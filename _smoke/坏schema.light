# 坏schema.light —— R99 路 E 冒烟：工具 schema 注册期形状自检（LP-D-017）
#
# 目的：证明**形状非法的 schema 在注册那一刻就抛错**，而不是等到执行期按 schema 造参时才炸在
# stdlib 内部（历史症状：`类 list 缺少方法/属性 keys（stdlib/内置核心字典.light:29）`，
# 报错位置与出错插件毫无关系，定位成本极高）。
#
# 运行：
#   python 运行.py _smoke/坏schema.light
# 期望：打印「坏schema 冒烟全部通过」，且 断言失败=0；任一断言失败会 [失败] 打印且 rc!=0。

从 工具 导入 工具注册表, 造工具定义

设 通过数 为 0
设 失败数 为 0

段落 记通过():
  全局 通过数。
  设 通过数 为 通过数 + 1
  返回 真

段落 记失败(说明):
  全局 失败数。
  设 失败数 为 失败数 + 1
  打印 "  [失败] " + 说明
  返回 真

# 串包含：分割字符串 命中后段数 > 1 即视为包含（不引入额外依赖）
段落 串包含(串, 子串):
  如果 长(分割字符串(串, 子串)) > 1:
    返回 真
  返回 假

# 试注册：返回错误文本；注册成功（未抛错）返回空串
段落 试注册(定义项):
  设 注册表 为 新建 工具注册表()
  设 错误文本 为 ""
  尝试:
    注册表.注册(定义项)
  捕获 错误:
    设 错误文本 为 转字符串(错误)
  返回 错误文本

段落 断言报错(错误文本, 关键字, 标签):
  如果 错误文本 == "":
    记失败("注册本应报错却成功了: " + 标签)
    返回 真
  如果 串包含(错误文本, "INVALID_TOOL_SCHEMA") == 假:
    记失败("报错缺 INVALID_TOOL_SCHEMA 标记: " + 标签 + " -> " + 错误文本)
    返回 真
  如果 串包含(错误文本, 关键字) == 假:
    记失败("报错文本应含『" + 关键字 + "』: " + 标签 + " -> " + 错误文本)
    返回 真
  记通过()
  返回 真

段落 断言通过(错误文本, 标签):
  如果 错误文本 != "":
    记失败("注册本应成功却报错: " + 标签 + " -> " + 错误文本)
    返回 真
  记通过()
  返回 真

段落 主:
  打印 "===== 坏 schema 注册期自检冒烟 ====="

  # ---- 反例：properties 写成列表（LP-D-017 的头号真凶）----
  设 空列表模式 为 ["type": "object", "properties": [], "required": []]
  设 错1 为 试注册(造工具定义("坏_空列表", "d", 空列表模式, 空))
  断言报错(错1, "properties", "properties 写成空列表")

  设 非空列表 为 ["a", "b"]
  设 错2 为 试注册(造工具定义("坏_非空列表", "d", ["type": "object", "properties": 非空列表], 空))
  断言报错(错2, "properties", "properties 写成非空列表")

  # ---- 正例：properties 为映射 ----
  设 错3 为 试注册(造工具定义("好_空映射", "d", ["type": "object", "properties": {}], 空))
  断言通过(错3, "properties 为空映射")

  设 错4 为 试注册(造工具定义("好_正常", "d", ["type": "object", "properties": ["x": ["type": "string"]], "required": ["x"]], 空))
  断言通过(错4, "正常 schema")

  # ---- 反例：顶层 type ----
  设 错5 为 试注册(造工具定义("坏_缺type", "d", ["properties": {}], 空))
  断言报错(错5, "type", "顶层缺 type")

  设 错6 为 试注册(造工具定义("坏_type非对象", "d", ["type": "string"], 空))
  断言报错(错6, "type", "顶层 type 非 object")

  设 错7 为 试注册(造工具定义("坏_非法type名", "d", ["type": "object", "properties": ["x": ["type": "str"]]], 空))
  断言报错(错7, "type", "属性 type 名非法")

  # ---- 反例：required ----
  设 错8 为 试注册(造工具定义("坏_required非列表", "d", ["type": "object", "properties": ["x": ["type": "string"]], "required": "x"], 空))
  断言报错(错8, "required", "required 非列表")

  设 必填 为 ["no_such"]
  设 错9 为 试注册(造工具定义("坏_required未知", "d", ["type": "object", "properties": ["x": ["type": "string"]], "required": 必填], 空))
  断言报错(错9, "no_such", "required 引用未声明属性")

  # ---- 反例：工具级必填字段 ----
  设 无名定义 为 ["description": "d", "parameters": ["type": "object"]]
  设 错10 为 试注册(无名定义)
  断言报错(错10, "name", "缺 name")

  设 错11 为 试注册(造工具定义("坏_缺parameters", "d", 空, 空))
  断言报错(错11, "parameters", "缺 parameters")

  # ---- 反例：嵌套子 schema（递归校验 + 点名参数路径）----
  设 错12 为 试注册(造工具定义("坏_嵌套items", "d", ["type": "object", "properties": ["m": ["type": "array", "items": "bad"]]], 空))
  断言报错(错12, "m", "嵌套 items 非 schema")

  # ---- 定位能力：报错必须点名出错的工具与参数 ----
  如果 串包含(错1, "坏_空列表") == 假:
    记失败("报错应点名工具名 坏_空列表，实际=" + 错1)
  否则:
    记通过()
  如果 串包含(错12, "m") == 假:
    记失败("嵌套报错应点名参数 m，实际=" + 错12)
  否则:
    记通过()

  打印 "断言通过="
  打印 通过数
  打印 "断言失败="
  打印 失败数
  如果 失败数 == 0:
    打印 "坏schema 冒烟全部通过"
  否则:
    抛出 新建 错误("坏schema 冒烟有 " + 转字符串(失败数) + " 条断言失败")

  打印 "===== 冒烟结束 ====="

主()
