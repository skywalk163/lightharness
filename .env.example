# lightharness 大模型配置示例
# 复制本文件为 .env 并填入真实值，或在网页首次启动时通过配置界面填写。
# 密钥仅保存在本地 .env 文件中，不会上传到任何第三方。

# 你的 API Key（DeepSeek 官方平台获取：https://platform.deepseek.com）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM 端点（OpenAI 兼容，代码自动拼 /chat/completions，无需手写 /v1）
# DeepSeek 官方端点
OPENAI_BASE_URL=https://api.deepseek.com

# 模型名（端点大小写敏感！）
# DeepSeek 常用模型：deepseek-chat / deepseek-reasoner
OPENAI_MODEL=deepseek-chat
