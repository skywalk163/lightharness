# _probe_R41_fs.light —— R41 任务1 探针：实证 light 运行时文件/路径原语行为
# 仅用于探查，不改任何 src/。运行：cd lightharness && python 运行.py _probe_R41_fs.light

从 工具_路径安全 导入 取根目录, 解析安全路径
从 主目录路径 导入 展开主目录路径

段落 探测 接收 标签, 值:
  打印("PROBE " + 标签 + " => " + 转字符串(值))

段落 主:
  设 根 为 取根目录()
  探测("根目录", 根)

  # 用一个受控子目录做沙箱测试（落在根内，合法）
  设 基 为 连接路径(根, "_r41_probe_tmp")
  设 安全 为 解析安全路径(根, "_r41_probe_tmp")
  探测("解析安全路径.ok", 安全["ok"])
  探测("解析安全路径.路径", 安全["路径"])

  # 越界拒绝
  设 越界 为 解析安全路径(根, "../../etc/passwd")
  探测("越界.ok(应为假)", 越界["ok"])

  # 创建目录
  创建目录(基)
  探测("目录存在", 目录存在(基))

  # 写文本
  设 文件甲 为 连接路径(基, "a.txt")
  写入文件(文件甲, "第一行\n第二行\n")
  探测("文件存在", 文件存在(文件甲))
  探测("文件大小", 文件大小(文件甲))
  探测("读取文件", 读取文件(文件甲))

  # 原子写：临时文件 + 原子替换
  设 临时 为 连接路径(基, "a.txt.tmp")
  写入文件(临时, "新内容\n")
  原子替换(临时, 文件甲)
  探测("原子写后内容", 读取文件(文件甲))
  探测("临时是否消失", 文件存在(临时))

  # 列出目录
  设 文件乙 为 连接路径(基, "b.txt")
  写入文件(文件乙, "x")
  探测("列出目录", 列出目录(基))

  # 移动/重命名
  设 文件丙 为 连接路径(基, "c.txt")
  移动文件系统(文件乙, 文件丙)
  探测("重命名后乙存在(应为假)", 文件存在(文件乙))
  探测("重命名后丙存在", 文件存在(文件丙))

  # 二进制读 + 字节索引（图片嗅探需要 bytes->int）
  # 说明：light 无「字节串」构造器（登记 L-159），此处直接读已有文本文件验证 bytes 索引行为
  设 原始 为 读二进制文件(文件甲)
  探测("读二进制文件类型", 类型(原始))
  探测("读二进制文件长度", 长(原始))
  # 试着索引字节（UTF-8 下「第」首字节 = 0xE7 = 231）
  设 首字节 为 原始[0]
  探测("首字节(期望231)", 首字节)
  探测("首字节类型", 类型(首字节))

  # 低级读路径（mode 用十六进制 0x1A4=420，light 不支持 0o644 八进制字面量）
  设 句柄 为 低级打开(文件甲, 只读(), 0x1A4)
  设 头 为 低级读(句柄, 4)
  低级关闭(句柄)
  探测("低级读类型", 类型(头))
  探测("低级读首字节", 头[0])

  # 文件状态（mtime/size）
  设 状态 为 文件状态(文件甲)
  探测("文件状态", 状态)

  # 主目录展开
  设 主 为 主目录()
  探测("主目录", 主)
  探测("~ 展开", 展开主目录路径("~/foo", 主))

  # 清理
  删除文件(文件甲)
  删除文件(文件丙)
  删除目录(基)
  探测("清理后基存在(应为假)", 目录存在(基))

  打印("--- R41 文件原语探针结束 ---")

主()
