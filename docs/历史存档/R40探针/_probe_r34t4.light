# _probe_r34t4.light —— 第34轮任务4 语法/内建探查（工具探针，非交付模块）
# 运行：cd lightharness && python 运行.py _probe_r34t4.light

段落 取项 接收 字典, 键表, 默认值:
  如果 是字典(字典) == 假:
    返回 默认值
  遍历 键 之 键表:
    如果 字典包含键(字典, 键):
      返回 字典[键]
  返回 默认值

段落 列出键 接收 字典:
  设 表 为 字典键列表(字典)
  表.sort()
  返回 表

段落 主:
  打印 "=== P1 类型判定 ==="
  设 零 为 -0.0
  打印 "零==0:", 零 == 0
  打印 "零==0.0:", 零 == 0.0
  打印 "是整数(0.0):", 是整数(0.0)
  打印 "是整数(-1):", 是整数(-1)
  打印 "是浮点(0.0):", 是浮点(0.0)
  打印 "是浮点(1):", 是浮点(1)
  打印 "是浮点(-0.0):", 是浮点(零)
  打印 "是布尔(真):", 是布尔(真)
  打印 "是空(空):", 是空(空)
  打印 "是空({}):", 是空({})

  打印 "=== P2 字典/列表 ==="
  设 甲 为 {"a": 1, "b": "x", "c": [1, 2]}
  打印 "键表:", 列出键(甲)
  设 乙 为 {}
  乙["k"] 为 [1]
  设 内 为 乙["k"]
  列表追加(内, 2)
  乙["k"] 为 内
  打印 "嵌套改:", 序列化JSON(乙)
  设 表 为 [10, 20, 30, 40, 50]
  打印 "切片中段:", 序列化JSON(表[1:3])
  打印 "切片尾:", 序列化JSON(表[2:])
  打印 "切片头:", 序列化JSON(表[:2])
  列表追加(表, 60)
  打印 "追加后长:", 列表长度(表)
  打印 "包含:", 列表包含(表, 40), 列表包含(表, 99)
  设 复制表 为 表[:]
  复制表[0] 为 0
  打印 "浅复制不影响原表:", 表[0]

  打印 "=== P3 字符串/数值 ==="
  打印 "截:", 截取(表, 1, 3)
  打印 "整:", 转整数("7"), int("8"), 转整数(9.7)
  打印 "长:", 长度("你好"), 字符串长度("abc"), 列表长度([])
  打印 "拼:", "n=" + 转字符串(3)
  设 小写 为 "AbC"
  打印 "子串:", 小写[1:3]

  打印 "=== P4 异常 ==="
  设 出错 为 假
  尝试:
    抛出 新建 错误(" boom-1 ")
  捕获 异常 错误:
    设 出错 为 真
    打印 "捕获:", 转字符串(错误), "含boom:", 字符串包含(转字符串(错误), "boom")
  如果 出错 == 假:
    抛出 新建 错误("捕获未生效")
  打印 "取项缺键默认:", 取项({"a": 1}, ["z", "y"], "缺省")
  打印 "取项取到:", 取项({"a": 1, "b": 2}, ["z", "b"], "缺省")

  打印 "=== P5 负零/工具 ==="
  打印 "转整数('-0'):", 转整数("-0"), "是整数?", 是整数(转整数("-0"))
  打印 "字符串'-0'含减号:", 字符串包含("-0", "-")
  打印 "字符串包含('0.0','0'):", 字符串包含("0.0", "0")
  打印 "截取越界:", 截取([1, 2, 3], 2, 9)
  设 甲2 为 {"x": 1}
  设 乙2 为 {"x": 2}
  甲2["x"] 为 9
  打印 "字典独立性:", 甲2["x"], 乙2["x"]
  设 空字典 为 {}
  空字典["新"] 为 "值"
  打印 "字典设置检查:", 字典包含键(空字典, "新"), 字典获取(空字典, "新"), 字典获取(空字典, "缺", "缺省值")
  打印 "字典键列表可迭代:", 长度(字典键列表({"a": 1, "b": 2}))
  设 删 为 {"a": 1, "b": 2}
  字典删除(删, "a")
  打印 "删除后:", 序列化JSON(删)
  打印 "时间戳类型:", 是整数(时间戳())
  打印 "序列化:", 序列化JSON({"中文键": "值", "数字": 3})

  打印 "=== P6 控制流/嵌套 ==="
  设 嵌套 为 {"外层": {"内层": 1}, "表": [1, 2]}
  嵌套["外层"]["内层"] 为 9
  列表追加(嵌套["表"], 3)
  打印 "嵌套改成功:", 序列化JSON(嵌套)
  设 命中 为 ""
  遍历 项 之 [1, 2, 3, 4]:
    如果 项 == 2:
      设 命中 为 "甲"
      继续
    如果 项 == 4:
      设 命中 为 "乙"
    如果 项 >= 4:
      设 已满 为 真
    设 命中 为 命中 + 转字符串(项)
  打印 "循环控制:", 命中
  设 结果 为 空
  如果 1 < 2:
    设 结果 为 "分支甲"
  否则:
    设 结果 为 "分支乙"
  打印 "否则:", 结果
  设 表 为 [10, 20]
  如果 列表包含(表, 20):
    打印 "列表包含可用"
  打印 "去空白:", 去除空白("  hi  ")
  打印 "连接:", 连接字符串(["a", "b", "c"], "-")
  返回 真

主()
