# test_R74_路5_JSONRPC深化.light —— #74 JSONRPC 传输缺口深化（路5）
#
# 背景：对标清单 #74 原登记「done(纯逻辑层)」，pending 请求表 / AbortSignal /
#       flush / 流挂接 未移植（登记理由「依赖 node:stream + Promise，留后续轮宿主包」）。
#       现光明已落一等 async/await（R70-B：异步段落 / 等待 / 并发等待 / 捕获全部），
#       且已有字节流一等原语 字节缓冲（R72-E，L-175），故「等宿主包」前提不成立——
#       本用例用光明现有异步能力 + 字节缓冲做等价实现，不再登记为不可移植。
#
# 覆盖四组断言：
#   ① pending 撮合（并发多请求按 id 正确回填）
#   ② 取消后 pending 清理（等待方收到明确取消结果）
#   ③ flush（缓冲帧强制写出为字节）
#   ④ 流挂接（传输层接到可读写字节流，请求经流写出、响应经流读回并撮合）
#   ⑤ 异步等价（请求并等待 / 等待解决 / 取消令牌 驱动取消，均用 R70-B async）

从 JSONRPC传输 导入 造请求帧, 造响应帧, 造通知帧, 造错误, 造错误响应帧, 帧编码
从 JSONRPC传输 导入 判别帧, 归一化参数, NDJSON行解码器, JSONRPC终端, 造请求ID
从 JSONRPC传输 导入 错误码方法未找到, 错误码处理器失败, 取消错误, 取消令牌
从 JSON 导入 解析JSON
从 字节缓冲 导入 字节缓冲, 新建字节缓冲

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 实际, 标签:
  如果 实际 != 真:
    抛出 新建 错误("断言失败(应真): " + 标签 + " 实际=" + 转字符串(实际))

# 双向字节流：用两个 字节缓冲 分别承载「出站（终端写出）」与「入站（喂回响应）」，
# 对外暴露 推入字节（写）/ 按字节切（读）/ 喂入站（测试注入响应），即 AbortSignal 宿主面
# 字节流挂接的纯逻辑等价物。
类 双向字节流:
  属性 出站 等于 空
  属性 入站 等于 空
  段落 构造:
    设 己.出站 为 新建 字节缓冲()
    设 己.入站 为 新建 字节缓冲()
  段落 推入字节 接收 字节段:
    己.出站.推入字节(字节段)
  段落 按字节切 接收 分隔:
    返回 己.入站.按字节切(分隔)
  段落 喂入站 接收 字节段:
    己.入站.推入字节(字节段)
  段落 取出站字节:
    返回 己.出站.取全部()

异步 段落 主:
  打印 "=== R74 JSONRPC 深化 开始 ==="

  # ---- ① pending 撮合：并发多请求按 id 正确回填 ----
  设 终端 为 新建 JSONRPC终端()
  终端.安装请求处理器(段落 好处理 接收 方法, 参数:
    返回 ["echo": 参数["v"]])
  终端.挂号请求("r1", 空, 空, 空)
  终端.挂号请求("r2", 空, 空, 空)
  终端.挂号请求("r3", 空, 空, 空)
  # 乱序喂回响应，验证按 id 撮合而非按到达顺序
  终端.接收行(帧编码(造响应帧("r2", ["ok": 2])))
  终端.接收行(帧编码(造响应帧("r1", ["ok": 1])))
  终端.接收行(帧编码(造响应帧("r3", ["ok": 3])))
  断言相等(终端.应答表["r1"]["ok"], 1, "撮合 r1")
  断言相等(终端.应答表["r2"]["ok"], 2, "撮合 r2")
  断言相等(终端.应答表["r3"]["ok"], 3, "撮合 r3")
  断言相等(终端.pending表.包含("r1"), 假, "撮合后 pending 清空 r1")
  断言相等(终端.pending表.包含("r2"), 假, "撮合后 pending 清空 r2")
  断言相等(终端.pending表.包含("r3"), 假, "撮合后 pending 清空 r3")
  断言相等(长度(终端.收到响应), 3, "响应帧仍记入收到响应（旧行为保留）")
  # 错误响应也按 id 撮合
  设 终端E 为 新建 JSONRPC终端()
  终端E.挂号请求("e1", 空, 空, 空)
  终端E.接收行(帧编码(造错误响应帧("e1", 错误码方法未找到(), "no", 空)))
  断言相等(终端E.错答表["e1"]["code"], 错误码方法未找到(), "错误响应按 id 撮合")

  # ---- ② 取消后 pending 清理 + 等待方收到明确结果 ----
  设 终端2 为 新建 JSONRPC终端()
  终端2.挂号请求("c1", 空, 空, 空)
  断言相等(终端2.pending表.包含("c1"), 真, "挂号后 pending 存在")
  终端2.取消请求("c1")
  断言相等(终端2.pending表.包含("c1"), 假, "取消后 pending 清理")
  断言相等(终端2.已取消表.包含("c1"), 真, "取消已记录（明确结果）")
  # 拒绝器被调用且收到取消错误
  设 拒绝收到 为 []
  段落 我的拒绝 接收 错:
    拒绝收到.追加(错)
  设 终端2b 为 新建 JSONRPC终端()
  终端2b.挂号请求("c2", 空, 我的拒绝, 空)
  终端2b.取消请求("c2")
  断言相等(长度(拒绝收到), 1, "取消触发拒绝器")
  断言相等(拒绝收到[0].消息.包含("取消"), 真, "拒绝器收到取消错误（明确结果）")

  # ---- ③ flush：缓冲帧强制写出为字节 ----
  设 流 为 新建 双向字节流()
  设 终端3 为 新建 JSONRPC终端()
  终端3.挂接流(流)
  终端3.发送请求("f1", "session/prompt", ["v": 7])
  断言相等(长度(终端3.待发), 1, "发送后缓冲 1 帧")
  终端3.flush()
  断言相等(长度(终端3.待发), 0, "flush 后缓冲清空")
  设 出站文本 为 流.取出站字节().解码("utf-8")
  断言真(出站文本.包含("\"f1\""), "flush 写出含 id 的帧字节")
  断言真(出站文本.结尾("\n"), "flush 写出以换行结尾")

  # ---- ④ 流挂接：请求经流写出、响应经流读回并撮合 ----
  设 流4 为 新建 双向字节流()
  设 终端4 为 新建 JSONRPC终端()
  终端4.挂接流(流4)
  终端4.发送请求("s1", "session/prompt", ["v": 9])
  终端4.flush()
  断言真(流4.取出站字节().解码("utf-8").包含("s1"), "请求经流写出")
  # 注入响应字节到入站，泵读回 → 接收行 → 撮合
  流4.喂入站(b'{"jsonrpc":"2.0","id":"s1","result":{"ok":9}}\n')
  终端4.泵()
  断言相等(终端4.应答表["s1"]["ok"], 9, "流挂接：响应经流读回并撮合")
  断言相等(终端4.pending表.包含("s1"), 假, "流挂接：撮合后 pending 清理")
  # 多帧一泵：同时撮合两个 pending
  设 流5 为 新建 双向字节流()
  设 终端5 为 新建 JSONRPC终端()
  终端5.挂接流(流5)
  终端5.发送请求("m1", "a", 空)
  终端5.发送请求("m2", "a", 空)
  终端5.flush()
  流5.喂入站(b'{"jsonrpc":"2.0","id":"m1","result":1}\n{"jsonrpc":"2.0","id":"m2","result":2}\n')
  终端5.泵()
  断言相等(终端5.应答表["m1"], 1, "流挂接：一泵撮合 m1")
  断言相等(终端5.应答表["m2"], 2, "流挂接：一泵撮合 m2")

  # ---- ⑤ 异步等价：请求并等待（并发多请求按 id 回填，用 R70-B await）----
  设 终端A 为 新建 JSONRPC终端()
  终端A.挂号请求("a1", 空, 空, 空)
  终端A.挂号请求("a2", 空, 空, 空)
  终端A.挂号请求("a3", 空, 空, 空)
  # 同步喂回响应（pending 已挂号 → 撮合回填），再并发等待（已在等待前解决，无挂起风险）
  终端A.接收行(帧编码(造响应帧("a2", ["ok": 2])))
  终端A.接收行(帧编码(造响应帧("a1", ["ok": 1])))
  终端A.接收行(帧编码(造响应帧("a3", ["ok": 3])))
  设 结果表 为 等待 并发等待([
    终端A.等待解决("a1"), 终端A.等待解决("a2"), 终端A.等待解决("a3")])
  断言相等(结果表[0]["ok"], 1, "异步撮合 a1")
  断言相等(结果表[1]["ok"], 2, "异步撮合 a2")
  断言相等(结果表[2]["ok"], 3, "异步撮合 a3")

  # ---- ⑤b 异步等价：取消后等待方收到明确结果（捕获 全部 接取消错误）----
  设 终端B 为 新建 JSONRPC终端()
  终端B.挂号请求("cC", 空, 空, 空)
  终端B.取消请求("cC")
  尝试:
    设 结果C 为 等待 终端B.等待解决("cC")
    抛出 新建 错误("不应到达：取消后不应返回结果")
  捕获 全部:
    打印 "异步取消：等待方捕获取消错误（明确结果）"

  # ---- ⑤c 取消令牌（AbortSignal 等价物）驱动取消 ----
  设 终端C 为 新建 JSONRPC终端()
  设 令牌X 为 新建 取消令牌()
  段落 令牌取消X:
    终端C.取消请求("tX")
  令牌X.当取消(令牌取消X)
  终端C.发送请求("tX", "m", 空, 令牌X)
  令牌X.取消()
  断言相等(终端C.pending表.包含("tX"), 假, "令牌取消→pending 清理")
  断言相等(终端C.已取消表.包含("tX"), 真, "令牌取消→已取消记录")
  断言相等(令牌X.是否已取消(), 真, "令牌状态反映已取消")

  打印 "--- test_R74_路5_JSONRPC深化 PASS ---"
