# 持久化.light —— JSONL 会话持久化（对齐原版 session-persistence-jsonl，P0 纯文本版）
#
# 磁盘布局（对齐原版 format.ts）：
#   root/<项目键(cwd)>/<编码段(id)>/session.jsonl
# 首行：{ "type":"session", "version":1, "id", "createdAt", "cwd"?, "delegationDepth":0, ... }
# 之后每行一条事件记录（JSONL，无压缩/无 chunk 打包，v1）。
#
# 路径安全：SessionId 未经校验，必须编码成单一安全路径段（防遍历/防碰撞）。
# 编码段/项目键 对齐原版：安全字符字面保留，其余 ~XXXX（大写十六进制补 4 位）。
# 码点/十六进制走纯光明内置（码位 / 十六进制），不再依赖 Python 生态的 builtins。
#
# ⚠️ 光明命名规范 v1：成员名/局部名避开关键字与运算符词根。

从 JSON 导入 解析JSON, 序列化JSON
从 会话 导入 会话

# 字符是否为安全路径字符（A-Za-z0-9._-）
段落 安全字符 接收 字符:
  设 码 为 码位(字符)
  如果 码 >= 48 且 码 <= 57:
    返回 真
  如果 码 >= 65 且 码 <= 90:
    返回 真
  如果 码 >= 97 且 码 <= 122:
    返回 真
  如果 字符 == "." 或 字符 == "_" 或 字符 == "-":
    返回 真
  返回 假

# 码位 → ~XXXX（大写十六进制补 4 位）
段落 逃逸字符 接收 字符:
  设 数字 为 十六进制(码位(字符))
  当 长度(数字) < 4:
    设 数字 为 "0" + 数字
  返回 "~" + 数字

# ---- 路径段编码（对齐 encodeSegment）----
段落 编码段 接收 原文:
  如果 原文 == "":
    抛出 "不能编码空路径段"
  如果 原文 == ".":
    返回 "~002E"
  如果 原文 == "..":
    返回 "~002E~002E"
  设 输出 为 ""
  设 i 为 0
  当 i < 长度(原文):
    设 字符 为 原文[i]
    如果 字符 != "~" 且 安全字符(字符):
      设 输出 为 输出 + 字符
    否则:
      设 输出 为 输出 + 逃逸字符(字符)
    设 i 为 i + 1
  返回 输出

# ---- 项目键（对齐 projectKey）----
段落 项目键 接收 工作目录:
  如果 工作目录 == "":
    抛出 "不能编码空项目路径"
  设 可读 为 ""
  设 分隔中 为 假
  设 i 为 0
  当 i < 长度(工作目录):
    设 字符 为 工作目录[i]
    如果 字符 == "/" 或 字符 == "\\" 或 字符 == ":":
      如果 分隔中 == 假:
        设 可读 为 可读 + "-"
      设 分隔中 为 真
    否则如果 字符 != "~" 且 安全字符(字符):
      设 可读 为 可读 + 字符
      设 分隔中 为 假
    否则:
      设 可读 为 可读 + 逃逸字符(字符)
      设 分隔中 为 假
    设 i 为 i + 1
  设 段 为 可读
  当 长度(段) > 0 且 段[0] == "-":
    设 段 为 段[1:]
  如果 段 == "":
    设 段 为 "root"
  如果 长度(段) > 251:
    设 段 为 段[0:251]
  返回 "--" + 段 + "--"

# ---- 目录与路径 ----
段落 会话目录 接收 根, 工作目录, 标识:
  返回 根 + "\\" + 项目键(工作目录) + "\\" + 编码段(标识)

段落 日志路径 接收 根, 工作目录, 标识:
  返回 会话目录(根, 工作目录, 标识) + "\\session.jsonl"

# ---- 首行对象 ----
段落 行对象 接收 会话对象:
  设 头数据 为 会话对象.头信息
  设 行 为 ["type": "session", "version": 头数据["版本"], "id": 会话对象.标识, "createdAt": 头数据["创建时间"], "delegationDepth": 0]
  如果 头数据.包含("工作目录") 且 头数据["工作目录"] != "":
    行["cwd"] 为 头数据["工作目录"]
  返回 行

# ---- 增量模式：初始化日志（只写首行 header，不写事件）----
段落 初始化日志 接收 根, 会话对象:
  设 工作目录 为 会话对象.头信息.获取("工作目录", ".")
  设 目录 为 会话目录(根, 工作目录, 会话对象.标识)
  如果 目录存在(目录) == 假:
    创建目录(目录)
  设 路径 为 日志路径(根, 工作目录, 会话对象.标识)
  设 文本 为 序列化JSON(行对象(会话对象))
  写入文件(路径, 文本 + "
")
  返回 路径

# ---- 增量模式：追加单个事件行到文件末尾 ----
段落 追加事件行 接收 根, 工作目录, 标识, 事件记录:
  设 路径 为 日志路径(根, 工作目录, 标识)
  # 文件不存在则先初始化（仅写 header，事件后续追加）
  如果 文件存在(路径) == 假:
    设 目录 为 会话目录(根, 工作目录, 标识)
    如果 目录存在(目录) == 假:
      创建目录(目录)
    设 最小头 为 ["type": "session", "version": 1, "id": 标识, "createdAt": 转字符串(时间戳()), "delegationDepth": 0, "cwd": 工作目录]
    写入文件(路径, 序列化JSON(最小头) + "
")
  设 记录 为 ["type": 事件记录["类型"], "seq": 事件记录["序号"], "time": 事件记录["时间"], "data": 事件记录["数据"]]
  如果 事件记录.包含("遮蔽") 且 事件记录["遮蔽"]:
    记录["遮蔽"] 为 真
  如果 事件记录.包含("来源事件序号"):
    记录["来源事件序号"] 为 事件记录["来源事件序号"]
  # 追加到文件末尾
  设 现有 为 读取文件(路径)
  写入文件(路径, 现有 + 序列化JSON(记录) + "
")
  返回 路径

# ---- 写出：首行 header + 每事件一行（含遮蔽标记与来源序号）----
段落 写出会话 接收 根, 会话对象:
  设 工作目录 为 会话对象.头信息.获取("工作目录", ".")
  设 目录 为 会话目录(根, 工作目录, 会话对象.标识)
  如果 目录存在(目录) == 假:
    创建目录(目录)
  设 路径 为 日志路径(根, 工作目录, 会话对象.标识)
  设 文本 为 序列化JSON(行对象(会话对象))
  遍历 事件记录 之 会话对象.汇集全部事件():
    设 记录 为 ["type": 事件记录["类型"], "seq": 事件记录["序号"], "time": 事件记录["时间"], "data": 事件记录["数据"]]
    如果 事件记录.包含("遮蔽") 且 事件记录["遮蔽"]:
      记录["遮蔽"] 为 真
    如果 事件记录.包含("来源事件序号"):
      记录["来源事件序号"] 为 事件记录["来源事件序号"]
    设 文本 为 文本 + "\n" + 序列化JSON(记录)
  # 整盘快照：写出完整会话日志（覆盖旧文件）
  写入文件(路径, 文本 + "\n")
  返回 路径

# ---- 读入：解析首行 + 逐事件重建会话 ----
段落 读入会话 接收 根, 工作目录, 标识:
  设 路径 为 日志路径(根, 工作目录, 标识)
  如果 文件存在(路径) == 假:
    抛出 "会话日志不存在: " + 路径
  设 全文 为 读取文件(路径)
  设 行表 为 拆分行(全文)
  如果 长度(行表) == 0:
    抛出 "空会话日志"
  设 首行 为 解析JSON(行表[0])
  如果 首行["type"] != "session":
    抛出 "会话日志首行不是 session 头"
  设 会话对象 为 新建 会话(首行["id"], 首行.获取("cwd", 工作目录), 空, 0)
  设 i 为 1
  当 i < 长度(行表):
    如果 行表[i] != "":
      设 记录 为 解析JSON(行表[i])
      设 事件记录 为 会话对象.记录事件(记录["type"], 记录["data"])
      事件记录["时间"] 为 记录["time"]
      如果 记录.包含("遮蔽"):
        事件记录["遮蔽"] 为 记录["遮蔽"]
      如果 记录.包含("来源事件序号"):
        事件记录["来源事件序号"] 为 记录["来源事件序号"]
    设 i 为 i + 1
  返回 会话对象

# 按换行拆分（保留空行判断）
段落 拆分行 接收 文本:
  设 结果 为 []
  设 当前 为 ""
  设 i 为 0
  当 i < 长度(文本):
    如果 文本[i] == "\n":
      结果.追加(当前)
      设 当前 为 ""
    否则:
      设 当前 为 当前 + 文本[i]
    设 i 为 i + 1
  如果 当前 != "":
    结果.追加(当前)
  返回 结果
