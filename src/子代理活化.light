# 子代理活化.light —— R175（T-0175）B3 路纯逻辑复刻
#
# 上游：packages/subagent/subagent/src/activation.ts（dsh-v0.2.1-rc.3，186 行新增）
#   → 一次「活化期（residency epoch）」的进程内名额、每个可续子代的串行化，
#     以及本地活化的 Agent 取回 / 外部活化的后续输入拒收。
#
# 复刻范围（纯逻辑段，上游 ActivationPool / activationAgent / requireLocalActivation / ChildLock）：
#   §1 名额池：容量满 → SubagentError(ACTIVATION_LIMIT_REACHED)；释放幂等（容忍回滚未发布）
#   §2 本地活化取 Agent；外部活化拒绝后续输入（NOT_CONTINUABLE）
#   §3 子代串行锁：按子标识 FIFO 串接；尾条目只在本轮仍是尾时清理
#
# 宿主面剥离 / 本轮不搬（登记，见 summary 与交付报告差异节）：
#   - captureLocalResult / observeLocalFailure 依赖会话事件流（snapshotEvents、agent/error、
#     session/event 监听）与 Promise，全属宿主运行时；本轮只登记其**选停因语义**：
#     未提交（无更晚的 turn/end）的失败优先判 "error"，否则取 epochStopReason。
#   - PromiseWithResolvers / WeakSet 祖先判定 / AbortController 无光明对应物（无对象身份）。
#
# 命名避坑：本地辅助段一律「活化」前缀（src 后端把被导入模块内联进同一份 Python）。

# =====================================================================
# §1 名额池（ActivationPool）
# =====================================================================

# new ActivationPool —— 池 = {"容量": n, "占用": {令牌: 真/假}, "下一个": k}
# 用「占位表标记」而非删除键，是因为释放必须幂等（上游 release 可被重复调用）。
段落 活化新池(容量):
  如果 是整数(容量) == 假 或 容量 < 0:
    抛出 新建 错误("ActivationPool capacity must be a non-negative integer")
  返回 {"容量": 容量, "占用": {}, "下一个": 1}

# reserve：满了就抛（含上游的 ACTIATION_LIMIT_REACHED 文案与码），否则发一个名额
段落 活化占用(池):
  如果 活化在飞(池) >= 池["容量"]:
    抛出 新建 错误(活化限额消息(池["容量"]))
  设 令牌 为 池["下一个"]
  设 池["下一个"] 为 令牌 + 1
  设 池["占用"][令牌] 为 真
  返回 令牌

# 释放：幂等（未占用/已释放返回 假；首次释放返回 真）
段落 活化释放(池, 令牌):
  如果 字典包含键(池["占用"], 令牌) == 假:
    返回 假
  如果 池["占用"][令牌] == 假:
    返回 假
  设 池["占用"][令牌] 为 假
  返回 真

# 当前在飞名额数
段落 活化在飞(池):
  设 n 为 0
  遍历 令牌 之 字典键列表(池["占用"]):
    如果 池["占用"][令牌] == 真:
      设 n 为 n + 1
  返回 n

# 上游文案逐字对齐：`subagent limit reached (active child limit: ${capacity}); wait for
# an existing child to finish or complete this work with the current agents`
段落 活化限额消息(容量):
  返回 活化错误消息("subagent limit reached (active child limit: " + 转字符串(容量)
    + "); wait for an existing child to finish or complete this work with the current agents",
    "ACTIVATION_LIMIT_REACHED")

# =====================================================================
# §2 本地 / 外部活化（activationAgent / requireLocalActivation）
# =====================================================================

# 活化 = {"种类": "local"|"external", "标识": 子会话标识, "句柄": {"代理": ...}}
段落 活化本地的(标识, 代理):
  返回 {"种类": "local", "标识": 标识, "句柄": {"代理": 代理}}

段落 活化外部的(标识, 运行):
  返回 {"种类": "external", "标识": 标识, "运行": 运行}

# activationAgent：只有本地活化才有活的 Agent
段落 活化取代理(活化):
  如果 活化["种类"] == "local":
    返回 活化["句柄"]["代理"]
  返回 空

# requireLocalActivation：外部后端不接受后续输入
段落 活化要求本地(活化):
  如果 活化["种类"] == "local":
    返回 活化
  抛出 新建 错误(活化错误消息("subagent \"" + 转字符串(活化["标识"])
    + "\" does not accept follow-up input", "NOT_CONTINUABLE"))

# =====================================================================
# §3 子代串行锁（ChildLock）
# =====================================================================

# new ChildLock —— 锁 = {"尾巴": {子标识: 序号或 空}, "下一个": k}
段落 活化新锁:
  返回 {"尾巴": {}, "下一个": 1}

# run：返回本轮序号与「同子标识的上一轮序号」（无则 空），并把尾巴换成本轮。
# 上游的线性化由 previous.then(operation) 表达；纯逻辑面等同「FIFO 串接 + 尾替换」。
段落 活化排队(锁, 子标识):
  设 前序号 为 字典获取(锁["尾巴"], 子标识, 空)
  设 序号 为 锁["下一个"]
  设 锁["下一个"] 为 序号 + 1
  设 锁["尾巴"][子标识] 为 序号
  返回 {"序号": 序号, "前序号": 前序号}

# 收尾：只有「本轮仍是尾」才清掉条目（对齐上游 `if (tails.get(id) === tail) delete`）
段落 活化收尾(锁, 子标识, 序号):
  如果 字典获取(锁["尾巴"], 子标识, 空) == 序号:
    设 锁["尾巴"][子标识] 为 空
    返回 真
  返回 假

# 仍有未收尾尾巴的子标识数
段落 活化活跃子数(锁):
  设 n 为 0
  遍历 标识 之 字典键列表(锁["尾巴"]):
    如果 锁["尾巴"][标识] != 空:
      设 n 为 n + 1
  返回 n

段落 活化错误消息(消息, 码):
  返回 消息 + " [" + 码 + "]"

段落 是整数(值):
  返回 type(值) == int

导出 活化新池, 活化占用, 活化释放, 活化在飞, 活化限额消息, 活化本地的, 活化外部的, 活化取代理, 活化要求本地, 活化新锁, 活化排队, 活化收尾, 活化活跃子数, 活化错误消息