# 预设.light —— 对标 #72：agent-presets 纯逻辑复刻
# 原版：packages/preset/agent-presets/src/{specifier,preset,metadata,session,discovery,mount,authoring}.ts
#   （index.ts 装配层 / invariant.ts Cordis 宿主绑定 不在本批白名单，未复刻）
#
# 复刻边界：node:fs / node:path / js-yaml / node:module / Cordis 运行时 一律投影为
#   「入参能力函数 / 注入字典」。fiber 对象同一性 → 标识图（父标识 + 纤维表）；
#   service store → 服务列表（每项 {name,fiber标识,在根隔离}）；YAML 解析 → 解析能力。
#
# 语言坑规避：全部函数用块形式（禁单行 段落 X: 返回/抛出，避免生成器缩进累积）；
#   列表/字典字面量单行；嵌套字面量内不写 \n（用 chr(10) 构造）；错误对象不可当字典。

从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 开头, 去除空白, 字符串包含
从 字符串工具轻量 导入 字符串长度
从 内置核心判型 导入 是整数, 是字符串, 是字典, 是列表
从 内置核心列表 导入 列表追加, 列表包含, 列表获取
从 内置核心字典 导入 字典包含键, 字典键列表
从 预设组合 导入 解析组合

# =====================================================================
# 一、specifier.ts —— 行标识符分类（对齐 classifyRowSpecifier）
# =====================================================================
段落 分类行标识符(标识符):
  如果 (开头(标识符, "cordis:") == 真): 返回 {"种类":"builtin", "标识符":标识符}
  如果 (开头(标识符, "./") == 真 或 开头(标识符, "../") == 真): 返回 {"种类":"preset", "标识符":标识符}
  如果 (开头(标识符, "/") == 真 或 (字符串长度(标识符) >= 2 且 标识符[1] == ":")): 返回 {"种类":"file", "标识符":标识符}
  如果 (开头(标识符, "file:") == 真): 返回 {"种类":"file", "标识符":标识符}
  如果 (开头(标识符, "@") == 真): 返回 {"种类":"package", "标识符":标识符}
  返回 {"种类":"package", "标识符":标识符}

# 是否绝对路径（对齐 isAbsolute：以 / 开头 或 带盘符 X:）
段落 是绝对(路径):
  如果 (路径 == ""): 返回 假
  如果 (开头(路径, "/") == 真): 返回 真
  如果 (字符串长度(路径) >= 2 且 路径[1] == ":"): 返回 真
  返回 假

# 前缀判定（对齐 deleteComposition 的 startsWith 检查）
段落 前缀是(路径, 前缀):
  返回 开头(路径, 前缀)

# =====================================================================
# 二、preset.ts —— 标识校验 + 远程错误构造
# =====================================================================
# 标识合法：非空、首字符非 -、其余仅 [a-z0-9-]（对齐 ^[a-z0-9-]+$）
段落 标识合法(标识):
  如果 (标识 == ""): 返回 假
  如果 (标识[0] == "-"): 返回 假
  设 允许 为 "abcdefghijklmnopqrstuvwxyz0123456789-"
  设 i 为 0
  当 (i < 字符串长度(标识)):
    如果 (字符串包含(允许, 标识[i]) == 假): 返回 假
    设 i 为 i + 1
  返回 真

# 校验预设标识（别名，复用 标识合法）
段落 校验预设标识(标识):
  返回 标识合法(标识)

# 可用文本：空列表→"none"，否则取首元素（对齐 availableText）
段落 可用文本(列表):
  如果 (列表长度(列表) == 0): 返回 "none"
  返回 列表获取(列表, 0)

# 未知道错误（对齐 PresetNotFoundError）
段落 造未知道错误(标识, 可用):
  设 串 为 ""
  设 i 为 0
  当 (i < 列表长度(可用)):
    如果 (i > 0): 设 串 为 串 + ", "
    设 串 为 串 + 转字符串(列表获取(可用, i))
    设 i 为 i + 1
  返回 {"码":"agent-preset-not-found", "消息":"agent-presets: preset \"" + 标识 + "\" not found (available: " + 串 + ")", "详情":{"agentPreset":标识}}

# 锁错误（对齐 PresetLockedError）
段落 造锁错误(会话标识, 预设标识):
  返回 {"码":"agent-preset-locked", "消息":"agent-presets: preset \"" + 预设标识 + "\" is locked by session " + 会话标识, "详情":{"sessionId":会话标识}}

# 挂载错误（对齐 invalid-preset 的 reason 分支）
段落 造挂载错误(预设标识, 理由):
  返回 {"码":"agent-preset-invalid", "消息":"agent-presets: preset \"" + 预设标识 + "\" failed to mount: " + 理由, "详情":{"reason":理由}}

# 只读错误（对齐 read-only preset）
段落 造只读错误(预设标识, 来源):
  返回 {"码":"agent-preset-read-only", "消息":"agent-presets: preset \"" + 预设标识 + "\" is read-only (" + 来源 + ")", "详情":{"source":来源}}

# 坏请求错误
段落 造坏请求错误 ():
  返回 {"码":"bad-request", "消息":"bad request", "详情":{}}

# 内部错误
段落 造内部错误 ():
  返回 {"码":"internal", "消息":"internal error", "详情":{}}

# =====================================================================
# 三、metadata.ts —— 显示元数据
# =====================================================================
# 文本：非串→空；否则去空白，空白串→空（对齐 displayMetadata 的 trim 折叠）
段落 文本(值):
  如果 (是字符串(值) == 假): 返回 空
  设 去 为 去除空白(值)
  如果 (去 == ""): 返回 空
  返回 去

# 提取显示元数据（对齐 extractDisplayMetadata：name/description 非空串、order 整数）
段落 提取显示元数据(元):
  设 结果 为 {}
  如果 (字典包含键(元, "name") == 真 且 是字符串(元["name"]) == 真):
    设 名 为 去除空白(元["name"])
    如果 (名 != ""): 设 结果["name"] 为 名
  如果 (字典包含键(元, "description") == 真 且 是字符串(元["description"]) == 真):
    设 描 为 去除空白(元["description"])
    如果 (描 != ""): 设 结果["description"] 为 描
  如果 (字典包含键(元, "order") == 真 且 是整数(元["order"]) == 真): 设 结果["order"] 为 元["order"]
  返回 结果

# 造显示元数据记录（空则 空，否则返回记录）
段落 造显示元数据记录(元):
  设 结果 为 提取显示元数据(元)
  如果 (列表长度(字典键列表(结果)) == 0): 返回 空
  返回 结果

# 内置 shipped 预设显示文案字典（对齐上游 display.ts BUILT_IN_PRESET_KEYS：
# standard/ptc/minimal/cordis；shipped 预设走字典键，user 预设永不翻译）
# T-0403：四个组合型模式（topdown/bottomup/brainstorm/lazy）是本仓新增的上游无对应物，
#   名字与一句话描述是本仓自定文案，挂进同一张表（是内置预设 因此自动跟随）。
段落 内置预设文案(标识):
  设 字典 为 {"standard": ["名称": "标准模式", "描述": "完整的编码 agent。"], "ptc": ["名称": "编码模式", "描述": "专注编码的 agent。"], "minimal": ["名称": "极简模式", "描述": "最小的可用 agent。"], "cordis": ["名称": "组装模式", "描述": "用 Cordis 插件组装 agent。"], "default": ["名称": "默认", "描述": "不做任何工作方式干预，按标准推进。"], "topdown": ["名称": "自上而下", "描述": "先出计划树再动手，计划是一等产物。"], "bottomup": ["名称": "自下而上", "描述": "无中央规划器，领原子单元独立执行。"], "brainstorm": ["名称": "头脑风暴", "描述": "只读工具，先发散后收敛。"], "lazy": ["名称": "懒人", "描述": "沿决策阶梯走，能不做就不做。"]}
  如果 (字典包含键(字典, 标识) == 真): 返回 字典[标识]
  返回 空

# 是否内置 shipped 预设（对齐 display.ts isBuiltInPreset）：
#   shipped 预设不自发 name；自报 name 的声明自带文案，不进本地化字典。
段落 是内置预设(预设):
  如果 (是字典(预设) == 假): 返回 假
  如果 (字典包含键(预设, "name") == 真): 返回 假
  如果 (字典包含键(预设, "id") == 假): 返回 假
  返回 内置预设文案(预设["id"]) != 空

# 造显示文本（对齐上游 presetDisplayText：shipped 预设走字典文案；
# 其余预设 name 优先、无 name 回退 id、description 可选原样保留）
段落 造显示文本(预设):
  如果 (是字典(预设) == 假): 返回 空
  设 来源 为 ""
  如果 (字典包含键(预设, "trust") == 真): 设 来源 为 预设["trust"]
  设 标识 为 ""
  如果 (字典包含键(预设, "id") == 真): 设 标识 为 预设["id"]
  如果 (来源 == "system"):
    设 内置 为 内置预设文案(标识)
    如果 (内置 != 空): 返回 ["name": 内置["名称"], "description": 内置["描述"]]
  设 名 为 标识
  如果 (字典包含键(预设, "name") == 真 且 是字符串(预设["name"]) == 真):
    设 元名 为 去除空白(预设["name"])
    如果 (元名 != ""): 设 名 为 元名
  设 结果 为 ["name": 名]
  如果 (字典包含键(预设, "description") == 真 且 是字符串(预设["description"]) == 真):
    设 描 为 去除空白(预设["description"])
    如果 (描 != ""): 设 结果["description"] 为 描
  返回 结果

# =====================================================================
# 四、session.ts —— 投影 reducer（对齐 presetProjection reduce）
# =====================================================================
段落 预设投影初值(状态):
  如果 (字典包含键(状态, "agentPreset") == 真): 返回 状态["agentPreset"]
  返回 空

段落 预设投影应用(当前, 动作):
  如果 (动作["type"] == "agent-preset/selected"): 返回 动作["data"]["agentPreset"]
  返回 当前

# =====================================================================
# 五、discovery.ts —— 发现纯逻辑
# =====================================================================
# 行启用（对齐 row 的 disabled 取反）
段落 行启用(行):
  如果 (字典包含键(行, "disabled") == 真 且 行["disabled"] == 真): 返回 假
  返回 真

# 条目列表形状问题（对齐 entryListProblem，递归处理 group）
#   R87 增量：嵌套 group 的 config 不是列表时，诊断改为 "group <at> must hold a list..."
段落 条目列表问题(列表, 根):
  如果 (是列表(列表) == 假):
    如果 (根 == ""):
      返回 "the composition must be a top-level list of plugin rows"
    返回 "group " + 根 + " must hold a list of plugin rows"
  设 序号 为 0
  遍历 行 之 列表:
    设 序号 为 序号 + 1
    设 位置 为 ""
    如果 (根 == ""):
      设 位置 为 "row " + 转字符串(序号)
    否则:
      设 位置 为 根 + " row " + 转字符串(序号)
    如果 (是字典(行) == 假): 返回 位置 + " is not a plugin row (expected a map with a \"name\")"
    设 名 为 空
    如果 (字典包含键(行, "name") == 真): 设 名 为 行["name"]
    如果 (是字符串(名) == 假 或 名 == ""): 返回 位置 + " names no plugin (a \"name\" string is required)"
    如果 (字典包含键(行, "group") == 真 且 行["group"] == 真):
      设 子 为 空
      如果 (字典包含键(行, "config") == 真): 设 子 为 行["config"]
      设 子问题 为 条目列表问题(子, 位置)
      如果 (子问题 != 空): 返回 子问题
  返回 空

# 不可解析行（对齐 unresolvableRows：跳过 disabled / group 递归 / 行解析能力判定）
段落 不可解析行(行列表, 预设基, 宿主基, 解析能力, 前缀):
  设 找到 为 []
  设 序号 为 0
  遍历 行 之 行列表:
    设 序号 为 序号 + 1
    设 位置 为 ""
    如果 (前缀 == ""):
      设 位置 为 "row " + 转字符串(序号)
    否则:
      设 位置 为 前缀 + " row " + 转字符串(序号)
    如果 (行启用(行) == 假): 继续
    如果 (字典包含键(行, "group") == 真 且 行["group"] == 真):
      设 子 为 空
      如果 (字典包含键(行, "config") == 真): 设 子 为 行["config"]
      设 子结果 为 不可解析行(子, 预设基, 宿主基, 解析能力, 位置)
      遍历 子项 之 子结果: 列表追加(找到, 子项)
      继续
    设 分类 为 分类行标识符(行["name"])
    如果 (解析能力(分类, 预设基, 宿主基) == 假):
      设 标签 为 位置
      如果 (字典包含键(行, "id") == 真 且 是字符串(行["id"]) == 真 且 行["id"] != ""):
        设 标签 为 "row \"" + 行["id"] + "\""
      列表追加(找到, {"标签":标签, "名":行["name"]})
  返回 找到

# 合成文件问题（对齐 compositionProblem）：读 → 解析 → 形状 → 不可解析；宿主能力注入
#
# 注：原版 compositionProblem(path, harnessBase) 只收 2 参，行「是否可解析」由
# 固定的 rowResolves（不注入）判定。复刻时把『YAML 解析能力』与『行解析能力』
# 拆开：解析能力(content)→rows 是入参注入；行解析(分类,预设基,宿主基)→bool 用
# 下方固定内部判定（纯逻辑、无包注册表，package 一律判不可解，对齐原版默认语义）。
段落 预设行解析(分类, 预设基, 宿主基):
  如果 (分类["种类"] == "builtin"): 返回 真
  如果 (分类["种类"] == "preset"): 返回 真
  如果 (分类["种类"] == "file"): 返回 真
  返回 假

段落 合成问题(路径, 宿主基, 读文件能力, 解析能力):
  设 内容 为 空
  尝试:
    设 内容 为 读文件能力(路径)
  捕获 异常 为 e:
    返回 "the composition file agent.cordis.yml cannot be read"
  设 行 为 空
  尝试:
    设 行 为 解析能力(内容)
  捕获 异常 为 e:
    返回 "the composition is not valid YAML: " + 转字符串(e)
  设 形 为 条目列表问题(行, "")
  如果 (形 != 空): 返回 形
  设 不可 为 不可解析行(行, 路径, 宿主基, 预设行解析, "")
  如果 (列表长度(不可) == 0): 返回 空
  如果 (列表长度(不可) == 1):
    设 首 为 列表获取(不可, 0)
    返回 首["标签"] + " names a plugin that cannot be resolved: " + 首["名"]
  设 行文本 为 转字符串(列表长度(不可)) + " rows name plugins that cannot be resolved:"
  遍历 项 之 不可:
    设 行文本 为 行文本 + chr(10) + "- " + 项["标签"] + ": " + 项["名"]
  返回 行文本

# 应前（对齐 scanRoot 稳定排序的比较：先 order 后 id 字典序；缺省 order 视作 +∞）
段落 应前(a, b):
  设 大数 为 9007199254740991
  设 a序 为 大数
  设 b序 为 大数
  如果 (字典包含键(a, "order") == 真 且 是整数(a["order"]) == 真): 设 a序 为 a["order"]
  如果 (字典包含键(b, "order") == 真 且 是整数(b["order"]) == 真): 设 b序 为 b["order"]
  如果 (a序 != b序): 返回 a序 < b序
  设 aid 为 ""
  设 bid 为 ""
  如果 (字典包含键(a, "id") == 真): 设 aid 为 a["id"]
  如果 (字典包含键(b, "id") == 真): 设 bid 为 b["id"]
  返回 aid < bid

# 交换列表 i/j 元素（返回新列表，避免原地替换语义歧义）
段落 交换元素(列表, i, j):
  设 a 为 列表获取(列表, i)
  设 b 为 列表获取(列表, j)
  设 新 为 []
  设 k 为 0
  遍历 项 之 列表:
    如果 (k == i):
      列表追加(新, b)
    否则如果 (k == j):
      列表追加(新, a)
    否则:
      列表追加(新, 项)
    设 k 为 k + 1
  返回 新

# 扫描根排序（对齐 scanRoot 的 order→id 稳定排序，插入排序）
段落 扫描根排序(列表):
  设 结果 为 []
  遍历 项 之 列表: 列表追加(结果, 项)
  设 长 为 列表长度(结果)
  设 i 为 0
  当 (i < 长):
    设 j 为 i + 1
    当 (j < 长):
      设 a 为 列表获取(结果, i)
      设 b 为 列表获取(结果, j)
      如果 (应前(b, a) == 真): 设 结果 为 交换元素(结果, i, j)
      设 j 为 j + 1
    设 i 为 i + 1
  返回 结果

# 发现预设（跨根去重，保留首现；对齐 discoverPresets 的合并）
段落 发现预设(根表):
  设 发现 为 []
  遍历 根 之 根表:
    设 列表 为 []
    如果 (字典包含键(根, "预设列表") == 真): 设 列表 为 根["预设列表"]
    遍历 项 之 列表:
      设 已 为 假
      遍历 已有 之 发现:
        如果 (已有["id"] == 项["id"]): 设 已 为 真
      如果 (已 == 假): 列表追加(发现, 项)
  返回 发现

# =====================================================================
# 六、mount.ts —— 审计纯逻辑
# =====================================================================
# 在纤维内（对齐 withinFiber：沿父链上行命中根即真；父==自身为根顶，未命中则假）
段落 在纤维内(纤维表, 纤维, 根):
  设 当前 为 纤维
  设 已访问 为 []
  当 (列表包含(已访问, 当前) == 假):
    如果 (当前 == 根): 返回 真
    列表追加(已访问, 当前)
    如果 (字典包含键(纤维表, 当前) == 假): 返回 假
    设 父 为 纤维表[当前]["父标识"]
    设 当前 为 父
  返回 假

# 泄出服务（对齐 leakedServices：在根隔离 且 fiber 隶属根，按名排序）
段落 泄出服务(服务, 纤维表, 根):
  设 漏 为 []
  遍历 服务项 之 服务:
    如果 (服务项["在根隔离"] == 假): 继续
    如果 (在纤维内(纤维表, 服务项["fiber标识"], 根) == 假): 继续
    列表追加(漏, 服务项["name"])
  返回 排序名(漏)

# 排序名（对齐服务名 sort）
段落 排序名(列表):
  设 结果 为 []
  遍历 项 之 列表: 列表追加(结果, 项)
  设 长 为 列表长度(结果)
  设 i 为 0
  当 (i < 长):
    设 j 为 i + 1
    当 (j < 长):
      如果 (列表获取(结果, j) < 列表获取(结果, i)): 设 结果 为 交换元素(结果, i, j)
      设 j 为 j + 1
    设 i 为 i + 1
  返回 结果

# 未激活行（对齐 inactiveRows：disabled 跳过；无 fiber→never started；缺注入→waiting for）
段落 未激活行(条目):
  设 结果 为 []
  遍历 行 之 条目:
    如果 (字典包含键(行, "disabled") == 真 且 行["disabled"] == 真): 继续
    设 纤维 为 空
    如果 (字典包含键(行, "fiber") == 真): 设 纤维 为 行["fiber"]
    如果 (纤维 == 空):
      列表追加(结果, 行["id"] + " (" + 行["name"] + "): never started")
      继续
    设 注入 为 []
    如果 (字典包含键(纤维, "inject") == 真): 设 注入 为 纤维["inject"]
    设 已有 为 {}
    如果 (字典包含键(纤维, "已有") == 真): 设 已有 为 纤维["已有"]
    设 缺 为 []
    遍历 服务 之 注入:
      如果 (字典包含键(已有, 服务) == 假): 列表追加(缺, 服务)
    如果 (列表长度(缺) > 0):
      设 缺串 为 ""
      设 k 为 0
      遍历 服务 之 缺:
        如果 (k > 0): 设 缺串 为 缺串 + ", "
        设 缺串 为 缺串 + 服务
        设 k 为 k + 1
      列表追加(结果, 行["id"] + " (" + 行["name"] + "): waiting for " + 缺串)
  返回 结果

# 名文本（对齐 name list 逗号拼接，供审计消息）
段落 名文本(列表):
  设 文本 为 ""
  设 索引 为 0
  遍历 项 之 列表:
    如果 (索引 > 0): 设 文本 为 文本 + ", "
    设 文本 为 文本 + 项
    设 索引 为 索引 + 1
  返回 文本

# 取错误分支（对齐 detailBranches：AggregateError→分支；存在 原因→以原因为单元素分支递归渲染其消息）
# 注：原版对「原因为 AggregateError」会丢 cause.message（lossy），本复刻选择把原因整体作为分支渲染，
#     既保留 mid 行又经递归展开其内层分支，输出更完整（与 test_预设.light 的 明细_嵌套 验收一致）。
段落 明细分支(错误):
  如果 (字典包含键(错误, "分支") == 真 且 是列表(错误["分支"]) == 真): 返回 错误["分支"]
  如果 (字典包含键(错误, "原因") == 真 且 是字典(错误["原因"]) == 真): 返回 [错误["原因"]]
  返回 []

# 挂载失败报告（对齐 mountDetail：递归扁平化，首行 + 缩进分支）
段落 挂载明细(错误):
  如果 (是字典(错误) == 假): 返回 转字符串(错误)
  如果 (字典包含键(错误, "分支") == 假 且 字典包含键(错误, "原因") == 假): 返回 错误["消息"]
  设 换行 为 chr(10)
  设 行文本 为 错误["消息"]
  遍历 分支 之 明细分支(错误):
    设 子 为 挂载明细(分支)
    设 行文本 为 行文本 + 换行 + "- " + 子
  返回 行文本

# =====================================================================
# 七、authoring.ts —— 作者面纯逻辑（剥离 node:fs/cp/rm/chmod/atomic-write）
# =====================================================================
# 可写根：首个 user 根；无则抛（对齐 writableRoot）
段落 可写根(根列表):
  遍历 根 之 根列表:
    如果 (根["trust"] == "user"): 返回 根["path"]
  抛出 新建 错误("agent-presets: this deployment configures no user-writable preset root")

# 可删判定：必须 user + 路径绝对且位于可写根下（对齐 deleteComposition 的两条闸）
段落 可删判定(预设, 可写根目录):
  如果 (预设["trust"] != "user"):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it ships with the deployment")
  如果 (是绝对(预设["path"]) == 假):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it does not live under the writable preset root")
  如果 (前缀是(预设["path"], 可写根目录) == 假):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it does not live under the writable preset root")
  返回 真

# 可复制元数据（对齐 copyMetadata：name 覆盖 + 保留 description）
段落 可复制元数据(源, 名):
  设 结果 为 {"name":名}
  如果 (字典包含键(源, "description") == 真 且 是字符串(源["description"]) == 真): 设 结果["description"] 为 源["description"]
  返回 结果

# =====================================================================
# 八、T-0403 模式提示契约（组合型模式的「控制流向 / 人机介入点 / 终止条件」）
#
#   本段只产出**纯文本与纯数据**，不做任何注入：
#   注入点在 T-0407 收口 —— 调用方取 模式系统提示(预设标识) 塞进 选项["系统提示文本"]，
#   链路是 总入口.light:316-317 → 代理.light:293-297 渲染系统提示。
#   src/系统提示.light 是复刻件，本卡不碰。
#
#   四个新模式（topdown / bottomup / brainstorm / lazy）各一段；shipped 四预设
#   返回空串（它们没有额外注入；空串语义 = 「不追加任何段」）。
#   未知标识也返回空串 —— 注入点是防御性拼接，不该为一个坏 id 打断整轮对话。
# =====================================================================

# 模式系统提示(预设标识) -> 该模式的系统提示段（无则空串）
#   T-0441：标识可能是 "代理+方法" 组合串；提示段只由「方法」维决定，代理维不注入
#   （standard/ptc/minimal/cordis 各自的差异在工具面，不在提示里）。
段落 模式系统提示(预设标识):
  如果 (是字符串(预设标识) == 假): 返回 ""
  设 解 为 解析组合(预设标识)
  如果 (解["ok"] == 假): 返回 ""
  返回 方法系统提示(解["方法"])

段落 方法系统提示(方法标识):
  如果 (方法标识 == "topdown"): 返回 自上而下提示()
  如果 (方法标识 == "bottomup"): 返回 自下而上提示()
  如果 (方法标识 == "brainstorm"): 返回 头脑风暴提示()
  如果 (方法标识 == "lazy"): 返回 懒人提示()
  返回 ""

# 自上而下：计划树是一等产物（控制流向 = 自顶向下分解）
段落 自上而下提示():
  设 行1 为 "## 工作方式：自上而下"
  设 行2 为 ""
  设 行3 为 "先出计划树，再动手。树的每个节点写清三件事：目标、依赖、预估依据（为什么是这个规模）。计划树是一等产物，不是可以随手改口的草稿。"
  设 行4 为 ""
  设 行5 为 "执行时按依赖顺序推进叶子节点；每完成一个节点，回报这个节点的产出和下一批可动节点。要改计划就显式改树并说明为什么改，不要边做边在心里换方案。"
  设 行6 为 ""
  设 行7 为 "## 人机介入点"
  设 行8 为 ""
  设 行9 为 "计划树首次成形时，整棵树提交给用户确认。被拒就改树后重新提交，不要绕开确认直接开写。"
  设 行10 为 ""
  设 行11 为 "## 终止条件"
  设 行12 为 ""
  设 行13 为 "计划树叶子全部完成；或用户拒绝计划且不接受改树；或某节点失败且无法回退到上层节点换路。"
  返回 竖向拼接(行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13)

# 自下而上：无中央规划器（控制流向 = 原子单元驱动）
段落 自下而上提示():
  设 行1 为 "## 工作方式：自下而上"
  设 行2 为 ""
  设 行3 为 "没有中央规划器。先扫出可以独立完成的原子单元（一个文件、一处调用、一条断言），领一个、做完、交回结果，再领下一个。单元之间不要互相等待，也不要为了「全局一致」先搭一层大计划。"
  设 行4 为 ""
  设 行5 为 "本模式不提供目标工具：用单元清单代替目标树，单元的完成度就是进度。"
  设 行6 为 ""
  设 行7 为 "## 人机介入点"
  设 行8 为 ""
  设 行9 为 "不主动请求确认。遇到歧义就按最小改动选一个默认值继续，并把默认值记进该单元的结果里，让人事后能看出来你替他做了什么决定。"
  设 行10 为 ""
  设 行11 为 "## 终止条件"
  设 行12 为 ""
  设 行13 为 "所有已发现单元处理完；或连续两轮以上没有新的有效产出；或到达总轮次 / 成本上限。"
  返回 竖向拼接(行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13)

# 头脑风暴：发散→收敛两阶段，中间硬闸（人机介入点 = 硬闸）
段落 头脑风暴提示():
  设 行1 为 "## 工作方式：头脑风暴"
  设 行2 为 ""
  设 行3 为 "本模式只挂只读工具（读文件 / 搜索文件），不要承诺改代码、也不要假装已经改过。分两个阶段，中间有硬闸。"
  设 行4 为 ""
  设 行5 为 "发散阶段：只发散、不评判。禁止打分，禁止说「不可行」，禁止提前收敛。每个想法写一句主张 + 一句为什么可能成立。"
  设 行6 为 ""
  设 行7 为 "硬闸：发散结束必须显式停下，把想法列成清单交出去，等用户选完再进收敛，不要自问自答地把闸门推过去。"
  设 行8 为 ""
  设 行9 为 "收敛阶段：对留下的方案同时给 Steelman（这个方案最强的版本）与 Devil's Advocate（最致命的反驳），再排序并说明排序依据。"
  设 行10 为 ""
  设 行11 为 "## 终止条件"
  设 行12 为 ""
  设 行13 为 "发散：到最大轮次或用户喊停。收敛：排序连续多轮稳定（名次不再变化）。"
  返回 竖向拼接(行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13)

# 懒人：决策阶梯（控制流向 = 由「不做」向下逐级让步）
段落 懒人提示():
  设 行1 为 "## 工作方式：懒人"
  设 行2 为 ""
  设 行3 为 "按决策阶梯往下走，能用上一级就不用下一级：1) 不做——这件事真的需要做吗；2) 现成的开源项目或服务；3) 现成的开源库；4) 已有依赖或标准库；5) 一行命令 / 一行代码；6) 才写新代码。"
  设 行4 为 ""
  设 行5 为 "进入第 6 级（写新代码）之前，必须留下「方案层已穷尽」的依据：试过哪些现成方案、为什么都不行。"
  设 行6 为 ""
  设 行7 为 "不追问细节：缺参数就选最保守的默认值继续，末尾附一份「默认决策日志」，逐条列出你替用户定的默认值和理由。"
  设 行8 为 ""
  设 行9 为 "## 人机介入点"
  设 行10 为 ""
  设 行11 为 "只在不可逆操作（删数据、对外发送、花钱）之前停下确认，其余一概不打断。"
  设 行12 为 ""
  设 行13 为 "## 终止条件"
  设 行14 为 ""
  设 行15 为 "用户意图以最小必要产物被满足；或触碰不可逆操作的安全边界；或达到硬迭代上限。"
  返回 竖向拼接(行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13, 行14, 行15)

# 竖向拼接(...) -> 用换行把各行接起来（字面量内不写 \n 的替代写法）
#   参数表可空位传 ""（空行）；这是「空行」而不是「缺参」，两者在本仓语义不同。
段落 竖向拼接(行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13, 行14 = "", 行15 = ""):
  设 换行 为 chr(10)
  设 段表 为 [行1, 行2, 行3, 行4, 行5, 行6, 行7, 行8, 行9, 行10, 行11, 行12, 行13, 行14, 行15]
  设 文本 为 ""
  设 序号 为 0
  遍历 行 之 段表:
    如果 (序号 > 0): 设 文本 为 文本 + 换行
    设 文本 为 文本 + 行
    设 序号 为 序号 + 1
  # 尾部多余的空行裁掉（懒人 15 行、其余 13 行，统一按「去掉末尾空行」收口）
  设 长度值 为 字符串长度(文本)
  设 裁剪 为 真
  当 (长度值 > 0 且 裁剪 == 真):
    如果 (文本[长度值 - 1] == 换行):
      设 文本 为 文本[0:长度值 - 1]
      设 长度值 为 长度值 - 1
    否则:
      设 裁剪 为 假
  返回 文本

# 模式终止条件(预设标识) -> 终止条件清单（人可读的短句列表；非新模式返回空列表）
#   与 模式系统提示 的「终止条件」段同源同义，供 T-0407 做完成判定 / UI 展示时不解析自然语言。
段落 模式终止条件(预设标识):
  设 解 为 解析组合(预设标识)
  如果 (解["ok"] == 假):
    返回 []
  设 方法标识 为 解["方法"]
  如果 (方法标识 == "topdown"):
    返回 ["计划树叶子全部完成", "用户拒绝计划且不接受改树", "某节点失败且无法回退"]
  如果 (方法标识 == "bottomup"):
    返回 ["所有已发现单元处理完", "连续两轮以上无新有效产出", "到达总轮次/成本上限"]
  如果 (方法标识 == "brainstorm"):
    返回 ["发散：到最大轮次或用户喊停", "收敛：排序连续多轮稳定"]
  如果 (方法标识 == "lazy"):
    返回 ["用户意图以最小必要产物被满足", "触发不可逆操作安全边界", "达到硬迭代上限"]
  返回 []

# 模式开关表(预设标识) -> 该模式的可调开关默认值；非新模式返回空字典
#   懒人模式的两个开关是 DSH 规格明文要求可调的：minimal_action（最小必要行动）
#   与 no_ask（最少交互自主跑），默认都开。
段落 模式开关表(预设标识):
  设 解 为 解析组合(预设标识)
  如果 (解["ok"] == 假):
    返回 {}
  如果 (解["方法"] == "lazy"):
    返回 {"minimal_action": 真, "no_ask": 真}
  返回 {}

# 需开源检索(预估自写行数) -> 真假
#   懒人模式成本闸：预估自写行数 < 20 行时不触发开源检索
#   （为了少写几行反而先去搜一圈，净成本更高）。
段落 需开源检索(预估自写行数):
  如果 (是整数(预估自写行数) == 假): 返回 真
  如果 (预估自写行数 < 20): 返回 假
  返回 真

# =====================================================================
# 九、T-0497 preset 侧可见性注入（allowedTools / focusedTools）
#
#   preset 是声明式数据（YAML 解析后就是字典），工具面可见性不写死在 registry 里，
#   而是从预设里读两个列表：
#     allowedTools —— 硬白名单（只给「锁死 surface」的子代理用；常规会话不声明）
#     focusedTools —— 软聚焦（常规会话用这个）
#   键名英 / 中两种口径都认；也可以写在预设的 "config" / "选项" 子字典里。
#
#   返回形状固定为 {"allowedTools": [...], "focusedTools": [...]}，
#   没有声明的键给空表 —— 调用方据此判定「未配置 = 行为与改动前一致」。
#   本段只读预设字典，不依赖工具面模块，避免装配层与数据层互相导入。
# =====================================================================

# 读名单键(容器, 键) → 该键下的字符串项（缺键 / 非列表 / 非串项一律跳过；去空白去重）
段落 读名单键(容器, 键):
  设 结果 为 []
  如果 (是字典(容器) == 假): 返回 结果
  如果 (字典包含键(容器, 键) == 假): 返回 结果
  设 原 为 容器[键]
  如果 (是列表(原) == 假): 返回 结果
  遍历 项 之 原:
    如果 (是字符串(项) == 假): 继续
    设 去 为 去除空白(项)
    如果 (去 == ""): 继续
    如果 (列表包含(结果, 去) == 假): 列表追加(结果, 去)
  返回 结果

# 合并名单(甲, 乙) → 甲在前、去掉重复的新列表
段落 合并名单(甲, 乙):
  设 结果 为 []
  遍历 项 之 甲:
    如果 (列表包含(结果, 项) == 假): 列表追加(结果, 项)
  遍历 项 之 乙:
    如果 (列表包含(结果, 项) == 假): 列表追加(结果, 项)
  返回 结果

# 预设可见性层(预设项) → 可能登记可见性键的字典层（自身 + config / 选项 子字典）
段落 预设可见性层(预设项):
  设 层表 为 []
  如果 (是字典(预设项) == 假): 返回 层表
  列表追加(层表, 预设项)
  如果 (字典包含键(预设项, "config") == 真):
    设 配 为 预设项["config"]
    如果 (是字典(配) == 真): 列表追加(层表, 配)
  如果 (字典包含键(预设项, "选项") == 真):
    设 选 为 预设项["选项"]
    如果 (是字典(选) == 真): 列表追加(层表, 选)
  返回 层表

# 预设可见性(预设项) → {"allowedTools": [...], "focusedTools": [...]}
#   空表 = 该预设没有声明可见性，调用方按「未配置」处理（不剪枝、不聚焦）。
段落 预设可见性(预设项):
  设 允许 为 []
  设 聚焦 为 []
  遍历 层 之 预设可见性层(预设项):
    设 允英 为 读名单键(层, "allowedTools")
    设 允中 为 读名单键(层, "允许工具")
    设 聚英 为 读名单键(层, "focusedTools")
    设 聚中 为 读名单键(层, "聚焦工具")
    设 允合 为 合并名单(允英, 允中)
    设 聚合 为 合并名单(聚英, 聚中)
    设 允许 为 合并名单(允许, 允合)
    设 聚焦 为 合并名单(聚焦, 聚合)
  设 结果 为 {"allowedTools": 允许, "focusedTools": 聚焦}
  返回 结果

# =====================================================================
# 导出（对齐原版各 .ts 的导出名）
# =====================================================================
导出 分类行标识符
导出 是绝对
导出 前缀是
