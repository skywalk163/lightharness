# 预设.light —— 对标 #72：agent-presets 纯逻辑复刻
# 原版：packages/preset/agent-presets/src/{specifier,preset,metadata,session,discovery,mount,authoring}.ts
#   （index.ts 装配层 / invariant.ts Cordis 宿主绑定 不在本批白名单，未复刻）
#
# 复刻边界：node:fs / node:path / js-yaml / node:module / Cordis 运行时 一律投影为
#   「入参能力函数 / 注入字典」。fiber 对象同一性 → 标识图（父标识 + 纤维表）；
#   service store → 服务列表（每项 {name,fiber标识,在根隔离}）；YAML 解析 → 解析能力。
#
# 语言坑规避：全部函数用块形式（禁单行 段落 X: 返回/抛出，避免生成器缩进累积）；
#   列表/字典字面量单行；嵌套字面量内不写 \n（用 chr(10) 构造）；错误对象不可当字典。

从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 开头, 去除空白, 字符串包含
从 字符串工具轻量 导入 字符串长度
从 内置核心判型 导入 是整数, 是字符串, 是字典, 是列表
从 内置核心列表 导入 列表追加, 列表包含, 列表获取
从 内置核心字典 导入 字典包含键, 字典键列表

# =====================================================================
# 一、specifier.ts —— 行标识符分类（对齐 classifyRowSpecifier）
# =====================================================================
段落 分类行标识符(标识符):
  如果 (开头(标识符, "cordis:") == 真): 返回 {"种类":"builtin", "标识符":标识符}
  如果 (开头(标识符, "./") == 真 或 开头(标识符, "../") == 真): 返回 {"种类":"preset", "标识符":标识符}
  如果 (开头(标识符, "/") == 真 或 (字符串长度(标识符) >= 2 且 标识符[1] == ":")): 返回 {"种类":"file", "标识符":标识符}
  如果 (开头(标识符, "file:") == 真): 返回 {"种类":"file", "标识符":标识符}
  如果 (开头(标识符, "@") == 真): 返回 {"种类":"package", "标识符":标识符}
  返回 {"种类":"package", "标识符":标识符}

# 是否绝对路径（对齐 isAbsolute：以 / 开头 或 带盘符 X:）
段落 是绝对(路径):
  如果 (路径 == ""): 返回 假
  如果 (开头(路径, "/") == 真): 返回 真
  如果 (字符串长度(路径) >= 2 且 路径[1] == ":"): 返回 真
  返回 假

# 前缀判定（对齐 deleteComposition 的 startsWith 检查）
段落 前缀是(路径, 前缀):
  返回 开头(路径, 前缀)

# =====================================================================
# 二、preset.ts —— 标识校验 + 远程错误构造
# =====================================================================
# 标识合法：非空、首字符非 -、其余仅 [a-z0-9-]（对齐 ^[a-z0-9-]+$）
段落 标识合法(标识):
  如果 (标识 == ""): 返回 假
  如果 (标识[0] == "-"): 返回 假
  设 允许 为 "abcdefghijklmnopqrstuvwxyz0123456789-"
  设 i 为 0
  当 (i < 字符串长度(标识)):
    如果 (字符串包含(允许, 标识[i]) == 假): 返回 假
    设 i 为 i + 1
  返回 真

# 校验预设标识（别名，复用 标识合法）
段落 校验预设标识(标识):
  返回 标识合法(标识)

# 可用文本：空列表→"none"，否则取首元素（对齐 availableText）
段落 可用文本(列表):
  如果 (列表长度(列表) == 0): 返回 "none"
  返回 列表获取(列表, 0)

# 未知道错误（对齐 PresetNotFoundError）
段落 造未知道错误(标识, 可用):
  设 串 为 ""
  设 i 为 0
  当 (i < 列表长度(可用)):
    如果 (i > 0): 设 串 为 串 + ", "
    设 串 为 串 + 转字符串(列表获取(可用, i))
    设 i 为 i + 1
  返回 {"码":"agent-preset-not-found", "消息":"agent-presets: preset \"" + 标识 + "\" not found (available: " + 串 + ")", "详情":{"agentPreset":标识}}

# 锁错误（对齐 PresetLockedError）
段落 造锁错误(会话标识, 预设标识):
  返回 {"码":"agent-preset-locked", "消息":"agent-presets: preset \"" + 预设标识 + "\" is locked by session " + 会话标识, "详情":{"sessionId":会话标识}}

# 挂载错误（对齐 invalid-preset 的 reason 分支）
段落 造挂载错误(预设标识, 理由):
  返回 {"码":"agent-preset-invalid", "消息":"agent-presets: preset \"" + 预设标识 + "\" failed to mount: " + 理由, "详情":{"reason":理由}}

# 只读错误（对齐 read-only preset）
段落 造只读错误(预设标识, 来源):
  返回 {"码":"agent-preset-read-only", "消息":"agent-presets: preset \"" + 预设标识 + "\" is read-only (" + 来源 + ")", "详情":{"source":来源}}

# 坏请求错误
段落 造坏请求错误 ():
  返回 {"码":"bad-request", "消息":"bad request", "详情":{}}

# 内部错误
段落 造内部错误 ():
  返回 {"码":"internal", "消息":"internal error", "详情":{}}

# =====================================================================
# 三、metadata.ts —— 显示元数据
# =====================================================================
# 文本：非串→空；否则去空白，空白串→空（对齐 displayMetadata 的 trim 折叠）
段落 文本(值):
  如果 (是字符串(值) == 假): 返回 空
  设 去 为 去除空白(值)
  如果 (去 == ""): 返回 空
  返回 去

# 提取显示元数据（对齐 extractDisplayMetadata：name/description 非空串、order 整数）
段落 提取显示元数据(元):
  设 结果 为 {}
  如果 (字典包含键(元, "name") == 真 且 是字符串(元["name"]) == 真):
    设 名 为 去除空白(元["name"])
    如果 (名 != ""): 设 结果["name"] 为 名
  如果 (字典包含键(元, "description") == 真 且 是字符串(元["description"]) == 真):
    设 描 为 去除空白(元["description"])
    如果 (描 != ""): 设 结果["description"] 为 描
  如果 (字典包含键(元, "order") == 真 且 是整数(元["order"]) == 真): 设 结果["order"] 为 元["order"]
  返回 结果

# 造显示元数据记录（空则 空，否则返回记录）
段落 造显示元数据记录(元):
  设 结果 为 提取显示元数据(元)
  如果 (列表长度(字典键列表(结果)) == 0): 返回 空
  返回 结果

# 内置 shipped 预设显示文案字典（对齐上游 display.ts BUILT_IN_PRESET_KEYS：
# standard/ptc/minimal/cordis；shipped 预设走字典键，user 预设永不翻译）
段落 内置预设文案(标识):
  设 字典 为 {"standard": ["名称": "标准模式", "描述": "完整的编码 agent。"],
    "ptc": ["名称": "编码模式", "描述": "专注编码的 agent。"],
    "minimal": ["名称": "极简模式", "描述": "最小的可用 agent。"],
    "cordis": ["名称": "组装模式", "描述": "用 Cordis 插件组装 agent。"]}
  如果 (字典包含键(字典, 标识) == 真): 返回 字典[标识]
  返回 空

# 是否内置 shipped 预设（对齐 display.ts isBuiltInPreset）：
#   shipped 预设不自发 name；自报 name 的声明自带文案，不进本地化字典。
段落 是内置预设(预设):
  如果 (是字典(预设) == 假): 返回 假
  如果 (字典包含键(预设, "name") == 真): 返回 假
  如果 (字典包含键(预设, "id") == 假): 返回 假
  返回 内置预设文案(预设["id"]) != 空

# 造显示文本（对齐上游 presetDisplayText：shipped 预设走字典文案；
# 其余预设 name 优先、无 name 回退 id、description 可选原样保留）
段落 造显示文本(预设):
  如果 (是字典(预设) == 假): 返回 空
  设 来源 为 ""
  如果 (字典包含键(预设, "trust") == 真): 设 来源 为 预设["trust"]
  设 标识 为 ""
  如果 (字典包含键(预设, "id") == 真): 设 标识 为 预设["id"]
  如果 (来源 == "system"):
    设 内置 为 内置预设文案(标识)
    如果 (内置 != 空): 返回 ["name": 内置["名称"], "description": 内置["描述"]]
  设 名 为 标识
  如果 (字典包含键(预设, "name") == 真 且 是字符串(预设["name"]) == 真):
    设 元名 为 去除空白(预设["name"])
    如果 (元名 != ""): 设 名 为 元名
  设 结果 为 ["name": 名]
  如果 (字典包含键(预设, "description") == 真 且 是字符串(预设["description"]) == 真):
    设 描 为 去除空白(预设["description"])
    如果 (描 != ""): 设 结果["description"] 为 描
  返回 结果

# =====================================================================
# 四、session.ts —— 投影 reducer（对齐 presetProjection reduce）
# =====================================================================
段落 预设投影初值(状态):
  如果 (字典包含键(状态, "agentPreset") == 真): 返回 状态["agentPreset"]
  返回 空

段落 预设投影应用(当前, 动作):
  如果 (动作["type"] == "agent-preset/selected"): 返回 动作["data"]["agentPreset"]
  返回 当前

# =====================================================================
# 五、discovery.ts —— 发现纯逻辑
# =====================================================================
# 行启用（对齐 row 的 disabled 取反）
段落 行启用(行):
  如果 (字典包含键(行, "disabled") == 真 且 行["disabled"] == 真): 返回 假
  返回 真

# 条目列表形状问题（对齐 entryListProblem，递归处理 group）
#   R87 增量：嵌套 group 的 config 不是列表时，诊断改为 "group <at> must hold a list..."
段落 条目列表问题(列表, 根):
  如果 (是列表(列表) == 假):
    如果 (根 == ""):
      返回 "the composition must be a top-level list of plugin rows"
    返回 "group " + 根 + " must hold a list of plugin rows"
  设 序号 为 0
  遍历 行 之 列表:
    设 序号 为 序号 + 1
    设 位置 为 ""
    如果 (根 == ""):
      设 位置 为 "row " + 转字符串(序号)
    否则:
      设 位置 为 根 + " row " + 转字符串(序号)
    如果 (是字典(行) == 假): 返回 位置 + " is not a plugin row (expected a map with a \"name\")"
    设 名 为 空
    如果 (字典包含键(行, "name") == 真): 设 名 为 行["name"]
    如果 (是字符串(名) == 假 或 名 == ""): 返回 位置 + " names no plugin (a \"name\" string is required)"
    如果 (字典包含键(行, "group") == 真 且 行["group"] == 真):
      设 子 为 空
      如果 (字典包含键(行, "config") == 真): 设 子 为 行["config"]
      设 子问题 为 条目列表问题(子, 位置)
      如果 (子问题 != 空): 返回 子问题
  返回 空

# 不可解析行（对齐 unresolvableRows：跳过 disabled / group 递归 / 行解析能力判定）
段落 不可解析行(行列表, 预设基, 宿主基, 解析能力, 前缀):
  设 找到 为 []
  设 序号 为 0
  遍历 行 之 行列表:
    设 序号 为 序号 + 1
    设 位置 为 ""
    如果 (前缀 == ""):
      设 位置 为 "row " + 转字符串(序号)
    否则:
      设 位置 为 前缀 + " row " + 转字符串(序号)
    如果 (行启用(行) == 假): 继续
    如果 (字典包含键(行, "group") == 真 且 行["group"] == 真):
      设 子 为 空
      如果 (字典包含键(行, "config") == 真): 设 子 为 行["config"]
      设 子结果 为 不可解析行(子, 预设基, 宿主基, 解析能力, 位置)
      遍历 子项 之 子结果: 列表追加(找到, 子项)
      继续
    设 分类 为 分类行标识符(行["name"])
    如果 (解析能力(分类, 预设基, 宿主基) == 假):
      设 标签 为 位置
      如果 (字典包含键(行, "id") == 真 且 是字符串(行["id"]) == 真 且 行["id"] != ""):
        设 标签 为 "row \"" + 行["id"] + "\""
      列表追加(找到, {"标签":标签, "名":行["name"]})
  返回 找到

# 合成文件问题（对齐 compositionProblem）：读 → 解析 → 形状 → 不可解析；宿主能力注入
#
# 注：原版 compositionProblem(path, harnessBase) 只收 2 参，行「是否可解析」由
# 固定的 rowResolves（不注入）判定。复刻时把『YAML 解析能力』与『行解析能力』
# 拆开：解析能力(content)→rows 是入参注入；行解析(分类,预设基,宿主基)→bool 用
# 下方固定内部判定（纯逻辑、无包注册表，package 一律判不可解，对齐原版默认语义）。
段落 预设行解析(分类, 预设基, 宿主基):
  如果 (分类["种类"] == "builtin"): 返回 真
  如果 (分类["种类"] == "preset"): 返回 真
  如果 (分类["种类"] == "file"): 返回 真
  返回 假

段落 合成问题(路径, 宿主基, 读文件能力, 解析能力):
  设 内容 为 空
  尝试:
    设 内容 为 读文件能力(路径)
  捕获 异常 为 e:
    返回 "the composition file agent.cordis.yml cannot be read"
  设 行 为 空
  尝试:
    设 行 为 解析能力(内容)
  捕获 异常 为 e:
    返回 "the composition is not valid YAML: " + 转字符串(e)
  设 形 为 条目列表问题(行, "")
  如果 (形 != 空): 返回 形
  设 不可 为 不可解析行(行, 路径, 宿主基, 预设行解析, "")
  如果 (列表长度(不可) == 0): 返回 空
  如果 (列表长度(不可) == 1):
    设 首 为 列表获取(不可, 0)
    返回 首["标签"] + " names a plugin that cannot be resolved: " + 首["名"]
  设 行文本 为 转字符串(列表长度(不可)) + " rows name plugins that cannot be resolved:"
  遍历 项 之 不可:
    设 行文本 为 行文本 + chr(10) + "- " + 项["标签"] + ": " + 项["名"]
  返回 行文本

# 应前（对齐 scanRoot 稳定排序的比较：先 order 后 id 字典序；缺省 order 视作 +∞）
段落 应前(a, b):
  设 大数 为 9007199254740991
  设 a序 为 大数
  设 b序 为 大数
  如果 (字典包含键(a, "order") == 真 且 是整数(a["order"]) == 真): 设 a序 为 a["order"]
  如果 (字典包含键(b, "order") == 真 且 是整数(b["order"]) == 真): 设 b序 为 b["order"]
  如果 (a序 != b序): 返回 a序 < b序
  设 aid 为 ""
  设 bid 为 ""
  如果 (字典包含键(a, "id") == 真): 设 aid 为 a["id"]
  如果 (字典包含键(b, "id") == 真): 设 bid 为 b["id"]
  返回 aid < bid

# 交换列表 i/j 元素（返回新列表，避免原地替换语义歧义）
段落 交换元素(列表, i, j):
  设 a 为 列表获取(列表, i)
  设 b 为 列表获取(列表, j)
  设 新 为 []
  设 k 为 0
  遍历 项 之 列表:
    如果 (k == i):
      列表追加(新, b)
    否则如果 (k == j):
      列表追加(新, a)
    否则:
      列表追加(新, 项)
    设 k 为 k + 1
  返回 新

# 扫描根排序（对齐 scanRoot 的 order→id 稳定排序，插入排序）
段落 扫描根排序(列表):
  设 结果 为 []
  遍历 项 之 列表: 列表追加(结果, 项)
  设 长 为 列表长度(结果)
  设 i 为 0
  当 (i < 长):
    设 j 为 i + 1
    当 (j < 长):
      设 a 为 列表获取(结果, i)
      设 b 为 列表获取(结果, j)
      如果 (应前(b, a) == 真): 设 结果 为 交换元素(结果, i, j)
      设 j 为 j + 1
    设 i 为 i + 1
  返回 结果

# 发现预设（跨根去重，保留首现；对齐 discoverPresets 的合并）
段落 发现预设(根表):
  设 发现 为 []
  遍历 根 之 根表:
    设 列表 为 []
    如果 (字典包含键(根, "预设列表") == 真): 设 列表 为 根["预设列表"]
    遍历 项 之 列表:
      设 已 为 假
      遍历 已有 之 发现:
        如果 (已有["id"] == 项["id"]): 设 已 为 真
      如果 (已 == 假): 列表追加(发现, 项)
  返回 发现

# =====================================================================
# 六、mount.ts —— 审计纯逻辑
# =====================================================================
# 在纤维内（对齐 withinFiber：沿父链上行命中根即真；父==自身为根顶，未命中则假）
段落 在纤维内(纤维表, 纤维, 根):
  设 当前 为 纤维
  设 已访问 为 []
  当 (列表包含(已访问, 当前) == 假):
    如果 (当前 == 根): 返回 真
    列表追加(已访问, 当前)
    如果 (字典包含键(纤维表, 当前) == 假): 返回 假
    设 父 为 纤维表[当前]["父标识"]
    设 当前 为 父
  返回 假

# 泄出服务（对齐 leakedServices：在根隔离 且 fiber 隶属根，按名排序）
段落 泄出服务(服务, 纤维表, 根):
  设 漏 为 []
  遍历 服务项 之 服务:
    如果 (服务项["在根隔离"] == 假): 继续
    如果 (在纤维内(纤维表, 服务项["fiber标识"], 根) == 假): 继续
    列表追加(漏, 服务项["name"])
  返回 排序名(漏)

# 排序名（对齐服务名 sort）
段落 排序名(列表):
  设 结果 为 []
  遍历 项 之 列表: 列表追加(结果, 项)
  设 长 为 列表长度(结果)
  设 i 为 0
  当 (i < 长):
    设 j 为 i + 1
    当 (j < 长):
      如果 (列表获取(结果, j) < 列表获取(结果, i)): 设 结果 为 交换元素(结果, i, j)
      设 j 为 j + 1
    设 i 为 i + 1
  返回 结果

# 未激活行（对齐 inactiveRows：disabled 跳过；无 fiber→never started；缺注入→waiting for）
段落 未激活行(条目):
  设 结果 为 []
  遍历 行 之 条目:
    如果 (字典包含键(行, "disabled") == 真 且 行["disabled"] == 真): 继续
    设 纤维 为 空
    如果 (字典包含键(行, "fiber") == 真): 设 纤维 为 行["fiber"]
    如果 (纤维 == 空):
      列表追加(结果, 行["id"] + " (" + 行["name"] + "): never started")
      继续
    设 注入 为 []
    如果 (字典包含键(纤维, "inject") == 真): 设 注入 为 纤维["inject"]
    设 已有 为 {}
    如果 (字典包含键(纤维, "已有") == 真): 设 已有 为 纤维["已有"]
    设 缺 为 []
    遍历 服务 之 注入:
      如果 (字典包含键(已有, 服务) == 假): 列表追加(缺, 服务)
    如果 (列表长度(缺) > 0):
      设 缺串 为 ""
      设 k 为 0
      遍历 服务 之 缺:
        如果 (k > 0): 设 缺串 为 缺串 + ", "
        设 缺串 为 缺串 + 服务
        设 k 为 k + 1
      列表追加(结果, 行["id"] + " (" + 行["name"] + "): waiting for " + 缺串)
  返回 结果

# 名文本（对齐 name list 逗号拼接，供审计消息）
段落 名文本(列表):
  设 文本 为 ""
  设 索引 为 0
  遍历 项 之 列表:
    如果 (索引 > 0): 设 文本 为 文本 + ", "
    设 文本 为 文本 + 项
    设 索引 为 索引 + 1
  返回 文本

# 取错误分支（对齐 detailBranches：AggregateError→分支；存在 原因→以原因为单元素分支递归渲染其消息）
# 注：原版对「原因为 AggregateError」会丢 cause.message（lossy），本复刻选择把原因整体作为分支渲染，
#     既保留 mid 行又经递归展开其内层分支，输出更完整（与 test_预设.light 的 明细_嵌套 验收一致）。
段落 明细分支(错误):
  如果 (字典包含键(错误, "分支") == 真 且 是列表(错误["分支"]) == 真): 返回 错误["分支"]
  如果 (字典包含键(错误, "原因") == 真 且 是字典(错误["原因"]) == 真): 返回 [错误["原因"]]
  返回 []

# 挂载失败报告（对齐 mountDetail：递归扁平化，首行 + 缩进分支）
段落 挂载明细(错误):
  如果 (是字典(错误) == 假): 返回 转字符串(错误)
  如果 (字典包含键(错误, "分支") == 假 且 字典包含键(错误, "原因") == 假): 返回 错误["消息"]
  设 换行 为 chr(10)
  设 行文本 为 错误["消息"]
  遍历 分支 之 明细分支(错误):
    设 子 为 挂载明细(分支)
    设 行文本 为 行文本 + 换行 + "- " + 子
  返回 行文本

# =====================================================================
# 七、authoring.ts —— 作者面纯逻辑（剥离 node:fs/cp/rm/chmod/atomic-write）
# =====================================================================
# 可写根：首个 user 根；无则抛（对齐 writableRoot）
段落 可写根(根列表):
  遍历 根 之 根列表:
    如果 (根["trust"] == "user"): 返回 根["path"]
  抛出 新建 错误("agent-presets: this deployment configures no user-writable preset root")

# 可删判定：必须 user + 路径绝对且位于可写根下（对齐 deleteComposition 的两条闸）
段落 可删判定(预设, 可写根目录):
  如果 (预设["trust"] != "user"):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it ships with the deployment")
  如果 (是绝对(预设["path"]) == 假):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it does not live under the writable preset root")
  如果 (前缀是(预设["path"], 可写根目录) == 假):
    抛出 新建 错误("agent-presets: preset \"" + 预设["id"] + "\" cannot be written: it does not live under the writable preset root")
  返回 真

# 可复制元数据（对齐 copyMetadata：name 覆盖 + 保留 description）
段落 可复制元数据(源, 名):
  设 结果 为 {"name":名}
  如果 (字典包含键(源, "description") == 真 且 是字符串(源["description"]) == 真): 设 结果["description"] 为 源["description"]
  返回 结果

