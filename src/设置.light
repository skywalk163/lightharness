# 设置（settings）子系统 —— 对照原版 packages/settings
#
# 原版 settings 是 Cordis 服务 + schemastery 模式解析，无法整体复刻。
# 这里 1:1 复刻其纯逻辑核心（与模式/存储无关、可独立测试）：
#   1) settingsNamespace(value)：小写 kebab-case 校验 /^[a-z][a-z0-9-]*$/
#   2) deepEqualJson：JSON 兼容数据的结构相等
#   3) mergeLayers：plain-object 递归合并，非对象整体覆盖（数组亦整体替换）
#   4) redactSecrets：沿 object/dict/array 容器剥离 role('secret') 字段并记录位置
#      这里用光明原生「模式描述符」表达 schemastery 模式：
#        { "类型":"对象", "属性": {键: 子模式} }
#        { "类型":"字典", "内": 子模式 }
#        { "类型":"数组", "内": 子模式 }
#        { "角色":"secret" }  <- 标记秘密字段

从 字符串处理 导入 匹配正则
从 JSON 导入 序列化JSON
从 内置核心字典 导入 字典删除

# 命名空间校验：小写 kebab-case
段落 设置命名空间(值):
  如果 匹配正则(值, "^[a-z][a-z0-9-]*$") == 假:
    抛出 新建 错误("设置命名空间 \"" 加上 值 加上 "\" 必须匹配 ^[a-z][a-z0-9-]*$")
  返回 值

# JSON 兼容数据的结构相等
段落 深度相等(甲, 乙):
  如果 甲 == 乙:
    返回 真
  如果 是字典(甲) 且 是字典(乙):
    如果 列表长度(字典键列表(甲)) != 列表长度(字典键列表(乙)):
      返回 假
    遍历 键 之 字典键列表(甲):
      如果 字典包含键(乙, 键) == 假:
        返回 假
      如果 深度相等(字典获取(甲, 键), 字典获取(乙, 键)) == 假:
        返回 假
    返回 真
  如果 是列表(甲) 且 是列表(乙):
    如果 列表长度(甲) != 列表长度(乙):
      返回 假
    设 i 为 0
    当 i < 列表长度(甲):
      如果 深度相等(列表获取(甲, i), 列表获取(乙, i)) == 假:
        返回 假
      设 i 为 i + 1
    返回 真
  返回 假

# 分层合并：plain-object 递归合并；任意一侧非 plain-object 则上層整体覆盖
段落 分层合并(底, 上):
  如果 上 == 空:
    返回 底
  如果 是字典(底) == 假 或 是字典(上) == 假:
    返回 上
  设 合并 为 字典创建()
  遍历 键 之 字典键列表(底):
    字典设置(合并, 键, 字典获取(底, 键))
  遍历 键 之 字典键列表(上):
    如果 字典包含键(底, 键):
      字典设置(合并, 键, 分层合并(字典获取(底, 键), 字典获取(上, 键)))
    否则:
      字典设置(合并, 键, 字典获取(上, 键))
  返回 合并

# 沿路径新建一个副本（避免共享可变路径数组）
段落 路径追加(路径, 段):
  设 新 为 列表创建()
  遍历 p 之 路径:
    列表追加(新, p)
  列表追加(新, 段)
  返回 新

# 脱敏：剥离秘密字段并记录位置（R87：同路径多分支命中去重，set 取 OR）
段落 脱敏值(模式, 值):
  设 秘密 为 列表创建()
  设 结果 为 走查(模式, 值, 列表创建(), 秘密)
  设 位置表 为 {}
  遍历 条 之 秘密:
    设 键 为 序列化JSON(条["路径"])
    设 旧 为 取可选(位置表, 键, 空)
    如果 旧 == 空:
      字典设置(位置表, 键, {"路径": 条["路径"], "设置": 条["设置"]})
    否则:
      如果 条["设置"]:
        字典设置(位置表, 键, {"路径": 条["路径"], "设置": 真})
  设 去重 为 []
  遍历 键 之 字典键列表(位置表):
    列表追加(去重, 位置表[键])
  返回 { "值": 结果, "秘密": 去重 }

段落 走查(模式, 值, 路径, 秘密):
  如果 字典包含键(模式, "角色") 且 模式["角色"] == "secret":
    列表追加(秘密, { "路径": 路径, "设置": 值 != 空 })
    返回 空
  设 类型 为 模式["类型"]
  如果 类型 == "对象":
    设 属性 为 模式["属性"]
    设 重建 为 字典创建()
    遍历 键 之 字典键列表(属性):
      设 子值 为 空
      如果 是字典(值) 且 字典包含键(值, 键):
        设 子值 为 字典获取(值, 键)
      设 子 为 走查(字典获取(属性, 键), 子值, 路径追加(路径, 键), 秘密)
      如果 子 != 空:
        字典设置(重建, 键, 子)
    # 未声明的键原样保留（schemastery 只声明已知属性）
    如果 是字典(值):
      遍历 键 之 字典键列表(值):
        如果 字典包含键(属性, 键) == 假:
          字典设置(重建, 键, 字典获取(值, 键))
    # 值本身不是对象（或剥离后为空）时原样保留原值，与原版一致
    如果 是字典(值) == 假 且 列表长度(字典键列表(重建)) == 0:
      返回 值
    返回 重建
  如果 类型 == "字典":
    设 重建 为 字典创建()
    如果 是字典(值):
      遍历 键 之 字典键列表(值):
        字典设置(重建, 键, 走查(模式["内"], 字典获取(值, 键), 路径追加(路径, 键), 秘密))
    返回 重建
  如果 类型 == "数组":
    设 重建 为 列表创建()
    如果 是列表(值):
      遍历 项 之 值:
        列表追加(重建, 走查(模式["内"], 项, 路径追加(路径, "*"), 秘密))
    返回 重建
  # R87：union/intersect 逐分支走查，把当前值穿过去（保守剥离任一分支声明的秘密）
  如果 类型 == "联合" 或 类型 == "交叉":
    设 当前 为 值
    遍历 子 之 取可选(模式, "表", []):
      设 当前 为 走查(子, 当前, 路径, 秘密)
    返回 当前
  # R87：transform 透传到内层模式
  如果 类型 == "变换":
    返回 走查(模式["内"], 值, 路径, 秘密)
  返回 值

# =====================================================================
# R87 增量：schema.ts —— 从 Config 模式派生可编辑表单与脱机值（纯逻辑面）
#   上游 packages/settings/settings/src/schema.ts
#   schemastery 运行时投影为本地模式描述符：
#     {"类型":"对象","属性":{键:子}} / {"类型":"字典","内":子} / {"类型":"数组","内":子}
#     {"类型":"联合","表":[...]} / {"类型":"交叉","表":[...]} / {"类型":"变换","内":子}
#     {"角色":"secret"} / {"易变":真} / {"默认":值} / {"必填":真}
#   isVolatile(value).get() 是宿主运行时取值，纯逻辑面跳过（仅做容器脱机）。
# =====================================================================

# plainConfig：脱机——列表逐项、字典逐值递归；标量原样（volatile 取值属宿主面）
段落 普通配置(值):
  如果 是列表(值):
    设 出 为 []
    遍历 项 之 值:
      列表追加(出, 普通配置(项))
    返回 出
  如果 是字典(值):
    设 出 为 {}
    遍历 键 之 字典键列表(值):
      字典设置(出, 键, 普通配置(值[键]))
    返回 出
  返回 值

# 深度克隆模式（展示模式 在副本上改写，不污染源模式）
段落 克隆模式(模式):
  如果 是列表(模式):
    设 出 为 []
    遍历 项 之 模式:
      列表追加(出, 克隆模式(项))
    返回 出
  如果 是字典(模式):
    设 出 为 {}
    遍历 键 之 字典键列表(模式):
      字典设置(出, 键, 克隆模式(模式[键]))
    返回 出
  返回 模式

# plainSchema 的深度走查：去易变标记；secret 删默认/必填；否则脱敏默认值；递归子模式
段落 深度走查模式(节点):
  如果 字典包含键(节点, "易变"):
    字典删除(节点, "易变")
  如果 字典包含键(节点, "角色") 且 节点["角色"] == "secret":
    如果 字典包含键(节点, "默认"):
      字典删除(节点, "默认")
    如果 字典包含键(节点, "必填"):
      字典删除(节点, "必填")
  否则:
    如果 字典包含键(节点, "默认"):
      设 脱敏 为 走查(节点, 节点["默认"], 列表创建(), 列表创建())
      字典设置(节点, "默认", 脱敏)
  如果 字典包含键(节点, "属性"):
    遍历 键 之 字典键列表(节点["属性"]):
      深度走查模式(节点["属性"][键])
  如果 字典包含键(节点, "内"):
    深度走查模式(节点["内"])
  如果 字典包含键(节点, "表"):
    遍历 项 之 节点["表"]:
      深度走查模式(项)

段落 展示模式(模式):
  设 副本 为 克隆模式(模式)
  深度走查模式(副本)
  返回 副本

# volatileForm：模式自身易变→整表展示；对象→仅保留可活的子字段；否则空
段落 易变表单(模式):
  如果 字典包含键(模式, "易变"):
    返回 展示模式(模式)
  如果 字典获取(模式, "类型", 空) == "对象":
    设 属性 为 取可选(模式, "属性", {})
    设 新 为 {}
    遍历 键 之 字典键列表(属性):
      设 子 为 易变表单(属性[键])
      如果 子 != 空:
        字典设置(新, 键, 子)
    如果 列表长度(字典键列表(新)) == 0:
      返回 空
    返回 {"类型": "对象", "属性": 新}
  返回 空

# isExpression：未求值的 !!js 单键节点（整值保留，不逐字段投影）
段落 是表达式(值):
  如果 是字典(值) == 假:
    返回 假
  如果 列表长度(字典键列表(值)) != 1:
    返回 假
  如果 字典包含键(值, "__jsExpr") == 假:
    返回 假
  返回 是字符串(值["__jsExpr"])

# projectForm：对象模式且值是普通字典时只投影声明字段；表达式节点整体保留
段落 投影表单(模式, 值):
  如果 字典获取(模式, "类型", 空) == "对象" 且 是字典(值) 且 是表达式(值) == 假:
    设 属性 为 取可选(模式, "属性", {})
    设 出 为 {}
    遍历 键 之 字典键列表(属性):
      如果 字典包含键(值, 键):
        字典设置(出, 键, 投影表单(属性[键], 值[键]))
    返回 出
  返回 值

# isVolatilePath：路径是否落在某个易变节点之下
段落 是易变路径(模式, 路径):
  如果 字典包含键(模式, "易变"):
    返回 真
  如果 列表长度(路径) == 0:
    返回 假
  如果 字典获取(模式, "类型", 空) != "对象":
    返回 假
  设 键 为 列表获取(路径, 0)
  设 属性 为 取可选(模式, "属性", {})
  如果 字典包含键(属性, 键) == 假:
    返回 假
  设 余 为 []
  设 i 为 1
  当 i < 列表长度(路径):
    列表追加(余, 路径[i])
    设 i 为 i + 1
  返回 是易变路径(属性[键], 余)
