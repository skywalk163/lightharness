# 客户端语言设置.light —— R87 B4 第3组：client/locale/locale-settings.ts 纯逻辑
#
# 上游（锚点 877717787c）：packages/client/locale/src/locale-settings.ts
#   命名空间 locale / 偏好字段 preference / BCP47 语言标识正则 / 内置语言 [zh,en]
#
# 纯逻辑剥离：schemastery schema、浏览器 navigator 兜底、UI 语言选择行已剔除；
#   这里只搬常量、语言标识正则校验与设置段归一。

从 字符串处理 导入 字符转ASCII

设 语言设置命名空间 为 "locale"
设 语言偏好字段 为 "preference"
设 内置语言表 为 ["zh", "en"]

# BCP47 标识字符：字母或数字
段落 标识字(字符):
  设 码 为 字符转ASCII(字符)
  如果 码 >= 65 且 码 <= 90:
    返回 真
  如果 码 >= 97 且 码 <= 122:
    返回 真
  如果 码 >= 48 且 码 <= 57:
    返回 真
  返回 假

段落 字母字(字符):
  设 码 为 字符转ASCII(字符)
  如果 码 >= 65 且 码 <= 90:
    返回 真
  如果 码 >= 97 且 码 <= 122:
    返回 真
  返回 假

# LOCALE_ID_PATTERN = /^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$/u
段落 校验语言标识(值):
  如果 是字符串(值) == 假:
    返回 假
  设 长 为 字符串长度(值)
  如果 长 < 2:
    返回 假
  # 首段 2..8 字母
  设 i 为 0
  设 段长 为 0
  当 i < 长 且 字母字(值[i]):
    设 段长 为 段长 + 1
    设 i 为 i + 1
  如果 段长 < 2 或 段长 > 8:
    返回 假
  # 后续 -[A-Za-z0-9]{1,8}
  当 i < 长:
    如果 值[i] != "-":
      返回 假
    设 i 为 i + 1
    设 子段 为 0
    当 i < 长 且 字母字(值[i]):
      设 子段 为 子段 + 1
      设 i 为 i + 1
    如果 子段 < 1 或 子段 > 8:
      返回 假
  返回 真

# 归一语言设置段：缺 preference → {}；有则必须通过标识校验
段落 归一语言设置(原始):
  设 段 为 {}
  如果 是字典(原始) == 假:
    返回 段
  如果 字典包含键(原始, 语言偏好字段):
    设 值 为 原始[语言偏好字段]
    如果 校验语言标识(值) == 假:
      抛出 新建 错误("locale: 非法语言偏好 \"" + 转字符串(值) + "\"")
    设 段[语言偏好字段] 为 值
  返回 段

导出 语言设置命名空间
导出 语言偏好字段
导出 内置语言表
导出 校验语言标识
导出 归一语言设置
