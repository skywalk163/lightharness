# 双端队列.light —— 对标原版 packages/util/deque/src/index.ts
# 纯逻辑核心：环形缓冲双端队列，摊销 O(1) 插入/弹出；MIN_CAPACITY=16；
# 实占数掉到容量 1/4 时收缩。已弹出项立即清空引用。
# 上游导出（Deque 类）：pushBack / pushFront / popFront / clear / size。
# 差异：上游无 popBack，本模块严格对齐（只实现队首弹出）。

设 最小容量 为 16

# 造一个长度为 容量、初始全为空 的缓冲。
段落 造缓冲 接收 容量:
  设 缓冲 为 []
  设 i 为 0
  当 i < 容量:
    缓冲.追加(空)
    设 i 为 i + 1
  返回 缓冲

类 双端队列:
  属性 缓冲 等于 空
  属性 头 等于 空
  属性 计数 等于 空

  段落 构造:
    设 己.缓冲 为 造缓冲(最小容量)
    设 己.头 为 0
    设 己.计数 为 0

  # 当前可移除项数
  段落 大小:
    返回 己.计数

  # 队尾追加
  段落 队尾推入 接收 值:
    己.确保容量()
    设 尾 为 (己.头 + 己.计数) % 长(己.缓冲)
    设 己.缓冲[尾] 为 值
    设 己.计数 为 己.计数 + 1

  # 队首前置
  段落 队首推入 接收 值:
    己.确保容量()
    设 新头 为 己.头 - 1
    如果 新头 < 0:
      设 新头 为 长(己.缓冲) - 1
    设 己.头 为 新头
    设 己.缓冲[己.头] 为 值
    设 己.计数 为 己.计数 + 1

  # 移除并返回队首；空队列返回 空。
  段落 队首弹出:
    如果 己.计数 == 0:
      返回 空
    设 值 为 己.缓冲[己.头]
    设 己.缓冲[己.头] 为 空
    设 己.头 为 己.头 + 1
    如果 己.头 == 长(己.缓冲):
      设 己.头 为 0
    设 己.计数 为 己.计数 - 1
    己.收缩()
    返回 值

  # 清空并释放当前缓冲
  段落 清空:
    设 己.缓冲 为 造缓冲(最小容量)
    设 己.头 为 0
    设 己.计数 为 0

  # 私有：容量不足则翻倍
  段落 确保容量:
    如果 己.计数 < 长(己.缓冲):
      返回 真
    己.重设(长(己.缓冲) * 2)
    返回 真

  # 私有：稀疏时收缩
  段落 收缩:
    如果 己.计数 == 0:
      设 己.头 为 0
      返回 真
    如果 长(己.缓冲) > 最小容量 且 己.计数 <= 长(己.缓冲) // 4:
      设 新容 为 长(己.缓冲) // 2
      如果 新容 < 最小容量:
        设 新容 为 最小容量
      己.重设(新容)
    返回 真

  # 私有：按当前逻辑顺序重排到新缓冲
  段落 重设 接收 容量:
    设 新缓冲 为 造缓冲(容量)
    设 源 为 己.头
    设 索引 为 0
    当 索引 < 己.计数:
      设 新缓冲[索引] 为 己.缓冲[源]
      设 源 为 源 + 1
      如果 源 == 长(己.缓冲):
        设 源 为 0
      设 索引 为 索引 + 1
    设 己.缓冲 为 新缓冲
    设 己.头 为 0
    返回 真
