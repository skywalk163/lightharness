# 网页搜索.light —— 对标原版 packages/web（tool-web/search.ts + fetch.ts +
#   web-search-exa/provider.ts + web-search-deepseek/provider.ts +
#   web-search-perplexity/provider.ts）纯逻辑核心
#
# 复刻范围：搜索参数校验/去重、结果按 URL 去重+轮次合并+截断、
#   转换深度栈检测、正文渲染与截断、三个 provider 归一化。
#
# 不可移植缺口（与原版一致，本模块只复刻纯逻辑层）：
#   - 原版 Cordis Service / 事件发射 / 真实网络 IO 全部剔除；
#     IO 抽象成入参（转换器函数可空注入），保留可断言行为。
#   - 原版用 turndown 做 HTML→Markdown；本模块将转换器抽象为可选入参，
#     传 空 时 HTML 原样透传（模拟"转换不可用"），深度检测仍生效。
#   - 原版用 Set 去重；光明用字典模拟集合（键=URL，值=真）。
#   - 原版用 URL 构造器取 hostname；光明手写提取主机名。
#   - 原版标签名用正则 /[a-zA-Z0-9-]/；光明手写 ASCII 码点判定。

从 字符串处理 导入 截取, 字符转ASCII
从 字符串工具 导入 去除首尾空白

# ---------- 常量 ----------
最大转换深度 = 512
自闭合标签集 = " area base br col embed hr img input link meta param source track wbr "
原文标签集 = " script style noscript "
截断尾注 = "\n\n(Content truncated. Fetch a more specific URL or section for the full text.)"
正文截断限 = 100000

大写集 = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
小写集 = "abcdefghijklmnopqrstuvwxyz"

# ---------- 字符 / 字符串工具 ----------

# 在 文本 中从 起点 开始查找 字符 的首个位置，找不到返回 -1
段落 查找字符 接收 文本, 字符, 起点:
  设 n 为 字符串长度(文本)
  设 i 为 起点
  当 i < n:
    如果 字符串获取(文本, i) == 字符:
      返回 i
    设 i 为 i + 1
  返回 -1

# 在 文本 中从 起点 开始查找 子串 的首个位置，找不到返回 -1
段落 查找子串 接收 文本, 子串, 起点:
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  如果 m == 0:
    返回 起点
  设 i 为 起点
  当 i <= n - m:
    设 j 为 0
    设 找到 为 真
    当 j < m:
      如果 字符串获取(文本, i + j) != 字符串获取(子串, j):
        设 找到 为 假
        设 j 为 m
      设 j 为 j + 1
    如果 找到:
      返回 i
    设 i 为 i + 1
  返回 -1

# 将大写字母转小写，其余字符不变
段落 转小写 接收 文本:
  设 结果 为 ""
  设 i 为 0
  设 n 为 字符串长度(文本)
  当 i < n:
    设 c 为 字符串获取(文本, i)
    设 位置 为 查找字符(大写集, c, 0)
    如果 位置 >= 0:
      设 结果 为 结果 + 字符串获取(小写集, 位置)
    否则:
      设 结果 为 结果 + c
    设 i 为 i + 1
  返回 结果

段落 是空白 接收 c:
  如果 c == " ":
    返回 真
  如果 c == "\t":
    返回 真
  如果 c == "\n":
    返回 真
  如果 c == "\r":
    返回 真
  返回 假

# 判断字符串是否为空或全空白
段落 是全空白 接收 s:
  如果 字符串长度(s) == 0:
    返回 真
  设 i 为 0
  设 n 为 字符串长度(s)
  当 i < n:
    如果 是空白(字符串获取(s, i)) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

# 判断字符是否为 [a-zA-Z0-9-]
段落 是字母数字或横线 接收 c:
  设 code 为 字符转ASCII(c)
  如果 code >= 48:
    如果 code <= 57:
      返回 真
  如果 code >= 65:
    如果 code <= 90:
      返回 真
  如果 code >= 97:
    如果 code <= 122:
      返回 真
  如果 c == "-":
    返回 真
  返回 假

# 判断字符是否为标签边界（undefined / > / / / 空白）
段落 是标签边界 接收 c:
  如果 c == 空:
    返回 真
  如果 c == ">":
    返回 真
  如果 c == "/":
    返回 真
  如果 是空白(c):
    返回 真
  返回 假

# 判断 文本 从 起点 开始是否以 前缀 开头
段落 始于 接收 文本, 起点, 前缀:
  设 m 为 字符串长度(前缀)
  设 n 为 字符串长度(文本)
  如果 起点 + m > n:
    返回 假
  设 i 为 0
  当 i < m:
    如果 字符串获取(文本, 起点 + i) != 字符串获取(前缀, i):
      返回 假
    设 i 为 i + 1
  返回 真

# 可选字段守卫：键存在返回值（含 空 本身），不存在返回 空
段落 得可选 接收 容器, 键:
  如果 字典包含键(容器, 键):
    返回 容器[键]
  返回 空

# 从 URL 提取主机名（去端口）；无 :// 返回原始 URL
段落 构造主机名 接收 网址:
  设 协议尾 为 查找子串(网址, "://", 0)
  如果 协议尾 == -1:
    返回 网址
  设 起点 为 协议尾 + 3
  设 n 为 字符串长度(网址)
  设 终点 为 n
  设 i 为 起点
  当 i < n:
    设 c 为 字符串获取(网址, i)
    如果 c == "/":
      设 终点 为 i
      跳出
    如果 c == "?":
      设 终点 为 i
      跳出
    如果 c == "#":
      设 终点 为 i
      跳出
    设 i 为 i + 1
  设 主机 为 截取(网址, 起点, 终点)
  设 冒号位 为 查找字符(主机, ":", 0)
  如果 冒号位 > 0:
    设 主机 为 截取(主机, 0, 冒号位)
  返回 主机

# ---------- search.ts 纯逻辑 ----------

# parseSearchArgs: 空查询抛错 / 超 maxQueries 抛错 / 空白查询抛错 / Set 去重
段落 判定搜索参数 接收 参数, 最大查询数:
  设 查询列表 为 参数["queries"]
  如果 列表长度(查询列表) == 0:
    抛出 新建 错误("queries must contain at least one query")
  如果 列表长度(查询列表) > 最大查询数:
    抛出 新建 错误("queries must contain at most " + 转字符串(最大查询数) + " queries")
  设 i 为 0
  当 i < 列表长度(查询列表):
    设 q 为 列表获取(查询列表, i)
    如果 是全空白(q):
      抛出 新建 错误("each query must be a non-empty string")
    设 i 为 i + 1
  # 去重，保留首次出现顺序
  设 已见 为 {}
  设 结果 为 []
  设 j 为 0
  当 j < 列表长度(查询列表):
    设 q 为 列表获取(查询列表, j)
    如果 字典包含键(已见, q) == 假:
      已见[q] = 真
      列表追加(结果, q)
    设 j 为 j + 1
  返回 结果

# sourceLabel: 有标题用标题，无标题用 hostname，URL 解析失败用原始 URL
段落 构造源标签 接收 网址, 标题:
  如果 标题 != 空:
    如果 字符串长度(标题) > 0:
      返回 标题
  返回 构造主机名(网址)

# projectSource: 投影源字段，仅保留非空的可选字段
段落 净化源投影 接收 源:
  设 结果 为 { "url": 源["url"] }
  如果 字典包含键(源, "title"):
    设 t 为 源["title"]
    如果 t != 空:
      如果 字符串长度(t) > 0:
        结果["title"] = t
  如果 字典包含键(源, "snippet"):
    设 s 为 源["snippet"]
    如果 s != 空:
      如果 字符串长度(s) > 0:
        结果["snippet"] = s
  如果 字典包含键(源, "publishedAt"):
    设 d 为 源["publishedAt"]
    如果 d != 空:
      如果 字符串长度(d) > 0:
        结果["publishedAt"] = d
  返回 结果

# mergeSearchResults: 按 URL 去重 + 按轮次 round-robin 合并 + maxResults 截断 + content 拼接
段落 整理搜索结果 接收 查询列表, 结果列表, 最大结果数:
  设 已见 为 {}
  设 源列表 为 []
  设 丢弃源 为 假
  # 找最大源列表长度
  设 最大长度 为 0
  设 i 为 0
  当 i < 列表长度(结果列表):
    设 结果 为 列表获取(结果列表, i)
    设 源数 为 列表长度(结果["sources"])
    如果 源数 > 最大长度:
      设 最大长度 为 源数
    设 i 为 i + 1
  # Round-robin 合并
  设 轮次 为 0
  当 轮次 < 最大长度:
    设 j 为 0
    当 j < 列表长度(结果列表):
      设 结果 为 列表获取(结果列表, j)
      设 结果源 为 结果["sources"]
      设 源 为 空
      如果 轮次 < 列表长度(结果源):
        设 源 为 列表获取(结果源, 轮次)
      如果 源 != 空:
        设 网址 为 源["url"]
        如果 字典包含键(已见, 网址) == 假:
          已见[网址] = 真
          如果 列表长度(源列表) == 最大结果数:
            设 丢弃源 为 真
            跳出
          列表追加(源列表, 源)
      设 j 为 j + 1
    如果 丢弃源:
      跳出
    设 轮次 为 轮次 + 1
  # 合并内容
  设 内容段列表 为 []
  设 k 为 0
  当 k < 列表长度(结果列表):
    设 结果 为 列表获取(结果列表, k)
    设 内容 为 得可选(结果, "content")
    如果 内容 != 空:
      如果 字符串长度(内容) > 0:
        设 查询 为 列表获取(查询列表, k)
        设 段 为 "### " + 查询 + "\n\n" + 内容
        列表追加(内容段列表, 段)
    设 k 为 k + 1
  # 检查截断
  设 已截断 为 假
  设 m 为 0
  当 m < 列表长度(结果列表):
    设 结果 为 列表获取(结果列表, m)
    设 截断标志 为 得可选(结果, "truncated")
    如果 截断标志 == 真:
      设 已截断 为 真
    设 m 为 m + 1
  如果 丢弃源:
    设 已截断 为 真
  设 终值 为 { "sources": 源列表, "truncated": 已截断 }
  如果 列表长度(内容段列表) > 0:
    终值["content"] = 连接字符串(内容段列表, "\n\n")
  返回 终值

# formatSearchOutput: 渲染搜索结果为文本
段落 渲染搜索文本 接收 结果:
  设 段列表 为 []
  设 内容 为 得可选(结果, "content")
  如果 内容 != 空:
    如果 字符串长度(内容) > 0:
      列表追加(段列表, 内容)
  设 源列表 为 结果["sources"]
  如果 列表长度(源列表) > 0:
    列表追加(段列表, "Sources:")
    设 i 为 0
    当 i < 列表长度(源列表):
      设 源 为 列表获取(源列表, i)
      设 标题 为 得可选(源, "title")
      设 标签 为 构造源标签(源["url"], 标题)
      列表追加(段列表, "[" + 转字符串(i + 1) + "] " + 标签)
      设 i 为 i + 1
  如果 列表长度(段列表) == 0:
    返回 "No results found."
  如果 结果["truncated"]:
    列表追加(段列表, "(Results are truncated.)")
  返回 连接字符串(段列表, "\n")

# ---------- fetch.ts 纯逻辑 ----------

# parseFetchArgs: 空白 URL 抛错
段落 判定网址参数 接收 参数:
  设 网址 为 参数["url"]
  如果 是全空白(网址):
    抛出 新建 错误("url must be a non-empty string")
  返回 网址

# findRawTextEnd: 在小写文本中从起点查找 </name 标签的起始位置
段落 查找原文尾 接收 小写文本, 名, 起点:
  设 前缀 为 "</" + 名
  设 前缀长 为 字符串长度(前缀)
  设 n 为 字符串长度(小写文本)
  设 候选 为 查找子串(小写文本, 前缀, 起点)
  当 候选 != -1:
    设 边界位 为 候选 + 前缀长
    设 c 为 空
    如果 边界位 < n:
      设 c 为 字符串获取(小写文本, 边界位)
    如果 是标签边界(c):
      返回 候选
    设 候选 为 查找子串(小写文本, 前缀, 候选 + 前缀长)
  返回 候选

# exceedsConversionDepth: 单遍扫描 HTML 判断嵌套深度是否超过 512
段落 判定深度超限 接收 网页:
  设 小写文本 为 转小写(网页)
  设 n 为 字符串长度(小写文本)
  设 开标签栈 为 []
  设 偏移 为 0
  设 在注释中 为 假
  设 应跳出 为 假
  当 偏移 < n:
    如果 应跳出:
      跳出
    设 起点 为 查找字符(小写文本, "<", 偏移)
    # 注释中：寻找 --> 退出
    如果 在注释中:
      设 注释尾 为 查找子串(小写文本, "-->", 偏移)
      如果 注释尾 != -1:
        设 离注 为 假
        如果 起点 == -1:
          设 离注 为 真
        否则如果 注释尾 < 起点:
          设 离注 为 真
        如果 离注:
          设 在注释中 为 假
          设 偏移 为 注释尾 + 3
          继续
    如果 起点 == -1:
      设 应跳出 为 真
      继续
    # 注释开始
    如果 在注释中 == 假:
      如果 始于(小写文本, 起点, "<!--"):
        设 在注释中 为 真
        设 偏移 为 起点 + 4
        继续
    # 解析标签名
    设 游标 为 起点 + 1
    设 闭合 为 假
    如果 游标 < n:
      如果 字符串获取(小写文本, 游标) == "/":
        设 闭合 为 真
        设 游标 为 游标 + 1
    设 名起点 为 游标
    当 游标 < n:
      如果 是字母数字或横线(字符串获取(小写文本, 游标)) == 假:
        跳出
      设 游标 为 游标 + 1
    # 空标签名或非字母开头：跳过
    如果 游标 == 名起点:
      设 偏移 为 起点 + 1
      继续
    设 名首 为 空
    如果 名起点 < n:
      设 名首 为 字符串获取(小写文本, 名起点)
    设 是字母 为 假
    如果 名首 != 空:
      设 名首码 为 字符转ASCII(名首)
      如果 名首码 >= 65:
        如果 名首码 <= 90:
          设 是字母 为 真
      如果 名首码 >= 97:
        如果 名首码 <= 122:
          设 是字母 为 真
    如果 是字母 == 假:
      设 偏移 为 起点 + 1
      继续
    设 名 为 截取(小写文本, 名起点, 游标)
    # 解析属性（跳过引号，直到 >）
    当 游标 < n:
      如果 字符串获取(小写文本, 游标) == ">":
        跳出
      设 c 为 字符串获取(小写文本, 游标)
      如果 c == "\"":
        设 游标 为 游标 + 1
        当 游标 < n:
          如果 字符串获取(小写文本, 游标) == "\"":
            跳出
          设 游标 为 游标 + 1
        如果 游标 < n:
          设 游标 为 游标 + 1
      否则如果 c == "'":
        设 游标 为 游标 + 1
        当 游标 < n:
          如果 字符串获取(小写文本, 游标) == "'":
            跳出
          设 游标 为 游标 + 1
        如果 游标 < n:
          设 游标 为 游标 + 1
      否则:
        设 游标 为 游标 + 1
    如果 游标 < n:
      设 游标 为 游标 + 1
    # 检查是否找到 >
    设 找到尾 为 假
    如果 游标 > 0:
      如果 字符串获取(小写文本, 游标 - 1) == ">":
        设 找到尾 为 真
    如果 找到尾 == 假:
      设 应跳出 为 真
      继续
    # 闭合标签：匹配则弹出栈顶
    如果 闭合:
      设 栈长 为 列表长度(开标签栈)
      如果 栈长 > 0:
        设 栈顶 为 列表获取(开标签栈, 栈长 - 1)
        如果 栈顶 == 名:
          开标签栈.pop()
    否则:
      # 检查自闭合
      设 末位 为 游标 - 2
      当 末位 >= 0:
        如果 是空白(字符串获取(小写文本, 末位)) == 假:
          跳出
        设 末位 为 末位 - 1
      设 自闭合 为 假
      如果 末位 >= 0:
        如果 字符串获取(小写文本, 末位) == "/":
          设 自闭合 为 真
      设 是空标签 为 字符串包含(自闭合标签集, " " + 名 + " ")
      如果 是空标签 == 假:
        如果 自闭合 == 假:
          列表追加(开标签栈, 名)
          如果 列表长度(开标签栈) > 最大转换深度:
            返回 真
          设 是原文 为 字符串包含(原文标签集, " " + 名 + " ")
          如果 是原文:
            设 原文尾 为 查找原文尾(小写文本, 名, 游标)
            如果 原文尾 != -1:
              设 偏移 为 原文尾
              继续
    设 偏移 为 游标
  返回 假

# renderBody: 截断内容 + 按 kind 分支 + 深度检测
段落 渲染正文 接收 正文体, 最大字符数, 变形:
  设 内容 为 正文体["content"]
  设 截断内容 为 内容
  设 已截断源 为 假
  如果 字符串长度(内容) > 最大字符数:
    设 截断内容 为 截取(内容, 0, 最大字符数)
    设 已截断源 为 真
  设 种类 为 正文体["kind"]
  如果 种类 == "text":
    返回 { "text": 截断内容, "sourceTruncated": 已截断源 }
  如果 种类 == "html":
    如果 判定深度超限(截断内容):
      返回 { "text": 截断内容, "sourceTruncated": 已截断源 }
    如果 变形 != 空:
      设 转换结果 为 变形(截断内容)
      返回 { "text": 转换结果, "sourceTruncated": 已截断源 }
    返回 { "text": 截断内容, "sourceTruncated": 已截断源 }
  返回 { "text": 截断内容, "sourceTruncated": 已截断源 }

# computeFetchOutput: 构造头部 + 渲染正文 + 截断尾注
段落 计算正文文本 接收 结果, 最大字符数:
  设 头 为 "Fetched " + 结果["url"] + " (HTTP " + 转字符串(结果["statusCode"]) + ")\n\n"
  设 渲染体 为 渲染正文(结果["body"], 正文截断限, 空)
  设 文本 为 头 + 渲染体["text"]
  设 已截断 为 渲染体["sourceTruncated"]
  如果 字符串长度(文本) > 最大字符数:
    设 已截断 为 真
    返回 { "text": 截取(文本, 0, 最大字符数) + 截断尾注, "truncated": 已截断 }
  返回 { "text": 文本, "truncated": 已截断 }

# formatFetchOutput: 公开接口，返回文本
段落 渲染结果文本 接收 结果, 最大字符数:
  设 渲染体 为 计算正文文本(结果, 最大字符数)
  返回 渲染体["text"]

# ---------- exa/provider.ts 纯逻辑 ----------

# mapExaResult: highlights 首个非空白行 -> snippet，无 snippet 丢弃
段落 净化高亮条目 接收 条目:
  设 片段 为 ""
  设 高亮 为 得可选(条目, "highlight")
  如果 高亮 != 空:
    设 换行位 为 查找字符(高亮, "\n", 0)
    设 首行 为 高亮
    如果 换行位 != -1:
      设 首行 为 截取(高亮, 0, 换行位)
    设 净化首行 为 去除首尾空白(首行)
    如果 字符串长度(净化首行) > 0:
      设 片段 为 净化首行
  如果 字符串长度(片段) == 0:
    设 文本 为 得可选(条目, "text")
    如果 文本 != 空:
      设 片段 为 文本
  如果 字符串长度(片段) == 0:
    返回 空
  设 结果 为 { "url": 条目["url"], "snippet": 片段 }
  如果 字典包含键(条目, "title"):
    设 t 为 条目["title"]
    如果 t != 空:
      如果 字符串长度(t) > 0:
        结果["title"] = t
  如果 字典包含键(条目, "publishedDate"):
    设 d 为 条目["publishedDate"]
    如果 d != 空:
      如果 字符串长度(d) > 0:
        结果["publishedAt"] = d
  返回 结果

# mapExaResponse: 过滤 undefined，truncated: false
段落 净化高亮响应 接收 响应:
  设 原始列表 为 响应["results"]
  设 结果 为 []
  设 i 为 0
  当 i < 列表长度(原始列表):
    设 条目 为 列表获取(原始列表, i)
    设 净化条目 为 净化高亮条目(条目)
    如果 净化条目 != 空:
      列表追加(结果, 净化条目)
    设 i 为 i + 1
  返回 { "sources": 结果, "truncated": 假 }

# ---------- deepseek/provider.ts 纯逻辑 ----------

# citationSnippets: 遍历 text 块 citations[]，url+cited_text 非空且首次入表
段落 收集引用片段 接收 块列表:
  设 片段表 为 {}
  设 i 为 0
  当 i < 列表长度(块列表):
    设 块 为 列表获取(块列表, i)
    设 块种 为 块["type"]
    如果 块种 != "text":
      设 i 为 i + 1
      继续
    设 引用列表 为 得可选(块, "citations")
    如果 引用列表 != 空:
      设 j 为 0
      当 j < 列表长度(引用列表):
        设 引用 为 列表获取(引用列表, j)
        设 网址 为 得可选(引用, "url")
        设 文本 为 得可选(引用, "cited_text")
        如果 网址 != 空:
          如果 文本 != 空:
            如果 字典包含键(片段表, 网址) == 假:
              片段表[网址] = 文本
        设 j 为 j + 1
    设 i 为 i + 1
  返回 片段表

# mapAnthropicResponse: 过滤 web_search_tool_result 块、无则抛错、按 url 去重、snippet 从引用片段取
段落 净化引用响应 接收 响应:
  设 内容块 为 响应["content"]
  设 结果块 为 []
  设 i 为 0
  当 i < 列表长度(内容块):
    设 块 为 列表获取(内容块, i)
    如果 块["type"] == "web_search_tool_result":
      列表追加(结果块, 块)
    设 i 为 i + 1
  如果 列表长度(结果块) == 0:
    抛出 新建 错误("No web search tool result found in the response content")
  设 片段表 为 收集引用片段(内容块)
  设 已见 为 {}
  设 源列表 为 []
  设 j 为 0
  当 j < 列表长度(结果块):
    设 块 为 列表获取(结果块, j)
    设 块源列表 为 块["sources"]
    设 k 为 0
    当 k < 列表长度(块源列表):
      设 源 为 列表获取(块源列表, k)
      设 网址 为 源["url"]
      如果 字典包含键(已见, 网址) == 假:
        已见[网址] = 真
        设 投影 为 净化源投影(源)
        如果 字典包含键(片段表, 网址):
          投影["snippet"] = 片段表[网址]
        列表追加(源列表, 投影)
      设 k 为 k + 1
    设 j 为 j + 1
  返回 { "sources": 源列表, "truncated": 假 }

# ---------- perplexity/provider.ts 纯逻辑 ----------

# mapPerplexityResult: url 必带、title/snippet/date 非空才带
段落 净化对话条目 接收 条目:
  设 结果 为 { "url": 条目["url"] }
  如果 字典包含键(条目, "title"):
    设 t 为 条目["title"]
    如果 t != 空:
      如果 字符串长度(t) > 0:
        结果["title"] = t
  如果 字典包含键(条目, "snippet"):
    设 s 为 条目["snippet"]
    如果 s != 空:
      如果 字符串长度(s) > 0:
        结果["snippet"] = s
  如果 字典包含键(条目, "date"):
    设 d 为 条目["date"]
    如果 d != 空:
      如果 字符串长度(d) > 0:
        结果["publishedAt"] = d
  返回 结果

# mapPerplexityResponse: choices[0].message.content -> content、
#   search_results 优先否则 citations[] 降级为 {url}、truncated: false
段落 净化对话响应 接收 响应:
  设 选择列表 为 响应["choices"]
  设 选择 为 列表获取(选择列表, 0)
  设 消息 为 选择["message"]
  设 内容 为 得可选(消息, "content")
  设 原始结果列表 为 得可选(消息, "search_results")
  如果 原始结果列表 == 空:
    设 引用列表 为 得可选(消息, "citations")
    如果 引用列表 == 空:
      设 原始结果列表 为 []
    否则:
      设 原始结果列表 为 []
      设 i 为 0
      当 i < 列表长度(引用列表):
        设 网址 为 列表获取(引用列表, i)
        列表追加(原始结果列表, { "url": 网址 })
        设 i 为 i + 1
  设 源列表 为 []
  设 j 为 0
  当 j < 列表长度(原始结果列表):
    设 条目 为 列表获取(原始结果列表, j)
    设 投影 为 净化对话条目(条目)
    列表追加(源列表, 投影)
    设 j 为 j + 1
  设 终值 为 { "sources": 源列表, "truncated": 假 }
  如果 内容 != 空:
    如果 字符串长度(内容) > 0:
      终值["content"] = 内容
  返回 终值

# ======================================================================
# 语言缺陷登记
# ======================================================================
#
# L-042（新坑）：长函数体首句非 设 语句时，后段变量解析丢失
#   现象：当 段落 函数体第一行可执行语句是函数调用（如 断言相等(...)）
#         而非 设 变量 为 ... 时，函数体超过约 250 行后，
#         后段（约 2/3 处起）的 设 变量 赋值静默失败，
#         导致后续引用该变量时报 "名称错误: name 'xxx' is not defined"。
#   复现：test_网页搜索.light 原始版本（277 行，主函数首句为 断言相等）
#         在 用例39 处报 name '片段表' is not defined。
#   绕法：在 段落 主: 体首行加 设 哑变量 为 0 即可规避。
#   根因推测：光明 parser 在编译长函数时，首句若非 设/打印，
#           可能导致内部行号映射偏移，后段生成的 Python 代码中变量赋值被跳过。
#   影响范围：仅影响 段落 主（入口函数）；子函数不受影响（已验证各子函数独立调用均正常）。
