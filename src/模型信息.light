# 模型信息.light —— R85 任务 A：0.1.6 模型能力元数据与推理努力
#
# 上游锚点（逐字语义，不自行推算）：
#   ddefc45fbc packages/llm/llm-deepseek/src/common/model-info.ts（全文 99 行）
#     REASONING_EFFORTS = off/low/high/max 四条（id + name + description）
#     OFF_ONLY_REASONING_EFFORTS = 仅 off 一条
#     catalogModelInfo(provider, model)  —— 目录条目广告
#     modelInfo(connection, provider, model) —— 按配置代次解析能力
#   ddefc45fbc packages/llm/llm-pi-ai/src/catalog.ts:69-86
#     THINKING_LEVEL_GATE = off/minimal/low/medium/high/xhigh/max（升级序）
#   ddefc45fbc packages/llm/llm-pi-ai/src/models.ts:52-62
#     getSupportedThinkingLevels(model)
#
# 上游关键注释（逐字保留，语义即判据）：
#   model-info.ts:77 「An uncatalogued endpoint is safely treated as text-only.
#   Declaring an unverified image capability would let the host persist input
#   that the endpoint may reject on every later turn.」
#   → 未收录端点一律 text-only，不得虚报图像能力。
#
# 宿主面登记（不移植）：
#   model-info.ts 依赖的 DeepSeekConnectionOptions 由调用方构造（本模块只读其形状）；
#   pi-ai builtinModels/clearProviders/createProvider 依赖 pi-ai 库聚合入口，属宿主装配。
#
# 偏离声明：
#   D-1 上游用条件展开（...cond ? {} : {...}）；光明逐键判 后赋值，语义等价。
#   D-2 连接.包含("defaults") 为假时按上游 `?? 连接.defaults` 的链式取值语义
#       视为「未禁用思考」（enabled）与 reasoningEffort 未设（high）。
#
# 命名避坑：中文数字别名（一 二 三 四 五 …）与 空 为保留字，局部名用安全名。

段落 思考级表:
  返回 ["off", "minimal", "low", "medium", "high", "xhigh", "max"]

# REASONING_EFFORTS（off/low/high/max 四条，顺序即上游声明序）
段落 推理努力表:
  返回 [
    ["id": "off", "name": "Off", "description": "Use for simple tasks that do not need reasoning."],
    ["id": "low", "name": "Low", "description": "Prefer for routine or latency-sensitive tasks."],
    ["id": "high", "name": "High", "description": "The default balance for most tasks."],
    ["id": "max", "name": "Max", "description": "Reserve for the hardest quality-first tasks."],
  ]

# OFF_ONLY_REASONING_EFFORTS（thinking === 'disabled' 时仅广告 off）
段落 仅关推理努力表:
  返回 [["id": "off", "name": "Off", "description": "Use for simple tasks that do not need reasoning."]]

# 按努力 id 取条目；未命中返回 空
段落 按ID取努力(努力表, 努力标识):
  遍历 条目 之 努力表:
    如果 条目["id"] == 努力标识:
      返回 条目
  返回 空

# pi-ai getSupportedThinkingLevels：
#   无 reasoning 能力 → 只有 off；
#   thinkingLevelMap[level] === null（上游显式置空）→ 剔除；
#   xhigh / max 仅在映射显式声明时开放；
#   其余级别默认开放。
#   模型形状：{"reasoning": 真/假, "thinkingLevelMap": {"off": "...", "low": null, ...}}
#   光明侧 thinkingLevelMap 用 空 表示「未声明」（对应上游 undefined）。
段落 思考级过滤(模型):
  如果 模型.包含("reasoning") == 假:
    返回 ["off"]
  如果 模型["reasoning"] == 假:
    返回 ["off"]
  # 上游区分 undefined（未声明键）与 null（显式置空）：光明用
  # 映射.包含(级别) 判「未声明」，用 值 == 空 判「显式置空」。
  设 结果 为 列表创建()
  如果 模型.包含("thinkingLevelMap") == 假:
    遍历 级别 之 思考级表():
      如果 级别 == "xhigh" 或 级别 == "max":
        继续
      列表追加(结果, 级别)
    返回 结果
  设 映射 为 模型["thinkingLevelMap"]
  遍历 级别 之 思考级表():
    如果 映射.包含(级别) == 假:
      如果 级别 == "xhigh" 或 级别 == "max":
        继续
      列表追加(结果, 级别)
      继续
    设 映射值 为 映射[级别]
    如果 映射值 == 空:
      继续
    如果 级别 == "xhigh" 或 级别 == "max":
      列表追加(结果, 级别)
      继续
    列表追加(结果, 级别)
  返回 结果

# catalogModelInfo(provider, model)：广告一条目录条目
段落 目录模型信息(提供方, 模型):
  设 结果 为 ["provider": 提供方, "id": 模型["id"]]
  如果 模型.包含("name") == 真:
    设 结果["name"] 为 模型["name"]
  否则:
    设 结果["name"] 为 模型["id"]
  如果 模型.包含("description") == 真:
    设 结果["description"] 为 模型["description"]
  如果 模型.包含("inputModalities") == 真:
    设 结果["inputModalities"] 为 模型["inputModalities"]
  否则:
    设 结果["inputModalities"] 为 ["text"]
  返回 结果

# 在连接目录里按 id 找条目；未命中返回 空
段落 找目录条目(连接, 模型标识):
  设 目录 为 取可选(连接, "models")
  如果 目录 == 空:
    返回 空
  遍历 条目 之 目录:
    如果 条目["id"] == 模型标识:
      返回 条目
  返回 空

# modelInfo(connection, provider, model)：按配置代次解析能力
# 连接形状：
#   {"models": [目录条目...], "defaultContextWindow": 整数, "maxTokens": 整数,
#    "defaults": {"thinking": "enabled"/"disabled", "reasoningEffort": "off"/"low"/"high"/"max"}}
段落 解析模型信息(连接, 提供方, 模型标识):
  设 已收录 为 找目录条目(连接, 模型标识)
  设 上下文窗口 为 取可选(连接, "defaultContextWindow")
  如果 已收录 != 空 且 已收录.包含("contextWindow") == 真:
    设 上下文窗口 为 已收录["contextWindow"]
  设 默认输出 为 取可选(连接, "maxTokens")
  如果 已收录 != 空 且 已收录.包含("maxTokens") == 真:
    设 默认输出 为 已收录["maxTokens"]
  设 默认配置 为 取可选(连接, "defaults")
  设 思考禁用 为 假
  如果 默认配置 != 空:
    如果 取可选(默认配置, "thinking") == "disabled":
      设 思考禁用 为 真
  设 基础 为 空
  如果 已收录 == 空:
    设 基础 为 ["provider": 提供方, "id": 模型标识, "name": 模型标识, "inputModalities": ["text"]]
  否则:
    设 基础 为 目录模型信息(提供方, 已收录)
  设 基础["context"] 为 ["contextWindow": 上下文窗口]
  设 基础["defaultMaxTokens"] 为 默认输出
  如果 已收录 != 空 且 已收录.包含("systemPromptUpdate") == 真:
    设 基础["systemPromptUpdate"] 为 已收录["systemPromptUpdate"]
  如果 思考禁用 == 真:
    设 基础["reasoning"] 为 ["efforts": 仅关推理努力表(), "defaultEffort": "off"]
  否则:
    设 缺省努力 为 "high"
    如果 默认配置 != 空:
      设 声明努力 为 取可选(默认配置, "reasoningEffort")
      如果 声明努力 == "off" 或 声明努力 == "low" 或 声明努力 == "max":
        设 缺省努力 为 声明努力
    设 基础["reasoning"] 为 ["efforts": 推理努力表(), "defaultEffort": 缺省努力]
  返回 基础

导出 思考级表
导出 推理努力表
导出 仅关推理努力表
导出 按ID取努力
导出 思考级过滤
导出 目录模型信息
导出 找目录条目
导出 解析模型信息
