# 作用域.light —— 第 39 轮 任务 1+2：@deepseek-ai/dsh-scope 核心 + 存储层复刻
#
# 上游（本地基线 0.1.5-rc.2，与 GitHub master 一致）：
#   G:\github\deepseek-harness\packages\core\scope\src\index.ts（204 行，全文精读）
#   G:\github\deepseek-harness\packages\core\scope\src\store.ts（267 行，全文精读）
#   官方测试：tests/scope.spec.ts（10 用例）+ tests/store.spec.ts（8 用例）
#
# 上游 → 光明对照表：
#   type ScopeKey = object                                  → 建作用域键() 产出不透明字典（标识比较）
#   const kScope = Symbol('dsh.scope')                      → 作用域上下文的「作用域键」槽位
#   const carrierKeys = WeakMap<object, ScopeKey|undefined> → 载体键表（载体ID → 作用域键）
#   const scopeParents = WeakMap<ScopeKey, ScopeKey>        → 作用域父表（键ID → 父键）
#   linkScopeParent(key, parent)                            → 作用域循环检测 + 写父作用域
#   bindScopeParent(key, parent) → { rebind }               → 绑定父作用域 / 重绑父作用域
#   scopeParentOf(key)                                      → 取父作用域
#   scopeChainOf(key)                                       → 取作用域链
#   createScope(ctx, key, { parent })                       → 建作用域 / 注销作用域 / 原始注销作用域
#   scopeOf(ctx)                                            → 取上下文作用域
#   scopeTarget(base, key)                                  → 建作用域目标 + 作用域准入
#   isScopeCarrier(value) / carrierKeyOf(value)             → 是作用域载体 / 取载体作用域
#   class NamedEntries<V>                                   → 类 命名条目表
#   class AnonymousEntries<V>                               → 类 匿名条目表
#   class ScopedLayers<L>（global/peek/chainLayers/merge/effect）→ 类 作用域层组
#
# 光明适配要点（4 处等价替代，详见 _task2_R39_scope存储层复刻.md）：
#   1) WeakMap → 模块级字典（键ID / 载体ID 字符串）。「标识比较」语义由唯一ID 承载，等价。
#   2) JS 闭包 undo → 句柄字典 {"活跃": …} + 具名段落 注销…；幂等由 活跃 标记保证，等价。
#   3) JS Map 活迭代器 → 游标 {"数据": <字典引用>, "位置": n} + 推进游标。排空换代会把 己.数据
#      换为新字典，旧游标仍持有旧字典（已排空）⇒ 自动失效，与「drain detaches iterators」等价。
#   4) cordis ctx.effect 惰性 → 光明无延迟效应：附着 立即执行动作并同步通知；返回句柄充当
#      disposer（语义等价于上游 effect 返回的注销器）。
#
# 命名避坑：标识符内不得含关键字「函数」（类属性名含「函数」直接解析失败，本轮实测）
#   ⇒ 一律用 建层器 / 变更器 / 重复报错。模块名「作用域」已做全 src/ 唯一性预检查（零冲突）。

从 内置核心字典 导入 字典包含键, 字典删除, 字典键列表, 字典设置
从 内置核心判型 导入 是字典, 是空

# =====================================================================
# §1 模块级状态（对应上游 WeakMap 世界）
# =====================================================================

# 唯一ID 发生器（段落体内 `设 X 为 X + 1` 只改局部名，故状态必须落在字典上）
设 作用域序盘 为 {"值": 0}
设 载体序盘 为 {"值": 0}

# 上游 scopeParents：键ID → 父键（键存在即「已绑定」，与 scopeParents.has(key) 等价）
设 作用域父表 为 {}

# 上游 carrierKeys：载体ID → 作用域键（值可为 空 = 未指键载体，存在性即「是载体」）
设 载体键表 为 {}

# 父链表异常时的遍历卫兵（上游靠 JS 引擎兜底；光明显式设上界）
设 链卫兵上限 为 10000

# =====================================================================
# §2 作用域键（对应 type ScopeKey = object）
# =====================================================================

# 建作用域键：产出不透明键（标识比较，不是字符串）
段落 建作用域键(标签=空):
  字典设置(作用域序盘, "值", 作用域序盘["值"] + 1)
  设 键 为 {}
  键["__作用域键__"] 为 "sk" + 转字符串(作用域序盘["值"])
  键["标签"] 为 标签
  返回 键

# 是作用域键：判型（上游靠 TS 类型系统，光明靠不透明标记字段）
段落 是作用域键(值):
  如果 是字典(值) == 假:
    返回 假
  返回 字典包含键(值, "__作用域键__")

# 作用域键ID：内部字典键（承载标识，不参与对外语义）
段落 作用域键ID(键):
  如果 是作用域键(键) == 假:
    抛出 新建 错误("作用域：不是作用域键 [NOT_SCOPE_KEY]")
  返回 键["__作用域键__"]

# 作用域键标签：可选的人类可读标签（不参与标识比较）
段落 作用域键标签(键):
  如果 是作用域键(键) == 假:
    返回 空
  返回 键["标签"]

# 作用域相等：标识比较（两个不同对象必然不等）
段落 作用域相等(键1, 键2):
  如果 是作用域键(键1) == 假:
    返回 假
  如果 是作用域键(键2) == 假:
    返回 假
  如果 键1["__作用域键__"] == 键2["__作用域键__"]:
    返回 真
  返回 假

# =====================================================================
# §3 父链：循环检测 / 绑定 / 重绑 / 取值（linkScopeParent / bindScopeParent / scopeChainOf）
# =====================================================================

# 作用域循环检测：从候选父键沿父链上行，途中遇到键本身 ⇒ 成环（返回 真）
段落 作用域循环检测(键, 候选父键):
  如果 是作用域键(键) == 假:
    返回 假
  如果 是空(候选父键) == 真:
    返回 假
  设 游标 为 候选父键
  设 卫兵 为 0
  当 卫兵 < 链卫兵上限:
    如果 是作用域键(游标) == 假:
      返回 假
    如果 作用域相等(游标, 键) == 真:
      返回 真
    如果 字典包含键(作用域父表, 游标["__作用域键__"]) == 假:
      返回 假
    设 游标 为 作用域父表[游标["__作用域键__"]]
    如果 是空(游标) == 真:
      返回 假
    设 卫兵 为 卫兵 + 1
  返回 真

# 写父作用域：循环检测通过后落盘（上游 linkScopeParent 的抛错分支）
段落 写父作用域(键, 父键):
  如果 作用域循环检测(键, 父键) == 真:
    抛出 新建 错误("作用域：父链将形成循环 [SCOPE_CYCLE]")
  设 键ID 为 作用域键ID(键)
  作用域父表[键ID] 为 父键
  返回 真

# 绑定父作用域：一次性绑定；已绑定则抛错；返回唯一可重绑的句柄
#   （上游：绑定后只有原始绑定者持有的 ScopeParentBinding 能移动该键）
段落 绑定父作用域(键, 父键):
  如果 是作用域键(键) == 假:
    抛出 新建 错误("作用域：不是作用域键 [NOT_SCOPE_KEY]")
  如果 字典包含键(作用域父表, 作用域键ID(键)) == 真:
    抛出 新建 错误("作用域：作用域键已绑定父作用域，重绑需使用绑定返回的句柄 [ALREADY_BOUND]")
  写父作用域(键, 父键)
  返回 ["键": 键, "父键": 父键]

# 重绑父作用域：仅通过句柄；不检查一次性标记，但仍做循环检测
段落 重绑父作用域(绑定句柄, 新父键):
  如果 是字典(绑定句柄) == 假:
    抛出 新建 错误("作用域：绑定句柄非法 [INVALID_BINDING]")
  如果 字典包含键(绑定句柄, "键") == 假:
    抛出 新建 错误("作用域：绑定句柄缺少键 [INVALID_BINDING]")
  写父作用域(绑定句柄["键"], 新父键)
  绑定句柄["父键"] 为 新父键
  返回 绑定句柄

# 取父作用域：根作用域返回 空
段落 取父作用域(键):
  如果 是作用域键(键) == 假:
    返回 空
  如果 字典包含键(作用域父表, 作用域键ID(键)) == 假:
    返回 空
  返回 作用域父表[作用域键ID(键)]

# 取作用域链：就近优先 [键, 父, 祖父, …]；非作用域键 ⇒ 空链
段落 取作用域链(键):
  设 链 为 []
  如果 是作用域键(键) == 假:
    返回 链
  设 游标 为 键
  设 卫兵 为 0
  当 卫兵 < 链卫兵上限:
    链.追加(游标)
    如果 字典包含键(作用域父表, 游标["__作用域键__"]) == 假:
      返回 链
    设 游标 为 作用域父表[游标["__作用域键__"]]
    如果 是空(游标) == 真:
      返回 链
    设 卫兵 为 卫兵 + 1
  返回 链

# 取作用域链由根到叶：取作用域链 的反向（供层级继承顺序使用）
段落 取作用域链向上(键):
  设 下到上 为 取作用域链(键)
  设 上到下 为 []
  设 i 为 列表长度(下到上) - 1
  当 i >= 0:
    上到下.追加(下到上[i])
    设 i 为 i - 1
  返回 上到下

# =====================================================================
# §4 作用域上下文与生命周期（对应 kScope / createScope / scopeOf）
#   光明没有 cordis：用「上下文链字典」替代 ctx.extend，用注销器表替代 fiber。
# =====================================================================

# 建上下文：根上下文（无作用域标签）
段落 建上下文(标签=空):
  设 上下文 为 {}
  上下文["作用域键"] 为 空
  上下文["父"] 为 空
  上下文["标签"] 为 标签
  返回 上下文

# 扩展作用域上下文：对应 ctx.extend({ [kScope]: key })
段落 扩展作用域上下文(上下文, 键):
  设 新 为 {}
  新["作用域键"] 为 键
  新["父"] 为 上下文
  新["标签"] 为 ""
  返回 新

# 派生上下文：对应 ctx.extend({})（不写新标签，最近标签来自父链）
段落 派生上下文(上下文):
  返回 扩展作用域上下文(上下文, 空)

# 取上下文作用域：最近标签胜出（沿父链上行）
段落 取上下文作用域(上下文):
  设 游标 为 上下文
  设 卫兵 为 0
  当 卫兵 < 链卫兵上限:
    如果 是空(游标) == 真:
      返回 空
    如果 是字典(游标) == 假:
      返回 空
    如果 字典包含键(游标, "作用域键") == 真:
      如果 是空(游标["作用域键"]) == 假:
        返回 游标["作用域键"]
    如果 字典包含键(游标, "父") == 假:
      返回 空
    设 游标 为 游标["父"]
    设 卫兵 为 卫兵 + 1
  返回 空

# 建作用域：绑定可选父链 + 派生作用域上下文 + 建立注销边界
#   （上游 createScope(ctx, key, {parent}) → { ctx, rawDispose, dispose }）
段落 建作用域(宿主上下文, 键, 父键=空):
  如果 是作用域键(键) == 假:
    抛出 新建 错误("作用域：不是作用域键 [NOT_SCOPE_KEY]")
  如果 是空(父键) == 假:
    绑定父作用域(键, 父键)
  设 域体 为 {}
  域体["键"] 为 键
  域体["上下文"] 为 扩展作用域上下文(宿主上下文, 键)
  域体["注销器表"] 为 []
  域体["已注销"] 为 假
  返回 域体

# 取作用域键 / 取作用域上下文
#   ⚠️ 形参名不得用裸「作用域」：作用域 is a reserved keyword (light-merge/src/keywords.py:179)
段落 取作用域键(域体):
  如果 是字典(域体) == 假:
    返回 空
  返回 域体["键"]

段落 取作用域上下文(域体):
  如果 是字典(域体) == 假:
    返回 空
  返回 域体["上下文"]

# 登记作用域注销：对应 scope.ctx.effect(...) 把撤销器挂进该作用域 frame
段落 登记作用域注销(域体, 撤销):
  如果 是字典(域体) == 假:
    返回 假
  如果 是空(撤销) == 真:
    返回 假
  域体["注销器表"].追加(撤销)
  返回 真

# 原始注销作用域：对应 rawDispose（执行注销器、不置已注销标记，供有序复合拆除）
段落 原始注销作用域(域体):
  如果 是字典(域体) == 假:
    返回 假
  设 表 为 域体["注销器表"]
  域体["注销器表"] 为 []
  遍历 撤销 之 表:
    撤销()
  返回 真

# 注销作用域：对应 dispose()（静默共享：重复调用安全，只执行一次）
段落 注销作用域(域体):
  如果 是字典(域体) == 假:
    返回 假
  如果 域体["已注销"] == 真:
    返回 真
  域体["已注销"] 为 真
  原始注销作用域(域体)
  返回 真

# 作用域已注销
段落 作用域已注销(域体):
  如果 是字典(域体) == 假:
    返回 真
  返回 域体["已注销"]

# =====================================================================
# §5 作用域载体与准入（scopeTarget / isScopeCarrier / carrierKeyOf / carrier filter）
# =====================================================================

# 建作用域目标：创建路由专用事件目标（载体）
#   键   = 该载体的作用域键，空 表示「未指键载体」（全局准入）
#   基础 = 可选的基础过滤器段落（对应 base 上已有的 Cordis filter），签名 (上下文) → 真|假
段落 建作用域目标(键, 基础=空):
  字典设置(载体序盘, "值", 载体序盘["值"] + 1)
  设 载体ID 为 "载体" + 转字符串(载体序盘["值"])
  设 载体 为 {}
  载体["__作用域载体__"] 为 载体ID
  载体["基础"] 为 基础
  载体键表[载体ID] 为 键
  返回 载体

# 是作用域载体：判型（对应 isScopeCarrier；未指键载体与外部值可区分）
段落 是作用域载体(值):
  如果 是字典(值) == 假:
    返回 假
  返回 字典包含键(值, "__作用域载体__")

# 取载体作用域：对应 carrierKeyOf（非载体返回 空）
段落 取载体作用域(载体):
  如果 是作用域载体(载体) == 假:
    返回 空
  设 载体ID 为 载体["__作用域载体__"]
  如果 字典包含键(载体键表, 载体ID) == 假:
    返回 空
  返回 载体键表[载体ID]

# 取目标作用域：取载体作用域的别名（任务书命名）
段落 取目标作用域(载体):
  返回 取载体作用域(载体)

# 作用域准入：对应 carrier[Context.filter](ctx)
#   1) 基础过滤器先否决则否决
#   2) 监听上下文无标签 ⇒ 全局准入
#   3) 有标签 ⇒ 沿「载体的键 → 父 → …」上行命中即准入（事件向上流，绝不下行）
段落 作用域准入(载体, 监听上下文):
  如果 是作用域载体(载体) == 假:
    返回 假
  设 基础 为 载体["基础"]
  如果 是空(基础) == 假:
    如果 基础(监听上下文) == 假:
      返回 假
  设 标签 为 取上下文作用域(监听上下文)
  如果 是空(标签) == 真:
    返回 真
  设 键 为 取载体作用域(载体)
  如果 是空(键) == 真:
    返回 假
  遍历 游标 之 取作用域链(键):
    如果 作用域相等(游标, 标签) == 真:
      返回 真
  返回 假

# =====================================================================
# §6 存储层之一：命名条目表 / 匿名条目表（store.ts 的 NamedEntries / AnonymousEntries）
# =====================================================================

# 默认重复报错（上游要求诊断由调用方拥有；此处提供缺省实现）
段落 默认重复报错(名字):
  抛出 新建 错误("命名条目表：名称重复 " + 名字 + " [DUPLICATE_NAME]")

# 推进游标：把游标推进一格 → {"完成": 真|假, "值": …}
#   游标持有的是「字典引用」而非快照 ⇒ 同一代内可见后续插入；排空换代后旧游标命中空字典
段落 推进游标(游标):
  设 键表 为 字典键列表(游标["数据"])
  如果 游标["位置"] >= 列表长度(键表):
    返回 ["完成": 真, "值": 空]
  设 键 为 键表[游标["位置"]]
  游标["位置"] 为 游标["位置"] + 1
  返回 ["完成": 假, "值": 游标["数据"][键]]

# 命名条目表：插入有序命名条目，重复名抛错，插入返回幂等 undo
类 命名条目表:
  属性 数据 等于 空
  属性 代数 等于 0
  属性 重复报错 等于 空

  段落 构造(重复报错器=空):
    设 己.数据 为 {}
    设 己.代数 为 0
    设 己.重复报错 为 重复报错器

  段落 插入(名字, 值):
    如果 字典包含键(己.数据, 名字) == 真:
      如果 是空(己.重复报错) == 真:
        默认重复报错(名字)
      设 错 为 己.重复报错(名字)
      抛出 错
    己.数据[名字] 为 值
    返回 ["活跃": 真, "名字": 名字, "表": 己]

  段落 撤销插入(句柄):
    如果 是字典(句柄) == 假:
      返回 假
    如果 句柄["活跃"] == 假:
      返回 假
    句柄["活跃"] 为 假
    字典删除(己.数据, 句柄["名字"])
    己.回收空代()
    返回 真

  段落 取(名字):
    如果 字典包含键(己.数据, 名字) == 真:
      返回 己.数据[名字]
    返回 空

  段落 有无(名字):
    返回 字典包含键(己.数据, 名字)

  段落 名字列表:
    返回 字典键列表(己.数据)

  段落 项列表:
    设 结果 为 []
    遍历 名字 之 己.名字列表():
      结果.追加([名字, 己.数据[名字]])
    返回 结果

  段落 值列表:
    设 结果 为 []
    遍历 名字 之 己.名字列表():
      结果.追加(己.数据[名字])
    返回 结果

  段落 条目数:
    返回 列表长度(字典键列表(己.数据))

  段落 为空:
    如果 己.条目数() == 0:
      返回 真
    返回 假

  段落 代数取:
    返回 己.代数

  段落 游标:
    返回 ["数据": 己.数据, "位置": 0]

  段落 回收空代:
    如果 己.为空() == 真:
      设 己.数据 为 {}
      设 己.代数 为 己.代数 + 1
      返回 真
    返回 假

# 注销命名条目：幂等 undo（对应 insert 返回的 () => void）
段落 注销命名条目(句柄):
  如果 是字典(句柄) == 假:
    返回 假
  如果 字典包含键(句柄, "表") == 假:
    返回 假
  返回 句柄["表"].撤销插入(句柄)

# 匿名条目表：等值条目的独立注册身份，插入返回幂等 undo
类 匿名条目表:
  属性 数据 等于 空
  属性 序 等于 0
  属性 代数 等于 0

  段落 构造:
    设 己.数据 为 {}
    设 己.序 为 0
    设 己.代数 为 0

  段落 追加(值):
    设 己.序 为 己.序 + 1
    设 符号 为 "匿名" + 转字符串(己.序)
    己.数据[符号] 为 值
    返回 ["活跃": 真, "符号": 符号, "表": 己]

  段落 撤销追加(句柄):
    如果 是字典(句柄) == 假:
      返回 假
    如果 句柄["活跃"] == 假:
      返回 假
    句柄["活跃"] 为 假
    字典删除(己.数据, 句柄["符号"])
    己.回收空代()
    返回 真

  段落 有无(值):
    遍历 符号 之 己.符号列表():
      如果 己.数据[符号] == 值:
        返回 真
    返回 假

  段落 符号列表:
    返回 字典键列表(己.数据)

  段落 值列表:
    设 结果 为 []
    遍历 符号 之 己.符号列表():
      结果.追加(己.数据[符号])
    返回 结果

  段落 条目数:
    返回 列表长度(字典键列表(己.数据))

  段落 为空:
    如果 己.条目数() == 0:
      返回 真
    返回 假

  段落 代数取:
    返回 己.代数

  段落 游标:
    返回 ["数据": 己.数据, "位置": 0]

  段落 回收空代:
    如果 己.为空() == 真:
      设 己.数据 为 {}
      设 己.代数 为 己.代数 + 1
      返回 真
    返回 假

# 注销匿名条目：幂等 undo
段落 注销匿名条目(句柄):
  如果 是字典(句柄) == 假:
    返回 假
  如果 字典包含键(句柄, "表") == 假:
    返回 假
  返回 句柄["表"].撤销追加(句柄)

# =====================================================================
# §7 存储层之二：简单作用域层 / 作用域层组（store.ts 的 ScopeLayer / ScopedLayers）
# =====================================================================

# 取名字表：层 → 命名条目表（取表 空 时用标准层的 命名）
段落 取名字表(层, 取表):
  如果 是空(取表) == 假:
    返回 取表(层)
  返回 层.命名

# 空变更：缺省变更通知器（无订阅者）
段落 空变更:
  返回 真

# 简单作用域层：一个作用域对注册表的全部贡献（NamedEntries + AnonymousEntries）
类 简单作用域层:
  属性 键 等于 空
  属性 命名 等于 空
  属性 匿名 等于 空

  段落 构造(作用域键=空):
    设 己.键 为 作用域键
    设 己.命名 为 新建 命名条目表(空)
    设 己.匿名 为 新建 匿名条目表()

  段落 为空:
    如果 己.命名.为空() == 真 且 己.匿名.为空() == 真:
      返回 真
    返回 假

# 建标准层：ScopedLayers 缺省建层器
段落 建标准层(作用域键=空):
  返回 新建 简单作用域层(作用域键)

# 作用域层组：一个注册表的全局层 + 精确作用域层
#   注册视图向下继承（子见祖先层）：链上层 / 合并命名 / 收集
#   事件准入向上扩展（父收子事件）：作用域准入（§5）
#   另：上游 ScopedLayers 的 effect 语义由 附着 / 注销附着 承载
类 作用域层组:
  属性 建层器 等于 空
  属性 变更器 等于 空
  属性 全局 等于 空
  属性 作用域层表 等于 空

  段落 构造(建层器实参, 变更器实参):
    设 己.建层器 为 建层器实参
    设 己.变更器 为 变更器实参
    设 己.作用域层表 为 {}
    设 己.全局 为 己.建层器(空)

  段落 全局层:
    返回 己.全局

  段落 取层(作用域键):
    如果 是空(作用域键) == 真:
      返回 空
    设 键ID 为 作用域键ID(作用域键)
    如果 字典包含键(己.作用域层表, 键ID) == 真:
      返回 己.作用域层表[键ID]
    返回 空

  段落 层数:
    返回 列表长度(字典键列表(己.作用域层表))

  段落 确保层(作用域键):
    设 已存在 为 己.取层(作用域键)
    如果 是空(已存在) == 假:
      返回 已存在
    设 新 为 己.建层器(作用域键)
    己.作用域层表[作用域键ID(作用域键)] 为 新
    返回 新

  段落 链上层(作用域键):
    设 链 为 取作用域链(作用域键)
    设 结果 为 []
    设 i 为 列表长度(链) - 1
    当 i >= 0:
      设 层 为 己.取层(链[i])
      如果 是空(层) == 假:
        结果.追加(层)
      设 i 为 i - 1
    返回 结果

  段落 层链(作用域键):
    设 结果 为 []
    结果.追加(己.全局)
    遍历 层 之 己.链上层(作用域键):
      结果.追加(层)
    返回 结果

  段落 合并命名(作用域键, 取表=空):
    设 结果 为 {}
    遍历 层 之 己.层链(作用域键):
      设 子表 为 取名字表(层, 取表)
      遍历 名字 之 子表.名字列表():
        结果[名字] 为 子表.取(名字)
    返回 结果

  段落 收集(作用域键, 取表=空):
    设 命名条目 为 []
    设 匿名条目 为 []
    遍历 层 之 己.层链(作用域键):
      设 子表 为 取名字表(层, 取表)
      遍历 名字 之 子表.名字列表():
        命名条目.追加(["名": 名字, "值": 子表.取(名字)])
      遍历 值 之 层.匿名.值列表():
        匿名条目.追加(值)
    返回 ["命名条目": 命名条目, "匿名条目": 匿名条目]

  段落 为空(作用域键):
    设 层 为 己.取层(作用域键)
    如果 是空(层) == 真:
      返回 真
    返回 层.为空()

  段落 附着(上下文, 动作, 标签=空, 通知=真):
    设 作用域键 为 取上下文作用域(上下文)
    设 层 为 己.全局
    设 新建层 为 假
    如果 是空(作用域键) == 假:
      设 已存在 为 己.取层(作用域键)
      如果 是空(已存在) == 真:
        设 层 为 己.建层器(作用域键)
        己.作用域层表[作用域键ID(作用域键)] 为 层
        设 新建层 为 真
      否则:
        设 层 为 已存在
    设 撤销 为 空
    尝试:
      设 撤销 为 动作(层)
    捕获 异常 为 错:
      如果 (是空(作用域键) == 假) 且 (新建层 == 真) 且 (层.为空() == 真):
        字典删除(己.作用域层表, 作用域键ID(作用域键))
      抛出 错
    设 句柄 为 {}
    句柄["活跃"] 为 真
    句柄["层"] 为 层
    句柄["作用域键"] 为 作用域键
    句柄["撤销"] 为 撤销
    句柄["标签"] 为 标签
    句柄["通知"] 为 通知
    句柄["组"] 为 己
    如果 通知 == 真:
      尝试:
        己.变更器()
      捕获 异常 为 错2:
        撤销()
        如果 (是空(作用域键) == 假) 且 (层.为空() == 真):
          字典删除(己.作用域层表, 作用域键ID(作用域键))
        己.变更器()
        抛出 错2
    返回 句柄

  段落 撤销附着(句柄):
    如果 是字典(句柄) == 假:
      返回 假
    如果 句柄["活跃"] == 假:
      返回 假
    句柄["活跃"] 为 假
    句柄["撤销"]()
    设 作用域键 为 句柄["作用域键"]
    如果 (是空(作用域键) == 假) 且 (句柄["层"].为空() == 真):
      字典删除(己.作用域层表, 作用域键ID(作用域键))
    如果 句柄["通知"] == 真:
      己.变更器()
    返回 真

# 注销附着：对应 effect 返回的注销器（幂等）
段落 注销附着(句柄):
  如果 是字典(句柄) == 假:
    返回 假
  如果 字典包含键(句柄, "组") == 假:
    返回 假
  返回 句柄["组"].撤销附着(句柄)

# 造作用域层组：缺省用 建标准层 + 空变更
段落 造作用域层组(建层器实参=空, 变更器实参=空):
  设 层建 为 建层器实参
  如果 是空(层建) == 真:
    设 层建 为 建标准层
  设 层变 为 变更器实参
  如果 是空(层变) == 真:
    设 层变 为 空变更
  返回 新建 作用域层组(层建, 层变)

