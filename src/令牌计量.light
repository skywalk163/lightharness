# 令牌计量.light —— E5：每轮/累计 token 与花费计量 + 消息启发式估算
#
# 契约（对齐原版 packages/llm/token-meter）：
#   - 令牌计量器 持本轮输入/输出与累计输入/输出、累计花费（美元），按模型单价计费。
#   - 单价表（$ / 1M tokens，输入 / 输出）：
#       deepseek-chat     0.27 / 1.10
#       deepseek-reasoner 0.27 / 1.10
#       deepseek-flash    0.27 / 1.10（0.1.5 默认模型 V41 Flash，与 deepseek-chat 同代同价；
#                                          如官方定价有更新可调整）
#       gpt-4o            2.50 / 10.00
#       gpt-4o-mini       0.15 /  0.60
#       其它（未知模型）  1.00 /  2.00  （未知一律用此缺省）
#   - 估算启发式（对齐原版 estimate 的粗粒度）：
#       中文（含中日韩统一表意）1.5 字/token
#       英文 4 字符/token
#       代码 3 字符/token
#   - 记录响应() 接收模型响应的 usage（prompt_tokens/completion_tokens），
#     也兼容「输入token/输出token」中文键与 结果.获取 的兜底。
#
# ⚠️ 光明命名规范 v1：局部名避用 数/序/事件/头/原因 等关键字/易拆词根；
#    循环变量用 字符项/部分；类方法内 if 分支不接同级语句，用提前返回。

# 中文单价表（键 = 模型名；值 = [输入单价, 输出单价]，单位 $/1M tokens）
# deepseek-flash：0.1.5 默认模型（客户端 取默认模型()，DeepSeek V41 Flash），与
# deepseek-chat 同代同价 0.27/1.10（如官方定价有更新可调整）；未知模型仍回落 缺省单价表。
设 单价表 为 ["deepseek-chat": [0.27, 1.10], "deepseek-reasoner": [0.27, 1.10], "deepseek-flash": [0.27, 1.10], "gpt-4o": [2.50, 10.00], "gpt-4o-mini": [0.15, 0.60]]

# 缺省单价：未知模型一律使用（$1/1M 输入，$2/1M 输出）
设 缺省单价表 为 [1.00, 2.00]

# 每百万 token 的除数
设 百万 为 1000000.0

# 每类文本的每 token 字符数
设 中文每令牌字 为 1.5
设 英文每令牌字 为 4.0
设 代码每令牌字 为 3.0

# B1 项#3 令牌折叠：复用 令牌估算 的工具 schema 计价（request/header 工具来自 数据["工具模式"]）
从 令牌估算 导入 估算工具令牌

# 从模型名取单价对；未知回落到 缺省单价表（不抛错）
段落 取单价(模型名):
  如果 模型名 == 空 或 模型名 == "":
    返回 缺省单价表
  如果 单价表.包含(模型名):
    返回 单价表[模型名]
  返回 缺省单价表


# 单字符分类：中文 / 英文 / 代码（含标点、空白、符号）
#   返回 "中文" 或 "英文" 或 "代码"
段落 分类字符(字符):
  设 码 为 ord(字符)
  # CJK 统一表意 (U+4E00–U+9FFF)
  如果 码 >= 19968 且 码 <= 40959:
    返回 "中文"
  # CJK 扩展 A (U+3400–U+4DBF)
  如果 码 >= 13312 且 码 <= 19887:
    返回 "中文"
  # CJK 兼容表意 (U+F900–U+FAFF)
  如果 码 >= 63744 且 码 <= 64255:
    返回 "中文"
  # 中日韩标点 (U+3000–U+303F)
  如果 码 >= 12288 且 码 <= 12351:
    返回 "中文"
  # 平假名/片假名 (U+3040–U+309F) + 片假名扩展 (U+30A0–U+30FF)
  如果 码 >= 12352 且 码 <= 12543:
    返回 "中文"
  如果 码 >= 12448 且 码 <= 12543:
    返回 "中文"
  # 韩文音节 (U+AC00–U+D7AF)
  如果 码 >= 44032 且 码 <= 55215:
    返回 "中文"
  # 英文大写字母 (A-Z)
  如果 码 >= 65 且 码 <= 90:
    返回 "英文"
  # 英文小写字母 (a-z)
  如果 码 >= 97 且 码 <= 122:
    返回 "英文"
  # 数字 (0-9)
  如果 码 >= 48 且 码 <= 57:
    返回 "英文"
  返回 "代码"


# 纯文本估算：中文按 1.5 字/token，英文按 4 字符/token，其余按 3 字符/token
#   返回浮点 token 数
段落 估算文本(文本):
  如果 文本 == 空 或 文本 == "":
    返回 0.0
  设 中文 为 0
  设 英文 为 0
  设 代码 为 0
  设 i 为 0
  当 i < 长度(文本):
    设 字符 为 文本[i]
    设 分类 为 分类字符(字符)
    如果 分类 == "中文":
      设 中文 为 中文 + 1
    否则 如果 分类 == "英文":
      设 英文 为 英文 + 1
    否则:
      设 代码 为 代码 + 1
    设 i 为 i + 1
  设 结果 为 (转浮点(中文) / 中文每令牌字) + (转浮点(英文) / 英文每令牌字) + (转浮点(代码) / 代码每令牌字)
  返回 结果


# 估算一条消息的 token 数
#   支持两种形态：
#     a) OpenAI 形态：{"role":..,"content":"文本"} 或 content 为 [{"type":"text","text":"..."}]
#     b) Agent 内部形态：{"角色":..,"内容":"文本"}
#   content 也可能是字符串数组/字典；无法识别的键回落为序列化字符串估价
段落 估算消息(消息):
  如果 消息 == 空 或 type(消息) != dict:
    返回 0.0
  设 内容 为 空
  如果 消息.包含("content"):
    设 内容 为 消息["content"]
  否则 如果 消息.包含("内容"):
    设 内容 为 消息["内容"]
  如果 内容 == 空:
    返回 0.0
  如果 type(内容) == str:
    返回 估算文本(内容)
  如果 type(内容) == list:
    设 汇总 为 0.0
    遍历 块 之 内容:
      如果 type(块) == str:
        设 汇总 为 汇总 + 估算文本(块)
      否则 如果 type(块) == dict:
        设 文本 为 空
        如果 块.包含("text"):
          设 文本 为 转字符串(块["text"])
        否则 如果 块.包含("arguments"):
          设 文本 为 转字符串(块["arguments"])
        如果 文本 != 空:
          设 汇总 为 汇总 + 估算文本(文本)
        否则:
          设 汇总 为 汇总 + 估算文本(转字符串(块))
      否则:
        设 汇总 为 汇总 + 估算文本(转字符串(块))
    返回 汇总
  返回 估算文本(转字符串(内容))


# 估算整条消息历史的 token 数（供压缩触发判断）
段落 估算消息表(消息表):
  设 汇总 为 0.0
  遍历 消息 之 消息表:
    设 汇总 为 汇总 + 估算消息(消息)
  返回 汇总


# ============================================================
# 令牌计量器：本轮 + 累计计数与花费
# ============================================================
类 令牌计量器:
  属性 模型 等于 ""
  属性 单价 等于 空
  属性 本轮输入 等于 0
  属性 本轮输出 等于 0
  属性 累计输入 等于 0
  属性 累计输出 等于 0
  属性 累计花费 等于 0.0

  # 构造：可选模型名（入口方应传 取默认模型() 结果；缺省空串按 缺省单价表 计费）
  段落 构造(模型=""):
    设 己.模型 为 模型
    设 己.单价 为 取单价(模型)

  # 切换模型（配置热更新后调用）；累计花费保留
  段落 设置模型(模型):
    设 己.模型 为 模型
    设 己.单价 为 取单价(模型)

  # 记录一次模型响应：优先取 usage.prompt_tokens / completion_tokens，
  #   回落 "输入token" / "输出token"，再回落 0
  段落 记录响应(响应):
    设 输入 为 0
    设 输出 为 0
    如果 响应 != 空 且 type(响应) == dict:
      如果 响应.包含("usage") 且 type(响应["usage"]) == dict:
        设 用法 为 响应["usage"]
        如果 用法.包含("prompt_tokens"):
          设 输入 为 转整数(用法["prompt_tokens"])
        如果 用法.包含("completion_tokens"):
          设 输出 为 转整数(用法["completion_tokens"])
      如果 输入 == 0 且 响应.包含("输入token"):
        设 输入 为 转整数(响应["输入token"])
      如果 输出 == 0 且 响应.包含("输出token"):
        设 输出 为 转整数(响应["输出token"])
    设 己.本轮输入 为 输入
    设 己.本轮输出 为 输出
    设 己.累计输入 为 己.累计输入 + 输入
    设 己.累计输出 为 己.累计输出 + 输出
    设 单价 为 己.单价
    设 费用 为 转浮点(输入) * 单价[0] / 百万 + 转浮点(输出) * 单价[1] / 百万
    设 己.累计花费 为 己.累计花费 + 费用
    返回 真

  # 本轮统计快照（供 SSE 统计事件使用）
  段落 本轮统计:
    返回 ["本轮输入": 己.本轮输入, "本轮输出": 己.本轮输出]

  # 累计统计快照（含花费美元）
  段落 累计统计:
    返回 ["累计输入": 己.累计输入, "累计输出": 己.累计输出, "累计花费": 己.累计花费]

  # 重置本轮计数（保留累计）
  段落 重置本轮:
    设 己.本轮输入 为 0
    设 己.本轮输出 为 0
    返回 真

  # 当前模型与单价（诊断用）
  段落 取单价表:
    返回 ["模型": 己.模型, "输入单价": 己.单价[0], "输出单价": 己.单价[1]]

导出 令牌计量器
导出 估算消息
导出 估算消息表
导出 估算文本
导出 取单价

# =====================================================================
# §9 视觉令牌计算（0.1.6 新增：llm-deepseek common/image-tokens.ts，v41 配置逐句移植）
#
# 上游锚点：ddefc45fbc packages/llm/llm-deepseek/src/common/image-tokens.ts（新增 157 行）
#   PATCH_SIZE=14  DOWNSAMPLE_RATIO=3  MAX_IMAGE_TOKENS=1024
#   MIN_PIXELS=544*544=295936  CELL_SIZE=14*3=42
#   gridTokens(h,w)=h*(w+1)+2          gridCells(p)=ceilDiv(intDiv(p,14),3)
#   solveResizeRatio 闭式解三分支（igw<1 / igh<1 / 按比例缩放并对齐 14）
#   safeResize 直投不超限则直投，否则求解；resizeOnce 小图放大 + 14 对齐 + safeResize
#   deepSeekImageTokens ≤10 轮 fixpoint；deepSeekRequestImageDimensions 直投不超限即原尺寸
# 语言差异登记：
#   L-126 光明内建 向下取整 是 Math.floor，负数与 JS Math.trunc 不一致 → 自写 截断值。
#   L-125 内建 四舍五入 是银行家舍入；本段只用 floor/trunc/ceil/sqrt，避开该缺陷。
#   L-127 幂(2,n) 返回精确大整数、幂(2.0,n) 返回浮点 → 一律显式 转浮点 后再做除法。
#   L-131 longEdgeDimensions 上游在 attachment/request-projection.ts，附件反馈.light 尚无该段；
#     本任务红线只允许改 5 个 src 文件，故就地移植 长边尺寸（已在交付报告登记同源漂移风险）。
# =====================================================================
# R85A-IMG-TOKENS-SECTION

# JS Math.trunc 语义：正向同 floor，负向向零
# # R85A-TRUNC-FIXED —— 光明 向下取整 是 Math.floor（负数与 JS Math.trunc 差 1），故负数走 0 - floor(0 - x) 分支。
# 实证：修正前 截断值(-2.9) 返回 -3（= floor），修正后返回 -2（= trunc）。
段落 截断值(x):
  如果 x >= 0:
    返回 转整数(向下取整(x))
  返回 0 - 转整数(向下取整(0 - x))

# JS Math.ceil 语义（整数原样返回）
段落 上浮值(x):
  设 下 为 转整数(向下取整(x))
  如果 x == 下:
    返回 下
  返回 下 + 1

# JS Math.floor(a / b)：先转浮点确保浮点除
段落 向下整除(a, b):
  返回 转整数(向下取整(转浮点(a) / 转浮点(b)))

# JS Math.floor((a + b - 1) / b)：正整数向上取整
段落 向上整除(a, b):
  返回 转整数(向下取整((转浮点(a) + 转浮点(b) - 1.0) / 转浮点(b)))

# JS Math.round 语义（half-up）
段落 半数上取整(x):
  返回 转整数(向下取整(x + 0.5))

# gridTokens：每行带分隔符 + 两个框架令牌
段落 视觉网格令牌数(行, 列):
  返回 行 * (列 + 1) + 2

# gridCells：一个补零后的像素轴上的令牌格数
段落 视觉网格格数(补零像素):
  返回 向上整除(向下整除(补零像素, 14), 3)

# solveResizeRatio：在预算内解出保比最大网格（闭式解三分支）
段落 视觉求解网格(高, 宽, 预算):
  设 宽高比 为 转浮点(高) / 转浮点(宽)
  设 理想列 为 平方根((转浮点(预算) - 2.0) / 宽高比 + 0.25) - 0.5
  设 理想行 为 理想列 * 宽高比
  设 最佳宽 为 0
  设 最佳高 为 0
  如果 理想列 < 1.0:
    设 解列 为 1
    设 解行 为 向下整除(预算 - 2, 解列 + 1)
    设 最佳宽 为 解列 * 42
    设 最佳高 为 解行 * 42
  否则 如果 理想行 < 1.0:
    设 解行 为 1
    设 解列 为 向下整除(预算 - 2, 解行) - 1
    设 最佳宽 为 解列 * 42
    设 最佳高 为 解行 * 42
  否则:
    设 解列 为 截断值(理想列)
    设 解行 为 截断值(理想行)
    设 宽比例 为 转浮点(解列) * 42.0 / 转浮点(宽)
    设 高比例 为 转浮点(解行) * 42.0 / 转浮点(高)
    如果 宽比例 <= 高比例:
      设 缩放 为 宽比例
    否则:
      设 缩放 为 高比例
    设 最佳宽 为 截断值(转浮点(宽) * 缩放 / 14.0) * 14
    设 最佳高 为 截断值(转浮点(高) * 缩放 / 14.0) * 14
  设 行 为 视觉网格格数(最佳高)
  设 列 为 视觉网格格数(最佳宽)
  返回 ["网格高": 行, "网格宽": 列, "最佳高": 最佳高, "最佳宽": 最佳宽, "令牌数": 视觉网格令牌数(行, 列)]

# safeResize：直投网格不超 1024 则直投，否则求解
段落 视觉安全缩放(高, 宽, 补零高, 补零宽):
  设 行 为 视觉网格格数(补零高)
  设 列 为 视觉网格格数(补零宽)
  设 直投令牌 为 视觉网格令牌数(行, 列)
  如果 直投令牌 <= 1024:
    返回 ["网格高": 行, "网格宽": 列, "最佳高": 补零高, "最佳宽": 补零宽, "令牌数": 直投令牌]
  设 求解 为 视觉求解网格(高, 宽, 1024)
  如果 求解["令牌数"] > 1024:
    抛出 新建 错误("IMAGE_TOKENS_NO_GRID " + 转字符串(宽) + "x" + 转字符串(高))
  返回 求解

# sameResize：五字段全等
段落 视觉网格相同(甲, 乙):
  如果 甲["网格高"] != 乙["网格高"]:
    返回 假
  如果 甲["网格宽"] != 乙["网格宽"]:
    返回 假
  如果 甲["最佳高"] != 乙["最佳高"]:
    返回 假
  如果 甲["最佳宽"] != 乙["最佳宽"]:
    返回 假
  如果 甲["令牌数"] != 乙["令牌数"]:
    返回 假
  返回 真

# resizeOnce：小图按 sqrt(MIN_PIXELS/pixels) 放大 → 14 对齐 → safeResize
段落 视觉单次缩放(宽, 高):
  设 缩宽 为 宽
  设 缩高 为 高
  设 像素 为 缩宽 * 缩高
  如果 像素 < 295936 且 像素 > 0:
    设 放大 为 平方根(295936.0 / 转浮点(像素))
    设 缩宽 为 截断值(转浮点(缩宽) * 放大)
    设 缩高 为 截断值(转浮点(缩高) * 放大)
  设 补零宽 为 向上整除(缩宽, 14) * 14
  设 补零高 为 向上整除(缩高, 14) * 14
  返回 视觉安全缩放(缩高, 缩宽, 补零高, 补零宽)

# deepSeekImageTokens：≤10 轮 fixpoint，不收敛抛错
段落 视觉令牌数(宽, 高):
  设 结果 为 视觉单次缩放(宽, 高)
  设 i 为 0
  当 i < 9:
    设 下一轮 为 视觉单次缩放(结果["最佳宽"], 结果["最佳高"])
    如果 视觉网格相同(下一轮, 结果):
      返回 结果["令牌数"]
    设 结果 为 下一轮
    设 i 为 i + 1
  抛出 新建 错误("IMAGE_TOKENS_NO_CONVERGE " + 转字符串(宽) + "x" + 转字符串(高))

# longEdgeDimensions（attachment/request-projection.ts）：长边精确、短边半上取整
段落 长边尺寸(宽, 高, 长边):
  设 最大边 为 宽
  如果 高 > 最大边:
    设 最大边 为 高
  如果 长边 >= 最大边:
    返回 ["width": 宽, "height": 高]
  如果 宽 >= 高:
    设 短边 为 半数上取整(转浮点(长边) * 转浮点(高) / 转浮点(宽))
    如果 短边 < 1:
      设 短边 为 1
    返回 ["width": 长边, "height": 短边]
  设 短边 为 半数上取整(转浮点(长边) * 转浮点(宽) / 转浮点(高))
  如果 短边 < 1:
    设 短边 为 1
  返回 ["width": 短边, "height": 长边]

# deepSeekRequestImageDimensions：直投网格不超 1024 即原尺寸，否则按长边求解
段落 深求请求尺寸(宽, 高):
  设 补零宽 为 向上整除(宽, 14) * 14
  设 补零高 为 向上整除(高, 14) * 14
  设 直投令牌 为 视觉网格令牌数(视觉网格格数(补零高), 视觉网格格数(补零宽))
  如果 直投令牌 <= 1024:
    返回 ["width": 宽, "height": 高]
  设 求解 为 视觉求解网格(高, 宽, 1024)
  如果 宽 >= 高:
    设 长边 为 求解["最佳宽"]
  否则:
    设 长边 为 求解["最佳高"]
  返回 长边尺寸(宽, 高, 长边)

# 视觉配置快照（诊断用）
段落 视觉令牌配置:
  返回 ["补丁边长": 14, "降采样比": 3, "最大令牌": 1024, "最小像素": 295936, "单元格像素": 42]

导出 视觉令牌数
导出 深求请求尺寸
导出 视觉求解网格
导出 视觉网格令牌数
导出 视觉网格格数
导出 长边尺寸
导出 截断值
导出 上浮值
# ====================== 0.1.6 增量段 §10 起 ======================
# 上游锚点：ddefc45fbc packages/llm/token-meter/src/{estimate.ts,index.ts}
#
# 移植面（纯逻辑，逐句对照）：
#   estimate.ts:13/16/19  常量 CHARS_PER_TOKEN / BLOCK_OVERHEAD / ROLE_OVERHEAD = 4
#   estimate.ts:31        estimateStructuralBlock（剥离 offloaded 标记后按紧凑 JSON 计价）
#   estimate.ts:45        estimateContent（text/reasoning/tool-call/tool-result + default 结构计价）
#   index.ts:253          case 'image/offload' 折叠 targets -> {seq:Set(imageIndexes)}
#
# 偏离声明：
#   D-1  紧凑JSON 不做字符串转义。上游注释本身写明「No escaping is necessary for
#        our compact format」；且 .light 双引号字符串内书写反斜杠会与词法器冲突
#        双引号字符串内书写反斜杠会被词法器当成转义引号，触发「字符串未闭合」。
#        消息.light 的空字符串() 同源限制已登记为 L-135。
#   D-2  本段不新增 导入 行：只用 stdlib/builtins.py 已内置的名字，
#        避免为 向上取整 / 用分隔符连接 去改本模块头部导入区。
#        上浮取整复用本文件 252 行已有的 上浮值(x)（视觉令牌段同义助手）。
#   D-3  类型判定用 是布尔 优先于 是整数 / 是浮点，
#        因 Python isinstance(True, int) 为真，布尔会被误判为整数。

段落 每令牌字符:
  返回 4

段落 块开销:
  返回 4

段落 角色开销:
  返回 4

# 以逗号连接列表元素（等价 stdlib 用分隔符连接(x, ",")，此处自写以免新增导入）
段落 用逗号连接(列表):
  设 结果 为 ""
  遍历 项 之 列表:
    如果 结果 == "":
      设 结果 为 转字符串(项)
    否则:
      设 结果 为 结果 + "," + 转字符串(项)
  返回 结果

# 紧凑 JSON 序列化：无空格分隔符 + JS 字面量 true/false/null
段落 紧凑JSON(值):
  如果 值 == 空:
    返回 "null"
  如果 是字符串(值):
    返回 '"' + 值 + '"'
  如果 是布尔(值):
    如果 值 == 真:
      返回 "true"
    返回 "false"
  如果 是整数(值) 或 是浮点(值):
    返回 转字符串(值)
  如果 是列表(值):
    设 部件 为 列表创建()
    遍历 项 之 值:
      列表追加(部件, 紧凑JSON(项))
    返回 "[" + 用逗号连接(部件) + "]"
  设 键对 为 列表创建()
  遍历 键 之 值:
    设 键对 为 键对 + [紧凑JSON(键) + ":" + 紧凑JSON(值[键])]
  返回 "{" + 用逗号连接(键对) + "}"

# 剥离 offloaded 标记：卸载标记不改变结构计价值
段落 剥离卸载标记(块):
  设 结果 为 {}
  遍历 键 之 块:
    如果 键 == "offloaded":
      继续
    设 结果[键] 为 块[键]
  返回 结果

段落 估算结构块(块):
  设 载荷 为 紧凑JSON(剥离卸载标记(块))
  返回 块开销() + 上浮值(字符串长度(载荷) / 每令牌字符())

段落 估算内容(内容表):
  设 合计 为 0
  遍历 块 之 内容表:
    如果 块.包含("type") == 假:
      跳出
    如果 块["type"] == "text":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["text"]) / 每令牌字符())
      继续
    如果 块["type"] == "reasoning":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["text"]) / 每令牌字符())
      继续
    如果 块["type"] == "tool-call":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["name"]) / 每令牌字符()) + 上浮值(字符串长度(块["arguments"]) / 每令牌字符())
      继续
    如果 块["type"] == "tool-result":
      设 合计 为 合计 + 块开销() + 估算内容(块["content"])
      继续
    设 合计 为 合计 + 估算结构块(块)
  返回 合计

段落 取卸载目标(事件):
  设 数据 为 取可选(事件, "data")
  如果 是字典(数据) == 假:
    返回 列表创建()
  设 目标 为 取可选(数据, "targets")
  如果 是列表(目标) == 假:
    返回 列表创建()
  返回 目标

段落 折叠图片卸载(节点表, 事件):
  设 映射 为 {}
  遍历 目标 之 取卸载目标(事件):
    设 键 为 目标["seq"]
    如果 映射.包含(键) == 假:
      设 集合 为 列表创建()
      设 映射[键] 为 集合
    设 集合 为 映射[键]
    设 索引表 为 取可选(目标, "imageIndexes")
    如果 是列表(索引表) == 假:
      继续
    遍历 索引 之 索引表:
      如果 列表包含(集合, 索引) == 假:
        列表追加(集合, 索引)
  设 结果 为 列表创建()
  遍历 节点 之 节点表:
    设 键 为 取可选(节点, "seq")
    如果 映射.包含(键) == 假:
      列表追加(结果, 节点)
      继续
    设 集合 为 映射[键]
    设 原图片 为 取可选(节点, "images")
    如果 是列表(原图片) == 假:
      列表追加(结果, 节点)
      继续
    设 图片表 为 列表创建()
    设 索引 为 0
    遍历 图片 之 原图片:
      如果 列表包含(集合, 索引) == 真:
        设 拷贝 为 深拷贝(图片)
        设 拷贝["offloaded"] 为 真
        列表追加(图片表, 拷贝)
      否则:
        列表追加(图片表, 图片)
      设 索引 为 索引 + 1
    设 新节点 为 深拷贝(节点)
    设 新节点["images"] 为 图片表
    列表追加(结果, 新节点)
  返回 结果

导出 每令牌字符
导出 块开销
导出 角色开销
导出 用逗号连接
导出 紧凑JSON
导出 剥离卸载标记
导出 估算结构块
导出 估算内容
导出 取卸载目标
导出 折叠图片卸载

# =====================================================================
# B1 项#3：令牌计量折叠（对齐 token-meter surface-fold.ts / breakdown-projection.ts / surface-projection.ts）
#
# 纯逻辑核心：保留面（retained surface）启发式组成——系统提示按序保留，其余消息按增量计价，
#   状态大小只随系统提示数而非消息数增长。plan/commit 两段式保证失败不改状态，
#   同一畸形事件重试表现一致。结构性附件（图片/文件）按结构计价。
# 已剔除：Cordis 胶水、zod schema 校验、projection 注册表；事件用 lightharness surface 事件形状
#   { 类型, 序号, surfaceOp: "append" | { startSeq, endSeq }, 数据 }。
#   会话事件消息导出/表面判定本地化（与 会话.light 投影消息 同语义，规避 L-004 词法坑、不耦合宿主）。
# 语言坑：局部变量/循环变量避用「事件」二字（用 事件项/候/块/序），避免把「事件表」拆词。

# ---- 表面事件判定（对齐 upstream isSurfaceEvent：消息产出型事件，含 system/developer）----
段落 是表面事件类型(类型):
  返回 类型 == "system/message" 或 类型 == "developer/message" 或 类型 == "user/message" 或 类型 == "assistant/message" 或 类型 == "tool/result"

# ---- 从表面事件导出消息（对齐 deriveEventMessage）；非表面/空内容返回 空 ----
# 系统提示（system/message）亦为表面事件，按文本块计价（上游 deriveEventMessage 含系统提示）。
段落 导出事件消息(事件项):
  设 类型 为 事件项["类型"]
  如果 类型 == "system/message":
    返回 ["role": "system", "content": [["type": "text", "text": 事件项["数据"]["系统"]]]]
  如果 类型 == "user/message":
    返回 事件项["数据"]
  如果 类型 == "assistant/message":
    设 消息 为 事件项["数据"]["消息"]
    如果 字典包含键(事件项["数据"], "流") 且 是列表(事件项["数据"]["流"]):
      设 合并 为 []
      遍历 块 之 消息["content"]:
        合并.追加(块)
      遍历 块 之 事件项["数据"]["流"]:
        合并.追加(块)
      消息["content"] 为 合并
    如果 长度(消息["content"]) == 0:
      返回 空
    返回 消息
  如果 类型 == "tool/result":
    返回 事件项["数据"]["消息"]
  返回 空

# ---- 收集结构性附件（图片/文件）及其结构价（对齐 collectProjectedAttachments）----
段落 收集投影附件(块表, 图片, 文件):
  设 图片令牌 为 0
  设 文件令牌 为 0
  遍历 块 之 块表:
    如果 块["type"] == "image":
      图片.追加(块)
      图片令牌 为 图片令牌 + 估算结构块(块)
    否则 如果 块["type"] == "file":
      文件.追加(块["attachment"])
      文件令牌 为 文件令牌 + 估算结构块(块)
  返回 ["图片令牌": 图片令牌, "文件令牌": 文件令牌]

# ---- 由表面事件导出的消息造一个计价节点（对齐 analyzeNode）----
段落 分析节点(序号, 消息):
  如果 消息 == 空:
    返回 ["序号": 序号, "启发式令牌": 0, "图片结构令牌": 0, "文件结构令牌": 0, "图片": [], "文件": []]
  设 启发式令牌 为 估算消息(消息)
  设 图片 为 []
  设 文件 为 []
  设 结构 为 收集投影附件(消息["content"], 图片, 文件)
  返回 ["序号": 序号, "启发式令牌": 启发式令牌, "图片结构令牌": 结构["图片令牌"], "文件结构令牌": 结构["文件令牌"], "图片": 图片, "文件": 文件]

# ---- 规划表面令牌（只读试算，不改动节点表；对齐 planSurfaceTokens）----
# 畸形替换区间（在节点表中无解）视为日志损坏，必须响亮抛错而非跳过。
段落 规划表面令牌(节点表, 事件项):
  设 节点 为 分析节点(事件项["序号"], 导出事件消息(事件项))
  设 令牌 为 节点["启发式令牌"]
  设 操作 为 事件项["surfaceOp"]
  如果 操作 == "append" 或 操作 == 空:
    返回 ["令牌": 令牌, "增量令牌": 令牌, "节点": 节点, "目标": "append"]
  设 起 为 操作["startSeq"]
  设 止 为 操作["endSeq"]
  设 起序 为 -1
  设 止序 为 -1
  设 序 为 0
  遍历 候 之 节点表:
    如果 候["序号"] == 起: 设 起序 为 序
    如果 候["序号"] == 止: 设 止序 为 序
    设 序 为 序 + 1
  如果 起序 == -1 或 止序 == -1 或 起序 > 止序:
    抛出 新建 错误("token surface: replace at seq " + 转字符串(事件项["序号"]) + " has invalid current range " + 转字符串(起) + "-" + 转字符串(止))
  设 移除 为 0
  设 序2 为 起序
  当 序2 <= 止序:
    设 移除 为 移除 + 节点表[序2]["启发式令牌"]
    设 序2 为 序2 + 1
  返回 ["令牌": 令牌, "增量令牌": 令牌 - 移除, "节点": 节点, "目标": ["起序": 起序, "止序": 止序]]

# ---- 提交表面令牌（原地，必然成功；对齐 commitSurfaceTokens）----
段落 提交表面令牌(节点表, 计划):
  如果 计划["目标"] == "append":
    节点表.追加(计划["节点"])
    返回
  设 起序 为 计划["目标"]["起序"]
  设 止序 为 计划["目标"]["止序"]
  设 i 为 止序
  当 i >= 起序:
    列表弹出(节点表, i)
    设 i 为 i - 1
  列表插入(节点表, 起序, 计划["节点"])

# ---- O(1) 表面令牌折叠（对齐 surface-projection.ts foldSurfaceProjection）----
# 声明（claim）= 紧邻压缩事件（compaction/summary|prune）声明的被替换区间启发式价；
#   压缩事件与其后的 surface replace 同步相邻，故存活声明必然定价下一事件。
#   无声明的 replace 折叠为零增量（有界状态无法重建被替换区间价，容忍历史重放漂移）。
段落 折叠表面投影(声明, 事件项):
  设 类型 为 事件项["类型"]
  如果 类型 == "compaction/summary" 或 类型 == "compaction/prune":
    设 范围 为 事件项["数据"]["shadowedRange"]
    返回 ["增量令牌": 0, "声明": ["起": 范围["start"], "止": 范围["end"], "令牌": 事件项["数据"]["shadowedTokenCount"]]]
  如果 是表面事件类型(类型) == 假:
    返回 ["增量令牌": 0, "声明": 空]
  设 消息 为 导出事件消息(事件项)
  设 令牌 为 0
  如果 消息 != 空:
    设 令牌 为 估算消息(消息)
  设 操作 为 事件项["surfaceOp"]
  如果 操作 == "append" 或 操作 == 空:
    返回 ["增量令牌": 令牌, "声明": 空]
  如果 声明 == 空:
    返回 ["增量令牌": 0, "声明": 空]
  设 起 为 操作["startSeq"]
  设 止 为 操作["endSeq"]
  如果 声明["起"] != 起 或 声明["止"] != 止:
    抛出 新建 错误("token surface: replace at seq " + 转字符串(事件项["序号"]) + " over range " + 转字符串(起) + "-" + 转字符串(止) + " has no adjacent shadow price (armed claim covers " + 转字符串(声明["起"]) + "-" + 转字符串(声明["止"]) + ")")
  返回 ["增量令牌": 令牌 - 声明["令牌"], "声明": 空]

# ---- 语境拆解投影（对齐 breakdown-projection.ts contextBreakdownProjectionDefinition）----
# 有界状态：只保留存活系统提示（按序）+ 一个运行表面总额 + 至多一个待消费声明；不保留逐节点价。
# 工具价来自最新 request/header 的 tools；压缩事件声明遮蔽其覆盖的系统提示。

# 建初始语境拆解状态
段落 建语境拆解状态:
  返回 ["系统": [], "表面令牌": 0, "声明": 空, "拆解": ["系统令牌": 0, "工具令牌": 0, "消息令牌": 0]]

# 去掉已武装的声明（无声明则状态不变）
段落 去掉声明(状态):
  如果 状态["声明"] == 空:
    返回 状态
  返回 ["系统": 状态["系统"], "表面令牌": 状态["表面令牌"], "声明": 空, "拆解": 状态["拆解"]]

# 放置一个表面事件（返回 系统提示表 + 表面总额）
段落 放置表面事件(状态, 声明, 事件项, 令牌):
  设 操作 为 事件项["surfaceOp"]
  设 节点 为 ["序号": 事件项["序号"], "令牌": 令牌]
  设 是系统 为 事件项["类型"] == "system/message"
  如果 操作 == "append" 或 操作 == 空:
    如果 是系统:
      返回 ["系统": 状态["系统"] + [节点], "表面令牌": 状态["表面令牌"] + 令牌]
    返回 ["系统": 状态["系统"], "表面令牌": 状态["表面令牌"] + 令牌]
  如果 声明 != 空:
    如果 声明["起"] != 操作["startSeq"] 或 声明["止"] != 操作["endSeq"]:
      抛出 新建 错误("context breakdown: replace at seq " + 转字符串(事件项["序号"]) + " over range " + 转字符串(操作["startSeq"]) + "-" + 转字符串(操作["endSeq"]) + " has no adjacent shadow price (armed claim covers " + 转字符串(声明["起"]) + "-" + 转字符串(声明["止"]) + ")")
    如果 是系统:
      抛出 新建 错误("context breakdown: replace at seq " + 转字符串(事件项["序号"]) + " puts a system message in place of a metered range; its order among the surviving system prompts is unknown")
    设 遮蔽集 为 声明["系统序号表"]
    设 新系统 为 []
    遍历 系统 之 状态["系统"]:
      如果 列表包含(遮蔽集, 系统["序号"]) == 假:
        新系统.追加(系统)
    返回 ["系统": 新系统, "表面令牌": 状态["表面令牌"] + 令牌 - 声明["令牌"]]
  设 索引 为 -1
  如果 操作["startSeq"] == 操作["endSeq"]:
    设 序 为 0
    遍历 系统 之 状态["系统"]:
      如果 系统["序号"] == 操作["startSeq"]:
        设 索引 为 序
      设 序 为 序 + 1
  如果 索引 == -1:
    返回 ["系统": 状态["系统"], "表面令牌": 状态["表面令牌"]]
  如果 是系统:
    设 新系统 为 []
    设 序 为 0
    遍历 系统 之 状态["系统"]:
      如果 序 == 索引:
        新系统.追加(节点)
      否则:
        新系统.追加(系统)
      设 序 为 序 + 1
    返回 ["系统": 新系统, "表面令牌": 状态["表面令牌"] + 令牌 - 状态["系统"][索引]["令牌"]]
  设 新系统 为 []
  设 序 为 0
  遍历 系统 之 状态["系统"]:
    如果 序 != 索引:
      新系统.追加(系统)
    设 序 为 序 + 1
  返回 ["系统": 新系统, "表面令牌": 状态["表面令牌"] + 令牌 - 状态["系统"][索引]["令牌"]]

# 发布总额，拆解不变时复用对象（避免无谓分配）
段落 带总额(状态, 总数):
  设 表面令牌 为 最大值([0, 总数["表面令牌"]])
  设 系统令牌 为 0
  遍历 系统 之 总数["系统"]:
    如果 系统["令牌"] > 0:
      设 系统令牌 为 系统["令牌"]
  设 消息令牌 为 最大值([0, 表面令牌 - 系统令牌])
  如果 系统令牌 == 状态["拆解"]["系统令牌"] 且 消息令牌 == 状态["拆解"]["消息令牌"]:
    设 拆解 为 状态["拆解"]
  否则:
    设 拆解 为 ["系统令牌": 系统令牌, "工具令牌": 状态["拆解"]["工具令牌"], "消息令牌": 消息令牌]
  返回 ["系统": 总数["系统"], "表面令牌": 表面令牌, "声明": 状态["声明"], "拆解": 拆解]

# 应用一个事件到语境拆解状态（对齐 projection apply）
段落 应用语境拆解(状态, 事件项):
  设 类型 为 事件项["类型"]
  如果 类型 == "compaction/summary" 或 类型 == "compaction/prune":
    设 数据 为 事件项["数据"]
    设 遮蔽集 为 数据["shadowedSeqs"]
    设 新系统 为 []
    遍历 系统 之 状态["系统"]:
      如果 列表包含(遮蔽集, 系统["序号"]) == 真:
        新系统.追加(系统["序号"])
    返回 ["系统": 状态["系统"], "表面令牌": 状态["表面令牌"], "声明": ["起": 数据["shadowedRange"]["start"], "止": 数据["shadowedRange"]["end"], "令牌": 数据["shadowedTokenCount"], "系统序号表": 新系统], "拆解": 状态["拆解"]]
  设 无声明 为 去掉声明(状态)
  如果 类型 == "request/header":
    设 工具模式 为 空
    如果 字典包含键(事件项["数据"], "工具模式"):
      设 工具模式 为 事件项["数据"]["工具模式"]
    否则 如果 字典包含键(事件项["数据"], "tools"):
      设 工具模式 为 事件项["数据"]["tools"]
    设 工具令牌 为 估算工具令牌(["tools": 工具模式])
    如果 工具令牌 == 无声明["拆解"]["工具令牌"]:
      返回 无声明
    返回 ["系统": 无声明["系统"], "表面令牌": 无声明["表面令牌"], "声明": 空, "拆解": ["系统令牌": 无声明["拆解"]["系统令牌"], "工具令牌": 工具令牌, "消息令牌": 无声明["拆解"]["消息令牌"]]]
  如果 是表面事件类型(类型) == 假:
    返回 无声明
  设 消息 为 导出事件消息(事件项)
  设 令牌 为 0
  如果 消息 != 空:
    设 令牌 为 估算消息(消息)
  返回 带总额(无声明, 放置表面事件(无声明, 状态["声明"], 事件项, 令牌))

导出 是表面事件类型
导出 导出事件消息
导出 分析节点
导出 规划表面令牌
导出 提交表面令牌
导出 折叠表面投影
导出 建语境拆解状态
导出 应用语境拆解
