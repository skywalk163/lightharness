# ====================== 0.1.6 增量段 §10 起 ======================
# 上游锚点：ddefc45fbc packages/llm/token-meter/src/{estimate.ts,index.ts}
#
# 移植面（纯逻辑，逐句对照）：
#   estimate.ts:13/16/19  常量 CHARS_PER_TOKEN / BLOCK_OVERHEAD / ROLE_OVERHEAD = 4
#   estimate.ts:31        estimateStructuralBlock（剥离 offloaded 标记后按紧凑 JSON 计价）
#   estimate.ts:45        estimateContent（text/reasoning/tool-call/tool-result + default 结构计价）
#   index.ts:253          case 'image/offload' 折叠 targets -> {seq:Set(imageIndexes)}
#
# 偏离声明：
#   D-1  紧凑JSON 不做字符串转义。上游注释本身写明「No escaping is necessary for
#        our compact format」；且 .light 双引号字符串内书写反斜杠会与词法器冲突
#        双引号字符串内书写反斜杠会被词法器当成转义引号，触发「字符串未闭合」。
#        消息.light 的空字符串() 同源限制已登记为 L-135。
#   D-2  本段不新增 导入 行：只用 stdlib/builtins.py 已内置的名字，
#        避免为 向上取整 / 用分隔符连接 去改本模块头部导入区。
#        上浮取整复用本文件 252 行已有的 上浮值(x)（视觉令牌段同义助手）。
#   D-3  类型判定用 是布尔 优先于 是整数 / 是浮点，
#        因 Python isinstance(True, int) 为真，布尔会被误判为整数。

段落 每令牌字符:
  返回 4

段落 块开销:
  返回 4

段落 角色开销:
  返回 4

# 以逗号连接列表元素（等价 stdlib 用分隔符连接(x, ",")，此处自写以免新增导入）
段落 用逗号连接(列表):
  设 结果 为 ""
  遍历 项 之 列表:
    如果 结果 == "":
      设 结果 为 转字符串(项)
    否则:
      设 结果 为 结果 + "," + 转字符串(项)
  返回 结果

# 紧凑 JSON 序列化：无空格分隔符 + JS 字面量 true/false/null
段落 紧凑JSON(值):
  如果 值 == 空:
    返回 "null"
  如果 是字符串(值):
    返回 '"' + 值 + '"'
  如果 是布尔(值):
    如果 值 == 真:
      返回 "true"
    返回 "false"
  如果 是整数(值) 或 是浮点(值):
    返回 转字符串(值)
  如果 是列表(值):
    设 部件 为 列表创建()
    遍历 项 之 值:
      列表追加(部件, 紧凑JSON(项))
    返回 "[" + 用逗号连接(部件) + "]"
  设 键对 为 列表创建()
  遍历 键 之 值:
    设 键对 为 键对 + [紧凑JSON(键) + ":" + 紧凑JSON(值[键])]
  返回 "{" + 用逗号连接(键对) + "}"

# 剥离 offloaded 标记：卸载标记不改变结构计价值
段落 剥离卸载标记(块):
  设 结果 为 {}
  遍历 键 之 块:
    如果 键 == "offloaded":
      继续
    设 结果[键] 为 块[键]
  返回 结果

段落 估算结构块(块):
  设 载荷 为 紧凑JSON(剥离卸载标记(块))
  返回 块开销() + 上浮值(字符串长度(载荷) / 每令牌字符())

段落 估算内容(内容表):
  设 合计 为 0
  遍历 块 之 内容表:
    如果 块.包含("type") == 假:
      跳出
    如果 块["type"] == "text":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["text"]) / 每令牌字符())
      继续
    如果 块["type"] == "reasoning":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["text"]) / 每令牌字符())
      继续
    如果 块["type"] == "tool-call":
      设 合计 为 合计 + 块开销() + 上浮值(字符串长度(块["name"]) / 每令牌字符()) + 上浮值(字符串长度(块["arguments"]) / 每令牌字符())
      继续
    如果 块["type"] == "tool-result":
      设 合计 为 合计 + 块开销() + 估算内容(块["content"])
      继续
    设 合计 为 合计 + 估算结构块(块)
  返回 合计

段落 取卸载目标(事件):
  设 数据 为 取可选(事件, "data")
  如果 是字典(数据) == 假:
    返回 列表创建()
  设 目标 为 取可选(数据, "targets")
  如果 是列表(目标) == 假:
    返回 列表创建()
  返回 目标

段落 折叠图片卸载(节点表, 事件):
  设 映射 为 {}
  遍历 目标 之 取卸载目标(事件):
    设 键 为 目标["seq"]
    如果 映射.包含(键) == 假:
      设 集合 为 列表创建()
      设 映射[键] 为 集合
    设 集合 为 映射[键]
    设 索引表 为 取可选(目标, "imageIndexes")
    如果 是列表(索引表) == 假:
      继续
    遍历 索引 之 索引表:
      如果 列表包含(集合, 索引) == 假:
        列表追加(集合, 索引)
  设 结果 为 列表创建()
  遍历 节点 之 节点表:
    设 键 为 取可选(节点, "seq")
    如果 映射.包含(键) == 假:
      列表追加(结果, 节点)
      继续
    设 集合 为 映射[键]
    设 原图片 为 取可选(节点, "images")
    如果 是列表(原图片) == 假:
      列表追加(结果, 节点)
      继续
    设 图片表 为 列表创建()
    设 索引 为 0
    遍历 图片 之 原图片:
      如果 列表包含(集合, 索引) == 真:
        设 拷贝 为 深拷贝(图片)
        设 拷贝["offloaded"] 为 真
        列表追加(图片表, 拷贝)
      否则:
        列表追加(图片表, 图片)
      设 索引 为 索引 + 1
    设 新节点 为 深拷贝(节点)
    设 新节点["images"] 为 图片表
    列表追加(结果, 新节点)
  返回 结果

