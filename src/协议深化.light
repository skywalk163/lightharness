# 协议深化.light —— 对标上游 packages/acp/acp/src/{mcp.ts,model-control.ts,updates.ts}
#                  与 packages/hooks/hook-protocol/src/{detached.ts,events.ts,runner.ts,types.ts}
#
# 原版对象（deepseek-harness @a305303422）：
#   - mcp.ts        (143 行) AcpMcpConfigError / resolveMcpConfigs / normalizeServerName /
#                            entriesToRecord / assertHttpUrl（宿主面 mountAcpMcpServers 已剔除）
#   - model-control.ts (237 行) AcpModelControl：selected/turnSelection/hasResolvedState/tail 状态，
#                            snapshot/pinTurn/releaseTurn/state/set；modelValue(p,m)=JSON.stringify([p,m])
#                            （resolveSelection/listProviders/listModels/resolveModelInfo/tail 宿主注入）
#   - updates.ts    (111 行) assistantUpdates / usageUpdate / toolCallUpdate / toolResultUpdate /
#                            parseToolArguments（assistantBlockToAcp 来自 content.ts = acp内容.light）
#   - detached.ts   ( 62 行) DetachedRuns{signal,track,drain}：AbortController + Set<Promise>
#   - events.ts     (104 行) DEFAULT_STDERR_SUMMARY_MAX_CHARS=500 / summarizeStderr /
#                            appendHookInvoked / appendHookResult
#   - runner.ts     (106 行) DEFAULT_HOOK_TIMEOUT_MS=600_000 / runHook（parseHookOutput 来自
#                            codec.ts = 钩子协议.light 的 解析钩子产出）
#   - types.ts      (137 行) HookDialect / CommandHook / MatcherGroup / HookOutput 全可选字段
#
# ── 宿主绑定剥离表（原版宿主设施 → 本模块投影）────────────────────────────
#   AcpMcpConfigError            → 抛 新建 错误(上游文案)，由调用方判定
#   mountAcpMcpServers           → 剔除（依赖 Cordis 生命周期/AbortSignal）
#   assertHttpUrl(new URL)       → 校验HTTP网址()：前缀 http://|https:// + 无空白（new URL 主机校验宿主面）
#   isValidAbsolutePath(path)    → 绝对路径判定()：以 / 或 \ 开头（Windows盘符形式宿主面）
#   normalizeServerName          → 规范化服务器名()：合法名直返；否则 NFKD 折叠 + SHA256 前缀 8
#   entriesToRecord              → 条目成记录()：header 按小写身份去重 + token 字符校验；
#                                  environment 非空/无=/无 \0 校验；重复一律抛
#   AcpModelControl 类状态       → 造控制状态()：{"已选","轮次","已解析过"} 字典；轮次覆盖投影为
#                                  状态["轮次"]={"轮次":n,"选择":快照}
#   await this.resolveSelection  → 组装选项() 的「解析结果/解析可用」形参（宿主注入，双参投影）
#   listProviders/listModels     → 提供商表 直接携带 模型表（已解析视图；目录失败=空模型表→空组）
#   resolveModelInfo             → 推理信息 形参（宿主注入）
#   this.tail (Promise 队列)     → 剔除（宿主面，登记差异 R15-D6）
#   AbortController + Set<Promise> → 造分离跟踪器()：{"中止":假,"在飞表":[]}；逗留 以任意标识承载；
#                                  drain 的 async 等待 → 排空运行() 置信号 + 结算全部() 宿主循环形态
#   HookOutput (codec 产物)      → 解析钩子产出()（对接键：退出码/标准输出/标准错误/裁定/续行标志…）
#   事件负载键                   → 英文键 turn/point/dialect/handlerId/matcher/decision/exitCode/
#                                  stderrSummary/durationMs（忠实上游协议线）
#
# ── 光明降级点（口径明确，勿当 bug）─────────────────────────────────────
#   1. null 与 undefined 同为 空：exitCode ?? 语义由「取可选(产出,"退出码",空)」承担，0 不落空；
#      成功分支显式把 执行结果["退出码"]（可能为 空）原样传递给 解析钩子产出 —— 这是判据C变异点。
#   2. NFKD Unicode 规范化宿主面（光明无该内建）；fold 段仅按字符集折叠并登记差异。
#   3. reasoning effort 选择 投影为 已选["推理档位"]=值（字符串），替代原版 ReasoningEffortId 对象。
#   4. 线性循环替代正则量词（L-086 禁花括号量词）：合法名/控制字符/折叠全部手写逐字符判定。

从 内置核心转换 导入 转字符串
从 内置核心判型 导入 是字典, 是列表, 是字符串, 是整数, 是字母
从 内置核心字典 导入 字典创建, 字典包含键, 取可选
从 内置核心列表 导入 列表创建, 列表长度, 列表获取, 列表追加, 列表插入, 列表包含
从 内置核心字符串 导入 字符串获取, 截取, 去除空白, 字符串包含, 开头
从 JSON 导入 解析JSON, 序列化JSON
从 哈希 导入 SHA256
从 字符串工具轻量 导入 转小写
从 钩子协议 导入 解析钩子产出
从 acp内容 导入 assistantBlockToAcp

# =====================================================================
# 一、MCP 域（对标 mcp.ts）
# =====================================================================

段落 ASCII字母(字符):
  返回 (字符 >= "A" 且 字符 <= "Z") 或 (字符 >= "a" 且 字符 <= "z")

段落 ASCII数字(字符):
  返回 字符 >= "0" 且 字符 <= "9"

段落 ASCII字母数字(字符):
  返回 ASCII字母(字符) 或 ASCII数字(字符)

段落 划界字符(字符):
  返回 字符 == "_" 或 字符 == "-"

段落 是服务器名字符(字符):
  返回 ASCII字母数字(字符) 或 划界字符(字符)

段落 含控制字符(名):
  设 步 为 0
  设 命中 为 假
  当 步 < 字符串长度(名):
    设 字符 为 字符串获取(名, 步)
    如果 (字符 < " ") 或 (字符 == "\u007f"):
      设 命中 为 真
    设 步 为 步 + 1
  返回 命中

段落 合法服务器名(名):
  如果 字符串长度(名) < 1 或 字符串长度(名) > 32:
    返回 假
  设 步 为 0
  设 全部合法 为 真
  当 步 < 字符串长度(名):
    如果 是服务器名字符(字符串获取(名, 步)) == 假:
      设 全部合法 为 假
    设 步 为 步 + 1
  返回 全部合法

段落 去首尾划线(文本):
  设 起点 为 0
  设 终点 为 字符串长度(文本)
  当 起点 < 终点 且 字符串获取(文本, 起点) == "_":
    设 起点 为 起点 + 1
  当 终点 > 起点 且 字符串获取(文本, 终点 - 1) == "_":
    设 终点 为 终点 - 1
  返回 截取(文本, 起点, 终点)

段落 折叠服务器名(名):
  设 结果 为 ""
  设 前非法 为 假
  设 步 为 0
  当 步 < 字符串长度(名):
    设 字符 为 字符串获取(名, 步)
    如果 是服务器名字符(字符) == 真:
      设 结果 为 结果 + 字符
      设 前非法 为 假
    否则:
      如果 前非法 == 假:
        设 结果 为 结果 + "_"
        设 前非法 为 真
    设 步 为 步 + 1
  设 结果 为 去首尾划线(结果)
  如果 字符串长度(结果) == 0:
    设 结果 为 "server"
  如果 字符串长度(结果) > 20:
    设 结果 为 截取(结果, 0, 20)
  返回 结果

段落 规范化服务器名(名):
  如果 字符串长度(去除空白(名)) == 0:
    抛 新建 错误("mcpServers contains an invalid server name")
  如果 含控制字符(名) == 真:
    抛 新建 错误("mcpServers contains an invalid server name")
  如果 合法服务器名(名) == 真:
    返回 名
  设 段 为 折叠服务器名(名)
  设 摘要 为 截取(SHA256(名), 0, 8)
  设 合并 为 段 + "_" + 摘要
  如果 字符串长度(合并) > 32:
    返回 截取(合并, 0, 32)
  返回 合并

段落 头标字符(字符):
  如果 ASCII字母数字(字符) == 真:
    返回 真
  返回 字符串包含("!#$%&'*+-.^_`|~", 字符)

段落 头名合法(名):
  如果 字符串长度(名) == 0:
    返回 假
  设 步 为 0
  设 全部合法 为 真
  当 步 < 字符串长度(名):
    如果 头标字符(字符串获取(名, 步)) == 假:
      设 全部合法 为 假
    设 步 为 步 + 1
  返回 全部合法

段落 头值合法(值):
  返回 (字符串包含(值, "\u000d") == 假) 且 (字符串包含(值, "\u000a") == 假) 且 (字符串包含(值, "\u0000") == 假)

段落 环境项合法(名, 值):
  如果 字符串长度(名) == 0:
    返回 假
  如果 字符串包含(名, "=") == 真:
    返回 假
  如果 字符串包含(名, "\u0000") == 真:
    返回 假
  如果 字符串包含(值, "\u0000") == 真:
    返回 假
  返回 真

段落 含空白字符(值):
  设 步 为 0
  设 命中 为 假
  当 步 < 字符串长度(值):
    设 字符 为 字符串获取(值, 步)
    如果 字符 == " " 或 字符 < " ":
      设 命中 为 真
    设 步 为 步 + 1
  返回 命中

段落 条目成记录(条目表, 字段, 类别):
  设 结果 为 字典创建()
  设 已见 为 字典创建()
  遍历 条目 之 条目表:
    设 名 为 条目["名"]
    设 值 为 取可选(条目, "值", "")
    设 身份 为 名
    如果 类别 == "header":
      如果 头名合法(名) == 假 或 头值合法(值) == 假:
        抛 新建 错误(字段 + " contains an invalid header entry")
      设 身份 为 转小写(名)
    否则:
      如果 环境项合法(名, 值) == 假:
        抛 新建 错误(字段 + " contains an invalid environment entry")
    如果 字典包含键(已见, 身份) == 真:
      抛 新建 错误(字段 + " contains duplicate name: " + 名)
    字典设置(已见, 身份, 真)
    字典设置(结果, 名, 值)
  返回 结果

段落 绝对路径判定(路径):
  如果 是字符串(路径) == 假:
    返回 假
  如果 开头(路径, "/") == 真:
    返回 真
  如果 开头(路径, "\\") == 真:
    返回 真
  如果 字符串长度(路径) >= 3:
    设 首位 为 字符串获取(路径, 0)
    设 次位 为 字符串获取(路径, 1)
    如果 (是字母(首位) == 真) 且 (次位 == ":"):
      返回 真
  返回 假

段落 校验HTTP网址(值, 字段):
  如果 是字符串(值) == 假:
    抛 新建 错误(字段 + " must be an absolute HTTP(S) URL")
  如果 (开头(值, "http://") == 假) 且 (开头(值, "https://") == 假):
    抛 新建 错误(字段 + " must be an absolute HTTP(S) URL")
  如果 含空白字符(值) == 真:
    抛 新建 错误(字段 + " must be an absolute HTTP(S) URL")
  返回 真

段落 解析MCP配置(服务器表, 会话目录):
  设 已见 为 字典创建()
  设 配置表 为 列表创建()
  设 索引 为 0
  遍历 服务器 之 服务器表:
    设 名 为 规范化服务器名(服务器["名"])
    如果 字典包含键(已见, 名) == 真:
      抛 新建 错误("mcpServers contains duplicate normalized name: " + 名)
    字典设置(已见, 名, 真)
    如果 字典包含键(服务器, "类型") == 假:
      设 指令 为 取可选(服务器, "指令", "")
      如果 绝对路径判定(指令) == 假:
        抛 新建 错误("mcpServers[" + 转字符串(索引) + "].command must be an absolute path")
      设 环境 为 条目成记录(取可选(服务器, "环境", []), "mcpServers[" + 转字符串(索引) + "].env", "environment")
      列表追加(配置表, {"传输": "stdio", "服务器名": 名, "指令": 指令, "参数": 取可选(服务器, "参数", []), "环境": 环境, "目录": 会话目录, "启动失败即报错": 真})
    否则如果 服务器["类型"] == "http":
      校验HTTP网址(取可选(服务器, "网址", 空), "mcpServers[" + 转字符串(索引) + "].url")
      设 头表 为 条目成记录(取可选(服务器, "头表", []), "mcpServers[" + 转字符串(索引) + "].headers", "header")
      列表追加(配置表, {"传输": "streamable-http", "服务器名": 名, "网址": 服务器["网址"], "头表": 头表, "启动失败即报错": 真})
    否则:
      抛 新建 错误("mcpServers[" + 转字符串(索引) + "] transport " + 转字符串(服务器["类型"]) + " is not supported")
    设 索引 为 索引 + 1
  返回 配置表

# =====================================================================
# 二、模型控制域（对标 model-control.ts）
# =====================================================================

段落 造控制状态(初始选择):
  返回 {"已选": 初始选择, "轮次": 空, "已解析过": 假}

段落 模型选择值(提供者, 成员):
  返回 序列化JSON([提供者, 成员])

段落 快照选择(状态):
  设 已选 为 状态["已选"]
  如果 已选 == 空:
    返回 空
  设 快照 为 {"提供者": 已选["提供者"], "成员": 已选["成员"]}
  如果 取可选(已选, "推理档位", 空) != 空:
    设 快照["推理档位"] 为 已选["推理档位"]
  返回 快照

段落 当前选择(状态):
  如果 状态["轮次"] != 空:
    返回 状态["轮次"]["选择"]
  返回 状态["已选"]

段落 钉住轮次(状态, 轮次):
  如果 轮次 == 空:
    抛 新建 错误("cannot pin an empty turn")
  字典设置(状态, "轮次", {"轮次": 轮次, "选择": 快照选择(状态)})

段落 放开轮次(状态, 轮次):
  如果 状态["轮次"] != 空 且 状态["轮次"]["轮次"] == 轮次:
    字典设置(状态, "轮次", 空)

段落 组装选择表(提供商表):
  设 选择表 为 字典创建()
  遍历 提供商 之 提供商表:
    遍历 模型 之 提供商["模型表"]:
      设 值 为 模型选择值(提供商["标识"], 模型["标识"])
      字典设置(选择表, 值, {"提供者": 提供商["标识"], "成员": 模型["标识"]})
  返回 选择表

段落 档位包含(档位表, 值):
  设 命中 为 假
  遍历 档 之 档位表:
    如果 档["标识"] == 值:
      设 命中 为 真
  返回 命中

段落 组装选项(状态, 提供商表, 解析结果, 解析可用, 推理信息):
  设 已选 为 状态["已选"]
  如果 已选 == 空:
    返回 []
  设 解析 为 解析结果
  如果 解析可用 == 假:
    设 解析 为 已选
  设 选择表 为 组装选择表(提供商表)
  设 当前值 为 模型选择值(解析["提供者"], 解析["成员"])
  设 组表 为 列表创建()
  遍历 提供商 之 提供商表:
    设 组选项 为 列表创建()
    遍历 模型 之 提供商["模型表"]:
      列表追加(组选项, {"值": 模型选择值(提供商["标识"], 模型["标识"]), "名": 模型["名"]})
    如果 列表长度(组选项) > 0:
      列表追加(组表, {"标识": 提供商["标识"], "名": 提供商["名"], "选项表": 组选项})
  如果 字典包含键(选择表, 当前值) == 假:
    字典设置(选择表, 当前值, {"提供者": 解析["提供者"], "成员": 解析["成员"]})
    设 挂载组 为 空
    遍历 组 之 组表:
      如果 组["标识"] == 解析["提供者"]:
        设 挂载组 为 组
    如果 挂载组 == 空:
      列表追加(组表, {"标识": 解析["提供者"], "名": 解析["提供者"], "选项表": [{"值": 当前值, "名": 当前值}]})
    否则:
      列表插入(挂载组["选项表"], 0, {"值": 当前值, "名": 当前值})
  设 选项表 为 [{"标识": "model", "名": "Model", "类别": "model", "样式": "select", "当前值": 当前值, "选项表": 组表}]
  如果 解析可用 == 真 且 推理信息 != 空 且 字典包含键(推理信息, "推理") == 真:
    设 推理 为 推理信息["推理"]
    设 推理选项表 为 列表创建()
    如果 取可选(推理, "默认档位", 空) == 空:
      列表追加(推理选项表, {"值": "", "名": "Provider default"})
    遍历 档 之 取可选(推理, "档位表", []):
      列表追加(推理选项表, {"值": 档["标识"], "名": 档["名"]})
    设 推理当前 为 ""
    如果 取可选(解析, "推理档位", 空) != 空:
      设 推理当前 为 转字符串(解析["推理档位"])
    列表追加(选项表, {"标识": "reasoning_effort", "名": "Reasoning effort", "类别": "reasoning", "样式": "select", "当前值": 推理当前, "选项表": [{"标识": "推理", "名": "推理档位", "选项表": 推理选项表}]})
  返回 选项表

段落 设定配置值(状态, 配置ID, 值, 提供商表, 解析结果, 解析可用, 推理信息):
  如果 是字符串(值) == 假:
    抛 新建 错误(配置ID + " requires a select value")
  如果 状态["已选"] == 空:
    抛 新建 错误("this session has no model selection")
  如果 配置ID == "model":
    设 选择表 为 组装选择表(提供商表)
    如果 字典包含键(选择表, 值) == 假:
      抛 新建 错误("unknown model option: " + 值)
    设 选择 为 选择表[值]
    设 状态["已选"] 为 {"提供者": 选择["提供者"], "成员": 选择["成员"]}
    设 状态["已解析过"] 为 真
    返回 组装选项(状态, 提供商表, 状态["已选"], 真, 推理信息)
  如果 配置ID == "reasoning_effort":
    如果 推理信息 == 空 或 字典包含键(推理信息, "推理") == 假:
      抛 新建 错误("this session has no model info")
    设 推理 为 推理信息["推理"]
    设 档位表 为 取可选(推理, "档位表", [])
    设 提供者默认 为 (值 == "") 且 (取可选(推理, "默认档位", 空) == 空)
    如果 提供者默认 == 假 且 档位包含(档位表, 值) == 假:
      抛 新建 错误("unknown reasoning effort: " + 值)
    设 已选 为 {"提供者": 状态["已选"]["提供者"], "成员": 状态["已选"]["成员"]}
    如果 提供者默认 == 假:
      设 已选["推理档位"] 为 值
    设 状态["已选"] 为 已选
    设 状态["已解析过"] 为 真
    返回 组装选项(状态, 提供商表, 状态["已选"], 真, 推理信息)
  抛 新建 错误("unknown session config option: " + 配置ID)

# =====================================================================
# 三、语义更新域（对标 updates.ts）
# =====================================================================

段落 占用更新(用量记录, 用量总数):
  如果 用量记录 == 空:
    返回 []
  如果 取可选(用量记录, "大小", 空) == 空:
    返回 []
  如果 用量总数 == 空:
    返回 []
  返回 [{"sessionUpdate": "usage_update", "used": 用量总数, "size": 用量记录["大小"]}]

段落 助手更新批次(块表, 消息ID, 用量记录, 用量总数, 附件库):
  设 更新表 为 列表创建()
  遍历 块 之 块表:
    如果 块["type"] == "reasoning":
      设 文 为 取可选(块, "text", "")
      如果 字符串长度(文) > 0:
        列表追加(更新表, {"sessionUpdate": "agent_thought_chunk", "messageId": 消息ID, "content": {"type": "text", "text": 文}})
    否则:
      设 内容 为 assistantBlockToAcp(块, 附件库)
      如果 内容 != 空:
        列表追加(更新表, {"sessionUpdate": "agent_message_chunk", "messageId": 消息ID, "content": 内容})
  设 用量 为 占用更新(用量记录, 用量总数)
  遍历 用量项 之 用量:
    列表追加(更新表, 用量项)
  返回 更新表

段落 调用更新(块):
  返回 {"sessionUpdate": "tool_call", "toolCallId": 块["id"], "kind": "other", "title": 块["name"], "status": "in_progress", "rawInput": 解析工具入参(取可选(块, "arguments", ""))}

段落 结果更新(块, 附件库):
  设 内容表 为 列表创建()
  遍历 子块 之 取可选(块, "content", []):
    设 内容 为 assistantBlockToAcp(子块, 附件库)
    如果 内容 != 空:
      列表追加(内容表, {"kind": "content", "content": 内容})
  设 状态 为 "completed"
  如果 取可选(块, "isError", 假) == 真:
    设 状态 为 "failed"
  返回 {"sessionUpdate": "tool_call_update", "toolCallId": 取可选(块, "id", ""), "status": 状态, "content": 内容表}

段落 解析工具入参(值):
  如果 值 == 空:
    返回 空
  设 结果 为 值
  尝试:
    设 结果 为 解析JSON(值)
  捕获 错误:
    设 结果 为 值
  返回 结果

# =====================================================================
# 四、分离运行域（对标 detached.ts）
# =====================================================================

段落 造分离跟踪器:
  返回 {"中止": 假, "在飞表": []}

段落 登记运行(跟踪器, 逗留):
  如果 列表包含(跟踪器["在飞表"], 逗留) == 假:
    列表追加(跟踪器["在飞表"], 逗留)

段落 结算运行(跟踪器, 逗留):
  设 新表 为 列表创建()
  遍历 项 之 跟踪器["在飞表"]:
    如果 项 != 逗留:
      列表追加(新表, 项)
  字典设置(跟踪器, "在飞表", 新表)

段落 在飞数量(跟踪器):
  返回 列表长度(跟踪器["在飞表"])

段落 结算全部(跟踪器):
  字典设置(跟踪器, "在飞表", [])

段落 排空运行(跟踪器):
  字典设置(跟踪器, "中止", 真)
  返回 在飞数量(跟踪器) == 0

# =====================================================================
# 五、钩子事件域（对标 events.ts）
# =====================================================================

常量 设 默认标准错误摘要上限 为 500

段落 摘要标准错误(标准错误, 上限):
  设 修剪 为 去除空白(标准错误)
  如果 字符串长度(修剪) == 0:
    返回 空
  如果 字符串长度(修剪) > 上限:
    返回 截取(修剪, 0, 上限) + "…"
  返回 修剪

段落 构造引用事件(轮次, 点位, 方言, 处理器ID, 甄别式):
  设 事件 为 {"turn": 轮次, "point": 点位, "dialect": 方言, "handlerId": 处理器ID}
  如果 甄别式 != 空:
    设 事件["matcher"] 为 甄别式
  返回 事件

段落 构造结果事件(轮次, 点位, 处理器ID, 产出, 上限, 时长毫秒):
  设 摘要 为 摘要标准错误(取可选(产出, "标准错误", ""), 上限)
  设 裁 为 取可选(产出, "裁定", 空)
  设 决策 为 "pass"
  如果 裁 != 空:
    设 决策 为 裁
  否则如果 取可选(产出, "续行标志", 空) == 假:
    设 决策 为 "stop"
  设 事件 为 {"turn": 轮次, "point": 点位, "handlerId": 处理器ID, "decision": 决策, "durationMs": 时长毫秒}
  如果 取可选(产出, "退出码", 空) != 空:
    设 事件["exitCode"] 为 产出["退出码"]
  如果 摘要 != 空:
    设 事件["stderrSummary"] 为 摘要
  返回 事件

# =====================================================================
# 六、钩子运行器（对标 runner.ts）
# =====================================================================

常量 设 默认钩子超时毫秒 为 600000

段落 构输入流(载荷, 尾随换行):
  设 文本 为 序列化JSON(载荷)
  如果 尾随换行 == 真:
    设 文本 为 文本 + "\u000a"
  返回 文本

段落 运行钩子(钩, 载荷, 尾随换行, 默认超时, 预期时机, 执行结果, 当前毫秒):
  设 开始 为 当前毫秒()
  设 超时 为 默认超时
  如果 取可选(钩, "超时秒", 空) != 空:
    设 超时 为 钩["超时秒"] * 1000
  设 输入 为 构输入流(载荷, 尾随换行)
  设 产出 为 空
  如果 取可选(执行结果, "失败消息", 空) != 空:
    设 产出 为 解析钩子产出(空, "", 执行结果["失败消息"], 预期时机)
  否则:
    # 判据C变异点：成功分支退出码原样透传（空 → 空，等价上游 result.exitCode ?? undefined）；
    # 变异为「空 → 0」后，t3/信号死亡用例必须立红。
    设 退出码 为 执行结果["退出码"]
    设 产出 为 解析钩子产出(退出码, 取可选(执行结果, "标准输出", ""), 取可选(执行结果, "标准错误", ""), 预期时机)
  设 末 为 当前毫秒()
  返回 {"产出": 产出, "时长毫秒": 末 - 开始, "指令": 钩["指令"], "输入": 输入, "超时毫秒": 超时}

# =====================================================================
# 七、钩子协议类型（对标 types.ts）
# =====================================================================

段落 判方言(值):
  返回 (值 == "claude-code") 或 (值 == "codex")

段落 构造指令钩(指令, 时长秒):
  设 钩 为 {"指令": 指令}
  如果 时长秒 != 空:
    设 钩["超时秒"] 为 时长秒
  返回 钩

段落 判指令钩(值):
  如果 是字典(值) == 假:
    返回 假
  设 指令 为 取可选(值, "指令", 空)
  如果 是字符串(指令) == 假 或 字符串长度(指令) == 0:
    返回 假
  设 超时 为 取可选(值, "超时秒", 空)
  如果 超时 != 空 且 (是整数(超时) == 假 或 超时 < 0):
    返回 假
  返回 真

段落 构造匹配组(甄别式, 钩表):
  设 组 为 {"钩表": 钩表}
  如果 甄别式 != 空:
    设 组["甄别式"] 为 甄别式
  返回 组

段落 判匹配组(值):
  如果 是字典(值) == 假:
    返回 假
  设 钩表 为 取可选(值, "钩表", 空)
  如果 是列表(钩表) == 假:
    返回 假
  设 全部合法 为 真
  遍历 钩 之 钩表:
    如果 判指令钩(钩) == 假:
      设 全部合法 为 假
  设 甄别式 为 取可选(值, "甄别式", 空)
  如果 甄别式 != 空 且 是字符串(甄别式) == 假:
    设 全部合法 为 假
  返回 全部合法

段落 判产出形(值):
  如果 是字典(值) == 假:
    返回 假
  设 退出码 为 取可选(值, "退出码", 空)
  如果 退出码 != 空 且 是整数(退出码) == 假:
    返回 假
  如果 字典包含键(值, "标准输出") == 假:
    返回 假
  如果 字典包含键(值, "标准错误") == 假:
    返回 假
  如果 是字符串(值["标准输出"]) == 假:
    返回 假
  如果 是字符串(值["标准错误"]) == 假:
    返回 假
  返回 真

段落 判选择形(值):
  如果 是字典(值) == 假:
    返回 假
  设 提供者 为 取可选(值, "提供者", 空)
  设 成员 为 取可选(值, "成员", 空)
  如果 是字符串(提供者) == 假 或 字符串长度(提供者) == 0:
    返回 假
  如果 是字符串(成员) == 假 或 字符串长度(成员) == 0:
    返回 假
  返回 真

# =====================================================================
# 导出（空格分隔）
# =====================================================================

导出 合法服务器名 含控制字符 折叠服务器名 规范化服务器名 头名合法 头值合法 环境项合法
导出 条目成记录 绝对路径判定 校验HTTP网址 解析MCP配置
导出 造控制状态 模型选择值 快照选择 当前选择 钉住轮次 放开轮次 组装选择表 档位包含
导出 组装选项 设定配置值
导出 占用更新 助手更新批次 调用更新 结果更新 解析工具入参
导出 造分离跟踪器 登记运行 结算运行 在飞数量 结算全部 排空运行
导出 默认标准错误摘要上限 摘要标准错误 构造引用事件 构造结果事件
导出 默认钩子超时毫秒 构输入流 运行钩子
导出 判方言 构造指令钩 判指令钩 构造匹配组 判匹配组 判产出形 判选择形