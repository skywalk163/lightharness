# 流式参数.light —— 对标 packages/util/values/src/partial-json.ts（上游 dsh-v0.2.1-alpha.1，R126 B2 移植）
#
# 上游源文件：666 行纯逻辑（commit 2ba4144a7e a33bd1a80b 91818992b0 b7f06692b6），
#   PartialArguments 类：残缺 JSON 顶层字段的流式懒扫描视图，供模型工具调用参数行
#   在流式输出各阶段按需读取字段。
#
# 上游语义映射（Mode 状态机逐分支对照）：
#   scan()/step()            → 扫描顶层/步进（root/key-or-end/key-only/key/colon/value/
#                              string/scalar/nested/comma-or-end/closed/invalid →
#                              根/键或终/键只/键/冒号/值/串/标量/嵌套/逗或终/已闭/错）
#   stringBoundary           → 找串界（反斜杠跳双等价于奇偶计数；转义引号不截断）
#   stepKey                  → 键步进（控制字符立错、转义挂起、键含转义时 JSON 解码）
#   beginValue/stepScalar/stepNested → 值起步/标量步进/嵌套步进
#   SIMPLE_ESCAPES/\uXXXX    → 简单转义符/读串体（含流式悬空转义等待、非法转义保留前缀）
#   lengthNow/textNow/textPrefixNow/valueNow → 参数字符串长度/参数字符串前缀/参数值
#   closedNow/completeNow    → 视图["闭合"]/参数字段完整
#
# ⚠️ 语义降级登记（纯函数版，非语言缺陷）：
#   1. 上游为流式实例保留 append/settle 增量接口与 #consumed 扫描位置记忆；本模块
#      每次调用对全文全量重扫（任务书允许的降级）。扫描结果与上游逐字符一致。
#   2. 上游 reads 记忆层（remember/refresh 变更检测、length step/offset 粒度）服务于
#      "跨调用增量扫描后只报变化"；纯函数版每次全量重扫，该缓存层无对象，不复刻。
#   3. 上游 complete() 可携带此前 value() 已发现的值内容错误（invalid 值使 complete
#      返回假）；纯函数版无跨调用记忆，参数字段完整 只判边界不判内容（上游默认行为）。
#   4. 上游 Entry 需解码标志（needsDecoding fast-path 直接截取）；本模块统一走手工
#      解码器，结果一致，无语义差异。
#
# ⚠️ 命名铁律：避开 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/模式/
#   用量/打印/抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回 词根；
#   状态机"模式"改称"阶段"、Entry kind 改称"种别"。

常量 设 解码大限 为 1073741824

# =====================================================================
# 字符判定
# =====================================================================

# isWhitespace（JSON 白名单：仅空格/换行/回车/制表，不用内置是空白以免 Python isspace 扩集）
段落 是json空白(字符):
  如果 字符 == " ":
    返回 真
  如果 字符 == "\n":
    返回 真
  如果 字符 == "\r":
    返回 真
  如果 字符 == "\t":
    返回 真
  返回 假

# isHex（0-9 a-f A-F）
段落 是十六进制字符(字符):
  返回 字符串包含("0123456789abcdefABCDEF", 字符)

# SIMPLE_ESCAPES（partial-json.ts L56-58）
段落 简单转义符(字符):
  如果 字符 == "\"":
    返回 "\""
  如果 字符 == "\\":
    返回 "\\"
  如果 字符 == "/":
    返回 "/"
  如果 字符 == "b":
    返回 "\b"
  如果 字符 == "f":
    返回 "\f"
  如果 字符 == "n":
    返回 "\n"
  如果 字符 == "r":
    返回 "\r"
  如果 字符 == "t":
    返回 "\t"
  返回 空

# =====================================================================
# 扫描器：Mode 状态机（全量一次，产出条目定位表）
# =====================================================================

# fail（L577-581）：标记全局错误位置
段落 失败点(s):
  字典设置(s, "错位", s["已读"])
  字典设置(s, "阶段", "错")
  字典设置(s, "现值", 空)

# open（L610-614）：登记条目并记首现次序
段落 开条目(s, 条目):
  如果 列表包含(s["次序"], s["键"]) == 假:
    列表追加(s["次序"], s["键"])
  字典设置(s["条目"], s["键"], 条目)
  字典设置(s, "现值", 条目)

# beginKey（L583-588）
段落 起键(s, 位置):
  字典设置(s, "阶段", "键")
  字典设置(s, "键起", 位置 + 1)
  字典设置(s, "键转义", 假)

# stepKey（L590-608）：键内容扫描；控制字符立错、转义挂起一次跳过、闭引号处解码键名
段落 键步进(s, 字符, 位置):
  如果 字符 < " ":
    失败点(s)
    返回
  如果 s["转义挂"]:
    字典设置(s, "转义挂", 假)
    返回
  如果 字符 == "\\":
    字典设置(s, "键转义", 真)
    字典设置(s, "转义挂", 真)
    返回
  如果 字符 != "\"":
    返回
  设 原文 为 截取(s["文本"], s["键起"], 位置)
  如果 s["键转义"]:
    设 解 为 ""
    设 成 为 真
    尝试:
      设 解 为 解析JSON("\"" + 原文 + "\"")
    捕获 错误:
      设 成 为 假
    如果 成 == 假:
      # 键内非法转义，后续字段无法识别（上游 L597-603）
      失败点(s)
      返回
    字典设置(s, "键", 解)
  否则:
    字典设置(s, "键", 原文)
  字典设置(s, "阶段", "冒号")

# beginValue（L616-637）：值首字符分派：串 / 嵌套容器 / 标量 / 语法错
段落 值起步(s, 字符, 位置):
  如果 是json空白(字符):
    返回
  如果 字符 == "\"":
    开条目(s, {"种别": "串", "起": 位置 + 1, "止": -1, "错位": 空})
    字典设置(s, "阶段", "串")
    返回
  如果 字符 == "}" 或 字符 == "," 或 字符 == ":" 或 字符 == "]":
    失败点(s)
    返回
  开条目(s, {"种别": "值", "起": 位置, "止": -1, "错值": 假})
  如果 字符 == "{" 或 字符 == "[":
    字典设置(s, "阶段", "嵌套")
    设 闭字 为 "}"
    如果 字符 == "[":
      设 闭字 为 "]"
    字典设置(s, "套栈", [闭字])
    字典设置(s, "套串中", 假)
    返回
  字典设置(s, "阶段", "标量")

# stepScalar（L639-643）：标量读到分隔符即闭合
段落 标量步进(s, 字符, 位置):
  如果 字符 != "," 且 字符 != "}" 且 是json空白(字符) == 假:
    返回
  s["现值"]["止"] = 位置
  字典设置(s, "现值", 空)
  如果 字符 == ",":
    字典设置(s, "阶段", "键只")
    返回
  如果 字符 == "}":
    字典设置(s, "阶段", "已闭")
    返回
  字典设置(s, "阶段", "逗或终")

# stepNested（L645-658）：嵌套容器深度配对；栈空即值闭合
段落 嵌套步进(s, 字符, 位置):
  如果 s["套串中"]:
    字典设置(s, "套串中", 假)
    返回
  如果 字符 == "\"":
    字典设置(s, "套串中", 真)
    返回
  如果 字符 == "{" 或 字符 == "[":
    设 闭字 为 "}"
    如果 字符 == "[":
      设 闭字 为 "]"
    列表追加(s["套栈"], 闭字)
    返回
  如果 字符 == "}" 或 字符 == "]":
    如果 列表长度(s["套栈"]) == 0:
      失败点(s)
      返回
    设 顶 为 列表弹出(s["套栈"])
    如果 顶 != 字符:
      失败点(s)
      返回
    如果 列表长度(s["套栈"]) == 0:
      s["现值"]["止"] = 位置 + 1
      字典设置(s, "现值", 空)
      字典设置(s, "阶段", "逗或终")
    返回

# stringBoundary（L508-524）纯文本等价：找下一个未转义引号。
# 「遇反斜杠跳双」与上游反斜杠计数奇偶等价（单文本无跨段挂起）；
# 转义引号 \" 不视为串界。
段落 找串界(文本, 起, 总长):
  设 j 为 起
  当 j < 总长:
    设 字符 为 字符串获取(文本, j)
    如果 字符 == "\"":
      返回 j
    如果 字符 == "\\":
      设 j 为 j + 2
      继续
    设 j 为 j + 1
  返回 -1

# step（L526-575）：Mode 状态机单字符步进
段落 步进(s, 字符, 位置):
  设 阶段 为 s["阶段"]
  如果 阶段 == "根":
    如果 是json空白(字符):
      返回
    如果 字符 == "{":
      字典设置(s, "阶段", "键或终")
      返回
    失败点(s)
    返回
  如果 阶段 == "键或终":
    如果 是json空白(字符):
      返回
    如果 字符 == "}":
      字典设置(s, "阶段", "已闭")
      返回
    如果 字符 == "\"":
      起键(s, 位置)
      返回
    失败点(s)
    返回
  如果 阶段 == "键只":
    如果 是json空白(字符):
      返回
    如果 字符 == "\"":
      起键(s, 位置)
      返回
    失败点(s)
    返回
  如果 阶段 == "键":
    键步进(s, 字符, 位置)
    返回
  如果 阶段 == "冒号":
    如果 是json空白(字符):
      返回
    如果 字符 == ":":
      字典设置(s, "阶段", "值")
      返回
    失败点(s)
    返回
  如果 阶段 == "值":
    值起步(s, 字符, 位置)
    返回
  如果 阶段 == "串":
    # 闭引号字符：字符串条目收界（上游 L549-555）
    s["现值"]["止"] = 位置
    字典设置(s, "现值", 空)
    字典设置(s, "阶段", "逗或终")
    返回
  如果 阶段 == "标量":
    标量步进(s, 字符, 位置)
    返回
  如果 阶段 == "嵌套":
    嵌套步进(s, 字符, 位置)
    返回
  如果 阶段 == "逗或终":
    如果 是json空白(字符):
      返回
    如果 字符 == ",":
      字典设置(s, "阶段", "键只")
      返回
    如果 字符 == "}":
      字典设置(s, "阶段", "已闭")
      返回
    失败点(s)
    返回
  如果 阶段 == "已闭":
    如果 是json空白(字符):
      返回
    失败点(s)
    返回
  返回

# scan（L489-505）：全文扫描；串/嵌套串内先跳到串界再步进
段落 扫描顶层(文本):
  设 总长 为 字符串长度(文本)
  设 s 为 字典创建()
  字典设置(s, "文本", 文本)
  字典设置(s, "总长", 总长)
  字典设置(s, "已读", 0)
  字典设置(s, "阶段", "根")
  字典设置(s, "转义挂", 假)
  字典设置(s, "键起", 0)
  字典设置(s, "键转义", 假)
  字典设置(s, "键", "")
  字典设置(s, "现值", 空)
  字典设置(s, "套栈", [])
  字典设置(s, "套串中", 假)
  字典设置(s, "错位", 空)
  字典设置(s, "值错", 假)
  字典设置(s, "条目", {})
  字典设置(s, "次序", [])
  设 i 为 0
  当 i < 总长:
    如果 s["错位"] != 空:
      跳出
    设 字符 为 ""
    如果 s["阶段"] == "串" 或 (s["阶段"] == "嵌套" 且 s["套串中"]):
      设 q 为 找串界(文本, i, 总长)
      设 终点 为 q
      如果 终点 < 0:
        设 终点 为 总长
      字典设置(s, "已读", s["已读"] + (终点 - i))
      设 i 为 终点
      如果 i >= 总长:
        跳出
      设 字符 为 字符串获取(文本, i)
    否则:
      设 字符 为 字符串获取(文本, i)
    步进(s, 字符, i)
    字典设置(s, "已读", s["已读"] + 1)
    设 i 为 i + 1
  返回 s

# =====================================================================
# 读字符串体（readString L429-486 等价）：解码转义、保留有效前缀、流式悬空等待
# =====================================================================

段落 读串体(文本, s, 条目, 限):
  设 终 为 条目["止"]
  如果 终 < 0:
    设 终 为 s["已读"]
  如果 条目["错位"] != 空 且 条目["错位"] < 终:
    设 终 为 条目["错位"]
  如果 s["错位"] != 空 且 s["错位"] < 终:
    设 终 为 s["错位"]
  设 文 为 ""
  设 长 为 0
  设 i 为 条目["起"]
  当 i < 终:
    如果 长 >= 限:
      跳出
    设 字符 为 字符串获取(文本, i)
    如果 字符 != "\\":
      # 控制字符：内容错误（上游 CONTENT_ESCAPE 命中且非转义 → invalidAt）
      如果 字符 < " ":
        字典设置(条目, "错位", i)
        跳出
      设 文 为 文 + 字符
      设 长 为 长 + 1
      设 i 为 i + 1
      继续
    # 字符 == "\\"：转义序列
    设 解 为 ""
    设 宽 为 2
    如果 i + 1 >= 终:
      # 悬空反斜杠：流式等待（上游 L463），闭合则内容错误
      如果 条目["止"] < 0:
        跳出
      字典设置(条目, "错位", i)
      跳出
    设 随字 为 字符串获取(文本, i + 1)
    如果 随字 == "u":
      # \uXXXX：hex 不足且流式 → 等待；hex 非法或闭合不足 4 位 → 内容错误
      设 终六 为 i + 6
      如果 终六 > 终:
        设 终六 为 终
      设 十六 为 截取(文本, i + 2, 终六)
      设 十六长 为 字符串长度(十六)
      设 合 为 真
      设 位 为 0
      当 位 < 十六长:
        如果 是十六进制字符(字符串获取(十六, 位)) == 假:
          设 合 为 假
        设 位 为 位 + 1
      如果 合:
        如果 十六长 < 4:
          如果 条目["止"] < 0:
            跳出
          字典设置(条目, "错位", i)
          跳出
        设 文 为 文 + 解析JSON("\"\\u" + 十六 + "\"")
        设 长 为 长 + 1
      否则:
        字典设置(条目, "错位", i)
        跳出
      设 宽 为 6
    否则:
      设 解 为 简单转义符(随字)
      如果 解 == 空:
        字典设置(条目, "错位", i)
        跳出
      设 文 为 文 + 解
      设 长 为 长 + 1
    设 i 为 i + 宽
  返回 {"长": 长, "文": 文}

# =====================================================================
# 读取 API（对齐上游各 Now 函数；纯函数版每次独立全量扫描）
# =====================================================================

# keys（L216-218）：首现次序键表
段落 参数键表(文本):
  设 s 为 扫描顶层(文本)
  返回 s["次序"]

# complete（L234-236/L327-332）：闭界已到且无错（串判错位；值默认不验内容，见降级登记 3）
段落 参数字段完整(文本, 键):
  设 s 为 扫描顶层(文本)
  如果 字典包含键(s["条目"], 键) == 假:
    返回 假
  设 条目 为 字典获取(s["条目"], 键)
  如果 条目["止"] < 0:
    返回 假
  如果 条目["种别"] == "串":
    返回 条目["错位"] == 空
  返回 条目["错值"] == 假

# text/textPrefix（L268-282/L347-383）：字符串字段已解码前缀；非串或不存在 → 空
段落 参数字符串前缀(文本, 键):
  设 s 为 扫描顶层(文本)
  如果 字典包含键(s["条目"], 键) == 假:
    返回 空
  设 条目 为 字典获取(s["条目"], 键)
  如果 条目["种别"] != "串":
    返回 空
  设 体 为 读串体(文本, s, 条目, 解码大限)
  返回 体["文"]

# stringLength（L244-249/L334-345）：已解码前缀长度；非串或不存在 → 空
段落 参数字符串长度(文本, 键):
  设 s 为 扫描顶层(文本)
  如果 字典包含键(s["条目"], 键) == 假:
    返回 空
  设 条目 为 字典获取(s["条目"], 键)
  如果 条目["种别"] != "串":
    返回 空
  设 体 为 读串体(文本, s, 条目, 解码大限)
  返回 体["长"]

# value（L289-291/L385-403）：完整非字符串值；串/未完整/解析失败 → 空（null 值返回空，用字段表判存在）
段落 参数值(文本, 键):
  设 s 为 扫描顶层(文本)
  如果 字典包含键(s["条目"], 键) == 假:
    返回 空
  设 条目 为 字典获取(s["条目"], 键)
  如果 条目["种别"] != "值":
    返回 空
  如果 条目["止"] < 0:
    返回 空
  如果 条目["错值"]:
    返回 空
  设 解 为 空
  设 成 为 真
  尝试:
    设 解 为 解析JSON(截取(文本, 条目["起"], 条目["止"]))
  捕获 错误:
    设 成 为 假
  如果 成 == 假:
    字典设置(条目, "错值", 真)
    字典设置(s, "值错", 真)
    返回 空
  返回 解

# 汇总视图（最小可用契约）：
#   {"键表": [键…首现序], "字段表": {键: 完整值},
#    "闭合": 外层已闭或已判错, "无效": 扫描发现非法 JSON}
#   字段表只收"完整可读"字段：串 → 完整解码文本（未闭/有错不收）；
#   值 → 解析结果（未闭/解析失败不收）。
段落 残缺参数视图(文本):
  设 s 为 扫描顶层(文本)
  设 字段表 为 {}
  设 键序 为 s["次序"]
  遍历 键 之 键序:
    设 条目 为 字典获取(s["条目"], 键)
    如果 条目["止"] < 0:
      继续
    如果 条目["种别"] == "串":
      设 体 为 读串体(文本, s, 条目, 解码大限)
      # 读后无内容错才视为完整可读（对齐上游 completeNow 的 invalidAt 判据）
      如果 条目["错位"] == 空:
        字典设置(字段表, 键, 体["文"])
    否则:
      设 解 为 空
      设 成 为 真
      尝试:
        设 解 为 解析JSON(截取(文本, 条目["起"], 条目["止"]))
      捕获 错误:
        设 成 为 假
      如果 成:
        字典设置(字段表, 键, 解)
      否则:
        字典设置(条目, "错值", 真)
        字典设置(s, "值错", 真)
  设 闭 为 假
  如果 s["阶段"] == "已闭" 或 s["阶段"] == "错":
    设 闭 为 真
  设 视 为 字典创建()
  字典设置(视, "键表", s["次序"])
  字典设置(视, "字段表", 字段表)
  字典设置(视, "闭合", 闭)
  字典设置(视, "无效", s["错位"] != 空)
  返回 视

导出 解码大限 是json空白 是十六进制字符 简单转义符 扫描顶层 读串体
导出 参数键表 参数字段完整 参数字符串前缀 参数字符串长度 参数值 残缺参数视图
