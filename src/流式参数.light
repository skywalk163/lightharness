# 流式参数.light —— 对标 packages/util/values/src/partial-json.ts（上游 dsh-v0.2.1-alpha.1，R126 B2 移植 + R128 增量语义补齐）
#
# 上游源文件：666 行纯逻辑（commit 2ba4144a7e a33bd1a80b 91818992b0 b7f06692b6），
#   PartialArguments 类：残缺 JSON 顶层字段的流式懒扫描视图，供模型工具调用参数行
#   在流式输出各阶段按需读取字段。
#
# 上游语义映射（Mode 状态机逐分支对照）：
#   scan()/step()            → 扫描顶层/步进（root/key-or-end/key-only/key/colon/value/
#                              string/scalar/nested/comma-or-end/closed/invalid →
#                              根/键或终/键只/键/冒号/值/串/标量/嵌套/逗或终/已闭/错）
#   stringBoundary           → 找串界（反斜杠游程奇偶 + 跨段挂起记忆；转义引号不截断）
#   stepKey                  → 键步进（控制字符立错、转义挂起、键含转义时 JSON 解码）
#   beginValue/stepScalar/stepNested → 值起步/标量步进/嵌套步进
#   SIMPLE_ESCAPES/\uXXXX    → 简单转义符/读串体（含流式悬空转义等待、非法转义保留前缀）
#   lengthNow/textNow/textPrefixNow/valueNow → 参数字符串长度/参数字符串前缀/参数值
#   closedNow/completeNow    → 视图["闭合"]/参数字段完整
#   append/settle/#consumed  → 流式追加/流式定着/状态["已读"]（R128 补齐）
#   remember/refresh/#reads  → 记读/流式刷新/状态["读表"]（R128 补齐）
#   stringExceeds            → 流式串超限（R128 补齐）
#
# ── 语义降级登记（R128 复核：1~4 已闭环，5~6 为本轮新增如实缩窄）──
#   1. 【R128 已闭环】上游 append/settle 增量接口与 #consumed 扫描位置记忆：
#      本模块现以状态句柄（流式扫描器() 造、调用方跨调用持有）承载 块/止表/总长/已读，
#      流式追加 只登记文本段不扫描，流式扫描 从 已读 处续扫、跨调用不重扫已消费前缀；
#      流式定着 以「逐段前缀比对 + 长度相等」判定可否就地密闭（否则另起密闭视图）。
#   2. 【R128 已闭环】上游 reads 记忆层：记读(状态, …) 按「种别/键/步/移/限」登记答案，
#      流式刷新 先刷非完整类读、再刷完整类读（内容读可能改写完整判定），密闭后清空读表；
#      流式串长度 支持 step/offset 粒度（比较值 = 上进位(长+移, 步)），流式串超限 对齐
#      stringExceeds 的「limit+1 限长读再比上限」。
#   3. 【R128 已闭环】上游 complete() 可携带此前内容读发现的内容错：条目字典跨调用持久，
#      串内容错写入 条目["错位"]，值解析错写入 条目["错值"]/状态["值错"]，
#      故「先读串、后问完整」与上游一致地翻假；纯函数层（参数字段完整）每次新开状态，
#      仍只判边界，与上游「未读过内容即不报内容错」同义。
#   4. 【R128 已闭环】上游 Entry 需解码标志（needsDecoding fast-path 直接截取）：
#      本模块新增 条目["需解码"]，由 找串界 在串区间内探测反斜杠/控制字符置真；
#      未置真时 读串体 走「直接切片」快路，置真时走手工解码器，结果与上游一致。
#   5. 【R128 如实缩窄】上游 fromObject/EMPTY/isSealed 的「已解析对象源」分支未移植：
#      光明侧无 PTC 派发对象消费方，本模块只做文本源（chunks）一侧；
#      状态["密闭"] 仅由 流式定着 置真，不提供对象视图。
#   6. 【R128 如实缩窄】视图["无效"] 仍只报「结构错」（错位），不并入内容错（值错）；
#      对齐上游 invalid 语义的入口是 流式无效(状态)。此口径为保 R126 既有判据
#      （判据9「结构仍有效」）不回归，非语义退化。
#
# ⚠️ 命名铁律：避开 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/模式/
#   用量/打印/抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回 词根；
#   状态机"模式"改称"阶段"、Entry kind 改称"种别"。

常量 设 解码大限 为 1073741824

# =====================================================================
# 字符判定
# =====================================================================

# isWhitespace（JSON 白名单：仅空格/换行/回车/制表，不用内置是空白以免 Python isspace 扩集）
段落 是json空白(字符):
  如果 字符 == " ":
    返回 真
  如果 字符 == "\n":
    返回 真
  如果 字符 == "\r":
    返回 真
  如果 字符 == "\t":
    返回 真
  返回 假

# isHex（0-9 a-f A-F）
段落 是十六进制字符(字符):
  返回 字符串包含("0123456789abcdefABCDEF", 字符)

# SIMPLE_ESCAPES（partial-json.ts L56-58）
段落 简单转义符(字符):
  如果 字符 == "\"":
    返回 "\""
  如果 字符 == "\\":
    返回 "\\"
  如果 字符 == "/":
    返回 "/"
  如果 字符 == "b":
    返回 "\b"
  如果 字符 == "f":
    返回 "\f"
  如果 字符 == "n":
    返回 "\n"
  如果 字符 == "r":
    返回 "\r"
  如果 字符 == "t":
    返回 "\t"
  返回 空

# =====================================================================
# 状态句柄（对齐上游 PartialArguments 实例：chunks/#ends/#size/sealed + 扫描缓存 + 读表）
# =====================================================================

# 造一个空视图状态。调用方持有它跨调用（流式追加 → 各种读 → 流式刷新）。
段落 流式扫描器():
  设 s 为 字典创建()
  字典设置(s, "块", [])
  字典设置(s, "止表", [])
  字典设置(s, "总长", 0)
  字典设置(s, "密闭", 假)
  字典设置(s, "已读", 0)
  字典设置(s, "阶段", "根")
  字典设置(s, "转义挂", 假)
  字典设置(s, "键起", 0)
  字典设置(s, "键转义", 假)
  字典设置(s, "键", "")
  字典设置(s, "现值", 空)
  字典设置(s, "套栈", [])
  字典设置(s, "套串中", 假)
  字典设置(s, "错位", 空)
  字典设置(s, "值错", 假)
  字典设置(s, "条目", {})
  字典设置(s, "次序", [])
  字典设置(s, "读表", {})
  字典设置(s, "步计", 0)
  返回 s

# 段起匹配：文本 从 偏移 起是否以 段 开头（长度校验由调用方保证）
段落 段起匹配(文本, 段, 偏移):
  设 k 为 0
  当 k < 字符串长度(段):
    如果 字符串获取(文本, 偏移 + k) != 字符串获取(段, k):
      返回 假
    设 k 为 k + 1
  返回 真

# 造一个「文本即全文、已密闭」的视图（对应上游 PartialArguments.fromText）
段落 流式定全文(文本):
  设 s 为 流式扫描器()
  流式追加(s, 文本)
  字典设置(s, "密闭", 真)
  返回 s

# append（L137-143）：只登记文本段，不扫描、不比较答案；密闭后再追加抛错
段落 流式追加(状态, 文本段):
  如果 状态["密闭"] == 真:
    抛出 新建 错误("PartialArguments: cannot append to a sealed view")
  如果 文本段 == "":
    返回 状态
  列表追加(状态["块"], 文本段)
  字典设置(状态, "总长", 状态["总长"] + 字符串长度(文本段))
  列表追加(状态["止表"], 状态["总长"])
  返回 状态

# settle（L150-163）：逐段前缀比对 + 长度相等 ⇒ 就地密闭并保留缓存；否则另起密闭视图
段落 流式定着(状态, 文本):
  如果 字符串长度(文本) != 状态["总长"]:
    返回 流式定全文(文本)
  设 偏移 为 0
  遍历 段 之 状态["块"]:
    如果 段起匹配(文本, 段, 偏移) == 假:
      返回 流式定全文(文本)
    设 偏移 为 偏移 + 字符串长度(段)
  设 块 为 []
  设 止表 为 []
  如果 字符串长度(文本) > 0:
    列表追加(块, 文本)
    列表追加(止表, 字符串长度(文本))
  字典设置(状态, "块", 块)
  字典设置(状态, "止表", 止表)
  字典设置(状态, "密闭", 真)
  返回 状态

# chunkAt（L412-421）等价：定位 位置 落在第几段（返回首段其止 > 位置）
段落 定位块(状态, 位置):
  设 i 为 0
  当 i < 列表长度(状态["止表"]):
    如果 列表获取(状态["止表"], i) > 位置:
      返回 i
    设 i 为 i + 1
  返回 i

# slice（L424-437）：只物化请求区间，永不拼全文
段落 段切片(状态, 起, 止):
  如果 起 >= 止:
    返回 ""
  设 首 为 定位块(状态, 起)
  设 末 为 定位块(状态, 止 - 1)
  设 基 为 0
  如果 首 > 0:
    设 基 为 列表获取(状态["止表"], 首 - 1)
  设 首段 为 列表获取(状态["块"], 首)
  如果 首 == 末:
    返回 截取(首段, 起 - 基, 止 - 基)
  设 文 为 截取(首段, 起 - 基, 字符串长度(首段))
  设 i 为 首 + 1
  当 i < 末:
    设 文 为 文 + 列表获取(状态["块"], i)
    设 i 为 i + 1
  设 末基 为 0
  如果 末 > 0:
    设 末基 为 列表获取(状态["止表"], 末 - 1)
  设 文 为 文 + 截取(列表获取(状态["块"], 末), 0, 止 - 末基)
  返回 文

# =====================================================================
# 扫描器：Mode 状态机（从 已读 处续扫，产出/更新条目定位表）
# =====================================================================

# fail（L577-581）：标记全局错误位置
段落 失败点(s):
  字典设置(s, "错位", s["已读"])
  字典设置(s, "阶段", "错")
  字典设置(s, "现值", 空)

# open（L610-614）：登记条目并记首现次序
段落 开条目(s, 条目):
  如果 列表包含(s["次序"], s["键"]) == 假:
    列表追加(s["次序"], s["键"])
  字典设置(s["条目"], s["键"], 条目)
  字典设置(s, "现值", 条目)

# beginKey（L583-588）：注意上游在此重置 #escape（跨段挂起不串进键扫描）
段落 起键(s, 位置):
  字典设置(s, "阶段", "键")
  字典设置(s, "键起", 位置 + 1)
  字典设置(s, "键转义", 假)
  字典设置(s, "转义挂", 假)

# stepKey（L590-608）：键内容扫描；控制字符立错、转义挂起一次跳过、闭引号处解码键名
段落 键步进(s, 字符, 位置):
  如果 字符 < " ":
    失败点(s)
    返回
  如果 s["转义挂"]:
    字典设置(s, "转义挂", 假)
    返回
  如果 字符 == "\\":
    字典设置(s, "键转义", 真)
    字典设置(s, "转义挂", 真)
    返回
  如果 字符 != "\"":
    返回
  设 原文 为 段切片(s, s["键起"], 位置)
  如果 s["键转义"]:
    设 解 为 ""
    设 成 为 真
    尝试:
      设 解 为 解析JSON("\"" + 原文 + "\"")
    捕获 错误:
      设 成 为 假
    如果 成 == 假:
      # 键内非法转义，后续字段无法识别（上游 L597-603）
      失败点(s)
      返回
    字典设置(s, "键", 解)
  否则:
    字典设置(s, "键", 原文)
  字典设置(s, "阶段", "冒号")

# beginValue（L616-637）：值首字符分派：串 / 嵌套容器 / 标量 / 语法错
段落 值起步(s, 字符, 位置):
  如果 是json空白(字符):
    返回
  如果 字符 == "\"":
    开条目(s, {"种别": "串", "起": 位置 + 1, "止": -1, "错位": 空, "需解码": 假, "读长": 空, "读文": 空, "前缀表": 空})
    字典设置(s, "阶段", "串")
    字典设置(s, "转义挂", 假)
    返回
  如果 字符 == "}" 或 字符 == "," 或 字符 == ":" 或 字符 == "]":
    失败点(s)
    返回
  开条目(s, {"种别": "值", "起": 位置, "止": -1, "错值": 假, "解析": 空})
  如果 字符 == "{" 或 字符 == "[":
    字典设置(s, "阶段", "嵌套")
    设 闭字 为 "}"
    如果 字符 == "[":
      设 闭字 为 "]"
    字典设置(s, "套栈", [闭字])
    字典设置(s, "套串中", 假)
    字典设置(s, "转义挂", 假)
    返回
  字典设置(s, "阶段", "标量")

# stepScalar（L639-643）：标量读到分隔符即闭合
段落 标量步进(s, 字符, 位置):
  如果 字符 != "," 且 字符 != "}" 且 是json空白(字符) == 假:
    返回
  s["现值"]["止"] = 位置
  字典设置(s, "现值", 空)
  如果 字符 == ",":
    字典设置(s, "阶段", "键只")
    返回
  如果 字符 == "}":
    字典设置(s, "阶段", "已闭")
    返回
  字典设置(s, "阶段", "逗或终")

# stepNested（L645-658）：嵌套容器深度配对；栈空即值闭合
段落 嵌套步进(s, 字符, 位置):
  如果 s["套串中"]:
    字典设置(s, "套串中", 假)
    返回
  如果 字符 == "\"":
    字典设置(s, "套串中", 真)
    返回
  如果 字符 == "{" 或 字符 == "[":
    设 闭字 为 "}"
    如果 字符 == "[":
      设 闭字 为 "]"
    列表追加(s["套栈"], 闭字)
    返回
  如果 字符 == "}" 或 字符 == "]":
    如果 列表长度(s["套栈"]) == 0:
      失败点(s)
      返回
    设 顶 为 列表弹出(s["套栈"])
    如果 顶 != 字符:
      失败点(s)
      返回
    如果 列表长度(s["套栈"]) == 0:
      s["现值"]["止"] = 位置 + 1
      字典设置(s, "现值", 空)
      字典设置(s, "阶段", "逗或终")
    返回

# stringBoundary（L508-524）：只在本段内找串界。
#   反斜杠游程奇偶 + 「游程是否顶到本次起点且上段挂起」判定该引号是否被转义；
#   段末仍悬空时把挂起状态写回 状态["转义挂"]，供下一段续判（跨段转义记忆）。
#   顺带在串区间内探测 needsDecoding（反斜杠或控制字符 → 需解码）。
段落 找串界(状态, 段, 起):
  设 位 为 起
  设 段长 为 字符串长度(段)
  当 真:
    设 引号 为 -1
    设 k 为 位
    当 k < 段长:
      如果 字符串获取(段, k) == "\"":
        设 引号 为 k
        跳出
      设 k 为 k + 1
    设 终 为 段长
    如果 引号 >= 0:
      设 终 为 引号
    如果 状态["阶段"] == "串":
      设 探 为 位
      当 探 < 终:
        设 字 为 字符串获取(段, 探)
        如果 字 == "\\" 或 字 < " ":
          设 状态["现值"]["需解码"] 为 真
          跳出
        设 探 为 探 + 1
    设 斜起 为 终
    设 斜奇 为 假
    当 斜起 > 位 且 字符串获取(段, 斜起 - 1) == "\\":
      如果 斜奇 == 真:
        设 斜奇 为 假
      否则:
        设 斜奇 为 真
      设 斜起 为 斜起 - 1
    设 挂 为 假
    如果 斜起 == 位 且 状态["转义挂"] == 真:
      设 挂 为 真
    设 转义 为 斜奇 != 挂
    如果 引号 < 0:
      字典设置(状态, "转义挂", 转义)
      返回 终
    字典设置(状态, "转义挂", 假)
    如果 转义 == 假:
      返回 终
    设 位 为 引号 + 1

# step（L526-575）：Mode 状态机单字符步进；步计 为实际步进次数（可观测判据）
段落 步进(状态, 字符, 位置):
  字典设置(状态, "步计", 状态["步计"] + 1)
  设 阶段 为 状态["阶段"]
  如果 阶段 == "根":
    如果 是json空白(字符):
      返回
    如果 字符 == "{":
      字典设置(状态, "阶段", "键或终")
      返回
    失败点(状态)
    返回
  如果 阶段 == "键或终":
    如果 是json空白(字符):
      返回
    如果 字符 == "}":
      字典设置(状态, "阶段", "已闭")
      返回
    如果 字符 == "\"":
      起键(状态, 位置)
      返回
    失败点(状态)
    返回
  如果 阶段 == "键只":
    如果 是json空白(字符):
      返回
    如果 字符 == "\"":
      起键(状态, 位置)
      返回
    失败点(状态)
    返回
  如果 阶段 == "键":
    键步进(状态, 字符, 位置)
    返回
  如果 阶段 == "冒号":
    如果 是json空白(字符):
      返回
    如果 字符 == ":":
      字典设置(状态, "阶段", "值")
      返回
    失败点(状态)
    返回
  如果 阶段 == "值":
    值起步(状态, 字符, 位置)
    返回
  如果 阶段 == "串":
    # 闭引号字符：字符串条目收界（上游 L549-555）
    状态["现值"]["止"] = 位置
    字典设置(状态, "现值", 空)
    字典设置(状态, "阶段", "逗或终")
    返回
  如果 阶段 == "标量":
    标量步进(状态, 字符, 位置)
    返回
  如果 阶段 == "嵌套":
    嵌套步进(状态, 字符, 位置)
    返回
  如果 阶段 == "逗或终":
    如果 是json空白(字符):
      返回
    如果 字符 == ",":
      字典设置(状态, "阶段", "键只")
      返回
    如果 字符 == "}":
      字典设置(状态, "阶段", "已闭")
      返回
    失败点(状态)
    返回
  如果 阶段 == "已闭":
    如果 是json空白(字符):
      返回
    失败点(状态)
    返回
  返回

# scan（L489-505）增量版：从 已读 处续扫，只走尚未消费的段与字符。
#   跨调用不重扫：已消费前缀一律跳过（状态["已读"] 即 #consumed）。
段落 流式扫描(状态):
  如果 状态["已读"] == 状态["总长"]:
    返回
  设 i 为 定位块(状态, 状态["已读"])
  当 i < 列表长度(状态["块"]):
    如果 状态["错位"] != 空:
      跳出
    设 段 为 列表获取(状态["块"], i)
    设 段长 为 字符串长度(段)
    设 基 为 0
    如果 i > 0:
      设 基 为 列表获取(状态["止表"], i - 1)
    设 下标 为 状态["已读"] - 基
    当 下标 < 段长:
      如果 状态["阶段"] == "错":
        跳出
      如果 状态["阶段"] == "串" 或 (状态["阶段"] == "嵌套" 且 状态["套串中"]):
        设 终点 为 找串界(状态, 段, 下标)
        字典设置(状态, "已读", 状态["已读"] + (终点 - 下标))
        设 下标 为 终点
        如果 下标 >= 段长:
          跳出
      设 字符 为 字符串获取(段, 下标)
      步进(状态, 字符, 状态["已读"])
      字典设置(状态, "已读", 状态["已读"] + 1)
      设 下标 为 下标 + 1
    设 i 为 i + 1
  返回

# 一次性全量扫描（保留 R126 契约：给一段文本，返回扫完的状态）
段落 扫描顶层(文本):
  设 s 为 流式扫描器()
  流式追加(s, 文本)
  流式扫描(s)
  返回 s

# =====================================================================
# 读字符串体（readString L429-486 等价）
#   读 = {"位": 续读位移, "长": 已解码长度, "文": 已解码文本}，跨调用持久（增量续读）
#   具象 = 假 时只累计长度不物化文本（对齐 lengthNow 的 materialize=false）
# =====================================================================

段落 读串体(状态, 条目, 读, 限, 具象):
  设 终 为 条目["止"]
  如果 终 < 0:
    设 终 为 状态["已读"]
  如果 条目["错位"] != 空 且 条目["错位"] < 终:
    设 终 为 条目["错位"]
  如果 状态["错位"] != 空 且 状态["错位"] < 终:
    设 终 为 状态["错位"]
  # needsDecoding=false 快路：区间内无转义与控制字符，直接按原文切片计数
  如果 条目["需解码"] == 假:
    设 量 为 终 - 读["位"]
    设 余 为 限 - 读["长"]
    如果 量 > 余:
      设 量 为 余
    如果 量 <= 0:
      返回
    如果 具象 == 真:
      设 读["文"] 为 读["文"] + 段切片(状态, 读["位"], 读["位"] + 量)
    设 读["位"] 为 读["位"] + 量
    设 读["长"] 为 读["长"] + 量
    返回
  当 读["位"] < 终 且 读["长"] < 限:
    设 字符 为 字符串获取(段切片(状态, 读["位"], 读["位"] + 1), 0)
    如果 字符 != "\\":
      # 控制字符：内容错误（上游 CONTENT_ESCAPE 命中且非转义 → invalidAt）
      如果 字符 < " ":
        字典设置(条目, "错位", 读["位"])
        字典设置(状态, "值错", 真)
        跳出
      如果 具象 == 真:
        设 读["文"] 为 读["文"] + 字符
      设 读["长"] 为 读["长"] + 1
      设 读["位"] 为 读["位"] + 1
      继续
    # 字符 == "\\"：转义序列（跨段取随字：段切片 天然跨界）
    设 随字 为 空
    如果 读["位"] + 1 < 终:
      设 随字 为 字符串获取(段切片(状态, 读["位"] + 1, 读["位"] + 2), 0)
    如果 随字 == 空:
      # 悬空反斜杠：流式等待（上游 L463），闭合则内容错误
      如果 条目["止"] < 0:
        跳出
      字典设置(条目, "错位", 读["位"])
      字典设置(状态, "值错", 真)
      跳出
    如果 随字 == "u":
      # \uXXXX：hex 不足且流式 → 等待；hex 非法或闭合不足 4 位 → 内容错误
      设 终六 为 读["位"] + 6
      如果 终六 > 终:
        设 终六 为 终
      设 十六 为 段切片(状态, 读["位"] + 2, 终六)
      设 十六长 为 字符串长度(十六)
      设 合 为 真
      设 位 为 0
      当 位 < 十六长:
        如果 是十六进制字符(字符串获取(十六, 位)) == 假:
          设 合 为 假
        设 位 为 位 + 1
      如果 合 == 假:
        字典设置(条目, "错位", 读["位"])
        字典设置(状态, "值错", 真)
        跳出
      如果 十六长 < 4:
        如果 条目["止"] < 0:
          跳出
        字典设置(条目, "错位", 读["位"])
        字典设置(状态, "值错", 真)
        跳出
      如果 具象 == 真:
        设 读["文"] 为 读["文"] + 解析JSON("\"\\u" + 十六 + "\"")
      设 读["长"] 为 读["长"] + 1
      设 读["位"] 为 读["位"] + 6
      继续
    设 解 为 简单转义符(随字)
    如果 解 == 空:
      字典设置(条目, "错位", 读["位"])
      字典设置(状态, "值错", 真)
      跳出
    如果 具象 == 真:
      设 读["文"] 为 读["文"] + 解
    设 读["长"] 为 读["长"] + 1
    设 读["位"] 为 读["位"] + 2
  返回

# textNow 的整串快取（L347-361）：闭界且需解码且无误时先试整段 JSON 解码
段落 备整串(状态, 条目):
  如果 条目["读文"] != 空:
    返回
  如果 条目["止"] < 0:
    返回
  如果 条目["需解码"] == 假:
    返回
  如果 条目["错位"] != 空:
    返回
  设 原 为 段切片(状态, 条目["起"], 条目["止"])
  设 文 为 空
  尝试:
    设 文 为 解析JSON("\"" + 原 + "\"")
  捕获 错误:
    返回
  字典设置(条目, "读文", {"位": 条目["止"], "长": 字符串长度(文), "文": 文})

# =====================================================================
# 现值层（对齐上游各 Now 函数：不记读，仅供公开读口与刷新复用）
# =====================================================================

段落 取串条目(状态, 键):
  如果 字典包含键(状态["条目"], 键) == 假:
    返回 空
  设 条目 为 字典获取(状态["条目"], 键)
  如果 条目["种别"] != "串":
    返回 空
  返回 条目

段落 闭合现值(状态):
  如果 状态["密闭"] == 真:
    返回 真
  如果 状态["阶段"] == "已闭":
    返回 真
  如果 状态["阶段"] == "错":
    返回 真
  返回 假

段落 完整现值(状态, 键):
  如果 字典包含键(状态["条目"], 键) == 假:
    返回 假
  设 条目 为 字典获取(状态["条目"], 键)
  如果 条目["止"] < 0:
    返回 假
  如果 条目["种别"] == "串":
    如果 条目["错位"] == 空:
      返回 真
    返回 假
  如果 条目["错值"] == 假:
    返回 真
  返回 假

# 取值解析（valueNow L385-403 的解析部分）：返回 {成, 值}
段落 取值解析(状态, 条目):
  如果 条目["错值"] == 真:
    返回 {"成": 假, "值": 空}
  如果 条目["解析"] != 空:
    返回 {"成": 真, "值": 条目["解析"]}
  设 成 为 真
  设 解 为 空
  尝试:
    设 解 为 解析JSON(段切片(状态, 条目["起"], 条目["止"]))
  捕获 错误:
    设 成 为 假
  如果 成 == 假:
    字典设置(条目, "错值", 真)
    字典设置(状态, "值错", 真)
    返回 {"成": 假, "值": 空}
  字典设置(条目, "解析", 解)
  返回 {"成": 真, "值": 解}

段落 值现值(状态, 键):
  如果 字典包含键(状态["条目"], 键) == 假:
    返回 空
  设 条目 为 字典获取(状态["条目"], 键)
  如果 条目["种别"] != "值":
    返回 空
  如果 条目["止"] < 0:
    返回 空
  设 果 为 取值解析(状态, 条目)
  如果 果["成"] == 假:
    返回 空
  返回 果["值"]

段落 串文现值(状态, 键):
  设 条目 为 取串条目(状态, 键)
  如果 条目 == 空:
    返回 空
  备整串(状态, 条目)
  如果 条目["读文"] == 空:
    字典设置(条目, "读文", {"位": 条目["起"], "长": 0, "文": ""})
  设 读 为 条目["读文"]
  读串体(状态, 条目, 读, 解码大限, 真)
  返回 读["文"]

段落 串前缀现值(状态, 键, 限):
  设 条目 为 取串条目(状态, 键)
  如果 条目 == 空:
    返回 空
  设 键名 为 转字符串(限)
  如果 条目["前缀表"] == 空:
    字典设置(条目, "前缀表", {})
  如果 字典包含键(条目["前缀表"], 键名) == 假:
    字典设置(条目["前缀表"], 键名, {"位": 条目["起"], "长": 0, "文": ""})
  设 读 为 字典获取(条目["前缀表"], 键名)
  读串体(状态, 条目, 读, 限, 真)
  返回 读["文"]

段落 串长现值(状态, 键, 限):
  设 条目 为 取串条目(状态, 键)
  如果 条目 == 空:
    返回 空
  # 整串已读至闭界：直接复用其长度（上游 L337）
  如果 条目["读文"] != 空 且 条目["读文"]["位"] == 条目["止"]:
    返回 条目["读文"]["长"]
  如果 条目["读长"] == 空:
    字典设置(条目, "读长", {"位": 条目["起"], "长": 0, "文": ""})
  设 读 为 条目["读长"]
  读串体(状态, 条目, 读, 限, 假)
  返回 读["长"]

# =====================================================================
# 读记忆层（remember/refresh，L296-331）
# =====================================================================

# 上进位：ceil(值 / 步)，仅用于正整数粒度
段落 上进位(值, 步):
  设 商 为 值 // 步
  如果 商 * 步 == 值:
    返回 商
  返回 商 + 1

# remember：未密闭时按「种别/键/步/移/限」登记答案与比较值
段落 记读(状态, 种别, 键, 现值, 比较值, 步, 移, 限):
  如果 状态["密闭"] == 真:
    返回
  设 标识 为 种别 + "/" + 键 + "/" + 转字符串(步) + "/" + 转字符串(移) + "/" + 转字符串(限)
  如果 字典包含键(状态["读表"], 标识) == 假:
    设 完整类 为 假
    如果 种别 == "complete":
      设 完整类 为 真
    字典设置(状态["读表"], 标识, {"种别": 种别, "键": 键, "完整类": 完整类, "步": 步, "移": 移, "限": 限, "末": 比较值})

# 重答：刷新时按登记重算比较值（不走记读，避免自扰）
段落 重答(状态, 读):
  设 种别 为 读["种别"]
  如果 种别 == "closed":
    返回 闭合现值(状态)
  如果 种别 == "keys":
    返回 列表长度(状态["次序"])
  如果 种别 == "has":
    返回 字典包含键(状态["条目"], 读["键"])
  如果 种别 == "complete":
    返回 完整现值(状态, 读["键"])
  如果 种别 == "text":
    返回 串文现值(状态, 读["键"])
  如果 种别 == "value":
    返回 值现值(状态, 读["键"])
  如果 种别 == "length":
    设 长 为 串长现值(状态, 读["键"], 解码大限)
    如果 长 == 空:
      返回 空
    返回 上进位(长 + 读["移"], 读["步"])
  如果 种别 == "prefix":
    返回 串前缀现值(状态, 读["键"], 读["限"])
  如果 种别 == "exceeds":
    设 长2 为 串长现值(状态, 读["键"], 读["限"] + 1)
    设 基 为 0
    如果 长2 != 空:
      设 基 为 长2
    如果 基 > 读["限"]:
      返回 真
    返回 假
  返回 空

段落 刷一读(状态, 读):
  设 今 为 重答(状态, 读)
  如果 今 == 读["末"]:
    返回 假
  字典设置(读, "末", 今)
  返回 真

# refresh（L166-186）：先非完整类、后完整类（内容读可改写完整判定）；密闭后清空读表
段落 流式刷新(状态):
  如果 列表长度(字典键列表(状态["读表"])) == 0:
    返回 假
  流式扫描(状态)
  设 变 为 假
  设 标识表 为 字典键列表(状态["读表"])
  遍历 标识 之 标识表:
    设 读 为 字典获取(状态["读表"], 标识)
    如果 读["完整类"] == 真:
      继续
    如果 刷一读(状态, 读) == 真:
      设 变 为 真
  遍历 标识 之 标识表:
    设 读 为 字典获取(状态["读表"], 标识)
    如果 读["完整类"] == 假:
      继续
    如果 刷一读(状态, 读) == 真:
      设 变 为 真
  如果 状态["密闭"] == 真:
    字典设置(状态, "读表", {})
  返回 变

# =====================================================================
# 公开读口（未密闭时顺带记读，供 流式刷新 做变更检测）
# =====================================================================

段落 流式闭合(状态):
  流式扫描(状态)
  设 值 为 闭合现值(状态)
  记读(状态, "closed", "", 值, 值, 1, 0, 0)
  返回 值

段落 流式键表(状态):
  流式扫描(状态)
  记读(状态, "keys", "", 状态["次序"], 列表长度(状态["次序"]), 1, 0, 0)
  返回 状态["次序"]

段落 流式含字段(状态, 键):
  流式扫描(状态)
  设 值 为 字典包含键(状态["条目"], 键)
  记读(状态, "has", 键, 值, 值, 1, 0, 0)
  返回 值

段落 流式字段完整(状态, 键):
  流式扫描(状态)
  设 值 为 完整现值(状态, 键)
  记读(状态, "complete", 键, 值, 值, 1, 0, 0)
  返回 值

段落 流式串文(状态, 键):
  流式扫描(状态)
  设 文 为 串文现值(状态, 键)
  记读(状态, "text", 键, 文, 文, 1, 0, 0)
  返回 文

段落 流式串前缀(状态, 键, 限 = 1):
  流式扫描(状态)
  设 实际限 为 限
  如果 实际限 < 1:
    设 实际限 为 1
  设 文 为 串前缀现值(状态, 键, 实际限)
  记读(状态, "prefix", 键, 文, 文, 1, 0, 实际限)
  返回 文

段落 流式串长度(状态, 键, 步 = 1, 移 = 0):
  流式扫描(状态)
  设 长 为 串长现值(状态, 键, 解码大限)
  设 实际步 为 步
  如果 实际步 < 1:
    设 实际步 为 1
  设 比较 为 空
  如果 长 != 空:
    设 比较 为 上进位(长 + 移, 实际步)
  记读(状态, "length", 键, 长, 比较, 实际步, 移, 0)
  返回 长

段落 流式串超限(状态, 键, 上限):
  流式扫描(状态)
  设 限 为 上限
  如果 限 < 0:
    设 限 为 0
  设 长2 为 串长现值(状态, 键, 限 + 1)
  设 基 为 0
  如果 长2 != 空:
    设 基 为 长2
  设 值 为 假
  如果 基 > 限:
    设 值 为 真
  记读(状态, "exceeds", 键, 值, 值, 1, 0, 限)
  返回 值

段落 流式值(状态, 键):
  流式扫描(状态)
  设 值 为 值现值(状态, 键)
  记读(状态, "value", 键, 值, 值, 1, 0, 0)
  返回 值

段落 流式无效(状态):
  流式扫描(状态)
  如果 状态["错位"] != 空:
    返回 真
  如果 状态["值错"] == 真:
    返回 真
  返回 假

# 可观测进度（供对拍「跨调用不重扫已消费前缀」判据）
#   已读 = #consumed（累计消费位移）；步计 = 累计实际步进次数（跨调用只增不重置）
段落 流式进度(状态):
  返回 {"已读": 状态["已读"], "总长": 状态["总长"], "步计": 状态["步计"], "密闭": 状态["密闭"]}

# 汇总视图（最小可用契约）：
#   {"键表": [键…首现序], "字段表": {键: 完整值},
#    "闭合": 外层已闭或已判错, "无效": 扫描发现非法 JSON（只报结构错，见降级登记 6）}
#   字段表只收"完整可读"字段：串 → 完整解码文本（未闭/有错不收）；
#   值 → 解析结果（未闭/解析失败不收）。
段落 流式视图(状态):
  流式扫描(状态)
  设 字段表 为 {}
  遍历 键 之 状态["次序"]:
    设 条目 为 字典获取(状态["条目"], 键)
    如果 条目["止"] < 0:
      继续
    如果 条目["种别"] == "串":
      设 文 为 串文现值(状态, 键)
      # 读后无内容错才视为完整可读（对齐上游 completeNow 的 invalidAt 判据）
      如果 条目["错位"] == 空:
        字典设置(字段表, 键, 文)
      继续
    设 果 为 取值解析(状态, 条目)
    如果 果["成"] == 真:
      字典设置(字段表, 键, 果["值"])
  设 视 为 字典创建()
  字典设置(视, "键表", 状态["次序"])
  字典设置(视, "字段表", 字段表)
  字典设置(视, "闭合", 闭合现值(状态))
  字典设置(视, "无效", 状态["错位"] != 空)
  返回 视

# =====================================================================
# 纯函数层（R126 契约：每次新开状态、全量扫描；供无跨调用需求的调用方）
# =====================================================================

段落 参数键表(文本):
  设 s 为 扫描顶层(文本)
  返回 s["次序"]

段落 参数字段完整(文本, 键):
  设 s 为 扫描顶层(文本)
  返回 完整现值(s, 键)

段落 参数字符串前缀(文本, 键):
  设 s 为 扫描顶层(文本)
  返回 串文现值(s, 键)

段落 参数字符串长度(文本, 键):
  设 s 为 扫描顶层(文本)
  返回 串长现值(s, 键, 解码大限)

段落 参数值(文本, 键):
  设 s 为 扫描顶层(文本)
  返回 值现值(s, 键)

段落 残缺参数视图(文本):
  返回 流式视图(扫描顶层(文本))

导出 解码大限 是json空白 是十六进制字符 简单转义符 扫描顶层 读串体
导出 参数键表 参数字段完整 参数字符串前缀 参数字符串长度 参数值 残缺参数视图
导出 流式扫描器 流式追加 流式定着 流式定全文 流式扫描 流式进度
导出 流式键表 流式含字段 流式字段完整 流式串文 流式串前缀 流式串长度 流式串超限
导出 流式值 流式闭合 流式无效 流式刷新 流式视图
