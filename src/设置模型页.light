# =====================================================================
# §6 模型选项区（上游 modelAdvanced 每行展开箭头的内容，ModelRow.tsx:65-74）
#   复用 模型信息.解析模型信息 全量解析：上下文窗口 / 最大输出 / 输入类型 / 推理努力。
# =====================================================================

# 模型选项区(模型条目) -> 字典（模型条目 = 默认模型目录 的一条）
段落 模型选项区(模型条目):
  设 目录 为 [模型条目]
  设 连接 为 {}
  连接["models"] 为 目录
  设 信息 为 解析模型信息(连接, "deepseek-official", 模型条目["id"])
  设 选项 为 {}
  选项["上下文窗口"] 为 信息["context"]["contextWindow"]
  选项["最大输出"] 为 信息["defaultMaxTokens"]
  选项["输入类型"] 为 信息["inputModalities"]
  选项["推理努力表"] 为 信息["reasoning"]["efforts"]
  选项["默认努力"] 为 信息["reasoning"]["defaultEffort"]
  返回 选项

# =====================================================================
# §7 行编辑校验（上游 ProviderEditor 校验消息，locales.ts:190-194 逐字）
# =====================================================================

# 判正数(值) -> 真假：数字须 > 0；字符串按 T-6 口径解析（"131072"/"256K"/"1M"）
段落 判正数(值):
  如果 是整数(值) 或 是浮点(值):
    如果 值 > 0:
      返回 真
    返回 假
  如果 是字符串(值):
    设 文本 为 去除空白(值)
    如果 文本 == "":
      返回 假
    设 尾缀 为 ""
    如果 结尾(文本, "K") 或 结尾(文本, "k"):
      设 尾缀 为 "K"
    如果 结尾(文本, "M") 或 结尾(文本, "m"):
      设 尾缀 为 "M"
    设 数值部分 为 文本
    如果 尾缀 != "":
      设 数值部分 为 截取(文本, 0, 字符串长度(文本) - 1)
    设 数值 为 0
    尝试:
      设 数值 为 转浮点(数值部分)
    捕获 (运行时错误):
      返回 假
    如果 数值 <= 0:
      返回 假
    如果 尾缀 == "K":
      设 数值 为 数值 * 1024
    如果 尾缀 == "M":
      设 数值 为 数值 * 1024 * 1024
    返回 真
  返回 假

# 校验模型行(模型行, 既有行集) -> {"合法": 真假, "消息": 串}
#   判定序（先到先停）：id 空 → id 重复 → 上下文窗口非正 → 最大输出非正。
#   ⚠ 反跑锚点：删「id 重复」判定 → 「模型 ID 不能重复」用例必须红。
#   既有行集 = 目录行形状（含 "id" 键）；编辑既有行时由调用方排除自身行。
#   文案 keyBlankNew / modelIdRequired / modelIdDuplicate / modelContextInvalid /
#   modelMaxTokensInvalid 全部走 §1 文案表，一字不差（含末尾句号）。
段落 校验模型行(模型行, 既有行集):
  设 表 为 文案表()
  设 结论 为 {}
  结论["合法"] 为 真
  结论["消息"] 为 ""
  设 标识 为 取可选(模型行, "id", "")
  如果 标识 == "":
    结论["合法"] 为 假
    结论["消息"] 为 表["modelIdRequired"]
    返回 结论
  遍历 既有 之 既有行集:
    如果 既有["id"] == 标识:
      结论["合法"] 为 假
      结论["消息"] 为 表["modelIdDuplicate"]
      返回 结论
  如果 字典包含键(模型行, "上下文窗口"):
    如果 判正数(模型行["上下文窗口"]) == 假:
      结论["合法"] 为 假
      结论["消息"] 为 表["modelContextInvalid"]
      返回 结论
  如果 字典包含键(模型行, "最大输出"):
    设 输出 为 模型行["最大输出"]
    如果 是空(输出) == 假:
      如果 判正数(输出) == 假:
        结论["合法"] 为 假
        结论["消息"] 为 表["modelMaxTokensInvalid"]
        返回 结论
  返回 结论

# =====================================================================
# §8 密钥校验（上游 keyInput 编辑约定；密钥永不回显，T-5 / T-7）
# =====================================================================

# 校验密钥(明文, 是否已有) -> {"合法": 真假, "消息": 串}
#   空且已有 → 合法（上游约定：留空 = 保持已存密钥）；
#   空且未有 → keyBlankNew 逐字；含空白字符 → 格式错误（T-5）。
#   本段落只做校验，不存储、不回显、不打日志。
段落 校验密钥(明文, 是否已有):
  设 表 为 文案表()
  设 结论 为 {}
  结论["合法"] 为 真
  结论["消息"] 为 ""
  设 密文 为 明文
  如果 是空(明文):
    设 密文 为 ""
  如果 是字符串(密文) == 假:
    结论["合法"] 为 假
    结论["消息"] 为 表["keyFormatError"]
    返回 结论
  # 空且已有 → 合法（上游约定：留空 = 保持已存密钥）
  如果 密文 == "":
    如果 是否已有:
      返回 结论
    结论["合法"] 为 假
    结论["消息"] 为 表["keyBlankNew"]
    返回 结论
  # 含空白字符（空格/制表/换行）→ 格式错误（口径 T-5）
  如果 字符串包含(密文, " ") 或 字符串包含(密文, "\t") 或 字符串包含(密文, "\n"):
    结论["合法"] 为 假
    结论["消息"] 为 表["keyFormatError"]
    返回 结论
  返回 结论

# =====================================================================
# §9 整页渲染（合流入口：E 线 渲染模型页 委托本段）
# =====================================================================

# 渲染模型页(配置元数据) -> §2.1 目标形状整页字典
#   说明 逐字 = 上游 intro；只读 恒 假（本仓设置文档可写，上游 readOnly 仅文档只读时为真）；
#   未配置（无密钥）→ 只读=假 且 提供商行[0].凭据.configured=假（前端据此给红点）。
#   可用提供商：「添加模型提供商」下拉候选；本仓单提供商，仅 deepseek 系（T-1）。
段落 渲染模型页(配置元数据):
  设 表 为 文案表()
  设 说明 为 表["intro"]
  设 只读 为 假
  设 提供商行 为 提供商行集(配置元数据)
  设 模型行 为 模型行集(配置元数据)
  设 继承 为 模型目录继承(配置元数据)
  设 候选 为 ["deepseek-official"]
  设 选项 为 协议选项()
  设 页 为 {}
  页["说明"] 为 说明
  页["只读"] 为 只读
  页["提供商行"] 为 提供商行
  页["模型行"] 为 模型行
  页["模型目录继承"] 为 继承
  页["可用提供商"] 为 候选
  页["协议选项"] 为 选项
  返回 页

导出 文案表, 凭据视图, 提供商行集, 模型行集, 模型目录继承, 协议选项, 模型选项区, 判正数, 校验模型行, 校验密钥, 渲染模型页
