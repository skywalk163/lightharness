# 启动环境.light —— 对齐原版 packages/util/launch-environment/src/index.ts
#
# 不可变启动环境快照：每值记录来源层（进程继承 > 调用目录 .env > Harness 家目录 .env），
# 从最可信到最不可信解析；launcher 可物化接受值给配置表达式/第三方库。
# 剔除 Cordis Context 宿主面（launchEnvironmentOf / DSH_LAUNCH_ENVIRONMENT_KEY / declare module）。
#
# 光明差异口径（报告登记）：
#   1) 原版 lookupKey 用 process.platform 判定；光明侧平台标识作为显式入参
#      （"win32" 折叠为大写键，其余保留原样），纯函数化、可测试。
#   2) 构造时复制每层值表（键折叠后的新字典），外部后续改动不透传进快照（不可变）。
#   3) user-env 层即「Harness 家目录 .env」：其绝对路径语义与 src/主目录路径.light 的
#      解析主目录 核对 —— 家目录 .env 路径 = 解析主目录(配置, 环境, 主目录) 下的 .env，
#      由调用方物化后作为层输入传入；本模块只负责层级解析，不拼路径（与上游一致）。

从 字符串工具轻量 导入 转大写

# 来源层：进程继承 > 调用目录 .env > 家目录 .env（最可信到最不可信）
设 来源序 为 ["process", "project-env", "user-env"]
# SSH 启动标记（仅进程层可信，.env 不得伪造 SSH 会话）
设 SSH标记表 为 ["SSH_CONNECTION", "SSH_TTY"]

# 键查找：win32 环境名大小写不敏感 → 大写折叠；其余平台精确
段落 查找键(名称, 平台标识):
  如果 平台标识 == "win32":
    返回 转大写(名称)
  返回 名称

# 不可变启动环境快照
类 启动环境快照:
  属性 层表 等于 空
  属性 平台标识 等于 ""

  # 构造：接收层输入表（每项 {来源, 路径?, 值表}），复制并折叠键，外部改动不透传
  段落 构造(层输入表, 平台标识):
    设 层 为 {}
    遍历 输入 之 层输入表:
      设 来源 为 输入["来源"]
      设 值表 为 {}
      遍历 名称 之 字典键列表(输入["值表"]):
        设 值表[查找键(名称, 平台标识)] 为 输入["值表"][名称]
      设 条目 为 {}
      条目["值表"] 为 值表
      如果 字典包含键(输入, "路径"):
        条目["路径"] 为 输入["路径"]
      层[来源] 为 条目
    设 己.层表 为 层
    设 己.平台标识 为 平台标识

  # 解析一个名称：全来源序，最可信优先
  段落 取(名称):
    返回 己.取从(名称, 来源序)

  # 仅从允许的来源解析，保留规范信任序；未命中返回 空
  段落 取从(名称, 允许表):
    设 键 为 查找键(名称, 己.平台标识)
    遍历 来源 之 来源序:
      如果 列表包含(允许表, 来源) == 假:
        继续
      如果 字典包含键(己.层表, 来源) == 假:
        继续
      设 层 为 己.层表[来源]
      如果 字典包含键(层["值表"], 键) == 假:
        继续
      设 结果 为 {}
      结果["值"] 为 层["值表"][键]
      结果["来源"] 为 来源
      如果 字典包含键(层, "路径"):
        结果["路径"] 为 层["路径"]
      返回 结果
    返回 空

# 工厂：构造不可变快照（对齐 createLaunchEnvironmentSnapshot）
段落 构造启动环境快照(层输入表, 平台标识):
  返回 新建 启动环境快照(层输入表, 平台标识)

# SSH 启动判定：进程层非空 SSH_CONNECTION / SSH_TTY 即建立（对齐 launchedThroughSsh，trim 后判非空）
段落 判定SSH启动(快照):
  遍历 名称 之 SSH标记表:
    设 条目 为 快照.取从(名称, ["process"])
    如果 条目 != 空:
      如果 去除空白(条目["值"]) != "":
        返回 真
  返回 假

# 导出清单
导出 来源序, SSH标记表
导出 构造启动环境快照, 判定SSH启动
