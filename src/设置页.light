# 设置页.light —— 对照原版 web-app 设置页（通用设置 / 模型 / 内置插件 / Agent预设）
#
# 复刻边界：React 渲染属宿主面，本模块只做「纯逻辑结构」——产出可序列化的设置页数据模型
#   （页签 + 各页数据），可被任意前端直接消费。
#
# 复刻源：
#   deepseek-harness 设置页（用户在 v0.1.7 实测）：四页签 + 「Agent预设」页四内置预设展示文案。
#   R105 任务线 A：通用设置改为九行行集模型（§3.5，对齐原版设置对话框），内置插件计数移至 内置插件 键。
#
# 依赖（只读复用，不重写）：
#   src/预设组合.light —— 组合统计 / 预设清单 / 预设序 / 组合（内置插件按模式计数）
#   src/预设.light     —— 造未知道错误（未知预设闸门）
#
# 与 src/预设.light.内置预设文案 的区别（重要）：
#   src/预设.light.内置预设文案 复刻的是 packages/preset/agent-presets/src/display.ts
#   （BUILT_IN_PRESET_KEYS，用于「预设选择器 / 命令面板」的短名），是 dsh 的另一张 UI 面；
#   本模块的 Agent 预设文案取自「设置页 → Agent预设」页，文案更详细，二者独立、不混用。
#
# 语言坑规避：L-047（字典/列表字面量不可直接作实参 → 先赋变量）；L-055/L-160（写/打印 只吃
#   字面量串或已设为串的变量）；L-151（`设 X 为` 的 为 前必须有空格）；L-170（核心动词关键字
#   不可作变量名）；列表/字典字面量不内含换行。

从 预设组合 导入 组合统计, 预设清单, 预设序, 是已知预设, 组合
从 预设 导入 造未知道错误
# R105 收口合流（#257）：模型 / 内置插件 / Agent预设 三页签的深化结构由 src/设置页深化.light 提供。
#   ⚠ 循环依赖（实测）：设置页深化 反向依赖本模块的 智能预设元数据表/预设按序/内置插件概览/
#   内置插件按模式/默认预设标识。两边都用 `从 X 导入 名` 会在**任一入口**撞上半初始化模块：
#     · 入口=设置页       → 深化 取不到 智能预设元数据表（本模块还没定义到那一行）
#     · 入口=设置页深化   → 本模块 取不到 渲染模型页（深化 还没定义到那一行）
#   解法：两边都改成 `导入 <模块>`（只绑定模块对象，不立即取属性），调用点走 `模块.段落()`。
#   Python 的 `import X` 对半初始化模块是安全的，属性在**调用时**才解析，那时两边都已完整。
导入 设置页深化
从 内置核心转换 导入 转字符串
从 内置核心字典 导入 字典包含键, 字典设置, 字典键列表, 字典获取
从 内置核心列表 导入 列表创建, 列表追加, 列表包含
从 内置核心判型 导入 是字符串, 是整数, 是浮点

# =====================================================================
# §1 设置页四页签
# =====================================================================

# 显示名（设置页顶部 Tab）
段落 设置页签():
  返回 ["通用设置", "模型", "内置插件", "Agent预设"]

# 页签内部标识（程序用 kebab 串，避免与显示名耦合）
段落 页签标识():
  返回 ["general", "models", "builtin-plugins", "agent-presets"]

# 每页签一句话说明（设置页导航辅助）
段落 页签说明():
  设 表 为 {}
  字典设置(表, "general", "通用配置：内置插件按模式分布")
  字典设置(表, "models", "选择并配置模型")
  字典设置(表, "builtin-plugins", "已安装的内置插件清单（宿主插件注册表提供）")
  字典设置(表, "agent-presets", "选择 Agent 的工具和工作方式")
  返回 表

# =====================================================================
# §2 Agent 预设元数据（设置页「Agent预设」页；T-0403 起 8 个内置预设）
#   来源：用户在 deepseek-harness 设置页实测的展示文案。
#   字段：
#     id          预设标识（standard/ptc/minimal/cordis + topdown/bottomup/brainstorm/lazy）
#     名称        中文显示名
#     描述        设置页卡片摘要文案
#     是否内置    恒 真（四者皆内置，带「内置」徽标）
#     顺序        列表顺序（standard 默认在前）
#     是否默认    standard 为默认（新任务默认）
#     区块        模式说明 / 如何使用 两个可展开区（详细正文未在实测中抓取，先占位 空）
# =====================================================================

段落 造预设元数据(标识, 名称, 描述, 是否内置, 顺序, 是否默认, 类别 = ""):
  设 区块 为 {}
  字典设置(区块, "模式说明", 空)
  字典设置(区块, "如何使用", 空)
  返回 {"id": 标识, "名称": 名称, "描述": 描述, "是否内置": 是否内置,
    "顺序": 顺序, "是否默认": 是否默认, "类别": 类别, "分组名": 造分组名(类别),
    "区块": 区块}

# 类别 -> 展示分组名（T-0439 分层：设置页与前端下拉共用这一份文案口径）
段落 造分组名(类别):
  如果 (类别 == "agent"):
    返回 "Agent 模式"
  如果 (类别 == "method"):
    返回 "工作方法"
  返回 ""

段落 智能预设元数据表():
  设 标准 为 造预设元数据("standard", "标准模式",
    "处理代码、文件和资料，适合大多数任务。Agent 会按需使用检索、编辑和终端等工具。", 真, 1, 真, "agent")
  设 编码 为 造预设元数据("ptc", "PTC 模式",
    "包含标准模式的所有能力，更适合批量调用工具，并对结果进行筛选、整理、去重、统计或汇总的任务。", 真, 2, 假, "agent")
  设 极简 为 造预设元数据("minimal", "极简模式",
    "Agent 仅使用终端工具完成任务，适合测试和对比其基础表现。", 真, 3, 假, "agent")
  设 组装 为 造预设元数据("cordis", "创造模式",
    "用对话定制 DSH：让 Agent 编写插件，添加新功能或界面；也能组合工具和提示词，创建自己的模式。", 真, 4, 假, "agent")
  # T-0403：四个组合型模式（顺序 5-8，均非默认）。文案为本地新增，无上游逐字对应；
  #   帮助正文（模式说明 / 如何使用）一并落在这里，供 设置页深化 的回调兜底取用。
  # T-0439：它们不是「另一种 Agent 预设」而是方法论，类别固定为 method（工作方法）。
  设 自上 为 造预设元数据("topdown", "自上而下",
    "先把任务拆成计划树再执行，计划树是一等产物。适合边界清楚、步骤长、需要事先对齐的工作。", 真, 5, 假, "method")
  设 自下 为 造预设元数据("bottomup", "自下而上",
    "没有中央规划器：领一个原子单元、做完、交回，再领下一个。适合清单式、可独立推进的琐碎工作。", 真, 6, 假, "method")
  设 头脑 为 造预设元数据("brainstorm", "头脑风暴",
    "只给只读工具的纯讨论模式：先发散不评判，过硬闸后再收敛排序。适合方案探索与评审。", 真, 7, 假, "method")
  设 懒人 为 造预设元数据("lazy", "懒人",
    "沿决策阶梯往下走：能不做就不做，能复用就不新写。适合「先看看有没有现成的」这类诉求。", 真, 8, 假, "method")
  # 四个新模式的 帮助正文 回填进 区块（正文本体在 帮助正文，这里只做一次挂接）
  字典设置(自上, "区块", 帮助区块("topdown"))
  字典设置(自下, "区块", 帮助区块("bottomup"))
  字典设置(头脑, "区块", 帮助区块("brainstorm"))
  字典设置(懒人, "区块", 帮助区块("lazy"))
  设 表 为 {}
  字典设置(表, "standard", 标准)
  字典设置(表, "ptc", 编码)
  字典设置(表, "minimal", 极简)
  字典设置(表, "cordis", 组装)
  字典设置(表, "topdown", 自上)
  字典设置(表, "bottomup", 自下)
  字典设置(表, "brainstorm", 头脑)
  字典设置(表, "lazy", 懒人)
  返回 表

# 新模式帮助正文（模式说明 / 如何使用）：
#   shipped 四预设的正文在 src/设置页深化.light（上游 guide-locales.ts 逐字）；
#   四个组合型模式没有上游正文，正文放这里，由 设置页深化.预设模式说明/预设如何使用
#   的回调兜底取用（那边只改「取不到就回调本函数」，不搬正文）。
段落 帮助正文(预设标识, 区名):
  如果 (预设标识 == "topdown"):
    如果 (区名 == "模式说明"):
      返回 "把任务自上而下拆成一棵计划树：节点、依赖、预估依据都写在树上，计划本身就是要交付的东西之一。执行按依赖顺序推进叶子节点，改计划要改树并说明原因。"
    如果 (区名 == "如何使用"):
      返回 "第一次把计划树整棵提交给用户确认；被拒就改树再提交。叶子全部完成、或用户拒绝且不接受改树、或某节点失败无路可退时结束。"
  如果 (预设标识 == "bottomup"):
    如果 (区名 == "模式说明"):
      返回 "不先做整体规划：扫出可独立完成的原子单元，领一个做完交回，再领下一个。单元之间不互相等待，也不会为了全局一致先搭大计划。"
    如果 (区名 == "如何使用"):
      返回 "适合清单式、可独立推进的活。任何已发现单元处理完、或连续两轮没有新的有效产出、或到达轮次上限时结束；过程中不主动请求确认。"
  如果 (预设标识 == "brainstorm"):
    如果 (区名 == "模式说明"):
      返回 "只挂只读工具（读文件 / 搜索文件）的纯讨论模式。发散阶段禁评判、禁打分；发散与收敛之间有一道硬闸；收敛阶段要对方案给 Steelman 与 Devil's Advocate 再排序。"
    如果 (区名 == "如何使用"):
      返回 "先让 Agent 把想法铺开，到最大轮次或你喊停；你点头后才进收敛。排序连续多轮稳定即结束。想改代码请换标准模式。"
  如果 (预设标识 == "lazy"):
    如果 (区名 == "模式说明"):
      返回 "沿决策阶梯往下让步：不做、现成项目或服务、现成库、已有依赖或标准库、一行代码，最后才写新代码。进入写代码前要留下「方案层已穷尽」的依据。"
    如果 (区名 == "如何使用"):
      返回 "不追问细节，缺参数就选最保守的默认值继续，末尾附默认决策日志。只在不可逆操作前停下确认。两个开关（最小必要行动 / 最少交互自主跑）默认都开。"
  返回 空

# 帮助区块(预设标识) -> {"模式说明": 串, "如何使用": 串}；无正文则空字典
段落 帮助区块(预设标识):
  设 说明 为 帮助正文(预设标识, "模式说明")
  设 用法 为 帮助正文(预设标识, "如何使用")
  如果 (说明 == 空 或 用法 == 空):
    设 空块 为 {}
    返回 空块
  返回 {"模式说明": 说明, "如何使用": 用法}

# 预设帮助正文(预设标识, 区名) -> 元数据表 区块 里的正文（区名取 "模式说明" / "如何使用"）
#   调用点：设置页深化.预设模式说明 / 预设如何使用 的兜底分支（shipped 四预设不走到这里）。
#   未知预设仍抛错，消息形状与原先一致（"未知预设标识，无模式说明正文: x"）。
段落 预设帮助正文(预设标识, 区名):
  设 表 为 智能预设元数据表()
  如果 (字典包含键(表, 预设标识) == 假):
    抛出 新建 错误("未知预设标识，无" + 区名 + "正文: " + 转字符串(预设标识))
  设 区块 为 字典获取(表[预设标识], "区块", {})
  设 正文 为 字典获取(区块, 区名, 空)
  如果 (是字符串(正文) == 假 或 正文 == ""):
    抛出 新建 错误("预设 " + 转字符串(预设标识) + " 没有" + 区名 + "正文")
  返回 正文

# 单条预设元数据（未知预设 → 抛出，文案复用 预设.造未知道错误）
段落 取预设元数据(标识):
  如果 是已知预设(标识) == 假:
    设 坏 为 造未知道错误(转字符串(标识), 预设清单())
    抛出 新建 错误(坏["消息"])
  返回 智能预设元数据表()[标识]

# 预设按顺序排列（对齐设置页 Agent预设 列表顺序：standard→ptc→minimal→cordis→topdown…）
#   T-0439：新增可选 `类别` 过滤，空串 = 全部（向后兼容）。
段落 预设按序(类别 = ""):
  设 表 为 智能预设元数据表()
  设 清单 为 预设清单(类别)
  设 结果 为 列表创建()
  遍历 标识 之 清单:
    列表追加(结果, 表[标识])
  返回 结果

# 预设分组按序() -> [{"分组":"Agent 模式","类别":"agent","预设":[...]},
#                    {"分组":"工作方法","类别":"method","预设":[...]}]
#   设置页「Agent预设」页按这两组渲染（T-0439）；空组也保留，避免前端组头消失。
段落 预设分组按序():
  设 代理卡 为 预设按序("agent")
  设 方法卡 为 预设按序("method")
  设 代理组 为 {"分组": 造分组名("agent"), "类别": "agent", "预设": 代理卡}
  设 方法组 为 {"分组": 造分组名("method"), "类别": "method", "预设": 方法卡}
  设 组集 为 [代理组, 方法组]
  返回 组集

# 默认预设标识（新任务默认）：无默认 → 空
段落 默认预设标识():
  设 表 为 智能预设元数据表()
  遍历 标识 之 字典键列表(表):
    如果 表[标识]["是否默认"] == 真:
      返回 标识
  返回 空

# =====================================================================
# §3 通用设置 —— 内置插件按四模式（每种对应不同数量的插件）
#   数量口径：直接复用 预设组合.组合统计 的「展平后」
#   （声明行 + 插件行；对齐设置页「内置插件」按模式计数，standard/ptc/minimal/cordis 各不相同）。
# =====================================================================

# 内置插件按模式计数：随 预设清单() 走（T-0403 起 8 键；shipped 四键仍是 33/34/8/34）
段落 内置插件按模式():
  设 表 为 {}
  设 清单 为 预设清单()
  遍历 标识 之 清单:
    设 统计 为 组合统计(标识)
    字典设置(表, 标识, 统计["展平后"])
  返回 表

# 内置插件概览（整块渲染用：每个模式一行，含名称 / 插件行 / 展平后 / 描述）
段落 内置插件概览():
  设 元表 为 智能预设元数据表()
  设 清单 为 预设清单()
  设 结果 为 列表创建()
  遍历 标识 之 清单:
    设 统计 为 组合统计(标识)
    设 元 为 元表[标识]
    设 项 为 {"id": 标识, "名称": 元["名称"], "插件行": 统计["插件行"],
      "展平后": 统计["展平后"], "描述": 元["描述"]}
    列表追加(结果, 项)
  返回 结果

# =====================================================================
# §3.5 通用设置行集（R105 任务线 A）—— 对齐原版设置对话框「通用设置」页
#   九行 id 固定且按此序（对齐用户实拍截图行序）：
#     permission / language / appearance / fontSize / transcriptView /
#     performanceUsage / linkOpening / developerTools / shortcuts
#   上游考据（各线直接引用，勿重考）：
#     权限   packages/client/ui-permission-presets/src/client/locales.ts（title/description/preset.*）
#     语言   packages/client/locale/src/locale-settings.ts:15 LOCALE_IDS = ['zh','en']
#           + locale/src/locales/settings.ts（language.title=语言）；
#           locale/src/client/settings-store.ts:11（label 用各自语言自述：中文 / English）
#     外观   packages/client/ui-theme/src/client/locales.ts:5-8（浅色/深色/跟随系统）
#     字号   packages/client/ui-theme/src/theme-settings.ts:24-30（最小12 最大17 默认14）
#           + locales.ts:9-11（字号大小 / 仅影响会话内容的字号 / 单位px）
#     工作步骤展示 / 性能与用量 / 网页链接默认打开方式
#           packages/client/ui-chat/src/client/locale.ts:103-108 / :95-98 / :99-102
#     代码工作工具  packages/client/ui-settings-general/src/client/locales.ts:32-33
#     快捷键 packages/client/ui-shortcuts/src/client/locales.ts:31
#           （title=快捷键 / description=查看和编辑当前可用的快捷键和输入操作 / view=编辑快捷键）
# =====================================================================

# 造选项(值, 标签)：单选项 {"值", "标签"}
段落 造选项(值, 标签):
  返回 {"值": 值, "标签": 标签}

# 下拉行：id / 类型=下拉 / 标题 / 描述 / 选项 / 值
段落 造下拉行(标识, 标题, 描述, 选项表, 值):
  返回 {"id": 标识, "类型": "下拉", "标题": 标题, "描述": 描述, "选项": 选项表, "值": 值}

# 卡片三选行：id / 类型=卡片三选 / 标题 / 描述 / 选项 / 值
段落 造卡片行(标识, 标题, 描述, 选项表, 值):
  返回 {"id": 标识, "类型": "卡片三选", "标题": 标题, "描述": 描述, "选项": 选项表, "值": 值}

# 数字行：id / 类型=数字 / 标题 / 描述 / 单位 / 最小 / 最大 / 值
段落 造数字行(标识, 标题, 描述, 单位, 最小, 最大, 值):
  返回 {"id": 标识, "类型": "数字", "标题": 标题, "描述": 描述, "单位": 单位, "最小": 最小, "最大": 最大, "值": 值}

# 开关行：id / 类型=开关 / 标题 / 描述 / 值(真假)
段落 造开关行(标识, 标题, 描述, 值):
  返回 {"id": 标识, "类型": "开关", "标题": 标题, "描述": 描述, "值": 值}

# 按钮行：id / 类型=按钮 / 标题 / 描述 / 按钮（无 值 字段）
段落 造按钮行(标识, 标题, 描述, 按钮文案):
  返回 {"id": 标识, "类型": "按钮", "标题": 标题, "描述": 描述, "按钮": 按钮文案}

# 信息行：id / 类型=信息 / 标题 / 描述 / 值（只读展示，不参与值校验）
#   上游 CurrentVersionRow.tsx：只读版本信息，不可编辑
段落 造信息行(标识, 标题, 描述, 值):
  返回 {"id": 标识, "类型": "信息", "标题": 标题, "描述": 描述, "值": 值}

# 本仓版本常量（无上游版本号对应，light-merge 自举版）
#   来源：本仓自举进度，非上游 DSH 版本号
设 本仓版本 为 "0.2.0-lightmerge"

# 通用设置行集() -> 十二行列表（id 序按上游 order 升序，对齐 settings.general.item 槽位账本）
段落 通用设置行集():
  设 权限选项 为 [
    造选项("readOnly", "仅可查看"),
    造选项("workspaceWrite", "工作区内修改"),
    造选项("fullAccess", "完全权限")]
  设 语言选项 为 [
    造选项("zh", "中文"),
    造选项("en", "English")]
  设 外观选项 为 [
    造选项("light", "浅色"),
    造选项("dark", "深色"),
    造选项("system", "跟随系统")]
  设 步骤选项 为 [
    造选项("compact", "简洁"),
    造选项("standard", "标准"),
    造选项("detailed", "详细"),
    造选项("verbose", "完全展开")]
  设 用量选项 为 [
    造选项("compact", "简洁"),
    造选项("detailed", "详细")]
  设 链接选项 为 [
    造选项("sidebar", "应用内侧边栏"),
    造选项("newTab", "默认浏览器")]
  设 繁忙发送选项 为 [
    造选项("queue", "排队发送"),
    造选项("steer", "插话发送")]
  设 版本文案 为 "当前版本：" + 本仓版本
  设 行集 为 [
    造下拉行("permission", "权限", "选择新会话的默认权限模式", 权限选项, "workspaceWrite"),
    造下拉行("language", "语言", "", 语言选项, "zh"),
    造卡片行("appearance", "外观", "", 外观选项, "system"),
    造数字行("fontSize", "字号大小", "仅影响会话内容的字号", "px", 12, 17, 14),
    造下拉行("transcriptView", "工作步骤展示", "选择希望看到多少工具调用细节", 步骤选项, "detailed"),
    造下拉行("performanceUsage", "性能与用量", "选择性能与用量信息展示的详细程度", 用量选项, "detailed"),
    造下拉行("linkOpening", "网页链接默认打开方式", "对话中网页链接的打开位置", 链接选项, "sidebar"),
    造开关行("developerTools", "代码工作工具", "开启后显示轨迹、本轮代码差异，新对话中的 Agent 预设切换", 真),
    造按钮行("shortcuts", "快捷键", "查看和编辑当前可用的快捷键和输入操作", "编辑快捷键"),
    造下拉行("composerEnter", "繁忙时的发送行为", "智能体运行时 Enter 键和发送按钮的行为；Cmd/Ctrl+Enter 使用另一行为", 繁忙发送选项, "queue"),
    造开关行("sessionLogDeepseek", "在使用官方模型 API 时上传 Session Log", "帮助改进 DeepSeek 模型与产品", 假),
    造信息行("currentVersion", "关于", "", 版本文案)]
  返回 行集

# 取通用行(行id) -> 单行字典；未知行id 抛错（消息含合法 id 清单）
段落 取通用行(行标识):
  设 行集 为 通用设置行集()
  遍历 行 之 行集:
    如果 行["id"] == 行标识:
      返回 行
  设 合法 为 ""
  遍历 行 之 行集:
    设 合法 为 合法 + 行["id"] + " "
  抛出 新建 错误("未知通用设置行: " + 转字符串(行标识) + "，合法行id: " + 合法)

# 权限需确认(行id)：fullAccess 启用前需确认弹窗（前端契约，纯逻辑侧只判值）
#   值为 fullAccess → 真；其他 → 假
段落 权限需确认(值):
  如果 值 == "fullAccess":
    返回 真
  返回 假

# 校验通用值(行id, 新值) -> {"合法": 真假, "消息": 串}
#   下拉/卡片三选 → 新值必须在选项值集内；数字 → 数值且在 [最小,最大]；
#   开关 → 布尔值；按钮 → 不受值校验（合法，消息空）。
段落 校验通用值(行标识, 新值):
  设 行 为 取通用行(行标识)
  设 行类型 为 行["类型"]
  如果 行类型 == "下拉" 或 行类型 == "卡片三选":
    遍历 选项 之 行["选项"]:
      如果 选项["值"] == 新值:
        设 好结果 为 {"合法": 真, "消息": ""}
        返回 好结果
    设 坏结果 为 {"合法": 假, "消息": "非法选项值: " + 转字符串(新值)}
    返回 坏结果
  如果 行类型 == "数字":
    如果 (是整数(新值) 或 是浮点(新值)) == 假:
      设 非数 为 {"合法": 假, "消息": "值必须是数字: " + 转字符串(新值)}
      返回 非数
    如果 新值 < 行["最小"]:
      设 太小 为 {"合法": 假, "消息": "值低于最小 " + 转字符串(行["最小"]) + ": " + 转字符串(新值)}
      返回 太小
    如果 新值 > 行["最大"]:
      设 太大 为 {"合法": 假, "消息": "值超过最大 " + 转字符串(行["最大"]) + ": " + 转字符串(新值)}
      返回 太大
    设 数好 为 {"合法": 真, "消息": ""}
    返回 数好
  如果 行类型 == "开关":
    如果 isinstance(新值, bool) == 假:
      设 非布 为 {"合法": 假, "消息": "开关值必须是真假值: " + 转字符串(新值)}
      返回 非布
    设 布好 为 {"合法": 真, "消息": ""}
    返回 布好
  # 信息行：只读展示，无值校验（对齐按钮行处理）
  如果 行类型 == "信息":
    设 信息好 为 {"合法": 真, "消息": ""}
    返回 信息好
  # 按钮行：无值校验
  设 按钮好 为 {"合法": 真, "消息": ""}
  返回 按钮好

# 通用设置块(已存值为空) -> {"配置文档": {...}, "行集": [...]}
#   已存值参数为字典（行id→值，来自持久化，可能为空字典），非空则覆盖对应行默认值。
段落 通用设置块(已存值 = 空):
  设 行集 为 通用设置行集()
  设 存值 为 已存值
  如果 存值 == 空:
    设 空存 为 {}
    设 存值 为 空存
  设 结果 为 列表创建()
  遍历 行 之 行集:
    设 新行 为 行
    如果 字典包含键(存值, 行["id"]) == 真:
      设 行类型 为 字典获取(行, "类型", "")
      如果 行类型 == "按钮":
        列表追加(结果, 行)
      否则:
        设 覆盖行 为 {}
        遍历 键 之 字典键列表(行):
          如果 键 == "值":
            字典设置(覆盖行, 键, 存值[行["id"]])
          否则:
            字典设置(覆盖行, 键, 行[键])
        列表追加(结果, 覆盖行)
    否则:
      列表追加(结果, 行)
  设 文档为 为 {"路径": "", "可用": 假, "说明": "对应原版对话框头部的 profile patch 文件路径；宿主接入后填真实路径"}
  设 块 为 {"配置文档": 文档为, "行集": 结果}
  返回 块

# =====================================================================
# §4 渲染设置页（纯逻辑：产出可序列化结构，前端直接消费）
#   说明：
#     · 通用设置 —— 九行行集模型（§3.5 通用设置块，对齐原版设置对话框截图：
#       通用设置页无插件区，内置插件计数已移至 内置插件 键）；
#     · 模型 —— 宿主设置服务提供的模型清单（本仓不复制模型配置，留空结构）；
#     · 内置插件（顶Tab）—— 宿主插件注册表的完整插件目录（本仓不复制，留说明占位）
#       + 按模式概览 / 按模式计数（原 通用.内置插件.按模式 迁移至此）；
#     · Agent预设 —— 本仓内置预设元数据（含默认预设；T-0403 起 8 个）。
# =====================================================================

段落 渲染设置页():
  设 页签 为 设置页签()
  设 标识 为 页签标识()
  设 说明 为 页签说明()
  设 结构 为 {}
  字典设置(结构, "页签", 页签)
  字典设置(结构, "页签标识", 标识)
  字典设置(结构, "页签说明", 说明)
  设 空存 为 {}
  字典设置(结构, "通用设置", 通用设置块(空存))
  # R105 收口合流：模型 / 内置插件 / Agent预设 三键改由 设置页深化 提供（含行结构、
  #   按模式概览 + 按模式计数、四预设卡「模式说明 / 如何使用」正文）。调用点走模块对象。
  字典设置(结构, "模型", 设置页深化.渲染模型页())
  字典设置(结构, "内置插件", 设置页深化.渲染插件页())
  字典设置(结构, "Agent预设", 设置页深化.渲染预设页())
  返回 结构

