# 应用补丁.light —— 对标上游 packages/fs/fs-patch/src/{parse.ts,apply.ts}（dsh-v0.2.2-rc.1）
#
# Codex rust-v0.158.0 补丁格式（*** Begin Patch 语系）的纯逻辑复刻，两件事：
#   1) 解析：Add / Delete / Update(+ Move to) 头、@@ 锚点、' ' '+' '-' 行、*** End of File、
#      heredoc 包装（<<EOF / <<'EOF' / <<"EOF"），行号按原始输入（含包装行）计。
#   2) 应用：对 LF 文本做四遍规范化（原样 / 去尾空白 / 去首尾空白 / 标点归一）定位 old 序列，
#      按补丁顺序回放；失败返回首个不匹配块，不产生半成品文本。
#
# 宿主面剔除：文件读写、路径解析、sandbox 策略、版本守卫、审计全在宿主；本模块只做文本变换。
# 判据见 examples/test_应用补丁.light（对齐上游 parse.spec.ts / apply.spec.ts 用例表）。

导出 解析补丁 应用补丁块 补丁标点归一 补丁定位序列

设 补丁语首 为 "*** Begin Patch"
设 补丁语尾 为 "*** End Patch"
设 补丁文末 为 "*** End of File"
设 补丁移动头 为 "*** Move to: "
设 补丁新增头 为 "*** Add File: "
设 补丁删除头 为 "*** Delete File: "
设 补丁更新头 为 "*** Update File: "
设 补丁环境头 为 "*** Environment ID:"
设 补丁新增头长 为 14
设 补丁删除头长 为 17
设 补丁更新头长 为 17
设 补丁移动头长 为 13

# 标点归一表（对齐上游 normalizePunctuation 四组映射）：破折号 / 单引号 / 双引号 / 各种空格
设 补丁标点表 为 {"‐": "-", "‑": "-", "‒": "-", "–": "-", "—": "-", "―": "-", "−": "-", "‘": "'", "’": "'", "‚": "'", "‛": "'", "“": "\"", "”": "\"", "„": "\"", "‟": "\"", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", " ": " ", "　": " "}

# 语法错误一律带「原始输入的一基行号」
段落 补丁报错(行号, 原因):
  抛出 新建 错误("无效补丁：第 " + 转字符串(行号) + " 行 " + 原因)

段落 补丁新块(行号):
  返回 {"行号": 行号, "锚点": 空, "旧行": [], "新行": [], "文末": 假}

# 空块：既无上下文也无增删行
段落 补丁空块(块):
  如果 列表长度(块["旧行"]) > 0:
    返回 假
  如果 列表长度(块["新行"]) > 0:
    返回 假
  返回 真

段落 补丁首字(文本):
  如果 字符串长度(文本) == 0:
    返回 ""
  返回 字符串获取(文本, 0)

# 行表：整段去首尾空白 -> CRLF 归一 -> 按行拆 -> 每行去一个残留 CR。
# 行号 = 一基 + 前置空白里的换行数（对齐上游 patchLines 的 offset 口径）。
段落 补丁行表(补丁文本):
  设 原文 为 补丁文本
  设 扫描位 为 0
  设 总长 为 字符串长度(原文)
  当 扫描位 < 总长:
    设 单字 为 字符串获取(原文, 扫描位)
    如果 是空白(单字) == 假:
      跳出
    设 扫描位 为 扫描位 + 1
  设 行偏移 为 字符串计数(截取(原文, 0, 扫描位), "\n")
  设 净文本 为 替换字符串(去除空白(原文), "\r\n", "\n")
  设 原行表 为 分割字符串(净文本, "\n")
  设 行表 为 []
  设 序 为 0
  当 序 < 列表长度(原行表):
    设 行文 为 列表获取(原行表, 序)
    如果 结尾(行文, "\r") == 真:
      设 行文 为 截取(行文, 0, 字符串长度(行文) - 1)
    列表追加(行表, {"文": 行文, "号": 行偏移 + 序 + 1})
    设 序 为 序 + 1
  返回 行表

段落 补丁校验首尾(行表):
  设 首 为 列表获取(行表, 0)
  如果 去除空白(首["文"]) != 补丁语首:
    补丁报错(首["号"], "期望 *** Begin Patch")
  设 末 为 列表获取(行表, 列表长度(行表) - 1)
  如果 去除空白(末["文"]) != 补丁语尾:
    补丁报错(末["号"], "期望 *** End Patch")
  返回 空

# heredoc 包装：首行三种字面形态 + 末行以 EOF 结尾 + 整体不少于 4 行
段落 补丁拆包装(行表):
  如果 列表长度(行表) < 4:
    返回 行表
  设 首文 为 列表获取(行表, 0)["文"]
  设 是包装 为 假
  如果 首文 == "<<EOF":
    设 是包装 为 真
  如果 首文 == "<<'EOF'":
    设 是包装 为 真
  如果 首文 == "<<\"EOF\"":
    设 是包装 为 真
  如果 是包装 == 假:
    返回 行表
  设 末文 为 列表获取(行表, 列表长度(行表) - 1)["文"]
  如果 结尾(末文, "EOF") == 假:
    返回 行表
  设 内表 为 []
  设 序 为 1
  当 序 < 列表长度(行表) - 1:
    列表追加(内表, 列表获取(行表, 序))
    设 序 为 序 + 1
  返回 内表

# 上一操作若是 Update：必须有块，末块不能为空
段落 补丁确保更新(操作, 当前行号):
  如果 操作 == 空:
    返回 空
  如果 操作["种类"] != "更新":
    返回 空
  如果 列表长度(操作["块表"]) == 0:
    补丁报错(操作["行号"], "更新 " + 操作["路径"] + " 至少需要一个补丁块")
  设 末块 为 列表获取(操作["块表"], 列表长度(操作["块表"]) - 1)
  如果 补丁空块(末块) == 真:
    补丁报错(当前行号, "更新块必须包含上下文、新增或删除行")
  返回 空

# 读 Update 体内一行：文末约束 / Move to / @@ 锚点 / *** End of File / 三种前缀行
段落 补丁读更新(操作, 行):
  设 原文 为 行["文"]
  设 文本 为 去除右侧空白(原文)
  设 块表 为 操作["块表"]
  设 前块 为 空
  如果 列表长度(块表) > 0:
    设 前块 为 列表获取(块表, 列表长度(块表) - 1)
  设 是标记 为 假
  如果 文本 == "@@":
    设 是标记 为 真
  如果 开头(文本, "@@ "):
    设 是标记 为 真
  如果 前块 != 空:
    如果 前块["文末"] == 真:
      如果 文本 == "":
        返回 空
      如果 是标记 == 假:
        补丁报错(行["号"], "在 *** End of File 之后应当出现 @@")
  如果 前块 == 空:
    如果 操作["移动至"] == 空:
      如果 开头(文本, 补丁移动头):
        操作["移动至"] 为 截取到末尾(文本, 补丁移动头长)
        返回 空
  如果 是标记 == 真:
    如果 前块 != 空:
      如果 补丁空块(前块) == 真:
        补丁报错(行["号"], "更新块必须包含上下文、新增或删除行")
    设 新块 为 补丁新块(行["号"])
    如果 开头(文本, "@@ "):
      新块["锚点"] 为 截取到末尾(文本, 3)
    列表追加(块表, 新块)
    返回 空
  如果 文本 == 补丁文末:
    如果 前块 != 空:
      如果 补丁空块(前块) == 真:
        补丁报错(行["号"], "更新块必须包含上下文、新增或删除行")
      前块["文末"] 为 真
    返回 空
  设 前缀 为 补丁首字(原文)
  如果 字符串长度(原文) > 0:
    如果 前缀 != " ":
      如果 前缀 != "+":
        如果 前缀 != "-":
          补丁报错(行["号"], "期望上下文（空格）、新增（+）、删除（-）行或 @@")
  设 块 为 前块
  如果 前块 == 空:
    设 块 为 补丁新块(行["号"])
    列表追加(块表, 块)
  设 内容 为 截取到末尾(原文, 1)
  如果 前缀 == "+":
    列表追加(块["新行"], 内容)
    返回 空
  如果 前缀 == "-":
    列表追加(块["旧行"], 内容)
    返回 空
  列表追加(块["旧行"], 内容)
  列表追加(块["新行"], 内容)
  返回 空

# 解析整段补丁：纯文本 -> 有序操作表（不读盘）
段落 解析补丁(补丁文本):
  设 行表 为 补丁拆包装(补丁行表(补丁文本))
  补丁校验首尾(行表)
  设 操作表 为 []
  设 已结束 为 假
  设 总行数 为 列表长度(行表)
  设 序 为 1
  当 序 < 总行数:
    设 行 为 列表获取(行表, 序)
    设 操作 为 空
    如果 列表长度(操作表) > 0:
      设 操作 为 列表获取(操作表, 列表长度(操作表) - 1)
    设 头 为 去除空白(行["文"])
    如果 操作 != 空:
      如果 操作["种类"] == "更新":
        如果 序 < 总行数 - 1:
          设 头 为 去除右侧空白(行["文"])
    设 要跳过 为 假
    如果 已结束 == 真:
      如果 序 < 总行数 - 1:
        如果 去除空白(行["文"]) != "":
          补丁报错(行["号"], "在 *** End Patch 之后出现多余内容")
        设 要跳过 为 真
    如果 要跳过 == 假:
      如果 头 == 补丁语尾:
        补丁确保更新(操作, 行["号"])
        设 已结束 为 真
      否则如果 开头(头, 补丁新增头):
        补丁确保更新(操作, 行["号"])
        列表追加(操作表, {"种类": "新增", "路径": 截取到末尾(头, 补丁新增头长), "行号": 行["号"], "内容": ""})
      否则如果 开头(头, 补丁删除头):
        补丁确保更新(操作, 行["号"])
        列表追加(操作表, {"种类": "删除", "路径": 截取到末尾(头, 补丁删除头长), "行号": 行["号"]})
      否则如果 开头(头, 补丁更新头):
        补丁确保更新(操作, 行["号"])
        列表追加(操作表, {"种类": "更新", "路径": 截取到末尾(头, 补丁更新头长), "行号": 行["号"], "移动至": 空, "块表": []})
      否则如果 列表长度(操作表) == 0:
        如果 开头(头, 补丁环境头):
          补丁报错(行["号"], "不支持 Environment ID 头，文件系统提供方由调用方选择")
        补丁报错(行["号"], "期望 Add File、Delete File 或 Update File 头；新增内容必须以 + 开头")
      否则如果 操作 != 空:
        如果 操作["种类"] == "新增":
          如果 开头(行["文"], "+"):
            操作["内容"] 为 操作["内容"] + 截取到末尾(行["文"], 1) + "\n"
          否则:
            补丁报错(行["号"], "期望 Add File、Delete File 或 Update File 头；新增内容必须以 + 开头")
        否则如果 操作["种类"] == "更新":
          补丁读更新(操作, 行)
        否则:
          补丁报错(行["号"], "期望 Add File、Delete File 或 Update File 头；新增内容必须以 + 开头")
      否则:
        补丁报错(行["号"], "期望 Add File、Delete File 或 Update File 头；新增内容必须以 + 开头")
    设 序 为 序 + 1
  返回 操作表

# ===== 应用：四遍规范化定位 + 逆序回放 =====

段落 补丁规范化(文本, 遍):
  如果 遍 == 0:
    返回 文本
  如果 遍 == 1:
    返回 去除右侧空白(文本)
  如果 遍 == 2:
    返回 去除空白(文本)
  返回 补丁标点归一(文本)

# 标点归一：先去首尾空白，再按表逐条全量替换
段落 补丁标点归一(文本):
  设 结果 为 去除空白(文本)
  设 键表 为 字典键列表(补丁标点表)
  遍历 键 之 键表:
    设 结果 为 替换字符串(结果, 键, 补丁标点表[键])
  返回 结果

# 四遍规范化里找首个命中；文末块只从尾部候选起找（上游 NormalizeToLf 语义）
段落 补丁定位序列(行表, 模式表, 起点, 文末):
  设 模式数 为 列表长度(模式表)
  如果 模式数 == 0:
    返回 起点
  设 行数 为 列表长度(行表)
  如果 模式数 > 行数:
    返回 -1
  设 末位 为 行数 - 模式数
  设 首位 为 起点
  如果 文末 == 真:
    设 首位 为 末位
  设 遍 为 0
  当 遍 < 4:
    设 期望表 为 []
    遍历 模式行 之 模式表:
      列表追加(期望表, 补丁规范化(模式行, 遍))
    设 位 为 首位
    当 位 <= 末位:
      设 命中 为 真
      设 偏 为 0
      当 偏 < 模式数:
        设 实文 为 补丁规范化(列表获取(行表, 位 + 偏), 遍)
        如果 实文 != 列表获取(期望表, 偏):
          设 命中 为 假
          设 偏 为 模式数
        否则:
          设 偏 为 偏 + 1
      如果 命中 == 真:
        返回 位
      设 位 为 位 + 1
    设 遍 为 遍 + 1
  返回 -1

# 一个块：可选锚点 -> 旧行序列定位（含末尾空行重试），命中则登记替换
段落 补丁应用一块(行表, 块, 游标, 替换表):
  设 锚点 为 块["锚点"]
  如果 锚点 != 空:
    设 锚模式 为 [锚点]
    设 锚位 为 补丁定位序列(行表, 锚模式, 游标, 假)
    如果 锚位 < 0:
      返回 {"失败": {"块行号": 块["行号"], "阶段": "锚点", "搜索起点": 游标, "模式": 锚模式}}
    设 游标 为 锚位 + 1
  如果 列表长度(块["旧行"]) == 0:
    设 起点 为 列表长度(行表)
    如果 起点 > 0:
      如果 列表获取(行表, 起点 - 1) == "":
        设 起点 为 起点 - 1
    列表追加(替换表, {"起点": 起点, "旧长": 0, "新行": 块["新行"]})
    返回 {"游标": 游标}
  设 模式表 为 块["旧行"]
  设 新行表 为 块["新行"]
  设 文末 为 块["文末"]
  设 命中 为 补丁定位序列(行表, 模式表, 游标, 文末)
  如果 命中 < 0:
    设 模式长 为 列表长度(模式表)
    如果 列表获取(模式表, 模式长 - 1) == "":
      设 短模式 为 []
      设 序 为 0
      当 序 < 模式长 - 1:
        列表追加(短模式, 列表获取(模式表, 序))
        设 序 为 序 + 1
      设 短新行 为 新行表
      如果 列表长度(新行表) > 0:
        如果 列表获取(新行表, 列表长度(新行表) - 1) == "":
          设 短新行 为 []
          设 序 为 0
          当 序 < 列表长度(新行表) - 1:
            列表追加(短新行, 列表获取(新行表, 序))
            设 序 为 序 + 1
      设 命中 为 补丁定位序列(行表, 短模式, 游标, 文末)
      如果 命中 >= 0:
        设 模式表 为 短模式
        设 新行表 为 短新行
  如果 命中 < 0:
    返回 {"失败": {"块行号": 块["行号"], "阶段": "旧行", "搜索起点": 游标, "模式": 块["旧行"]}}
  列表追加(替换表, {"起点": 命中, "旧长": 列表长度(模式表), "新行": 新行表})
  返回 {"游标": 命中 + 列表长度(模式表)}

# 替换表按起点稳定排序（同起点保持补丁顺序；插入排序，避免原地下标赋值）
段落 补丁排序替换(替换表):
  设 结果表 为 []
  遍历 项 之 替换表:
    设 插入位 为 列表长度(结果表)
    设 位 为 0
    当 位 < 列表长度(结果表):
      如果 插入位 == 列表长度(结果表):
        如果 列表获取(结果表, 位)["起点"] > 项["起点"]:
          设 插入位 为 位
      设 位 为 位 + 1
    列表插入(结果表, 插入位, 项)
  返回 结果表

# 主入口：文本 + 块表 -> 成功(后文本) / 失败(首个不匹配块)
段落 应用补丁块(原文本, 块表):
  设 原始行 为 分割字符串(原文本, "\n")
  如果 列表长度(原始行) > 0:
    如果 列表获取(原始行, 列表长度(原始行) - 1) == "":
      列表弹出(原始行)
  设 替换表 为 []
  设 游标 为 0
  设 失败 为 空
  遍历 块 之 块表:
    如果 失败 == 空:
      设 单果 为 补丁应用一块(原始行, 块, 游标, 替换表)
      如果 字典包含键(单果, "失败"):
        设 失败 为 单果["失败"]
      否则:
        设 游标 为 单果["游标"]
  如果 失败 != 空:
    返回 {"成功": 假, "失败": 失败}
  设 有序表 为 补丁排序替换(替换表)
  设 结果行 为 原始行
  设 序 为 列表长度(有序表) - 1
  当 序 >= 0:
    设 换 为 列表获取(有序表, 序)
    设 起点 为 换["起点"]
    设 旧长 为 换["旧长"]
    设 新段 为 换["新行"]
    设 临时 为 []
    设 甲 为 0
    当 甲 < 起点:
      列表追加(临时, 列表获取(结果行, 甲))
      设 甲 为 甲 + 1
    遍历 行 之 新段:
      列表追加(临时, 行)
    设 乙 为 起点 + 旧长
    当 乙 < 列表长度(结果行):
      列表追加(临时, 列表获取(结果行, 乙))
      设 乙 为 乙 + 1
    设 结果行 为 临时
    设 序 为 序 - 1
  如果 列表长度(结果行) == 0:
    返回 {"成功": 真, "后文本": ""}
  如果 列表获取(结果行, 列表长度(结果行) - 1) != "":
    列表追加(结果行, "")
  返回 {"成功": 真, "后文本": 连接字符串(结果行, "\n")}
