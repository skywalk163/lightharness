# 会话查询.light —— session-query 纯逻辑新层（对齐原版 packages/session-query/session-query/src）
#
# 第 5 轮任务4（缺口 #36）：上游 0.1.2→0.1.5 把 session-query 从「纯 filters」
# 扩展为完整查询子系统。本模块移植其纯逻辑新层：
#   extraction.ts    → 抽取事件文本（事件语义文本抽取）
#   documents.ts     → 构建事件记录 / 构建事件搜索文档 / 表面三分类
#   tracing.ts       → 分析事件日志 / 追踪事件 / 追踪会话（血缘与关系）
#   sources.ts       → 校验头兼容
#   corpus.ts        → 解析逻辑会话 / 解析会话语料 / 合并会话记录（纯逻辑面）
# 剔除：Cordis Service、持久化 handle seam、provider 游标、异步胶水。
# filters.ts 已在 会话查询过滤.light（本轮不动其既有段落）。
#
# 表面折叠（foldSurface）语义对齐 上游 packages/core/session/src/surface.ts：
#   表面合格类型 = system/message | user/message | assistant/message | tool/result；
#   surfaceOp 来源 = 事件 数据["表面操作"]，缺省 "append"；
#   replace 两种形态：字符串 "replace"（lightharness V3 节点0 语义，替换 surface
#     节点 0）与 字典 { "op": "replace", "startSeq": S, "endSeq": E }（上游区间语义）。
#
# V3 事件数据形状（以 会话.light/消息.light/会话格式.light 词汇表为准）：
#   user/message:   数据 = 消息（含 content 块表）
#   assistant/message: 数据 = { "消息": 消息, "流"?: 块表 }（内嵌流合并后抽取）
#   tool/call:      数据 = { "名称", "输入" }
#   tool/result:    数据 = { "调用", "成功", "消息"?, "错误"? }
#   todo/write:     数据 = { "项表" }
#   turn/end:       数据 = { "原因", "错误"? }
#   system/message: 数据 = { "系统", "表面操作"? }
#
# 光明命名：变量名避用「映射」（保留字，用 表/字典）；捕获用 e1。

从 字符串工具 导入 去除首尾空白

# ============ 抽取（对齐 extraction.ts） ============

# 连接文本：去首尾空白 + 滤空 + 换行连接
段落 连接文本 接收 部分表:
  设 结果 为 []
  遍历 部分 之 部分表:
    如果 是字符串(部分):
      设 修剪 为 去除首尾空白(部分)
      如果 修剪 != "":
        结果.追加(修剪)
    否则:
      如果 部分 != 空:
        设 修剪 为 去除首尾空白(转字符串(部分))
        如果 修剪 != "":
          结果.追加(修剪)
  返回 连接字符串(结果, "\n")

# 块文本（对齐上游 blockText）：text 贡献文本；reasoning 不贡献；
# tool-call 贡献 名称+参数；tool-result 递归其内容；未知块不贡献
段落 块文本 接收 块:
  设 种类 为 块["type"]
  如果 种类 == "text":
    返回 [块["text"]]
  如果 种类 == "reasoning":
    返回 []
  如果 种类 == "tool-call":
    设 名称 为 块["name"]
    设 参数 为 ""
    如果 字典包含键(块, "arguments"):
      设 参数 为 块["arguments"]
    返回 [名称, 参数]
  如果 种类 == "tool-result":
    设 子部分 为 []
    如果 字典包含键(块, "content") 且 是列表(块["content"]):
      遍历 子块 之 块["content"]:
        设 子文本 为 块文本(子块)
        遍历 段 之 子文本:
          子部分.追加(段)
    返回 子部分
  返回 []

# 内容文本（对齐上游 contentText）：块表 → 连接文本
段落 内容文本 接收 块表:
  设 部分 为 []
  如果 块表 == 空:
    返回 ""
  如果 是列表(块表) == 假:
    返回 ""
  遍历 块 之 块表:
    设 段表 为 块文本(块)
    遍历 段 之 段表:
      部分.追加(段)
  返回 连接文本(部分)

# 结束原因文本（对齐上游 turnEndText）
段落 结束原因文本 接收 原因, 错误:
  设 种类 为 原因
  如果 是字典(原因):
    如果 字典包含键(原因, "kind"):
      设 种类 为 原因["kind"]
    否则:
      返回 ""
  如果 种类 == "error":
    设 消息 为 ""
    如果 错误 != 空:
      如果 是字典(错误):
        如果 字典包含键(错误, "message"):
          设 消息 为 错误["message"]
        否则如果 字典包含键(错误, "消息"):
          设 消息 为 错误["消息"]
      否则:
        设 消息 为 转字符串(错误)
    返回 连接文本(["error", 消息])
  如果 种类 == "aborted":
    返回 "aborted"
  如果 种类 == "max-tokens":
    返回 "max-tokens"
  如果 种类 == "interrupted":
    返回 "interrupted"
  返回 ""

# 抽取事件语义文本：不可检索事件（结构化边界/内嵌原始流/请求信封/未知声明合并）→ ""
段落 抽取事件文本 接收 事件项:
  设 类型 为 事件项["类型"]
  设 数据 为 事件项["数据"]
  如果 类型 == "user/message":
    如果 字典包含键(数据, "content"):
      返回 内容文本(数据["content"])
    如果 字典包含键(数据, "消息"):
      设 消息 为 数据["消息"]
      如果 字典包含键(消息, "content"):
        返回 内容文本(消息["content"])
    返回 ""
  如果 类型 == "assistant/message":
    设 部分 为 []
    如果 字典包含键(数据, "消息"):
      设 消息 为 数据["消息"]
      如果 字典包含键(消息, "content"):
        设 段表 为 块文本流(消息["content"])
        遍历 段 之 段表:
          部分.追加(段)
    # 内嵌流合并后文本（对齐 会话.投影内嵌消息 的 content+流 合并）
    如果 字典包含键(数据, "流") 且 是列表(数据["流"]):
      设 流段 为 块文本流(数据["流"])
      遍历 段 之 流段:
        部分.追加(段)
    返回 连接文本(部分)
  如果 类型 == "tool/call":
    设 名称 为 ""
    如果 字典包含键(数据, "名称"):
      设 名称 为 数据["名称"]
    设 输入 为 ""
    如果 字典包含键(数据, "输入"):
      设 输入 为 数据["输入"]
    返回 连接文本([名称, 输入])
  如果 类型 == "tool/result":
    设 部分 为 []
    如果 字典包含键(数据, "消息"):
      设 消息 为 数据["消息"]
      如果 字典包含键(消息, "content"):
        设 段表 为 块文本流(消息["content"])
        遍历 段 之 段表:
          部分.追加(段)
    如果 字典包含键(数据, "错误"):
      设 错误 为 数据["错误"]
      如果 是字典(错误):
        如果 字典包含键(错误, "名称"):
          部分.追加(错误["名称"])
        否则如果 字典包含键(错误, "name"):
          部分.追加(错误["name"])
        如果 字典包含键(错误, "代码"):
          部分.追加(错误["代码"])
        否则如果 字典包含键(错误, "code"):
          部分.追加(错误["code"])
      否则:
        部分.追加(错误)
    返回 连接文本(部分)
  如果 类型 == "todo/write":
    设 部分 为 []
    如果 字典包含键(数据, "项表") 且 是列表(数据["项表"]):
      遍历 项 之 数据["项表"]:
        如果 是字典(项):
          如果 字典包含键(项, "状态"):
            部分.追加(项["状态"])
          否则如果 字典包含键(项, "status"):
            部分.追加(项["status"])
          如果 字典包含键(项, "内容"):
            部分.追加(项["内容"])
          否则如果 字典包含键(项, "content"):
            部分.追加(项["content"])
        否则:
          部分.追加(转字符串(项))
    返回 连接文本(部分)
  如果 类型 == "turn/end":
    设 错误 为 空
    如果 字典包含键(数据, "错误"):
      设 错误 为 数据["错误"]
    设 原因 为 空
    如果 字典包含键(数据, "原因"):
      设 原因 为 数据["原因"]
    返回 结束原因文本(原因, 错误)
  返回 ""

# 块表 → 段表（辅助，避免重复遍历样板）
段落 块文本流 接收 块表:
  设 部分 为 []
  如果 块表 == 空:
    返回 部分
  如果 是列表(块表) == 假:
    返回 部分
  遍历 块 之 块表:
    设 段表 为 块文本(块)
    遍历 段 之 段表:
      部分.追加(段)
  返回 部分

# ============ 表面折叠（对齐 core/session surface.ts foldSurface） ============

# 表面合格类型
段落 是表面合格 接收 类型:
  返回 类型 == "system/message" 或 类型 == "user/message" 或 类型 == "assistant/message" 或 类型 == "tool/result"

# 取事件表面操作：数据["表面操作"] 缺省 "append"
段落 表面操作取 接收 数据:
  如果 是字典(数据):
    如果 字典包含键(数据, "表面操作"):
      返回 数据["表面操作"]
  返回 "append"

# 列表取索引：返回首个等于 值 的下标，找不到返回 -1
段落 索引查找 接收 列表, 值:
  设 计数 为 0
  遍历 元素 之 列表:
    如果 元素 == 值:
      返回 计数
    设 计数 为 计数 + 1
  返回 -1

# 折叠表面：返回 { "节点表": 当前表面序号, "替换表": [{序号,开始,结束,遮蔽序号表}] }
# 序号连续性校验：事件序号须与事件表下标一致（对齐上游 planSurfaceEvent）
段落 折叠表面 接收 事件表:
  设 节点表 为 []
  设 替换表 为 []
  设 下标 为 0
  遍历 事件项 之 事件表:
    如果 事件项["序号"] != 下标:
      抛出 新建 错误("session event seq " + 转字符串(事件项["序号"]) + " is not contiguous; expected " + 转字符串(下标))
    设 类型 为 事件项["类型"]
    设 数据 为 事件项["数据"]
    如果 是表面合格(类型) == 假:
      设 下标 为 下标 + 1
      继续
    设 操作 为 表面操作取(数据)
    如果 操作 == "append":
      节点表.追加(事件项["序号"])
    否则:
      设 开始序号 为 空
      设 结束序号 为 空
      如果 是字典(操作):
        如果 字典包含键(操作, "startSeq"):
          设 开始序号 为 操作["startSeq"]
        如果 字典包含键(操作, "endSeq"):
          设 结束序号 为 操作["endSeq"]
      否则:
        # 字符串 "replace"（lightharness V3 节点0 语义）：替换 surface 节点 0
        如果 列表长度(节点表) > 0:
          设 开始序号 为 节点表[0]
          设 结束序号 为 节点表[0]
      如果 开始序号 == 空 或 结束序号 == 空:
        设 下标 为 下标 + 1
        继续
      设 起始索引 为 索引查找(节点表, 开始序号)
      设 结束索引 为 索引查找(节点表, 结束序号)
      如果 起始索引 < 0:
        抛出 新建 错误("surface replace: start seq " + 转字符串(开始序号) + " not found in surface")
      如果 结束索引 < 0:
        抛出 新建 错误("surface replace: end seq " + 转字符串(结束序号) + " not found in surface")
      如果 起始索引 > 结束索引:
        抛出 新建 错误("surface replace: start seq is after end seq")
      设 被遮蔽 为 切片(节点表, 起始索引, 结束索引)
      设 前半 为 []
      设 后半 为 []
      设 i 为 0
      当 i < 列表长度(节点表):
        如果 i < 起始索引:
          前半.追加(节点表[i])
        否则如果 i > 结束索引:
          后半.追加(节点表[i])
        设 i 为 i + 1
      设 节点表 为 []
      遍历 项 之 前半:
        节点表.追加(项)
      节点表.追加(事件项["序号"])
      遍历 项 之 后半:
        节点表.追加(项)
      替换表.追加(["序号": 事件项["序号"], "开始": 开始序号, "结束": 结束序号, "遮蔽序号表": 被遮蔽])
    设 下标 为 下标 + 1
  返回 ["节点表": 节点表, "替换表": 替换表]

# 切片（含起止的闭区间拷贝）
段落 切片 接收 列表, 起点, 终点:
  设 结果 为 []
  设 i 为 起点
  当 i <= 终点:
    结果.追加(列表[i])
    设 i 为 i + 1
  返回 结果
# ============ 事件日志分析（对齐 tracing.ts analyzeEventLog / documents.ts classifySurface） ============

# 分析事件日志：一次规范表面折叠后产出
# { "记录表", "替换表"(被遮蔽→替换), "替换事件表"(替换→遮蔽表), "当前序号表" }
段落 分析事件日志 接收 会话标识, 事件表:
  设 折叠 为 折叠表面(事件表)
  设 替换表 为 {}
  设 替换事件表 为 {}
  遍历 替换 之 折叠["替换表"]:
    字典设置(替换事件表, 替换["序号"], 替换["遮蔽序号表"])
    遍历 被遮蔽序号 之 替换["遮蔽序号表"]:
      字典设置(替换表, 被遮蔽序号, 替换["序号"])
  设 记录表 为 []
  遍历 事件项 之 事件表:
    设 序号 为 事件项["序号"]
    设 表面 为 "log-only"
    如果 列表包含(折叠["节点表"], 序号):
      设 表面 为 "current"
    否则如果 字典包含键(替换表, 序号):
      设 表面 为 "shadowed"
    记录表.追加(["会话标识": 会话标识, "序号": 序号, "类型": 事件项["类型"], "时间": 事件项["时间"], "表面": 表面])
  返回 ["记录表": 记录表, "替换表": 替换表, "替换事件表": 替换事件表, "当前序号表": 折叠["节点表"]]

# 构建事件记录（对齐 documents.ts buildSessionEventRecords）：每条事件一条 surface-aware 记录
段落 构建事件记录 接收 会话标识, 事件表:
  设 分析 为 分析事件日志(会话标识, 事件表)
  返回 分析["记录表"]

# 构建事件搜索文档（对齐 documents.ts buildSessionEventSearchDocuments）：
# 抽取文本非空的事件才成文档，附语义文本
段落 构建事件搜索文档 接收 会话标识, 事件表:
  设 分析 为 分析事件日志(会话标识, 事件表)
  设 文档表 为 []
  遍历 记录 之 分析["记录表"]:
    设 事件项 为 事件表[记录["序号"]]
    设 文本 为 抽取事件文本(事件项)
    如果 文本 != "":
      文档表.追加(["会话标识": 会话标识, "序号": 记录["序号"], "类型": 记录["类型"], "时间": 记录["时间"], "表面": 记录["表面"], "文本": 文本])
  返回 文档表

# ============ 头兼容校验（对齐 sources.ts assertSessionHeadersCompatible） ============

# 校验头兼容：六字段全等（delegationDepth 缺省 0）；任一不等抛错
# lightharness V3 头键：标识/创建时间/工作目录/父会话/种子长度；isSeeded = 种子长度非空
段落 校验头兼容 接收 甲, 乙:
  设 甲标识 为 头取字段(甲, "标识")
  设 乙标识 为 头取字段(乙, "标识")
  设 甲时间 为 头取字段(甲, "创建时间")
  设 乙时间 为 头取字段(乙, "创建时间")
  设 甲目录 为 头取字段(甲, "工作目录")
  设 乙目录 为 头取字段(乙, "工作目录")
  设 甲父 为 头取字段(甲, "父会话")
  设 乙父 为 头取字段(乙, "父会话")
  设 甲种子 为 头取字段(甲, "种子长度")
  设 乙种子 为 头取字段(乙, "种子长度")
  如果 甲标识 != 乙标识:
    抛出 新建 错误("session source headers conflict for session " + 转字符串(甲标识))
  如果 甲时间 != 乙时间:
    抛出 新建 错误("session source headers conflict for session " + 转字符串(甲标识))
  如果 甲目录 != 乙目录:
    抛出 新建 错误("session source headers conflict for session " + 转字符串(甲标识))
  如果 甲父 != 乙父:
    抛出 新建 错误("session source headers conflict for session " + 转字符串(甲标识))
  如果 头是否种子(甲) != 头是否种子(乙):
    抛出 新建 错误("session source headers conflict for session " + 转字符串(甲标识))
  返回 真

# 复制头并补 标识：lightharness 会话头信息（版本/创建时间/工作目录/父会话/种子长度）
# 不含 id（标识 在会话对象属性），语料/血缘/合并需要统一的头标识字段
段落 复制头加标识 接收 头, 标识:
  设 新头 为 {}
  遍历 键 之 字典键列表(头):
    新头[键] 为 头[键]
  新头["标识"] 为 标识
  返回 新头

# 头取字段：中英键兼容（lightharness 中文键优先，上游英文键兜底）
段落 头取字段 接收 头, 字段:
  如果 字典包含键(头, 字段):
    返回 头[字段]
  设 英文 为 "id"
  如果 字段 == "标识":
    设 英文 为 "id"
  如果 字段 == "创建时间":
    设 英文 为 "createdAt"
  如果 字段 == "工作目录":
    设 英文 为 "cwd"
  如果 字段 == "父会话":
    设 英文 为 "parentSession"
  如果 字段 == "种子长度":
    设 英文 为 "seedLength"
  如果 字典包含键(头, 英文):
    返回 头[英文]
  返回 空

# 是否种子：种子长度非空（isSeeded 语义）
段落 头是否种子 接收 头:
  设 种子 为 头取字段(头, "种子长度")
  如果 种子 == 空:
    返回 假
  如果 种子 == "":
    返回 假
  返回 真

# ============ 事件血缘追踪（对齐 tracing.ts） ============

# 追踪事件：目标记录 + 替换关系 + 替换链 + 来源/派生事件序号
段落 追踪事件 接收 会话标识, 事件表, 序号:
  设 目标 为 空
  遍历 事件项 之 事件表:
    如果 事件项["序号"] == 序号:
      设 目标 为 事件项
  如果 目标 == 空:
    抛出 新建 错误("session " + 转字符串(会话标识) + " has no event at seq " + 转字符串(序号))
  设 分析 为 分析事件日志(会话标识, 事件表)
  设 替换链 为 []
  设 当前替换 为 空
  如果 字典包含键(分析["替换表"], 序号):
    设 当前替换 为 分析["替换表"][序号]
  当 当前替换 != 空:
    替换链.追加(当前替换)
    如果 字典包含键(分析["替换表"], 当前替换):
      设 当前替换 为 分析["替换表"][当前替换]
    否则:
      设 当前替换 为 空
  设 派生 为 []
  遍历 事件项 之 事件表:
    如果 事件项["序号"] <= 序号:
      继续
    设 来源表 为 事件来源序号(事件项)
    如果 列表包含(来源表, 序号):
      派生.追加(事件项["序号"])
  设 目标记录 为 空
  遍历 记录 之 分析["记录表"]:
    如果 记录["序号"] == 序号:
      设 目标记录 为 记录
  设 结果 为 ["目标": 目标记录, "替换链": 替换链, "替换事件序号表": [], "来源事件序号表": 事件来源序号(目标), "派生事件序号表": 派生]
  如果 字典包含键(分析["替换表"], 序号):
    设 结果["被替换为"] 为 分析["替换表"][序号]
  如果 字典包含键(分析["替换事件表"], 序号):
    设 结果["替换事件序号表"] 为 分析["替换事件表"][序号]
  返回 结果

# 事件来源序号（sourceEventSeqs 中英键兼容）
段落 事件来源序号 接收 事件项:
  设 数据 为 事件项["数据"]
  如果 是字典(数据):
    如果 字典包含键(数据, "来源事件序号") 且 是列表(数据["来源事件序号"]):
      返回 数据["来源事件序号"]
    如果 字典包含键(数据, "sourceEventSeqs") 且 是列表(数据["sourceEventSeqs"]):
      返回 数据["sourceEventSeqs"]
  返回 []

# 复制会话记录（深拷贝头）
段落 复制会话记录 接收 记录:
  设 头 为 记录["头"]
  设 新头 为 {}
  遍历 键 之 字典键列表(头):
    新头[键] 为 头[键]
  设 新记录 为 ["头": 新头]
  如果 字典包含键(记录, "live"):
    新记录["live"] 为 记录["live"]
  如果 字典包含键(记录, "persisted"):
    新记录["persisted"] 为 记录["persisted"]
  返回 新记录

# 追踪会话（对齐 tracing.ts traceSession）：祖先链 + 后代树 + 循环/缺父检测
段落 追踪会话 接收 记录表, 会话标识:
  设 目标 为 空
  遍历 记录 之 记录表:
    如果 头取字段(记录["头"], "标识") == 会话标识:
      设 目标 为 记录
  如果 目标 == 空:
    抛出 新建 错误("session " + 转字符串(会话标识) + " not found")
  设 祖先 为 []
  设 已见 为 [会话标识]
  设 未解析父 为 空
  设 父标识 为 头取字段(目标["头"], "父会话")
  当 父标识 != 空:
    如果 列表包含(已见, 父标识):
      抛出 新建 错误("session lineage contains a cycle at " + 转字符串(父标识))
    已见.追加(父标识)
    设 父记录 为 空
    遍历 记录 之 记录表:
      如果 头取字段(记录["头"], "标识") == 父标识:
        设 父记录 为 记录
    如果 父记录 == 空:
      设 未解析父 为 父标识
      跳出
    祖先.追加(父记录)
    设 父标识 为 头取字段(父记录["头"], "父会话")
  # 后代分组
  设 子按父 为 {}
  遍历 记录 之 记录表:
    设 父 为 头取字段(记录["头"], "父会话")
    如果 父 == 空:
      继续
    设 子表 为 []
    如果 字典包含键(子按父, 父):
      设 子表 为 子按父[父]
    子表.追加(记录)
    字典设置(子按父, 父, 子表)
  遍历 键 之 字典键列表(子按父):
    设 子表 为 子按父[键]
    排序会话记录(子表)
    字典设置(子按父, 键, 子表)
  设 后代 为 []
  设 栈 为 [["会话标识": 会话标识, "目标表": 后代]]
  设 游标 为 0
  当 游标 < 列表长度(栈):
    设 帧 为 栈[游标]
    设 游标 为 游标 + 1
    设 节点表 为 []
    设 子 为 []
    如果 字典包含键(子按父, 帧["会话标识"]):
      设 子 为 子按父[帧["会话标识"]]
    遍历 子记录 之 子:
      设 节点 为 ["会话": 复制会话记录(子记录), "后代": []]
      节点表.追加(节点)
      帧["目标表"].追加(节点)
    设 倒序 为 列表长度(节点表) - 1
    当 倒序 >= 0:
      设 节点 为 节点表[倒序]
      栈.追加(["会话标识": 头取字段(节点["会话"]["头"], "标识"), "目标表": 节点["后代"]])
      设 倒序 为 倒序 - 1
  设 结果 为 ["目标": 复制会话记录(目标), "祖先": 祖先, "后代": 后代]
  如果 未解析父 != 空:
    结果["完整"] 为 假
    结果["未解析父"] 为 未解析父
    返回 结果
  设 根 为 目标
  如果 列表长度(祖先) > 0:
    设 根 为 祖先[列表长度(祖先) - 1]
  结果["完整"] 为 真
  结果["根"] 为 复制会话记录(根)
  返回 结果

# 排序会话记录：createdAt 降序 || id 升序（对齐 compareSessions）
段落 排序会话记录 接收 记录表:
  设 n 为 列表长度(记录表)
  设 i 为 1
  当 i < n:
    设 当前 为 记录表[i]
    设 j 为 i - 1
    当 j >= 0:
      设 甲 为 记录表[j]
      如果 会话比较(甲, 当前) <= 0:
        跳出
      设 记录表[j + 1] 为 甲
      设 j 为 j - 1
    设 记录表[j + 1] 为 当前
    设 i 为 i + 1

# 会话记录比较：createdAt 降序；相等时 id 升序
段落 会话比较 接收 甲, 乙:
  设 甲时间 为 头取字段(甲["头"], "创建时间")
  设 乙时间 为 头取字段(乙["头"], "创建时间")
  如果 甲时间 < 乙时间:
    返回 1
  如果 甲时间 > 乙时间:
    返回 -1
  设 甲标识 为 头取字段(甲["头"], "标识")
  设 乙标识 为 头取字段(乙["头"], "标识")
  如果 甲标识 < 乙标识:
    返回 -1
  如果 甲标识 > 乙标识:
    返回 1
  返回 0

# ============ 逻辑语料（对齐 corpus.ts 纯逻辑面） ============

# 解析逻辑会话：头 + 继承事件数 + 事件表（来自 会话对象 的投影，剔除持久化 seam）
段落 解析逻辑会话 接收 会话对象:
  设 头 为 复制头加标识(会话对象.头信息, 会话对象.标识)
  设 事件表 为 会话对象.汇集全部事件()
  设 继承数 为 0
  如果 字典包含键(头, "继承事件数"):
    设 继承数 为 头["继承事件数"]
  返回 ["头": 头, "继承事件数": 继承数, "事件表": 事件表]

# 解析会话语料：记录表 → 按 id 索引并排序（createdAt 降序 || id）
段落 解析会话语料 接收 记录表:
  设 结果 为 []
  遍历 记录 之 记录表:
    结果.追加(复制会话记录(记录))
  排序会话记录(结果)
  返回 结果

# 合并会话记录（对齐 corpus.ts listSessions 纯逻辑面）：
# 持久表先入（live=false），存活表覆盖（live=true）并在同 id 时校验头兼容；
# 返回 { "头", "live", "persisted" } 列表，按 比较会话 排序
段落 合并会话记录 接收 存活表, 持久表:
  设 结果 为 []
  遍历 头 之 持久表:
    结果.追加(["头": 头, "live": 假, "persisted": 真])
  遍历 会话 之 存活表:
    设 头 为 复制头加标识(会话.头信息, 会话.标识)
    设 已有 为 空
    遍历 记录 之 结果:
      如果 头取字段(记录["头"], "标识") == 头取字段(头, "标识"):
        设 已有 为 记录
    如果 已有 != 空:
      校验头兼容(头, 已有["头"])
      已有["live"] 为 真
    否则:
      结果.追加(["头": 头, "live": 真, "persisted": 假])
  排序会话记录(结果)
  返回 结果
