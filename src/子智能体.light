# 0.1.5 复刻增量（第 4 轮 · 路 4 · subagent 1.5）
# 上游只读依据：
#   - packages/util/chunked-list/src/index.ts（9f69a7fb16 抽出的持久分块列表）
#   - packages/subagent/subagent/src/catalog.ts（2db4bdd31d 父属目录事件、
#     80e34ce709 事件序列出、532e712c7b 经投影视图暴露、
#     661135fe29 非法目录拒绝、ba731d1c9e 目录失败后的被拒运行）
#   - packages/subagent/subagent/src/{inbox,control-types,control}.ts +
#     index.ts catalogView（96ead6091d #3223 human inbox controls）
#   - continuation.ts 重构（96ead6091d 拆出 continuation-activation /
#     continuation-messages / inbox）仅压缩实现不改语义 → 仅核对
# =====================================================================

# ---- 分块列表：持久化追加列表（chunked-list 1:1）----
# 节点 = ["值表": [...], "前块": 节点或无]；空列表 = 空。块容量 64，
# 追加至多复制一个头块；展平按插入序（老→新）访问，保留事件顺序。

# 分块容量常量（上游 CHUNK_CAPACITY = 64，由本工具自有）
段落 分块容量:
  返回 64

# 追加而不修改输入：块满（=64）或空表则开新块，否则复制头块
段落 追加分块(头块, 值):
  如果 头块 == 空:
    返回 ["值表": [值]]
  如果 长度(头块["值表"]) >= 64:
    返回 ["值表": [值], "前块": 头块]
  设 新值表 为 []
  遍历 旧值 之 头块["值表"]:
    新值表.追加(旧值)
  新值表.追加(值)
  设 节点 为 ["值表": 新值表]
  如果 头块.包含("前块"):
    节点["前块"] 为 头块["前块"]
  返回 节点

# 按插入序展平（老块 → 新块），对齐 iterateChunkedList
段落 分块展平(头块):
  设 块栈 为 []
  设 当前 为 头块
  当 当前 不等于 空:
    块栈.追加(当前)
    如果 当前.包含("前块"):
      设 当前 为 当前["前块"]
    否则:
      设 当前 为 空
  设 结果 为 []
  设 序 为 长度(块栈) - 1
  当 序 >= 0:
    遍历 值 之 块栈[序]["值表"]:
      结果.追加(值)
    设 序 为 序 - 1
  返回 结果

# 检查点校验：每个块 1..64 个值、仅「值表/前块」键、递归校验前块。
# 空列表（头块=空）合法；越界块/未知字段一律拒绝（对齐 chunkedListSchema strict，
# 值表 min(1)/max(64)）。
段落 校验分块(头块):
  如果 头块 == 空:
    返回 空
  如果 是字典(头块) == 假:
    抛出 "非法分块列表: 节点不是字典"
  遍历 键 之 字典键列表(头块):
    如果 (键 == "值表") == 假 且 (键 == "前块") == 假:
      抛出 "非法分块列表: 未知字段 " 加上 键
  如果 头块.包含("值表") == 假:
    抛出 "非法分块列表: 缺值表"
  如果 是列表(头块["值表"]) == 假:
    抛出 "非法分块列表: 值表不是列表"
  设 个数 为 长度(头块["值表"])
  如果 个数 < 1 或 个数 > 64:
    抛出 "非法分块列表: 块容量越界 " 加上 转字符串(个数)
  如果 头块.包含("前块"):
    校验分块(头块["前块"])


# ---- 父属目录：subagent/catalog 事件（父会话日志为直系子发现的持久权威）----
# 事实数据 = { 版本:0, 子标识, 子创建时间, 模式, 标签? }；
# one-shot 标签可选，continuable 必带标签；只发布成功事实。

# 建立目录子项：把一份完整直系子发现事实追加到父会话
# R87（上游 catalog.ts 877717787c）：载荷版本升 union[0,1]；v1 新增 unknown 模式
# （语料枚举到的未知模式子项，标签可选）。unknown 事实只能以版本 1 落库。
段落 建立目录子项(父会话, 子标识, 子创建时间, 模式, 标签):
  设 载荷版本 为 0
  如果 模式 == "unknown":
    设 载荷版本 为 1
  设 数据 为 ["版本": 载荷版本, "子标识": 子标识, "子创建时间": 子创建时间, "模式": 模式]
  如果 模式 == "continuable":
    如果 标签 == 空 或 标签 == "":
      抛出 "非法目录事实: continuable 子项必须携带标签"
    数据["标签"] 为 标签
  否则如果 模式 == "one-shot":
    如果 标签 不等于 空 且 标签 != "":
      数据["标签"] 为 标签
  否则如果 模式 == "unknown":
    如果 标签 不等于 空 且 标签 != "":
      数据["标签"] 为 标签
  否则:
    抛出 "非法目录事实: 未知模式 " 加上 转字符串(模式)
  返回 父会话.记录事件("subagent/catalog", 数据)

# 严格校验一份目录事实：未知字段/缺失字段/不支持的版本一律抛错
# （非法自有事实拒绝投影恢复——静默丢弃必选事实会得到不完整目录）
段落 校验目录数据(数据):
  如果 是字典(数据) == 假:
    抛出 "非法目录事件: 数据不是字典"
  设 允许 为 ["版本": 真, "子标识": 真, "子创建时间": 真, "模式": 真, "标签": 真]
  遍历 键 之 字典键列表(数据):
    如果 允许.包含(键) == 假:
      抛出 "非法目录事件: 未知字段 " 加上 键
  如果 数据.包含("版本") == 假:
    抛出 "非法目录事件: 缺版本"
  如果 数据["版本"] != 0 且 数据["版本"] != 1:
    抛出 "非法目录事件: 不支持的目录事件版本 " 加上 转字符串(数据["版本"])
  如果 数据.包含("子标识") == 假:
    抛出 "非法目录事件: 缺子标识"
  如果 是字符串(数据["子标识"]) == 假 或 数据["子标识"] == "":
    抛出 "非法目录事件: 子标识必须为非空字符串"
  如果 数据.包含("子创建时间") == 假:
    抛出 "非法目录事件: 缺子创建时间"
  设 创建时刻 为 数据["子创建时间"]
  如果 (是整数(创建时刻) 或 是浮点(创建时刻)) == 假 或 创建时刻 < 0:
    抛出 "非法目录事件: 子创建时间必须为非负数"
  如果 数据.包含("模式") == 假:
    抛出 "非法目录事件: 缺模式"
  如果 数据["模式"] == "continuable":
    如果 数据.包含("标签") == 假 或 是字符串(数据["标签"]) == 假 或 数据["标签"] == "":
      抛出 "非法目录事件: continuable 事实必须携带非空标签"
  否则如果 数据["模式"] == "one-shot":
    如果 数据.包含("标签") 且 (是字符串(数据["标签"]) == 假 或 数据["标签"] == ""):
      抛出 "非法目录事件: one-shot 标签若存在必须为非空字符串"
  否则如果 数据["模式"] == "unknown":
    # R87：unknown 仅 v1 语料枚举事实；标签可选，存在则须非空串
    如果 数据["版本"] != 1:
      抛出 "非法目录事件: unknown 模式事实必须为版本 1"
    如果 数据.包含("标签") 且 (是字符串(数据["标签"]) == 假 或 数据["标签"] == ""):
      抛出 "非法目录事件: unknown 标签若存在必须为非空字符串"
  否则:
    抛出 "非法目录事件: 未知模式 " 加上 转字符串(数据["模式"])

# 目录投影阶段版本（上游 subagentCatalogProjectionDefinition.stateVersion）
# R87：2 → 3（v1 载荷 / unknown 模式进入折痕，属不兼容的状态面变更）
段落 目录阶段版本:
  返回 3

# 父属目录投影：折叠 subagent/catalog 事件为分块列表状态
# 继承序号以下的事实被忽略（fork 隔离：种子副本不继承原会话的子目录）
类 目录投影:
  属性 继承序号 等于 0
  属性 头块 等于 空

  段落 构造(继承序号):
    设 己.继承序号 为 继承序号
    设 己.头块 为 空

  # 折叠一条会话事件；非目录事件或继承前缀内的事件原样跳过
  段落 应用事件(事件项):
    如果 事件项["类型"] != "subagent/catalog":
      返回 己
    如果 事件项["序号"] < 己.继承序号:
      返回 己
    校验目录数据(事件项["数据"])
    设 己.头块 为 追加分块(己.头块, 事件项["数据"])
    返回 己

  # 物化直系子行表：严格按父目录事件顺序（老 → 新），与子创建时间无关
  # R87（上游 catalog.ts subagentCatalogEntries）：行分支谓词由
  # `mode === 'one-shot'` 改为 `mode !== 'continuable'` —— 即 one-shot 与
  # unknown（v1）都落一行式行（标签可选）；仅 continuable 落标签必在行。
  # （校验已保证 continuable 事实必带标签，故此处标签随事实有无自然成立。）
  段落 条目:
    设 行表 为 []
    遍历 事实 之 分块展平(己.头块):
      设 行 为 ["标识": 事实["子标识"], "创建时间": 事实["子创建时间"], "模式": 事实["模式"]]
      如果 事实.包含("标签"):
        行["标签"] 为 事实["标签"]
      行表.追加(行)
    返回 行表

  # 检查点校验（stateSchema 的检查点面）
  段落 校验状态:
    如果 己.头块 不等于 空:
      校验分块(己.头块)

# 从会话事件表重建父属目录（投影恢复入口）
段落 重建父属目录(事件表, 继承序号):
  设 投影 为 新建 目录投影(继承序号)
  遍历 事件项 之 事件表:
    投影.应用事件(事件项)
  返回 投影

# ---- 目录视图（对齐 control.ts catalogView：经既有投影视图暴露）----
# 每行活动由运行中 Agent 状态覆盖：运行中 → "running"，否则 "inactive"；
# 父可用仅为提示，权威检查在提示投递时进行。
段落 目录视图(条目表, 运行表, 父可用):
  设 行表 为 []
  遍历 条目 之 条目表:
    设 行 为 ["标识": 条目["标识"], "创建时间": 条目["创建时间"], "模式": 条目["模式"], "活动": "inactive"]
    如果 条目.包含("标签"):
      行["标签"] 为 条目["标签"]
    如果 运行表 不等于 空:
      遍历 运行标识 之 运行表:
        如果 运行标识 == 条目["标识"]:
          行["活动"] 为 "running"
    行表.追加(行)
  返回 ["条目表": 行表, "父可用": 父可用]


# ---- 子智能体收件箱（对齐 inbox.ts SubagentInbox：激活期人类投递准入）----
# 上游把 queue/steer 委派给 Agent 收件箱（nextTurn/nextStep）。lightharness 的
# 代理循环暂无收件箱原语（属路 3 辖区，移交清单登记），本类先自有两个投递
# 目的地：queue → 下一轮表（后续轮次），steer → 下一步表（最近步骤）。
# 语义对齐：关闭截止后拒绝投递（ACTIVATION_CLOSING，消息不被接受）、
# 待处理保留、关闭幂等（释放操作仅启动一次并记忆结果）。
类 子智能体收件箱:
  属性 智能体名字 等于 ""
  属性 下一轮表 等于 空
  属性 下一步表 等于 空
  属性 关闭中 等于 假
  属性 释放结果 等于 空

  段落 构造(智能体名字):
    设 己.智能体名字 为 智能体名字
    设 己.下一轮表 为 []
    设 己.下一步表 为 []

  # 收件箱目的地是否非空（对齐 hasPending：两个目的地任一非空即有待处理）
  段落 是否待处理:
    返回 (长度(己.下一轮表) > 0) 或 (长度(己.下一步表) > 0)

  # 投递一条已接受输入：queue 排入后续轮次，steer 定向最近步骤
  段落 投递(消息, 投递方式):
    如果 (投递方式 == "queue") == 假 且 (投递方式 == "steer") == 假:
      抛出 "非法投递方式: " 加上 转字符串(投递方式)
    如果 己.关闭中:
      抛出 "ACTIVATION_CLOSING: subagent \"" 加上 己.智能体名字 加上 "\" activation is being disposed; the message was not accepted"
    如果 投递方式 == "steer":
      己.下一步表.追加(消息)
    否则:
      己.下一轮表.追加(消息)

  # 驱动方认领：从队首取走一条（先进先出，对齐 Agent 收件箱 nextTurn 语义）
  段落 认领下一轮:
    如果 长度(己.下一轮表) == 0:
      返回 空
    设 首条 为 己.下一轮表[0]
    设 余表 为 []
    设 序 为 1
    当 序 < 长度(己.下一轮表):
      余表.追加(己.下一轮表[序])
      设 序 为 序 + 1
    设 己.下一轮表 为 余表
    返回 首条

  # 关闭投递准入并记忆释放结果：重复关闭返回既有结果，不再启动释放
  段落 关闭(释放函数):
    如果 己.关闭中:
      返回 己.释放结果
    设 己.关闭中 为 真
    设 己.释放结果 为 释放函数()
    返回 己.释放结果

  # 人类提示请求校验（对齐 control.ts 'subagent.prompt' 模式面）：
  # mode 必须为 continuable（one-shot 子项保持只读），投递方式仅 queue/steer
  段落 校验提示请求(请求):
    如果 是字典(请求) == 假:
      抛出 "无效提示请求: 请求不是字典"
    如果 请求.包含("父会话标识") == 假 或 请求.包含("子会话标识") == 假:
      抛出 "无效提示请求: 缺会话标识"
    如果 请求.包含("模式") == 假 或 请求["模式"] != "continuable":
      抛出 "无效提示请求: 模式必须为 continuable（one-shot 子智能体只读）"
    如果 请求.包含("投递方式") == 假:
      抛出 "无效提示请求: 缺投递方式"
    如果 (请求["投递方式"] == "queue" 或 请求["投递方式"] == "steer") == 假:
      抛出 "无效提示请求: 投递方式必须为 queue/steer"

# =====================================================================
# R87 增量（B3 第2组 · subagent 编排面）
# 上游只读依据（877717787c）：
#   - packages/subagent/subagent/src/archive-admission.ts
#       runningDescendants：按 session.header.parentSession + origin=='subagent'
#       的 BFS，任何深度的运行中后代；fork 有父系字段无出处 → 不入谱
#   - packages/subagent/subagent/src/control-types.ts
#       SubagentCatalogRow（完整后代行）/ SubagentAddress 模式新增 'unknown'
# =====================================================================

# 运行中后代：从根会话出发，沿 parentSession 谱系做 BFS，收集所有
# origin == 'subagent' 且 status == 'running' 的后代（任意深度）。
# 代理表每项 = {"标识":id, "父会话":父id或空, "出处":origin, "状态":running|...}
# 纯数据遍历：损坏的父链成环时，已访集合保证只访问一次（对齐上游 visited）。
段落 运行中后代(代理表, 根标识):
  设 子谱 为 {}
  遍历 代理 之 代理表:
    如果 是字典(代理):
      如果 代理.包含("父会话") 且 代理["父会话"] != 空 且 代理.包含("出处") 且 代理["出处"] == "subagent":
        设 父 为 代理["父会话"]
        如果 字典包含键(子谱, 父) == 假:
          子谱[父] 为 []
        子谱[父].追加(代理)
  设 运行表 为 []
  设 待访 为 [根标识]
  设 已访 为 {}
  设 序 为 0
  当 序 < 长度(待访):
    设 当前 为 待访[序]
    设 序 为 序 + 1
    如果 已访.包含(当前) == 假:
      已访[当前] 为 真
      设 子表 为 []
      如果 字典包含键(子谱, 当前):
        设 子表 为 子谱[当前]
      遍历 子 之 子表:
        如果 子.包含("状态") 且 子["状态"] == "running":
          如果 子.包含("标识"):
            运行表.追加(子["标识"])
        如果 子.包含("标识"):
          待访.追加(子["标识"])
  返回 运行表

# 完整后代行（对齐 control-types.ts SubagentCatalogRow）：
# 标识 + 活动(running/inactive) + 模式(one-shot|continuable|unknown) + 可选标签
段落 造后代行(标识, 活动, 模式, 标签):
  设 行 为 ["标识": 标识, "活动": 活动, "模式": 模式]
  如果 标签 != 空 且 标签 != "":
    行["标签"] 为 标签
  返回 行

# 持久父子浏览地址（对齐 control-types.ts SubagentAddress）：
# 父/子会话标识 + 模式；R87 起模式集扩为 one-shot | continuable | unknown
# （unknown 在读取子项历史时再裁决为具体模式）
段落 校验浏览地址(地址):
  如果 是字典(地址) == 假:
    抛出 "无效浏览地址: 地址不是字典"
  如果 地址.包含("父会话标识") == 假 或 是字符串(地址["父会话标识"]) == 假 或 地址["父会话标识"] == "":
    抛出 "无效浏览地址: 缺合法父会话标识"
  如果 地址.包含("子会话标识") == 假 或 是字符串(地址["子会话标识"]) == 假 或 地址["子会话标识"] == "":
    抛出 "无效浏览地址: 缺合法子会话标识"
  如果 地址.包含("模式") == 假:
    抛出 "无效浏览地址: 缺模式"
  如果 地址["模式"] != "one-shot" 且 地址["模式"] != "continuable" 且 地址["模式"] != "unknown":
    抛出 "无效浏览地址: 模式必须为 one-shot/continuable/unknown"
  返回 真
