# 语言服务器.light —— 语言服务器纯逻辑核心（任务卡 M，编号 63）
# 对齐原版：packages/lsp/lsp/src/index.ts（finalExtension / registerProvider / query，L52-149）
#          + packages/lsp/tool-lsp/src/render.ts（parseLspArgs / formatLocations /
#            formatHover / renderUri，L39-164）
#
# 纯逻辑口径：剔除 Cordis Service / ctx.effect 生命周期、异步 signal 与真实 IO——
#   注册提供方返回的释放函数为同步纯函数，直接改成员表（原版 ctx.effect 的同步等价）；
#   查询只做路由选择并调用入参提供方的 "查询" 函数（派发以入参投影，不依赖真实 LSP 服务）；
#   资源标识转换的 URL 解析 / fileURLToPath / win32.relative / posix.relative 全部以字符串
#   等价复刻（2026-09-02 探针 _probe_m63i.mjs 与 Node 原生逐条对拍 FAIL_COUNT=0），
#   无任何网络 / 子进程 / 文件 IO；真实 fs 校验以规范化后的入参字符串代替。
#
# 命名（避 工具/类型/匹配 词根）：provider→提供方；location→坐标；URI→资源标识；
#   hover→悬停；operation→操作；extension→扩展名。原版英文键（id/extensionToLanguage/
#   languageId/filePath/range/start/line/character/uri/contents...）作为字符串字面量保留在
#   入参/出参，不做中文改名。
# 成员赋值一律 设 己.X 为 …；字面量一律单行；布尔链不带行内 否则 返回；捕获变量用单字 e。

导出 提取最终扩展名 规范化扩展名 判定扩展名合法 判定操作合法 解析定位 格式化坐标 格式化悬停 渲染资源标识 造语言服务器。

从 正则表达式 导入 是否匹配, 匹配开头, 分组匹配
从 字符串工具 导入 去除首尾空白

# 四种可查询操作（LSP_OPERATIONS）
设 操作表 为 ["goToDefinition", "findReferences", "goToImplementation", "hover"]

# ===========================================================
# 1) 扩展名提取与规范化（index.ts L60-67 / L153-156）
# ===========================================================
# 提取最终扩展名：取路径末段最后一个点后的全部字符，转小写（Foo.TS → .ts，
# foo.d.ts → .ts；无扩展名或点文件 .bashrc → ""）。同时按 / 与 \ 切分。
段落 提取最终扩展名 接收 路径:
  设 斜 为 最后索引(路径, "/")
  设 反 为 最后索引(路径, "\\")
  设 大 为 斜
  如果 反 > 大:
    设 大 为 反
  设 基 为 路径
  如果 大 >= 0:
    设 基 为 截取(路径, 大 + 1, 字符串长度(路径))
  设 点 为 最后索引(基, ".")
  # 点 <= 0 同时覆盖「无点」（-1）与「点文件」（0）：两者都没有扩展名
  如果 点 <= 0:
    返回 ""
  设 名 为 截取(基, 点, 字符串长度(基))
  返回 转小写(名)

# 规范化扩展名：转小写并保证带前导点；EXTENSION_PATTERN 拒绝其余形状
段落 规范化扩展名 接收 扩展:
  设 低 为 转小写(扩展)
  如果 开头(低, "."):
    返回 低
  返回 "." + 低

# 判定扩展名合法：一个点后跟一个或多个非点、非分隔符字符
段落 判定扩展名合法 接收 扩展:
  返回 是否匹配("^\\.[^./\\\\]+$", 扩展)

# ===========================================================
# 2) 提供方注册校验 / 冲突检查 / 路由选择（index.ts L82-149）
# ===========================================================
# 语言服务器注册表：id 预留集 + 扩展名→路由表；二者同步写入/清除。
类 语言服务器:
  属性 提供方标识集 等于 空
  属性 路由表 等于 空

  段落 构造:
    设 己.提供方标识集 为 {}
    设 己.路由表 为 {}

  # 注册提供方：校验与冲突检查全部先于任何变更（all-or-nothing）；
  # 返回同步释放函数，同时收回 id 预留与全部扩展名路由。
  段落 注册提供方 接收 提供方:
    设 标识 为 取可选(提供方, "id")
    如果 是字符串(标识) == 假 或 去除首尾空白(标识) == "":
      抛出 新建 错误("语言服务器提供方 id 必须为非空字符串")
    如果 字典包含键(己.提供方标识集, 标识) == 真:
      抛出 新建 错误("语言服务器提供方已注册: " + 标识)
    设 映照 为 取可选(提供方, "extensionToLanguage")
    如果 是字典(映照) == 假:
      抛出 新建 错误("语言服务器提供方缺 extensionToLanguage: " + 标识)
    设 键集 为 字典键列表(映照)
    如果 列表长度(键集) == 0:
      抛出 新建 错误("语言服务器提供方未注册任何扩展名: " + 标识)
    设 待定 为 {}
    遍历 原始 之 键集:
      设 语言标识 为 映照[原始]
      设 扩展 为 规范化扩展名(原始)
      如果 判定扩展名合法(扩展) == 假:
        抛出 新建 错误("语言服务器提供方映射非法扩展名: " + 转字符串(原始))
      如果 是字符串(语言标识) == 假 或 去除首尾空白(语言标识) == "":
        抛出 新建 错误("语言服务器提供方扩展名映射空语言标识: " + 扩展)
      # 提供方内部规范化去重（.TS 与 .ts 视为同一扩展）
      如果 字典包含键(待定, 扩展) == 真:
        抛出 新建 错误("语言服务器提供方重复映射扩展名: " + 扩展)
      设 待定[扩展] 为 { "提供方": 提供方, "语言标识": 语言标识 }
    # 跨提供方扩展名冲突检查
    遍历 扩展 之 字典键列表(待定):
      如果 字典包含键(己.路由表, 扩展) == 真:
        抛出 新建 错误("扩展名已被其他语言服务器提供方处理: " + 扩展)
    # 全部检查通过：一次性预留 id 与所有扩展名
    设 己.提供方标识集[标识] 为 真
    设 扩展表 为 字典键列表(待定)
    遍历 扩展 之 扩展表:
      设 己.路由表[扩展] 为 待定[扩展]
    段落 释放:
      字典删除(己.提供方标识集, 标识)
      遍历 键 之 扩展表:
        字典删除(己.路由表, 键)
    返回 释放

  # 查询：按文件最终扩展名选路由，无路由抛错；否则补 languageId 后委托提供方查询。
  段落 查询 接收 请求:
    设 扩展 为 提取最终扩展名(请求["filePath"])
    设 路由 为 取可选(己.路由表, 扩展)
    如果 路由 == 空:
      抛出 新建 错误("无语言服务器提供方处理: " + 请求["filePath"])
    设 增强 为 构造查询请求(请求, 路由["语言标识"])
    返回 路由["提供方"]["查询"](增强)

# 复制请求字典并补 languageId（对应原版 { ...request, languageId }）
段落 构造查询请求 接收 请求, 语言:
  设 新请求 为 {}
  遍历 键 之 字典键列表(请求):
    设 新请求[键] 为 请求[键]
  设 新请求["languageId"] 为 语言
  返回 新请求

# 构造语言服务器实例
段落 造语言服务器:
  返回 新建 语言服务器()

# ===========================================================
# 3) 参数校验与坐标转换（render.ts L39-72）
# ===========================================================
# 判定操作合法：是否四种操作之一
段落 判定操作合法 接收 值:
  遍历 项 之 操作表:
    如果 项 == 值:
      返回 真
  返回 假

# 校验一基坐标：必须是正整数（一基），否则抛错
段落 校验一基坐标 接收 值, 名:
  如果 是整数(值) == 假:
    抛出 新建 错误(名 + " 必须为正整数（一基）")
  如果 值 < 1:
    抛出 新建 错误(名 + " 必须为正整数（一基）")
  返回 值

# 解析定位：校验操作/文件路径/一基坐标，转零基 position
段落 解析定位 接收 参:
  如果 判定操作合法(参["operation"]) == 假:
    抛出 新建 错误("operation 必须是 " + 连接字符串(操作表, ", ") + " 之一")
  设 路径 为 参["file_path"]
  如果 是字符串(路径) == 假 或 去除首尾空白(路径) == "":
    抛出 新建 错误("file_path 必须为非空字符串")
  设 行 为 校验一基坐标(参["line"], "line")
  设 纵 为 校验一基坐标(参["character"], "character")
  返回 { "operation": 参["operation"], "filePath": 路径, "position": { "line": 行 - 1, "character": 纵 - 1 } }

# ===========================================================
# 4) 结果展示格式化（render.ts L74-128）
# ===========================================================
# 限制结果：完整渲染文本（含截断通知本身）不超过最大字符数
段落 限制结果 接收 文本, 最大字符数, 标签:
  如果 字符串长度(文本) <= 最大字符数:
    返回 文本
  设 通知 为 "\n… " + 标签 + " truncated (limit " + 转字符串(最大字符数) + " characters)."
  如果 字符串长度(通知) >= 最大字符数:
    返回 截取(通知, 0, 最大字符数)
  设 保留 为 最大字符数 - 字符串长度(通知)
  返回 截取(文本, 0, 保留) + 通知

# 格式化坐标：按文件分组渲染 path:line:character（零基转一基），
# 工作区内 file: 资源标识转相对路径；超量省略标记；最后整体截断。
段落 格式化坐标 接收 坐标集, 工作区资源标识, 最大坐标数, 最大字符数:
  如果 列表长度(坐标集) == 0:
    返回 限制结果("No results.", 最大字符数, "locations")
  设 展示 为 列表截取(坐标集, 0, 最大坐标数)
  设 省略数 为 列表长度(坐标集) - 列表长度(展示)
  设 分组 为 {}
  遍历 坐标 之 展示:
    设 路径 为 渲染资源标识(坐标["uri"], 工作区资源标识)
    设 行 为 坐标["range"]["start"]["line"] + 1
    设 纵 为 坐标["range"]["start"]["character"] + 1
    设 已有 为 取可选(分组, 路径)
    如果 已有 == 空:
      设 已有 为 []
      设 分组[路径] 为 已有
    列表追加(已有, 路径 + ":" + 转字符串(行) + ":" + 转字符串(纵))
  设 行表 为 []
  遍历 键 之 字典键列表(分组):
    设 项表 为 分组[键]
    遍历 项 之 项表:
      列表追加(行表, 项)
  如果 省略数 > 0:
    设 复数 为 ""
    如果 省略数 != 1:
      设 复数 为 "s"
    列表追加(行表, "… " + 转字符串(省略数) + " more location" + 复数 + " omitted (limit " + 转字符串(最大坐标数) + ").")
  返回 限制结果(连接字符串(行表, "\n"), 最大字符数, "locations")

# 格式化悬停：空悬停输出专行，否则输出 contents，最后整体截断
段落 格式化悬停 接收 悬停, 最大字符数:
  设 文本 为 "No hover information."
  如果 悬停 != 空:
    设 文本 为 悬停["contents"]
  返回 限制结果(文本, 最大字符数, "hover")

# 列表截取：取表[起:止]（越界截断），返回新表
段落 列表截取 接收 表, 起, 止:
  设 新 为 []
  设 n 为 列表长度(表)
  设 实止 为 止
  如果 实止 > n:
    设 实止 为 n
  设 i 为 起
  当 i < 实止:
    列表追加(新, 列表获取(表, i))
    设 i 为 i + 1
  返回 新

# ===========================================================
# 5) 资源标识转换（render.ts L130-175，纯字符串等价复刻）
# ===========================================================
# 判定字母：A-Z / a-z
段落 判定字母 接收 字符:
  如果 字符 >= "a" 且 字符 <= "z":
    返回 真
  如果 字符 >= "A" 且 字符 <= "Z":
    返回 真
  返回 假

# 判定十六进制字符：0-9 a-f A-F
段落 判定十六进制字符 接收 字符:
  如果 字符 >= "0" 且 字符 <= "9":
    返回 真
  如果 字符 >= "a" 且 字符 <= "f":
    返回 真
  如果 字符 >= "A" 且 字符 <= "F":
    返回 真
  返回 假

# 判定十六进制对：恰好两个十六进制字符
段落 判定十六进制对 接收 块:
  如果 字符串长度(块) != 2:
    返回 假
  如果 判定十六进制字符(字符串获取(块, 0)) == 假:
    返回 假
  返回 判定十六进制字符(字符串获取(块, 1))

# 十六进制位值：单个十六进制字符 → 0-15（判定十六进制对已保证合法）
段落 十六位值 接收 字符:
  如果 字符 >= "0" 且 字符 <= "9":
    返回 ord(字符) - 48
  如果 字符 >= "a" 且 字符 <= "f":
    返回 ord(字符) - 87
  返回 ord(字符) - 55

# 十六进制对 → 整数（0-255，绕开光明「整数」无基数参数的限制）
段落 十六到整数 接收 十六:
  设 高 为 十六位值(字符串获取(十六, 0))
  设 低 为 十六位值(字符串获取(十六, 1))
  返回 高 * 16 + 低

# 解码百分：%XX → 对应码点字符；非法转义抛错
段落 解码百分 接收 块:
  设 n 为 字符串长度(块)
  设 成品 为 ""
  设 i 为 0
  当 i < n:
    设 字符 为 字符串获取(块, i)
    如果 字符 == "%":
      设 十六 为 截取(块, i + 1, i + 3)
      如果 判定十六进制对(十六) == 假:
        抛出 新建 错误("bad escape")
      设 码 为 十六到整数(十六)
      设 成品 为 成品 + chr(码)
      设 i 为 i + 3
      跳过
    设 成品 为 成品 + 字符
    设 i 为 i + 1
  返回 成品

# 判定分隔位置：首个 / ? # 的索引，无则 -1
段落 判定分隔位置 接收 文本:
  设 n 为 字符串长度(文本)
  设 i 为 0
  当 i < n:
    设 字符 为 字符串获取(文本, i)
    如果 字符 == "/" 或 字符 == "?" 或 字符 == "#":
      返回 i
    设 i 为 i + 1
  返回 -1

# 解析文件：等价 Node URL 解析（file: 子集），返回 { 协议, 主机, 路径名 } 或 空
段落 解析文件 接收 原文:
  设 冒 为 查找子串(原文, ":")
  如果 冒 < 0:
    返回 空
  设 方案 为 截取(原文, 0, 冒 + 1)
  设 余下 为 截取(原文, 冒 + 1, 字符串长度(原文))
  设 主机 为 ""
  设 路径名 为 ""
  如果 开头(余下, "//"):
    设 尾部 为 截取(余下, 2, 字符串长度(余下))
    设 m 为 判定分隔位置(尾部)
    设 认证 为 尾部
    如果 m >= 0:
      设 认证 为 截取(尾部, 0, m)
    如果 开头(认证, "["):
      设 闭 为 查找子串(认证, "]")
      如果 闭 < 0:
        返回 空
      设 闭后 为 截取(认证, 闭 + 1, 字符串长度(认证))
      如果 闭后 != "":
        返回 空
      设 主机 为 认证
      设 路径名 为 "/"
      如果 m >= 0:
        设 路径名 为 截取(尾部, m, 字符串长度(尾部))
    否则 如果 认证 == "":
      设 主机 为 ""
      设 路径名 为 "/"
      如果 尾部 != "":
        设 路径名 为 尾部
    否则:
      如果 字符串包含(认证, ":") 或 字符串包含(认证, " ") 或 字符串包含(认证, "\t") 或 字符串包含(认证, "\n"):
        返回 空
      设 主机 为 认证
      设 路径名 为 "/"
      如果 m >= 0:
        设 路径名 为 截取(尾部, m, 字符串长度(尾部))
  否则 如果 开头(余下, "/"):
    设 路径名 为 余下
  否则:
    设 路径名 为 "/" + 余下
  设 主机 为 转小写(主机)
  返回 { "协议": 方案, "主机": 主机, "路径名": 路径名 }

# 转换文件：等价 fileURLToPath（按执行世界），失败/非法返回 空
段落 转换文件 接收 原文, 窗:
  设 u 为 解析文件(原文)
  如果 u == 空:
    返回 空
  如果 u["协议"] != "file:":
    返回 空
  设 低 为 转小写(u["路径名"])
  如果 字符串包含(低, "%2f"):
    返回 空
  如果 窗 == 真 且 字符串包含(低, "%5c"):
    返回 空
  设 解码 为 u["路径名"]
  如果 字符串包含(u["路径名"], "%"):
    尝试:
      设 解码 为 解码百分(u["路径名"])
    捕获 异常 e:
      返回 空
  如果 窗 == 真:
    如果 u["主机"] != "":
      返回 "\\\\" + u["主机"] + 替换字符串(解码, "/", "\\")
    设 组 为 分组匹配("^/([A-Za-z])(?::|%3A)(.*)$", 解码)
    如果 组 == 空:
      返回 空
    设 盘 为 列表获取(组, 0)
    设 尾 为 列表获取(组, 1)
    返回 盘 + ":" + 替换字符串(尾, "/", "\\")
  如果 u["主机"] != "":
    返回 空
  返回 解码

# 去尾部空：原地移除末尾空串
段落 去尾部空 接收 表:
  当 列表长度(表) > 0 且 列表获取(表, 列表长度(表) - 1) == "":
    列表弹出(表)
  返回 表

# 窗根：win32 根分类（UNC/盘符/根/相对）
段落 窗根 接收 表:
  如果 列表长度(表) >= 2 且 列表获取(表, 0) == "" 且 列表获取(表, 1) == "":
    如果 列表长度(表) >= 4:
      返回 "网:" + 转小写(列表获取(表, 2)) + "/" + 转小写(列表获取(表, 3))
    返回 "网:" + 转小写(列表获取(表, 2)) + "/"
  如果 列表长度(表) >= 1:
    设 头 为 列表获取(表, 0)
    如果 字符串长度(头) >= 2 且 字符串获取(头, 1) == ":" 且 判定字母(字符串获取(头, 0)):
      返回 "盘:" + 转小写(头)
  如果 列表长度(表) >= 1 且 列表获取(表, 0) == "":
    返回 "根:"
  如果 列表长度(表) > 0:
    返回 "相:" + 转小写(列表获取(表, 0))
  返回 "相:"

# 窗相对：等价 win32.relative（大小写不敏感、根不同返回乙）
段落 窗相对 接收 甲, 乙:
  如果 甲 == 乙:
    返回 ""
  设 前 为 去尾部空(分割字符串(甲, "\\"))
  设 后 为 去尾部空(分割字符串(乙, "\\"))
  如果 窗根(前) != 窗根(后):
    返回 乙
  设 短 为 列表长度(前)
  如果 列表长度(后) < 短:
    设 短 为 列表长度(后)
  设 i 为 0
  当 i < 短:
    如果 转小写(列表获取(前, i)) != 转小写(列表获取(后, i)):
      跳出
    设 i 为 i + 1
  设 果 为 []
  设 j 为 i
  当 j < 列表长度(前):
    列表追加(果, "..")
    设 j 为 j + 1
  设 j 为 i
  当 j < 列表长度(后):
    列表追加(果, 列表获取(后, j))
    设 j 为 j + 1
  返回 连接字符串(果, "\\")

# 宽相对：等价 posix.relative（大小写敏感）
段落 宽相对 接收 甲, 乙:
  如果 甲 == 乙:
    返回 ""
  设 前 为 去尾部空(分割字符串(甲, "/"))
  设 后 为 去尾部空(分割字符串(乙, "/"))
  如果 列表长度(前) > 0 且 列表获取(前, 0) == "":
    列表弹出(前, 0)
  如果 列表长度(后) > 0 且 列表获取(后, 0) == "":
    列表弹出(后, 0)
  如果 列表长度(前) > 0 且 (列表获取(前, 0) == "" 或 列表获取(前, 0) == "."):
    列表弹出(前, 0)
  如果 列表长度(后) > 0 且 (列表获取(后, 0) == "" 或 列表获取(后, 0) == "."):
    列表弹出(后, 0)
  设 短 为 列表长度(前)
  如果 列表长度(后) < 短:
    设 短 为 列表长度(后)
  设 i 为 0
  当 i < 短:
    如果 列表获取(前, i) != 列表获取(后, i):
      跳出
    设 i 为 i + 1
  设 成品 为 []
  设 j 为 i
  当 j < 列表长度(前):
    列表追加(成品, "..")
    设 j 为 j + 1
  设 j 为 i
  当 j < 列表长度(后):
    列表追加(成品, 列表获取(后, j))
    设 j 为 j + 1
  返回 连接字符串(成品, "/")

# 窗绝对：win32 绝对路径判定（盘符:[/\] 或以 [/\] 开头）
段落 窗绝对 接收 路径:
  设 n 为 字符串长度(路径)
  如果 n >= 3 且 判定字母(字符串获取(路径, 0)) 且 字符串获取(路径, 1) == ":" 且 (字符串获取(路径, 2) == "/" 或 字符串获取(路径, 2) == "\\"):
    返回 真
  如果 n >= 1 且 (字符串获取(路径, 0) == "/" 或 字符串获取(路径, 0) == "\\"):
    返回 真
  返回 假

# 宽绝对：posix 绝对路径判定
段落 宽绝对 接收 路径:
  返回 开头(路径, "/")

# 判定盘符路径：路径名以 /[A-Za-z]: 或 /[A-Za-z]%3A 开头
段落 判定盘符路径 接收 路径名:
  设 命中 为 匹配开头("/[a-zA-Z](?::|%3A|%3a)", 路径名)
  如果 命中 == 空:
    返回 假
  返回 真

# 判定窗世界：主机非空或路径名带盘符 → Windows 世界
段落 判定窗世界 接收 u:
  如果 u["主机"] != "":
    返回 真
  返回 判定盘符路径(u["路径名"])

# 判定含空字符：路径中是否存在 NUL 字符（经 ord 判定，绕开 \0 字面量）
段落 判定含空字符 接收 路径:
  设 长 为 字符串长度(路径)
  设 i 为 0
  当 i < 长:
    如果 ord(字符串获取(路径, i)) == 0:
      返回 真
    设 i 为 i + 1
  返回 假

# 渲染资源标识：等价 renderUri——工作区内 file: 转相对路径，工作区外转绝对路径，
# 非 file: 或非法资源标识原样保留。
段落 渲染资源标识 接收 资源标识, 工作区资源标识:
  如果 开头(资源标识, "file:") == 假:
    返回 资源标识
  设 目标 为 解析文件(资源标识)
  设 工作 为 解析文件(工作区资源标识)
  如果 目标 == 空 或 工作 == 空:
    返回 资源标识
  如果 工作["协议"] != "file:":
    返回 资源标识
  设 窗界 为 判定窗世界(工作)
  设 目窗界 为 假
  如果 窗界 == 真:
    设 目窗界 为 判定窗世界(目标)
  设 工作路径 为 转换文件(工作区资源标识, 窗界)
  设 目标路径 为 转换文件(资源标识, 目窗界)
  如果 工作路径 == 空 或 目标路径 == 空:
    返回 资源标识
  如果 判定含空字符(目标路径) == 真 或 判定含空字符(工作路径) == 真:
    返回 资源标识
  如果 窗界 != 目窗界:
    返回 目标路径
  设 相对 为 ""
  如果 窗界 == 真:
    设 相对 为 窗相对(工作路径, 目标路径)
  否则:
    设 相对 为 宽相对(工作路径, 目标路径)
  设 分隔 为 "/"
  如果 窗界 == 真:
    设 分隔 为 "\\"
  设 越界 为 假
  如果 相对 == "..":
    设 越界 为 真
  如果 开头(相对, ".." + 分隔) == 真:
    设 越界 为 真
  如果 窗界 == 真:
    如果 窗绝对(相对) == 真:
      设 越界 为 真
  否则:
    如果 宽绝对(相对) == 真:
      设 越界 为 真
  设 果 为 相对
  如果 相对 == "":
    设 果 为 "."
  如果 越界 == 真:
    设 果 为 目标路径
  如果 窗界 == 真:
    设 果 为 替换字符串(果, "\\", "/")
  返回 果
