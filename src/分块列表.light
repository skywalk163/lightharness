# 分块列表.light —— 对标原版 packages/util/chunked-list/src/index.ts
# 纯逻辑核心：不可变追加链表（每块最多 64 个值），追加只复制最新一块；按插入序遍历。
# 上游导出：appendChunkedList / iterateChunkedList / chunkedListSchema(zod)。
# 差异：光明无 zod，chunkedListSchema 以「校验分块检查点」纯函数等价提供（拒绝空块/超容块）。

从 内置核心字典 导入 字典包含键, 字典获取
从 内置核心列表 导入 列表追加
从 内置核心判型 导入 是字符串, 是列表, 是字典, 是整数
从 内置核心字符串 导入 去除空白, 截取, 字符串包含

设 块容量 为 64

# 追加分块：不修改入参；最新块满 64 时新开一块，旧块全程共享。
# 节点形状：{"值表": [...], "前件": 上一节点 或 空}
段落 追加分块(头, 值):
  如果 头 == 空 或 长(头["值表"]) == 块容量:
    设 节点 为 {"值表": [值]}
    如果 头 != 空:
      字典设置(节点, "前件", 头)
    返回 节点
  设 新值表 为 []
  遍历 旧值 之 头["值表"]:
    新值表.追加(旧值)
  新值表.追加(值)
  设 新节点 为 {"值表": 新值表}
  如果 字典包含键(头, "前件"):
    字典设置(新节点, "前件", 头["前件"])
  返回 新节点

# 遍历分块：从最新块反向回溯收集，再正展平为插入序列表（O(N)）。
段落 遍历分块(头):
  设 块栈 为 []
  设 游标 为 头
  当 游标 != 空:
    块栈.追加(游标)
    如果 字典包含键(游标, "前件"):
      设 游标 为 游标["前件"]
    否则:
      设 游标 为 空
  设 结果 为 []
  设 i 为 长(块栈) - 1
  当 i >= 0:
    遍历 值 之 块栈[i]["值表"]:
      结果.追加(值)
    设 i 为 i - 1
  返回 结果

# 校验分块检查点：每块非空且不超过块容量（等价上游 chunkedListSchema 的尺寸约束）。
段落 校验分块(头):
  如果 头 == 空:
    返回 真
  设 游标 为 头
  当 游标 != 空:
    设 表 为 游标["值表"]
    如果 长(表) == 0 或 长(表) > 块容量:
      返回 假
    如果 字典包含键(游标, "前件"):
      设 游标 为 游标["前件"]
    否则:
      设 游标 为 空
  返回 真

# =====================================================================
# T-0499：ctx 装配族四合一（原 tool_20/21/22/23）
#
# 差异分析：压缩选块 / 压缩摘要 / 上下文装配 / 上下文装配报告 四者都只作用于
#   本模块的不可变分块链，差异在「参数形态 + 后处理」，执行路径同为纯函数：
#   选块=按起点/上限/关键词过滤，截断摘要=长度上限+省略标记，装配=按分隔符
#   拼接并加前后缀，装配报告=块数/字符数/是否截断/丢弃字符数。
#   按 (输入, mode, 参数) 缓存、重复调用幂等，合并不破坏缓存/幂等性。
# 统一入口：ctx装配(输入, 模式, 参数) → {"ok", "mode", "结果"}；
#   四个原名收进 ctx别名表 / ctx原名表，能力零丢失。
# 错误口径：mode 非法 → T-0504 同形信封（type=validation / errorType=schema /
#   code=PARAM_SCHEMA_INVALID / suggestion=决策树文本），不另起字段口径。
# =====================================================================

设 ctx原名表 为 ["压缩选块", "压缩摘要", "上下文装配", "上下文装配报告"]
设 ctx模式表 为 ["选块", "截断摘要", "装配", "装配报告"]
设 ctx别名表 为 {
  "选块": "选块", "select": "选块", "压缩选块": "选块",
  "截断摘要": "截断摘要", "截断": "截断摘要", "摘要": "截断摘要",
  "压缩摘要": "截断摘要", "truncate": "截断摘要",
  "装配": "装配", "组装": "装配", "上下文装配": "装配", "assemble": "装配",
  "装配报告": "装配报告", "报告": "装配报告",
  "上下文装配报告": "装配报告", "report": "装配报告"
}

段落 ctx模式归一(模式):
  如果 是字符串(模式) == 假:
    返回 ""
  设 去 为 去除空白(模式)
  如果 字典包含键(ctx别名表, 去) == 真:
    返回 ctx别名表[去]
  返回 ""

段落 ctx决策树文本():
  设 文 为 "挑要用的块→mode=选块；长文本压到上限内→mode=截断摘要；已选块拼成上下文→mode=装配；看块数/字符数/截断情况→mode=装配报告"
  返回 文

段落 ctx建议文本(模式):
  设 列 为 ""
  遍历 项 之 ctx模式表:
    如果 列 != "":
      设 列 为 列 + "/"
    设 列 为 列 + 项
  设 原 为 ""
  遍历 名 之 ctx原名表:
    如果 原 != "":
      设 原 为 原 + "/"
    设 原 为 原 + 名
  返回 "mode 只接受 " + 列 + "（原名 " + 原 + " 亦可用）。" + ctx决策树文本()

段落 ctx失败载荷(模式, 字段 = "mode"):
  # 与 T-0504 ValidationError 信封同字段：type/errorType/code/field/reason/
  #   message/suggestion/retryable/traceId/details；不另起一套。
  设 路径 为 "参数." + 字段
  设 载 为 {"ok": 假, "type": "validation", "errorType": "schema",
    "code": "PARAM_SCHEMA_INVALID", "field": 路径, "reason": "enum",
    "message": "mode 取值非法，期望四选一", "suggestion": ctx建议文本(模式),
    "retryable": 假, "traceId": 空, "details": 空}
  返回 载

# 原 tool_20 能力：选块（按起点/上限/关键词过滤，保持插入序，不改入参）
段落 ctx选块(块表, 参数 = 空):
  设 参 为 参数
  如果 是字典(参) == 假:
    设 参 为 {}
  设 表 为 块表
  如果 是列表(表) == 假:
    设 表 为 []
  设 起 为 字典获取(参, "起始", 0)
  如果 是整数(起) == 假:
    设 起 为 0
  如果 起 < 0:
    设 起 为 0
  设 止 为 长(表)
  如果 字典包含键(参, "上限") == 真:
    设 数 为 字典获取(参, "上限", 0)
    如果 是整数(数) == 真:
      设 止 为 起 + 数
  如果 止 > 长(表):
    设 止 为 长(表)
  设 关键字 为 字典获取(参, "关键词", "")
  设 结果 为 []
  设 i 为 起
  当 i < 止:
    设 值 为 表[i]
    设 留 为 真
    如果 是字符串(关键字) == 真 且 关键字 != "":
      设 留 为 字符串包含(转字符串(值), 关键字)
    如果 留 == 真:
      列表追加(结果, 值)
    设 i 为 i + 1
  返回 结果

# 原 tool_21 能力：截断摘要（长度上限 + 省略标记，中文按字符计）
段落 ctx截断摘要(输入文本, 参数 = 空):
  设 参 为 参数
  如果 是字典(参) == 假:
    设 参 为 {}
  设 文本 为 转字符串(输入文本)
  设 上限 为 字典获取(参, "上限", 80)
  如果 是整数(上限) == 假:
    设 上限 为 80
  如果 上限 < 0:
    设 上限 为 0
  设 尾 为 字典获取(参, "省略标记", "…")
  如果 是字符串(尾) == 假:
    设 尾 为 "…"
  如果 长(文本) <= 上限:
    返回 文本
  设 留 为 上限 - 长(尾)
  如果 留 < 0:
    设 留 为 0
  返回 截取(文本, 0, 留) + 尾

# 原 tool_22 能力：装配（按分隔符拼接，支持前缀/后缀）
段落 ctx装配文本(块表, 参数 = 空):
  设 参 为 参数
  如果 是字典(参) == 假:
    设 参 为 {}
  设 表 为 块表
  如果 是列表(表) == 假:
    设 表 为 []
  设 分隔 为 字典获取(参, "分隔符", "\n")
  如果 是字符串(分隔) == 假:
    设 分隔 为 "\n"
  设 前 为 字典获取(参, "前缀", "")
  设 后 为 字典获取(参, "后缀", "")
  如果 是字符串(前) == 假:
    设 前 为 ""
  如果 是字符串(后) == 假:
    设 后 为 ""
  设 文 为 ""
  设 i 为 0
  遍历 块 之 表:
    设 片 为 转字符串(块)
    如果 i == 0:
      设 文 为 文 + 片
    否则:
      设 文 为 文 + 分隔 + 片
    设 i 为 i + 1
  返回 前 + 文 + 后

# 原 tool_23 能力：装配报告（块数/字符数/是否截断/丢字符数，含装配文本）
段落 ctx装配报告(块表, 参数 = 空):
  设 参 为 参数
  如果 是字典(参) == 假:
    设 参 为 {}
  设 表 为 块表
  如果 是列表(表) == 假:
    设 表 为 []
  设 文 为 ctx装配文本(表, 参)
  设 原长 为 长(文)
  设 报 为 {"块数": 长(表), "字符数": 原长, "已截断": 假,
    "装配文本": 文, "丢字符数": 0}
  设 上限 为 字典获取(参, "上限", 0)
  如果 是整数(上限) == 真 且 上限 > 0 且 原长 > 上限:
    设 截参 为 {"上限": 上限, "省略标记": 字典获取(参, "省略标记", "…")}
    设 短 为 ctx截断摘要(文, 截参)
    字典设置(报, "已截断", 真)
    字典设置(报, "装配文本", 短)
    字典设置(报, "丢字符数", 原长 - 长(短))
  返回 报

# 统一入口：模型只选意图(mode)，实现选择下沉到本流水线
段落 ctx装配(输入, 模式, 参数 = 空):
  设 归一 为 ctx模式归一(模式)
  如果 归一 == "":
    返回 ctx失败载荷(模式)
  设 参 为 参数
  如果 是字典(参) == 假:
    设 参 为 {}
  设 块表 为 []
  如果 是字典(输入) == 真:
    如果 字典包含键(输入, "值表") == 真:
      设 块表 为 遍历分块(输入)
  否则如果 是列表(输入) == 真:
    设 块表 为 输入
  设 结果 为 空
  如果 归一 == "选块":
    设 结果 为 ctx选块(块表, 参)
  否则如果 归一 == "截断摘要":
    设 原文 为 转字符串(输入)
    如果 是字典(输入) == 真 或 是列表(输入) == 真:
      设 原文 为 ctx装配文本(块表, 参)
    设 结果 为 ctx截断摘要(原文, 参)
  否则如果 归一 == "装配":
    设 结果 为 ctx装配文本(块表, 参)
  否则:
    设 结果 为 ctx装配报告(块表, 参)
  设 出 为 {"ok": 真, "mode": 归一, "结果": 结果, "suggestion": ""}
  返回 出
