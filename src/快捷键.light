# 快捷键.light —— R106 任务线 D：快捷键编辑器后端模型（键位规范化 / 校验 / 保留 / 冲突 / 默认表 / 重置）
#
# 合流点：C 线的 GET/POST /api/shortcuts（web服务器.light）将调用本模块；
#         B 线前端不自行计算保留/冲突规则，错误文案一律由本模块返回、经 C 线原样带回。
#
# 上游考据（锚点 G:\github\deepseek-harness，HEAD=e5b5ccbfcb，0.2.0-rc.1，行号实测）：
#   - packages/client/shortcuts/src/binding.ts:27-32 keyNames（具名键显示映射）；
#     :33 modifierOrder = control→alt→shift→meta（物理规范串排序，也是键帽序）；
#     :49-51 primary 按平台展开（macos→meta，其它→control）后 Set 去重再按该序排列；
#     :91-100 isWebBindingAllowed（web 允许集）
#   - packages/client/shortcuts/src/configuration.ts:96-113 bindingIssue()（校验/保留/拒绝规则，逐条复刻）
#   - packages/client/ui-shortcuts/src/client/locales.ts:6-8/:11/:17 文案逐字；:32 分组；:34 fixed 标签
#   - packages/client/ui-shortcuts/src/client/fixed.ts rows（fixed.move/select/dismiss，分组 menus，
#     固定键不受校验约束——configuration.ts:138-139 把 fixed 单列，普通行才校验）
#   - too-many-keys 产出时机：ui-shortcuts/src/client/Editor.tsx:114（捕获期一次按下 >2 键）
#     → 字符串模型等价「键串含 >=3 个非修饰键」；两个非修饰键（和弦）→ unsupported-key（configuration.ts:99）
#
# 命令目录口径（只读抄录；命令 id 以 cli外壳.斜杠命令表 为权威，test_快捷键 有对账断言）：
#   - 命令 id：src/cli外壳.light:84 斜杠命令表()（/help /clear /model /compact /save /resume /exit）
#   - 标签：webui/slash-palette.js:17 的 {cmd, desc} 描述文案（CLI 侧无 desc，故抄 webui 口径）
#
# 已知口径差异（如实登记，不自造规则）：
#   - 桌面运行时：上游 bindingIssue 仅 desktop + windows/macos 直接放行（configuration.ts:98），
#     linux 桌面仍走后续检查；本模块按任务书口径「desktop 一律不保留」（是保留组合 desktop → 假）。
#   - 键串全为修饰键（无非修饰键）时上游无此输入形状（normalizeBinding 要求 code），
#     本模块报自定消息「键串缺少非修饰键: <串>」（非上游文案，已单独列出）。

从 文件系统 导入 文件存在, 路径连接

# ---- 物理修饰词固定序（binding.ts:33 modifierOrder）----
设 修饰键表 为 ["control", "alt", "shift", "meta"]

# ---- 保留具名键（configuration.ts:104 第一组：编辑器/导航键）----
设 保留具名键表 为 ["Escape", "Tab", "Space", "Backspace", "Delete", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"]

# ---- primary + 文本编辑保留键（configuration.ts:105-107：C/V/X/Z/Y/Q/H；A 另判 shift）----
设 主修饰保留码表 为 ["KeyC", "KeyV", "KeyX", "KeyZ", "KeyY", "KeyQ", "KeyH"]

# ---- 上游文案逐字（ui-shortcuts/src/client/locales.ts:6-8/:11/:17，已实测）----
设 文案不支持键 为 "暂不支持这个按键。"
设 文案保留 为 "此组合由系统或文本编辑操作保留。"
设 文案需修饰键 为 "请同时按下 Command、Ctrl 或 Alt 修饰键。"
设 文案过多键 为 "最多同时按下两个非修饰键。请松开后重试。"
设 文案不支持浏览器 为 "此浏览器暂不支持该组合。"
设 文案冲突 为 "已被「{{commands}}」占用"

# ---- 分组（locales.ts:32 上游 zh 文案；本仓命令目录只用 应用操作 一类）----
设 分组应用操作 为 "应用操作"
设 分组菜单与弹层 为 "菜单与弹层"


# ---- 平台判定：macos → primary=meta，其它（windows/linux/other）→ primary=control（binding.ts:49-51）----
段落 是mac平台(平台):
  返回 平台 == "macos"

段落 主修饰词(平台):
  如果 是mac平台(平台):
    返回 "meta"
  返回 "control"

# ---- 字符判定（内置 是字母/是数字 未注册，用 码位 实现：A-Z 65-90 / a-z 97-122 / 0-9 48-57）----
段落 是字母字(字符):
  设 码 为 码位(字符)
  如果 码 >= 65 且 码 <= 90:
    返回 真
  如果 码 >= 97 且 码 <= 122:
    返回 真
  返回 假

段落 是数字字(字符):
  设 码 为 码位(字符)
  如果 码 >= 48 且 码 <= 57:
    返回 真
  返回 假

# ---- 键名 → 上游物理码（binding.ts:27-32 keyNames 逆向 + 常用别名；未知返回 ""）----
段落 键名转码(名):
  设 词 为 去除空白(名)
  如果 词 == "":
    返回 ""
  设 大写词 为 转大写(词)
  # 符号键（keyNames 第一行）
  如果 词 == "/" 或 大写词 == "SLASH":
    返回 "Slash"
  如果 词 == "," 或 大写词 == "COMMA":
    返回 "Comma"
  如果 词 == "." 或 大写词 == "PERIOD":
    返回 "Period"
  如果 词 == "\\" 或 大写词 == "BACKSLASH":
    返回 "Backslash"
  如果 词 == "`" 或 大写词 == "BACKQUOTE":
    返回 "Backquote"
  如果 词 == "-" 或 大写词 == "MINUS":
    返回 "Minus"
  如果 词 == "=" 或 大写词 == "EQUAL":
    返回 "Equal"
  如果 词 == "[" 或 大写词 == "BRACKETLEFT":
    返回 "BracketLeft"
  如果 词 == "]" 或 大写词 == "BRACKETRIGHT":
    返回 "BracketRight"
  如果 词 == ";" 或 大写词 == "SEMICOLON":
    返回 "Semicolon"
  如果 词 == "'" 或 大写词 == "QUOTE":
    返回 "Quote"
  # 具名键
  如果 大写词 == "ENTER":
    返回 "Enter"
  如果 大写词 == "ESCAPE" 或 大写词 == "ESC":
    返回 "Escape"
  如果 大写词 == "SPACE":
    返回 "Space"
  如果 大写词 == "TAB":
    返回 "Tab"
  如果 大写词 == "BACKSPACE":
    返回 "Backspace"
  如果 大写词 == "DELETE" 或 大写词 == "DEL":
    返回 "Delete"
  如果 大写词 == "ARROWUP" 或 词 == "↑":
    返回 "ArrowUp"
  如果 大写词 == "ARROWDOWN" 或 词 == "↓":
    返回 "ArrowDown"
  如果 大写词 == "ARROWLEFT" 或 词 == "←":
    返回 "ArrowLeft"
  如果 大写词 == "ARROWRIGHT" 或 词 == "→":
    返回 "ArrowRight"
  # 上游 code 形式直收（KeyK / Digit5）
  如果 长度(大写词) == 4 且 开头(大写词, "KEY") 且 是字母字(截取(词, 3, 4)):
    返回 "Key" + 转大写(截取(词, 3, 4))
  如果 长度(大写词) == 6 且 开头(大写词, "DIGIT") 且 是数字字(截取(词, 5, 6)):
    返回 "Digit" + 截取(词, 5, 6)
  # 单字母 / 单数字
  如果 长度(词) == 1:
    如果 是字母字(词):
      返回 "Key" + 转大写(词)
    如果 是数字字(词):
      返回 "Digit" + 词
    返回 ""
  # F 功能键 F1~F24
  如果 长度(词) >= 2 且 长度(词) <= 3:
    如果 词[0] == "F" 或 词[0] == "f":
      设 尾 为 截取(词, 1, 长度(词))
      设 全数字 为 真
      设 下标 为 0
      当 下标 < 长度(尾):
        如果 是数字字(尾[下标]) == 假:
          设 全数字 为 假
        设 下标 为 下标 + 1
      如果 全数字:
        设 键值 为 转整数(尾)
        如果 键值 >= 1 且 键值 <= 24:
          返回 "F" + 转字符串(键值)
    返回 ""
  返回 ""

# ---- 物理码 → 显示键名（binding.ts:27-32 keyNames 正向；KeyX→X，Digit5→5）----
段落 键码显示(码):
  如果 码 == "Slash":
    返回 "/"
  如果 码 == "Comma":
    返回 ","
  如果 码 == "Period":
    返回 "."
  如果 码 == "Backslash":
    返回 "\\"
  如果 码 == "Backquote":
    返回 "`"
  如果 码 == "Minus":
    返回 "-"
  如果 码 == "Equal":
    返回 "="
  如果 码 == "BracketLeft":
    返回 "["
  如果 码 == "BracketRight":
    返回 "]"
  如果 码 == "Semicolon":
    返回 ";"
  如果 码 == "Quote":
    返回 "'"
  如果 码 == "Escape":
    返回 "Esc"
  如果 码 == "ArrowUp":
    返回 "↑"
  如果 码 == "ArrowDown":
    返回 "↓"
  如果 码 == "ArrowLeft":
    返回 "←"
  如果 码 == "ArrowRight":
    返回 "→"
  如果 开头(码, "Key") 且 长度(码) == 4:
    返回 截取(码, 3, 4)
  如果 开头(码, "Digit") 且 长度(码) == 6:
    返回 截取(码, 5, 6)
  返回 码

# ---- 键串解析核心（不抛错版，供 键位规范 与 应用变更 共用）----
# 键串（入参/展示层）：Mod+/、Mod+Shift+,、Ctrl+Alt+K 形式；
# Mod = 逻辑主修饰键，mac→meta、其它→control（binding.ts:49-51）。
# 返回 {"物理串": 串, "错误": 串}；错误非空时物理串为空串。
段落 解析键串(键串, 平台 = "other"):
  设 结果 为 {"物理串": "", "错误": ""}
  如果 是字符串(键串) == 假:
    字典设置(结果, "错误", "键串必须是字符串")
    返回 结果
  设 文本 为 去除空白(键串)
  如果 文本 == "":
    字典设置(结果, "错误", "键串为空")
    返回 结果
  设 片表 为 分割字符串(文本, "+")
  设 修饰集 为 []
  设 键码表 为 []
  遍历 片 之 片表:
    设 词 为 转大写(去除空白(片))
    如果 词 == "":
      字典设置(结果, "错误", "键串含空段: " + 文本)
      返回 结果
    如果 词 == "MOD":
      列表追加(修饰集, 主修饰词(平台))
    否则如果 词 == "CTRL" 或 词 == "CONTROL":
      列表追加(修饰集, "control")
    否则如果 词 == "ALT":
      列表追加(修饰集, "alt")
    否则如果 词 == "SHIFT":
      列表追加(修饰集, "shift")
    否则如果 词 == "META" 或 词 == "CMD" 或 词 == "COMMAND":
      列表追加(修饰集, "meta")
    否则:
      设 码 为 键名转码(去除空白(片))
      如果 码 == "":
        字典设置(结果, "错误", "未知键名: " + 片)
        返回 结果
      列表追加(键码表, 码)
  # 非修饰键个数（Editor.tsx:114 的字符串模型等价）
  如果 长度(键码表) == 0:
    字典设置(结果, "错误", "键串缺少非修饰键: " + 文本)
    返回 结果
  如果 长度(键码表) == 2:
    字典设置(结果, "错误", 文案不支持键)
    返回 结果
  如果 长度(键码表) >= 3:
    字典设置(结果, "错误", 文案过多键)
    返回 结果
  # 修饰键去重 + 固定序 control→alt→shift→meta（binding.ts:33/:49-51）
  设 修饰表 为 []
  遍历 物理修饰 之 修饰键表:
    如果 列表包含(修饰集, 物理修饰):
      列表追加(修饰表, 物理修饰)
  设 全表 为 []
  遍历 物理修饰2 之 修饰表:
    列表追加(全表, 物理修饰2)
  列表追加(全表, 键码表[0])
  字典设置(结果, "物理串", 连接字符串(全表, "+"))
  返回 结果

# ---- 段落 1：键位规范（键串, 平台) -> 物理规范串；非法抛错（消息含上游文案）----
段落 键位规范(键串, 平台 = "other"):
  设 结果 为 解析键串(键串, 平台)
  如果 结果["错误"] != "":
    抛出 新建 错误(结果["错误"])
  返回 结果["物理串"]

# ---- 物理规范串拆解：{"修饰": [control...], "键": 码} ----
段落 拆物理串(物理串):
  设 片表 为 分割字符串(物理串, "+")
  设 修饰表 为 []
  设 末下标 为 长度(片表) - 1
  设 下标 为 0
  当 下标 < 末下标:
    列表追加(修饰表, 转小写(片表[下标]))
    设 下标 为 下标 + 1
  返回 {"修饰": 修饰表, "键": 片表[末下标]}

# ---- 段落 2：展示键串（物理规范串, 平台) -> 键串（Mod 形式回显，用于 默认键/当前键 字段）----
# 物理 meta/control 的主修饰词在展示层回显为 Mod；其余 Ctrl/Alt/Shift/Meta。
段落 展示键串(物理串, 平台 = "other"):
  设 拆结果 为 拆物理串(物理串)
  设 修饰表 为 拆结果["修饰"]
  设 主词 为 主修饰词(平台)
  设 显示表 为 []
  遍历 修饰 之 修饰键表:
    如果 列表包含(修饰表, 修饰):
      如果 修饰 == 主词:
        列表追加(显示表, "Mod")
      否则如果 修饰 == "control":
        列表追加(显示表, "Ctrl")
      否则如果 修饰 == "alt":
        列表追加(显示表, "Alt")
      否则如果 修饰 == "shift":
        列表追加(显示表, "Shift")
      否则:
        列表追加(显示表, "Meta")
  列表追加(显示表, 键码显示(拆结果["键"]))
  返回 连接字符串(显示表, "+")

# ---- 段落 4：是保留组合（物理规范串, 平台, 运行时) -> 真假 ----
# configuration.ts:104-110 保留清单逐条复刻（出处见各分支注释）。
# 注：本段落只判保留表本身；调用顺序（modifier-required / >=3 合法 / web 允许集）
#     由 校验键位 按 bindingIssue 的原始顺序编排。
段落 是保留组合(物理串, 平台 = "other", 运行时 = "web"):
  # 任务书口径：desktop 一律不保留（上游 :98 仅 desktop+windows/macos 直接放行，差异已在文件头登记）
  如果 运行时 == "desktop":
    返回 假
  设 拆结果 为 拆物理串(物理串)
  设 修饰表 为 拆结果["修饰"]
  设 码 为 拆结果["键"]
  设 含主修饰 为 列表包含(修饰表, 主修饰词(平台))
  # :104 具名键保留表
  如果 列表包含(保留具名键表, 码):
    返回 真
  # :105 Enter（不含 alt）
  如果 码 == "Enter" 且 列表包含(修饰表, "alt") == 假:
    返回 真
  # :106 primary + C/V/X/Z/Y/Q/H
  如果 含主修饰 且 列表包含(主修饰保留码表, 码):
    返回 真
  # :107 primary + A（不含 shift）
  如果 含主修饰 且 码 == "KeyA" 且 列表包含(修饰表, "shift") == 假:
    返回 真
  如果 是mac平台(平台) == 假:
    # :108 非 mac：含 meta，或 alt + F4/F2
    如果 列表包含(修饰表, "meta"):
      返回 真
    如果 列表包含(修饰表, "alt") 且 (码 == "F4" 或 码 == "F2"):
      返回 真
  否则:
    # :109 mac：control+meta
    如果 列表包含(修饰表, "control") 且 列表包含(修饰表, "meta"):
      返回 真
    # :110 mac：alt 且无 primary
    如果 列表包含(修饰表, "alt") 且 含主修饰 == 假:
      返回 真
  返回 假

# ---- web 允许集（binding.ts:91-100 isWebBindingAllowed）----
段落 网络组合允许(物理串, 平台 = "other"):
  设 拆结果 为 拆物理串(物理串)
  设 修饰表 为 拆结果["修饰"]
  设 码 为 拆结果["键"]
  设 个量 为 长度(修饰表)
  设 主词 为 主修饰词(平台)
  如果 是mac平台(平台) 或 平台 == "windows":
    # >=3 个修饰键一律允许
    如果 个量 >= 3:
      返回 真
    # 单修饰键：Comma/Backslash + primary，或 Backquote + control
    如果 个量 == 1:
      如果 (码 == "Comma" 或 码 == "Backslash") 且 修饰表[0] == 主词:
        返回 真
      如果 码 == "Backquote" 且 修饰表[0] == "control":
        返回 真
    # 双修饰键：含 primary 且（alt 或 shift）
    如果 个量 == 2:
      如果 列表包含(修饰表, 主词) 且 (列表包含(修饰表, "alt") 或 列表包含(修饰表, "shift")):
        返回 真
  # 各平台共用回退白名单（binding.ts:101-105）
  设 回退表 为 []
  列表追加(回退表, 主词 + "+Slash")
  列表追加(回退表, 主词 + "+Shift+Comma")
  列表追加(回退表, 主词 + "+Shift+Period")
  返回 列表包含(回退表, 物理串)

# ---- 段落 5：校验键位（物理规范串, 平台, 运行时) -> {"合法": 真假, "消息": 串} ----
# 顺序按 configuration.ts:96-113 原始判定链编排：
#   :98 desktop+windows/macos 直接合法；:100 无修饰键或仅 shift → modifier-required；
#   :101 windows/macos 且 >=3 修饰键 → 合法（不判保留）；:102 web+windows/macos 允许集 → 合法；
#   :104-110 保留 → reserved；:111 web 且不在允许集 → unsupported-browser。
段落 校验键位(物理串, 平台 = "other", 运行时 = "web"):
  设 结果 为 {"合法": 假, "消息": ""}
  设 拆结果 为 拆物理串(物理串)
  设 修饰表 为 拆结果["修饰"]
  设 个量 为 长度(修饰表)
  如果 运行时 == "desktop" 且 (是mac平台(平台) 或 平台 == "windows"):
    字典设置(结果, "合法", 真)
    返回 结果
  # :100 modifier-required
  如果 个量 == 0:
    字典设置(结果, "消息", 文案需修饰键)
    返回 结果
  设 全shift 为 真
  遍历 修饰 之 修饰表:
    如果 修饰 != "shift":
      设 全shift 为 假
      跳出
  如果 全shift:
    字典设置(结果, "消息", 文案需修饰键)
    返回 结果
  # :101 >=3 修饰键（仅 windows/macos）
  如果 (是mac平台(平台) 或 平台 == "windows") 且 个量 >= 3:
    字典设置(结果, "合法", 真)
    返回 结果
  # :102 web + windows/macos 允许集
  如果 运行时 == "web" 且 (是mac平台(平台) 或 平台 == "windows"):
    如果 网络组合允许(物理串, 平台):
      字典设置(结果, "合法", 真)
      返回 结果
  # :104-110 保留
  如果 是保留组合(物理串, 平台, 运行时):
    字典设置(结果, "消息", 文案保留)
    返回 结果
  # :111 web 且不在允许集
  如果 运行时 == "web":
    # 本仓 web 建模决策（C 线 §C⑪ 需要 Mod+字母 改键成功）：
    #   含 primary 修饰键（other 平台=control）即放行——上游严格 isWebBindingAllowed 会把
    #   Ctrl+字母 判 unsupported-browser，本仓放宽；Alt-only / Shift-only 仍落 unsupported-browser。
    设 拆web 为 拆物理串(物理串)
    设 含主词 为 列表包含(拆web["修饰"], 主修饰词(平台))
    如果 网络组合允许(物理串, 平台) == 假 且 含主词 == 假:
      字典设置(结果, "消息", 文案不支持浏览器)
      返回 结果
  字典设置(结果, "合法", 真)
  返回 结果

# ---- 条目当前占用的物理串表（" / " 和弦展示逐段反解；空键不计占用）----
段落 条目物理串表(条目, 平台):
  设 表 为 []
  设 当前键 为 条目["当前键"]
  如果 当前键 == 空 或 当前键 == "":
    返回 表
  设 段表 为 分割字符串(当前键, " / ")
  遍历 段 之 段表:
    设 反解 为 解析键串(段, 平台)
    如果 反解["错误"] == "":
      列表追加(表, 反解["物理串"])
  返回 表

# ---- 段落 6：查冲突（目录, 命令id, 物理规范串) -> 冲突命令标签列表（空表 = 无冲突）----
# 同键被别的命令占用即冲突；fixed 三件（菜单保留项）参与占用判定（fixed.ts 语义）。
段落 查冲突(目录, 命令id, 物理串, 平台 = "other"):
  设 冲突标签 为 []
  # 候选物理串先归一（修饰词小写化 + 固定序），防御大小写漂移
  设 拆候选 为 拆物理串(物理串)
  设 候选表 为 []
  遍历 修饰0 之 拆候选["修饰"]:
    列表追加(候选表, 修饰0)
  列表追加(候选表, 拆候选["键"])
  设 规范候选 为 连接字符串(候选表, "+")
  遍历 条目 之 目录:
    如果 条目["id"] != 命令id:
      设 占用表 为 条目物理串表(条目, 平台)
      遍历 占用 之 占用表:
        如果 占用 == 规范候选:
          如果 列表包含(冲突标签, 条目["标签"]) == 假:
            列表追加(冲突标签, 条目["标签"])
  返回 冲突标签

# ---- 冲突文案：已被「{commands}」占用（locales.ts:11，{commands} 用 、 连接）----
# 注：源码字面量 "{{commands}}" 经 f-string 折叠即运行时的 "{commands}"
段落 冲突文案(标签表):
  返回 替换字符串(文案冲突, "{{commands}}", 连接字符串(标签表, "、"))

# ---- 段落 7：应用变更（目录, 命令id, 键串, 平台) -> [新目录, "状态", "消息"] ----
# 先 键位规范 再 校验键位 再 查冲突；合法 → 更新 当前键/是否自定义；
# 非法 → 原目录 + 对应文案（状态 "错误"）。状态 "ok" / "错误"。
段落 应用变更(目录, 命令id, 键串, 平台 = "other"):
  设 结果目录 为 深拷贝(目录)
  设 解析 为 解析键串(键串, 平台)
  如果 解析["错误"] != "":
    返回 [结果目录, "错误", 解析["错误"]]
  设 物理 为 解析["物理串"]
  设 目标 为 空
  遍历 条目 之 结果目录:
    如果 条目["id"] == 命令id:
      设 目标 为 条目
  如果 目标 == 空:
    返回 [结果目录, "错误", "未知命令: " + 命令id]
  # fixed 行与其它命令走同一管线（规范→校验→冲突）；fixed 默认裸键仅在目录构建期不被校验拒绝，
  #   改键本身允许——C 线 §C⑪ 要求 POST fixed.move Mod+J → 200 且 是否自定义==真。
  设 校验 为 校验键位(物理, 平台, "web")
  如果 校验["合法"] == 假:
    返回 [结果目录, "错误", 校验["消息"]]
  设 冲突表 为 查冲突(结果目录, 命令id, 物理, 平台)
  如果 长度(冲突表) > 0:
    返回 [结果目录, "错误", 冲突文案(冲突表)]
  字典设置(目标, "当前键", 展示键串(物理, 平台))
  字典设置(目标, "是否自定义", 真)
  返回 [结果目录, "ok", ""]

# ---- 段落 8：重置命令 / 重置全部（恢复默认键、是否自定义=假）----
段落 重置命令(目录, 命令id):
  设 结果目录 为 深拷贝(目录)
  遍历 条目 之 结果目录:
    如果 条目["id"] == 命令id:
      字典设置(条目, "当前键", 条目["默认键"])
      字典设置(条目, "是否自定义", 假)
  返回 结果目录

段落 重置全部(目录):
  设 结果目录 为 深拷贝(目录)
  遍历 条目 之 结果目录:
    字典设置(条目, "当前键", 条目["默认键"])
    字典设置(条目, "是否自定义", 假)
  返回 结果目录

# ---- 段落 9：自定义计数（目录) -> 整数 ----
段落 自定义计数(目录):
  设 计 为 0
  遍历 条目 之 目录:
    如果 条目["是否自定义"] == 真:
      设 计 为 计 + 1
  返回 计

# ---- 段落 10：快捷键文档（根) -> {"路径": <根>/keybindings.json, "可用": 文件存在与否} ----
# 本轮自定义目录只存进程内存（C 线服务对象属性），未落 keybindings.json → 可用 恒为 假，如实上报。
段落 快捷键文档(根):
  设 路径 为 路径连接(根, "keybindings.json")
  返回 {"路径": 路径, "可用": 文件存在(路径)}

# ---- 段落 3：默认目录（平台) -> 列表 ----
# fixed 三件（fixed.ts rows，分组 菜单与弹层，标签 locales.ts:34 zh 逐字；固定键不受校验约束）
# + 本仓七命令（分组 应用操作；id 来源 cli外壳.斜杠命令表，标签抄 webui/slash-palette.js:17 描述）。
# 命令行本轮无默认键位 → 默认键/当前键 为空串（上游 unbound「暂无快捷键」语义）。
段落 默认目录(平台 = "other"):
  设 目录 为 []
  设 行1 为 {"id": "fixed.move", "标签": "移动菜单选择", "分组": 分组菜单与弹层, "默认键": "↑ / ↓", "当前键": "↑ / ↓", "是否自定义": 假}
  设 行2 为 {"id": "fixed.select", "标签": "选择菜单项", "分组": 分组菜单与弹层, "默认键": "Enter", "当前键": "Enter", "是否自定义": 假}
  设 行3 为 {"id": "fixed.dismiss", "标签": "关闭菜单或顶层弹窗", "分组": 分组菜单与弹层, "默认键": "Esc", "当前键": "Esc", "是否自定义": 假}
  列表追加(目录, 行1)
  列表追加(目录, 行2)
  列表追加(目录, 行3)
  设 命令标签表 为 {"id": "/help", "分组": 分组应用操作, "标签": "显示可用命令与快捷键"}
  设 命令标签表2 为 {"id": "/clear", "分组": 分组应用操作, "标签": "清空当前会话上下文（新对话）"}
  设 命令标签表3 为 {"id": "/model", "分组": 分组应用操作, "标签": "切换当前模型"}
  设 命令标签表4 为 {"id": "/compact", "分组": 分组应用操作, "标签": "手动触发上下文压缩"}
  设 命令标签表5 为 {"id": "/save", "分组": 分组应用操作, "标签": "立即保存当前会话"}
  设 命令标签表6 为 {"id": "/resume", "分组": 分组应用操作, "标签": "恢复历史会话"}
  设 命令标签表7 为 {"id": "/exit", "分组": 分组应用操作, "标签": "退出会话（关闭面板）"}
  列表追加(目录, 命令标签表)
  列表追加(目录, 命令标签表2)
  列表追加(目录, 命令标签表3)
  列表追加(目录, 命令标签表4)
  列表追加(目录, 命令标签表5)
  列表追加(目录, 命令标签表6)
  列表追加(目录, 命令标签表7)
  遍历 条目 之 目录:
    如果 条目["分组"] == 分组应用操作:
      字典设置(条目, "默认键", "")
      字典设置(条目, "当前键", "")
      字典设置(条目, "是否自定义", 假)
  返回 目录


