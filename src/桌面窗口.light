# 桌面窗口.light —— desktop 外壳纯逻辑面：窗口生命周期状态机（#293）
#
# 上游 apps/desktop 是 Electron 原生壳；本轮只收纯逻辑面：
#   - 窗口生命周期状态机（closed -> opening -> open -> focused/blurred -> closing -> closed）
#   - 窗口配置纯逻辑校验
#   - 多窗口管理器（窗口表 + 活跃窗口指针）
#
# 红线（永久宿主绑定，不移植）：
#   - BrowserWindow 句柄 / 原生窗口渲染 / 真实置顶/动画 / 原生 frame 控制。
#   本模块只给状态转移与配置判定的纯逻辑形状，不触任何 Electron API。
#
# 反跑判据：
#   ① 非法转移被放行（如 closed + focus 也返回成功）-> test_桌面窗口 红；
#   ② 配置最小尺寸/全屏互斥校验被放宽 -> test_桌面窗口 红。

# 窗口合法状态词表
设 窗口状态表 为 ["closed", "opening", "open", "focused", "blurred", "closing"]

# 事件词表：open/focus/blur/close-request/closed
# 合法转移表（当前态 -> 事件 -> 新态）：
#   closed   + open          -> opening
#   opening  + open          -> open
#   opening  + focus        -> focused
#   opening  + blur          -> blurred
#   open     + focus         -> focused
#   open     + blur          -> blurred
#   focused  + blur          -> blurred
#   blurred  + focus         -> focused
#   focused  + close-request -> closing
#   open     + close-request -> closing
#   blurred  + close-request -> closing
#   closing  + closed        -> closed
段落 是合法窗口状态(态):
  遍历 项 之 窗口状态表:
    如果 项 == 态:
      返回 真
  返回 假

# 状态转移决策：给定 当前态 + 事件，返回 新态；非法转移返回空（由调用方包装错误信封）
段落 决策窗口转移(当前态, 事件):
  # closed
  如果 当前态 == "closed" 且 事件 == "open":
    返回 "opening"
  # opening
  如果 当前态 == "opening" 且 事件 == "open":
    返回 "open"
  如果 当前态 == "opening" 且 事件 == "focus":
    返回 "focused"
  如果 当前态 == "opening" 且 事件 == "blur":
    返回 "blurred"
  # open
  如果 当前态 == "open" 且 事件 == "focus":
    返回 "focused"
  如果 当前态 == "open" 且 事件 == "blur":
    返回 "blurred"
  # focused / blurred 之间
  如果 当前态 == "focused" 且 事件 == "blur":
    返回 "blurred"
  如果 当前态 == "blurred" 且 事件 == "focus":
    返回 "focused"
  # close-request 从任一可视态进入 closing
  如果 当前态 == "focused" 且 事件 == "close-request":
    返回 "closing"
  如果 当前态 == "open" 且 事件 == "close-request":
    返回 "closing"
  如果 当前态 == "blurred" 且 事件 == "close-request":
    返回 "closing"
  # closing + closed 收尾
  如果 当前态 == "closing" 且 事件 == "closed":
    返回 "closed"
  返回 空

# 对外转移入口：合法 -> {"成功":真,"新状态":...}；非法 -> {"成功":假,"原因":...}（fail-closed）
段落 窗口状态转移(当前态, 事件):
  如果 是合法窗口状态(当前态) == 假:
    返回 {"成功": 假, "原因": "非法当前窗口状态: " + 当前态, "新状态": 空}
  设 新态 为 决策窗口转移(当前态, 事件)
  如果 新态 == 空:
    返回 {"成功": 假, "原因": "非法转移 " + 当前态 + " -[" + 事件 + "]-> ?", "新状态": 当前态}
  返回 {"成功": 真, "新状态": 新态, "原因": 空}

# =====================================================================
# 窗口配置纯逻辑校验
#   配置字段：宽/高/最小宽/最小高/可调整尺寸/全屏/最大化/位置X/位置Y
#   规则：
#     1. 宽 >= 最小宽 且 高 >= 最小高（最小宽/高缺省 200）
#     2. 位置边界：位置X >= 0 且 位置Y >= 0
#     3. 全屏与最大化互斥（Electron 中二者不能同时为真）
# =====================================================================
段落 取配置数(配置, 键, 默认值):
  设 值 为 字典获取(配置, 键, 空)
  如果 值 == 空:
    返回 默认值
  返回 值

段落 校验窗口配置(配置):
  设 最小宽 为 取配置数(配置, "最小宽", 200)
  设 最小高 为 取配置数(配置, "最小高", 200)
  设 宽 为 取配置数(配置, "宽", 800)
  设 高 为 取配置数(配置, "高", 600)
  # 规则1：最小尺寸
  如果 宽 < 最小宽:
    返回 {"通过": 假, "原因": "窗口宽 " + 转字符串(宽) + " 小于最小宽 " + 转字符串(最小宽)}
  如果 高 < 最小高:
    返回 {"通过": 假, "原因": "窗口高 " + 转字符串(高) + " 小于最小高 " + 转字符串(最小高)}
  # 规则2：位置边界
  设 位置X 为 取配置数(配置, "位置X", 0)
  设 位置Y 为 取配置数(配置, "位置Y", 0)
  如果 位置X < 0:
    返回 {"通过": 假, "原因": "窗口位置X不能为负: " + 转字符串(位置X)}
  如果 位置Y < 0:
    返回 {"通过": 假, "原因": "窗口位置Y不能为负: " + 转字符串(位置Y)}
  # 规则3：全屏与最大化互斥
  设 全屏 为 字典获取(配置, "全屏", 假)
  设 最大化 为 字典获取(配置, "最大化", 假)
  如果 全屏 == 真 且 最大化 == 真:
    返回 {"通过": 假, "原因": "全屏与最大化互斥，不能同时为真"}
  返回 {"通过": 真, "原因": 空}

# =====================================================================
# 多窗口管理器（纯逻辑：窗口表 + 活跃窗口指针；不持有真实窗口句柄）
#   窗口表项：{窗口ID: {"状态":..., "配置":...}}
# =====================================================================
类 窗口管理器:
  属性 窗口表 等于 空
  属性 活跃窗口 等于 空

  段落 构造:
    己.窗口表 为 {}
    己.活跃窗口 为 空

  # 打开一个窗口：写入窗口表，状态 opening，并设为活跃
  段落 打开(己, 窗口ID, 配置):
    设 校验 为 校验窗口配置(配置)
    如果 校验["通过"] == 假:
      返回 校验
    如果 己.窗口表.包含(窗口ID):
      返回 {"通过": 假, "原因": "窗口已存在: " + 窗口ID}
    设 项 为 {"状态": "opening", "配置": 配置}
    己.窗口表[窗口ID] 为 项
    己.活跃窗口 为 窗口ID
    返回 {"通过": 真, "原因": 空}

  # 对某窗口推进状态转移
  段落 转移(己, 窗口ID, 事件):
    如果 己.窗口表.包含(窗口ID) == 假:
      返回 {"成功": 假, "原因": "窗口不存在: " + 窗口ID, "新状态": 空}
    设 当前态 为 己.窗口表[窗口ID]["状态"]
    设 结果 为 窗口状态转移(当前态, 事件)
    如果 结果["成功"]:
      己.窗口表[窗口ID]["状态"] 为 结果["新状态"]
      # focus 事件把目标窗口设为活跃
      如果 事件 == "focus":
        己.活跃窗口 为 窗口ID
      # closed 收尾：从窗口表移除
      如果 结果["新状态"] == "closed":
        字典删除(己.窗口表, 窗口ID)
        如果 己.活跃窗口 == 窗口ID:
          己.活跃窗口 为 空
    返回 结果

  # 聚焦某窗口
  段落 聚焦(己, 窗口ID):
    返回 己.转移(窗口ID, "focus")

  # 关闭请求某窗口
  段落 关闭请求(己, 窗口ID):
    返回 己.转移(窗口ID, "close-request")

  # 列表：当前非 closed 的窗口ID
  段落 列表(己):
    设 结果 为 []
    遍历 ID 之 己.窗口表:
      结果.追加(ID)
    返回 结果

# 便捷工厂
段落 造窗口管理器:
  设 管理器 为 新建 窗口管理器()
  返回 管理器
