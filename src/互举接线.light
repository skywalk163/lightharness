# 互举接线.light —— 第40轮 任务1：端到端互举链路装配层
#
# 目标：把 R34~R39 的 8 个新模块（系统提示/作用域/工具展示/工具执行/子代理深化/
#      会话日志深化/代理默认模型/中止）通过 5 个集成点串成真实多轮 agent 链路，
#      不改动既有 src 模块（零修改适配层）。
#
# 5 集成点：
#   集成点1：system-prompt 组装进 llm 步骤（3节+1上下文+1变量 → 渲染）
#   集成点2：作用域管理接入会话上下文（作用域链 + 组装上下文 scope 传递）
#   集成点3：工具展示模式进工具执行流水线（native/ptc/both → 可见工具 → 执行）
#   集成点4：子代理深化 + 会话日志深化（子会话走同一链路，日志可查询）
#   集成点5：中止恢复（中止令牌 + 检查点 + 恢复）
#
# 铁律：
#   - 优先零修改适配层：本模块只组装，不改动既有 src 模块
#   - LLM 必须确定性：本模块不接真实 API，端到端用「消息字典」模拟 LLM 步骤
#   - 中止恢复用 src/中止.light 的 中止令牌 + 上下文检查点
#
# 运行：cd lightharness && python 运行.py examples/test_R40_端到端互举.light
# 判据：rc=0

从 系统提示 导入 建系统提示注册表, 注册节, 注册上下文, 注册变量
从 系统提示 导入 组装系统提示, 渲染提示, 渲染上下文快照
从 系统提示 导入 节顺序常量表, 上下文顺序常量表
从 系统提示 导入 部署角色前缀节名, 部署角色后缀节名
从 作用域 导入 建作用域键, 是作用域键, 作用域键ID, 作用域键标签
从 作用域 导入 绑定父作用域, 取父作用域, 取作用域链
从 工具展示 导入 工具展示模式表, 校验展示模式
从 工具展示 导入 建工具展示配置, 应用工具展示, 注销工具展示
从 工具展示 导入 获取作用域展示
从 工具执行 导入 建注册表, 具注册工具, 取工具, 工具名表, 列出工具
从 工具执行 导入 建执行器, 执行工具
从 工具执行 导入 策略滑动窗
从 工具执行 导入 级公开
从 中止 导入 中止令牌, 新建令牌

# =====================================================================
# §0 常量与工具类型
# =====================================================================

设 互举链路上下文形态 为 "互举链路上下文"

设 链路事件类型表 为 [
  "系统提示组装", "作用域过滤", "工具注册", "工具展示",
  "工具执行", "子代理委派", "中止", "检查点", "恢复"
]

# =====================================================================
# §1 装配上下文构造 + 事件记录
# =====================================================================

段落 建互举链路上下文:
  返回 {
    "形态": 互举链路上下文形态,
    "系统提示注册表": 空,
    "作用域键": 空,
    "工具展示配置": 空,
    "工具执行注册表": 空,
    "中止令牌": 空,
    "日志事件表": [],
    "检查点表": []
  }

段落 记事件(上下文, 事件类型, 详情):
  上下文["日志事件表"].追加({
    "类型": 事件类型,
    "详情": 详情,
    "序号": 长(上下文["日志事件表"]) + 1
  })
  返回 上下文["日志事件表"][-1]

段落 查事件(上下文, 事件类型):
  设 结果 为 []
  遍历 事件 之 上下文["日志事件表"]:
    如果 事件["类型"] == 事件类型:
      结果.追加(事件)
  返回 结果

# =====================================================================
# §2 集成点 1：system-prompt 组装进 llm 步骤
# =====================================================================

段落 初始LLM步骤系统提示(上下文):
  设 提示表 为 建系统提示注册表()
  上下文["系统提示注册表"] 为 提示表
  注册节(提示表, 部署角色前缀节名, 节顺序常量表["DEPLOYMENT_PERSONA_PREFIX"], "你是商汤小浣熊")
  注册节(提示表, "plan_policy", 节顺序常量表["PLAN_POLICY"], "计划策略：分步骤执行")
  注册节(提示表, "tool_read", 节顺序常量表["TOOL_READ"], "工具：读取文件由 {{persona}} 完成")
  注册上下文(提示表, "sandbox_policy", 上下文顺序常量表["SANDBOX_POLICY"], "沙箱：默认开启")
  注册变量(提示表, "persona", "小浣熊")
  记事件(上下文, "系统提示组装", "注册 3节 + 1上下文 + 1变量")
  返回 提示表

段落 组装LLM步骤提示(上下文, 作用域键=空):
  设 提示表 为 上下文["系统提示注册表"]
  设 组装上下文 为 {"作用域": 作用域键, "信号": 空}
  设 装配 为 组装系统提示(提示表, 组装上下文)
  设 提示文本 为 渲染提示(装配)
  记事件(上下文, "系统提示组装", "渲染长度=" + 转字符串(长(提示文本)))
  返回 提示文本

# =====================================================================
# §3 集成点 2：作用域管理接入会话上下文
# =====================================================================

段落 建作用域链(上下文):
  设 主键 为 建作用域键("agent-main")
  上下文["作用域键"] 为 主键
  设 子键 为 建作用域键("agent-sub")
  绑定父作用域(子键, 主键)
  记事件(上下文, "作用域过滤", "主=" + 作用域键ID(主键) + " 子=" + 作用域键ID(子键))
  返回 [主键, 子键]

段落 作用域过滤组装(上下文, 作用域键):
  设 提示表 为 上下文["系统提示注册表"]
  设 组装上下文 为 {"作用域": 作用域键, "信号": 空}
  设 装配 为 组装系统提示(提示表, 组装上下文)
  设 标签 为 "未知"
  如果 作用域键 != 空:
    标签 为 作用域键ID(作用域键)
  记事件(上下文, "作用域过滤", "作用域=" + 标签 + " 节数=" + 转字符串(长(装配["节列表"])))
  返回 装配

# =====================================================================
# §4 集成点 3：工具展示模式进工具执行流水线
# =====================================================================

# 测试工具处理函数：读取文件模拟（接收 参数, 取消令牌）
段落 测试读文件处理(参数, 取消令牌):
  设 路径 为 "unknown"
  如果 参数 != 空 且 字典包含键(参数, "path"):
    路径 为 参数["path"]
  返回 {"文件": 路径, "内容": "test-content", "字节数": 12}

# 注册测试工具：注册 2 个测试工具（读文件/写文件）
段落 注册测试工具(上下文):
  设 注册表 为 建注册表()
  上下文["工具执行注册表"] 为 注册表
  具注册工具(注册表, "read_file", 级公开, 测试读文件处理, 空)
  具注册工具(注册表, "write_file", 级公开, 测试读文件处理, 空)
  记事件(上下文, "工具注册", "注册 2 工具")
  返回 注册表

段落 应用工具展示模式(上下文, 作用域ID, 模式):
  如果 校验展示模式(模式) == 假:
    抛出 新建 错误("互举接线：非法工具展示模式 '" + 模式 + "'")
  设 配置 为 建工具展示配置(模式)
  应用工具展示(配置, 作用域ID, 上下文["工具执行注册表"], 空)
  上下文["工具展示配置"] 为 配置
  记事件(上下文, "工具展示", "模式=" + 模式 + " 作用域=" + 作用域ID)
  返回 配置

# 取作用域展示模式（验证集成点：模式已注册到作用域）
段落 取作用域展示模式(作用域ID):
  返回 获取作用域展示(作用域ID)

段落 执行工具全链路(上下文, 工具名, 参数=空):
  # R73-E · L-158：建执行器 现支持 既有注册表 参数——直接共享上下文注册表，
  # 外部注册的工具自动可见，镜像循环（逐工具 具注册工具 到执行器注册表）
  # 已删除。传入的是引用：执行器与上下文注册表双向同步。
  设 执行器 为 建执行器(10, 1000, 0, 策略滑动窗, 上下文["工具执行注册表"])
  设 结果 为 执行工具(执行器, 工具名, 级公开, "agent-main", 参数, 空)
  记事件(上下文, "工具执行", "工具=" + 工具名 + " 状态=" + 转字符串(结果.获取("状态", "")))
  返回 结果

# =====================================================================
# §5 集成点 4：子代理深化 + 会话日志深化
# =====================================================================

段落 委派子代理(上下文, 子任务描述):
  设 主键 为 上下文["作用域键"]
  设 子键 为 建作用域键("subagent")
  绑定父作用域(子键, 主键)
  设 子上下文 为 {
    "形态": 互举链路上下文形态,
    "系统提示注册表": 上下文["系统提示注册表"],
    "作用域键": 子键,
    "工具展示配置": 上下文["工具展示配置"],
    "工具执行注册表": 上下文["工具执行注册表"],
    "中止令牌": 上下文["中止令牌"],
    "日志事件表": [],
    "检查点表": []
  }
  记事件(子上下文, "子代理委派", "任务=" + 子任务描述)
  记事件(上下文, "子代理委派", "委派=" + 子任务描述)
  返回 子上下文

# =====================================================================
# §6 集成点 5：中止恢复
# =====================================================================

段落 建中止令牌到上下文(上下文):
  设 令牌 为 新建令牌()
  上下文["中止令牌"] 为 令牌
  记事件(上下文, "中止", "令牌已建")
  返回 令牌

段落 保存检查点(上下文, 标签):
  设 检查点 为 {
    "标签": 标签,
    "序号": 长(上下文["检查点表"]) + 1,
    "日志事件数": 长(上下文["日志事件表"]),
    "作用域键": 上下文["作用域键"],
    "工具展示配置": 上下文["工具展示配置"]
  }
  上下文["检查点表"].追加(检查点)
  记事件(上下文, "检查点", "标签=" + 标签)
  返回 检查点

段落 中止会话(上下文, 原因):
  设 令牌 为 上下文["中止令牌"]
  令牌.触发(原因)
  记事件(上下文, "中止", "原因=" + 原因)
  返回 令牌.已中止()

段落 恢复会话(上下文, 检查点标签):
  设 目标 为 空
  遍历 检查点 之 上下文["检查点表"]:
    如果 检查点["标签"] == 检查点标签:
      目标 为 检查点
  如果 目标 == 空:
    抛出 新建 错误("互举接线：找不到检查点 '" + 检查点标签 + "'")
  设 新令牌 为 新建令牌()
  上下文["中止令牌"] 为 新令牌
  记事件(上下文, "恢复", "检查点=" + 检查点标签)
  返回 目标

# =====================================================================
# §7 端到端驱动
# =====================================================================

段落 驱动一轮链路(用户消息):
  设 上下文 为 建互举链路上下文()
  初始LLM步骤系统提示(上下文)
  设 链 为 建作用域链(上下文)
  组装LLM步骤提示(上下文, 链[0])
  注册测试工具(上下文)
  应用工具展示模式(上下文, "agent-main", "native")
  取作用域展示模式("agent-main")
  建中止令牌到上下文(上下文)
  保存检查点(上下文, "pre-step")
  委派子代理(上下文, "子任务示例")
  记事件(上下文, "工具执行", "消息=" + 用户消息)
  返回 上下文

# =====================================================================
# 导出
# =====================================================================

导出 互举链路上下文形态
导出 链路事件类型表
导出 建互举链路上下文
导出 记事件
导出 查事件

导出 初始LLM步骤系统提示
导出 组装LLM步骤提示

导出 建作用域链
导出 作用域过滤组装

导出 测试读文件处理
导出 注册测试工具
导出 应用工具展示模式
导出 取作用域展示模式
导出 执行工具全链路

导出 委派子代理

导出 建中止令牌到上下文
导出 保存检查点
导出 中止会话
导出 恢复会话

导出 驱动一轮链路
