# 文件系统工具.light —— 对标上游 packages/fs/tool-fs/src/（11 文件，a305303422）
# 通用文件工具 read / write / edit / read_image 的纯逻辑面（对标 #92），与
#   字符串替换编辑器.light（#86 专用编辑器）同域互补。
#
# 上游结构映射：
#   error.ts        -> 提示读错误 守卫编辑前提（FS_NOT_OBSERVED / FS_STALE_VERSION 文案）
#   read.ts         -> 解析读参数（READ_LIMIT=2000、offset 默认 1、limit 默认/上限 maxLimit）
#   read-target.ts  -> 判读目标错误文案（FS_NOT_FOUND / FS_NOT_REGULAR_FILE）
#   read-render.ts  -> 造读窗口 + 渲染读输出 + 语言自路径（READ_MAX_LINE_LENGTH=2000、READ_MAX_BYTES=51200）
#   read-image.ts   -> 图媒体类型 造图元数据 渲染图输出（PNG/JPEG/WebP/GIF 扩展名+字节签名嗅探；
#                      AttachmentRef 形状，宿主解码/降采样剔除）
#   write.ts        -> 判写参数 + 写后信封（create-or-overwrite；无追加/创建标志参数）
#   edit.ts         -> 校验编辑参数 + 施加编辑（replace_all / 唯一命中，多命中策略在本层判定）
#   diff.ts         -> 行差分表（LCS 行级 diff，DIFF_CONTEXT=3）+ 差异到文件差异 + 渲染统一差异文本
#   index.ts        -> 执行读命令/执行写命令/执行编辑命令 分发 + 呈现形状
#   sandbox.ts / session-cwd.ts -> 宿主面剔除（登记）
#
# 宿主入参字典（宿主）：
#   "查信息" 段落(路径) -> ["类型","大小","版本"] 或 空；"读文本" 段落(路径)；"写文本" 段落(路径,内容)；
#   "读头字节" 段落(路径,字节数) -> 整数列表（图片嗅探）；"读上限"/"行上限"/"字节上限" 可选数。
# 行为差异：行字节预算以码点计数近似 UTF-8 字节（登记 R14-D1）。
# 绕法：内置裸名（L-090）、无花括号文案（L-089）、无 且/或 行内链（L-043）、标识符避关键字（L-084/L-092）。

导出 提示读错误 守卫编辑前提 解析读参数 判读目标 造读窗口 渲染读输出 语言自路径 图媒体类型 造图元数据 渲染图输出 判写参数 写操作判定 写后信封 校验编辑参数 收集命中 施加编辑 编辑后文案 行差分表 差异到文件差异 渲染统一差异文本 呈现读调用 呈现写调用 呈现编辑调用 执行读命令 执行写命令 执行编辑命令。

设 读上限默认 为 2000
设 读行上限默认 为 2000
设 读字节上限默认 为 51200
设 差异上下文 为 3

# ---------------- error.ts：错误提示 ----------------
# FS_NOT_OBSERVED：未先读即改（守卫）；FS_STALE_VERSION：版本过期文案追加续读提示
段落 提示读错误(码, 显示路径, 原因文本):
  如果 码 == "FS_NOT_OBSERVED":
    返回 "cannot modify \"" + 显示路径 + "\": file has not been read — read the file, then retry"
  如果 码 == "FS_STALE_VERSION":
    返回 原因文本 + " — re-read the file, then retry"
  返回 原因文本

# 编辑守卫（write/edit 的观察策略，纯逻辑投影）：已观察 + 版本一致才许可
段落 守卫编辑前提(已观察, 期望版本, 当前版本, 显示路径):
  如果 已观察 == 假:
    返回 ["许可": 假, "文案": 提示读错误("FS_NOT_OBSERVED", 显示路径, "")]
  如果 期望版本 != 空:
    如果 期望版本 != 当前版本:
      返回 ["许可": 假, "文案": 提示读错误("FS_STALE_VERSION", 显示路径, "stale file version")]
  返回 ["许可": 真, "文案": ""]

# ---------------- read.ts：参数解析 ----------------
段落 解析读参数(参数, 最大上限):
  设 路径 为 字典获取(参数, "file_path", 空)
  如果 是字符串(路径) == 假:
    抛出 新建 错误("file_path must be a non-empty string")
  如果 字符串长度(去除空白(路径)) == 0:
    抛出 新建 错误("file_path must be a non-empty string")
  设 偏移 为 字典获取(参数, "offset", 1)
  设 上限 为 字典获取(参数, "limit", 最大上限)
  如果 是整数(偏移) == 假:
    抛出 新建 错误("offset must be a positive integer")
  如果 偏移 < 1:
    抛出 新建 错误("offset must be a positive integer")
  如果 是整数(上限) == 假:
    抛出 新建 错误("limit must be a positive integer")
  如果 上限 < 1:
    抛出 新建 错误("limit must be a positive integer")
  如果 上限 > 最大上限:
    抛出 新建 错误("limit must be less than or equal to " + 转字符串(最大上限))
  返回 ["路径": 路径, "偏移": 偏移, "上限": 上限]

# ---------------- read-target.ts：目标判别 ----------------
# 信息 = ["类型","大小","版本"] 或 空；返回错误文案或空（空=可读）
段落 判读目标(信息, 显示路径):
  如果 信息 == 空:
    返回 "cannot read \"" + 显示路径 + "\": not found"
  如果 信息["类型"] != "文件":
    返回 "cannot read \"" + 显示路径 + "\": not a regular file"
  返回 ""

# ---------------- read-render.ts：窗口与渲染 ----------------
# 行扫描窗口：总行数全量计数；行收入条件=行号>=偏移 且 已收<上限 且 预算未超
# 行表项 ["号", "文本"]；单行超 行上限 截断加尾注；字节预算按码点近似（行为差异登记）
段落 造读窗口(全行表, 偏移, 上限, 显示路径, 行上限, 字节上限):
  设 总行数 为 列表长度(全行表)
  设 收行表 为 []
  设 已收 为 0
  设 已用 为 0
  设 字节截断 为 假
  设 序号 为 1
  当 序号 <= 总行数:
    设 行文本 为 全行表[序号 - 1]
    如果 字符串长度(行文本) > 行上限:
      设 行文本 为 截取(行文本, 0, 行上限) + "... (line truncated to " + 转字符串(行上限) + " chars)"
    如果 序号 >= 偏移:
      如果 已收 < 上限:
        # 行字节 = 码点数 + 分隔换行（首行不计分隔）
        设 行花 为 字符串长度(行文本)
        如果 已收 > 0:
          设 行花 为 行花 + 1
        如果 已用 + 行花 > 字节上限:
          设 字节截断 为 真
        否则:
          设 已用 为 已用 + 行花
          设 行项 为 {}
          行项["号"] 为 序号
          行项["文本"] 为 行文本
          列表追加(收行表, 行项)
          设 已收 为 已收 + 1
    设 序号 为 序号 + 1
  # offset 越 EOF（空文件且 offset==1 放行）
  如果 已收 == 0:
    如果 字节截断 == 假:
      如果 总行数 > 0:
        如果 偏移 > 总行数:
          抛出 新建 错误("offset " + 转字符串(偏移) + " is out of range for \"" + 显示路径 + "\" (" + 转字符串(总行数) + " lines)")
  返回 ["行表": 收行表, "总行数": 总行数, "字节截断": 字节截断, "末行号": 偏移 + 已收 - 1]

# footer 三态 + envelope（formatReadOutput 逐字模板）
段落 渲染读输出(显示路径, 窗口):
  设 行表 为 窗口["行表"]
  设 总行数 为 窗口["总行数"]
  设 行文本表 为 []
  遍历 行项 之 行表:
    列表追加(行文本表, 转字符串(行项["号"]) + ": " + 行项["文本"])
  设 尾注 为 ""
  如果 窗口["字节截断"]:
    设 尾注 为 "(Output capped. Showing lines " + 转字符串(窗口["行表"][0]["号"]) + "-" + 转字符串(窗口["末行号"]) + ". Use offset=" + 转字符串(窗口["末行号"] + 1) + " to continue.)"
  否则:
    如果 列表长度(行表) > 0:
      如果 窗口["末行号"] < 总行数:
        设 尾注 为 "(Showing lines " + 转字符串(行表[0]["号"]) + "-" + 转字符串(窗口["末行号"]) + " of " + 转字符串(总行数) + ". Use offset=" + 转字符串(窗口["末行号"] + 1) + " to continue.)"
    如果 尾注 == "":
      设 末号 为 窗口["末行号"]
      如果 末号 < 0:
        设 末号 为 0
      设 尾注 为 "(End of file - total " + 转字符串(总行数) + " lines)"
  设 正文 为 连接字符串(行文本表, "\n")
  返回 "<path>" + 显示路径 + "</path>\n<type>file</type>\n<content>\n" + 正文 + "\n\n" + 尾注 + "\n</content>"

# 扩展名 -> 高亮语言提示（langFromPath 子集；未知/点文件返回 空）
段落 语言自路径(路径):
  设 名 为 路径
  设 点位 为 最后索引(名, ".")
  如果 点位 < 0:
    返回 空
  设 扩展 为 转小写(截取到末尾(名, 点位 + 1))
  设 映射 为 {"ts": "ts", "tsx": "tsx", "js": "js", "jsx": "jsx", "json": "json", "py": "py", "rb": "rb", "go": "go", "rs": "rs", "java": "java", "c": "c", "h": "c", "cpp": "cpp", "hpp": "cpp", "cs": "cs", "kt": "kotlin", "swift": "swift", "php": "php", "sh": "sh", "bash": "sh", "zsh": "sh", "yaml": "yaml", "yml": "yaml", "toml": "toml", "ini": "ini", "md": "md", "html": "html", "htm": "html", "css": "css", "scss": "scss", "sql": "sql", "xml": "xml", "lua": "lua"}
  如果 字典包含键(映射, 扩展):
    返回 字典获取(映射, 扩展, 空)
  返回 空

# ---------------- read-image.ts：格式与形状 ----------------
# 扩展名声明优先；无扩展名按头字节签名嗅探；返回媒体类型或 空
段落 图媒体类型(路径, 头字节表):
  设 名 为 路径
  设 点位 为 最后索引(名, ".")
  设 声明 为 空
  如果 点位 >= 0:
    设 扩展 为 转小写(截取到末尾(名, 点位 + 1))
    设 扩展映射 为 {"png": "image/png", "jpg": "image/jpeg", "jpeg": "image/jpeg", "webp": "image/webp", "gif": "image/gif"}
    如果 字典包含键(扩展映射, 扩展):
      设 声明 为 字典获取(扩展映射, 扩展, 空)
    否则:
      抛出 新建 错误("cannot read \"" + 路径 + "\": the " + 扩展 + " extension does not declare a supported image format; read_image accepts PNG/JPEG/WebP/GIF files, including extension-less files in those formats")
  如果 声明 != 空:
    返回 声明
  # 字节签名嗅探
  设 字节数 为 列表长度(头字节表)
  如果 字节数 >= 8:
    如果 头字节表[0] == 137:
      如果 头字节表[1] == 80:
        如果 头字节表[2] == 78:
          如果 头字节表[3] == 71:
            返回 "image/png"
  如果 字节数 >= 3:
    如果 头字节表[0] == 255:
      如果 头字节表[1] == 216:
        如果 头字节表[2] == 255:
          返回 "image/jpeg"
  如果 字节数 >= 6:
    设 签名 为 ""
    设 序号 为 0
    当 序号 < 6:
      设 签名 为 签名 + 字符自码位(头字节表[序号])
      设 序号 为 序号 + 1
    如果 签名 == "GIF87a":
      返回 "image/gif"
    如果 签名 == "GIF89a":
      返回 "image/gif"
  如果 字节数 >= 12:
    设 头四 为 ""
    设 序号 为 0
    当 序号 < 4:
      设 头四 为 头四 + 字符自码位(头字节表[序号])
      设 序号 为 序号 + 1
    设 网页四 为 ""
    设 序号 为 8
    当 序号 < 12:
      设 网页四 为 网页四 + 字符自码位(头字节表[序号])
      设 序号 为 序号 + 1
    如果 头四 == "RIFF":
      如果 网页四 == "WEBP":
        返回 "image/webp"
  抛出 新建 错误("cannot read \"" + 路径 + "\": the file content is not a supported image format; read_image accepts PNG/JPEG/WebP/GIF")

# ImageAttachmentRef 形状（宿主解码产出尺寸/字节，此处构造形状）
段落 造图元数据(附件标识, 媒体类型, 字节数, 宽, 高, 名称, 原始宽, 原始高):
  设 元 为 {}
  元["attachmentId"] 为 附件标识
  元["mediaType"] 为 媒体类型
  元["bytes"] 为 字节数
  元["width"] 为 宽
  元["height"] 为 高
  如果 名称 != 空:
    元["name"] 为 名称
  如果 原始宽 != 空:
    设 原 为 {}
    原["width"] 为 原始宽
    原["height"] 为 原始高
    元["originalDimensions"] 为 原
  返回 元

# 图片文本 envelope + 降采样后缀
段落 渲染图输出(显示路径, 元数据):
  设 说明 为 元数据["mediaType"] + " image, " + 转字符串(元数据["width"]) + "x" + 转字符串(元数据["height"]) + " px, " + 转字符串(元数据["bytes"]) + " bytes"
  如果 字典包含键(元数据, "originalDimensions"):
    设 原 为 元数据["originalDimensions"]
    # 上游 toFixed(2) 形态近似（两轴比率相等才单轴提示；浮点文本形态差异登记 R14-D1）
    设 比率 为 原["width"] / 元数据["width"]
    设 说明 为 说明 + " (downscaled from " + 转字符串(原["width"]) + "x" + 转字符串(原["height"]) + " px; multiply coordinates by " + 转字符串(比率) + " to locate features in the original file)"
  返回 "<path>" + 显示路径 + "</path>\n<type>image</type>\n<content>\n" + 说明 + "\n</content>"

# ---------------- write.ts ----------------
段落 判写参数(参数):
  设 路径 为 字典获取(参数, "file_path", 空)
  如果 是字符串(路径) == 假:
    抛出 新建 错误("file_path must be a non-empty string")
  如果 字符串长度(去除空白(路径)) == 0:
    抛出 新建 错误("file_path must be a non-empty string")
  如果 字典包含键(参数, "content") == 假:
    抛出 新建 错误("content must be a string")
  设 内容 为 参数["content"]
  如果 是字符串(内容) == 假:
    抛出 新建 错误("content must be a string")
  返回 ["路径": 路径, "内容": 内容]

# create-or-overwrite：目标此前不存在为 create
段落 写操作判定(之前存在):
  如果 之前存在:
    返回 "update"
  返回 "create"

# 写后确认信封（不回显内容）
段落 写后信封(显示路径, 操作):
  设 动词 为 "Updated"
  如果 操作 == "create":
    设 动词 为 "Created"
  返回 "<path>" + 显示路径 + "</path>\n<type>file</type>\n<content>\n" + 动词 + " file\n</content>"

# ---------------- edit.ts ----------------
段落 校验编辑参数(参数):
  设 路径 为 字典获取(参数, "file_path", 空)
  如果 是字符串(路径) == 假:
    抛出 新建 错误("file_path must be a non-empty string")
  如果 字符串长度(去除空白(路径)) == 0:
    抛出 新建 错误("file_path must be a non-empty string")
  设 旧串 为 字典获取(参数, "old_string", 空)
  如果 是字符串(旧串) == 假:
    抛出 新建 错误("old_string must be a non-empty string")
  如果 字符串长度(旧串) == 0:
    抛出 新建 错误("old_string must be a non-empty string")
  设 新串 为 字典获取(参数, "new_string", 空)
  如果 是字符串(新串) == 假:
    抛出 新建 错误("new_string must be a string")
  如果 旧串 == 新串:
    抛出 新建 错误("old_string and new_string must differ")
  设 全部 为 字典获取(参数, "replace_all", 假)
  返回 ["路径": 路径, "旧串": 旧串, "新串": 新串, "全部替换": 全部]

# indexOf 循环推进收集全部命中偏移（空搜索返回空表）
段落 收集命中(内容, 搜索):
  设 偏移表 为 []
  如果 字符串长度(搜索) == 0:
    返回 偏移表
  设 已扫 为 0
  当 真:
    设 相对 为 查找子串(截取到末尾(内容, 已扫), 搜索)
    如果 相对 < 0:
      跳出
    列表追加(偏移表, 已扫 + 相对)
    设 已扫 为 已扫 + 相对 + 字符串长度(搜索)
  返回 偏移表

# 施加编辑：replace_all=假 要求恰好一次（多命中抛）；真=全替换
# 后端唯一性文案不可见（dsh-fs 契约），多命中文案按语义拟定，登记 R14-D1
段落 施加编辑(内容, 旧串, 新串, 全部替换):
  设 命中表 为 收集命中(内容, 旧串)
  设 次数 为 列表长度(命中表)
  如果 次数 == 0:
    返回 ["许可": 假, "内容": ""]
  如果 全部替换:
    返回 ["许可": 真, "内容": 替换字符串(内容, 旧串, 新串)]
  如果 次数 > 1:
    抛出 新建 错误("old_string matched " + 转字符串(次数) + " times in file; provide a more specific old_string or set replace_all=true")
  设 首 为 命中表[0]
  返回 ["许可": 真, "内容": 截取(内容, 0, 首) + 新串 + 截取到末尾(内容, 首 + 字符串长度(旧串))]

# edit 确认文案两条
段落 编辑后文案(显示路径, 全部替换):
  如果 全部替换:
    返回 "The file " + 显示路径 + " has been updated. All occurrences were successfully replaced."
  返回 "The file " + 显示路径 + " has been updated successfully."

# ---------------- diff.ts：LCS 行级差异 ----------------
# 经典 DP 最长公共子序列（字典键 "甲,乙"），回溯生成操作表，按 差异上下文=3 分组 hunk
# hunk 形状 ["前起","前数","后起","后数","行表"]（行表项 前缀+文本：上下文行无前缀）
段落 行差分表(前文本, 后文本):
  # jsdiff 空串语义：空文本无行（非 [""]）
  设 前行表 为 []
  如果 前文本 != "":
    设 前行表 为 分割字符串(前文本, "\n")
  设 后行表 为 []
  如果 后文本 != "":
    设 后行表 为 分割字符串(后文本, "\n")
  设 甲数 为 列表长度(前行表)
  设 乙数 为 列表长度(后行表)
  # DP 表
  设 表 为 {}
  设 甲 为 甲数 - 1
  当 甲 >= 0:
    设 乙 为 乙数 - 1
    当 乙 >= 0:
      设 值 为 0
      如果 前行表[甲] == 后行表[乙]:
        设 下键 为 转字符串(甲 + 1) + "," + 转字符串(乙 + 1)
        设 值 为 字典获取(表, 下键, 0) + 1
      否则:
        设 右键 为 转字符串(甲 + 1) + "," + 转字符串(乙)
        设 下键 为 转字符串(甲) + "," + 转字符串(乙 + 1)
        设 右值 为 字典获取(表, 右键, 0)
        设 下值 为 字典获取(表, 下键, 0)
        如果 右值 >= 下值:
          设 值 为 右值
        否则:
          设 值 为 下值
      表[转字符串(甲) + "," + 转字符串(乙)] 为 值
      设 乙 为 乙 - 1
    设 甲 为 甲 - 1
  # 回溯操作：单循环三态（主/删尾/增尾），["种", 前行号(1 基), 后行号(1 基), 文本]
  设 操作表 为 []
  设 甲 为 0
  设 乙 为 0
  当 真:
    设 走 为 "停"
    如果 甲 < 甲数:
      如果 乙 < 乙数:
        设 走 为 "主"
    如果 甲 < 甲数:
      如果 乙 >= 乙数:
        设 走 为 "删尾"
    如果 甲 >= 甲数:
      如果 乙 < 乙数:
        设 走 为 "增尾"
    如果 走 == "停":
      跳出
    如果 走 == "主":
      如果 前行表[甲] == 后行表[乙]:
        列表追加(操作表, ["种": "同", "前": 甲 + 1, "后": 乙 + 1, "文本": 前行表[甲]])
        设 甲 为 甲 + 1
        设 乙 为 乙 + 1
      否则:
        设 右键 为 转字符串(甲 + 1) + "," + 转字符串(乙)
        设 下键 为 转字符串(甲) + "," + 转字符串(乙 + 1)
        如果 字典获取(表, 右键, 0) >= 字典获取(表, 下键, 0):
          列表追加(操作表, ["种": "删", "前": 甲 + 1, "后": 乙 + 1, "文本": 前行表[甲]])
          设 甲 为 甲 + 1
        否则:
          列表追加(操作表, ["种": "增", "前": 甲 + 1, "后": 乙 + 1, "文本": 后行表[乙]])
          设 乙 为 乙 + 1
    如果 走 == "删尾":
      列表追加(操作表, ["种": "删", "前": 甲 + 1, "后": 乙 + 1, "文本": 前行表[甲]])
      设 甲 为 甲 + 1
    如果 走 == "增尾":
      列表追加(操作表, ["种": "增", "前": 甲 + 1, "后": 乙 + 1, "文本": 后行表[乙]])
      设 乙 为 乙 + 1
  # 无变更
  设 有变更 为 假
  遍历 操作 之 操作表:
    如果 操作["种"] != "同":
      设 有变更 为 真
  如果 有变更 == 假:
    返回 []
  # 变更点扩展 上下文 行分 hunk（重叠合并）
  设 区间表 为 []
  设 序号 为 0
  遍历 操作 之 操作表:
    如果 操作["种"] != "同":
      设 起 为 序号 - 差异上下文
      如果 起 < 0:
        设 起 为 0
      设 止 为 序号 + 差异上下文
      列表追加(区间表, [起, 止])
    设 序号 为 序号 + 1
  # 合并重叠区间（含相邻 1 行内合并）
  设 合并表 为 []
  遍历 区间 之 区间表:
    如果 列表长度(合并表) > 0:
      设 末区间 为 合并表[列表长度(合并表) - 1]
      如果 区间[0] <= 末区间[1] + 1:
        如果 区间[1] > 末区间[1]:
          设 末区间[1] 为 区间[1]
      否则:
        列表追加(合并表, [区间[0], 区间[1]])
    否则:
      列表追加(合并表, [区间[0], 区间[1]])
  # 每 hunk 切片操作表产出行
  设 块表 为 []
  遍历 区间 之 合并表:
    设 行表 为 []
    设 前起 为 空
    设 后起 为 空
    设 前数 为 0
    设 后数 为 0
    设 序号 为 区间[0]
    当 序号 <= 区间[1]:
      如果 序号 < 列表长度(操作表):
        设 操作 为 操作表[序号]
        如果 前起 == 空:
          设 前起 为 操作["前"]
          设 后起 为 操作["后"]
        如果 操作["种"] == "同":
          列表追加(行表, " " + 操作["文本"])
          设 前数 为 前数 + 1
          设 后数 为 后数 + 1
        如果 操作["种"] == "删":
          列表追加(行表, "-" + 操作["文本"])
          设 前数 为 前数 + 1
        如果 操作["种"] == "增":
          列表追加(行表, "+" + 操作["文本"])
          设 后数 为 后数 + 1
      设 序号 为 序号 + 1
    设 块 为 {}
    块["前起"] 为 前起
    块["前数"] 为 前数
    块["后起"] 为 后起
    块["后数"] 为 后数
    块["行表"] 为 行表
    列表追加(块表, 块)
  返回 块表

# computeHunkDiffs：hunk -> FileDiff {path, oldText(纯删除空时 null), newText}
段落 差异到文件差异(路径, 块表):
  设 前行表 为 []
  设 后行表 为 []
  遍历 块 之 块表:
    遍历 行 之 块["行表"]:
      设 前缀 为 字符串获取(行, 0)
      设 正文 为 截取到末尾(行, 1)
      如果 前缀 == "-":
        列表追加(前行表, 正文)
      如果 前缀 == "+":
        列表追加(后行表, 正文)
      如果 前缀 == " ":
        列表追加(前行表, 正文)
        列表追加(后行表, 正文)
  设 旧文本 为 连接字符串(前行表, "\n")
  设 差异 为 {}
  差异["path"] 为 路径
  如果 列表长度(前行表) == 0:
    差异["oldText"] 为 空
  否则:
    差异["oldText"] 为 旧文本
  差异["newText"] 为 连接字符串(后行表, "\n")
  返回 [差异]

# 统一差异文本（---/+++/@@ 头 + 行；jsdiff 形态：长度 1 省略 ,1）
段落 渲染统一差异文本(路径, 块表):
  设 输出 为 "--- a/" + 路径 + "\n+++ b/" + 路径 + "\n"
  遍历 块 之 块表:
    设 头 为 "@@ -" + 转字符串(块["前起"])
    如果 块["前数"] != 1:
      设 头 为 头 + "," + 转字符串(块["前数"])
    设 头 为 头 + " +" + 转字符串(块["后起"])
    如果 块["后数"] != 1:
      设 头 为 头 + "," + 转字符串(块["后数"])
    设 输出 为 输出 + 头 + " @@\n"
    遍历 行 之 块["行表"]:
      设 输出 为 输出 + 行 + "\n"
  返回 输出

# ---------------- 呈现形状 ----------------
段落 呈现读调用(路径, 偏移, 上限):
  设 标题 为 "Read " + 路径
  如果 上限 > 0:
    设 标题 为 标题 + " (" + 转字符串(偏移) + " - " + 转字符串(偏移 + 上限 - 1) + ")"
  返回 ["卡片": "generic", "标题": 标题, "种类": "read", "位置": [["路径": 路径, "行": 偏移]]]

段落 呈现写调用(路径, 内容):
  返回 ["卡片": "diff", "标题": "Write " + 路径, "差异": [["路径": 路径, "旧文本": 空, "新文本": 内容]], "位置": [["路径": 路径]]]

段落 呈现编辑调用(路径, 旧串, 新串):
  设 旧文本 为 旧串
  如果 旧文本 == "":
    设 旧文本 为 空
  返回 ["卡片": "diff", "标题": "Edit " + 路径, "差异": [["路径": 路径, "旧文本": 旧文本, "新文本": 新串]], "位置": [["路径": 路径]]]

# ---------------- 命令分发 ----------------
段落 执行读命令(参数, 宿主):
  设 上限值 为 字典获取(宿主, "读上限", 读上限默认)
  设 解析 为 解析读参数(参数, 上限值)
  设 显示路径 为 解析["路径"]
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(显示路径)
  设 目标错 为 判读目标(信息, 显示路径)
  如果 目标错 != "":
    抛出 新建 错误(目标错)
  设 读文本 为 宿主["读文本"]
  设 内容 为 读文本(显示路径)
  设 行上限值 为 字典获取(宿主, "行上限", 读行上限默认)
  设 字节上限值 为 字典获取(宿主, "字节上限", 读字节上限默认)
  设 窗口 为 造读窗口(分割字符串(内容, "\n"), 解析["偏移"], 解析["上限"], 显示路径, 行上限值, 字节上限值)
  # 观察登记（上游 emit fs/observed present 的宿主投影）
  设 快照 为 字典获取(宿主, "已观察", 空)
  如果 快照 != 空:
    设 快照[显示路径] 为 信息["版本"]
  返回 ["路径": 显示路径, "偏移": 解析["偏移"], "行表": 窗口["行表"], "总行数": 窗口["总行数"], "输出": 渲染读输出(显示路径, 窗口), "语言": 语言自路径(显示路径)]

段落 执行写命令(参数, 宿主):
  设 解析 为 判写参数(参数)
  设 显示路径 为 解析["路径"]
  设 查信息 为 宿主["查信息"]
  设 之前存在 为 查信息(显示路径) != 空
  设 写文本 为 宿主["写文本"]
  写文本(显示路径, 解析["内容"])
  设 操作 为 写操作判定(之前存在)
  返回 ["路径": 显示路径, "操作": 操作, "输出": 写后信封(显示路径, 操作)]

段落 执行编辑命令(参数, 宿主):
  设 解析 为 校验编辑参数(参数)
  设 显示路径 为 解析["路径"]
  # 观察守卫在前（上游 waterfall fs/edit-intent 先于 editText 的存在性检查）
  设 快照 为 字典获取(宿主, "已观察", {})
  设 已观察 为 字典获取(快照, 显示路径, 空)
  设 守卫 为 守卫编辑前提(已观察 != 空, 空, 空, 显示路径)
  如果 守卫["许可"] == 假:
    抛出 新建 错误(守卫["文案"])
  # 目标存在性（editText 契约投影）
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(显示路径)
  如果 信息 == 空:
    抛出 新建 错误("cannot edit \"" + 显示路径 + "\": not found")
  设 守卫二 为 守卫编辑前提(真, 已观察, 信息["版本"], 显示路径)
  如果 守卫二["许可"] == 假:
    抛出 新建 错误(守卫二["文案"])
  设 读文本 为 宿主["读文本"]
  设 原文 为 读文本(显示路径)
  设 施加 为 施加编辑(原文, 解析["旧串"], 解析["新串"], 解析["全部替换"])
  如果 施加["许可"] == 假:
    抛出 新建 错误("old_string did not appear verbatim in \"" + 显示路径 + "\"")
  设 写文本 为 宿主["写文本"]
  写文本(显示路径, 施加["内容"])
  # 记录已观察快照（版本推进）
  设 快照[显示路径] 为 信息["版本"] + 1
  返回 ["路径": 显示路径, "前文": 原文, "后文": 施加["内容"], "输出": 编辑后文案(显示路径, 解析["全部替换"]), "差异": 差异到文件差异(显示路径, 行差分表(原文, 施加["内容"]))]
