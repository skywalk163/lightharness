# 字符串替换编辑器.light —— 对标上游 packages/fs/tool-str-replace-editor/src/index.ts（531 行，a305303422）
# 模型面 str_replace_editor 工具的纯逻辑复刻：view / create / str_replace / insert 四命令
#   （上游无 undo，本轮亦不含）。
#
# 宿主面剔除（任务书 §8）：ctx.fs / cordis / sandboxPolicy / waterfall / emit / defineTool 注册
#   全部入参化——文件内容、存在性、目录条目、版本号由宿主/测试注入，本模块只做
#   「纯字符串/列表变换 + 校验 + 文案 + 命令呈现形状」。
#   宿主入参字典键：
#     "查信息"  段落(路径) -> ["类型": "文件"|"目录"|其他, "版本": 数] 或 空(不存在)
#     "读文本"  段落(路径) -> 文本
#     "写文本"  段落(路径, 内容)
#     "列目录"  段落(路径) -> 条目表 [ ["名": 文本, "类型": "文件"|"目录"|其他, "显示路径": 文本] ]
#     "上限"    数(可选，view 输出截断上限，默认 16000，对齐上游 maxOutputChars)
#
# 错误文案按任务书中文化模板对齐上游文案要点；命令呈现形状键中文化：
#   card->卡片 title->标题 kind->种类 diffs->差异 locations->位置 path->路径
#   oldText->旧文本 newText->新文本 line->行。
#
# 绕法备注：字符串原语一律用编译器内置裸名（L-090）；文案不含花括号（L-089）；
#   无 且/或 行内布尔链，一律拆嵌套 如果（L-043 规避）；标识符避开 为 字（L-084）。

导出 截断内容 收集命中偏移 偏移行号 整数表转文本 必填参数 解析目标 渲染视图行 格式化文件视图 目录行较前 收集目录行 造目录视图 查看路径 创建文件 替换于文件 插入于文件 呈现编辑调用 执行编辑命令。

# 上游 TRUNCATED_MESSAGE（L17）：尾注保留要点，反引号略去（光明文案不带反引号，登记语言差异）
设 截断尾注 为 "<response clipped><NOTE>To save on context only part of this file has been shown to you. You should retry this tool after you have searched inside the file with grep -n in order to find the line numbers of what you are looking for.</NOTE>"
# 上游 maxOutputChars 默认 16000（L514）
设 默认输出上限 为 16000

# maybeTruncate（L33-37）：内容不超上限原样返回；超限截到上限并附尾注
段落 截断内容 接收 内容, 上限:
  如果 字符串长度(内容) <= 上限:
    返回 内容
  返回 截取(内容, 0, 上限) + 截断尾注

# matchOffsets（L43-52）：indexOf 循环推进收集全部命中偏移；空搜索直接返回空表（防死循环）
段落 收集命中偏移 接收 内容, 搜索:
  设 偏移表 为 []
  如果 字符串长度(搜索) == 0:
    返回 偏移表
  设 已扫 为 0
  当 真:
    设 剩余 为 截取到末尾(内容, 已扫)
    设 相对 为 查找子串(剩余, 搜索)
    如果 相对 < 0:
      跳出
    列表追加(偏移表, 已扫 + 相对)
    设 已扫 为 已扫 + 相对 + 字符串长度(搜索)
  返回 偏移表

# lineNumbersAt（L54-64）：单游标递增扫描，按偏移给出所在行号（偏移表须升序）
段落 偏移行号 接收 内容, 偏移表:
  设 行号表 为 []
  设 行 为 1
  设 游标 为 0
  遍历 偏移 之 偏移表:
    当 游标 < 偏移:
      如果 字符串获取(内容, 游标) == "\n":
        设 行 为 行 + 1
      设 游标 为 游标 + 1
    列表追加(行号表, 行)
  返回 行号表

# 整数表转 ", " 连接文本（上游 join(', ')：view_range 提示与歧义行号共用）
段落 整数表转文本 接收 整数表:
  设 文本表 为 []
  遍历 值 之 整数表:
    列表追加(文本表, 转字符串(值))
  返回 连接字符串(文本表, ", ")

# requiredForCommand（L124-135）：缺省抛必填；allowEmpty=假 且空串抛为空
段落 必填参数 接收 值, 参数名, 命令名, 允许空:
  如果 是空(值):
    抛出 新建 错误("参数 " + 参数名 + " 是 " + 命令名 + " 命令必填")
  如果 允许空 == 假:
    如果 值 == "":
      抛出 新建 错误("参数 " + 参数名 + " 是 " + 命令名 + " 命令为空")
  返回 值

# resolveTarget（L89-99）路径校验：空串(trim 后)抛非空；非绝对(/ 开头)抛建议文案
段落 解析目标 接收 路径:
  如果 字符串长度(去除空白(路径)) == 0:
    抛出 新建 错误("路径必须为非空字符串")
  如果 开头(路径, "/") == 假:
    抛出 新建 错误("路径 " + 路径 + " 不是绝对路径，应以 / 开头。是不是想写 /" + 路径 + "？")
  返回 路径

# 行号渲染（L181）：6 位右对齐 + 两空格 + 行文本
段落 渲染视图行 接收 行号, 行文本:
  返回 字符串对齐右(转字符串(行号), 6, " ") + "  " + 行文本

# formatFileView（L137-184）：总行数提示、view_range 校验族、行号渲染、截断
段落 格式化文件视图 接收 路径, 内容, 上限, 视图范围:
  设 行表 为 分割字符串(内容, "\n")
  设 总行数 为 列表长度(行表)
  设 起 为 1
  设 止 为 空
  设 头 为 "这是 " + 路径 + " 的内容，带行号（这里有 " + 转字符串(总行数) + " 行）"
  如果 视图范围 != 空:
    如果 列表长度(视图范围) != 2:
      抛出 新建 错误("视图范围无效。应为两个整数组成的列表")
    设 起 为 视图范围[0]
    设 止 为 视图范围[1]
    如果 是整数(起) == 假:
      抛出 新建 错误("视图范围无效。应为两个整数组成的列表")
    如果 是整数(止) == 假:
      抛出 新建 错误("视图范围无效。应为两个整数组成的列表")
    如果 起 < 1:
      抛出 新建 错误("视图范围无效: [" + 整数表转文本(视图范围) + "]。第一个元素 " + 转字符串(起) + " 应在文件行范围内: [1, " + 转字符串(总行数) + "]")
    如果 起 > 总行数:
      抛出 新建 错误("视图范围无效: [" + 整数表转文本(视图范围) + "]。第一个元素 " + 转字符串(起) + " 应在文件行范围内: [1, " + 转字符串(总行数) + "]")
    如果 止 > 总行数:
      抛出 新建 错误("视图范围无效: [" + 整数表转文本(视图范围) + "]。第二个元素 " + 转字符串(止) + " 应小于文件行数: " + 转字符串(总行数))
    如果 止 != -1:
      如果 止 < 起:
        抛出 新建 错误("视图范围无效: [" + 整数表转文本(视图范围) + "]。第二个元素 " + 转字符串(止) + " 应大于等于其第一个元素 " + 转字符串(起))
    设 头 为 头 + "，视图范围=[" + 转字符串(起) + ", " + 转字符串(止) + "]"
  # 渲染区间 [起, 末行]（无视图范围或 止=-1 均到文尾，对齐上游 slice 语义）
  设 末行 为 总行数
  如果 止 != 空:
    如果 止 != -1:
      设 末行 为 止
  设 编号行表 为 []
  设 序号 为 起
  当 序号 <= 末行:
    列表追加(编号行表, 渲染视图行(序号, 行表[序号 - 1]))
    设 序号 为 序号 + 1
  返回 截断内容(头 + ":\n" + 连接字符串(编号行表, "\n") + "\n", 上限)

# 目录行排序键比较（L208-212）：取 \t 之后的显示路径按码点比较
段落 目录行较前 接收 甲, 乙:
  设 甲键 为 截取到末尾(甲, 查找子串(甲, "\t") + 1)
  设 乙键 为 截取到末尾(乙, 查找子串(乙, "\t") + 1)
  如果 甲键 < 乙键:
    返回 真
  返回 假

# visit（L192-205）：过滤隐藏/node_modules/__pycache__，行格式 类型符\t显示路径，目录且深度<2 递归
段落 收集目录行 接收 行表, 目录路径, 深度, 列目录:
  设 条目表 为 列目录(目录路径)
  遍历 条目 之 条目表:
    设 名 为 条目["名"]
    如果 开头(名, ".") == 假:
      如果 名 != "node_modules":
        如果 名 != "__pycache__":
          设 类型符 为 "?"
          如果 条目["类型"] == "目录":
            设 类型符 为 "d"
          如果 条目["类型"] == "文件":
            设 类型符 为 "f"
          列表追加(行表, 类型符 + "\t" + 条目["显示路径"])
          如果 条目["类型"] == "目录":
            如果 深度 < 2:
              收集目录行(行表, 条目["显示路径"], 深度 + 1, 列目录)

# listDirectory（L186-215）：根行 + 递归行，按键码点排序（选择排序，不原地改入参），头部提示保留英文
段落 造目录视图 接收 根路径, 列目录, 上限:
  设 行表 为 ["d\t" + 根路径]
  收集目录行(行表, 根路径, 1, 列目录)
  设 总数 为 列表长度(行表)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 目录行较前(行表[内], 行表[最小]):
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时行 为 行表[外]
      设 行表[外] 为 行表[最小]
      设 行表[最小] 为 临时行
    设 外 为 外 + 1
  设 清单 为 截断内容(连接字符串(行表, "\n") + "\n", 上限)
  返回 "Here're the files and directories up to 2 levels deep in " + 根路径 + ", excluding hidden items, node_modules, and Python cache directories:\n" + 清单 + "\n"

# statExisting（L101-122）不存在分支 + viewPath（L217-238）：目录走目录视图（view_range 拒绝），非文件拒绝
段落 查看路径 接收 路径, 视图范围, 上限, 宿主:
  设 目标 为 解析目标(路径)
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(目标)
  如果 信息 == 空:
    抛出 新建 错误("路径 " + 目标 + " 不存在，请提供有效路径")
  如果 信息["类型"] == "目录":
    如果 视图范围 != 空:
      抛出 新建 错误("path 指向目录时不允许使用 view_range 参数")
    设 列目录 为 宿主["列目录"]
    返回 造目录视图(目标, 列目录, 上限)
  如果 信息["类型"] != "文件":
    抛出 新建 错误("无法查看 \"" + 目标 + "\": 不是普通文件或目录")
  设 读文本 为 宿主["读文本"]
  返回 格式化文件视图(目标, 读文本(目标), 上限, 视图范围)

# createFile（L240-273）：file_text 必填(allowEmpty=真，空文件合法) -> 路径校验 -> 已存在拒绝 -> 写 -> 文案
段落 创建文件 接收 路径, 文件文本, 宿主:
  设 内容 为 必填参数(文件文本, "file_text", "create", 真)
  设 目标 为 解析目标(路径)
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(目标)
  如果 信息 != 空:
    抛出 新建 错误("文件已存在: " + 目标 + "。create 不能覆盖")
  设 写文本 为 宿主["写文本"]
  写文本(目标, 内容)
  返回 "新文件创建成功: " + 目标

# replaceInFile（L275-327）：new_str 为 无 抛 -> 路径校验 -> old_str 必填非空 -> 存在性 ->
#   命中收集：0 命中未找到 / 多命中歧义(行号) / 单命中 前+新+后 写回
段落 替换于文件 接收 路径, 旧串, 新串, 宿主:
  如果 新串 == 空:
    抛出 新建 错误("参数 new_str 必须省略或为字符串")
  设 目标 为 解析目标(路径)
  设 原值 为 必填参数(旧串, "old_str", "str_replace", 假)
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(目标)
  如果 信息 == 空:
    抛出 新建 错误("路径 " + 目标 + " 不存在，请提供有效路径")
  如果 信息["类型"] == "目录":
    抛出 新建 错误("路径 " + 目标 + " 是目录，只有 view 命令可用于目录")
  如果 信息["类型"] != "文件":
    抛出 新建 错误("无法编辑 \"" + 目标 + "\": 不是普通文件")
  设 读文本 为 宿主["读文本"]
  设 原文 为 读文本(目标)
  设 命中表 为 收集命中偏移(原文, 原值)
  如果 列表长度(命中表) == 0:
    抛出 新建 错误("未执行替换，old_str 未在 " + 目标 + " 中原样出现")
  如果 列表长度(命中表) > 1:
    设 行号表 为 偏移行号(原文, 命中表)
    抛出 新建 错误("未执行替换，old_str 在行 [" + 整数表转文本(行号表) + "] 出现多次，请确保唯一")
  设 首中 为 命中表[0]
  设 写文本 为 宿主["写文本"]
  写文本(目标, 截取(原文, 0, 首中) + 新串 + 截取到末尾(原文, 首中 + 字符串长度(原值)))
  返回 "文件 " + 目标 + " 已编辑成功"

# insertInFile（L329-369）：insert_line/new_str 必填 -> 存在性 -> 行范围 [0, 总行数] -> 按行三段拼接写回
段落 插入于文件 接收 路径, 插入行, 新串, 宿主:
  设 行 为 必填参数(插入行, "insert_line", "insert", 真)
  设 值 为 必填参数(新串, "new_str", "insert", 真)
  设 目标 为 解析目标(路径)
  设 查信息 为 宿主["查信息"]
  设 信息 为 查信息(目标)
  如果 信息 == 空:
    抛出 新建 错误("路径 " + 目标 + " 不存在，请提供有效路径")
  如果 信息["类型"] == "目录":
    抛出 新建 错误("路径 " + 目标 + " 是目录，只有 view 命令可用于目录")
  如果 信息["类型"] != "文件":
    抛出 新建 错误("无法插入 \"" + 目标 + "\": 不是普通文件")
  设 读文本 为 宿主["读文本"]
  设 原文 为 读文本(目标)
  设 行表 为 分割字符串(原文, "\n")
  设 总行数 为 列表长度(行表)
  # 行数校验（L348-352）：非整数 / 负数 / 超上界同文案
  设 范围错 为 假
  如果 是整数(行) == 假:
    设 范围错 为 真
  如果 行 < 0:
    设 范围错 为 真
  如果 行 > 总行数:
    设 范围错 为 真
  如果 范围错:
    抛出 新建 错误("insert_line 参数无效: " + 转字符串(行) + "。应在文件行范围内: [0, " + 转字符串(总行数) + "]")
  设 新行表 为 []
  设 序号 为 0
  当 序号 < 行:
    列表追加(新行表, 行表[序号])
    设 序号 为 序号 + 1
  遍历 插行 之 分割字符串(值, "\n"):
    列表追加(新行表, 插行)
  设 序号 为 行
  当 序号 < 总行数:
    列表追加(新行表, 行表[序号])
    设 序号 为 序号 + 1
  设 写文本 为 宿主["写文本"]
  写文本(目标, 连接字符串(新行表, "\n"))
  返回 "文件 " + 目标 + " 已编辑成功"

# presentEditorCall（L376-423）：四命令呈现形状（view=generic/read，create/str_replace=diff，
#   insert=generic/edit + 行号 max(1, insert_line+1)）
段落 呈现编辑调用 接收 参数:
  设 命令 为 参数["command"]
  设 路径 为 参数["path"]
  如果 命令 == "view":
    返回 ["卡片": "generic", "标题": "view " + 路径, "种类": "read", "位置": [["路径": 路径]]]
  如果 命令 == "create":
    设 新文本 为 ""
    如果 字典包含键(参数, "file_text"):
      如果 参数["file_text"] != 空:
        设 新文本 为 参数["file_text"]
    返回 ["卡片": "diff", "标题": "create " + 路径, "差异": [["路径": 路径, "旧文本": 空, "新文本": 新文本]], "位置": [["路径": 路径]]]
  如果 命令 == "str_replace":
    设 旧文本 为 空
    如果 字典包含键(参数, "old_str"):
      如果 参数["old_str"] != 空:
        设 旧文本 为 参数["old_str"]
    设 新文本 为 ""
    如果 字典包含键(参数, "new_str"):
      如果 参数["new_str"] != 空:
        设 新文本 为 参数["new_str"]
    返回 ["卡片": "diff", "标题": "str_replace " + 路径, "差异": [["路径": 路径, "旧文本": 旧文本, "新文本": 新文本]], "位置": [["路径": 路径]]]
  如果 命令 == "insert":
    设 位置表 为 [["路径": 路径]]
    如果 字典包含键(参数, "insert_line"):
      如果 参数["insert_line"] != 空:
        设 行值 为 参数["insert_line"] + 1
        如果 行值 < 1:
          设 行值 为 1
        设 位置表 为 [["路径": 路径, "行": 行值]]
    返回 ["卡片": "generic", "标题": "insert " + 路径, "种类": "edit", "位置": 位置表]
  返回 空

# execute（L471-496）+ schema 门禁手写化：命令枚举、path 必填、可选参数缺省语义、上限默认
段落 执行编辑命令 接收 参数, 宿主:
  设 命令 为 空
  如果 字典包含键(参数, "command"):
    设 命令 为 参数["command"]
  如果 命令 != "view":
    如果 命令 != "create":
      如果 命令 != "str_replace":
        如果 命令 != "insert":
          抛出 新建 错误("未知命令: " + 转字符串(命令) + "。允许: view, create, str_replace, insert")
  设 路径 为 空
  如果 字典包含键(参数, "path"):
    设 路径 为 参数["path"]
  如果 是空(路径):
    抛出 新建 错误("参数 path 必填")
  设 上限 为 字典获取(宿主, "上限", 默认输出上限)
  如果 命令 == "view":
    设 视图范围 为 空
    如果 字典包含键(参数, "view_range"):
      设 视图范围 为 参数["view_range"]
    返回 查看路径(路径, 视图范围, 上限, 宿主)
  如果 命令 == "create":
    设 文件文本 为 空
    如果 字典包含键(参数, "file_text"):
      设 文件文本 为 参数["file_text"]
    返回 创建文件(路径, 文件文本, 宿主)
  如果 命令 == "str_replace":
    # 上游 null/undefined 两态在入参字典以「键存在且值 无」与「键不存在」区分：
    #   键不存在 -> 省略（等价 undefined -> 空串，删除替换）；键存在且值为 无 -> 抛（等价 null）
    设 旧串 为 空
    如果 字典包含键(参数, "old_str"):
      设 旧串 为 参数["old_str"]
    设 新串值 为 ""
    如果 字典包含键(参数, "new_str"):
      设 新串值 为 参数["new_str"]
    返回 替换于文件(路径, 旧串, 新串值, 宿主)
  # insert
  设 插入行 为 空
  如果 字典包含键(参数, "insert_line"):
    设 插入行 为 参数["insert_line"]
  设 新串 为 空
  如果 字典包含键(参数, "new_str"):
    设 新串 为 参数["new_str"]
  返回 插入于文件(路径, 插入行, 新串, 宿主)
