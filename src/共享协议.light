# 共享协议.light —— 对标上游 packages/experimental/liveshare-protocol/src/*
#   {tunnel-protocol.ts(610 行), viewer-carrier.ts(306 行), viewer-states.ts(48 行)}
#   锚点：deepseek-ai/deepseek-harness dsh-v0.2.2-rc.1 = 66491b05e3
#
# LiveShare 是 0.2.2 唯一的架构级新面：把会话通过独立 Relay 共享出去，两档权限
# （view / bounded-write），fork 与附件上传是两个独立开关。本模块只做**协议层**：
#   1) 隧道帧编解码：Relay ⇄ 网关（share-rpc / share-rpc-res / share-rpc-cancel /
#      share-access-state）与 宿主 ⇄ worker 的 IPC（工令 add-share / remove-share /
#      share-rpc-response / shutdown，工事 ready / share-connected / share-error /
#      share-closed / share-rpc-request / share-rpc-cancel / share-access-state）。
#   2) 拒答：本版本读不懂的帧必须有答复（400 invalid-request / 501 unsupported-frame），
#      否则对端只能等到自己的预算超时，版本不匹配伪装成超时。
#   3) viewer 承载：页面脚本里可移植的纯判定——读通道目标、可重试 vs 终局的归类、
#      拒绝体解包、转发路由的**路径段边界**匹配、流编号窗口。
#   4) viewer 状态词表：七种结局 + 每种是否可重试。
#
# 宿主面剔除：relay 连接、WebSocket/HTTP 收发、DOM 全局安装、crypto 随机源、identity
# 签名与密钥派生、React UI、鉴权——一律入参化或整体不做（见文件末「未移植」）。
# 判据见 examples/test_共享协议.light（对齐上游 tests/frames/{v1,unknown}/*.json 与
# protocol-frames / protocol-utilities / share-access-state / ipc-token / viewer-carrier 用例）。

导出 共享协议版本 共享协议能力表 共享协议观看全局名 共享协议观看态表 共享协议观看可达性
导出 共享隧道解析网关帧 共享隧道解析中继帧 共享隧道解析准入态 共享隧道拒答帧 共享隧道请求字段
导出 共享隧道拒令分享号 共享隧道解析工令 共享隧道解析工事 共享隧道校验分享规格 共享隧道校验行为者
导出 共享隧道校验注册牌 共享隧道过期可解析
导出 共享承载目标路径 共享承载失败归类 共享承载失败帧 共享承载拒绝解包 共享承载编码形状
导出 共享承载转发路由 共享承载调用路径 共享承载流号起点

# ---------------------------------------------------------------- 常量（对齐上游 as const）

# 上游 LIVESHARE_PROTOCOL_VERSION：Relay 线协议版本，Host/worker IPC 同发同收，不参与协商。
段落 共享协议版本():
  返回 1

# 上游 LIVESHARE_CAPABILITIES：本构建向 Relay 声明的可选行为，名字都描述「对端能在线上看到
# 什么」，Relay 只依赖被告知的能力，不依赖它恰好跑在哪个版本旁边。
段落 共享协议能力表():
  返回 ["session-mode", "fork", "acl-subjects", "expiry", "owner-credential", "scoped-rpc-response", "unsupported-frame-refusal", "share-access-state", "actor-credential", "direct-connection"]

# 上游 LIVESHARE_VIEWER_GLOBAL：页面全局名，viewer 客户端插件按它读本页呈现的分享。
段落 共享协议观看全局名():
  返回 "__DSH_LIVESHARE_VIEWER__"

# 上游 VIEWER_STATE_REACH：七种结局，每种是否可重试。HTTP 状态码归 Relay、文案键归客户端，
# 协议层只发布这一份词表。
段落 共享协议观看态表():
  返回 ["share-not-found", "share-stopped", "share-expired", "owner-offline", "sign-in-expired", "access-denied", "relay-unreachable"]

段落 共享协议观看可达性(态):
  如果 列表包含(["owner-offline", "relay-unreachable"], 态):
    返回 "retryable"
  如果 列表包含(共享协议观看态表(), 态):
    返回 "terminal"
  返回 ""

# ---------------------------------------------------------------- 通用判定

段落 共享协议是记录(值):
  返回 是字典(值)

段落 共享协议有键(字典, 键):
  返回 列表包含(字典键列表(字典), 键)

# 缺键访问在光明里会抛错（实测 2026-11-05），所有可选字段都必须先问键在不在。
段落 共享协议取键(字典, 键, 兜底):
  如果 共享协议有键(字典, 键) == 假:
    返回 兜底
  返回 字典[键]

# 非空字符串；空串在上游一律视同缺字段。
段落 共享协议非空串(值):
  如果 是字符串(值) == 假:
    返回 假
  如果 值 == "":
    返回 假
  返回 真

# Number.isSafeInteger：整数直通；JSON 里 1e3 这类会解析成浮点（实测），整值浮点也放行，
# 非整值浮点与超界一律拒绝，避免把无法精确对照请求的 id 当成信封。
段落 共享协议安全整数(值):
  设 界 为 9007199254740991
  如果 是整数(值):
    如果 值 > 界:
      返回 假
    如果 值 < 0 - 界:
      返回 假
    返回 真
  如果 是浮点(值):
    如果 值 != 转整数(值):
      返回 假
    如果 值 > 界:
      返回 假
    如果 值 < 0 - 界:
      返回 假
    返回 真
  返回 假

# 帧信封：两条方向共用同一套解码规则（上游 frameEnvelope 只留一份，免得 id 规则漂两处）。
# 返回 空 或 {"值": 原字典, "标识": id}。
段落 共享协议信封(值):
  如果 共享协议是记录(值) == 假:
    返回 空
  如果 共享协议有键(值, "id") == 假:
    返回 空
  设 标识 为 值["id"]
  如果 共享协议安全整数(标识) == 假:
    返回 空
  如果 标识 <= 0:
    返回 空
  返回 {"值": 值, "标识": 标识}

# HTTP 状态码区间：上游 100..599 才收，700 这种整帧丢弃。
段落 共享协议状态可用(值):
  如果 共享协议安全整数(值) == 假:
    返回 假
  如果 值 < 100:
    返回 假
  如果 值 > 599:
    返回 假
  返回 真

# ---------------------------------------------------------------- 令牌与时间

段落 共享协议十六进制串(文本):
  如果 是字符串(文本) == 假:
    返回 假
  如果 文本 == "":
    返回 假
  设 表 为 "0123456789abcdefABCDEF"
  设 序 为 0
  当 序 < 字符串长度(文本):
    如果 字符串包含(表, 字符串获取(文本, 序)) == 假:
      返回 假
    设 序 为 序 + 1
  返回 真

# 上游 isRegistrationToken：uuid v4 形状（8-4-4-4-12、版本位 4、变体位 89ab）。
# 用逐段判长代替正则——光明没有正则内置，手写反而判据更透明。
段落 共享隧道校验注册牌(文本):
  如果 是字符串(文本) == 假:
    返回 假
  如果 字符串长度(文本) != 36:
    返回 假
  如果 字符串获取(文本, 8) != "-":
    返回 假
  如果 字符串获取(文本, 13) != "-":
    返回 假
  如果 字符串获取(文本, 18) != "-":
    返回 假
  如果 字符串获取(文本, 23) != "-":
    返回 假
  如果 字符串获取(文本, 14) != "4":
    返回 假
  如果 字符串包含("89ab89AB", 字符串获取(文本, 19)) == 假:
    返回 假
  如果 共享协议十六进制串(截取(文本, 0, 8)) == 假:
    返回 假
  如果 共享协议十六进制串(截取(文本, 9, 13)) == 假:
    返回 假
  如果 共享协议十六进制串(截取(文本, 14, 18)) == 假:
    返回 假
  如果 共享协议十六进制串(截取(文本, 19, 23)) == 假:
    返回 假
  如果 共享协议十六进制串(截取(文本, 24, 36)) == 假:
    返回 假
  返回 真

段落 共享协议两位值(文本, 起):
  如果 起 + 2 > 字符串长度(文本):
    返回 -1
  设 段 为 截取(文本, 起, 起 + 2)
  如果 字符串全数字(段) == 假:
    返回 -1
  返回 转整数(段)

# 上游用 Date.parse 判过期时间；光明没有日历解析，这里收 ISO-8601 子集并逐段验范围：
# YYYY-MM-DD[THH:MM[:SS[.f+]][Z|±HH:MM]]。比 Date.parse 严（不收 "Oct 3 2026"），
# 差异记在测试文件头的「口径差异」里，不悄悄放宽。
段落 共享隧道过期可解析(文本):
  如果 是字符串(文本) == 假:
    返回 假
  设 长 为 字符串长度(文本)
  如果 长 < 10:
    返回 假
  如果 字符串全数字(截取(文本, 0, 4)) == 假:
    返回 假
  如果 字符串获取(文本, 4) != "-":
    返回 假
  如果 字符串获取(文本, 7) != "-":
    返回 假
  设 月 为 共享协议两位值(文本, 5)
  设 日 为 共享协议两位值(文本, 8)
  如果 月 < 1 或 月 > 12:
    返回 假
  如果 日 < 1 或 日 > 31:
    返回 假
  如果 长 == 10:
    返回 真
  如果 字符串获取(文本, 10) != "T":
    返回 假
  如果 长 < 16:
    返回 假
  如果 字符串获取(文本, 13) != ":":
    返回 假
  设 时 为 共享协议两位值(文本, 11)
  设 分 为 共享协议两位值(文本, 14)
  如果 时 < 0 或 时 > 23:
    返回 假
  如果 分 < 0 或 分 > 59:
    返回 假
  设 位 为 16
  如果 位 < 长 且 字符串获取(文本, 位) == ":":
    设 秒 为 共享协议两位值(文本, 位 + 1)
    如果 秒 < 0 或 秒 > 60:
      返回 假
    设 位 为 位 + 3
    如果 位 < 长 且 字符串获取(文本, 位) == ".":
      设 扫 为 位 + 1
      当 扫 < 长 且 字符串全数字(字符串获取(文本, 扫)) == 真:
        设 扫 为 扫 + 1
      如果 扫 == 位 + 1:
        返回 假
      设 位 为 扫
  如果 位 >= 长:
    返回 真
  设 尾 为 截取(文本, 位, 长)
  如果 尾 == "Z":
    返回 真
  如果 字符串长度(尾) == 6:
    设 首字 为 字符串获取(尾, 0)
    如果 首字 == "+" 或 首字 == "-":
      如果 字符串获取(尾, 3) == ":":
        如果 共享协议两位值(尾, 1) >= 0 且 共享协议两位值(尾, 4) >= 0:
          返回 真
  返回 假

段落 共享协议主体表可用(值):
  如果 是列表(值) == 假:
    返回 假
  遍历 项 之 值:
    如果 共享协议非空串(项) == 假:
      返回 假
  返回 真

段落 共享协议可选串可用(值, 键):
  如果 共享协议有键(值, 键) == 假:
    返回 真
  返回 是字符串(值[键])

# ---------------------------------------------------------------- 已授权的准入快照

# 上游 parseShareAccessState：Relay 提交的权威快照，读的一方跟随它而不是跟随当初的申请。
# 任一权威字段不可信就整帧作废（不做「能收多少收多少」）。
段落 共享隧道解析准入态(值):
  如果 共享协议是记录(值) == 假:
    返回 空
  如果 共享协议取键(值, "type", "") != "share-access-state":
    返回 空
  如果 共享协议有键(值, "version") == 假:
    返回 空
  设 版本 为 值["version"]
  如果 共享协议安全整数(版本) == 假:
    返回 空
  如果 版本 < 0:
    返回 空
  设 准入 为 共享协议取键(值, "accessMode", "")
  如果 准入 != "open" 且 准入 != "selected":
    返回 空
  如果 共享协议主体表可用(共享协议取键(值, "allowedSubjectIds", 空)) == 假:
    返回 空
  设 会话模式 为 共享协议取键(值, "sessionMode", "")
  如果 会话模式 != "view" 且 会话模式 != "write":
    返回 空
  设 帧 为 {"种类": "share-access-state", "版本": 版本, "准入模式": 准入, "允许主体": 值["allowedSubjectIds"], "会话模式": 会话模式}
  如果 共享协议有键(值, "allowsFork"):
    如果 是布尔(值["allowsFork"]) == 假:
      返回 空
    帧["允许分叉"] 为 值["allowsFork"]
  如果 共享协议有键(值, "expiresAt"):
    如果 共享隧道过期可解析(值["expiresAt"]) == 假:
      返回 空
    帧["过期时间"] 为 值["expiresAt"]
  返回 帧

# ---------------------------------------------------------------- Relay ⇄ 网关

# 上游 parseGatewayFrame：网关发往 Relay 的只有答复帧，未知/畸形一律丢弃（不抛）。
段落 共享隧道解析网关帧(文本):
  如果 是字符串(文本) == 假:
    返回 空
  设 原值 为 空
  尝试:
    设 原值 为 解析JSON(文本)
  捕获 异常 为 错误值:
    返回 空
  设 信封 为 共享协议信封(原值)
  如果 信封 == 空:
    返回 空
  设 值 为 信封["值"]
  如果 共享协议取键(值, "type", "") != "share-rpc-res":
    返回 空
  设 状态 为 共享协议取键(值, "status", 空)
  如果 共享协议状态可用(状态) == 假:
    返回 空
  设 帧 为 {"种类": "share-rpc-res", "标识": 信封["标识"], "状态": 状态}
  如果 共享协议有键(值, "body"):
    帧["体"] 为 值["body"]
  返回 帧

# 上游 parseRelayValue：先认准入快照（它没有 RPC id），再认带信封的三类帧。
# share-rpc 缺 actor 一律作废——宿主绝不允许对一条无法归属的请求动手。
段落 共享隧道解析中继值(值):
  设 准入 为 共享隧道解析准入态(值)
  如果 准入 != 空:
    返回 准入
  设 信封 为 共享协议信封(值)
  如果 信封 == 空:
    返回 空
  设 帧值 为 信封["值"]
  设 种类 为 共享协议取键(帧值, "type", "")
  如果 种类 == "share-rpc":
    如果 共享协议有键(帧值, "body") == 假:
      返回 空
    如果 共享协议有键(帧值, "actor") == 假:
      返回 空
    如果 共享隧道校验行为者(帧值["actor"]) == 假:
      返回 空
    返回 {"种类": "share-rpc", "标识": 信封["标识"], "体": 帧值["body"], "行为者": 帧值["actor"]}
  如果 种类 == "share-rpc-cancel":
    返回 {"种类": "share-rpc-cancel", "标识": 信封["标识"]}
  返回 空

段落 共享隧道解析中继帧(文本):
  如果 是字符串(文本) == 假:
    返回 空
  设 原值 为 空
  尝试:
    设 原值 为 解析JSON(文本)
  捕获 异常 为 错误值:
    返回 空
  返回 共享隧道解析中继值(原值)

# 上游 unsupportedFrameRefusal：本构建读不懂的帧必须回一句，让对端能报「版本不匹配」而不是
# 干等到超时。已能服务的帧不回（那不是该被拒的帧）；本身就是答复/取消的帧不回；没有可用
# 信封的帧没有 id 可对照，也不回。
段落 共享隧道拒答帧(文本):
  如果 是字符串(文本) == 假:
    返回 空
  设 原值 为 空
  尝试:
    设 原值 为 解析JSON(文本)
  捕获 异常 为 错误值:
    返回 空
  如果 共享隧道解析中继值(原值) != 空:
    返回 空
  设 信封 为 共享协议信封(原值)
  如果 信封 == 空:
    返回 空
  设 值 为 信封["值"]
  设 种类 为 共享协议取键(值, "type", "")
  如果 种类 == "share-rpc":
    返回 {"种类": "share-rpc-res", "标识": 信封["标识"], "状态": 400, "体": {"error": "invalid-request"}}
  如果 种类 == "share-rpc-res" 或 种类 == "share-rpc-cancel":
    返回 空
  如果 是字符串(种类) == 假 或 种类 == "":
    返回 空
  返回 {"种类": "share-rpc-res", "标识": 信封["标识"], "状态": 501, "体": {"error": "unsupported-frame"}}

# 上游 viewerRequestFields：不透明请求体只有两个字段被读（仅为日志对账），其余保持不透明。
段落 共享隧道请求字段(体):
  如果 共享协议是记录(体) == 假:
    返回 {"op": "unknown", "streamId": "-"}
  设 操作名 为 共享协议取键(体, "op", 空)
  设 编号 为 共享协议取键(体, "id", 空)
  设 操作文 为 "unknown"
  如果 是字符串(操作名) == 真:
    设 操作文 为 操作名
  设 流文 为 "-"
  如果 是数值(编号) == 真:
    设 流文 为 转字符串(编号)
  返回 {"op": 操作文, "streamId": 流文}

# 上游 rejectedCommandShareId：被拒的 IPC 工令也要点名它针对的分享，否则交互式分享只能
# 等自己的超时，重启恢复的分享则静默离线。
段落 共享隧道拒令分享号(值):
  如果 共享协议是记录(值) == 假:
    返回 ""
  设 直属 为 共享协议取键(值, "shareId", 空)
  如果 共享协议非空串(直属) == 真:
    返回 直属
  设 分享 为 共享协议取键(值, "share", 空)
  如果 共享协议是记录(分享) == 假:
    返回 ""
  设 内层 为 共享协议取键(分享, "shareId", 空)
  如果 共享协议非空串(内层) == 真:
    返回 内层
  返回 ""

# ---------------------------------------------------------------- 宿主 ⇄ worker IPC

段落 共享隧道校验行为者(值):
  如果 共享协议是记录(值) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "providerId", 空)) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "tenantId", 空)) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "subjectId", 空)) == 假:
    返回 假
  如果 共享协议有键(值, "displayName"):
    如果 共享协议非空串(值["displayName"]) == 假:
      返回 假
  如果 共享协议有键(值, "credential"):
    如果 是字符串(值["credential"]) == 假:
      返回 假
  返回 真

# 上游 isTunnelShareSpec：跨进程边界，worker 读到的每个字段这里都要查，不做断言。
段落 共享隧道校验分享规格(值):
  如果 共享协议是记录(值) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "shareId", 空)) == 假:
    返回 假
  如果 是字符串(共享协议取键(值, "sessionId", 空)) == 假:
    返回 假
  如果 是字符串(共享协议取键(值, "sessionTitle", 空)) == 假:
    返回 假
  设 准入 为 共享协议取键(值, "accessMode", "")
  如果 准入 != "open" 且 准入 != "selected":
    返回 假
  如果 是字符串(共享协议取键(值, "relay", 空)) == 假:
    返回 假
  如果 是字符串(共享协议取键(值, "gatewayToken", 空)) == 假:
    返回 假
  如果 是字符串(共享协议取键(值, "ownerDisplayName", 空)) == 假:
    返回 假
  如果 共享协议可选串可用(值, "ownerProviderId") == 假:
    返回 假
  如果 共享协议可选串可用(值, "ownerTenantId") == 假:
    返回 假
  如果 共享协议可选串可用(值, "dshVersion") == 假:
    返回 假
  如果 共享协议可选串可用(值, "ownerInstanceId") == 假:
    返回 假
  如果 共享协议可选串可用(值, "ownerCredential") == 假:
    返回 假
  如果 共享协议有键(值, "allowsFork"):
    如果 是布尔(值["allowsFork"]) == 假:
      返回 假
  如果 共享协议有键(值, "sessionMode"):
    设 模式 为 值["sessionMode"]
    如果 模式 != "view" 且 模式 != "write":
      返回 假
  如果 共享协议有键(值, "connection"):
    设 连接 为 值["connection"]
    如果 共享协议是记录(连接) == 假:
      返回 假
    设 连接型 为 共享协议取键(连接, "mode", "")
    如果 连接型 != "relay" 且 连接型 != "direct":
      返回 假
  如果 共享协议主体表可用(共享协议取键(值, "allowedSubjectIds", 空)) == 假:
    返回 假
  如果 共享协议有键(值, "expiresAt"):
    如果 共享隧道过期可解析(值["expiresAt"]) == 假:
      返回 假
  返回 真

# add-share 解析后补默认连接：缺省读作 {mode: "relay"}（今天唯一的形态）。
段落 共享隧道补默认连接(分享):
  设 连接副本 为 副本(分享)
  如果 共享协议有键(连接副本, "connection") == 假:
    连接副本["connection"] 为 {"mode": "relay"}
  返回 连接副本

段落 共享隧道注册身份可用(值):
  如果 共享协议有键(值, "registrationToken") == 假:
    返回 假
  如果 共享隧道校验注册牌(值["registrationToken"]) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "shareId", 空)) == 假:
    返回 假
  返回 真

段落 共享隧道请求身份可用(值):
  如果 共享隧道注册身份可用(值) == 假:
    返回 假
  如果 共享协议非空串(共享协议取键(值, "token", 空)) == 假:
    返回 假
  如果 共享协议有键(值, "id") == 假:
    返回 假
  设 标识 为 值["id"]
  如果 共享协议安全整数(标识) == 假:
    返回 假
  如果 标识 <= 0:
    返回 假
  返回 真

# 上游 parseTunnelWorkerCommand：worker 只服务四道工令，未知类型明确丢弃（不猜、不改写）。
段落 共享隧道解析工令(值):
  如果 共享协议是记录(值) == 假:
    返回 空
  设 种类 为 共享协议取键(值, "type", "")
  如果 种类 == "shutdown":
    返回 {"种类": "shutdown"}
  如果 种类 == "remove-share":
    设 号 为 共享协议取键(值, "shareId", 空)
    如果 共享协议非空串(号) == 假:
      返回 空
    返回 {"种类": "remove-share", "分享号": 号}
  如果 种类 == "add-share":
    如果 共享隧道校验注册牌(共享协议取键(值, "registrationToken", 空)) == 假:
      返回 空
    设 分享 为 共享协议取键(值, "share", 空)
    如果 共享隧道校验分享规格(分享) == 假:
      返回 空
    返回 {"种类": "add-share", "注册牌": 值["registrationToken"], "分享": 共享隧道补默认连接(分享)}
  如果 种类 == "share-rpc-response":
    如果 共享隧道请求身份可用(值) == 假:
      返回 空
    设 状态 为 共享协议取键(值, "status", 空)
    如果 共享协议状态可用(状态) == 假:
      返回 空
    设 答复 为 {"种类": "share-rpc-response", "注册牌": 值["registrationToken"], "请求牌": 值["token"], "标识": 值["id"], "分享号": 值["shareId"], "状态": 状态}
    如果 共享协议有键(值, "body"):
      答复["体"] 为 值["body"]
    返回 答复
  返回 空

# 上游 parseTunnelWorkerEvent：生命周期事件都要回带自己的注册牌；IPC 令牌不进 Relay 帧。
段落 共享隧道解析工事(值):
  如果 共享协议是记录(值) == 假:
    返回 空
  设 种类 为 共享协议取键(值, "type", "")
  如果 种类 == "ready":
    返回 {"种类": "ready"}
  如果 种类 == "share-connected" 或 种类 == "share-closed":
    如果 共享隧道注册身份可用(值) == 假:
      返回 空
    返回 {"种类": 种类, "注册牌": 值["registrationToken"], "分享号": 值["shareId"]}
  如果 种类 == "share-access-state":
    如果 共享隧道注册身份可用(值) == 假:
      返回 空
    设 准入 为 共享隧道解析准入态(值)
    如果 准入 == 空:
      返回 空
    准入["注册牌"] 为 值["registrationToken"]
    准入["分享号"] 为 值["shareId"]
    返回 准入
  如果 种类 == "share-error":
    如果 共享隧道注册身份可用(值) == 假:
      返回 空
    如果 是字符串(共享协议取键(值, "message", 空)) == 假:
      返回 空
    返回 {"种类": "share-error", "注册牌": 值["registrationToken"], "分享号": 值["shareId"], "报文": 值["message"]}
  如果 种类 == "share-rpc-cancel":
    如果 共享隧道请求身份可用(值) == 假:
      返回 空
    返回 {"种类": "share-rpc-cancel", "注册牌": 值["registrationToken"], "请求牌": 值["token"], "标识": 值["id"], "分享号": 值["shareId"]}
  如果 种类 == "share-rpc-request":
    如果 共享隧道请求身份可用(值) == 假:
      返回 空
    如果 共享协议有键(值, "body") == 假:
      返回 空
    如果 共享隧道校验行为者(共享协议取键(值, "actor", 空)) == 假:
      返回 空
    返回 {"种类": "share-rpc-request", "注册牌": 值["registrationToken"], "请求牌": 值["token"], "标识": 值["id"], "分享号": 值["shareId"], "体": 值["body"], "行为者": 值["actor"]}
  返回 空

# ---------------------------------------------------------------- viewer 承载（纯判定部分）

# 上游 target：页面读通道。无分享号时打裸通道（链接从没指名分享）。
# 口径差异：上游用 encodeURIComponent 编分享号，光明无此内置，这里原样拼接——分享号来自
# Relay 签发（uuid 形状），不含需要转义的字符；非 uuid 分享号属宿主面拒绝的事。
段落 共享承载目标路径(基路径, 分享号):
  如果 分享号 == "":
    返回 基路径 + "/__share/rpc"
  返回 基路径 + "/__share/rpc?shareId=" + 分享号

# 上游 readable()：401/403 是认证拒绝，无论包里写什么码都终局；408/429/502/503/504 与两个
# 「逻辑流丢了」的码可重连；其余一律按对端裁决（普通 500 不假设可重试）。
段落 共享承载失败归类(状态, 编码):
  如果 状态 == 401 或 状态 == 403:
    返回 "远端"
  如果 列表包含([408, 429, 502, 503, 504], 状态) == 真:
    返回 "承载"
  如果 列表包含(["stream-not-found", "gateway/cancelled"], 编码) == 真:
    返回 "承载"
  返回 "远端"

# 上游 failure()：200 流帧里的 failure 槽同样按码分类。
段落 共享承载失败帧(帧):
  如果 共享协议是记录(帧) == 假:
    返回 空
  如果 共享协议有键(帧, "failure") == 假:
    返回 空
  设 值 为 帧["failure"]
  如果 共享协议是记录(值) == 假:
    返回 空
  设 编码 为 共享协议取键(值, "code", 空)
  设 码文 为 "liveshare/read-refused"
  如果 是字符串(编码) == 真 且 编码 != "":
    设 码文 为 编码
  设 类 为 "远端"
  如果 列表包含(["stream-not-found", "gateway/cancelled"], 码文) == 真:
    设 类 为 "承载"
  返回 {"类": 类, "编码": 码文}

# 上游 refusal()：拒绝体两种形状都认——{error: "码"} 与 {error: {code, message}, message}。
段落 共享承载拒绝解包(体):
  如果 共享协议是记录(体) == 假:
    返回 {}
  设 错 为 共享协议取键(体, "error", 空)
  设 编码 为 ""
  设 说明 为 ""
  如果 是字典(错) == 真:
    设 内码 为 共享协议取键(错, "code", 空)
    如果 是字符串(内码) == 真:
      设 编码 为 内码
    设 内说明 为 共享协议取键(错, "message", 空)
    如果 是字符串(内说明) == 真:
      设 说明 为 内说明
  否则:
    如果 是字符串(错) == 真:
      设 编码 为 错
    设 顶说明 为 共享协议取键(体, "message", 空)
    如果 是字符串(顶说明) == 真:
      设 说明 为 顶说明
  设 结论 为 {}
  如果 共享承载编码形状(编码) == 真:
    结论["编码"] 为 编码
  如果 说明 != "":
    结论["说明"] 为 说明
  返回 结论

# 上游 codeShaped = /^[a-z][a-z0-9-]*(\/[a-z0-9-]+)*$/u：首段小写字母开头，斜杠分段，不许空段。
段落 共享承载编码形状(文本):
  如果 是字符串(文本) == 假:
    返回 假
  如果 文本 == "":
    返回 假
  设 序 为 0
  设 长 为 字符串长度(文本)
  设 段首 为 真
  当 序 < 长:
    设 单字 为 字符串获取(文本, 序)
    如果 单字 == "/":
      如果 段首 == 真:
        返回 假
      设 段首 为 真
    否则若 段首 == 真:
      如果 字符串包含("abcdefghijklmnopqrstuvwxyz", 单字) == 假:
        返回 假
      设 段首 为 假
    否则:
      如果 字符串包含("abcdefghijklmnopqrstuvwxyz0123456789-", 单字) == 假:
        返回 假
    设 序 为 序 + 1
  如果 段首 == 真:
    返回 假
  返回 真

# 上游 segmentOffset：路由必须**起一个路径段**——页 URL 前面挂着 Relay 自己的基路径，
# 所以不能拿前缀直接比；`/api/present.hostile`、`/x/open-in-app/apps-foo` 都不是这条路由。
段落 共享承载段起点(路径名, 路由):
  设 长 为 字符串长度(路径名)
  设 路长 为 字符串长度(路由)
  设 位 为 0
  当 位 + 路长 <= 长:
    如果 截取(路径名, 位, 位 + 路长) == 路由:
      如果 位 + 路长 == 长:
        返回 位
      如果 字符串获取(路径名, 位 + 路长) == "/":
        返回 位
    设 位 为 位 + 1
  返回 -1

# 上游 forwardedRoute：只转发 GET 的两条只读宿主路由；会作用于宿主机器的路由一律不进表。
段落 共享承载转发路由(路径名, 方法):
  如果 方法 != "GET":
    返回 ""
  遍历 路由 之 ["/open-in-app/apps", "/api/present.host"]:
    设 起点 为 共享承载段起点(路径名, 路由)
    如果 起点 >= 0:
      返回 截取(路径名, 起点, 字符串长度(路径名))
  返回 ""

# 上游 fetchCall：页面把文档相对路由投给 Connection，宿主读的是 `/api/...` 那段（用最后一处）。
段落 共享承载调用路径(路径名):
  设 标记 为 "/api/"
  设 长 为 字符串长度(路径名)
  设 记长 为 字符串长度(标记)
  设 位 为 0
  设 末位 为 -1
  当 位 + 记长 <= 长:
    如果 截取(路径名, 位, 位 + 记长) == 标记:
      设 末位 为 位
    设 位 为 位 + 1
  如果 末位 < 0:
    返回 ""
  返回 截取(路径名, 末位, 长)

# 上游 nextStreamId 起点：(随机源 % 0x7fffff00) + 1。随机源在宿主（crypto），这里收种子。
# 每个页面在自己的窗口里编号，两个页面读同一分享也不会互相顶掉流。
段落 共享承载流号起点(种子):
  返回 种子 % 2147483392 + 1
