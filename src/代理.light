# 代理.light —— 代理循环驱动（对齐原版 core/agent-loop agent.ts，P0 同步等价版）
#
# 语义对齐点：
#   - 每轮：turn/start → 步骤循环（step/start → user/message → 模型流 → assistant/chunk → assistant/message → 工具调用 → tool/call+tool/result → step/end）→ turn/end
#   - 每步请求由会话日志派生（整理消息 → 映射网络消息 → 客户端对话）
#   - max-tokens 粘性：任一步命中即整轮 max-tokens，后续步骤不降级
#   - 工具调用：模型序分组（exclusive 屏障 / parallel 池，v1 顺序执行）；结果按模型序记录
#   - 失败结构化：错误返回 { 种类:"error", 失败:{消息,代码} }
#   - 系统提示提交（对标 runtime-context.ts SystemPromptProjection）：渲染文本 vs 持久
#     system/message 表面 → append / replace 提交；开始请求系列 或 无读后置提示能力 → 归一化
#   - 请求头准入（对标 buildRequest request/header 追加）：initial/resume/change/series 四原因 +
#     request/context 变化记录 + 请求面世代锁定
#   - 中止结算（对标 cancel/信号语义）：终止后正在成形的尝试 → 中断 assistant/message（非空内容）
#     或 assistant/attempt（空内容），轮次以 aborted 收束
#
# ⚠️ 光明命名规范 v1：成员名避开关键字/运算符词根；成员赋值一律「设 己.X 为 …」。

从 消息 导入 造用户消息, 造助手消息, 造工具结果消息, 造文本块, 造标识, 造系统消息
从 工具 导入 解析参数
从 客户端 导入 映射网络消息
从 流 导入 块组装器
从 线程 导入 线程
从 压缩 导入 压缩管理器
从 审批 导入 审批管理器
从 遥测 导入 遥测收集器
从 时间管理 导入 休眠

# 线程目标：跑单个工具执行（只跑 注册表.执行，事件在主线程记录）
段落 跑单工具 接收 注册表, 名字, 参数原文:
  返回 注册表.执行(名字, 参数原文)

# 造系统消息：已收编进 消息.light（对齐原版 createSystemMessage(text, plugin)）。
# 本模块不再持有局部实现，调用点统一走 消息.造系统消息(文本, "system-prompt")；
# 消息形状 { id, role:"system", content, source:{kind:"plugin",plugin} } 保持不变。

# ===== 系统提示投影（对标原版 runtime-context.ts 的 SystemPromptProjection 决策面）=====
# 把渲染文本与持久 system/message 表面折叠对齐，产出提交意图表：
#   - 表面 = 未经遮蔽、且未被后续 replace 意图声明为源的 system/message 节点
#     （压缩折叠面待路 1 的 node folding 落地后接管；当前用意图声明的源事件序号在决策面内消化）
#   - 节点文本（对标 textOf）：单 text 块 → 其文本；空 content → ""；其余 → 空
#   - 输入 开始系列（请求系列开始）或 无读后置提示能力 或 渲染文本为空 → 归一化：
#     改写头节点为渲染文本，清空其余非空节点
#   - 有能力且继续系列：最新非空节点与渲染文本相同 → 无提交；不同 → 追加
#   - 表面为空 → 追加新头节点
类 系统提示投影:
  属性 会话对象 等于 空

  段落 构造 接收 会话对象:
    设 己.会话对象 为 会话对象

  # 节点表：[{"序号", "文本"}]
  段落 系统节点表 接收:
    设 事件项表 为 己.会话对象.查询事件("system/message", 0, 0)
    设 被替换表 为 []
    遍历 事件项 之 事件项表:
      如果 事件项.包含("遮蔽") 且 事件项["遮蔽"]:
        继续
      设 意图 为 字典获取(事件项["数据"], "意图")
      如果 意图 != 空:
        设 源表 为 字典获取(意图, "源事件序号")
        如果 源表 != 空:
          遍历 源序号 之 源表:
            如果 列表包含(被替换表, 源序号) == 假:
              列表追加(被替换表, 源序号)
    设 节点表 为 []
    遍历 事件项 之 事件项表:
      如果 事件项.包含("遮蔽") 且 事件项["遮蔽"]:
        继续
      如果 列表包含(被替换表, 事件项["序号"]):
        继续
      设 节点 为 {"序号": 事件项["序号"]}
      字典设置(节点, "文本", 己.节点文本(字典获取(事件项["数据"], "消息")))
      列表追加(节点表, 节点)
    返回 节点表

  # 对标 textOf：单 text 块 → 文本；空 content → ""；其余 → 空
  段落 节点文本 接收 消息:
    如果 消息 == 空:
      返回 ""
    设 内容 为 字典获取(消息, "content")
    如果 内容 == 空:
      返回 ""
    如果 长度(内容) == 0:
      返回 ""
    如果 长度(内容) == 1 且 字典获取(内容[0], "type") == "text":
      返回 字典获取(内容[0], "text")
    返回 空

  # 提交意图：追加新头节点
  段落 提交追加 接收 渲染文本:
    设 意图 为 {"表面操作": "append"}
    返回 ["消息": 造系统消息(渲染文本, "system-prompt"), "意图": 意图]

  # 提交意图：改写指定序号节点（light 以意图字典随事件持久，源事件序号供表面折叠消化）
  段落 提交替换 接收 序号, 渲染文本:
    设 表面 为 {"操作": "replace", "开始序号": 序号, "结束序号": 序号}
    设 表面表 为 []
    列表追加(表面表, 表面)
    设 源表 为 []
    列表追加(源表, 序号)
    设 意图 为 {"表面操作": "replace"}
    字典设置(意图, "表面", 表面表)
    字典设置(意图, "源事件序号", 源表)
    返回 ["消息": 造系统消息(渲染文本, "system-prompt"), "意图": 意图]

  # 投影：渲染文本 + {"读历史提示": 真/假, "开始系列": 真/假} → 提交意图表
  段落 投影 接收 渲染文本, 输入:
    设 节点表 为 己.系统节点表()
    设 提交表 为 []
    设 头节点 为 空
    如果 长度(节点表) > 0:
      设 头节点 为 节点表[0]
    如果 头节点 == 空:
      列表追加(提交表, 己.提交追加(渲染文本))
      返回 提交表
    设 读历史 为 字典获取(输入, "读历史提示")
    设 开始系列 为 字典获取(输入, "开始系列")
    如果 读历史 == 假 或 开始系列 == 真 或 渲染文本 == "":
      # 归一化：清空其余非空节点，改写头节点
      遍历 节点 之 节点表:
        如果 节点["序号"] == 头节点["序号"]:
          继续
        如果 节点["文本"] == "":
          继续
        列表追加(提交表, 己.提交替换(节点["序号"], ""))
      如果 头节点["文本"] != 渲染文本:
        列表追加(提交表, 己.提交替换(头节点["序号"], 渲染文本))
      返回 提交表
    # 有能力 + 继续系列：最新非空节点与渲染文本不同 → 追加
    设 最新 为 空
    遍历 节点 之 节点表:
      如果 节点["文本"] != "":
        设 最新 为 节点
    如果 最新 != 空 且 最新["文本"] == 渲染文本:
      返回 提交表
    列表追加(提交表, 己.提交追加(渲染文本))
    返回 提交表

类 代理循环:
  属性 会话对象 等于 空
  属性 客户端对象 等于 空
  属性 注册表 等于 空
  属性 选项 等于 空
  属性 轮号 等于 空
  属性 步号 等于 空
  属性 钩子系统 等于 空
  属性 并发上限 等于 空
  属性 压缩管理器 等于 空
  属性 审批管理器 等于 空
  属性 遥测 等于 空
  属性 最大步数 等于 25
  属性 本轮输入token 等于 0
  属性 本轮输出token 等于 0
  # A3 溢出重试可配置：最大重试次数（默认2，范围0-5）、重试间隔秒（默认1）
  属性 最大重试次数 等于 2
  属性 重试间隔秒 等于 1
  # 重试统计：{触发次数, 成功次数, 失败次数, 最后错误}
  属性 重试统计 等于 空
  # 系统提示投影（请求系列决策面对象）
  属性 投影器 等于 空
  # 请求面世代（对标 requestSurfaceGeneration 锁存值；快照 = 自记替换数 + 压缩遮蔽数）
  属性 请求面世代 等于 0
  属性 自记替换数 等于 0
  # 请求头准入状态：本循环实例是否已记过 request/header
  属性 已记请求头 等于 假
  # request/context 去重（JSON 串比较；空 = 尚未记录）
  属性 上次请求上下文串 等于 ""
  # 预步决策声明 startsRequestSeries（对标 agent/pre-step decision.startsRequestSeries）
  属性 声明开始系列 等于 假
  # 中止语义（对标 cancel/AbortSignal）：置位后正在成形的尝试按中断结算
  属性 中止标志 等于 假
  属性 中止原因 等于 空
  # 中断空内容结算计数（assistant/attempt 事件无 turn/step 之外的标识，用于测试）
  属性 活跃尝试号 等于 0

  段落 构造 接收 会话对象, 客户端对象, 注册表, 选项:
    设 己.会话对象 为 会话对象
    设 己.客户端对象 为 客户端对象
    设 己.注册表 为 注册表
    设 己.选项 为 选项
    设 己.轮号 为 0
    设 己.步号 为 0
    设 己.并发上限 为 4
    设 己.投影器 为 新建 系统提示投影(会话对象)
    # v2 自动压缩：选项["压缩配置"] = {上下文窗口, 阈值比例, 保留条数}
    如果 选项 != 空 且 选项.包含("压缩配置"):
      设 己.压缩管理器 为 新建 压缩管理器(己.会话对象, 选项["压缩配置"])
    # v2 用户审批：选项["审批管理器"] 直接传入实例
    如果 选项 != 空 且 选项.包含("审批管理器"):
      设 己.审批管理器 为 选项["审批管理器"]
    # 遥测：选项["遥测"] 直接传入实例
    如果 选项 != 空 且 选项.包含("遥测"):
      设 己.遥测 为 选项["遥测"]
    如果 选项 != 空 且 选项.包含("最大步数"):
      设 己.最大步数 为 选项["最大步数"]
    # A3 溢出重试可配置：读取最大重试次数（钳制0-5）与重试间隔秒
    如果 选项 != 空 且 选项.包含("最大重试次数"):
      设 己.最大重试次数 为 选项["最大重试次数"]
      如果 己.最大重试次数 < 0:
        设 己.最大重试次数 为 0
      如果 己.最大重试次数 > 5:
        设 己.最大重试次数 为 5
    如果 选项 != 空 且 选项.包含("重试间隔秒"):
      设 己.重试间隔秒 为 选项["重试间隔秒"]
    # 初始化重试统计
    设 己.重试统计 为 ["触发次数": 0, "成功次数": 0, "失败次数": 0, "最后错误": ""]
    设 己.本轮输入token 为 0
    设 己.本轮输出token 为 0

  # 连接三域钩子系统（agent 域 / capability 域实时事件）
  段落 连接钩子 接收 钩子系统:
    己.钩子系统 为 钩子系统

  # 向 agent 域发事件（未连接钩子则空操作）
  段落 发出代理事件 接收 类型, 数据:
    如果 己.钩子系统 不等于 空:
      己.钩子系统.发布("agent", 类型, 数据, 己.会话对象)

  # 向 capability 域发事件（未连接钩子则空操作）
  段落 发出能力事件 接收 类型, 数据:
    如果 己.钩子系统 不等于 空:
      己.钩子系统.发布("capability", 类型, 数据, 己.会话对象)

  # ===== 请求系列决策（对标 agent/pre-step decision.startsRequestSeries 声明点）=====
  # 目标轮次驱动（目标折叠.light 预步决策返回 "enter"）在预步阶段调用本方法，
  # 声明下一个请求是请求系列（同会话自动续作）的开始。
  段落 声明请求系列 接收:
    设 己.声明开始系列 为 真

  # ===== 中止语义（对标 cancel(cause)）=====
  # 置位后：正在成形的助手尝试按中断结算（非空内容 → 中断 assistant/message；空 → assistant/attempt），
  # 当前轮次以 aborted 收束。不追溯改写已结算步骤。
  段落 终止 接收 原因:
    设 己.中止标志 为 真
    设 己.中止原因 为 原因

  段落 是已终止 接收:
    返回 己.中止标志

  # 请求配置（对标 config.provider/model；light 客户端仅有 模型名，提供方取选项）
  段落 请求配置 接收:
    设 提供方 为 ""
    如果 己.选项 != 空 且 己.选项.包含("提供方"):
      设 提供方 为 己.选项["提供方"]
    设 模型 为 己.客户端对象.模型名
    如果 模型 == 空:
      设 模型 为 ""
    返回 {"提供方": 提供方, "模型": 模型}

  # 读后置提示能力 stand-in（对标 route.capabilities 含 history-aware-system-prompt）
  段落 读后置提示 接收:
    如果 己.选项 != 空 且 己.选项.包含("路由读后置系统提示"):
      返回 己.选项["路由读后置系统提示"]
    返回 假

  # 渲染系统提示 stand-in（对标 route 的 prompt runner 产物）
  段落 渲染系统提示 接收:
    如果 己.选项 != 空 且 己.选项.包含("系统提示文本"):
      返回 己.选项["系统提示文本"]
    返回 ""

  # 最新已记录的 request/header 数据（对标 requestHeader()；无 → 空）
  段落 当前请求头 接收:
    设 事件项表 为 己.会话对象.查询事件("request/header", 0, 0)
    如果 长度(事件项表) == 0:
      返回 空
    返回 事件项表[长度(事件项表) - 1]["数据"]

  # 压缩遮蔽数（压缩面变化计入请求面世代；路 1 node folding 落地前的等价计数）
  段落 面遮蔽数 接收:
    设 计数 为 0
    设 事件项表 为 己.会话对象.查询事件("", 0, 0)
    遍历 事件项 之 事件项表:
      如果 事件项.包含("遮蔽") 且 事件项["遮蔽"]:
        设 计数 为 计数 + 1
    返回 计数

  段落 请求面世代快照 接收:
    返回 己.自记替换数 + 己.面遮蔽数()

  段落 面代变化 接收:
    如果 己.请求面世代 != 己.请求面世代快照():
      返回 真
    返回 假

  # 工具模式变化（对标 toolsChanged：与最新请求头中的工具模式比较；无基线 → 假）
  段落 工具模式变化 接收 工具模式表:
    设 基线 为 己.当前请求头()
    如果 基线 == 空:
      返回 假
    如果 序列化JSON(字典获取(基线, "工具模式")) != 序列化JSON(工具模式表):
      返回 真
    返回 假

  # ===== 系统提示提交（对标 SystemPromptProjection.project + commit）=====
  # 计算开始系列（仅预步声明，首尝试有效）→ 投影 → 逐提交记录 system/message；
  # replace 提交计入自记替换数（请求面世代的一部分）。
  段落 准备请求准入 接收 轮次, 步骤, 项目系列:
    设 渲染提示 为 己.渲染系统提示()
    设 输入 为 {"读历史提示": 己.读后置提示()}
    字典设置(输入, "开始系列", 项目系列)
    设 提交表 为 己.投影器.投影(渲染提示, 输入)
    遍历 提交 之 提交表:
      设 意图 为 字典获取(提交, "意图")
      如果 字典获取(意图, "表面操作") == "replace":
        设 己.自记替换数 为 己.自记替换数 + 1
      设 数据 为 {"turn": 轮次, "step": 步骤}
      字典设置(数据, "消息", 字典获取(提交, "消息"))
      字典设置(数据, "意图", 意图)
      # V3 catalog 形状（定词汇 system/message：["系统"]+["表面操作"]）：随 消息/意图 并存，
      # 供 会话.投影节点0/整理消息 与 V3 编解码使用；文本取自提交消息（节点文本 单 text 块）
      字典设置(数据, "系统", 己.投影器.节点文本(字典获取(提交, "消息")))
      字典设置(数据, "表面操作", 字典获取(意图, "表面操作", "append"))
      己.会话对象.记录事件("system/message", 数据)
    返回 空

  # ===== 请求头准入（对标 buildRequest 的 request/header + request/context 追加与世代锁定）=====
  # 原因：本实例首记 → initial（无基线）或 resume（会话已有基线）；配置/工具变化 → change；
  # 开始请求系列且头不变 → series。request/context 仅变化时记录。末尾锁定请求面世代。
  段落 记录请求准入 接收 轮次, 步骤, 工具模式表, 开始系列:
    设 配置 为 己.请求配置()
    设 渲染提示 为 己.渲染系统提示()
    设 基线 为 己.当前请求头()
    设 需记 为 假
    设 原因 为 ""
    如果 己.已记请求头 == 假:
      如果 基线 == 空:
        设 原因 为 "initial"
      否则:
        设 原因 为 "resume"
      设 需记 为 真
    否则如果 基线 == 空:
      设 原因 为 "change"
      设 需记 为 真
    否则:
      设 基线指纹 为 序列化JSON(["配置": 字典获取(基线, "配置"), "工具模式": 字典获取(基线, "工具模式")])
      设 新指纹 为 序列化JSON(["配置": 配置, "工具模式": 工具模式表])
      如果 基线指纹 != 新指纹:
        设 原因 为 "change"
        设 需记 为 真
      否则如果 开始系列:
        设 原因 为 "series"
        设 需记 为 真
    如果 需记:
      设 数据 为 {"turn": 轮次, "step": 步骤}
      字典设置(数据, "配置", 配置)
      字典设置(数据, "系统提示", 渲染提示)
      字典设置(数据, "工具模式", 工具模式表)
      字典设置(数据, "原因", 原因)
      字典设置(数据, "开始系列", 开始系列)
      己.会话对象.记录事件("request/header", 数据)
      设 己.已记请求头 为 真
    # request/context：仅变化时记录
    设 上下文 为 {"提供方": 字典获取(配置, "提供方"), "模型": 字典获取(配置, "模型")}
    字典设置(上下文, "读后置提示", 己.读后置提示())
    设 上下文串 为 序列化JSON(上下文)
    如果 己.上次请求上下文串 != 上下文串:
      己.会话对象.记录事件("request/context", 上下文)
      设 己.上次请求上下文串 为 上下文串
    # 请求面世代锁定（对标 buildRequest 末尾的 requestSurfaceGeneration latch）
    设 己.请求面世代 为 己.请求面世代快照()
    返回 空

  # ===== 中断结算（对标 abort 后 AssistantStreamAttempt 的 interrupted 分支）=====
  # 非空内容 → 中断 assistant/message；空内容 → assistant/attempt。
  段落 结算被终止尝试 接收 轮次, 步骤, 内容块表, 用量:
    设 配置 为 己.请求配置()
    如果 长度(内容块表) > 0:
      设 消息 为 造助手消息(内容块表, 字典获取(配置, "提供方"), 字典获取(配置, "模型"))
      设 数据 为 {"turn": 轮次, "step": 步骤}
      字典设置(数据, "消息", 消息)
      字典设置(数据, "用量", 用量)
      字典设置(数据, "中断", 真)
      己.会话对象.记录事件("assistant/message", 数据)
    否则:
      设 己.活跃尝试号 为 己.活跃尝试号 + 1
      己.会话对象.记录事件("assistant/attempt", ["turn": 轮次, "step": 步骤])
    返回 空

  # 驱动一个轮次（同步），返回轮次结束原因
  段落 驱动 接收 用户文本:
    设 轮次开始 为 时间戳()
    设 己.本轮输入token 为 0
    设 己.本轮输出token 为 0
    设 己.轮号 为 己.轮号 + 1
    设 轮次 为 己.轮号
    己.会话对象.记录轮次开始()
    己.发出代理事件("turn/start", ["turn": 轮次])
    如果 己.遥测 != 空:
      己.遥测.记录轮次开始(轮次)
    设 消息 为 造用户消息([造文本块(用户文本)])
    己.会话对象.记录事件("user/message", 消息)
    设 轮次结果 为 空
    设 进行中 为 真
    设 己.步号 为 0
    当 进行中:
      设 跳过本步 为 假
      # 中止检查（对标 turn 循环顶部 signal.throwIfAborted）
      如果 己.是已终止():
        设 轮次耗时 为 时间戳() - 轮次开始
        设 轮次结果 为 ["种类": "aborted", "原因": 己.中止原因, "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
        设 进行中 为 假
        设 跳过本步 为 真
      如果 跳过本步 == 假:
        如果 己.步号 >= 己.最大步数:
          设 轮次耗时 为 时间戳() - 轮次开始
          设 轮次结果 为 ["种类": "max-steps", "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
          设 进行中 为 假
          设 跳过本步 为 真
      如果 跳过本步 == 假:
        设 己.步号 为 己.步号 + 1
        设 步骤 为 己.步号
        己.会话对象.记录事件("step/start", ["turn": 轮次, "step": 步骤])
        设 结束 为 己.执行步骤(轮次, 步骤)
        己.会话对象.记录事件("step/end", ["turn": 轮次, "step": 步骤])
        设 轮次耗时 为 时间戳() - 轮次开始
        如果 结束 == "completed":
          设 轮次结果 为 ["种类": "completed", "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
          设 进行中 为 假
        否则如果 结束 == "max-tokens":
          设 轮次结果 为 ["种类": "max-tokens", "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
          设 进行中 为 假
        否则如果 结束 == "aborted":
          设 轮次结果 为 ["种类": "aborted", "原因": 己.中止原因, "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
          设 进行中 为 假
        否则如果 结束 == "continue":
          设 进行中 为 真
        否则:
          设 轮次结果 为 ["种类": "error", "失败": 结束, "步骤数": 己.步号, "输入token": 己.本轮输入token, "输出token": 己.本轮输出token, "耗时秒": 轮次耗时]
          设 进行中 为 假
    己.会话对象.记录轮次结束(轮次结果, 空)
    己.发出代理事件("turn/end", ["turn": 轮次, "原因": 轮次结果])
    如果 己.遥测 != 空:
      己.遥测.记录轮次结束(轮次, 轮次结果)
    返回 轮次结果

  # 执行一个步骤：请求 → 流 → 组装 → 助手消息 → 工具调用 → 循环
  # 返回 "completed" / "max-tokens" / 失败字典
  # A3：溢出重试读取 己.最大重试次数 / 己.重试间隔秒，每次重试更新 己.重试统计
  段落 执行步骤 接收 轮次, 步骤:
    设 进行中 为 真
    设 溢出重试 为 0
    设 本步触发重试 为 0
    # 预步声明的 startsRequestSeries 仅本步首尝试有效（对标 firstAttempt && decision.startsRequestSeries）
    设 系列声明 为 己.声明开始系列
    设 己.声明开始系列 为 假
    设 首次尝试 为 真
    当 进行中:
      设 步骤开始 为 时间戳()
      # 中止检查（对标请求前 signal.throwIfAborted）
      如果 己.是已终止():
        返回 "aborted"
      # v2 自动压缩：step 前检查 token 压力，超过阈值则压缩
      如果 己.压缩管理器 != 空:
        己.压缩管理器.检查并压缩()
      # ===== 预步准入：系统提示提交 → 请求头/上下文（对标 preStep 投影 + buildRequest）=====
      设 项目系列 为 首次尝试 且 系列声明
      设 面代变 为 己.面代变化()
      设 工具模式表 为 己.注册表.描述表()
      设 工具变 为 己.工具模式变化(工具模式表)
      设 开始系列 为 项目系列 或 面代变 或 工具变
      己.准备请求准入(轮次, 步骤, 项目系列)
      己.记录请求准入(轮次, 步骤, 工具模式表, 开始系列)
      设 首次尝试 为 假
      设 消息表 为 己.会话对象.整理消息()
      设 网络消息 为 映射网络消息(消息表)
      设 块表 为 []
      设 请求错误 为 空
      尝试:
        设 块表 为 己.客户端对象.对话响应(网络消息, 己.选项, 工具模式表)
      捕获 异常:
        设 请求错误 为 转字符串(异常)
      如果 请求错误 != 空:
        如果 己.是溢出错误(请求错误) 且 己.压缩管理器 != 空 且 溢出重试 < 己.最大重试次数:
          # A3：记录最后错误、触发统计，压缩后按配置间隔等待再重试
          设 己.重试统计["最后错误"] 为 请求错误
          设 己.重试统计["触发次数"] 为 己.重试统计["触发次数"] + 1
          设 本步触发重试 为 本步触发重试 + 1
          己.压缩管理器.检查并压缩()
          设 溢出重试 为 溢出重试 + 1
          如果 己.重试间隔秒 > 0:
            休眠(己.重试间隔秒)
          继续
        # 重试耗尽或不可重试：若本步触发过重试则记一次失败
        如果 本步触发重试 > 0:
          设 己.重试统计["失败次数"] 为 己.重试统计["失败次数"] + 1
          设 己.重试统计["最后错误"] 为 请求错误
        返回 ["种类": "error", "失败": 请求错误]
      设 组装器 为 新建 块组装器()
      设 块序表 为 []
      遍历 块 之 块表:
        设 事件记录 为 己.会话对象.记录事件("assistant/chunk", ["turn": 轮次, "step": 步骤, "chunk": 块])
        块序表.追加(事件记录["序号"])
        组装器.送入(块)
      # 请求期间被终止：按中断结算已成形内容（对标 abort 后的 interrupted 分支）
      如果 己.是已终止():
        己.结算被终止尝试(轮次, 步骤, 组装器.块表(), 组装器.用量())
        返回 "aborted"
      设 完成原因 为 组装器.完成原因()
      如果 完成原因["种类"] == "error":
        设 失败描述 为 转字符串(完成原因["失败"])
        如果 己.是溢出错误(失败描述) 且 己.压缩管理器 != 空 且 溢出重试 < 己.最大重试次数:
          # A3：记录最后错误、触发统计，压缩后按配置间隔等待再重试
          设 己.重试统计["最后错误"] 为 失败描述
          设 己.重试统计["触发次数"] 为 己.重试统计["触发次数"] + 1
          设 本步触发重试 为 本步触发重试 + 1
          己.压缩管理器.检查并压缩()
          设 溢出重试 为 溢出重试 + 1
          如果 己.重试间隔秒 > 0:
            休眠(己.重试间隔秒)
          继续
        # 重试耗尽：若本步触发过重试则记一次失败
        如果 本步触发重试 > 0:
          设 己.重试统计["失败次数"] 为 己.重试统计["失败次数"] + 1
          设 己.重试统计["最后错误"] 为 失败描述
        返回 完成原因["失败"]
      如果 完成原因["种类"] == "aborted":
        # 流级中止完成 → 同样按中断结算（非空内容记中断消息，空内容记 attempt）
        己.结算被终止尝试(轮次, 步骤, 组装器.块表(), 组装器.用量())
        返回 "aborted"
      # A3：本步触发过重试且最终成功，记一次成功
      如果 本步触发重试 > 0:
        设 己.重试统计["成功次数"] 为 己.重试统计["成功次数"] + 1
      设 内容 为 组装器.块表()
      设 消息 为 造助手消息(内容, 己.客户端对象.模型名, 己.客户端对象.模型名)
      己.会话对象.记录事件("assistant/message", ["turn": 轮次, "step": 步骤, "消息": 消息, "用量": 组装器.用量()])
      如果 己.遥测 != 空:
        设 步骤延迟 为 时间戳() - 步骤开始
      设 步骤用量 为 组装器.用量()
      如果 步骤用量 != 空:
        如果 步骤用量.包含("输入"):
          设 己.本轮输入token 为 己.本轮输入token + 步骤用量["输入"]
        如果 步骤用量.包含("输出"):
          设 己.本轮输出token 为 己.本轮输出token + 步骤用量["输出"]
      如果 己.遥测 != 空:
        设 步骤延迟 为 时间戳() - 步骤开始
        己.遥测.记录步骤(轮次, 步骤, 步骤延迟, 步骤用量)
      如果 完成原因["种类"] == "max-tokens":
        返回 "max-tokens"
      设 工具调用块表 为 []
      遍历 块 之 内容:
        如果 块["type"] == "tool-call":
          工具调用块表.追加(块)
      如果 长度(工具调用块表) == 0:
        返回 "completed"
      设 结语 为 己.执行工具调用(轮次, 步骤, 工具调用块表)
      如果 结语 == 真:
        返回 "completed"
      设 进行中 为 假
      返回 "continue"
    返回 "completed"

  段落 执行工具调用 接收 轮次, 步骤, 工具调用块表:
    设 规划表 为 []
    遍历 块 之 工具调用块表:
      设 参数 为 解析参数(块["arguments"])
      规划表.追加(["块": 块, "参数": 参数])
    设 下标 为 0
    设 结语 为 假
    当 下标 < 长度(规划表):
      设 首个 为 规划表[下标]
      设 组 为 [首个]
      设 策略 为 己.注册表.执行策略(首个["块"]["name"])
      如果 策略 == "parallel":
        设 组 为 []
        设 扫描 为 下标
        设 组外 为 假
        当 扫描 < 长度(规划表) 且 组外 == 假:
          如果 己.注册表.执行策略(规划表[扫描]["块"]["name"]) == "parallel":
            组.追加(规划表[扫描])
            设 扫描 为 扫描 + 1
          否则:
            设 组外 为 真
      设 组结果 为 己.执行组(轮次, 步骤, 组)
      设 下标 为 下标 + 长度(组)
      如果 组结果["结语"]:
        设 结语 为 真
    返回 结语

  # 执行一组：>1 项并行（线程，分批限流，结果按模型序回填）；单例顺序
  # ⚠️ 线程只跑 注册表.执行；tool/call、tool/result 事件一律在主线程记录（事件总线非线程安全）
  段落 执行组 接收 轮次, 步骤, 组:
    设 结语 为 假
    如果 长度(组) <= 1:
      # 单例：顺序执行
      设 项 为 组[0]
      设 块 为 项["块"]
      设 调用事件 为 己.会话对象.记录事件("tool/call", ["turn": 轮次, "step": 步骤, "callId": 块["id"], "name": 块["name"], "arguments": 块["arguments"]])
      # v2 用户审批：执行前检查，拒绝则记录 tool/error 并跳过
      如果 己.审批管理器 != 空:
        设 审批 为 己.审批管理器.请求审批(块["name"], 块["arguments"])
        如果 审批["批准"] == 假:
          己.会话对象.记录事件("tool/error", ["turn": 轮次, "step": 步骤, "callId": 块["id"], "name": 块["name"], "错误": 审批["原因"]])
          返回 ["结语": 假]
      设 工具开始 为 时间戳()
      设 结果 为 己.注册表.执行(块["name"], 块["arguments"])
      如果 己.遥测 != 空:
        己.遥测.记录工具调用(块["name"], 时间戳() - 工具开始)
      己.记录结果事件(轮次, 步骤, 调用事件, 块, 结果)
      如果 结果.包含("concludesTurn") 且 结果["concludesTurn"] == 真:
        设 结语 为 真
      返回 ["结语": 结语]
    # 并行：分批（并发上限）起线程 → join → 主线程按序记录
    设 批 为 己.并发上限
    设 起 为 0
    当 起 < 长度(组):
      设 止 为 起 + 批
      如果 止 > 长度(组):
        设 止 为 长度(组)
      设 线程表 为 []
      设 k 为 起
      当 k < 止:
        设 项 为 组[k]
        设 块 为 项["块"]
        # v2 用户审批：并行执行前检查，拒绝则记录 error 并跳过（不启动线程）
        设 审批通过 为 真
        如果 己.审批管理器 != 空:
          设 审批 为 己.审批管理器.请求审批(块["name"], 块["arguments"])
          如果 审批["批准"] == 假:
            设 审批通过 为 假
            己.会话对象.记录事件("tool/error", ["turn": 轮次, "step": 步骤, "callId": 块["id"], "name": 块["name"], "错误": 审批["原因"]])
        如果 审批通过 == 假:
          设 k 为 k + 1
          继续
        设 工作线程 为 新建 线程(跑单工具, 己.注册表, 块["name"], 块["arguments"])
        工作线程.开始()
        线程表.追加(["线程": 工作线程, "块": 块])
        设 k 为 k + 1
      遍历 记录 之 线程表:
        记录["线程"].等待()
      遍历 记录 之 线程表:
        设 块 为 记录["块"]
        设 调用事件 为 己.会话对象.记录事件("tool/call", ["turn": 轮次, "step": 步骤, "callId": 块["id"], "name": 块["name"], "arguments": 块["arguments"]])
        设 结果 为 记录["线程"].获取结果()
        己.记录结果事件(轮次, 步骤, 调用事件, 块, 结果)
        如果 结果.包含("concludesTurn") 且 结果["concludesTurn"] == 真:
          设 结语 为 真
      设 起 为 止
    返回 ["结语": 结语]

  # v3 溢出恢复：检测错误描述是否为上下文溢出
  段落 是溢出错误 接收 描述:
    如果 描述.包含("context"):
      返回 真
    如果 描述.包含("Context"):
      返回 真
    如果 描述.包含("overflow"):
      返回 真
    如果 描述.包含("maximum context"):
      返回 真
    如果 描述.包含("too long"):
      返回 真
    如果 描述.包含("400"):
      返回 真
    返回 假

  # 记录工具结果事件 + 发能力钩子（主线程）
  段落 记录结果事件 接收 轮次, 步骤, 调用事件, 块, 结果:
    设 结果消息 为 造工具结果消息(块["id"], 结果["content"], 结果["isError"])
    己.会话对象.记录事件("tool/result", ["turn": 轮次, "step": 步骤, "消息": 结果消息, "源序号": 调用事件["序号"]])
    己.发出能力事件("tool/executed", ["turn": 轮次, "step": 步骤, "name": 块["name"], "成功": 结果["isError"] == 假])
