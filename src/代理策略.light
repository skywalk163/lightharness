# 代理策略.light —— 对齐原版 packages/util/http-proxy/src/policy.ts（纯逻辑、零传输依赖）
#
# 复刻范围：EnvLookup / ProxyPolicy / ProxyResolution / ProxyDiagnostic 接口投影；
#   常量 LOOPBACK_NO_PROXY / POLICY_ENV_NAMES / PROXY_ENV_NAMES / DIRECT_POLICY；
#   函数 isSupportedProxyUrl / isLoopbackHost / bypassesProxy / resolveProxyPolicy / proxyForUrl；
#   辅助 readEnv / acceptProxyUrl / resolveScheme / withLoopback / splitHostPort。
#   跳过 install.ts（undici 宿主传输装配）。
#
# 光明差异口径（报告登记）：
#   1) 原版用 URL 类（URL.parse / url.hostname / url.port）；光明无 URL 类，
#      用 stdlib HTTP解析URL（urllib.parse.urlparse）得到 {协议, 域名, ...}，
#      hostname/port 由 netloc（域名）经 拆分网络位置 还原（剥 userinfo、方括号 IPv6、
#      单冒号拆端口）。协议 键无冒号，比较时拼回 "http:"/"https:" 对齐上游 SUPPORTED_PROTOCOLS。
#   2) EnvLookup 接受「字典或带 获取 方法的对象」；条目形态接受 {value,...} 对象
#      （启动环境快照的 get 返回 {值,来源,路径}）或裸字符串（测试直构）。
#   3) SOCKS/unsupported 拒绝消息为上游文案逐字对齐；invalid URL 在光明侧由
#      urlparse 宽松解析承担（空协议 → 不在支持表 → invalid 诊断）。
#   4) 字符串原语（转小写/转大写/替换字符串/去除空白/截取/码位 等）一律用编译器
#      内置映射裸名（编译器自动加 _light_builtin. 前缀），不 import 模块：
#      被导入模块内部 import 字符串工具轻量 等 .light 模块会在运行.py 内联路径
#      下产生名称解析错乱（实测 'int' object is not callable），裸名路径稳定。

从 正则表达式 导入 完全匹配, 分组匹配
从 HTTP 导入 HTTP解析URL

# =====================================================================
# 常量（对齐 LOOPBACK_NO_PROXY / POLICY_ENV_NAMES / PROXY_ENV_NAMES / DIRECT_POLICY）
# =====================================================================
# 环回条目并入每个策略的 noProxy。代理若同时代理本机环回流量，
# 会把 Web UI / Connection 传输 / 每个本地测试服务器变成路由环，因此豁免不可选。
设 环回豁免表 为 ["localhost", "127.0.0.1", "::1", "[::1]"]

# 代理环境名全表（含 ALL_PROXY 回退，本包解析但不写回）
设 代理环境名表 为 ["http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY", "no_proxy", "NO_PROXY", "all_proxy", "ALL_PROXY"]

# 直连策略：不代理任何流量（对齐 DIRECT_POLICY）
设 直连策略 为 {"无代理": "", "来源": "none"}

# 支持的代理 URL 协议（带冒号，对齐 SUPPORTED_PROTOCOLS）
设 支持协议表 为 ["http:", "https:"]
# SOCKS 协议（仅诊断命名，永不路由）
设 SOCKS协议表 为 ["socks:", "socks4:", "socks4a:", "socks5:", "socks5h:"]

# 环回 IPv4 正则：整段 127.0.0.0/8，单八位组不允许 127.999.1.1（对齐 LOOPBACK_IPV4）
设 环回IPv4模式 为 "^127\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)\\.(?:25[0-5]|2[0-4]\\d|1\\d\\d|[1-9]?\\d)$"
# IPv4-mapped IPv6 十六进制组形态：::ffff:7f00:1（点分形态走 环回IPv4模式 的 ::ffff: 剥离）
# 注意：光明字符串把 {1,4} 当作重复语法，正则量词花括号会被破坏，
# 故用等价的 [0-9a-f][0-9a-f]?[0-9a-f]?[0-9a-f]?（1-4 位）写法。
设 映射IPv6模式 为 "^::ffff:([0-9a-f][0-9a-f]?[0-9a-f]?[0-9a-f]?):[0-9a-f][0-9a-f]?[0-9a-f]?[0-9a-f]?$"

# =====================================================================
# 环境读取（readEnv）
# 小写优先、大写回退（对齐 undici ?? 链优先级）；空白值视为未设置。
# =====================================================================
段落 读环境 接收 环境, 小写名:
  设 名称表 为 [小写名, 转大写(小写名)]
  遍历 名称 之 名称表:
    设 条目 为 环境.获取(名称, 空)
    如果 条目 == 空:
      继续
    设 原始 为 空
    如果 是字典(条目) 且 字典包含键(条目, "value"):
      设 原始 为 条目["value"]
    否则:
      设 原始 为 条目
    设 修整 为 去除空白(原始)
    如果 修整 != "":
      返回 ["值": 修整, "名称": 名称]
  返回 空

# =====================================================================
# 代理 URL 判定与候选接受（isSupportedProxyUrl / acceptProxyUrl）
# =====================================================================
段落 判定支持代理URL 接收 值:
  设 解析 为 HTTP解析URL(值)
  设 协议 为 解析["协议"] + ":"
  返回 列表包含(支持协议表, 协议)

# 候选 = {值, 名称}；返回 {"种类": "接受"/"拒绝"/"缺位", "值"?, "名称"?}
段落 接受代理URL 接收 候选, 诊断表:
  如果 候选 == 空:
    返回 ["种类": "缺位"]
  设 解析 为 HTTP解析URL(候选["值"])
  设 协议 为 解析["协议"] + ":"
  如果 列表包含(SOCKS协议表, 协议):
    列表追加(诊断表, ["种类": "socks", "来源": 候选["名称"], "消息": 候选["名称"] + " names a SOCKS proxy, which is not supported; connecting directly for that scheme — set an http:// or https:// proxy URL instead"])
    返回 ["种类": "拒绝", "名称": 候选["名称"]]
  如果 列表包含(支持协议表, 协议) == 假:
    列表追加(诊断表, ["种类": "invalid", "来源": 候选["名称"], "消息": 候选["名称"] + " uses the unsupported " + 协议 + "// scheme; connecting directly for that scheme — set an http:// or https:// proxy URL instead"])
    返回 ["种类": "拒绝", "名称": 候选["名称"]]
  返回 ["种类": "接受", "值": 候选["值"], "名称": 候选["名称"]]

# =====================================================================
# 方案解析（resolveScheme）
# 己方接受 → 用己方；己方被拒 → 该方案保持直连（诊断与路由一致）；
# 己方缺位 → 按序回退。
# =====================================================================
段落 解析方案 接收 己方, 回退表:
  如果 己方 == 空:
    返回 空
  如果 己方["种类"] == "接受":
    返回 己方["值"]
  如果 己方["种类"] == "拒绝":
    返回 空
  遍历 值 之 回退表:
    如果 值 != 空:
      返回 值
  返回 空

# =====================================================================
# 豁免条目拆分（split /[,\s]+/ 投影）与环回并入（withLoopback）
# =====================================================================
段落 拆豁免条目 接收 文本:
  设 条目表 为 []
  设 当前 为 ""
  设 i 为 0
  当 i < 长度(文本):
    设 字符 为 文本[i]
    如果 字符 == "," 或 字符 == " " 或 字符 == "\t" 或 字符 == "\n" 或 字符 == "\r":
      如果 当前 != "":
        列表追加(条目表, 当前)
        设 当前 为 ""
    否则:
      设 当前 为 当前 + 字符
    设 i 为 i + 1
  如果 当前 != "":
    列表追加(条目表, 当前)
  返回 条目表

# 并入环回：保留调用方条目与顺序；* 已全豁免则原样返回
段落 并入环回 接收 无代理:
  设 原始 为 ""
  如果 无代理 != 空:
    设 原始 为 无代理
  设 条目表 为 拆豁免条目(原始)
  遍历 条目 之 条目表:
    如果 条目 == "*":
      返回 "*"
  设 已有 为 []
  遍历 条目 之 条目表:
    列表追加(已有, 转小写(条目))
  设 结果 为 []
  遍历 条目 之 条目表:
    列表追加(结果, 条目)
  遍历 环回项 之 环回豁免表:
    如果 列表包含(已有, 环回项) == 假:
      列表追加(结果, 环回项)
  设 连接 为 ""
  设 j 为 0
  当 j < 长度(结果):
    如果 j > 0:
      设 连接 为 连接 + ","
    设 连接 为 连接 + 结果[j]
    设 j 为 j + 1
  返回 连接

# =====================================================================
# 主机:端口拆分（splitHostPort 投影）
# 裸 IPv6 字面量含多个冒号且无端口：仅单冒号条目拆分；
# 方括号字面量的端口取方括号之后。写错它正是 undici 把 ::1 读成 主机":"端口"1" 的根因。
# =====================================================================
段落 查找子串从 接收 文本, 子串, 起点:
  设 片段 为 截取(文本, 起点, 长度(文本))
  设 位 为 查找子串(片段, 子串)
  如果 位 < 0:
    返回 -1
  返回 位 + 起点

段落 拆分主机端口 接收 条目:
  如果 开头(条目, "["):
    设 闭 为 查找子串(条目, "]")
    如果 闭 >= 0:
      设 余 为 截取(条目, 闭 + 1, 长度(条目))
      设 主机 为 截取(条目, 1, 闭)
      如果 开头(余, ":"):
        返回 ["主机": 主机, "端口": 截取(余, 1, 长度(余))]
      返回 ["主机": 主机]
  设 冒号 为 查找子串(条目, ":")
  如果 冒号 >= 0:
    设 再冒号 为 查找子串从(条目, ":", 冒号 + 1)
    如果 再冒号 < 0:
      返回 ["主机": 截取(条目, 0, 冒号), "端口": 截取(条目, 冒号 + 1, 长度(条目))]
  返回 ["主机": 条目]

# =====================================================================
# 环回主机判定（isLoopbackHost）
# 代理无法有意义地到达本机：它会在自己的网络中解析地址，本机代理到达的
# 是仅监听环回的服务。除四个字面条目外还须覆盖 127.0.0.0/8 其余地址与
# IPv4-mapped 拼写。
# =====================================================================
段落 去括号去点小写 接收 主机名:
  设 主机 为 转小写(主机名)
  如果 开头(主机, "["):
    设 主机 为 截取(主机, 1, 长度(主机))
  如果 结尾(主机, "]"):
    设 主机 为 截取(主机, 0, 长度(主机) - 1)
  如果 结尾(主机, "."):
    设 主机 为 截取(主机, 0, 长度(主机) - 1)
  返回 主机

段落 十六进制数位 接收 字符:
  设 码 为 码位(字符)
  如果 码 >= 48:
    如果 码 <= 57:
      返回 码 - 48
  如果 码 >= 97:
    如果 码 <= 102:
      返回 码 - 87
  如果 码 >= 65:
    如果 码 <= 70:
      返回 码 - 55
  返回 0

段落 十六进制转整数 接收 文本:
  设 总值 为 0
  设 i 为 0
  当 i < 长度(文本):
    设 总值 为 总值 * 16 + 十六进制数位(文本[i])
    设 i 为 i + 1
  返回 总值

段落 判定环回主机 接收 主机名:
  设 主机 为 去括号去点小写(主机名)
  如果 主机 == "localhost":
    返回 真
  如果 结尾(主机, ".localhost"):
    返回 真
  如果 主机 == "::1" 或 主机 == "::" 或 主机 == "0.0.0.0":
    返回 真
  如果 开头(主机, "::ffff:"):
    设 映射组 为 分组匹配(映射IPv6模式, 主机)
    如果 映射组 != 空:
      设 高值 为 十六进制转整数(映射组[0])
      返回 整数(高值 / 256) == 127
    设 余 为 截取(主机, 7, 长度(主机))
    返回 完全匹配(环回IPv4模式, 余)
  返回 完全匹配(环回IPv4模式, 主机)

# =====================================================================
# 网址表示与豁免判定（bypassesProxy）
# 光明侧用 解析网址 把 URL 字符串投影为 {协议, 主机, 端口} 记录；
# 条目匹配主机及其全部子域（example.com 也豁免 api.example.com），
# 前导 . / *. 同义；条目可带 :port；* 全豁免；CIDR 不支持（与上游一致）。
# =====================================================================
段落 拆分网络位置 接收 网络位置:
  设 位置 为 网络位置
  如果 字符串包含(位置, "@"):
    设 尾 为 最后索引(位置, "@")
    设 位置 为 截取(位置, 尾 + 1, 长度(位置))
  如果 开头(位置, "["):
    设 闭 为 查找子串(位置, "]")
    如果 闭 >= 0:
      设 主机 为 截取(位置, 1, 闭)
      设 余 为 截取(位置, 闭 + 1, 长度(位置))
      如果 开头(余, ":"):
        返回 ["主机": 主机, "端口": 截取(余, 1, 长度(余))]
      返回 ["主机": 主机, "端口": ""]
  设 冒号 为 查找子串(位置, ":")
  如果 冒号 >= 0:
    设 再冒号 为 查找子串从(位置, ":", 冒号 + 1)
    如果 再冒号 < 0:
      返回 ["主机": 截取(位置, 0, 冒号), "端口": 截取(位置, 冒号 + 1, 长度(位置))]
  返回 ["主机": 位置, "端口": ""]

段落 解析网址 接收 网址:
  设 解析 为 HTTP解析URL(网址)
  设 拆 为 拆分网络位置(解析["域名"])
  设 记录 为 {}
  记录["协议"] 为 解析["协议"] + ":"
  记录["主机"] 为 拆["主机"]
  记录["端口"] 为 拆["端口"]
  返回 记录

段落 判定豁免 接收 无代理, 网址:
  设 主机 为 去括号去点小写(网址["主机"])
  设 端口 为 网址["端口"]
  如果 端口 == "":
    如果 网址["协议"] == "https:":
      设 端口 为 "443"
    否则:
      设 端口 为 "80"
  遍历 原始 之 拆豁免条目(无代理):
    设 条目 为 转小写(原始)
    如果 条目 == "":
      继续
    如果 条目 == "*":
      返回 真
    设 拆 为 拆分主机端口(条目)
    如果 字典包含键(拆, "端口"):
      如果 拆["端口"] != 端口:
        继续
    设 候选 为 拆["主机"]
    如果 开头(候选, "*."):
      设 候选 为 截取(候选, 2, 长度(候选))
    如果 开头(候选, "."):
      设 候选 为 截取(候选, 1, 长度(候选))
    如果 结尾(候选, "."):
      设 候选 为 截取(候选, 0, 长度(候选) - 1)
    如果 候选 == "":
      继续
    如果 主机 == 候选:
      返回 真
    如果 结尾(主机, "." + 候选):
      返回 真
  返回 假

# =====================================================================
# 策略解析与选中（resolveProxyPolicy / proxyForUrl）
# 方案自有变量胜出 → ALL_PROXY → （仅 HTTPS）HTTP 代理，匹配 undici。
# =====================================================================
段落 解析代理策略 接收 环境:
  设 诊断表 为 []
  设 全代理 为 接受代理URL(读环境(环境, "all_proxy"), 诊断表)
  设 全代理值 为 空
  如果 全代理["种类"] == "接受":
    设 全代理值 为 全代理["值"]
  设 环境HTTP 为 接受代理URL(读环境(环境, "http_proxy"), 诊断表)
  设 环境HTTPS 为 接受代理URL(读环境(环境, "https_proxy"), 诊断表)
  设 无代理 为 读环境(环境, "no_proxy")
  设 无代理值 为 空
  如果 无代理 != 空:
    设 无代理值 为 无代理["值"]
  设 http代理 为 解析方案(环境HTTP, [全代理值])
  设 https代理 为 解析方案(环境HTTPS, [全代理值, http代理])
  如果 http代理 == 空 且 https代理 == 空:
    返回 ["策略": 直连策略, "诊断": 诊断表]
  设 策略 为 {}
  策略["来源"] 为 "env"
  策略["无代理"] 为 并入环回(无代理值)
  如果 http代理 != 空:
    策略["http代理"] 为 http代理
  如果 https代理 != 空:
    策略["https代理"] 为 https代理
  返回 ["策略": 策略, "诊断": 诊断表]

段落 选中代理 接收 策略, 网址:
  设 代理 为 空
  如果 网址["协议"] == "https:":
    如果 字典包含键(策略, "https代理"):
      设 代理 为 策略["https代理"]
  否则如果 网址["协议"] == "http:":
    如果 字典包含键(策略, "http代理"):
      设 代理 为 策略["http代理"]
  如果 代理 == 空:
    返回 空
  如果 判定环回主机(网址["主机"]):
    返回 空
  如果 判定豁免(策略["无代理"], 网址):
    返回 空
  返回 代理

# 导出清单
导出 环回豁免表, 代理环境名表, 直连策略, 支持协议表, SOCKS协议表
导出 读环境, 判定支持代理URL, 接受代理URL, 解析方案, 并入环回, 拆豁免条目
导出 拆分主机端口, 判定环回主机, 解析网址, 判定豁免, 解析代理策略, 选中代理
