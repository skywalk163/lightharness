# 包清单.light —— 对标原版 packages/util/package-manifest/src/{index.ts,types.ts}
# 上游 index.ts 仅做类型再导出（无运行时导出）；types.ts 定义 package.json.dsh 的形状。
# 本模块把「无运行时」的类型形状落成可调用的读取/校验纯函数（读取 dsh 字段 + 各角色校验），
# 与上游 DshBundleManifest / DshProfileManifest / DshClientManifest / DshConfigTreeDeclaration 对齐。

# 从包 JSON 取出 dsh 字段（非字典或缺 dsh → 空字典）
段落 读包清单DSH(包JSON):
  如果 是字典(包JSON) == 假:
    返回 {}
  设 dsh 为 字典获取(包JSON, "dsh", 空)
  如果 是字典(dsh) == 假:
    返回 {}
  返回 dsh

# DshBundleManifest.patch：相对声明包根的 patch 文件路径，必填非空字符串。
段落 校验Bundle清单(dsh):
  如果 是字典(dsh) == 假:
    返回 假
  设 patch 为 字典获取(dsh, "patch", 空)
  如果 是字符串(patch) == 假 或 长(patch) == 0:
    返回 假
  返回 真

# DshProfileManifest：bundles 可选字符串数组；patchReload 仅 live/startup。
段落 校验Profile清单(dsh):
  如果 是字典(dsh) == 假:
    返回 假
  设 bundles 为 字典获取(dsh, "bundles", 空)
  如果 bundles != 空:
    如果 是列表(bundles) == 假:
      返回 假
    遍历 b 之 bundles:
      如果 是字符串(b) == 假:
        返回 假
  设 reload 为 字典获取(dsh, "patchReload", 空)
  如果 reload != 空:
    如果 reload != "live" 且 reload != "startup":
      返回 假
  返回 真

# DshClientManifest：platform 必填非空字符串；inject/immediately/external 形状校验。
段落 校验Client清单(dsh):
  如果 是字典(dsh) == 假:
    返回 假
  设 platform 为 字典获取(dsh, "platform", 空)
  如果 是字符串(platform) == 假 或 长(platform) == 0:
    返回 假
  设 inject 为 字典获取(dsh, "inject", 空)
  如果 inject != 空 且 是列表(inject) == 假:
    返回 假
  设 immediately 为 字典获取(dsh, "immediately", 空)
  如果 immediately != 空 且 isinstance(immediately, bool) == 假:
    返回 假
  设 external 为 字典获取(dsh, "external", 空)
  如果 external != 空 且 是列表(external) == 假:
    返回 假
  返回 真

# DshConfigTreeDeclaration：mount/path 均为非空字符串。
段落 校验配置树声明(项):
  如果 是字典(项) == 假:
    返回 假
  设 mount 为 字典获取(项, "mount", 空)
  设 p 为 字典获取(项, "path", 空)
  如果 是字符串(mount) == 假 或 长(mount) == 0:
    返回 假
  如果 是字符串(p) == 假 或 长(p) == 0:
    返回 假
  返回 真

# ============================================================
# R126 §4-3 包清单 icon 判定（上游 app-boot/src/package-meta.ts iconOf
#   @ d12257c959 / 8339f16c1d / f8a274b76e）
# 判定纯逻辑面（优先级/相对路径/越界/后缀白名单）；realpath、stat、fs 读、
# base64 编码与「./icon 导出资源解析」「包归属查找」一律宿主投影入参：
#   归一投影(路径)       → realpath（缺文件返回 空）
#   文件信息投影(路径)   → {"是文件": 真/假, "大小": N}（读不到返回 空）
#   编码投影(路径)       → base64 文本（宿主读字节后编码）
#   归属投影(路径, 包名) → 文件是否落在 包名 owns 的目录树内（宿主查祖先 package.json）
# 返回统一 {"错误": 串, "图标": dataURI 或 空}；错误非空即拒绝。
# ============================================================

导入 re
从 字符串工具轻量 导入 转小写

# 上游 ICON_MEDIA_TYPES 白名单（后缀 → media type；后缀小写归一）
段落 图标后缀(路径):
  设 基 为 路径
  设 s1 为 最后索引(路径, "/")
  设 s2 为 最后索引(路径, "\\")
  设 s 为 s1
  如果 s2 > s:
    设 s 为 s2
  如果 s != -1:
    设 基 为 截取到末尾(路径, s + 1)
  设 d 为 最后索引(基, ".")
  如果 d == -1:
    返回 ""
  返回 转小写(截取到末尾(基, d))

段落 图标媒体类型(路径):
  设 后 为 图标后缀(路径)
  如果 后 == ".svg":
    返回 "image/svg+xml"
  如果 后 == ".png":
    返回 "image/png"
  如果 后 == ".jpg":
    返回 "image/jpeg"
  如果 后 == ".jpeg":
    返回 "image/jpeg"
  如果 后 == ".webp":
    返回 "image/webp"
  返回 空

# icon 值须相对路径：拒绝 posix 绝对、win32 盘符/UNC 绝对、URL scheme
# （上游 isAbsolute(icon) || win32.isAbsolute(icon) || /^[A-Za-z][A-Za-z\d+.-]*:/u）
段落 是绝对图标路径(图标):
  如果 开头(图标, "/") 或 开头(图标, "\\"):
    返回 真
  如果 re.match("^[A-Za-z]:[\\\\/]", 图标) != 空:
    返回 真
  如果 re.match("^[A-Za-z][A-Za-z0-9+.-]*:", 图标) != 空:
    返回 真
  返回 假

# realpath 后须落在 界内（分量级前缀；上游 relative 为 '..' 或 '../' 前缀或绝对 → 拒）
段落 在目录界内(目标, 根):
  如果 目标 == 根:
    返回 真
  如果 开头(目标, 根 + "/") 或 开头(目标, 根 + "\\"):
    返回 真
  返回 假

# 共享尾部：后缀白名单 + 常规文件 + 256KiB 上限（上游 MAX_ICON_BYTES = 256*1024）
段落 校验图标文件(目标, 标签, 文件信息投影, 编码投影):
  设 媒体 为 图标媒体类型(目标)
  如果 媒体 == 空:
    返回 {"错误": 标签 + ": icon must be SVG, PNG, JPEG, or WebP", "图标": 空}
  设 信息 为 文件信息投影(目标)
  如果 信息 == 空:
    返回 {"错误": 标签 + ": icon is unreadable", "图标": 空}
  如果 字典获取(信息, "是文件", 假) == 假:
    返回 {"错误": 标签 + ": icon must be a regular file", "图标": 空}
  如果 字典获取(信息, "大小", 0) > 262144:
    返回 {"错误": 标签 + ": icon exceeds 256 KiB", "图标": 空}
  返回 {"错误": "", "图标": "data:" + 媒体 + ";base64," + 编码投影(目标), "目标": 目标, "媒体类型": 媒体}

# 清单所在目录（上游 dirname(manifestPath)；词法实现）
段落 清单目录(清单路径):
  设 s1 为 最后索引(清单路径, "/")
  设 s2 为 最后索引(清单路径, "\\")
  设 s 为 s1
  如果 s2 > s:
    设 s 为 s2
  如果 s <= 0:
    返回 ""
  返回 截取(清单路径, 0, s)

# 分支一：manifest 写了 icon 字段才走（上游 textOf：须非空字符串）；
#   相对路径 + realpath 后落在清单目录内。清单路径连接用 "/"，平台语义由归一投影承载。
段落 判定清单图标(图标值, 清单路径, 归一投影, 文件信息投影, 编码投影):
  如果 是字符串(图标值) == 假 或 去除空白(图标值) == "":
    返回 {"错误": 清单路径 + ": icon must be a non-empty string", "图标": 空}
  如果 是绝对图标路径(图标值) == 真:
    返回 {"错误": 清单路径 + ": icon must be a relative file path", "图标": 空}
  设 根 为 清单目录(清单路径)
  设 目标 为 归一投影(根 + "/" + 图标值)
  如果 目标 == 空:
    返回 {"错误": 清单路径 + ": icon is missing", "图标": 空}
  设 实根 为 归一投影(根)
  如果 实根 == 空 或 在目录界内(目标, 实根) == 假:
    返回 {"错误": 清单路径 + ": icon must remain inside its manifest directory", "图标": 空}
  返回 校验图标文件(目标, 清单路径, 文件信息投影, 编码投影)

# 分支二：manifest 省略 icon → 读导出 ./icon 资源（宿主解析出本地路径，缺省 空）。
#   资源须落在 包名 owns 的目录树内（上游 assertPackageOwned，宿主投影入参）。
#   导出资源缺席（导出路径 空）→ 图标 空、无错（上游 undefined）。
段落 判定导出图标(导出路径, 包名, 归属投影, 文件信息投影, 编码投影):
  如果 导出路径 == 空 或 导出路径 == "":
    返回 {"错误": "", "图标": 空}
  如果 归属投影(导出路径, 包名) == 假:
    返回 {"错误": 导出路径 + ": icon must remain inside its package directory", "图标": 空}
  返回 校验图标文件(导出路径, 导出路径, 文件信息投影, 编码投影)

# 优先级选择：manifest icon 优先，仅省略 icon（传 空）才读 ./icon 导出资源。
#   manifest 有 icon 键但值为空串 → 判定清单图标 报 "must be a non-empty string"
#   （对齐上游 textOf 对 defined-but-invalid 的拒绝）。
段落 判定插件图标(图标值, 导出路径, 包名, 清单路径, 归一投影, 文件信息投影, 编码投影, 归属投影):
  如果 图标值 != 空:
    返回 判定清单图标(图标值, 清单路径, 归一投影, 文件信息投影, 编码投影)
  返回 判定导出图标(导出路径, 包名, 归属投影, 文件信息投影, 编码投影)

导出 图标后缀, 图标媒体类型, 是绝对图标路径, 在目录界内, 校验图标文件
导出 判定清单图标, 判定导出图标, 判定插件图标
