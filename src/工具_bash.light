# 工具_bash.light —— bash 核心工具（在 shell 中执行命令）
#
# 工具名：bash
# 参数：  {"命令": "要执行的 shell 命令"}
# 返回：  {"输出":"...", "错误":"...", "退出码":N}
#
# 安全：
#   - 工作目录固定在 HARNESS_ROOT（缺省当前工作目录），命令在此目录下执行。
#   - 拒绝 `cd` 到上级目录 / 绝对路径 / 盘符 / ~（防止逃逸项目根）。
#   - 超时 30 秒；超时返回 {"退出码":-1, "错误":"命令超时（30秒）"}。

导入 re
导入 外部命令
从 工具 导入 造工具定义
从 工具_路径安全 导入 取根目录
# L-163：工具执行.建注册表() 返回的是普通 dict（工具挂在 注册["工具表"]），没有 .注册 方法；
#        注册统一走 具注册工具(注册, 名称, 级别, 处理, 插件)。
#        （注：核心工具.light 用的是另一套 工具.工具注册表 抽象，确实有 .注册 方法，不受影响。）
从 工具执行 导入 具注册工具, 级公开

# bash 参数模式（JSON Schema，供 OpenAI/tools 校验）
段落 bash模式:
  返回 ["type": "object",
          "properties": ["命令": ["type": "string", "description": "要执行的 shell 命令"]],
          "required": ["命令"]]

# cd 越界正则：行首/空白后跟 `cd` + 空白，再跟 ../ 或 ..\ 或 ..(空白) 或 / 或 \ 或 ~ 或 盘符:
越界正则 等于 "(?:^|\\s)cd\\s+\\.\\.(?:\\s|/|\\\\)|(?:^|\\s)cd\\s+(?:/|\\\\|~|[A-Za-z]:)"

# ---- 处理：参数已是解析后的字典（注册表负责解析与 schema 校验）----
# L-163：执行工具 以 处理(参数, 取消令牌) 调用 handler，且光明对形参数量严格（多参即报错）；
#        取消令牌 带默认值 空，既有单参调用（test_R42_bash跨平台 / test_R42_真实工具链）不受影响。
段落 bash处理(参数, 取消令牌 = 空):
  设 命令 为 参数["命令"]
  # 安全护栏：禁止 cd 逃逸项目根
  设 越界 为 re.search(越界正则, 命令)
  如果 越界 != 空:
    返回 ["输出": "", "错误": "禁止切换到项目根目录之外（不允许 cd 到上级目录）", "退出码": -1]
  # 固定工作目录
  设 根 为 取根目录()
  设 结果 为 外部命令.执行命令(命令, 真, 根, 空, 30)
  # 输出换行归一（Windows 的 \r\n → \n，避免爆上下文）
  设 输出 为 替换字符串(结果.标准输出, "\r\n", "\n")
  设 输出 为 替换字符串(输出, "\r", "\n")
  设 错误 为 替换字符串(结果.标准错误, "\r\n", "\n")
  设 错误 为 替换字符串(错误, "\r", "\n")
  返回 ["输出": 输出, "错误": 错误, "退出码": 结果.返回码]

# ---- 构造工具定义（供注册表注册）----
段落 造bash工具定义():
  返回 造工具定义("bash", "在 shell 中执行命令，返回 stdout、stderr 与退出码（工作目录限于项目根，超时 30 秒）", bash模式(), bash处理)

# ---- 便捷注册（对齐 工具执行 的 dict 注册表）----
# L-163：原实现 注册表.注册(...) 对 工具执行.建注册表() 的 dict 会抛
#        AttributeError: 'dict' object has no attribute '注册'。改走 具注册工具。
段落 注册bash工具(注册表, 级别 = 级公开):
  设 定义 为 造bash工具定义()
  具注册工具(注册表, 定义["name"], 级别, 定义["execute"], 空)
  返回 真
