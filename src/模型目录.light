# 模型目录.light —— R108 任务线 D：多 provider 目录合并 + 模型发现（discoverModels）纯逻辑
#
# 合流点：H 线新端点 与 G 线模型页将调本模块。
# 本模块是 provider 目录合并规则与模型发现换算面的唯一权威；前端与服务端不得另算一份。
#
# 上游考据（锚点 G:\github\deepseek-harness，HEAD=e5b5ccbfcb，0.2.0-rc.1，行号实测）：
#   - joinProviderDirectory（ui-settings-models/src/client/store.ts:42-70）：
#     先铺可配置目录（active 计算），再追加「已注册未声明」route；排序稳定，仅 account→0 / official→1。
#   - declared 语义（llm/src/types.ts:257-265）：真 = 适配器只因配置声明才知道该 route；缺省 = 不分此别。
#   - 可删除四条件（store.ts:207-210）；删除序列「先凭据后配置」（ModelsSection.tsx:146-156）。
#   - deriveKeyRef（store.ts:117-119）：大写 + [^A-Z0-9]+→_ + _API_KEY。
#   - route 正则（CustomProviderCard.tsx:52）：^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$
#   - discoverModels（llm-pi-ai/src/discovery.ts）：协议白名单三条、URL 构造、鉴权头分叉、
#     data 数组优先 / models 对象兜底、容量字段别名表、规范化。
#
# 偏离声明（如实登记，不自造上游不存在的形态）：
#   - D-1 route 校验上游只在客户端做（宿主侧无同名正则）；本仓在纯逻辑模块做 ⇒ 偏离，注释声明。
#   - D-2 上游无浏览器侧硬编码模型目录；本仓 src/客户端.light:320 的 4 条静态目录在上游无等价形态
#     （上游权威来源是宿主 listModels + resolveModelInfo，或适配器 config default）。
#     渲染提供商目录 里显式声明这个偏离，不把本仓静态目录伪装成上游形态。
#   - D-3 本模块是纯换算，绝不写任何配置/凭据（上游三重确认）；apiKey 仅本次询问。
#   - D-4 外部 HTTP 不移植：本仓只做响应解析 + URL/头构造 + 规范化（注入式，便于单测），真实 fetch 属宿主面。
#
# 语言坑规避：L-047（字典/列表字面量先赋变量再作实参）；L-055/L-160（打印只吃字面量串）；
#   L-151（「设 X 为」的 为 前必须有空格）；L-170（核心动词关键字不可作变量名）；
#   字面量不内含换行（单行书写）。

从 JSON 导入 解析JSON
从 内置核心字典 导入 字典设置, 字典包含键, 字典键列表, 字典获取, 取可选
从 内置核心列表 导入 列表追加, 列表包含, 列表长度
从 内置核心判型 导入 是字符串, 是字典, 是空, 是整数, 是浮点
从 内置核心字符串 导入 去除空白, 结尾, 开头, 字符串包含, 截取

# =====================================================================
# §1 协议白名单与常量
# =====================================================================

设 协议白名单 为 ["anthropic-messages", "openai-completions", "openai-responses"]
设 默认协议 为 "openai-completions"
设 凭据引用后缀 为 "_API_KEY"

# =====================================================================
# §2 派生凭据引用（store.ts:117-119 deriveKeyRef 逐字复刻）
#   route.toUpperCase().replace(/[^A-Z0-9]+/g, '_') + '_API_KEY'
# =====================================================================

段落 是字母数字(字符):
  设 码 为 码位(字符)
  # A-Z 65-90
  如果 码 >= 65 且 码 <= 90:
    返回 真
  # a-z 97-122
  如果 码 >= 97 且 码 <= 122:
    返回 真
  # 0-9 48-57
  如果 码 >= 48 且 码 <= 57:
    返回 真
  返回 假

段落 派生凭据引用(route):
  设 大写 为 转大写(route)
  设 结果 为 ""
  设 下标 为 0
  当 下标 < 长度(大写):
    设 字符 为 大写[下标]
    如果 是字母数字(字符):
      设 结果 为 结果 + 字符
    否则:
      设 结果 为 结果 + "_"
    设 下标 为 下标 + 1
  返回 结果 + 凭据引用后缀

# =====================================================================
# §3 校验收据路由（CustomProviderCard.tsx:52 正则逐字）
#   ^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$
#   上游理由：deriveKeyRef 会大写并把非字母数字段换成 _，而凭据引用必须是 POSIX shell 标识符
#     ⇒ 首字符不能是数字。
#   ⚠ D-1 偏离：上游只在客户端做此校验；本仓在纯逻辑模块做，注释声明。
# =====================================================================

段落 是小写字母(字符):
  设 码 为 码位(字符)
  如果 码 >= 97 且 码 <= 122:
    返回 真
  返回 假

段落 是小写字母或数字(字符):
  设 码 为 码位(字符)
  如果 码 >= 97 且 码 <= 122:
    返回 真
  如果 码 >= 48 且 码 <= 57:
    返回 真
  返回 假

段落 匹配路由正则(route):
  设 长度 为 长度(route)
  如果 长度 == 0:
    返回 假
  # 首字符必须是小写字母
  如果 是小写字母(route[0]) == 假:
    返回 假
  设 下标 为 1
  设 期望字母 为 假   # 短横线后期望字母
  当 下标 < 长度:
    设 字符 为 route[下标]
    如果 字符 == "-":
      如果 期望字母:
        # 连续两个短横线，或短横线在末尾
        返回 假
      设 期望字母 为 真
    否则:
      如果 是小写字母或数字(字符) == 假:
        返回 假
      设 期望字母 为 假
    设 下标 为 下标 + 1
  # 末尾不能是短横线
  如果 期望字母:
    返回 假
  返回 真

段落 校验收据路由(route, 既有路由表):
  设 结果 为 {}
  结果["合法"] 为 真
  结果["消息"] 为 ""
  设 文本 为 去除空白(route)
  # 空 -> 非法
  如果 文本 == "":
    结果["合法"] 为 假
    结果["消息"] 为 "请输入有效的包名或地址"
    返回 结果
  # 不匹配正则
  如果 匹配路由正则(文本) == 假:
    结果["合法"] 为 假
    结果["消息"] 为 "需以小写字母开头，之后可用小写字母、数字和短横线。"
    返回 结果
  # 与既有路由重名
  遍历 既有 之 既有路由表:
    如果 既有 == 文本:
      结果["合法"] 为 假
      结果["消息"] 为 "已有提供商使用了这个 ID。"
      返回 结果
  返回 结果

# =====================================================================
# §4 合并提供商目录（store.ts:42-70 joinProviderDirectory 逐条复刻）
#   先铺可配置目录全部条目（活动 = 是否同时在已注册表），
#   再追加「已注册但未声明」的 route（命名空间=""、设置路径=[]、活动=真）；
#   排序稳定：deepseek-account→0、deepseek-official→1、其余保持原序。
#   ⛔ 不得就地改动入参（加一条断言钉死）。
# =====================================================================

段落 排序键(route):
  如果 route == "deepseek-account":
    返回 0
  如果 route == "deepseek-official":
    返回 1
  返回 2

段落 合并提供商目录(已注册表, 可配置表):
  设 行集 为 []
  # 第一步：铺可配置目录全部条目
  遍历 条目 之 可配置表:
    设 route 为 条目["provider"]
    设 活动 为 列表包含(已注册表, route)
    设 行 为 {}
    行["provider"] 为 route
    行["显示名"] 为 取可选(条目, "显示名", route)
    行["命名空间"] 为 取可选(条目, "命名空间", "")
    行["设置路径"] 为 取可选(条目, "设置路径", [])
    行["活动"] 为 活动
    行["已声明"] 为 取可选(条目, "已声明", 空)
    行["已配置"] 为 取可选(条目, "已配置", 假)
    行["可删除"] 为 假   # 由调用方/可删除判定 段落计算
    行["凭据引用"] 为 取可选(条目, "凭据引用", 派生凭据引用(route))
    设 凭据 为 {}
    凭据["configured"] 为 取可选(条目, "已配置", 假)
    凭据["source"] 为 取可选(条目, "凭据来源", "")
    凭据["writable"] 为 取可选(条目, "可写", 真)
    行["凭据"] 为 凭据
    行["错误"] 为 取可选(条目, "错误", "")
    列表追加(行集, 行)
  # 第二步：追加已注册但未声明的 route
  设 已有route集 为 []
  遍历 行 之 行集:
    列表追加(已有route集, 行["provider"])
  遍历 注册route 之 已注册表:
    如果 列表包含(已有route集, 注册route) == 假:
      设 新行 为 {}
      新行["provider"] 为 注册route
      新行["显示名"] 为 注册route
      新行["命名空间"] 为 ""
      新行["设置路径"] 为 []
      新行["活动"] 为 真
      新行["已声明"] 为 空
      新行["已配置"] 为 假
      新行["可删除"] 为 假
      新行["凭据引用"] 为 派生凭据引用(注册route)
      设 新凭据 为 {}
      新凭据["configured"] 为 假
      新凭据["source"] 为 ""
      新凭据["writable"] 为 真
      新行["凭据"] 为 新凭据
      新行["错误"] 为 ""
      列表追加(行集, 新行)
  # 第三步：稳定排序（account→0, official→1, 其余原序）
  # 简单冒泡排序（保持稳定）
  设 总 为 长度(行集)
  设 i 为 0
  当 i < 总:
    设 j 为 0
    当 j < 总 - i - 1:
      设 键a 为 排序键(行集[j]["provider"])
      设 键b 为 排序键(行集[j+1]["provider"])
      如果 键a > 键b:
        设 临时 为 行集[j]
        行集[j] 为 行集[j+1]
        行集[j+1] 为 临时
      设 j 为 j + 1
    设 i 为 i + 1
  返回 行集

# =====================================================================
# §5 可删除判定（store.ts:207-210 四条件同时满足）
#   ① 命名空间存在；② 设置路径长度 > 0（整段 provider 永不可删）；
#   ③ 用户层该路径存在；④ 组合/base 层该路径不存在。
# =====================================================================

段落 路径存在(视图, 路径):
  # 视图是字典，路径是列表（如 ["llm-deepseek", "customProviders"]）
  设 当前 为 视图
  遍历 段 之 路径:
    如果 是字典(当前) == 假:
      返回 假
    如果 字典包含键(当前, 段) == 假:
      返回 假
    设 当前 为 当前[段]
  返回 真

段落 可删除判定(provider行, 命名空间视图, 用户层视图, 基座层视图):
  # ① 命名空间存在
  设 命名空间 为 provider行["命名空间"]
  如果 命名空间 == "":
    返回 假
  # ② 设置路径长度 > 0
  设 路径 为 provider行["设置路径"]
  如果 长度(路径) == 0:
    返回 假
  # ③ 用户层该路径存在
  设 用户存在 为 路径存在(用户层视图, 路径)
  如果 用户存在 == 假:
    返回 假
  # ④ 组合/base 层该路径不存在
  设 基座存在 为 路径存在(基座层视图, 路径)
  如果 基座存在:
    返回 假
  返回 真

# =====================================================================
# §6 删除序列（ModelsSection.tsx:146-156 先凭据后配置）
#   先 credentials/unset（先凭据后配置，失败可重试且行仍在）
#   再 settings/mutate 单条 {op:'unset', path:设置路径}
# =====================================================================

段落 删除序列(provider行):
  设 步骤表 为 []
  设 步骤1 为 {}
  步骤1["阶段"] 为 "凭据"
  步骤1["动作"] 为 "撤下"
  步骤1["引用"] 为 provider行["凭据引用"]
  列表追加(步骤表, 步骤1)
  设 步骤2 为 {}
  步骤2["阶段"] 为 "配置"
  步骤2["动作"] 为 "撤下"
  步骤2["路径"] 为 provider行["设置路径"]
  列表追加(步骤表, 步骤2)
  返回 步骤表

# =====================================================================
# §7 构造发现请求（§2.2 形状，空值省略键）
# =====================================================================

段落 构造发现请求(provider = "", baseURL = "", api = "", apiKey = ""):
  设 请求 为 {}
  如果 provider != "":
    字典设置(请求, "provider", provider)
  如果 baseURL != "":
    字典设置(请求, "baseURL", baseURL)
  如果 api != "":
    字典设置(请求, "api", api)
  如果 apiKey != "":
    字典设置(请求, "apiKey", apiKey)
  返回 请求

# =====================================================================
# §8 发现地址（discovery.ts:117-122 逐字复刻）
#   OpenAI 系：{去尾斜杠基址}/models
#   Anthropic：{root}/v1/models?limit=1000
#     其中 root = 去尾斜杠后若以 /v1 结尾则去掉该段。
# =====================================================================

段落 去尾斜杠(文本):
  设 结果 为 文本
  当 结尾(结果, "/"):
    设 结果 为 截取(结果, 0, 长度(结果) - 1)
  返回 结果

段落 发现地址(基址, 协议):
  设 根 为 去尾斜杠(基址)
  # Anthropic 特殊处理
  如果 协议 == "anthropic-messages":
    # 若以 /v1 结尾则去掉该段
    设 root 为 根
    如果 结尾(root, "/v1"):
      设 root 为 截取(root, 0, 长度(root) - 3)
    返回 root + "/v1/models?limit=1000"
  # OpenAI 系（completions / responses）
  返回 根 + "/models"

# =====================================================================
# §9 发现请求头（鉴权分叉）
#   accept: application/json 恒有
#   Anthropic：x-api-key + anthropic-version: 2023-06-01
#   OpenAI 系：authorization: Bearer <key>（带密钥时）
#   ⚠ 密钥只进请求头、绝不进任何返回值/日志。
# =====================================================================

段落 发现请求头(协议, 密钥 = ""):
  设 头 为 {}
  字典设置(头, "accept", "application/json")
  如果 协议 == "anthropic-messages":
    字典设置(头, "anthropic-version", "2023-06-01")
    如果 密钥 != "":
      字典设置(头, "x-api-key", 密钥)
  否则:
    # OpenAI 系
    如果 密钥 != "":
      字典设置(头, "authorization", "Bearer " + 密钥)
  返回 头

# =====================================================================
# §10 解析发现响应（data 数组优先 / models 对象兜底 / 字段别名 / 规范化）
#   容量字段别名：
#     contextWindow ← contextWindow|context_window|context_length|max_input_tokens|limit.context
#     maxTokens ← maxOutputTokens|max_output_tokens|maxTokens|max_tokens|limit.output|top_provider.max_completion_tokens
#     name ← name|display_name|displayName，兜底 id
#   规范化：丢弃非字符串/空/重复 id；未定义字段省略键；inputModalities listing 路径一律省略。
# =====================================================================

段落 取别名(对象, 键表):
  遍历 键 之 键表:
    如果 字典包含键(对象, 键):
      返回 对象[键]
  返回 空

段落 解析发现响应(响应体文本, 协议):
  设 结果 为 {}
  结果["候选"] 为 []
  结果["错误"] 为 ""
  # 解析 JSON
  设 数据 为 空
  尝试:
    设 数据 为 解析JSON(响应体文本)
  捕获 错误:
    结果["错误"] 为 "响应不是有效 JSON"
    返回 结果
  如果 是字典(数据) == 假:
    结果["错误"] 为 "响应根节点不是对象"
    返回 结果
  # data 数组优先
  设 原始表 为 空
  如果 字典包含键(数据, "data"):
    设 原始表 为 数据["data"]
  否则如果 字典包含键(数据, "models"):
    设 models值 为 数据["models"]
    # models 对象：键即 id，仅取对象值条目
    如果 是字典(models值):
      设 临时表 为 []
      遍历 键 之 字典键列表(models值):
        设 值 为 models值[键]
        如果 是字典(值):
          设 条目 为 深拷贝(值)
          字典设置(条目, "id", 键)
          列表追加(临时表, 条目)
        否则:
          设 条目2 为 {}
          字典设置(条目2, "id", 键)
          列表追加(临时表, 条目2)
      设 原始表 为 临时表
  否则:
    结果["错误"] 为 "响应缺少 data 数组或 models 对象"
    返回 结果
  # 规范化
  设 已见id 为 []
  遍历 条目 之 原始表:
    如果 是字典(条目) == 假:
      继续
    设 id值 为 取别名(条目, ["id", "id_"])
    # 丢弃非字符串/空 id
    如果 是字符串(id值) == 假 或 id值 == "":
      继续
    # 去重
    如果 列表包含(已见id, id值):
      继续
    列表追加(已见id, id值)
    设 候选 为 {}
    字典设置(候选, "id", id值)
    # name 别名
    设 名称 为 取别名(条目, ["name", "display_name", "displayName"])
    如果 是字符串(名称) 且 名称 != "":
      字典设置(候选, "name", 名称)
    # contextWindow 别名
    设 ctx 为 空
    如果 字典包含键(条目, "contextWindow"):
      设 ctx 为 条目["contextWindow"]
    否则如果 字典包含键(条目, "context_window"):
      设 ctx 为 条目["context_window"]
    否则如果 字典包含键(条目, "context_length"):
      设 ctx 为 条目["context_length"]
    否则如果 字典包含键(条目, "max_input_tokens"):
      设 ctx 为 条目["max_input_tokens"]
    否则如果 字典包含键(条目, "limit"):
      设 limit值 为 条目["limit"]
      如果 是字典(limit值) 且 字典包含键(limit值, "context"):
        设 ctx 为 limit值["context"]
    如果 ctx != 空:
      字典设置(候选, "contextWindow", ctx)
    # maxTokens 别名
    设 max 为 空
    如果 字典包含键(条目, "maxOutputTokens"):
      设 max 为 条目["maxOutputTokens"]
    否则如果 字典包含键(条目, "max_output_tokens"):
      设 max 为 条目["max_output_tokens"]
    否则如果 字典包含键(条目, "maxTokens"):
      设 max 为 条目["maxTokens"]
    否则如果 字典包含键(条目, "max_tokens"):
      设 max 为 条目["max_tokens"]
    否则如果 字典包含键(条目, "limit"):
      设 limit值2 为 条目["limit"]
      如果 是字典(limit值2) 且 字典包含键(limit值2, "output"):
        设 max 为 limit值2["output"]
    否则如果 字典包含键(条目, "top_provider"):
      设 tp值 为 条目["top_provider"]
      如果 是字典(tp值) 且 字典包含键(tp值, "max_completion_tokens"):
        设 max 为 tp值["max_completion_tokens"]
    如果 max != 空:
      字典设置(候选, "maxTokens", max)
    # inputModalities listing 路径一律省略
    列表追加(结果["候选"], 候选)
  返回 结果

# =====================================================================
# §11 渲染提供商目录（整页形状，含本仓静态目录的偏离声明字段）
# =====================================================================

段落 渲染提供商目录(已注册表, 可配置表, 命名空间表):
  设 行集 为 合并提供商目录(已注册表, 可配置表)
  设 页 为 {}
  页["提供商行"] 为 行集
  # D-2 偏离声明：本仓静态模型目录无上游等价形态
  页["静态目录偏离声明"] 为 "本仓 src/客户端.light 的 4 条静态模型目录在上游无等价形态；上游权威来源是宿主 listModels + resolveModelInfo。"
  页["协议白名单"] 为 协议白名单
  页["默认协议"] 为 默认协议
  返回 页

