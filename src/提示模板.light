从 JSON 导入 序列化JSON

# ---- 0.1.5 提示表示：PTC 词汇 + 缓存保证并入 model-experience 字段 ----
# 对应上游 0.1.5 提交 71b0d83822（V3 PTC 词汇并入 system-prompt 表示）、
# 73865675a4（combine cache guarantees in model-experience field）。
# PTC = Persistent Token Cache：in-history 系统提示更新模式下，系统提示可被持久化缓存，
# 变更随缓存历史下发，不必重写消息 0。
设 PTC段序 为 800
设 PTC段名 为 "prompt-token-cache"

# 组合模型体验：把缓存保证与 system-prompt 更新语义并入单一 model-experience 字段。
段落 组合模型体验(模型):
  设 更新 为 空
  如果 (模型.包含("systemPromptUpdate") == 真): 设 更新 为 模型["systemPromptUpdate"]
  设 缓存保证 为 ""
  如果 (更新 == "in-history"):
    设 缓存保证 为 "persistent token cache：模型按 messages 中最新 system 消息读取完整有效系统提示，变更可随缓存历史下发而不必重写消息 0"
  返回 ["id": 模型["id"], "name": 模型["name"], "systemPromptUpdate": 更新, "cacheGuarantee": 缓存保证]

# 渲染 PTC 段（system-prompt 表示层 PTC 词汇文本；非 in-history 模型返回空串）
段落 渲染PTC段(体验):
  如果 (体验["systemPromptUpdate"] != "in-history"): 返回 ""
  设 文本 为 "模型体验（" + 体验["name"] + "）"
  设 文本 为 文本 + "\n- " + PTC段名 + "（段序 " + 转字符串(PTC段序) + "）：" + 体验["cacheGuarantee"]
  返回 文本
段落 是小写字母(c):
  返回 (c >= "a") 且 (c <= "z")
段落 是数字字符(c):
  返回 (c >= "0") 且 (c <= "9")
段落 是变量名(名):
  设 长 为 字符串长度(名)
  如果 (长 == 0): 返回 假
  如果 (是小写字母(名[0]) == 假): 返回 假
  设 i 为 1
  当 (i < 长):
    设 c 为 名[i]
    如果 (是小写字母(c) == 假 且 是数字字符(c) == 假): 返回 假
    设 i 为 i + 1
  返回 真
段落 取完整组(文本, 开0, 长):
  设 i 为 开0 + 2
  当 (i < 长):
    设 c 为 文本[i]
    如果 (c == "}"):
      如果 (i + 1 < 长 且 文本[i + 1] == "}"):
        返回 {"状态": "完整", "名": 截取(文本, 开0 + 2, i)}
      返回 {"状态": "畸形"}
    如果 (c == "{"):
      返回 {"状态": "畸形"}
    设 i 为 i + 1
  返回 {"状态": "残缺"}
段落 插值(文本, 变量表, 种类, 来源名):
  设 结果 为 ""
  设 末 为 0
  设 长 为 字符串长度(文本)
  当 (真):
    设 余 为 截取(文本, 末, 长)
    设 开 为 查找子串(余, "{{")
    如果 (开 == -1):
      设 结果 为 结果 + 余
      跳出
    设 开0 为 末 + 开
    设 组 为 取完整组(文本, 开0, 长)
    如果 (组["状态"] == "完整"):
      设 名 为 组["名"]
      如果 (是变量名(名) == 假):
        抛出 新建 错误("malformed prompt variable reference {{" + 名 + "}} in " + 种类 + " " + 来源名)
      如果 (字典包含键(变量表, 名) == 假):
        抛出 新建 错误("unknown prompt variable {{" + 名 + "}} in " + 种类 + " " + 来源名)
      设 值 为 变量表[名]
      如果 (值 == 空):
        抛出 新建 错误("prompt variable {{" + 名 + "}} has no value for this assembly (" + 种类 + " " + 来源名 + ")")
      设 结果 为 结果 + 截取(文本, 末, 开0) + 值
      设 末 为 开0 + 字符串长度(名) + 4
    否则 如果 (组["状态"] == "畸形"):
      抛出 新建 错误("malformed prompt variable reference at {{...}} in " + 种类 + " " + 来源名)
    否则:
      设 结果 为 结果 + 截取(文本, 末, 开0 + 2)
      设 末 为 开0 + 2
  返回 结果
段落 渲染提示(装配):
  设 已渲染 为 []
  遍历 段 之 装配["sections"]:
    设 文本 为 插值(段["text"], 装配["variables"], "section", 段["name"])
    如果 (字符串长度(文本) > 0): 列表追加(已渲染, 文本)
  返回 连接字符串(已渲染, "\n\n")
段落 渲染上下文段(装配):
  设 结果 为 []
  遍历 上下文 之 装配["contexts"]:
    设 文本 为 插值(上下文["text"], 装配["variables"], "context", 上下文["name"])
    如果 (字符串长度(文本) > 0): 列表追加(结果, {"name": 上下文["name"], "text": 文本})
  返回 结果
段落 连接上下文段(段列表):
  设 文本们 为 []
  遍历 s 之 段列表: 列表追加(文本们, s["text"])
  设 体 为 连接字符串(文本们, "\n\n")
  如果 (字符串长度(体) == 0): 返回 ""
  返回 "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\n" + 体
段落 渲染上下文快照(装配):
  返回 连接上下文段(渲染上下文段(装配))
段落 表包含(列表, 值):
  遍历 x 之 列表:
    如果 (x == 值): 返回 真
  返回 假
段落 列表副本(列表):
  设 结果 为 []
  遍历 x 之 列表: 列表追加(结果, x)
  返回 结果
段落 移除第(列表, 索引):
  设 结果 为 []
  设 i 为 0
  当 (i < 列表长度(列表)):
    如果 (i != 索引): 列表追加(结果, 列表[i])
    设 i 为 i + 1
  返回 结果
段落 排序按(列表, 比较):
  设 结果 为 []
  设 源 为 列表副本(列表)
  当 (列表长度(源) > 0):
    设 最小索引 为 0
    设 k 为 1
    当 (k < 列表长度(源)):
      如果 (比较(源[k], 源[最小索引]) < 0): 设 最小索引 为 k
      设 k 为 k + 1
    列表追加(结果, 源[最小索引])
    设 源 为 移除第(源, 最小索引)
  返回 结果
段落 比较工具名(a, b):
  设 名a 为 a["name"]
  设 名b 为 b["name"]
  如果 (名a < 名b): 返回 -1
  如果 (名a > 名b): 返回 1
  返回 0
段落 校验工具顺序(顺序):
  如果 (顺序 == 空): 返回 空
  设 已见 为 {}
  遍历 名 之 顺序:
    如果 (字典包含键(已见, 名) == 真): 抛出 新建 错误("toolOrder lists " + 名 + " more than once")
    设 已见[名] 为 真
  如果 (字典包含键(已见, "<unlisted-tools>") == 假):
    抛出 新建 错误("toolOrder must contain the <unlisted-tools> rest entry")
  返回 顺序
段落 排序工具(工具表, 顺序, 已知名):
  遍历 t 之 工具表:
    如果 (t["name"] == "<unlisted-tools>"): 抛出 新建 错误("tool provider returned reserved tool name <unlisted-tools>")
  如果 (顺序 == 空): 返回 排序按(工具表, 比较工具名)
  遍历 名 之 顺序:
    如果 (名 != "<unlisted-tools>" 且 表包含(已知名, 名) == 假):
      抛出 新建 错误("toolOrder lists unregistered tool " + 名)
  设 已列 为 {}
  遍历 名 之 顺序: 设 已列[名] 为 真
  设 休息 为 []
  遍历 t 之 工具表:
    如果 (字典包含键(已列, t["name"]) == 假): 列表追加(休息, t)
  设 休息 为 排序按(休息, 比较工具名)
  设 结果 为 []
  遍历 名 之 顺序:
    如果 (名 == "<unlisted-tools>"):
      遍历 r 之 休息: 列表追加(结果, r)
    否则:
      遍历 t 之 工具表:
        如果 (t["name"] == 名): 列表追加(结果, t)
  返回 结果
