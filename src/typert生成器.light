# typert生成器.light —— R85 任务 D：typert generator 纯逻辑面移植（简化但真实）
#
# 上游（本地锚点 ddefc45fbc，0.1.6-alpha.2）：
#   G:\github\deepseek-harness\packages\typert\generator\src\
#     analyzer.ts（3236 行）/ emitter.ts（938）/ model.ts（438，运行期类型模型）/ index.ts（16）
#
# 上游 → 光明对照表（纯逻辑）：
#   PackageModel / analyze(package)            → 型生分析包(描述)（内存包描述 → 包模型）
#   WorkspaceModel / analyze workspace         → 型生分析工作区(包描述表)
#   emitter：Model → 文本桩                     → 型生发射包(包模型)
#   childTypeNodeIds(node)                     → 型生子类型节点(类型节点)（简化类型节点边提取）
#
# 范围说明（聚焦纯逻辑，不 1:1 搬 3236 行 TS 编译器分析）：
#   上游 analyzer 基于真实 TS 编译器（Checker/节点）；光明没有 TS 编译器，因此 型生分析包 直接基于
#   调用方传入的「内存包描述」做结构校验与归一化，产出与 PackageModel 对齐的字典——
#   这是 analyzer 的「契约输出」而非编译实现。cordis-catalog / registry service / loader 属宿主面登记。
#
# 宿主面登记（不移植，注入承接）：
#   - generator/cordis-catalog.ts（API 数据注册表）：宿主登记。
#   - registry/src/service.ts、loader/src/*（运行期 registry 服务 + loader）：宿主登记。
#   - 真实 TS 编译分析（analyzer 的编译器后端）：宿主登记（光明以内存描述替代）。
#
# 命名避坑：所有 段落/函数 名带前缀「型生」，避免与 src/ 其它模块撞名（已 grep 自查）。

从 typert协议 导入 型协是调用描述
从 内置核心字典 导入 字典包含键
从 内置核心判型 导入 是字典, 是列表
从 字符串增强 导入 码转字符

# =====================================================================
# §0 常量
# =====================================================================

# TypertFace
设 型生面表 为 ["host", "client"]

# =====================================================================
# §1 analyzer：包描述 → 包模型（纯结构校验 + 归一化，无 TS 编译器）
# =====================================================================

# 上游 PackageModel：从一份内存包描述产出包模型
#   描述 = {name, root?, exports[], services[{key,members[]}], events[], objects[], schemas[], invocations[]}
段落 型生分析包(描述):
  如果 是字典(描述) == 假:
    抛出 新建 错误("typert: 包描述必须是字典 [BAD_PACKAGE_DESC]")
  如果 字典包含键(描述, "name") == 假:
    抛出 新建 错误("typert: 包描述缺少 name [BAD_PACKAGE_DESC]")
  设 模型 为 {}
  模型["name"] 为 描述["name"]
  如果 字典包含键(描述, "root"):
    模型["root"] 为 描述["root"]
  否则:
    模型["root"] 为 ""
  模型["exports"] 为 型生取表(描述, "exports")
  模型["services"] 为 型生取表(描述, "services")
  模型["events"] 为 型生取表(描述, "events")
  模型["objects"] 为 型生取表(描述, "objects")
  模型["schemas"] 为 型生取表(描述, "schemas")
  模型["invocations"] 为 型生取表(描述, "invocations")
  返回 模型

# 安全取表（缺省为空表）
段落 型生取表(描述, 键):
  如果 字典包含键(描述, 键) == 假:
    返回 []
  设 表 为 描述[键]
  如果 是列表(表) == 假:
    抛出 新建 错误("typert: 包描述字段 " + 键 + " 必须是列表 [BAD_FIELD]")
  返回 表

# 上游 WorkspaceModel：把若干包描述按面归一成工作区模型
#   包描述表 = [{face, packages:[描述,...]}, ...]
段落 型生分析工作区(包描述表):
  如果 是列表(包描述表) == 假:
    抛出 新建 错误("typert: 包描述表必须是列表 [BAD_WORKSPACE]")
  设 面表 为 []
  遍历 项 之 包描述表:
    如果 是字典(项) == 假:
      抛出 新建 错误("typert: 工作区项必须是字典 [BAD_WORKSPACE_ITEM]")
    设 面 为 项["face"]
    如果 是列表(型生面表) == 真 且 列表包含(型生面表, 面) == 假:
      抛出 新建 错误("typert: 未知面 " + 转字符串(面) + " [BAD_FACE]")
    设 包列表 为 型生取表(项, "packages")
    设 分析包列表 为 []
    遍历 包描述 之 包列表:
      分析包列表.追加(型生分析包(包描述))
    面表.追加(["face": 面, "packages": 分析包列表])
  返回 ["faces": 面表, "crossFaceLinks": []]

# =====================================================================
# §2 emitter：包模型 → 文本桩（纯字符串拼装，无文件写）
# =====================================================================

# 上游 emitter：给定包模型，渲染可读/代码桩文本（含 service 名、method 名、event 名）
段落 型生发射包(包模型):
  如果 型协是调用描述(包模型) == 真:
    返回 型生发射调用(包模型)
  如果 是字典(包模型) == 假:
    抛出 新建 错误("typert: 发射目标必须是包模型或调用描述 [BAD_EMIT_TARGET]")
  设 文本 为 "# Package: " + 包模型["name"]
  文本 为 文本 + 码转字符(10) + "root: " + 包模型["root"]
  设 服务表 为 包模型["services"]
  如果 长度(服务表) > 0:
    文本 为 文本 + 码转字符(10) + "## Services"
    遍历 服务 之 服务表:
      设 键 为 服务["key"]
      设 成员数 为 长度(服务["members"])
      文本 为 文本 + 码转字符(10) + "  - " + 键 + " (" + 转字符串(成员数) + " members)"
  设 调用表 为 包模型["invocations"]
  如果 长度(调用表) > 0:
    文本 为 文本 + 码转字符(10) + "## Invocations"
    遍历 调用 之 调用表:
      文本 为 文本 + 码转字符(10) + "  - " + 调用["service"] + "/" + 调用["method"]
  设 事件表 为 包模型["events"]
  如果 长度(事件表) > 0:
    文本 为 文本 + 码转字符(10) + "## Events"
    遍历 事件 之 事件表:
      文本 为 文本 + 码转字符(10) + "  - " + 事件["name"]
  返回 文本

# 单条调用描述 → 一行桩文本
段落 型生发射调用(调用):
  返回 "invoke " + 调用["service"] + "/" + 调用["namespace"] + "/" + 调用["method"]

# =====================================================================
# §3 childTypeNodeIds：简化类型节点边提取（对齐 upstream model.childTypeNodeIds）
# =====================================================================

# 上游 childTypeNodeIds(node)：返回节点的直接子类型节点 id 列表（仅实现 typert 关心的若干 kind）
段落 型生子类型节点(类型节点):
  如果 是字典(类型节点) == 假:
    抛出 新建 错误("typert: 类型节点必须是字典 [BAD_TYPE_NODE]")
  如果 字典包含键(类型节点, "kind") == 假:
    抛出 新建 错误("typert: 类型节点缺少 kind [BAD_TYPE_NODE]")
  设 种类 为 类型节点["kind"]
  如果 种类 == "parenthesized" 或 种类 == "operator":
    返回 [类型节点["type"]]
  如果 种类 == "reference":
    返回 类型节点["arguments"]
  如果 种类 == "union" 或 种类 == "intersection":
    返回 类型节点["types"]
  如果 种类 == "array":
    返回 [类型节点["element"]]
  如果 种类 == "tuple":
    设 结果 为 []
    遍历 元素 之 类型节点["elements"]:
      结果.追加(元素["type"])
    返回 结果
  如果 种类 == "indexed-access":
    返回 [类型节点["object"], 类型节点["index"]]
  如果 种类 == "conditional":
    返回 [类型节点["check"], 类型节点["extends"], 类型节点["whenTrue"], 类型节点["whenFalse"]]
  如果 种类 == "template-literal":
    设 结果二 为 []
    遍历 跨度 之 类型节点["spans"]:
      结果二.追加(跨度["type"])
    返回 结果二
  # keyword / literal / object / function / constructor / this：无子类型节点
  返回 []

# =====================================================================
# 导出
# =====================================================================

导出 型生面表
导出 型生分析包
导出 型生分析工作区
导出 型生发射包
导出 型生发射调用
导出 型生子类型节点
