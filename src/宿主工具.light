# 宿主工具.light —— 第17轮任务4 宿主工具接线原型（#113 / R17-D4）
# 缺陷编号 L-147~L-148 为本轮预分配；本轮未遇真正语言缺陷（见交付报告），编号空缺顺延。
# 定位：在已有 工具.light（注册表+执行）之上设计「工具接线层」——工具发现/上下文注入/权限控制/分组命名空间。
# 自包含说明：本轮任务1/2/3 的 宿主运行时/宿主上下文/宿主事件 模块尚不存在，本路以字典形状作为
#   「运行时」载体（造接线运行时），不 import 不存在的模块；事件派发用本地轻量监听表实现。
#   整合验证（路M）时再把本原型接到真实 宿主运行时.light 等模块。
# 只读复用：工具.light 的 校验参数（参数校验）。
# 运行：cd lightharness && python 运行.py examples/test_宿主工具.light

从 工具 导入 校验参数

# =====================================================================
# §0 运行时载体（自包含契约形状）
# =====================================================================
段落 造接线运行时:
  返回 {"工具表": {}, "短名表": {}, "审计日志": [], "请求计数": 0, "事件监听表": {}, "令牌表": {}, "限流表": {}}

段落 取下一个请求ID(运行时):
  设 运行时["请求计数"] 为 运行时["请求计数"] + 1
  返回 "req-" + 文本(运行时["请求计数"])

段落 包含文本(文本, 子串):
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

# =====================================================================
# §1 工具发现器（注册/注销/命名空间/自动注册卸载）
# =====================================================================
段落 工具全名(插件名, 工具名):
  返回 插件名 + "/" + 工具名

段落 注册工具(运行时, 插件名, 工具声明):
  设 名 为 字典获取(工具声明, "工具名", 空)
  如果 名 == 空:
    抛出 新建 错误("宿主工具: 工具声明缺少 工具名")
  设 全 为 工具全名(插件名, 名)
  如果 字典包含键(运行时["工具表"], 全):
    抛出 新建 错误("宿主工具: 同插件工具名冲突 " + 全)
  设 条目 为 {"全名": 全, "短名": 名, "插件名": 插件名, "描述": 字典获取(工具声明, "描述", ""),
    "参数模式": 字典获取(工具声明, "参数模式", 空), "执行函数": 字典获取(工具声明, "执行函数", 空),
    "作用域": 字典获取(工具声明, "作用域", 空), "分组": 字典获取(工具声明, "分组", 空),
    "可见性": 字典获取(工具声明, "可见性", "public")}
  字典设置(运行时["工具表"], 全, 条目)
  如果 字典包含键(运行时["短名表"], 名):
    字典设置(运行时["短名表"], 名, "")   # 多插件同名 → 歧义标记
  否则:
    字典设置(运行时["短名表"], 名, 全)
  返回 全

段落 注销工具(运行时, 插件名, 工具名):
  设 全 为 工具全名(插件名, 工具名)
  如果 字典包含键(运行时["工具表"], 全):
    字典删除(运行时["工具表"], 全)
    设 短 为 字典获取(运行时["短名表"], 工具名, 空)
    如果 短 == 全:
      字典删除(运行时["短名表"], 工具名)
  返回 真

段落 注销全部(运行时, 插件名):
  设 待删 为 []
  遍历 全 之 字典键列表(运行时["工具表"]):
    设 条目 为 字典获取(运行时["工具表"], 全, 空)
    如果 字典获取(条目, "插件名", 空) == 插件名:
      设 待删 为 待删 + [全]
  遍历 全 之 待删:
    字典删除(运行时["工具表"], 全)
  返回 真

段落 插件启动注册工具(运行时, 插件名, 工具声明列表):
  遍历 声明 之 工具声明列表:
    注册工具(运行时, 插件名, 声明)
  返回 真

# 自动卸载：插件停止时调用（反跑 C 变异锚点——改错即停止时不注销）
段落 插件停止注销工具(运行时, 插件名):
  返回 注销全部(运行时, 插件名)

# =====================================================================
# §2 执行上下文 + 取消令牌
# =====================================================================
段落 造取消令牌(请求ID):
  返回 {"是否已取消": 假, "取消原因": 空, "监听表": [], "请求ID": 请求ID}

段落 取消令牌(令牌, 原因):
  设 令牌["是否已取消"] 为 真
  设 令牌["取消原因"] 为 原因
  遍历 处理器 之 令牌["监听表"]:
    尝试:
      处理器(原因)
    捕获 异常:
      通过

段落 监听取消(令牌, 处理器):
  设 表 为 字典获取(令牌, "监听表", [])
  字典设置(令牌, "监听表", 表 + [处理器])
  返回 真

段落 令牌已取消(令牌):
  返回 字典获取(令牌, "是否已取消", 假)

段落 校验未取消(令牌):
  如果 令牌已取消(令牌) == 真:
    抛出 新建 错误("宿主工具: 操作已取消 (" + 文本(字典获取(令牌, "取消原因", 空)) + ")")
  返回 真

段落 造执行上下文(运行时, 参数, 调用者插件名, 作用域, 会话ID, 请求ID, 令牌):
  返回 {"运行时引用": 运行时, "参数": 参数, "上下文数据": 空, "会话ID": 会话ID,
    "作用域": 作用域, "取消令牌": 令牌, "调用者插件名": 调用者插件名,
    "调用时间": 请求ID, "请求ID": 请求ID}

# =====================================================================
# §3 权限控制 + 审计
# =====================================================================
段落 检查调用权限(条目, 调用者插件名):
  设 可见性 为 字典获取(条目, "可见性", "public")
  设 注册者 为 字典获取(条目, "插件名", 空)
  如果 可见性 == "public":
    返回 真
  如果 可见性 == "internal":
    返回 调用者插件名 == 注册者
  如果 可见性 == "private":
    返回 调用者插件名 == 注册者
  返回 假

段落 记审计(运行时, 记录):
  设 日志 为 字典获取(运行时, "审计日志", [])
  字典设置(运行时, "审计日志", 日志 + [记录])
  返回 真

段落 获取审计日志(运行时):
  返回 字典获取(运行时, "审计日志", [])

# =====================================================================
# §4 分组 / 命名空间 / 获取
# =====================================================================
段落 解析工具名(运行时, 名称):
  如果 包含文本(名称, "/") == 真:
    如果 字典包含键(运行时["工具表"], 名称):
      返回 名称
    返回 空
  设 全 为 字典获取(运行时["短名表"], 名称, 空)
  返回 全   # 空=不存在；""=歧义

段落 获取工具(运行时, 名称, 调用者插件名):
  设 全 为 解析工具名(运行时, 名称)
  如果 全 == 空:
    抛出 新建 错误("宿主工具: 工具不存在 " + 文本(名称))
  如果 全 == "":
    抛出 新建 错误("宿主工具: 工具名歧义 " + 文本(名称))
  设 条目 为 字典获取(运行时["工具表"], 全, 空)
  如果 调用者插件名 != 空:
    如果 检查调用权限(条目, 调用者插件名) == 假:
      抛出 新建 错误("宿主工具: 无调用权限 " + 全)
  返回 条目

段落 获取工具宽松(运行时, 名称):
  设 全 为 解析工具名(运行时, 名称)
  如果 全 == 空 或 全 == "":
    返回 空
  返回 字典获取(运行时["工具表"], 全, 空)

段落 列举工具(运行时, 过滤):
  设 结果 为 []
  遍历 全 之 字典键列表(运行时["工具表"]):
    设 条目 为 字典获取(运行时["工具表"], 全, 空)
    设 命中 为 真
    如果 过滤 != 空:
      如果 字典包含键(过滤, "分组") 且 字典获取(条目, "分组", 空) != 字典获取(过滤, "分组", 空):
        设 命中 为 假
      如果 字典包含键(过滤, "插件名") 且 字典获取(条目, "插件名", 空) != 字典获取(过滤, "插件名", 空):
        设 命中 为 假
      如果 字典包含键(过滤, "可见性") 且 字典获取(条目, "可见性", 空) != 字典获取(过滤, "可见性", 空):
        设 命中 为 假
    如果 命中 == 真:
      设 结果 为 结果 + [条目]
  返回 结果

# =====================================================================
# §5 调用协议（含超时重试在任务5；本路含限流简化）
# =====================================================================
段落 检查限流(运行时, 全名, 上限):
  如果 上限 <= 0:
    返回 真
  设 记录 为 字典获取(运行时["限流表"], 全名, 空)
  如果 记录 == 空:
    返回 真
  返回 字典获取(记录, "计数", 0) < 上限

段落 记录限流(运行时, 全名):
  设 记录 为 字典获取(运行时["限流表"], 全名, 空)
  如果 记录 == 空:
    设 记录 为 {"计数": 0}
  字典设置(记录, "计数", 字典获取(记录, "计数", 0) + 1)
  字典设置(运行时["限流表"], 全名, 记录)
  返回 真

段落 重置限流(运行时, 全名):
  如果 字典包含键(运行时["限流表"], 全名):
    字典删除(运行时["限流表"], 全名)
  返回 真

段落 造成功结果(数据, 元数据):
  返回 {"成功": 真, "数据": 数据, "错误码": 空, "错误消息": 空, "元数据": 元数据}

段落 造失败结果(错误码, 错误消息, 元数据):
  返回 {"成功": 假, "数据": 空, "错误码": 错误码, "错误消息": 错误消息, "元数据": 元数据}

段落 是成功结果(结果):
  返回 字典获取(结果, "成功", 假) == 真

段落 是失败结果(结果):
  返回 字典获取(结果, "成功", 假) == 假

段落 派发工具事件(运行时, 事件名, 数据):
  设 表 为 字典获取(运行时, "事件监听表", {})
  设 监听 为 字典获取(表, 事件名, [])
  遍历 处理器 之 监听:
    尝试:
      处理器(数据)
    捕获 异常:
      通过
  返回 真

段落 监听工具事件(运行时, 事件名, 处理器):
  设 表 为 字典获取(运行时, "事件监听表", {})
  设 现 为 字典获取(表, 事件名, [])
  字典设置(表, 事件名, 现 + [处理器])
  字典设置(运行时, "事件监听表", 表)
  返回 真

段落 调用工具(运行时, 名称, 参数, 调用者插件名, 作用域 = 空, 限流上限 = 0):
  设 全 为 解析工具名(运行时, 名称)
  如果 全 == 空 或 全 == "":
    返回 造失败结果("NOT_FOUND", "工具不存在 " + 文本(名称), {"工具全名": 全, "调用者": 调用者插件名})
  设 条目 为 字典获取(运行时["工具表"], 全, 空)
  如果 检查调用权限(条目, 调用者插件名) == 假:
    返回 造失败结果("PERMISSION_DENIED", "无调用权限 " + 全, {"工具全名": 全, "调用者": 调用者插件名})
  如果 检查限流(运行时, 全, 限流上限) == 假:
    返回 造失败结果("RATE_LIMITED", "超过调用频率上限 " + 全, {"工具全名": 全, "调用者": 调用者插件名})
  设 请求ID 为 取下一个请求ID(运行时)
  设 令牌 为 造取消令牌(请求ID)
  字典设置(运行时["令牌表"], 请求ID, 令牌)
  设 上下文 为 造执行上下文(运行时, 参数, 调用者插件名, 作用域, 空, 请求ID, 令牌)
  派发工具事件(运行时, "tool/called", {"请求ID": 请求ID, "工具全名": 全, "调用者": 调用者插件名, "参数": 参数})
  # 参数校验（复用 工具.light 校验参数；返回错误列表，需显式判定——校验器不抛异常）
  # 反跑 A 变异锚点：把 函数(上下文) 改为 空 即跳过执行（下方 尝试 块内）
  设 模式 为 字典获取(条目, "参数模式", 空)
  如果 模式 != 空:
    设 校验错误 为 校验参数(模式, 参数)
    如果 长(校验错误) > 0:
      设 记录 为 {"请求ID": 请求ID, "工具名": 全, "调用者": 调用者插件名, "参数摘要": 参数,
        "结果状态": "失败", "错误码": "PARAM_SCHEMA_INVALID", "耗时": 0, "时间": 请求ID}
      记审计(运行时, 记录)
      记录限流(运行时, 全)
      返回 造失败结果("PARAM_SCHEMA_INVALID", "参数校验失败 " + 转字符串(校验错误), {"工具全名": 全, "调用者": 调用者插件名, "字段错误": 校验错误})
  设 结果 为 空
  尝试:
    设 函数 为 字典获取(条目, "执行函数", 空)
    设 数据 为 函数(上下文)   # 反跑 A 变异锚点：改 空 即跳过执行
    设 结果 为 造成功结果(数据, {"工具全名": 全, "请求ID": 请求ID, "调用者": 调用者插件名, "耗时": 0})
    派发工具事件(运行时, "tool/completed", {"请求ID": 请求ID, "工具全名": 全, "成功": 真})
  捕获 异常 为 e:
    设 结果 为 造失败结果("EXECUTION_ERROR", 文本(e), {"工具全名": 全, "请求ID": 请求ID, "调用者": 调用者插件名, "耗时": 0})
    派发工具事件(运行时, "tool/failed", {"请求ID": 请求ID, "工具全名": 全, "成功": 假, "错误": 文本(e)})
  设 记录 为 {"请求ID": 请求ID, "工具名": 全, "调用者": 调用者插件名, "参数摘要": 参数,
    "结果状态": "成功", "错误码": 字典获取(结果, "错误码", 空), "耗时": 0, "时间": 请求ID}
  如果 是失败结果(结果) == 真:
    设 记录["结果状态"] 为 "失败"
  记审计(运行时, 记录)
  记录限流(运行时, 全)
  返回 结果

段落 取消调用(运行时, 请求ID):
  设 令牌 为 字典获取(运行时["令牌表"], 请求ID, 空)
  如果 令牌 == 空:
    返回 假
  取消令牌(令牌, "用户取消")
  返回 真

段落 批量调用(运行时, 调用列表, 调用者插件名):
  设 结果表 为 []
  遍历 项 之 调用列表:
    设 名称 为 字典获取(项, "名称", 空)
    设 参数 为 字典获取(项, "参数", {})
    设 作用域 为 字典获取(项, "作用域", 空)
    设 上限 为 字典获取(项, "限流上限", 0)
    设 单项 为 调用工具(运行时, 名称, 参数, 调用者插件名, 作用域, 上限)
    设 结果表 为 结果表 + [单项]
  返回 结果表
