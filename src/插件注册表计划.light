# 插件注册表计划.light —— 对标上游 deepseek-harness boot/plugin-manager（增量 ddefc45fbc..877717787c，0.1.7）
# 纯逻辑面移植（R87 任务 B3 第 3 组：boot + experimental）。
#
# 上游源码：
#   packages/boot/plugin-manager/src/registry.ts:25 normalizeRegistry
#   packages/boot/plugin-manager/src/registry.ts:51 registryPlan（ownIsPublic :54，NEXT_REGISTRY_KINDS :76，ERROR_LINE :79）
#   packages/boot/plugin-manager/src/registry.ts:89 attributeFailure
#   packages/boot/plugin-manager/src/install-spec.ts:51 gitHost（GIT_SHORTHAND_HOSTS :25）
#
# 本模块只做「URL 归一化 + 询问顺序规划 + 失败归因 + git 宿主解析」纯逻辑，浏览器也可运行。
# 不读 node:fs、不跑 pnpm、不发网络；真实安装执行仍归 插件管理.light 的宿主钩子。
#
# 数据形状（Registry = http(s) URL 字符串，或 插pnpm自 = pnpm 自身配置所指的那个源）：
#   配置 = {"首选": <Registry>, "回退": [URL...], "自解析": <URL|空>}
#     首选   = configured.registry（被询问的第一个源；可为 插pnpm自）
#     回退   = configured.fallbackRegistries（按序的公开回退源，恒为 URL 字符串）
#     自解析 = configured.resolved（pnpm 自身配置所指的 URL；读不到时为 空）
#   请求（requested）：空 = 退回「首选」；否则为 URL 字符串或 插pnpm自。
#   返回：按询问顺序的源列表（URL 字符串或 插pnpm自），永不为空。
#
# 与既有 插件管理.light 的分工：那边是「规格校验 + 补丁 + 失败分类 + 操作编排」；
# 本模块补「注册表归一化、询问计划、失败归因、git 宿主解析」这一计划层，不重复已有内容。
#
# 铁律：段落名带前缀「插册」；错误只在抛出点现造 错误；字面量单行；布尔链不配行内否则。

从 字符串处理 导入 匹配正则, 字符转ASCII

# npm 官方注册表：pnpm 不带任何配置时所指、且计划信任为公开源的那个
设 插官方注册表 为 "https://registry.npmjs.org/"
# Registry 中代表「pnpm 自身配置所指源」的哨兵字符串（区别于 空=未指定）
设 插pnpm自 为 "pnpm-own"
# 失败后还能换源再试的种类（NEXT_REGISTRY_KINDS）
设 册可下一跳 为 ["network", "timeout", "not-found", "no-matching-version"]
# git 简写前缀 -> 宿主（GIT_SHORTHAND_HOSTS）
设 册简写宿主 为 {"github": "github.com", "gitlab": "gitlab.com", "bitbucket": "bitbucket.org", "gist": "gist.github.com"}

导出 插官方注册表, 插pnpm自, 插册归一, 插册计划, 插册归属, 插册解析宿主

# registry.ts normalizeRegistry：把注册表 URL 归一为「小写宿主 + 尾斜杠」形式；非 http(s) 抛错
段落 插册归一(网址):
  设 小 为 小写(网址)
  设 方案 为 "https"
  设 起点 为 8
  如果 开头(小, "https://"):
    设 方案 为 "https"
    设 起点 为 8
  否则 如果 开头(小, "http://"):
    设 方案 为 "http"
    设 起点 为 7
  否则:
    抛出 新建 错误("a registry must be an http(s) URL: " + 网址)
  设 余 为 截取到末尾(小, 起点)
  如果 余 == "":
    抛出 新建 错误("a registry must be an http(s) URL: " + 网址)
  # 权威段 = 到第一个 / ? # 为止；其余为路径
  设 权威 为 余
  设 路径 为 "/"
  设 序号 为 0
  当 序号 < 字符串长度(余):
    设 码 为 字符串获取(余, 序号)
    如果 码 == "/" 或 码 == "?" 或 码 == "#":
      设 权威 为 截取(余, 0, 序号)
      设 路径 为 截取到末尾(余, 序号)
      跳出
    设 序号 为 序号 + 1
  如果 权威 == "":
    抛出 新建 错误("a registry must be an http(s) URL: " + 网址)
  # 路径体与 ?/# 杂尾分离；路径体补尾斜杠
  设 路体 为 路径
  设 杂尾 为 ""
  设 内 为 0
  当 内 < 字符串长度(路径):
    设 码2 为 字符串获取(路径, 内)
    如果 码2 == "?" 或 码2 == "#":
      设 路体 为 截取(路径, 0, 内)
      设 杂尾 为 截取到末尾(路径, 内)
      跳出
    设 内 为 内 + 1
  如果 结尾(路体, "/") == 假:
    设 路体 为 路体 + "/"
  返回 方案 + "://" + 权威 + 路体 + 杂尾

# registry.ts registryPlan：一次操作按顺序要问的源（先到后）
段落 插册计划(请求, 配置):
  # own = configured.resolved 归一；读不到即 插pnpm自
  设 自 为 字典获取(配置, "自解析", 空)
  设 己 为 插pnpm自
  如果 自 != 空:
    设 己 为 插册归一(自)
  设 回退表 为 字典获取(配置, "回退", [])
  设 回退归 为 []
  遍历 回 之 回退表:
    列表追加(回退归, 插册归一(回))
  # ownIsPublic：自身所指即官方或在回退表里
  设 己公开 为 假
  如果 己 != 插pnpm自:
    如果 己 == 插官方注册表:
      设 己公开 为 真
    如果 列表包含(回退归, 己):
      设 己公开 为 真
  # keyOf：pnpm 自身 = own，其余 = 归一后的 URL
  # known = [首选, ...回退] 去重（pnpm 自身仅在公开时入列）
  设 已知 为 []
  设 已知键 为 []
  设 首选 为 字典获取(配置, "首选", 插pnpm自)
  设 遍历表 为 [首选]
  遍历 回 之 回退表:
    列表追加(遍历表, 回)
  遍历 登记 之 遍历表:
    如果 登记 == 插pnpm自:
      如果 己公开 == 假:
        继续
    设 键 为 己
    如果 登记 != 插pnpm自:
      设 键 为 插册归一(登记)
    如果 列表包含(已知键, 键):
      继续
    设 入列 为 登记
    如果 登记 != 插pnpm自:
      设 入列 为 插册归一(登记)
    列表追加(已知, 入列)
    列表追加(已知键, 键)
  # first = requested ?? configured.registry
  设 首个 为 首选
  如果 请求 != 空:
    设 首个 为 请求
  设 首键 为 己
  如果 首个 != 插pnpm自:
    设 首键 为 插册归一(首个)
  设 首归 为 首个
  如果 首个 != 插pnpm自:
    设 首归 为 插册归一(首个)
  # 私有/未知的自身源（无论怎么问到）只问它自己，不回退公开源
  如果 己公开 == 假:
    如果 首个 == 插pnpm自:
      返回 [首归]
    如果 首键 == 己:
      返回 [首归]
  # 问到的源不在已知集合里：单独问它
  如果 列表包含(已知键, 首键) == 假:
    返回 [首归]
  # 否则：首源在前，其余已知源按键去重补后
  设 结果 为 [首归]
  设 序号 为 0
  当 序号 < 列表长度(已知):
    如果 已知键[序号] != 首键:
      列表追加(结果, 已知[序号])
    设 序号 为 序号 + 1
  返回 结果

# registry.ts attributeFailure：一次失败另一个源能否换答案；
# 日志错误行点名了 git/tarball 宿主时归 spec-host，否则 registry；其余 other
段落 插册归属(种类, 日志, 规格):
  如果 列表包含(册可下一跳, 种类) == 假:
    返回 "other"
  设 宿主 为 空
  设 种 为 字典获取(规格, "种类", "")
  如果 种 == "git":
    设 宿主 为 字典获取(规格, "宿主", 空)
  如果 种 == "tarball":
    设 宿主 为 字典获取(规格, "宿主", 空)
  如果 宿主 == 空:
    返回 "registry"
  设 宿小 为 小写(宿主)
  设 行表 为 分割字符串(日志, "\n")
  设 点名 为 假
  遍历 行 之 行表:
    设 行小 为 小写(行)
    设 错行 为 假
    如果 字符串包含(行小, "err_"): 设 错行 为 真
    如果 字符串包含(行小, "error"): 设 错行 为 真
    如果 字符串包含(行小, "fatal:"): 设 错行 为 真
    如果 字符串包含(行小, "could not resolve"): 设 错行 为 真
    如果 字符串包含(行小, "unable to access"): 设 错行 为 真
    如果 字符串包含(行小, "ssh:"): 设 错行 为 真
    如果 匹配正则(行小, "e[a-z]{4,}"): 设 错行 为 真
    如果 错行 == 真:
      如果 字符串包含(行小, 宿小):
        设 点名 为 真
  如果 点名:
    返回 "spec-host"
  返回 "registry"

# install-spec.ts gitHost：git 规格从哪个宿主克隆——简写宿主 / scp 形如 git@host: / URL 宿主
段落 插册解析宿主(规格):
  设 小 为 小写(规格)
  # 简写：前导纯字母 + 冒号，命中简写表即返回映射宿主
  设 冒位 为 -1
  设 序号 为 0
  当 序号 < 字符串长度(小):
    设 码 为 字符转ASCII(字符串获取(小, 序号))
    如果 码 == 58:
      设 冒位 为 序号
      跳出
    设 是字母 为 假
    如果 码 >= 97:
      如果 码 <= 122:
        设 是字母 为 真
    如果 是字母 == 假:
      设 冒位 为 -1
      跳出
    设 序号 为 序号 + 1
  如果 冒位 > 0:
    设 前 为 截取(小, 0, 冒位)
    如果 字典包含键(册简写宿主, 前):
      返回 字典获取(册简写宿主, 前)
  # scp 形如 git@host:path
  如果 开头(小, "git@"):
    设 余 为 截取到末尾(小, 4)
    设 冒位2 为 -1
    设 内 为 0
    当 内 < 字符串长度(余):
      如果 字符转ASCII(字符串获取(余, 内)) == 58:
        设 冒位2 为 内
        跳出
      设 内 为 内 + 1
    如果 冒位2 > 0:
      返回 截取(余, 0, 冒位2)
  # URL：去掉 git+ 前缀，取 :// 后到 / : ? # 前的宿主
  设 净 为 小
  如果 开头(净, "git+"):
    设 净 为 截取到末尾(净, 4)
  设 双斜 为 查找子串(净, "://")
  如果 双斜 >= 0:
    设 权威 为 截取到末尾(净, 双斜 + 3)
    设 停 为 字符串长度(权威)
    设 内 为 0
    当 内 < 字符串长度(权威):
      设 码 为 字符串获取(权威, 内)
      如果 码 == "/" 或 码 == ":" 或 码 == "?" 或 码 == "#":
        设 停 为 内
        跳出
      设 内 为 内 + 1
    返回 截取(权威, 0, 停)
  返回 净
