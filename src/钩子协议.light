# 钩子协议.light —— hooks 钩子协议纯逻辑（对标 #56）
#
# 对照原版（已逐行 Read 确认）：
#   packages/hooks/hook-protocol/src/matcher.ts        L12-65   甄别判定/正则编译/字面量
#   packages/hooks/hook-protocol/src/codec.ts          L32-134  产出解析/结构化字段应用
#   packages/hooks/hook-protocol/src/merge.ts          L34-100  多钩子合并（deny>ask>allow）
#   packages/hooks/hooks-codex/src/config.ts           L28-86   科德 hooks.json 解析
#   packages/hooks/hooks-codex/src/index.ts            L113-170 普通 stdout 作上下文
#   packages/hooks/hooks-codex/src/index.ts            L198-253 扩展点纯决策映射
#   packages/hooks/hooks-claude-code/src/config.ts     L51-123  指令替换 + 配置解析
#
# 纯逻辑化（本卡要求）：
#   剔除真实子进程 exec/spawn 与文件 IO。原版「跑命令」环节抽象成入参——
#   钩子产出由调用方以（退出码 / 标准输出 / 标准错误）三元组注入（解析钩子产出）；
#   配置解析只产出可运行的「指令表」，不落地执行、不计时、不等待。
#
# ⚠️ 命名铁律（本模块严格遵循）：
#   避开词根 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/模式/
#   用量/打印/抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回。
#   危险词根替代对照：
#     matcher → 甄别      command  → 指令        event   → 时机
#     decision→ 裁定      reason   → 缘由        timeout → 时长毫秒
#     continue→ 续行标志  callback → （本模块无需）
#   说明：匹配/回调/排序/继续 是光明真关键字，故连「含该词根」的标识符一并避开。
#
# ⚠️ 光明坑位绕法（本模块已绕，详见文件末尾「新坑登记」）：
#   L-049 捕获 错误 as 变量 绑定子句不支持 → 捕获 错误: + 局部标志记是否抛错。
#   L-051 多行字典/列表字面量破坏后续块缩进 → 所有字面量一律单行书写。
#   L-052 字符串字面量含 {标识符} 被当插值 → 用 "$" + "{" + "NAME" + "}" 拼接。
#         本模块 插件根标记/项目目录标记 两处依赖此绕法。

从 正则表达式 导入 搜索
从 JSON 导入 解析JSON 序列化JSON
从 内置核心转换 导入 转字符串

# =====================================================================
# 常量
# =====================================================================
# 退出码 2 = 阻断（stderr 作为给模型的缘由）
常量 设 阻断退出码 为 2
常量 设 方言科德 为 "codex"
常量 设 方言克劳德 为 "claude-code"
# 科德五时机（hooks-codex config.ts L11）
常量 设 科德时机表 为 ["PreToolUse", "PostToolUse", "SessionStart", "UserPromptSubmit", "Stop"]
# 克劳德七时机（hooks-claude-code config.ts L11-19）
常量 设 克劳德时机表 为 ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse", "Stop", "SubagentStart", "SubagentStop"]
# 这两个时机没有甄别主体，matcher 字段一律丢弃（两版 config.ts 同款逻辑）
常量 设 无甄别时机表 为 ["UserPromptSubmit", "Stop"]
# Claude 字面量判别式：纯 word 字符 + 竖线（matcher.ts L18）
常量 设 字面式 为 "^[A-Za-z0-9_|]+$"
# 单花括号字面量安全（只有 {标识符} 形式才会被当插值）
常量 设 左花括号 为 "{"
# 扩展点兜底缘由（hooks-codex index.ts L229/L240/L267）
常量 设 前置兜底 为 "blocked by PreToolUse hook"
常量 设 后置兜底 为 "blocked by PostToolUse hook"
常量 设 停止兜底 为 "continue: blocked by Stop hook"

# =====================================================================
# matcher.ts —— 甄别判定
# =====================================================================

# 通配哨兵：缺失 / 空串 / "*" 三态（matcher.ts L13-15）
段落 判通配 接收 甄别式:
  如果 是空(甄别式):
    返回 真
  如果 甄别式 == "":
    返回 真
  如果 甄别式 == "*":
    返回 真
  返回 假

# Claude 字面量判别：纯 word 字符 + 竖线（matcher.ts L18、L40、L61）
段落 判字面式 接收 甄别式:
  如果 是字符串(甄别式) == 假:
    返回 假
  如果 是空(搜索(字面式, 甄别式)):
    返回 假
  返回 真

# 正则可编译性：非法正则返回假而非抛错（matcher.ts L21-29）
#   光明无「编译返回 undefined」语义，故用 尝试/捕获 兜住 搜索 的抛出。
段落 编译可用 接收 甄别式:
  如果 是字符串(甄别式) == 假:
    返回 假
  设 可用 为 真
  尝试:
    设 占位 为 搜索(甄别式, "")
  捕获 错误:
    设 可用 为 假
  返回 可用

# 配置期的甄别式体检（matcher.ts L37-44）
#   返回 空 表示合法；否则返回稳定诊断串，供调用方抛 SyntaxError。
段落 甄别诊断 接收 甄别式, 方言:
  如果 判通配(甄别式):
    返回 空
  如果 方言 == 方言克劳德:
    如果 判字面式(甄别式):
      返回 空
  如果 编译可用(甄别式):
    返回 空
  返回 "invalid " + 方言 + " regex matcher " + 序列化JSON(甄别式)

# 运行期甄别命中（matcher.ts L57-65）
#   克劳德字面量 → 竖线分隔后精确比对；其余 → 非锚定正则；非法正则记未命中。
段落 甄别命中 接收 甄别式, 待查, 方言:
  如果 判通配(甄别式):
    返回 真
  如果 方言 == 方言克劳德:
    如果 判字面式(甄别式):
      设 选项表 为 分割字符串(甄别式, "|")
      返回 列表包含(选项表, 待查)
  如果 编译可用(甄别式) == 假:
    返回 假
  如果 是空(搜索(甄别式, 待查)):
    返回 假
  返回 真

# =====================================================================
# codec.ts —— 产出解析
# =====================================================================

# 读字符串字段（codec.ts L14-17）：非字符串一律视为缺失
段落 读字符串 接收 表, 键:
  如果 字典包含键(表, 键) == 假:
    返回 空
  设 值 为 表[键]
  如果 是字符串(值):
    返回 值
  返回 空

# 读布尔字段（codec.ts L20-23）
#   光明无 是布尔 地板函数；用 isinstance(值, bool) 直呼，
#   可严格区分 真/假 与 1/0（是整数 会把 1 当数、把 真 排除）。
段落 读布尔 接收 表, 键:
  如果 字典包含键(表, 键) == 假:
    返回 空
  设 值 为 表[键]
  如果 isinstance(值, bool):
    返回 值
  返回 空

# 读纯对象（codec.ts L26-30）：非 null、非数组的字典
段落 读对象 接收 值:
  如果 是字典(值):
    返回 值
  返回 空

# 顶层遗留 decision 只认 approve/block（codec.ts L38-40）
#   关键：越界的 {"decision":"deny"} 必须被忽略，不能变成真阻断。
段落 顶层裁定 接收 值:
  如果 值 == "approve":
    返回 值
  如果 值 == "block":
    返回 值
  返回 空

# hookSpecificOutput.permissionDecision 只认 allow/deny/ask（codec.ts L43-45）
段落 许可裁定值 接收 值:
  如果 值 == "allow":
    返回 值
  如果 值 == "deny":
    返回 值
  如果 值 == "ask":
    返回 值
  返回 空

# 判定值是否为数字（原版 typeof x === 'number'）：整数或浮点，bool 不算
段落 判数值 接收 值:
  如果 是整数(值):
    返回 真
  如果 是浮点(值):
    返回 真
  返回 假

# 解析钩子产出（codec.ts L59-89）
#   纯逻辑化：退出码/标准输出/标准错误 全由调用方注入，本模块不跑子进程。
段落 解析钩子产出 接收 退出码, 标准输出, 标准错误, 预期时机:
  设 错误串 为 去除空白(标准错误)
  设 输出串 为 去除空白(标准输出)
  设 产出 为 ["退出码": 退出码, "标准错误": 错误串, "标准输出": 输出串]
  # 退出码 2 = 阻断，stderr 即缘由（两版方言一致）
  如果 退出码 == 阻断退出码:
    设 产出["裁定"] 为 "block"
    如果 字符串长度(错误串) > 0:
      设 产出["缘由"] 为 错误串
  # 结构化 stdout 仅在干净退出时生效
  如果 退出码 == 0:
    如果 开头(输出串, 左花括号):
      设 已解析 为 空
      尝试:
        设 已解析 为 读对象(解析JSON(输出串))
      捕获 错误:
        设 已解析 为 空
      如果 是空(已解析) == 假:
        设 占位 为 应用结构化(产出, 已解析, 预期时机)
  返回 产出

# 折叠结构化字段进产出（codec.ts L97-134，原地改产出）
#   时机守卫：hookSpecificOutput.hookEventName 缺失或与预期时机不符时，
#   只丢弃「时机作用域内」的字段，钩子时机名本身仍记录（便于诊断）。
段落 应用结构化 接收 产出, 已解析, 预期时机:
  设 续行 为 读布尔(已解析, "continue")
  如果 是空(续行) == 假:
    设 产出["续行标志"] 为 续行
  设 停因 为 读字符串(已解析, "stopReason")
  如果 是空(停因) == 假:
    设 产出["停止缘由"] 为 停因
  设 系统消息 为 读字符串(已解析, "systemMessage")
  如果 是空(系统消息) == 假:
    设 产出["系统消息"] 为 系统消息
  设 顶裁 为 顶层裁定(读字符串(已解析, "decision"))
  如果 是空(顶裁) == 假:
    设 产出["裁定"] 为 顶裁
  设 顶因 为 读字符串(已解析, "reason")
  如果 是空(顶因) == 假:
    设 产出["缘由"] 为 顶因
  设 专属 为 读对象(取可选(已解析, "hookSpecificOutput", 空))
  如果 是空(专属) == 假:
    设 时机名 为 读字符串(专属, "hookEventName")
    如果 是空(时机名) == 假:
      设 产出["钩子时机名"] 为 时机名
    # 缺失或错名的判别器不能影响本次触发时机
    如果 是空(预期时机) == 假:
      如果 时机名 != 预期时机:
        返回 产出
    设 许可 为 许可裁定值(读字符串(专属, "permissionDecision"))
    如果 是空(许可) == 假:
      设 产出["裁定"] 为 许可
    设 许可因 为 读字符串(专属, "permissionDecisionReason")
    如果 是空(许可因) == 假:
      设 产出["缘由"] 为 许可因
    设 附加 为 读字符串(专属, "additionalContext")
    如果 是空(附加) == 假:
      设 产出["附加上下文"] 为 附加
    设 更新 为 读对象(取可选(专属, "updatedInput", 空))
    如果 是空(更新) == 假:
      设 产出["更新入参"] 为 更新
  返回 产出

# =====================================================================
# merge.ts —— 多钩子合并（deny > ask > allow）
# =====================================================================

# 单条产出的裁定等级（merge.ts L35-42）：block/deny 同归 3，approve/allow 同归 1
段落 裁定等级 接收 裁定:
  如果 裁定 == "deny":
    返回 3
  如果 裁定 == "block":
    返回 3
  如果 裁定 == "ask":
    返回 2
  如果 裁定 == "approve":
    返回 1
  如果 裁定 == "allow":
    返回 1
  返回 0

# 等级回落合并枚举（merge.ts L45-52）
段落 等级裁定 接收 等级:
  如果 等级 == 3:
    返回 "deny"
  如果 等级 == 2:
    返回 "ask"
  如果 等级 == 1:
    返回 "allow"
  返回 "none"

# 缘由以双换行连接（merge.ts L94）
段落 连接缘由 接收 缘由表:
  设 结果 为 ""
  设 序号 为 0
  遍历 因 之 缘由表:
    如果 序号 > 0:
      设 结果 为 结果 + "\n\n"
    设 结果 为 结果 + 因
    设 序号 为 序号 + 1
  返回 结果

# 合并同一扩展点上所有命中钩子的产出（merge.ts L62-100）
#   只有「胜出等级」的缘由会浮出；续行标志首次为假即粘住；上下文按钩子顺序累积。
段落 合并钩子产出 接收 产出表:
  设 最高等级 为 0
  设 三级缘由 为 []
  设 二级缘由 为 []
  设 停止 为 假
  设 停止缘由 为 空
  设 附加表 为 []
  设 系统表 为 []
  遍历 产出 之 产出表:
    设 等级 为 裁定等级(取可选(产出, "裁定", 空))
    如果 等级 > 最高等级:
      设 最高等级 为 等级
    设 因 为 取可选(产出, "缘由", 空)
    如果 等级 == 3:
      如果 是空(因) == 假:
        如果 字符串长度(因) > 0:
          列表追加(三级缘由, 因)
    如果 等级 == 2:
      如果 是空(因) == 假:
        如果 字符串长度(因) > 0:
          列表追加(二级缘由, 因)
    如果 取可选(产出, "续行标志", 真) == 假:
      如果 停止 == 假:
        设 停止 为 真
        设 停因 为 取可选(产出, "停止缘由", 空)
        如果 是空(停因) == 假:
          设 停止缘由 为 停因
    设 附加 为 取可选(产出, "附加上下文", 空)
    如果 是空(附加) == 假:
      如果 字符串长度(附加) > 0:
        列表追加(附加表, 附加)
    设 消息 为 取可选(产出, "系统消息", 空)
    如果 是空(消息) == 假:
      如果 字符串长度(消息) > 0:
        列表追加(系统表, 消息)
  设 结果 为 ["裁定": 等级裁定(最高等级), "停止": 停止, "附加上下文表": 附加表, "系统消息表": 系统表]
  设 命中表 为 空
  如果 最高等级 == 3:
    设 命中表 为 三级缘由
  如果 最高等级 == 2:
    设 命中表 为 二级缘由
  如果 是空(命中表) == 假:
    如果 列表长度(命中表) > 0:
      设 结果["缘由"] 为 连接缘由(命中表)
  如果 是空(停止缘由) == 假:
    设 结果["停止缘由"] 为 停止缘由
  返回 结果

# =====================================================================
# hooks-claude-code config.ts —— 指令替换
# =====================================================================

# 两个替换标记必须拼接构造：整串 "${CLAUDE_PLUGIN_ROOT}" 会被光明
# 当成插值（L-051），写进字面量即 NameError。
段落 插件根标记:
  返回 "$" + "{" + "CLAUDE_PLUGIN_ROOT" + "}"

段落 项目目录标记:
  返回 "$" + "{" + "CLAUDE_PROJECT_DIR" + "}"

# 应用 ${CLAUDE_PLUGIN_ROOT} / ${CLAUDE_PROJECT_DIR} 替换（config.ts L57-62）
#   变量未提供的标记原样保留。
段落 替换指令 接收 指令, 插件根, 项目目录:
  设 结果 为 指令
  如果 是空(插件根) == 假:
    设 结果 为 替换字符串(结果, 插件根标记(), 插件根)
  如果 是空(项目目录) == 假:
    设 结果 为 替换字符串(结果, 项目目录标记(), 项目目录)
  返回 结果

# =====================================================================
# 通用：从原始配置里取出「时机映射」
#   接受 { hooks: {...} } 包装，也接受裸时机映射（两版 config.ts 同款）
# =====================================================================
段落 析时机表 接收 原始:
  如果 是字典(原始) == 假:
    返回 空
  设 钩子表 为 取可选(原始, "hooks", 空)
  如果 是字典(钩子表):
    返回 钩子表
  返回 原始

# 判定某时机是否丢弃 matcher 字段
段落 丢弃甄别式 接收 时机:
  返回 列表包含(无甄别时机表, 时机)

# =====================================================================
# hooks-codex config.ts L43-86 —— 科德配置解析
#   只保留同步 command 钩子；非 command 与 async 记入跳过表；
#   UserPromptSubmit/Stop 丢弃 matcher；带 matcher 的可运行组若正则非法则抛错。
# =====================================================================
段落 解析科德配置 接收 原始:
  设 配置 为 {}
  设 跳过表 为 []
  设 时机映射 为 析时机表(原始)
  如果 是空(时机映射):
    返回 ["配置": 配置, "跳过表": 跳过表]
  遍历 时机 之 科德时机表:
    设 原始组表 为 取可选(时机映射, 时机, 空)
    如果 是列表(原始组表):
      设 组表 为 []
      遍历 原始组 之 原始组表:
        如果 是字典(原始组):
          设 钩表 为 取可选(原始组, "hooks", 空)
          如果 是列表(钩表):
            设 指令表 为 []
            遍历 原始钩 之 钩表:
              如果 是字典(原始钩):
                设 型 为 取可选(原始钩, "type", "command")
                如果 型 == "command":
                  如果 取可选(原始钩, "async", 假) == 真:
                    列表追加(跳过表, ["时机": 时机, "缘由": "async hook"])
                  否则:
                    设 指令 为 取可选(原始钩, "command", 空)
                    如果 是字符串(指令):
                      设 时长 为 空
                      如果 判数值(取可选(原始钩, "timeout", 空)):
                        设 时长 为 原始钩["timeout"]
                      否则:
                        如果 判数值(取可选(原始钩, "timeoutSec", 空)):
                          设 时长 为 原始钩["timeoutSec"]
                      设 条目 为 ["指令": 指令]
                      如果 是空(时长) == 假:
                        设 条目["时长毫秒"] 为 时长
                      列表追加(指令表, 条目)
                否则:
                  列表追加(跳过表, ["时机": 时机, "缘由": "unsupported \"" + 型 + "\" hook"])
            如果 列表长度(指令表) > 0:
              设 甄别式 为 空
              如果 丢弃甄别式(时机) == 假:
                设 甄别式 为 取可选(原始组, "matcher", 空)
                如果 是字符串(甄别式) == 假:
                  设 甄别式 为 空
              设 诊断 为 甄别诊断(甄别式, 方言科德)
              如果 是空(诊断) == 假:
                抛出 新建 错误(诊断 + " on event " + 序列化JSON(时机))
              设 组 为 ["指令表": 指令表]
              如果 是空(甄别式) == 假:
                设 组["甄别式"] 为 甄别式
              列表追加(组表, 组)
      如果 列表长度(组表) > 0:
        设 配置[时机] 为 组表
  返回 ["配置": 配置, "跳过表": 跳过表]

# =====================================================================
# hooks-claude-code config.ts L78-123 —— 克劳德配置解析
#   与科德差异：八时机、无 async 跳过逻辑、指令做变量替换、跳过项记 型 而非 缘由。
# =====================================================================
段落 解析克劳德配置 接收 原始, 插件根, 项目目录:
  设 配置 为 {}
  设 跳过表 为 []
  设 时机映射 为 析时机表(原始)
  如果 是空(时机映射):
    返回 ["配置": 配置, "跳过表": 跳过表]
  遍历 时机 之 克劳德时机表:
    设 原始组表 为 取可选(时机映射, 时机, 空)
    如果 是列表(原始组表):
      设 组表 为 []
      遍历 原始组 之 原始组表:
        如果 是字典(原始组):
          设 钩表 为 取可选(原始组, "hooks", 空)
          如果 是列表(钩表):
            设 指令表 为 []
            遍历 原始钩 之 钩表:
              如果 是字典(原始钩):
                设 型 为 取可选(原始钩, "type", "command")
                如果 型 == "command":
                  设 指令 为 取可选(原始钩, "command", 空)
                  如果 是字符串(指令):
                    设 时长 为 空
                    如果 判数值(取可选(原始钩, "timeout", 空)):
                      设 时长 为 原始钩["timeout"]
                    设 条目 为 ["指令": 替换指令(指令, 插件根, 项目目录)]
                    如果 是空(时长) == 假:
                      设 条目["时长毫秒"] 为 时长
                    列表追加(指令表, 条目)
                否则:
                  列表追加(跳过表, ["时机": 时机, "型": 型])
            如果 列表长度(指令表) > 0:
              设 甄别式 为 空
              如果 丢弃甄别式(时机) == 假:
                设 甄别式 为 取可选(原始组, "matcher", 空)
                如果 是字符串(甄别式) == 假:
                  设 甄别式 为 空
              设 诊断 为 甄别诊断(甄别式, 方言克劳德)
              如果 是空(诊断) == 假:
                抛出 新建 错误(诊断 + " on event " + 序列化JSON(时机))
              设 组 为 ["指令表": 指令表]
              如果 是空(甄别式) == 假:
                设 组["甄别式"] 为 甄别式
              列表追加(组表, 组)
      如果 列表长度(组表) > 0:
        设 配置[时机] 为 组表
  返回 ["配置": 配置, "跳过表": 跳过表]

# =====================================================================
# hooks-codex index.ts L152-156 —— 干净普通 stdout 作附加上下文
#   仅当：允许标志为真 + 退出码 0 + 尚无附加上下文 + stdout 非空 + 非 JSON 开头。
# =====================================================================
段落 普通输出作上下文 接收 产出, 允许标志:
  如果 允许标志 == 假:
    返回 产出
  如果 取可选(产出, "退出码", 空) != 0:
    返回 产出
  如果 是空(取可选(产出, "附加上下文", 空)) == 假:
    返回 产出
  设 输出串 为 取可选(产出, "标准输出", "")
  如果 字符串长度(输出串) == 0:
    返回 产出
  如果 开头(输出串, 左花括号):
    返回 产出
  设 产出["附加上下文"] 为 输出串
  返回 产出

# =====================================================================
# hooks-codex index.ts L198-253 —— 扩展点纯决策映射
#   科德只认 deny（allow/ask 不生效）；缺缘由时按扩展点回落兜底文案。
# =====================================================================

# agent/pre-step（UserPromptSubmit）：deny→reject；仅有上下文→enter；否则 pass
段落 决断前置步 接收 裁定, 有上下文:
  如果 裁定 == "deny":
    返回 "reject"
  如果 有上下文 == 真:
    返回 "enter"
  返回 "pass"

# tools/pre-execute（PreToolUse）：deny→deny，否则放行
段落 决断器前置 接收 裁定:
  如果 裁定 == "deny":
    返回 "deny"
  返回 "pass"

# tools/post-execute（PostToolUse）：deny→block，否则放行
段落 决断器后置 接收 裁定:
  如果 裁定 == "deny":
    返回 "block"
  返回 "pass"

# agent/turn-stopping（Stop）：deny→steer（强制续跑），否则放行
段落 决断停止 接收 裁定:
  如果 裁定 == "deny":
    返回 "steer"
  返回 "pass"

# 缘由兜底：空缘由回落到扩展点文案（无理由的阻断也要有转向文案）
段落 择决断缘由 接收 缘由, 兜底:
  如果 是空(缘由):
    返回 兜底
  如果 字符串长度(缘由) == 0:
    返回 兜底
  返回 缘由

# =====================================================================
# 导出
# =====================================================================
导出 阻断退出码 方言科德 方言克劳德 科德时机表 克劳德时机表 无甄别时机表 字面式
导出 左花括号 前置兜底 后置兜底 停止兜底
导出 判通配 判字面式 编译可用 甄别诊断 甄别命中
导出 读字符串 读布尔 读对象 顶层裁定 许可裁定值 判数值
导出 解析钩子产出 应用结构化
导出 裁定等级 等级裁定 连接缘由 合并钩子产出
导出 插件根标记 项目目录标记 替换指令 析时机表 丢弃甄别式
导出 解析科德配置 解析克劳德配置
导出 普通输出作上下文
导出 决断前置步 决断器前置 决断器后置 决断停止 择决断缘由
