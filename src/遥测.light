# 遥测.light —— 遥测/指标收集（对齐原版 packages/telemetry，P2 生态层）
#
# v1/v2：收集 agent 运行指标（token 用量、延迟、工具调用、错误），汇总/输出/导出/聚合/错误分类/持久化。
# v3（A1 OTel对齐）：引入 span 调用树结构（session→turn→step→llm/tool），
#   trace_id/span_id 生成、span 栈上下文管理、LLM/工具 span 属性、
#   按模型/工具维度聚合统计、错误分类统计。
#   原有方法全部保留（向后兼容），内部可独立运行。
#
# 集成：代理循环 选项["遥测"] 传入实例；驱动/执行步骤/工具执行时记录。
#
# ⚠️ 光明命名规范 v1：成员名避开关键字/运算符词根；成员赋值一律「设 己.X 为 …」。

从 随机 导入 随机整数

类 遥测收集器:
  # ---- v1/v2 原有属性 ----
  属性 轮次表 等于 []
  属性 当前轮次 等于 空
  属性 工具调用计数 等于 {}
  属性 错误计数 等于 0
  属性 总延迟秒 等于 0.0
  属性 错误分类表 等于 {}
  # ---- v3 OTel span 新增属性 ----
  属性 span表 等于 []
  属性 span栈 等于 []
  属性 当前trace_id 等于 ""
  属性 标识计数器 等于 0
  属性 记录正文 等于 假

  # 构造（无参，兼容旧调用 新建 遥测收集器()；选项通过 配置选项 方法设置）
  段落 构造 接收:
    设 己.轮次表 为 []
    设 己.当前轮次 为 空
    设 己.工具调用计数 为 {}
    设 己.错误计数 为 0
    设 己.总延迟秒 为 0.0
    设 己.错误分类表 为 {}
    设 己.span表 为 []
    设 己.span栈 为 []
    设 己.当前trace_id 为 ""
    设 己.标识计数器 为 0
    设 己.记录正文 为 假

  # 配置选项（可选）
  段落 配置选项 接收 选项:
    如果 选项 != 空 且 选项.包含("capture_content"):
      设 己.记录正文 为 选项["capture_content"]

  # ================================================================
  # v3：标识生成（时间戳+随机数+计数器，保证唯一）
  段落 生成标识 接收 长度:
    设 己.标识计数器 为 己.标识计数器 + 1
    设 基础 为 转字符串(时间戳()) + 转字符串(随机整数(100000, 999999)) + 转字符串(己.标识计数器)
    当 字符串长度(基础) < 长度:
      设 基础 为 基础 + "0"
    如果 字符串长度(基础) > 长度:
      设 基础 为 字符串截取(基础, 0, 长度)
    返回 基础

  # ================================================================
  # v3：span 栈上下文管理
  # ================================================================
  段落 栈顶span:
    如果 长度(己.span栈) == 0:
      返回 空
    返回 己.span栈[长度(己.span栈) - 1]

  # 通用：创建并压栈一个 span
  段落 创建并压栈 接收 名字, 种类, 属性表:
    设 父span 为 己.栈顶span()
    设 父id 为 ""
    如果 父span != 空:
      设 父id 为 父span["span_id"]
    设 trace_id 为 己.当前trace_id
    如果 trace_id == "" 或 种类 == "session":
      设 trace_id 为 己.生成标识(32)
      设 己.当前trace_id 为 trace_id
    设 span 为 ["trace_id": trace_id, "span_id": 己.生成标识(16), "parent_span_id": 父id, "name": 名字, "kind": 种类, "start_time": 时间戳(), "end_time": 0.0, "duration_ms": 0.0, "attributes": 属性表, "status": "ok", "error_message": ""]
    己.span表.追加(span)
    己.span栈.追加(span)
    返回 span

  # 结束栈顶 span（设置结束时间和耗时）
  段落 结束当前:
    如果 长度(己.span栈) == 0:
      返回 空
    设 span 为 己.span栈[长度(己.span栈) - 1]
    设 span["end_time"] 为 时间戳()
    设 span["duration_ms"] 为 (span["end_time"] - span["start_time"]) * 1000
    设 己.span栈[长度(己.span栈) - 1] 为 span
    # 弹栈
    设 新栈 为 []
    设 j 为 0
    当 j < 长度(己.span栈) - 1:
      新栈.追加(己.span栈[j])
      设 j 为 j + 1
    设 己.span栈 为 新栈
    返回 span

  # ================================================================
  # v3：业务 span 方法
  # ================================================================

  # 开始会话 span（kind=session，设置 trace_id）
  段落 开始会话 接收 会话ID:
    返回 己.创建并压栈("session:" + 会话ID, "session", ["session_id": 会话ID])

  # 开始轮次 span（kind=turn，父=当前栈顶）
  段落 开始轮次:
    返回 己.创建并压栈("turn", "turn", [])

  # 开始步骤 span（kind=step，父=当前栈顶）
  段落 开始步骤:
    返回 己.创建并压栈("step", "step", [])

  # 记录 LLM 调用（创建 llm span 作为当前栈顶子节点，立即结束）
  段落 记录LLM调用 接收 模型, TTFT毫秒, 输入tokens, 输出tokens, 缓存tokens, 完成原因:
    设 父span 为 己.栈顶span()
    设 父id 为 ""
    如果 父span != 空:
      设 父id 为 父span["span_id"]
    设 属性表 为 ["model": 模型, "ttft_ms": TTFT毫秒, "input_tokens": 输入tokens, "output_tokens": 输出tokens, "cache_read_tokens": 缓存tokens, "finish_reason": 完成原因]
    设 开始时刻 为 时间戳()
    设 span 为 ["trace_id": 己.当前trace_id, "span_id": 己.生成标识(16), "parent_span_id": 父id, "name": "llm:" + 模型, "kind": "llm", "start_time": 开始时刻, "end_time": 开始时刻, "duration_ms": TTFT毫秒, "attributes": 属性表, "status": "ok", "error_message": ""]
    己.span表.追加(span)
    返回 span

  # 记录工具调用详情（创建 tool span，立即结束；新签名，区别于旧 记录工具调用(工具名,延迟秒)）
  段落 记录工具调用详情 接收 工具名, 参数hash, 成功, 错误类型:
    设 父span 为 己.栈顶span()
    设 父id 为 ""
    如果 父span != 空:
      设 父id 为 父span["span_id"]
    设 状态 为 "ok"
    设 错误信息 为 ""
    如果 成功 == 假:
      设 状态 为 "error"
      设 错误信息 为 错误类型
    设 属性表 为 ["tool_name": 工具名, "params_hash": 参数hash, "success": 成功, "error_type": 错误类型]
    设 开始时刻 为 时间戳()
    设 span 为 ["trace_id": 己.当前trace_id, "span_id": 己.生成标识(16), "parent_span_id": 父id, "name": "tool:" + 工具名, "kind": "tool", "start_time": 开始时刻, "end_time": 开始时刻, "duration_ms": 0.0, "attributes": 属性表, "status": 状态, "error_message": 错误信息]
    己.span表.追加(span)
    # 同步更新旧错误分类表
    如果 成功 == 假 且 错误类型 != "" 且 错误类型 != 空:
      如果 己.错误分类表.包含(错误类型):
        设 己.错误分类表[错误类型] 为 己.错误分类表[错误类型] + 1
      否则:
        设 己.错误分类表[错误类型] 为 1
    返回 span

  # 获取全部 span（供导出器使用）
  段落 获取全部span:
    返回 己.span表

  # ================================================================
  # v3：增强聚合统计（支持 轮次/步骤/模型/工具 维度）
  # ================================================================
  段落 聚合统计 接收 维度:
    # 模型维度：从 llm span 聚合
    如果 维度 == "模型":
      返回 己.按属性聚合("llm", "model")
    # 工具维度：从 tool span 聚合
    如果 维度 == "工具":
      返回 己.按属性聚合("tool", "tool_name")
    # 轮次/步骤维度：沿用 v2 逻辑（从 轮次表）
    设 总调用数 为 0
    设 总耗时 为 0.0
    设 错误数 为 0
    如果 维度 == "轮次":
      设 总调用数 为 长度(己.轮次表)
      遍历 轮次 之 己.轮次表:
        设 总耗时 为 总耗时 + 轮次["总延迟"]
        设 错误数 为 错误数 + 轮次["错误数"]
    如果 维度 == "步骤":
      遍历 轮次 之 己.轮次表:
        设 总调用数 为 总调用数 + 长度(轮次["步骤表"])
        设 总耗时 为 总耗时 + 轮次["总延迟"]
        设 错误数 为 错误数 + 轮次["错误数"]
    设 平均耗时 为 0.0
    设 成功率 为 1.0
    如果 总调用数 > 0:
      设 平均耗时 为 总耗时 / 总调用数
      设 成功率 为 (总调用数 - 错误数) / 总调用数
    返回 ["维度": 维度, "调用数": 总调用数, "总耗时": 总耗时, "平均耗时": 平均耗时, "成功率": 成功率, "错误数": 错误数]

  # 按 span kind + 属性键 聚合（内部辅助）
  段落 按属性聚合 接收 种类, 属性键:
    设 分组表 为 {}
    遍历 span 之 己.span表:
      如果 span["kind"] == 种类:
        设 键 为 span["attributes"][属性键]
        如果 分组表.包含(键) == 假:
          设 分组表[键] 为 ["调用数": 0, "总耗时": 0.0, "成功数": 0]
        设 分组表[键]["调用数"] 为 分组表[键]["调用数"] + 1
        设 分组表[键]["总耗时"] 为 分组表[键]["总耗时"] + span["duration_ms"]
        如果 span["status"] == "ok":
          设 分组表[键]["成功数"] 为 分组表[键]["成功数"] + 1
    # 计算平均耗时和成功率
    设 结果表 为 {}
    遍历 键 之 分组表:
      设 项 为 分组表[键]
      设 平均 为 0.0
      设 成功率 为 0.0
      如果 项["调用数"] > 0:
        设 平均 为 项["总耗时"] / 项["调用数"]
        设 成功率 为 项["成功数"] / 项["调用数"]
      设 结果表[键] 为 ["调用数": 项["调用数"], "总耗时": 项["总耗时"], "平均耗时": 平均, "成功率": 成功率]
    返回 ["维度": 种类 + ":" + 属性键, "分组": 结果表]

  # ================================================================
  # v1/v2 原有方法（向后兼容，全部保留）
  # ================================================================

  # 记录轮次开始
  段落 记录轮次开始 接收 轮次:
    设 己.当前轮次 为 ["轮次": 轮次, "步骤表": [], "工具调用数": 0, "错误数": 0, "总延迟": 0.0, "总promptToken": 0, "总completionToken": 0]

  # 记录步骤：延迟秒 + 用量 {promptTokens, completionTokens}
  段落 记录步骤 接收 轮次, 步骤, 延迟秒, 用量:
    如果 己.当前轮次 == 空:
      返回
    设 步骤记录 为 ["步骤": 步骤, "延迟": 延迟秒, "promptToken": 0, "completionToken": 0]
    如果 用量 != 空:
      如果 用量.包含("输入"):
        设 步骤记录["promptToken"] 为 用量["输入"]
      否则如果 用量.包含("promptTokens"):
        设 步骤记录["promptToken"] 为 用量["promptTokens"]
      如果 用量.包含("输出"):
        设 步骤记录["completionToken"] 为 用量["输出"]
      否则如果 用量.包含("completionTokens"):
        设 步骤记录["completionToken"] 为 用量["completionTokens"]
    己.当前轮次["步骤表"].追加(步骤记录)
    己.当前轮次["总延迟"] 为 己.当前轮次["总延迟"] + 延迟秒
    己.当前轮次["总promptToken"] 为 己.当前轮次["总promptToken"] + 步骤记录["promptToken"]
    己.当前轮次["总completionToken"] 为 己.当前轮次["总completionToken"] + 步骤记录["completionToken"]
    设 己.总延迟秒 为 己.总延迟秒 + 延迟秒

  # 记录工具调用（旧签名：工具名, 延迟秒；代理循环使用）
  段落 记录工具调用 接收 工具名, 延迟秒:
    如果 己.当前轮次 != 空:
      己.当前轮次["工具调用数"] 为 己.当前轮次["工具调用数"] + 1
    如果 己.工具调用计数.包含(工具名):
      设 己.工具调用计数[工具名] 为 己.工具调用计数[工具名] + 1
    否则:
      设 己.工具调用计数[工具名] 为 1

  # 记录错误（v2：同时按类型分类）
  段落 记录错误 接收 错误描述:
    设 己.错误计数 为 己.错误计数 + 1
    如果 己.当前轮次 != 空:
      己.当前轮次["错误数"] 为 己.当前轮次["错误数"] + 1
    设 错误类型 为 "other"
    设 描述文本 为 转字符串(错误描述)
    如果 描述文本.包含("timeout") 或 描述文本.包含("超时"):
      设 错误类型 为 "timeout"
    如果 描述文本.包含("auth") 或 描述文本.包含("认证") 或 描述文本.包含("401"):
      设 错误类型 为 "auth"
    如果 描述文本.包含("rate") 或 描述文本.包含("429") 或 描述文本.包含("限流"):
      设 错误类型 为 "rate_limit"
    如果 描述文本.包含("network") 或 描述文本.包含("连接") 或 描述文本.包含("connection"):
      设 错误类型 为 "network"
    如果 己.错误分类表.包含(错误类型):
      设 己.错误分类表[错误类型] 为 己.错误分类表[错误类型] + 1
    否则:
      设 己.错误分类表[错误类型] 为 1

  # 记录轮次结束
  段落 记录轮次结束 接收 轮次, 结果:
    如果 己.当前轮次 != 空:
      设 己.当前轮次["结果"] 为 结果
      己.轮次表.追加(己.当前轮次)
    设 己.当前轮次 为 空

  # 汇总：返回统计字典
  段落 汇总:
    设 总步骤 为 0
    设 总工具调用 为 0
    设 总prompt 为 0
    设 总completion 为 0
    遍历 轮次 之 己.轮次表:
      设 总步骤 为 总步骤 + 长度(轮次["步骤表"])
      设 总工具调用 为 总工具调用 + 轮次["工具调用数"]
      设 总prompt 为 总prompt + 轮次["总promptToken"]
      设 总completion 为 总completion + 轮次["总completionToken"]
    返回 ["轮次数": 长度(己.轮次表), "总步骤": 总步骤, "总工具调用": 总工具调用, "总错误": 己.错误计数, "总延迟秒": 己.总延迟秒, "总promptToken": 总prompt, "总completionToken": 总completion, "工具调用明细": 己.工具调用计数]

  # 输出：打印可读汇总
  段落 输出:
    设 统计 为 己.汇总()
    打印 "=== 遥测汇总 ==="
    打印 "轮次数: " 加上 转字符串(统计["轮次数"])
    打印 "总步骤: " 加上 转字符串(统计["总步骤"])
    打印 "总工具调用: " 加上 转字符串(统计["总工具调用"])
    打印 "总错误: " 加上 转字符串(统计["总错误"])
    打印 "总延迟秒: " 加上 转字符串(统计["总延迟秒"])
    打印 "总promptToken: " 加上 转字符串(统计["总promptToken"])
    打印 "总completionToken: " 加上 转字符串(统计["总completionToken"])
    打印 "工具调用明细: " 加上 转字符串(统计["工具调用明细"])
    打印 "=================="

  # v2：导出指标——格式参数指定 "json"，返回 JSON 格式字符串
  段落 导出指标 接收 格式:
    设 统计 为 己.汇总()
    设 导出数据 为 ["指标名": "telemetry", "格式": 格式, "时间戳": 时间戳(), "维度标签": ["agent", "session"], "数据": 统计]
    如果 格式 == "json":
      返回 序列化JSON(导出数据)
    返回 转字符串(导出数据)

  # v2：错误分类统计——按错误类型分类
  段落 错误分类统计:
    返回 己.错误分类表

  # v2：持久化接口——将遥测数据写入指定路径的 JSON 文件
  段落 持久化接口 接收 文件路径:
    设 导出数据 为 ["导出时间": 时间戳(), "汇总": 己.汇总(), "错误分类": 己.错误分类表, "轮次明细": 己.轮次表]
    设 文本 为 序列化JSON(导出数据)
    写入文件(文件路径, 文本)
    返回 文件路径

  # v3：导出——触发全部 span 导出（返回 span 表，供导出器管理器使用）
  段落 导出:
    返回 己.span表

  # v3：持久化 span 为 JSONL（每行一个 span JSON）
  段落 持久化 接收 文件路径:
    设 全部文本 为 ""
    遍历 span 之 己.span表:
      设 行文本 为 序列化JSON(span)
      设 全部文本 为 全部文本 + 行文本 + "\n"
    写入文件(文件路径, 全部文本)
    返回 文件路径

# 顶层便捷构造
段落 新建遥测收集器:
  返回 新建 遥测收集器()
