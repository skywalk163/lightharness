# office转PDF.light —— 对标原版 deepseek-harness packages/document/office-to-pdf
# 锚点提交 ddefc45fbc（0.1.6-alpha.2 新包 document/office-to-pdf）。
#
# 纯逻辑范围（本模块只移植运行期可验证的纯逻辑，不涉及真实 LibreOffice / 网络 / 真实 FS 写）：
#   types.ts    → 数据形状：转换任务 / 选项 / 结果 + 状态枚举（pending/running/done/failed）
#   errors.ts   → 错误族分类：办转构造错误 + 错误码常量 + 按码分类判定（输入/输出/引擎/源）
#   identity.ts → 身份归一：由 源键+版本+扩展名 推导稳定 identity（规范化序列化 JSON，确定性）
#   output.ts   → 输出归一：给定转换结果，归一化输出元数据 + 纯 PDF 完整性/体积校验
#   queue.ts    → 核心纯逻辑：转换队列（入队 / 按 identity 去重 / 优先级 / 状态跟踪 / 出队 / 查状态 / 列队）
#   index.ts    → 服务装配 + provider 抽象：队列调度 + 结果/错误归一 + identity
#
# 宿主面登记项（真实转换必须注入回调，本模块绝不调用 LibreOffice）：
#   由调用方注入：设 宿主钩子 为 {"转换": 某段落}
#   办转提交转换 经 服务["宿主钩子"]["转换"](内容, 扩展名) 回调拿到 PDF，再归一为结果。
#   provider（LibreOffice 后端）是宿主面；纯逻辑 = 队列调度 + 结果/错误归一 + identity。

# ===================== 状态枚举（JobStatus）=====================
设 办转状态待定 为 "pending"
设 办转状态运行 为 "running"
设 办转状态完成 为 "done"
设 办转状态失败 为 "failed"

# ===================== 错误码常量（对标 OfficeToPdfErrorCode）=====================
设 办转错误码输入过大 为 "input-too-large"
设 办转错误码输出过大 为 "output-too-large"
设 办转错误码文档无效 为 "invalid-document"
设 办转错误码格式不支持 为 "unsupported-format"
设 办转错误码输出无效 为 "invalid-output"
设 办转错误码超时 为 "timeout"
设 办转错误码不可用 为 "unavailable"
设 办转错误码失败 为 "failed"
设 办转错误码繁忙 为 "busy"
设 办转错误码源变更 为 "source-changed"

# ===================== types.ts 纯逻辑：数据形状构造 / 校验 =====================
# 构造一个转换任务（ConversionJob）：源键/版本/扩展名/优先级/内容 + 初始状态 pending。
段落 办转构造任务(源键, 版本, 扩展名, 优先级, 内容):
  返回 {"源键": 源键, "版本": 版本, "扩展名": 扩展名, "优先级": 优先级, "内容": 内容, "状态": 办转状态待定}

# 构造转换选项（ConversionOptions）：队列/源/输出相关限制，调用方可按需传参。
段落 办转构造选项(最大并发, 最大排队, 最大源字节, 最大输出字节):
  返回 {"最大并发": 最大并发, "最大排队": 最大排队, "最大源字节": 最大源字节, "最大输出字节": 最大输出字节}

# 构造转换结果（ConversionResult）：pdf/缺失字体/缓存键/生成标识。
段落 办转构造结果(pdf, 缺失字体, 缓存键, 生成):
  返回 {"pdf": pdf, "缺失字体": 缺失字体, "缓存键": 缓存键, "生成": 生成}

# 校验转换任务形状；非法则抛带错误码的异常。
段落 办转校验任务(任务):
  如果 是字典(任务) == 假:
    抛出 新建 错误(办转构造错误(办转错误码文档无效, "办转校验任务: 任务必须是字典"))
  如果 是字符串(字典获取(任务, "源键", 空)) == 假 或 字符串长度(字典获取(任务, "源键", "")) == 0:
    抛出 新建 错误(办转构造错误(办转错误码文档无效, "办转校验任务: 源键须为非空字符串"))
  如果 是字符串(字典获取(任务, "版本", 空)) == 假 或 字符串长度(字典获取(任务, "版本", "")) == 0:
    抛出 新建 错误(办转构造错误(办转错误码文档无效, "办转校验任务: 版本须为非空字符串"))
  如果 是字符串(字典获取(任务, "扩展名", 空)) == 假 或 字符串长度(字典获取(任务, "扩展名", "")) == 0:
    抛出 新建 错误(办转构造错误(办转错误码文档无效, "办转校验任务: 扩展名须为非空字符串"))
  如果 任务["优先级"] != "foreground" 且 任务["优先级"] != "background":
    抛出 新建 错误(办转构造错误(办转错误码文档无效, "办转校验任务: 优先级须为 foreground 或 background"))
  返回 真

# ===================== errors.ts 纯逻辑：错误族分类 =====================
# 构造一个带错误码的结构化错误（返回序列化 JSON 字符串，便于解析回错误码；
# 注意：导入模块内不能以「返回 新建 错误」形式返回异常对象——本段只产出 JSON 串，
# 真正抛出由 抛出 新建 错误(办转构造错误(...)) 在宿主/测试侧完成）。
段落 办转构造错误(码, 消息):
  设 结构 为 {"码": 码, "消息": 消息}
  返回 序列化JSON(结构)

# 从异常中提取错误码（无法解析则返回 空）。
段落 办转取错误码(异常):
  尝试:
    设 解析 为 解析JSON(转字符串(异常))
    如果 是字典(解析) == 假:
      返回 空
    返回 字典获取(解析, "码", 空)
  捕获 异常:
    返回 空

# 按错误码归类到族：输入 / 输出 / 引擎 / 源 / 未知。
段落 办转错误族(码):
  如果 码 == 办转错误码输入过大 或 码 == 办转错误码文档无效 或 码 == 办转错误码格式不支持:
    返回 "输入"
  如果 码 == 办转错误码输出过大 或 码 == 办转错误码输出无效:
    返回 "输出"
  如果 码 == 办转错误码超时 或 码 == 办转错误码不可用 或 码 == 办转错误码失败 或 码 == 办转错误码繁忙:
    返回 "引擎"
  如果 码 == 办转错误码源变更:
    返回 "源"
  返回 "未知"

# 判定异常是否匹配期望错误码。
段落 办转是错误码(异常, 期望码):
  返回 办转取错误码(异常) == 期望码

# ===================== identity.ts 纯逻辑：身份归一（确定性）=====================
# 由 源键+版本+扩展名 推导稳定 identity：规范化序列化 JSON，保证同输入同输出、不同输入不同。
段落 办转推导身份(源键, 版本, 扩展名):
  设 归一 为 序列化JSON([源键, 版本, 扩展名])
  返回 "id-" 加上 归一

# 校验输入并推导 identity；非法输入抛 格式不支持 错误。
段落 办转校验身份(源键, 版本, 扩展名):
  如果 是字符串(源键) == 假 或 字符串长度(源键) == 0:
    抛出 新建 错误(办转构造错误(办转错误码格式不支持, "办转校验身份: 源键须为非空字符串"))
  如果 是字符串(版本) == 假 或 字符串长度(版本) == 0:
    抛出 新建 错误(办转构造错误(办转错误码格式不支持, "办转校验身份: 版本须为非空字符串"))
  如果 是字符串(扩展名) == 假 或 字符串长度(扩展名) == 0:
    抛出 新建 错误(办转构造错误(办转错误码格式不支持, "办转校验身份: 扩展名须为非空字符串"))
  返回 办转推导身份(源键, 版本, 扩展名)

# ===================== output.ts 纯逻辑：输出归一 + 纯 PDF 校验 =====================
# 纯 PDF 完整性/体积校验（不读真实 FS）：pdf 为字符串，检查体积上限、%PDF 头、%%EOF 尾。
段落 办转校验输出(结果, 最大字节):
  如果 是字典(结果) == 假:
    抛出 新建 错误(办转构造错误(办转错误码输出无效, "办转校验输出: 结果必须是字典"))
  设 pdf 为 字典获取(结果, "pdf", 空)
  如果 是字符串(pdf) == 假:
    抛出 新建 错误(办转构造错误(办转错误码输出无效, "办转校验输出: pdf 须为字符串"))
  设 字节数 为 字符串长度(pdf)
  如果 字节数 > 最大字节:
    抛出 新建 错误(办转构造错误(办转错误码输出过大, "办转校验输出: PDF 超过最大字节"))
  如果 字符串包含(pdf, "%PDF") == 假:
    抛出 新建 错误(办转构造错误(办转错误码输出无效, "办转校验输出: 不是合法 PDF（缺 %PDF 头）"))
  如果 字符串包含(pdf, "%%EOF") == 假:
    抛出 新建 错误(办转构造错误(办转错误码输出无效, "办转校验输出: PDF 不完整（缺 %%EOF 尾）"))
  返回 真

# 给定转换结果，归一化输出路径/元数据（纯）；返回 {pdf, 字节长度, 缺失字体数, 缓存键, 生成}。
段落 办转投影输出(结果, 配置):
  设 最大字节 为 字典获取(配置, "最大输出字节", 100000000)
  办转校验输出(结果, 最大字节)
  设 pdf 为 字典获取(结果, "pdf", "")
  设 缺失字体 为 字典获取(结果, "缺失字体", [])
  设 归一 为 {}
  字典设置(归一, "pdf", pdf)
  字典设置(归一, "字节长度", 字符串长度(pdf))
  字典设置(归一, "缺失字体数", 列表长度(缺失字体))
  字典设置(归一, "缓存键", 字典获取(结果, "缓存键", ""))
  字典设置(归一, "生成", 字典获取(结果, "生成", ""))
  返回 归一

# ===================== queue.ts 核心纯逻辑：转换队列 =====================
# 新建一个空队列（数据结构）：任务表 + 身份集合（去重索引）+ 配置。
段落 办转新建队列(配置):
  设 队列 为 {}
  字典设置(队列, "任务表", [])
  字典设置(队列, "身份集合", {})
  字典设置(队列, "配置", 配置)
  返回 队列

# 判断某 identity 是否已在队列（去重判定）。
段落 办转去重判定(队列, 身份):
  设 集合 为 字典获取(队列, "身份集合", {})
  返回 字典包含键(集合, 身份)

# 入队：相同 identity 不入两次；返回 真=已入队，假=重复被拒。
段落 办转入队(队列, 身份, 优先级, 载荷):
  如果 办转去重判定(队列, 身份) == 真:
    返回 假
  设 任务 为 {"身份": 身份, "优先级": 优先级, "状态": 办转状态待定, "载荷": 载荷}
  设 表 为 字典获取(队列, "任务表", [])
  列表追加(表, 任务)
  设 集合 为 字典获取(队列, "身份集合", {})
  字典设置(集合, 身份, 真)
  返回 真

# 出队下一个 pending 任务：若有前台 pending 则优先返回首个前台，否则返回首个后台；标记 running。
段落 办转出队(队列):
  设 表 为 字典获取(队列, "任务表", [])
  设 有前台 为 假
  遍历 任务 之 表:
    如果 任务["状态"] == 办转状态待定 且 任务["优先级"] == "foreground":
      设 有前台 为 真
      跳出
  遍历 任务 之 表:
    如果 任务["状态"] != 办转状态待定:
      继续
    如果 有前台 == 真 且 任务["优先级"] != "foreground":
      继续
    字典设置(任务, "状态", 办转状态运行)
    返回 任务
  返回 空

# 标记某 identity 任务为 running。
段落 办转标记运行(队列, 身份):
  设 表 为 字典获取(队列, "任务表", [])
  遍历 任务 之 表:
    如果 任务["身份"] == 身份:
      字典设置(任务, "状态", 办转状态运行)
      返回 真
  返回 假

# 标记某 identity 任务为 done（转换成功）。
段落 办转标记完成(队列, 身份):
  设 表 为 字典获取(队列, "任务表", [])
  遍历 任务 之 表:
    如果 任务["身份"] == 身份:
      字典设置(任务, "状态", 办转状态完成)
      返回 真
  返回 假

# 标记某 identity 任务为 failed（转换失败）。
段落 办转标记失败(队列, 身份):
  设 表 为 字典获取(队列, "任务表", [])
  遍历 任务 之 表:
    如果 任务["身份"] == 身份:
      字典设置(任务, "状态", 办转状态失败)
      返回 真
  返回 假

# 查询某 identity 任务的状态（pending/running/done/failed）；不在队列返回 空。
段落 办转查状态(队列, 身份):
  设 表 为 字典获取(队列, "任务表", [])
  遍历 任务 之 表:
    如果 任务["身份"] == 身份:
      返回 任务["状态"]
  返回 空

# 列队：返回当前任务表（列表，元素为任务字典）。
段落 办转列队(队列):
  返回 字典获取(队列, "任务表", [])

# ===================== index.ts 纯逻辑：服务装配 + provider 抽象 =====================
# 新建服务：持有队列 + 配置 + 宿主钩子（初始为 空，待注入）。
段落 办转新建服务(配置):
  设 服务 为 {}
  字典设置(服务, "队列", 办转新建队列(配置))
  字典设置(服务, "配置", 配置)
  字典设置(服务, "宿主钩子", 空)
  返回 服务

# 登记宿主面：注入 {转换: 某段落} 回调（真实 LibreOffice 转换由该回调提供）。
段落 办转设宿主钩子(服务, 钩子):
  字典设置(服务, "宿主钩子", 钩子)
  返回 服务

# 提交一次转换：identity 归一 → 入队去重 → 调宿主钩子转换 → 结果归一 → 标记完成。
# 返回 {重复, 身份, 结果}；未注入宿主钩子时抛 不可用 错误（provider 不可用）。
段落 办转提交转换(服务, 源键, 版本, 扩展名, 内容):
  设 身份 为 办转校验身份(源键, 版本, 扩展名)
  设 队列 为 字典获取(服务, "队列", {})
  如果 办转去重判定(队列, 身份) == 真:
    返回 {"重复": 真, "身份": 身份, "结果": 空}
  办转入队(队列, 身份, "foreground", 内容)
  设 钩子 为 字典获取(服务, "宿主钩子", 空)
  如果 钩子 == 空:
    抛出 新建 错误(办转构造错误(办转错误码不可用, "办转提交转换: 未注入宿主转换钩子（LibreOffice 后端）"))
  设 原始结果 为 钩子["转换"](内容, 扩展名)
  设 归一 为 办转投影输出(原始结果, 字典获取(服务, "配置", {}))
  字典设置(归一, "身份", 身份)
  办转标记完成(队列, 身份)
  返回 {"重复": 假, "身份": 身份, "结果": 归一}

导出 办转状态待定
导出 办转状态运行
导出 办转状态完成
导出 办转状态失败
