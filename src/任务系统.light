# 任务系统.light —— 后台任务（jobs）子系统纯逻辑核心
# 对齐原版：
#   packages/jobs/jobs-local/src/index.ts
#     L131-154  start 入口校验（controller/owner、kind、label、outputLimitBytes、并发槽位、kind-count ID）
#     L192-197  list 归属过滤
#     L205-213  read 产出投影 + 终态标记 reported
#     L215-228  kill 状态迁移（终态→already-finished；否则 cancel→stopping→reported=true）
#     L230-279  wait 时限校验 + 等待超时 / caller 取消 区分
#     L321-328  activeTaskCount 并发槽位计数
#     L416-440  settle 首胜结算（waiters>0 则 reported）
#   packages/jobs/tool-jobs/src/index.ts
#     L205-222  插件配置与预算（waitTimeoutMs / maxWaitTimeoutMs / completionDelivery / maxConsecutiveWakes）
#     L224-230  人类输入认领重置连续唤醒预算
#     L293-300  唤醒预算耗尽降级为注入
#     L333      wait 时限取 min(timeout_ms ?? waitDefault, waitCap)
#
# 复刻边界（只取纯逻辑，剔除过程调度胶水）：
#   - 剔除真实进程/协程调度、Promise、AbortSignal、定时器、监听器分层（ScopedLayers/AnonymousEntries）。
#     等待结局改由调用方以「信号中止 / 到达期限 / 结算阶段」三个确定入参注入，
#     使「等待超时」与「caller 取消」两条路径在纯函数下可判定、可断言。
#   - 控制器分层简化为「全域控制器计数 + 归属控制器名单」两条纯数据，
#     语义保留原版「全域层服务所有 owner；归属层只服务其下 agent」。
#   - 全部导出为纯函数；任务册/已用表为普通字典，原地写入（光明无不可变字典原语）。
#
# ⚠️ 命名铁律（光明 parser 按关键字边界拆标识符）：
#   避开词根 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/模式(含模)/用量/打印/
#            抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回。
#   状态不用「状态」二字（L-041），一律叫 阶段；变量不用单字「出」「字典」「映射」「父」（L-041/L-046/L-032）。
#   函数定义一律 `段落 X 接收 参数:`（L-040）；布尔链不配行内否则（L-043），改顺序 如果。
#   断言降级 no-op（L-037），判据一律 断言相等 / 检查抛错（测试侧）。
#   循环 break 写 跳出（L-039）；不用 截取到末尾（L-038）。
#
# 依赖：JSON（序列化JSON，等价 JSON.stringify 用于错误信息）、
#       内置核心转换（转字符串）、内置 取可选/字典包含键/列表包含/列表追加/字典值列表/字符串长度。

从 JSON 导入 序列化JSON
从 内置核心转换 导入 转字符串

# =====================================================================
# 常量
# =====================================================================

# 三种终态（jobs-local L66-68 isTerminal）
设 终态清单 为 ["completed", "killed", "failed"]
# 两种活动态（jobs-local L325 计并发槽位只数 running/stopping）
设 活动态清单 为 ["running", "stopping"]
# jobs-local L28 DEFAULT_MAX_CONCURRENT_TASKS_PER_OWNER
设 默认槽位上限 为 10
# jobs-local L25 TASK_WAIT_TIMEOUT
设 等待超时码 为 "TASK_WAIT_TIMEOUT"
# Number.MAX_SAFE_INTEGER
设 安全整数上限 为 9007199254740991

# =====================================================================
# 判型与状态谓词（纯函数）
# =====================================================================

# 是否终态：completed / killed / failed
段落 判终态 接收 阶段:
  如果 列表包含(终态清单, 阶段): 返回 真
  返回 假

# 是否活动态：running / stopping（并发槽位只数这两种）
段落 判活动态 接收 阶段:
  如果 列表包含(活动态清单, 阶段): 返回 真
  返回 假

# Number.isSafeInteger：整数且 |值| <= 2^53-1
# 用于 outputLimitBytes（L137-139）与 maxConsecutiveWakes（L220）
段落 判安全整数 接收 值:
  如果 是整数(值) == 假: 返回 假
  如果 值 > 安全整数上限: 返回 假
  如果 值 < 0 - 安全整数上限: 返回 假
  返回 真

# Number.isFinite 且为正：用于 wait 时限校验（L233）
# 「值 * 0 != 0」捕获 ±Infinity（Inf*0 = NaN，NaN != 0），无需写无穷字面量。
段落 判有限正数 接收 值:
  如果 是整数(值) == 假:
    如果 是浮点(值) == 假: 返回 假
  如果 值 != 值: 返回 假
  如果 值 * 0 != 0: 返回 假
  如果 值 <= 0: 返回 假
  返回 真

# =====================================================================
# 任务册（registry 的纯数据投影）
#   结构：{ "槽位上限": int, "记录表": {id: 记录}, "计次表": {kind: count},
#           "全域控制器": int, "归属控制器": [owner...] }
# =====================================================================
段落 造任务册 接收 槽位上限:
  如果 槽位上限 == 空:
    设 槽位上限 为 默认槽位上限
  # 注意（L-049）：字典字面量必须单行——跨行写会让后续语句块丢失缩进
  返回 ["槽位上限": 槽位上限, "记录表": {}, "计次表": {}, "全域控制器": 1, "归属控制器": []]

# 是否有控制器服务该归属（jobs-local L315-319 servesOwner）
#   全域层非空 → 服务一切 owner；否则仅当归属在其自身作用域链上有控制器。
段落 判有控制器 接收 任务册, 归属:
  如果 任务册["全域控制器"] > 0: 返回 真
  如果 归属 == 空: 返回 假
  如果 列表包含(任务册["归属控制器"], 归属): 返回 真
  返回 假

# =====================================================================
# 记录与快照
# =====================================================================

# 一条可变的任务记录（jobs-local L157-175 TrackedTask 的纯数据形态）
段落 造记录 接收 标识, 类别, 标题, 归属, 输出上限, 起始时刻:
  # 注意（L-049）：本字典字面量刻意单行，跨行会破坏后续块缩进
  返回 ["id": 标识, "kind": 类别, "label": 标题, "outputLimitBytes": 输出上限, "owner": 归属, "status": "running", "detail": 空, "output": 空, "startedAt": 起始时刻, "finishedAt": 空, "reported": 假, "waiters": 0]

# 投影只读快照（jobs-local L363-377 snapshot）：可选字段缺失则整键不出现
段落 造快照 接收 记录:
  设 快照 为 ["id": 记录["id"], "kind": 记录["kind"], "label": 记录["label"], "status": 记录["status"], "startedAt": 记录["startedAt"], "reported": 记录["reported"]]
  如果 记录["outputLimitBytes"] != 空:
    设 快照["outputLimitBytes"] 为 记录["outputLimitBytes"]
  如果 记录["owner"] != 空:
    设 快照["ownerSession"] 为 记录["owner"]
  如果 记录["detail"] != 空:
    设 快照["detail"] 为 记录["detail"]
  如果 记录["finishedAt"] != 空:
    设 快照["finishedAt"] 为 记录["finishedAt"]
  返回 快照

# 按标识定位记录；不存在则抛（jobs-local L345-349 expect）
段落 定位记录 接收 任务册, 标识:
  设 记录表 为 任务册["记录表"]
  如果 字典包含键(记录表, 标识) == 假:
    抛出 新建 错误("unknown job " + 转字符串(标识))
  设 记录 为 记录表[标识]
  返回 记录

# 归属隔离栅栏（jobs-local L356-360 assertAccess）：
#   有归属的任务只对同会话调用者可见；无归属任务对所有人开放；
#   无 agent 的调用者永远匹配不上有归属的任务。
段落 校验归属 接收 记录, 调用者:
  设 归属 为 记录["owner"]
  如果 归属 != 空:
    如果 归属 != 调用者:
      设 标识 为 记录["id"]
      抛出 新建 错误("job " + 转字符串(标识) + " belongs to another session")
  返回 真

# =====================================================================
# 并发槽位（jobs-local L321-328 activeTaskCount + L143-148 上限判定）
# =====================================================================
段落 活动任务数 接收 任务册, 归属:
  设 计次 为 0
  设 记录表 为 任务册["记录表"]
  遍历 记录 之 字典值列表(记录表):
    如果 记录["owner"] == 归属:
      如果 判活动态(记录["status"]):
        设 计次 为 计次 + 1
  返回 计次

# 该归属是否还有空槽位（active < max）
段落 判有空槽 接收 任务册, 归属:
  设 活动 为 活动任务数(任务册, 归属)
  如果 活动 >= 任务册["槽位上限"]: 返回 假
  返回 真

# =====================================================================
# kind-count ID（jobs-local L151-153）
#   计数器按 kind 累加，ID 形如 "<kind>-<count>"
# =====================================================================
段落 查类别序号 接收 任务册, 类别:
  设 计次表 为 任务册["计次表"]
  如果 字典包含键(计次表, 类别) == 假: 返回 1
  设 旧值 为 计次表[类别]
  返回 旧值 + 1

段落 构造任务标识 接收 类别, 序号:
  返回 类别 + "-" + 转字符串(序号)

# =====================================================================
# start 入口校验（jobs-local L131-148，顺序与原版一致）
#   规格：{ "kind": str, "label": str, "owner": str|空, "outputLimitBytes": int|空 }
# =====================================================================
段落 校验启动 接收 规格, 任务册:
  设 归属 为 取可选(规格, "owner", 空)
  如果 判有控制器(任务册, 归属) == 假:
    抛出 新建 错误("background jobs unavailable: no job controller serves this agent")
  设 类别 为 取可选(规格, "kind", "")
  如果 字符串长度(类别) == 0:
    抛出 新建 错误("invalid job kind: expected a non-empty string")
  设 标题 为 取可选(规格, "label", "")
  如果 字符串长度(标题) == 0:
    抛出 新建 错误("invalid job label: expected a non-empty string")
  设 输出上限 为 取可选(规格, "outputLimitBytes", 空)
  如果 输出上限 != 空:
    如果 判安全整数(输出上限) == 假:
      抛出 新建 错误("invalid outputLimitBytes: expected a positive safe integer, got " + 序列化JSON(输出上限))
    如果 输出上限 <= 0:
      抛出 新建 错误("invalid outputLimitBytes: expected a positive safe integer, got " + 序列化JSON(输出上限))
  设 活动 为 活动任务数(任务册, 归属)
  如果 活动 >= 任务册["槽位上限"]:
    设 上限 为 任务册["槽位上限"]
    抛出 新建 错误("background job limit reached for this owner (limit: " + 转字符串(上限) + "); use job_kill to stop an unneeded job, wait for it to finish, then retry")
  返回 真

# 登记一条新任务：先全量校验，再发 ID、写记录、推计数器（jobs-local L131-189）
#   返回新任务标识。校验任一失败即抛，不写任何状态。
段落 登记任务 接收 任务册, 规格, 起始时刻:
  设 占位 为 校验启动(规格, 任务册)
  设 类别 为 规格["kind"]
  设 归属 为 取可选(规格, "owner", 空)
  设 序号 为 查类别序号(任务册, 类别)
  设 标识 为 构造任务标识(类别, 序号)
  设 输出上限 为 取可选(规格, "outputLimitBytes", 空)
  设 记录 为 造记录(标识, 类别, 规格["label"], 归属, 输出上限, 起始时刻)
  设 记录表 为 任务册["记录表"]
  设 记录表[标识] 为 记录
  设 任务册["记录表"] 为 记录表
  设 计次表 为 任务册["计次表"]
  设 计次表[类别] 为 序号
  设 任务册["计次表"] 为 计次表
  返回 标识

# =====================================================================
# list：调用者可见的快照表（jobs-local L192-197）
#   无归属任务人人可见；有归属任务仅同会话可见
# =====================================================================
段落 列出快照 接收 任务册, 调用者:
  设 结果 为 []
  设 记录表 为 任务册["记录表"]
  遍历 记录 之 字典值列表(记录表):
    设 归属 为 记录["owner"]
    如果 归属 == 空:
      列表追加(结果, 造快照(记录))
    否则:
      如果 归属 == 调用者:
        列表追加(结果, 造快照(记录))
  返回 结果

# =====================================================================
# read：产出投影 + 终态标记 reported（jobs-local L205-213）
#   非终态且无 readOutput 钩子 → 空串；终态 → 记录产出（空则空串）并标 reported
# =====================================================================
段落 读取产出 接收 任务册, 标识, 调用者:
  设 记录 为 定位记录(任务册, 标识)
  设 占位 为 校验归属(记录, 调用者)
  设 文本 为 ""
  如果 判终态(记录["status"]):
    设 结果串 为 记录["output"]
    如果 结果串 != 空:
      设 文本 为 结果串
    设 记录["reported"] 为 真
  返回 ["text": 文本, "snapshot": 造快照(记录)]

# =====================================================================
# kill 状态迁移与返回码（jobs-local L215-228）
#   终态  → reported=true，返回 "already-finished"，不迁状态
#   非终态 → status=stopping，reported=true，返回 "requested"
#   （原版 cancel 先行、抛错则生命周期与通知状态均不变；本纯逻辑版以「先判终态、
#     再整体迁移」保持同样的「要么全变、要么不变」原子性）
# =====================================================================
段落 执行终止 接收 任务册, 标识, 调用者:
  设 记录 为 定位记录(任务册, 标识)
  设 占位 为 校验归属(记录, 调用者)
  如果 判终态(记录["status"]):
    设 记录["reported"] 为 真
    返回 "already-finished"
  设 记录["status"] 为 "stopping"
  设 记录["reported"] 为 真
  返回 "requested"

# =====================================================================
# settle 首胜结算（jobs-local L416-428）
#   已终态 → 直接返回当前快照（first-wins，丢弃迟到结算）
#   否则写入 status/detail/output/finishedAt；若有人在等则标 reported
# =====================================================================
段落 结算任务 接收 任务册, 标识, 阶段, 详情, 结果串, 完成时刻:
  设 记录 为 定位记录(任务册, 标识)
  如果 判终态(记录["status"]):
    返回 造快照(记录)
  设 记录["status"] 为 阶段
  设 记录["detail"] 为 详情
  设 记录["output"] 为 结果串
  设 记录["finishedAt"] 为 完成时刻
  如果 记录["waiters"] > 0:
    设 记录["reported"] 为 真
  返回 造快照(记录)

# 等待者进出记账（jobs-local L240/244-246/273-275 的 waiters 增减）
段落 记入等待者 接收 任务册, 标识:
  设 记录 为 定位记录(任务册, 标识)
  设 记录["waiters"] 为 记录["waiters"] + 1
  设 计次 为 记录["waiters"]
  返回 计次

段落 移出等待者 接收 任务册, 标识:
  设 记录 为 定位记录(任务册, 标识)
  设 计次 为 记录["waiters"] - 1
  如果 计次 < 0:
    设 计次 为 0
  设 记录["waiters"] 为 计次
  返回 计次

# =====================================================================
# wait 时限校验（jobs-local L233-235）
#   必须 Number.isFinite 且 > 0，否则抛；错误信息用 JSON.stringify 口径
# =====================================================================
段落 校验等待时限 接收 毫秒:
  如果 判有限正数(毫秒) == 假:
    抛出 新建 错误("invalid wait timeout: expected a positive number of milliseconds, got " + 序列化JSON(毫秒))
  返回 真

# 等待结局三态判定（jobs-local L257-269 的 abort 分支判定）
#   到达期限（deadline 到期）优先于信号中止 → "timeout"（resolve，返回快照，任务存活）
#   仅信号中止（caller 取消）          → "aborted"（reject，抛 'wait aborted'）
#   二者皆无                          → "settled"（任务在等待期间结算）
段落 判定等待结局 接收 信号中止, 到达期限:
  如果 到达期限 == 真: 返回 "timeout"
  如果 信号中止 == 真: 返回 "aborted"
  返回 "settled"

# 推演一次 wait（纯逻辑总入口，覆盖 jobs-local L230-279 全部状态路径）
#   入参：标识 / 时限 / 调用者 / 信号中止（caller 已取消）/ 到达期限（deadline 到期）/
#         结算阶段（等待期间任务结算到的终态；空=未结算）
#   返回：["结局": "settled"|"timeout", "快照": 快照]
#   抛错：时限非法（invalid wait timeout…）；caller 取消（wait aborted）
#   状态副作用：
#     - 进入前已终态：不等待，直接标 reported，结局 settled
#     - 非终态 + 信号中止：抛 wait aborted（不进等待者、不改状态）
#     - 非终态 + 到达期限：waiters 进出各一次，状态与 reported 均不变，结局 timeout
#     - 非终态 + 到期同时结算：结局 timeout，但任务已终态 → reported 置真
#     - 非终态 + 结算：waiters>0 期间结算 → reported 置真，结局 settled
段落 推演等待 接收 任务册, 标识, 时限, 调用者, 信号中止, 到达期限, 结算阶段:
  设 占位 为 校验等待时限(时限)
  设 记录 为 定位记录(任务册, 标识)
  设 占位 为 校验归属(记录, 调用者)
  设 结局 为 "settled"
  如果 判终态(记录["status"]) == 假:
    设 结局 为 判定等待结局(信号中止, 到达期限)
    如果 结局 == "aborted":
      抛出 新建 错误("wait aborted")
    设 占位 为 记入等待者(任务册, 标识)
    如果 结算阶段 != 空:
      设 结算后 为 结算任务(任务册, 标识, 结算阶段, 空, 空, 0)
    设 占位 为 移出等待者(任务册, 标识)
  如果 判终态(记录["status"]):
    设 记录["reported"] 为 真
  返回 ["结局": 结局, "快照": 造快照(记录)]

# =====================================================================
# tool-jobs 插件配置与预算（tool-jobs L205-222）
# =====================================================================

# 合法投递方式：wakeup（闲置 owner 上开一轮）/ quiet（只注入，等别的唤醒）
段落 校验投递方式 接收 投递方式:
  如果 投递方式 == "quiet": 返回 真
  如果 投递方式 == "wakeup": 返回 真
  抛出 新建 错误("tool-jobs: invalid completionDelivery " + 序列化JSON(投递方式))

# 配置自检（tool-jobs L215-222）
#   1) waitTimeoutMs 不得超过 maxWaitTimeoutMs
#   2) maxConsecutiveWakes 必须是「整轮数」的安全整数（Infinity/小数都不行）
段落 校验插件配置 接收 等待默认, 等待上限, 唤醒预算:
  如果 等待默认 > 等待上限:
    抛出 新建 错误("tool-jobs: waitTimeoutMs (" + 序列化JSON(等待默认) + ") exceeds maxWaitTimeoutMs (" + 序列化JSON(等待上限) + ")")
  如果 判安全整数(唤醒预算) == 假:
    抛出 新建 错误("tool-jobs: maxConsecutiveWakes (" + 序列化JSON(唤醒预算) + ") must be a whole number of turns")
  返回 真

# 单次 wait 的时限取定（tool-jobs L333）：min(timeout_ms ?? waitDefault, waitCap)
#   要求时限为 空（模型未给）→ 取配置默认；再被硬上限压住
段落 约束等待时限 接收 要求时限, 等待默认, 等待上限:
  设 取定 为 等待默认
  如果 要求时限 != 空:
    设 取定 为 要求时限
  如果 取定 > 等待上限:
    返回 等待上限
  返回 取定

# 归属已用唤醒轮数（tool-jobs L293 spentWakes.get(owner) ?? 0）
段落 查唤醒次数 接收 已用表, 归属:
  如果 字典包含键(已用表, 归属) == 假: 返回 0
  设 已用 为 已用表[归属]
  返回 已用

# 投递判定（tool-jobs L294）：wakeup + 闲置 + 预算未耗尽 → followup；否则 inject
段落 判定投递 接收 投递方式, 闲着, 已用, 唤醒预算:
  如果 投递方式 != "wakeup": 返回 "inject"
  如果 闲着 == 假: 返回 "inject"
  如果 已用 >= 唤醒预算: 返回 "inject"
  返回 "followup"

# 记入一次唤醒：命中 followup 才扣预算（tool-jobs L294-298）
#   返回 ["投递": "followup"|"inject", "已用": 记入后的已用轮数]
段落 记入唤醒 接收 已用表, 归属, 唤醒预算, 投递方式, 闲着:
  设 已用 为 查唤醒次数(已用表, 归属)
  设 投递 为 判定投递(投递方式, 闲着, 已用, 唤醒预算)
  如果 投递 == "followup":
    设 已用表[归属] 为 已用 + 1
  设 余后 为 查唤醒次数(已用表, 归属)
  返回 ["投递": 投递, "已用": 余后]

# 重置连续唤醒预算（tool-jobs L226-229）：人类输入被认领时清空该归属计数
段落 重置唤醒 接收 已用表, 归属:
  如果 字典包含键(已用表, 归属):
    设 已用表[归属] 为 0
  返回 查唤醒次数(已用表, 归属)

