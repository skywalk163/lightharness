# 抓取策略.light —— 本地 HTTP(S) 抓取提供方的 URL 校验与内容类型分类纯逻辑核心
# 对齐原版 packages/web/web-fetch-http/src/policy.ts（"pure, network-free half"）
#
# 已剔除：decoderForCharset（依赖 TextDecoder，纯光明无编码库，不可移植——已登记缺口）。
# 近似说明（已文档化）：validateFetchUrl 原版依赖宿主 `new URL()` 做严格解析（含 IPv6 括号、
# 主机名小写化、百分号解码、默认端口归一）。纯光明无 URL 类，此处以「scheme://authority[/path]」
# 手工切分等价复刻其四条判定：长度上限、协议白名单、authority 非空、authority 内无 @（凭据）。
# parseCharset 原版用正则 `;\s*charset\s*=\s*"?([^";]+)"?`；此处以字符扫描复刻，
# \s 近似为 空格/制表/换行/回车（光明无 \s 元字符，且 匹配正则 不返回捕获组）。
#
# 语言坑规避：函数用 接收；变量名避 字典/映射；布尔链用多行块（L-043）；缺键用 字典包含键 守卫（L-036）。

从 字符串工具 导入 去除首尾空白

# 取 MIME 主类型：去掉首个分号后的参数、去首尾空白、转小写（等价 replace(/;.*$/s,'').trim().toLowerCase()）
段落 取MIME 接收 内容类型:
  如果 内容类型 == 空: 返回 ""
  设 原 为 内容类型
  设 分号 为 查找子串(原, ";")
  如果 分号 >= 0:
    设 原 为 截取(原, 0, 分号)
  设 原 为 去除首尾空白(原)
  返回 原.转小写()

# 把响应 Content-Type 归类为可解码体类型；不支持（如二进制）返回 空（等价 undefined）
段落 分类内容类型 接收 内容类型:
  设 mime 为 取MIME(内容类型)
  如果 mime == "text/html" 或 mime == "application/xhtml+xml":
    返回 "html"
  如果 mime.开头("text/"):
    返回 "text"
  如果 mime == "application/json" 或 mime == "application/xml":
    返回 "text"
  如果 mime.结尾("+json") 或 mime.结尾("+xml"):
    返回 "text"
  返回 空

# 空白字符判定（近似正则 \s）
段落 是空白字符 接收 c:
  如果 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r":
    返回 真
  返回 假

# 从 Content-Type 抽出 charset 参数值（去首尾空白 + 转小写）；未声明返回 空（等价 undefined）
段落 解析字符集 接收 内容类型:
  如果 内容类型 == 空:
    返回 空
  设 s 为 内容类型.转小写()
  设 n 为 字符串长度(s)
  设 i 为 0
  当 i < n:
    如果 字符串获取(s, i) == ";":
      设 j 为 i + 1
      当 j < n 且 是空白字符(字符串获取(s, j)):
        设 j 为 j + 1
      # 该分号后是否紧跟 charset（大小写已统一）
      设 标记 为 "charset"
      设 标记长 为 字符串长度(标记)
      设 k 为 0
      设 匹配 为 真
      当 k < 标记长:
        如果 j + k >= n 或 字符串获取(s, j + k) != 字符串获取(标记, k):
          设 匹配 为 假
          跳出
        设 k 为 k + 1
      如果 匹配:
        设 j 为 j + 标记长
        当 j < n 且 是空白字符(字符串获取(s, j)):
          设 j 为 j + 1
        如果 j < n 且 字符串获取(s, j) == "=":
          设 j 为 j + 1
          当 j < n 且 是空白字符(字符串获取(s, j)):
            设 j 为 j + 1
          如果 j < n 且 字符串获取(s, j) == "\"":
            设 j 为 j + 1
          设 末 为 j
          当 末 < n 且 字符串获取(s, 末) != ";" 且 字符串获取(s, 末) != "\"":
            设 末 为 末 + 1
          如果 末 > j:
            设 值 为 去除首尾空白(截取(s, j, 末))
            返回 值.转小写()
    设 i 为 i + 1
  返回 空

# 两 URL 同源判定：scheme + hostname + port 全等。入参为已解析结构（字典键 protocol/hostname/port）
段落 比较同源 接收 甲, 乙:
  如果 甲["protocol"] != 乙["protocol"]:
    返回 假
  如果 甲["hostname"] != 乙["hostname"]:
    返回 假
  如果 甲["port"] != 乙["port"]:
    返回 假
  返回 真

# 抓取 URL 卫生校验：长度上限 → 可解析 → 协议白名单 → 禁止内嵌凭据
# 返回已解析结构 {protocol, hostname, port}（port 为空串表示默认端口，与原版 URL.port 一致）
段落 校验抓取地址 接收 输入, 最大长度:
  如果 字符串长度(输入) > 最大长度:
    抛出 新建 错误("URL exceeds the maximum length")
  设 分隔 为 查找子串(输入, "://")
  如果 分隔 < 0:
    抛出 新建 错误("invalid URL")
  设 协议 为 截取(输入, 0, 分隔 + 1)
  如果 协议 != "http:" 且 协议 != "https:":
    抛出 新建 错误("unsupported URL scheme")
  设 余 为 截取(输入, 分隔 + 3, 字符串长度(输入))
  设 斜杠 为 查找子串(余, "/")
  设 权威 为 余
  如果 斜杠 >= 0:
    设 权威 为 截取(余, 0, 斜杠)
  如果 字符串长度(权威) == 0:
    抛出 新建 错误("invalid URL")
  如果 查找子串(权威, "@") >= 0:
    抛出 新建 错误("credentials in URLs are not allowed")
  设 主机名 为 权威
  设 端口 为 ""
  设 冒号 为 查找子串(权威, ":")
  如果 冒号 >= 0:
    设 主机名 为 截取(权威, 0, 冒号)
    设 端口 为 截取(权威, 冒号 + 1, 字符串长度(权威))
  返回 ["protocol": 协议, "hostname": 主机名, "port": 端口]
# ============ 非公网 IP 字面量判定（对齐 network.ts isNonPublicIpLiteral） ============
# 对标点：packages/web/web-fetch-http/src/network.ts —— isNonPublicIpLiteral(hostname) =
#   isIP(剥括号) != 0 且 !isPublicIpAddress()；语义：IP 字面量无需 DNS 解析，代理/直连会
#   精确命中回环或私网服务，公网校验只放行公网地址。
# 光明无 node:net isIP / ipaddr.js，以下以字符扫描近似判定面（IPv4 点分四段 0-255、
# IPv6 冒号+十六进制形态；无正则捕获组，判定为近似，注释已说明）。
# 宿主网络动作（dns.lookup/pinning/NAT64 探测）维持「已剔除（宿主网络层）」登记不变。

# 去 IPv6 方括号：仅当 以[开头 且 以]结尾 才剥（对齐 stripIpv6Brackets）
段落 剥IPv6括号 接收 主机名:
  如果 主机名.开头("[") 且 主机名.结尾("]"):
    返回 截取(主机名, 1, 字符串长度(主机名) - 1)
  返回 主机名

# 单字符 0-9 判定（光明无正则字符类，用显式比较）
段落 是数字字符 接收 c:
  如果 c == "0" 或 c == "1" 或 c == "2" 或 c == "3" 或 c == "4" 或 c == "5" 或 c == "6" 或 c == "7" 或 c == "8" 或 c == "9":
    返回 真
  返回 假

# 单字符十六进制判定（IPv6 段用）
段落 是十六进制字符 接收 c:
  如果 是数字字符(c) 或 c == "a" 或 c == "b" 或 c == "c" 或 c == "d" 或 c == "e" 或 c == "f" 或 c == "A" 或 c == "B" 或 c == "C" 或 c == "D" 或 c == "E" 或 c == "F":
    返回 真
  返回 假

# 十进制段 0-255 判定（1~3 位数字，值不越界）
段落 是0到255 接收 段:
  设 n 为 字符串长度(段)
  如果 n == 0 或 n > 3:
    返回 假
  设 i 为 0
  当 i < n:
    如果 是数字字符(字符串获取(段, i)) == 假:
      返回 假
    设 i 为 i + 1
  设 v 为 整数(段)
  返回 v >= 0 且 v <= 255

# IPv4 字面量：恰好四点分隔、每段 0-255（近似 node:net isIP）
段落 是IPv4字面量 接收 地址:
  设 n 为 字符串长度(地址)
  设 点计数 为 0
  设 段起点 为 0
  设 i 为 0
  当 i <= n:
    如果 i == n 或 字符串获取(地址, i) == ".":
      如果 是0到255(截取(地址, 段起点, i)) == 假:
        返回 假
      如果 i < n:
        设 点计数 为 点计数 + 1
      设 段起点 为 i + 1
    否则:
      如果 是数字字符(字符串获取(地址, i)) == 假:
        返回 假
    设 i 为 i + 1
  返回 点计数 == 3

# IPv6 字面量（近似）：含冒号，且其余字符为 十六进制 或 点（IPv4 嵌入段）；无正则捕获组，
# 不校验段数与压缩形态（注释说明近似 node:net isIP 的 IPv6 判定）
段落 是IPv6字面量 接收 地址:
  设 有冒号 为 假
  设 i 为 0
  当 i < 字符串长度(地址):
    设 c 为 字符串获取(地址, i)
    如果 c == ":":
      设 有冒号 为 真
    否则 如果 是十六进制字符(c) == 假 且 c != ".":
      返回 假
    设 i 为 i + 1
  返回 有冒号

# IP 字面量判定（含剥括号；等价 isIP(剥括号) != 0）
段落 是IP字面量 接收 主机名:
  设 地址 为 剥IPv6括号(主机名)
  如果 是IPv4字面量(地址):
    返回 真
  如果 是IPv6字面量(地址):
    返回 真
  返回 假

# IPv4 分解为数值段表（调用方保证已是合法 IPv4 字面量）
段落 分解IPv4 接收 地址:
  设 段表 为 []
  设 起点 为 0
  设 i 为 0
  当 i <= 字符串长度(地址):
    如果 i == 字符串长度(地址) 或 字符串获取(地址, i) == ".":
      段表.追加(整数(截取(地址, 起点, i)))
      设 起点 为 i + 1
    设 i 为 i + 1
  返回 段表

# IPv4 公网判定：拒绝 0/8、10/8、100.64/10、127/8、169.254/16、172.16/12、
# 192.0.0.0/24、192.168/16、198.18/15、224/4、240/4（含 0.0.0.0）；其余公网
段落 IPv4是否公网 接收 段表:
  设 a 为 段表[0]
  设 b 为 段表[1]
  设 c 为 段表[2]
  如果 a == 0:
    返回 假
  如果 a == 10:
    返回 假
  如果 a == 100 且 b >= 64 且 b <= 127:
    返回 假
  如果 a == 127:
    返回 假
  如果 a == 169 且 b == 254:
    返回 假
  如果 a == 172 且 b >= 16 且 b <= 31:
    返回 假
  如果 a == 192 且 b == 0 且 c == 0:
    返回 假
  如果 a == 192 且 b == 168:
    返回 假
  如果 a == 198 且 (b == 18 或 b == 19):
    返回 假
  如果 a >= 224 且 a <= 239:
    返回 假
  如果 a >= 240:
    返回 假
  返回 真

# IPv6 公网判定（近似）：拒绝 ::/128、::1/128、::ffff:0:0/96（IPv4 映射）、
# fc00::/7、fe80::/10、ff00::/8；其余公网。前缀判定用前导字符近似（注释说明）
段落 IPv6是否公网 接收 地址:
  设 a 为 地址.转小写()
  如果 a == "::" 或 a == "::1":
    返回 假
  如果 a.开头("::ffff:"):
    返回 假
  如果 a.开头("fc") 或 a.开头("fd"):
    返回 假
  如果 a.开头("fe8") 或 a.开头("fe9") 或 a.开头("fea") 或 a.开头("feb"):
    返回 假
  如果 a.开头("ff"):
    返回 假
  返回 真

# 地址是否公网：IPv4 按段判定、IPv6 按前缀判定；非 IP 字面量（域名）→ 真
# （本函数只判字面量，域名交给 DNS 校验）
段落 IP是否公网 接收 地址:
  设 剥 为 剥IPv6括号(地址)
  如果 是IPv4字面量(剥):
    设 段表 为 分解IPv4(剥)
    返回 IPv4是否公网(段表)
  如果 是IPv6字面量(剥):
    返回 IPv6是否公网(剥)
  返回 真

# 主机是否非公网字面量（等价 isNonPublicIpLiteral）：是IP字面量 且 非公网 → 真
段落 主机是否非公网字面量 接收 主机名:
  设 剥 为 剥IPv6括号(主机名)
  如果 是IP字面量(剥) == 假:
    返回 假
  返回 IP是否公网(剥) == 假
