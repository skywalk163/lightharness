# 会话轮次大纲.light —— session-turn-outline 纯逻辑移植（对齐上游 packages/session/session-turn-outline）
#
# 第 12 轮任务2（会话投影域）：移植上游 turn-outline 的纯逻辑面：
#   types.ts        → 轮次大纲条目/状态形状（空大纲常量）
#   projection.ts   → 预览文本 preview() / 折叠 apply(state, event) / 视图 view(state)
# 剔除：Cordis 插件壳（name/inject/apply 注册）、zod schema、SessionSeq 类型、
#       sessionProjections 注册与 identity-gated 语义化变更流。
#
# 折叠语义（对齐上游 projection.ts）：
#   turn/start        开新条目 {turn, seq, prompt:"", response:""}；轮次不递增时忽略（返回原状态）
#   user/message      仅来源 kind=user 且末条 prompt 为空；预览提示（上限50）写入末条
#   assistant/message 仅写草稿（预览回答，上限120）；不动 turns 引用
#   turn/end          草稿提交到末条 response 并清空 draft；草稿为空时不动作
#   preview(): 文本块才计入；任一块长 >= 上限*2 视为未读完并停止追加；拼接后若超 上限-1
#              则截断加 "…"，未读完且未截断时也补 "…"
#
# 光明命名：变量名避用「映射」（保留字）；方法调用用 .追加()。

从 字符串工具 导入 去除首尾空白

段落 列表取(列表, i):
  设 计数 为 0
  遍历 元素 之 列表:
    如果 计数 == i: 返回 元素
    设 计数 为 计数 + 1
  返回 空

段落 追加项(列表, 项):
  设 结果 为 []
  遍历 元素 之 列表:
    结果.追加(元素)
  结果.追加(项)
  返回 结果

段落 替换末项(列表, 新项):
  设 结果 为 []
  设 计数 为 0
  设 总 为 列表长度(列表)
  遍历 元素 之 列表:
    如果 计数 < 总 - 1:
      结果.追加(元素)
    设 计数 为 计数 + 1
  结果.追加(新项)
  返回 结果

# ---------- 限量常量（对齐 projection.ts 顶部常量） ----------

段落 提示预览上限():
  返回 50

段落 回答预览上限():
  返回 120

# ---------- 预览（对齐 projection.ts 的 preview） ----------

段落 预览文本收集(内容, 上限):
  设 文本 为 ""
  如果 内容 == 空: 返回 {"文本": "", "未读完": 假}
  如果 是列表(内容) == 假: 返回 {"文本": "", "未读完": 假}
  遍历 块 之 内容:
    如果 是字典(块) 且 字典包含键(块, "type") 且 块["type"] == "text":
      如果 字典包含键(块, "text") 且 是字符串(块["text"]):
        设 块文 为 块["text"]
        如果 字符串长度(块文) >= 上限 * 2:
          返回 {"文本": 文本, "未读完": 真}
        如果 文本 == "":
          设 文本 为 块文
        否则:
          设 文本 为 文本 + " " + 块文
  返回 {"文本": 文本, "未读完": 假}

段落 预览文本(内容, 上限):
  设 收集 为 预览文本收集(内容, 上限)
  设 规整 为 去除首尾空白(收集["文本"])
  如果 字符串长度(规整) > 上限 - 1:
    返回 去除首尾空白(截取(规整, 0, 上限 - 1)) + "…"
  如果 收集["未读完"] == 真:
    返回 规整 + "…"
  返回 规整

# ---------- 折叠（对齐 projection.ts 的 apply） ----------

段落 空大纲():
  返回 {"turns": [], "draft": ""}

段落 轮次大纲折叠(状态, 事件):
  设 类型 为 事件["type"]
  如果 类型 == "turn/start":
    设 轮次 为 事件["data"]["turn"]
    设 序号 为 事件["seq"]
    设 尾 为 列表取(状态["turns"], 列表长度(状态["turns"]) - 1)
    如果 尾 != 空 且 轮次 <= 尾["turn"]: 返回 状态
    设 新项 为 {"turn": 轮次, "seq": 序号, "prompt": "", "response": ""}
    返回 {"turns": 追加项(状态["turns"], 新项), "draft": ""}
  如果 类型 == "user/message":
    设 数据 为 事件["data"]
    如果 字典包含键(数据, "source") == 假: 返回 状态
    如果 数据["source"]["kind"] != "user": 返回 状态
    设 尾 为 列表取(状态["turns"], 列表长度(状态["turns"]) - 1)
    如果 尾 == 空 或 尾["prompt"] != "": 返回 状态
    设 提示 为 预览文本(数据["content"], 提示预览上限())
    如果 提示 == "": 返回 状态
    设 静默 为 {"turn": 尾["turn"], "seq": 尾["seq"], "prompt": 提示, "response": 尾["response"]}
    返回 {"turns": 替换末项(状态["turns"], 静默), "draft": 状态["draft"]}
  如果 类型 == "assistant/message":
    设 数据 为 事件["data"]
    设 草稿 为 预览文本(数据["message"]["content"], 回答预览上限())
    如果 草稿 == "" 或 草稿 == 状态["draft"]: 返回 状态
    返回 {"turns": 状态["turns"], "draft": 草稿}
  如果 类型 == "turn/end":
    如果 状态["draft"] == "": 返回 状态
    设 尾 为 列表取(状态["turns"], 列表长度(状态["turns"]) - 1)
    如果 尾 == 空 或 尾["response"] == 状态["draft"]:
      返回 {"turns": 状态["turns"], "draft": ""}
    设 静默 为 {"turn": 尾["turn"], "seq": 尾["seq"], "prompt": 尾["prompt"], "response": 状态["draft"]}
    返回 {"turns": 替换末项(状态["turns"], 静默), "draft": ""}
  返回 状态

段落 轮次大纲视图(状态):
  返回 状态["turns"]

段落 轮次大纲定义():
  返回 {"key": "turnOutline", "stateVersion": 2, "stateSchema": "轮次大纲状态", "viewSchema": "轮次大纲条目表"}