# 远程mock.light —— test-support/remote-mock 纯逻辑复刻（第52轮 任务2，对标 #189 面）
#
# 上游（只读）：G:\github\deepseek-harness（ea53423b60 = 0.1.6-alpha.1）
#   packages/test-support/remote-mock/src/remote-mock.ts（RemoteMock/RemoteTable/ok/OpenStreams）
#   packages/test-support/remote-mock/src/streams.ts（StreamScript/frames/openStream/MockStream/toError）
#   packages/test-support/remote-mock/src/log.ts（MockLogStore：calls/streams/requests/unmatched）
#
# 对齐口径（纯逻辑化，剔除的宿主面在「已登记偏差」）：
#   - vitest spy（unaryMocks/streamMocks 的调用计数面）→ 剔除，日志即观测面；
#   - Promise/AsyncIterable/AbortSignal → 同步步进状态机：读取 返回
#     {态: "值"/"完"/"败"/"挂起"}，挂起时交付「信箱」（首格引用），推送/定局直接填信箱；
#   - remote-proxy（命名空间代理）→ 剔除（纯语法糖），端点显式注册/派发；
#   - localStorage/随机UUID 等 → 不涉及。
#
# 语义对齐要点（逐条对应上游）：
#   - 无规则的一元派发：记 未匹配（不记调用），抛 MissingUnaryRule 消息（含已注册端点表）；
#   - 函数规则同步抛：记调用且状态=失败、结果=错误，再抛（toError 包装非 Error 值）；
#   - open 无脚本：记 未匹配（不记流），抛；有脚本 → 记流(open) + live + 跑脚本
#     （脚本抛错 → 流失败）；
#   - 推入：非 open 忽略；已推计数；有等待者直达信箱，否则入队；
#   - 读取：队列首 → 值；定局 end → 完；定局 fail → 败；已取消 → 完；
#     已有等待者 → 抛「stream has one consumer」；否则挂起并登记信箱；
#   - 结束/失败：仅 open 态生效；取消：open → cancelled + 清队 + 信箱完（清队总是执行）；
#   - 排空判定：队空 且（有等待者 或 状态非 open）；
#   - 装载顺序：一元 → 流声明（无脚本声明保留既有脚本）→ 流脚本；
#   - 模式：脚本表（含空脚本声明）→ 流；一元表 → 一元；否则 空（未注册按一元派发）；
#   - 事件端点（$events）：ready 帧 {type, clientId: mock-client-<代>, host}，代数递增；
#   - 活流控制（push/end/fail）：只作用于 open 态，返回命中数量；live 遗忘
#     「非 open 且队列空」的流；
#   - 载荷解包：{args: 数组} → 数组；{args: 对象} → [对象]；否则 TypeError 消息。
#
# ⚠️ 命名纪律：布尔链拆成顺序如果；段名避开关键字词根（匹配/回调/继续/事件 等）；
#    字面量单行；「拟」为本模块前缀域。

# =====================================================================
# 信封与错误
# =====================================================================

# ok(value)：Remote 调用方读到的成功信封
段落 造成功信封(值):
  返回 {"ok": 真, "value": 值}

# toError(reason)：抛出值 → Error（本身是错误字典则原样，否则字符串化包装）
段落 造规范错误(缘由):
  如果 是字典(缘由):
    如果 字典获取(缘由, "name", 空) == "Error":
      返回 缘由
  返回 {"name": "Error", "message": 转字符串(缘由)}

# =====================================================================
# 流脚本（StreamScript）：函数型（接收 (参数, 句柄)）或 步骤表型
# =====================================================================

# frames(items)：推出全部项后结束
段落 造帧脚本(项表):
  返回 {"种类": "帧", "项表": 项表}

# openStream(initial)：推出初始项后保持开放（等待活流控制）
段落 造开放脚本(初始表 = []):
  返回 {"种类": "开放", "初始表": 初始表}

# =====================================================================
# MockStream：一步进状态机（队列 + 定局 + 单消费者等待者）
# =====================================================================

# 造拟流 接收 记录（日志流条目）：{队列, 定局, 等待者, 取消}
段落 造拟流(记录):
  返回 {"队列": [], "定局": 空, "等待者": 空, "取消": 假, "记录": 记录}

# 已排队数（queued）
段落 拟流排队数(流):
  返回 长(流["队列"])

# 推入（push）：非 open 忽略；有等待者直达信箱，否则入队
段落 拟流推入(流, 项):
  如果 流["记录"]["状态"] != "open":
    返回 流
  字典设置(流["记录"], "已推", 流["记录"]["已推"] + 1)
  如果 流["等待者"] != 空:
    设 信箱 为 流["等待者"]
    字典设置(流, "等待者", 空)
    字典设置(信箱, 0, {"值": 项, "完": 假})
    返回 流
  列表追加(流["队列"], 项)
  返回 流

# 结束（end）
段落 拟流结束(流):
  返回 拟流定局(流, {"种类": "end"}, "ended")

# 失败（fail）
段落 拟流失败(流, 错误):
  返回 拟流定局(流, {"种类": "fail", "错误": 错误}, "failed")

# settle：仅 open 态生效；定局 + 状态迁移 + 等待者信箱直达
段落 拟流定局(流, 定局, 新状态):
  如果 流["记录"]["状态"] != "open":
    返回 流
  字典设置(流["记录"], "状态", 新状态)
  字典设置(流, "定局", 定局)
  如果 流["等待者"] != 空:
    设 信箱 为 流["等待者"]
    字典设置(流, "等待者", 空)
    如果 定局["种类"] == "end":
      字典设置(信箱, 0, {"完": 真})
    否则:
      字典设置(信箱, 0, {"败": 定局["错误"]})
  返回 流

# 读取（next 的同步步进）：值 / 完 / 败 / 挂起（登记信箱）
#   信箱是首格引用列表 [空]：后续 推入/结束/失败/取消 把结果填进 信箱[0]。
段落 拟流读取(流):
  如果 长(流["队列"]) > 0:
    设 首 为 流["队列"][0]
    设 余表 为 []
    设 序 为 1
    当 序 < 长(流["队列"]):
      列表追加(余表, 流["队列"][序])
      设 序 为 序 + 1
    字典设置(流, "队列", 余表)
    返回 {"态": "值", "值": 首}
  如果 流["取消"] == 真:
    返回 {"态": "完"}
  如果 流["定局"] != 空:
    如果 流["定局"]["种类"] == "end":
      返回 {"态": "完"}
    返回 {"态": "败", "错误": 流["定局"]["错误"]}
  如果 流["等待者"] != 空:
    抛出 新建 错误("remote-mock: " + 流["记录"]["端点"] + " stream has one consumer")
  设 信箱 为 [空]
  字典设置(流, "等待者", 信箱)
  返回 {"态": "挂起", "信箱": 信箱}

# 排空判定（drained）：队空 且（有等待者 或 状态非 open）
段落 拟流排空否(流):
  如果 长(流["队列"]) > 0:
    返回 假
  如果 流["等待者"] != 空:
    返回 真
  返回 流["记录"]["状态"] != "open"

# 取消（消费者提前退场 / 源信号中止）：open → cancelled；清队总是执行
段落 拟流取消(流):
  如果 流["记录"]["状态"] == "open":
    字典设置(流["记录"], "状态", "cancelled")
    字典设置(流, "取消", 真)
    如果 流["等待者"] != 空:
      设 信箱 为 流["等待者"]
      字典设置(流, "等待者", 空)
      字典设置(信箱, 0, {"完": 真})
  字典设置(流, "队列", [])
  返回 流

# 跑脚本：函数型脚本 直调；步骤表型 按序执行（脚本抛错 → 流失败）
段落 拟流跑脚本(流, 脚本, 参数):
  如果 是字典(脚本):
    如果 脚本["种类"] == "帧":
      遍历 项 之 脚本["项表"]:
        拟流推入(流, 项)
      拟流结束(流)
      返回 流
    如果 脚本["种类"] == "开放":
      遍历 项 之 脚本["初始表"]:
        拟流推入(流, 项)
      返回 流
  尝试:
    脚本(参数, 流)
  捕获 异常:
    拟流失败(流, 造规范错误(异常))
  返回 流

# =====================================================================
# MockLogStore：日志与观测面
# =====================================================================

段落 造拟真日志:
  返回 {"调用表": [], "流表": [], "未匹配表": [], "序号": 0}

段落 日志下一序号(日志):
  设 序 为 日志["序号"]
  字典设置(日志, "序号", 序 + 1)
  返回 序

# 记一元调用（规则被选中时记录；返回可变条目由派发方结算）
段落 日志记调用(日志, 端点, 参数):
  设 条目 为 {"端点": 端点, "参数": 参数, "状态": "pending", "结果": 空, "序号": 日志下一序号(日志)}
  列表追加(日志["调用表"], 条目)
  返回 条目

# 记流开放
段落 日志记流(日志, 端点, 参数):
  设 条目 为 {"端点": 端点, "参数": 参数, "状态": "open", "已推": 0, "序号": 日志下一序号(日志)}
  列表追加(日志["流表"], 条目)
  返回 条目

# 记未匹配请求
段落 日志记未匹配(日志, 端点, 方式):
  列表追加(日志["未匹配表"], {"端点": 端点, "方式": 方式})
  返回 日志

# calls(endpoint?)：老序在前
段落 日志调用(日志, 端点 = 空):
  如果 端点 == 空:
    返回 日志["调用表"]
  设 结果 为 []
  遍历 条目 之 日志["调用表"]:
    如果 条目["端点"] == 端点:
      列表追加(结果, 条目)
  返回 结果

# streams(endpoint?)
段落 日志流(日志, 端点 = 空):
  如果 端点 == 空:
    返回 日志["流表"]
  设 结果 为 []
  遍历 条目 之 日志["流表"]:
    如果 条目["端点"] == 端点:
      列表追加(结果, 条目)
  返回 结果

# requests(endpoint?)：一元调用与流开放的首参表；无端点时剔除 $ 前缀端点
段落 日志请求(日志, 端点 = 空):
  设 结果 为 []
  遍历 条目 之 日志["调用表"]:
    日志请求收集(结果, 条目, 端点)
  遍历 条目 之 日志["流表"]:
    日志请求收集(结果, 条目, 端点)
  返回 结果

段落 日志请求收集(结果, 条目, 端点):
  如果 端点 != 空:
    如果 条目["端点"] != 端点:
      返回 结果
  否则:
    如果 开头(条目["端点"], "$") == 真:
      返回 结果
  如果 长(条目["参数"]) > 0:
    列表追加(结果, 条目["参数"][0])
  返回 结果

# unmatched()
段落 日志未匹配(日志):
  返回 日志["未匹配表"]

# =====================================================================
# RemoteMock：端点命名的 Remote 拟真
# =====================================================================

段落 造远程拟真:
  返回 {"一元表": {}, "脚本表": {}, "活流": [], "日志": 造拟真日志(), "事件代": 0}

# unary(endpoint, rule)：规则 = 值 或 函数（同步版无 pending 结算期）
段落 拟真一元(拟, 端点, 规则):
  字典设置(拟["一元表"], 端点, 规则)
  返回 拟

# stream(endpoint, script?)：声明为流；无脚本声明保留既有脚本
段落 拟真流声明(拟, 端点, 脚本 = 空):
  如果 脚本 != 空:
    字典设置(拟["脚本表"], 端点, 脚本)
    返回 拟
  如果 字典包含键(拟["脚本表"], 端点) == 假:
    字典设置(拟["脚本表"], 端点, 空)
  返回 拟

# load(table)：一元 → 流声明 → 流脚本（顺序对齐上游）
段落 拟真装载(拟, 表):
  如果 字典包含键(表, "unary") == 真:
    遍历 端点 之 字典键列表(表["unary"]):
      拟真一元(拟, 端点, 表["unary"][端点])
  如果 字典包含键(表, "streams") == 真:
    遍历 端点 之 表["streams"]:
      拟真流声明(拟, 端点, 空)
  如果 字典包含键(表, "stream") == 真:
    遍历 端点 之 字典键列表(表["stream"]):
      拟真流声明(拟, 端点, 表["stream"][端点])
  返回 拟

# modeOf(endpoint)
段落 拟真模式(拟, 端点):
  如果 字典包含键(拟["脚本表"], 端点):
    返回 "stream"
  如果 字典包含键(拟["一元表"], 端点):
    返回 "unary"
  返回 空

# registered 端点有序表（稳定插入序；上游为字典序，测试域内等价可读）
段落 拟真端点表(拟):
  设 名表 为 []
  遍历 端点 之 字典键列表(拟["脚本表"]):
    如果 列表包含(名表, 端点) == 假:
      列表追加(名表, 端点)
  遍历 端点 之 字典键列表(拟["一元表"]):
    如果 列表包含(名表, 端点) == 假:
      列表追加(名表, 端点)
  返回 端点有序化(名表)

# 字典序插入（避开「排序」命名）
段落 端点有序化(表):
  设 结果 为 []
  遍历 名 之 表:
    设 插位 为 长(结果)
    设 序 为 0
    当 序 < 长(结果):
      如果 结果[序] > 名:
        设 插位 为 序
        设 序 为 长(结果)
      否则:
        设 序 为 序 + 1
    列表插入(结果, 插位, 名)
  返回 结果

# 无规则消息（noRuleMessage）
段落 无规则消息(拟, 端点):
  返回 "remote-mock: no rule for " + 端点 + "; registered: " + 连接串(拟真端点表(拟), ", ")

段落 连接串(表, 分隔):
  设 结果 为 ""
  设 序 为 0
  遍历 项 之 表:
    如果 序 > 0:
      设 结果 为 结果 + 分隔
    设 结果 为 结果 + 项
    设 序 为 序 + 1
  返回 结果

# 规则应答（unaryAnswer 纯化）：无规则 → 未匹配 + MissingUnaryRule（不记调用）；
# 函数规则 → 直调（同步抛上抛，由派发方记 failed）；值规则 verbatim（含显式 空）
段落 拟真一元应答(拟, 端点, 参数):
  如果 字典包含键(拟["一元表"], 端点) == 假:
    日志记未匹配(拟["日志"], 端点, "unary")
    抛出 新建 错误(无规则消息(拟, 端点))
  设 规则 为 拟["一元表"][端点]
  如果 type(规则) == type(造规范错误):
    返回 规则(参数)
  返回 规则

# dispatch（同步纯化）：无规则 → miss + 抛（不记调用）；有规则 → 记调用并结算：
# 规则同步抛 → 状态=失败、结果=规范错误、再抛（对齐上游 answerOf 转 rejection 的单路径结算）
段落 拟真派发(拟, 端点, 参数):
  如果 字典包含键(拟["一元表"], 端点) == 假:
    日志记未匹配(拟["日志"], 端点, "unary")
    抛出 新建 错误(无规则消息(拟, 端点))
  设 条目 为 日志记调用(拟["日志"], 端点, 参数)
  尝试:
    设 应答 为 拟真一元应答(拟, 端点, 参数)
  捕获 异常:
    字典设置(条目, "状态", "failed")
    字典设置(条目, "结果", 造规范错误(异常))
    抛出 新建 错误(转字符串(造规范错误(异常)))
  字典设置(条目, "状态", "answered")
  字典设置(条目, "结果", 应答)
  返回 应答

# open：无脚本 → miss + 抛（不记流）；有脚本 → 记流 + 造拟流 + 跑脚本
段落 拟真开放(拟, 端点, 参数):
  如果 字典包含键(拟["脚本表"], 端点) == 假:
    日志记未匹配(拟["日志"], 端点, "stream")
    抛出 新建 错误(无规则消息(拟, 端点))
  设 脚本 为 拟["脚本表"][端点]
  如果 脚本 == 空:
    日志记未匹配(拟["日志"], 端点, "stream")
    抛出 新建 错误(无规则消息(拟, 端点))
  设 记录 为 日志记流(拟["日志"], 端点, 参数)
  设 流 为 造拟流(记录)
  列表追加(拟["活流"], 流)
  拟流跑脚本(流, 脚本, 参数)
  返回 流

# 活流筛选（matching）：遗忘「非 open 且队空」的流，再按端点过滤
段落 活流筛选(拟, 端点):
  设 留表 为 []
  遍历 流 之 拟["活流"]:
    如果 流["记录"]["状态"] == "open":
      列表追加(留表, 流)
    否则:
      如果 拟流排队数(流) > 0:
        列表追加(留表, 流)
  字典设置(拟, "活流", 留表)
  设 命中 为 []
  遍历 流 之 拟["活流"]:
    如果 流["记录"]["端点"] == 端点:
      列表追加(命中, 流)
  返回 命中

# OpenStreams.push / end / fail：只作用 open 态，返回命中数量
段落 活流逐个推入(拟, 端点, 项):
  设 数 为 0
  遍历 流 之 活流筛选(拟, 端点):
    如果 流["记录"]["状态"] == "open":
      拟流推入(流, 项)
      设 数 为 数 + 1
  返回 数

段落 活流逐个结束(拟, 端点):
  设 数 为 0
  遍历 流 之 活流筛选(拟, 端点):
    如果 流["记录"]["状态"] == "open":
      拟流结束(流)
      设 数 为 数 + 1
  返回 数

段落 活流逐个失败(拟, 端点, 错误):
  设 数 为 0
  遍历 流 之 活流筛选(拟, 端点):
    如果 流["记录"]["状态"] == "open":
      拟流失败(流, 错误)
      设 数 为 数 + 1
  返回 数

# 载荷解包（argsOf）：{args: 数组} | {args: 对象} | TypeError
段落 拟真参数解包(端点, 载荷):
  如果 是字典(载荷):
    如果 字典包含键(载荷, "args"):
      设 参数 为 载荷["args"]
      如果 是列表(参数):
        返回 参数
      如果 是字典(参数):
        返回 [参数]
  抛出 新建 错误("remote-mock: payload of " + 端点 + " must be { args: unknown[] | object }")

# assertNoUnmatched：无未匹配静默；否则抛清单消息
段落 拟真断言无未匹配(拟):
  设 未匹配 为 日志未匹配(拟["日志"])
  如果 长(未匹配) == 0:
    返回 真
  设 行表 为 []
  遍历 条目 之 未匹配:
    列表追加(行表, "  " + 条目["端点"] + " (" + 条目["方式"] + ")")
  抛出 新建 错误("remote-mock: " + 转字符串(长(未匹配)) + " unmatched request(s):\n" + 连接串(行表, "\n") + "\nregistered: " + 连接串(拟真端点表(拟), ", "))

# RemoteMock.create：$events 流以 ready 帧应答后保持开放（代数递增）
段落 造事件拟真(宿主 = 空):
  设 拟 为 造远程拟真()
  设 宿主事实 为 宿主
  如果 宿主事实 == 空:
    设 宿主事实 为 {"home": "/home/mock"}
  段落 事件脚本(参数, 句柄):
    设 代 为 拟["事件代"] + 1
    字典设置(拟, "事件代", 代)
    拟流推入(句柄, {"type": "ready", "clientId": "mock-client-" + 转字符串(代), "host": 宿主事实})
    返回 空
  拟真流声明(拟, "$events", 事件脚本)
  返回 拟

# =====================================================================
# 【R87-B4】test-support 0.1.7 增量纯逻辑
# 对标源：
#   packages/test-support/remote-mock/src/streams.ts（HandleUplink 上行队列状态机）
#   packages/test-support/session-snapshot/src/normalize.ts（cwd 拼法展开 + 记录钟归零）
# 锚点：877717787c
# 宿主面剔除：AsyncIterator/Promise/AbortController、regex（UUID/spill path 扫描）、
#   prepareSessionSnapshotFixtureForComparison、redactSessionSnapshotIds、JSON 逐行序列化。
# =====================================================================

# ---- HandleUplink（streams.ts:178）：脚本侧上行队列（send 推入 / end 半关 / close 清仓）----
# 同步步进状态机：items 队列 + done 半关 + 单消费者等待者信箱（首格引用，对齐 拟流 范式）。
段落 造上行:
  返回 {"项表": [], "完": 假, "等待者": 空}

段落 上行读一步(上行):
  如果 长(上行["项表"]) > 0:
    设 首 为 上行["项表"][0]
    设 余表 为 []
    设 序 为 1
    当 序 < 长(上行["项表"]):
      列表追加(余表, 上行["项表"][序])
      设 序 为 序 + 1
    字典设置(上行, "项表", 余表)
    返回 {"态": "值", "值": 首}
  如果 上行["完"] == 真:
    返回 {"态": "完"}
  设 信箱 为 [空]
  字典设置(上行, "等待者", 信箱)
  返回 {"态": "挂起", "信箱": 信箱}

段落 上行推入(上行, 项):
  如果 上行["完"] == 真:
    抛出 新建 错误("remote-mock: uplink was ended")
  设 等待者 为 上行["等待者"]
  字典设置(上行, "等待者", 空)
  如果 等待者 == 空:
    列表追加(上行["项表"], 项)
  否则:
    字典设置(等待者, 0, {"值": 项, "完": 假})
  返回 上行

段落 上行结束(上行):
  如果 上行["完"] == 真:
    返回 上行
  字典设置(上行, "完", 真)
  设 等待者 为 上行["等待者"]
  字典设置(上行, "等待者", 空)
  如果 等待者 != 空:
    字典设置(等待者, 0, {"完": 真})
  返回 上行

段落 上行关闭(上行):
  字典设置(上行, "项表", [])
  返回 上行结束(上行)

# ---- normalize.ts:123 cwdSpellings：去重非空拼法 + mac /private 别名，最长优先 ----
段落 列cwd拼法(上下文):
  设 原始 为 []
  如果 字典包含键(上下文, "cwd") == 真:
    如果 上下文["cwd"] != 空:
      如果 字符串长度(上下文["cwd"]) > 0: 列表追加(原始, 上下文["cwd"])
  如果 字典包含键(上下文, "cwdAliases") == 真:
    如果 上下文["cwdAliases"] != 空:
      遍历 拼法 之 上下文["cwdAliases"]:
        如果 拼法 != 空:
          如果 字符串长度(拼法) > 0: 列表追加(原始, 拼法)
  # 去重
  设 见 为 {}
  设 唯一 为 []
  遍历 拼法 之 原始:
    如果 字典包含键(见, 拼法) == 假:
      字典设置(见, 拼法, 真)
      列表追加(唯一, 拼法)
  # mac 别名：以 / 开头但不以 /private/ 开头 → 加 /private 前缀
  设 扩表 为 []
  遍历 拼法 之 唯一:
    列表追加(扩表, 拼法)
    如果 开头(拼法, "/") == 真:
      如果 开头(拼法, "/private/") == 假:
        设 别名 为 "/private" + 拼法
        如果 字典包含键(见, 别名) == 假:
          字典设置(见, 别名, 真)
          列表追加(扩表, 别名)
  # 最长优先选择排序（降序）
  设 总数 为 长(扩表)
  设 外 为 0
  当 外 < 总数:
    设 最大 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 字符串长度(扩表[内]) > 字符串长度(扩表[最大]):
        设 最大 为 内
      设 内 为 内 + 1
    如果 最大 != 外:
      设 临 为 扩表[外]
      设 扩表[外] 为 扩表[最大]
      设 扩表[最大] 为 临
    设 外 为 外 + 1
  返回 扩表

# ---- normalize.ts 记录钟归零（normalizeSessionLog 的类型分支，作用于已解析字典）----
# 包块行类型集合（PACKED_CHUNK_ROW_TYPES）
段落 是包块行(记录):
  如果 字典包含键(记录, "type") == 假: 返回 假
  设 t 为 记录["type"]
  如果 t == "text-chunks": 返回 真
  如果 t == "reasoning-chunks": 返回 真
  如果 t == "tool-call-chunks": 返回 真
  返回 假

段落 是数值(值):
  如果 是整数(值) == 真: 返回 真
  返回 是浮点(值)

段落 归零流成员(成员):
  如果 字典包含键(成员, "time") == 真:
    如果 是数值(成员["time"]) == 真: 字典设置(成员, "time", 0)
  如果 字典包含键(成员, "time0") == 真:
    如果 是数值(成员["time0"]) == 真: 字典设置(成员, "time0", 0)
  如果 字典包含键(成员, "dt") == 真:
    如果 是列表(成员["dt"]) == 真:
      设 新dt 为 []
      设 k 为 0
      当 k < 长(成员["dt"]):
        列表追加(新dt, 0)
        设 k 为 k + 1
      字典设置(成员, "dt", 新dt)
  返回 成员

段落 归零记录钟(记录):
  设 t 为 记录["type"]
  如果 t == "session":
    如果 字典包含键(记录, "createdAt") == 真: 字典设置(记录, "createdAt", 0)
    返回 记录
  如果 是包块行(记录) == 真:
    如果 字典包含键(记录, "time0") == 真: 字典设置(记录, "time0", 0)
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "dt") == 真:
          如果 是列表(数据["dt"]) == 真:
            设 新dt 为 []
            设 k 为 0
            当 k < 长(数据["dt"]):
              列表追加(新dt, 0)
              设 k 为 k + 1
            字典设置(数据, "dt", 新dt)
    返回 记录
  如果 字典包含键(记录, "time") == 真:
    字典设置(记录, "time", 0)
  如果 t == "assistant/message" 或 t == "assistant/attempt":
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "stream") == 真:
          如果 是列表(数据["stream"]) == 真:
            遍历 成员 之 数据["stream"]:
              如果 是字典(成员) == 真: 归零流成员(成员)
  如果 t == "hook/result":
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "durationMs") == 真: 字典设置(数据, "durationMs", 0)
  如果 t == "feedback/message-put":
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "item") == 真:
          设 项 为 数据["item"]
          如果 是字典(项) == 真:
            如果 字典包含键(项, "createdAt") == 真: 字典设置(项, "createdAt", 0)
            如果 字典包含键(项, "updatedAt") == 真: 字典设置(项, "updatedAt", 0)
  如果 t == "goal/change":
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "createdAt") == 真: 字典设置(数据, "createdAt", 0)
        如果 字典包含键(数据, "updatedAt") == 真: 字典设置(数据, "updatedAt", 0)
  如果 t == "subagent/catalog":
    如果 字典包含键(记录, "data") == 真:
      设 数据 为 记录["data"]
      如果 是字典(数据) == 真:
        如果 字典包含键(数据, "childCreatedAt") == 真: 字典设置(数据, "childCreatedAt", 0)
  返回 记录

# ---- normalize.ts:262 normalizeStdout 的稳定 id 序号表（首见序 1,2,3…）----
段落 造稳定id表:
  返回 {"表": {}, "序号": 0}

段落 稳定id(序号表, 键):
  如果 字典包含键(序号表["表"], 键) == 真:
    返回 序号表["表"][键]
  字典设置(序号表, "序号", 序号表["序号"] + 1)
  字典设置(序号表["表"], 键, 序号表["序号"])
  返回 序号表["序号"]
