# 类型系统.light —— 第14轮 任务5：typert generator + protocol 纯逻辑面复刻
#
# 上游：packages/typert/protocol/src/{index.ts, types.ts, remote-error.ts}（协议：段语法 + 结构化远端错误）
#       packages/typert/generator/src/{model.ts, renderer.ts, emitter.ts}（IR 模型 / 渲染 / 发射）
#       packages/typert/generator/src/analyzer.ts（声明级形状，**简化**：只做声明头提取，不做完整 TS 解析）
#
# 复刻面（纯逻辑）：
#   §1 协议：段语法（isTypertRemoteSegment）、方法枚举、请求/响应/通知/错误消息形状、
#      消息 id（req_ + 整数）、JSON 行序列化/解析、结构化远端错误识别（remoteErrorOf 结构标记）
#   §2 类型 IR：类型节点（primitive/literal/union/intersection/array/tuple/object/function/reference）、
#      符号、作用域（父链查找）
#   §3 结构相等 + 可赋值性（简化子类型：any/never/unknown、字面量→原语、联合、数组、引用、对象结构）
#   §4 分析器：分词 + 声明头提取（种类/名称/形参/继承/实现/修饰符/文档）+ 符号表 + 重复符号检测
#   §5 渲染器：节点→类型串（union 用 ` | `、array 用 `[]`、object 用 `{ m; }`）、签名、符号→声明文本、JSDoc
#   §6 发射器：头注释 + 仅导出公开 + 按名排序 + 尾部换行
#
# 宿主面剔除登记（未移植）：cordis-catalog.ts（Cordis 目录扫描/服务注入）、tsdown-plugin.ts（构建钩子）、
#   workspace.ts（文件系统扫描/tsconfig 解析）、analyzer.ts 的 TS compiler/checker 依赖与完整 AST 遍历、
#   emitter 的 zod schema 发射与 Remote .d.ts 生成、protocol 的 decorator/Service 绑定。
#
# 任务书扩展登记（上游无对应，按 §复刻范围 实现，见交付报告）：方法枚举 analyze/render/emit/listSymbols、
#   消息 kind 词汇、声明文件头之外的简化发射流程；上游 protocol 为类型级 + decorator，无运行时 RPC 消息构造。
#
# 命名避坑：标识符不用「为」「类型」「事件」「接收」「包含」「输出」「空」「返回」「映射」「父」等词根（L-084/L-004）。

从 JSON 导入 序列化JSON, 解析JSON
从 字符串工具 导入 去除首尾空白

# =====================================================================
# §0 通用读取与字符判定
# =====================================================================

段落 取字段(表, 键表, 默认值):
  如果 type(表) != dict:
    返回 默认值
  遍历 键 之 键表:
    如果 字典包含键(表, 键):
      返回 表[键]
  返回 默认值

段落 有字段(表, 键表):
  如果 type(表) != dict:
    返回 假
  遍历 键 之 键表:
    如果 字典包含键(表, 键):
      返回 真
  返回 假

段落 是词符(c):
  如果 c >= "a" 且 c <= "z":
    返回 真
  如果 c >= "A" 且 c <= "Z":
    返回 真
  如果 c >= "0" 且 c <= "9":
    返回 真
  如果 c == "_" 或 c == "$":
    返回 真
  返回 假

段落 是空白符(c):
  如果 c == " " 或 c == "\t" 或 c == "\n" 或 c == "\r":
    返回 真
  返回 假

# 段语法字符（上游 TYPERT_REMOTE_SEGMENT_PATTERN 的 [A-Za-z0-9_$.-]）
段落 是段字符(c):
  如果 是词符(c):
    返回 真
  如果 c == "." 或 c == "-":
    返回 真
  返回 假

段落 定位子串(文本, 子串):
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 i
    设 i 为 i + 1
  返回 -1

# =====================================================================
# §1 协议（上游 protocol：段语法 + 消息形状 + 结构化远端错误）
# =====================================================================

设 方法枚举 为 ["analyze", "render", "emit", "listSymbols"]

段落 是合法方法(方法):
  遍历 项 之 方法枚举:
    如果 项 == 方法:
      返回 真
  返回 假

# 上游 isTypertRemoteSegment：非 "." / ".." 且逐字符落在段字母表
段落 是合法远程段(值):
  如果 type(值) != str:
    返回 假
  如果 值 == "." 或 值 == "..":
    返回 假
  如果 字符串长度(值) == 0:
    返回 假
  设 i 为 0
  设 n 为 字符串长度(值)
  当 i < n:
    如果 是段字符(字符串获取(值, i)) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

# 消息 id：req_ 前缀 + 整数（与第11轮 JSONRPC 同范式）
段落 造消息ID(序号):
  返回 "req_" + 转字符串(序号)

段落 造请求(标识, 方法, 参数):
  如果 是合法方法(方法) == 假:
    抛出 新建 错误("unknown typert method: " + 转字符串(方法))
  返回 {"id": 标识, "kind": "request", "method": 方法, "params": 参数}

段落 造响应(标识, 结果):
  返回 {"id": 标识, "kind": "response", "result": 结果}

段落 造错误响应(标识, 码, 消息):
  返回 {"id": 标识, "kind": "error", "error": {"code": 码, "message": 消息}}

段落 造通知(方法, 参数):
  如果 是合法方法(方法) == 假:
    抛出 新建 错误("unknown typert method: " + 转字符串(方法))
  返回 {"kind": "notification", "method": 方法, "params": 参数}

段落 序列化消息(消息):
  返回 序列化JSON(消息)

段落 解析消息(文本):
  返回 解析JSON(文本)

# 上游 RemoteError：结构标记（isDSHRemoteError === true 且 code 为字符串），不靠 instanceof
段落 造远程错误(码, 消息, 明细):
  设 结果 为 {}
  结果["isDSHRemoteError"] 为 真
  结果["name"] 为 "RemoteError"
  结果["code"] 为 码
  结果["message"] 为 消息
  结果["details"] 为 明细
  返回 结果

段落 是远程错误(值):
  如果 type(值) != dict:
    返回 假
  如果 取字段(值, ["isDSHRemoteError"], 假) != 真:
    返回 假
  如果 type(取字段(值, ["code"], 空)) != str:
    返回 假
  返回 真

# =====================================================================
# §2 类型 IR（上游 model.ts 的简化：节点 / 符号 / 作用域）
# =====================================================================

段落 造节点(种类, 字段):
  设 节点 为 {"种类": 种类}
  如果 type(字段) == dict:
    遍历 键 之 字段:
      节点[键] 为 字段[键]
  返回 节点

段落 造原语(名):
  返回 造节点("primitive", {"名称": 名})

段落 造字面量(文本, 原语名):
  返回 造节点("literal", {"文本": 文本, "原语": 原语名})

段落 造联合(成员表):
  返回 造节点("union", {"成员": 成员表})

段落 造交叉(成员表):
  返回 造节点("intersection", {"成员": 成员表})

段落 造数组(元素):
  返回 造节点("array", {"元素": 元素})

段落 造元组(元素表):
  返回 造节点("tuple", {"元素": 元素表})

段落 造属性成员(名, 节点, 可选, 只读):
  返回 {"种类": "property", "名称": 名, "节点": 节点, "可选": 可选, "只读": 只读}

段落 造方法成员(名, 参数表, 返回节点):
  返回 {"种类": "method", "名称": 名, "参数": 参数表, "返回": 返回节点, "可选": 假, "只读": 假}

段落 造对象(成员表):
  返回 造节点("object", {"成员": 成员表})

段落 造函数(参数表, 返回节点):
  返回 造节点("function", {"参数": 参数表, "返回": 返回节点})

段落 造引用(名, 参数表):
  返回 造节点("reference", {"名称": 名, "参数": 参数表})

段落 造作用域(上作用域, 符号表, 节点表):
  返回 {"上": 上作用域, "符号": 符号表, "节点": 节点表}

段落 作用域注册(域, 名, 值):
  设 内 为 域["符号"]
  内[名] 为 值
  返回 真

# 沿父链向上查找（上游 scope.parent 链）
段落 作用域查找(域, 名):
  设 游标 为 域
  当 游标 != 空:
    设 内 为 游标["符号"]
    如果 字典包含键(内, 名):
      返回 内[名]
    设 游标 为 游标["上"]
  返回 空

# =====================================================================
# §3 结构相等与可赋值性
# =====================================================================

段落 节点表相等(甲表, 乙表):
  如果 长(甲表) != 长(乙表):
    返回 假
  设 i 为 0
  当 i < 长(甲表):
    如果 节点相等(甲表[i], 乙表[i]) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

段落 按名找成员(成员表, 名):
  遍历 成员 之 成员表:
    如果 取字段(成员, ["名称"], "") == 名:
      返回 成员
  返回 空

段落 参数表相等(甲表, 乙表):
  如果 长(甲表) != 长(乙表):
    返回 假
  设 i 为 0
  当 i < 长(甲表):
    如果 取字段(甲表[i], ["名称"], "") != 取字段(乙表[i], ["名称"], ""):
      返回 假
    如果 节点相等(取字段(甲表[i], ["节点"], {}), 取字段(乙表[i], ["节点"], {})) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

段落 成员相等(甲, 乙):
  如果 取字段(甲, ["种类"], "property") != 取字段(乙, ["种类"], "property"):
    返回 假
  如果 取字段(甲, ["可选"], 假) != 取字段(乙, ["可选"], 假):
    返回 假
  如果 取字段(甲, ["只读"], 假) != 取字段(乙, ["只读"], 假):
    返回 假
  如果 取字段(甲, ["种类"], "property") == "method":
    如果 节点相等(取字段(甲, ["返回"], {}), 取字段(乙, ["返回"], {})) == 假:
      返回 假
    返回 参数表相等(取字段(甲, ["参数"], []), 取字段(乙, ["参数"], []))
  返回 节点相等(取字段(甲, ["节点"], {}), 取字段(乙, ["节点"], {}))

段落 成员表相等(甲表, 乙表):
  如果 长(甲表) != 长(乙表):
    返回 假
  遍历 甲成员 之 甲表:
    设 乙成员 为 按名找成员(乙表, 取字段(甲成员, ["名称"], ""))
    如果 乙成员 == 空:
      返回 假
    如果 成员相等(甲成员, 乙成员) == 假:
      返回 假
  返回 真

# 结构相等（上游 renderer 依赖的 graph 一致性；此处按节点形状递归）
段落 节点相等(甲, 乙):
  设 甲种 为 取字段(甲, ["种类"], "")
  设 乙种 为 取字段(乙, ["种类"], "")
  如果 甲种 != 乙种:
    返回 假
  如果 甲种 == "primitive":
    返回 取字段(甲, ["名称"], "") == 取字段(乙, ["名称"], "")
  如果 甲种 == "literal":
    如果 取字段(甲, ["文本"], "") != 取字段(乙, ["文本"], ""):
      返回 假
    返回 取字段(甲, ["原语"], "") == 取字段(乙, ["原语"], "")
  如果 甲种 == "union" 或 甲种 == "intersection":
    返回 节点表相等(取字段(甲, ["成员"], []), 取字段(乙, ["成员"], []))
  如果 甲种 == "array":
    返回 节点相等(取字段(甲, ["元素"], {}), 取字段(乙, ["元素"], {}))
  如果 甲种 == "tuple":
    返回 节点表相等(取字段(甲, ["元素"], []), 取字段(乙, ["元素"], []))
  如果 甲种 == "reference":
    如果 取字段(甲, ["名称"], "") != 取字段(乙, ["名称"], ""):
      返回 假
    返回 节点表相等(取字段(甲, ["参数"], []), 取字段(乙, ["参数"], []))
  如果 甲种 == "function":
    如果 节点相等(取字段(甲, ["返回"], {}), 取字段(乙, ["返回"], {})) == 假:
      返回 假
    返回 参数表相等(取字段(甲, ["参数"], []), 取字段(乙, ["参数"], []))
  如果 甲种 == "object":
    返回 成员表相等(取字段(甲, ["成员"], []), 取字段(乙, ["成员"], []))
  # 未覆盖的节点种类（简化 IR 之外）：退化为 JSON 形状比较（同种类才走到这里）
  # ⚠️ L-116：`序列化JSON` 保留插入序、不做键排序，与 `字典 ==`（键序无关）语义不一致 ——
  #    该回退对「同构但键构造顺序不同」的节点会判不等。本模块所有节点都经 造节点/造原语 等
  #    同一条构造路径产生，键序天然一致，故在此可用；跨来源比较须先做键规范化
  #    （见 examples/_repro_L116.light 绕法②）。
  如果 type(甲) != dict 或 type(乙) != dict:
    返回 假
  返回 序列化JSON(甲) == 序列化JSON(乙)

段落 任一可赋值(源, 成员表):
  遍历 成员 之 成员表:
    如果 可赋值(源, 成员) == 真:
      返回 真
  返回 假

段落 全部可赋值(成员表, 目标):
  遍历 成员 之 成员表:
    如果 可赋值(成员, 目标) == 假:
      返回 假
  返回 真

段落 表逐项可赋值(源表, 目标表):
  如果 长(源表) != 长(目标表):
    返回 假
  设 i 为 0
  当 i < 长(源表):
    如果 可赋值(源表[i], 目标表[i]) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

段落 对象可赋值(源, 目标):
  遍历 目成员 之 取字段(目标, ["成员"], []):
    设 源成员 为 按名找成员(取字段(源, ["成员"], []), 取字段(目成员, ["名称"], ""))
    如果 源成员 == 空:
      返回 假
    如果 可赋值(取字段(源成员, ["节点"], {}), 取字段(目成员, ["节点"], {})) == 假:
      返回 假
  返回 真

# 简化子类型（源 → 目标）
段落 可赋值(源, 目标):
  如果 节点相等(源, 目标):
    返回 真
  设 源种 为 取字段(源, ["种类"], "")
  设 目标种 为 取字段(目标, ["种类"], "")
  如果 目标种 == "primitive":
    设 目名 为 取字段(目标, ["名称"], "")
    如果 目名 == "any" 或 目名 == "unknown":
      返回 真
  如果 源种 == "primitive":
    设 源名 为 取字段(源, ["名称"], "")
    如果 源名 == "never":
      返回 真
    如果 目标种 == "primitive":
      如果 源名 == "any" 或 源名 == "unknown":
        返回 真
  如果 源种 == "literal" 且 目标种 == "primitive":
    返回 取字段(源, ["原语"], "") == 取字段(目标, ["名称"], "")
  # 源联合：每个成员都能赋给目标（必须先于目标联合判定，否则 union→union 走错支）
  如果 源种 == "union":
    返回 全部可赋值(取字段(源, ["成员"], []), 目标)
  # 目标联合：任一成员接受源
  如果 目标种 == "union":
    返回 任一可赋值(源, 取字段(目标, ["成员"], []))
  如果 源种 == "array" 且 目标种 == "array":
    返回 可赋值(取字段(源, ["元素"], {}), 取字段(目标, ["元素"], {}))
  如果 源种 == "tuple" 且 目标种 == "array":
    设 元素表 为 取字段(源, ["元素"], [])
    如果 长(元素表) == 0:
      返回 真
    设 i 为 0
    当 i < 长(元素表):
      如果 可赋值(元素表[i], 取字段(目标, ["元素"], {})) == 假:
        返回 假
      设 i 为 i + 1
    返回 真
  如果 源种 == "reference" 且 目标种 == "reference":
    如果 取字段(源, ["名称"], "") != 取字段(目标, ["名称"], ""):
      返回 假
    返回 表逐项可赋值(取字段(源, ["参数"], []), 取字段(目标, ["参数"], []))
  如果 源种 == "object" 且 目标种 == "object":
    返回 对象可赋值(源, 目标)
  返回 假

# =====================================================================
# §4 分析器（上游 analyzer.ts 的简化：声明级形状，不做完整 TS 解析）
# =====================================================================

# 分词：标识符整词 / 单个非空白符
段落 分词(文本):
  设 记号表 为 []
  设 当前 为 ""
  设 i 为 0
  设 n 为 字符串长度(文本)
  当 i < n:
    设 c 为 字符串获取(文本, i)
    如果 是空白符(c):
      如果 字符串长度(当前) > 0:
        列表追加(记号表, 当前)
        设 当前 为 ""
      设 i 为 i + 1
      跳过
    如果 是词符(c):
      设 当前 为 当前 + c
      设 i 为 i + 1
      跳过
    如果 字符串长度(当前) > 0:
      列表追加(记号表, 当前)
      设 当前 为 ""
    列表追加(记号表, c)
    设 i 为 i + 1
  如果 字符串长度(当前) > 0:
    列表追加(记号表, 当前)
  返回 记号表

段落 记号下标(记号表, 目标):
  设 i 为 0
  遍历 记号 之 记号表:
    如果 记号 == 目标:
      返回 i
    设 i 为 i + 1
  返回 -1

段落 取记号(记号表, 下标):
  如果 下标 < 0 或 下标 >= 长(记号表):
    返回 ""
  返回 记号表[下标]

段落 声明种类(记号表):
  遍历 记号 之 记号表:
    如果 记号 == "class":
      返回 "class"
    如果 记号 == "interface":
      返回 "interface"
    如果 记号 == "enum":
      返回 "enum"
    如果 记号 == "type":
      返回 "alias"
    如果 记号 == "function":
      返回 "function"
  返回 "unknown"

段落 取声明名(记号表, 种类):
  设 键 为 种类
  如果 种类 == "alias":
    设 键 为 "type"
  设 下标 为 记号下标(记号表, 键)
  如果 下标 < 0:
    返回 ""
  返回 取记号(记号表, 下标 + 1)

# 从 起 处跳过平衡的 <...>，返回其后下标
段落 跳过尖括号(记号表, 起):
  如果 取记号(记号表, 起) != "<":
    返回 起
  设 i 为 起 + 1
  设 深 为 1
  当 i < 长(记号表):
    设 记号 为 记号表[i]
    如果 记号 == "<":
      设 深 为 深 + 1
    如果 记号 == ">":
      设 深 为 深 - 1
      如果 深 == 0:
        返回 i + 1
    设 i 为 i + 1
  返回 i

# 泛型形参名：< 之后的首词，及每个逗号后的首词
段落 取形参表(记号表):
  设 起 为 记号下标(记号表, "<")
  如果 起 < 0:
    返回 []
  设 结果 为 []
  设 i 为 起 + 1
  设 待 为 真
  当 i < 长(记号表):
    设 记号 为 记号表[i]
    如果 记号 == ">":
      跳出
    如果 记号 == ",":
      设 待 为 真
      设 i 为 i + 1
      跳过
    如果 待:
      列表追加(结果, 记号)
      设 待 为 假
    设 i 为 i + 1
  返回 结果

# 从 起点 起找关键字，收集其后到 { / implements / ; 之前的名字表
段落 取关键字后名(记号表, 关键字, 起点):
  设 i 为 起点
  当 i < 长(记号表):
    如果 记号表[i] == 关键字:
      设 结果 为 []
      设 j 为 i + 1
      当 j < 长(记号表):
        设 记号 为 记号表[j]
        如果 记号 == "{" 或 记号 == "implements" 或 记号 == ";":
          返回 结果
        如果 记号 == ",":
          设 j 为 j + 1
          跳过
        列表追加(结果, 记号)
        设 j 为 j + 1
      返回 结果
    设 i 为 i + 1
  返回 []

段落 按行拆(文本):
  设 行表 为 []
  设 当前 为 ""
  设 i 为 0
  设 n 为 字符串长度(文本)
  当 i < n:
    设 c 为 字符串获取(文本, i)
    如果 c == "\n":
      列表追加(行表, 当前)
      设 当前 为 ""
    否则:
      设 当前 为 当前 + c
    设 i 为 i + 1
  列表追加(行表, 当前)
  返回 行表

段落 剥前导星(行):
  设 s 为 去除首尾空白(行)
  当 字符串长度(s) > 0 且 字符串获取(s, 0) == "*":
    设 s 为 去除首尾空白(截取(s, 1, 字符串长度(s)))
  返回 s

# JSDoc 首行摘要
段落 取文档描叙(文本):
  设 起 为 定位子串(文本, "/**")
  如果 起 < 0:
    返回 ""
  设 止 为 定位子串(文本, "*/")
  如果 止 < 0 或 止 <= 起:
    返回 ""
  设 体 为 截取(文本, 起 + 3, 止)
  遍历 行 之 按行拆(体):
    设 净 为 剥前导星(行)
    如果 字符串长度(净) > 0:
      返回 净
  返回 ""

# 分析一条顶层声明文本 → 符号模型
段落 分析声明(文本, 包名):
  设 记号表 为 分词(文本)
  设 种类 为 声明种类(记号表)
  设 名 为 取声明名(记号表, 种类)
  设 名下标 为 记号下标(记号表, 名)
  设 尾起 为 跳过尖括号(记号表, 名下标 + 1)
  设 符号 为 {}
  符号["名称"] 为 名
  符号["种类"] 为 种类
  符号["包"] 为 包名
  符号["导出"] 为 记号下标(记号表, "export") >= 0
  符号["抽象"] 为 记号下标(记号表, "abstract") >= 0
  符号["只读"] 为 记号下标(记号表, "readonly") >= 0
  符号["静态"] 为 记号下标(记号表, "static") >= 0
  符号["形参"] 为 取形参表(记号表)
  符号["继承"] 为 取关键字后名(记号表, "extends", 尾起)
  符号["实现"] 为 取关键字后名(记号表, "implements", 尾起)
  符号["文档"] 为 取文档描叙(文本)
  返回 符号

段落 造符号表(包名):
  返回 {"包": 包名, "符号": {}, "顺序": []}

段落 注册符号(表, 符号):
  设 名 为 符号["名称"]
  设 内 为 表["符号"]
  如果 字典包含键(内, 名):
    抛出 新建 错误("duplicate symbol " + 名 + " in package " + 表["包"])
  内[名] 为 符号
  列表追加(表["顺序"], 名)
  返回 符号

段落 有符号(表, 名):
  返回 字典包含键(表["符号"], 名)

段落 查找符号(表, 名):
  设 内 为 表["符号"]
  如果 字典包含键(内, 名):
    返回 内[名]
  返回 空

# =====================================================================
# §5 渲染器（上游 renderer.ts）
# =====================================================================

段落 连接文本(表, 分隔):
  设 累积 为 ""
  设 首 为 真
  遍历 项 之 表:
    如果 首:
      设 累积 为 项
      设 首 为 假
    否则:
      设 累积 为 累积 + 分隔 + 项
  返回 累积

段落 连接节点(表, 分隔):
  设 段 为 []
  遍历 项 之 表:
    列表追加(段, 渲染节点(项))
  返回 连接文本(段, 分隔)

段落 需括号(节点):
  设 种类 为 取字段(节点, ["种类"], "")
  如果 种类 == "union" 或 种类 == "intersection" 或 种类 == "function":
    返回 真
  返回 假

段落 连接参数(参数表):
  设 段 为 []
  遍历 参数 之 参数表:
    设 名 为 取字段(参数, ["名称"], "")
    设 可 为 ""
    如果 取字段(参数, ["可选"], 假) == 真:
      设 可 为 "?"
    设 段一 为 名 + 可 + ": " + 渲染节点(取字段(参数, ["节点"], {}))
    列表追加(段, 段一)
  返回 连接文本(段, ", ")

段落 渲染成员(成员):
  设 名 为 取字段(成员, ["名称"], "")
  设 可 为 ""
  如果 取字段(成员, ["可选"], 假) == 真:
    设 可 为 "?"
  设 只 为 ""
  如果 取字段(成员, ["只读"], 假) == 真:
    设 只 为 "readonly "
  如果 取字段(成员, ["种类"], "property") == "method":
    返回 名 + 可 + "(" + 连接参数(取字段(成员, ["参数"], [])) + "): " + 渲染节点(取字段(成员, ["返回"], {}))
  返回 只 + 名 + 可 + ": " + 渲染节点(取字段(成员, ["节点"], {}))

段落 渲染节点(节点):
  设 种类 为 取字段(节点, ["种类"], "")
  如果 种类 == "primitive":
    返回 取字段(节点, ["名称"], "")
  如果 种类 == "literal":
    返回 取字段(节点, ["文本"], "")
  如果 种类 == "union":
    返回 连接节点(取字段(节点, ["成员"], []), " | ")
  如果 种类 == "intersection":
    返回 连接节点(取字段(节点, ["成员"], []), " & ")
  如果 种类 == "array":
    设 元素 为 渲染节点(取字段(节点, ["元素"], {}))
    如果 需括号(取字段(节点, ["元素"], {})):
      返回 "(" + 元素 + ")[]"
    返回 元素 + "[]"
  如果 种类 == "tuple":
    返回 "[" + 连接节点(取字段(节点, ["元素"], []), ", ") + "]"
  如果 种类 == "object":
    设 成员表 为 取字段(节点, ["成员"], [])
    如果 长(成员表) == 0:
      返回 "{}"
    设 段 为 []
    遍历 成员 之 成员表:
      列表追加(段, 渲染成员(成员) + ";")
    返回 "{ " + 连接文本(段, " ") + " }"
  如果 种类 == "function":
    返回 "(" + 连接参数(取字段(节点, ["参数"], [])) + ") => " + 渲染节点(取字段(节点, ["返回"], {}))
  如果 种类 == "reference":
    设 名 为 取字段(节点, ["名称"], "")
    设 实参 为 取字段(节点, ["参数"], [])
    如果 长(实参) == 0:
      返回 名
    返回 名 + "<" + 连接节点(实参, ", ") + ">"
  抛出 新建 错误("unsupported type node kind: " + 转字符串(种类))

段落 形参文本(表):
  如果 长(表) == 0:
    返回 ""
  返回 "<" + 连接文本(表, ", ") + ">"

段落 承继文本(表, 前缀):
  如果 长(表) == 0:
    返回 ""
  返回 前缀 + 连接文本(表, ", ")

段落 渲染文档(描叙):
  如果 字符串长度(描叙) == 0:
    返回 ""
  返回 "/**\n * " + 描叙 + "\n */"

# 符号 → 声明文本（上游 renderDeclaration）
段落 渲染符号(符号):
  设 种类 为 取字段(符号, ["种类"], "")
  设 名 为 取字段(符号, ["名称"], "")
  设 形参 为 形参文本(取字段(符号, ["形参"], []))
  如果 种类 == "alias":
    返回 "export type " + 名 + 形参 + " = " + 渲染节点(取字段(符号, ["节点"], {})) + ";"
  设 前 为 "export "
  如果 取字段(符号, ["抽象"], 假) == 真:
    设 前 为 "export abstract "
  设 承 为 承继文本(取字段(符号, ["继承"], []), " extends ")
  设 实 为 承继文本(取字段(符号, ["实现"], []), " implements ")
  设 行表 为 []
  列表追加(行表, 前 + 种类 + " " + 名 + 形参 + 承 + 实 + " {")
  遍历 成员 之 取字段(符号, ["成员"], []):
    列表追加(行表, "    " + 渲染成员(成员) + ";")
  列表追加(行表, "}")
  返回 连接文本(行表, "\n")

# =====================================================================
# §6 发射器（上游 emitter.ts：头注释 + 名称排序 + 尾换行）
# =====================================================================

段落 声明文件头:
  返回 "/* Generated by @deepseek-ai/dsh-typert-generator from FaceModel — do not edit. */"

段落 名比较(甲, 乙):
  如果 甲 < 乙:
    返回 -1
  如果 甲 > 乙:
    返回 1
  返回 0

# 插入排序（上游 .sort((l,r)=>l.name.localeCompare(r.name))）
段落 排序名(名表):
  设 副本 为 []
  遍历 名 之 名表:
    列表追加(副本, 名)
  设 i 为 1
  当 i < 长(副本):
    设 当值 为 副本[i]
    设 j 为 i - 1
    当 j >= 0 且 名比较(副本[j], 当值) > 0:
      设 副本[j + 1] 为 副本[j]
      设 j 为 j - 1
    设 副本[j + 1] 为 当值
    设 i 为 i + 1
  返回 副本

段落 只导出公开(表):
  设 名单 为 []
  遍历 名 之 表["顺序"]:
    设 符号 为 表["符号"][名]
    如果 取字段(符号, ["导出"], 假) == 真:
      列表追加(名单, 名)
  返回 名单

# 发射声明文件内容：头注释 + 文档注释 + 声明，按名排序，尾部换行
段落 发射声明文件(表):
  设 名单 为 排序名(只导出公开(表))
  设 行表 为 [声明文件头()]
  遍历 名 之 名单:
    设 符号 为 表["符号"][名]
    设 描叙 为 取字段(符号, ["文档"], "")
    如果 字符串长度(描叙) > 0:
      列表追加(行表, 渲染文档(描叙))
    列表追加(行表, 渲染符号(符号))
  返回 连接文本(行表, "\n") + "\n"
