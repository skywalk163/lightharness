# 会话格式.light —— Session format V3 纯逻辑（对齐原版 session-format 族，路1/S 头号工程）
#
# 覆盖上游（0.1.5-rc.2）：
#   packages/session/session-format/src/{types.ts,index.ts,json.ts,chain.ts,catalog.ts,context.ts,error.ts,filename.ts}
#   packages/session/session-format-v0-to-v1/src/{index.ts,codec.ts,dispositions.ts}
#   packages/session/session-format-v1-to-v2/src/{codec.ts,dispositions.ts,migration.ts}
#   packages/session/session-format-v2-to-v3/src/{codec.ts,migration.ts,payload.ts,references.ts,validation.ts}
#   packages/session/session-format-catalog/src/{current.ts,generated.ts,index.ts}
#   packages/core/session/src/surface.ts（§14 surface 投影：节点0投影 / 遮蔽跳过 / 表面事件数据校验）
#
# 复刻边界：纯逻辑核心（事件溯源数据模型 + 编解码 + 迁移链 + catalog）。
#   文件锁/写租约属宿主层，不移植（登记缺口）；事件词汇表为核心子集 + 关键必选键，
#   payload 校验走「必选键存在性 + 多余键拒绝」两条规则（见 校验事件载荷）。
#
# 版本语义：
#   v0/v1 物理行 = header + 事件行（assistant/chunk 压缩为打包行 runType/firstSeq/eventCount）
#   v2 物理行 = header + 事件行（seq 连续，sourceEventSeqs 可追踪）
#   v3 物理行 = v2 物理层 + 结构化行准入（canonical envelope）+ end-seed accepted cut
#   v0→v1 identity 直通；v1→v2 内嵌助手流（assistant/attempt + stream）；v2→v3 系统提示提升 + PTC 词汇
#
# ⚠️ 光明命名规范：段落/局部名避用「事件」二字开头与「事件表」同源标识符（L-004）。

从 JSON 导入 解析JSON, 序列化JSON
从 内置核心字典 导入 字典删除
# =====================================================================
# 1. 基础校验（对齐 json.ts：safeInteger / nonNegativeInteger / snapshot）
# =====================================================================
# T2-D4（任务5）：恢复边界显式拒绝负零序号，对齐上游 Object.is(value, -0)。
# 是负零 必须放在 是整数 之前：-0.0 是 float，放后面会被「must be an integer」
# 先截走，负零就得不到上游的「non-negative」语义（负零是数值域非负性违规，
# 不是整数形态违规；上游对 -0 抛的也是 non-negative safe integer）。
段落 安全整数 接收 值, 标签:
  如果 (是负零(值)):
    抛出 新建 错误("invalid " + 标签 + ": must be non-negative")
  如果 (是整数(值) == 假):
    抛出 新建 错误("invalid " + 标签 + ": must be an integer")
  如果 (值 < 0):
    抛出 新建 错误("invalid " + 标签 + ": must be non-negative")
  返回 真

段落 非负整数 接收 值, 标签:
  设 占 为 安全整数(值, 标签)  # 抑制L166
  返回 真

段落 判版本 接收 主, 次:
  设 占 为 安全整数(主, "version.major")  # 抑制L166
  设 占 为 安全整数(次, "version.minor")
  返回 ["主": 主, "次": 次]

段落 版本文本 接收 版本:
  返回 转字符串(版本["主"]) + "." + 转字符串(版本["次"])

段落 同版本 接收 左, 右:
  返回 (左["主"] == 右["主"]) 且 (左["次"] == 右["次"])

段落 版本小 接收 左, 右:
  如果 左["主"] != 右["主"]:
    返回 左["主"] < 右["主"]
  返回 左["次"] < 右["次"]

# 快照校验：对象必须是字典，且只含允许键（strict）
段落 校验快照 接收 对象, 允许键表, 标签:
  如果 (是字典(对象) == 假):
    抛出 新建 错误("invalid " + 标签 + ": expected object")
  遍历 键 之 字典键列表(对象):
    如果 (列表包含(允许键表, 键) == 假):
      抛出 新建 错误("invalid " + 标签 + ": unexpected key " + 键)
  返回 真

# =====================================================================
# 2. 事件词汇（RELEASED_V0_EVENT_DISPOSITIONS 核心子集 + V2 增量）
#    每条：{必选键表, 可选键表}
# =====================================================================
设 事件词汇表 为 {}

段落 定词汇 接收 种类, 必选表, 可选表:
  全局 事件词汇表
  设 词 为 {}
  词["必选"] 为 必选表
  词["可选"] 为 可选表
  设 表 为 事件词汇表
  表[种类] 为 词
  设 事件词汇表 为 表
  返回 词

# ---- V0 词汇（对齐 RELEASED_V0_EVENT_DISPOSITIONS）----
设 占 为 定词汇("system/prompt", ["值"], ["应加入记录"])
设 占 为 定词汇("session/created", [], ["标识"])
设 占 为 定词汇("session/start-seed", [], ["长度"])
设 占 为 定词汇("session/end-seed", ["长度"], [])
设 占 为 定词汇("user/message", ["消息"], [])
设 占 为 定词汇("assistant/chunk", ["消息", "块"], [])
设 占 为 定词汇("assistant/attempt", ["消息"], [])
设 占 为 定词汇("assistant/message", ["消息"], [])
设 占 为 定词汇("tool/call", ["名称", "输入"], ["禁用"])
设 占 为 定词汇("tool/result", ["调用", "成功"], ["消息", "错误", "输出"])
设 占 为 定词汇("todo/write", ["项表"], [])
设 占 为 定词汇("turn/start", [], [])
设 占 为 定词汇("turn/end", ["原因"], ["错误"])
设 占 为 定词汇("step/start", [], [])
设 占 为 定词汇("step/end", ["原因"], ["错误"])
设 占 为 定词汇("request/header", ["配置"], ["系统提示", "代理预设", "工具模式"])
设 占 为 定词汇("request/context", ["代理"], ["路由"])
设 占 为 定词汇("injection/message", ["消息", "来源"], ["指针"])
设 占 为 定词汇("injection/message-text", ["文本", "来源"], ["指针"])
设 占 为 定词汇("agent/added", ["代理"], [])
设 占 为 定词汇("agent/removed", ["代理"], [])
设 占 为 定词汇("agent/preempted", ["代理"], [])
设 占 为 定词汇("agent/inbox/message", ["代理", "消息"], [])
设 占 为 定词汇("agent/inbox/text", ["代理", "文本"], [])
设 占 为 定词汇("agent/inbox/spliced", ["目标", "开始", "插入"], ["移除数"])
设 占 为 定词汇("agent/memory/locked", ["代理", "记忆"], [])
设 占 为 定词汇("agent/memory/unlocked", ["代理", "记忆"], [])
设 占 为 定词汇("attachment/added", ["附件"], [])

# ---- V2 事件词汇（v1→v2 codec 新增/重命名的可变动种类）----
设 占 为 定词汇("session/surface/head", [], [])
设 占 为 定词汇("system/message", ["系统"], ["表面操作"])
设 占 为 定词汇("session/end-seed", ["长度"], [])
设 占 为 定词汇("assistant/message", ["message"], [])
设 占 为 定词汇("session/end-seed", ["length"], [])

# ---- approval 审计对（第13轮决策2 补登：interaction/user-approval，轮封闭审计事件）----
# 键名与 src/审批.light 请求审批审计 实际落盘一致（id/callId/reason 保留英文，工具名/结果 中文映射）。
设 占 为 定词汇("approval/policy", ["policy"], [])
设 占 为 定词汇("approval/asked", ["id", "工具名"], ["callId", "reason"])
设 占 为 定词汇("approval/decided", ["id", "结果"], [])

# ---- 0.1.6 增量事件（R51 任务1）：图像卸载决策 ----
# P0 硬兼容：上游 0.1.6 `2026-09-14-image-offload` 明确「不认识该事件的旧读取器拒绝读取日志」，
#   故本事件必须显式进词汇表（未知类型在严格校验下抛 unsupported event type）。
# 键名与上游 wire 形状逐字一致（targets / seq / imageIndexes，英文），保证 0.1.6 日志可读。
设 占 为 定词汇("image/offload", ["targets"], [])

# 未知事件类型是否可忽略（v2 起：不认识的事件类型保持排队直通）
段落 已知事件类型 接收 种类:
  返回 字典包含键(事件词汇表, 种类)

# 校验事件载荷（strict：必选缺失抛错、多余键抛错、未知类型抛错）
段落 校验事件载荷 接收 种类, 数据, 严格:
  如果 (已知事件类型(种类) == 假):
    抛出 新建 错误("unsupported event type " + 种类)
  设 词 为 事件词汇表[种类]
  如果 (是字典(数据) == 假):
    抛出 新建 错误("invalid payload for " + 种类 + ": expected object")
  遍历 键 之 词["必选"]:
    如果 (字典包含键(数据, 键) == 假):
      抛出 新建 错误("invalid payload for " + 种类 + ": missing required key " + 键)
  如果 严格:
    设 允许 为 []
    遍历 键 之 词["必选"]:
      列表追加(允许, 键)
    遍历 键 之 词["可选"]:
      列表追加(允许, 键)
    遍历 键 之 字典键列表(数据):
      如果 (列表包含(允许, 键) == 假):
        抛出 新建 错误("invalid payload for " + 种类 + ": unexpected key " + 键)
  返回 真

# =====================================================================
# 3. 头信息模型（SessionHeader）
# =====================================================================
# 头 = {版本, 标识, 创建时间, 工作目录?, 代理预设?, 父会话?, 是种子}
段落 造头 接收 主版本, 次版本, 标识, 创建时间, 工作目录, 代理预设, 父会话, 是种子:
  设 头 为 {}
  头["版本"] 为 ["主": 主版本, "次": 次版本]
  头["标识"] 为 标识
  头["创建时间"] 为 创建时间
  头["工作目录"] 为 工作目录
  头["代理预设"] 为 代理预设
  头["父会话"] 为 父会话
  头["是种子"] 为 是种子
  返回 头

段落 头版本号 接收 头:
  返回 版本文本(头["版本"])

段落 头版本为 接收 头, 主版本, 次版本:
  返回 (头["版本"]["主"] == 主版本) 且 (头["版本"]["次"] == 次版本)

# =====================================================================
# 4. 事件记录模型（SessionEvent）
# =====================================================================
# 事件 = {类型, 序号, 时间, 数据, 来源事件序号?}
段落 造事件 接收 种类, 序号, 时间, 数据:
  设 事件项 为 {}
  事件项["类型"] 为 种类
  事件项["序号"] 为 序号
  事件项["时间"] 为 时间
  事件项["数据"] 为 数据
  返回 事件项

段落 事件带来源 接收 事件项, 来源表:
  如果 (来源表 != 空):
    # L-082 已修复：副本 一等浅拷贝原语可用，直接快照脱钩（对齐上游 sourceEventSeqs snapshot，调用方后续改动不透传）。
    事件项["来源事件序号"] 为 副本(来源表)
  返回 事件项

# =====================================================================
# 5. V0/V1 编解码（releasedV0/V1SessionFormatCodec，物理行 = header + 事件行）
# =====================================================================
# 解码头：seedLength 字段 → 是种子（v0/v1 无代理预设/父会话字段时补默认）
段落 解码V0头 接收 行:
  设 版本值 为 行.获取("version", {})
  设 主 为 2
  设 次 为 0
  如果 是字典(版本值):
    设 主 为 版本值.获取("major", 2)
    设 次 为 版本值.获取("minor", 0)
  否则:
    设 主 为 版本值
    设 次 为 0
  设 头 为 {}
  头["版本"] 为 ["主": 主, "次": 次]
  头["标识"] 为 行["id"]
  头["创建时间"] 为 行.获取("createdAt", 0)
  设 是种子 为 假
  如果 行.包含("seedLength"):
    设 是种子 为 真
  头["是种子"] 为 是种子
  头["工作目录"] 为 行.获取("cwd", 空)
  头["代理预设"] 为 行.获取("agentPreset", 空)
  头["父会话"] 为 行.获取("parentSession", 空)
  返回 头
段落 编码V0头 接收 头:
  设 行 为 {}
  行["type"] 为 "session"
  行["version"] 为 ["major": 头["版本"]["主"], "minor": 头["版本"]["次"]]  # T2-D3：JSON 形状统一英文键（内部头模型仍 主/次；对齐上游 canonical envelope）
  行["id"] 为 头["标识"]
  行["createdAt"] 为 头["创建时间"]
  如果 (头["是种子"] == 真):
    行["seedLength"] 为 0
  如果 (头["工作目录"] != 空):
    行["cwd"] 为 头["工作目录"]
  如果 (头["代理预设"] != 空):
    行["agentPreset"] 为 头["代理预设"]
  如果 (头["父会话"] != 空):
    行["parentSession"] 为 头["父会话"]
  返回 行

# 事件行解码（v0/v1：seq 校验 + 事件类型直通）
段落 解码V0事件 接收 行, 上一序号:
  如果 (行["type"] == "assistant/chunk"):
    抛出 新建 错误("unexpected packed row in decoded form")
  设 种类 为 行["type"]
  设 数据 为 行.获取("data", {})
  设 序号 为 行.获取("seq", 上一序号 + 1)
  设 事件项 为 造事件(种类, 序号, 行.获取("time", 0), 数据)
  如果 (行.包含("sourceEventSeqs")):
    事件项["来源事件序号"] 为 行["sourceEventSeqs"]
  如果 (行.包含("redacted")) 且 行["redacted"]:
    事件项["遮蔽"] 为 真
  返回 事件项

# 压缩行解码（v0 打包 run：runType/firstSeq/eventCount + chunks 数组）
段落 解码V0打包行 接收 行, 上一序号:
  设 种类 为 行["type"]
  如果 种类 == "text-chunks" 或 种类 == "reasoning-chunks" 或 种类 == "tool-call-chunks":
    设 序号 为 行["firstSeq"]
    设 块表 为 行["chunks"]
    设 事件项 为 造事件("assistant/chunk", 序号, 行.获取("time", 0), ["消息": 行.获取("message", {}), "块": 块表])
    返回 事件项
  抛出 新建 错误("unsupported packed row type " + 种类)

# v0/v1 编解码器（共享布局，版本号不同）
段落 造V0编解码 接收 主版本:
  设 器 为 {}
  器["主版本"] 为 主版本
  器["解码头"] 为 解码V0头
  器["解码事件"] 为 解码V0事件
  器["解码打包行"] 为 解码V0打包行
  器["编码头"] 为 编码V0头
  返回 器

设 V0编解码 为 造V0编解码(0)
设 V1编解码 为 造V0编解码(1)

# =====================================================================
# 6. V2 编解码（releasedV2SessionFormatCodec，seq 连续 + sourceEventSeqs）
# =====================================================================
段落 解码V2头 接收 行:
  返回 解码V0头(行)
段落 解码V2事件 接收 行, 上一序号:
  设 种类 为 行["type"]
  如果 (种类 == "assistant/chunk"):
    抛出 新建 错误("unexpected packed row in v2 stream")
  设 序号 为 行.获取("seq", 上一序号 + 1)
  设 数据 为 行.获取("data", {})
  设 事件项 为 造事件(种类, 序号, 行.获取("time", 0), 数据)
  如果 (行.包含("sourceEventSeqs")):
    事件项["来源事件序号"] 为 行["sourceEventSeqs"]
  如果 (行.包含("redacted")) 且 行["redacted"]:
    事件项["遮蔽"] 为 真
  返回 事件项

段落 编码V2头 接收 头:
  设 行 为 编码V0头(头)
  行["version"] 为 ["major": 头["版本"]["主"], "minor": 头["版本"]["次"]]  # T2-D3：JSON 形状统一英文键（内部头模型仍 主/次；对齐上游 canonical envelope）
  返回 行

段落 编码V2事件 接收 事件项:
  设 行 为 {}
  行["type"] 为 事件项["类型"]
  行["seq"] 为 事件项["序号"]
  行["time"] 为 事件项["时间"]
  行["data"] 为 事件项["数据"]
  如果 (事件项.包含("来源事件序号")):
    行["sourceEventSeqs"] 为 事件项["来源事件序号"]
  如果 (事件项.包含("遮蔽")) 且 事件项["遮蔽"]:
    行["redacted"] 为 真
  返回 行

设 V2编解码 为 {}
V2编解码["主版本"] 为 2
V2编解码["解码头"] 为 解码V2头
V2编解码["解码事件"] 为 解码V2事件
V2编解码["编码头"] 为 编码V2头
V2编解码["编码事件"] 为 编码V2事件

# =====================================================================
# 7. V3 编解码（v2 物理层 + 结构化行准入 + canonical 事件校验 + end-seed cut）
# =====================================================================
# 解码事件（V3）：先过 payload 校验（canonical），未知必选事件保留直通
段落 解码V3事件 接收 行, 上一序号:
  设 种类 为 行["type"]
  设 数据 为 行.获取("data", {})
  如果 (已知事件类型(种类) == 真):
    设 占 为 校验事件载荷(种类, 数据, 真)  # 抑制L166
  设 序号 为 行.获取("seq", 上一序号 + 1)
  设 事件项 为 造事件(种类, 序号, 行.获取("time", 0), 数据)
  如果 (行.包含("sourceEventSeqs")):
    事件项["来源事件序号"] 为 行["sourceEventSeqs"]
  如果 (行.包含("redacted")) 且 行["redacted"]:
    事件项["遮蔽"] 为 真
  返回 事件项

# 恢复会话事件（restoreSessionEvents）：迁移流 + 版本门
段落 恢复会话事件 接收 解码器, 源事件表:
  设 结果 为 []
  设 上一序号 为 -1
  遍历 源事件 之 源事件表:
    设 事件项 为 解码器["解码事件"](源事件, 上一序号)
    设 上一序号 为 事件项["序号"]
    列表追加(结果, 事件项)
  返回 结果

设 V3编解码 为 {}
V3编解码["主版本"] 为 3
V3编解码["解码头"] 为 解码V2头
V3编解码["解码事件"] 为 解码V3事件
V3编解码["编码头"] 为 编码V2头
V3编解码["编码事件"] 为 编码V2事件

# =====================================================================
# 8. 迁移链（defineSessionFormatMigration / createSessionFormatChain）
# =====================================================================
# 迁移 = {名称, 基础版本, 目标版本, 迁移头, 迁移事件}
段落 定义迁移 接收 名称, 基础主, 基础次, 目标主, 目标次, 迁移头段落, 迁移事件段落:
  设 迁 为 {}
  迁["名称"] 为 名称
  迁["基础版本"] 为 ["主": 基础主, "次": 基础次]
  迁["目标版本"] 为 ["主": 目标主, "次": 目标次]
  迁["迁移头"] 为 迁移头段落
  迁["迁移事件"] 为 迁移事件段落
  返回 迁

# 编译链：版本 → 迁移（createSessionFormatChain 的字典投影）
段落 创建链 接收 迁移表:
  设 链映射 为 {}
  遍历 迁移项 之 迁移表:
    设 键 为 版本文本(迁移项["基础版本"])
    链映射[键] 为 迁移项
  设 链 为 {}
  链["映射"] 为 链映射
  返回 链

# 迁移流：从头版本走到目标版本（沿链逐跳）
段落 迁移会话 接收 链, 头, 事件表, 目标版本:
  设 当前头 为 头
  设 当前事件 为 事件表
  设 保护 为 0
  当 版本小(当前头["版本"], 目标版本) 且 保护 < 8:
    设 键 为 版本文本(当前头["版本"])
    如果 (字典包含键(链["映射"], 键) == 真):
      设 迁移项 为 链["映射"][键]
      设 当前头 为 迁移项["迁移头"](当前头)
      设 新事件 为 []
      遍历 事件项 之 当前事件:
        列表追加(新事件, 迁移项["迁移事件"](事件项))
      设 当前事件 为 重排序号(新事件)
      设 当前头["版本"] 为 迁移项["目标版本"]
    否则:
      抛出 新建 错误("unsupported session format migration " + 键)
    设 保护 为 保护 + 1
  返回 ["头": 当前头, "事件": 当前事件]

# 重排序号：迁移后事件按序重编号（对齐 v2→v3 seq 重映射）
段落 重排序号 接收 事件表:
  设 结果 为 []
  设 序号 为 0
  遍历 事件项 之 事件表:
    事件项["序号"] 为 序号
    设 序号 为 序号 + 1
    列表追加(结果, 事件项)
  返回 结果

# ---- v0→v1：identity edge（头版本推进，事件直通）----
段落 迁移头V0V1 接收 头:
  设 新头 为 头
  新头["版本"] 为 ["主": 1, "次": 0]
  返回 新头

段落 迁移事件V0V1 接收 事件项:
  返回 事件项

# ---- v1→v2：内嵌助手流（assistant/chunk 并入 assistant/message 的 stream）----
# 压缩 run 直通：v0 打包行在解码时直接表达为 assistant/message + stream（不展开成多条 chunk）
段落 迁移头V1V2 接收 头:
  设 新头 为 头
  新头["版本"] 为 ["主": 2, "次": 0]
  返回 新头

段落 迁移事件V1V2 接收 事件项:
  设 种类 为 事件项["类型"]
  如果 种类 == "assistant/chunk":
    # 直通为内嵌流事件：assistant/message + stream 块
    设 消息 为 事件项["数据"]["消息"]
    设 数据 为 {}
    数据["消息"] 为 消息
    设 流 为 []
    遍历 块 之 事件项["数据"]["块"]:
      列表追加(流, 块)
    数据["流"] 为 流
    设 新事件 为 造事件("assistant/message", 事件项["序号"], 事件项["时间"], 数据)
    如果 事件项.包含("来源事件序号"):
      新事件["来源事件序号"] 为 事件项["来源事件序号"]
    返回 新事件
  返回 事件项

# ---- v2→v3：系统提示提升 + PTC 词汇 + end-seed 语义 ----
段落 迁移头V2V3 接收 头:
  设 新头 为 头
  新头["版本"] 为 ["主": 3, "次": 0]
  如果 (新头.包含("代理预设")) 且 新头["代理预设"] == "code":
    新头["代理预设"] 为 "ptc"
  返回 新头

段落 迁移事件V2V3 接收 事件项:
  设 种类 为 事件项["类型"]
  如果 种类 == "request/header":
    设 数据 为 事件项["数据"]
    # PTC 词汇重命名：tools-code-mode → tools-ptc；tool/code-dispatch-* → tool/ptc-dispatch-*
    设 工具 为 数据.获取("工具模式", 空)
    如果 (是字典(工具) == 真):
      如果 (字典包含键(工具, "codeMode") == 真):
        设 工具["ptc"] 为 工具["codeMode"]
        字典删除(工具, "codeMode")
      如果 (字典包含键(工具, "codeModeEnabled") == 真):
        设 工具["ptcEnabled"] 为 工具["codeModeEnabled"]
        字典删除(工具, "codeModeEnabled")
      数据["tools"] 为 工具
    返回 事件项
  如果 种类 == "tool/call" 或 种类 == "tool/result":
    设 数据 为 事件项["数据"]
    # 词汇重命名（工具名）
    设 名字 为 数据.获取("名称", 空)
    如果 名字 == "tool/code-dispatch-render":
      数据["名称"] 为 "tool/ptc-dispatch-render"
    如果 名字 == "tool/code-dispatch-run":
      数据["名称"] 为 "tool/ptc-dispatch-run"
    返回 事件项
  返回 事件项

# ---- 链实例（v0→v1→v2→v3）----
段落 造标准链:
  设 迁移表 为 []
  列表追加(迁移表, 定义迁移("v0-to-v1", 0, 0, 1, 0, 迁移头V0V1, 迁移事件V0V1))
  列表追加(迁移表, 定义迁移("v1-to-v2", 1, 0, 2, 0, 迁移头V1V2, 迁移事件V1V2))
  列表追加(迁移表, 定义迁移("v2-to-v3", 2, 0, 3, 0, 迁移头V2V3, 迁移事件V2V3))
  返回 创建链(迁移表)

设 标准链 为 造标准链()

# =====================================================================
# 9. catalog（SessionFormatCatalog：readHeader / createRestore / encodeCurrentHeader / encodeCurrentEvent）
# =====================================================================
段落 造目录 接收 名称, 解码器, 迁移链, 当前版本:
  设 目 为 {}
  目["名称"] 为 名称
  目["解码器"] 为 解码器
  目["链"] 为 迁移链
  目["当前版本"] 为 当前版本
  返回 目

# 读头：解析首行（当前版本不匹配时按链迁移头）
段落 目录读头 接收 目, 行:
  设 头 为 目["解码器"]["解码头"](行)
  如果 (头版本为(头, 目["当前版本"]["主"], 目["当前版本"]["次"]) == 假):
    设 头 为 迁移会话(目["链"], 头, [], 目["当前版本"])["头"]
  返回 头

# 恢复（createRestore）：读头 + 事件恢复（按版本门选择解码器与迁移）
段落 目录恢复 接收 目, 行表:
  如果 (长度(行表) == 0):
    抛出 新建 错误("empty session log")
  设 头 为 目录读头(目, 解析JSON(行表[0]))
  设 源事件 为 []
  设 上一序号 为 -1
  设 i 为 1
  当 i < 长度(行表):
    如果 (行表[i] != ""):
      设 行 为 解析JSON(行表[i])
      设 事件项 为 目["解码器"]["解码事件"](行, 上一序号)
      设 上一序号 为 事件项["序号"]
      列表追加(源事件, 事件项)
    设 i 为 i + 1
  设 目标头 为 头
  设 目标事件 为 源事件
  如果 (头版本为(头, 目["当前版本"]["主"], 目["当前版本"]["次"]) == 假):
    设 迁 为 迁移会话(目["链"], 头, 源事件, 目["当前版本"])
    设 目标头 为 迁["头"]
    设 目标事件 为 迁["事件"]
  返回 ["头": 目标头, "事件": 目标事件]

# 编码当前头/事件（current writer）
段落 目录编码头 接收 目, 头:
  返回 目["解码器"]["编码头"](头)

段落 目录编码事件 接收 目, 事件项:
  返回 目["解码器"]["编码事件"](事件项)

设 当前目录 为 造目录("current", V3编解码, 标准链, ["主": 3, "次": 0])

# =====================================================================
# 10. 节点 0：系统提示提升（system/message + surfaceOp append/replace）
# =====================================================================
# surfaceOp：append（追加到节点0）或 replace（替换节点0）
# R47 深化（V3 记录形状）：表面操作只允许 append/replace，非法值拒绝落盘而非静默按 append 处理。
段落 记录系统提示 接收 会话对象, 系统提示, 操作:
  如果 (是字符串(操作) == 假):
    抛出 新建 错误("system/message surfaceOp must be append or replace")
  如果 (操作 != "append") 且 (操作 != "replace"):
    抛出 新建 错误("system/message surfaceOp must be append or replace")
  设 数据 为 {}
  数据["系统"] 为 系统提示
  数据["表面操作"] 为 操作
  设 事件项 为 会话对象.记录事件("system/message", 数据)
  返回 事件项

# 节点0投影：从事件表取最近一条 system/message（按 surfaceOp 应用）
# R47 深化：遮蔽跳过（被 replace 遮蔽的旧 system/message 不参与投影，对齐上游
#   「shadowed nodes are excluded」）；空文本节点（无系统提示记录）不产消息但保留节点位置。
段落 投影节点0 接收 事件表:
  设 当前 为 空
  遍历 事件项 之 事件表:
    设 被遮蔽 为 事件项.包含("遮蔽") 且 事件项["遮蔽"]
    如果 (被遮蔽 == 真) 或 (事件项["类型"] != "system/message"):
      继续
    设 数据 为 事件项.获取("数据", 空)
    如果 是字典(数据) == 假:
      继续
    设 操作 为 数据.获取("表面操作", 空)
    如果 操作 == 空:
      设 操作 为 事件项.获取("表面操作", 事件项.获取("surfaceOp", "append"))
    如果 是字典(操作):
      设 操作 为 操作.获取("op", "append")
    如果 操作 == "replace":
      设 当前 为 数据.获取("系统", "")
    否则:
      设 提示文 为 数据.获取("系统", "")
      如果 提示文 != "":
        如果 当前 == 空:
          设 当前 为 提示文
        否则:
          设 当前 为 当前 + 提示文  # T2-D5：对齐 记录系统提示 写入的中文键（原 ["system"] 笔误，第二条 append 必错）
  如果 当前 == "":
    返回 空
  返回 当前

# =====================================================================
# 11. 内嵌助手流（assistant/attempt + assistant/message stream）
# =====================================================================
# 记录助手轮：先 attempt，再以 stream 内嵌块的方式记录 assistant/message
段落 记录助手轮 接收 会话对象, 消息标识, 内容表, 流块表:
  设 尝试数据 为 {}
  尝试数据["消息"] 为 ["标识": 消息标识, "content": 内容表]
  设 占 为 会话对象.记录事件("assistant/attempt", 尝试数据)  # 抑制L166
  设 消息数据 为 {}
  消息数据["消息"] 为 ["标识": 消息标识, "content": 内容表]
  消息数据["流"] 为 流块表
  设 事件项 为 会话对象.记录事件("assistant/message", 消息数据)
  返回 事件项

# 从内嵌流投影完整消息（stream 块并入 content）
段落 投影内嵌消息 接收 事件项:
  设 数据 为 事件项["数据"]
  设 消息 为 数据["消息"]
  如果 (字典包含键(数据, "流") == 真):
    设 内容 为 消息["content"]
    设 合并 为 []
    遍历 块 之 内容:
      列表追加(合并, 块)
    遍历 块 之 数据["流"]:
      列表追加(合并, 块)
    消息["content"] 为 合并
  返回 消息

# =====================================================================
# 12. 文件名与错误（filename.ts / error.ts 投影）
# =====================================================================
# 会话日志路径段（encodeSegment 已在 持久化.light，这里提供版本无关的日志名）
段落 日志文件名 接收 标识:
  返回 编码段本地(标识) + ".session.jsonl"

段落 编码段本地 接收 原文:
  如果 原文 == "":
    抛出 新建 错误("不能编码空路径段")
  设 输出 为 ""
  设 i 为 0
  当 i < 长度(原文):
    设 字符 为 原文[i]
    设 码 为 码位(字符)
    设 安全 为 (码 >= 48 且 码 <= 57) 或 (码 >= 65 且 码 <= 90) 或 (码 >= 97 且 码 <= 122) 或 (字符 == "." 或 字符 == "_" 或 字符 == "-")
    如果 字符 != "~" 且 安全:
      设 输出 为 输出 + 字符
    否则:
      设 数字 为 十六进制(码)
      当 长度(数字) < 4:
        设 数字 为 "0" + 数字
      设 输出 为 输出 + "~" + 数字
    设 i 为 i + 1
  返回 输出

# =====================================================================
# 13. repair —— 崩溃恢复：中断轮闭合器（对齐上游 session/src/repair.ts interruptedTurnClosers）
# =====================================================================
# 恢复错误码（对齐上游 TOOL_NOT_STARTED / TOOL_OUTCOME_UNKNOWN）
设 恢复码工具未启动 为 "TOOL_NOT_STARTED"
设 恢复码结果未知 为 "TOOL_OUTCOME_UNKNOWN"

# 安全取值（数据可能为 空：光明 turn/start 常记 空 数据，不能直接 .获取）
段落 修复取值 接收 数据, 键, 缺省:
  如果 是字典(数据):
    返回 数据.获取(键, 缺省)
  返回 缺省

# 中断轮闭合器：扫描事件日志，为未闭合的 turn/step/tool-call 按序合成关闭事件。
# 输入：事件表（光明 SessionEvent：类型/序号/时间/数据）；输出：追加在日志尾的合成事件表。
# 顺序：未决调用先合成错误 tool/result → step/end（若开启）→ turn/end {interrupted}。
# 序号：从最后真实事件序号+1 连续递增；时间戳复用最后真实事件时间；平衡/空日志返回空表。
# 轮界重置待决调用：早前轮的调用不得泄漏到尾部修复（对齐上游 pendingCalls.clear()）。
段落 中断轮闭合器 接收 事件表:
  设 有开启轮次 为 假
  设 有开启步骤 为 假
  设 待决调用 为 {}
  遍历 事件项 之 事件表:
    设 种类 为 事件项["类型"]
    设 数据 为 修复取值(事件项, "数据", 空)
    如果 种类 == "turn/start":
      设 有开启轮次 为 真
      设 有开启步骤 为 假
      设 待决调用 为 {}
    否则如果 种类 == "turn/end":
      设 有开启轮次 为 假
      设 有开启步骤 为 假
      设 待决调用 为 {}
    否则如果 种类 == "step/start":
      设 有开启步骤 为 真
    否则如果 种类 == "step/end":
      设 待决调用 为 {}
      设 有开启步骤 为 假
    否则如果 种类 == "assistant/message":
      设 消息 为 修复取值(数据, "消息", {})
      设 内容表 为 修复取值(消息, "content", [])
      如果 是列表(内容表):
        遍历 块 之 内容表:
          如果 是字典(块):
            设 块型 为 修复取值(块, "type", "")
            设 块标识 为 修复取值(块, "id", "")
            如果 (块型 == "tool-call") 且 (块标识 != ""):
              设 条目 为 {}
              条目["步骤"] 为 修复取值(数据, "step", 空)
              待决调用[块标识] 为 条目
    否则如果 种类 == "tool/call":
      设 调用标识 为 修复取值(数据, "callId", 空)
      如果 调用标识 == 空:
        设 调用标识 为 修复取值(数据, "调用", 空)
      如果 (调用标识 != 空) 且 (字典包含键(待决调用, 调用标识) == 真):
        设 条目 为 待决调用[调用标识]
        条目["调用序号"] 为 事件项["序号"]
    否则如果 种类 == "tool/result":
      设 消息 为 修复取值(数据, "消息", {})
      设 来源 为 修复取值(消息, "来源", {})
      设 调用标识 为 修复取值(来源, "callId", 空)
      如果 调用标识 == 空:
        设 调用标识 为 修复取值(数据, "调用", 空)
      如果 (调用标识 != 空) 且 (字典包含键(待决调用, 调用标识) == 真):
        字典删除(待决调用, 调用标识)
  # 平衡日志（轮已闭合）或空日志：无需合成
  如果 (有开启轮次 == 假) 或 (长度(事件表) == 0):
    返回 []
  # 最后真实事件提供序号基线与时间戳（复用最后时间保证确定性，不发明未来时间）
  设 最后事件 为 事件表[长度(事件表) - 1]
  设 序号 为 最后事件["序号"] + 1
  设 时刻 为 最后事件["时间"]
  设 合成表 为 []
  # 先闭合未决调用（provider 拒绝悬空 assistant 调用；字典插入序即转写序）
  遍历 调用标识 之 字典键列表(待决调用):
    设 条目 为 待决调用[调用标识]
    设 调用序号 为 修复取值(条目, "调用序号", 空)
    设 已启动 为 调用序号 != 空
    如果 已启动:
      设 文案 为 "The tool call was interrupted after it was recorded, but no result was durably recorded. Its outcome is unknown. Decide whether to retry from the tool semantics: retry only if the operation is read-only or idempotent; if it may have side effects, first verify external state or ask the user. Do not retry blindly."
    否则:
      设 文案 为 "The tool call was interrupted before the Harness recorded it as started. Retry it if it is still needed."
    设 消息 为 {}
    消息["id"] 为 "interrupted-tool-result-" + 调用标识 + "-" + 转字符串(序号)
    消息["role"] 为 "user"
    设 来源 为 {}
    来源["kind"] 为 "tool"
    来源["callId"] 为 调用标识
    消息["来源"] 为 来源
    设 文本块 为 {}
    文本块["type"] 为 "text"
    文本块["text"] 为 文案
    设 块内 为 []
    列表追加(块内, 文本块)
    设 结果块 为 {}
    结果块["type"] 为 "tool-result"
    结果块["toolCallId"] 为 调用标识
    结果块["isError"] 为 真
    结果块["content"] 为 块内
    设 消息内容 为 []
    列表追加(消息内容, 结果块)
    消息["content"] 为 消息内容
    设 错误 为 {}
    如果 已启动:
      错误["名称"] 为 "ToolOutcomeUnknownError"
      错误["代码"] 为 恢复码结果未知
    否则:
      错误["名称"] 为 "ToolNotStartedError"
      错误["代码"] 为 恢复码工具未启动
    设 结果数据 为 {}
    结果数据["调用"] 为 调用标识
    结果数据["成功"] 为 假
    结果数据["消息"] 为 消息
    结果数据["错误"] 为 错误
    设 合成事件 为 造事件("tool/result", 序号, 时刻, 结果数据)
    设 序号 为 序号 + 1
    如果 已启动:
      设 来源序号 为 []
      列表追加(来源序号, 调用序号)
      合成事件["来源事件序号"] 为 来源序号
    列表追加(合成表, 合成事件)
  # 再闭合开启的步骤（步骤开启时轮次不得先闭合）
  如果 有开启步骤:
    设 步数据 为 {}
    步数据["原因"] 为 "interrupted"
    列表追加(合成表, 造事件("step/end", 序号, 时刻, 步数据))
    设 序号 为 序号 + 1
  # 最后闭合轮次（上游 reason.kind 展平为光明 turn/end 词汇的 原因 字符串）
  设 轮数据 为 {}
  轮数据["原因"] 为 "interrupted"
  列表追加(合成表, 造事件("turn/end", 序号, 时刻, 轮数据))
  返回 合成表

# =====================================================================
# 14. surface 投影（对齐 core/session/src/surface.ts 纯逻辑面 · R47 深化）
#     节点0投影 / 遮蔽跳过 / 表面事件数据校验（V3 系统提示记录约束）
# =====================================================================
# 表面可入类型：四条产出 LLM 消息的事件种类（上游 SURFACE_EVENT_TYPES）
段落 表面可入类型 接收 种类:
  返回 (种类 == "system/message") 或 (种类 == "user/message") 或 (种类 == "assistant/message") 或 (种类 == "tool/result")

# 表面操作取值：数据["表面操作"] 优先，其次事件级 "表面操作"/"surfaceOp"，缺省 "append"
# （本地约定：缺省 append；兼容 会话.light 的数据键与 会话日志增量.light 的事件级键两种表示）
段落 表面操作取值 接收 事件项:
  设 数据 为 事件项.获取("数据", 空)
  如果 (是字典(数据) == 真) 且 (字典包含键(数据, "表面操作") == 真):
    返回 数据["表面操作"]
  如果 事件项.包含("表面操作"):
    返回 事件项["表面操作"]
  如果 事件项.包含("surfaceOp"):
    返回 事件项["surfaceOp"]
  返回 "append"

# 是否替换操作：字符串 "replace" 或 字典 { "op": "replace", ... }
段落 是替换操作 接收 操作:
  如果 操作 == "replace":
    返回 真
  如果 (是字典(操作) == 真) 且 (操作.获取("op", "") == "replace"):
    返回 真
  返回 假

# 是否表面事件（类型可入即成立；本地缺省 surfaceOp = append，上游要求显式标记，登记为适配差异）
段落 是表面事件 接收 事件项:
  返回 表面可入类型(事件项["类型"])

# 空内容消息 → 空（上游：空内容 system/assistant 事件只承载用量，不产线消息，但节点位置保留）
段落 空内容判定 接收 消息:
  如果 是字典(消息) == 假:
    返回 空
  设 内容 为 消息.获取("content", 空)
  如果 (是列表(内容) == 假) 或 (长度(内容) == 0):
    返回 空
  返回 消息

# 节点消息投影（对齐 surface.ts deriveEventMessage）：
#   user/message → 数据（canonical 形状为 数据["消息"]）
#   system/message → 本地形状 数据["系统"] 文本成 system 消息；canonical 形状走 数据["消息"]
#   assistant/message → 数据["消息"] 与 数据["流"] 合并后成消息
#   tool/result → 数据["消息"]
#   空内容与 log-only（turn/step/attempt/错误）→ 空：不产线消息，表面位置由 节点表 保留
段落 投影节点消息 接收 事件项:
  设 种类 为 事件项["类型"]
  设 数据 为 事件项.获取("数据", 空)
  如果 是字典(数据) == 假:
    返回 空
  如果 种类 == "user/message":
    如果 字典包含键(数据, "消息"):
      返回 数据["消息"]
    返回 数据
  如果 种类 == "system/message":
    如果 字典包含键(数据, "消息"):
      返回 空内容判定(数据["消息"])
    设 提示文 为 数据.获取("系统", "")
    如果 提示文 == "":
      返回 空
    设 块表 为 []
    列表追加(块表, ["type": "text", "text": 提示文])
    返回 ["角色": "system", "content": 块表]
  如果 种类 == "assistant/message":
    如果 字典包含键(数据, "消息") == 假:
      返回 空
    设 消息 为 数据["消息"]
    如果 是字典(消息) == 假:
      返回 空
    如果 是列表(消息.获取("content", 空)) == 假:
      返回 空
    如果 (字典包含键(数据, "流") == 真) 且 (是列表(数据["流"]) == 真):
      设 合并 为 []
      遍历 块 之 消息["content"]:
        列表追加(合并, 块)
      遍历 块 之 数据["流"]:
        列表追加(合并, 块)
      消息["content"] 为 合并
    返回 空内容判定(消息)
  如果 种类 == "tool/result":
    返回 数据.获取("消息", 空)
  返回 空

# 校验表面事件数据（对齐 surface.ts validateSessionEventData）：
#   request/header：数据必须是字典；必须省略 header.system（V3 系统提示提升到 system/message 节点，
#     本地对应键为 "系统提示"）；存在的 header 必须是字典，空的 tools / adapterDefaults 必须省略；
#   tool/result：带 错误（键存在即校验，不看值）时 message content[0].isError 必须为 真。
#   位置 = 事件定位文案（如 "request/header at seq 3"）。
段落 校验表面事件数据 接收 事件项, 位置:
  设 种类 为 事件项["类型"]
  设 数据 为 事件项.获取("数据", 空)
  如果 种类 == "request/header":
    如果 是字典(数据) == 假:
      抛出 新建 错误(位置 + " data must be an object")
    如果 字典包含键(数据, "系统提示"):
      抛出 新建 错误(位置 + " must omit header.system; use system/message")
    如果 字典包含键(数据, "header"):
      设 头 为 数据["header"]
      如果 是字典(头) == 假:
        抛出 新建 错误(位置 + " header must be an object")
      如果 字典包含键(头, "system"):
        抛出 新建 错误(位置 + " must omit header.system; use system/message")
      如果 (字典包含键(头, "tools") == 真) 且 (是列表(头["tools"]) == 真) 且 (长度(头["tools"]) == 0):
        抛出 新建 错误(位置 + " must omit empty tools")
      设 缺省值 为 头.获取("adapterDefaults", 空)
      如果 (是字典(缺省值) == 真) 且 (长度(字典键列表(缺省值)) == 0):
        抛出 新建 错误(位置 + " must omit empty adapterDefaults")
    返回 真
  如果 种类 == "tool/result":
    如果 是字典(数据) == 假:
      抛出 新建 错误(位置 + " data must be an object")
    如果 字典包含键(数据, "错误") == 假:
      返回 真
    设 消息 为 数据.获取("消息", 空)
    设 内容 为 空
    如果 (是字典(消息) == 真) 且 (字典包含键(消息, "content") == 真):
      设 内容 为 消息["content"]
    设 首个 为 空
    如果 (是列表(内容) == 真) 且 (长度(内容) > 0):
      设 首个 为 内容[0]
    如果 (是字典(首个) == 假) 或 (首个.获取("isError", 假) != 真):
      抛出 新建 错误(位置 + " error requires message content[0].isError === true")
    返回 真
  返回 真

# 表面消息投影（对齐 surface.ts deriveMessages over surface）：
#   1) 遮蔽跳过：被 replace 遮蔽（"遮蔽" 为 真）的事件不参与投影（上游「shadowed nodes are excluded」）；
#   2) 节点0 前置：system/message 节点聚合为模型可见的首条 system 消息，不逐条投影；
#   3) 逐节点投影：空内容节点不产线消息，但表面位置保留在 节点表。
# R51 任务1 加性参数：覆盖表 = {序号: 消息} 为消息级投影（image/offload）的结果，
#   命中即替换该节点的派生消息（对齐上游 fold 的 deriveEventMessage(seq, projectedMessages) 优先取用）；
#   缺省 空 → 行为与 R47/R48 完全一致（既有调用方不传第二参）。
# ⚠️ 命名铁律（R51 实测新坑）：此区间名不得用核心动词关键字——「映射」是 arity-2 核心动词，
#   以其为变量名时 `映射[k] 为 值` 会被**静默**编译成 `(映射[k] == 值)`（赋值丢失且无报错）。
段落 投影表面消息 接收 事件表, 覆盖表 = 空:
  设 节点表 为 []
  设 消息表 为 []
  设 节点0 为 投影节点0(事件表)
  如果 节点0 != 空:
    设 系统块表 为 []
    列表追加(系统块表, ["type": "text", "text": 节点0])
    列表追加(消息表, ["角色": "system", "content": 系统块表])
  遍历 事件项 之 事件表:
    设 被遮蔽 为 事件项.包含("遮蔽") 且 事件项["遮蔽"]
    如果 (被遮蔽 == 真):
      继续
    如果 (是表面事件(事件项) == 假):
      继续
    列表追加(节点表, 事件项["序号"])
    设 数据 为 事件项.获取("数据", 空)
    设 归并节点0 为 (事件项["类型"] == "system/message") 且 ((是字典(数据) == 假) 或 (字典包含键(数据, "消息") == 假))
    如果 (归并节点0 == 真):
      继续
    设 消息 为 投影节点消息(事件项)
    设 已投影 为 空
    如果 覆盖表 != 空:
      如果 字典包含键(覆盖表, 事件项["序号"]) == 真:
        设 已投影 为 覆盖表[事件项["序号"]]
    如果 已投影 != 空:
      设 消息 为 已投影
    如果 (消息 == 空):
      继续
    列表追加(消息表, 消息)
  返回 ["节点表": 节点表, "消息表": 消息表]

# =====================================================================
# 14b. R48 任务1：消息产生事件投影 + append/replace 两种 surfaceOp 投影规则
#      （对齐 surface.ts：isAppendSurfaceEvent / isReplacementSurfaceEvent /
#       validateSurfaceMetadata + assertProvenance 事件级部分）
#      加性对齐，不改 R47 已做的 投影节点0 / 遮蔽跳过 / 投影节点消息 / 是表面事件 / 是替换操作。
# =====================================================================
# 是否追加表面事件（align isAppendSurfaceEvent）：表面事件 且 surfaceOp 为字符串 "append"
段落 是追加表面事件 接收 事件项:
  如果 (是表面事件(事件项) == 假):
    返回 假
  返回 表面操作取值(事件项) == "append"

# 是否替换表面事件（align isReplacementSurfaceEvent）：表面事件 且 surfaceOp 非 "append"
#   （字符串 "replace" 或 字典 {"op":"replace",...} 均判替换；log-only 事件不算表面事件）
段落 是替换表面事件 接收 事件项:
  如果 (是表面事件(事件项) == 假):
    返回 假
  返回 表面操作取值(事件项) != "append"

# 是否非负安全序号（align isEventSeq：Number.isSafeInteger && >=0 && 非 -0）
段落 是非负安全序号 接收 值:
  如果 (是数字(值) == 假):
    返回 假
  如果 (是负零(值) == 真):
    返回 假
  如果 (是整数(值) == 假):
    返回 假
  返回 值 >= 0

# 校验表面标记（align surfaceOpOf + validateSurfaceMetadata + assertProvenance 事件级部分）：
#   返回 surfaceOp（"append" 或 替换字典）；非表面事件返回 空；违规抛错。
#   规则：
#   - 表面可入类型 但 缺 surfaceOp 标记 → 抛「requires a surfaceOp marker」
#   - 表面可入类型 + 非法 surfaceOp（非 append、非合法 replace 字典）→ 抛「invalid surfaceOp」
#   - replace 字典须含 op/startSeq/endSeq，且 startSeq/endSeq 为更早的非负安全序号
#   - 非表面事件 携带 surfaceOp / 来源事件序号 → 抛（未知可忽略事件除外）
#   - 来源事件序号（sourceEventSeqs）须为数组、非空、全为更早的非负安全序号、无重复
段落 校验表面标记 接收 事件项:
  设 种类 为 事件项["类型"]
  设 数据 为 事件项.获取("数据", 空)
  设 原操作 为 空
  如果 (是字典(数据) == 真) 且 (字典包含键(数据, "表面操作") == 真):
    设 原操作 为 数据["表面操作"]
  否则如果 (事件项.包含("表面操作") == 真):
    设 原操作 为 事件项["表面操作"]
  否则如果 (事件项.包含("surfaceOp") == 真):
    设 原操作 为 事件项["surfaceOp"]
  如果 (表面可入类型(种类) == 假):
    # 非表面事件：未知可忽略事件可保留不透明元数据，但不得携带 surfaceOp / 来源事件序号
    如果 (原操作 != 空):
      抛出 新建 错误("session event \"" + 种类 + "\" is not surface-eligible and cannot carry surfaceOp")
    如果 (事件项.包含("来源事件序号") == 真):
      抛出 新建 错误("session event \"" + 种类 + "\" is not surface-eligible and cannot carry sourceEventSeqs")
    返回 空
  如果 (原操作 == 空):
    抛出 新建 错误("session event \"" + 种类 + "\" is surface-eligible and requires a surfaceOp marker")
  如果 (原操作 == "append"):
    设 占 为 校验来源序号(事件项, 种类)  # 抑制L166
    返回 "append"
  如果 (是字典(原操作) == 假):
    抛出 新建 错误("session event \"" + 种类 + "\" carries an invalid surfaceOp")
  如果 (原操作.获取("op", "") != "replace"):
    抛出 新建 错误("session event \"" + 种类 + "\" carries an invalid surfaceOp")
  设 起 为 原操作.获取("startSeq", 空)
  设 止 为 原操作.获取("endSeq", 空)
  如果 (是非负安全序号(起) == 假) 或 (是非负安全序号(止) == 假):
    抛出 新建 错误("session event \"" + 种类 + "\" carries an invalid replace surfaceOp")
  如果 (起 >= 事件项["序号"]) 或 (止 >= 事件项["序号"]):
    抛出 新建 错误("surface replace at seq " + 转字符串(事件项["序号"]) + ": startSeq and endSeq must reference earlier events")
  # 来源事件序号 provenance（事件级部分；fold 级「须覆盖全部被遮蔽节点」由 fold 层负责）
  设 占 为 校验来源序号(事件项, 种类)  # 抑制L166
  返回 原操作

# 来源事件序号 provenance 校验（align assertProvenance 事件级部分）：
#   assistant/message 不得携带 来源事件序号；来源事件序号 须为数组、非空、全为更早的非负安全序号、无重复。
段落 校验来源序号 接收 事件项, 种类:
  如果 (种类 == "assistant/message") 且 (事件项.包含("来源事件序号") == 真):
    抛出 新建 错误("assistant/message embeds its source stream and cannot carry sourceEventSeqs")
  如果 (事件项.包含("来源事件序号") == 真):
    设 源 为 事件项["来源事件序号"]
    如果 (是列表(源) == 假):
      抛出 新建 错误("sourceEventSeqs must be an array")
    如果 (长度(源) == 0):
      抛出 新建 错误("sourceEventSeqs must not be empty")
    设 见 为 {}
    遍历 序号 之 源:
      如果 (是非负安全序号(序号) == 假):
        抛出 新建 错误("sourceEventSeqs must contain non-negative safe integers")
      如果 (序号 >= 事件项["序号"]):
        抛出 新建 错误("sourceEventSeqs must reference earlier events: " + 转字符串(序号) + " >= current seq " + 转字符串(事件项["序号"]))
      如果 (字典包含键(见, 序号) == 真):
        抛出 新建 错误("sourceEventSeqs must not contain duplicates")
      见[序号] 为 真
  返回 真

# 消息产生事件投影（align deriveMessages over surface）：返回非空的模型可见消息表
#   复用 投影表面消息 的 消息表（节点0 系统消息前置 + 逐节点投影 + 遮蔽跳过）。
段落 投影消息产生 接收 事件表:
  设 结果 为 投影表面消息(事件表)
  返回 结果["消息表"]

# =====================================================================
# 15. R48 任务4：V3 系统头/节点0 role 形状 + V2→V3 迁移补验
#      （对齐 session-format-v2-to-v3/validation.ts：节点0 必须是 system/message 且 role 为 system；
#       系统头保护：system/message 须落在开启的 step 内、首条 surface 须为受保护系统头、
#       replace 须精确覆盖 head、非系统替换不得遮蔽 head）
# =====================================================================
# 节点0 role 形状校验：首个非遮蔽表面事件必须是 system/message 且其派生消息 role == "system"
段落 校验节点0角色形状 接收 事件表:
  设 节点0事件 为 空
  设 已找 为 假
  遍历 事件项 之 事件表:
    如果 (已找 == 真):
      继续
    设 被遮蔽 为 事件项.包含("遮蔽") 且 事件项["遮蔽"]
    如果 (被遮蔽 == 真):
      继续
    如果 (是表面事件(事件项) == 假):
      继续
    设 节点0事件 为 事件项
    设 已找 为 真
  如果 (节点0事件 == 空):
    抛出 新建 错误("surface node 0 must be a system/message; no surface event found")
  如果 (节点0事件["类型"] != "system/message"):
    抛出 新建 错误("surface node 0 must be a system/message; got " + 节点0事件["类型"])
  设 消息 为 投影节点消息(节点0事件)
  如果 (消息 == 空):
    抛出 新建 错误("surface node 0 system/message must produce a message")
  如果 (消息.获取("角色", "") != "system"):
    抛出 新建 错误("surface node 0 system/message role must be 'system'")
  返回 真

# V3 系统头保护（align restoreReleasedV3Artifact 系统头部分）：
#   首条 surface 事件须为受保护系统头；system/message 须落在开启的 step 内；
#   replace（system 或非 system）不得错误遮蔽 head。返回 真，违规抛错。
段落 校验V3系统头 接收 事件表:
  设 有表面 为 假
  设 头 为 空
  设 步 为 空
  遍历 事件项 之 事件表:
    设 种类 为 事件项["类型"]
    设 数据 为 事件项.获取("数据", 空)
    如果 (种类 == "step/start"):
      如果 (是字典(数据) == 真):
        设 步 为 ["turn": 数据.获取("turn", 空), "step": 数据.获取("step", 空)]
      否则:
        设 步 为 空
    否则如果 (种类 == "step/end") 或 (种类 == "turn/end"):
      设 步 为 空
    如果 (种类 == "system/message"):
      如果 (是字典(数据) == 真) 且 (字典包含键(数据, "turn") == 真) 且 (字典包含键(数据, "step") == 真):
        如果 (步 == 空) 或 (步["turn"] != 数据["turn"]) 或 (步["step"] != 数据["step"]):
          抛出 新建 错误("system/message does not match an open step")
      设 操作 为 表面操作取值(事件项)
      如果 (有表面 == 真) 且 (头 == 空):
        抛出 新建 错误("system/message requires a protected first surface head")
      如果 (操作 == "append"):
        如果 (有表面 == 假):
          设 头 为 事件项["序号"]
      否则:
        设 替换 为 操作
        如果 (替换 == 空) 或 (是字典(替换) == 假):
          抛出 新建 错误("system/message carries an invalid surfaceOp")
        设 起 为 替换.获取("startSeq", 空)
        设 止 为 替换.获取("endSeq", 空)
        如果 (起 == 头) 或 (止 == 头):
          如果 (起 != 头) 或 (止 != 头):
            抛出 新建 错误("system/message must replace exactly the current system head")
          设 头 为 事件项["序号"]
    否则如果 (是表面事件(事件项) == 真) 且 (表面操作取值(事件项) != "append"):
      设 替换 为 表面操作取值(事件项)
      如果 (是字典(替换) == 真):
        设 起 为 替换.获取("startSeq", 空)
        设 止 为 替换.获取("endSeq", 空)
        如果 (起 == 头) 或 (止 == 头):
          抛出 新建 错误("surface replacement cannot shadow the protected system head")
    如果 (是表面事件(事件项) == 真):
      设 有表面 为 真
  返回 真

# V2→V3 迁移补验（align validateTargetHeader: assertReleasedV3Header + 系统提示提升完备性）：
#   目标头须为 v3；目标事件序号须密集 0..n-1；目标须通过 V3 系统头校验；
#   若源 v2 在 request/header 携带系统提示（系统提示/system），目标节点0 须反映该提示。
#   返回 真，违规抛错。
段落 补验V2V3迁移 接收 源头, 源事件表, 目标头, 目标事件表:
  如果 (目标头["版本"]["主"] != 3) 或 (目标头["版本"]["次"] != 0):
    抛出 新建 错误("v2->v3 migration target header must be format v3")
  设 n 为 长度(目标事件表)
  设 i 为 0
  当 i < n:
    如果 (目标事件表[i]["序号"] != i):
      抛出 新建 错误("v2->v3 migration must emit dense seqs")
    设 i 为 i + 1
  设 占 为 校验V3系统头(目标事件表)  # 抑制L166
  设 源提示 为 空
  遍历 事件项 之 源事件表:
    如果 (事件项["类型"] == "request/header"):
      设 数据 为 事件项.获取("数据", 空)
      如果 (是字典(数据) == 真):
        如果 (字典包含键(数据, "系统提示") == 真) 且 (数据["系统提示"] != ""):
          设 源提示 为 数据["系统提示"]
        否则如果 (是字典(数据.获取("header", 空)) == 真) 且 (数据["header"].包含("system") == 真) 且 (数据["header"]["system"] != ""):
          设 源提示 为 数据["header"]["system"]
  如果 (源提示 != 空):
    设 节点0 为 投影节点0(目标事件表)
    如果 (节点0 != 源提示):
      抛出 新建 错误("v2->v3 migration must promote system prompt to node 0")
  返回 真

# =====================================================================
# 16. R51 任务1：image/offload 事件 + 图像卸载投影（上游 0.1.6 增量）
#      （对齐 compaction/compaction-image-offload/src/{projection.ts,project-message.ts,image-offload.ts}
#        与 llm/llm/src/content.ts 的 offloadedImageText / replaceOffloadedImages）
#
# P0 硬兼容：上游 0.1.6 起会话日志会含 image/offload 事件；
#   上游明说「不认识该事件的旧版本拒绝读取这些日志」→ 本模块必须显式认识（见 §2 词汇表）。
#
# 语义（逐条对齐上游）：
#   - 目标 = {seq, imageIndexes}；seq 必须是「当前表面节点」且源事件为 user/message 或 tool/result；
#   - imageIndexes = 按深度优先（含嵌套 tool-result）对**全部图像出现位置**计数得到的下标，
#     严格递增、非空、非负安全整数；计数**包含此前已卸载的出现位置**；
#   - 命中出现位置被标 offloaded=真，消息标识与其余块保持原样（不替换消息、不改身份）；
#   - 同一 seq 在一个事件内不得重复；跨事件可对同一 seq 再叠加卸载其它下标；
#   - 选中的出现位置必须存在且尚未卸载，否则抛错（无部分应用）。
#
# ⚠️ 与上游的刻意差异（登记为行为差异）：上游返回 deepFreeze 深冻结消息；
#   光明无深冻结原语 → 本层返回浅拷贝（副本），且不改动原消息（不可变性由「不原地写」保证，
#   而非由 Object.freeze 保证）。
# =====================================================================

# 按序号取事件（对齐 upstream session.eventAt）
段落 取事件序号 接收 事件表, 序号:
  遍历 事件项 之 事件表:
    如果 事件项["序号"] == 序号:
      返回 事件项
  返回 空

# 当前表面节点序号表（对齐 upstream 投影上下文 context.nodes）：
#   遮蔽跳过 + 表面可入类型，与 投影表面消息 的 节点表 同规则。
段落 当前表面节点 接收 事件表:
  设 结果 为 []
  遍历 事件项 之 事件表:
    设 被遮蔽 为 事件项.包含("遮蔽") 且 事件项["遮蔽"]
    如果 (被遮蔽 == 真):
      继续
    如果 (是表面事件(事件项) == 假):
      继续
    列表追加(结果, 事件项["序号"])
  返回 结果

# 是图像块 / 是工具结果块（深度优先遍历的两个分支判据）
段落 是图像块 接收 块:
  如果 (是字典(块) == 假):
    返回 假
  返回 块.获取("type", "") == "image"

段落 是工具结果块 接收 块:
  如果 (是字典(块) == 假):
    返回 假
  返回 块.获取("type", "") == "tool-result"

# 图像身份（对齐 upstream imageIdentity）：attachment.name → attachmentId → 本地 名称/标识 → "image"
段落 图像身份 接收 块:
  如果 (是字典(块) == 假):
    返回 "image"
  设 附件 为 块.获取("attachment", 空)
  如果 是字典(附件):
    设 名 为 附件.获取("name", 空)
    如果 (是字符串(名) == 真) 且 (名 != ""):
      返回 名
    设 标识 为 附件.获取("attachmentId", 空)
    如果 (是字符串(标识) == 真) 且 (标识 != ""):
      返回 标识
  设 名 为 块.获取("名称", 空)
  如果 (是字符串(名) == 真) 且 (名 != ""):
    返回 名
  设 标识 为 块.获取("标识", 空)
  如果 (是字符串(标识) == 真) 且 (标识 != ""):
    返回 标识
  返回 "image"

# 卸载占位文本（对齐 upstream offloadedImageText 的「无本地规整图像路径」分支）
段落 卸载占位文本 接收 块:
  返回 "[image omitted to fit request image limits; " + 图像身份(块) + ". No local normalized image path is available; ask the user to attach it again if needed.]"

# 把已卸载出现位置替换为占位文本（对齐 upstream replaceOffloadedImages；递归进 tool-result content）
段落 替换卸载图像 接收 块表:
  设 下一 为 空
  设 i 为 0
  当 i < 长度(块表):
    设 块 为 块表[i]
    设 投影 为 块
    如果 (是图像块(块) == 真) 且 (块.获取("offloaded", 假) == 真):
      设 投影 为 ["type": "text", "text": 卸载占位文本(块)]
    否则如果 是工具结果块(块):
      设 内层 为 块.获取("content", 空)
      如果 是列表(内层):
        设 新内层 为 替换卸载图像(内层)
        如果 新内层 != 内层:
          设 投影 为 副本(块)
          投影["content"] 为 新内层
    如果 投影 != 块:
      如果 下一 == 空:
        设 下一 为 []
        设 j 为 0
        当 j < i:
          列表追加(下一, 块表[j])
          设 j 为 j + 1
      列表追加(下一, 投影)
    否则:
      如果 下一 != 空:
        列表追加(下一, 投影)
    设 i 为 i + 1
  如果 下一 == 空:
    返回 块表
  返回 下一

# 单消息占位渲染（对齐 upstream projectOffloadedImages 的单条形态）：无卸载时返回原消息
段落 替换消息卸载占位 接收 消息:
  如果 (是字典(消息) == 假):
    返回 消息
  设 内容 为 消息.获取("content", 空)
  如果 (是列表(内容) == 假):
    返回 消息
  设 新内容 为 替换卸载图像(内容)
  如果 新内容 == 内容:
    返回 消息
  设 结果 为 副本(消息)
  结果["content"] 为 新内容
  返回 结果

# 卸载块表（对齐 upstream offloadMessageImages 的 visit）：深度优先标记，命中即浅拷贝该图像块
#   状态 = {"计数": 已遍历图像出现位置数, "命中": 已标记数}；未命中任何下标时原样返回同一列表。
段落 卸载块表 接收 块表, 索引表, 状态:
  设 下一 为 空
  设 i 为 0
  当 i < 长度(块表):
    设 块 为 块表[i]
    设 投影 为 块
    如果 是图像块(块):
      设 目标下标 为 -1
      如果 状态["命中"] < 长度(索引表):
        设 目标下标 为 索引表[状态["命中"]]
      如果 目标下标 == 状态["计数"]:
        如果 块.获取("offloaded", 假) == 真:
          抛出 新建 错误("image/offload: image index " + 转字符串(状态["计数"]) + " is already offloaded")
        设 投影 为 副本(块)
        投影["offloaded"] 为 真
        设 状态["命中"] 为 状态["命中"] + 1
      设 状态["计数"] 为 状态["计数"] + 1
    否则如果 是工具结果块(块):
      设 内层 为 块.获取("content", 空)
      如果 是列表(内层):
        设 新内层 为 卸载块表(内层, 索引表, 状态)
        如果 新内层 != 内层:
          设 投影 为 副本(块)
          投影["content"] 为 新内层
    如果 投影 != 块:
      如果 下一 == 空:
        设 下一 为 []
        设 j 为 0
        当 j < i:
          列表追加(下一, 块表[j])
          设 j 为 j + 1
      列表追加(下一, 投影)
    否则:
      如果 下一 != 空:
        列表追加(下一, 投影)
    设 i 为 i + 1
  如果 下一 == 空:
    返回 块表
  返回 下一

# 卸载消息图像（对齐 upstream offloadMessageImages）：返回浅拷贝消息；选中下标必须存在且未卸载
段落 卸载消息图像 接收 消息, 索引表:
  如果 (是字典(消息) == 假):
    抛出 新建 错误("image/offload: target message must be an object")
  设 内容 为 消息.获取("content", 空)
  如果 (是列表(内容) == 假):
    抛出 新建 错误("image/offload: target message must have content blocks")
  设 状态 为 ["计数": 0, "命中": 0]
  设 新内容 为 卸载块表(内容, 索引表, 状态)
  如果 状态["命中"] != 长度(索引表):
    抛出 新建 错误("image/offload: image index " + 转字符串(索引表[状态["命中"]]) + " does not exist")
  设 结果 为 副本(消息)
  结果["content"] 为 新内容
  返回 结果

# 校验 image/offload 载荷（对齐 upstream project 的原子校验；违规抛错，返回规范目标表）
段落 校验图像卸载载荷 接收 数据, 节点表, 事件表:
  如果 (是字典(数据) == 假):
    抛出 新建 错误("image/offload: data must contain a nonempty targets array")
  设 数据键 为 字典键列表(数据)
  如果 (长度(数据键) != 1) 或 (列表包含(数据键, "targets") == 假):
    抛出 新建 错误("image/offload: data must contain a nonempty targets array")
  设 目标表 为 数据["targets"]
  如果 (是列表(目标表) == 假) 或 (长度(目标表) == 0):
    抛出 新建 错误("image/offload: data must contain a nonempty targets array")
  设 已见 为 {}
  设 结果 为 []
  遍历 目标 之 目标表:
    如果 (是字典(目标) == 假):
      抛出 新建 错误("image/offload: each target must contain a seq and nonempty imageIndexes")
    设 目标键 为 字典键列表(目标)
    如果 (长度(目标键) != 2) 或 (列表包含(目标键, "seq") == 假) 或 (列表包含(目标键, "imageIndexes") == 假):
      抛出 新建 错误("image/offload: each target must contain a seq and nonempty imageIndexes")
    设 序号 为 目标["seq"]
    如果 (是非负安全序号(序号) == 假):
      抛出 新建 错误("image/offload: each target must contain a seq and nonempty imageIndexes")
    如果 (列表包含(节点表, 序号) == 假):
      抛出 新建 错误("image/offload: target seq " + 转字符串(序号) + " is not a current surface node")
    如果 字典包含键(已见, 序号) == 真:
      抛出 新建 错误("image/offload: duplicate target seq " + 转字符串(序号))
    设 种类 为 ""
    设 源事件 为 取事件序号(事件表, 序号)
    如果 源事件 != 空:
      设 种类 为 源事件["类型"]
    如果 (种类 != "user/message") 且 (种类 != "tool/result"):
      抛出 新建 错误("image/offload: target seq " + 转字符串(序号) + " must be user/message or tool/result")
    设 索引表 为 目标["imageIndexes"]
    如果 (是列表(索引表) == 假) 或 (长度(索引表) == 0):
      抛出 新建 错误("image/offload: each target must contain a seq and nonempty imageIndexes")
    设 前值 为 -1
    遍历 索引 之 索引表:
      如果 (是非负安全序号(索引) == 假) 或 (索引 <= 前值):
        抛出 新建 错误("image/offload: imageIndexes must be strictly increasing non-negative safe integers")
      设 前值 为 索引
    列表追加(结果, ["seq": 序号, "imageIndexes": 索引表])
    已见[序号] 为 真
  返回 结果

# 投影图像卸载（对齐 upstream imageOffloadProjection.project）：
#   按事件顺序叠加每个 image/offload 决策，返回 {序号: 投影后消息} 供 fold 优先取用。
段落 投影图像卸载 接收 事件表:
  设 覆盖表 为 {}
  设 节点表 为 当前表面节点(事件表)
  遍历 事件项 之 事件表:
    如果 事件项["类型"] != "image/offload":
      继续
    设 目标表 为 校验图像卸载载荷(事件项.获取("数据", 空), 节点表, 事件表)
    设 已见 为 {}
    遍历 目标 之 目标表:
      设 序号 为 目标["seq"]
      如果 字典包含键(已见, 序号) == 真:
        抛出 新建 错误("image/offload: duplicate target seq " + 转字符串(序号))
      设 源消息 为 空
      如果 字典包含键(覆盖表, 序号) == 真:
        设 源消息 为 覆盖表[序号]
      否则:
        设 源消息 为 投影节点消息(取事件序号(事件表, 序号))
        如果 源消息 == 空:
          抛出 新建 错误("image/offload: target seq " + 转字符串(序号) + " must produce a message")
      设 投影后 为 卸载消息图像(源消息, 目标["imageIndexes"])
      覆盖表[序号] 为 投影后
      已见[序号] 为 真
  返回 覆盖表

# 模型可见消息表（图像卸载投影 + 占位文本渲染）：读 0.1.6 会话日志的正式入口
段落 投影消息产生带卸载 接收 事件表:
  设 覆盖表 为 投影图像卸载(事件表)
  设 表面 为 投影表面消息(事件表, 覆盖表)
  设 结果 为 []
  遍历 消息 之 表面["消息表"]:
    列表追加(结果, 替换消息卸载占位(消息))
  返回 结果

# 导出清单
导出 是追加表面事件, 是替换表面事件, 是非负安全序号, 校验表面标记, 投影消息产生
导出 校验节点0角色形状, 校验V3系统头, 补验V2V3迁移
导出 安全整数, 非负整数, 判版本, 版本文本, 同版本, 版本小, 校验快照
导出 中断轮闭合器, 恢复码工具未启动, 恢复码结果未知
导出 事件词汇表, 已知事件类型, 校验事件载荷
导出 造头, 头版本号, 头版本为
导出 造事件, 事件带来源
导出 解码V0头, 编码V0头, 解码V0事件, 解码V0打包行
导出 解码V2头, 编码V2头, 解码V2事件, 编码V2事件
导出 解码V3事件, 恢复会话事件
导出 V0编解码, V1编解码, V2编解码, V3编解码
导出 定义迁移, 创建链, 迁移会话, 重排序号
导出 迁移头V0V1, 迁移事件V0V1, 迁移头V1V2, 迁移事件V1V2, 迁移头V2V3, 迁移事件V2V3
导出 造目录, 目录读头, 目录恢复, 目录编码头, 目录编码事件, 当前目录
导出 记录系统提示, 投影节点0, 记录助手轮, 投影内嵌消息
导出 表面可入类型, 表面操作取值, 是替换操作, 是表面事件, 空内容判定
导出 投影节点消息, 校验表面事件数据, 投影表面消息
导出 日志文件名
# R51 任务1：image/offload 投影面
导出 取事件序号, 当前表面节点, 是图像块, 是工具结果块, 图像身份, 卸载占位文本
导出 替换卸载图像, 替换消息卸载占位, 卸载块表, 卸载消息图像, 校验图像卸载载荷
导出 投影图像卸载, 投影消息产生带卸载
