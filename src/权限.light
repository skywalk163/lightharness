# 权限.light —— E4：权限预设 + 工具分类 + bash 命令分类 + 危险命令检测
#
# 契约：
#   - 4 种预设：全放行 / 按类别（默认）/ 全拒绝 / 自定义
#   - 分类返回：放行 / 审批 / 拒绝
#   - 按类别：读文件/搜索文件 放行；写文件/bash 修改命令/bash 网络命令 审批；
#     bash 危险命令 拒绝；bash 只读命令（ls/cat/grep/whoami/pwd/echo/git status/git log）放行
#   - 危险命令：默认列表（rm -rf /、mkfs、dd if=/dev/zero、fork bomb、chmod 777 /、> /dev/sda）
#   - 环境变量：
#       HARNESS_PERMISSION_MODE = 全放行 / 按类别 / 全拒绝 / 自定义（默认：按类别）
#
# ⚠️ 光明命名规范 v1：局部名避用 数/序/事件/头/原因 等关键字；
#    空 是保留字，勿作变量名；不用 hex 字面量。
#    类体中 if/否则 分支后不接同级语句，多分支时用提前返回写法。

导入 os

# ---- 预设名常量 ----
设 预设全放行 为 "全放行"
设 预设按类别 为 "按类别"
设 预设全拒绝 为 "全拒绝"
设 预设自定义 为 "自定义"

# ---- 分类返回值常量 ----
设 分类放行 为 "放行"
设 分类审批 为 "审批"
设 分类拒绝 为 "拒绝"

# ---- bash 只读命令白名单（首词）----
设 只读命令表 为 ["ls", "cat", "grep", "whoami", "pwd", "echo", "head", "tail", "wc", "find", "less", "more"]

# ---- bash 需审批命令（首词或首词+子命令）----
设 修改命令表 为 ["rm", "mv", "cp", "mkdir", "chmod", "chown", "rmdir", "truncate", "install"]
设 网络命令表 为 ["curl", "wget", "ssh", "scp", "rsync"]

# ---- git/npm/pip 等需审批的子命令（前缀匹配）----
设 需审批子命令表 为 ["git commit", "git push", "git pull", "git reset", "git clean", "git merge", "git rebase", "npm install", "pip install", "docker run", "docker stop", "docker rm", "kubectl apply"]
设 放行子命令表 为 ["git status", "git log", "git diff", "git branch", "git show", "git remote", "pip list", "npm list", "docker ps", "kubectl get"]

# ---- 默认危险命令模式（子串匹配）----
#   用子串匹配（光明语无正则），每个模式是"必须全部出现"的字面片段；避免误伤
设 危险模式表 为 [
  "rm -rf /", "rm -rf /*", "rm -rf ~", "rm -rf $HOME",
  "mkfs",
  "dd if=/dev/zero", "dd of=/dev/sda", "dd of=/dev/hda", "dd if=/dev/urandom",
  ":(){ :|:& };:",
  "chmod 777 /", "chmod 777 ~",
  "> /dev/sda", "> /dev/hda",
  "shred -u /", "shred /dev",
  "shutdown", "reboot", "halt",
  "mkswap", "fdisk", "parted"
]


# ============================================================
# 权限管理器：持有预设 + 自定义表 + 危险模式 + 审批超时
# ============================================================
类 权限管理器:
  属性 预设 等于 ""
  属性 自定义表 等于 空
  属性 危险模式 等于 空
  属性 审批超时 等于 300

  段落 构造:
    设 己.预设 为 环境变量("HARNESS_PERMISSION_MODE", 预设按类别)
    设 己.自定义表 为 {}
    设 己.危险模式 为 危险模式表
    设 超时串 为 环境变量("HARNESS_APPROVAL_TIMEOUT", "300")
    设 己.审批超时 为 转整数(超时串)

  # 热更新预设（配置面板切换时调用）
  段落 设置预设 接收 预设:
    设 己.预设 为 预设
    返回 真

  # 设置自定义工具权限：工具名 → 放行 / 审批 / 拒绝
  段落 设置自定义 接收 工具名, 分类:
    己.自定义表[工具名] 为 分类
    返回 真

  # 追加危险命令模式
  段落 追加危险模式 接收 片段:
    己.危险模式.追加(片段)
    返回 真

  段落 当前预设:
    返回 己.预设

  # 检测 bash 命令是否为危险命令（子串匹配危险模式）
  段落 是危险命令 接收 命令:
    如果 命令 == 空 或 命令 == "":
      返回 假
    遍历 模式 之 己.危险模式:
      如果 命令.查找(模式) >= 0:
        返回 真
    返回 假

  # 分类 bash 命令：返回 放行 / 审批 / 拒绝
  段落 分类bash命令 接收 命令:
    如果 命令 == 空 或 命令 == "":
      返回 分类放行
    # 危险命令优先
    如果 己.是危险命令(命令) == 真:
      返回 分类拒绝
    # 首词（跳过前导空白）
    设 去空白 为 命令
    设 首 为 0
    当 首 < 长度(去空白):
      如果 去空白[首] == " ":
        设 首 为 首 + 1
      否则:
        跳出
    设 首词起 为 首
    设 首词尾 为 首
    当 首词尾 < 长度(去空白):
      设 字符 为 去空白[首词尾]
      如果 字符 == " " 或 字符 == "\t":
        跳出
      设 首词尾 为 首词尾 + 1
    设 首词 为 去空白[首词起:首词尾]
    # 只读命令
    如果 只读命令表.包含(首词):
      返回 分类放行
    # 需审批的修改命令
    如果 修改命令表.包含(首词):
      返回 分类审批
    # 网络命令
    如果 网络命令表.包含(首词):
      返回 分类审批
    # 子命令前缀匹配（git commit / npm install 等）
    遍历 前缀 之 需审批子命令表:
      如果 去空白.查找(前缀) == 首词起:
        返回 分类审批
    遍历 放行前缀 之 放行子命令表:
      如果 去空白.查找(放行前缀) == 首词起:
        返回 分类放行
    # 默认：bash 未知命令 → 审批（保守）
    返回 分类审批

  # 工具分类：读文件/搜索/ls 放行；写文件/bash 按命令分类；其它 审批
  段落 分类工具 接收 工具名, 参数:
    如果 工具名 == 空 或 工具名 == "":
      返回 分类审批
    # 安全类：读文件/搜索/列表（多种命名兼容）
    如果 工具名.查找("读文件") >= 0 或 工具名.查找("读取文件") >= 0 或 工具名.查找("读文本") >= 0:
      返回 分类放行
    如果 工具名.查找("搜索") >= 0 或 工具名.查找("search") >= 0 或 工具名.查找("grep") >= 0:
      返回 分类放行
    如果 工具名 == "ls" 或 工具名 == "list":
      返回 分类放行
    # 危险工具（bash 需按命令分类）
    如果 工具名 == "bash" 或 工具名 == "sh" 或 工具名 == "shell":
      设 命令 为 ""
      如果 参数 != 空 且 type(参数) == dict:
        如果 参数.包含("command"):
          设 命令 为 转字符串(参数["command"])
        否则 如果 参数.包含("cmd"):
          设 命令 为 转字符串(参数["cmd"])
        否则 如果 参数.包含("命令"):
          设 命令 为 转字符串(参数["命令"])
      返回 己.分类bash命令(命令)
    # 写文件类 → 审批
    如果 工具名.查找("写文件") >= 0 或 工具名.查找("写入") >= 0 或 工具名.查找("写") >= 0:
      返回 分类审批
    # 删除类 → 审批
    如果 工具名.查找("删除") >= 0 或 工具名.查找("delete") >= 0 或 工具名.查找("remove") >= 0:
      返回 分类审批
    # 默认：审批
    返回 分类审批

  # 综合检查：按预设返回 放行 / 审批 / 拒绝
  段落 检查 接收 工具名, 参数:
    设 分类 为 己.分类工具(工具名, 参数)
    如果 己.预设 == 预设全放行:
      返回 分类放行
    如果 己.预设 == 预设全拒绝:
      返回 分类拒绝
    如果 己.预设 == 预设自定义:
      如果 己.自定义表.包含(工具名):
        返回 己.自定义表[工具名]
      # 自定义模式下未配置的工具走"按类别"逻辑
    # 按类别：直接返回分类结果
    返回 分类

导出 权限管理器
导出 预设全放行
导出 预设按类别
导出 预设全拒绝
导出 预设自定义
导出 分类放行
导出 分类审批
导出 分类拒绝
