# 任务事件总线.light —— 本地任务册的事件路由（JobEventHub：作用域分层 subscribe/emit）
#
# 对齐原版：
#   packages/jobs/jobs-local/src/events.ts（@deepseek-ai/dsh-jobs-local/events）
#     L20-24  Subscription { filter, listener }
#     L33-44  JobLayer：controllers + scoped({owners:'scope'}) 两张匿名表
#     L56-69  JobEventHub 构造：unscoped 集 + layers 层组 + warn 沉降
#     L80-99  subscribe：{owners:'scope'} 归入注册上下文作用域层；其余入 unscoped
#     L107-128 emit：unscoped 按 owner 过滤；全局 scoped 全收；沿 owner 作用域链逐层分发
#     L130-137 deliver：监听器异常 containment，沉降到 warn 不击穿已提交事务
#
# 复刻边界（去 Cordis/Node 宿主）：
#   - AnonymousEntries/ScopedLayers/ctx.effect 替换为纯数据：
#       全域表（{owner} / {owners:'all'}）、全局层（无作用域上下文注册的 scope 订阅）、
#       作用域表（scopeId → 订阅表）。
#   - 作用域链不内置父表：emit 由调用方直接传入「归属作用域链」（scopeId 列表，自叶向根），
#     对应原版 scopeOf(owner.ctx) → chainLayers(scope)。父链建模属 作用域.light 职责，此处不重复。
#   - warn 沉降为告警表（可断言），不写真实日志。
#
# ⚠️ 命名铁律：避开词根 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/
#            模式(含模)/用量/打印/抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回。
#   （模块名「任务事件总线」为任务书指定；内部标识符用 监听器/订阅/分发，避免歧义。）

# =====================================================================
# 订阅登记
# =====================================================================

# 造一条订阅记录（events.ts L20-24 Subscription）
段落 造订阅(过滤, 监听器):
  返回 ["过滤": 过滤, "监听器": 监听器]

# =====================================================================
# 任务总线（events.ts JobEventHub）
# =====================================================================
类 任务总线:
  属性 全域表 等于 空
  属性 全局层 等于 空
  属性 作用域表 等于 空
  属性 告警表 等于 空

  段落 构造:
    设 己.全域表 为 []
    设 己.全局层 为 []
    设 己.作用域表 为 {}
    设 己.告警表 为 []

  # 注册一条订阅（events.ts L80-99 subscribe）
  #   注册作用域：空 = 无作用域上下文（全局层）；否则为该作用域的 scopeId
  #   过滤：{"owner": X} / {"owners": "all"} / {"owners": "scope"}
  #   返回注销器（调用即移除该订阅）
  段落 订阅(注册作用域, 过滤, 监听器):
    设 订阅 为 造订阅(过滤, 监听器)
    设 存于作用域 为 假
    如果 字典包含键(过滤, "owners"):
      如果 过滤["owners"] == "scope":
        设 存于作用域 为 真
    如果 存于作用域:
      如果 注册作用域 == 空:
        己.全局层.追加(订阅)
        返回 造注销(己, "全局层", 空, 订阅)
      否则:
        如果 字典包含键(己.作用域表, 注册作用域) == 假:
          设 己.作用域表[注册作用域] 为 []
        己.作用域表[注册作用域].追加(订阅)
        返回 造注销(己, "作用域表", 注册作用域, 订阅)
    己.全域表.追加(订阅)
    返回 造注销(己, "全域表", 空, 订阅)

  # 分发一条（events.ts L107-128 emit）
  #   归属标识：任务确切归属 id（字符串）；无主任务传 空
  #   归属作用域链：归属 agent 的作用域链（scopeId 列表，自叶向根）；无主任务传 []
  段落 分发(报文, 归属标识, 归属作用域链):
    # 1) 全域订阅：{owner: X} 只在报文归属匹配时收；{owners:'all'} 全收；无主报文对所有全域订阅可达
    遍历 订阅 之 己.全域表:
      设 过滤 为 订阅["过滤"]
      如果 字典包含键(过滤, "owner"):
        如果 归属标识 != 空:
          如果 归属标识 != 过滤["owner"]:
            跳过
      己.送达(订阅, 报文)
    # 2) 全局 scoped 层：无作用域上下文注册的 scope 订阅收一切
    遍历 订阅 之 己.全局层:
      己.送达(订阅, 报文)
    # 3) 沿归属作用域链逐层分发（父收子任务的报文）
    遍历 作用域ID 之 归属作用域链:
      如果 字典包含键(己.作用域表, 作用域ID):
        遍历 订阅 之 己.作用域表[作用域ID]:
          己.送达(订阅, 报文)

  # 送达单条（events.ts L130-137 deliver）：监听器异常 containment，沉降告警
  段落 送达(订阅, 报文):
    尝试:
      订阅["监听器"](报文)
    捕获 异常 为 错:
      己.告警表.追加("jobs: listener threw: " + 转字符串(错))

  # 告警快照（供测试断言 containment）
  段落 告警列表:
    返回 己.告警表

  # 订阅计数（便于测试断言注销生效）
  段落 存活计数:
    设 n 为 列表长度(己.全域表) + 列表长度(己.全局层)
    遍历 作用域ID 之 字典键列表(己.作用域表):
      设 n 为 n + 列表长度(己.作用域表[作用域ID])
    返回 n

# =====================================================================
# 注销器（events.ts subscribe 返回的 disposer；幂等由「移除即删」保证）
# =====================================================================
段落 造注销(总线, 表名, 作用域ID, 订阅):
  段落 注销:
    设 新表 为 []
    如果 表名 == "全域表":
      遍历 项 之 总线.全域表:
        如果 项 != 订阅:
          新表.追加(项)
      设 总线.全域表 为 新表
    否则:
      如果 表名 == "全局层":
        遍历 项 之 总线.全局层:
          如果 项 != 订阅:
            新表.追加(项)
        设 总线.全局层 为 新表
      否则:
        遍历 项 之 总线.作用域表[作用域ID]:
          如果 项 != 订阅:
            新表.追加(项)
        设 总线.作用域表[作用域ID] 为 新表
  返回 注销

导出 造订阅
导出 任务总线
