# 授权链.light —— authorization 纯逻辑面（对齐上游 packages/credentials/authorization/src/index.ts + types.ts）
#
# 复刻范围（剔除宿主胶水 ctx.effect / events.dispatch / credentials 事件 / AbortSignal）：
#   1. 类型形状：方法 / 通知 / 选项 / 提问(文本|机密|选择) / 状态 / 结算 / 结果 / 条目
#   2. 错误族：授权错误(消息, 码) / 授权被拒错误(DECLINED)
#   3. 注册表：注册流程(重复键抛 DUPLICATE_FLOW) / 列出流程 / 描述流程 / 取消流程
#   4. 入口 开始授权（校验链顺序不可乱）：
#      NO_FLOW → UNKNOWN_METHOD → ALREADY_IN_FLIGHT → 已中止(不占槽) → 占槽 →
#      执行尝试 → 释放槽 → 结算广播（监听器失败隔离，INVARIANT 全跑完后重抛）
#   5. 执行尝试：中止竞态 / 提交观察(凭据已更新) / notify fire-and-forget /
#      prompt 被拒→cancelled / 运行抛错分类(被拒→cancelled, 其他→重抛) /
#      未提交→NOT_COMMITTED / 提交且未中止→authorized
#   6. 中止模拟：光明无 AbortSignal，用 运行上下文["中止标志"] + 中止处理器表
#
# 错误传递约定：光明 抛出 会将对象包装为 Exception，字典属性丢失。
#   本模块统一用 抛出 新建 错误("[" + 码 + "] " + 消息)，
#   捕获后 转字符串(错误) + 解析授权错误 还原 {码, 消息}。
#
# 命名：避开 为/空/回调 等保留字或词法陷阱（L-030/L-084/铁律8）。

# =====================================================================
# 1. 错误码常量（对齐上游 AuthorizationError code）
# =====================================================================
设 码无流程 为 "NO_FLOW"
设 码未知方法 为 "UNKNOWN_METHOD"
设 码已在飞 为 "ALREADY_IN_FLIGHT"
设 码未提交 为 "NOT_COMMITTED"
设 码重复流程 为 "DUPLICATE_FLOW"
设 码被拒 为 "DECLINED"
设 码不变 为 "INVARIANT"

# =====================================================================
# 2. 错误构造与解析
# =====================================================================

# 构造 "[CODE] 消息" 格式错误文本
段落 构造授权错误 接收 消息, 码:
    返回 "[" + 码 + "] " + 消息

# 解析 "[CODE] 消息" 格式文本，返回 ["码":码, "消息":消息]
段落 解析授权错误 接收 文本:
    如果 长度(文本) < 3:
        返回 ["码":"未知", "消息":文本]
    如果 文本[0] != "[":
        返回 ["码":"未知", "消息":文本]
    设 位置 为 1
    当 位置 < 长度(文本):
        如果 文本[位置] == "]":
            跳出
        设 位置 为 位置 + 1
    如果 位置 >= 长度(文本):
        返回 ["码":"未知", "消息":文本]
    设 码 为 截取(文本, 1, 位置)
    设 消息起点 为 位置 + 1
    如果 消息起点 < 长度(文本):
        如果 文本[消息起点] == " ":
            设 消息起点 为 消息起点 + 1
    设 消息 为 截取(文本, 消息起点, 长度(文本))
    返回 ["码":码, "消息":消息]

# 抛出授权错误（[CODE] 消息 格式）
段落 抛授权错误 接收 消息, 码:
    抛出 新建 错误(构造授权错误(消息, 码))

# 抛出授权被拒错误（DECLINED，默认文案 "授权提示被拒绝"）
段落 抛被拒错误 接收 消息:
    如果 消息 == 空:
        设 消息 为 "授权提示被拒绝"
    抛授权错误(消息, 码被拒)

# =====================================================================
# 3. 类型构造（对齐 types.ts）
# =====================================================================

段落 构造方法 接收 id, 标签:
    返回 ["id":id, "标签":标签]

段落 构造通知 接收 消息, url, 码:
    设 通知 为 ["消息":消息]
    如果 url != 空:
        设 通知["url"] 为 url
    如果 码 != 空:
        设 通知["码"] 为 码
    返回 通知

段落 构造选项 接收 id, 标签, 描述:
    设 选项 为 ["id":id, "标签":标签]
    如果 描述 != 空:
        设 选项["描述"] 为 描述
    返回 选项

段落 构造提问文本 接收 消息, 占位:
    设 提问 为 ["种类":"text", "消息":消息]
    如果 占位 != 空:
        设 提问["占位"] 为 占位
    返回 提问

段落 构造提问机密 接收 消息, 占位:
    设 提问 为 ["种类":"secret", "消息":消息]
    如果 占位 != 空:
        设 提问["占位"] 为 占位
    返回 提问

段落 构造提问选择 接收 消息, 选项表:
    返回 ["种类":"select", "消息":消息, "选项表":选项表]

# =====================================================================
# 4. 服务构造（状态容器：注册表 + 运行表 + 监听器表 + 提交观察表 + 日志）
# =====================================================================

段落 构造授权服务:
    返回 [
        "流程表":[],
        "键序表":[],
        "运行表":字典(),
        "监听器表":[],
        "提交观察表":[],
        "日志":[]
    ]

# =====================================================================
# 5. 注册表（对齐 registerFlow / list / describe / cancel）
# =====================================================================

# 注册流程，返回注销函数；重复键抛 DUPLICATE_FLOW
段落 注册流程 接收 服务, 流程:
    遍历 已有 之 服务["流程表"]:
        如果 已有["键"] == 流程["键"]:
            抛授权错误("授权流程 \"" + 流程["键"] + "\" 已注册", 码重复流程)
    服务["流程表"].添加(流程)
    服务["键序表"].添加(流程["键"])
    # 注销函数：移除流程，若在跑则置中止
    段落 注销:
        设 索引 为 0
        当 索引 < 长度(服务["流程表"]):
            如果 服务["流程表"][索引]["键"] == 流程["键"]:
                服务["流程表"].弹出(索引)
                跳出
            设 索引 为 索引 + 1
        设 索引2 为 0
        当 索引2 < 长度(服务["键序表"]):
            如果 服务["键序表"][索引2] == 流程["键"]:
                服务["键序表"].弹出(索引2)
                跳出
            设 索引2 为 索引2 + 1
        如果 字典包含键(服务["运行表"], 流程["键"]):
            设 上下文 为 服务["运行表"][流程["键"]]
            设 上下文["中止标志"] 为 真
            遍历 处理器 之 上下文["中止处理器表"]:
                处理器()
    返回 注销

# 列出所有注册流程（条目形状）
段落 列出流程 接收 服务:
    设 结果 为 []
    遍历 流程 之 服务["流程表"]:
        设 在飞 为 字典包含键(服务["运行表"], 流程["键"])
        结果.添加(["键":流程["键"], "标签":流程["标签"], "方法表":流程["方法表"], "在飞":在飞])
    返回 结果

# 描述单个流程（不存在返回 空）
段落 描述流程 接收 服务, 键:
    遍历 流程 之 服务["流程表"]:
        如果 流程["键"] == 键:
            设 在飞 为 字典包含键(服务["运行表"], 键)
            返回 ["键":流程["键"], "标签":流程["标签"], "方法表":流程["方法表"], "在飞":在飞]
    返回 空

# 取消指定键的在跑尝试（置中止标志）
段落 取消流程 接收 服务, 键:
    如果 字典包含键(服务["运行表"], 键):
        设 上下文 为 服务["运行表"][键]
        设 上下文["中止标志"] 为 真
        遍历 处理器 之 上下文["中止处理器表"]:
            处理器()

# 添加结算监听器（返回注销函数）
段落 添加结算监听器 接收 服务, 监听器:
    服务["监听器表"].添加(监听器)
    段落 移除监听器:
        设 索引 为 0
        当 索引 < 长度(服务["监听器表"]):
            如果 服务["监听器表"][索引] == 监听器:
                服务["监听器表"].弹出(索引)
                跳出
            设 索引 为 索引 + 1
    返回 移除监听器

# =====================================================================
# 6. 结算广播（对齐 settle：监听器失败隔离 + INVARIANT 全跑完后重抛）
# =====================================================================

段落 结算广播 接收 服务, 键, 结算:
    设 不变失败 为空
    遍历 监听器 之 服务["监听器表"]:
        尝试:
            监听器(键, 结算)
        捕获 错误:
            设 解析 为 解析授权错误(转字符串(错误))
            如果 解析["码"] == 码不变:
                如果 不变失败 == 空:
                    设 不变失败 为 错误
            否则:
                服务["日志"].添加("授权: authorization/settled 监听器失败: " + 转字符串(错误))
    如果 不变失败 != 空:
        抛出 不变失败

# =====================================================================
# 7. 执行尝试（对齐 attempt：中止竞态 + 提交观察 + notify/prompt 包装 + 提交契约）
# =====================================================================

段落 执行尝试 接收 服务, 流程, 方法, 运行上下文, 交互:
    # 观察表：凭据提交标记 + 被拒标记（闭包写入）
    设 观察 为 ["已拒绝":假, "已提交":假]
    # 提交观察器：模拟 credentials/record-updated 事件
    段落 提交观察器(键):
        如果 键 == 流程["键"]:
            设 观察["已提交"] 为 真
    设 观察器索引 为 长度(服务["提交观察表"])
    服务["提交观察表"].添加(提交观察器)

    # 构造会话（对齐 AuthorizationSession：method / signal / notify / prompt）
    段落 会话通知(通知项):
        尝试:
            交互["通知"](通知项)
        捕获 通知错误:
            服务["日志"].添加("授权: 交互表面无法渲染通知: " + 转字符串(通知错误))
    段落 会话提问(提问):
        尝试:
            返回 交互["提问"](提问)
        捕获 提问错误:
            设 解析 为 解析授权错误(转字符串(提问错误))
            如果 解析["码"] == 码被拒:
                设 观察["已拒绝"] 为 真
            抛出 提问错误
    段落 会话提交(键):
        遍历 处理器 之 服务["提交观察表"]:
            处理器(键)
    段落 会话是否中止:
        返回 运行上下文["中止标志"]
    设 会话 为 [
        "方法":方法,
        "通知":会话通知,
        "提问":会话提问,
        "提交":会话提交,
        "是否中止":会话是否中止
    ]

    # 运行流程（同步简化上游 Promise.race 中止竞态）
    设 运行错误 为空
    尝试:
        如果 运行上下文["中止标志"] == 真:
            服务["提交观察表"].弹出(观察器索引)
            返回 ["状态":"cancelled"]
        流程["运行"](会话)
        如果 运行上下文["中止标志"] == 真:
            服务["提交观察表"].弹出(观察器索引)
            返回 ["状态":"cancelled"]
        如果 观察["已拒绝"] == 真:
            服务["提交观察表"].弹出(观察器索引)
            返回 ["状态":"cancelled"]
    捕获 错误:
        如果 运行上下文["中止标志"] == 真:
            服务["提交观察表"].弹出(观察器索引)
            返回 ["状态":"cancelled"]
        如果 观察["已拒绝"] == 真:
            服务["提交观察表"].弹出(观察器索引)
            返回 ["状态":"cancelled"]
        设 运行错误 为 错误

    # finally：移除提交观察器
    服务["提交观察表"].弹出(观察器索引)

    如果 运行错误 != 空:
        抛出 运行错误

    # 提交契约：未提交抛 NOT_COMMITTED
    如果 观察["已提交"] != 真:
        抛授权错误("授权流程 \"" + 流程["键"] + "\" 在此尝试中解析但未提交凭据记录", 码未提交)

    返回 ["状态":"authorized"]

# =====================================================================
# 8. 入口 开始授权（对齐 begin：校验链 + 占槽 + finally 释放 + 结算广播）
# =====================================================================

段落 开始授权 接收 服务, 请求:
    设 键 为 请求["键"]

    # 校验1：无流程 → NO_FLOW
    设 流程 为空
    遍历 候选 之 服务["流程表"]:
        如果 候选["键"] == 键:
            设 流程 为 候选
    如果 流程 == 空:
        抛授权错误("没有为 \"" + 键 + "\" 注册授权流程", 码无流程)

    # 校验2：方法解析与校验 → UNKNOWN_METHOD
    设 方法 为 取可选(请求, "方法")
    如果 方法 == 空:
        设 方法 为 流程["方法表"][0]["id"]
    设 方法存在 为 假
    遍历 候选方法 之 流程["方法表"]:
        如果 候选方法["id"] == 方法:
            设 方法存在 为 真
    如果 方法存在 != 真:
        抛授权错误("授权流程 \"" + 键 + "\" 不提供方法 \"" + 方法 + "\"", 码未知方法)

    # 校验3：已在飞 → ALREADY_IN_FLIGHT
    如果 字典包含键(服务["运行表"], 键):
        抛授权错误("\"" + 键 + "\" 的授权尝试已在运行", 码已在飞)

    # 校验4：请求已中止 → 直接 cancelled（不占槽，校验仍先执行）
    如果 取可选(请求, "已中止") == 真:
        返回 ["状态":"cancelled"]

    # 占槽
    设 运行上下文 为 ["中止标志":假, "中止处理器表":[]]
    设 服务["运行表"][键] 为 运行上下文

    # 注册请求外部中止处理器（模拟 request.signal abort 事件）
    # 注意：嵌套段落定义须放在如果块之前（编译器限制：if 块内段落定义会破坏缩进跟踪）
    段落 外部中止:
        设 运行上下文["中止标志"] 为 真
        遍历 处理器 之 运行上下文["中止处理器表"]:
            处理器()
    设 注册中止 为 取可选(请求, "注册中止处理器")
    如果 注册中止 != 空:
        注册中止(外部中止)

    # 运行尝试 + finally 模拟（释放槽 + 结算广播）
    设 结算 为 "failed"
    设 结果 为空
    设 尝试错误 为空
    尝试:
        设 结果 为 执行尝试(服务, 流程, 方法, 运行上下文, 取可选(请求, "交互"))
        设 结算 为 结果["状态"]
    捕获 错误:
        设 尝试错误 为 错误

    # finally 开始：释放槽（先删，使监听器启动下一次尝试不被刚结束的拒绝）
    字典删除(服务["运行表"], 键)
    # 结算广播（INVARIANT 在此重抛，覆盖尝试结果，对齐上游 finally 语义）
    结算广播(服务, 键, 结算)
    # finally 结束

    如果 尝试错误 != 空:
        抛出 尝试错误
    返回 结果
