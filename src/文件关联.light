# 文件关联.light —— 对标上游 packages/util/native-command（锚点 877717787c，0.1.7 增量）
#
# 纯逻辑面：文件关联 / 默认应用解析的「字符串与结构」部分。
# 上游源文件:行号：
#   - src/desktop-entry.ts:31  desktopEntryFields（.desktop 主段字段解析）
#   - src/desktop-entry.ts:48  desktopDataDirectories（XDG 数据目录优先级）
#   - src/types.ts:21          parseNativeFileApplications（应用表形状校验）
#   - src/file-applications.ts:152 macField（可选串空化）
#   - src/file-applications.ts:177 compareVersions（点版数字序）
#   - src/file-applications.ts:130 dedupeMacApplications（同 bundle+名 折叠）
#   - src/file-applications-linux.ts:76 区域解析 / :81 应用名查选 / :63 内容类型 / :68 默认桌面
#   - src/file-applications-windows.ts:List（默认标记 + id 去重，COM 调用为宿主面）
#
# 宿主面剔除（不搬）：readFile/readdir/stat/真实路径 join、AssocQueryString/SHAssocEnumHandlers
#   COM、gio/open/wslpath 子进程、图标字节读取。本模块只吃「已拿到的文本/字典」做纯解析与校验。
#
# 语言坑：无正则（L-086），gio 输出用 查找子串+逐字符收集近似；布尔链拆顺序如果（L-043）。

# 通用子串（避免依赖外部导出；字符串获取 为码点取字）
段落 子串(文本, 起, 止):
  设 结果 为 ""
  设 i 为 起
  当 i < 止:
    设 结果 为 结果 + 字符串获取(文本, i)
    设 i 为 i + 1
  返回 结果

# ---------------------------------------------------------------------
# desktop-entry.ts:31 desktopEntryFields —— 解析 .desktop 主段 [Desktop Entry] 的键值
# ---------------------------------------------------------------------
段落 桌面项字段(文本):
  设 字段 为 {}
  设 在主段 为 假
  设 行表 为 文本.split("\n")
  遍历 行 之 行表:
    设 净 为 去除空白(行)
    如果 字符串长度(净) == 0:
      继续
    如果 字符串获取(净, 0) == "[":
      如果 净 == "[Desktop Entry]":
        设 在主段 为 真
      否则:
        设 在主段 为 假
      继续
    如果 在主段 == 假:
      继续
    如果 字符串获取(净, 0) == "#":
      继续
    设 等号 为 查找子串(净, "=")
    如果 等号 <= 0:
      继续
    设 键 为 去除空白(子串(净, 0, 等号))
    设 值 为 去除空白(子串(净, 等号 + 1, 字符串长度(净)))
    字典设置(字段, 键, 值)
  返回 字段

# ---------------------------------------------------------------------
# desktop-entry.ts:48 desktopDataDirectories —— XDG 数据目录优先级表
#   XDG_DATA_HOME ?? 主目录/.local/share，再冒号切 XDG_DATA_DIRS ?? /usr/local/share:/usr/share
# ---------------------------------------------------------------------
段落 桌面数据目录(主目录, 环境表):
  设 首位 为 主目录 + "/.local/share"
  如果 字典包含键(环境表, "XDG_DATA_HOME") == 真:
    如果 环境表["XDG_DATA_HOME"] != 空:
      设 首位 为 环境表["XDG_DATA_HOME"]
  设 次串 为 "/usr/local/share:/usr/share"
  如果 字典包含键(环境表, "XDG_DATA_DIRS") == 真:
    如果 环境表["XDG_DATA_DIRS"] != 空:
      设 次串 为 环境表["XDG_DATA_DIRS"]
  设 结果 为 [首位]
  设 段表 为 次串.split(":")
  遍历 段 之 段表:
    如果 字符串长度(去除空白(段)) > 0:
      列表追加(结果, 段)
  返回 结果

# ---------------------------------------------------------------------
# types.ts:21 parseNativeFileApplications 的图标形状校验（无正则近似）
#   合法：空 或 data:image/(png|svg+xml);base64,<base64字符>
# ---------------------------------------------------------------------
段落 是合法数据图标(图标):
  如果 图标 == 空:
    返回 真
  如果 开头(图标, "data:image/png;base64,") == 真:
    返回 是base64体(子串(图标, 字符串长度("data:image/png;base64,"), 字符串长度(图标)))
  如果 开头(图标, "data:image/svg+xml;base64,") == 真:
    返回 是base64体(子串(图标, 字符串长度("data:image/svg+xml;base64,"), 字符串长度(图标)))
  返回 假

段落 是base64体(体):
  如果 字符串长度(体) == 0:
    返回 假
  设 i 为 0
  当 i < 字符串长度(体):
    设 c 为 字符串获取(体, i)
    设 好 为 假
    设 码 为 码位(c)
    # A-Z 65-90 / a-z 97-122 / 0-9 48-57 / + 43 / / 47 / = 61
    如果 码 >= 65:
      如果 码 <= 90: 设 好 为 真
    如果 码 >= 97:
      如果 码 <= 122: 设 好 为 真
    如果 码 >= 48:
      如果 码 <= 57: 设 好 为 真
    如果 码 == 43: 设 好 为 真
    如果 码 == 47: 设 好 为 真
    如果 码 == 61: 设 好 为 真
    如果 好 == 假:
      返回 假
    设 i 为 i + 1
  返回 真

# ---------------------------------------------------------------------
# types.ts:21 parseNativeFileApplications —— 校验解码后的应用表
# ---------------------------------------------------------------------
段落 校验应用表(值):
  如果 是列表(值) == 假:
    抛出 新建 错误("Invalid native application list")
  设 结果 为 []
  遍历 项 之 值:
    如果 是字典(项) == 假:
      抛出 新建 错误("Invalid native application entry")
    如果 字典包含键(项, "id") == 假: 抛出 新建 错误("Invalid native application entry")
    如果 字典包含键(项, "name") == 假: 抛出 新建 错误("Invalid native application entry")
    如果 字典包含键(项, "default") == 假: 抛出 新建 错误("Invalid native application entry")
    如果 字典包含键(项, "icon") == 假: 抛出 新建 错误("Invalid native application entry")
    设 id 为 项["id"]
    设 name 为 项["name"]
    设 默认 为 项["default"]
    设 图标 为 项["icon"]
    如果 是字符串(id) == 假: 抛出 新建 错误("Invalid native application entry")
    如果 字符串长度(id) == 0: 抛出 新建 错误("Invalid native application entry")
    如果 是字符串(name) == 假: 抛出 新建 错误("Invalid native application entry")
    如果 是布尔(默认) == 假: 抛出 新建 错误("Invalid native application entry")
    如果 是合法数据图标(图标) == 假: 抛出 新建 错误("Invalid native application entry")
    列表追加(结果, ["id": id, "name": name, "default": 默认, "icon": 图标])
  返回 结果

# ---------------------------------------------------------------------
# file-applications.ts:152 macField —— 可选串：空/null/空串 → 空；非串抛错
# ---------------------------------------------------------------------
段落 空化可选串(字段):
  如果 字段 == 空:
    返回 空
  如果 是字符串(字段) == 假:
    抛出 新建 错误("Invalid native application entry")
  如果 字符串长度(字段) == 0:
    返回 空
  返回 字段

# ---------------------------------------------------------------------
# file-applications.ts:177 compareVersions —— 点版数字序（段缺省 0；缺失版排最低）
# ---------------------------------------------------------------------
# 段转数：Number(段) || 0 的纯逻辑投影（转整数 失败回 0）
段落 段转数(段):
  尝试:
    设 数 为 转整数(段)
  捕获 异常:
    返回 0
  如果 数 == 空:
    返回 0
  返回 数

段落 点版次序(左, 右):
  如果 左 == 空:
    如果 右 == 空: 返回 0
    返回 -1
  如果 右 == 空:
    返回 1
  设 甲表 为 转字符串(左).split(".")
  设 乙表 为 转字符串(右).split(".")
  设 总长 为 列表长度(甲表)
  如果 列表长度(乙表) > 总长: 设 总长 为 列表长度(乙表)
  设 i 为 0
  当 i < 总长:
    设 甲段 为 0
    设 乙段 为 0
    如果 i < 列表长度(甲表): 设 甲段 为 段转数(甲表[i])
    如果 i < 列表长度(乙表): 设 乙段 为 段转数(乙表[i])
    设 差 为 甲段 - 乙段
    如果 差 != 0:
      返回 差
    设 i 为 i + 1
  返回 0

# ---------------------------------------------------------------------
# file-applications.ts:130 dedupeMacApplications —— 同 bundle+显示名 折叠到首组位
#   组内：已有默认则不动；否则当前默认 或 版本更高者上位
# ---------------------------------------------------------------------
段落 折叠Mac应用(应用表):
  设 序表 为 []
  设 组位 为 {}
  遍历 应用 之 应用表:
    设 束 为 应用["bundle"]
    如果 束 == 空:
      列表追加(序表, 应用)
      继续
    设 键 为 束 + "\u0000" + 应用["name"]
    如果 字典包含键(组位, 键) == 假:
      字典设置(组位, 键, 列表长度(序表))
      列表追加(序表, 应用)
      继续
    设 持 为 序表[字典获取(组位, 键, 0)]
    如果 持["default"] == 真:
      继续
    如果 应用["default"] == 真:
      字典设置(序表, 字典获取(组位, 键, 0), 应用)
      继续
    如果 点版次序(应用["version"], 持["version"]) > 0:
      字典设置(序表, 字典获取(组位, 键, 0), 应用)
  设 结果 为 []
  遍历 应用 之 序表:
    列表追加(结果, ["id": 应用["id"], "name": 应用["name"], "default": 应用["default"], "icon": 应用["icon"]])
  返回 结果

# ---------------------------------------------------------------------
# file-applications-linux.ts 区域与应用名纯逻辑
#   区域 = (LC_ALL ?? LC_MESSAGES ?? LANG ?? "") 去 '.' 后段；应用名 = Name[区域] ?? Name[语言] ?? Name
# ---------------------------------------------------------------------
段落 解区域(环境表):
  设 值 为 ""
  如果 字典包含键(环境表, "LC_ALL") == 真:
    如果 环境表["LC_ALL"] != 空: 设 值 为 环境表["LC_ALL"]
  如果 值 == "":
    如果 字典包含键(环境表, "LC_MESSAGES") == 真:
      如果 环境表["LC_MESSAGES"] != 空: 设 值 为 环境表["LC_MESSAGES"]
  如果 值 == "":
    如果 字典包含键(环境表, "LANG") == 真:
      如果 环境表["LANG"] != 空: 设 值 为 环境表["LANG"]
  设 点 为 查找子串(值, ".")
  如果 点 < 0:
    返回 值
  返回 子串(值, 0, 点)

段落 查应用名(字段, 区域):
  如果 区域 != "":
    设 键全 为 "Name[" + 区域 + "]"
    如果 字典包含键(字段, 键全) == 真:
      返回 字段[键全]
    设 下划 为 查找子串(区域, "_")
    如果 下划 > 0:
      设 语言 为 子串(区域, 0, 下划)
      设 键短 为 "Name[" + 语言 + "]"
      如果 字典包含键(字段, 键短) == 真:
        返回 字段[键短]
  返回 字段["Name"]

# ---------------------------------------------------------------------
# file-applications-linux.ts:63/68 gio 输出纯解析（无正则近似）
# ---------------------------------------------------------------------
# 从 "standard::content-type: text/plain" 形文本取 content-type 尾令牌
段落 解内容类型(信息文本):
  设 锚 为 "standard::content-type:"
  设 位 为 查找子串(信息文本, 锚)
  如果 位 < 0:
    抛出 新建 错误("GIO did not identify the file content type")
  设 i 为 位 + 字符串长度(锚)
  设 长 为 字符串长度(信息文本)
  当 i < 长:
    设 c 为 字符串获取(信息文本, i)
    如果 c != " " 且 c != "\t":
      跳出
    设 i 为 i + 1
  设 起 为 i
  当 i < 长:
    设 c 为 字符串获取(信息文本, i)
    如果 c == " " 或 c == "\t" 或 c == "\r" 或 c == "\n":
      跳出
    设 i 为 i + 1
  如果 i <= 起:
    抛出 新建 错误("GIO did not identify the file content type")
  返回 子串(信息文本, 起, i)

# 从 gio mime 输出取默认 .desktop 与全部候选 id（默认在前，去重保序）
段落 解默认桌面(输出文本):
  设 默认 为 空
  设 锚 为 "Default application"
  设 位 为 查找子串(输出文本, 锚)
  如果 位 >= 0:
    设 冒 为 查找子串(子串(输出文本, 位, 字符串长度(输出文本)), ":")
    如果 冒 >= 0:
      设 j 为 位 + 冒 + 1
      设 长 为 字符串长度(输出文本)
      当 j < 长:
        设 c 为 字符串获取(输出文本, j)
        如果 c == " " 或 c == "\t":
          设 j 为 j + 1
          继续
        跳出
      设 起 为 j
      当 j < 长:
        设 c 为 字符串获取(输出文本, j)
        如果 c == "\r" 或 c == "\n":
          跳出
        设 j 为 j + 1
      设 段 为 去除空白(子串(输出文本, 起, j))
      如果 结尾(段, ".desktop") == 真:
        设 默认 为 段
  设 表 为 []
  如果 默认 != 空:
    列表追加(表, 默认)
  设 行表 为 输出文本.split("\n")
  遍历 行 之 行表:
    # 上游正则 ^\s+.*\.desktop\s*$：仅收以空白开头（缩进）且以 .desktop 结尾的行
    设 首字 为 字符串获取(行, 0)
    如果 首字 != " ":
      如果 首字 != "\t":
        继续
    设 净 为 去除空白(行)
    如果 结尾(净, ".desktop") == 假:
      继续
    如果 列表包含(表, 净) == 真:
      继续
    列表追加(表, 净)
  返回 ["默认": 默认, "表": 表]

# ---------------------------------------------------------------------
# file-applications-windows.ts:List 默认标记纯逻辑（COM 查询为宿主面；此处吃已查回的 id 列表）
#   @default = id 等于 可执行(progid, kind=2) 或 应用id(kind=21)（大小写不敏感）；按 id 去重
# ---------------------------------------------------------------------
段落 标Windows默认(句柄表, 可执行, 应用id):
  设 见 为 {}
  设 结果 为 []
  遍历 句柄 之 句柄表:
    设 id 为 句柄["id"]
    设 键 为 转大写(id)
    如果 字典包含键(见, 键) == 真:
      继续
    字典设置(见, 键, 真)
    设 是默认 为 假
    如果 可执行 != 空:
      如果 转大写(id) == 转大写(可执行): 设 是默认 为 真
    如果 应用id != 空:
      如果 转大写(id) == 转大写(应用id): 设 是默认 为 真
    列表追加(结果, ["id": id, "name": 句柄["name"], "icon": 句柄["icon"], "default": 是默认])
  返回 结果
