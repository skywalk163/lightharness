# 工具展示.light —— 第 38 轮 任务 1：agent-tool-presentation 核心模块复刻
#
# 上游（本地基线 0.1.5-rc.2，与 GitHub master 一致）：
#   G:\github\deepseek-harness\packages\core\agent-tool-presentation\src\index.ts（72 行，全文精读）
#   G:\github\deepseek-harness\packages\core\agent-tool-presentation\tests\agent-tool-presentation.spec.ts（官方 7 用例 + 隐含 disposer 共 8 契约）
#
# 上游 → 光明对照表：
#   name = 'tool-presentation'                                    → 工具展示插件名（常量 工具展示插件名）
#   inject = ['tools']                                            → 只声明工具依赖（常量 工具展示依赖 = ["tools"]）
#   Config = { mode: 'native'|'ptc'|'both' }（mode 必填）         → 建工具展示配置 + 校验展示模式
#   apply(ctx, config): native→ctx.tools.presentAs('native')      → 应用工具展示（native 分支）
#   apply: ptc/both→ctx.inject(['codeRuntime'], ...presentAs)     → 应用工具展示（ptc/both 分支 + 待代码运行时）
#   presentAs 返回 disposer（随 row 卸载解除）                     → 应用工具展示 返回配置句柄；注销工具展示 即 disposer
#   作用域隔离（每 composition 一行，覆盖该 preset 下所有 agent）   → 模块级 作用域展示表（按 作用域ID 存储模式）
#   codeRuntime 条件等待（mount 时失败而非 prompt 时）             → 待代码运行时 状态 + 等待代码运行时
#
# 光明适配要点：
#   - 光明没有 cordis/Service：作用域展示用模块级字典 作用域展示表（作用域ID → 模式）承载；
#     presentAs 即「写入该作用域的模式」；disposer 即「删除该作用域条目（回退部署默认）」。
#   - 光明没有 schemastery：mode 校验用手动谓词 校验展示模式（枚举 native/ptc/both）；
#     mode 必填、不设默认值（对齐上游 z.union([...]).required()）。
#   - 光明没有闭包：apply 返回配置句柄（字典），注销工具展示(句柄) 充当 disposer，语义逐用例等价。
#   - 工具注册表/代码运行时 以「入参」注入（依赖注入），不修改现有模块（对齐上游 host-plane 不变）。
#
# 命名避坑：无单字别名（L-119）；模块名 工具展示 已全仓库唯一性预检查（src/ 下无同名）。

从 内置核心字典 导入 字典包含键, 字典删除, 字典键列表
从 内置核心判型 导入 是字典, 是字符串, 是空

# =====================================================================
# §0 常量
# =====================================================================

# 上游 name = 'tool-presentation'
设 工具展示插件名 为 "tool-presentation"

# 上游 inject = ['tools']（codeRuntime 不在此，条件等待在 apply 内）
设 工具展示依赖 为 ["tools"]

# 三种展示模式（上游 ToolPresentationMode）
设 工具展示模式表 为 ["native", "ptc", "both"]

# run_code 工具名（对齐上游 RUN_CODE_NAME = 'run_code'）
设 运行代码工具名 为 "run_code"

# run_code 工具 schema（PTC/both 模式下模型看到的唯一「真工具」；SDK 由 生成工具SDK 生成）
设 运行代码工具模式 为 ["name": "run_code", "description": "在 agent 的代码运行时中执行 TypeScript 代码并返回结果。", "parameters": ["type": "object", "properties": ["代码": ["type": "string"]], "required": ["代码"]]]

# 部署默认展示（无配置/待代码运行时 回退态）
设 部署默认展示 为 "native"

# =====================================================================
# §1 mode 校验（对应 Config = z.union([...]).required()）
# =====================================================================

# mode 合法：值为 native/ptc/both 之一
段落 校验展示模式(模式):
  如果 是字符串(模式) == 假:
    返回 假
  遍历 候选 之 工具展示模式表:
    如果 候选 == 模式:
      返回 真
  返回 假

# 构造工具展示配置：mode 必填且合法，否则抛错（对齐上游 Config({}) 抛错）
段落 建工具展示配置(模式):
  如果 校验展示模式(模式) == 假:
    抛出 新建 错误("工具展示：mode 必填且必须为 native|ptc|both [INVALID_MODE]")
  设 配置 为 {}
  配置["模式"] 为 模式
  配置["作用域"] 为 ""
  配置["已应用"] 为 假
  配置["待代码运行时"] 为 假
  配置["注销函数"] 为 假
  返回 配置

# 校验既有配置是否合法（返回 真/假，供 apply 前断言）
段落 校验工具展示配置(配置):
  如果 是字典(配置) == 假:
    返回 假
  如果 字典包含键(配置, "模式") == 假:
    返回 假
  如果 校验展示模式(配置["模式"]) == 假:
    返回 假
  返回 真

# =====================================================================
# §2 作用域展示状态（对应 ctx.tools.presentAs 写入的 scope 状态）
# =====================================================================

# 模块级：作用域ID → 展示模式（native/ptc/both）。未命中 = 部署默认。
设 作用域展示表 为 {}

# 取某作用域当前展示模式（未配置 → 部署默认 native）
段落 获取作用域展示(作用域ID):
  如果 字典包含键(作用域展示表, 作用域ID):
    返回 作用域展示表[作用域ID]
  返回 部署默认展示

# =====================================================================
# §3 apply：核心应用逻辑（对应 export function apply(ctx, config)）
# =====================================================================

# 应用工具展示：写入该作用域的展示模式；返回配置句柄（充当 disposer）。
#   参数 代码运行时 默认 空：ptc/both 在无运行时 → 待代码运行时（pending），不应用；
#   有运行时 → 立即应用为 ptc/both。
#   native 模式：直接应用，无需运行时。
段落 应用工具展示(配置, 作用域ID, 工具注册表, 代码运行时=空):
  如果 校验工具展示配置(配置) == 假:
    抛出 新建 错误("工具展示：配置非法 [INVALID_CONFIG]")
  设 模式 为 配置["模式"]
  配置["作用域"] 为 作用域ID
  配置["已应用"] 为 假
  配置["待代码运行时"] 为 假
  如果 模式 == "native":
    作用域展示表[作用域ID] 为 "native"
    配置["已应用"] 为 真
    返回 配置
  如果 (代码运行时 != 空):
    作用域展示表[作用域ID] 为 模式
    配置["已应用"] 为 真
    配置["待代码运行时"] 为 假
    返回 配置
  # 无 codeRuntime：pending（不写入作用域展示，回退部署默认 = 全量可见）
  配置["待代码运行时"] 为 真
  配置["已应用"] 为 假
  返回 配置

# 注销工具展示（disposer）：删除作用域条目，恢复部署默认（HMR 安全）
段落 注销工具展示(配置):
  如果 是字典(配置) == 假:
    返回 假
  如果 字典包含键(配置, "作用域") == 假:
    返回 假
  设 作用域ID 为 配置["作用域"]
  如果 字典包含键(作用域展示表, 作用域ID):
    字典删除(作用域展示表, 作用域ID)
  配置["已应用"] 为 假
  配置["待代码运行时"] 为 假
  返回 真

# 是否处于待代码运行时状态（对应上游 pending row）
段落 是否待代码运行时(配置):
  如果 是字典(配置) == 假:
    返回 假
  如果 字典包含键(配置, "待代码运行时") == 假:
    返回 假
  返回 配置["待代码运行时"]

# 等待代码运行时到达后应用展示（对应 ctx.inject(['codeRuntime'], ...) 条件等待）
段落 等待代码运行时(配置, 代码运行时):
  如果 是否待代码运行时(配置) == 假:
    返回 配置
  如果 (代码运行时 == 空):
    返回 配置
  如果 字典包含键(配置, "作用域") == 假:
    抛出 新建 错误("工具展示：配置缺少作用域 [MISSING_SCOPE]")
  设 作用域ID 为 配置["作用域"]
  设 模式 为 配置["模式"]
  作用域展示表[作用域ID] 为 模式
  配置["已应用"] 为 真
  配置["待代码运行时"] 为 假
  返回 配置

# =====================================================================
# §4 工具过滤（对应 presentAs 决定模型可见工具列表）
# =====================================================================

# 根据作用域展示模式过滤工具列表（供代理循环 / 模型请求使用）
#   native → 全部工具 schema
#   ptc    → 仅 run_code 工具 schema（真实工具走 SDK）
#   both   → 全部工具 schema + run_code
# 注册表 需提供 描述表()（模型可见 schema 列表）。
段落 获取可见工具(作用域ID, 工具注册表):
  设 模式 为 获取作用域展示(作用域ID)
  如果 模式 == "native":
    返回 工具注册表.描述表()
  如果 模式 == "ptc":
    设 表 为 []
    表.追加(运行代码工具模式)
    返回 表
  如果 模式 == "both":
    设 表 为 工具注册表.描述表()
    表.追加(运行代码工具模式)
    返回 表
  返回 工具注册表.描述表()

# 生成工具 SDK 描述（PTC/both 模式下提供给模型的「run_code 可调用的工具清单」）
# 返回 {条目:[{名,描述}...], 文本: 拼接文本}；注册表 需提供 描述表()。
段落 生成工具SDK(工具注册表):
  设 模式表 为 工具注册表.描述表()
  设 条目 为 []
  设 文本 为 ""
  遍历 t 之 模式表:
    设 名 为 t["name"]
    设 描 为 t["description"]
    条目.追加(["名": 名, "描述": 描])
    如果 文本 != "":
      设 文本 为 文本 + chr(10)
    设 文本 为 文本 + 名 + ": " + 描
  返回 ["条目": 条目, "文本": 文本]

# =====================================================================
# §5 代理注册表代理（对应上游 host-plane 不变、presentAs 只改展示的语义）
#   零修改适配层：把「作用域ID + 真实工具注册表」包成代理，覆盖 描述表() 为
#   按作用域过滤后的可见工具；其余方法（执行/执行策略/注册/注销…）原样委托。
#   代理循环.light 本就调用 注册表.描述表()/执行()/执行策略()，传入本代理即
#   自动获得按作用域的工具展示过滤，无需改动代理循环代码。
# =====================================================================

类 工具展示注册表代理:
  属性 包装 等于 空
  属性 作用域ID 等于 空

  段落 构造(作用域ID, 注册表):
    设 己.包装 为 注册表
    设 己.作用域ID 为 作用域ID

  段落 描述表:
    返回 获取可见工具(己.作用域ID, 己.包装)

  段落 执行(名字, 原始参数):
    返回 己.包装.执行(名字, 原始参数)

  段落 执行策略(名字):
    返回 己.包装.执行策略(名字)

  段落 名单:
    返回 己.包装.名单()

  段落 有无(名字):
    返回 己.包装.有无(名字)

  段落 查找(名字):
    返回 己.包装.查找(名字)

  段落 注册 接收 定义:
    返回 己.包装.注册(定义)

  段落 注销(名字):
    返回 己.包装.注销(名字)

  段落 统计:
    返回 己.包装.统计()

  段落 汇总统计:
    返回 己.包装.汇总统计()

  段落 批量执行(调用表):
    返回 己.包装.批量执行(调用表)

# 造代理工具展示：建配置 + 应用 + 包代理（供「代理携带工具展示配置」使用，对齐 代理默认模型 模式）
#   返回 {配置, 代理注册表, 注销器}；把 代理注册表 传给 代理循环 即实现按作用域过滤。
段落 造代理工具展示(作用域ID, 注册表, 模式, 代码运行时=空):
  设 配置 为 建工具展示配置(模式)
  设 注销器 为 应用工具展示(配置, 作用域ID, 注册表, 代码运行时)
  设 代理 为 新建 工具展示注册表代理(作用域ID, 注册表)
  返回 ["配置": 配置, "代理注册表": 代理, "注销器": 注销器]

# =====================================================================
# §6 分层披露呈现与 tool_search 桥（T-0498；内部段落，显式导入直用）
#
# 职责：把 工具面装配.计算分层 的分层结果装配成模型上下文形态，并提供
#   tool_search 桥——被折叠工具 1 轮内按需加载回 eager（折叠不等于删除：
#   桥在全注册表上搜索，与折叠层无关）。
#
# 零侵入约束（R38 对本模块有钉子）：
#   - 不新增「导出」行（导出集合 18 项被 tests/test_R38_工具展示_token.py 钉死）；
#     消费方用「从 工具展示 导入 符号」显式导入本段段落（光明导出语句只生成
#     __all__，显式导入不受其约束，已实证）。
#   - 不新增模块导入（导入模块集合被钉死为 内置核心字典/内置核心判型）；
#     因此子串匹配、名单包含均手写实现，分层结果经参数注入（不 import 工具面装配）。
# =====================================================================

# tool_search 桥工具名（与 工具面装配.搜索桥工具名 同名同值，两侧口径一致）
设 搜索桥工具名 为 "tool_search"

# 桥工具 schema：模型调用它把折叠工具 1 轮内加载回可调用态
设 搜索桥工具模式 为 ["name": "tool_search", "description": "按名称或关键词查找折叠收纳的工具，返回其全量定义。目录中折叠列出的工具并未删除，查到即可直接调用。", "parameters": ["type": "object", "properties": ["查询": ["type": "string", "description": "工具名或关键词"]], "required": ["查询"]]]

# 造搜索桥工具：返回桥工具 schema（装配进模型可见清单时用）
段落 造搜索桥工具():
  设 条目 为 {}
  条目["name"] 为 搜索桥工具模式["name"]
  条目["description"] 为 搜索桥工具模式["description"]
  条目["parameters"] 为 搜索桥工具模式["parameters"]
  返回 条目

# 名单包含(表, 名) -> 布尔：手写实现（列表包含 未在本模块导入）
段落 名单包含(表, 名):
  遍历 已有 之 表:
    如果 已有 == 名:
      返回 真
  返回 假

# 名字含查询(文本, 子串) -> 布尔：手写子串匹配（字符串包含 未在本模块导入）
段落 名字含查询(文本, 子串):
  设 全长 为 字符串长度(文本)
  设 子长 为 字符串长度(子串)
  如果 子长 == 0:
    返回 真
  如果 子长 > 全长:
    返回 假
  设 起 为 0
  当 起 <= 全长 - 子长:
    设 移 为 0
    设 相同 为 真
    当 移 < 子长:
      如果 文本[起 + 移] != 子串[移]:
        设 相同 为 假
      设 移 为 移 + 1
    如果 相同 == 真:
      返回 真
    设 起 为 起 + 1
  返回 假

# 执行搜索桥(查询, 注册表) -> 命中的全量 schema 条目表
#   在**全注册表**上搜索（含被折叠工具——折叠不等于删除）；
#   精确名命中优先，其次名字包含。1 轮调用即取回可直接调用的全量定义。
#   注册表 只需提供 描述表()（工具.light / 总入口.兼容注册表 / 工具展示注册表代理 均满足）。
段落 执行搜索桥(查询, 注册表):
  设 全表 为 注册表.描述表()
  设 命中表 为 []
  设 命中名表 为 []
  遍历 条目 之 全表:
    如果 条目["name"] == 查询:
      命中名表.追加(条目["name"])
      命中表.追加(条目)
  如果 长度(命中表) == 0:
    遍历 条目 之 全表:
      如果 名单包含(命中名表, 条目["name"]) == 假:
        如果 名字含查询(条目["name"], 查询) == 真:
          命中名表.追加(条目["name"])
          命中表.追加(条目)
  返回 命中表

# 装配分层工具面(分层结果, 注册表) -> 模型上下文形态
#   层 0 核心工具以全量 schema 进「模式条目」；折叠清单文本进「目录文本」；
#   注册表未登记桥工具时兜底注入 搜索桥工具模式（保证 1 轮加载通道恒在）。
#   返回 {"模式条目", "目录文本", "折叠组名单", "分层表", "桥工具", "桥已注入"}
段落 装配分层工具面(分层结果, 注册表):
  设 全表 为 注册表.描述表()
  设 条目表 为 []
  设 核名 为 字典获取(分层结果, "核心名单", [])
  设 有桥 为 假
  遍历 条目 之 全表:
    如果 条目["name"] == 搜索桥工具名:
      设 有桥 为 真
    如果 名单包含(核名, 条目["name"]) == 真:
      条目表.追加(条目)
  设 桥 为 造搜索桥工具()
  设 已注入 为 假
  如果 有桥 == 假:
    条目表.追加(桥)
    设 已注入 为 真
  设 目文本 为 字典获取(分层结果, "目录文本", "")
  设 折叠组 为 字典获取(分层结果, "组名单", {})
  设 分层表 为 字典获取(分层结果, "分层表", {})
  返回 {"模式条目": 条目表, "目录文本": 目文本, "折叠组名单": 折叠组, "分层表": 分层表, "桥工具": 桥, "桥已注入": 已注入}

# 折叠呈现文本(分层结果) -> 折叠清单文本（bridge 头 + 分组清单/名单/计数行）
#   分层结果由 工具面装配.计算分层 产出（单一真相源），本段只校验并取用；
#   形态口径：层 1 = 「组名: 名单」行；层 2 = 仅名称行；层 3 = 「组名: 数量」行。
段落 折叠呈现文本(分层结果):
  如果 是字典(分层结果) == 假:
    返回 ""
  如果 字典包含键(分层结果, "目录文本") == 假:
    返回 ""
  返回 分层结果["目录文本"]

# =====================================================================
# 导出
# =====================================================================

导出 工具展示插件名
导出 工具展示依赖
导出 工具展示模式表
导出 运行代码工具名
导出 运行代码工具模式
导出 部署默认展示
