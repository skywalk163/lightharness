# 代码运行时协议.light —— code-runtime-python 协议层（对齐原版 packages/experimental/code-runtime-python/src/protocol.ts）
#
# 纯协议逻辑（无宿主导入）：fd 3 上 JSON-lines 帧、消息构造 / 帧字段名册必填校验 / 方向判别 /
# 无损 JSON 编码与数值无损性校验 / 截断标记 / Done 超预算与非无损拒绝。
# 与 src/代码运行时.light（只读）词汇对齐：前者负责子进程执行，本模块负责 fd-3 线缆帧语义。
#
# ⚠️ 光明语法纪律：L-043 禁止 `如果 ... 且/或 ... :`，布尔链一律拆成顺序 如果；
# 变量赋值用「设 X 为 …」；函数一律「段落 X 接收 参数:」。

# ---- 常量 ----
# fd 3 上的 JSON-lines 帧通道；stdout/stderr 留给程序自身输出。
段落 协议文件描述符:
  返回 3

# ---- 消息构造（宿主→子进程 / 子进程→宿主） ----
段落 造启动消息 接收 cpu秒, 地址空间字节, 最大日志字节, 最大值字节, 命名空间表:
  返回 ["type": "boot", "cpuSeconds": cpu秒, "addressSpaceBytes": 地址空间字节, "maxLogBytes": 最大日志字节, "maxValueBytes": 最大值字节, "namespaces": 命名空间表]

段落 造运行消息 接收 程序:
  返回 ["type": "run", "program": 程序]

段落 造启动确认消息:
  返回 ["type": "boot-ack"]

段落 造调用消息 接收 id, 全局名, 函数名, 参数:
  返回 ["type": "call", "id": id, "global": 全局名, "name": 函数名, "args": 参数]

段落 造日志消息 接收 文本, 截断 = 空, 开放 = 空:
  设 m 为 ["type": "log", "text": 文本]
  如果 截断 == 真:
    m["truncated"] 为 真
  如果 开放 == 真:
    m["open"] 为 真
  返回 m

段落 造完成消息 接收 值 = 空, 错误 = 空:
  设 m 为 ["type": "done"]
  如果 值 != 空:
    设 m 为 ["type": "done", "value": 值]
  如果 错误 != 空:
    m["error"] 为 错误
  返回 m

段落 造错误字段 接收 种类, 消息:
  返回 ["kind": 种类, "message": 消息]

段落 造回复成功 接收 id, 值:
  返回 ["type": "reply", "id": id, "ok": 真, "value": 值]

段落 造回复失败 接收 id, 消息:
  返回 ["type": "reply", "id": id, "ok": 假, "message": 消息]

# ---- 帧字段名册（必填/可选，按帧名） ----
# 对齐上游 WIRE_FRAME_FIELDS：每个帧的线框字段名册，必填与可选分离、字段名按字母序。
段落 线框字段名册:
  返回 [
    "BootMessage": ["required": ["type", "addressSpaceBytes", "cpuSeconds", "maxLogBytes", "maxValueBytes", "namespaces"], "optional": []],
    "Namespace": ["required": ["global", "names"], "optional": ["errorClass"]],
    "RunMessage": ["required": ["type", "program"], "optional": []],
    "BootAckMessage": ["required": ["type"], "optional": []],
    "CallMessage": ["required": ["type", "args", "global", "id", "name"], "optional": []],
    "LogMessage": ["required": ["type", "text"], "optional": ["open", "truncated"]],
    "DoneErrorField": ["required": ["kind", "message"], "optional": []],
    "DoneMessage": ["required": ["type"], "optional": ["error", "value"]],
    "ErrorClass": ["required": ["memberNameProperty", "name"], "optional": []],
    "ReplyOk": ["required": ["id", "ok", "type", "value"], "optional": []],
    "ReplyErr": ["required": ["id", "message", "ok", "type"], "optional": []]
  ]

# 帧字段名册必填校验：缺任一必填字段 → 返回 假；否则 真。
段落 校验帧必填 接收 帧, 帧名:
  设 名册 为 线框字段名册()
  如果 字典包含键(名册, 帧名) == 假:
    返回 假
  设 条目 为 名册[帧名]
  设 必填 为 条目["required"]
  遍历 字段 之 必填:
    如果 字典包含键(帧, 字段) == 假:
      返回 假
  返回 真

# ---- 方向判别 ----
# 子进程→宿主：boot-ack / call / log / done；宿主→子进程回复：reply；宿主→子进程引导：boot / run。
段落 判别方向 接收 帧:
  如果 是字典(帧) == 假:
    返回 "未知"
  如果 字典包含键(帧, "type") == 假:
    返回 "未知"
  设 t 为 帧["type"]
  如果 t == "boot-ack":
    返回 "子到宿主"
  如果 t == "call":
    返回 "子到宿主"
  如果 t == "log":
    返回 "子到宿主"
  如果 t == "done":
    返回 "子到宿主"
  如果 t == "reply":
    返回 "回复"
  如果 t == "boot":
    返回 "宿主到子"
  如果 t == "run":
    返回 "宿主到子"
  返回 "未知"

# ---- 日志截断标记 ----
# 共享线槽词汇：捕获触及字节预算时发出的标记文本（子进程与宿主两侧一致）。
段落 日志截断标记 接收 最大字节:
  返回 "[dsh-code-runtime-python] log capture truncated at " 加上 转文本(最大字节) 加上 " bytes"

# ---- 数值无损性辅助 ----
段落 是数值 接收 值:
  如果 是布尔(值) == 真:
    返回 假
  如果 是整数(值) == 真:
    返回 真
  如果 是浮点(值) == 真:
    返回 真
  返回 假

段落 非有限 接收 值:
  如果 值 != 值:
    返回 真
  如果 值 == 0:
    返回 假
  如果 值 == 值 * 2:
    返回 真
  返回 假

段落 是负零 接收 当前:
  如果 当前 == 0:
    如果 是浮点(当前) == 真:
      如果 转文本(当前) == "-0.0":
        返回 真
  返回 假

段落 是安全整数 接收 n:
  如果 是整数(n) == 假:
    返回 假
  设 s 为 转文本(n)
  如果 截取(s, 0, 1) == "-":
    设 s 为 截取(s, 1, 长度(s))
  如果 长度(s) < 16:
    返回 真
  如果 长度(s) > 16:
    返回 假
  如果 s > "9007199254740991":
    返回 假
  返回 真

# 单个标量（null/布尔/有限数）的 JSON 文本；超出安全范围的整数需精确 BigInt 位（用 转整数 取精确位）。
段落 标量JSON 接收 当前:
  如果 是布尔(当前) == 真:
    如果 当前 == 真:
      返回 "true"
    返回 "false"
  如果 当前 == 空:
    返回 "null"
  如果 是整数(当前) == 真:
    如果 是安全整数(当前) == 假:
      返回 转文本(转整数(当前))
  返回 转文本(当前)

# ---- 无损 JSON 编码（encodeJsonPlain） ----
# 紧凑 JSON；组合值递归构造；数值经 标量JSON（超安全范围整数取精确位）。
段落 编码JSON纯量 接收 值:
  如果 是布尔(值) == 真:
    如果 值 == 真:
      返回 "true"
    返回 "false"
  如果 值 == 空:
    返回 "null"
  如果 是数值(值) == 真:
    返回 标量JSON(值)
  如果 是字符串(值) == 真:
    返回 序列化JSON(值)
  如果 是列表(值) == 真:
    设 部分 为 []
    遍历 元素 之 值:
      列表追加(部分, 编码JSON纯量(元素))
    返回 "[" 加上 连接字符串(部分, ",") 加上 "]"
  如果 是字典(值) == 真:
    设 部分 为 []
    遍历 键 之 字典键列表(值):
      列表追加(部分, 序列化JSON(键) 加上 ":" 加上 编码JSON纯量(值[键]))
    返回 "{" 加上 连接字符串(部分, ",") 加上 "}"
  返回 "null"

# ---- UTF-8 字节长度（带早停，对齐 jsonStringBytesUpTo） ----
# 返回精确 UTF-8 字节长，或 空（一旦超过 余量）。
段落 字节长度 接收 text, 余量:
  设 字节 为 2
  如果 字节 > 余量:
    返回 空
  设 i 为 0
  当 i < 长度(text):
    设 ch 为 截取(text, i, i + 1)
    设 code 为 ord(ch)
    设 增量 为 1
    如果 code == 34:
      设 增量 为 2
    否则 如果 code == 92:
      设 增量 为 2
    否则 如果 code == 8:
      设 增量 为 2
    否则 如果 code == 9:
      设 增量 为 2
    否则 如果 code == 10:
      设 增量 为 2
    否则 如果 code == 12:
      设 增量 为 2
    否则 如果 code == 13:
      设 增量 为 2
    否则 如果 code < 32:
      设 增量 为 6
    否则 如果 code < 128:
      设 增量 为 1
    否则 如果 code < 2048:
      设 增量 为 2
    否则:
      设 是代理高 为 假
      如果 code >= 55296:
        如果 code <= 56319:
          设 是代理高 为 真
      如果 是代理高 == 真:
        如果 i + 1 < 长度(text):
          设 下 为 ord(截取(text, i + 1, i + 2))
          如果 下 >= 56320:
            如果 下 <= 57343:
              设 增量 为 4
              设 i 为 i + 1
            否则:
              设 增量 为 6
          否则:
            设 增量 为 6
        否则:
          设 增量 为 6
      否则 如果 code >= 55296:
        设 增量 为 6
      否则:
        设 增量 为 3
    设 字节 为 字节 + 增量
    如果 字节 > 余量:
      返回 空
    设 i 为 i + 1
  返回 字节

# ---- Done 值计量（checkDoneValue） ----
# 一次遍历同时算紧凑 JSON 字节长与数值无损性；超预算或非无损（非有限/负零）拒绝。
段落 校验完成值 接收 值, 最大字节:
  设 字节 为 0
  设 非无损 为 假
  设 栈 为 [值]
  当 长度(栈) > 0:
    设 当前 为 列表弹出(栈)
    如果 是数值(当前) == 真:
      如果 非有限(当前) == 真:
        设 非无损 为 真
      否则:
        如果 是负零(当前) == 真:
          设 非无损 为 真
      设 增量 为 字节长度(标量JSON(当前), 最大字节 - 字节)
      如果 增量 == 空:
        返回 ["ok": 假, "reason": "over-budget"]
      设 字节 为 字节 + 增量
    否则 如果 是字符串(当前) == 真:
      设 增量 为 字节长度(当前, 最大字节 - 字节)
      如果 增量 == 空:
        返回 ["ok": 假, "reason": "over-budget"]
      设 字节 为 字节 + 增量
    否则 如果 是列表(当前) == 真:
      设 字节 为 字节 + 2
      如果 长度(当前) > 1:
        设 字节 为 字节 + (长度(当前) - 1)
      如果 字节 + 长度(当前) > 最大字节:
        返回 ["ok": 假, "reason": "over-budget"]
      遍历 元素 之 当前:
        列表追加(栈, 元素)
    否则 如果 是字典(当前) == 真:
      设 键表 为 字典键列表(当前)
      设 计数 为 长度(键表)
      设 字节 为 字节 + 2
      如果 计数 > 1:
        设 字节 为 字节 + (计数 - 1)
      如果 字节 + 计数 * 4 > 最大字节:
        返回 ["ok": 假, "reason": "over-budget"]
      遍历 键 之 键表:
        设 键长 为 字节长度(键, 最大字节 - 字节)
        如果 键长 == 空:
          返回 ["ok": 假, "reason": "over-budget"]
        设 字节 为 字节 + 键长 + 1
        列表追加(栈, 当前[键])
    否则:
      设 增量 为 字节长度(标量JSON(当前), 最大字节 - 字节)
      如果 增量 == 空:
        返回 ["ok": 假, "reason": "over-budget"]
      设 字节 为 字节 + 增量
    如果 字节 > 最大字节:
      返回 ["ok": 假, "reason": "over-budget"]
  如果 非无损 == 真:
    返回 ["ok": 假, "reason": "non-lossless"]
  返回 ["ok": 真, "bytes": 字节]

# ---- 含非无损数（hasNonLosslessNumber） ----
# 任一内嵌数为非有限或负零 → 真（模型代码的 args 无字节预算，靠逐层游标避免宽负载 OOM）。
段落 含非无损数 接收 值:
  设 栈 为 [值]
  当 长度(栈) > 0:
    设 当前 为 列表弹出(栈)
    如果 是数值(当前) == 真:
      如果 非有限(当前) == 真:
        返回 真
      如果 是负零(当前) == 真:
        返回 真
    否则 如果 是列表(当前) == 真:
      遍历 元素 之 当前:
        列表追加(栈, 元素)
    否则 如果 是字典(当前) == 真:
      遍历 键 之 字典键列表(当前):
        列表追加(栈, 当前[键])
  返回 假

# ---- 子帧校验（validateChildFrame） ----
# 入站 fd-3 流量重建：伪造多余字段不随行；非数值 id / 缺 args / 非无损 args 一律丢弃（返回 空）。
段落 校验子帧 接收 原始:
  如果 是字典(原始) == 假:
    返回 空
  如果 字典包含键(原始, "type") == 假:
    返回 空
  设 m 为 原始
  设 t 为 m["type"]
  如果 t == "boot-ack":
    返回 ["type": "boot-ack"]
  如果 t == "log":
    如果 字典包含键(m, "text") == 假:
      返回 空
    如果 是字符串(m["text"]) == 假:
      返回 空
    设 结果 为 ["type": "log", "text": m["text"]]
    如果 字典包含键(m, "truncated") == 真:
      如果 是布尔(m["truncated"]) == 真:
        如果 m["truncated"] == 真:
          结果["truncated"] 为 真
    如果 字典包含键(m, "open") == 真:
      如果 是布尔(m["open"]) == 真:
        如果 m["open"] == 真:
          结果["open"] 为 真
    返回 结果
  如果 t == "call":
    如果 字典包含键(m, "id") == 假:
      返回 空
    如果 是数值(m["id"]) == 假:
      返回 空
    如果 非有限(m["id"]) == 真:
      返回 空
    如果 是负零(m["id"]) == 真:
      返回 空
    如果 字典包含键(m, "global") == 假:
      返回 空
    如果 是字符串(m["global"]) == 假:
      返回 空
    如果 字典包含键(m, "name") == 假:
      返回 空
    如果 是字符串(m["name"]) == 假:
      返回 空
    如果 字典包含键(m, "args") == 假:
      返回 空
    如果 含非无损数(m["args"]) == 真:
      返回 空
    返回 ["type": "call", "id": m["id"], "global": m["global"], "name": m["name"], "args": m["args"]]
  如果 t == "done":
    如果 字典包含键(m, "error") == 假:
      如果 字典包含键(m, "value") == 假:
        返回 ["type": "done"]
      返回 ["type": "done", "value": m["value"]]
    设 err 为 m["error"]
    如果 是字典(err) == 假:
      返回 空
    如果 字典包含键(err, "message") == 假:
      返回 空
    设 消息 为 err["message"]
    如果 是字符串(消息) == 假:
      返回 空
    设 种类 为 err["kind"]
    设 合法 为 假
    如果 种类 == "exception":
      设 合法 为 真
    否则 如果 种类 == "invalid-output":
      设 合法 为 真
    否则 如果 种类 == "output-limit":
      设 合法 为 真
    如果 合法 == 假:
      返回 空
    如果 字典包含键(m, "value") == 假:
      返回 ["type": "done", "error": ["kind": 种类, "message": 消息]]
    返回 ["type": "done", "value": m["value"], "error": ["kind": 种类, "message": 消息]]
  返回 空

# ---- 不安全整数令牌（hasUnsafeIntegerToken） ----
# 原始 JSON 行里、字符串字面量之外、超安全范围的整数令牌 → 真（JSON.parse 会静默取整，须读源码文本）。
段落 跳过字符串字面量 接收 line, i:
  设 j 为 i + 1
  当 j < 长度(line):
    设 d 为 截取(line, j, j + 1)
    如果 d == "\\":
      设 j 为 j + 2
    否则 如果 d == "\"":
      返回 j + 1
    否则:
      设 j 为 j + 1
  返回 j

段落 是纯整数 接收 token:
  如果 长度(token) == 0:
    返回 假
  设 k 为 0
  如果 截取(token, 0, 1) == "-":
    设 k 为 1
  如果 k == 长度(token):
    返回 假
  当 k < 长度(token):
    设 ch 为 截取(token, k, k + 1)
    设 是数字 为 假
    如果 ch >= "0":
      如果 ch <= "9":
        设 是数字 为 真
    如果 是数字 == 假:
      返回 假
    设 k 为 k + 1
  返回 真

段落 是不安全整数 接收 token:
  如果 长度(token) > 16:
    返回 真
  设 s 为 token
  如果 截取(s, 0, 1) == "-":
    设 s 为 截取(s, 1, 长度(s))
  如果 长度(s) < 16:
    返回 假
  如果 s > "9007199254740991":
    返回 真
  返回 假

段落 含不安全整数令牌 接收 line:
  设 i 为 0
  当 i < 长度(line):
    设 c 为 截取(line, i, i + 1)
    如果 c == "\"":
      设 i 为 跳过字符串字面量(line, i)
      继续
    设 是数字起点 为 假
    如果 c == "-":
      设 是数字起点 为 真
    否则 如果 c >= "0":
      如果 c <= "9":
        设 是数字起点 为 真
    如果 是数字起点 == 真:
      设 起点 为 i
      设 终点 为 i + 1
      当 终点 < 长度(line):
        设 e 为 截取(line, 终点, 终点 + 1)
        设 续 为 假
        如果 e >= "0":
          如果 e <= "9":
            设 续 为 真
        如果 续 == 假:
          如果 e == ".":
            设 续 为 真
          否则 如果 e == "e":
            设 续 为 真
          否则 如果 e == "E":
            设 续 为 真
          否则 如果 e == "+":
            设 续 为 真
          否则 如果 e == "-":
            设 续 为 真
        如果 续 == 假:
          跳出
        设 终点 为 终点 + 1
      设 token 为 截取(line, 起点, 终点)
      如果 是纯整数(token) == 真:
        如果 是不安全整数(token) == 真:
          返回 真
      设 i 为 终点
    否则:
      设 i 为 i + 1
  返回 假
