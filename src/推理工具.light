# 推理工具.light —— 推理与工具纯逻辑核心（任务卡 N，对标编号 64）
# 纯逻辑复刻，剥离真实 IO / 网络 / 子进程 / 文件系统；后端能力以入参抽象。
#
# 对照原版：
#   packages/llm/llm-retry/src/index.ts            L58-63  retry 退避（指数退避 + jitter）
#   packages/llm/llm-deepseek/src/serialize.ts     L45-72  选项求解（reasoning effort / thinking）
#                                                  L74-99  内容校验/转换（文本块拼平 / 拒图像 / 校验图像角色）
#   packages/session/session-stats/src/projection.ts L82-159 会话统计投影
#   packages/util/atomic-write/src/index.ts        L35-64  原子替换（临时档 + rename + 失败清理）
#                                                  L66-78  isLockContention
#                                                  L80-130 writer lock 协议（命名/延迟/超时/指数退避）
#   packages/util/output-retention/src/index.ts    L129-198 ItemRetainer（预算/入/截断/收统计）
#                                                  L200-220 trimTrailingPartialUtf8（UTF-8 尾随不完整）
#
# 命名：model option → 求解器选项；thinking → 说理；text block → 文本块；
#        atomic-write → 原子覆写（临时档命名 临时档）；lock contention → 写锁争用；
#        output retention → 保留（保留尾部/头部）。内部标识符避开 类型/工具/排序/模型 等词根。

# ========== 通用小工具 ==========
段落 最小 接收 a, b:
  如果 a < b: 返回 a
  返回 b

段落 最大 接收 a, b:
  如果 a > b: 返回 a
  返回 b

段落 算幂 接收 底, 指:
  设 果 为 1
  设 i 为 0
  当 i < 指:
    设 果 为 果 * 底
    设 i 为 i + 1
  返回 果

# ========== 1) retry 退避（llm-retry L58-63）==========
# 策: {"初延迟":int,"最大延迟":int,"抖动比":float}; 次数 从 1 起; 随机值 ∈ [0,1]
# 对齐：exponent=min(次数-1,1024); exponential=min(初延迟*2^exponent, 最大延迟);
#      jitter=1-抖动比+2*抖动比*随机值; 返回 min(exponential*jitter, 最大延迟)
段落 计算退避 接收 策, 次数, 随机值:
  设 指数 为 最小(次数 - 1, 1024)
  设 幂值 为 算幂(2, 指数)
  设 指数延迟 为 最小((策["初延迟"] * 幂值), 策["最大延迟"])
  设 抖动 为 (1 - 策["抖动比"]) + ((策["抖动比"] * 2) * 随机值)
  设 带抖 为 指数延迟 * 抖动
  返回 最小(带抖, 策["最大延迟"])

# ========== 2) LLM 选项求解 / 内容校验（llm-deepseek/serialize.ts）==========
# reasoning effort 校验：仅 off/low/high/max 合法，否则抛 UNSUPPORTED_REASONING_EFFORT
段落 校验说理力度 接收 力度:
  如果 力度 == "off": 返回 "off"
  如果 力度 == "low": 返回 "low"
  如果 力度 == "high": 返回 "high"
  如果 力度 == "max": 返回 "max"
  抛出 新建 错误("DeepSeek does not support reasoning effort " + 力度 + " [UNSUPPORTED_REASONING_EFFORT]")

# 求解说理（thinking）：对齐 resolveThinking
段落 求解说理 接收 选项, 缺省:
  如果 字典包含键(选项, "目的"):
    如果 选项["目的"] == "session-title":
      返回 { "说理": "禁用" }
  设 力度 为 空
  如果 字典包含键(选项, "说理力度"):
    设 力度 为 校验说理力度(选项["说理力度"])
  否则:
    如果 字典包含键(缺省, "说理力度"):
      设 力度 为 缺省["说理力度"]
  如果 缺省["说理"] == "禁用":
    如果 力度 != 空:
      如果 力度 != "off":
        抛出 新建 错误("DeepSeek deployment does not support reasoning effort " + 力度 + " [UNSUPPORTED_REASONING_EFFORT]")
  如果 力度 == "off":
    返回 { "说理": "禁用" }
  如果 力度 == "low":
    返回 { "说理": "启用", "说理力度": "low" }
  如果 力度 == "high":
    返回 { "说理": "启用", "说理力度": "high" }
  如果 力度 == "max":
    返回 { "说理": "启用", "说理力度": "max" }
  如果 字典包含键(缺省, "说理"):
    返回 { "说理": 缺省["说理"] }
  返回 {}

# 含图像：内容块表任一为 图像 型
段落 含图像 接收 块集:
  遍历 块 之 块集:
    如果 块["型"] == "图像":
      返回 真
  返回 假

# 拼平文本块（flattenText）：仅 text 块，拼接其 文
段落 拼平文本 接收 块集:
  设 结果 为 ""
  遍历 块 之 块集:
    如果 块["型"] == "文本":
      设 结果 为 结果 + 块["文"]
  返回 结果

# 断言纯文本（assertTextOnly）：含图像即抛 UNSUPPORTED_CONTENT
段落 断言纯文本 接收 块集:
  如果 含图像(块集):
    抛出 新建 错误("The DeepSeek chat-completions adapter does not support image content. [UNSUPPORTED_CONTENT]")

# 断言图像角色（assertSupportedImageRoles）：非 user 消息含图像即抛
段落 断言图像角色 接收 消息集:
  遍历 消息 之 消息集:
    设 异角色 为 消息["角色"] != "用户"
    如果 异角色:
      如果 含图像(消息["内容"]):
        抛出 新建 错误("The DeepSeek chat-completions adapter cannot represent image content in a " + 消息["角色"] + " message. [UNSUPPORTED_CONTENT]")

# ========== 3) 会话统计投影（session-stats/projection.ts L82-159）==========
# 用量输出令牌：usage.outputTokens 为有限非负整数/小数时返回，否则 空
段落 析令牌 接收 用量:
  如果 type(用量) != dict:
    返回 空
  设 值 为 取可选(用量, "输出令牌")
  如果 type(值) == int:
    如果 值 >= 0:
      返回 值
    返回 空
  如果 type(值) == float:
    如果 值 >= 0:
      返回 值
    返回 空
  返回 空

# 判定令增量（isTokenDelta）：文本/推理增量非空、工具调用增量非空或有名即计首令
段落 判定令增量 接收 块:
  设 型 为 块["型"]
  如果 型 == "text-delta":
    返回 块["文"] != ""
  如果 型 == "reasoning-delta":
    返回 块["文"] != ""
  如果 型 == "tool-call-delta":
    设 有参 为 假
    如果 字典包含键(块, "参数增量"):
      如果 块["参数增量"] != "":
        设 有参 为 真
    设 有名 为 字典包含键(块, "名")
    如果 有参:
      返回 真
    如果 有名:
      返回 真
    返回 假
  返回 假

# 初始态
段落 初始态:
  返回 ["轮数":0,"步数":0,"推毫秒":0,"具毫秒":0,"首令毫秒":0,"首令步":0,"解码毫秒":0,"解码令牌":0,"末轮":空,"开步":空,"待呼":{}]

# 复制待呼（避免共享引用）
段落 复制待呼 接收 待呼:
  设 副本 为 {}
  遍历 k 之 待呼:
    设 副本[k] 为 待呼[k]
  返回 副本

# 复制态（12 字段全量复制，等价于 { ...state }）
段落 复制态 接收 态:
  返回 ["轮数":态["轮数"],"步数":态["步数"],"推毫秒":态["推毫秒"],"具毫秒":态["具毫秒"],
        "首令毫秒":态["首令毫秒"],"首令步":态["首令步"],"解码毫秒":态["解码毫秒"],
        "解码令牌":态["解码令牌"],"末轮":态["末轮"],"开步":态["开步"],"待呼":复制待呼(态["待呼"])]

# 投影（apply）：事件驱动纯折叠
段落 投影 接收 态, 事件:
  设 型 为 事件["型"]
  如果 型 == "步开始":
    设 新 为 复制态(态)
    设 新["开步"] 为 ["轮":事件["数据"]["轮"],"步":事件["数据"]["步"],"起时":事件["时间"],"首令时":空]
    返回 新
  如果 型 == "助块":
    设 开 为 态["开步"]
    如果 开 == 空: 返回 态
    如果 开["轮"] != 事件["数据"]["轮"]: 返回 态
    如果 开["步"] != 事件["数据"]["步"]: 返回 态
    如果 开["首令时"] != 空: 返回 态
    如果 判定令增量(事件["数据"]["块"]) == 假: 返回 态
    设 新 为 复制态(态)
    设 新["开步"] 为 ["轮":开["轮"],"步":开["步"],"起时":开["起时"],"首令时":事件["时间"]]
    返回 新
  如果 型 == "助消息":
    设 开 为 态["开步"]
    如果 开 == 空: 返回 态
    如果 开["轮"] != 事件["数据"]["轮"]: 返回 态
    如果 开["步"] != 事件["数据"]["步"]: 返回 态
    设 新 为 复制态(态)
    设 新["推毫秒"] 为 态["推毫秒"] + 最大(0, 事件["时间"] - 开["起时"])
    设 新["开步"] 为 空
    如果 开["首令时"] != 空:
      设 新["首令毫秒"] 为 态["首令毫秒"] + 最大(0, 开["首令时"] - 开["起时"])
      设 新["首令步"] 为 态["首令步"] + 1
      设 出令牌 为 析令牌(事件["数据"]["用量"])
      如果 出令牌 != 空:
        设 新["解码毫秒"] 为 态["解码毫秒"] + 最大(0, 事件["时间"] - 开["首令时"])
        设 新["解码令牌"] 为 态["解码令牌"] + 出令牌
    返回 新
  如果 型 == "具呼":
    设 新 为 复制态(态)
    设 新["待呼"] 为 复制待呼(态["待呼"])
    设 新["待呼"][事件["数据"]["呼号"]] 为 事件["时间"]
    返回 新
  如果 型 == "具果":
    设 呼号 为 事件["数据"]["消息"]["源"]["呼号"]
    设 派 为 空
    如果 字典包含键(态["待呼"], 呼号):
      设 派 为 态["待呼"][呼号]
    如果 派 == 空: 返回 态
    设 新 为 复制态(态)
    设 新["待呼"] 为 复制待呼(态["待呼"])
    字典删除(新["待呼"], 呼号)
    设 新["具毫秒"] 为 态["具毫秒"] + 最大(0, 事件["时间"] - 派)
    返回 新
  如果 型 == "步结束":
    设 新 为 复制态(态)
    如果 态["末轮"] == 事件["数据"]["轮"]:
      设 新["轮数"] 为 态["轮数"]
    否则:
      设 新["轮数"] 为 态["轮数"] + 1
    设 新["步数"] 为 态["步数"] + 1
    设 新["末轮"] 为 事件["数据"]["轮"]
    设 新["开步"] 为 空
    返回 新
  如果 型 == "轮结束":
    如果 长(态["待呼"]) == 0: 返回 态
    设 新 为 复制态(态)
    设 新["待呼"] 为 {}
    返回 新
  返回 态

# ========== 4) 原子覆写 + 写锁协议（util/atomic-write L35-130）==========
# 原子覆写：临时档写入 + rename 覆盖；任一失败清理临时档并重抛。
# 后端（入参能力）：{"造临时档":fn(终档)->临时档名, "写独占":fn(临时档,内容,权限),
#                    "改名":fn(临时档,终档), "删":fn(档)}
段落 原子覆写 接收 终档, 内容, 权限, 后端:
  设 临时档 为 后端["造临时档"](终档)
  尝试:
    后端["写独占"](临时档, 内容, 权限)
    后端["改名"](临时档, 终档)
  捕获 异常 e:
    后端["删"](临时档)
    抛出 e
  返回 真

# 写锁命名：终档 + ".lock"
段落 锁命名 接收 终档:
  返回 终档 + ".lock"

# 判定写锁争用（isLockContention）：EEXIST→真；非 EPERM→假；EPERM 看锁在否
段落 判定写锁争用 接收 码, 锁在:
  如果 码 == "EEXIST": 返回 真
  如果 码 != "EPERM": 返回 假
  返回 锁在

# 锁延迟表：前 次数 次重试的延迟序列（20→40→80→160→200 封顶）
段落 锁延迟表 接收 次数:
  设 表 为 []
  设 延迟 为 20
  设 i 为 0
  当 i < 次数:
    表.追加(延迟)
    设 延迟 为 最小(延迟 * 2, 200)
    设 i 为 i + 1
  返回 表

# 持文件锁（withFileLock）：争用指数退避、超时抛错、终释放锁。
# 后端（入参能力）：{"试锁":fn(锁档)->"ok"|码, "释锁":fn(锁档), "锁在":fn(锁档)->bool,
#                    "时":fn()->毫秒, "延":fn(毫秒)}
段落 持文件锁 接收 终档, 操作, 后端:
  设 锁档 为 锁命名(终档)
  设 取时 为 后端["时"]
  设 试锁 为 后端["试锁"]
  设 查锁 为 后端["锁在"]
  设 延 为 后端["延"]
  设 释锁 为 后端["释锁"]
  设 截止 为 取时() + 2000
  设 延迟 为 20
  设 已得 为 假
  当 已得 == 假:
    设 码 为 试锁(锁档)
    如果 码 == "ok":
      设 已得 为 真
      跳出
    设 争用 为 判定写锁争用(码, 查锁(锁档))
    如果 争用 == 假:
      抛出 新建 错误("atomic-write: non-contention error " + 码)
    如果 取时() >= 截止:
      抛出 新建 错误("atomic-write: timed out waiting for the writer lock at " + 锁档)
    延(延迟)
    设 延迟 为 最小(延迟 * 2, 200)
  尝试:
    设 果 为 操作()
  捕获 异常 e:
    释锁(锁档)
    抛出 e
  释锁(锁档)
  返回 果

# ========== 5) 输出保留 + UTF-8 尾随裁剪（util/output-retention L129-220）==========
# 预算校验：非负整数
段落 校验预算 接收 值, 名:
  如果 type(值) != int:
    抛出 新建 错误(名 + " must be a non-negative integer")
  如果 值 < 0:
    抛出 新建 错误(名 + " must be a non-negative integer")
  返回 真

# 项保留器（ItemRetainer，head 策略）：预算/入/截断/收统计
类 项保留器:
  属性 上限 等于 空
  属性 项表 等于 空
  属性 已见 等于 空
  属性 省略数 等于 空

  段落 构造 接收 策略:
    校验预算(策略["上限"], "maxItems")
    设 己.上限 为 策略["上限"]
    设 己.项表 为 []
    设 己.已见 为 0
    设 己.省略数 为 0

  段落 入 接收 项:
    设 己.已见 为 己.已见 + 1
    如果 长(己.项表) < 己.上限:
      己.项表.追加(项)
      返回 { "留": 真, "截": 假 }
    设 己.省略数 为 己.省略数 + 1
    返回 { "留": 假, "截": 真 }

  段落 收 接收:
    设 截 为 (己.省略数 > 0)
    设 省 为 空
    如果 截:
      设 省 为 { "式": "精确", "数": 己.省略数 }
    否则:
      设 省 为 { "式": "无" }
    返回 { "项": 己.项表, "截": 截, "见": 己.已见, "留": 长(己.项表), "省": 省 }

# 前缀表：取列表前 n 项（替代切片语法）
段落 前缀表 接收 表, n:
  设 结果 为 []
  设 i 为 0
  当 i < n:
    结果.追加(表[i])
    设 i 为 i + 1
  返回 结果

# 裁剪尾随不完整 UTF-8（trimTrailingPartialUtf8）
# 字节集：0-255 整数列表。尾随 continuation 字节(128..191)回退最多 3；
# 首字节定预期长度，bytes.length-i < 预期 即不完整，裁掉 [i,末尾)。
段落 裁剪尾utf8 接收 字节集:
  设 i 为 长(字节集) - 1
  当 i >= 0:
    如果 字节集[i] < 128: 跳出
    如果 字节集[i] > 191: 跳出
    如果 (长(字节集) - i) > 3: 跳出
    设 i 为 i - 1
  如果 i < 0:
    返回 字节集
  设 首 为 字节集[i]
  设 期望 为 1
  如果 首 >= 128: 设 期望 为 2
  如果 首 >= 224: 设 期望 为 3
  如果 首 >= 240: 设 期望 为 4
  如果 首 >= 248:
    返回 字节集
  如果 (长(字节集) - i) < 期望:
    返回 前缀表(字节集, i)
  返回 字节集
