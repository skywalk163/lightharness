# 代理循环.light —— 第34轮 任务1：agent-loop 多轮循环核心
#
# 上游（只读）：G:\github\deepseek-harness\packages\agent-loop\src\
#   turn.ts（Turn 轮次）     → §1 轮次状态机
#   step.ts（Step 步骤）     → §2 步骤状态机
#   checkpoint.ts（检查点）   → §3 检查点与幂等恢复
#   abort.ts（AbortSignal）  → §4 中止与恢复
#
# 纯逻辑复刻：剔除 LLM 流式 I/O、工具真实分派、持久化写盘（改为内存结构）。
# 命名避坑：L-119 单字别名保留字（步/长/首/末/空/当 等勿作变量名）；
#           L-120 可被关键字序列完全切分的标识符。
# 本模块段落一律以「循」为前缀，避免与同测导入的其它模块同名段冲突
#（src 后端会把依赖模块内联进同一份 Python，同名段会 codegen 重定义）。
# 铁律：状态机转换必须严格，非法转换抛错；检查点恢复必须幂等。

# =====================================================================
# §0 常量与合法表
# =====================================================================

设 轮次待启 为 "pending"
设 轮次进行 为 "running"
设 轮次完成 为 "completed"
设 轮次失败 为 "failed"
设 轮次中止 为 "aborted"

设 步骤待启 为 "pending"
设 步骤进行 为 "running"
设 步骤完成 为 "completed"
设 步骤失败 为 "failed"
设 步骤跳过 为 "skipped"
设 步骤中止 为 "aborted"

# 轮次/步骤类型：一轮含多个 step（LLM 调用 / 工具调用 / 用户输入）
设 步骤型表 为 ["llm", "tool", "user_input"]
设 中止原因表 为 ["user_abort", "timeout", "error", "max_rounds"]
设 检查点策略表 为 ["pre-turn", "pre-step", "post-step", "post-turn"]
设 事件类型表 为 ["turn/start", "turn/end", "step/start", "step/end",
  "checkpoint", "abort", "resume"]
设 默认最大轮次 为 3

段落 轮次状态表:
  返回 [轮次待启, 轮次进行, 轮次完成, 轮次失败, 轮次中止]

段落 步骤状态表:
  返回 [步骤待启, 步骤进行, 步骤完成, 步骤失败, 步骤跳过, 步骤中止]

# =====================================================================
# §1 轮次状态机（turn.ts）
# =====================================================================

# 后继状态表：终态（completed/failed/aborted）无后继 → 空表
段落 循轮次后继(状态):
  如果 状态 == 轮次待启:
    返回 [轮次进行, 轮次中止]
  如果 状态 == 轮次进行:
    返回 [轮次完成, 轮次失败, 轮次中止]
  返回 []

段落 循步骤后继(状态):
  如果 状态 == 步骤待启:
    返回 [步骤进行, 步骤跳过, 步骤中止]
  如果 状态 == 步骤进行:
    返回 [步骤完成, 步骤失败, 步骤跳过, 步骤中止]
  返回 []

段落 循是轮次状态(值):
  返回 轮次状态表().包含(值)

段落 循是步骤状态(值):
  返回 步骤状态表().包含(值)

段落 循轮次可转(从, 到):
  遍历 目标 之 循轮次后继(从):
    如果 目标 == 到:
      返回 真
  返回 假

段落 循步骤可转(从, 到):
  遍历 目标 之 循步骤后继(从):
    如果 目标 == 到:
      返回 真
  返回 假

段落 建轮次(序号):
  返回 {"序号": 序号, "状态": 轮次待启, "步骤表": [], "轨迹": [轮次待启],
    "原因": 空}

段落 建步骤(序号, 类型):
  如果 步骤型表.包含(类型) == 假:
    抛出 新建 错误("未知步骤类型：" + 转字符串(类型) + " [UNKNOWN_STEP_TYPE]")
  返回 {"序号": 序号, "类型": 类型, "状态": 步骤待启, "轨迹": [步骤待启],
    "原因": 空, "结果": 空}

段落 转轮次(轮次, 目标, 原因 = 空):
  如果 循是轮次状态(目标) == 假:
    抛出 新建 错误("未知轮次状态：" + 转字符串(目标) + " [UNKNOWN_TURN_STATE]")
  如果 循轮次可转(轮次["状态"], 目标) == 假:
    抛出 新建 错误("非法轮次转换：" + 轮次["状态"] + " → " + 目标 +
      " [ILLEGAL_TURN_TRANSITION]")
  字典设置(轮次, "状态", 目标)
  轮次["轨迹"].追加(目标)
  如果 原因 != 空:
    字典设置(轮次, "原因", 原因)
  返回 轮次

段落 转步骤(步骤, 目标, 原因 = 空):
  如果 循是步骤状态(目标) == 假:
    抛出 新建 错误("未知步骤状态：" + 转字符串(目标) + " [UNKNOWN_STEP_STATE]")
  如果 循步骤可转(步骤["状态"], 目标) == 假:
    抛出 新建 错误("非法步骤转换：" + 步骤["状态"] + " → " + 目标 +
      " [ILLEGAL_STEP_TRANSITION]")
  字典设置(步骤, "状态", 目标)
  步骤["轨迹"].追加(目标)
  如果 原因 != 空:
    字典设置(步骤, "原因", 原因)
  返回 步骤

段落 轮次是否终态(轮次):
  返回 长(循轮次后继(轮次["状态"])) == 0

段落 步骤是否终态(步骤):
  返回 长(循步骤后继(步骤["状态"])) == 0

段落 轮次追加步骤(轮次, 类型):
  设 步骤 为 建步骤(长(轮次["步骤表"]), 类型)
  轮次["步骤表"].追加(步骤)
  返回 步骤

段落 轮次当前步骤(轮次):
  遍历 步骤 之 轮次["步骤表"]:
    如果 步骤是否终态(步骤) == 假:
      返回 步骤
  返回 空

# 轮次是否跑完：所有 step 均终态
段落 轮次是否跑完(轮次):
  如果 长(轮次["步骤表"]) == 0:
    返回 假
  遍历 步骤 之 轮次["步骤表"]:
    如果 步骤是否终态(步骤) == 假:
      返回 假
  返回 真

# =====================================================================
# §2 检查点（checkpoint.ts）
# =====================================================================

段落 轮次快照(轮次):
  设 步骤状态表 为 []
  遍历 步骤 之 轮次["步骤表"]:
    步骤状态表.追加(步骤["状态"])
  返回 {"序号": 轮次["序号"], "状态": 轮次["状态"], "步骤状态表": 步骤状态表,
    "原因": 轮次["原因"]}

段落 建检查点(序号, 轮次序号, 步骤序号, 策略, 快照, 待处理事件):
  如果 检查点策略表.包含(策略) == 假:
    抛出 新建 错误("未知检查点策略：" + 转字符串(策略) +
      " [UNKNOWN_CHECKPOINT_POLICY]")
  返回 {"序号": 序号, "轮次序号": 轮次序号, "步骤序号": 步骤序号,
    "策略": 策略, "快照": 快照, "待处理事件": 待处理事件}

段落 循末项(表):
  如果 长(表) == 0:
    返回 空
  返回 表[长(表) - 1]

段落 取最近检查点(驱动):
  返回 循末项(驱动["检查点表"])

# 记检查点：序号严格递增（追加-only），返回新检查点
段落 记检查点(驱动, 策略, 快照, 待处理事件 = 空):
  设 序号 为 驱动["检查点序号"] + 1
  设 轮次序号 为 0 - 1
  设 步骤序号 为 0 - 1
  如果 驱动["当前轮次"] != 空:
    设 轮次序号 为 驱动["当前轮次"]["序号"]
    如果 驱动["当前步骤"] != 空:
      设 步骤序号 为 驱动["当前步骤"]["序号"]
  设 待办 为 []
  如果 待处理事件 != 空:
    设 待办 为 待处理事件
  设 点 为 建检查点(序号, 轮次序号, 步骤序号, 策略, 快照, 待办)
  驱动["检查点表"].追加(点)
  字典设置(驱动, "检查点序号", 序号)
  发事件(驱动, "checkpoint", {"序号": 序号, "策略": 策略})
  返回 点

# 按序号取检查点
段落 取检查点(驱动, 序号):
  遍历 点 之 驱动["检查点表"]:
    如果 点["序号"] == 序号:
      返回 点
  返回 空

# 从检查点恢复：幂等——同一序号重复恢复返回同一快照，且不新增检查点
段落 从检查点恢复(驱动, 序号 = 空):
  设 点 为 空
  如果 序号 == 空:
    设 点 为 取最近检查点(驱动)
  否则:
    设 点 为 取检查点(驱动, 序号)
  如果 点 == 空:
    返回 空
  字典设置(驱动, "恢复序号", 点["序号"])
  字典设置(驱动, "恢复快照", 点["快照"])
  返回 点["快照"]

# =====================================================================
# §3 中止信号（abort.ts）
# =====================================================================

段落 建中止信号:
  返回 {"中止": 假, "原因": 空}

段落 是否中止(信号):
  如果 信号 == 空:
    返回 假
  返回 信号["中止"] == 真

段落 请求中止(信号, 原因):
  如果 中止原因表.包含(原因) == 假:
    抛出 新建 错误("未知中止原因：" + 转字符串(原因) + " [UNKNOWN_ABORT_REASON]")
  如果 信号["中止"] == 真:
    返回 假
  字典设置(信号, "中止", 真)
  字典设置(信号, "原因", 原因)
  返回 真

段落 中止原因(信号):
  如果 信号 == 空:
    返回 空
  返回 信号["原因"]

# =====================================================================
# §4 循环驱动：事件 + 监听器 + 轮次/步骤推进
# =====================================================================

段落 建循环(最大轮次 = 3):
  如果 最大轮次 <= 0:
    抛出 新建 错误("最大轮次必须为正：" + 转字符串(最大轮次) +
      " [INVALID_MAX_ROUNDS]")
  返回 {"最大轮次": 最大轮次, "轮次表": [], "当前轮次": 空, "当前步骤": 空,
    "事件表": [], "检查点表": [], "检查点序号": 0, "恢复序号": 0,
    "恢复快照": 空, "已达上限": 假, "信号": 建中止信号(), "监听表": [],
    "监听器错误表": []}

段落 是否超限(驱动):
  返回 长(驱动["轮次表"]) >= 驱动["最大轮次"]

# 监听器注册/注销（错误隔离在 派发监听 内）
段落 注册监听(驱动, 名称, 处理):
  遍历 项 之 驱动["监听表"]:
    如果 项["名称"] == 名称:
      抛出 新建 错误("监听器重名：" + 名称 + " [DUPLICATE_LISTENER]")
  驱动["监听表"].追加({"名称": 名称, "处理": 处理})
  返回 真

段落 注销监听(驱动, 名称):
  设 新表 为 []
  设 命中 为 假
  遍历 项 之 驱动["监听表"]:
    如果 项["名称"] == 名称:
      设 命中 为 真
    否则:
      新表.追加(项)
  字典设置(驱动, "监听表", 新表)
  返回 命中

段落 监听器数(驱动):
  返回 长(驱动["监听表"])

# 派发：单个监听器抛错被隔离，记入 监听器错误表，不影响其余监听器
段落 派发监听(驱动, 事件):
  遍历 项 之 驱动["监听表"]:
    设 处理 为 项["处理"]
    尝试:
      处理(事件)
    捕获 异常 为 e:
      驱动["监听器错误表"].追加({"名称": 项["名称"], "消息": 转字符串(e)})
  返回 长(驱动["监听器错误表"])

段落 发事件(驱动, 类型, 载荷 = 空):
  如果 事件类型表.包含(类型) == 假:
    抛出 新建 错误("未知循环事件类型：" + 转字符串(类型) +
      " [UNKNOWN_LOOP_EVENT]")
  设 事件 为 {"序号": 长(驱动["事件表"]) + 1, "类型": 类型, "载荷": 载荷}
  驱动["事件表"].追加(事件)
  派发监听(驱动, 事件)
  返回 事件

# ---- 轮次推进 ----

段落 开始轮次(驱动):
  如果 是否中止(驱动["信号"]) == 真:
    返回 空
  如果 是否超限(驱动) == 真:
    请求中止(驱动["信号"], "max_rounds")
    字典设置(驱动, "已达上限", 真)
    发事件(驱动, "abort", {"原因": "max_rounds"})
    返回 空
  设 轮次 为 建轮次(长(驱动["轮次表"]))
  驱动["轮次表"].追加(轮次)
  字典设置(驱动, "当前轮次", 轮次)
  字典设置(驱动, "当前步骤", 空)
  记检查点(驱动, "pre-turn", 轮次快照(轮次), [])
  转轮次(轮次, 轮次进行)
  发事件(驱动, "turn/start", {"序号": 轮次["序号"]})
  返回 轮次

段落 结束轮次(驱动, 结果 = 轮次完成, 原因 = 空):
  设 轮次 为 驱动["当前轮次"]
  如果 轮次 == 空:
    抛出 新建 错误("无进行中的轮次可结束 [NO_ACTIVE_TURN]")
  转轮次(轮次, 结果, 原因)
  记检查点(驱动, "post-turn", 轮次快照(轮次), [])
  发事件(驱动, "turn/end", {"序号": 轮次["序号"], "结果": 结果})
  如果 长(驱动["轮次表"]) >= 驱动["最大轮次"]:
    字典设置(驱动, "已达上限", 真)
  返回 轮次

# ---- 步骤推进 ----

段落 开始步骤(驱动, 类型):
  设 轮次 为 驱动["当前轮次"]
  如果 轮次 == 空:
    抛出 新建 错误("无进行中的轮次可开步骤 [NO_ACTIVE_TURN]")
  如果 是否中止(驱动["信号"]) == 真:
    返回 空
  设 步骤 为 轮次追加步骤(轮次, 类型)
  字典设置(驱动, "当前步骤", 步骤)
  记检查点(驱动, "pre-step", 轮次快照(轮次), [])
  转步骤(步骤, 步骤进行)
  发事件(驱动, "step/start", {"轮次": 轮次["序号"], "序号": 步骤["序号"],
    "类型": 类型})
  返回 步骤

段落 结束步骤(驱动, 结果 = 步骤完成, 原因 = 空, 产出 = 空):
  设 步骤 为 驱动["当前步骤"]
  如果 步骤 == 空:
    抛出 新建 错误("无进行中的步骤可结束 [NO_ACTIVE_STEP]")
  转步骤(步骤, 结果, 原因)
  如果 产出 != 空:
    字典设置(步骤, "结果", 产出)
  设 轮次 为 驱动["当前轮次"]
  记检查点(驱动, "post-step", 轮次快照(轮次), [])
  发事件(驱动, "step/end", {"轮次": 轮次["序号"], "序号": 步骤["序号"],
    "结果": 结果})
  返回 步骤

# ---- 中止与恢复 ----

段落 中止循环(驱动, 原因 = "user_abort"):
  设 首次 为 请求中止(驱动["信号"], 原因)
  如果 驱动["当前步骤"] != 空 且 步骤是否终态(驱动["当前步骤"]) == 假:
    转步骤(驱动["当前步骤"], 步骤中止, 原因)
  如果 驱动["当前轮次"] != 空 且 轮次是否终态(驱动["当前轮次"]) == 假:
    转轮次(驱动["当前轮次"], 轮次中止, 原因)
  发事件(驱动, "abort", {"原因": 原因})
  返回 首次

# 恢复：从中止态续跑，跳过已完成步骤（按检查点序号定位）
段落 恢复循环(驱动):
  如果 是否中止(驱动["信号"]) == 假:
    返回 {"决定": "无需恢复", "跳过步骤": 0}
  设 点 为 取最近检查点(驱动)
  如果 点 == 空:
    返回 {"决定": "无检查点", "跳过步骤": 0}
  设 跳过 为 0
  如果 驱动["当前轮次"] != 空:
    遍历 步骤 之 驱动["当前轮次"]["步骤表"]:
      如果 步骤是否终态(步骤) == 真:
        设 跳过 为 跳过 + 1
  字典设置(驱动, "信号", 建中止信号())
  从检查点恢复(驱动, 点["序号"])
  发事件(驱动, "resume", {"检查点序号": 点["序号"], "跳过步骤": 跳过})
  返回 {"决定": "已恢复", "检查点序号": 点["序号"], "跳过步骤": 跳过}

# =====================================================================
# §5 事件投影：从事件流重建循环状态（幂等）
# =====================================================================

段落 投影循环(事件表, 起始序号 = 0):
  设 态 为 {"轮次数": 0, "步骤数": 0, "检查点数": 0, "中止数": 0,
    "恢复数": 0, "轮次状态": "none", "步骤状态": "none"}
  遍历 事件 之 事件表:
    如果 事件["序号"] > 起始序号:
      设 类型 为 事件["类型"]
      如果 类型 == "turn/start":
        字典设置(态, "轮次数", 态["轮次数"] + 1)
        字典设置(态, "轮次状态", 轮次进行)
      否则 如果 类型 == "turn/end":
        字典设置(态, "轮次状态", 事件["载荷"]["结果"])
      否则 如果 类型 == "step/start":
        字典设置(态, "步骤数", 态["步骤数"] + 1)
        字典设置(态, "步骤状态", 步骤进行)
      否则 如果 类型 == "step/end":
        字典设置(态, "步骤状态", 事件["载荷"]["结果"])
      否则 如果 类型 == "checkpoint":
        字典设置(态, "检查点数", 态["检查点数"] + 1)
      否则 如果 类型 == "abort":
        字典设置(态, "中止数", 态["中止数"] + 1)
      否则 如果 类型 == "resume":
        字典设置(态, "恢复数", 态["恢复数"] + 1)
  返回 态

# 投影不变量：步骤数不得为负 / 轮次数不得为负 / 检查点数单调
段落 校验循环投影(态):
  如果 是字典(态) == 假:
    返回 假
  如果 字典包含键(态, "轮次数") == 假:
    返回 假
  如果 字典包含键(态, "步骤数") == 假:
    返回 假
  如果 字典包含键(态, "检查点数") == 假:
    返回 假
  如果 态["轮次数"] < 0:
    返回 假
  如果 态["步骤数"] < 0:
    返回 假
  如果 态["检查点数"] < 0:
    返回 假
  返回 真

# 增量扫描：只处理 起始序号 之后的事件（不重复处理）
段落 增量投影(事件表, 起始序号):
  设 新事件 为 []
  遍历 事件 之 事件表:
    如果 事件["序号"] > 起始序号:
      新事件.追加(事件)
  返回 投影循环(新事件, 0)

# =====================================================================
# §6 R47 深化（#7）：请求头四原因 + 相位机（暂停恢复）+ 轮次驱动粘滞
#
# 上游（只读）：packages/core/agent-loop/src/agent.ts（ReactLoopAgent）+ core/session types.ts
#   1) 请求头四原因（agent.ts buildRequest 562-582 / RequestHeaderReason）：
#      initial（日志首个头）｜resume（循环实例首请求但日志已有头事件：进程重启/fork 种子）｜
#      change（后续请求头与基线不同，可携带 startsSeries）｜series（头未变但显式开启新消息系列）。
#      头相同且无系列边界 → 不追加 header 事件（纯决策返回 不记录）。
#   2) 相位机（agent.ts Phase idle/running/maintenance + wakeDriver 闩锁）：
#      非 idle 相位的唤醒不丢失——闩为待唤，收敛到 idle 时重放（暂停→fold→恢复 的纯决策面）。
#   3) 轮次驱动（agent.ts turn() 283-349）：max-tokens 粘滞——任一步骤触顶后，
#      后续正常完成的步骤不得把轮次结局降级；步骤终因非空且无待办步骤 → 轮次跳出。
# 纯逻辑复刻：不接真实事件总线/会话日志，决策输入全部显式传参。
# =====================================================================

设 请求头原因表 为 ["initial", "resume", "change", "series"]
设 步骤终因表 为 ["completed", "max-tokens"]
设 相位表 为 ["idle", "running", "maintenance"]

# ---- 1) 请求头四原因（对齐 agent.ts:570-581 判定序列）----
# 入参：已登记=本循环实例是否已追加过 header；有基线=日志中是否已存在 header 事件；
#       头变化=新头与基线不同；系列边界=startsRequestSeries 或 surface 代次变化。
# 返回：{"原因": 四原因之一或空, "记录": 是否追加事件, "开始系列": change 事件是否携带 startsSeries}
段落 循环请求头原因(已登记, 有基线, 头变化, 系列边界):
  如果 已登记 == 假:
    如果 有基线 == 假:
      返回 {"原因": "initial", "记录": 真, "开始系列": 假}
    返回 {"原因": "resume", "记录": 真, "开始系列": 假}
  如果 有基线 == 假 或 头变化 == 真:
    返回 {"原因": "change", "记录": 真, "开始系列": 系列边界}
  如果 系列边界 == 真:
    返回 {"原因": "series", "记录": 真, "开始系列": 假}
  返回 {"原因": 空, "记录": 假, "开始系列": 假}

# 头相等（深比较：config/tools 嵌套字典/列表逐键逐项；对齐上游 headerEquals 语义）
段落 循头相等(甲, 乙):
  如果 type(甲) != type(乙):
    返回 假
  如果 type(甲) == list:
    如果 长(甲) != 长(乙):
      返回 假
    设 i 为 0
    当 i < 长(甲):
      如果 循头相等(甲[i], 乙[i]) == 假:
        返回 假
      设 i 为 i + 1
    返回 真
  如果 type(甲) == dict:
    如果 长(甲) != 长(乙):
      返回 假
    遍历 k 之 甲:
      如果 乙.包含(k) == 假:
        返回 假
      如果 循头相等(甲[k], 乙[k]) == 假:
        返回 假
    返回 真
  返回 甲 == 乙

# ---- 2) 相位机：暂停恢复纯决策面（对齐 Phase idle/running/maintenance + wakeDriver 闩锁）----
段落 循建相位机(上轮次 = 0):
  返回 {"相态": "idle", "上轮次": 上轮次, "待唤": 假}

# 合法转换：idle → running/maintenance；running/maintenance → idle（上游 setPhase 语义）
段落 循相位可转(从, 到):
  如果 从 == "idle":
    返回 到 == "running" 或 到 == "maintenance"
  如果 从 == "running" 或 从 == "maintenance":
    返回 到 == "idle"
  返回 假

段落 循相位转(相位机, 目标):
  如果 相位表.包含(目标) == 假:
    抛出 新建 错误("未知相位：" + 转字符串(目标) + " [UNKNOWN_PHASE]")
  如果 循相位可转(相位机["相态"], 目标) == 假:
    抛出 新建 错误("非法相位转换：" + 相位机["相态"] + " → " + 目标 +
      " [ILLEGAL_PHASE_TRANSITION]")
  字典设置(相位机, "相态", 目标)
  返回 相位机

# 暂停决策：仅运行中的驱动可暂停；idle 无活动、maintenance 属维护作业（非轮次）不可由暂停面挂起
段落 循暂停决策(相位机):
  如果 相位机["相态"] == "running":
    返回 {"可暂停": 真, "动作": "挂起"}
  返回 {"可暂停": 假, "动作": "拒绝"}

# 折算：暂停瞬间把相位机折算为可持久化快照（fold state，不含活动轮次内部状态）
段落 循折算状态(相位机):
  返回 {"相态": 相位机["相态"], "上轮次": 相位机["上轮次"], "待唤": 相位机["待唤"]}

# 恢复决策：相位收敛到 idle 后——有待办输入 或 折算带待唤 → 续跑；否则待机；非 idle → 忙
段落 循恢复决策(相位机, 折算, 有待办):
  如果 相位机["相态"] != "idle":
    返回 {"可恢复": 假, "动作": "忙"}
  如果 有待办 == 真 或 折算["待唤"] == 真:
    返回 {"可恢复": 真, "动作": "续跑"}
  返回 {"可恢复": 真, "动作": "待机"}

# 唤醒闩锁（上游 wakeDriver）：idle 直接开跑；非 idle 的唤醒闩为待唤，收敛时重放
段落 循请求唤醒(相位机):
  如果 相位机["相态"] == "idle":
    返回 {"已闩锁": 假, "动作": "开跑"}
  字典设置(相位机, "待唤", 真)
  返回 {"已闩锁": 真, "动作": "待收敛重放"}

# 收敛：running/maintenance → idle，重放待唤并清闩
段落 循相位收敛(相位机):
  循相位转(相位机, "idle")
  设 重放 为 相位机["待唤"]
  字典设置(相位机, "待唤", 假)
  返回 {"相态": "idle", "重放唤醒": 重放}

# ---- 3) 轮次驱动深化（对齐 agent.ts turn() 283-349）----
# 步骤终因粘滞合并：现终结已是 max-tokens 时，后续 completed 步骤不得降级轮次结局
段落 循终因合并(现终结, 步骤终因):
  如果 步骤终因表.包含(步骤终因) == 假:
    抛出 新建 错误("未知步骤终因：" + 转字符串(步骤终因) + " [UNKNOWN_STEP_END]")
  如果 现终结 == "max-tokens":
    返回 "max-tokens"
  返回 步骤终因

# 轮次续跑判定：无终结 → 续跑；有终结 且 有待办步骤 → 续跑；有终结 且 待办空 → 跳出
段落 循轮次续跑(现终结, 有待办步骤):
  如果 现终结 == 空:
    返回 真
  返回 有待办步骤

