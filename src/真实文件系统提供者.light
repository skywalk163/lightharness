# 真实文件系统提供者.light —— 第41轮 任务1（宿主层真实IO·文件）
#
# 定位：把「宿主IO.light 内存文件系统提供者」与「文件系统工具.light 宿主入参字典」
#   两套接口形状，用光明真实文件内建接到真实磁盘。原任务书要求：「零修改
#   文件系统工具.light / 宿主IO.light」，本文件是新增适配器，不改动任何既有文件。
#
# 两层接口：
#   层1 —— 宿主IO 风格 FS 提供者：返回 IO结果 统一形状
#         {"成功","数据","错误码","错误消息","元数据"}。
#   层2 —— 文件系统工具 宿主入参字典：返回原值（"查信息"→["类型","大小","版本"] 或 空；
#         "读文本"/"写文本"/"读头字节"）。
#
# 护栏（任务书铁律）：
#   - 所有路径经 工具_路径安全.解析安全路径 做 HARNESS_ROOT 越界拒绝；
#     越界一律返回 PERMISSION_DENIED，绝不落到磁盘。
#   - 原子写 = 临时文件 + 原子替换(=os.replace)。写临时落盘后、替换前若崩溃，
#     目标文件保持旧版不变（崩溃恢复保证）。
#   - 内部全部复用 light 真实文件内建（读取文件/写入文件/创建目录/文件存在/
#     列出目录/文件大小/读二进制文件/原子替换/目录名/文件名…），不伪造任何原语。
#
# 运行：
#   cd lightharness && python 运行.py examples/test_R41_真实文件IO.light

从 工具_路径安全 导入 取根目录, 解析安全路径

# =====================================================================
# §0 IO结果 统一形状（与 宿主IO.light 逐字一致；本地自含以免强耦合）
# =====================================================================
段落 造成功结果(数据, 元数据):
  设 r 为 {}
  r["成功"] 为 真
  r["数据"] 为 数据
  r["错误码"] 为 空
  r["错误消息"] 为 空
  r["元数据"] 为 元数据
  返回 r

段落 造失败结果(错误码, 错误消息, 元数据):
  设 r 为 {}
  r["成功"] 为 假
  r["数据"] 为 空
  r["错误码"] 为 错误码
  r["错误消息"] 为 错误消息
  r["元数据"] 为 元数据
  返回 r

# 异常文本：异常对象属性用 e.args（光明仅暴露英文 args；同 HTTP服务端.light:472）
段落 异常文本(e):
  尝试:
    设 a 为 e.args
    如果 列表长度(a) > 0:
      返回 转字符串(a[0])
    返回 ""
  捕获 异常 e2:
    返回 ""

# =====================================================================
# §1 层1：宿主IO 风格 FS 提供者（返回 IO结果 形状）
# =====================================================================
段落 文件存在提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "exists", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    设 存在 为 文件存在(真实)
    返回 造成功结果(存在, {"操作": "exists", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "exists", "请求ID": 请求ID})

段落 读文件提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "read", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    如果 文件存在(真实) == 假:
      返回 造失败结果("NOT_FOUND", "文件不存在 " + 路径, {"操作": "read", "路径": 真实, "请求ID": 请求ID})
    如果 目录存在(真实) == 真:
      返回 造失败结果("INVALID_ARGUMENT", "是目录非文件 " + 路径, {"操作": "read", "路径": 真实, "请求ID": 请求ID})
    设 内容 为 读取文件(真实)
    返回 造成功结果(内容, {"操作": "read", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "read", "路径": 真实, "请求ID": 请求ID})

段落 写文件提供(路径, 内容, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "write", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    写入文件(真实, 内容)
    返回 造成功结果(真, {"操作": "write", "路径": 真实, "大小": 字符串长度(内容), "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "write", "路径": 真实, "请求ID": 请求ID})

段落 创建目录提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "mkdir", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    创建目录(真实)
    返回 造成功结果(真, {"操作": "mkdir", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "mkdir", "路径": 真实, "请求ID": 请求ID})

段落 删除文件提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "unlink", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    如果 文件存在(真实) == 假:
      返回 造失败结果("NOT_FOUND", "文件不存在 " + 路径, {"操作": "unlink", "路径": 真实, "请求ID": 请求ID})
    删除文件(真实)
    返回 造成功结果(真, {"操作": "unlink", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "unlink", "路径": 真实, "请求ID": 请求ID})

段落 重命名提供(旧路径, 新路径, 请求ID):
  设 根 为 取根目录()
  设 解旧 为 解析安全路径(根, 旧路径)
  如果 解旧["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解旧["理由"], {"操作": "rename", "路径": 旧路径, "请求ID": 请求ID})
  设 解新 为 解析安全路径(根, 新路径)
  如果 解新["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解新["理由"], {"操作": "rename", "路径": 新路径, "请求ID": 请求ID})
  尝试:
    如果 文件存在(解旧["路径"]) == 假 且 目录存在(解旧["路径"]) == 假:
      返回 造失败结果("NOT_FOUND", "源不存在 " + 旧路径, {"操作": "rename", "路径": 解旧["路径"], "请求ID": 请求ID})
    重命名(解旧["路径"], 解新["路径"])
    返回 造成功结果(真, {"操作": "rename", "旧": 解旧["路径"], "新": 解新["路径"], "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "rename", "请求ID": 请求ID})

段落 列目录提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "list", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    如果 目录存在(真实) == 假:
      返回 造失败结果("NOT_FOUND", "目录不存在 " + 路径, {"操作": "list", "路径": 真实, "请求ID": 请求ID})
    设 表 为 列出目录(真实)
    返回 造成功结果(表, {"操作": "list", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "list", "路径": 真实, "请求ID": 请求ID})

段落 获取文件信息提供(路径, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "stat", "路径": 路径, "请求ID": 请求ID})
  设 真实 为 解["路径"]
  尝试:
    如果 文件存在(真实) == 假 且 目录存在(真实) == 假:
      返回 造失败结果("NOT_FOUND", "文件不存在 " + 路径, {"操作": "stat", "路径": 真实, "请求ID": 请求ID})
    设 是目录 为 目录存在(真实)
    设 大小 为 文件大小(真实)
    返回 造成功结果({"路径": 真实, "大小": 大小, "是目录": 是目录}, {"操作": "stat", "路径": 真实, "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "stat", "请求ID": 请求ID})

# 原子写：临时文件落盘 + 原子替换。写临时后、替换前若崩溃，目标保持旧版不变。
段落 原子写文件提供(路径, 内容, 请求ID):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 造失败结果("PERMISSION_DENIED", 解["理由"], {"操作": "atomic-write", "路径": 路径, "请求ID": 请求ID})
  设 目标 为 解["路径"]
  尝试:
    设 父 为 目录名(目标)
    设 临时 为 父 + "/" + "." + 文件名(目标) + ".atomic.tmp"
    如果 文件存在(临时) == 真:
      删除文件(临时)
    写入文件(临时, 内容)          # 临时已落盘；此处若崩溃，目标未动
    原子替换(临时, 目标)          # 同卷内原子改名覆盖
    返回 造成功结果(真, {"操作": "atomic-write", "路径": 目标, "大小": 字符串长度(内容), "请求ID": 请求ID})
  捕获 异常 e:
    返回 造失败结果("IO_ERROR", 异常文本(e), {"操作": "atomic-write", "路径": 目标, "请求ID": 请求ID})

# =====================================================================
# §2 层2：文件系统工具 宿主入参字典（返回原值）
# =====================================================================
# 查信息(路径) -> ["类型","大小","版本"] 或 空（空=不存在，与 文件系统工具.判读目标 契约一致）
段落 查信息(路径):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    返回 空
  设 真实 为 解["路径"]
  如果 文件存在(真实) == 假 且 目录存在(真实) == 假:
    返回 空
  如果 目录存在(真实) == 真:
    返回 ["类型": "目录", "大小": 0, "版本": 0]
  设 大小 为 文件大小(真实)
  # 版本用文件大小作代理（内容变→字节数通常变；纯做陈旧检测够用）
  返回 ["类型": "文件", "大小": 大小, "版本": 大小]

段落 读文本(路径):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    抛出 新建 错误("路径越界: " + 解["理由"])
  返回 读取文件(解["路径"])

# 写文本：原子写（临时 + 原子替换），避免覆盖中途读到半截内容
段落 写文本(路径, 内容):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    抛出 新建 错误("路径越界: " + 解["理由"])
  设 目标 为 解["路径"]
  设 父 为 目录名(目标)
  设 临时 为 父 + "/" + "." + 文件名(目标) + ".tmp"
  如果 文件存在(临时) == 真:
    删除文件(临时)
  写入文件(临时, 内容)
  原子替换(临时, 目标)

# 读头字节(路径, 字节数) -> 整数列表（图片嗅探用，返回字节串逐字节整数）
段落 读头字节(路径, 字节数):
  设 根 为 取根目录()
  设 解 为 解析安全路径(根, 路径)
  如果 解["ok"] == 假:
    抛出 新建 错误("路径越界: " + 解["理由"])
  设 真实 为 解["路径"]
  设 总 为 文件大小(真实)
  设 取 为 字节数
  如果 取 > 总:
    设 取 为 总
  设 原始 为 读二进制文件(真实)      # bytes
  设 表 为 []
  设 i 为 0
  当 i < 取:
    列表追加(表, 原始[i])           # bytes 索引返回整数
    设 i 为 i + 1
  返回 表

# =====================================================================
# §3 装配：把层2 函数打包成 文件系统工具 期望的 宿主 字典
# =====================================================================
段落 造宿主字典():
  设 宿主 为 {}
  宿主["查信息"] 为 查信息
  宿主["读文本"] 为 读文本
  宿主["写文本"] 为 写文本
  宿主["读头字节"] 为 读头字节
  返回 宿主

导出 造成功结果, 造失败结果, 异常文本
导出 文件存在提供, 读文件提供, 写文件提供, 创建目录提供, 删除文件提供, 重命名提供, 列目录提供, 获取文件信息提供, 原子写文件提供
导出 查信息, 读文本, 写文本, 读头字节
导出 造宿主字典
