# 宿主配置.light —— 第17轮任务6 宿主配置接线原型（#115 / R17-D6）
# 定位：配置注册表/加载器/变更事件/凭证接线框架。只读复用 设置.light（分层合并/脱敏值）+ 凭据.light（凭证引用）。
# 自包含说明：本轮任务1/2/3 的 宿主运行时/宿主上下文/宿主事件 尚不存在，本路以字典形状承载运行时，不 import 不存在模块。
# 运行：cd lightharness && python 运行.py examples/test_宿主配置.light

从 设置 导入 分层合并, 脱敏值
从 凭据 导入 凭证引用

# =====================================================================
# §0 公共辅助
# =====================================================================
段落 包含文本 接收 文本, 子串:
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 是数字 接收 值:
  返回 是整数(值) 或 是浮点(值)

# =====================================================================
# §1 配置注册表
# =====================================================================
段落 配置类型表:
  返回 ["string", "number", "boolean", "object", "array"]

段落 造配置项 接收 键, 类型, 默认值, 描述, 来源, 可变性, 命名空间, 秘密, 分组, 校验函数:
  返回 {"键": 键, "类型": 类型, "默认值": 默认值, "描述": 描述, "来源": 来源,
    "可变性": 可变性, "命名空间": 命名空间, "秘密": 秘密, "分组": 分组, "校验函数": 校验函数}

段落 造注册表:
  返回 {"项": {}}

段落 注册配置项 接收 注册表, 项:
  字典设置(注册表["项"], 项["键"], 项)
  返回 真

段落 获取配置项 接收 注册表, 键:
  设 项 为 字典获取(注册表["项"], 键, 空)
  如果 项 == 空:
    抛出 新建 错误("宿主配置: 未注册的配置项 " + 键)
  返回 项

段落 列举配置项 接收 注册表, 过滤:
  设 结果 为 []
  遍历 键 之 字典键列表(注册表["项"]):
    设 项 为 字典获取(注册表["项"], 键)
    设 命中 为 真
    如果 字典包含键(过滤, "命名空间") 且 过滤["命名空间"] != 空:
      如果 项["命名空间"] != 过滤["命名空间"]:
        设 命中 为 假
    如果 命中 == 真 且 字典包含键(过滤, "分组") 且 过滤["分组"] != 空:
      如果 项["分组"] != 过滤["分组"]:
        设 命中 为 假
    如果 命中 == 真 且 字典包含键(过滤, "可变性") 且 过滤["可变性"] != 空:
      如果 项["可变性"] != 过滤["可变性"]:
        设 命中 为 假
    如果 命中 == 真:
      结果.追加(项)
  返回 结果

段落 校验类型 接收 类型, 值:
  如果 类型 == "string":
    返回 是字符串(值)
  如果 类型 == "number":
    返回 是数字(值)
  如果 类型 == "boolean":
    返回 type(值) == bool
  如果 类型 == "object":
    返回 是字典(值)
  如果 类型 == "array":
    返回 是列表(值)
  返回 假

# =====================================================================
# §2 配置存储与获取
# =====================================================================
段落 造存储:
  返回 {"当前值表": {}, "默认值表": {}, "来源追踪表": {}, "变更监听": {}, "变更序号": 0, "变更历史": []}

段落 脱敏单值 接收 值:
  # 复用 设置.light 脱敏值：secret 角色下返回 空，标记秘密；本框架显示为 ***
  设 结果 为 脱敏值({"角色": "secret"}, 值)
  如果 列表长度(结果["秘密"]) > 0:
    返回 "***"
  返回 值

段落 获取配置 接收 存储, 注册表, 键:
  设 项 为 获取配置项(注册表, 键)
  设 当前 为 字典获取(存储["当前值表"], 键, 空)
  如果 当前 != 空:
    如果 项["秘密"] == 真:
      返回 脱敏单值(当前)
    返回 当前
  设 默认 为 项["默认值"]
  如果 默认 != 空:
    如果 项["秘密"] == 真:
      返回 脱敏单值(默认)
    返回 默认
  抛出 新建 错误("宿主配置: 无当前值也无默认值的配置项 " + 键)

段落 尝试获取配置 接收 存储, 注册表, 键:
  尝试:
    返回 获取配置(存储, 注册表, 键)
  捕获 异常:
    返回 空

段落 设置配置 接收 存储, 注册表, 键, 值, 来源:
  设 项 为 获取配置项(注册表, 键)
  # 可变性检查（反跑 B 变异锚点：删此检查则只读项可被改 → 测试红）
  如果 项["可变性"] == "只读" 且 字典包含键(存储["当前值表"], 键):
    抛出 新建 错误("宿主配置: 只读配置不可改 " + 键)
  # 类型校验
  如果 校验类型(项["类型"], 值) == 假:
    抛出 新建 错误("宿主配置: 类型不匹配 " + 键 + " 期望 " + 项["类型"])
  # 自定义校验函数
  设 校验 为 字典获取(项, "校验函数", 空)
  如果 校验 != 空:
    设 结论 为 校验(值)
    如果 结论["通过"] == 假:
      抛出 新建 错误("宿主配置: 校验失败 " + 键 + " " + 结论["错误消息"])
  # 变更前事件（可否决）
  设 旧值 为 字典获取(存储["当前值表"], 键, 字典获取(存储["默认值表"], 键, 空))
  如果 变更前被否决(存储, 键, 旧值, 值) == 真:
    抛出 新建 错误("宿主配置: 变更被监听器否决 " + 键)
  字典设置(存储["当前值表"], 键, 值)
  字典设置(存储["来源追踪表"], 键, 来源)
  记录变更(存储, 键, 旧值, 值, 来源)
  派发变更后(存储, 键, 旧值, 值, 来源)
  返回 真

段落 重置配置 接收 存储, 注册表, 键:
  设 项 为 获取配置项(注册表, 键)
  设 默认 为 字典获取(存储["默认值表"], 键, 空)
  设 旧值 为 字典获取(存储["当前值表"], 键, 空)
  如果 变更前被否决(存储, 键, 旧值, 默认) == 真:
    抛出 新建 错误("宿主配置: 重置被监听器否决 " + 键)
  字典删除(存储["当前值表"], 键)
  字典设置(存储["来源追踪表"], 键, "默认值")
  记录变更(存储, 键, 旧值, 默认, "默认值")
  派发变更后(存储, 键, 旧值, 默认, "默认值")
  返回 真

段落 获取配置来源 接收 存储, 键:
  设 源 为 字典获取(存储["来源追踪表"], 键, 空)
  如果 源 == 空:
    返回 "默认值"
  返回 源

段落 配置快照 接收 存储, 注册表:
  设 快照 为 {}
  遍历 键 之 字典键列表(注册表["项"]):
    设 值 为 尝试获取配置(存储, 注册表, 键)
    字典设置(快照, 键, 值)
  返回 快照

# =====================================================================
# §3 配置加载器（多层合并，复用 设置.light 分层合并）
# =====================================================================
段落 环境变量到键 接收 名:
  设 去前缀 为 名
  如果 包含文本(名, "DSH_") == 真:
    设 去前缀 为 截取(名, 字符串长度("DSH_"), 字符串长度(名))
  返回 替换下划线为点(去前缀)

段落 替换下划线为点 接收 名:
  设 结果 为 ""
  设 i 为 0
  当 i < 字符串长度(名):
    设 字符 为 字符串获取(名, i)
    如果 字符 == "_":
      设 结果 为 结果 + "."
    否则:
      设 结果 为 结果 + 字符
    设 i 为 i + 1
  返回 结果

段落 按优先级升序 接收 层列表:
  设 排序 为 []
  遍历 层 之 层列表:
    排序.追加(层)
  设 i 为 0
  当 i < 列表长度(排序):
    设 j 为 i + 1
    当 j < 列表长度(排序):
      如果 字典获取(排序[j], "优先级", 0) < 字典获取(排序[i], "优先级", 0):
        设 临时 为 排序[i]
        设 排序[i] 为 排序[j]
        设 排序[j] 为 临时
      设 j 为 j + 1
    设 i 为 i + 1
  返回 排序

段落 合并层数据源 接收 层列表:
  # 复用 分层合并：由低优先级向高优先级递归合并（高覆盖低）
  设 合并 为 {}
  遍历 层 之 按优先级升序(层列表):
    设 合并 为 分层合并(合并, 字典获取(层, "数据源", {}))
  返回 合并

段落 加载配置层 接收 存储, 注册表, 层:
  设 源 为 字典获取(层, "来源类型", "配置文件")
  遍历 键 之 字典键列表(字典获取(层, "数据源", {})):
    设 值 为 字典获取(层["数据源"], 键)
    尝试:
      设置配置(存储, 注册表, 键, 值, 源)
    捕获 异常:
      设 占位 为 真
  返回 真

段落 加载全部 接收 存储, 注册表, 层列表:
  # 反跑 C 变异锚点：若此处改为 按优先级降序 合并，低优先级会覆盖高优先级 → 测试红
  遍历 层 之 按优先级升序(层列表):
    加载配置层(存储, 注册表, 层)
  返回 真

# =====================================================================
# §4 配置变更事件
# =====================================================================
段落 监听配置变更 接收 存储, 键, 回调, 可否决:
  设 存储["变更序号"] 为 存储["变更序号"] + 1
  设 ID 为 "L" + 文本(存储["变更序号"])
  字典设置(存储["变更监听"], ID, {"键": 键, "回调": 回调, "可否决": 可否决})
  返回 ID

段落 取消监听 接收 存储, ID:
  字典删除(存储["变更监听"], ID)
  返回 真

段落 变更前被否决 接收 存储, 键, 旧值, 新值:
  遍历 ID 之 字典键列表(存储["变更监听"]):
    设 监听 为 字典获取(存储["变更监听"], ID)
    设 监听键 为 字典获取(监听, "键", 空)
    如果 监听键 == 空 或 监听键 == 键:
      如果 字典获取(监听, "可否决", 假) == 真:
        设 结论 为 监听["回调"](键, 旧值, 新值)
        如果 结论["允许"] == 假:
          返回 真
  返回 假

段落 派发变更后 接收 存储, 键, 旧值, 新值, 来源:
  遍历 ID 之 字典键列表(存储["变更监听"]):
    设 监听 为 字典获取(存储["变更监听"], ID)
    设 监听键 为 字典获取(监听, "键", 空)
    如果 监听键 == 空 或 监听键 == 键:
      尝试:
        监听["回调"](键, 旧值, 新值, 来源)
      捕获 异常:
        设 占位 为 真
  返回 真

段落 记录变更 接收 存储, 键, 旧值, 新值, 来源:
  存储["变更历史"].追加({"键": 键, "旧值": 旧值, "新值": 新值, "来源": 来源, "序号": 存储["变更序号"]})
  返回 真

段落 获取变更历史 接收 存储:
  返回 存储["变更历史"]

# =====================================================================
# §5 凭证接线
# =====================================================================
段落 造凭证表:
  返回 {"提供者": {}}

段落 注册凭证提供者 接收 表, 名, 提供者:
  字典设置(表["提供者"], 名, 提供者)
  返回 真

段落 解析凭证 接收 表, 引用:
  # 复用 凭据.light 凭证引用 校验格式（非法抛错）
  凭证引用(引用)
  设 顺序 为 ["env", "user", "project", "default"]
  遍历 层名 之 顺序:
    遍历 名 之 字典键列表(表["提供者"]):
      设 提供者 为 字典获取(表["提供者"], 名)
      设 解决 为 提供者(引用, 层名)
      如果 解决 != 空:
        返回 {"值": 解决["值"], "源": 层名, "提供者": 名}
  返回 空

段落 凭证脱敏 接收 值:
  # 复用 设置.light 脱敏值：secret 角色下标记秘密 → 显示为 ***
  设 结果 为 脱敏值({"角色": "secret"}, 值)
  如果 列表长度(结果["秘密"]) > 0:
    返回 "***"
  返回 值

# =====================================================================
# §6 配置验证器
# =====================================================================
段落 验证配置项 接收 存储, 注册表, 键:
  设 项 为 获取配置项(注册表, 键)
  设 当前 为 字典获取(存储["当前值表"], 键, 项["默认值"])
  设 错误 为 空
  如果 校验类型(项["类型"], 当前) == 假:
    设 错误 为 "类型不匹配 期望 " + 项["类型"]
  否则:
    设 校验 为 字典获取(项, "校验函数", 空)
    如果 校验 != 空:
      设 结论 为 校验(当前)
      如果 结论["通过"] == 假:
        设 错误 为 结论["错误消息"]
  如果 错误 == 空:
    返回 {"通过": 真, "错误列表": []}
  返回 {"通过": 假, "错误列表": [{"键": 键, "错误消息": 错误, "当前值": 当前}]}

段落 验证全部配置 接收 存储, 注册表:
  设 列表 为 []
  遍历 键 之 字典键列表(注册表["项"]):
    设 结论 为 验证配置项(存储, 注册表, 键)
    如果 结论["通过"] == 假:
      遍历 e 之 结论["错误列表"]:
        列表.追加(e)
  如果 列表长度(列表) == 0:
    返回 {"通过": 真, "错误列表": []}
  返回 {"通过": 假, "错误列表": 列表}
