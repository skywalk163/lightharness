# 工作流记录镜像.light —— 后台工作流运行的 live-progress 记录镜像（R87 B3 第2组）
#
# 上游只读依据（877717787c）：
#   - packages/workflow/tool-workflow/src/record.ts
#       createWorkflowRecordMirror：runId → 作业把手的登记面；把引擎
#       workflow/phase、workflow/log、成员生命周期事件镜像成作业输出环的
#       log 块（观察者旁白，不进模型 job_output 渲染）；并把 live 进度线推到当前阶段。
#   - packages/workflow/tool-workflow/src/index.ts
#       jobOutcomeOf：把一次已结算后台运行的停止原因映射到作业结局词汇
#       （completed/cancelled/error → completed/killed/failed），completed 附带
#       渲染后的返回值；renderResult / 截断上限 同源搬入。
#
# 纯逻辑面：不持有真实事件总线 / 作业环。作业把手在本模块只是一个不透明
# 登记键（用作业标签或作业 id 占位），镜像只负责「运行标识 → 是否在录 +
# 该事件应产出的 log 行文本」。宿主接线（ctx.on / job.append）由调用方完成。

从 JSON 导入 序列化JSON

# ---- 作业环 log 行格式（对齐 record.ts 四个 ctx.on 处理器）----

# workflow/phase：进度线推到阶段，并写一行 `▸ {标题}\n`
段落 阶段日志行(标题):
  返回 "▸ " 加上 标题 加上 "\n"

# workflow/log：原样追加 `{正文}\n`
段落 通道日志行(正文):
  返回 正文 加上 "\n"

# agent-start：成员启动 `agent #{序号} {标签} started\n`
段落 成员启动行(序号, 标签):
  返回 "agent #" 加上 转字符串(序号) + " " 加上 标签 加上 " started\n"

# agent-end：成员结束 `agent #{序号} {结局}\n`
段落 成员结束行(序号, 结局):
  返回 "agent #" 加上 转字符串(序号) + " " 加上 结局 加上 "\n"

# ---- 运行标识 → 作业把手 登记表（对齐 WorkflowRecordMirror.start/stop）----
# 登记面纯内存：停止幂等；结算后来的迟到事件因运行标识已摘出而被丢弃。
类 记录镜像:
  属性 活跃表 等于 {}

  # 开始跟踪一次后台运行：把运行标识绑到它的作业把手（不透明键）
  段落 开始(运行标识, 作业):
    己.活跃表[运行标识] 为 作业

  # 停止跟踪：摘出运行标识；重复停止无副作用
  段落 停止(运行标识):
    设 新表 为 {}
    遍历 键 之 字典键列表(己.活跃表):
      如果 键 != 运行标识:
        新表[键] 为 己.活跃表[键]
    设 己.活跃表 为 新表

  # 是否在录（供调用方判断路由命中）
  段落 是否在录(运行标识):
    返回 字典包含键(己.活跃表, 运行标识)

  # 投递一个引擎事件，返回应写进作业环的 log 行（未在录返回空串）。
  # 载荷 = {"标识":运行标识, ...其余字段}；种类 ∈ phase/log/成员启/成员止。
  # phase 另带「标题」；log 另带「正文」；成员启/止另带「序号」「标签|结局」。
  段落 投递(种类, 载荷):
    如果 载荷.包含("标识") == 假:
      返回 ""
    设 运行标识 为 载荷["标识"]
    如果 字典包含键(己.活跃表, 运行标识) == 假:
      返回 ""
    如果 种类 == "phase":
      设 标题 为 ""
      如果 载荷.包含("标题"):
        设 标题 为 载荷["标题"]
      返回 阶段日志行(标题)
    否则如果 种类 == "log":
      设 正文 为 ""
      如果 载荷.包含("正文"):
        设 正文 为 载荷["正文"]
      返回 通道日志行(正文)
    否则如果 种类 == "成员启":
      设 序号 为 0
      设 标签 为 ""
      如果 载荷.包含("序号"): 设 序号 为 载荷["序号"]
      如果 载荷.包含("标签"): 设 标签 为 载荷["标签"]
      返回 成员启动行(序号, 标签)
    否则如果 种类 == "成员止":
      设 序号 为 0
      设 结局 为 ""
      如果 载荷.包含("序号"): 设 序号 为 载荷["序号"]
      如果 载荷.包含("结局"): 设 结局 为 载荷["结局"]
      返回 成员结束行(序号, 结局)
    返回 ""

# ---- 结局判定（对齐 index.ts jobOutcomeOf + renderResult）----

# 字符上限截断（对齐上游截断：超长尾附 "\n… [truncated]"）
段落 截断到上限(原文, 上限):
  如果 字符串长度(原文) <= 上限:
    返回 原文
  设 标记 为 "\n… [truncated]"
  如果 上限 <= 字符串长度(标记):
    返回 截取(标记, 0, 上限)
  返回 截取(原文, 0, 上限 - 字符串长度(标记)) + 标记

# 渲染运行结局文本（对齐 renderResult）：名称 + 启动成员数 + 截断后的返回值 JSON
段落 渲染结局(名, 启动成员数, 值, 上限):
  设 成员词 为 " agent"
  如果 启动成员数 != 1:
    设 成员词 为 " agents"
  设 主体 为 "workflow \"" 加上 名 加上 "\" completed (" 加上 转字符串(启动成员数) + 成员词 加上 ").\nReturn value:\n" + 序列化JSON(值)
  返回 截断到上限(主体, 上限)

# 把已结算后台运行的停止原因映射到作业结局词汇（对齐 jobOutcomeOf）
# 结果 = {"停止原因": completed|cancelled|error, "启动成员数":n, "返回值":json, "错误"?:str}
段落 作业结局(结果, 名, 上限):
  如果 结果["停止原因"] == "completed":
    设 启动数 为 0
    如果 结果.包含("启动成员数"):
      设 启动数 为 结果["启动成员数"]
    设 返回值 为空
    如果 结果.包含("返回值"):
      设 返回值 为 结果["返回值"]
    设 细节 为 转字符串(启动数) + " agent"
    如果 启动数 != 1:
      设 细节 为 转字符串(启动数) + " agents"
    返回 ["状态": "completed", "细节": 细节, "结果": 渲染结局(名, 启动数, 返回值, 上限)]
  否则如果 结果["停止原因"] == "cancelled":
    返回 ["状态": "killed"]
  否则如果 结果["停止原因"] == "error":
    设 错误 为 "unknown error"
    如果 结果.包含("错误") 且 结果["错误"] != 空:
      设 错误 为 结果["错误"]
    返回 ["状态": "failed", "细节": 错误]
  否则:
    # 防御性：停止原因应为闭合枚举；未知变体大声失败
    返回 ["状态": "failed", "细节": "workflow run ended abnormally (" 加上 转字符串(结果["停止原因"]) + ")"]
