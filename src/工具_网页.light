# 工具_网页.light —— T-0452：把已复刻的搜索/抓取纯逻辑接成 web_search / web_fetch
#
# 背景（任务卡）：DSH 的 packages/web 里 web_search / web_fetch 是标准预设常驻工具；
# lightharness 的纯逻辑（搜索提供商 / 抓取策略 / 真实抓取提供 / 溢出）都在，但没有消费者，
# 模型只能靠 bash curl 查资料（Windows 上还不稳）。
#
# 本模块只做「接线」：不复制判定、不伪造网络能力，一切谓词与归一都调既有模块：
#   - 搜索执行体 → 搜索提供商.造搜索工具定义（参数校验 / 构造请求 / 归一响应）
#   - 抓取准入   → 抓取策略.校验抓取地址 + 抓取策略.主机是否非公网字面量
#   - 正文溢出   → 溢出.取前N字节 / 取后N字节 / 描述省略（见 §2 为何不用 构造预览）
#
# 导出三个入口：
#   造网页搜索工具定义(依赖)  —— web_search（query 必填 / limit 可选）
#   造网页抓取工具定义(依赖)  —— web_fetch（url 必填；私网字面量/非 http(s) 拒绝）
#   网页工具状态(依赖)        —— {搜索:{可用,原因}, 抓取:{可用,原因}}，供启动日志与 doctor
#
# 依赖注入（测试全部离线，禁止联网）：
#   搜索依赖 = {提供商?: "deepseek-official"|"exa"|"perplexity", 密钥?: 串, 密钥变量?: 串,
#               配置?: 选项字典, 执行器: fn(请求)->响应载荷}
#   抓取依赖 = {抓取器: fn(网址)->{状态,内容类型,体} 或 [状态,内容类型,体],
#               上限字节?: 整数（默认 32768）}
#
# 反跑锚点（任务卡判据 6）：
#   A：删掉 判定抓取准入 里「主机是否非公网字面量」那一行 → tests/test_T0452_网页工具.py
#      用例 3（四类非法目标必须拒绝）立红。
#   B：把 执行网页搜索 里的「密钥为空 → 造缺密钥结果」改回静默返回空表 → 用例 1 立红。
#
# 命名避坑：标识符不用「为」字；变量名避 字典/包含/输出/空/返回/设/是/并/之 等词法敏感词。

从 工具 导入 造工具定义, 造工具结果, 校验参数
从 JSON 导入 序列化JSON, 解析JSON
从 搜索提供商 导入 造搜索工具定义, 归一参数
从 抓取策略 导入 校验抓取地址, 主机是否非公网字面量, 分类内容类型
从 溢出 导入 字节长度, 取前N字节, 取后N字节, 描述省略
从 内置核心转换 导入 转字符串

# =====================================================================
# §0 常量
# =====================================================================

设 搜索工具标识 为 "web_search"
设 抓取工具标识 为 "web_fetch"
设 默认网页提供商 为 "deepseek-official"
设 默认抓取上限字节 为 32768
设 地址最大长度 为 8192

# 提供商 → 密钥环境变量名（与 DSH / docs/快速开始.md 口径一致）
段落 密钥环境变量(提供商名):
  如果 提供商名 == "exa":
    返回 "EXA_API_KEY"
  如果 提供商名 == "perplexity":
    返回 "PERPLEXITY_API_KEY"
  返回 "DEEPSEEK_API_KEY"

# 读取搜索密钥：依赖显式 密钥 优先，其次读环境变量（变量名可被 密钥变量 覆盖，便于测试/多账号）
段落 取搜索密钥(依赖, 提供商名):
  设 显式 为 字典获取(依赖, "密钥", "")
  如果 type(显式) == str:
    如果 字符串长度(显式) > 0:
      返回 显式
  设 变量 为 字典获取(依赖, "密钥变量", 密钥环境变量(提供商名))
  设 值 为 环境变量(变量, "")
  如果 type(值) != str:
    返回 ""
  返回 值

# 缺密钥的可读报错（点名缺哪个变量，且明确「不会发请求」）
段落 造缺密钥结果(提供商名):
  设 变量 为 密钥环境变量(提供商名)
  返回 造工具结果([["type": "text", "text": "web_search 不可用：缺少 " + 提供商名 + " 的 API 密钥。请设置环境变量 " + 变量 + "（或在依赖里显式传入 密钥）。缺密钥时不会发请求，也不会返回空结果。"]], 真)

# =====================================================================
# §1 web_search —— 参数 query（必填）/ limit（可选，1-100）
# =====================================================================

段落 网页搜索参数模式:
  设 模式 为 ["type": "object"]
  设 属性 为 {}
  属性["query"] 为 ["type": "string", "minLength": 1, "description": "搜索词（非空）"]
  属性["limit"] 为 ["type": "integer", "minimum": 1, "maximum": 100, "description": "返回条数上限（可选，1-100）"]
  模式["properties"] 为 属性
  模式["required"] 为 ["query"]
  返回 模式

# 按 limit 截断归一后的源表；返回 {"sources", "truncated"}
段落 截断源表(结果, 上限):
  设 源表 为 字典获取(结果, "sources", [])
  如果 type(源表) != list:
    设 源表 为 []
  设 保留 为 []
  设 i 为 0
  当 i < 列表长度(源表):
    如果 上限 > 0 且 i >= 上限:
      跳出
    列表追加(保留, 源表[i])
    设 i 为 i + 1
  设 已截断 为 字典获取(结果, "truncated", 假)
  如果 上限 > 0 且 列表长度(源表) > 上限:
    设 已截断 为 真
  返回 {"sources": 保留, "truncated": 已截断}

# 造 web_search 工具定义
#   依赖 = {提供商?, 密钥?, 密钥变量?, 配置?, 执行器}；执行体委托 搜索提供商.造搜索工具定义。
段落 造网页搜索工具定义(依赖):
  设 提供商名 为 字典获取(依赖, "提供商", 默认网页提供商)
  设 配置 为 字典获取(依赖, "配置", {})
  如果 字典包含键(依赖, "执行器") == 假:
    抛出 新建 错误("造网页搜索工具定义：依赖缺少 执行器（真实层注入 HTTP 执行器，测试注入假载荷函数）")
  设 执行器 为 依赖["执行器"]
  # 上游执行体（参数校验 / 构造请求 / 调执行器 / 归一响应）复用，本层只加「缺密钥闸门 + limit 截断」
  设 基定义 为 造搜索工具定义({"提供商": 提供商名, "密钥": 取搜索密钥(依赖, 提供商名), "配置": 配置, "执行器": 执行器})
  段落 执行(参数):
    设 参数错误 为 校验参数(网页搜索参数模式(), 参数)
    如果 列表长度(参数错误) > 0:
      返回 造工具结果([["type": "text", "text": "web_search 参数校验失败：" + 序列化JSON(参数错误) + "（必须提供非空 query；limit 取 1-100 的整数）"]], 真)
    # 反跑 B 锚点：删掉下面这段缺密钥闸门 → 用例 1 立红
    设 密钥 为 取搜索密钥(依赖, 提供商名)
    如果 字符串长度(密钥) == 0:
      返回 造缺密钥结果(提供商名)
    设 基结果 为 空
    尝试:
      设 基结果 为 基定义["execute"](参数)
    捕获 异常 e:
      返回 造工具结果([["type": "text", "text": "web_search 执行失败：" + 转字符串(e) + "（提供商响应无法归一；请检查 执行器 返回的载荷形状）"]], 真)
    如果 基结果["isError"] == 真:
      返回 基结果
    设 归一 为 归一参数(参数)
    设 上限 为 0
    如果 字典包含键(归一, "maxResults"):
      设 上限 为 归一["maxResults"]
    设 结果 为 空
    尝试:
      设 结果 为 解析JSON(基结果["content"][0]["text"])
    捕获 异常 e:
      返回 造工具结果([["type": "text", "text": "web_search 结果无法解析：" + 转字符串(e)]], 真)
    设 裁剪 为 截断源表(结果, 上限)
    设 终值 为 {"query": 归一["query"], "sources": 裁剪["sources"], "truncated": 裁剪["truncated"]}
    设 内容 为 字典获取(结果, "content", 空)
    如果 type(内容) == str:
      如果 字符串长度(内容) > 0:
        终值["content"] 为 内容
    返回 造工具结果([["type": "text", "text": 序列化JSON(终值)]], 假)
  返回 造工具定义(搜索工具标识, "Search the web for up-to-date information. Provide a non-empty query; limit (1-100) caps the number of sources.", 网页搜索参数模式(), 执行)

# =====================================================================
# §2 web_fetch —— 参数 url；准入走 抓取策略，正文超 32KB 走 溢出预览
# =====================================================================

段落 网页抓取参数模式:
  设 模式 为 ["type": "object"]
  设 属性 为 {}
  属性["url"] 为 ["type": "string", "minLength": 1, "description": "要抓取的 http(s) 公网地址"]
  模式["properties"] 为 属性
  模式["required"] 为 ["url"]
  返回 模式

# 抓取准入：URL 卫生（协议/凭据/长度）→ 私网字面量
#   返回 {"ok": 真, "解析", "主机"} 或 {"ok": 假, "理由"}
段落 判定抓取准入(网址):
  设 解析 为 空
  尝试:
    设 解析 为 校验抓取地址(网址, 地址最大长度)
  捕获 异常 e:
    返回 {"ok": 假, "理由": "URL 不可抓取：" + 转字符串(e) + "。只允许 http(s):// 形式的公网地址，file/ftp/相对路径一律拒绝。"}
  设 主机 为 解析["hostname"]
  # 反跑 A 变异锚点：删掉下面这一行（主机是否非公网字面量 判定）→ 用例 3 立红
  如果 主机是否非公网字面量(主机) == 真:
    返回 {"ok": 假, "理由": "拒绝私网/回环/保留地址 " + 主机 + "：web_fetch 只允许公网 http(s)，避免访问内网服务（SSRF）。", "主机": 主机}
  返回 {"ok": 真, "解析": 解析, "主机": 主机}

# 归一抓取器返回值：{状态,内容类型,体} 或 [状态,内容类型,体]
段落 读取抓取响应(响应):
  如果 type(响应) == dict:
    设 状态 为 字典获取(响应, "状态", 200)
    设 内容类型 为 字典获取(响应, "内容类型", "")
    设 体 为 字典获取(响应, "体", "")
  否则 如果 type(响应) == list:
    设 状态 为 0
    设 内容类型 为 ""
    设 体 为 ""
    如果 列表长度(响应) > 0:
      设 状态 为 响应[0]
    如果 列表长度(响应) > 1:
      设 内容类型 为 响应[1]
    如果 列表长度(响应) > 2:
      设 体 为 响应[2]
  否则:
    抛出 新建 错误("抓取器返回值形状不可识别：期望 {状态, 内容类型, 体} 或 [状态, 内容类型, 体]")
  如果 type(内容类型) != str:
    设 内容类型 为 ""
  如果 type(体) != str:
    设 体 为 转字符串(体)
  返回 {"状态": 状态, "内容类型": 内容类型, "体": 体}

# 头尾预览（沿用 溢出 的字节切分与省略文案；不改 溢出 本体）
#   说明：溢出.构造预览 的 `(预算 + 1) // 2` 在本语言里按 `预算 + (1 // 2)` 求值，
#   头预算被算成整个 cap（基线 tests/unit/test_溢出.py::test_构造预览_部分预算头尾拼接 现红），
#   因此这里直接调 取前N字节 / 取后N字节 组对称预算，省略计数自行按字节相减。
段落 造头尾预览(体, 上限字节):
  设 头预算 为 上限字节 // 2
  设 尾预算 为 上限字节 - 头预算
  设 前缀 为 取前N字节(体, 头预算)
  设 后缀 为 取后N字节(体, 尾预算)
  设 省略计数 为 字节长度(体) - 字节长度(前缀) - 字节长度(后缀)
  设 省略 为 {"种类": "精确", "计数": 省略计数}
  设 提示 为 "(" + 描述省略(省略, "bytes") + " web_fetch 只返回头尾预览；完整正文请在原地址按需分段获取。)"
  返回 {"文本": 前缀 + 后缀, "提示": 提示}

# 造 web_fetch 工具定义
段落 造网页抓取工具定义(依赖):
  设 抓取器 为 字典获取(依赖, "抓取器", 空)
  设 上限字节 为 字典获取(依赖, "上限字节", 默认抓取上限字节)
  段落 执行(参数):
    设 参数错误 为 校验参数(网页抓取参数模式(), 参数)
    如果 列表长度(参数错误) > 0:
      返回 造工具结果([["type": "text", "text": "web_fetch 参数校验失败：" + 序列化JSON(参数错误) + "（必须提供非空 url）"]], 真)
    设 网址 为 参数["url"]
    设 准入 为 判定抓取准入(网址)
    如果 准入["ok"] == 假:
      返回 造工具结果([["type": "text", "text": "web_fetch 拒绝抓取 " + 网址 + "：" + 准入["理由"]]], 真)
    如果 抓取器 == 空:
      返回 造工具结果([["type": "text", "text": "web_fetch 不可用：未注入 抓取器。请在依赖里传入 抓取器（真实层=真实抓取提供，测试=假响应桩）。"]], 真)
    设 响应 为 空
    尝试:
      设 响应 为 抓取器(网址)
    捕获 异常 e:
      返回 造工具结果([["type": "text", "text": "web_fetch 抓取失败 " + 网址 + "：" + 转字符串(e) + "（可换目标或稍后重试；私网目标一律拒绝）"]], 真)
    设 读数 为 读取抓取响应(响应)
    设 体 为 读数["体"]
    设 总字节 为 字节长度(体)
    设 已截断 为 假
    设 正文 为 体
    如果 总字节 > 上限字节:
      # 超 32KB：头尾预览 + 省略说明（走 溢出 的字节切分与省略文案），不吐全文
      设 预览 为 造头尾预览(体, 上限字节)
      设 正文 为 预览["文本"] + "\n\n" + 预览["提示"]
      设 已截断 为 真
    设 摘要 为 {"url": 网址, "status": 读数["状态"], "kind": 分类内容类型(读数["内容类型"]), "contentType": 读数["内容类型"], "bytes": 总字节, "truncated": 已截断, "text": 正文}
    返回 造工具结果([["type": "text", "text": 序列化JSON(摘要)]], 假)
  返回 造工具定义(抓取工具标识, "Fetch a public http(s) URL and return its text. Private/loopback/literal-reserved addresses and non-http(s) schemes are rejected. Bodies over 32KB return a truncated head/tail preview.", 网页抓取参数模式(), 执行)

# =====================================================================
# §3 网页工具状态 —— {搜索:{可用,原因}, 抓取:{可用,原因}}
# =====================================================================

段落 网页工具状态(依赖 = 空):
  如果 type(依赖) != dict:
    设 依赖 为 {}
  设 提供商名 为 字典获取(依赖, "提供商", 默认网页提供商)
  设 密钥 为 取搜索密钥(依赖, 提供商名)
  设 搜索可用 为 字符串长度(密钥) > 0
  设 搜索原因 为 ""
  如果 搜索可用 == 假:
    设 搜索原因 为 "缺少环境变量 " + 密钥环境变量(提供商名) + "：未配置搜索密钥，web_search 会直接报错且不发请求"
  设 抓取器 为 字典获取(依赖, "抓取器", 空)
  设 抓取可用 为 抓取器 != 空
  设 抓取原因 为 ""
  如果 抓取可用 == 假:
    设 抓取原因 为 "未注入 抓取器：web_fetch 无法外呼（真实层应注入 真实抓取提供）"
  返回 {"搜索": {"可用": 搜索可用, "原因": 搜索原因}, "抓取": {"可用": 抓取可用, "原因": 抓取原因}}
