# 工具执行.light —— 第34轮 任务2：工具执行流水线完善
#
# 上游（只读）：G:\github\deepseek-harness\packages\tools\src\
#   registry.ts（ToolRegistry）  → §1 工具注册与权限级别
#   permission.ts（Permission）  → §2 可见性 + 调用权限检查
#   cancel.ts（CancellationToken）→ §3 取消令牌
#   audit.ts（AuditLog）         → §4 追加-only 审计日志
#   ratelimit.ts（RateLimiter）  → §5 令牌桶 / 滑动窗口限流
#   executor.ts（ToolExecutor）  → §6 执行流水线（先权限、后限流、再取消）
#
# 纯逻辑复刻：剔除真实 I/O 分派、持久化写盘（改内存环形缓冲 + 导出接口）、
#             墙钟时间（改「逻辑时钟」，由调用方推进，保证可重放）。
# 命名避坑：L-119 单字别名保留字（长/首/末/空/步/当 等勿作变量名）；
#           L-120 可被关键字序列完全切分的标识符。
# 本模块段落一律以「具」为前缀，避免与同测导入的其它模块同名段冲突
#（src 后端会把依赖模块内联进同一份 Python，同名段会 codegen 重定义）。
# 铁律：权限检查必须在执行前完成，不得绕过；审计日志追加-only。

# T-0510：命令语义高危识别取自 工具_路径安全（识别规则单一出口），
#          确认收敛复用本文件 §7 预决确认决策面（不另起门控）。
从 工具_路径安全 导入 识别命令风险, 取调用根

# T-0504：参数校验失败统一收敛为结构化 ValidationError 信封（定义见 src/错误增强.light §13）。
#   本模块**不 import 校验器/错误增强**：那会把 工具 + 附件准入/终端 整条依赖链拖进
#   每个 工具_bash 使用方，编译开销直接击穿既有超时用例的 12s 预算（T-0442 实测 21s）。
#   改为依赖注入：建执行器(..., 校验器=…) 传入「(模式,参数) → {通过,载荷}」的入口；
#   未注入即不做校验（既有调用点零改动、零额外依赖）。

# =====================================================================
# §0 常量
# =====================================================================

设 级公开 为 "public"
设 级内部 为 "internal"
设 级私有 为 "private"
# R73-E · L-157：中文直觉别名（与上面三个常量同值异名）。
# wire 字面值保持英文不变（既有 examples 直接断言 "public"），只加别名
# 常量 + 判型归一化，消除「文档写「公开」匹配不上 "public"」的踩坑面。
设 公开 为 级公开
设 内部 为 级内部
设 私有 为 级私有
设 级别中文表 为 {"公开": 级公开, "内部": 级内部, "私有": 级私有}
设 级别表 为 [级公开, 级内部, 级私有]

设 调正常 为 "ok"
设 调拒绝 为 "permission_denied"
设 调限流 为 "rate_limited"
设 调取消 为 "cancelled"
设 调失败 为 "failed"

# L-164：以上**执行状态字面值请勿硬编码**。
#   成功态字面值是 "ok"，不是直觉的 "normal"——既有 examples/test_R40_端到端互举.light
#   直接断言 "ok"，为保持 wire 兼容不改值。调用方统一取 调正常 常量即可消除歧义；
#   另导出直觉别名 调成功（与 调正常 同值），给偏好 "成功" 命名的调用方使用。
设 调成功 为 调正常
设 状态字面值表 为 [调正常, 调拒绝, 调限流, 调取消, 调失败]

设 审计开始 为 "tool_call_start"
设 审计结束 为 "tool_call_end"
设 审计失败 为 "tool_call_failed"
设 审计拒绝 为 "permission_denied"
设 审计限流 为 "rate_limited"
设 审计事件表 为 [审计开始, 审计结束, 审计失败, 审计拒绝, 审计限流]

设 策略令牌桶 为 "令牌桶"
设 策略滑动窗 为 "滑动窗口"
设 限流策略表 为 [策略令牌桶, 策略滑动窗]

设 默认容量 为 128

# W6-A/T-0515：traceId 是**轻量关联键**，不是 tracing 框架。
# 只借用 uuid4 生成器（纯 id 铸造，无 span/采样/导出），不引入任何观测依赖。
从 uuid工具 导入 生成UUID4
从 工具面装配 导入 是同族工具
# W2/T2.2 T-0502：语义名与别名的唯一数据源在 工具面装配 §3.9（T-0501 映射表），
#   本模块只做注册期改名与执行期解析，不再另存第二份表。
从 工具面装配 导入 规范工具名, 是保留别名
# T-0509：可逆性分级 → 执行前确认门控（策略层在 工具面装配 §11.4）
从 工具面装配 导入 造门控配置, 工具门控判定, 可逆性条目键
从 工具面装配 导入 门控放行, 门控提示, 门控校验, 门控确认, 级不可逆
# T-0509：前置校验复用 工具_路径安全 的解析与命令目标校验，不另造路径校验
从 工具_路径安全 导入 校验破坏性命令目标, 规范路径比较, 解析安全路径
# T-0512：会话级预算信号（用量底座在 上下文，信号计算在 工具面装配 §12b）
从 上下文 导入 取本轮令牌, 取累计令牌, 取窗口
从 工具面装配 导入 计算预算信号, 建预算信号配置

设 追踪前缀 为 "tr_"
# W3/T-0505：运行时异常信封的 type 大类字面值（与 错误增强 §14 的 错误大类运行 同值）
设 异常大类运行 为 "runtime"
设 异常超时 为 "timeout"
设 异常未找到 为 "notFound"
设 异常权限 为 "permission"
设 异常取消 为 "cancelled"
设 异常内部 为 "internal"

# =====================================================================
# §1 工具注册（registry.ts）
# =====================================================================

段落 建注册表:
  返回 {"工具表": {}, "插件表": {},
    "别名表": {}, "别名命中": {}}

# R73-E · L-157：级别归一化——中文直觉别名 → 英文 wire 字面值；
# 非别名输入原样返回（英文三级别、以及任何非法值都不在这里报错，
# 报错口径仍由 具是级别/权限判定 负责）。
段落 具规整级别(值):
  如果 字典包含键(级别中文表, 值) == 真:
    返回 级别中文表[值]
  返回 值

段落 具是级别(值):
  # R73-E · L-157：中文直觉别名（公开/内部/私有）归一化为英文 wire 字面值。
  # 未命中别名表则维持原值（原三个英文级别照常通过 级别表.包含 判定）。
  设 值 为 具规整级别(值)
  返回 级别表.包含(值)

# T-0504 / T-0496 合并：第 6 参兼容两种调用——
#   传字典 = 参数模式（T-0504 口径）；传字符串 = 能力域（T-0496 口径）；
#   第 7 参 域 显式指定（优先）。既有 5 参调用点零改动。
段落 具注册工具(注册, 名称, 级别, 处理 = 空, 插件 = 空, 第6参 = 空, 域 = "其他"):
  如果 是字符串(名称) == 假 或 字符串长度(名称) == 0:
    抛出 新建 错误("工具名必须为非空串 [INVALID_TOOL_NAME]")
  # W2/T2.2 T-0502：语义名落地。基线工具（T-0501 映射表里的 160 条）登记成
  #   <域>.<动作>；表外的名字（测试名 / 插件自报名 / mcp__*）原样登记，不改名。
  设 规范名 为 规范工具名(名称)
  如果 具是级别(级别) == 假:
    抛出 新建 错误("未知权限级别：" + 转字符串(级别) + " [UNKNOWN_LEVEL]")
  如果 字典包含键(注册["工具表"], 规范名) == 真:
    抛出 新建 错误("工具重名：" + 规范名 + " [DUPLICATE_TOOL]")
  # T-0504：参数模式可选登记；T-0496：域纯元数据。两者同存，互不影响。
  设 实际模式 为 第6参
  设 实际域 为 域
  如果 是字典(第6参) == 真:
    设 实际域 为 域
  否则:
    如果 是字符串(第6参) == 真 且 字符串长度(第6参) > 0:
      设 实际域 为 第6参
      设 实际模式 为 空
  设 工具 为 {"名称": 规范名, "原名": 名称, "语义名": 规范名,
    "级别": 级别, "插件": 插件, "处理": 处理, "参数模式": 实际模式, "域": 实际域}
  字典设置(注册["工具表"], 规范名, 工具)
  # 旧名别名：只有「保留别名」的 27 条挂上去；「直接改名」的旧名不进别名表
  #   （T-0501 §5.2），调用即未找到，避免 133 个旧名重新回到模型面。
  如果 名称 != 规范名 且 是保留别名(名称) == 真:
    如果 字典包含键(注册, "别名表") == 假:
      字典设置(注册, "别名表", {})
    字典设置(注册["别名表"], 名称, 规范名)
  # 插件级可见：同名插件只记一次，后续工具继承该插件级别
  如果 插件 != 空:
    如果 字典包含键(注册["插件表"], 插件) == 假:
      字典设置(注册["插件表"], 插件, 级别)
  返回 工具

# 权限继承：插件提供的工具继承插件权限级别
段落 注册插件工具(注册, 插件, 级别, 名称表, 处理 = 空):
  如果 具是级别(级别) == 假:
    抛出 新建 错误("未知插件权限级别：" + 转字符串(级别) + " [UNKNOWN_LEVEL]")
  如果 字典包含键(注册["插件表"], 插件) == 假:
    字典设置(注册["插件表"], 插件, 级别)
  设 已注册 为 []
  遍历 名称 之 名称表:
    已注册.追加(具注册工具(注册, 名称, 级别, 处理, 插件))
  返回 已注册

段落 插件级别(注册, 插件):
  返回 字典获取(注册["插件表"], 插件, 空)

段落 具注销工具(注册, 名称):
  设 目标 为 名称
  如果 字典包含键(注册["工具表"], 名称) == 假:
    设 候选 为 具解析别名(注册, 名称)
    如果 字典包含键(注册["工具表"], 候选) == 真:
      设 目标 为 候选
  如果 字典包含键(注册["工具表"], 目标) == 假:
    返回 假
  设 新表 为 {}
  遍历 键 之 字典键列表(注册["工具表"]):
    如果 键 != 目标:
      字典设置(新表, 键, 注册["工具表"][键])
  字典设置(注册, "工具表", 新表)
  # 别名一并清理：不能让旧名继续指向一个已注销的工具
  如果 字典包含键(注册, "别名表") == 真:
    设 新别名 为 {}
    遍历 旧名 之 字典键列表(注册["别名表"]):
      如果 注册["别名表"][旧名] != 目标:
        字典设置(新别名, 旧名, 注册["别名表"][旧名])
    字典设置(注册, "别名表", 新别名)
  返回 真

# W2/T2.2 T-0502：解析顺序 = 语义名直查 → 旧名别名（仅 27 条）→ 未找到。
#   命中别名时打一次点（别名命中表），供观察旧名残留量；不打进审计事件，
#   也不改任何返回键（结果结构由 执行工具 保证逐键不变）。
段落 取工具(注册, 名称):
  设 工具 为 字典获取(注册["工具表"], 名称, 空)
  如果 工具 != 空:
    返回 工具
  设 规范名 为 具解析别名(注册, 名称)
  如果 规范名 == 名称:
    返回 空
  设 命中 为 字典获取(注册["工具表"], 规范名, 空)
  如果 命中 != 空:
    具记别名命中(注册, 名称)
  返回 命中

# 具解析别名(注册, 名) -> 执行管线实际查找的键：
#   只认本注册表登记过的别名（旧名 → 语义名，仅 27 条保留别名）；
#   「直接改名」的旧名没有登记，原样返回 → 调用方判 TOOL_NOT_FOUND。
段落 具解析别名(注册, 名):
  如果 字典包含键(注册, "别名表") == 假:
    返回 名
  设 规范名 为 字典获取(注册["别名表"], 名, "")
  如果 规范名 == "":
    返回 名
  返回 规范名

# 别名命中打点（沿用 T-0388「别名归一」口径：只计数，不改结果）
段落 具记别名命中(注册, 旧名):
  如果 字典包含键(注册, "别名命中") == 假:
    字典设置(注册, "别名命中", {})
  设 次数 为 字典获取(注册["别名命中"], 旧名, 0)
  字典设置(注册["别名命中"], 旧名, 次数 + 1)

# 别名命中表(注册) -> {旧名: 次数}（副本；审计/观测用）
段落 具别名命中表(注册):
  设 结果 为 {}
  如果 字典包含键(注册, "别名命中") == 真:
    遍历 旧名 之 字典键列表(注册["别名命中"]):
      字典设置(结果, 旧名, 注册["别名命中"][旧名])
  返回 结果

# 别名统计(注册) -> {"别名命中": 总数, "工具数": n, "别名数": m}
段落 具别名统计(注册):
  设 总计 为 0
  如果 字典包含键(注册, "别名命中") == 真:
    遍历 旧名 之 字典键列表(注册["别名命中"]):
      设 总计 为 总计 + 注册["别名命中"][旧名]
  设 别名数 为 0
  如果 字典包含键(注册, "别名表") == 真:
    设 别名数 为 长(注册["别名表"])
  返回 {"别名命中": 总计, "工具数": 长(工具名表(注册)), "别名数": 别名数}

段落 工具名表(注册):
  返回 字典键列表(注册["工具表"])

# T-0496：按能力域查询/枚举（纯元数据查询，不影响调用行为）。
# 未知域 / 空注册表返回空表；工具缺 "域" 键时按 "其他" 兜底。
段落 按域列工具(注册, 域):
  设 结果 为 []
  遍历 名 之 工具名表(注册):
    设 工具 为 注册["工具表"][名]
    设 工具域 为 字典获取(工具, "域", "其他")
    如果 工具域 == 域:
      列表追加(结果, 名)
  返回 结果

# T-0496：取单个工具的域元数据；未注册返回空（与 取工具 口径一致）。
段落 工具之域(注册, 名称):
  设 工具 为 取工具(注册, 名称)
  如果 工具 == 空:
    返回 空
  返回 字典获取(工具, "域", "其他")

段落 列出工具(注册, 调用者级别 = 空):
  设 结果 为 []
  遍历 名称 之 工具名表(注册):
    设 工具 为 注册["工具表"][名称]
    如果 调用者级别 == 空:
      结果.追加(名称)
    否则:
      如果 具可否见(工具["级别"], 调用者级别) == 真:
        结果.追加(名称)
  返回 结果

# =====================================================================
# §2 权限控制（permission.ts）
# =====================================================================

# 可见性矩阵：工具级别 → 允许看见它的调用者级别
段落 具可见级别(工具级别):
  如果 工具级别 == 级公开:
    返回 [级公开, 级内部, 级私有]
  如果 工具级别 == 级内部:
    返回 [级内部, 级私有]
  返回 [级私有]

段落 具可否见(工具级别, 调用者级别):
  # R73-E · L-157：两侧都先归一化——工具级别与调用者级别均可用中文直觉别名
  # （公开/内部/私有），比对在英文 wire 字面值上进行。
  设 工具级别 为 具规整级别(工具级别)
  设 调用者级别 为 具规整级别(调用者级别)
  如果 具是级别(工具级别) == 假:
    返回 假
  如果 具是级别(调用者级别) == 假:
    返回 假
  返回 具可见级别(工具级别).包含(调用者级别)

# 同插件豁免：private 工具对「同插件调用者」可见
段落 具同插件(工具, 调用者插件):
  如果 调用者插件 == 空:
    返回 假
  如果 工具["插件"] == 空:
    返回 假
  返回 工具["插件"] == 调用者插件

段落 权限判定(工具, 调用者级别, 调用者插件 = 空):
  如果 工具 == 空:
    返回 {"可见": 假, "可调用": 假, "错误码": "TOOL_NOT_FOUND",
      "消息": "工具不存在"}
  如果 具可否见(工具["级别"], 调用者级别) == 真:
    返回 {"可见": 真, "可调用": 真, "错误码": 空, "消息": 空}
  如果 工具["级别"] == 级私有 且 具同插件(工具, 调用者插件) == 真:
    返回 {"可见": 真, "可调用": 真, "错误码": 空, "消息": 空}
  返回 {"可见": 假, "可调用": 假, "错误码": "PERMISSION_DENIED",
    "消息": "工具 " + 工具["名称"] + " 对级别 " + 调用者级别 + " 不可见"}

# =====================================================================
# §3 取消令牌（cancel.ts）
# =====================================================================

段落 建取消令牌(信号 = 空):
  返回 {"已取消": 假, "原因": 空, "信号": 信号, "回调表": []}

段落 是否取消(令牌):
  如果 令牌 == 空:
    返回 假
  如果 令牌["已取消"] == 真:
    返回 真
  如果 令牌["信号"] != 空:
    返回 令牌["信号"]["中止"] == 真
  返回 假

段落 请求取消(令牌, 原因 = "user_abort"):
  如果 是否取消(令牌) == 真:
    返回 假
  字典设置(令牌, "已取消", 真)
  字典设置(令牌, "原因", 原因)
  返回 真

段落 检查取消(令牌):
  如果 是否取消(令牌) == 真:
    抛出 新建 错误("工具执行已取消：" + 转字符串(令牌["原因"]) +
      " [TOOL_CANCELLED]")
  返回 真

# 取消回调：资源清理钩子（注册即追加，不可删，保证清理不被绕过）
段落 注册清理(令牌, 处理):
  令牌["回调表"].追加(处理)
  返回 长(令牌["回调表"])

段落 执行清理(令牌):
  设 计数 为 0
  遍历 处理 之 令牌["回调表"]:
    设 钩子 为 处理
    钩子(令牌)
    设 计数 为 计数 + 1
  返回 计数

# =====================================================================
# §4 审计日志（audit.ts）—— 追加-only
# =====================================================================

段落 建审计日志(容量 = 128):
  如果 容量 <= 0:
    抛出 新建 错误("审计容量必须为正 [INVALID_AUDIT_CAPACITY]")
  返回 {"事件表": [], "容量": 容量, "序号": 0}

段落 具记审计(日志, 类型, 工具名, 调用者, 状态, 时刻 = 0, 参数摘要 = "", 耗时 = 0, traceId = ""):
  如果 审计事件表.包含(类型) == 假:
    抛出 新建 错误("未知审计事件类型：" + 转字符串(类型) +
      " [UNKNOWN_AUDIT_EVENT]")
  设 序号 为 日志["序号"] + 1
  设 记录 为 {"序号": 序号, "类型": 类型, "工具名": 工具名, "调用者": 调用者,
    "参数摘要": 参数摘要, "状态": 状态, "时刻": 时刻, "耗时": 耗时}
  # traceId 是新增元数据：仅在调用方提供时才挂，既有审计记录逐键不变
  如果 traceId != "":
    字典设置(记录, "traceId", traceId)
  日志["事件表"].追加(记录)
  # 环形缓冲：超容量丢弃最旧（只丢弃、不改写已有条目）
  当 长(日志["事件表"]) > 日志["容量"]:
    字典设置(日志, "事件表", 具截尾(日志["事件表"], 1))
  字典设置(日志, "序号", 序号)
  返回 记录

# 去掉列表前 n 项（环形缓冲丢弃最旧用）
段落 具截尾(表, 数量):
  设 结果 为 []
  设 位置 为 0
  遍历 项 之 表:
    如果 位置 >= 数量:
      结果.追加(项)
    设 位置 为 位置 + 1
  返回 结果

段落 审计查询(日志, 工具名 = 空, 调用者 = 空, 状态 = 空, 起始时刻 = 空):
  设 结果 为 []
  遍历 记录 之 日志["事件表"]:
    如果 工具名 == 空 或 记录["工具名"] == 工具名:
      如果 调用者 == 空 或 记录["调用者"] == 调用者:
        如果 状态 == 空 或 记录["状态"] == 状态:
          如果 起始时刻 == 空 或 记录["时刻"] >= 起始时刻:
            结果.追加(记录)
  返回 结果

# 可持久化接口：导出/导入（导入为整体替换，不提供单条改写）
段落 审计导出(日志):
  返回 {"容量": 日志["容量"], "序号": 日志["序号"], "事件表": 日志["事件表"]}

段落 审计导入(日志, 快照):
  如果 是字典(快照) == 假:
    抛出 新建 错误("审计快照必须为字典 [INVALID_AUDIT_SNAPSHOT]")
  字典设置(日志, "事件表", 字典获取(快照, "事件表", []))
  字典设置(日志, "序号", 字典获取(快照, "序号", 0))
  字典设置(日志, "容量", 字典获取(快照, "容量", 默认容量))
  返回 真

段落 审计条数(日志):
  返回 长(日志["事件表"])

# =====================================================================
# §5 速率限制（ratelimit.ts）
# =====================================================================

段落 建限流态(最大请求, 窗口, 突发, 策略):
  如果 最大请求 <= 0:
    抛出 新建 错误("maxRequests 必须为正 [INVALID_RATE_CONFIG]")
  如果 窗口 <= 0:
    抛出 新建 错误("windowMs 必须为正 [INVALID_RATE_CONFIG]")
  如果 突发 < 0:
    抛出 新建 错误("burstSize 不得为负 [INVALID_RATE_CONFIG]")
  如果 限流策略表.包含(策略) == 假:
    抛出 新建 错误("未知限流策略：" + 转字符串(策略) + " [UNKNOWN_RATE_STRATEGY]")
  设 上限 为 突发
  如果 突发 == 0:
    设 上限 为 最大请求
  返回 {"最大请求": 最大请求, "窗口": 窗口, "突发": 突发, "上限": 上限,
    "令牌": 上限, "上次时刻": 0, "命中表": [], "策略": 策略}

段落 建限速器(最大请求 = 10, 窗口 = 1000, 突发 = 0, 策略 = 策略滑动窗):
  返回 {"最大请求": 最大请求, "窗口": 窗口, "突发": 突发, "策略": 策略,
    "全局": 建限流态(最大请求, 窗口, 突发, 策略), "工具表": {}, "调用者表": {}}

段落 具取维度(限速器, 表名, 键):
  如果 字典包含键(限速器[表名], 键) == 假:
    字典设置(限速器[表名], 键, 建限流态(限速器["最大请求"], 限速器["窗口"],
      限速器["突发"], 限速器["策略"]))
  返回 限速器[表名][键]

# 令牌桶：按时间比例补充令牌，上限为桶容量
段落 令牌桶取(态, 时刻, 数量):
  设 间隔 为 时刻 - 态["上次时刻"]
  如果 间隔 > 0:
    设 补充 为 间隔 * 态["最大请求"] / 态["窗口"]
    设 余量 为 态["令牌"] + 补充
    如果 余量 > 态["上限"]:
      设 余量 为 态["上限"]
    字典设置(态, "令牌", 余量)
    字典设置(态, "上次时刻", 时刻)
  如果 态["令牌"] >= 数量:
    字典设置(态, "令牌", 态["令牌"] - 数量)
    返回 {"放行": 真, "剩余": 态["令牌"], "重试毫秒": 0}
  设 缺口 为 数量 - 态["令牌"]
  设 需补 为 缺口 * 态["窗口"] / 态["最大请求"]
  返回 {"放行": 假, "剩余": 态["令牌"], "重试毫秒": 需补 + 1}

# 滑动窗口：只保留窗口内的命中时刻
段落 滑动窗取(态, 时刻, 数量):
  设 保留 为 []
  遍历 旧时刻 之 态["命中表"]:
    如果 时刻 - 旧时刻 < 态["窗口"]:
      保留.追加(旧时刻)
  字典设置(态, "命中表", 保留)
  如果 长(保留) + 数量 <= 态["最大请求"]:
    设 位置 为 0
    当 位置 < 数量:
      态["命中表"].追加(时刻)
      设 位置 为 位置 + 1
    返回 {"放行": 真, "剩余": 态["最大请求"] - 长(态["命中表"]), "重试毫秒": 0}
  如果 长(保留) == 0:
    返回 {"放行": 假, "剩余": 0, "重试毫秒": 态["窗口"] + 1}
  设 最早 为 保留[0]
  返回 {"放行": 假, "剩余": 0, "重试毫秒": 态["窗口"] - (时刻 - 最早) + 1}

段落 具取一次(态, 时刻, 数量):
  如果 态["策略"] == 策略令牌桶:
    返回 令牌桶取(态, 时刻, 数量)
  返回 滑动窗取(态, 时刻, 数量)

# 三维度限流：全局 / 每工具 / 每调用者，任一维度超限即拒绝
段落 限流检查(限速器, 时刻, 工具名 = 空, 调用者 = 空, 数量 = 1):
  设 全局结果 为 具取一次(限速器["全局"], 时刻, 数量)
  如果 全局结果["放行"] == 假:
    返回 {"放行": 假, "维度": "全局", "错误码": "RATE_LIMITED",
      "重试毫秒": 全局结果["重试毫秒"]}
  如果 工具名 != 空:
    设 工具态 为 具取维度(限速器, "工具表", 工具名)
    设 工具结果 为 具取一次(工具态, 时刻, 数量)
    如果 工具结果["放行"] == 假:
      返回 {"放行": 假, "维度": "工具", "错误码": "RATE_LIMITED",
        "重试毫秒": 工具结果["重试毫秒"]}
  如果 调用者 != 空:
    设 调用者态 为 具取维度(限速器, "调用者表", 调用者)
    设 调用者结果 为 具取一次(调用者态, 时刻, 数量)
    如果 调用者结果["放行"] == 假:
      返回 {"放行": 假, "维度": "调用者", "错误码": "RATE_LIMITED",
        "重试毫秒": 调用者结果["重试毫秒"]}
  返回 {"放行": 真, "维度": 空, "错误码": 空, "重试毫秒": 0}

# =====================================================================
# §6 执行流水线（executor.ts）
# =====================================================================

# R73-E · L-158：建执行器 支持传入既有注册表。
# 此前 建执行器() 每次都新建独立注册表，外部（装配层/测试）注册的工具不会
# 自动进入执行器 → 执行时 TOOL_NOT_FOUND，调用方只能用「镜像工具」手法绕开
# （src/互举接线.light 执行工具全链路 的镜像循环）。现增可选第 5 参数
# 既有注册表：传入则直接引用（共享同一注册，外部后续注册的工具也可见）；
# 缺省为空则保持原行为（新建空注册表）。既有调用点零改动。
# 注意：传的是引用不是拷贝——执行器与外部注册表双向同步，这正是 L-158
# 建议的「消除镜像步骤」语义；需要隔离快照的调用方先自行拷贝注册表。
段落 建执行器(最大请求 = 10, 窗口 = 1000, 突发 = 0, 策略 = 策略滑动窗, 既有注册表 = 空, 校验器 = 空, traceId工厂 = 空, 门控 = 空, 预校验 = 假, 熔断 = 空):
  设 注册 为 既有注册表
  如果 是空(注册):
    设 注册 为 建注册表()
  # T-0509：门控配置可选注入（第 8 参）。缺省 = 规范默认策略（不可逆 → 确认），
  #   需要放宽的调用方传 造门控配置({...})；非法/非字典一律回落默认，不抛错。
  设 门控配置 为 门控
  如果 是字典(门控配置) == 假:
    设 门控配置 为 造门控配置()
  # T-0507：熔断器可显式注入（第 10 参）；缺省按默认门限 3 新建，
  #   调用方零改动；非法/非字典一律回落默认，不抛错。
  设 实熔断器 为 熔断
  如果 是字典(实熔断器) == 假:
    设 实熔断器 为 建熔断器()
  # T-0510 高危命令确认门控（复用 §7 预决确认出口）：
  #   "审批通道"/"审批结果" 为可选注入键——默认无通道：高危命令 ask → deny
  #   （默认保守，不确定时偏向确认而非放行）；调用方 显式注入 审批结果=批准放行
  #   且 审批通道=真 时按 §7 审批链收敛为 allow。合法命令 allow 直通，零行为变化。
  返回 {"注册": 注册, "审计": 建审计日志(默认容量),
    "限速": 建限速器(最大请求, 窗口, 突发, 策略), "令牌": 建取消令牌(),
    "时刻": 0, "审批通道": 假, "审批结果": 空,
    "校验器": 校验器, "trace表": {}, "最后traceId": "", "traceId工厂": traceId工厂,
    # T-0509：门控配置 + 已读清单（覆盖前先读的判据）+ 门控日志（降档/提示留痕）
    "门控": 门控配置, "已读表": {}, "门控日志": [],
    # T-0507：轻量预校验开关（默认关）+ 熔断器（默认门限 3，仅登记不改变执行结果）
    "预校验": 预校验 == 真, "熔断器": 实熔断器}

段落 推时钟(执行器, 毫秒):
  如果 毫秒 < 0:
    抛出 新建 错误("时钟不可倒退 [INVALID_CLOCK_STEP]")
  字典设置(执行器, "时刻", 执行器["时刻"] + 毫秒)
  返回 执行器["时刻"]

段落 具摘要(参数, 上限 = 64):
  设 串 为 序列化JSON(参数)
  如果 字符串长度(串) <= 上限:
    返回 串
  返回 截取(串, 0, 上限)

# T-0504：登记/替换工具参数模式（注册时已可传，这里供后置接线）
段落 具登记参数模式(注册, 名称, 参数模式):
  设 工具 为 取工具(注册, 名称)
  如果 工具 == 空:
    抛出 新建 错误("工具不存在，无法登记参数模式：" + 名称 + " [TOOL_NOT_FOUND]")
  字典设置(工具, "参数模式", 参数模式)
  返回 工具

# T-0504：参数校验闸门（返回 {"有模式","通过","跳过","错误表","载荷"}）
#   无 参数模式 → 放行（不做无依据的校验）；有模式但未注入校验器 → 跳过并留痕（跳过=真）；
#   校验器返回 {"通过": 真} 或 {"通过": 假, "载荷": 失败载荷}，本模块不构造信封。
# T-0507：第 4 参 预校验=真 时先跑 §9 的轻量预校验（只看顶层明显错误），
#   命中即拦、不再调全量校验器；未命中照旧走全量校验器（不重复报错、不改变口径）。
#   默认 假 → 既有调用点逐键逐语义不变。
段落 具校验工具参数(工具, 参数, 校验器 = 空, 预校验 = 假):
  设 无模式 为 {"有模式": 假, "通过": 真, "跳过": 假, "错误表": [], "载荷": 空}
  如果 是字典(工具) == 假:
    返回 无模式
  设 模式 为 字典获取(工具, "参数模式", 空)
  如果 模式 == 空:
    返回 无模式
  如果 预校验 == 真:
    设 预 为 具轻量预校验(工具, 参数)
    如果 预["拦下"] == 真:
      返回 {"有模式": 真, "通过": 假, "跳过": 假, "错误表": 预["错误表"],
        "载荷": 预["载荷"], "预校验": 真}
  如果 校验器 == 空:
    返回 {"有模式": 真, "通过": 真, "跳过": 真, "错误表": [], "载荷": 空}
  设 实际参数 为 参数
  如果 实际参数 == 空:
    设 实际参数 为 {}
  设 结论 为 校验器(模式, 实际参数)
  如果 是字典(结论) == 假:
    返回 {"有模式": 真, "通过": 真, "跳过": 真, "错误表": [], "载荷": 空}
  如果 字典获取(结论, "通过", 真) == 真:
    返回 {"有模式": 真, "通过": 真, "跳过": 假, "错误表": [], "载荷": 空}
  设 载荷 为 字典获取(结论, "载荷", 空)
  设 错误表 为 []
  如果 是字典(载荷) == 真:
    设 错误表 为 字典获取(载荷, "validationErrors", [])
  返回 {"有模式": 真, "通过": 假, "跳过": 假, "错误表": 错误表, "载荷": 载荷}

# 执行顺序（铁律）：权限 → 参数校验 → 限流 → 取消 → 执行 → 审计
#   参数校验前移到限流之前：参数错不该消耗限流额度，也不该排到取消之后才报。
# T-0515：父traceId 可选，串起重试/子操作；每次执行生成自己的 traceId。
段落 执行工具(执行器, 工具名, 调用者级别, 调用者 = "匿名", 参数 = 空, 调用者插件 = 空, 父traceId = 空):
  设 时刻 为 执行器["时刻"]
  # traceId 每次执行必生成（含前置闸门拒绝路径），失败/重试才挂到结果元数据上。
  设 本traceId 为 取新traceId(执行器)
  设 父链 为 取父traceId(参数, 父traceId)
  设 工具 为 取工具(执行器["注册"], 工具名)
  设 判定 为 权限判定(工具, 调用者级别, 调用者插件)
  如果 判定["可调用"] == 假:
    设 建议文本 为 造trace建议(本traceId, "权限拒绝不建议原地重试")
    设 trace记录 为 记trace(执行器, 工具名, 调拒绝, 本traceId, 父链,
      判定["消息"], 建议文本)
    具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调拒绝, "结果": 空, "错误码": 判定["错误码"],
      "消息": 判定["消息"]}
    返回 附trace元数据(结果, trace记录, 建议文本)
  # T-0504 参数校验闸门（权限之后、限流之前）：校验失败也挂 traceId 供关联。
  设 校验 为 具校验工具参数(工具, 参数, 字典获取(执行器, "校验器", 空), 字典获取(执行器, "预校验", 假))
  如果 校验["通过"] == 假:
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 调失败, 时刻,
      具摘要(参数), 0, 本traceId)
    设 校验载荷 为 校验["载荷"]
    设 校验消息 为 字典获取(校验载荷, "message", "参数校验失败")
    设 校验建议 为 造trace建议(本traceId, "参数校验失败，请按字段改正后重试")
    设 校验trace 为 记trace(执行器, 工具名, 调失败, 本traceId, 父链,
      校验消息, 校验建议)
    设 校验失败 为 {"状态": 调失败, "结果": 空,
      "错误码": "PARAM_SCHEMA_INVALID", "消息": 校验消息,
      "错误": 字典获取(校验载荷, "error", 空),
      "校验错误": 校验["错误表"]}
    返回 附trace元数据(校验失败, 校验trace, 校验建议)
  设 限流 为 限流检查(执行器["限速"], 时刻, 工具名, 调用者, 1)
  如果 限流["放行"] == 假:
    设 限流消息 为 "触发" + 限流["维度"] + "维度限流，建议 " +
      转字符串(限流["重试毫秒"]) + "ms 后重试"
    设 建议文本 为 造trace建议(本traceId, "限流可等待后重试")
    设 trace记录 为 记trace(执行器, 工具名, 调限流, 本traceId, 父链,
      限流消息, 建议文本)
    具记审计(执行器["审计"], 审计限流, 工具名, 调用者, 调限流, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调限流, "结果": 空, "错误码": 限流["错误码"],
      "消息": 限流消息, "重试毫秒": 限流["重试毫秒"]}
    返回 附trace元数据(结果, trace记录, 建议文本)
  如果 是否取消(执行器["令牌"]) == 真:
    设 建议文本 为 造trace建议(本traceId, "取消不可原地重试")
    设 trace记录 为 记trace(执行器, 工具名, 调取消, 本traceId, 父链,
      "执行前检测到取消", 建议文本)
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 调取消, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调取消, "结果": 空, "错误码": "TOOL_CANCELLED",
      "消息": "执行前检测到取消"}
    返回 附trace元数据(结果, trace记录, 建议文本)
  # T-0510 高危命令确认门控（复用 §7 出口）：ask 按审批链收敛，deny 即拒绝并记审计
  设 高危决 为 具高危命令预决(工具名, 参数)
  设 高危收敛 为 具高危命令收敛(执行器, 高危决)
  如果 高危收敛["过"] == 假:
    设 建议文本 为 造trace建议(本traceId, "高危命令需确认后重试")
    设 trace记录 为 记trace(执行器, 工具名, 调拒绝, 本traceId, 父链,
      高危收敛["消息"], 建议文本)
    具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调拒绝, "结果": 空, "错误码": "CMD_RISK_CONFIRM",
      "消息": 高危收敛["消息"]}
    返回 附trace元数据(结果, trace记录, 建议文本)
  # T-0509 可逆性分级门控：不可逆档走前置校验 + 确认出口；只读/可逆零拦截
  设 分级守卫 为 具分级守卫(执行器, 工具名, 参数, 本traceId, 父链, 调用者)
  如果 分级守卫["过"] == 假:
    返回 分级守卫["结果"]
  具记审计(执行器["审计"], 审计开始, 工具名, 调用者, "start", 时刻,
    具摘要(参数), 0, 本traceId)
  设 结果 为 空
  尝试:
    如果 工具["处理"] == 空:
      抛出 新建 错误("工具无处理函数 [NO_HANDLER]")
    设 处理 为 工具["处理"]
    # 取消令牌注入上下文：工具可自行查询
    设 结果 为 处理(参数, 执行器["令牌"])
    具记已读(执行器, 工具名, 参数)
    检查取消(执行器["令牌"])
    具记审计(执行器["审计"], 审计结束, 工具名, 调用者, 调正常, 时刻, "", 0,
      本traceId)
    # 成功路径**：不挂 traceId**，保持既有返回逐键一致
    设 trace记录 为 记trace(执行器, 工具名, 调正常, 本traceId, 父链)
    返回 附trace元数据({"状态": 调正常, "结果": 结果,
      "错误码": 空, "消息": 空}, trace记录)
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
    设 态 为 调失败
    如果 字符串包含(消息, "TOOL_CANCELLED") == 真:
      设 态 为 调取消
      执行清理(执行器["令牌"])
    设 异常体 为 造运行时异常信封(消息, 本traceId)
    设 建议文本 为 造trace建议(本traceId, 异常体["suggestion"])
    设 trace记录 为 记trace(执行器, 工具名, 态, 本traceId, 父链,
      消息, 建议文本)
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 态, 时刻, "", 0,
      本traceId)
    # 错误码保持既有 wire 口径（= 状态字面值，T-0515 已钉住）；稳定的机器可读码
    # 在 运行时异常.code（TOOL_TIMEOUT / TOOL_NOT_FOUND …），不改既有键语义。
    设 结果 为 {"状态": 态, "结果": 空, "错误码": 态, "消息": 消息}
    返回 附trace元数据(结果, trace记录, 建议文本, 异常体)

# =====================================================================
# §6b R53 深化（LP-D-012 · Day3）：原生并发执行面
#
#   动机：上游 packages/tools/src/executor.ts 的工具处理器在 Node 侧天然可 await，
#   多工具调用由宿主并发编排。A 方案（§6 执行工具）是**同步执行器**：处理器
#   只能是同步段落，多工具并发只能靠调用方自己在宿主侧起线程/手写调度，
#   再靠「跑之前排空一遍」这种注入式推进器收敛。
#
#   B 方案补三条原生入口，**一行不改 A**：
#     1) 具登记异步处理：给既有工具显式登记异步处理器（与同步 处理 并存，
#        不做运行期协程类型嗅探 —— 显式分流才可测、可审）。
#     2) 具异步执行：单工具异步执行，返回形状与 A 的 执行工具 逐键相同。
#     3) 具并发执行：多工具，前置闸门（权限→参数校验→限流→取消）**严格串行**，
#        只把「执行体」并发（创建任务 + 并发等待）。
#
#   ⚠️ 为什么前置闸门必须串行（无回归判据）：
#     限流态是**有状态**字典（令牌桶余额 / 滑动窗口命中表），串行判定的
#     时刻序列与 A 完全一致（逻辑时钟不推进），故 B 的放行/拒绝判定与 A
#     逐请求相同；并发只发生在**已放行**的执行体上。执行体之间不共享写。
# =====================================================================

# 登记异步处理器：工具必须先已注册；同步 处理 保留不动
段落 具登记异步处理(注册, 名称, 处理):
  设 工具 为 取工具(注册, 名称)
  如果 工具 == 空:
    抛出 新建 错误("工具不存在，无法登记异步处理：" + 名称 + " [TOOL_NOT_FOUND]")
  字典设置(工具, "异步处理", 处理)
  返回 工具

# 前置闸门（权限 → 参数校验 → 限流 → 取消）：与 执行工具 的前四段逐字同序，
# 抽出来供 具异步执行 / 具并发执行 复用，保证两条路与 A 同判。
# 返回 {"过": 是否放行, "结果": 不放行时的终态结果（已记审计）}
段落 具执行前置闸门(执行器, 工具名, 调用者级别, 调用者, 参数, 调用者插件, 父traceId = 空):
  设 时刻 为 执行器["时刻"]
  # 闸门与 执行工具 同序生成 traceId，保证同步/并发同序列可逐项比对
  设 本traceId 为 取新traceId(执行器)
  设 父链 为 取父traceId(参数, 父traceId)
  设 工具 为 取工具(执行器["注册"], 工具名)
  设 判定 为 权限判定(工具, 调用者级别, 调用者插件)
  如果 判定["可调用"] == 假:
    设 建议文本 为 造trace建议(本traceId, "权限拒绝不建议原地重试")
    设 trace记录 为 记trace(执行器, 工具名, 调拒绝, 本traceId, 父链,
      判定["消息"], 建议文本)
    具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调拒绝, "结果": 空,
      "错误码": 判定["错误码"], "消息": 判定["消息"]}
    返回 {"过": 假, "结果": 附trace元数据(结果, trace记录, 建议文本)}
  # T-0504 参数校验闸门（权限之后、限流之前）：校验失败也挂 traceId 供关联。
  设 校验 为 具校验工具参数(工具, 参数, 字典获取(执行器, "校验器", 空), 字典获取(执行器, "预校验", 假))
  如果 校验["通过"] == 假:
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 调失败, 时刻,
      具摘要(参数), 0, 本traceId)
    设 校验载荷 为 校验["载荷"]
    设 校验消息 为 字典获取(校验载荷, "message", "参数校验失败")
    设 校验建议 为 造trace建议(本traceId, "参数校验失败，请按字段改正后重试")
    设 校验trace 为 记trace(执行器, 工具名, 调失败, 本traceId, 父链,
      校验消息, 校验建议)
    设 校验失败 为 {"状态": 调失败, "结果": 空,
      "错误码": "PARAM_SCHEMA_INVALID", "消息": 校验消息,
      "错误": 字典获取(校验载荷, "error", 空),
      "校验错误": 校验["错误表"]}
    返回 {"过": 假, "结果": 附trace元数据(校验失败, 校验trace, 校验建议)}
  设 限流 为 限流检查(执行器["限速"], 时刻, 工具名, 调用者, 1)
  如果 限流["放行"] == 假:
    设 限流消息 为 "触发" + 限流["维度"] + "维度限流，建议 " +
      转字符串(限流["重试毫秒"]) + "ms 后重试"
    设 建议文本 为 造trace建议(本traceId, "限流可等待后重试")
    设 trace记录 为 记trace(执行器, 工具名, 调限流, 本traceId, 父链,
      限流消息, 建议文本)
    具记审计(执行器["审计"], 审计限流, 工具名, 调用者, 调限流, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调限流, "结果": 空,
      "错误码": 限流["错误码"], "消息": 限流消息,
      "重试毫秒": 限流["重试毫秒"]}
    返回 {"过": 假, "结果": 附trace元数据(结果, trace记录, 建议文本)}
  如果 是否取消(执行器["令牌"]) == 真:
    设 建议文本 为 造trace建议(本traceId, "取消不可原地重试")
    设 trace记录 为 记trace(执行器, 工具名, 调取消, 本traceId, 父链,
      "执行前检测到取消", 建议文本)
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 调取消, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调取消, "结果": 空,
      "错误码": "TOOL_CANCELLED", "消息": "执行前检测到取消"}
    返回 {"过": 假, "结果": 附trace元数据(结果, trace记录, 建议文本)}
  # T-0510 高危命令确认门控（与 执行工具 同判，复用 §7 出口）：
  # deny 即拒绝并记审计；并发路径的放行/拒绝判定与同步路径一致。
  设 高危决 为 具高危命令预决(工具名, 参数)
  设 高危收敛 为 具高危命令收敛(执行器, 高危决)
  如果 高危收敛["过"] == 假:
    设 建议文本 为 造trace建议(本traceId, "高危命令需确认后重试")
    设 trace记录 为 记trace(执行器, 工具名, 调拒绝, 本traceId, 父链,
      高危收敛["消息"], 建议文本)
    具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
      具摘要(参数), 0, 本traceId)
    设 结果 为 {"状态": 调拒绝, "结果": 空,
      "错误码": "CMD_RISK_CONFIRM", "消息": 高危收敛["消息"]}
    返回 {"过": 假, "结果": 附trace元数据(结果, trace记录, 建议文本)}
  # T-0509 可逆性分级门控（与 执行工具 同判，复用 §7c 分级守卫）
  设 分级守卫 为 具分级守卫(执行器, 工具名, 参数, 本traceId, 父链, 调用者)
  如果 分级守卫["过"] == 假:
    返回 分级守卫
  具记审计(执行器["审计"], 审计开始, 工具名, 调用者, "start", 时刻,
    具摘要(参数), 0, 本traceId)
  # 传递本 traceId 给执行体；不重新生成，保证一次执行只有一个关联键
  返回 {"过": 真, "结果": 空, "traceId": 本traceId, "父traceId": 父链}

# 执行体：同步处理 与 异步处理 二选一（显式分流），异常统一收敛
异步 段落 具并发执行体(执行器, 工具名, 参数, 本traceId = 空, 父traceId = 空):
  设 工具 为 取工具(执行器["注册"], 工具名)
  设 时刻 为 执行器["时刻"]
  如果 本traceId == 空:
    设 本traceId 为 取新traceId(执行器)
  尝试:
    设 异步处理 为 字典获取(工具, "异步处理", 空)
    设 结果 为 空
    如果 异步处理 != 空:
      设 结果 为 等待 异步处理(参数, 执行器["令牌"])
    否则:
      如果 工具["处理"] == 空:
        抛出 新建 错误("工具无处理函数 [NO_HANDLER]")
      设 同步处理 为 工具["处理"]
      设 结果 为 同步处理(参数, 执行器["令牌"])
    具记已读(执行器, 工具名, 参数)
    检查取消(执行器["令牌"])
    具记审计(执行器["审计"], 审计结束, 工具名, "并发", 调正常, 时刻, "", 0,
      本traceId)
    设 trace记录 为 记trace(执行器, 工具名, 调正常, 本traceId, 父traceId)
    返回 附trace元数据({"状态": 调正常, "结果": 结果,
      "错误码": 空, "消息": 空}, trace记录)
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
    设 态 为 调失败
    如果 字符串包含(消息, "TOOL_CANCELLED") == 真:
      设 态 为 调取消
    设 异常体 为 造运行时异常信封(消息, 本traceId)
    设 建议文本 为 造trace建议(本traceId, 异常体["suggestion"])
    设 trace记录 为 记trace(执行器, 工具名, 态, 本traceId, 父traceId,
      消息, 建议文本)
    具记审计(执行器["审计"], 审计失败, 工具名, "并发", 态, 时刻, "", 0,
      本traceId)
    设 结果 为 {"状态": 态, "结果": 空, "错误码": 态, "消息": 消息}
    返回 附trace元数据(结果, trace记录, 建议文本, 异常体)

# 单工具异步执行：返回形状与 A 的 执行工具 逐键相同
异步 段落 具异步执行(执行器, 工具名, 调用者级别, 调用者 = "匿名", 参数 = 空,
  调用者插件 = 空, 父traceId = 空):
  设 闸 为 具执行前置闸门(执行器, 工具名, 调用者级别, 调用者, 参数,
    调用者插件, 父traceId)
  如果 闸["过"] == 假:
    返回 闸["结果"]
  返回 等待 具并发执行体(执行器, 工具名, 参数, 闸["traceId"], 闸["父traceId"])

# 多工具并发执行：前置闸门串行 + 执行体并发，结果按请求序对齐
# 请求形状：{"工具名": 名称, "参数": 参数, "父traceId": 可选父链}
# 也接受直接把失败结果当请求：其 "traceId" 键会作为父链。
异步 段落 具并发执行(执行器, 请求表, 调用者级别, 调用者 = "匿名", 调用者插件 = 空, 父traceId = 空):
  设 早决表 为 []
  设 待发表 为 []
  遍历 请求 之 请求表:
    设 工具名 为 请求["工具名"]
    设 参数 为 字典获取(请求, "参数", 空)
    设 请求父 为 字典获取(请求, "父traceId", 空)
    如果 请求父 == 空:
      设 请求父 为 字典获取(请求, "traceId", 父traceId)
    设 闸 为 具执行前置闸门(执行器, 工具名, 调用者级别, 调用者, 参数,
      调用者插件, 请求父)
    如果 闸["过"] == 真:
      早决表.追加(空)
      待发表.追加({"工具名": 工具名, "参数": 参数,
        "traceId": 闸["traceId"], "父traceId": 闸["父traceId"]})
    否则:
      早决表.追加(闸["结果"])
  设 完成表 为 []
  如果 长(待发表) > 0:
    设 任务表 为 []
    遍历 待 之 待发表:
      任务表.追加(创建任务(具并发执行体(执行器, 待["工具名"], 待["参数"],
        待["traceId"], 待["父traceId"])))
    设 完成表 为 等待 并发等待(任务表)
  # 按请求序回填：早决位用早决结果，其余按待发序取并发结果
  设 最终表 为 []
  设 次序 为 0
  设 位置 为 0
  当 位置 < 长(早决表):
    设 项 为 早决表[位置]
    如果 项 == 空:
      设 项 为 完成表[次序]
      设 次序 为 次序 + 1
    最终表.追加(项)
    设 位置 为 位置 + 1
  返回 最终表

# =====================================================================
# §6c W6-A/T-0515 traceId 轻量关联键
#
# 设计边界（红线）：
#   1. traceId 只串「失败 → suggestion → 重试 → 同族子操作」，不做 span/采样/导出；
#   2. 每次执行都在执行器内生成并记录 traceId（审计条目也带），但**纯成功结果
#      不新增可见字段**——保持既有成功结果逐键不变（Day3 并发等价用例逐字比对）；
#   3. 失败结果、父链重试结果新增 traceId 元数据；失败文案（消息）保持原样，
#      traceId 只出现在 suggestion / 结构化异常里，不改变错误码与状态口径。

段落 抄trace链(表):
  设 结果 为 []
  遍历 项 之 表:
    结果.追加(项)
  返回 结果

# 生成唯一 traceId。工厂可注入（测试用确定性序列），缺省 uuid4。
段落 生成traceId():
  返回 追踪前缀 + 生成UUID4()

段落 取新traceId(执行器):
  设 工厂 为 字典获取(执行器, "traceId工厂", 空)
  如果 工厂 != 空:
    返回 转字符串(工厂())
  返回 生成traceId()

# 模型侧把 traceId 塞回下一次调用参数（或显式传 父traceId）都能接住。
# 显式父链优先，避免参数里的同名业务字段意外改链。
段落 取父traceId(参数, 父traceId):
  如果 父traceId != 空:
    返回 父traceId
  如果 是字典(参数) == 真 且 字典包含键(参数, "traceId") == 真:
    返回 参数["traceId"]
  返回 空

# 记一次执行到关联表。父 id 命中既有记录时继承根 id 与重试链；
# 父 id 是外部传入的孤立 id 时，也把它放进链首，保证 LLM 可凭它反查。
段落 记trace(执行器, 工具名, 状态, 当前id, 父id = 空, 错误信息 = "", 建议文本 = ""):
  设 根id 为 当前id
  设 链 为 []
  如果 父id != 空:
    如果 字典包含键(执行器["trace表"], 父id) == 真:
      设 父记录 为 执行器["trace表"][父id]
      设 根id 为 字典获取(父记录, "根traceId", 父id)
      设 链 为 抄trace链(字典获取(父记录, "重试链", []))
    否则:
      设 根id 为 父id
      链.追加(父id)
  链.追加(当前id)
  设 记录 为 {"traceId": 当前id, "父traceId": 父id, "根traceId": 根id,
    "工具名": 工具名, "状态": 状态, "错误信息": 错误信息,
    "建议": 建议文本, "重试链": 链}
  字典设置(执行器["trace表"], 当前id, 记录)
  字典设置(执行器, "最后traceId", 当前id)
  返回 记录

段落 最后traceId(执行器):
  返回 字典获取(执行器, "最后traceId", "")

段落 追踪详情(执行器, traceId):
  返回 字典获取(执行器["trace表"], traceId, 空)

# 按根 traceId 取整族（含根自身），按登记序返回，供后续结构化结果消费。
段落 按根追踪(执行器, 根id):
  设 结果 为 []
  遍历 当前id 之 字典键列表(执行器["trace表"]):
    设 记录 为 执行器["trace表"][当前id]
    如果 记录["根traceId"] == 根id:
      结果.追加(记录)
  返回 结果

# suggestion 一律带 traceId：模型据此把「这次失败」与「下一次重试」串起来。
段落 造trace建议(traceId, 提示 = ""):
  设 文本 为 "如需重试或查询本次执行，请携带 traceId=" + traceId
  如果 提示 != "":
    设 文本 为 提示 + "；" + 文本
  返回 文本

# W3/T-0505 运行时异常信封的 traceId 由本卡填充；类型判定保守：
# 只有明确超时才可原地重试，其余一律不可重试，避免模型无意义重试。
段落 推断异常类型(消息):
  如果 字符串包含(消息, "TOOL_CANCELLED") == 真:
    返回 异常取消
  如果 字符串包含(消息, "timeout") == 真 或 字符串包含(消息, "超时") == 真:
    返回 异常超时
  如果 字符串包含(消息, "notFound") == 真 或 字符串包含(消息, "未找到") == 真:
    返回 异常未找到
  如果 字符串包含(消息, "permission") == 真 或 字符串包含(消息, "权限") == 真:
    返回 异常权限
  返回 异常内部

# ---- W3/T-0505 运行时异常信封 ----
# 契约与 错误增强 §14（造运行时错误）**逐键相同**（同一只信封，只是本模块内联一份）：
#   type/errorType/code/field/reason/message/suggestion/retryable/traceId/details
# 为什么内联而不用 import：import 错误增强 会把 附件准入/终端 整条依赖链拖进每个
#   工具_bash 使用方，编译期直接击穿既有超时预算（见文件头 T-0504 注，实测 21s / 12s）。
#   两处口径由 tests/test_T0505_运行时异常结构化.py 的「同键集」判据钉死，改一边即红。
设 异常码超时 为 "TOOL_TIMEOUT"
设 异常码未找到 为 "TOOL_NOT_FOUND"
设 异常码权限 为 "TOOL_PERMISSION_DENIED"
设 异常码取消 为 "TOOL_CANCELLED"
设 异常码内部 为 "TOOL_INTERNAL_ERROR"
# 异常类型 → 稳定错误码 / 可重试 / 可操作建议（与 错误增强.运行时类型表 同口径）
设 异常码表 为 {"timeout": 异常码超时, "notFound": 异常码未找到,
  "permission": 异常码权限, "cancelled": 异常码取消, "internal": 异常码内部}
设 异常建议表 为 {
  "timeout": "可原样重试一次；若仍超时，缩短处理量或换方案",
  "notFound": "先核对路径/标识是否真实存在，改参数后再调用；原样重试无意义",
  "permission": "无权限，原样重试无意义；改用可访问路径或请用户授权",
  "cancelled": "已被取消，重试无意义；确认需求后再发起",
  "internal": "内部错误，原样重试无意义；检查参数与前置条件，或换方案"
}

段落 异常是已知型(类型):
  如果 类型 == 异常超时 或 类型 == 异常未找到:
    返回 真
  如果 类型 == 异常权限 或 类型 == 异常取消 或 类型 == 异常内部:
    返回 真
  返回 假

# 归一到已知型：空 / 未知一律 internal（保守落点，不猜成可重试类别）
段落 归一异常类型(类型):
  如果 是字符串(类型) == 假:
    返回 异常内部
  如果 异常是已知型(类型) == 真:
    返回 类型
  返回 异常内部

# 可重试**白名单**：只有 timeout 可原地重试，其余一律 假（保守单一出口）
段落 异常可重试(类型):
  如果 归一异常类型(类型) == 异常超时:
    返回 真
  返回 假

段落 异常类型码(类型):
  返回 字典获取(异常码表, 归一异常类型(类型), 异常码内部)

段落 异常类型建议(类型):
  返回 字典获取(异常建议表, 归一异常类型(类型),
    "原样重试无意义；检查参数或换方案")

# 造运行时异常信封：与 错误增强 §14 造运行时错误 同键集（type 恒 runtime）
段落 造运行时异常信封(消息, traceId, 类型 = 空):
  设 实际类型 为 类型
  如果 实际类型 == 空:
    设 实际类型 为 推断异常类型(消息)
  设 实际类型 为 归一异常类型(实际类型)
  设 信封 为 {"type": 异常大类运行, "errorType": 实际类型,
    "code": 异常类型码(实际类型), "field": 空, "reason": 空, "message": 消息,
    "suggestion": 异常类型建议(实际类型), "retryable": 异常可重试(实际类型),
    "traceId": traceId, "details": 空}
  返回 信封

# 轻量视图（T-0515 已钉住的 4 键 wire 形状，保留兼容）：由**同一只信封**投影而来，
#   不是第二套 schema；显式 可重试 只能否掉白名单里的可重试，不能打开白名单外。
段落 造运行时异常(消息, traceId, 类型 = 空, 可重试 = 空):
  设 信封 为 造运行时异常信封(消息, traceId, 类型)
  设 轻量 为 {"errorType": 信封["errorType"], "message": 信封["message"],
    "retryable": 信封["retryable"], "traceId": 信封["traceId"]}
  如果 可重试 == 空:
    返回 轻量
  如果 可重试 == 真 且 信封["retryable"] == 真:
    字典设置(轻量, "retryable", 真)
  返回 轻量

# 只给「需要关联」的结果挂元数据；纯成功结果原样返回。
# T-0505：异常结构入参是**运行时异常信封**（错误增强 §14 同族十键：type/errorType/
#   code/field/reason/message/suggestion/retryable/traceId/details），挂到 运行时异常；
#   顶层再平铺 errorType/retryable 两个模型面短键（既有消费方按短键取，不破坏）。
段落 附trace元数据(结果, 记录, 建议文本 = "", 异常结构 = 空):
  设 需暴露 为 假
  如果 结果["状态"] != 调正常:
    设 需暴露 为 真
  如果 记录["父traceId"] != 空:
    设 需暴露 为 真
  如果 需暴露 == 真:
    字典设置(结果, "traceId", 记录["traceId"])
    字典设置(结果, "父traceId", 记录["父traceId"])
    字典设置(结果, "根traceId", 记录["根traceId"])
    字典设置(结果, "重试链", 记录["重试链"])
  如果 建议文本 != "":
    字典设置(结果, "suggestion", 建议文本)
    字典设置(结果, "建议", 建议文本)
  如果 异常结构 != 空:
    字典设置(结果, "运行时异常", 异常结构)
    字典设置(结果, "errorType", 异常结构["errorType"])
    字典设置(结果, "retryable", 异常结构["retryable"])
  返回 结果

# 同族子操作：父执行的工具与子工具共享 DSH 叶子（或干脆同名）时，
# 子操作继承父 traceId；不同族保持独立 trace，避免把无关操作串成一条链。
段落 关联子操作(执行器, 父traceId, 工具名, 调用者级别, 调用者 = "匿名", 参数 = 空, 调用者插件 = 空):
  设 父记录 为 追踪详情(执行器, 父traceId)
  设 子父 为 空
  如果 父记录 != 空:
    设 父工具 为 字典获取(父记录, "工具名", "")
    如果 父工具 == 工具名:
      设 子父 为 父traceId
    否则:
      如果 是同族工具(父工具, 工具名) == 真:
        设 子父 为 父traceId
  返回 执行工具(执行器, 工具名, 调用者级别, 调用者, 参数, 调用者插件, 子父)

# §7 R47 深化（#8）：PTC 预决确认决策面（纯逻辑，不接宿主审批总线）
#
# 上游（只读）：packages/core/tools/src/index.ts
#   PreToolDecision = { kind: 'allow' } | { kind: 'deny'; reason } | { kind: 'ask'; reason? }
#   resolveAsk（1669-1716）：ask 无审批服务 → deny（requires approval, not yet supported）；
#     ask + allowed-once → allow；denied → deny；审批通道取消 → deny（approval cancelled）。
#   询问只在 pre-execute 瀑布与守卫都放行后发生；守卫单调否决不可被放行翻案。
# 纯逻辑复刻：审批结果由调用方显式传入，不接真实审批服务。
# =====================================================================

设 决放行 为 "allow"
设 决拒绝 为 "deny"
设 决询问 为 "ask"
设 预决表 为 [决放行, 决拒绝, 决询问]

设 批准放行 为 "allowed-once"
设 批准拒绝 为 "denied"
设 批准取消 为 "cancelled"
设 审批结果表 为 [批准放行, 批准拒绝, 批准取消]

# 造预决：校验种类并构造预决字典（ask 可带理由；allow 不带）
段落 具造预决(种类, 理由 = 空):
  如果 预决表.包含(种类) == 假:
    抛出 新建 错误("未知预决种类：" + 转字符串(种类) + " [UNKNOWN_PRE_TOOL_DECISION]")
  如果 种类 == 决放行 且 理由 != 空:
    抛出 新建 错误("allow 预决不携带理由 [ALLOW_WITH_REASON]")
  设 决 为 {"种类": 种类}
  如果 理由 != 空:
    决["理由"] 为 理由
  返回 决

# 询问收敛（上游 resolveAsk 纯决策面）：
#   allow/deny 原样收敛；ask 按审批链路折叠为 allow/deny：
#     无审批通道 → deny（审批未支持）；allowed-once → allow；
#     denied → deny；cancelled → deny（审批通道取消）；未知结果 → deny。
段落 具询问收敛(预决, 审批结果 = 空, 有通道 = 真):
  如果 预决["种类"] == 决放行:
    返回 {"种类": 决放行, "理由": 空}
  如果 预决["种类"] == 决拒绝:
    返回 {"种类": 决拒绝, "理由": 字典获取(预决, "理由", "")}
  # ask 路径
  如果 有通道 == 假:
    # T-0510：deny 理由透传预决事由（如高危命令的模式/理由），拒绝面可复核；
    # 判定语义不变（无通道 → deny）。
    设 事由 为 字典获取(预决, "理由", "")
    如果 事由 == "":
      返回 {"种类": 决拒绝, "理由": "工具 " + 字典获取(预决, "工具名", "") +
        " 需要审批，但审批通道未配置"}
    返回 {"种类": 决拒绝, "理由": "工具 " + 字典获取(预决, "工具名", "") +
      " 需要审批，但审批通道未配置；审批事由：" + 事由}
  如果 审批结果 == 批准放行:
    返回 {"种类": 决放行, "理由": 空}
  如果 审批结果 == 批准拒绝:
    返回 {"种类": 决拒绝, "理由": "审批拒绝"}
  如果 审批结果 == 批准取消:
    返回 {"种类": 决拒绝, "理由": "审批被取消"}
  返回 {"种类": 决拒绝, "理由": "审批结果未知"}

# 守卫否决单调性（上游 guard：任一守卫返回理由即否决，且不可被后续放行翻案）
段落 具守卫裁决(否决理由, 预决):
  如果 否决理由 != 空:
    返回 {"种类": 决拒绝, "理由": 否决理由}
  如果 预决["种类"] == 决放行:
    返回 {"种类": 决放行, "理由": 空}
  返回 预决

# =====================================================================
# §7b T-0510：bash 命令语义高危确认门控
#
#   动机：bash 的风险不止来自路径（静态分级已由 T-0470 cd 守卫兜住），
#   还来自**命令内容本身**（rm -rf、覆盖 mv、`>` 覆盖已有文件、管道删改、
#   宽权限/递归权限变更）。本节把 工具_路径安全.识别命令风险 的语义识别
#   结果接进执行器前置闸门，**复用 §7 预决确认出口**（决询问 → 具询问收敛），
#   不另起一套门控：
#     - 非高危（allow 预决）→ 直通，合法命令执行结果零变化；
#     - 高危（ask 预决）→ 按执行器注入的 审批通道/审批结果 收敛：
#         无通道 → deny（默认保守：确认未支持即不放行）；
#         批准放行（allowed-once）→ allow；批准拒绝/取消 → deny。
#   审计：deny 记 审计拒绝（状态=调拒绝，与权限拒绝同形，可复核）。
# =====================================================================

# 造高危命令预决：shell 类工具（bash/sh/shell）按命令语义识别判定，
# 其余工具 / 无命令参数 → allow 直通（识别只升级，不改变静态分级语义）
段落 具高危命令预决(工具名, 参数):
  设 是shell 为 假
  如果 工具名 == "bash" 或 工具名 == "sh" 或 工具名 == "shell":
    设 是shell 为 真
  如果 是shell == 假:
    返回 具造预决(决放行)
  设 命令 为 ""
  如果 参数 != 空 且 type(参数) == dict:
    设 命令键表 为 ["命令", "command", "cmd"]
    遍历 键 之 命令键表:
      如果 参数.包含(键):
        设 命令 为 转字符串(参数[键])
  如果 命令 == "":
    返回 具造预决(决放行)
  # bash 工作目录语义：单次 工作目录 参数（白名单）优先，否则会话工具根
  设 基准 为 取调用根(参数)
  设 风险 为 识别命令风险(命令, 基准)
  如果 风险["高危"] == 假:
    返回 具造预决(决放行)
  返回 具造预决(决询问, "bash 命令语义高危（" + 风险["模式"] + "）：" +
    风险["理由"] + "；需确认后方可执行")

# 高危预决收敛：ask → §7 具询问收敛（审批通道/结果由执行器键注入）
#   返回 {"过": 真/假, "消息": ""}——deny 时带收敛理由，供拒绝消息使用
段落 具高危命令收敛(执行器, 高危决):
  如果 高危决["种类"] != 决询问:
    返回 ["过": 真, "消息": ""]
  设 收敛 为 具询问收敛(高危决, 字典获取(执行器, "审批结果", 空),
    字典获取(执行器, "审批通道", 假))
  如果 收敛["种类"] == 决放行:
    返回 ["过": 真, "消息": ""]
  返回 ["过": 假, "消息": 收敛["理由"]]

# =====================================================================
# §7c T-0509：可逆性分级 → 执行前确认门控 + 前置校验
#
#   把 工具面装配 §11.4 的策略表接进执行器，让守卫强度按「不可逆程度」递增，
#   而不是每个工具各自在文案里写「请先确认 / 请先读」：
#
#     分级动作        执行器行为
#     放行           零拦截（只读 / 可逆 / 动态降档的合法调用）
#     提示           放行 + 门控日志留痕（软守卫，不改结果形状）
#     校验           强制前置校验，通过则放行并留痕，不通过即拒绝（默认档）
#     确认           前置校验 → §7 预决确认出口（ask → 审批链收敛；
#                    无审批通道 = deny）——配置可把不可逆档升到这一档
#
#   前置校验（只对「不可逆」档跑，复用 工具_路径安全，不另造路径校验）：
#     1) 文件类：目标路径必须在工具根内（解析安全路径）；
#     2) 命令类：rm / mv 的每个目标都要解析到工具根内（校验破坏性命令目标）；
#     3) 写文件覆盖：目标已存在且不在本执行器的「已读清单」→ 拒绝（先读再写）。
#
#   动态降档（静态只许更严，降档留门控日志）：
#     - bash / sh / shell：无命令参数或命令语义非高危（T-0510 判定）→ 放行；
#     - 写文件：目标不存在（本次是新增而不是覆盖）→ 放行；
#     - 其余不可逆工具没有可复核的动态结论 → 按静态档走确认（保守）。
# =====================================================================

设 具读工具名表 为 ["读文件", "read_file", "file.read"]
设 具写工具名表 为 ["写文件", "write_file", "file.write"]
设 具编辑工具名表 为 ["编辑文件", "edit_file", "file.edit"]
设 具命令工具名表 为 ["bash", "sh", "shell"]
设 具门控日志上限 为 64
设 门控拒绝码 为 "REVERSIBILITY_CONFIRM"
设 前置校验拒绝码 为 "GUARD_PRECHECK_FAILED"

# 具原名(执行器, 工具名) -> 注册条目原名（语义名调用时回落到原名，供工具族判定）
段落 具原名(执行器, 工具名):
  设 注册 为 字典获取(执行器, "注册", 空)
  如果 是字典(注册) == 假:
    返回 工具名
  设 键 为 可逆性条目键(注册, 工具名)
  如果 键 == "":
    返回 工具名
  设 表 为 字典获取(注册, "工具表", 空)
  如果 是字典(表) == 假 或 字典包含键(表, 键) == 假:
    返回 工具名
  设 条目 为 表[键]
  如果 是字典(条目) == 假:
    返回 工具名
  设 原名 为 字典获取(条目, "原名", "")
  如果 是字符串(原名) == 真 且 字符串长度(原名) > 0:
    返回 原名
  返回 工具名

# 具路径参数(参数) -> 首个非空路径词（键序与工具参数面一致）
段落 具路径参数(参数):
  如果 是字典(参数) == 假:
    返回 ""
  遍历 键 之 ["路径", "file_path", "path"]:
    如果 字典包含键(参数, 键) == 真:
      设 值 为 参数[键]
      如果 是字符串(值) == 真 且 字符串长度(去除空白(值)) > 0:
        返回 去除空白(值)
  返回 ""

# 具目标解析(执行器, 参数) -> {"有路径","ok","路径","理由"}
#   解析走 工具_路径安全.解析安全路径（根 = 取调用根(参数)，与处理器同口径）。
段落 具目标解析(执行器, 参数):
  设 词 为 具路径参数(参数)
  如果 词 == "":
    返回 {"有路径": 假, "ok": 假, "路径": "", "理由": ""}
  设 解 为 解析安全路径(取调用根(参数), 词)
  返回 {"有路径": 真, "ok": 解["ok"], "路径": 解["路径"],
    "理由": 字典获取(解, "理由", "")}

# 具命令文本(参数) -> 命令串（与 具高危命令预决 同口径：命令 / command / cmd）
段落 具命令文本(参数):
  设 命令 为 ""
  如果 参数 != 空 且 是字典(参数) == 真:
    遍历 键 之 ["命令", "command", "cmd"]:
      如果 字典包含键(参数, 键) == 真:
        设 命令 为 转字符串(参数[键])
  返回 命令

# 具记已读(执行器, 工具名, 参数) -> 是否记入
#   只记「读文件」成功后的目标（规范路径做键），供 写文件 覆盖校验使用。
段落 具记已读(执行器, 工具名, 参数):
  设 原名 为 具原名(执行器, 工具名)
  如果 列表包含(具读工具名表, 原名) == 假:
    返回 假
  设 目标 为 具目标解析(执行器, 参数)
  如果 目标["ok"] == 假:
    返回 假
  设 表 为 字典获取(执行器, "已读表", 空)
  如果 是字典(表) == 假:
    设 表 为 {}
    字典设置(执行器, "已读表", 表)
  字典设置(表, 规范路径比较(目标["路径"]), 真)
  返回 真

# 具已读过(执行器, 路径) -> 布尔（规范路径比较命中即算读过）
段落 具已读过(执行器, 路径):
  设 表 为 字典获取(执行器, "已读表", 空)
  如果 是字典(表) == 假:
    返回 假
  返回 字典包含键(表, 规范路径比较(路径))

# 具记门控(执行器, 工具名, 档, 动作, 事由)：门控日志留痕（降档 / 提示 / 拒绝）
段落 具记门控(执行器, 工具名, 档, 动作, 事由):
  设 表 为 字典获取(执行器, "门控日志", 空)
  如果 是列表(表) == 假:
    设 表 为 []
    字典设置(执行器, "门控日志", 表)
  列表追加(表, {"工具名": 工具名, "档": 档, "动作": 动作, "事由": 事由,
    "时刻": 执行器["时刻"]})
  # 环形上限：超出即重建，保留最近 N 条
  如果 长(表) > 具门控日志上限:
    设 起 为 长(表) - 具门控日志上限
    设 新表 为 []
    设 位 为 起
    当 位 < 长(表):
      新表.追加(表[位])
      设 位 为 位 + 1
    字典设置(执行器, "门控日志", 新表)

# 门控日志(执行器) -> 副本（观测/判据用；不改执行路径）
段落 门控日志(执行器):
  设 表 为 字典获取(执行器, "门控日志", 空)
  如果 是列表(表) == 假:
    返回 []
  返回 表

# 具不可逆降档(执行器, 原名, 参数) -> {"可逆":真/假, "事由":""}
#   只对「动态结论可复核」的工具族降档；其余一律保持不可逆（保守）。
段落 具不可逆降档(执行器, 原名, 参数):
  如果 列表包含(具命令工具名表, 原名) == 真:
    设 命令 为 具命令文本(参数)
    如果 命令 == "":
      返回 {"可逆": 真, "事由": "无命令参数，非破坏性调用"}
    设 风险 为 识别命令风险(命令, 取调用根(参数))
    如果 风险["高危"] == 假:
      返回 {"可逆": 真, "事由": "命令语义非高危（T-0510 动态判定）"}
    返回 {"可逆": 假, "事由": 风险["理由"]}
  如果 列表包含(具写工具名表, 原名) == 真:
    设 目标 为 具目标解析(执行器, 参数)
    如果 目标["有路径"] == 假:
      返回 {"可逆": 假, "事由": "缺路径参数，覆盖面不可判定"}
    如果 目标["ok"] == 假:
      返回 {"可逆": 假, "事由": "目标路径越界，交前置校验拒绝"}
    如果 文件存在(目标["路径"]) == 假:
      返回 {"可逆": 真, "事由": "目标不存在，本次是新增而非覆盖"}
    返回 {"可逆": 假, "事由": "目标已存在，覆盖无回滚路径"}
  返回 {"可逆": 假, "事由": "静态档位不可逆，无动态降档依据"}

# 具前置校验(执行器, 原名, 参数) -> {"通过":真/假, "理由":""}
#   三级校验都复用 工具_路径安全：越界/破坏性目标/已读清单。
段落 具前置校验(执行器, 原名, 参数):
  # A) 文件类：目标路径必须在工具根内（写 / 编辑）
  设 是写 为 列表包含(具写工具名表, 原名)
  如果 是写 == 真 或 列表包含(具编辑工具名表, 原名) == 真:
    设 目标 为 具目标解析(执行器, 参数)
    如果 目标["有路径"] == 真 且 目标["ok"] == 假:
      返回 {"通过": 假, "理由": "路径安全校验失败：" + 目标["理由"]}
    # 写文件覆盖「已读」：目标已存在且没读过 → 先读再写（即使审批放行也不跳）
    如果 是写 == 真 且 目标["ok"] == 真 且 文件存在(目标["路径"]) == 真:
      如果 具已读过(执行器, 目标["路径"]) == 假:
        返回 {"通过": 假,
          "理由": "覆盖前需先读目标文件：" + 目标["路径"] + "（已读清单未命中）"}
  # B) 命令类：rm / mv 的每个目标都要解析到工具根内
  如果 列表包含(具命令工具名表, 原名) == 真:
    设 命令 为 具命令文本(参数)
    如果 命令 != "":
      设 校验 为 校验破坏性命令目标(命令, 取调用根(参数))
      如果 校验["通过"] == 假:
        返回 {"通过": 假, "理由": "命令目标校验失败：" + 校验["理由"]}
  返回 {"通过": 真, "理由": ""}

# 具守卫拒绝(执行器, 工具名, 调用者, 消息, 错误码, 本traceId, 父链) -> 早决结果
#   口径与 §7b 高危命令拒绝一致：记 trace + 审计拒绝（状态 = 调拒绝）。
段落 具守卫拒绝(执行器, 工具名, 调用者, 消息, 错误码, 本traceId, 父链):
  设 时刻 为 执行器["时刻"]
  设 建议文本 为 造trace建议(本traceId, "可逆性门控未通过，不建议原地重试")
  设 trace记录 为 记trace(执行器, 工具名, 调拒绝, 本traceId, 父链, 消息, 建议文本)
  具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
    具摘要({}), 0, 本traceId)
  设 结果 为 {"状态": 调拒绝, "结果": 空, "错误码": 错误码, "消息": 消息}
  返回 {"过": 假, "结果": 附trace元数据(结果, trace记录, 建议文本)}

# 具分级守卫(执行器, 工具名, 参数, 本traceId, 父链, 调用者) -> {"过","结果"}
#   顺序：分级策略（含动态降档）→ 前置校验（仅不可逆档）→ 确认出口。
#   「只读 / 可逆」直接放行，且不跑任何额外 I/O（误拦率为零是硬约束）。
段落 具分级守卫(执行器, 工具名, 参数, 本traceId, 父链, 调用者):
  设 判定 为 工具门控判定(字典获取(执行器, "门控", 空), 字典获取(执行器, "注册", 空), 工具名)
  设 原名 为 具原名(执行器, 工具名)
  设 动作 为 判定["动作"]
  # 1) 不可逆档允许凭可复核动态结论降档（静态只许更严；降档留日志）
  如果 (动作 == 门控确认 或 动作 == 门控校验) 且 判定["档"] == 级不可逆:
    设 降 为 具不可逆降档(执行器, 原名, 参数)
    如果 降["可逆"] == 真:
      设 动作 为 门控放行
      具记门控(执行器, 工具名, 判定["档"], 门控放行, "动态降档放行：" + 降["事由"])
  # 2) 前置校验：不可逆档必跑（降档后仍跑——路径/已读是硬护栏）；
  #    配置把别的档位抬到 校验/确认 时也跑（动作本身就是「强制校验」）
  设 要校验 为 判定["档"] == 级不可逆
  如果 动作 == 门控校验 或 动作 == 门控确认:
    设 要校验 为 真
  如果 要校验 == 真:
    设 校验 为 具前置校验(执行器, 原名, 参数)
    如果 校验["通过"] == 假:
      具记门控(执行器, 工具名, 判定["档"], 门控确认, 校验["理由"])
      返回 具守卫拒绝(执行器, 工具名, 调用者, 校验["理由"], 前置校验拒绝码,
        本traceId, 父链)
  # 3) 确认出口：复用 §7 预决收敛（审批链决定 ask → allow / deny）
  如果 动作 == 门控确认:
    设 预决 为 具造预决(决询问, 判定["事由"])
    字典设置(预决, "工具名", 工具名)
    设 收敛 为 具询问收敛(预决, 字典获取(执行器, "审批结果", 空),
      字典获取(执行器, "审批通道", 假))
    如果 收敛["种类"] != 决放行:
      具记门控(执行器, 工具名, 判定["档"], 门控确认, 收敛["理由"])
      返回 具守卫拒绝(执行器, 工具名, 调用者, 收敛["理由"], 门控拒绝码,
        本traceId, 父链)
  # 4) 软守卫：提示只留痕；校验通过也留痕（可复核「这次为什么放行」）
  如果 动作 == 门控提示:
    具记门控(执行器, 工具名, 判定["档"], 门控提示, 判定["事由"])
  如果 动作 == 门控校验:
    具记门控(执行器, 工具名, 判定["档"], 门控校验, "前置校验通过，放行")
  返回 {"过": 真, "结果": 空}

# =====================================================================
# §8 会话预算信号注入（T-0512）
#
# 上游语境：模型不知道本轮烧了多少 token、还剩多少预算。本段只做**注入**：
#   用量数字由 src/上下文.light 提供（复用 令牌估算 口径），阈值/渲染在
#   工具面装配 §12b；这里负责把信号挂到工具响应元数据上，供模型在每轮
#   （或越过阈值后）看到「本轮 / 累计 / 剩余」。
#
# 红线：
#   1. 软提示——注入与否都不改变执行结果，绝不因额度耗尽拒绝/终止工具调用；
#   2. 轻量——只挂一个 "预算" 子字典（含一行文本），不复制用量历史；
#   3. 默认零侵入——未显式调用 具附预算信号 / 具执行工具带预算 的路径
#      逐键不变（T-0449 执行管线不回归）。
# =====================================================================

# 具预算信号(用量状态, 配置 = 空) → 信号字典（见 工具面装配.计算预算信号）
#   显式配置优先；缺配置时以用量状态里的上下文窗口作分母（建用量状态 传的窗口
#   就是会话真实窗口），避免信号分母与用量台账各说一套。
段落 具预算信号(用量状态, 配置 = 空):
  设 实配置 为 配置
  如果 是字典(实配置) == 假:
    设 实配置 为 建预算信号配置("每轮", 空, 取窗口(用量状态))
  返回 计算预算信号(取本轮令牌(用量状态), 取累计令牌(用量状态), 实配置)

# 具附预算信号(结果, 用量状态, 配置 = 空, 元数据键 = "元数据") → 结果
#   未触发（阈值模式未到线 / 显式停用）时**原样返回**，不添加空元数据；
#   已存在 元数据 字典则就地补 "预算" 键，不覆盖其它元数据。
#   重复调用幂等：同一状态算出同一信号，覆盖写而非追加。
段落 具附预算信号(结果, 用量状态, 配置 = 空, 元数据键 = "元数据"):
  如果 是字典(结果) == 假:
    返回 结果
  设 信号 为 具预算信号(用量状态, 配置)
  如果 信号["触发"] == 假:
    返回 结果
  设 元数据表 为 字典获取(结果, 元数据键, 空)
  如果 是字典(元数据表) == 假:
    设 元数据表 为 {}
    字典设置(结果, 元数据键, 元数据表)
  字典设置(元数据表, "预算", 信号)
  返回 结果

# 具执行工具带预算(执行器, 工具名, 调用者级别, 用量状态, ...) → 执行结果
#   与 执行工具 参数序一致，仅多插 用量状态（第 4 位）与 预算配置（末位）；
#   执行语义完全复用 执行工具，只在返回前补预算元数据。
段落 具执行工具带预算(执行器, 工具名, 调用者级别, 用量状态, 调用者 = "匿名", 参数 = 空, 调用者插件 = 空, 父traceId = 空, 预算配置 = 空):
  设 结果 为 执行工具(执行器, 工具名, 调用者级别, 调用者, 参数, 调用者插件, 父traceId)
  返回 具附预算信号(结果, 用量状态, 预算配置)

# =====================================================================
# §9 W3/T3.4 校验熔断与反馈闭环（T-0507）
#
# 背景（任务卡）：现状是「同一工具连续 3 次参数校验失败 → 熔断并中止本轮」
#   （计数在 代理.light 的 记参数失败）。熔断是保护，但撞墙前模型常常只是
#   原样重发同一调用。本段把「熔断」与「可操作反馈」对齐，分两件事：
#
#   1) 预校验（轻量、显式开关）：在工具真正派发前，用**同一份** schema
#      （工具条目里的 参数模式，即能力登记口径）先做一次只看「明显错误」的
#      前置检查：顶层缺必填 / 顶层类型明显不符 / 顶层枚举越界。
#      命中即拦，不再调全量校验器，也不进限流、不派发；
#      其余一律放行（嵌套字段、额外字段、格式/长度等交给全量校验器），
#      **宁可漏拦，不可误拦**——合法调用必须放行。
#
#   2) 熔断计数与结构化错误联动：具记熔断(熔断器, 工具名, 结果) 直接吃执行
#      管线的失败结果（PARAM_SCHEMA_INVALID + 结构化错误信封），逐次留
#      「字段/原因/建议」摘要；达到门限时给出可操作的熔断消息
#      （已试几次 + 各次原因 + 「换方案而非继续重试」指引）。
#
# 红线（任务卡）：
#   · 预校验只拦明显错误，且默认关闭（建执行器 第 9 参 预校验=真 才启用），
#     既有调用点逐键逐语义不变；
#   · 默认熔断门限 3（与 代理.light 参数熔断门限 同值），要改必须显式传门限；
#     传 0 = 关闭熔断（沿用 代理.light「0 关闭」口径）；
#   · 不另造 schema：schema 只从 工具["参数模式"] 读，不新建任何 schema 表；
#     错误信封 10 键与 错误增强 §13 逐字相同，原因码沿用校验器那一套
#     （missing / type / enum），文案口径与 工具.light 校验器 + 错误增强 对齐
#     （tests/test_T0507_熔断反馈闭环.py 逐字比对，防两套方言）。
#
# 接线归下游（本卡不改 代理.light，不在允许路径内）：
#   代理.light 的 记参数失败 换成
#     设 结 为 具记熔断(己.熔断器, 工具名, 结果)
#     如果 结["熔断"] == 真: 己.终止(结["消息"])
#   计数/清零/消息语义已在此处钉死，接线只搬运，不再写第二套逻辑。
# =====================================================================

设 熔断默认门限 为 3
设 熔断停用门限 为 0
设 熔断摘要上限 为 5
# 校验错误码/大类：与 错误增强.码参数校验 / 错误大类校验 / 错误型校验 同值镜像
#   （本模块不 import 错误增强，见文件头注；漂移由 T-0507 用例逐字比对兜住）
设 校验错误码 为 "PARAM_SCHEMA_INVALID"
设 错误大类校验 为 "validation"
设 错误型校验 为 "schema"

# ---- 9.1 轻量预校验：只认三类「明显错误」----

# 取值类型名（与 错误增强 §13.5 值类型名 同口径：布尔先于整数）
段落 具取值类型名(值):
  如果 是字符串(值) == 真:
    返回 "string"
  如果 是布尔(值) == 真:
    返回 "boolean"
  如果 是整数(值) == 真:
    返回 "integer"
  如果 是浮点(值) == 真:
    返回 "number"
  如果 是列表(值) == 真:
    返回 "array"
  如果 是字典(值) == 真:
    返回 "object"
  返回 "null"

# 取值的中文类型名（与 工具.light 校验器.可读名 同口径，用于 type 细节文案）
段落 具可读类型名(值):
  如果 是字符串(值) == 真:
    返回 "字符串"
  如果 是布尔(值) == 真:
    返回 "布尔"
  如果 是整数(值) == 真:
    返回 "整数"
  如果 是浮点(值) == 真:
    返回 "小数"
  如果 是列表(值) == 真:
    返回 "数组"
  如果 是字典(值) == 真:
    返回 "对象"
  返回 "空"

段落 具连接文本(表, 分隔):
  设 文 为 ""
  设 序 为 0
  遍历 项 之 表:
    如果 序 > 0:
      设 文 为 文 + 分隔
    设 文 为 文 + 转字符串(项)
    设 序 为 序 + 1
  返回 文

# 子模式的期望类型文本（与 错误增强 §13.6 模式类型文本 同口径）
段落 具模式类型文本(子模式):
  如果 是字典(子模式) == 假:
    返回 ""
  设 型参 为 字典获取(子模式, "type", 空)
  如果 是字符串(型参) == 真:
    返回 型参
  如果 是列表(型参) == 真:
    如果 长(型参) > 0:
      返回 具连接文本(型参, "|")
  设 枚参 为 字典获取(子模式, "enum", 空)
  如果 是列表(枚参) == 真:
    如果 长(枚参) > 0:
      返回 "枚举 " + 具连接文本(枚参, "|")
  返回 ""

# 单值是否符合声明的 type（与 工具.light 校验器.校验型 同口径；
#   未知 type 返回 假，但调用方只对已知型判，未知型一律不拦）
段落 具型相符(值, 期望型):
  如果 期望型 == "string":
    返回 是字符串(值)
  如果 期望型 == "integer":
    返回 是整数(值)
  如果 期望型 == "number":
    如果 是整数(值) == 真 或 是浮点(值) == 真:
      返回 真
    返回 假
  如果 期望型 == "boolean":
    返回 是布尔(值)
  如果 期望型 == "null":
    返回 是空(值)
  如果 期望型 == "array":
    返回 是列表(值)
  如果 期望型 == "object":
    返回 是字典(值)
  返回 假

段落 具是已知型(期望型):
  如果 期望型 == "string":
    返回 真
  如果 期望型 == "integer":
    返回 真
  如果 期望型 == "number":
    返回 真
  如果 期望型 == "boolean":
    返回 真
  如果 期望型 == "null":
    返回 真
  如果 期望型 == "array":
    返回 真
  如果 期望型 == "object":
    返回 真
  返回 假

# 枚举表是否全是字符串（只有全字符串枚举才做「明显越界」判定，避免误拦数值枚举）
段落 具全是字符串(表):
  遍历 项 之 表:
    如果 是字符串(项) == 假:
      返回 假
  返回 真

# 明显错误信封：10 键与 错误增强.造校验错误 逐字相同
段落 具造预校验错误(字段, 原因, 消息, 建议, 细节):
  返回 {"type": 错误大类校验, "errorType": 错误型校验, "code": 校验错误码,
    "field": 字段, "reason": 原因, "message": 消息, "suggestion": 建议,
    "retryable": 假, "traceId": 空, "details": 细节}

# 预校验失败的载荷：与 错误增强.校验失败载荷 同形（ok=假 + 首条信封平铺 + 全量）
段落 具预校验载荷(错误表):
  设 首条 为 空
  如果 长(错误表) > 0:
    设 首条 为 错误表[0]
  设 首字段 为 ""
  设 首原因 为 ""
  设 首建议 为 ""
  设 首消息 为 "参数校验失败"
  如果 是字典(首条) == 真:
    设 首字段 为 转字符串(字典获取(首条, "field", ""))
    设 首原因 为 转字符串(字典获取(首条, "reason", ""))
    设 首建议 为 转字符串(字典获取(首条, "suggestion", ""))
    设 首消息 为 转字符串(字典获取(首条, "message", 首消息))
  返回 {"ok": 假, "type": 错误大类校验, "errorType": 错误型校验, "code": 校验错误码,
    "field": 首字段, "reason": 首原因, "message": 首消息, "suggestion": 首建议,
    "retryable": 假, "traceId": 空, "error": 首条, "validationErrors": 错误表}

# 单个已声明字段的顶层明显错误：类型 > 枚举（类型不符时不再叠一条枚举错，
#   与 工具.light 校验枚举 的 type-gated 语义一致）
段落 具查顶层明显错误(键, 值, 子模式, 错误表):
  如果 是字典(子模式) == 假:
    返回
  # oneOf / anyOf 交给全量校验器：轻量层不猜分支，避免误拦
  如果 字典包含键(子模式, "oneOf") == 真 或 字典包含键(子模式, "anyOf") == 真:
    返回
  设 型参 为 字典获取(子模式, "type", 空)
  如果 是字符串(型参) == 真 且 具是已知型(型参) == 真:
    如果 具型相符(值, 型参) == 假:
      设 错误 为 具造预校验错误("参数." + 键, "type",
        "参数." + 键 + "：期望 " + 型参 + " 实际 " + 具可读类型名(值),
        "类型应为 " + 型参 + "（当前为 " + 具取值类型名(值) + "）",
        {"路径": ["参数", 键]})
      列表追加(错误表, 错误)
      返回
  如果 是列表(型参) == 真:
    # 多类型声明：本仓全量校验器对 list 型不判（只看字符串型），
    #   轻量层必须与之一致——一律放行，避免比全量校验器更严而误拦
    返回
  设 枚举表 为 字典获取(子模式, "enum", 空)
  如果 是列表(枚举表) == 真 且 是字符串(值) == 真 且 具全是字符串(枚举表) == 真:
    如果 列表包含(枚举表, 值) == 假:
      设 错误 为 具造预校验错误("参数." + 键, "enum",
        "参数." + 键 + "：值不在枚举: " + 值,
        "枚举值只能是 " + 具连接文本(枚举表, "|") + "（当前为 " + 值 + "）",
        {"路径": ["参数", 键]})
      列表追加(错误表, 错误)

# 具轻量预校验(工具, 参数) → {"拦下": 布尔, "错误表": [...], "载荷": …}
#   schema 取 工具["参数模式"]（唯一来源）；非字典模式 → 放行（不做无依据的校验）
段落 具轻量预校验(工具, 参数):
  设 放行 为 {"拦下": 假, "错误表": [], "载荷": 空}
  如果 是字典(工具) == 假:
    返回 放行
  设 模式 为 字典获取(工具, "参数模式", 空)
  如果 是字典(模式) == 假:
    返回 放行
  设 实际参数 为 参数
  如果 是空(实际参数) == 真:
    设 实际参数 为 {}
  如果 是字典(实际参数) == 假:
    设 错误 为 具造预校验错误("参数", "type",
      "参数：期望 object 实际 " + 具可读类型名(实际参数),
      "类型应为 object（当前为 " + 具取值类型名(实际参数) + "）",
      {"路径": ["参数"]})
    设 错误表 为 [错误]
    返回 {"拦下": 真, "错误表": 错误表, "载荷": 具预校验载荷(错误表)}
  设 属性表 为 字典获取(模式, "properties", 空)
  设 必填表 为 字典获取(模式, "required", 空)
  设 错误表 为 []
  如果 是列表(必填表) == 真:
    遍历 键 之 必填表:
      如果 是字符串(键) == 真 且 字典包含键(实际参数, 键) == 假:
        设 子模式 为 空
        如果 是字典(属性表) == 真:
          设 子模式 为 字典获取(属性表, 键, 空)
        设 期望 为 具模式类型文本(子模式)
        设 建议 为 "缺少必填字段 " + 键
        如果 期望 != "":
          设 建议 为 建议 + "（" + 期望 + "）"
        设 错误 为 具造预校验错误("参数." + 键, "missing",
          "参数." + 键 + "：缺少必需字段 " + 键, 建议, {"路径": ["参数", 键]})
        列表追加(错误表, 错误)
  如果 是字典(属性表) == 真:
    遍历 键 之 字典键列表(实际参数):
      如果 字典包含键(属性表, 键) == 真:
        具查顶层明显错误(键, 实际参数[键], 属性表[键], 错误表)
  如果 长(错误表) == 0:
    返回 放行
  返回 {"拦下": 真, "错误表": 错误表, "载荷": 具预校验载荷(错误表)}

# ---- 9.2 熔断：门限可配（默认 3）+ 计数与结构化错误联动 ----

# 门限归一：整数 >=0 才采纳（0 = 关闭熔断）；其余（空/字符串/负数/非整数）回落 3
段落 具熔断门限归一(门限):
  如果 是整数(门限) == 真:
    如果 门限 >= 熔断停用门限:
      返回 门限
  返回 熔断默认门限

段落 建熔断器(门限 = 空, 摘要上限 = 空):
  设 显式 为 假
  如果 是整数(门限) == 真 且 门限 >= 熔断停用门限:
    设 显式 为 真
  设 实上限 为 熔断摘要上限
  如果 是整数(摘要上限) == 真 且 摘要上限 > 0:
    设 实上限 为 摘要上限
  返回 {"门限": 具熔断门限归一(门限), "显式": 显式,
    "计数": {}, "原因": {}, "摘要上限": 实上限}

段落 具熔断门限(熔断器):
  如果 是字典(熔断器) == 假:
    返回 熔断默认门限
  返回 字典获取(熔断器, "门限", 熔断默认门限)

段落 具熔断计数(熔断器, 工具名):
  如果 是字典(熔断器) == 假:
    返回 0
  设 计表 为 字典获取(熔断器, "计数", 空)
  如果 是字典(计表) == 假:
    返回 0
  返回 字典获取(计表, 工具名, 0)

# 路径表 → 字段路径文本（首段原样，下标写 [n]，其余点号连接；
#   与 错误增强.字段路径文本 同口径）
段落 具路径文本(路径表):
  设 文 为 ""
  设 序 为 0
  遍历 段 之 路径表:
    如果 是整数(段) == 真:
      设 文 为 文 + "[" + 转字符串(段) + "]"
    否则:
      如果 序 == 0:
        设 文 为 转字符串(段)
      否则:
        设 文 为 文 + "." + 转字符串(段)
    设 序 为 序 + 1
  返回 文

段落 具拼摘要(字段, 原因, 建议, 消息):
  设 文 为 字段
  如果 文 == "":
    设 文 为 消息
  如果 原因 != "":
    设 文 为 文 + "（" + 原因 + "）"
  如果 建议 != "":
    设 文 为 文 + "→" + 建议
  返回 文

# 一次失败的「字段/原因/建议」摘要：优先结构化错误信封（T-0504 口径），
#   退回校验错误表的首条（路径/原因/细节），再退回 消息
段落 具失败摘要(结果):
  如果 是字典(结果) == 假:
    返回 "未知失败"
  设 信封 为 字典获取(结果, "错误", 空)
  如果 是字典(信封) == 真:
    返回 具拼摘要(转字符串(字典获取(信封, "field", "")),
      转字符串(字典获取(信封, "reason", "")),
      转字符串(字典获取(信封, "suggestion", "")),
      转字符串(字典获取(信封, "message", "")))
  设 校验表 为 字典获取(结果, "校验错误", 空)
  如果 是列表(校验表) == 真:
    如果 长(校验表) > 0:
      设 项 为 校验表[0]
      如果 是字典(项) == 真:
        设 路径 为 字典获取(项, "路径", 空)
        设 字段 为 ""
        如果 是列表(路径) == 真:
          设 字段 为 具路径文本(路径)
        返回 具拼摘要(字段, 转字符串(字典获取(项, "原因", "")), "",
          转字符串(字典获取(项, "细节", "")))
  返回 转字符串(字典获取(结果, "消息", "未知失败"))

# 是否为参数校验失败（吃执行管线结果：顶层 错误码 或 结构化错误信封 code）
段落 具是参数错(结果):
  如果 是字典(结果) == 假:
    返回 假
  如果 转字符串(字典获取(结果, "错误码", "")) == 校验错误码:
    返回 真
  设 信封 为 字典获取(结果, "错误", 空)
  如果 是字典(信封) == 真:
    如果 转字符串(字典获取(信封, "code", "")) == 校验错误码:
      返回 真
  返回 假

# 熔断消息：已试几次 + 各次原因 + 「换方案而非继续重试」指引
段落 具造熔断消息(工具名, 次数, 原因表, 门限):
  设 行 为 ""
  设 序 为 0
  遍历 摘 之 原因表:
    如果 序 > 0:
      设 行 为 行 + "；"
    设 行 为 行 + "第" + 转字符串(序 + 1) + "次 " + 转字符串(摘)
    设 序 为 序 + 1
  设 文 为 "工具「" + 转字符串(工具名) + "」参数校验连续失败 " +
    转字符串(次数) + " 次（熔断门限 " + 转字符串(门限) + "），已熔断并中止本轮。"
  如果 行 != "":
    设 文 为 文 + "已尝试 " + 转字符串(次数) + " 次，各次失败原因：" + 行 + "。"
  设 文 为 文 + "应换方案而非继续重试：按上面的字段与建议改正参数结构、改调用方式或换工具；" +
    "原样重发同一个调用不会通过。门限可显式配置（默认 " + 转字符串(熔断默认门限) + "，传 0 关闭）。"
  返回 文

# 具记熔断(熔断器, 工具名, 结果) → {"熔断","次数","门限","摘要","消息"}
#   非参数错（成功 / 运行时错 / 被拒）→ 该工具计数与原因清零
#   （与 代理.light 同语义：**连续**才熔断，成功一次即清零）
段落 具记熔断(熔断器, 工具名, 结果):
  设 不熔断 为 {"熔断": 假, "次数": 0, "门限": 熔断默认门限, "摘要": "", "消息": ""}
  如果 是字典(熔断器) == 假:
    返回 不熔断
  设 计表 为 字典获取(熔断器, "计数", 空)
  如果 是字典(计表) == 假:
    设 计表 为 {}
    字典设置(熔断器, "计数", 计表)
  设 原因表 为 字典获取(熔断器, "原因", 空)
  如果 是字典(原因表) == 假:
    设 原因表 为 {}
    字典设置(熔断器, "原因", 原因表)
  设 门限 为 具熔断门限(熔断器)
  如果 具是参数错(结果) == 假:
    字典设置(计表, 工具名, 0)
    字典设置(原因表, 工具名, [])
    返回 {"熔断": 假, "次数": 0, "门限": 门限, "摘要": "", "消息": ""}
  设 摘要 为 具失败摘要(结果)
  设 记表 为 字典获取(原因表, 工具名, 空)
  如果 是列表(记表) == 假:
    设 记表 为 []
  设 上限 为 字典获取(熔断器, "摘要上限", 熔断摘要上限)
  如果 是整数(上限) == 假:
    设 上限 为 熔断摘要上限
  如果 上限 < 1:
    设 上限 为 熔断摘要上限
  如果 长(记表) < 上限:
    列表追加(记表, 摘要)
  字典设置(原因表, 工具名, 记表)
  设 次数 为 具熔断计数(熔断器, 工具名) + 1
  字典设置(计表, 工具名, 次数)
  设 熔断 为 假
  如果 门限 > 0 且 次数 >= 门限:
    设 熔断 为 真
  设 消息 为 ""
  如果 熔断 == 真:
    设 消息 为 具造熔断消息(工具名, 次数, 记表, 门限)
  返回 {"熔断": 熔断, "次数": 次数, "门限": 门限, "摘要": 摘要, "消息": 消息}

段落 具重置熔断(熔断器, 工具名):
  如果 是字典(熔断器) == 假:
    返回 假
  设 计表 为 字典获取(熔断器, "计数", 空)
  如果 是字典(计表) == 真:
    字典设置(计表, 工具名, 0)
  设 原因表 为 字典获取(熔断器, "原因", 空)
  如果 是字典(原因表) == 真:
    字典设置(原因表, 工具名, [])
  返回 真

# 熔断器快照（副本，审计/观测用；不外泄内部可变表）
段落 具熔断快照(熔断器):
  设 快照 为 {"门限": 熔断默认门限, "显式": 假, "计数": {}, "原因": {}}
  如果 是字典(熔断器) == 假:
    返回 快照
  字典设置(快照, "门限", 具熔断门限(熔断器))
  字典设置(快照, "显式", 字典获取(熔断器, "显式", 假))
  设 计表 为 字典获取(熔断器, "计数", 空)
  如果 是字典(计表) == 真:
    遍历 键 之 字典键列表(计表):
      字典设置(快照["计数"], 键, 计表[键])
  设 原因表 为 字典获取(熔断器, "原因", 空)
  如果 是字典(原因表) == 真:
    遍历 键 之 字典键列表(原因表):
      字典设置(快照["原因"], 键, 原因表[键])
  返回 快照

# 执行器级薄包装：代理侧一行接线即可（吃 执行工具 / 具执行前置闸门 的失败结果）
段落 具记熔断结果(执行器, 工具名, 结果):
  设 熔断器 为 字典获取(执行器, "熔断器", 空)
  返回 具记熔断(熔断器, 工具名, 结果)

段落 具执行熔断快照(执行器):
  设 熔断器 为 字典获取(执行器, "熔断器", 空)
  返回 具熔断快照(熔断器)

