# 工具执行.light —— 第34轮 任务2：工具执行流水线完善
#
# 上游（只读）：G:\github\deepseek-harness\packages\tools\src\
#   registry.ts（ToolRegistry）  → §1 工具注册与权限级别
#   permission.ts（Permission）  → §2 可见性 + 调用权限检查
#   cancel.ts（CancellationToken）→ §3 取消令牌
#   audit.ts（AuditLog）         → §4 追加-only 审计日志
#   ratelimit.ts（RateLimiter）  → §5 令牌桶 / 滑动窗口限流
#   executor.ts（ToolExecutor）  → §6 执行流水线（先权限、后限流、再取消）
#
# 纯逻辑复刻：剔除真实 I/O 分派、持久化写盘（改内存环形缓冲 + 导出接口）、
#             墙钟时间（改「逻辑时钟」，由调用方推进，保证可重放）。
# 命名避坑：L-119 单字别名保留字（长/首/末/空/步/当 等勿作变量名）；
#           L-120 可被关键字序列完全切分的标识符。
# 本模块段落一律以「具」为前缀，避免与同测导入的其它模块同名段冲突
#（src 后端会把依赖模块内联进同一份 Python，同名段会 codegen 重定义）。
# 铁律：权限检查必须在执行前完成，不得绕过；审计日志追加-only。

# =====================================================================
# §0 常量
# =====================================================================

设 级公开 为 "public"
设 级内部 为 "internal"
设 级私有 为 "private"
设 级别表 为 [级公开, 级内部, 级私有]

设 调正常 为 "ok"
设 调拒绝 为 "permission_denied"
设 调限流 为 "rate_limited"
设 调取消 为 "cancelled"
设 调失败 为 "failed"

# L-164：以上**执行状态字面值请勿硬编码**。
#   成功态字面值是 "ok"，不是直觉的 "normal"——既有 examples/test_R40_端到端互举.light
#   直接断言 "ok"，为保持 wire 兼容不改值。调用方统一取 调正常 常量即可消除歧义；
#   另导出直觉别名 调成功（与 调正常 同值），给偏好 "成功" 命名的调用方使用。
设 调成功 为 调正常
设 状态字面值表 为 [调正常, 调拒绝, 调限流, 调取消, 调失败]

设 审计开始 为 "tool_call_start"
设 审计结束 为 "tool_call_end"
设 审计失败 为 "tool_call_failed"
设 审计拒绝 为 "permission_denied"
设 审计限流 为 "rate_limited"
设 审计事件表 为 [审计开始, 审计结束, 审计失败, 审计拒绝, 审计限流]

设 策略令牌桶 为 "令牌桶"
设 策略滑动窗 为 "滑动窗口"
设 限流策略表 为 [策略令牌桶, 策略滑动窗]

设 默认容量 为 128

# =====================================================================
# §1 工具注册（registry.ts）
# =====================================================================

段落 建注册表:
  返回 {"工具表": {}, "插件表": {}}

段落 具是级别 接收 值:
  返回 级别表.包含(值)

段落 具注册工具 接收 注册, 名称, 级别, 处理 = 空, 插件 = 空:
  如果 是字符串(名称) == 假 或 字符串长度(名称) == 0:
    抛出 新建 错误("工具名必须为非空串 [INVALID_TOOL_NAME]")
  如果 具是级别(级别) == 假:
    抛出 新建 错误("未知权限级别：" + 转字符串(级别) + " [UNKNOWN_LEVEL]")
  如果 字典包含键(注册["工具表"], 名称) == 真:
    抛出 新建 错误("工具重名：" + 名称 + " [DUPLICATE_TOOL]")
  设 工具 为 {"名称": 名称, "级别": 级别, "插件": 插件, "处理": 处理}
  字典设置(注册["工具表"], 名称, 工具)
  # 插件级可见：同名插件只记一次，后续工具继承该插件级别
  如果 插件 != 空:
    如果 字典包含键(注册["插件表"], 插件) == 假:
      字典设置(注册["插件表"], 插件, 级别)
  返回 工具

# 权限继承：插件提供的工具继承插件权限级别
段落 注册插件工具 接收 注册, 插件, 级别, 名称表, 处理 = 空:
  如果 具是级别(级别) == 假:
    抛出 新建 错误("未知插件权限级别：" + 转字符串(级别) + " [UNKNOWN_LEVEL]")
  如果 字典包含键(注册["插件表"], 插件) == 假:
    字典设置(注册["插件表"], 插件, 级别)
  设 已注册 为 []
  遍历 名称 之 名称表:
    已注册.追加(具注册工具(注册, 名称, 级别, 处理, 插件))
  返回 已注册

段落 插件级别 接收 注册, 插件:
  返回 字典获取(注册["插件表"], 插件, 空)

段落 具注销工具 接收 注册, 名称:
  如果 字典包含键(注册["工具表"], 名称) == 假:
    返回 假
  设 新表 为 {}
  遍历 键 之 字典键列表(注册["工具表"]):
    如果 键 != 名称:
      字典设置(新表, 键, 注册["工具表"][键])
  字典设置(注册, "工具表", 新表)
  返回 真

段落 取工具 接收 注册, 名称:
  返回 字典获取(注册["工具表"], 名称, 空)

段落 工具名表 接收 注册:
  返回 字典键列表(注册["工具表"])

段落 列出工具 接收 注册, 调用者级别 = 空:
  设 结果 为 []
  遍历 名称 之 工具名表(注册):
    设 工具 为 注册["工具表"][名称]
    如果 调用者级别 == 空:
      结果.追加(名称)
    否则:
      如果 具可否见(工具["级别"], 调用者级别) == 真:
        结果.追加(名称)
  返回 结果

# =====================================================================
# §2 权限控制（permission.ts）
# =====================================================================

# 可见性矩阵：工具级别 → 允许看见它的调用者级别
段落 具可见级别 接收 工具级别:
  如果 工具级别 == 级公开:
    返回 [级公开, 级内部, 级私有]
  如果 工具级别 == 级内部:
    返回 [级内部, 级私有]
  返回 [级私有]

段落 具可否见 接收 工具级别, 调用者级别:
  如果 具是级别(工具级别) == 假:
    返回 假
  如果 具是级别(调用者级别) == 假:
    返回 假
  返回 具可见级别(工具级别).包含(调用者级别)

# 同插件豁免：private 工具对「同插件调用者」可见
段落 具同插件 接收 工具, 调用者插件:
  如果 调用者插件 == 空:
    返回 假
  如果 工具["插件"] == 空:
    返回 假
  返回 工具["插件"] == 调用者插件

段落 权限判定 接收 工具, 调用者级别, 调用者插件 = 空:
  如果 工具 == 空:
    返回 {"可见": 假, "可调用": 假, "错误码": "TOOL_NOT_FOUND",
      "消息": "工具不存在"}
  如果 具可否见(工具["级别"], 调用者级别) == 真:
    返回 {"可见": 真, "可调用": 真, "错误码": 空, "消息": 空}
  如果 工具["级别"] == 级私有 且 具同插件(工具, 调用者插件) == 真:
    返回 {"可见": 真, "可调用": 真, "错误码": 空, "消息": 空}
  返回 {"可见": 假, "可调用": 假, "错误码": "PERMISSION_DENIED",
    "消息": "工具 " + 工具["名称"] + " 对级别 " + 调用者级别 + " 不可见"}

# =====================================================================
# §3 取消令牌（cancel.ts）
# =====================================================================

段落 建取消令牌 接收 信号 = 空:
  返回 {"已取消": 假, "原因": 空, "信号": 信号, "回调表": []}

段落 是否取消 接收 令牌:
  如果 令牌 == 空:
    返回 假
  如果 令牌["已取消"] == 真:
    返回 真
  如果 令牌["信号"] != 空:
    返回 令牌["信号"]["中止"] == 真
  返回 假

段落 请求取消 接收 令牌, 原因 = "user_abort":
  如果 是否取消(令牌) == 真:
    返回 假
  字典设置(令牌, "已取消", 真)
  字典设置(令牌, "原因", 原因)
  返回 真

段落 检查取消 接收 令牌:
  如果 是否取消(令牌) == 真:
    抛出 新建 错误("工具执行已取消：" + 转字符串(令牌["原因"]) +
      " [TOOL_CANCELLED]")
  返回 真

# 取消回调：资源清理钩子（注册即追加，不可删，保证清理不被绕过）
段落 注册清理 接收 令牌, 处理:
  令牌["回调表"].追加(处理)
  返回 长(令牌["回调表"])

段落 执行清理 接收 令牌:
  设 计数 为 0
  遍历 处理 之 令牌["回调表"]:
    设 钩子 为 处理
    钩子(令牌)
    设 计数 为 计数 + 1
  返回 计数

# =====================================================================
# §4 审计日志（audit.ts）—— 追加-only
# =====================================================================

段落 建审计日志 接收 容量 = 128:
  如果 容量 <= 0:
    抛出 新建 错误("审计容量必须为正 [INVALID_AUDIT_CAPACITY]")
  返回 {"事件表": [], "容量": 容量, "序号": 0}

段落 具记审计 接收 日志, 类型, 工具名, 调用者, 状态, 时刻 = 0, 参数摘要 = "", 耗时 = 0:
  如果 审计事件表.包含(类型) == 假:
    抛出 新建 错误("未知审计事件类型：" + 转字符串(类型) +
      " [UNKNOWN_AUDIT_EVENT]")
  设 序号 为 日志["序号"] + 1
  设 记录 为 {"序号": 序号, "类型": 类型, "工具名": 工具名, "调用者": 调用者,
    "参数摘要": 参数摘要, "状态": 状态, "时刻": 时刻, "耗时": 耗时}
  日志["事件表"].追加(记录)
  # 环形缓冲：超容量丢弃最旧（只丢弃、不改写已有条目）
  当 长(日志["事件表"]) > 日志["容量"]:
    字典设置(日志, "事件表", 具截尾(日志["事件表"], 1))
  字典设置(日志, "序号", 序号)
  返回 记录

# 去掉列表前 n 项（环形缓冲丢弃最旧用）
段落 具截尾 接收 表, 数量:
  设 结果 为 []
  设 位置 为 0
  遍历 项 之 表:
    如果 位置 >= 数量:
      结果.追加(项)
    设 位置 为 位置 + 1
  返回 结果

段落 审计查询 接收 日志, 工具名 = 空, 调用者 = 空, 状态 = 空, 起始时刻 = 空:
  设 结果 为 []
  遍历 记录 之 日志["事件表"]:
    如果 工具名 == 空 或 记录["工具名"] == 工具名:
      如果 调用者 == 空 或 记录["调用者"] == 调用者:
        如果 状态 == 空 或 记录["状态"] == 状态:
          如果 起始时刻 == 空 或 记录["时刻"] >= 起始时刻:
            结果.追加(记录)
  返回 结果

# 可持久化接口：导出/导入（导入为整体替换，不提供单条改写）
段落 审计导出 接收 日志:
  返回 {"容量": 日志["容量"], "序号": 日志["序号"], "事件表": 日志["事件表"]}

段落 审计导入 接收 日志, 快照:
  如果 是字典(快照) == 假:
    抛出 新建 错误("审计快照必须为字典 [INVALID_AUDIT_SNAPSHOT]")
  字典设置(日志, "事件表", 字典获取(快照, "事件表", []))
  字典设置(日志, "序号", 字典获取(快照, "序号", 0))
  字典设置(日志, "容量", 字典获取(快照, "容量", 默认容量))
  返回 真

段落 审计条数 接收 日志:
  返回 长(日志["事件表"])

# =====================================================================
# §5 速率限制（ratelimit.ts）
# =====================================================================

段落 建限流态 接收 最大请求, 窗口, 突发, 策略:
  如果 最大请求 <= 0:
    抛出 新建 错误("maxRequests 必须为正 [INVALID_RATE_CONFIG]")
  如果 窗口 <= 0:
    抛出 新建 错误("windowMs 必须为正 [INVALID_RATE_CONFIG]")
  如果 突发 < 0:
    抛出 新建 错误("burstSize 不得为负 [INVALID_RATE_CONFIG]")
  如果 限流策略表.包含(策略) == 假:
    抛出 新建 错误("未知限流策略：" + 转字符串(策略) + " [UNKNOWN_RATE_STRATEGY]")
  设 上限 为 突发
  如果 突发 == 0:
    设 上限 为 最大请求
  返回 {"最大请求": 最大请求, "窗口": 窗口, "突发": 突发, "上限": 上限,
    "令牌": 上限, "上次时刻": 0, "命中表": [], "策略": 策略}

段落 建限速器 接收 最大请求 = 10, 窗口 = 1000, 突发 = 0, 策略 = 策略滑动窗:
  返回 {"最大请求": 最大请求, "窗口": 窗口, "突发": 突发, "策略": 策略,
    "全局": 建限流态(最大请求, 窗口, 突发, 策略), "工具表": {}, "调用者表": {}}

段落 具取维度 接收 限速器, 表名, 键:
  如果 字典包含键(限速器[表名], 键) == 假:
    字典设置(限速器[表名], 键, 建限流态(限速器["最大请求"], 限速器["窗口"],
      限速器["突发"], 限速器["策略"]))
  返回 限速器[表名][键]

# 令牌桶：按时间比例补充令牌，上限为桶容量
段落 令牌桶取 接收 态, 时刻, 数量:
  设 间隔 为 时刻 - 态["上次时刻"]
  如果 间隔 > 0:
    设 补充 为 间隔 * 态["最大请求"] / 态["窗口"]
    设 余量 为 态["令牌"] + 补充
    如果 余量 > 态["上限"]:
      设 余量 为 态["上限"]
    字典设置(态, "令牌", 余量)
    字典设置(态, "上次时刻", 时刻)
  如果 态["令牌"] >= 数量:
    字典设置(态, "令牌", 态["令牌"] - 数量)
    返回 {"放行": 真, "剩余": 态["令牌"], "重试毫秒": 0}
  设 缺口 为 数量 - 态["令牌"]
  设 需补 为 缺口 * 态["窗口"] / 态["最大请求"]
  返回 {"放行": 假, "剩余": 态["令牌"], "重试毫秒": 需补 + 1}

# 滑动窗口：只保留窗口内的命中时刻
段落 滑动窗取 接收 态, 时刻, 数量:
  设 保留 为 []
  遍历 旧时刻 之 态["命中表"]:
    如果 时刻 - 旧时刻 < 态["窗口"]:
      保留.追加(旧时刻)
  字典设置(态, "命中表", 保留)
  如果 长(保留) + 数量 <= 态["最大请求"]:
    设 位置 为 0
    当 位置 < 数量:
      态["命中表"].追加(时刻)
      设 位置 为 位置 + 1
    返回 {"放行": 真, "剩余": 态["最大请求"] - 长(态["命中表"]), "重试毫秒": 0}
  如果 长(保留) == 0:
    返回 {"放行": 假, "剩余": 0, "重试毫秒": 态["窗口"] + 1}
  设 最早 为 保留[0]
  返回 {"放行": 假, "剩余": 0, "重试毫秒": 态["窗口"] - (时刻 - 最早) + 1}

段落 具取一次 接收 态, 时刻, 数量:
  如果 态["策略"] == 策略令牌桶:
    返回 令牌桶取(态, 时刻, 数量)
  返回 滑动窗取(态, 时刻, 数量)

# 三维度限流：全局 / 每工具 / 每调用者，任一维度超限即拒绝
段落 限流检查 接收 限速器, 时刻, 工具名 = 空, 调用者 = 空, 数量 = 1:
  设 全局结果 为 具取一次(限速器["全局"], 时刻, 数量)
  如果 全局结果["放行"] == 假:
    返回 {"放行": 假, "维度": "全局", "错误码": "RATE_LIMITED",
      "重试毫秒": 全局结果["重试毫秒"]}
  如果 工具名 != 空:
    设 工具态 为 具取维度(限速器, "工具表", 工具名)
    设 工具结果 为 具取一次(工具态, 时刻, 数量)
    如果 工具结果["放行"] == 假:
      返回 {"放行": 假, "维度": "工具", "错误码": "RATE_LIMITED",
        "重试毫秒": 工具结果["重试毫秒"]}
  如果 调用者 != 空:
    设 调用者态 为 具取维度(限速器, "调用者表", 调用者)
    设 调用者结果 为 具取一次(调用者态, 时刻, 数量)
    如果 调用者结果["放行"] == 假:
      返回 {"放行": 假, "维度": "调用者", "错误码": "RATE_LIMITED",
        "重试毫秒": 调用者结果["重试毫秒"]}
  返回 {"放行": 真, "维度": 空, "错误码": 空, "重试毫秒": 0}

# =====================================================================
# §6 执行流水线（executor.ts）
# =====================================================================

段落 建执行器 接收 最大请求 = 10, 窗口 = 1000, 突发 = 0, 策略 = 策略滑动窗:
  返回 {"注册": 建注册表(), "审计": 建审计日志(默认容量),
    "限速": 建限速器(最大请求, 窗口, 突发, 策略), "令牌": 建取消令牌(),
    "时刻": 0}

段落 推时钟 接收 执行器, 毫秒:
  如果 毫秒 < 0:
    抛出 新建 错误("时钟不可倒退 [INVALID_CLOCK_STEP]")
  字典设置(执行器, "时刻", 执行器["时刻"] + 毫秒)
  返回 执行器["时刻"]

段落 具摘要 接收 参数, 上限 = 64:
  设 串 为 序列化JSON(参数)
  如果 字符串长度(串) <= 上限:
    返回 串
  返回 截取(串, 0, 上限)

# 执行顺序（铁律）：权限 → 限流 → 取消 → 执行 → 审计
段落 执行工具 接收 执行器, 工具名, 调用者级别, 调用者 = "匿名", 参数 = 空, 调用者插件 = 空:
  设 时刻 为 执行器["时刻"]
  设 工具 为 取工具(执行器["注册"], 工具名)
  设 判定 为 权限判定(工具, 调用者级别, 调用者插件)
  如果 判定["可调用"] == 假:
    具记审计(执行器["审计"], 审计拒绝, 工具名, 调用者, 调拒绝, 时刻,
      具摘要(参数), 0)
    返回 {"状态": 调拒绝, "结果": 空, "错误码": 判定["错误码"],
      "消息": 判定["消息"]}
  设 限流 为 限流检查(执行器["限速"], 时刻, 工具名, 调用者, 1)
  如果 限流["放行"] == 假:
    具记审计(执行器["审计"], 审计限流, 工具名, 调用者, 调限流, 时刻,
      具摘要(参数), 0)
    返回 {"状态": 调限流, "结果": 空, "错误码": 限流["错误码"],
      "消息": "触发" + 限流["维度"] + "维度限流，建议 " +
        转字符串(限流["重试毫秒"]) + "ms 后重试",
      "重试毫秒": 限流["重试毫秒"]}
  如果 是否取消(执行器["令牌"]) == 真:
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 调取消, 时刻,
      具摘要(参数), 0)
    返回 {"状态": 调取消, "结果": 空, "错误码": "TOOL_CANCELLED",
      "消息": "执行前检测到取消"}
  具记审计(执行器["审计"], 审计开始, 工具名, 调用者, "start", 时刻,
    具摘要(参数), 0)
  设 结果 为 空
  尝试:
    如果 工具["处理"] == 空:
      抛出 新建 错误("工具无处理函数 [NO_HANDLER]")
    设 处理 为 工具["处理"]
    # 取消令牌注入上下文：工具可自行查询
    设 结果 为 处理(参数, 执行器["令牌"])
    检查取消(执行器["令牌"])
    具记审计(执行器["审计"], 审计结束, 工具名, 调用者, 调正常, 时刻, "", 0)
    返回 {"状态": 调正常, "结果": 结果, "错误码": 空, "消息": 空}
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
    设 态 为 调失败
    如果 字符串包含(消息, "TOOL_CANCELLED") == 真:
      设 态 为 调取消
      执行清理(执行器["令牌"])
    具记审计(执行器["审计"], 审计失败, 工具名, 调用者, 态, 时刻, "", 0)
    返回 {"状态": 态, "结果": 空, "错误码": 态, "消息": 消息}

