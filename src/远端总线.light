# 远端总线.light —— 远端 API 总线纯逻辑（对齐原版 api/remotes + api/gateway）
#
# 纯逻辑复刻：剔除真实 HTTP/WebSocket/网络 IO、连接 RPC、Cordis 总线；
# IO 抽象成入参（上下文对象/持久层/连接器/令牌 均为可注入字典或函数），保留可断言行为。
#
# 对标源码：
#   packages/api/remotes/src/remote-events.ts L1-29 —— 转发通知白名单
#   packages/api/remotes/src/agent-lookup.ts L62-210 —— 子代理归属/会话校验/代理解析器
#   packages/api/gateway/src/index.ts L586-679 —— 参数形状校验/JSON边界/strict codec解码/失败信封
#   packages/api/gateway/src/client/index.ts L356-414,566-588 —— 参数计数/mount token/上下文注入/结果解析/失败信封
#
# 命名规范 v1：成员名避开关键字/运算符词根；成员赋值一律「设 己.X 为 ...」。
# 语法约束：L-036 取可选守卫；L-037 断言用断言相等或如果/抛出；L-038 不用截取到末尾；
#           L-039 退出循环写跳出；L-040 函数参数用接收非括号；L-041 字典/映射不作变量名；
#           L-043 布尔链+行内否则返回改顺序如果。
# 新坑登记：L-050 捕获异常的变量名必须用单字母 ASCII（如 e），中文名（如 错误对象）
#           导致解析器报「无法识别的语法元素：':'」。对齐既有代码全部用 捕获 异常 e:。
#           另注：长度() 仅适用于字符串，列表用 列表长度()；字典迭代键用 字典键列表()，
#           不可用 .keys() 方法调用。

# ============================================================
# 辅助函数
# ============================================================

# 判定元素是否在列表中（避开「包含」词根）
段落 列表含 接收 项表, 元素:
  遍历 项 之 项表:
    如果 项 == 元素:
      返回 真
  返回 假

# 把列表拼接成逗号分隔的字符串
段落 拼接项表 接收 项表:
  如果 列表长度(项表) == 0:
    返回 ""
  设 结果 为 转字符串(项表[0])
  设 索引 为 1
  当 索引 < 列表长度(项表):
    设 结果 为 结果 + ", " + 转字符串(项表[索引])
    设 索引 为 索引 + 1
  返回 结果

# ============================================================
# 一、转发通知白名单（对齐 remote-events.ts L1-29）
# ============================================================

# 精确复刻原版 11 项转发通知白名单
段落 整理直达清单:
  返回 ["agent-preset/selected", "commands/change", "credentials/updated", "cordis/request-run", "cordis/request-run-resolved", "cordis/dynamic-package", "cordis/dynamic-retract", "cordis/inspect-query", "cordis/inspect-query-resolved", "llm/adapters-updated", "settings/document-updated"]

# 判定通知名是否在转发白名单中
段落 判定可转发 接收 通知名:
  设 清单 为 整理直达清单()
  返回 列表含(清单, 通知名)

# ============================================================
# 二、子代理归属判定（对齐 agent-lookup.ts L62-85）
# ============================================================

# 对齐 hasApiRemoteSubagentOwner：判定会话是否被子代理路由占有
# 上下文: {"代理表": {id->代理}, "判定归属": fn(代理标识, 父代理)->布尔}
# 会话头: {"来源": str, "父会话": str|空}
# 代理对象: {"标识": str, "会话": {"头": 会话头}} | 空
段落 判定子代理归属 接收 上下文, 会话头, 代理对象:
  # origin === 'subagent' -> true
  如果 取可选(会话头, "来源") == "subagent":
    返回 真
  # parentSession === undefined || agent === undefined -> false
  设 父标识 为 取可选(会话头, "父会话")
  如果 父标识 == 空:
    返回 假
  如果 代理对象 == 空:
    返回 假
  # parent = ctx.agents.get(parentId)
  设 代理表 为 取可选(上下文, "代理表")
  如果 代理表 == 空:
    返回 假
  设 父代理 为 取可选(代理表, 父标识)
  如果 父代理 == 空:
    返回 假
  # parent !== undefined && ctx.agents.isOwnedBy(agent.id, parent)
  设 判定归属函数 为 取可选(上下文, "判定归属")
  如果 判定归属函数 == 空:
    返回 假
  返回 判定归属函数(代理对象["标识"], 父代理)

# 对齐 apiRemoteSubagentOwnershipError：构造 agent-busy 错误信封
段落 构造归属拒绝 接收 会话标识:
  返回 ["代码": "agent-busy", "消息": "会话 " + 会话标识 + " 被子代理路由占有", "细节": ["理由": "对此子会话请使用子代理投递"]]

# ============================================================
# 三、会话元数据校验（对齐 agent-lookup.ts L94-110）
# ============================================================

# 对齐 inspectApiRemoteSession：审视会话元数据
# 缺持久久层 / 找不到会话 / 缺工作目录 -> 抛出 "会话未找到"
# 成功 -> 返回 {"头": meta, "条目": [events]}
段落 审视远端会话 接收 上下文, 会话标识:
  设 持久层 为 取可选(上下文, "持久层")
  如果 持久层 == 空:
    抛出 "无持久层"
  # persistence.list() find by id
  设 头列表 为 持久层["列表"]
  设 候选 为 空
  遍历 头 之 头列表:
    如果 头["标识"] == 会话标识:
      设 候选 为 头
  如果 候选 == 空:
    抛出 "会话未找到:" + 会话标识
  # meta === undefined || meta.cwd === undefined -> throw session not found
  如果 取可选(候选, "工作目录") == 空:
    抛出 "会话未找到:" + 会话标识
  # persistence.inspect(sessionId)
  设 审视结果 为 持久层["审视"](会话标识)
  如果 取可选(审视结果["头"], "工作目录") == 空:
    抛出 "会话未找到:" + 会话标识
  返回 ["头": 审视结果["头"], "条目": 审视结果["条目"]]

# ============================================================
# 四、代理解析器（对齐 agent-lookup.ts L121-210）
# ============================================================

# 对齐 createApiRemoteAgentResolver：纯逻辑代理解析器
# 缓存、归属围栏、子代理识别、冷启动 inspect+setup+publish+resume
# catch 三分支：session-not-found / agent-busy / internal
类 代理解析器:
  属性 上下文 等于 空
  属性 选项 等于 空
  属性 缓存表 等于 空

  段落 构造 接收 上下文, 选项:
    设 己.上下文 为 上下文
    设 己.选项 为 选项
    设 己.缓存表 为 {}

  # 对齐 fencedLiveAgent：查活跃代理并判归属围栏
  # 返回 {"代理": 代理} | {"失败": 错误信封} | 空
  段落 判定活跃归属 接收 会话标识:
    设 代理表 为 取可选(己.上下文, "代理表")
    如果 代理表 == 空:
      返回 空
    设 活跃代理 为 取可选(代理表, 会话标识)
    如果 活跃代理 == 空:
      返回 空
    # 判定子代理归属
    设 代理会话 为 取可选(活跃代理, "会话")
    如果 代理会话 != 空:
      设 归属为真 为 判定子代理归属(己.上下文, 代理会话["头"], 活跃代理)
      如果 归属为真:
        返回 ["失败": 构造归属拒绝(会话标识)]
    返回 ["代理": 活跃代理]

  # 对齐 agentFor：主解析流程
  段落 解析代理 接收 会话标识:
    # Step 1: 判定活跃归属
    设 活跃结果 为 己.判定活跃归属(会话标识)
    如果 活跃结果 != 空:
      返回 活跃结果
    # Step 2: 检查已附加会话的归属
    设 会话表 为 取可选(己.上下文, "会话表")
    如果 会话表 != 空:
      设 已附加 为 取可选(会话表, 会话标识)
      如果 已附加 != 空:
        设 附加归属 为 判定子代理归属(己.上下文, 已附加["头"], 空)
        如果 附加归属:
          返回 ["失败": 构造归属拒绝(会话标识)]
    # Step 3: 检查缓存
    设 已缓存 为 取可选(己.缓存表, 会话标识)
    如果 已缓存 != 空:
      返回 已缓存
    # Step 4: 执行恢复（冷启动）
    返回 己.执行恢复(会话标识)

  # 冷启动恢复逻辑：inspect + setup + re-check + resume
  段落 执行恢复 接收 会话标识:
    尝试:
      # inspect session
      设 审视结果 为 审视远端会话(己.上下文, 会话标识)
      # check subagent ownership of inspected session
      设 视察归属 为 判定子代理归属(己.上下文, 审视结果["头"], 空)
      如果 视察归属:
        抛出 "子代理归属:" + 会话标识
      # call setup if available
      设 安装函数 为 取可选(己.选项, "安装")
      如果 安装函数 != 空:
        安装函数(审视结果)
      # re-check published session/agent for subagent ownership
      设 会话表 为 取可选(己.上下文, "会话表")
      设 已发布会话 为 空
      如果 会话表 != 空:
        设 已发布会话 为 取可选(会话表, 会话标识)
      设 代理表 为 取可选(己.上下文, "代理表")
      设 已发布代理 为 空
      如果 代理表 != 空:
        设 已发布代理 为 取可选(代理表, 会话标识)
      如果 已发布会话 != 空:
        设 发布归属 为 判定子代理归属(己.上下文, 已发布会话["头"], 已发布代理)
        如果 发布归属:
          抛出 "子代理归属:" + 会话标识
      # resume
      设 恢复函数 为 取可选(己.上下文, "恢复代理")
      如果 恢复函数 == 空:
        抛出 "无恢复函数"
      设 代理对象 为 恢复函数(会话标识, 己.选项)
      返回 ["代理": 代理对象]
    捕获 异常 e:
      设 错误文本 为 转字符串(e)
      # session-not-found branch
      如果 开头(错误文本, "会话未找到"):
        返回 ["失败": ["代码": "session-not-found", "消息": "会话 " + 会话标识 + " 未找到", "细节": ["会话标识": 会话标识]]]
      # agent-busy branch
      如果 开头(错误文本, "子代理归属"):
        返回 ["失败": 构造归属拒绝(会话标识)]
      # fallback: re-check fencedLiveAgent and attached session
      设 活跃结果 为 己.判定活跃归属(会话标识)
      如果 活跃结果 != 空:
        返回 活跃结果
      设 会话表 为 取可选(己.上下文, "会话表")
      如果 会话表 != 空:
        设 已附加 为 取可选(会话表, 会话标识)
        如果 已附加 != 空:
          设 附加归属 为 判定子代理归属(己.上下文, 已附加["头"], 空)
          如果 附加归属:
            返回 ["失败": 构造归属拒绝(会话标识)]
      # internal error
      返回 ["失败": ["代码": "internal", "消息": "恢复失败 会话 " + 会话标识 + ": " + 错误文本, "细节": {}]]

# ============================================================
# 五、网关参数校验（对齐 gateway/src/index.ts L586-679）
# ============================================================

# 对齐 endpointOf：构造端点字符串
段落 构造端点 接收 描述符:
  返回 描述符["命名空间"] + "/" + 描述符["方法"]

# 对齐 isPlainObject：判定纯对象（字典）
段落 判定纯对象 接收 值:
  返回 是字典(值)

# 对齐 isObject：判定是否为对象
段落 判定对象 接收 值:
  返回 是字典(值) 或 是列表(值)

# 对齐 assertJsonValue：递归校验 JSON 安全性
# 空字串布尔整数 -> 通过；浮点 -> 有限性校验；列表 -> 逐元素递归；字典 -> 逐值递归；其他 -> 抛出
# 已访表用于循环引用检测（用 id() 追踪对象身份）
段落 校验JSON安全 接收 值, 已访表:
  如果 是空(值):
    返回
  如果 isinstance(值, bool):
    返回
  如果 是字符串(值):
    返回
  如果 是整数(值):
    返回
  如果 是浮点(值):
    # NaN: 值 != 值; Infinity: 值 * 0 != 0
    如果 值 != 值:
      抛出 "非有限数值"
    如果 值 * 0 != 0:
      抛出 "非有限数值"
    返回
  如果 是列表(值):
    如果 列表含(已访表, id(值)):
      抛出 "循环引用"
    列表追加(已访表, id(值))
    遍历 元素 之 值:
      校验JSON安全(元素, 已访表)
    已访表.pop()
    返回
  如果 是字典(值):
    如果 列表含(已访表, id(值)):
      抛出 "循环引用"
    列表追加(已访表, id(值))
    遍历 键 之 字典键列表(值):
      校验JSON安全(值[键], 已访表)
    已访表.pop()
    返回
  抛出 "非JSON安全类型"

# 对齐 assertExactArguments：参数形状校验
# 描述符: {"参数列表": [{"线名": str, "来源": str, "允许空": bool, "编解码": {...}}], "调用": {"种类": str, "线名": str}}
# 非纯对象 -> 抛出；额外键/缺失键 -> 抛出带子句
段落 校验精确参数 接收 参数对象, 描述符, 端点:
  如果 判定纯对象(参数对象) == 假:
    抛出 "参数非纯对象: " + 端点
  # build expected key list
  设 期望键 为 []
  遍历 参数项 之 描述符["参数列表"]:
    列表追加(期望键, 参数项["线名"])
  设 调用信息 为 取可选(描述符, "调用")
  如果 调用信息 != 空:
    如果 取可选(调用信息, "种类") == "context":
      列表追加(期望键, 调用信息["线名"])
  # build acceptsMissing list
  设 可缺省 为 []
  遍历 参数项 之 描述符["参数列表"]:
    如果 取可选(参数项, "来源") == "json":
      设 可省 为 假
      如果 取可选(参数项, "允许空") == 真:
        设 可省 为 真
      设 参数编解码 为 取可选(参数项, "编解码")
      如果 参数编解码 != 空:
        如果 取可选(参数编解码, "来源") == "src-json":
          设 可省 为 真
      如果 可省:
        列表追加(可缺省, 参数项["线名"])
  # find extra keys
  设 额外键 为 []
  遍历 键 之 字典键列表(参数对象):
    如果 列表含(期望键, 键) == 假:
      列表追加(额外键, 键)
  # find missing keys
  设 缺失键 为 []
  遍历 键 之 期望键:
    如果 取可选(参数对象, 键) == 空:
      如果 列表含(可缺省, 键) == 假:
        列表追加(缺失键, 键)
  # no errors -> return
  如果 列表长度(额外键) == 0:
    如果 列表长度(缺失键) == 0:
      返回
  # build error message with clauses
  设 消息 为 "参数不匹配: " + 端点
  如果 列表长度(缺失键) > 0:
    设 消息 为 消息 + " 缺失: " + 拼接项表(缺失键)
  如果 列表长度(额外键) > 0:
    设 消息 为 消息 + " 意外: " + 拼接项表(额外键)
  抛出 消息

# 对齐 decode：strict codec 解码 + JSON 边界校验
# 编解码器: {"严格": bool, "校验函数": fn(值)->值}
# strict -> parse + JSON安全；非strict -> 仅JSON安全
段落 解码值 接收 编解码器, 值, 代码, 端点, 字段:
  尝试:
    设 解码结果 为 值
    如果 取可选(编解码器, "严格") == 真:
      设 校验函数 为 取可选(编解码器, "校验函数")
      如果 校验函数 != 空:
        设 解码结果 为 校验函数(值)
      如果 解码结果 == 空:
        返回 解码结果
    校验JSON安全(解码结果, [])
    返回 解码结果
  捕获:
    抛出 "网关解码失败: " + 代码 + " " + 端点 + " " + 字段

# ============================================================
# 六、客户端调用逻辑（对齐 gateway/src/client/index.ts L356-414,566-588）
# ============================================================

# 对齐 requireStrictDescriptor/requireStrictCodec：非strict抛出
段落 校验严格编解码 接收 编解码器, 端点, 字段:
  如果 取可选(编解码器, "严格") != 真:
    抛出 "编解码非严格: " + 端点 + " " + 字段

# 对齐 parse：strict codec 解析
# 非strict -> 抛出；strict -> 校验函数(值)；失败 -> 抛出
段落 解析编解码 接收 编解码器, 值, 端点, 字段:
  如果 取可选(编解码器, "严格") != 真:
    抛出 "编解码非严格: " + 端点 + " " + 字段
  设 校验函数 为 取可选(编解码器, "校验函数")
  如果 校验函数 == 空:
    返回 值
  设 解析结果 为 空
  设 解析失败 为 假
  尝试:
    设 解析结果 为 校验函数(值)
  捕获:
    设 解析失败 为 真
  如果 解析失败:
    抛出 "编解码拒绝: " + 端点 + " " + 字段
  返回 解析结果

# 对齐 withdrawn：构造已撤回失败信封
段落 构造已撤回 接收 端点:
  返回 构造内部失败("客户端: 远端方法 " + 端点 + " 已卸载")

# 对齐 carrierFailure：构造运载失败信封
段落 构造运载失败 接收 端点, 错误:
  返回 构造内部失败("客户端: " + 端点 + " 失败: " + 转字符串(错误))

# 对齐 internalFailure：构造内部失败信封
段落 构造内部失败 接收 消息:
  返回 ["成功": 假, "失败": ["代码": "internal", "消息": 消息, "细节": {}]]

# 对齐 invoke：客户端远端调用纯逻辑
# 描述符: {"命名空间": str, "方法": str, "参数列表": [...], "结果编解码": {...}, "可取消": ...}
# 投影: {"线名": str, "编解码": {...}, "参数索引": int} | 空
# 令牌: {"活跃": bool}
# 值列表: [值, ...]
# 连接器: fn(端点, 参数对象)->{"好": bool, "值": ...} | {"好": bool, "失败": {...}}
# 标识值: 上下文身份值 | 空
段落 调用远端 接收 描述符, 投影, 令牌, 值列表, 连接器, 标识值:
  设 端点 为 构造端点(描述符)
  # 1. mount token check
  如果 取可选(令牌, "活跃") != 真:
    返回 构造已撤回(端点)
  # 2. calculate expected count
  设 参数列表 为 描述符["参数列表"]
  设 期望数 为 列表长度(参数列表)
  设 投影索引 为 空
  如果 投影 != 空:
    设 投影索引 为 取可选(投影, "参数索引")
  如果 投影索引 != 空:
    设 期望数 为 期望数 - 1
  # 3. check actual count (with optional cancellation signal)
  设 有取消信号 为 假
  如果 取可选(描述符, "可取消") != 空:
    如果 列表长度(值列表) == 期望数 + 1:
      设 有取消信号 为 真
  如果 列表长度(值列表) != 期望数:
    如果 有取消信号 == 假:
      抛出 "参数计数不匹配: " + 端点 + " 期望 " + 转字符串(期望数) + " 实际 " + 转字符串(列表长度(值列表))
  # 4. context injection (projection)
  设 参数对象 为 {}
  如果 投影 != 空:
    如果 标识值 == 空:
      抛出 "缺少上下文: " + 端点
    设 参数对象[投影["线名"]] 为 解析编解码(投影["编解码"], 标识值, 端点, 投影["线名"])
  # 5. parse parameters and build args
  设 参数索引 为 0
  设 值索引 为 0
  遍历 参数项 之 参数列表:
    设 跳过此参数 为 假
    如果 投影 != 空:
      设 投影索引值 为 取可选(投影, "参数索引")
      如果 投影索引值 == 参数索引:
        设 跳过此参数 为 真
    如果 跳过此参数 == 假:
      设 解析值 为 解析编解码(参数项["编解码"], 值列表[值索引], 端点, 参数项["线名"])
      如果 解析值 != 空:
        设 参数对象[参数项["线名"]] 为 解析值
      设 值索引 为 值索引 + 1
    设 参数索引 为 参数索引 + 1
  # 6. check connection
  如果 连接器 == 空:
    抛出 "无连接: " + 端点
  # 7. call RPC (injected)
  设 调用结果 为 空
  设 调用失败 为 假
  设 调用错误 为 空
  尝试:
    设 调用结果 为 连接器(端点, 参数对象)
  捕获 异常 e:
    设 调用失败 为 真
    设 调用错误 为 e
  如果 调用失败:
    返回 构造运载失败(端点, 调用错误)
  # 8. mount token still active?
  如果 取可选(令牌, "活跃") != 真:
    返回 构造已撤回(端点)
  # 9. check result
  如果 调用结果["好"] == 假:
    返回 ["成功": 假, "失败": 调用结果["失败"]]
  # 10. parse result and return
  设 结果值 为 解析编解码(描述符["结果编解码"], 调用结果["值"], 端点, "结果")
  返回 ["成功": 真, "值": 结果值]
