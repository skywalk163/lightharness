# 存储核心.light —— 对标上游 packages/storage/storage + storage-json/src/（a305303422）
# 对标 #99（L-123~L-124 预分配空缺；差异 R15-D2）。
#
# 上游结构映射：
#   storage/error.ts      -> 存储错误文本（7 码：backend-not-found/form-not-mounted/duplicate-backend/
#                            duplicate-mount/version-mismatch/malformed-medium/closed；码以文本承载，登记）
#   storage/backend.ts    -> 断言单元名（UNIT_NAME_RE ^[a-z][a-z0-9_]*$）/ 断言记录键（SAFE_KEY_RE）
#                            / 造单元描述符（version/tables/hasGlobal/layout single|per-record/compatibleVersions）
#   storage/registry.ts   -> 造后端注册表 / 注册后端（重名+disposer 语义）/ 取后端（缺失含已注册列表，空表 none）
#                            / 列出后端名 / 移除后端（仅当当前映射匹配）
#   storage-json/format.ts -> 序列化单元文档 / 解析单元文档（六步校验链逐字文案）/
#                            序列化记录文档 / 解析记录文档（畸形或过期戳读作缺席 -> 空）
#   storage-json/per-record-unit.ts -> 造单记录单元 / 载入全部（含 legacy 兄弟文件引导）/
#                            写入记录 / 删除记录（幂等）/ 备份记录（.bak.时间戳）/ 设置全局 /
#                            断言打开（closed）/ 表声明与全局槽声明校验
#   storage-json/single-unit.ts -> 造单文件单元（打开即严格解析）/ 内存态权威 + 发布 /
#                            写入/删除/设置全局（失败回滚结构保留，纯逻辑发布不失败，登记）
#
# 宿主面剔除：node:fs 读写/原子重命名/mkdir 0o700/Dirent 遍历——介质以「字典<相对路径, 文档文本>」
#   模拟文件系统；writeAtomic（atomic.ts）契约=单文档原子替换（介质赋值天然满足）。
# 绕法：内置裸名（L-090）、无 且/或 行内链（L-043）、标识符避关键字与单字别名切分（L-119/L-120/L-084）、
#   无花括号文案（L-089）、可选键先 字典包含键（L-103）。

导出 存储错误文本 断言单元名 断言记录键 造后端注册表 注册后端 取后端 列出后端名 移除后端 造单元描述符 序列化单元文档 解析单元文档 序列化记录文档 解析记录文档 造单记录单元 载入全部 写入记录 删除记录 备份记录 设置全局 断言打开 关闭单元 造单文件单元 发布单元文档 单文件写入记录 单文件删除记录 单文件设置全局 单文件载入全部 打开单元 关闭后端。

# ---------------- storage/error.ts ----------------
# StorageError：码以文本前缀承载（结构化 code 未复刻，登记 R15-D2）
段落 存储错误文本 接收 码, 消息:
  返回 "StorageError[" + 码 + "] " + 消息

# ---------------- storage/backend.ts：名称规则 ----------------
# UNIT_NAME_RE ^[a-z][a-z0-9_]*$：首字符小写字母，其余小写字母/数字/下划线
段落 断言单元名 接收 名:
  设 长 为 字符串长度(名)
  如果 长 < 1:
    抛出 新建 错误("unit name must match [a-z][a-z0-9_]*")
  设 首码 为 码位(字符串获取(名, 0))
  如果 首码 < 97:
    抛出 新建 错误("unit name must match [a-z][a-z0-9_]*")
  如果 首码 > 122:
    抛出 新建 错误("unit name must match [a-z][a-z0-9_]*")
  设 序号 为 1
  当 序号 < 长:
    设 码 为 码位(字符串获取(名, 序号))
    设 合法 为 假
    如果 码 >= 97:
      如果 码 <= 122:
        设 合法 为 真
    如果 码 >= 48:
      如果 码 <= 57:
        设 合法 为 真
    如果 码 == 95:
      设 合法 为 真
    如果 合法 == 假:
      抛出 新建 错误("unit name must match [a-z][a-z0-9_]*")
    设 序号 为 序号 + 1
  返回 名

# SAFE_KEY_RE ^[a-zA-Z0-9_-]+$（per-record 布局键），文案逐字
段落 断言记录键 接收 单元名, 键:
  设 长 为 字符串长度(键)
  设 合法 为 假
  如果 长 >= 1:
    设 合法 为 真
    设 序号 为 0
    当 序号 < 长:
      设 码 为 码位(字符串获取(键, 序号))
      设 单字合法 为 假
      如果 码 >= 97:
        如果 码 <= 122:
          设 单字合法 为 真
      如果 码 >= 65:
        如果 码 <= 90:
          设 单字合法 为 真
      如果 码 >= 48:
        如果 码 <= 57:
          设 单字合法 为 真
      如果 码 == 95:
        设 单字合法 为 真
      如果 码 == 45:
        设 单字合法 为 真
      如果 单字合法 == 假:
        设 合法 为 假
      设 序号 为 序号 + 1
  如果 合法 == 假:
    抛出 新建 错误("unit '" + 单元名 + "': per-record key '" + 键 + "' is not path-safe (must match ^[a-zA-Z0-9_-]+$)")
  返回 键

# ---------------- storage/registry.ts ----------------
段落 造后端注册表:
  返回 ["表": {}]

# register：重名抛逐字文案；返回注销闭包（仅当当前映射仍为本后端才移除）
段落 注册后端 接收 注册表, 名, 后端:
  设 表 为 注册表["表"]
  如果 字典包含键(表, 名):
    抛出 新建 错误(存储错误文本("duplicate-backend", "storage backend '" + 名 + "' is already registered"))
  设 表[名] 为 后端
  段落 注销:
    设 现表 为 注册表["表"]
    如果 字典包含键(现表, 名):
      如果 字典获取(现表, 名, 空) == 后端:
        字典删除(现表, 名)
  返回 注销

# get：缺失抛逐字文案（已注册列表 join ", "；空表字面 none）
段落 取后端 接收 注册表, 名:
  设 表 为 注册表["表"]
  如果 字典包含键(表, 名):
    返回 字典获取(表, 名, 空)
  设 名单 为 列出后端名(注册表)
  设 名单文本 为 连接字符串(名单, ", ")
  如果 列表长度(名单) == 0:
    设 名单文本 为 "none"
  抛出 新建 错误(存储错误文本("backend-not-found", "storage backend '" + 名 + "' is not registered (registered: " + 名单文本 + ")"))

# names：注册名快照
段落 列出后端名 接收 注册表:
  设 名单 为 []
  遍历 名字 之 字典键列表(注册表["表"]):
    列表追加(名单, 名字)
  返回 名单

# disposer 语义独立验证：仅当前映射匹配才移除
段落 移除后端 接收 注册表, 名, 后端:
  设 表 为 注册表["表"]
  如果 字典包含键(表, 名):
    如果 字典获取(表, 名, 空) == 后端:
      字典删除(表, 名)
  返回 注册表

# ---------------- storage/backend.ts：描述符 ----------------
# layout 缺省 single；compatibleVersions 缺省空表
段落 造单元描述符 接收 名, 版本, 表列表, 有全局, 布局, 兼容版本表:
  断言单元名(名)
  设 描述符 为 {}
  描述符["name"] 为 名
  描述符["version"] 为 版本
  描述符["tables"] 为 表列表
  描述符["hasGlobal"] 为 有全局
  如果 布局 == 空:
    设 布局 为 "single"
  描述符["layout"] 为 布局
  如果 兼容版本表 == 空:
    设 兼容版本表 为 []
  描述符["compatibleVersions"] 为 兼容版本表
  返回 描述符

# ---------------- storage-json/format.ts：单元文档 ----------------
# serialize：{"unit":{name,version},"global":..,"tables":{表:{键:值}}} 缩进 2 + 尾换行
段落 序列化单元文档 接收 名, 状态:
  设 文档 为 {}
  设 头 为 {}
  头["name"] 为 名
  头["version"] 为 状态["版本"]
  文档["unit"] 为 头
  文档["global"] 为 字典获取(状态, "global", 空)
  设 表文 为 {}
  遍历 表名 之 字典键列表(状态["表集合"]):
    设 行文 为 {}
    遍历 键 之 字典键列表(状态["表集合"][表名]):
      设 行文[键] 为 状态["表集合"][表名][键]
    设 表文[表名] 为 行文
  文档["tables"] 为 表文
  返回 序列化JSON(文档, 2) + "\n"

# parse 六步校验链（文案逐字）：
#   ①JSON 失败 ②非对象 ③unit 头缺失或外来 ④version 不符 ⑤tables 非对象 ⑥逐声明表组装（缺表空、表值非对象拒、多余表忽略）
段落 解析单元文档 接收 文本, 描述符:
  设 名 为 描述符["name"]
  设 文档 为 空
  设 解析失败 为 假
  尝试:
    设 文档 为 解析JSON(文本)
  捕获 错误 为 e:
    设 解析失败 为 真
  如果 解析失败:
    抛出 新建 错误(存储错误文本("malformed-medium", "unit '" + 名 + "': file is not valid JSON"))
  如果 是字典(文档) == 假:
    抛出 新建 错误(存储错误文本("malformed-medium", "unit '" + 名 + "': file is not a JSON object"))
  # ③ unit 头
  设 头 为 字典获取(文档, "unit", 空)
  设 头坏 为 假
  如果 头 == 空:
    设 头坏 为 真
  如果 头 != 空:
    如果 是字典(头) == 假:
      设 头坏 为 真
  如果 头坏 == 假:
    如果 字典获取(头, "name", "") != 名:
      设 头坏 为 真
  如果 头坏 == 假:
    如果 是整数(字典获取(头, "version", 空)) == 假:
      设 头坏 为 真
  如果 头坏:
    抛出 新建 错误(存储错误文本("malformed-medium", "unit '" + 名 + "': missing or foreign unit header"))
  # ④ 版本
  设 版本 为 头["version"]
  如果 版本 != 描述符["version"]:
    抛出 新建 错误(存储错误文本("version-mismatch", "unit '" + 名 + "': stored version " + 转字符串(版本) + " != expected " + 转字符串(描述符["version"])))
  # ⑤ tables
  设 源表 为 字典获取(文档, "tables", 空)
  如果 是字典(源表) == 假:
    抛出 新建 错误(存储错误文本("malformed-medium", "unit '" + 名 + "': tables is not an object"))
  # ⑥ 逐声明表组装
  设 表集合 为 {}
  遍历 表名 之 描述符["tables"]:
    如果 字典包含键(源表, 表名) == 假:
      设 表集合[表名] 为 {}
    否则:
      设 源行 为 源表[表名]
      如果 是字典(源行) == 假:
        抛出 新建 错误(存储错误文本("malformed-medium", "unit '" + 名 + "': table '" + 表名 + "' is not an object"))
      设 行文 为 {}
      遍历 键 之 字典键列表(源行):
        设 行文[键] 为 源行[键]
      设 表集合[表名] 为 行文
  设 状态 为 {}
  状态["版本"] 为 版本
  状态["global"] 为 字典获取(文档, "global", 空)
  状态["表集合"] 为 表集合
  返回 状态

# serializeRecord：{"version": v, "record": 值} 缩进 2 + 尾换行
段落 序列化记录文档 接收 版本, 值:
  设 文档 为 {}
  文档["version"] 为 版本
  文档["record"] 为 值
  返回 序列化JSON(文档, 2) + "\n"

# parseRecord：JSON 失败/非对象/version 非数值或不在可接受表 -> 空（外来文档读作缺席）；否则返回 record
段落 解析记录文档 接收 文本, 可接受版本表:
  设 文档 为 空
  设 解析失败 为 假
  尝试:
    设 文档 为 解析JSON(文本)
  捕获 错误 为 e:
    设 解析失败 为 真
  如果 解析失败:
    返回 空
  如果 是字典(文档) == 假:
    返回 空
  设 版本 为 字典获取(文档, "version", 空)
  如果 是整数(版本) == 假:
    返回 空
  如果 列表包含(可接受版本表, 版本) == 假:
    返回 空
  返回 字典获取(文档, "record", 空)

# ---------------- storage-json/per-record-unit.ts ----------------
# 单元形状：["介质", "描述符", "根", "已关"]；介质 = 字典<相对路径, 文档文本>（模拟文件系统）
段落 造单记录单元 接收 介质, 描述符, 根:
  设 单元 为 {}
  单元["介质"] 为 介质
  单元["描述符"] 为 描述符
  单元["根"] 为 根
  单元["已关"] 为 假
  返回 单元

# assertOpen：closed 码逐字文案
段落 断言打开 接收 单元:
  如果 单元["已关"]:
    抛出 新建 错误(存储错误文本("closed", "unit '" + 单元["描述符"]["name"] + "' is closed"))
  返回 真

# 表声明校验 + 目录路径（相对路径，分隔符 /）
段落 单元表路径 接收 单元, 表:
  设 描述符 为 单元["描述符"]
  如果 列表包含(描述符["tables"], 表) == 假:
    抛出 新建 错误("unit '" + 描述符["name"] + "' does not declare table '" + 表 + "'")
  返回 单元["根"] + "/" + 描述符["name"] + "/" + 表

# 载入全部：遍历介质按单元前缀归组；global.json（hasGlobal）；表文档键安全过滤 + 版本过滤；
#   单元目录无任何新文档 -> legacy 兄弟文件引导
段落 载入全部 接收 单元:
  断言打开(单元)
  设 描述符 为 单元["描述符"]
  设 名 为 描述符["name"]
  设 前缀 为 单元["根"] + "/" + 名 + "/"
  设 单元前缀 为 前缀
  设 表集合 为 {}
  遍历 表名 之 描述符["tables"]:
    设 表集合[表名] 为 {}
  设 全局值 为 空
  设 有新文档 为 假
  设 可接受版本 为 [描述符["version"]]
  遍历 旧版 之 描述符["compatibleVersions"]:
    列表追加(可接受版本, 旧版)
  遍历 路径 之 字典键列表(单元["介质"]):
    如果 开头(路径, 单元前缀):
      设 相对 为 截取到末尾(路径, 字符串长度(单元前缀))
      如果 相对 == "global.json":
        如果 描述符["hasGlobal"]:
          设 值 为 解析记录文档(单元["介质"][路径], 可接受版本)
          如果 值 != 空:
            设 全局值 为 值
          设 有新文档 为 真
      否则:
        # <表>/<键>.json
        设 斜位 为 查找子串(相对, "/")
        如果 斜位 > 0:
          设 表名 为 截取(相对, 0, 斜位)
          设 尾名 为 截取到末尾(相对, 斜位 + 1)
          如果 结尾(尾名, ".json"):
            # hasDocuments 与键安全/可读/版本无关：先置新文档标记
            设 有新文档 为 真
            设 键 为 截取(尾名, 0, 字符串长度(尾名) - 5)
            设 键合法 为 真
            尝试:
              断言记录键(名, 键)
            捕获 错误 为 e:
              设 键合法 为 假
            如果 键合法:
              如果 字典包含键(表集合, 表名):
                设 值 为 解析记录文档(单元["介质"][路径], 可接受版本)
                如果 值 != 空:
                  字典设置(表集合[表名], 键, 值)  # L-123：双层下标赋值静默失败，改用 字典设置
              设 有新文档 为 真
  # 无新文档 -> legacy 兄弟文件引导（每次 loadAll 都可能触发）
  如果 有新文档 == 假:
    引导旧单元(单元, 表集合)
  设 状态 为 {}
  状态["表集合"] 为 表集合
  状态["global"] 为 全局值
  返回 状态

# bootstrapLegacyUnit：兄弟文档 <root>/<名>.json；JSON 失败/名不符/版本不在可接受表/tables 非对象
#   一律静默返回（不解释不删除）；合法则逐声明表逐键以当前版本重写子文档并进内存表；legacy 永不改删
段落 引导旧单元 接收 单元, 表集合:
  设 描述符 为 单元["描述符"]
  设 名 为 描述符["name"]
  设 旧路径 为 单元["根"] + "/" + 名 + ".json"
  如果 字典包含键(单元["介质"], 旧路径) == 假:
    返回 表集合
  设 文档 为 空
  设 解析失败 为 假
  尝试:
    设 文档 为 解析JSON(单元["介质"][旧路径])
  捕获 错误 为 e:
    设 解析失败 为 真
  如果 解析失败:
    返回 表集合
  设 头 为 字典获取(文档, "unit", 空)
  如果 头 == 空:
    返回 表集合
  如果 是字典(头) == 假:
    返回 表集合
  如果 字典获取(头, "name", "") != 名:
    返回 表集合
  设 版本 为 字典获取(头, "version", 空)
  如果 是整数(版本) == 假:
    返回 表集合
  设 可接受版本 为 [描述符["version"]]
  遍历 旧版 之 描述符["compatibleVersions"]:
    列表追加(可接受版本, 旧版)
  如果 列表包含(可接受版本, 版本) == 假:
    返回 表集合
  设 源表 为 字典获取(文档, "tables", 空)
  如果 是字典(源表) == 假:
    返回 表集合
  遍历 表名 之 描述符["tables"]:
    如果 字典包含键(源表, 表名):
      设 源行 为 源表[表名]
      如果 是字典(源行):
        遍历 键 之 字典键列表(源行):
          # legacy 键不合法跳过（防御，对齐 loadTableRecords 过滤）
          设 键合法 为 真
          尝试:
            断言记录键(名, 键)
          捕获 错误 为 e:
            设 键合法 为 假
          如果 键合法:
            字典设置(表集合[表名], 键, 源行[键])  # L-123 绕法
            写入记录(单元, 表名, 键, 源行[键])
  返回 表集合

# putRecord：assertOpen -> 表声明 -> 键安全 -> 写文档（serializeRecord 当前版本；介质赋值=原子替换）
段落 写入记录 接收 单元, 表, 键, 值:
  断言打开(单元)
  设 表路径 为 单元表路径(单元, 表)
  断言记录键(单元["描述符"]["name"], 键)
  设 版本 为 单元["描述符"]["version"]
  单元["介质"][表路径 + "/" + 键 + ".json"] 为 序列化记录文档(版本, 值)
  返回 表路径 + "/" + 键 + ".json"

# deleteRecord：assertOpen -> 表声明 -> 键安全 -> 幂等移除（无键 no-op）
段落 删除记录 接收 单元, 表, 键:
  断言打开(单元)
  设 表路径 为 单元表路径(单元, 表)
  断言记录键(单元["描述符"]["name"], 键)
  设 路径 为 表路径 + "/" + 键 + ".json"
  如果 字典包含键(单元["介质"], 路径):
    字典删除(单元["介质"], 路径)
  返回 路径

# backupRecord：rename <key>.json -> <key>.json.bak.<时间文本>（同分钟同键覆盖旧备份）；无键传播
段落 备份记录 接收 单元, 表, 键, 时间文本:
  断言打开(单元)
  设 表路径 为 单元表路径(单元, 表)
  设 路径 为 表路径 + "/" + 键 + ".json"
  如果 字典包含键(单元["介质"], 路径) == 假:
    抛出 新建 错误("unit '" + 单元["描述符"]["name"] + "': record '" + 键 + "' is missing in table '" + 表 + "'")
  设 新路径 为 路径 + ".bak." + 时间文本
  单元["介质"][新路径] 为 单元["介质"][路径]
  字典删除(单元["介质"], 路径)
  返回 新路径

# setGlobal：未声明 -> 逐字文案；写 <单元>/global.json（serializeRecord 当前版本）
段落 设置全局 接收 单元, 值:
  断言打开(单元)
  设 描述符 为 单元["描述符"]
  如果 描述符["hasGlobal"] == 假:
    抛出 新建 错误("unit '" + 描述符["name"] + "' does not declare a global slot")
  设 版本 为 描述符["version"]
  单元["介质"][单元["根"] + "/" + 描述符["name"] + "/global.json"] 为 序列化记录文档(版本, 值)
  返回 真

# close：幂等；后续调用拒绝
段落 关闭单元 接收 单元:
  单元["已关"] 为 真
  返回 真

# ---------------- storage-json/single-unit.ts ----------------
# 单文件单元：内存态权威；打开即读 <root>/<名>.json（无文档->空态；有->严格解析）
段落 造单文件单元 接收 介质, 描述符, 根:
  设 单元 为 {}
  单元["介质"] 为 介质
  单元["描述符"] 为 描述符
  单元["根"] 为 根
  单元["已关"] 为 假
  设 文档路径 为 根 + "/" + 描述符["name"] + ".json"
  单元["文档路径"] 为 文档路径
  # 打开：ENOENT -> 空态（物化推迟首写）；有内容 -> 严格 parse
  如果 字典包含键(介质, 文档路径) == 假:
    设 表集合 为 {}
    遍历 表名 之 描述符["tables"]:
      设 表集合[表名] 为 {}
    设 状态 为 {}
    状态["版本"] 为 描述符["version"]
    状态["global"] 为 空
    状态["表集合"] 为 表集合
    单元["状态"] 为 状态
  否则:
    单元["状态"] 为 解析单元文档(介质[文档路径], 描述符)
  返回 单元

# publish：内存态整文档重发布（介质赋值=原子替换；失败回滚路径为宿主 IO 面，纯逻辑不触发，登记）
段落 发布单元文档 接收 单元:
  单元["介质"][单元["文档路径"]] 为 序列化单元文档(单元["描述符"]["name"], 单元["状态"])
  返回 真

# single putRecord：内存改 -> 发布（被拒写不残留内存由回滚结构承载）
段落 单文件写入记录 接收 单元, 表, 键, 值:
  断言打开(单元)
  设 表集合 为 单元["状态"]["表集合"]
  如果 字典包含键(表集合, 表) == 假:
    抛出 新建 错误("unit '" + 单元["描述符"]["name"] + "' does not declare table '" + 表 + "'")
  字典设置(表集合[表], 键, 值)  # L-123 绕法
  发布单元文档(单元)
  返回 真

# single deleteRecord：无键直接返回（不发布）
段落 单文件删除记录 接收 单元, 表, 键:
  断言打开(单元)
  设 表集合 为 单元["状态"]["表集合"]
  如果 字典包含键(表集合, 表) == 假:
    抛出 新建 错误("unit '" + 单元["描述符"]["name"] + "' does not declare table '" + 表 + "'")
  如果 字典包含键(表集合[表], 键) == 假:
    返回 假
  字典删除(表集合[表], 键)
  发布单元文档(单元)
  返回 真

# single setGlobal：未声明逐字文案；赋值+发布
段落 单文件设置全局 接收 单元, 值:
  断言打开(单元)
  设 描述符 为 单元["描述符"]
  如果 描述符["hasGlobal"] == 假:
    抛出 新建 错误("unit '" + 描述符["name"] + "' does not declare a global slot")
  单元["状态"]["global"] 为 值
  发布单元文档(单元)
  返回 真

# single loadAll：内存快照
段落 单文件载入全部 接收 单元:
  断言打开(单元)
  设 快照 为 {}
  设 表快照 为 {}
  遍历 表名 之 字典键列表(单元["状态"]["表集合"]):
    设 行文 为 {}
    遍历 键 之 字典键列表(单元["状态"]["表集合"][表名]):
      设 行文[键] 为 单元["状态"]["表集合"][表名][键]
    设 表快照[表名] 为 行文
  快照["表集合"] 为 表快照
  快照["global"] 为 单元["状态"]["global"]
  返回 快照

# ---------------- 内存后端（Backend 契约的字典模拟） ----------------
# open(descriptor)：按布局创建单元；未 close 重复打开同名单元拒绝（调用方 bug，文案自拟登记）
段落 造内存后端:
  返回 ["介质": {}, "单元表": {}]

段落 打开单元 接收 后端, 描述符:
  设 名 为 描述符["name"]
  设 单元表 为 后端["单元表"]
  # 未 close 重复打开同名单元是调用方 bug，拒绝；close 后重开允许
  如果 字典包含键(单元表, 名):
    设 已开单元 为 字典获取(单元表, 名, 空)
    如果 已开单元["已关"] == 假:
      抛出 新建 错误(存储错误文本("duplicate-mount", "unit '" + 名 + "' is already open in this backend"))
  设 单元 为 空
  如果 字典获取(描述符, "layout", "single") == "per-record":
    设 单元 为 造单记录单元(后端["介质"], 描述符, "介质根")
  否则:
    设 单元 为 造单文件单元(后端["介质"], 描述符, "介质根")
  设 单元表[名] 为 单元
  返回 单元

# close：幂等排干（关闭全部已开单元）
段落 关闭后端 接收 后端:
  遍历 名 之 字典键列表(后端["单元表"]):
    关闭单元(后端["单元表"][名])
  返回 真
