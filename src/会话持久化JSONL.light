# 会话持久化JSONL.light —— 对标上游 packages/session/session-persistence-jsonl/src/（12 文件，a305303422）
# 纯逻辑面复刻（对标 #94）：行格式 / 事件→行生成 / 迁移校验。
#   storage.ts（文件 IO/原子重命名）、lease.ts（文件锁/租约）、worker.ts（后台线程）、
#   win32.ts（Windows 文件属性）、zstd*.ts（zstd 压缩）全部剔除（登记报告 §五）。
#
# 上游结构映射（以上游真实代码为准）：
#   format.ts   -> 解析头记录 是头行形状 扫描日志 造头行 事件行文本 行序列化 编码段 投影键 投影目录
#                 （header 判别键 type="session"，上游无独立 magic 字符串/注释行——任务书差异登记）
#   generation.ts -> 生成行序列 增量行序列 行号映射（上游写路径顺序由调用方保证；
#                 任务书点名的 seq 排序/增量生成为补充实现，见报告 §五）
#   migration-verifier.ts -> 上游实为 worker 传输层；任务书校验项（版本合法/seq 连续/类型已知/
#                 载荷必选+多余键）以 校验迁移 纯逻辑实现，报告为「通过/失败+行号+原因」
#   index.ts    -> freezeStoredEvent/fileRevision 等辅助语义并入
#
# 词汇衔接：事件类型已知性与载荷校验复用 src/会话格式.light 的 已知事件类型/校验事件载荷
#   （approval/* 等已知类型在词汇表内）；事件行 JSON 形状 {"seq","type","data"} 与
#   src/会话日志增量.light 线格式同构。
# 格式版本：上游 SESSION_FORMAT_VERSION 数值不可见（外部 catalog 包），取光明侧最新 V3=3（登记）。
# 绕法：内置裸名（L-090）、无 且/或 行内链（L-043）、标识符避关键字（L-084/L-092）、无花括号文案（L-089）。

从 会话格式 导入 已知事件类型, 校验事件载荷

导出 是安全序号 是头行形状 解析头行 解析事件行 扫描日志 造头行 事件行文本 行序列化 码转十六进制 编码段 投影键 投影目录 事件到行字典 行到事件 排序事件表 生成行序列 增量行序列 行号映射 校验迁移。

# format version（上游 catalog 常量不可见，取 V3，登记 R14-D3）
设 当前格式版本 为 3
设 头必选键 为 ["type", "version", "id", "createdAt", "isSeeded", "delegationDepth"]
设 头可选键 为 ["cwd", "parentSession", "origin", "agentPreset"]
设 退役键表 为 ["sandboxMode", "approvalPolicy"]

# ---------------- format.ts：形状守卫 ----------------
# safe int >= 0 且非 -0（光明 是整数 已排除布尔；-0.0 为浮点被 是整数 排除）
段落 是安全序号(值):
  如果 是整数(值) == 假:
    返回 假
  如果 值 < 0:
    返回 假
  返回 真

# isHeaderLine 守卫：键集/类型逐项（返回 "" 或失败原因）
段落 是头行形状(对象):
  如果 是字典(对象) == 假:
    返回 "非对象"
  遍历 键 之 头必选键:
    如果 字典包含键(对象, 键) == 假:
      返回 "缺必选键"
  遍历 键 之 字典键列表(对象):
    如果 列表包含(头必选键, 键) == 假:
      如果 列表包含(头可选键, 键) == 假:
        返回 "未知键"
  # type
  如果 对象["type"] != "session":
    返回 "类型"
  # version：数字（版本拒绝由 解析头行 先行处理，这里只查形状）
  如果 是整数(对象["version"]) == 假:
    返回 "版本"
  # id：字符串
  如果 是字符串(对象["id"]) == 假:
    返回 "标识"
  # createdAt：safe int >= 0
  如果 是安全序号(对象["createdAt"]) == 假:
    返回 "创建时间"
  # isSeeded：布尔
  如果 对象["isSeeded"] != 真:
    如果 对象["isSeeded"] != 假:
      返回 "是种子"
  # delegationDepth：safe int >= 0
  如果 是安全序号(对象["delegationDepth"]) == 假:
    返回 "委托深度"
  # 可选键类型
  如果 字典包含键(对象, "cwd"):
    如果 是字符串(对象["cwd"]) == 假:
      返回 "工作目录"
  如果 字典包含键(对象, "parentSession"):
    如果 是字符串(对象["parentSession"]) == 假:
      返回 "父会话"
  如果 字典包含键(对象, "origin"):
    如果 对象["origin"] != "subagent":
      返回 "来源"
  如果 字典包含键(对象, "agentPreset"):
    如果 是字符串(对象["agentPreset"]) == 假:
      返回 "代理预设"
  返回 ""

# 解析头记录（parseHeaderRecord + SessionLogScanner 构造的校验链，顺序不可乱）：
#   JSON 失败 -> 非对象 -> 版本拒绝（先于结构）-> 退役键 -> 守卫失败
# 返回 ["头": 头字典] 或抛错
段落 解析头行(首行文本):
  设 头 为 空
  设 解析失败 为 假
  尝试:
    设 头 为 解析JSON(首行文本)
  捕获 错误 为 e:
    设 解析失败 为 真
  如果 解析失败:
    抛出 新建 错误("corrupt session log: header line is not valid JSON")
  # 非对象（含数组）
  如果 是字典(头) == 假:
    抛出 新建 错误("corrupt session log: first line is not a JSON object")
  # 版本拒绝先于结构校验（未来格式报升级而非损坏）
  设 版本 为 字典获取(头, "version", 空)
  如果 是整数(版本):
    如果 版本 != 当前格式版本:
      抛出 新建 错误("session log \"" + 转字符串(字典获取(头, "id", "")) + "\" uses format v" + 转字符串(版本) + "; this harness supports v" + 转字符串(当前格式版本) + " — upgrade harness to read this log")
  # 退役键
  遍历 退役键 之 退役键表:
    如果 字典包含键(头, 退役键):
      抛出 新建 错误("session header uses retired policy baseline fields")
  # 守卫
  设 守卫 为 是头行形状(头)
  如果 守卫 != "":
    抛出 新建 错误("corrupt session log: first line is not a session header")
  返回 ["头": 头]

# 解析单条事件行：JSON 失败抛（行号由调用方文案承载）；形状=对象且含 seq/type/data
段落 解析事件行(行文本, 行号):
  设 对象 为 空
  设 解析失败 为 假
  尝试:
    设 对象 为 解析JSON(行文本)
  捕获 错误 为 e:
    设 解析失败 为 真
  如果 解析失败:
    抛出 新建 错误("corrupt session log: unparsable committed event at line " + 转字符串(行号))
  如果 是字典(对象) == 假:
    抛出 新建 错误("corrupt session log: unparsable committed event at line " + 转字符串(行号))
  返回 行到事件(对象)

# 扫描日志（SessionLogScanner 纯逻辑）：文本 -> 头 + 事件表
#   空文本/无换行 -> empty or header-less；末行无尾换行 = torn tail 忽略；
#   严格=真 遇坏行即抛；否则记首个 issue，遇 turn/end 补抛（防吞结构性损坏）
段落 扫描日志(文本, 严格):
  # 空或无换行
  设 首换 为 查找子串(文本, "\n")
  如果 字符串长度(文本) == 0:
    抛出 新建 错误("empty or header-less session log")
  如果 首换 < 0:
    抛出 新建 错误("empty or header-less session log")
  # 分帧：按 \n 切，末段空=完整；末段非空=torn tail 忽略
  设 段表 为 分割字符串(文本, "\n")
  设 行表 为 []
  设 总段 为 列表长度(段表)
  设 序号 为 0
  当 序号 < 总段:
    如果 序号 < 总段 - 1:
      列表追加(行表, 段表[序号])
    否则:
      # 末段：空=文件以换行结束；非空=torn tail（忽略）
      如果 字符串长度(段表[序号]) == 0:
        # 不追加
        设 占 为 空
    设 序号 为 序号 + 1
  # 头行
  设 头果 为 解析头行(行表[0])
  # 事件行
  设 事件表 为 []
  设 首个问题 为 ""
  设 事件行号 为 0
  设 总行 为 列表长度(行表)
  设 序号 为 1
  当 序号 < 总行:
    设 事件行号 为 事件行号 + 1
    设 失败 为 假
    设 事件 为 空
    尝试:
      设 事件 为 解析事件行(行表[序号], 事件行号)
    捕获 错误 为 e:
      设 失败 为 真
      如果 首个问题 == "":
        设 首个问题 为 转字符串(e)
      如果 严格:
        抛出 新建 错误(转字符串(e))
    如果 失败 == 假:
      # recoverable 模式：有未决 issue 且遇 turn/end 补抛
      如果 首个问题 != "":
        如果 事件["种类"] == "turn/end":
          抛出 新建 错误(首个问题)
      列表追加(事件表, 事件)
    设 序号 为 序号 + 1
  返回 ["头": 头果["头"], "事件表": 事件表, "事件数": 列表长度(事件表)]

# ---------------- format.ts：序列化 ----------------
# toHeaderLine：seeded 必须给 继承事件数；unseeded 必须为 0；delegationDepth 缺省 0；可选键仅存在时落
段落 造头行(头, 继承事件数):
  设 是种子 为 头["isSeeded"]
  如果 是种子:
    如果 继承事件数 == 空:
      抛出 新建 错误("seeded session header requires an inherited event count")
  如果 是种子 == 假:
    如果 继承事件数 != 空:
      如果 继承事件数 != 0:
        抛出 新建 错误("unseeded session header inherited event count must be 0")
  设 行 为 {}
  行["type"] 为 "session"
  行["version"] 为 当前格式版本
  行["id"] 为 头["id"]
  行["createdAt"] 为 头["createdAt"]
  行["isSeeded"] 为 是种子
  行["delegationDepth"] 为 字典获取(头, "delegationDepth", 0)
  如果 字典包含键(头, "cwd"):
    行["cwd"] 为 头["cwd"]
  如果 字典包含键(头, "parentSession"):
    行["parentSession"] 为 头["parentSession"]
  如果 字典包含键(头, "origin"):
    行["origin"] 为 头["origin"]
  如果 字典包含键(头, "agentPreset"):
    行["agentPreset"] 为 头["agentPreset"]
  返回 行

# 事件行文本（上游 eventLine：无尾换行；最终换行由写入方添加）
段落 事件行文本(事件):
  返回 序列化JSON(事件到行字典(事件))

# 行序列化（写入一行到文件的形态：JSON + 尾换行；反跑 A 锚点）
段落 行序列化(对象):
  返回 序列化JSON(对象) + "\n"

# ---------------- format.ts：路径编码 ----------------
# 码 -> 4 位大写十六进制
段落 码转十六进制(码):
  设 余 为 码
  设 位表 为 []
  设 轮 为 0
  当 轮 < 4:
    设 商 为 转整数(余 / 16)
    设 位 为 余 - 商 * 16
    设 余 为 商
    设 字符 为 转字符串(位)
    如果 位 == 10:
      设 字符 为 "A"
    如果 位 == 11:
      设 字符 为 "B"
    如果 位 == 12:
      设 字符 为 "C"
    如果 位 == 13:
      设 字符 为 "D"
    如果 位 == 14:
      设 字符 为 "E"
    如果 位 == 15:
      设 字符 为 "F"
    # 位插入表首
    设 新表 为 [字符]
    遍历 旧 之 位表:
      列表追加(新表, 旧)
    设 位表 为 新表
    设 轮 为 轮 + 1
  返回 连接字符串(位表, "")

# encodeSegment：空抛；. / .. 特例；[A-Za-z0-9._-] 原样（~ 恒转义）；其余 ~XXXX
段落 编码段(段):
  如果 字符串长度(段) == 0:
    抛出 新建 错误("cannot encode an empty path segment")
  如果 段 == ".":
    返回 "~002E"
  如果 段 == "..":
    返回 "~002E~002E"
  设 输出 为 ""
  设 序号 为 0
  设 长 为 字符串长度(段)
  当 序号 < 长:
    设 字符 为 字符串获取(段, 序号)
    设 码 为 码位(字符)
    设 原样 为 假
    如果 码 >= 97:
      如果 码 <= 122:
        设 原样 为 真
    如果 码 >= 65:
      如果 码 <= 90:
        设 原样 为 真
    如果 码 >= 48:
      如果 码 <= 57:
        设 原样 为 真
    如果 字符 == ".":
      设 原样 为 真
    如果 字符 == "_":
      设 原样 为 真
    如果 字符 == "-":
      设 原样 为 真
    如果 原样:
      设 输出 为 输出 + 字符
    否则:
      设 输出 为 输出 + "~" + 码转十六进制(码)
    设 序号 为 序号 + 1
  返回 输出

# projectKey：/ \ : 连续段折叠 '-'；安全原样；其余 ~XXXX；去前导 '-'（空则 root）；--slug-- 截 251
段落 投影键(工作目录):
  设 输出 为 ""
  设 上连 为 假
  设 序号 为 0
  设 长 为 字符串长度(工作目录)
  当 序号 < 长:
    设 字符 为 字符串获取(工作目录, 序号)
    设 码 为 码位(字符)
    设 是分隔 为 假
    如果 字符 == "/":
      设 是分隔 为 真
    如果 字符 == "\\":
      设 是分隔 为 真
    如果 字符 == ":":
      设 是分隔 为 真
    如果 是分隔:
      如果 上连 == 假:
        设 输出 为 输出 + "-"
        设 上连 为 真
    否则:
      设 原样 为 假
      如果 码 >= 97:
        如果 码 <= 122:
          设 原样 为 真
      如果 码 >= 65:
        如果 码 <= 90:
          设 原样 为 真
      如果 码 >= 48:
        如果 码 <= 57:
          设 原样 为 真
      如果 字符 == ".":
        设 原样 为 真
      如果 字符 == "_":
        设 原样 为 真
      如果 字符 == "-":
        设 原样 为 真
      如果 原样:
        设 输出 为 输出 + 字符
        设 上连 为 假
      否则:
        设 输出 为 输出 + "~" + 码转十六进制(码)
        设 上连 为 假
    设 序号 为 序号 + 1
  # 去前导 '-'
  当 开头(输出, "-"):
    设 输出 为 截取到末尾(输出, 1)
  如果 字符串长度(输出) == 0:
    设 输出 为 "root"
  设 输出 为 "--" + 输出 + "--"
  如果 字符串长度(输出) > 251:
    设 输出 为 截取(输出, 0, 251)
  返回 输出

# projectDir：无 cwd -> _no-cwd
段落 投影目录(工作目录):
  如果 工作目录 == 空:
    返回 "_no-cwd"
  返回 投影键(工作目录)

# ---------------- 事件 <-> 行字典（线格式 {"seq","type","data"}） ----------------
段落 事件到行字典(事件):
  设 行 为 {}
  行["seq"] 为 事件["序号"]
  行["type"] 为 事件["种类"]
  行["data"] 为 字典获取(事件, "数据", {})
  返回 行

段落 行到事件(行字典):
  设 事件 为 {}
  事件["序号"] 为 字典获取(行字典, "seq", -1)
  事件["种类"] 为 字典获取(行字典, "type", "")
  事件["数据"] 为 字典获取(行字典, "data", {})
  返回 事件

# ---------------- generation.ts：事件按 seq 排序 + 生成（反跑 C 锚点） ----------------
# seq 升序选择排序（返回新表，稳定）
段落 排序事件表(事件表):
  设 结果 为 []
  遍历 事件 之 事件表:
    列表追加(结果, 事件)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 结果[内]["序号"] < 结果[最小]["序号"]:
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时事件 为 结果[外]
      设 结果[外] 为 结果[最小]
      设 结果[最小] 为 临时事件
    设 外 为 外 + 1
  返回 结果

# 生成行序列：header 首行 + 事件按 seq 升序逐事件一行（行含尾换行）
段落 生成行序列(头, 继承事件数, 事件表):
  设 头行 为 造头行(头, 继承事件数)
  设 行表 为 [行序列化(头行)]
  设 有序表 为 排序事件表(事件表)
  遍历 事件 之 有序表:
    列表追加(行表, 行序列化(事件到行字典(事件)))
  返回 行表

# 增量生成：只生成 seq > 起始序号 的事件行（header 不重复）
段落 增量行序列(事件表, 起始序号):
  设 行表 为 []
  设 有序表 为 排序事件表(事件表)
  遍历 事件 之 有序表:
    如果 事件["序号"] > 起始序号:
      列表追加(行表, 行序列化(事件到行字典(事件)))
  返回 行表

# 行号/seq 映射：行号(1 基，header 为 0 行) -> 事件 seq
段落 行号映射(行表):
  设 映射表 为 []
  设 序号 为 1
  设 总数 为 列表长度(行表)
  当 序号 < 总数:
    设 行文本 为 行表[序号]
    设 解析失败 为 假
    设 对象 为 空
    尝试:
      设 对象 为 解析JSON(行文本)
    捕获 错误 为 e:
      设 解析失败 为 真
    如果 解析失败 == 假:
      设 项 为 {}
      项["行"] 为 序号
      项["seq"] 为 字典获取(对象, "seq", -1)
      列表追加(映射表, 项)
    设 序号 为 序号 + 1
  返回 映射表

# ---------------- 迁移校验（任务书校验项；反跑 B 锚点） ----------------
# 校验报告：["通过": 真/假, "错误表": [["行", "原因"]]]；错误收集不抛（上游以抛错承载，报告形态为任务书要求）
段落 校验迁移(日志文本):
  设 错误表 为 []
  # 解析头（解析错误即报告失败）
  设 头 为 空
  设 头错 为 ""
  设 段表 为 分割字符串(日志文本, "\n")
  尝试:
    设 头果 为 解析头行(段表[0])
    设 头 为 头果["头"]
  捕获 错误 为 e:
    设 头错 为 转字符串(e)
  如果 头错 != "":
    列表追加(错误表, ["行": 1, "原因": 头错])
    返回 ["通过": 假, "错误表": 错误表]
  # 事件逐行校验：JSON/形状/seq 连续/类型已知/载荷必选+多余键
  设 总段 为 列表长度(段表)
  设 行号 为 1
  设 前序 为 -1
  设 序号 为 1
  当 序号 < 总段:
    设 行文本 为 段表[序号]
    # 报告行号 = 含 header 的 1 基行号
    设 行号 为 序号 + 1
    如果 字符串长度(行文本) > 0:
      # JSON 与形状
      设 对象 为 空
      设 失败 为 假
      设 原因 为 ""
      尝试:
        设 对象 为 解析JSON(行文本)
      捕获 错误 为 e:
        设 失败 为 真
        设 原因 为 "corrupt session log: unparsable committed event at line " + 转字符串(行号 - 1)
      如果 失败:
        列表追加(错误表, ["行": 行号, "原因": 原因])
      否则:
        如果 是字典(对象) == 假:
          列表追加(错误表, ["行": 行号, "原因": "corrupt session log: unparsable committed event at line " + 转字符串(行号 - 1)])
        否则:
          # seq 连续（首个任意 >=0，之后 前序+1）
          设 当前序号 为 字典获取(对象, "seq", -1)
          如果 是安全序号(当前序号) == 假:
            列表追加(错误表, ["行": 行号, "原因": "event seq is not a non-negative safe integer"])
          否则:
            如果 前序 >= 0:
              如果 当前序号 != 前序 + 1:
                列表追加(错误表, ["行": 行号, "原因": "event seq " + 转字符串(当前序号) + " is not contiguous; expected " + 转字符串(前序 + 1)])
            设 前序 为 当前序号
            # 类型已知（词汇表衔接）
            设 种类 为 字典获取(对象, "type", "")
            如果 已知事件类型(种类) == 假:
              列表追加(错误表, ["行": 行号, "原因": "unknown event type " + 种类])
            否则:
              # 载荷必选+多余键（strict）
              设 载荷错 为 ""
              尝试:
                校验事件载荷(种类, 字典获取(对象, "data", {}), 真)
              捕获 错误 为 e:
                设 载荷错 为 转字符串(e)
              如果 载荷错 != "":
                列表追加(错误表, ["行": 行号, "原因": 载荷错])
    设 序号 为 序号 + 1
  设 通过 为 列表长度(错误表) == 0
  返回 ["通过": 通过, "错误表": 错误表]
