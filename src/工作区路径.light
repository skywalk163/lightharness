# 工作区路径.light —— 对标原版 packages/util/workspace-path/src/{index.ts,file-address.ts}
# 纯逻辑核心：工作区路径分类/拼接/显示名缩写 + dsh-resource://file/ 地址编解码。
# 上游导出：isAbsoluteWorkspacePath / resolveWorkspacePath / abbreviateHomePath /
#   workspaceTitleOf / pathPartsOf / fileAddressFor / relativizeToCwd
#   + file-address: sessionFileAddress / absoluteFileAddress / parseFileAddress。
# 差异：parseFileAddress 对非法百分号转义，上游用 try/catch decodeURIComponent 兜底，
#       光明侧同样以 尝试/捕获 包裹，失败返回 空。

从 字符串处理 导入 截取, 替换, URL编码, URL解码, 匹配正则, 查找
从 字符串工具轻量 导入 连接字符串

设 文件地址前缀 为 "dsh-resource://file/"
设 盘符正则 为 "^[A-Za-z]:[/\\\\]"

# 是否 Windows 风格路径：盘符（C:\ 或 C:/）或 UNC（\\server）。
段落 是Windows风格路径(值):
  如果 匹配正则(值, 盘符正则):
    返回 真
  如果 值.开头("\\\\"):
    返回 真
  返回 假

# 绝对路径？POSIX 斜杠开头 或 Windows 盘符/UNC。
段落 是绝对工作区路径(路径):
  如果 路径.开头("/"):
    返回 真
  返回 是Windows风格路径(路径)

# 去掉尾部连续 / 或 \
段落 去尾分隔(路径):
  当 长(路径) > 0 且 (路径.结尾("/") 或 路径.结尾("\\")):
    设 路径 为 截取(路径, 0, 长(路径) - 1)
  返回 路径

# 去掉头部连续 / 或 \
段落 去头分隔(路径):
  设 起点 为 0
  设 n 为 长(路径)
  当 起点 < n 且 (路径[起点] == "/" 或 路径[起点] == "\\"):
    设 起点 为 起点 + 1
  返回 截取(路径, 起点, n)

# 解析相对路径到宿主拼写：绝对路径原样；否则按 cwd 拼接（分隔符跟随 cwd）。
段落 解析工作区路径(cwd, 路径):
  如果 是绝对工作区路径(路径):
    返回 路径
  如果 cwd == 空 或 长(cwd) == 0:
    返回 路径
  设 分隔符 为 "/"
  如果 是Windows风格路径(cwd) 且 cwd.包含("\\"):
    设 分隔符 为 "\\"
  设 基座 为 去尾分隔(cwd)
  设 相对段 为 去头分隔(路径)
  返回 基座 加上 分隔符 加上 相对段

# 缩写 POSIX 主目录：主目录本身 → ~；其后代 → ~/…；Windows 风格原样返回。
段落 缩写主目录路径(路径, 主目录):
  如果 主目录 == 空 或 长(主目录) == 0:
    返回 路径
  如果 是Windows风格路径(路径) 或 是Windows风格路径(主目录):
    返回 路径
  设 根 为 去尾分隔(主目录)
  如果 长(根) == 0 或 根 == "/":
    返回 路径
  如果 去尾分隔(路径) == 根:
    返回 "~"
  如果 路径.开头(根 加上 "/"):
    返回 "~" 加上 截取(路径, 长(根), 长(路径))
  返回 路径

# 取末段作工作区标题
段落 工作区标题(路径):
  设 修整 为 去尾分隔(路径)
  如果 长(修整) == 0:
    返回 ""
  设 斜位 为 修整.rfind("/")
  设 反位 为 修整.rfind("\\")
  设 界 为 斜位
  如果 反位 > 斜位:
    设 界 为 反位
  返回 截取(修整, 界 + 1, 长(修整))

# 拆成 (目录前缀, 末段)
段落 路径分部(路径):
  设 修整 为 去尾分隔(路径)
  如果 长(修整) == 0:
    返回 {"目录": "", "名字": 路径}
  设 斜位 为 修整.rfind("/")
  设 反位 为 修整.rfind("\\")
  设 界 为 斜位
  如果 反位 > 斜位:
    设 界 为 反位
  设 切点 为 界 + 1
  返回 {"目录": 截取(修整, 0, 切点), "名字": 截取(修整, 切点, 长(修整))}

# ── file-address 编解码 ──────────────────────────────────────────────

# 段编码：保持盘符冒号字面（%3A 还原为 :）
段落 编码段(段):
  设 编码 为 URL编码(段)
  设 编码 为 替换(编码, "%3A", ":")
  返回 编码

# 按 / 逐段编码
段落 编码路径(路径):
  设 段们 为 路径.分割("/")
  设 编码们 为 []
  遍历 段 之 段们:
    编码们.追加(编码段(段))
  返回 连接字符串(编码们, "/")

# 会话域文件地址：反斜杠归一 / 、剥掉前导 ./。
段落 会话文件地址(会话ID, 路径):
  设 归一 为 替换(路径, "\\", "/")
  当 归一.开头("./"):
    设 归一 为 截取(归一, 2, 长(归一))
  返回 文件地址前缀 加上 "session/" 加上 编码段(会话ID) 加上 "/" 加上 编码路径(归一)

# 绝对域文件地址：剥掉前导 /（UNC // 保留一个空首段）。
段落 绝对文件地址(路径):
  设 归一 为 替换(路径, "\\", "/")
  设 是UNC 为 归一.开头("//")
  设 去前导 为 去头分隔(归一)
  设 体 为 编码路径(去前导)
  如果 是UNC:
    返回 文件地址前缀 加上 "absolute/" 加上 "/" 加上 体
  返回 文件地址前缀 加上 "absolute/" 加上 体

# 工作区内路径 → 会话文件地址；工作区外绝对路径 → 绝对域地址。
段落 文件地址For(会话ID, cwd, 路径):
  设 归一 为 替换(路径, "\\", "/")
  如果 是绝对工作区路径(归一) == 假:
    返回 会话文件地址(会话ID, 归一)
  设 根 为 ""
  如果 cwd != 空:
    设 根 为 去尾分隔(替换(cwd, "\\", "/"))
  如果 长(根) > 0 且 归一 == 根:
    返回 会话文件地址(会话ID, "")
  如果 长(根) > 0 且 归一.开头(根 加上 "/"):
    返回 会话文件地址(会话ID, 截取(归一, 长(根) + 1, 长(归一)))
  返回 会话文件地址(会话ID, 归一)

# 把工作区根从工作区内绝对路径剥掉（显示用）。
段落 相对化到cwd(文本, cwd):
  如果 cwd == 空 或 长(cwd) == 0:
    返回 文本
  设 根 为 cwd
  当 长(根) > 0 且 (根.结尾("/") 或 根.结尾("\\")):
    设 根 为 截取(根, 0, 长(根) - 1)
  如果 文本.开头(根 加上 "/") 或 文本.开头(根 加上 "\\"):
    返回 截取(文本, 长(根) + 1, 长(文本))
  返回 文本

# 已解码首段是否盘符（C:）
段落 是盘符段(段):
  如果 段 == 空:
    返回 假
  返回 匹配正则(段, "^[A-Za-z]:$")

# 把 dsh-resource://file/… 读回部件；非法前缀/作用域/坏转义 → 空。
段落 解析文件地址(地址):
  如果 地址.开头(文件地址前缀) == 假:
    返回 空
  设 尾 为 截取(地址, 长(文件地址前缀), 长(地址))
  # 忽略 ? / # 后缀
  设 问位 为 查找(尾, "?")
  设 井位 为 查找(尾, "#")
  设 截断 为 -1
  如果 问位 >= 0 且 (截断 < 0 或 问位 < 截断):
    设 截断 为 问位
  如果 井位 >= 0 且 (截断 < 0 或 井位 < 截断):
    设 截断 为 井位
  如果 截断 >= 0:
    设 尾 为 截取(尾, 0, 截断)
  设 段们 为 尾.分割("/")
  设 作用域 为 段们[0]
  如果 作用域 == "session":
    设 id 为 段们[1]
    如果 id == 空 或 长(段们) <= 2:
      返回 空
    尝试:
      设 解码id 为 URL解码(id)
      设 路径段们 为 []
      设 i 为 2
      当 i < 长(段们):
        路径段们.追加(URL解码(段们[i]))
        设 i 为 i + 1
      返回 {"scope": "session", "sessionId": 解码id, "path": 连接字符串(路径段们, "/")}
    捕获 错误:
      返回 空
  如果 作用域 == "absolute":
    设 是UNC 为 段们[1] == "" 且 长(段们) > 2
    设 路径段们 为 []
    尝试:
      如果 是UNC:
        设 i 为 2
        当 i < 长(段们):
          路径段们.追加(URL解码(段们[i]))
          设 i 为 i + 1
      否则:
        设 i 为 1
        当 i < 长(段们):
          路径段们.追加(URL解码(段们[i]))
          设 i 为 i + 1
    捕获 错误:
      返回 空
    如果 长(路径段们) == 0 或 路径段们[0] == "":
      返回 空
    设 拼 为 连接字符串(路径段们, "/")
    如果 是UNC:
      返回 {"scope": "absolute", "path": "//" 加上 拼}
    如果 是盘符段(路径段们[0]):
      返回 {"scope": "absolute", "path": 拼}
    返回 {"scope": "absolute", "path": "/" 加上 拼}
  返回 空
