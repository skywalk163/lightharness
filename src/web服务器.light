# ---- 运行中任务控制 HTTP 处理（停止 / 暂停 / 继续 / 插入 / 工具清单）----
# 设计：所有接口都从请求体取 session_id；token 由路由层统一校验。
# 返回 JSON 信封：{"ok":布尔, ...}；错误用 ok:假 + 理由，而非 4xx（前端统一按 ok 判定）。

段落 取控制会话(请求, 体):
  # 只从 body 取 session_id；查询串 token 由路由层统一处理，控制接口无需二次解析
  设 会话 为 字典获取(体, "session_id", "")
  返回 会话

段落 控制JSON(状态, 内容):
  返回 ["状态": 状态, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(内容)]

段落 处理停止任务(请求, 体):
  设 会话 为 取控制会话(请求, 体)
  设 结果 为 请求停止(会话)
  如果 字典获取(结果, "ok", 假) == 真:
    设 队列 为 取运行(会话)
    如果 队列 != 空:
      设 代理 为 字典获取(队列, "代理", 空)
      如果 代理 != 空:
        尝试:
          代理.终止("user_stop")
        捕获 异常 e:
          设 忽略 为 空
    返回 控制JSON(200, ["ok": 真, "会话": 会话, "状态": "stopping", "已杀子进程": 字典获取(结果, "已杀子进程", 0)])
  返回 控制JSON(200, ["ok": 假, "理由": 字典获取(结果, "理由", "会话不在运行中")])

段落 处理暂停任务(请求, 体):
  设 会话 为 取控制会话(请求, 体)
  设 结果 为 请求暂停(会话)
  返回 控制JSON(200, 结果)

段落 处理继续任务(请求, 体):
  设 会话 为 取控制会话(请求, 体)
  设 结果 为 请求继续(会话)
  返回 控制JSON(200, 结果)

段落 处理工具控制(请求, 体, 动作):
  设 调用id 为 字典获取(体, "id", 字典获取(体, "调用id", ""))
  如果 调用id == "":
    返回 控制JSON(200, ["ok": 假, "理由": "缺少工具 id"])
  设 结果 为 空
  如果 动作 == "stop":
    设 结果 为 停工具(调用id)
    返回 控制JSON(200, ["ok": 真, "状态": "stopped"])
  否则如果 动作 == "pause":
    设 结果 为 暂停工具(调用id)
  否则如果 动作 == "resume":
    设 结果 为 继续工具(调用id)
  否则:
    返回 控制JSON(200, ["ok": 假, "理由": "未知动作"])
  返回 控制JSON(200, 结果)

段落 处理插入提示(请求, 体):
  设 会话 为 取控制会话(请求, 体)
  设 文本 为 字典获取(体, "text", 字典获取(体, "文本", ""))
  设 结果 为 插入提示(会话, 文本)
  如果 字典获取(结果, "ok", 假) == 真:
    返回 控制JSON(200, ["ok": 真, "会话": 会话, "位置": 字典获取(结果, "位置", 0)])
  返回 控制JSON(200, 结果)

段落 处理工具清单(请求, 体):
  尝试:
    设 会话 为 取控制会话(请求, 体)
    设 工具列表 为 列工具(会话)
    返回 控制JSON(200, ["ok": 真, "会话": 会话, "工具": 工具列表])
  捕获 异常 e:
    返回 控制JSON(200, ["ok": 假, "理由": 转字符串(e)])


# ---- 路由层本体（同步方法；异步编排在模块级 路由处理器）----
类 Web服务端:
  属性 服务端 等于 空
  属性 客户端对象 等于 空
  属性 注册表 等于 空
  属性 根 等于 空
  属性 超时值 等于 30.0
  属性 绑定地址 等于 "127.0.0.1"   # R41：HTTP 绑定地址（默认本机回环，保持默认安全）
  属性 令牌 等于 ""                # R41：HARNESS_TOKEN 网络级令牌（非 loopback 绑定时强制）
  属性 请求数 等于 0
  属性 会话表 等于 空
  属性 界面目录 等于 ""   # W3：静态页面根目录；"" 表示不启用静态路由（向后兼容）
  属性 配置元数据 等于 空   # 配置状态：configured/mock/model/endpoint/has_key（不含密钥明文）
  属性 环境文件路径 等于 ""  # .env 绝对路径；POST /api/config 写入此文件
  属性 会话库 等于 空       # E2：会话存储实例（JSONL + 索引）；空表示未启用会话持久化
  属性 令牌会话表 等于 空   # E2：认证令牌 → 会话 id 绑定表
  属性 计划命令表 等于 空   # T-0420：会话 id → 当前 /plan 的 commandId（出口工具配对用）
  属性 计量器 等于 空       # E5：令牌计量器（本轮/累计 token 与花费）
  属性 压缩管理器 等于 空   # E5：压缩配置（读环境变量）
  属性 生效工作目录 等于 ""   # 用户设置的工作目录（GET/POST /api/cwd；新会话与工具根据此）
  属性 上下文窗口 等于 32768  # E5：上下文窗口（用于计算使用率）
  属性 权限管理器 等于 空   # E4：权限预设管理器
  属性 审批管理器 等于 空   # E4：审批队列管理器
  属性 事件推送队列 等于 空 # E4：SSE 事件推送队列（审批请求等）
  属性 钩子秘密 等于 ""      # R42：GitHub webhook HMAC 秘密（env HARNESS_WEBHOOK_SECRET / GITHUB_WEBHOOK_SECRET）
  属性 钩子来源 等于 "github:webhook:lightharness"  # R42：webhook 交付来源标识
  属性 钩子体上限 等于 1000000  # R42：webhook 请求体上限（env HARNESS_WEBHOOK_MAX_BODY）
  属性 钩子派发记录 等于 空  # R42：webhook 派发记录（默认只记录不外联）
  属性 预设注册表缓存 等于 空  # 第5步：preset → 组装注册表(预设) 缓存（空串不缓存，走启动默认表）
  # T-0397：每个会话单独的模式 / 权限预设（对齐 DSH：切换会话即恢复）
  属性 会话模式表 等于 空   # 会话 id → {"模式":..., "权限预设":...}（落 <根>/session-modes.json）
  # 每个会话单独的模型选择（对齐 DSH：chat 框下模型选择器按会话生效）
  属性 会话模型表 等于 空     # 会话 id → 模型 id（落 <根>/session-models.json）
  属性 枢纽模型缓存 等于 空   # jet-hub 模型目录缓存（列表）
  属性 枢纽缓存时刻 等于 0    # 上次拉取的时间戳（秒）；0 = 未拉过
  属性 快捷键目录 等于 空  # R106：快捷键自定义目录（进程内存；空=未初始化，懒加载自 默认目录）
  属性 快捷键已合并 等于 假  # R107：keybindings.json 是否已合并回目录（每次目录重建后合并一次）
  属性 请求端口 等于 0        # T-0426：HARNESS_WEB_PORT 指定的固定端口（0 = 内核分配）
  属性 端口回退 等于 ""       # T-0426：固定端口占用而回退到内核分配时的说明（空 = 未回退）
  # T-0407 需求一/四/五：续跑台账 / 会话队列闸门 / 最近一轮细节（供统计帧与压缩帧）
  属性 续跑表 等于 空        # 会话 id → 续跑状态字典（goal 循环的进度台账）
  属性 队列闸门 等于 空      # 会话级排队/插话闸门单例（跨线程，见 会话队列.light）
  # T-0490：排队唤醒兜底——会话 → 最近一次流式载具（供孤儿待办兜底消费）
  属性 排队载具表 等于 空
  属性 唤醒线程 等于 空
  属性 最近轮次细节 等于 空  # {"开始时刻","完成时刻","耗时秒","速率"}，由本轮结果回填
  属性 最近轮次数 等于 0     # 本次 HTTP 请求内实际跑了多少轮（续跑/排队会让它 > 1）
  属性 最近压缩条数 等于 0   # 本次请求内自动压缩折叠掉的旧消息条数（0 = 未压缩）
  属性 最近步数上限 等于 0   # T-0425：本次请求实际生效的单轮步数上限（0 = 未知）
  属性 最近步数上限来源 等于 ""  # 生效来源：请求 / 环境 / 缺省
  # T-0466：使用率显示口径（只影响统计帧与前端展示，不碰自动压缩预算）
  属性 最近统计模型 等于 ""        # 本次统计帧对应的会话模型 id（分母按它的 contextWindow 取）
  属性 最近上下文占用 等于 0       # 当前驻留上下文估算（最后一次模型请求上报的 prompt_tokens）
  属性 最近上下文占用来源 等于 ""  # 占用口径：prompt_tokens / 本轮累计（后者是回退口径，帧里会标注）

  段落 构造:
    设 己.会话表 为 {}
    设 己.令牌会话表 为 {}
    设 己.计量器 为 新建 令牌计量器(取默认模型())
    设 配 为 新建 压缩配置()
    设 己.压缩管理器 为 配
    设 己.上下文窗口 为 配.上下文窗口
    设 己.权限管理器 为 新建 权限管理器()
    设 己.审批管理器 为 新建 审批管理器()
    设 己.事件推送队列 为 []
     # T-0397：保持 空（类属性默认），首次读时从 <根>/session-modes.json 懒加载（重启可恢复）
     #   （不在构造里预置空表，否则新实例读不到磁盘；与 会话模型表 同口径）
    # R42：webhook 装配（秘密/上限走环境变量，派发记录默认空）
    设 己.钩子秘密 为 环境变量("HARNESS_WEBHOOK_SECRET", 环境变量("GITHUB_WEBHOOK_SECRET", ""))
    设 己.钩子体上限 为 转整数(环境变量("HARNESS_WEBHOOK_MAX_BODY", "1000000"))
    设 己.钩子派发记录 为 []
    设 己.预设注册表缓存 为 {}
    # T-0407：续跑台账 / 排队闸门 / 最近一轮细节（跨线程共享，必须单例）
    设 己.续跑表 为 {}
    设 己.计划命令表 为 {}
    设 己.队列闸门 为 空
    # T-0490：排队唤醒兜底载具表（主线程写，唤醒线程读；只存最近一轮的载具引用）
    设 己.排队载具表 为 {}
    设 己.唤醒线程 为 空
    设 己.最近轮次细节 为 空
    设 己.最近轮次数 为 0
    设 己.最近压缩条数 为 0
    # T-0441：本轮生效的组合串与方法 id（统计帧回报，旧字段不动）
    设 己.最近模式 为 ""
    设 己.最近方法 为 ""
    # T-0466：统计帧口径初值（模型未知 → 分母回退环境默认，占用回退本轮累计）
    设 己.最近统计模型 为 ""
    设 己.最近上下文占用 为 0
    设 己.最近上下文占用来源 为 ""

  # 装配：注入客户端（真实或 mock）+ 注册表 + 持久化根 + 静态目录，起 HTTP 服务端
  #   界面目录：绝对路径字符串；"" 表示不启用静态路由（向后兼容老调用，仍 4 参）
  #   R41（任务2）：绑定地址 / 令牌 留空 → 读环境变量（HARNESS_BIND / HARNESS_TOKEN，
  #       后者兼容既有 HARNESS_WEB_TOKEN）；显式传入则覆盖。安全铁律：绑非 loopback
  #       且无令牌 → 拒绝启动（硬报错，不警告了事）。
  段落 配置(客户端对象, 注册表, 根, 超时值, 界面目录="", 配置元数据=空, 环境文件路径="", 绑定地址="", 令牌=""):
    # 兼容旧调用：绑定地址/令牌 留空 → 读环境变量
    如果 绑定地址 == "" 或 绑定地址 == 空:
      设 绑定地址 为 环境变量("HARNESS_BIND", "127.0.0.1")
    如果 令牌 == "" 或 令牌 == 空:
      设 令牌 为 环境变量("HARNESS_TOKEN", 环境变量("HARNESS_WEB_TOKEN", ""))
    # 安全铁律：绑非 loopback 且无令牌 → 拒绝启动
    如果 非 (是回环地址(绑定地址)) 且 (令牌 == "" 或 令牌 == 空):
      抛出 新建 错误("安全铁律：绑定非 loopback 地址(" + 绑定地址 + ") 但未设置 HARNESS_TOKEN，拒绝启动（暴露到局域网必须有令牌）")
    设 己.客户端对象 为 客户端对象
    设 己.注册表 为 注册表
    设 己.根 为 根
    设 己.超时值 为 超时值
    设 己.界面目录 为 界面目录
    设 己.绑定地址 为 绑定地址
    设 己.令牌 为 令牌
    如果 配置元数据 == 空:
      设 己.配置元数据 为 []
    否则:
      设 己.配置元数据 为 配置元数据
    设 己.环境文件路径 为 环境文件路径
    # 工作目录：settings.json 键 "工作目录" 持久化；缺省空（回落启动目录/HARNESS_CWD）
    设 己.生效工作目录 为 ""
    如果 己.根 != "" 且 己.根 != 空:
      设 存值目录 为 己.读已存设置()
      如果 字典包含键(存值目录, "工作目录") 且 是字符串(存值目录["工作目录"]):
        设 校验目录 为 断言可用(存值目录["工作目录"])
        如果 校验目录["ok"] == 真:
          设 己.生效工作目录 为 校验目录["路径"]
    # T-0426：固定端口（HARNESS_WEB_PORT）——给人用的 GUI 需要稳定地址。
    #   缺省 0 保持内核分配（并行门禁/示例依赖这一点，不能改默认）。
    #   指定端口被占用时不放弃启动，回退内核分配并在启动日志说明。
    # 环境变量优先；其次 .env（键盘/常驻部署写在 .env 里就够，不必改启动脚本）
    设 端口串 为 环境变量("HARNESS_WEB_PORT", "")
    如果 端口串 == "" 或 端口串 == 空:
      设 端口串 为 转字符串(读取环境文件值("HARNESS_WEB_PORT"))
    设 己.请求端口 为 0
    设 己.端口回退 为 ""
    如果 端口串 != "" 且 端口串 != 空:
      设 试端口 为 0
      尝试:
        设 试端口 为 int(端口串)
      捕获 异常 e:
        设 试端口 为 0
      如果 试端口 > 0 且 试端口 <= 65535:
        设 己.请求端口 为 试端口
      否则:
        设 己.端口回退 为 "HARNESS_WEB_PORT 不是合法端口（" + 端口串 + "），改用内核分配"
    如果 己.请求端口 > 0:
      尝试:
        设 己.服务端 为 新建 HTTP服务端(路由处理器, 超时值, 绑定地址, 己.请求端口)
      捕获 异常 占用错误:
        设 己.端口回退 为 "端口 " + 转字符串(己.请求端口) + " 不可用（" + 转字符串(占用错误) + "），改用内核分配"
        设 己.服务端 为 新建 HTTP服务端(路由处理器, 超时值, 绑定地址)
    否则:
      设 己.服务端 为 新建 HTTP服务端(路由处理器, 超时值, 绑定地址)

  # E2：注入会话存储实例（JSONL + 索引）。可在 配置() 前后任意时点调用；
  #   会话库 为空时 /api/sessions* 路由返回 503（不启用），/v1/chat/completions 行为不变。
  段落 设置会话库(会话库):
    设 己.会话库 为 会话库

  # R42：webhook 装配接口（供测试/宿主注入；秘密与体上限默认走环境变量）
  段落 设置钩子秘密(值):
    设 己.钩子秘密 为 值

  段落 设置钩子体上限(值):
    设 己.钩子体上限 为 值

  段落 清空钩子派发():
    设 己.钩子派发记录 为 []
    设 己.预设注册表缓存 为 {}

  段落 钩子派发数():
    返回 长(己.钩子派发记录)

  # 热更新客户端（配置保存后调用；不重建 HTTP 服务端，端口不变）
  段落 更新客户端(客户端对象, 配置元数据=空):
    设 己.客户端对象 为 客户端对象
    如果 配置元数据 != 空:
      设 己.配置元数据 为 配置元数据

  # 内核分配端口（HTTP服务端 构造即 bind(("127.0.0.1", 0))）
  段落 端口():
    返回 己.服务端.端口()

  段落 停止():
    如果 己.服务端 != 空:
      己.服务端.停止()

  # 404 JSON（沿用现有 404 格式：JSON + application/json）
  段落 响应404(路由):
    返回 ["状态": 404, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未找到: " + 路由, "type": "not_found"]])]

  # 静态页面路由（W3 契约 1、4）：仅支持文本资源，文件不存在 → 404（不抛 500）
  #   界面目录 == "" → 未启用 → 一律 404（向后兼容）；静态目录一律用传入路径，不外推当前目录()
  段落 处理静态(路径):
    如果 己.界面目录 == "" 或 己.界面目录 == 空:
      返回 己.响应404(路径)
    设 文件名 为 ""
    设 类型 为 ""
    如果 路径 == "/":
      设 文件名 为 "index.html"
      设 类型 为 "text/html; charset=utf-8"
    否则 如果 路径 == "/app.js":
      设 文件名 为 "app.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/style.css":
      设 文件名 为 "style.css"
      设 类型 为 "text/css; charset=utf-8"
    否则 如果 路径 == "/sidebar.js":
      设 文件名 为 "sidebar.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/messages.js":
      设 文件名 为 "messages.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/tool-card.js":
      设 文件名 为 "tool-card.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/settings.js":
      设 文件名 为 "settings.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/settings.css":
      设 文件名 为 "settings.css"
      设 类型 为 "text/css; charset=utf-8"
    否则 如果 路径 == "/slash-palette.js":
      设 文件名 为 "slash-palette.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/new-session.js":
      设 文件名 为 "new-session.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/index.html":
      设 文件名 为 "index.html"
      设 类型 为 "text/html; charset=utf-8"
    否则:
      返回 己.响应404(路径)
    设 全路径 为 路径连接(己.界面目录, 文件名)
    如果 文件存在(全路径) == 假:
      返回 己.响应404(路径)
    设 内容 为 读取文件(全路径)
    返回 ["状态": 200, "头": ["Content-Type": 类型], "体": 内容]

  # T-0395：校验请求携带的会话级工作目录。
  # 契约：字典获取(载荷, "工作目录", "") → ["ok":真, "路径":绝对路径] 或 ["ok":假, "理由":...]
  # 红线：相对路径一律拒绝（避免被进程 cwd 偷换语义）；不存在/不是目录/不可读走 断言可用。
  段落 校验请求工作目录(目录):
    如果 目录 == 空 或 目录 == "":
      返回 ["ok": 真, "路径": ""]
    如果 是字符串(目录) == 假:
      返回 ["ok": 假, "理由": "工作目录必须是字符串路径"]
    如果 是绝对路径(目录) == 假:
      返回 ["ok": 假, "理由": "工作目录必须是绝对路径: " + 目录]
    设 校验 为 断言可用(目录)
    如果 校验["ok"] == 假:
      返回 校验
    返回 ["ok": 真, "路径": 校验["路径"]]

  # T-0395：会话目录解析顺序 = 请求目录 → 会话库索引元数据 → 全局设置 → HARNESS_CWD → 当前目录。
  # 已有会话的磁盘日志首行 cwd 由 读入会话 还原，这里不覆盖它；索引只用于定位日志/新会话。
  段落 解析会话目录(标识, 请求目录):
    # 只有新会话才用请求目录：续写已有会话时首行 cwd/索引元数据是权威，
    # 请求目录不能改掉会话属性（防止旧会话被新请求“搬根”）。
    如果 标识 == "" 且 请求目录 != "" 且 请求目录 != 空:
      返回 请求目录
    如果 己.会话库 != 空:
      设 元数据 为 己.会话库.取元数据(标识)
      如果 元数据 != 空 且 字典包含键(元数据, "工作目录"):
        设 记 为 元数据["工作目录"]
        如果 记 != 空 且 记 != "":
          返回 记
    设 目录候选 为 环境变量("HARNESS_CWD", 空)
    如果 己.生效工作目录 != "" 且 己.生效工作目录 != 空:
      设 目录候选 为 己.生效工作目录
    返回 解析工作目录(目录候选, 当前目录())

  # 会话管理：空标识 → 新会话；有标识 → 内存缓存 → 磁盘续写（读入会话）→ 无则新建
  # T-0395：请求目录（已由 校验请求工作目录 校验）写入**新会话**头信息；
  #   续写已有会话时以磁盘首行 cwd / 索引元数据为准，全局设置不得覆盖。
  段落 取会话(标识, 请求目录 = ""):
    设 生效目录 为 己.解析会话目录(标识, 请求目录)
    如果 标识 == "":
      设 新标识 为 "web_" + 转字符串(时间戳())
      # T-0395：有会话库时用同一个 web_ id 登记索引，重启后仍可按会话解析 cwd；
      #   无会话库时不落盘（未启用持久化的行为一字不变）。
      如果 己.会话库 != 空:
        设 元数据 为 己.会话库.登记会话(新标识, "新会话", 生效目录)
      设 新会话 为 新建会话(新标识, 生效目录)
      己.会话表[新标识] 为 新会话
      返回 新会话
    # T-0490：显式 session_id（脚本/前端指定）也要登记到会话库——
    #   否则 /api/sessions/:id 永远返回空壳（用户切回会话历史空白），
    #   排队结果也无处落。只在元数据缺失时补登记，不动既有会话。
    如果 标识 != "" 且 己.会话库 != 空:
      尝试:
        如果 己.会话库.取元数据(标识) == 空:
          设 忽略登记 为 己.会话库.登记会话(标识, "新会话", 生效目录)
      捕获 异常 e:
        设 忽略登记失败 为 空
    如果 己.会话表.包含(标识):
      返回 己.会话表[标识]
    设 会话对象 为 空
    尝试:
      设 会话对象 为 读入会话(己.根, 生效目录, 标识)
    捕获 异常 e:
      设 会话对象 为 新建会话(标识, 生效目录)
    己.会话表[标识] 为 会话对象
    返回 会话对象

  # 提取最后一条用户消息的文本（content 为字符串或 OpenAI 多模态文本片段列表）
  段落 提取用户文本(消息表):
    设 结果 为 ""
    遍历 消息 之 消息表:
      如果 是字典(消息) 且 消息.获取("role", "") == "user":
        设 内容 为 消息.获取("content", "")
        如果 是字符串(内容):
          设 结果 为 内容
        否则 如果 是列表(内容):
          设 拼接 为 ""
          遍历 部分 之 内容:
            如果 是字典(部分) 且 部分.获取("type", "") == "text":
              设 拼接 为 拼接 + 部分.获取("text", "")
          设 结果 为 拼接
    返回 结果

  # 生成非流式对话响应 JSON
  段落 生成对话JSON(会话对象, 模型, 结果):
    设 全文 为 取最终文本(会话对象)
    设 输入 为 结果.获取("输入token", 0)
    设 输出 为 结果.获取("输出token", 0)
    返回 序列化JSON(["id": "chatcmpl-web-" + 转字符串(时间戳()), "object": "chat.completion", "model": 模型, "choices": [["index": 0, "message": ["role": "assistant", "content": 全文], "finish_reason": "stop"]], "usage": ["prompt_tokens": 输入, "completion_tokens": 输出, "total_tokens": 输入 + 输出]])

  # 生成 SSE 流式体：角色块 → 内容增量/工具事件（按序号混排）→ 结束块 → [DONE]
  #   起始序号：只回放 序号 >= 起始序号 的事件；0 = 不限制（回放全部，老调用行为不变）
  #   E5：在结束块之后、[DONE] 之前追加「统计」事件，包含本轮输入/输出、累计总数、花费、上下文使用率
  #   E3：把会话事件 tool/call、tool/result 映射为契约 1 帧（种类=工具调用/工具结果），
  #       与文本增量按事件序号稳定排序混排，驱动前端工具卡片；结尾追加「会话」帧绑定 E2 会话
  段落 生成SSE(会话对象, 模型, 起始序号 = 0):
    设 行表 为 []
    行表.追加(["id": "chatcmpl-web-" + 转字符串(时间戳()), "object": "chat.completion.chunk", "model": 模型, "choices": [["index": 0, "delta": ["role": "assistant", "content": ""], "finish_reason": 空]]])
    设 混排表 为 []
    设 有增量 为 假
    # 文本增量帧（assistant/chunk → OpenAI delta）
    设 块事件表 为 会话对象.查询事件("assistant/chunk", 起始序号, 0)
    遍历 记录 之 块事件表:
      设 块 为 记录["数据"]["chunk"]
      如果 块["type"] == "text-delta" 且 块["text"] != "":
        混排表.追加(["序号": 记录["序号"], "帧": ["choices": [["index": 0, "delta": ["content": 块["text"]], "finish_reason": 空]]]])
        设 有增量 为 真
    # 工具调用事件 → 契约 1「工具调用」帧（参数为模型原始 arguments 文本）
    设 调用事件表 为 会话对象.查询事件("tool/call", 起始序号, 0)
    遍历 记录 之 调用事件表:
      设 调用数据 为 记录["数据"]
      混排表.追加(["序号": 记录["序号"], "帧": ["种类": "工具调用", "工具名": 调用数据.获取("name", ""), "参数": 调用数据.获取("arguments", ""), "轮次": 调用数据.获取("turn", 0), "调用id": 调用数据.获取("callId", ""), "序号": 记录["序号"]]])
    # 工具结果事件 → 契约 1「工具结果」帧（经 源序号 关联调用事件回填工具名）
    设 结果事件表 为 会话对象.查询事件("tool/result", 起始序号, 0)
    遍历 记录 之 结果事件表:
      设 结果数据 为 记录["数据"]
      设 结果消息 为 结果数据.获取("消息", 空)
      设 源序号 为 结果数据.获取("源序号", 0)
      设 工具名 为 ""
      遍历 候选记录 之 调用事件表:
        如果 候选记录["序号"] == 源序号:
          设 候选数据 为 候选记录["数据"]
          设 工具名 为 候选数据.获取("name", "")
      设 内容文本 为 ""
      设 调用id文本 为 ""
      设 是否错误 为 假
      如果 结果消息 != 空:
        设 是否错误 为 结果消息.获取("isError", 假)
        # content 是块表：取 tool-result 块的 toolCallId 与内容；text 块拼接为可读文本，
        # 非块表内容序列化兜底（原先把块表原样塞进「结果」，UI 渲染不出文本）
        设 内容块表 为 结果消息.获取("content", [])
        遍历 块 之 内容块表:
          如果 type(块) == dict 且 块.包含("type") 且 块["type"] == "tool-result":
            设 调用id文本 为 块.获取("toolCallId", 调用id文本)
            设 块内 为 块.获取("content", "")
            如果 type(块内) == list:
              遍历 子块 之 块内:
                如果 type(子块) == dict 且 子块.包含("type") 且 子块["type"] == "text":
                  设 内容文本 为 内容文本 + 子块.获取("text", "")
            否则:
              设 内容文本 为 序列化JSON(块内)
      设 错误文本 为 ""
      如果 是否错误 == 真:
        设 错误文本 为 "执行出错"
      混排表.追加(["序号": 记录["序号"], "帧": ["种类": "工具结果", "工具名": 工具名, "结果": 内容文本, "错误": 错误文本, "是否错误": 是否错误, "调用id": 调用id文本, "序号": 记录["序号"]]])
    # 按事件序号稳定排序（插入排序；光明无 lambda，不用 sort(key=)；压缩后表序≠序号序）
    设 混排表 为 己.排序SSE帧(混排表)
    遍历 项 之 混排表:
      行表.追加(项["帧"])
    # 无增量兜底：整段最终文本
    如果 有增量 == 假:
      设 全文 为 取最终文本(会话对象)
      如果 全文 != "":
        行表.追加(["choices": [["index": 0, "delta": ["content": 全文], "finish_reason": 空]]])
    行表.追加(["choices": [["index": 0, "delta": {}, "finish_reason": "stop"]]])
    # E5：追加统计事件（T-0407：补 开始/完成/耗时/速率/轮次数）
    设 统计 为 己.生成统计事件()
    # T-0453：压缩帧不能是最后一帧 —— 先推压缩，再推统计与 [DONE]，
    #   顺序固定为 压缩 → 统计 → 会话 → [DONE]（与 推流实现 一致）。
    如果 己.最近压缩条数 > 0:
      行表.追加(己.生成压缩事件(己.最近压缩条数, 统计["上下文使用率"]))
    行表.追加(统计)
    # E4：追加待审批事件（本轮产生的审批请求通过 SSE 推送给前端）
    遍历 审批项 之 己.审批管理器.全部待审批():
      行表.追加(己.生成审批事件(审批项))
    # E3：会话标识帧（前端据此绑定 E2 会话，驱动侧边栏联动）
    行表.追加(["种类": "会话", "session_id": 会话对象.标识])
    设 输出 为 ""
    遍历 项 之 行表:
      设 输出 为 输出 + "data: " + 序列化JSON(项) + "\n\n"
    设 输出 为 输出 + "data: [DONE]\n\n"
    返回 输出

  # E3：混排帧按 序号 稳定排序（插入排序，返回新列表，不改入参）
  段落 排序SSE帧(项表):
    设 结果 为 []
    遍历 项 之 项表:
      结果.追加(项)
    设 n 为 长(结果)
    设 i 为 1
    当 i < n:
      设 当前 为 结果[i]
      设 j 为 i - 1
      当 j >= 0 且 结果[j]["序号"] > 当前["序号"]:
        结果[j + 1] 为 结果[j]
        设 j 为 j - 1
      结果[j + 1] 为 当前
      设 i 为 i + 1
    返回 结果

  # T-0466：解析「分母」——当前会话模型真实的上下文窗口。
  #   旧口径拿 压缩E5 的 HARNESS_MODEL_CONTEXT_WINDOW 缺省值 32768 当窗口，
  #   而 buddy/hy4flash-free 在模型目录里是 1,000,000 → 同一个占用被放大 30 倍，
  #   于是界面上出现 928% 这种「假爆满」。
  #   取数顺序（都不联网）：
  #     1) 内置模型目录 contextWindow（客户端.按ID取模型）；
  #     2) 已缓存的 jet-hub 模型目录（只读 己.枢纽模型缓存，绝不在这里触发 15s 探测）；
  #     3) 环境变量窗口（压缩E5 的 HARNESS_MODEL_CONTEXT_WINDOW，即 己.上下文窗口）；
  #     4) 保守缺省 32768。
  #   返回 ["窗口": 正整数, "来源": 模型目录/jet-hub/环境默认/保守缺省]，来源随统计帧上报。
  段落 取显示窗口(模型ID):
    设 窗口 为 0
    设 来源 为 ""
    设 有模型 为 假
    如果 是字符串(模型ID) == 真:
      如果 模型ID != "":
        设 有模型 为 真
    # 1) 内置目录
    如果 有模型 == 真:
      设 条 为 按ID取模型(模型ID)
      如果 是字典(条) == 真:
        设 窗口 为 转整数(字典获取(条, "contextWindow", 0))
        如果 窗口 > 0:
          设 来源 为 "模型目录"
    # 2) jet-hub 已缓存目录（精确 id 优先，再比 "/" 后的裸名，如 buddy/hy4flash-free → hy4flash-free）
    如果 窗口 <= 0 且 有模型 == 真 且 是列表(己.枢纽模型缓存) == 真:
      设 裸名 为 模型ID
      设 段表 为 分割字符串(模型ID, "/")
      如果 长度(段表) > 0:
        设 裸名 为 段表[长度(段表) - 1]
      遍历 条目 之 己.枢纽模型缓存:
        如果 是字典(条目) == 假:
          继续
        如果 窗口 > 0:
          继续
        设 条目ID 为 转字符串(字典获取(条目, "id", ""))
        设 命中 为 假
        如果 条目ID == 模型ID:
          设 命中 为 真
        如果 命中 == 假 且 裸名 != "" 且 条目ID == 裸名:
          设 命中 为 真
        如果 命中 == 真:
          设 窗口 为 转整数(字典获取(条目, "上下文窗口", 0))
          如果 窗口 > 0:
            设 来源 为 "jet-hub"
          否则:
            设 窗口 为 0
    # 3) 环境默认（压缩配置同源）
    如果 窗口 <= 0:
      设 窗口 为 转整数(己.上下文窗口)
      如果 窗口 > 0:
        设 来源 为 "环境默认"
    # 4) 保守缺省
    如果 窗口 <= 0:
      设 窗口 为 32768
      设 来源 为 "保守缺省"
    返回 ["窗口": 窗口, "来源": 来源]

  # T-0466：重算「分子」——当前驻留上下文的估算。
  #   口径：最后一次模型请求上报的 prompt_tokens（会话事件 assistant/message 里最新一条 用量["输入"]）。
  #   为什么不累加：代理.light:779 的 本轮输入token 是**一轮内所有 step/工具往返**的累加，
  #     10 步工具往返就翻十倍，它不是「现在上下文里有多少 token」。
  #   取不到上报时保持 0，由 生成统计事件 回退到「本轮累计」并在帧里标注口径。
  段落 重算上下文占用(会话对象):
    设 占用 为 0
    设 来源 为 ""
    如果 会话对象 != 空:
      尝试:
        设 记录表 为 会话对象.查询事件("assistant/message", 0, 0)
        如果 是列表(记录表) == 真:
          设 i 为 长度(记录表) - 1
          设 找到 为 假
          当 i >= 0 且 找到 == 假:
            设 记录 为 记录表[i]
            设 数据 为 字典获取(记录, "数据", 空)
            如果 是字典(数据) == 真:
              设 用量 为 字典获取(数据, "用量", 空)
              如果 是字典(用量) == 真:
                设 输入 为 转整数(字典获取(用量, "输入", 0))
                如果 输入 > 0:
                  设 占用 为 输入
                  设 来源 为 "prompt_tokens"
                  设 找到 为 真
            设 i 为 i - 1
      捕获 异常 e:
        设 占用 为 0
        设 来源 为 ""
    设 己.最近上下文占用 为 占用
    设 己.最近上下文占用来源 为 来源
    返回 占用

  # T-0466：使用率封顶（0..100，保留 1 位小数）。超出不再显示 928% 这种数字。
  段落 封顶使用率(数值):
    设 值 为 转浮点(数值)
    如果 值 < 0:
      设 值 为 0.0
    如果 值 > 100:
      设 值 为 100.0
    设 百分比 为 转浮点(整数(值 * 10.0 + 0.5)) / 10.0
    返回 百分比

  # E5：生成统计事件字典（本轮输入/输出、累计总数、花费、上下文使用率）
  #   T-0466 口径整改：
  #     分母 = 当前会话模型的真实上下文窗口（取显示窗口），帧里带「上下文窗口」「窗口来源」；
  #     分子 = 当前驻留上下文（重算上下文占用 落下的 prompt_tokens），帧里带「上下文占用」「占用口径」；
  #     使用率 = 封顶 100（前端另有同口径兜底）。
  段落 生成统计事件:
    设 本轮 为 己.计量器.本轮统计()
    设 累计 为 己.计量器.累计统计()
    设 本轮总 为 本轮["本轮输入"] + 本轮["本轮输出"]
    设 累计总 为 累计["累计输入"] + 累计["累计输出"]
    设 窗口信息 为 己.取显示窗口(己.最近统计模型)
    设 窗口 为 字典获取(窗口信息, "窗口", 0)
    设 占用 为 己.最近上下文占用
    设 口径 为 己.最近上下文占用来源
    # 回退口径：没有模型侧上报（命令面 / mock 客户端 / 老会话）时用本轮累计，并如实标注
    如果 占用 <= 0:
      设 占用 为 本轮总
      设 口径 为 "本轮累计"
    设 使用率 为 0
    如果 窗口 > 0:
      设 使用率 为 (转浮点(占用) * 100.0) / 转浮点(窗口)
    设 使用率 为 己.封顶使用率(使用率)
    设 花费 为 累计["累计花费"]
    设 统计 为 ["种类": "统计", "本轮输入": 本轮["本轮输入"], "本轮输出": 本轮["本轮输出"], "累计总": 累计总, "花费": 花费, "上下文使用率": 使用率]
    设 统计["上下文窗口"] 为 窗口
    设 统计["窗口来源"] 为 字典获取(窗口信息, "来源", "")
    设 统计["上下文占用"] 为 占用
    设 统计["占用口径"] 为 口径
    # T-0407 需求四：会话细节（开始/完成/耗时/速率）——纯逻辑在 会话细节，本层只回填
    如果 己.最近轮次细节 != 空:
      设 统计 为 时补统计字段(统计, 己.最近轮次细节)
    # T-0453：结束原因必须**每帧都在**且落在四值闭集内（completed/max-steps/max-tokens/aborted/error）。
    #   取自本轮落定的 最近轮次细节["结束原因"]（时从轮次结果取细节 已归一）；
    #   没有本轮细节（命令面、/compact 等）时按 completed —— 那些帧本来就没有「跑停」含义，
    #   但前端只要看到统计帧就会去读这个键，缺键比缺省值更难查。
    设 结束原因值 为 "completed"
    如果 己.最近轮次细节 != 空 且 是字典(己.最近轮次细节) == 真:
      设 结束原因值 为 时规范结束原因(字典获取(己.最近轮次细节, "结束原因", "completed"))
    设 统计["结束原因"] 为 结束原因值
    设 统计["轮次数"] 为 己.最近轮次数
    # T-0425：本轮生效的单轮步数上限（0 = 本请求未经过 处理对话，如命令面）
    如果 己.最近步数上限 > 0:
      设 统计["步数上限"] 为 己.最近步数上限
      设 统计["步数上限来源"] 为 己.最近步数上限来源
    # T-0441：模式（组合串）/ 方法（方法 id）——只增字段，不改旧键
    如果 己.最近模式 != 空 且 己.最近模式 != "":
      设 统计["模式"] 为 己.最近模式
      设 统计["方法"] 为 己.最近方法
    返回 统计

  # 第5步：按请求 preset 取注册表（带缓存）。
  #   空 preset → 启动默认表（己.注册表，HARNESS_PRESET 环境变量口径不变）；
  #   已知预设 → 首次 组装注册表(预设) 后缓存，切换后首轮及以后每轮都运行在新挂载组合下；
  #   未知预设 → 返回 空，由调用方回 400。
  段落 取预设注册表(预设标识):
    如果 预设标识 == 空 或 预设标识 == "":
      返回 己.注册表
    # T-0441：缓存键必须是规范化组合串，否则 ptc+brainstorm 与裸 ptc 会串味
    设 解 为 解析组合(预设标识)
    如果 解["ok"] == 假:
      返回 空
    设 组合键 为 组合串(解["代理"], 解["方法"])
    如果 组合键 == "":
      返回 空
    如果 己.预设注册表缓存 == 空:
      设 己.预设注册表缓存 为 {}
    如果 字典包含键(己.预设注册表缓存, 组合键):
      返回 字典获取(己.预设注册表缓存, 组合键, 空)
    设 表 为 组装注册表(组合键, 己.根)
    设 己.预设注册表缓存[组合键] 为 表
    返回 表

  # 归一化预设(预设值, 方法值) -> {"ok", "组合", "模式", "方法", "错误"}
  #   两维都空 → 组合为 ""（沿用启动默认表，旧语义）；显式方法覆盖 preset 的方法维。
  段落 归一化预设(预设值, 方法值):
    设 代理 为 "standard"
    设 方法 为 "default"
    如果 预设值 != 空 且 预设值 != "":
      设 解 为 解析组合(预设值)
      如果 解["ok"] == 假:
        返回 {"ok": 假, "组合": "", "模式": "", "方法": "", "错误": 解["错误"]}
      设 代理 为 解["代理"]
      设 方法 为 解["方法"]
    如果 方法值 != 空 且 方法值 != "":
      如果 列表包含(工作方法清单(), 方法值) == 假:
        返回 {"ok": 假, "组合": "", "模式": "", "方法": "", "错误": "未知工作方法: " + 方法值}
      设 方法 为 方法值
    设 组合 为 组合串(代理, 方法)
    返回 {"ok": 真, "组合": 组合, "模式": 代理, "方法": 方法, "错误": ""}

  # ---- T-0407 收口接线：队列/续跑/压缩/细节 的小工具（只调前置模块，不重造规则）----
  段落 取队列闸门:
    如果 己.队列闸门 == 空:
      设 己.队列闸门 为 队建闸门()
    # T-0490：第一次用到闸门时起一条兜底唤醒线程（每 2s 扫一次孤儿待办）。
    #   主路径仍是 T-0453 的「释放方拉起」，这里只补「链条被延长」的兜底。
    如果 己.唤醒线程 == 空:
      设 己.唤醒线程 为 新建 线程(排队唤醒循环, 己)
      己.唤醒线程.开始()
    返回 己.队列闸门

  段落 取续跑状态(标识):
    # 注：launch 必须 先于 使用；空标识不建表（旧"new session"路径不占台账）
    如果 标识 == "":
      返回 空
    如果 己.续跑表 == 空:
      设 己.续跑表 为 {}
    如果 字典包含键(己.续跑表, 标识) == 假:
      返回 空
    返回 字典获取(己.续跑表, 标识, 空)

  段落 存续跑状态(标识, 状态):
    如果 标识 == "":
      返回 假
    如果 己.续跑表 == 空:
      设 己.续跑表 为 {}
    设 己.续跑表[标识] 为 状态
    返回 真

  段落 建会话目标(标识, 描述, 轮数上限 = 续默认最大轮数):
    # /goal <描述> 是目标续跑的唯一入口：先立 goal 视图，再由 续续跑决策 驱动后续轮次
    # --max-rounds 把会话级轮数预算写进 maxGoalRounds，决策层与宿主循环都读它。
    设 上限 为 轮数上限
    如果 是整数(上限) == 假 或 上限 < 1:
      设 上限 为 续默认最大轮数
    设 视图 为 ["id": "goal-" + 标识, "revision": 1, "objective": 描述, "phase": "active", "maxGoalRounds": 上限, "roundsStarted": 0, "createdAt": 时间戳(), "updatedAt": 时间戳(), "activation": "armed"]
    设 状态 为 续建续跑状态(视图, {})
    设 忽略1 为 己.存续跑状态(标识, 状态)
    设 忽略2 为 挂目标台账(状态)
    返回 状态

  段落 合并台账到状态(状态):
    # 模型调 目标 工具后，代理已把 新状态 写回进程台账；这里取回台账里的目标视图再并入状态
    如果 状态 == 空:
      返回 空
    设 台账 为 取目标台账()
    如果 是字典(台账) == 假:
      返回 状态
    设 台账目标 为 字典获取(台账, "目标", 空)
    如果 是字典(台账目标) == 假:
      返回 状态
    返回 续合并目标变更(状态, 台账目标)

  段落 造压缩配置:
    # 与 T-0402 代理循环 的 压缩配置 同口径：窗口来自 HARNESS_MODEL_CONTEXT_WINDOW
    返回 ["上下文窗口": 己.上下文窗口, "阈值比例": 0.75, "保留条数": 10]

  段落 生成压缩事件(裁剪条数, 利用率):
    返回 ["种类": "压缩", "上下文利用率": 利用率, "裁剪条数": 裁剪条数]

  段落 数检查点(会话对象, 起始序号):
    # 自动压缩的产物是 compact-checkpoint 用户消息；按本轮新增事件计数，0 = 本轮没压缩
    设 计数 为 0
    遍历 记录 之 会话对象.查询事件("user/message", 起始序号, 0):
      设 数据 为 字典获取(记录, "数据", 空)
      如果 是字典(数据) == 假:
        继续
      设 来源 为 字典获取(数据, "来源", 空)
      如果 是字典(来源) == 假:
        继续
      如果 字典获取(来源, "kind", "") == "compact-checkpoint":
        设 计数 为 计数 + 1
    返回 计数

  段落 取末条助手文本(会话对象):
    设 结果 为 ""
    设 消息表 为 会话对象.整理消息()
    设 i 为 长度(消息表) - 1
    当 i >= 0:
      设 消息 为 消息表[i]
      如果 消息["role"] == "assistant":
        遍历 块 之 消息["content"]:
          如果 块["type"] == "text":
            设 结果 为 块["text"] + 结果
        跳出
      设 i 为 i - 1
    返回 去除空白(结果)

  # T-0407 需求二：/compact 服务端命令入口（不调模型、不消耗轮次）
  #   决策走 压缩策略.压判断触发（入口=手动 → 无条件触发，目标token 取 窗口×0.16），
  #   压缩动作走 压缩.light.压缩到最近（token 口径 + 工具配对保护），产物是 compact-checkpoint。
  段落 处理压缩命令(会话对象, 会话标识, 保存前序号, 流式):
    设 配置 为 己.造压缩配置()
    设 决策 为 压判断触发(["入口": "手动", "估算token": 0], 配置)
    设 目标token 为 字典获取(决策, "目标token", 0)
    设 前表 为 会话对象.整理消息()
    设 前token 为 估算token(前表)
    设 前条数 为 长度(前表)
    设 后表 为 压缩到最近(会话对象, 10, 空, 目标token)
    设 后token 为 估算token(后表)
    设 裁剪 为 前条数 - 长度(后表)
    如果 裁剪 < 0:
      设 裁剪 为 0
    设 利用率 为 0
    # T-0466：这里的利用率是给界面看的占比，分母同样取真实模型窗口并封顶 100
    #   （压缩目标token 仍走 造压缩配置 的窗口，预算口径不变）
    设 压缩窗口 为 字典获取(己.取显示窗口(己.最近统计模型), "窗口", 0)
    如果 压缩窗口 > 0:
      设 利用率 为 己.封顶使用率((转浮点(后token) * 100.0) / 转浮点(压缩窗口))
    设 忽略保存 为 空
    尝试:
      设 忽略保存 为 增量保存(己.根, 会话对象, 保存前序号)
    捕获 异常 e:
      返回 错误响应(500, "会话保存失败: " + 转字符串(e))
    设 己.最近压缩条数 为 裁剪
    设 事件 为 己.生成压缩事件(裁剪, 利用率)
    如果 流式 == 真:
      设 体 为 "data: " + 序列化JSON(事件) + "\n\n" + "data: " + 序列化JSON(己.生成统计事件()) + "\n\n" + "data: [DONE]\n\n"
      返回 ["状态": 200, "头": ["Content-Type": "text/event-stream; charset=utf-8"], "体": 体]
    设 体 为 序列化JSON(["状态": "已压缩", "裁剪条数": 裁剪, "压缩前token": 前token, "压缩后token": 后token, "上下文利用率": 利用率])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]

  # T-0420：从会话事件折出 {active,pending,text,title}；读失败回安全空态。
  段落 取计划状态(标识):
    设 空态 为 {"active": 假, "pending": 假, "text": "", "title": ""}
    如果 标识 == "" 或 标识 == 空:
      返回 空态
    尝试:
      设 会话对象 为 己.取会话(标识, "")
      设 事件表 为 会话对象.汇集全部事件()
      返回 折叠计划状态(事件表)
    捕获 异常 e:
      返回 空态

  # T-0420：/plan 与 /plan off —— 命令不是消息，不调模型、不消耗轮次。
  #   落 command/run + command/done + plan/mode 三个事件，投影层据此折 active。
  段落 处理计划命令(会话对象, 标识, 保存前序号, 开, 流式):
    如果 己.队列闸门 != 空 且 队是否忙(己.队列闸门, 标识) == 真:
      返回 错误响应(409, "会话运行中：等本轮结束再切换计划模式")
    设 事件表 为 会话对象.汇集全部事件()
    设 编号 为 "plan-" + 转字符串(时间戳()) + "-" + 转字符串(长(事件表))
    设 参 为 "on"
    如果 开 == 假:
      设 参 为 "off"
    设 忽略1 为 会话对象.记录事件("command/run", ["name": "plan", "commandId": 编号, "args": 参])
    设 忽略2 为 会话对象.记录事件("command/done", ["commandId": 编号, "kind": "success"])
    设 忽略3 为 会话对象.记录事件("plan/mode", ["active": 开])
    字典设置(己.计划命令表, 标识, 编号)
    尝试:
      设 忽略保存 为 增量保存(己.根, 会话对象, 保存前序号)
    捕获 异常 e:
      返回 错误响应(500, "会话保存失败: " + 转字符串(e))
    设 状态 为 折叠计划状态(会话对象.汇集全部事件())
    如果 流式 == 真:
      设 体 为 "data: " + 序列化JSON(["种类": "计划", "plan": 状态]) + "\n\n" + "data: [DONE]\n\n"
      返回 ["状态": 200, "头": ["Content-Type": "text/event-stream; charset=utf-8"], "体": 体]
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "ok", "会话": 标识, "plan": 状态])]

  # 出口工具与进入命令配对；进程重启后表丢了就现造一个 commandId（投影仍自洽）。
  段落 取计划命令编号(标识):
    如果 己.计划命令表.包含(标识):
      返回 己.计划命令表[标识]
    设 编号 为 "plan-exit-" + 转字符串(时间戳())
    字典设置(己.计划命令表, 标识, 编号)
    返回 编号

  # POST /v1/chat/completions：解析入参 → 会话 → 跑一轮 → 增量保存 → 非流式 JSON / SSE
  段落 处理对话(请求, 令牌 = "", 查询串 = ""):
    设 队列闸门 为 己.取队列闸门()
    设 排队键 为 ""
    设 已占用 为 假
    尝试:
      设 己.请求数 为 己.请求数 + 1
      设 体字节 为 请求["体"]
      设 文本 为 字符串(体字节, "utf-8")
      设 载荷 为 空
      尝试:
        设 载荷 为 解析JSON(文本)
      捕获 异常 e:
        返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
      如果 载荷 == 空 或 是字典(载荷) == 假:
        返回 错误响应(400, "请求体必须是 JSON 对象")
      设 模型 为 载荷.获取("model", "")
      设 消息表 为 载荷.获取("messages", [])
      如果 是列表(消息表) == 假:
        返回 错误响应(400, "messages 必须是数组")
      设 流式 为 载荷.获取("stream", 假)
      设 会话标识 为 载荷.获取("session_id", "")
      设 会话标识 为 解析会话标识(己, 会话标识, 令牌, 查询串)
      # T-0395：首条消息携带 工作目录 → 惰性建会话时写进头信息；非法目录直接 400
      设 请求目录校验 为 己.校验请求工作目录(字典获取(载荷, "工作目录", ""))
      如果 请求目录校验["ok"] == 假:
        返回 错误响应(400, 请求目录校验["理由"])
      设 请求目录 为 请求目录校验["路径"]
      # 第5步：chat 框模式选择——请求携带 preset（minimal/cordis/standard/ptc），
      #   按第 4 步装配逻辑取该模式的注册表（缓存复用）；空则用启动默认表
      # T-0425：单轮最大步数。请求体可显式指定（前端/脚本），否则读 HARNESS_MAX_STEPS，
      #   再否则 25（旧行为）。非法值不报错打断对话，回落并由统计帧携带实际生效值。
      设 步数解析 为 解析最大步数(字典获取(载荷, "最大步数", 空), 取环境变量("HARNESS_MAX_STEPS", ""))
      设 预设标识 为 载荷.获取("preset", "")
      # T-0441：可选 method（两维正交）。preset 含 "+" 时以组合串为准，否则 preset+method 合成；
      #   两维都空 → 继续用启动默认表。归一化结果只用于装配/缓存/统计，入参原样值另行保留给会话存储。
      设 方法载荷 为 载荷.获取("method", "")
      设 归一化 为 己.归一化预设(预设标识, 方法载荷)
      如果 字典获取(归一化, "ok", 假) == 假:
        返回 错误响应(400, 字典获取(归一化, "错误", "未知 agent preset: " + 预设标识))
      设 组合标识 为 字典获取(归一化, "组合", "")
      如果 组合标识 != "":
        设 预设标识 为 组合标识
      # 会话存储：请求给的是裸 id 就原样存（T-0397 断言），带了 method 才升级成组合串
      设 会话模式存 为 载荷.获取("preset", "")
      如果 方法载荷 != "" 且 (会话模式存 == "" 或 字符串包含(会话模式存, "+") == 假):
        设 会话模式存 为 组合标识
      # 统计帧口径：模式 = 规范化组合串，方法 = 方法维 id
      如果 组合标识 != "":
        设 己.最近模式 为 组合标识
        设 己.最近方法 为 字典获取(归一化, "方法", "default")
      设 本轮注册表 为 己.取预设注册表(预设标识)
      如果 本轮注册表 == 空:
        返回 错误响应(400, "未知 agent preset: " + 预设标识 + "（可用: " + 连接字符串(预设清单(), " / ") + "）")
      设 用户文本 为 己.提取用户文本(消息表)
      # T-0407 需求五：插话通道开关（前端「立即插话」按钮带此请求头）
      设 是插话 为 假
      如果 取头值(请求["头"], "x-lh-interrupt", "") == "1":
        设 是插话 为 真
      # T-0407 需求一/二：命令面（/goal 立目标 → 续跑循环；/compact 手动压缩，不再喂给模型）
      设 立目标 为 假
      设 是压缩命令 为 假
      设 是计划命令 为 假
      设 计划开关 为 真
      设 命令文本 为 去除空白(用户文本)
      设 目标轮数上限 为 续默认最大轮数
      如果 开头(命令文本, "/goal") == 真:
        设 目标命令 为 续解析目标命令(命令文本)
        如果 字典获取(目标命令, "ok", 假) == 假:
          返回 错误响应(400, 字典获取(目标命令, "错误", "用法：/goal [--max-rounds N] <目标描述>"))
        设 目标描述 为 字典获取(目标命令, "描述", "")
        设 目标轮数上限 为 字典获取(目标命令, "最大轮数", 续默认最大轮数)
        设 用户文本 为 目标描述
        设 立目标 为 真
      如果 开头(命令文本, "/compact") == 真:
        设 是压缩命令 为 真
      # T-0420：/plan 或 /plan on 进计划模式；/plan off 退出；其余参数 400。
      如果 开头(命令文本, "/plan") == 真:
        设 计划参 为 去除空白(截取(命令文本, 5, 长度(命令文本)))
        如果 计划参 == "" 或 计划参 == 空:
          设 计划开关 为 真
        否则 如果 计划参 == "on":
          设 计划开关 为 真
        否则 如果 计划参 == "off":
          设 计划开关 为 假
        否则:
          返回 错误响应(400, "用法：/plan 或 /plan off")
        设 是计划命令 为 真
        设 用户文本 为 "/plan"
      如果 用户文本 == "":
        返回 错误响应(400, "messages 缺少用户消息")
      设 会话对象 为 己.取会话(会话标识, 请求目录)
      # T-0470：本线程工具根 = 会话 cwd（Web 层信任设置；并发会话/后台线程各设各的）。
      #   无会话 cwd（空串）时 设置工具根 返回假，取根目录 按旧口径回落 HARNESS_CWD / 当前目录。
      设 忽略工具根 为 设置工具根(会话对象.取工作目录(), 真)
      设 保存前序号 为 事件序号水位(会话对象)
      # 首轮新对话时请求没带 session_id：以服务端生成的会话标识为准（SSE 也回这个 id），
      #   否则「本会话模型」在首轮会记不进去，客户端绑定后一问又回到全局默认。
      设 实际会话标识 为 会话标识
      尝试:
        设 实际会话标识 为 会话对象.标识
      捕获 异常 e:
        设 实际会话标识 为 会话标识
      设 排队键 为 实际会话标识
      # T-0420：/plan 在排队分流之前处理（命令不是消息）；忙时 handler 自己回 409。
      如果 是计划命令 == 真:
        返回 己.处理计划命令(会话对象, 实际会话标识, 保存前序号, 计划开关, 流式)
      # T-0407 需求五：同一会话正在跑（流式或非流式）→ 压缩命令 409，普通消息 202 入队
      #   队列由「持锁的那一轮循环」在轮末出队执行（与续跑共用 当 循环，不另起线程）
      #
      # T-0453：判忙与占位必须**一次原子完成**。
      #   旧写法「先 队是否忙，再（仅非流式）队尝试占用」在两次调用之间没有互斥：
      #   两个并发请求可以同时判到「不忙」，随后一个占位、另一个照样往下跑 ——
      #   同一会话双跑、事件序号交错、落盘重复。改成入口只调一次 队尝试占用：
      #   抢到=空闲（本请求持有占用），抢不到=确实有人在跑（走 202/409 分流）。
      #   空标识（未建会话的首轮）不占位，保持旧行为。
      设 已占用 为 假
      设 当前忙碌 为 假
      如果 排队键 != "" 且 排队键 != 空:
        设 已占用 为 队尝试占用(队列闸门, 排队键)
        如果 已占用 == 假:
          设 当前忙碌 为 真
      如果 当前忙碌 == 真:
        如果 是压缩命令 == 真:
          # 复用 src/压缩命令.light 的可用性判定与排队文案（不另造第二份口径）
          设 压缩判定 为 压缩可用性(真, 假)
          返回 错误响应(409, 字典获取(压缩判定, "原因", "agent running") + "：" + 排队提示文案())
        如果 是插话 == 真:
          设 插话结果 为 队入插话(队列闸门, 排队键, 用户文本)
          如果 字典获取(插话结果, "ok", 假) == 真:
            返回 ["状态": 202, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "插话", "位置": 字典获取(插话结果, "位置", 0), "会话": 排队键])]
          返回 ["状态": 429, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "拒绝", "理由": 字典获取(插话结果, "理由", "插话已满")])]
        设 入队结果 为 队入队(队列闸门, 排队键, ["文本": 用户文本, "流式": 流式, "入队时刻": 时间戳()])
        如果 字典获取(入队结果, "ok", 假) == 真:
          # T-0490：入队回执——写一条可见事件，前端轮询能发现「这条已受理」
          设 忽略入队回执 为 记排队事件(己, 实际会话标识, 用户文本, "排队中")
          设 排队体 为 序列化JSON(["状态": "排队", "位置": 字典获取(入队结果, "位置", 0), "会话": 排队键, "深度": 队排队深度(队列闸门, 排队键), "上限": 队上限(队列闸门)["待办"], "超时秒": 队待办超时秒])
          返回 ["状态": 202, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 排队体]
        返回 ["状态": 429, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "拒绝", "理由": 字典获取(入队结果, "理由", "队列已满")])]
      # 上面的分流里 已占用 一定是「抢到的占用」；没抢到才进 202/409 分支。
      # T-0407：流式请求也由本人持有占用，但所有权在起线程时**转交 后台跑一轮**：
      #   它在本轮（含续跑/排队）真正跑完时释放，而不是等 SSE 尾帧发完再释放。
      #   T-0453 之所以改这条：压缩提示帧属于尾帧，用户看到「已触发上下文压缩」时
      #   本轮其实早跑完了；旧口径下这一刻会话仍被占着，紧接着发的「继续」被判忙
      #   → 202 入队，而入队时那一轮的 当 循环已经跳出 → 这条永远没人取。
      #   （直调处理器且不消费流的自测不受影响：占用由后台线程在本轮结束时释放。）
      # ---- 本会话模型（对齐 DSH：每个会话单独选模型）----
      # ---- T-0397：每轮把「实际生效」的预设写回会话记录 ----
      #   请求带 preset/权限预设 → 写进该会话；续写会话未带 → 保留已存（切回仍还原）。
      设 请求权限预设 为 字典获取(载荷, "权限预设", "")
      如果 请求权限预设 == 空:
        设 请求权限预设 为 ""
      设 本轮写模式 为 会话模式存
      设 本轮写权限 为 请求权限预设
      如果 本轮写模式 != "" 且 是已知预设(本轮写模式) == 假:
        设 本轮写模式 为 ""
      如果 本轮写权限 != "" 且 是权限预设(本轮写权限) == 假:
        设 本轮写权限 为 ""
      # 只写「请求里真的带了」的那一项：空串在 设会话模式设置 里表示「显式回到全局默认」，
      #   不能拿它冒充「本轮没带」——否则续写会话一轮就把另一项（如权限）抹成空。
      设 待写模式 为 空
      如果 本轮写模式 != "":
        设 待写模式 为 本轮写模式
      设 待写权限 为 空
      如果 本轮写权限 != "":
        设 待写权限 为 本轮写权限
      如果 实际会话标识 != "" 且 实际会话标识 != 空:
        如果 待写模式 != 空 或 待写权限 != 空:
          己.设会话模式设置(实际会话标识, 待写模式, 待写权限)
          # 头信息只增：写进会话对象，随持久化落盘（旧会话读回没有这两键也不报错）
          尝试:
             如果 本轮写模式 != "":
               会话对象.头信息["模式"] 为 本轮写模式
             如果 本轮写权限 != "":
               会话对象.头信息["权限预设"] 为 本轮写权限
          捕获 异常 e:
             设 头忽略 为 空
      设 本轮权限预设 为 己.取会话权限预设(实际会话标识)
      #   优先级：请求 model > 该会话已存模型 > 全局配置（.env/启动配置）> 内置默认。
      设 本轮模型 为 ""
      如果 己.配置元数据 != 空 且 是字典(己.配置元数据):
        设 本轮模型 为 字典获取(己.配置元数据, "model", "")
      如果 本轮模型 == "" 或 本轮模型 == 空:
        设 本轮模型 为 取默认模型()
      如果 模型 != "" 且 模型 != 空:
        设 本轮模型 为 模型
      否则:
        设 已存模型 为 己.取会话模型(实际会话标识)
        如果 已存模型 != "" 且 已存模型 != 空:
          设 本轮模型 为 已存模型
      # 请求显式带 model → 记到该会话（下一轮/重开/切回都能恢复）
      如果 实际会话标识 != "" 且 实际会话标识 != 空 且 模型 != "" 且 模型 != 空:
        己.设会话模型(实际会话标识, 模型)
      # 同一端点/密钥、只换 model 的临时客户端（jet-hub 的多 provider 共用同一个网关）
      设 本轮客户端 为 己.客户端对象
      设 当前端点 为 ""
      如果 己.配置元数据 != 空 且 是字典(己.配置元数据):
        设 当前端点 为 字典获取(己.配置元数据, "endpoint", "")
      设 当前密钥 为 ""
      尝试:
        设 当前密钥 为 己.客户端对象.密钥
      捕获 异常 e:
        设 当前密钥 为 ""
      如果 当前端点 != "" 且 当前密钥 != "" 且 当前密钥 != 空:
        设 本轮客户端 为 新建 客户端(当前端点, 当前密钥, 本轮模型)
      # E5：切换模型（保持计量器与客户端一致）
      己.计量器.设置模型(本轮模型)
      己.计量器.重置本轮()
      # T-0466：统计帧分母按「本轮真正用的模型」取 contextWindow（不是压缩阈值默认值）
      设 己.最近统计模型 为 本轮模型
      # T-0397：按会话权限预设注入闸门（无会话级设置时空 → 走原无闸门路径）
      设 本轮选项 为 ["增量回调": 空]
      # T-0407 需求二：压缩配置从死代码变活——每轮塞进代理选项，step 前自动压缩生效
      字典设置(本轮选项, "压缩配置", 己.造压缩配置())
      # T-0425：把本轮的步数上限交给代理循环（此前恒为代理类属性默认 25）
      字典设置(本轮选项, "最大步数", 字典获取(步数解析, "值", 25))
      设 己.最近步数上限 为 字典获取(步数解析, "值", 25)
      设 己.最近步数上限来源 为 字典获取(步数解析, "来源", "缺省")
      # T-0420：plan 模式只认会话事件折出的 active（不再让 topdown 默认触发写拦截）
      设 会话计划 为 己.取计划状态(实际会话标识)
      如果 会话计划["active"] == 真:
        字典设置(本轮选项, "计划模式", 真)
        设 计划段 为 计划提示文本()
        如果 计划段 != "":
          字典设置(本轮选项, "计划模式提示", 计划段)
      设 本轮闸门 为 己.取会话权限闸门(实际会话标识)
      如果 本轮闸门 != 空:
        字典设置(本轮选项, "审批管理器", 本轮闸门)
      # T-0407 需求二：/compact 是命令不是消息——不消耗模型轮次，直接压缩并回压缩事件帧
      如果 是压缩命令 == 真:
        返回 己.处理压缩命令(会话对象, 实际会话标识, 保存前序号, 流式)
      # T-0407 需求一：/goal 立目标（占用后再建，避免并发两次立目标）
      设 续跑状态 为 己.取续跑状态(实际会话标识)
      如果 立目标 == 真:
        设 续跑状态 为 己.建会话目标(实际会话标识, 用户文本, 目标轮数上限)
      # T-0407 需求一：只在「本会话有目标」时挂 目标 工具（不污染其它会话的工具集）
      如果 续跑状态 != 空:
        # 工具注册表.执行 只回 content/isError/concludesTurn，会裁掉 变更/新状态 →
        #   execute 用本会话闭包：变更落 goal/change 事件、新状态回写台账（续跑决策的输入）
        段落 记录目标执行(参数):
          设 目标结果 为 目标工具处理(参数, 空)
          设 变更载荷 为 字典获取(目标结果, "变更", 空)
          如果 变更载荷 != 空:
            设 忽略目标事件 为 会话对象.记录事件("goal/change", 变更载荷)
          设 新目标状态 为 字典获取(目标结果, "新状态", 空)
          如果 新目标状态 != 空:
            设 忽略目标台账 为 挂目标台账(新目标状态)
          返回 目标结果
        设 目标规格 为 续目标工具规格()
        设 目标定义 为 造工具定义(目标规格["name"], 目标规格["description"], 目标规格["parameters"], 记录目标执行)
        # 预设装配返回的是 兼容注册表 包装（无 注册 方法），要落到其 内部表
        尝试:
          设 忽略目标注册 为 本轮注册表.注册(目标定义)
        捕获 异常 e:
          设 内部注册表 为 本轮注册表.内部表
          设 忽略目标注册2 为 内部注册表.注册(目标定义)
      # T-0420：plan 模式只挂出口工具；事件由本会话闭包落库（工具注册表会裁掉 plan/title）
      如果 会话计划["active"] == 真:
        段落 记录计划退出(参数):
          设 计划结果 为 计划工具处理为结果(参数)
          如果 计划结果["ok"] == 真:
            设 计划编号 为 己.取计划命令编号(实际会话标识)
            设 忽略4 为 会话对象.记录事件("command/done", ["commandId": 计划编号, "kind": "success"])
            设 忽略5 为 会话对象.记录事件("plan/mode", ["active": 假])
            设 忽略6 为 会话对象.记录事件("plan/submitted", ["plan": 计划结果["plan"], "title": 计划结果["title"]])
          返回 {"content": 计划结果["content"], "concludesTurn": 真, "isError": 计划结果["isError"]}
        设 计划规格 为 计划工具规格()
        设 计划定义 为 造工具定义(计划规格["name"], 计划规格["description"], 计划规格["parameters"], 记录计划退出)
        尝试:
          设 忽略计划注册 为 本轮注册表.注册(计划定义)
        捕获 异常 e:
          设 内部计划表 为 本轮注册表.内部表
          设 忽略计划注册2 为 内部计划表.注册(计划定义)
      # 实时推送（流式请求）：先建队列与增量回调，再丢后台线程跑一轮，
      #   本协程边收帧边发；非流式走下面的同步路径，行为完全不变。
      如果 流式 == 真:
        # T-0453：占用所有权转交 后台跑一轮（本轮真正跑完即释放，不等 SSE 尾帧）。
        #   本协程自己不留占用：它返回后由 HTTP 层推帧，那一段不需要会话锁。
        设 转交占用 为 已占用
        设 已占用 为 假
        返回 己.造流式响应(本轮客户端, 本轮注册表, 会话对象, 用户文本, 本轮模型, 保存前序号, 会话标识, 本轮闸门, 本轮选项, 续跑状态, 队列闸门, 排队键, 转交占用)
      设 结果 为 空
      设 续轮 为 0
      设 续跑轮数 为 0
      设 当轮文本 为 用户文本
      设 保存序号 为 保存前序号
      当 真:
        设 开始时刻 为 时间戳()
        尝试:
          设 结果 为 跑一轮(本轮客户端, 本轮注册表, 会话对象, 当轮文本, 本轮选项)
        捕获 异常 e:
          返回 错误响应(500, "驱动失败: " + 转字符串(e))
        # T-0407 需求四：每轮把耗时/速率细节留给统计帧；轮次数用于「续跑真的跑了 2 轮」判据
        设 己.最近轮次细节 为 时从轮次结果取细节(结果, 开始时刻)
        设 续跑轮数 为 续跑轮数 + 1
        设 己.最近轮次数 为 续跑轮数
        设 己.最近压缩条数 为 己.数检查点(会话对象, 保存序号)
        # T-0466：使用率分子改口径——取最后一次模型请求上报的 prompt_tokens 作为当前驻留上下文
        设 忽略占用 为 己.重算上下文占用(会话对象)
        # E5：记录响应（输入/输出 token 与花费）
        如果 结果 != 空 且 type(结果) == dict:
          己.计量器.记录响应(结果)
        如果 结果 != 空 且 结果.包含("种类") 且 结果["种类"] == "error":
          返回 错误响应(500, 转字符串(结果["失败"]))
        尝试:
          增量保存(己.根, 会话对象, 保存序号)
        捕获 异常 e:
          返回 错误响应(500, "会话保存失败: " + 转字符串(e))
        设 保存序号 为 事件序号水位(会话对象)
        # ---- T-0407 需求一：续跑决策（先续跑；不续跑才看队列）----
        设 续续了 为 假
        如果 续跑状态 != 空:
          设 续跑状态 为 己.合并台账到状态(续跑状态)
          设 续跑状态 为 续记账(续跑状态, 结果)
          设 决策 为 续续跑决策(续跑状态, 结果)
          设 忽略存 为 己.存续跑状态(实际会话标识, 续跑状态)
          如果 字典获取(决策, "动作", "") == 续动作续跑 且 续轮 < 续取上限(续跑状态):
            设 下轮文本 为 字典获取(决策, "提示文本", "")
            如果 是字符串(下轮文本) == 假:
              设 下轮文本 为 ""
            如果 下轮文本 != "":
              设 当轮文本 为 下轮文本
              设 续轮 为 续轮 + 1
              设 续续了 为 真
        如果 续续了 == 真:
          继续
        # ---- T-0407 需求五：插话优先于排队；两者都在同一个 当 循环里跑，不另起线程 ---- 
        设 插话文本 为 队取插话(队列闸门, 排队键)
        如果 是字符串(插话文本) == 假:
          设 插话文本 为 ""
        如果 插话文本 == "":
          设 待办项 为 队出队(队列闸门, 排队键)
          如果 是字典(待办项) == 真:
            设 插话文本 为 字典获取(待办项, "文本", "")
          否则:
            设 插话文本 为 ""
        如果 插话文本 != "" 且 续轮 < 续取上限(续跑状态):
          设 当轮文本 为 插话文本
          设 续轮 为 续轮 + 1
          继续
        跳出
      # T-0407 需求四：完成时刻落库（会话列表显示「完成时间」）
      如果 己.会话库 != 空 且 实际会话标识 != "":
        尝试:
          设 忽略完成 为 记完成时间(己.会话库, 实际会话标识, 时格式化完整时刻(时间戳()))
        捕获 异常 e:
          设 完成忽略 为 空
      # E2：每轮对话同时持久化到 JSONL 会话（会话库为空则跳过，行为不变）
      如果 己.会话库 != 空:
        设 持久化错误 为 ""
        # 本轮工具事件（只取 保存前序号 之后的）：下面持久化与 SSE 都要用。
        # 此前这两张表只在 生成SSE 内部定义，这里直接引用 → NameError → 500
        # （「处理对话异常: name '调用事件表' is not defined」）。
        设 调用事件表 为 会话对象.查询事件("tool/call", 保存前序号, 0)
        设 结果事件表 为 会话对象.查询事件("tool/result", 保存前序号, 0)
        尝试:
          己.会话库.追加消息(实际会话标识, ["角色": "user", "内容": 用户文本])
        捕获 异常 e:
          设 持久化错误 为 转字符串(e)
        尝试:
          己.会话库.追加消息(实际会话标识, ["角色": "assistant", "内容": 取最终文本(会话对象)])
        捕获 异常 e:
          设 持久化错误 为 转字符串(e)
        # 工具调用/结果也持久化（角色 tool-call / tool-result，内容为结构化字典序列化），
        # 供前端重放会话时还原工具卡片与时间线（本轮新增：工具面板回放增强）。
        遍历 记录 之 调用事件表:
          设 调用数据 为 记录["数据"]
          设 工具载荷 为 ["工具名": 调用数据.获取("name", ""), "参数": 调用数据.获取("arguments", ""),
            "调用id": 调用数据.获取("callId", ""), "轮次": 调用数据.获取("turn", 0)]
          尝试:
            己.会话库.追加消息(实际会话标识, ["角色": "tool-call", "内容": 序列化JSON(工具载荷)])
          捕获 异常 e:
            设 持久化错误 为 转字符串(e)
        遍历 记录 之 结果事件表:
          设 结果数据 为 记录["数据"]
          设 结果消息 为 结果数据.获取("消息", 空)
          设 源序号 为 结果数据.获取("源序号", 0)
          # T-0408：落库与 生成SSE 同口径 ——
          #   tool/result 的正文在下一层：顶层块 type 是 "tool-result"，
          #   可读文本在 块["content"] 的子块（type=="text"）里。
          #   旧实现只扫顶层 type=="text"，于是「结果」恒为空串、调用 id 也没回填。
          #   工具名按 源序号 关联 tool/call 事件回填（生成SSE 的现成写法）。
          设 工具名文本 为 ""
          遍历 候选记录 之 调用事件表:
            如果 候选记录["序号"] == 源序号:
              设 工具名文本 为 候选记录["数据"].获取("name", "")
          设 结果文本 为 ""
          设 结果错误 为 假
          设 调用id文本 为 ""
          如果 结果消息 != 空:
            设 结果错误 为 结果消息.获取("isError", 假)
            设 结果内容 为 结果消息.获取("content", [])
            如果 type(结果内容) == list:
              设 命中工具块 为 假
              遍历 块 之 结果内容:
                如果 type(块) == dict 且 块.获取("type", "") == "tool-result":
                  设 命中工具块 为 真
                  设 调用id文本 为 块.获取("toolCallId", 调用id文本)
                  设 块内 为 块.获取("content", "")
                  如果 type(块内) == list:
                    遍历 子块 之 块内:
                      如果 type(子块) == dict 且 子块.获取("type", "") == "text":
                        设 结果文本 为 结果文本 + 子块.获取("text", "")
                  否则:
                    设 结果文本 为 序列化JSON(块内)
              # 非 tool-result 形状（顶层直接就是 text 块）：保留旧口径，别把正文丢掉
              如果 命中工具块 == 假:
                遍历 块 之 结果内容:
                  如果 type(块) == dict 且 块.获取("type", "") == "text":
                    设 结果文本 为 结果文本 + 块.获取("text", "")
            否则:
              设 结果文本 为 序列化JSON(结果内容)
          设 错误文本 为 ""
          如果 结果错误 == 真:
            设 错误文本 为 "执行出错"
          设 结果载荷 为 ["工具名": 工具名文本, "结果": 结果文本, "错误": 错误文本, "是否错误": 结果错误, "调用id": 调用id文本]
          尝试:
            己.会话库.追加消息(实际会话标识, ["角色": "tool-result", "内容": 序列化JSON(结果载荷)])
          捕获 异常 e:
            设 持久化错误 为 转字符串(e)
        如果 持久化错误 != "":
          返回 错误响应(500, "会话持久化失败: " + 持久化错误)
      # E2：首条用户消息驱动标题生成（标题仍为默认值时更新）
      如果 己.会话库 != 空:
        尝试:
          设 当前元数据 为 己.会话库.取元数据(实际会话标识)
          如果 当前元数据 != 空 且 当前元数据.获取("标题", "") == "新会话":
            设 新标题 为 生成标题([{"角色": "user", "内容": 用户文本}])
            如果 新标题 != "" 且 新标题 != "新会话":
              己.会话库.更新标题(实际会话标识, 新标题)
        捕获 异常 e:
          设 标题忽略 为 空
      如果 流式 == 真:
        # E3：只回放本轮事件（保存前序号之后），避免同会话续聊重放历史
        设 体 为 己.生成SSE(会话对象, 本轮模型, 保存前序号)
        返回 ["状态": 200, "头": ["Content-Type": "text/event-stream; charset=utf-8"], "体": 体]
      设 体 为 己.生成对话JSON(会话对象, 本轮模型, 结果)
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]
    捕获 异常 e:
      返回 错误响应(500, "处理对话异常: " + 转字符串(e))
    最终:
      # T-0470：请求收尾必须清掉本线程工具根，避免线程复用时串到下一个会话
      设 忽略清根 为 清除工具根()
      # 排队占用必须整段请求结束后才释放；流式请求会把所有权转交后台线程（见 造流式响应）
      如果 已占用 == 真:
        设 忽略释放 为 队释放占用(队列闸门, 排队键)
  # ---- 实时推流：流式对话响应 ----
  # 做法：后台线程跑完整的 跑一轮 + 持久化（与同步路径同一套逻辑），
  #   增量回调把每块翻译成 SSE 帧投进线程安全队列；本协程（HTTP 连接侧）
  #   边取边 等待 流发送 → 浏览器逐字收到，而不是等整轮跑完才出字。
  # 返回响应字典带 "流响应" 键，HTTP服务端 会按 chunked 边发边收口。
  段落 造流式响应(本轮客户端, 本轮注册表, 会话对象, 用户文本, 本轮模型, 保存前序号, 会话标识, 本轮闸门=空, 本轮选项=空, 续跑状态=空, 队列闸门=空, 排队键="", 占用=假):
    设 队列 为 新建 实时队列()
    # 增量回调（在后台线程里被调用）：模型流块 → SSE 帧。
    #   文本增量走 choices[].delta.content，推理增量走 delta.reasoning_content
    #   （前端折叠展示）——长任务里模型长时间只产推理，不推就等于黑屏。
    段落 收块(块):
      如果 是字典(块) == 假:
        返回 真
      设 帧表 为 流块转增量帧(块)
      遍历 帧 之 帧表:
        队列.投递(帧)
      返回 真
    # 工具帧回调：工具调用/结果在**执行当时**入队，工具卡片立刻出现
    段落 收工具帧(帧):
      如果 是字典(帧) == 假:
        返回 真
      队列.投递(帧)
      返回 真
    # 任务控制帧（工具状态变化）走同一条流推给前端
    段落 收控制帧(帧):
      队列.投递(帧)
      返回 真
    # 运行项开在客户端连接侧：/api/task/* 立刻能看见（不等后台线程第一帧）
    设 忽略开运行 为 开运行(排队键, 收控制帧)
    设 载具 为 ["客户端": 本轮客户端, "注册表": 本轮注册表, "会话": 会话对象,
      "文本": 用户文本, "模型": 本轮模型, "保存前序号": 保存前序号,
      "会话标识": 会话标识, "队列": 队列, "收块": 收块, "收工具帧": 收工具帧, "服务": 己, "闸门": 本轮闸门,
      "选项": 本轮选项, "续跑": 续跑状态, "队列闸门": 队列闸门, "排队键": 排队键, "占用": 占用]
    # T-0490：登记本会话载具，供兜底唤醒线程拉起孤儿待办（同一会话串行）
    如果 排队键 != "" 且 排队键 != 空:
      己.排队载具表[排队键] 为 载具
    设 工作线程 为 新建 线程(后台跑一轮, 载具)
    工作线程.开始()
    设 响应 为 ["状态": 200, "头": ["Content-Type": "text/event-stream; charset=utf-8"]]
    响应["流响应"] 为 推流实现
    响应["载具"] 为 载具
    响应["服务"] 为 己
    响应["工作线程"] 为 工作线程
    返回 响应

  # ---- 每个会话单独的模型选择（对齐 DSH chat 框下的模型选择器）----
  #   存储：<根>/session-models.json（{会话id: 模型id}）；空串/无记录 = 跟随全局配置。
  #   ⛔ 只存模型 id，不存密钥；响应不含密钥明文。
  段落 读会话模型表():
    如果 己.会话模型表 != 空 且 是字典(己.会话模型表):
      返回 己.会话模型表
    设 表 为 {}
    如果 己.根 != "" 且 己.根 != 空:
      设 全路径 为 路径连接(己.根, "session-models.json")
      如果 文件存在(全路径) == 真:
        尝试:
          设 读入 为 解析JSON(读取文件(全路径))
          如果 是字典(读入):
            设 表 为 读入
        捕获 异常 e:
          设 表 为 {}
    设 己.会话模型表 为 表
    返回 表

  段落 写会话模型表():
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    尝试:
      写入文件(路径连接(己.根, "session-models.json"), 序列化JSON(己.会话模型表))
      返回 真
    捕获 异常 e:
      返回 假

  段落 取会话模型(标识):
    如果 标识 == "" 或 标识 == 空:
      返回 ""
    设 表 为 己.读会话模型表()
    返回 字典获取(表, 标识, "")

  段落 设会话模型(标识, 模型):
    如果 标识 == "" 或 标识 == 空:
      返回
    设 表 为 己.读会话模型表()
    字典设置(表, 标识, 模型)
    设 己.会话模型表 为 表
    设 忽略 为 己.写会话模型表()

  # ---- T-0397：每个会话单独的模式 / 权限预设（对齐 DSH 切换会话即恢复）----
  #   存储：<根>/session-modes.json（{会话id: {"模式":..,"权限预设":..}}）。
  #   只增不改：没有会话级设置时表项为 {}，读侧回退全局默认（standard + 按类别），旧数据不迁移。
  段落 读会话模式表():
    如果 己.会话模式表 != 空 且 是字典(己.会话模式表):
      返回 己.会话模式表
    设 表 为 {}
    如果 己.根 != "" 且 己.根 != 空:
      设 全路径 为 路径连接(己.根, "session-modes.json")
      如果 文件存在(全路径) == 真:
        尝试:
          设 读入 为 解析JSON(读取文件(全路径))
          如果 是字典(读入):
            设 表 为 读入
        捕获 异常 e:
          设 表 为 {}
    设 己.会话模式表 为 表
    返回 表

  段落 写会话模式表():
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    尝试:
      写入文件(路径连接(己.根, "session-modes.json"), 序列化JSON(己.会话模式表))
      返回 真
    捕获 异常 e:
      返回 假

  # 读某会话的模式设置：返回 {"模式":..,"权限预设":..}；无设置返回 {"模式":"","权限预设":""}
  段落 取会话模式设置(标识):
    设 空设置 为 ["模式": "", "权限预设": ""]
    如果 标识 == "" 或 标识 == 空:
      返回 空设置
    设 表 为 己.读会话模式表()
    设 项 为 字典获取(表, 标识, 空)
    如果 项 == 空 或 是字典(项) == 假:
      返回 空设置
    返回 ["模式": 字典获取(项, "模式", ""), "权限预设": 字典获取(项, "权限预设", "")]

  # 写某会话的模式设置（只传的键覆盖；空串 = 跟随全局默认，仍写键保证「刷新/切回能还原」）
  段落 设会话模式设置(标识, 模式=空, 权限预设=空):
    如果 标识 == "" 或 标识 == 空:
      返回
    设 表 为 己.读会话模式表()
    设 项 为 字典获取(表, 标识, 空)
    如果 项 == 空 或 是字典(项) == 假:
      设 项 为 {}
    如果 模式 != 空:
      项["模式"] 为 模式
    如果 权限预设 != 空:
      项["权限预设"] 为 权限预设
    字典设置(表, 标识, 项)
    设 己.会话模式表 为 表
    设 忽略 为 己.写会话模式表()

  # T-0397：按会话预设判定工具权限——并发隔离的核心判据。
  #   先解析该会话实际生效的 权限预设（会话级 > 全局默认），再显式传给
  #   权限管理器.检查 的第三参；绝不改 己.权限管理器.预设（否则多会话互相污染）。
  #   POST /api/permissions 只改 己.权限管理器（默认值），已绑定会话的预设存在 会话模式表，不受影响。
  段落 取会话权限预设(标识):
    设 设置 为 己.取会话模式设置(标识)
    设 会话预设 为 字典获取(设置, "权限预设", "")
    如果 会话预设 != "" 且 会话预设 != 空 且 是权限预设(会话预设) == 真:
      返回 会话预设
    # 无会话级设置：回退全局默认（按类别）
    如果 己.权限管理器 != 空:
      返回 己.权限管理器.当前预设()
    返回 预设按类别

  段落 检查会话权限(标识, 工具名, 参数=空):
    设 生效预设 为 己.取会话权限预设(标识)
    返回 己.权限管理器.检查(工具名, 参数, 生效预设)

   # 造一个「按该会话预设生效」的闸门实例，注入 跑一轮 的 选项["审批管理器"]。
   # 红线：没有会话级权限设置时返回 空 → 走原来的无闸门路径，默认行为一字不变。
   # 每个会话一个实例，显式携带预设，不改全局 权限管理器（并发隔离）。
  段落 取会话权限闸门(标识):
    设 设置 为 己.取会话模式设置(标识)
    设 会话预设 为 字典获取(设置, "权限预设", "")
    如果 会话预设 == "" 或 会话预设 == 空 或 是权限预设(会话预设) == 假:
      返回 空
    返回 新建 会话权限闸门(己.权限管理器, 会话预设)

  # 启动装配用：把外部已拉到的目录直接灌进缓存，省掉起服务时的二次探测
  段落 设置枢纽缓存(表):
    如果 是列表(表) == 假:
      返回
    设 己.枢纽模型缓存 为 表
    设 己.枢纽缓存时刻 为 时间戳()

  # jet-hub 模型目录（带缓存：目录变化慢，冷启动一次可能 15s，不能每个请求都拉）
  #   刷新=真 强制重拉；缓存 120 秒内直接复用。
  段落 取枢纽模型表(刷新):
    设 现在 为 时间戳()
    如果 刷新 == 假 且 己.枢纽缓存时刻 > 0:
      如果 现在 - 己.枢纽缓存时刻 < 120:
        返回 己.枢纽模型缓存
    设 环境表 为 提供商枢纽.取环境表(取环境变量)
    设 状态 为 提供商枢纽.探测(环境表, 15)
    设 表 为 状态["模型"]
    如果 是列表(表) == 假:
      设 表 为 []
    设 己.枢纽模型缓存 为 表
    # 不可用/空目录不缓存：下次请求立即重试（网关可能还没启动或冷启动中）
    如果 状态["可用"] == 真:
      设 己.枢纽缓存时刻 为 现在
    否则:
      设 己.枢纽缓存时刻 为 0
    返回 表

  # GET /api/models?session=<id>[&refresh=1]
  #   -> {"当前": <会话/全局模型>, "模型": [{id,名称,提供商,上下文窗口,来源}]}
  #   来源 = "内置"（客户端.取模型目录）| "jet-hub"（本地提供商枢纽）。
  段落 处理获取模型(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 参数 为 解析查询参数(查询串)
    设 全局 为 ""
    如果 己.配置元数据 != 空 且 是字典(己.配置元数据):
      设 全局 为 字典获取(己.配置元数据, "model", "")
    设 已存 为 ""
    如果 参数.包含("session"):
      设 已存 为 己.取会话模型(参数["session"])
    设 当前 为 全局
    如果 已存 != "" 且 已存 != 空:
      设 当前 为 已存
    设 目录 为 列表创建()
    遍历 条目 之 取模型目录():
      设 行 为 {}
      字典设置(行, "id", 字典获取(条目, "id", ""))
      字典设置(行, "名称", 字典获取(条目, "name", 字典获取(条目, "id", "")))
      字典设置(行, "提供商", "deepseek-official")
      字典设置(行, "上下文窗口", 字典获取(条目, "contextWindow", 0))
      字典设置(行, "来源", "内置")
      列表追加(目录, 行)
    设 刷新 为 假
    如果 参数.包含("refresh") 且 参数["refresh"] == "1":
      设 刷新 为 真
    遍历 条目 之 己.取枢纽模型表(刷新):
      设 行 为 {}
      字典设置(行, "id", 字典获取(条目, "id", ""))
      字典设置(行, "名称", 字典获取(条目, "名称", 字典获取(条目, "id", "")))
      字典设置(行, "提供商", 字典获取(条目, "提供商", "jet-hub"))
      字典设置(行, "上下文窗口", 字典获取(条目, "上下文窗口", 0))
      字典设置(行, "来源", "jet-hub")
      列表追加(目录, 行)
    设 响应体 为 {}
    字典设置(响应体, "当前", 当前)
    字典设置(响应体, "会话", 已存)
    字典设置(响应体, "全局", 全局)
    字典设置(响应体, "模型", 目录)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(响应体)]

  # POST /api/sessions/:id/model body {"模型": "<id>"}（空串 = 跟随全局配置）
  段落 处理设置会话模型(标识, 请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 模型 为 字典获取(载荷, "模型", "")
    如果 模型 == 空:
      设 模型 为 ""
    己.设会话模型(标识, 模型)
    设 响应体 为 {"ok": 1, "模型": 模型}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(响应体)]

   # T-0397：POST /api/sessions/:id/模式权限 body {"模式":..,"权限预设":..}
   #   用户在某会话内切换模式/权限时只写该会话，不改全局管理器（并发隔离）。
   #   空串 = 跟随全局默认（写键，保证切回/刷新还原为「全局默认」态）。
   段落 处理设置会话模式权限(标识, 请求):
     设 己.请求数 为 己.请求数 + 1
     设 体字节 为 请求["体"]
     设 文本 为 字符串(体字节, "utf-8")
     设 载荷 为 空
     尝试:
       设 载荷 为 解析JSON(文本)
     捕获 异常 e:
       返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
     如果 载荷 == 空 或 是字典(载荷) == 假:
       返回 错误响应(400, "请求体必须是 JSON 对象")
     设 新模式 为 字典获取(载荷, "模式", "")
     设 新权限 为 字典获取(载荷, "权限预设", "")
     如果 新模式 == 空:
       设 新模式 为 ""
     如果 新权限 == 空:
       设 新权限 为 ""
     如果 新模式 != "" 且 是已知预设(新模式) == 假:
       返回 错误响应(400, "未知 agent preset: " + 转字符串(新模式))
     如果 新权限 != "" 且 是权限预设(新权限) == 假:
       返回 错误响应(400, "未知权限预设: " + 转字符串(新权限))
     # 只覆盖请求里出现的键：{"权限预设":"全拒绝"} 不该把模式抹成默认；
     #   显式空串（{"权限预设":""}）才是「回到全局默认」，由 设会话模式设置 写空键。
     设 待写模式 为 空
     如果 字典包含键(载荷, "模式"):
       设 待写模式 为 新模式
     设 待写权限 为 空
     如果 字典包含键(载荷, "权限预设"):
       设 待写权限 为 新权限
     己.设会话模式设置(标识, 待写模式, 待写权限)
     设 生效 为 己.取会话模式设置(标识)
     返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["ok": 1, "模式": 字典获取(生效, "模式", ""), "权限预设": 字典获取(生效, "权限预设", "")])]

  # GET /api/config：返回配置状态（不含密钥明文）
  段落 处理获取配置():
    设 己.请求数 为 己.请求数 + 1
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(己.配置元数据)]

  # ---- 工作目录 API：GET/POST /api/cwd ----
  # GET 返回 {"工作目录": <绝对路径或"">, "来源": "设置"|"启动"}；未设置时工作目录为空。
  段落 处理获取工作目录():
    设 己.请求数 为 己.请求数 + 1
    设 现目录 为 己.生效工作目录
    设 来源 为 "设置"
    如果 现目录 == "" 或 现目录 == 空:
      设 来源 为 "启动"
      设 环境目录 为 环境变量("HARNESS_CWD", 空)
      如果 环境目录 != "" 且 环境目录 != 空:
        设 现目录 为 环境目录
      否则:
        设 现目录 为 当前目录()
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"],
      "体": 序列化JSON(["工作目录": 现目录, "来源": 来源])]

  # POST /api/cwd body {"工作目录": <路径>}：校验存在/可读 → 切换进程 cwd → 持久化到 settings.json
  # 成功 200 {"状态":"ok","工作目录":绝对路径}；失败 400 {"错误":理由}。
  段落 处理保存工作目录(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 候选 为 字典获取(载荷, "工作目录", 空)
    如果 候选 == 空 或 是字符串(候选) == 假:
      返回 错误响应(400, "缺少有效的 工作目录 字段")
    设 校验 为 断言可用(候选)
    如果 校验["ok"] == 假:
      设 坏体 为 序列化JSON(["错误": 校验["理由"]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体]
    设 绝对 为 校验["路径"]
    # 切换进程工作目录：让零参 取根目录() 的兜底与工具执行跟随新目录
    尝试:
      切换工作目录(绝对)
    捕获 异常 e:
      设 坏体2 为 序列化JSON(["错误": "切换工作目录失败: " + 转字符串(e)])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体2]
    设 己.生效工作目录 为 绝对
    # 持久化到 settings.json（不影响其他行）
    设 存值 为 己.读已存设置()
    字典设置(存值, "工作目录", 绝对)
    己.写已存设置(存值)
    # 清掉旧会话表，避免后续消息续用到旧 cwd 的会话
    设 己.会话表 为 字典创建()
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"],
      "体": 序列化JSON(["状态": "ok", "工作目录": 绝对])]

  # ---- T-0396：GET /api/cwd/check?工作目录=<urlencoded> 只读校验 ----
  # 契约（卡面「要做什么 2」）：返回 {存在, 是目录, 可读, 绝对路径, 错误}。
  # 红线：**绝不 chdir、绝不写 settings.json**；也不复用 POST /api/cwd（那条会切进程 cwd + 落盘）。
  # 相对路径按服务进程 cwd 解析后回显绝对路径（与 POST 的「必须绝对」不同：校验是只读的，
  #   允许用户把相对路径先照进 chip 看到它落到哪）。
  # 鉴权：与其它 GET 同一口径（路由层白名单已覆盖所有 GET，不经 POST 白名单）。
  # 参数名兼容：既接受 工作目录（与 POST /api/cwd 同名），也接受 路径（卡面字面量）、
  #   path / cwd（ASCII 别名，方便 curl/脚本）。**键与值都要 URL 解码**——
  #   浏览器会把中文参数名百分号编码（?%E5%B7%A5%E4%BD%9C...），只解值会永远匹配不上。
  段落 处理校验工作目录(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 原值 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 部分表 为 分割字符串(查询串, "&")
      遍历 部分 之 部分表:
        如果 部分 == "":
          继续
        设 等号 为 部分.查找("=")
        设 键 为 部分
        设 值 为 ""
        如果 等号 >= 0:
          设 键 为 截取(部分, 0, 等号)
          设 值 为 截取(部分, 等号 + 1, 长(部分))
        设 解键 为 键
        尝试:
          设 解键 为 URL解码(键)
        捕获 异常 e:
          设 解键 为 键
        如果 解键 == "工作目录" 或 解键 == "路径" 或 解键 == "path" 或 解键 == "cwd":
          设 原值 为 值
    # 浏览器/curl 都可能把中文路径百分号编码；解不出就按原样用（不让坏编码变成 500）
    设 候选 为 原值
    尝试:
      设 候选 为 URL解码(原值)
    捕获 异常 e:
      设 候选 为 原值
    设 报错 为 ""
    设 绝对 为 ""
    设 存在 为 假
    设 是目录 为 假
    设 可读 为 假
    如果 候选 == "" 或 候选 == 空:
      设 报错 为 "缺少 工作目录 参数"
    否则:
      # 解析绝对路径：绝对原样、相对按进程 cwd 解析（纯路径运算，不触碰文件系统语义）
      尝试:
        设 绝对 为 绝对路径(候选)
      捕获 异常 e:
        设 绝对 为 ""
        设 报错 为 "路径非法: " + 转字符串(e)
      如果 绝对 != "" 且 绝对 != 空:
        # 三段探测全部只读：路径存在 / 目录存在 / 遍历目录（权限不足 → 遍历抛 → 降级不可读）
        # ⚠ 不用 文件存在（门面里等价 os.path.isfile：目录恒假）；「存在」用 目录存在 兜住，
        #   非目录的普通文件走 文件存在 判「存在但不是目录」。
        设 是目录 为 目录存在(绝对)
        设 是文件 为 文件存在(绝对)
        设 存在 为 是目录
        如果 是目录 == 假 且 是文件 == 真:
          设 存在 为 真
        如果 存在 == 假:
          设 报错 为 "路径不存在: " + 绝对
        否则:
          如果 是目录 == 假:
            设 报错 为 "路径存在但不是目录: " + 绝对
          否则:
            尝试:
              设 项表 为 遍历目录(绝对)
              设 可读 为 真
            捕获 异常 e:
              设 可读 为 假
              设 报错 为 "目录不可读: " + 绝对 + "（" + 转字符串(e) + "）"
    设 响应体 为 {"存在": 存在, "是目录": 是目录, "可读": 可读, "绝对路径": 绝对, "错误": 报错}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(响应体)]

  # ---- 设置持久化（R105 任务线 C）：<持久化根>/settings.json，形状 {行id: 值} ----
  #   落点 = 路径连接(己.根, "settings.json")；己.根 由 配置(客户端对象, 注册表, 根, ...) 第三参注入。
  #   ⚠ 己.根 为空（未装配）→ 降级为「不落盘」：读恒为空字典、写直接返回假，绝不抛异常。
  # 读已存设置() -> 字典；文件不存在 / 坏 JSON / 非字典 → 空字典（绝不抛 500）
  段落 读已存设置():
    设 空表 为 {}
    如果 己.根 == "" 或 己.根 == 空:
      返回 空表
    设 全路径 为 路径连接(己.根, "settings.json")
    如果 文件存在(全路径) == 假:
      返回 空表
    尝试:
      设 文本 为 读取文件(全路径)
      设 表 为 解析JSON(文本)
      如果 是字典(表) == 假:
        返回 空表
      返回 表
    捕获 异常 e:
      返回 空表

  # 写已存设置(表) -> 真假；未装配根 → 假（不落盘、不抛异常）
  段落 写已存设置(表):
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    设 全路径 为 路径连接(己.根, "settings.json")
    尝试:
      写入文件(全路径, 序列化JSON(表))
      返回 真
    捕获 异常 e:
      返回 假

  # 合并已存设置(页结构)：把持久化的 {行id: 值} 覆盖进 通用设置.行集 各行的 "值"。
  #   ⚠ A 线契约：行集为九行模型，第 9 行 shortcuts 类型=按钮、无 "值" 字段 → 跳过不覆盖。
  #   ⚠ 兼容：通用设置 里还没有 行集（A 线未合流的旧形状 {"内置插件": {...}}）→ 原样返回，不报错。
  #     A 线合流后如形状再有变，以任务书 §2 契约为准，本段落只需保证「无行集即原样返回」。
  #   ✅ R105 收口复核（主 agent）：A 线 通用设置块() 产出的确为 {配置文档, 行集}，行集九行、
  #     shortcuts 类型=按钮无「值」字段 —— 与本段落假设一致，无需临时校验器替换。
  段落 合并已存设置(页结构):
    如果 是字典(页结构) == 假:
      返回 页结构
    如果 字典包含键(页结构, "通用设置") == 假:
      返回 页结构
    设 通用 为 页结构["通用设置"]
    如果 是字典(通用) == 假:
      返回 页结构
    如果 字典包含键(通用, "行集") == 假:
      返回 页结构
    设 行集 为 通用["行集"]
    如果 是列表(行集) == 假:
      返回 页结构
    设 存值 为 己.读已存设置()
    设 新集 为 列表创建()
    遍历 行 之 行集:
      如果 是字典(行) == 假:
        列表追加(新集, 行)
      否则:
        设 标识 为 字典获取(行, "id", "")
        设 行类型 为 字典获取(行, "类型", "")
        如果 标识 != "" 且 行类型 != "按钮" 且 字典包含键(存值, 标识) == 真:
          设 覆盖行 为 {}
          遍历 键 之 字典键列表(行):
            如果 键 == "值":
              字典设置(覆盖行, 键, 存值[标识])
            否则:
              字典设置(覆盖行, 键, 行[键])
          列表追加(新集, 覆盖行)
        否则:
          列表追加(新集, 行)
    字典设置(通用, "行集", 新集)
    返回 页结构

  # GET /api/settings：返回设置页结构（四页签 + 各页数据）
  #   通用设置 来自 src/设置页.light（九行行集）；模型/内置插件/Agent预设 三键
  #   R107 任务线 E 起改为 A/B/C 线真实产出（页结构形状不变，仅内容真实化）：
  #     模型      ← 设置模型页.渲染模型页(己.配置元数据)（凭据视图派生，永不回显明文）
  #     内置插件  ← 设置插件页.渲染插件页(内部工具注册表)（会话计数=展平叶子 29/30/6/30）
  #     Agent预设 ← 设置预设页.渲染预设页(已存设置, 开发者工具行值)
  #   返回前仍用 合并已存设置 把 <根>/settings.json 的持久化值合并进 通用设置.行集（R105 语义不变）。
  段落 处理获取设置页():
    设 己.请求数 为 己.请求数 + 1
    设 页结构 为 渲染设置页()
    # ---- 三页真实化（R107 E）----
    设 页结构["模型"] 为 设置页深化.渲染模型页(己.配置元数据)
    # 内置插件页需要内部工具注册表（名单=登记序、描述表含 description 顶键）；
    #   兼容注册表 的 描述表 是 OpenAI wire 形状，须取其 内部表；无 内部表（裸 工具注册表）→ 原样。
    设 插件注册表 为 己.注册表
    如果 插件注册表 == 空:
      设 插件注册表 为 组装注册表(空, 己.根)
    设 内部表 为 插件注册表
    尝试:
      设 内部表 为 插件注册表.内部表
    捕获 异常 e:
      设 内部表 为 插件注册表
    设 页结构["内置插件"] 为 设置页深化.渲染插件页(内部表, "standard", 空)
    设 已存 为 己.读已存设置()
    设 开发者工具值 为 真
    如果 字典包含键(已存, "developerTools"):
      如果 已存["developerTools"] == 假 或 已存["developerTools"] == 0:
        设 开发者工具值 为 假
    设 页结构["Agent预设"] 为 设置页深化.渲染预设页(已存, 开发者工具值)
    设 页结构 为 己.合并已存设置(页结构)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(页结构)]

  # POST /api/config：保存大模型配置到 .env，热更新客户端（端口不变）
  段落 处理保存配置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 密钥 为 载荷.获取("api_key", "")
    设 端点 为 载荷.获取("base_url", "https://api.deepseek.com")
    如果 端点.查找("chat/completions") == -1:
      设 端点 为 端点 + "/chat/completions"
    设 模型 为 载荷.获取("model", 取默认模型())
    如果 密钥 == "" 或 密钥 == 空:
      返回 错误响应(400, "api_key 不能为空")
    # 写 .env（三行；覆盖式写入）
    如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
      设 环境内容 为 "OPENAI_API_KEY=" + 密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
      尝试:
        写入文件(己.环境文件路径, 环境内容)
      捕获 异常 e:
        返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
    # 热更新客户端（真实客户端；端口不变）
    设 新客户端 为 新建 客户端(端点, 密钥, 模型)
    设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
    己.更新客户端(新客户端, 新元数据)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["ok": 1, "message": "配置已保存并热更新", "config": 新元数据])]

  # GET /api/settings/document：设置「配置文档」路径与可用状态 -> {"路径": <串>, "可用": 真假}
  #   R107 任务线 E（P1，R106 遗留纠正）：上游 profile patch 真实路径是
  #   $DSH_HOME/profiles/<profile>/cordis.patch.yml
  #   （packages/boot/app-boot/src/profile.ts:37,40 + :169-175；config-editor/src/index.ts:34,142）。
  #   R106 落的 "<档位>.patch.yml" 文件名与目录分段都不对，本轮修正：
  #     文件名 = 启动配置.补丁文件名（cordis.patch.json，光明 JSON 替代 YAML 的既有偏离）；
  #     目录分段 = 启动配置.资料夹名 + "web"（本仓 Web 运行时 profile 名，沿用 R106）。
  #   ⛔ 保持删除态：不拿 .env 冒充 profile patch；文件不存在 → 路径="" 且 可用=假，不编造绝对路径。
  段落 处理获取设置文档():
    设 己.请求数 为 己.请求数 + 1
    设 profiles目录 为 路径连接(己.根, 启动配置.资料夹名)
    设 web目录 为 路径连接(profiles目录, "web")
    设 全路径 为 路径连接(web目录, 启动配置.补丁文件名)
    设 路径串 为 ""
    设 可用 为 假
    如果 文件存在(全路径) == 真:
      设 路径串 为 全路径
      设 可用 为 真
    设 结果 为 {"路径": 路径串, "可用": 可用, "说明": "~/.dsh/profiles/web/cordis.patch.json 语义"}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/model：模型页配置写回（R107 任务线 E，A 线校验复用）
  #   body {"api_key","base_url","api","display_name","model","models"}（键均可选）：
  #   · 校验全部走 A 线：密钥 校验密钥(明文, 是否已有)（空且已有 → 合法=保持已存）；
  #     models 逐行 校验模型行(行, 既有目录行集)（空 id / 重复 id / 上下文窗口 / 最大输出，逐字消息）。
  #   · api_key 非空才写 .env（三行 OPENAI_API_KEY/BASE_URL/MODEL 兼容不变）并热更新客户端；
  #     空 api_key 不报错、不写 .env（上游语义：留空=保持已存密钥；本仓 .env 为覆盖式三行，
  #     若只重写 端点/模型 行会丢密钥行，故整体跳过——取舍见交付报告）。
  #   · 响应 {"状态":"ok","凭据":{configured,source,writable}}，⛔ 绝不含密钥明文。
  #   · 校验失败 → 400 {"错误": <A 线逐字消息>}。
  段落 处理保存模型配置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    # ---- 凭据现状（是否已有密钥）----
    设 现凭据 为 设置模型页.凭据视图(己.配置元数据)
    设 是否已有 为 现凭据["configured"]
    # ---- 密钥校验（A 线逐字消息）----
    设 密钥 为 字典获取(载荷, "api_key", "")
    设 判密 为 设置模型页.校验密钥(密钥, 是否已有)
    如果 判密["合法"] == 假:
      设 坏密钥体 为 序列化JSON(["错误": 判密["消息"]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏密钥体]
    # ---- 模型行校验（可选键 models；A 线逐字消息）----
    如果 字典包含键(载荷, "models"):
      设 模型行表 为 载荷["models"]
      如果 是列表(模型行表):
        设 既有行 为 设置模型页.模型行集(己.配置元数据)
        遍历 模型行 之 模型行表:
          设 判行 为 设置模型页.校验模型行(模型行, 既有行)
          如果 判行["合法"] == 假:
            设 坏行体 为 序列化JSON(["错误": 判行["消息"]])
            返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏行体]
    # ---- 写 .env + 热更新（api_key 非空才写；响应不含明文）----
    如果 密钥 != "":
      设 端点 为 载荷.获取("base_url", "https://api.deepseek.com")
      如果 端点.查找("chat/completions") == -1:
        设 端点 为 端点 + "/chat/completions"
      设 模型 为 载荷.获取("model", 取默认模型())
      如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
        设 环境内容 为 "OPENAI_API_KEY=" + 密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
        尝试:
          写入文件(己.环境文件路径, 环境内容)
        捕获 异常 e:
          返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
      设 新客户端 为 新建 客户端(端点, 密钥, 模型)
      设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
      己.更新客户端(新客户端, 新元数据)
    # ---- 响应：凭据视图三键（永不回显明文）----
    设 新凭据 为 设置模型页.凭据视图(己.配置元数据)
    设 凭据体 为 {}
    字典设置(凭据体, "状态", "ok")
    字典设置(凭据体, "凭据", 新凭据)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(凭据体)]

  # POST /api/settings：保存单行通用设置 -> body {"行": <行id>, "值": <新值>}
  #   校验：直接调 设置页.校验通用值(行id, 新值) -> {"合法": 真假, "消息": 串}（已实测存在，签名一致）。
  #     未知行id 时 设置页.取通用行 会抛错 → 捕获后按「非法」返回 400，不 500。
  #   合法 → 落盘 <根>/settings.json → 200 {"状态": "ok", "行集": <合并后的完整行集>}；
  #   非法 → 400 {"错误": <校验消息>}（JSON 体，与既有 400 同为 application/json）。
  段落 处理保存设置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 行标识 为 字典获取(载荷, "行", "")
    如果 行标识 == "" 或 行标识 == 空:
      返回 错误响应(400, "缺少 行 字段")
    设 新值 为 字典获取(载荷, "值", 空)
    # ---- R107 任务线 E（C 线写路径）：行=agentPresetDefault → 设为新任务默认 ----
    #   校验与落盘规则只有一套（设置预设页.设为默认预设），⛔ 本层不复制规则；
    #   开发者工具行值从已存设置读（未存默认 真，与通用设置行默认一致）。
    #   非法（未知预设 / 开发者工具为假）→ 400 {"错误": <C 线逐字消息>}；
    #   合法 → 落盘 settings.json（agentPresetDefault 键）→ 200 {"状态":"ok","默认预设":<id>}。
    如果 行标识 == "agentPresetDefault":
      设 已存设置 为 己.读已存设置()
      设 开发者工具值 为 真
      如果 字典包含键(已存设置, "developerTools"):
        如果 已存设置["developerTools"] == 假 或 已存设置["developerTools"] == 0:
          设 开发者工具值 为 假
      设 默认判定 为 设置预设页.设为默认预设(已存设置, 新值, 开发者工具值)
      如果 默认判定["合法"] == 假:
        设 坏默认体 为 序列化JSON(["错误": 默认判定["消息"]])
        返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏默认体]
      己.写已存设置(默认判定["设置"])
      设 好默认体 为 序列化JSON(["状态": "ok", "默认预设": 默认判定["设置"]["agentPresetDefault"]])
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 好默认体]
    设 校验 为 {"合法": 假, "消息": "未校验"}
    尝试:
      设 校验 为 校验通用值(行标识, 新值)
    捕获 异常 e:
      设 校验 为 {"合法": 假, "消息": 转字符串(e)}
    如果 校验["合法"] == 假:
      设 坏体 为 序列化JSON(["错误": 校验["消息"]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体]
    设 存值 为 己.读已存设置()
    字典设置(存值, 行标识, 新值)
    己.写已存设置(存值)
    设 页结构 为 渲染设置页()
    设 页结构 为 己.合并已存设置(页结构)
    设 行集 为 字典获取(页结构["通用设置"], "行集", 列表创建())
    # R106：行=permission 时，落盘之外同步 权限管理器.设置预设(<映射后预设名>)；
    #   响应在原 {"状态":"ok","行集":[...]} 两键之外追加 "权限预设"（向后兼容，不删原键）。
    #   权限管理器 为空（未装配）时跳过联动，不抛异常。
    设 响应表 为 ["状态": "ok", "行集": 行集]
    如果 行标识 == "permission":
      如果 己.权限管理器 != 空:
        设 映射预设 为 设置生效.档位取预设(新值)
        己.权限管理器.设置预设(映射预设)
        字典设置(响应表, "权限预设", 映射预设)
    设 好体 为 序列化JSON(响应表)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 好体]

  # ---- R106 任务线 C：生效设置端点（接线 A 线生效链）----
  # GET /api/settings/effective?系统偏好=light|dark
  #   读已存设置 → 解析可选 系统偏好（缺省 light，非法按 light）→ 取运行时预设
  #   （权限管理器 非空 → 当前预设()，否则 空）→ 设置生效.生效参数(...) → 200 七键对象。
  #   认证：默认所有 GET 放行（:990-993），无需改白名单。
  段落 处理获取生效设置(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 系统偏好 为 "light"
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 字典包含键(参数, "系统偏好") == 真:
        设 系统偏好 为 参数["系统偏好"]
    如果 系统偏好 != "dark":
      设 系统偏好 为 "light"
    设 已存 为 己.读已存设置()
    设 运行时预设 为 空
    如果 己.权限管理器 != 空:
      设 运行时预设 为 己.权限管理器.当前预设()
    设 生效 为 设置生效.生效参数(已存, 系统偏好, 运行时预设)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(生效)]

  # 取快捷键目录（懒加载；R107 任务线 E 起：目录重建后把 <根>/keybindings.json 的
  #   自定义键合并回默认目录（逐条走 快捷键.应用变更，非法绑定静默跳过不阻断），
  #   每次目录生命周期只合并一次（快捷键已合并 标志）。
  段落 取快捷键目录():
    如果 己.快捷键目录 == 空:
      设 己.快捷键目录 为 快捷键.默认目录("other")
      设 己.快捷键已合并 为 假
    如果 己.快捷键已合并 == 假:
      设 己.快捷键已合并 为 真
      设 绑定表 为 己.读快捷键绑定()
      遍历 命令id 之 字典键列表(绑定表):
        设 合并结果 为 快捷键.应用变更(己.快捷键目录, 命令id, 绑定表[命令id], "other")
        如果 合并结果[1] != "错误":
          设 己.快捷键目录 为 合并结果[0]
    返回 己.快捷键目录

  # 读快捷键绑定() -> {命令id: 物理规范串}；文件缺失/坏 JSON/形状不符 → 空表（绝不抛）
  #   形状 {"version":1,"bindings":{<命令id>:<物理规范串>}}
  段落 读快捷键绑定():
    设 空表 为 {}
    如果 己.根 == "" 或 己.根 == 空:
      返回 空表
    设 全路径 为 路径连接(己.根, "keybindings.json")
    如果 文件存在(全路径) == 假:
      返回 空表
    尝试:
      设 表 为 解析JSON(读取文件(全路径))
      如果 是字典(表) == 假:
        返回 空表
      设 绑定 为 字典获取(表, "bindings", {})
      如果 是字典(绑定) == 假:
        返回 空表
      返回 绑定
    捕获 异常 e:
      返回 空表

  # 落盘快捷键(目录) -> 真假：把目录中的自定义行写 <根>/keybindings.json
  #   形状 {"version":1,"bindings":{<命令id>:<物理规范串>}}；无自定义行 → 写空 bindings（文件仍在，
  #   快捷键文档.可用 首次写入后为真）。本仓 落盘包装 在 web服务器 侧完成（src/快捷键.light 属
  #   R106 D 线独占文件，本轮不改——取舍见交付报告）。
  段落 落盘快捷键(目录):
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    设 绑定 为 {}
    遍历 行 之 目录:
      如果 字典获取(行, "是否自定义", 假) == 真:
        字典设置(绑定, 行["id"], 行["当前键"])
    设 载荷 为 {"version": 1, "bindings": 绑定}
    尝试:
      写入文件(路径连接(己.根, "keybindings.json"), 序列化JSON(载荷))
      返回 真
    捕获 异常 e:
      返回 假

  # GET /api/shortcuts → {"文档", "自定义计数", "目录"}（接线 D 线模型）
  段落 处理获取快捷键():
    设 己.请求数 为 己.请求数 + 1
    设 文档 为 快捷键.快捷键文档(己.根)
    设 目录 为 己.取快捷键目录()
    设 计数 为 快捷键.自定义计数(目录)
    设 结果 为 {"文档": 文档, "自定义计数": 计数, "目录": 目录}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/shortcuts：body {"命令":<id>,"键":<键串>} 或 {"重置":真}
  #   走 D 线 应用变更 / 重置全部；成功 200 {"状态":"ok","目录":[...]}；
  #   非法/冲突 400 {"错误":<D 线返回消息>}——文案一律取 D 线，本层不拼上游文案。
  段落 处理保存快捷键(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 目录 为 己.取快捷键目录()
    # 全量重置
    如果 字典包含键(载荷, "重置") == 真 且 载荷["重置"] == 真:
      设 新目录 为 快捷键.重置全部(目录)
      设 己.快捷键目录 为 新目录
      # R107：目录变更落盘（重置 → bindings 空表仍写文件，保持 快捷键文档.可用 语义稳定）
      己.落盘快捷键(新目录)
      设 结果 为 {"状态": "ok", "目录": 新目录}
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]
    设 命令id 为 字典获取(载荷, "命令", "")
    设 键串 为 字典获取(载荷, "键", "")
    如果 命令id == "" 或 命令id == 空:
      返回 错误响应(400, "缺少 命令 字段")
    设 应用 为 快捷键.应用变更(目录, 命令id, 键串, "other")
    如果 应用[1] == "错误":
      设 坏体 为 序列化JSON(["错误": 应用[2]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体]
    设 己.快捷键目录 为 应用[0]
    # R107：目录变更落盘（自定义键写 keybindings.json）
    己.落盘快捷键(应用[0])
    设 结果 为 {"状态": "ok", "目录": 应用[0]}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # ---- R42（任务2）：真实 webhook 端点 —— /webhook/github ----
  #   把 HTTP 请求字典转成 网络钩子GitHub.处理请求 的入参形状：
  #     头表 = {小写名: [单值]}（门禁链按小写名查 x-hub-signature-256 / x-github-delivery / x-github-event）
  #     块表 = [{"字节": UTF-8 字节数, "文本": 体文本}]
  #   状态由门禁链决定：验签通过 → 202 并派发；错误签名 401；非 POST 405；
  #   超大 body 413；非 JSON 415；秘密未配置 503。派发默认只记录不外联（不回调 GitHub）。
  段落 处理webhook(请求):
    设 体字节 为 请求["体"]
    设 头字典 为 请求["头"]
    设 头表 为 造钩子头表(头字典)
    设 内容类型 为 取头值(头字典, "Content-Type", "")
    设 内容长度 为 取头值(头字典, "Content-Length", 空)
    设 块 为 ["字节": 长(体字节), "文本": 字符串(体字节, "utf-8")]
    设 块表 为 [块]
    设 钩子请求 为 ["方法": 请求["方法"], "内容类型": 内容类型, "内容长度": 内容长度, "块表": 块表, "头表": 头表]
    设 钩子响应 为 ["状态": 0, "消息": ""]
    处理请求(钩子请求, 钩子响应, 造钩子能力(己))
    设 体 为 序列化JSON(["状态": 钩子响应["状态"], "消息": 钩子响应["消息"]])
    返回 ["状态": 钩子响应["状态"], "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]

  # ---- E2 会话管理 API ----
  # GET /api/sessions：会话列表（按最后更新倒序）
  段落 处理列表会话():
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 列表 为 己.会话库.列表会话()
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(列表)]

  # GET /api/sessions/current：当前会话（显式 ?session= 优先，令牌绑定只作兜底）
  #
  # T-0408 修复：优先级从「令牌绑定 > ?session=」翻回「?session= > 令牌绑定」。
  #   令牌→会话 的绑定在每次新建会话时被覆盖（处理新建会话 末尾写 己.令牌会话表[令牌]），
  #   所以它只代表「这个令牌最近建的那个会话」，拿它压过显式 session 会让
  #   `current?session=<旧会话>` 恒回最新那个 —— 前端 refreshSessionTitle(id)
  #   正是带令牌 + ?session=<id> 取标题，多会话下会把标题刷成别的会话的。
  #   W2 契约「令牌=会话」在「没写 session」时依然成立（下面的兜底分支未动）。
  段落 处理当前会话(令牌, 查询串):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 标识 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 查询参数 为 解析查询参数(查询串)
      如果 查询参数.包含("session"):
        设 标识 为 查询参数["session"]
    如果 标识 == "":
      如果 令牌 != "" 且 令牌 != 空:
        如果 己.令牌会话表.包含(令牌):
          设 标识 为 己.令牌会话表[令牌]
    如果 标识 == "":
      返回 错误响应(400, "未指定会话")
    设 元数据 为 己.会话库.取元数据(标识)
    如果 元数据 == 空:
      返回 错误响应(404, "会话不存在")
    # T-0397：只增 模式/权限预设 两键（无设置时空串），旧键形状不变
    设 会话设置 为 己.取会话模式设置(标识)
    字典设置(元数据, "模式", 字典获取(会话设置, "模式", ""))
    字典设置(元数据, "权限预设", 字典获取(会话设置, "权限预设", ""))
    # T-0420：plan 状态（active/pending/text/title），旧键形状不变
    字典设置(元数据, "计划", 己.取计划状态(标识))
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(元数据)]

  # POST /api/sessions：新建会话
  段落 处理新建会话(请求, 令牌):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 标题 为 "新会话"
    设 载荷 为 空
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
      捕获 异常 e:
        设 占位 为 空
    设 请求目录值 为 ""
    如果 载荷 != 空 且 是字典(载荷):
      设 新标题 为 载荷.获取("标题", "")
      如果 新标题 != "":
        设 标题 为 新标题
      设 请求目录值 为 字典获取(载荷, "工作目录", "")
    # T-0395：工作目录是会话属性；非法目录直接 400，不写索引、不建空日志
    #   载荷为空/非字典（空体、坏 JSON、数组体）时保持旧行为：按默认标题建会话，
    #   不能因为多读一个可选键把原本 200 的请求变成 500。
    设 请求目录校验 为 己.校验请求工作目录(请求目录值)
    如果 请求目录校验["ok"] == 假:
      返回 错误响应(400, 请求目录校验["理由"])
    设 元数据 为 己.会话库.新建会话(标题, 请求目录校验["路径"])
    # T-0397：新建会话可指定模式/权限预设（UI 面板预选），创建时即写入会话记录
    设 新会话模式 为 ""
    设 新会话权限 为 ""
    如果 载荷 != 空 且 是字典(载荷):
      设 新会话模式 为 字典获取(载荷, "模式", "")
      设 新会话权限 为 字典获取(载荷, "权限预设", "")
    如果 新会话模式 != "" 且 是已知预设(新会话模式) == 假:
      设 新会话模式 为 ""
    如果 新会话权限 != "" 且 是权限预设(新会话权限) == 假:
      设 新会话权限 为 ""
    如果 新会话模式 != "" 或 新会话权限 != "":
      己.设会话模式设置(元数据["id"], 新会话模式, 新会话权限)
    如果 令牌 != "" 且 令牌 != 空:
      己.令牌会话表[令牌] 为 元数据["id"]
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(元数据)]

  # GET /api/sessions/:id：会话详情（完整消息历史）
  # T-0490：GET /api/sessions/:id/queue —— 轻量排队状态（深度/消息数/忙）
  #   前端 202 后轮询这个端点：消息数变化即说明后台待办落库，按 id 刷新当前会话视图。
  段落 处理排队状态(标识):
    设 闸门 为 己.取队列闸门()
    设 状态 为 取排队状态(闸门, 己, URL解码(标识))
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(状态)]

  段落 处理会话详情(标识):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 消息表 为 己.会话库.获取会话(标识)
    如果 是字典(消息表) 且 消息表.包含("错误"):
      返回 错误响应(404, 消息表["错误"])
    # T-0395/T-0397：详情只增 工作目录/模式/权限预设 键，旧键形状不变（侧边栏/导出依赖）
    设 元数据 为 己.会话库.取元数据(标识)
    设 详情工作目录 为 ""
    如果 元数据 != 空 且 字典包含键(元数据, "工作目录"):
      设 详情工作目录 为 元数据["工作目录"]
    设 详情模式设置 为 己.取会话模式设置(标识)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["id": 标识, "模型": 己.取会话模型(标识), "工作目录": 详情工作目录, "模式": 字典获取(详情模式设置, "模式", ""), "权限预设": 字典获取(详情模式设置, "权限预设", ""), "计划": 己.取计划状态(标识), "消息": 消息表])]

  # GET /api/sessions/:id/export：导出会话为 JSON 信封 {格式版本, 标题, 消息}
  段落 处理导出会话(标识):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 元数据 为 己.会话库.取元数据(标识)
    如果 元数据 == 空:
      返回 错误响应(404, "会话不存在")
    设 消息表 为 己.会话库.获取会话(标识)
    如果 是字典(消息表) 且 消息表.包含("错误"):
      返回 错误响应(404, 消息表["错误"])
    设 信封 为 ["格式版本": 1, "标题": 元数据.获取("标题", "新会话"), "消息": 消息表]
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8",
      "Content-Disposition": "attachment; filename=\"" + 标识 + ".json\""],
      "体": 序列化JSON(信封)]

  # POST /api/sessions/import：从 JSON 信封导入会话（新建 + 逐条追加消息 + 标题）
  段落 处理导入会话(请求):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 消息表 为 载荷.获取("消息", 空)
    如果 是列表(消息表) == 假:
      返回 错误响应(400, "缺少有效的 消息 数组")
    设 标题 为 载荷.获取("标题", "导入会话")
    如果 标题 == "" 或 标题 == 空:
      设 标题 为 "导入会话"
    设 元数据 为 己.会话库.新建会话(标题)
    设 标识 为 元数据["id"]
    设 成功数 为 0
    遍历 消息 之 消息表:
      如果 是字典(消息) == 假:
        继续
      己.会话库.追加消息(标识, 消息)
      设 成功数 为 成功数 + 1
    设 新元数据 为 己.会话库.取元数据(标识)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"],
      "体": 序列化JSON(["状态": "ok", "id": 标识, "标题": 标题, "导入消息数": 成功数, "会话": 新元数据])]

  # DELETE /api/sessions/:id：删除会话
  段落 处理删除会话(标识):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 结果 为 己.会话库.删除会话(标识)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # PUT /api/sessions/:id/标题：更新会话标题
  段落 处理更新标题(标识, 请求):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 标题 为 "新会话"
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
        如果 载荷 != 空 且 是字典(载荷):
          设 新标题 为 载荷.获取("标题", "")
          如果 新标题 != "":
            设 标题 为 新标题
      捕获 异常 e:
        设 占位 为 空
    设 结果 为 己.会话库.更新标题(标识, 标题)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # ---- E4 契约 3：审批 API ----
  # GET /api/approvals?session=xxx —— 待审批列表
  段落 处理审批列表(查询串):
    设 会话id 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("session"):
        设 会话id 为 参数["session"]
    设 列表 为 己.审批管理器.待审批列表(会话id)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["待审批": 列表, "全部": 己.审批管理器.全部待审批()])]

  # GET /api/approvals/history?session=xxx —— 已处理审批历史
  段落 处理审批历史(查询串):
    设 会话id 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("session"):
        设 会话id 为 参数["session"]
    设 列表 为 己.审批管理器.处理结果列表(会话id)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["已处理": 列表])]

  # POST /api/approvals/:id —— 处理审批（批准/拒绝）
  #   body: {"批准": true/false, "理由": "..."}
  段落 处理审批处理(审批id, 请求):
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 批准 为 假
    设 理由 为 ""
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
        如果 载荷 != 空 且 是字典(载荷):
          设 批准 为 载荷.获取("批准", 假)
          设 理由 为 载荷.获取("理由", "")
      捕获 异常 e:
        返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    设 结果 为 己.审批管理器.处理审批(审批id, 批准, 理由)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # GET /api/permissions —— 返回当前权限预设
  段落 处理获取权限:
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["预设": 己.权限管理器.当前预设(), "审批超时": 己.权限管理器.审批超时])]

  # POST /api/permissions —— 更新权限预设
  #   body: {"预设": "全放行"|"按类别"|"全拒绝"|"自定义", "审批超时": 300, "自定义": {"bash": "审批", ...}}
  段落 处理保存权限(请求):
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    如果 文本 == "":
      返回 错误响应(400, "请求体不能为空")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    # 更新预设
    如果 载荷.包含("预设"):
      己.权限管理器.设置预设(载荷["预设"])
    # 更新超时
    如果 载荷.包含("审批超时"):
      己.权限管理器.审批超时 为 载荷["审批超时"]
    # 更新自定义工具权限
    如果 载荷.包含("自定义") 且 type(载荷["自定义"]) == dict:
      设 自定义表 为 载荷["自定义"]
      遍历 工具名 之 自定义键表(自定义表):
        己.权限管理器.设置自定义(工具名, 自定义表[工具名])
    # 追加危险模式
    如果 载荷.包含("追加危险模式") 且 type(载荷["追加危险模式"]) == list:
      遍历 片段 之 载荷["追加危险模式"]:
        己.权限管理器.追加危险模式(片段)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["ok": 1, "预设": 己.权限管理器.当前预设(), "审批超时": 己.权限管理器.审批超时])]

  # E4：生成审批请求事件字典（SSE 推送用）
  段落 生成审批事件(审批项):
    返回 ["种类": "审批请求", "审批id": 审批项["审批id"], "会话id": 审批项["会话id"], "轮次": 审批项["轮次"], "工具名": 审批项["工具名"], "参数": 审批项["参数"]]

  # ---- R108 任务线 H：引导端点（C 线） ----
  # 构造引导已完成集（本仓 Web 层语义，不改 设置引导.完成步骤 的纯逻辑对齐）：
  #   welcome-notice 由版本键派生；deepseek-official 除「凭据就绪」派生（在 当前步骤 内）外，
  #   本仓 Web 端「稍后配置」需落一个跳过标记，否则浮层重读后反复弹出（用户问题 3）。
  段落 引导已完成集(设置表):
    设 已完成集 为 []
    如果 字典包含键(设置表, "引导_welcomeNoticeVersion"):
      列表追加(已完成集, "welcome-notice")
    如果 字典包含键(设置表, "引导_deepseekOfficialSkipped") 且 设置表["引导_deepseekOfficialSkipped"] == 真:
      列表追加(已完成集, "deepseek-official")
    返回 已完成集
  # GET /api/settings/onboarding -> C 线 渲染引导（查询参数 显式 可选）
  段落 处理获取引导(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 显式 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("显式"):
        设 显式 为 参数["显式"]
    # 本仓恒：会话为空白=真（首次进入）、凭据就绪=has_key
    设 会话空白 为 真
    设 凭据就绪 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 凭据就绪 为 真
    设 已存 为 己.读已存设置()
    设 已完成集 为 己.引导已完成集(已存)
    设 引导 为 设置引导.渲染引导(已完成集, 会话空白, 凭据就绪, 显式)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(引导)]

  # POST /api/settings/onboarding body {"步骤": <步 id>} -> C 线 完成步骤 落盘
  段落 处理保存引导(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 步id 为 载荷.获取("步骤", "")
    如果 步id == "":
      返回 错误响应(400, "缺少步骤字段")
    设 已存 为 己.读已存设置()
    设 新设置 为 空
    尝试:
      设 新设置 为 设置引导.完成步骤(已存, 步id)
    捕获 异常 e:
      返回 错误响应(400, "未知步骤: " + 步id)
    # 「稍后配置」落跳过标记：本仓 Web 端无上游桌面端的其他去重机制，
    #   不落盘则前端 load() 重读后 当前步骤 仍为 deepseek-official，浮层反复弹出。
    如果 步id == "deepseek-official":
      字典设置(新设置, "引导_deepseekOfficialSkipped", 真)
    己.写已存设置(新设置)
    # 返回当前步骤
    设 会话空白 为 真
    设 凭据就绪 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 凭据就绪 为 真
    设 已完成集 为 己.引导已完成集(新设置)
    设 当前 为 设置引导.当前步骤(已完成集, 会话空白, 凭据就绪, "")
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "ok", "当前步骤": 当前])]

  # ---- R108 任务线 H：凭据端点（E 线） ----
  # GET /api/settings/credential -> E 线凭据视图（响应绝不含明文）
  段落 处理获取凭据():
    设 己.请求数 为 己.请求数 + 1
    # 本仓恒为 env / file 两源之一：有密钥 -> file 来源（.env）
    设 有密钥 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 有密钥 为 真
    设 进程环境有 为 假  # 本仓无独立 env 探测，恒为假
    设 凭据文件有 为 有密钥
    设 项目环境有 为 假
    设 用户环境有 为 假
    设 视图 为 凭据链.解析凭据视图(进程环境有, 凭据文件有, 项目环境有, 用户环境有)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(视图)]

  # POST /api/settings/credential body {"密钥": <串>} -> 先过 E 线 可否写入
  段落 处理保存凭据(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 新密钥 为 载荷.获取("密钥", "")
    # 先过 E 线校验
    设 有密钥 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 有密钥 为 真
    设 视图 为 凭据链.解析凭据视图(假, 有密钥, 假, 假)
    设 校验 为 凭据链.可否写入(视图, 新密钥)
    如果 校验["合法"] == 假:
      返回 错误响应(400, 校验["消息"])
    # 合法 -> 复用既有 .env 写入路径（与 R107 模型配置写回同一条链）
    如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
      设 端点 为 "https://api.deepseek.com"
      设 模型 为 取默认模型()
      如果 己.配置元数据 != 空:
        设 端点 为 己.配置元数据.获取("endpoint", 端点)
        设 模型 为 己.配置元数据.获取("model", 模型)
      设 环境内容 为 "OPENAI_API_KEY=" + 新密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
      尝试:
        写入文件(己.环境文件路径, 环境内容)
      捕获 异常 e:
        返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
      # 热更新客户端
      设 新客户端 为 新建 客户端(端点, 新密钥, 模型)
      设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
      己.更新客户端(新客户端, 新元数据)
    # 只回凭据视图三键（不含明文）
    设 新视图 为 凭据链.解析凭据视图(假, 真, 假, 假)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(新视图)]

  # ---- R108 任务线 H：多 provider / 发现端点（D 线） ----
  # GET /api/settings/providers -> D 线 渲染提供商目录
  段落 处理获取提供商():
    设 己.请求数 为 己.请求数 + 1
    # 本仓注册表来源：已注册 route = [deepseek-official]（单提供商）
    设 已注册 为 ["deepseek-official"]
    设 可配置 为 []
    设 命名空间表 为 {}
    设 页 为 模型目录.渲染提供商目录(已注册, 可配置, 命名空间表)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(页)]

  # POST /api/settings/providers/discover body = 发现请求 -> D 线 换算（不写配置）
  段落 处理发现模型(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 baseURL 为 载荷.获取("baseURL", "")
    设 api 为 载荷.获取("api", "")
    设 apiKey 为 载荷.获取("apiKey", "")
    如果 baseURL == "":
      返回 错误响应(400, "请先填写 API 地址，再获取。")
    设 协议 为 模型目录.默认协议
    如果 api != "":
      设 协议 为 api
    # ⚠ 本端点绝不写任何配置；真实 HTTP 由宿主负责。
    #   注入式路径：若载荷带「响应」（原始响应文本），本端点调 D 线 解析发现响应 换算候选（便于宿主注入 mock / 未来接真实 fetch）；
    #   否则只回「地址 + 请求头形状」，候选由宿主侧真实响应驱动。
    设 注入响应 为 载荷.获取("响应", "")
    如果 注入响应 != "":
      设 解析结果 为 模型目录.解析发现响应(注入响应, 协议)
      设 地址2 为 模型目录.发现地址(baseURL, 协议)
      设 头键2 为 自定义键表(模型目录.发现请求头(协议, apiKey))
      # ⛔ 铁律：apiKey 仅本次询问使用，绝不进入任何返回值/日志
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["地址": 地址2, "请求头键": 头键2, "候选": 解析结果["候选"], "说明": "注入式响应驱动；apiKey 仅本次使用不落盘不回显"])]
    设 地址 为 模型目录.发现地址(baseURL, 协议)
    设 头 为 模型目录.发现请求头(协议, apiKey)
    设 头键 为 自定义键表(头)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["地址": 地址, "请求头键": 头键, "说明": "真实 HTTP 由宿主负责；本端点只做换算不写配置，apiKey 仅本次使用不落盘不回显"])]

  # ---- jet-hub（dsh-providers-hub 本地网关）：探测 + 一键接入 ----
  # GET /api/settings/providers/jet-hub -> {可用, 地址, 地址来源, 有密钥, 密钥来源, 密钥路径, 模型, 总数, 推荐, 错误}
  #   ⛔ 响应绝不含密钥明文（探测 只报「有没有 + 来源」）。
  段落 处理获取枢纽():
    设 己.请求数 为 己.请求数 + 1
    设 环境表 为 提供商枢纽.取环境表(取环境变量)
    设 状态 为 提供商枢纽.探测(环境表, 15)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(状态)]

  # POST /api/settings/providers/jet-hub/apply body {"模型": "<provider/model 或裸模型名，可选>"}
  #   语义：重新探测一次 → 选中模型 → 写 .env 三行（OPENAI_API_KEY/BASE_URL/MODEL）→ 热更新客户端。
  #   模型缺省 = 模块推荐（deepseek-official/deepseek-flash 优先）；
  #   错误一律 400/500 + {"错误": 文案}，绝不把密钥写进日志或响应。
  段落 处理应用枢纽(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 环境表 为 提供商枢纽.取环境表(取环境变量)
    设 状态 为 提供商枢纽.探测(环境表, 15)
    如果 状态["可用"] == 假:
      返回 错误响应(400, "jet-hub 不可用: " + 转字符串(状态["错误"]))
    设 想要 为 字典获取(载荷, "模型", "")
    如果 想要 == "" 或 想要 == 空:
      设 想要 为 字典获取(载荷, "model", "")
    设 选中 为 提供商枢纽.挑选模型(状态["模型"], 想要)
    如果 选中 == 空:
      返回 错误响应(400, "jet-hub 模型目录为空，无法接入")
    设 密钥视图 为 提供商枢纽.解析密钥(环境表)
    如果 密钥视图["存在"] == 假:
      返回 错误响应(400, "未找到 jet-hub 网关密钥: " + 转字符串(密钥视图["来源"]))
    设 接入 为 提供商枢纽.构造接入(状态["地址"], 密钥视图["密钥"], 选中["id"])
    # 写 .env（三行；覆盖式写入；未装配环境文件路径时跳过，行为与 POST /api/config 一致）
    如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
      尝试:
        写入文件(己.环境文件路径, 接入["环境内容"])
      捕获 异常 e:
        返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
    设 新客户端 为 新建 客户端(接入["端点"], 接入["密钥"], 接入["模型"])
    设 新元数据 为 ["configured": 1, "mock": 0, "model": 接入["模型"], "endpoint": 接入["端点"], "has_key": 1]
    己.更新客户端(新客户端, 新元数据)
    设 响应体 为 ["ok": 1, "message": "已切换到 jet-hub 模型", "模型": 接入["模型"], "地址": 状态["地址"], "config": 新元数据]
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(响应体)]

  # ---- R108 任务线 H：插件面板端点（F 线） + R110 宿主执行层接线 ----
  # GET /api/settings/plugin-panel -> 列光明插件（lightplugin 内置 75 个）+ 启停态
  # R113-R1 修复：GET 链路补上 探测管理面（幂等初始化 profile 目录/package.json/
  #   cordis.patch.json/pnpm-workspace.yaml，见 插件执行.light:40-56），并把面板
  #   可用态从硬编码 真 改回探针真实值。此前 GET 从不初始化 profile，
  #   test_r110_e2e 断言「GET 后补丁文件已初始化」恒假（该 example 出生即红）。
  #   兼容 R111「无根部署可用恒真」语义（test_r108新端点.light:76-80，根=""）：
  #   根为空时探针按设计返回不可用，但面板列内置插件不受影响，保持 恒真；
  #   根非空时用探针真实值（pnpm 探测 + profile 初始化）。
  段落 处理获取插件面板():
    设 己.请求数 为 己.请求数 + 1
    设 探针 为 插件执行.探测管理面(己.根)
    设 面板可用 为 真
    如果 己.根 != 空 且 己.根 != "":
      设 面板可用 为 探针["可用"]
    设 行列表 为 插件启停.列插件状态(己.根)
    设 包列表 为 []
    # MCP桥接 与 mcp接线 直连构成双路径，生产挂载时故意不挂 agent 工具表；
    #   面板仍列出但补只读原因，避免用户看到「工具数>0 但没挂上」误判为异常。
    设 只读提示 为 ""
    遍历 行 之 行列表:
      设 工具数 为 转字符串(行["工具数"])
      如果 行["name"] == "MCP桥接":
        设 只读提示 为 "management-required"
      否则:
        设 只读提示 为 ""
      设 卡片 为 {
        "name": 行["name"], "标题": 行["标题"], "版本": "内置",
        "描述": 工具数 + " 个工具", "已安装": 真, "可选": 假,
        "已启用": 行["已启用"], "标签": [], "只读原因": 只读提示, "错误": "",
        "组件": [], "工具表": 行["工具表"]
      }
      包列表.追加(卡片)
    设 面板 为 插件面板.渲染插件面板(包列表, [], "", 面板可用)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(面板)]

  # POST /api/settings/plugin-panel/install  body={"spec":"<git URL 或 owner/repo>"}
  # R112：git clone 光明插件仓库到 lightplugin/插件/_外部/，写 installed.json；清缓存后下次请求加载。
  段落 处理安装插件(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 规格 为 ""
    如果 是字典(载荷) == 真:
      设 规格 为 载荷.获取("spec", "")
    设 结果 为 插件安装.安装插件(己.根, 规格)
    # 安装成功清注册表缓存，下次请求加载新插件
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 500
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/plugin-panel/uninstall —— R3：外部插件（git clone）真卸载；内置插件返回可停用提示
  段落 处理卸载插件(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 id 为 ""
    如果 是字典(载荷) == 真:
      设 id 为 载荷.获取("id", "")
    设 结果 为 插件安装.卸载外部插件(己.根, id)
    # 卸载成功清注册表缓存，下次请求按新清单重建
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 400
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/plugin-panel/set-enabled  body={"id":"<插件名>", "enabled":true/false}
  段落 处理设置插件启用(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 id 为 ""
    设 启用 为 真
    如果 是字典(载荷) == 真:
      设 id 为 载荷.获取("id", "")
      设 启用 为 载荷.获取("enabled", 真)
    设 结果 为 插件启停.切换插件(己.根, id, 启用)
    # R113-R1 修复：宿主执行层补接线——对齐上游 writePluginEnabled，启停同时落
    #   cordis.patch.json（插件执行.设置启用）。此前只写 plugins.json，e2e 断言
    #   「补丁写入 demo-e2e」恒假（test_r110_e2e.light:36-41）。
    如果 结果["ok"] == 真:
      设 补丁结果 为 插件执行.设置启用(己.根, id, 启用)
      如果 补丁结果["ok"] == 假:
        设 结果 为 补丁结果
    # 启停变更后清空预设注册表缓存，下次请求按新开关重建
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 400
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]


# ---- T-0393 Phase 1：请求级纯辅助已抽到 src/web_请求辅助.light（边界 B1）----
#   取环境变量/自定义键表/处理健康检查/提取查询令牌/解析查询参数/分割字符串/
#   解析会话标识/是回环地址/加跨域 九个无状态纯函数移入子模块，此处同名转发导入，
#   类方法与 路由处理器 内的裸名调用照旧生效（导入即注入本模块命名空间）。

# ---- W3 辅助：CORS 头（契约 5）。开关：HARNESS_WEB_CORS=0 时不加，默认加 ----

# ---- T-0453：序号/待办兜底两个模块级辅助 ----
#
# 最大事件序号：压缩替换 会把新检查点插在遮蔽段之后、保留尾部之前 —— 表内顺序
#   从此不再等于序号顺序（检查点序号最大却排在中间）。所以「表长」与「最大序号」
#   是两个量，别拿 长(事件表) 当序号用。
段落 最大事件序号(会话对象):
  设 最大 为 0
  尝试:
    遍历 记录 之 会话对象.汇集全部事件():
      如果 是字典(记录) == 真 且 记录.包含("序号"):
        设 号 为 记录["序号"]
        如果 号 > 最大:
          设 最大 为 号
  捕获 异常 e:
    返回 最大
  返回 最大

# 保存水位 = 最大序号 + 1 = 下一事件将拿到的序号。
#   ⚠️ 序号是**从 0 起**的，所以 长(事件表) 恰好等于「最大序号+1」（水位），
#   不等于最大序号本身。增量保存 的起始序号要的是水位（>= 水位才写），
#   用最大序号会把上一轮的收尾事件（turn/end）重复写一次（实测 JSONL 出现重复 seq）。
段落 事件序号水位(会话对象):
  设 最大 为 最大事件序号(会话对象)
  设 总数 为 0
  尝试:
    设 总数 为 长度(会话对象.汇集全部事件())
  捕获 异常 e:
    设 总数 为 0
  # 表里一个事件都没有 → 水位 0；否则取「最大序号+1」，且不小于表长（防序号空档时倒退）
  设 水位 为 最大 + 1
  如果 水位 < 总数:
    设 水位 为 总数
  返回 水位

# 待办超时：202 入队项如果长时间没人取，执行它已经没有意义（那条 HTTP 早返回了）。
#   T-0490：超时不再「记日志 + 静默丢弃」——必须给用户一条可见回执（写进会话库，
#   前端轮询 /api/sessions/:id 或 /api/sessions/:id/queue 能看到）。202 回包里也回这个秒数。
设 队待办超时秒 为 120
# T-0490：队列唤醒兜底周期（秒）。释放方拉起是主路径，这个只是「链条被延长」时的兜底，
#   不重做 T-0453 的「释放方拉起待办」核心逻辑（那条仍保留，见 拉起待办消费）。
设 队唤醒周期秒 为 2

# T-0490：排队事件回执。202 入队的轮次没有 HTTP 连接可写 SSE，结果只落会话库，
#   前端此前只看到「服务端已排队」一句系统提示、再无任何输出。这里给每条待办
#   三个可见落点（入队 / 开始 / 完成或失败），都以 角色="system" 的消息写进会话库：
#   GET /api/sessions/:id 和 /api/sessions/:id/queue 都能读到；前端只刷新当前会话。
段落 记排队事件(服务, 会话标识, 文本, 阶段 = "完成"):
  如果 服务 == 空 或 会话标识 == "" 或 会话标识 == 空:
    返回 假
  如果 服务.会话库 == 空:
    返回 假
  尝试:
    设 内容 为 "[" + 阶段 + "] " + 文本
    设 忽略写 为 服务.会话库.追加消息(会话标识, ["角色": "system", "内容": 内容])
    返回 真
  捕获 异常 e:
    打印("排队事件写入失败：" + 转字符串(e))
    返回 假

# T-0490：排队结果摘要——给前端一个轻量状态查询点，避免为了看「排了队没」反复拉全量历史。
#   形状固定：{"深度":N, "消息数":M, "忙":布尔}，不改既有 SSE 帧形状/结束原因字段名。
段落 取排队状态(闸门, 服务, 会话标识):
  设 深度 为 队排队深度(闸门, 会话标识)
  设 忙 为 队是否忙(闸门, 会话标识)
  设 消息数 为 0
  如果 服务 != 空 且 服务.会话库 != 空 且 会话标识 != "":
    尝试:
      设 消息表 为 服务.会话库.获取会话(会话标识)
      如果 是列表(消息表) == 真:
        设 消息数 为 长(消息表)
    捕获 异常 e:
      设 消息数 为 0
  返回 ["深度": 深度, "消息数": 消息数, "忙": 忙]

# 拉起待办消费：交还占用的那一刻若还有待办，由释放方重新拉起一次消费。
#   为什么必须补这一手：202 入队项原先只由「正在跑的那一轮」的 当 循环在轮末取；
#   若入队时那一轮已经跳出循环（典型场景：压缩提示帧刚出现、用户立刻发「继续」，
#   而那时后台线程早已跑完、只是还在写 SSE 尾帧），这条就永远没人取 ——
#   用户侧看到的就是「再发继续，毫无反应」。
#   抢占用失败不视为失败：说明确实有另一轮在跑，它的轮末会取走队列。
# T-0490：兜底唤醒循环。T-0453 的「释放方拉起」是主路径；这里只处理一种残余竞态：
#   释放与拉起之间又被新请求抢占，或拉起时抢占用失败且没有下一条释放事件，
#   待办就会在队列里过 120s 直到超时。每 2s 扫一次，发现「有待办且会话空闲」就补拉一次。
段落 排队唤醒循环(服务):
  当 真:
    time.sleep(队唤醒周期秒)
    尝试:
      设 闸门 为 服务.队列闸门
      如果 闸门 == 空:
        继续
      设 键表 为 服务.排队载具表
      如果 是字典(键表) == 假:
        继续
      遍历 键 之 键表:
        尝试:
          如果 队排队深度(闸门, 键) <= 0:
            继续
          如果 队是否忙(闸门, 键) == 真:
            继续
          设 载具 为 键表[键]
          如果 是字典(载具) == 假:
            继续
          设 忽略拉起 为 拉起待办消费(载具, 闸门, 键)
        捕获 异常 e:
          打印("排队兜底唤醒单条失败：" + 转字符串(e))
    捕获 异常 e:
      打印("排队兜底唤醒异常：" + 转字符串(e))

段落 拉起待办消费(载具, 队列闸门, 排队键):
  如果 队列闸门 == 空 或 是字符串(排队键) == 假 或 排队键 == "":
    返回 假
  如果 队排队深度(队列闸门, 排队键) <= 0:
    返回 假
  如果 队尝试占用(队列闸门, 排队键) == 假:
    返回 假
  尝试:
    设 消费线程 为 新建 线程(后台消费待办, 载具, 队列闸门, 排队键)
    消费线程.开始()
    返回 真
  捕获 异常 e:
    设 忽略释放 为 队释放占用(队列闸门, 排队键)
    返回 假

# 后台消费待办：没有 HTTP 连接可写的兜底消费（202 项的执行者）。
#   与 后台跑一轮 共用 跑一轮/增量保存/会话库 同一套口径，差别只有「不推流」：
#   帧没有落点，所以结果只进会话事实（用户刷新历史能看到这一轮真的跑了）。
段落 后台消费待办(载具, 队列闸门, 排队键):
  设 服务 为 字典获取(载具, "服务", 空)
  设 会话对象 为 字典获取(载具, "会话", 空)
  设 会话标识 为 字典获取(载具, "会话标识", "")
  设 保存序号 为 0
  # T-0470：兜底消费线程也要把会话 cwd 设成本线程工具根（工具在此线程执行）
  如果 会话对象 != 空:
    设 忽略工具根 为 设置工具根(会话对象.取工作目录(), 真)
  尝试:
    当 真:
      设 待办项 为 队出队(队列闸门, 排队键)
      如果 是字典(待办项) == 假:
        跳出
      设 待办文本 为 字典获取(待办项, "文本", "")
      如果 是字符串(待办文本) == 假:
        设 待办文本 为 ""
      如果 待办文本 == "":
        继续
      设 等待秒 为 0
      如果 待办项.包含("入队时刻"):
        设 等待秒 为 时间戳() - 待办项["入队时刻"]
      如果 等待秒 > 队待办超时秒:
        # T-0490：不再静默吞——把明确失败回执写进会话库，前端轮询可见
        打印("排队待办超时丢弃：" + 转字符串(等待秒) + "s " + 待办文本)
        设 忽略超时回执 为 记排队事件(服务, 会话标识, "排队消息等待超过 " +
          转字符串(队待办超时秒) + " 秒，已放弃执行：" + 待办文本, "失败")
        继续
      # 单条失败不拖垮整批：捕获必须在 当 循环**里面**，
      #   否则一条异常就把队列里剩下的待办留在原地（又变孤儿）。
      尝试:
        如果 保存序号 == 0:
          设 保存序号 为 事件序号水位(会话对象)
        设 选项 为 {}
        设 模板 为 字典获取(载具, "选项", 空)
        如果 是字典(模板) == 真:
          遍历 模板键 之 模板:
            字典设置(选项, 模板键, 模板[模板键])
        # 兜底消费不推流：把流式回调摘掉，免得帧被投进已经关掉的队列
        如果 选项.包含("增量回调") == 真:
          字典删除(选项, "增量回调")
        如果 选项.包含("工具回调") == 真:
          字典删除(选项, "工具回调")
        设 闸门 为 字典获取(载具, "闸门", 空)
        如果 闸门 != 空:
          字典设置(选项, "审批管理器", 闸门)
        设 开始时刻 为 时间戳()
        设 忽略开始回执 为 记排队事件(服务, 会话标识, 待办文本, "开始")
        设 结果 为 跑一轮(载具["客户端"], 载具["注册表"], 会话对象, 待办文本, 选项)
        服务.最近轮次细节 为 时从轮次结果取细节(结果, 开始时刻)
        服务.最近轮次数 为 1
        服务.最近压缩条数 为 服务.数检查点(会话对象, 保存序号)
        # T-0466：排队续跑同样按「最后一次请求上报的 prompt_tokens」重算当前占用
        设 忽略占用 为 服务.重算上下文占用(会话对象)
        尝试:
          增量保存(服务.根, 会话对象, 保存序号)
        捕获 异常 e:
          打印("排队待办保存失败：" + 转字符串(e))
        设 保存序号 为 事件序号水位(会话对象)
        如果 服务.会话库 != 空 且 会话标识 != "":
          尝试:
            服务.会话库.追加消息(会话标识, ["角色": "user", "内容": 待办文本])
            服务.会话库.追加消息(会话标识, ["角色": "assistant", "内容": 服务.取末条助手文本(会话对象)])
            设 忽略完成 为 记完成时间(服务.会话库, 会话标识, 时格式化完整时刻(时间戳()))
          捕获 异常 e:
            设 忽略记账 为 空
         # T-0490：完成回执——前端轮询看到「完成」才知道这条排队轮次真的跑完了
        # T-0490：完成回执——前端轮询看到「完成」才知道这条排队轮次真的跑完了
        设 忽略完成回执 为 记排队事件(服务, 会话标识, 待办文本, "完成")
        打印("排队待办消费失败：" + 转字符串(e))
        # T-0490：失败也要有可见回执（不得静默吞）
        设 忽略失败回执 为 记排队事件(服务, 会话标识, 待办文本 + "（" + 转字符串(e) + "）", "失败")
  捕获 异常 e:
    打印("排队待办队列异常：" + 转字符串(e))
  最终:
    设 忽略清根 为 清除工具根()
    设 忽略释放 为 队释放占用(队列闸门, 排队键)

# ---- 实时推流的两个模块级段落（光明类体不能放 异步 段落）----
#
# 后台跑一轮：在独立线程里执行完整的一轮对话，与同步路径共用 跑一轮 / 计量 /
#   持久化 同一套逻辑；差别只有两点：
#     1) 选项里注入 增量回调，模型每产出一块就投一帧进队列（实时输出）；
#     2) 异常不抛给调用方线程，而是记进队列尾帧，由 HTTP 协程按错误收口。
#   收尾一律「投完帧 → 关闭队列」，消费者据此判断流结束。
段落 后台跑一轮(载具):
  设 队列 为 载具["队列"]
  设 会话对象 为 载具["会话"]
  设 保存前序号 为 载具["保存前序号"]
  设 会话标识 为 载具["会话标识"]
  设 服务 为 载具["服务"]
  设 队列闸门 为 字典获取(载具, "队列闸门", 空)
  设 排队键 为 字典获取(载具, "排队键", 会话标识)
  设 占用 为 字典获取(载具, "占用", 假)
  设 续跑状态 为 字典获取(载具, "续跑", 空)
  设 当轮文本 为 载具["文本"]
  设 保存序号 为 保存前序号
  设 续轮 为 0
  设 续跑轮数 为 0
  # T-0453：本线程是否已经「交还」会话占用（提前释放 / 最终兜底二选一，只做一次）
  设 已释放 为 假
  # T-0470：后台线程执行工具，工具根同样按本会话 cwd 设置（线程级，互不污染）
  设 忽略工具根 为 设置工具根(会话对象.取工作目录(), 真)
  尝试:
    # T-0407 需求一/五：流式与非流式共用同一形状的「当」循环——先续跑决策，再看队列/插话
    当 真:
      # 停止：整轮不再续跑、不再执行排队/插话（子进程由 /api/task/stop 杀掉）
      如果 是已请求停止(排队键) == 真:
        跳出
      # 暂停：每轮开始前等待继续（最多 400 次 × 0.05s ≈ 20 秒，避免永久挂死）
      设 忽略等 为 等继续(排队键, 400)
      # 插入（steer）：用户在运行中送来的 prompt 立即成为本轮提示词（下一步之前生效）
      设 插入文本 为 取插入(排队键)
      如果 是字符串(插入文本) == 真 且 插入文本 != "":
        设 当轮文本 为 插入文本
      设 选项 为 {}
      设 模板 为 字典获取(载具, "选项", 空)
      如果 是字典(模板) == 真:
        遍历 模板键 之 模板:
          字典设置(选项, 模板键, 模板[模板键])
      字典设置(选项, "增量回调", 载具["收块"])
      # T-043x：工具帧也走同一条队列（没有它，工具执行期间浏览器一片空白）
      如果 载具.包含("收工具帧"):
        字典设置(选项, "工具回调", 载具["收工具帧"])
      # T-0397：把会话权限闸门透传给 跑一轮（无会话级设置时 闸门 为空 → 不注入）
      设 闸门 为 字典获取(载具, "闸门", 空)
      如果 闸门 != 空:
        字典设置(选项, "审批管理器", 闸门)
      设 开始时刻 为 时间戳()
      设 结果 为 跑一轮(载具["客户端"], 载具["注册表"], 会话对象, 当轮文本, 选项)
      载具["结果"] 为 结果
      # T-0407 需求四：统计帧的 耗时秒/速率 必须在收尾帧之前就绪（推流实现 在队列关闭后读）
      服务.最近轮次细节 为 时从轮次结果取细节(结果, 开始时刻)
      设 续跑轮数 为 续跑轮数 + 1
      服务.最近轮次数 为 续跑轮数
      服务.最近压缩条数 为 服务.数检查点(会话对象, 保存序号)
      # T-0466：流式路径同样按 prompt_tokens 重算当前占用（统计帧在队列关闭后读快照）
      设 忽略占用 为 服务.重算上下文占用(会话对象)
      # 失败也把原因推给前端，避免浏览器只看到空白流（前端会渲染成错误气泡）
      如果 结果 != 空 且 是字典(结果) 且 结果.获取("种类", "") == "error":
        队列.投递(["error": ["message": 转字符串(结果.获取("失败", "驱动失败")), "type": "driver_error"]])
        队列.关闭()
        返回 假
      # 持久化：与同步路径同口径；失败只补一帧提示，不吞已发送内容
      尝试:
        增量保存(服务.根, 会话对象, 保存序号)
      捕获 异常 e:
        队列.投递(["error": ["message": "会话保存失败: " + 转字符串(e), "type": "save_error"]])
      设 保存序号 为 事件序号水位(会话对象)
      # T-0407 需求五：每轮各自的 user/assistant 落 会话库（续跑/排队的轮次不丢）
      如果 服务.会话库 != 空:
        尝试:
          服务.会话库.追加消息(会话标识, ["角色": "user", "内容": 当轮文本])
          服务.会话库.追加消息(会话标识, ["角色": "assistant", "内容": 服务.取末条助手文本(会话对象)])
        捕获 异常 e:
          设 忽略保存 为 空
      # ---- T-0407 需求一：续跑决策 ----
      设 续续了 为 假
      如果 续跑状态 != 空:
        设 续跑状态 为 服务.合并台账到状态(续跑状态)
        设 续跑状态 为 续记账(续跑状态, 结果)
        设 决策 为 续续跑决策(续跑状态, 结果)
        设 忽略存 为 服务.存续跑状态(会话标识, 续跑状态)
        如果 字典获取(决策, "动作", "") == 续动作续跑 且 续轮 < 续取上限(续跑状态):
          设 下轮文本 为 字典获取(决策, "提示文本", "")
          如果 是字符串(下轮文本) == 假:
            设 下轮文本 为 ""
          如果 下轮文本 != "":
            设 当轮文本 为 下轮文本
            设 续轮 为 续轮 + 1
            设 续续了 为 真
      如果 续续了 == 真:
        继续
      # ---- T-0407 需求五：插话优先，其后排队；同一条流里跑完，不另起线程 ----
      设 插话文本 为 队取插话(队列闸门, 排队键)
      如果 是字符串(插话文本) == 假:
        设 插话文本 为 ""
      如果 插话文本 == "":
        设 待办项 为 队出队(队列闸门, 排队键)
        如果 是字典(待办项) == 真:
          设 插话文本 为 字典获取(待办项, "文本", "")
           # T-0490：主循环取到 202 待办 → 写开始回执（这条路径不走 后台消费待办）
           设 忽略队开始回执 为 记排队事件(服务, 会话标识, 插话文本, "开始")
        否则:
          设 插话文本 为 ""
      如果 插话文本 != "" 且 续轮 < 续取上限(续跑状态):
        设 当轮文本 为 插话文本
        设 续轮 为 续轮 + 1
         # T-0490：排队轮次已被本循环取走并即将跑，写完成回执（前端轮询可见）
         设 忽略队完成回执 为 记排队事件(服务, 会话标识, 插话文本, "完成")
        继续
      跳出
    # T-0407 需求四：完成时刻落库
    如果 服务.会话库 != 空 且 会话标识 != "":
      尝试:
        设 忽略完成 为 记完成时间(服务.会话库, 会话标识, 时格式化完整时刻(时间戳()))
      捕获 异常 e:
        设 完成忽略 为 空
    # T-0453：收尾帧快照 + 提前交还会话占用。
    #   为什么快照：占用一放开，紧接着的「继续」就可能开新一轮并改写 服务.最近*，
    #     尾帧必须用本轮落定的值，不能临场再读（否则统计/压缩会串成下一轮的数字）。
    #   为什么提前：占用只该覆盖「跑这一轮」，不该覆盖「把尾帧写完」。
    #     SSE 尾帧里的「压缩」帧就是用户看见的压缩提示；旧口径下此刻仍占着会话，
    #     用户立刻发的「继续」被判忙入队，而入队时本循环已跳出 → 永远没人取。
    尝试:
      载具["统计帧"] 为 服务.生成统计事件()
      载具["压缩条数"] 为 服务.最近压缩条数
    捕获 异常 e:
      设 忽略快照 为 空
    如果 占用 == 真:
      设 忽略释放3 为 队释放占用(队列闸门, 排队键)
      设 占用 为 假
      设 已释放 为 真
    队列.关闭()
    # T-0453：交还占用时若还有待办，必须由释放方重新拉起一次消费
    #   （否则「本循环跳出后入队」的那条永远是孤儿，用户侧表现为发什么都没反应）
    如果 已释放 == 真:
      设 忽略拉起 为 拉起待办消费(载具, 队列闸门, 排队键)
    返回 真
  捕获 异常 e:
    载具["失败"] 为 转字符串(e)
    尝试:
      队列.投递(["error": ["message": "驱动失败: " + 转字符串(e), "type": "driver_error"]])
    捕获 异常 e2:
      设 忽略投递 为 空
    # T-0453：异常路径也要留统计快照，否则尾帧会读到下一轮的细节
    尝试:
      载具["统计帧"] 为 服务.生成统计事件()
      载具["压缩条数"] 为 服务.最近压缩条数
    捕获 异常 e3:
      设 忽略快照 为 空
    队列.关闭()
    返回 假
  最终:
    # T-0470：线程结束前清掉本线程工具根
    设 忽略清根 为 清除工具根()
    # T-0472：流式运行项收口（正常/异常路径都要关，/api/task/* 之后不再看见）
    设 忽略关运行 为 关运行(排队键)
    # T-0453：占用兜底释放（正常路径已在关闭队列前释放过，这里只兜异常/提前返回）
    如果 占用 == 真:
      设 忽略释放3 为 队释放占用(队列闸门, 排队键)
      设 已释放 为 真
    如果 已释放 == 真:
      设 忽略拉起 为 拉起待办消费(载具, 队列闸门, 排队键)

# 推流实现：HTTP 协程侧边取边发 —— 这是「实时」二字的落点。
#   每拿到一帧就 等待 流发送（底层是 chunked write + 立即 send），浏览器即时渲染；
#   队列关闭且取空后补收尾帧（压缩 / 统计 / 审批 / 会话 id / [DONE]）并返回。
#
# T-0453：**本协程不再持有会话占用**。
#   占用由 处理对话 入口原子抢到、随请求转交 后台跑一轮，那一轮跑完就释放。
#   旧口径（本协程在发第一帧时占位、发完尾帧才释放）有两个坏处：
#     1) 占用覆盖到 SSE 尾帧之后 —— 用户看到「已触发上下文压缩」时其实早跑完了，
#        此刻发的「继续」被判忙 → 202 入队，而入队时后台循环已跳出 → 这条没人取；
#     2) 浏览器中途断开时本协程会提前放手，而后台线程可能还在跑 → 会话被误判空闲。
异步 段落 推流实现(发送器, 载具, 服务):
  设 队列 为 载具["队列"]
  设 空闲 为 0
  尝试:
    当 真:
      设 帧 为 队列.取出()
      如果 帧 == 空:
        如果 队列.是否结束() == 真:
          跳出
        # 没有新帧：让出事件循环（不阻塞其它连接），稍后再取。
        等待 异步睡眠(0.01)
        设 空闲 为 空闲 + 1
        如果 空闲 > 30000:
          # 兜底：极端情况下（线程卡死）也不能无限占着连接
          跳出
        继续
      设 空闲 为 0
      设 可发 为 等待 流发送(发送器, 编码SSE帧(帧))
      如果 可发 == 假:
        # 浏览器断开（用户点「停止」）：不再写，但让后台线程自己跑完落盘
        跳出
    # ---- 收尾帧 ----
    # T-0453：一律用后台线程跑完时留下的快照（占用已放开，现场读 服务.最近* 会串味）
    设 统计帧 为 字典获取(载具, "统计帧", 空)
    如果 是字典(统计帧) == 假:
      设 统计帧 为 服务.生成统计事件()
    设 压缩条数 为 字典获取(载具, "压缩条数", 0)
    # T-0453：压缩帧不能是最后一帧 —— 先推压缩，再推统计与 [DONE]。
    #   「压缩」是用户唯一能看见的停住解释；把它压在 [DONE] 之前，
    #   前端先知道「本轮压缩了」再收尾，判据顺序固定为 压缩 → 统计 → [DONE]。
    如果 压缩条数 > 0:
      尝试:
        等待 流发送(发送器, 编码SSE帧(服务.生成压缩事件(压缩条数, 字典获取(统计帧, "上下文使用率", 0))))
      捕获 异常 e:
        设 忽略压缩 为 空
    尝试:
      等待 流发送(发送器, 编码SSE帧(统计帧))
    捕获 异常 e:
      设 忽略统计 为 空
    尝试:
      遍历 审批项 之 服务.审批管理器.全部待审批():
        等待 流发送(发送器, 编码SSE帧(服务.生成审批事件(审批项)))
    捕获 异常 e:
      设 忽略审批 为 空
    设 会话对象 为 载具["会话"]
    设 标识文本 为 ""
    尝试:
      设 标识文本 为 转字符串(会话对象.标识)
    捕获 异常 e:
      设 标识文本 为 ""
    如果 标识文本 != "":
      尝试:
        等待 流发送(发送器, 编码SSE帧(["种类": "会话", "session_id": 标识文本]))
      捕获 异常 e:
        设 忽略会话 为 空
    尝试:
      等待 流发送(发送器, "data: [DONE]\n\n")
    捕获 异常 e:
      设 忽略结束 为 空
  捕获 异常 e:
    设 忽略推流 为 空
  返回 真

# ---- 模块级单例：处理器（光明类体不能放 异步 段落）通过它拿到服务状态 ----
设 全局服务 为 新建 Web服务端()

# ---- R42 辅助：HTTP 头字典（原名→单值）→ 钩子头表（小写名→[单值]）----
#   门禁链 必需头() 按小写名查（x-hub-signature-256 等）且要求「长度恰 1 的单值表」，
#   故此处统一小写键 + 包成单元素列表。
段落 造钩子头表(头字典):
  设 结果 为 {}
  遍历 名 之 头字典:
    设 低 为 名.lower()
    设 单元 为 [头字典[名]]
    结果[低] 为 单元
  返回 结果

# ---- R42 辅助：大小写不敏感取头值（无则 缺省）----
段落 取头值(头字典, 名字, 缺省):
  设 低名 为 名字.lower()
  遍历 键 之 头字典:
    设 低键 为 键.lower()
    如果 低键 == 低名:
      返回 头字典[键]
  返回 缺省

# ---- R42 辅助：钩子能力（取秘密/当前时间/来源/派发/体上限）----
#   取秘密 与 派发 走模块级单例 全局服务（光明类体不能承载可注入回调）；
#   派发默认只把交付追加进 钩子派发记录（不外联 GitHub）。
段落 钩子取秘密:
  全局 全局服务
  设 值 为 全局服务.钩子秘密
  # 空串归一为 空：门禁链以「秘密==空」判「未配置」（503），空串不等同 空
  如果 值 == "" 或 值 == 空:
    返回 空
  返回 值

段落 钩子当前时间:
  返回 转字符串(时间戳())

段落 钩子派发(投递):
  全局 全局服务
  全局服务.钩子派发记录.追加(投递)

段落 造钩子能力(服务):
  返回 ["取秘密": 钩子取秘密, "当前时间": 钩子当前时间, "来源": 服务.钩子来源, "派发": 钩子派发, "体上限": 服务.钩子体上限]


# ---- 路由处理器：HTTP 服务端每连接回调。请求字典 → 响应字典 ----
#   处理次序：服务未配置 → 认证挂载点（S2）→ 路由分派（health/静态/chat/404）
#   认证：取令牌()=="" 即未启用（S1 全放行）；启用后白名单(GET /health、静态资源)放行，
#         其余校验 X-Auth-Token 头 或 ?token= 查询，二选一即过；失败 401。
#   所有响应统一加 CORS 头（HARNESS_WEB_CORS!=0 时）。
异步 段落 路由处理器(请求):
  设 服务 为 全局服务
  如果 服务.服务端 == 空:
    设 响应 为 错误响应(500, "服务未配置")
    返回 加跨域(响应)
  设 方法 为 请求["方法"]
  设 原路径 为 请求["路径"]
  设 路径 为 原路径
  设 查询串 为 ""
  设 问号 为 路径.查找("?")
  如果 问号 >= 0:
    设 查询串 为 路径[问号 + 1:]
    设 路径 为 路径[0:问号]
  # ---- R41（任务2）：非 loopback + HARNESS_TOKEN 网络级门禁 ----
  #   仅当绑定非 loopback 且配置了令牌时强制（loopback 默认不强制，向后兼容 S1）；
  #   与既有 认证 模块会话令牌（HARNESS_WEB_TOKEN）相互独立、并存不悖。
  设 期望令牌 为 服务.令牌
  设 非回环绑定 为 非 (是回环地址(服务.绑定地址))
  如果 非回环绑定 且 期望令牌 != "" 且 期望令牌 != 空:
    设 头令牌 为 请求["头"].获取("X-Auth-Token", "")
    设 查令牌 为 提取查询令牌(查询串)
    设 令牌相符 为 假
    如果 头令牌 != "" 且 头令牌 != 空 且 头令牌 == 期望令牌:
      设 令牌相符 为 真
    如果 令牌相符 == 假 且 查令牌 != "" 且 查令牌 != 空 且 查令牌 == 期望令牌:
      设 令牌相符 为 真
    如果 令牌相符 == 假:
      设 响应 为 ["状态": 401, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未认证：非 loopback 绑定要求携带 X-Auth-Token", "type": "unauthorized"]])]
      返回 加跨域(响应)
  # ---- 认证挂载点（S2 语义）----
  设 启用认证 为 假
  设 当前令牌 为 取令牌()
  设 令牌 为 ""
  设 头令牌 为 请求["头"].获取("X-Auth-Token", "")
  设 查令牌 为 提取查询令牌(查询串)
  如果 当前令牌 != "" 且 当前令牌 != 空:
    设 启用认证 为 真
  如果 启用认证:
    # 解析出本次请求携带的有效令牌（头优先，其次 ?token=）；无有效令牌 → 令牌 保持 ""
    如果 头令牌 != "" 且 头令牌 != 空 且 校验令牌(头令牌) == 真:
      设 令牌 为 头令牌
    如果 令牌 == "" 且 查令牌 != "" 且 查令牌 != 空 且 校验令牌(查令牌) == 真:
      设 令牌 为 查令牌
    设 白名单放行 为 假
    # 默认：所有 GET 放行（health/静态/未知路径→404 兜底）；认证只保护 POST agent API
    # E2 例外：/api/sessions* 是敏感会话数据（含对话历史），启用认证时 GET 也校验。
    如果 方法 == "GET" 且 路径.查找("/api/sessions") != 0:
      设 白名单放行 为 真
    # E4：审批/权限 API 也走认证
    如果 方法 == "GET" 且 路径.查找("/api/approvals") != 0:
      设 白名单放行 为 真
    如果 方法 == "GET" 且 路径.查找("/api/permissions") != 0:
      设 白名单放行 为 真
    # 配置 API 公开（首次启动无 token 时需保存大模型配置，热更新不重启）
    如果 方法 == "POST" 且 路径 == "/api/config":
      设 白名单放行 为 真
    # 工作目录 API 公开（与配置同级；首次即可选择工作目录）
    如果 方法 == "POST" 且 路径 == "/api/cwd":
      设 白名单放行 为 真
    # 会话导入公开（与新建会话同级）
    如果 方法 == "POST" 且 路径 == "/api/sessions/import":
      设 白名单放行 为 真
    # R105 任务线 C：设置保存 API 同样公开（与 GET /api/settings 一致，首次启动无 token 时可保存设置）
    如果 方法 == "POST" 且 路径 == "/api/settings":
      设 白名单放行 为 真
    # R106：快捷键保存 API 公开（启用认证时 POST 需白名单放行，否则 401）
    如果 方法 == "POST" 且 路径 == "/api/shortcuts":
      设 白名单放行 为 真
    # R107：模型配置保存 API 同样公开（与 POST /api/config 一致；首次启动无 token 时可配置大模型）
    如果 方法 == "POST" 且 路径 == "/api/settings/model":
      设 白名单放行 为 真
    # R108 任务线 H：新 POST 端点白名单（引导/凭据/发现，与设置保存同级）
    如果 方法 == "POST" 且 路径 == "/api/settings/onboarding":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/credential":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/providers/discover":
      设 白名单放行 为 真
    # jet-hub 一键接入与设置保存同级（首次启动无 token 时也可切换模型来源）
    如果 方法 == "POST" 且 路径 == "/api/settings/providers/jet-hub/apply":
      设 白名单放行 为 真
    # R110：插件安装/卸载/启停端点与设置类 POST 同级公开
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/install":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/uninstall":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/set-enabled":
      设 白名单放行 为 真
    如果 白名单放行 == 假 且 令牌 == "":
      设 响应 为 ["状态": 401, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未认证", "type": "unauthorized"]])]
      返回 加跨域(响应)
  # ---- 路由分派 ----
  # 运行中任务控制（停止/暂停/继续/插入/工具清单）——须在 chat 之前。
  如果 方法 == "POST" 且 (路径 == "/api/task/stop" 或 路径 == "/api/task/pause" 或 路径 == "/api/task/resume" 或 路径 == "/api/task/steer" 或 路径 == "/api/task/tools" 或 路径 == "/api/task/tool/stop" 或 路径 == "/api/task/tool/pause" 或 路径 == "/api/task/tool/resume"):
    设 体文本 为 字符串(请求["体"], "utf-8")
    设 请求体表 为 解析JSON(体文本)
    如果 请求体表 == 空:
      设 请求体表 为 {}
    设 响应 为 空
    尝试:
      如果 路径 == "/api/task/stop":
        设 响应 为 处理停止任务(请求, 请求体表)
      否则如果 路径 == "/api/task/pause":
        设 响应 为 处理暂停任务(请求, 请求体表)
      否则如果 路径 == "/api/task/resume":
        设 响应 为 处理继续任务(请求, 请求体表)
      否则如果 路径 == "/api/task/steer":
        设 响应 为 处理插入提示(请求, 请求体表)
      否则如果 路径 == "/api/task/tools":
        设 响应 为 处理工具清单(请求, 请求体表)
      否则如果 路径 == "/api/task/tool/stop":
        设 响应 为 处理工具控制(请求, 请求体表, "stop")
      否则如果 路径 == "/api/task/tool/pause":
        设 响应 为 处理工具控制(请求, 请求体表, "pause")
      否则:
        设 响应 为 处理工具控制(请求, 请求体表, "resume")
      设 结果 为 加跨域(响应)
      返回 结果
    捕获 异常 e:
      返回 加跨域(控制JSON(200, ["ok": 假, "理由": 转字符串(e)]))
  如果 方法 == "GET" 且 路径 == "/health":
    设 响应 为 处理健康检查(服务)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 (路径 == "/" 或 路径 == "/app.js" 或 路径 == "/style.css" 或 路径 == "/sidebar.js" 或 路径 == "/messages.js" 或 路径 == "/tool-card.js" 或 路径 == "/settings.js" 或 路径 == "/settings.css" 或 路径 == "/slash-palette.js" 或 路径 == "/new-session.js" 或 路径 == "/index.html"):
    设 响应 为 服务.处理静态(路径)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/config":
    设 响应 为 服务.处理获取配置()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/cwd/check":
    设 响应 为 服务.处理校验工作目录(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/cwd":
    设 响应 为 服务.处理获取工作目录()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/models":
    设 响应 为 服务.处理获取模型(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings":
    设 响应 为 服务.处理获取设置页()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/document":
    设 响应 为 服务.处理获取设置文档()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/effective":
    设 响应 为 服务.处理获取生效设置(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/shortcuts":
    设 响应 为 服务.处理获取快捷键()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings":
    设 响应 为 服务.处理保存设置(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/model":
    设 响应 为 服务.处理保存模型配置(请求)
    返回 加跨域(响应)
  # ---- R108 任务线 H：新端点路由 ----
  如果 方法 == "GET" 且 路径 == "/api/settings/onboarding":
    设 响应 为 服务.处理获取引导(查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/onboarding":
    设 响应 为 服务.处理保存引导(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/credential":
    设 响应 为 服务.处理获取凭据()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/credential":
    设 响应 为 服务.处理保存凭据(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/providers":
    设 响应 为 服务.处理获取提供商()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/providers/discover":
    设 响应 为 服务.处理发现模型(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/providers/jet-hub":
    设 响应 为 服务.处理获取枢纽()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/providers/jet-hub/apply":
    设 响应 为 服务.处理应用枢纽(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/plugin-panel":
    设 响应 为 服务.处理获取插件面板()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/install":
    设 响应 为 服务.处理安装插件(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/uninstall":
    设 响应 为 服务.处理卸载插件(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/set-enabled":
    设 响应 为 服务.处理设置插件启用(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/shortcuts":
    设 响应 为 服务.处理保存快捷键(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/config":
    设 响应 为 服务.处理保存配置(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/cwd":
    设 响应 为 服务.处理保存工作目录(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/v1/chat/completions":
    设 响应 为 服务.处理对话(请求, 令牌, 查询串)
    返回 加跨域(响应)
  # ---- E2 契约 2：会话管理 API（当前会话路由先于 :id 匹配）----
  如果 方法 == "GET" 且 路径 == "/api/sessions":
    设 响应 为 服务.处理列表会话()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/sessions/current":
    设 响应 为 服务.处理当前会话(令牌, 查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/sessions/import":
    设 响应 为 服务.处理导入会话(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/sessions":
    设 响应 为 服务.处理新建会话(请求, 令牌)
    返回 加跨域(响应)
  # /api/sessions/<id>/export 必须先于通用 <id> 匹配
  # T-0490：/api/sessions/<id>/queue 必须先于通用 <id> 匹配
  如果 方法 == "GET" 且 路径.查找("/api/sessions/") == 0 且 路径.查找("/queue") == 长(路径) - 6:
    设 尾段 为 截取(路径, 14, 长(路径) - 6)
    设 响应 为 服务.处理排队状态(尾段)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径.查找("/api/sessions/") == 0 且 路径.查找("/export") == 长(路径) - 7:
    设 尾段 为 截取(路径, 14, 长(路径) - 7)
    设 响应 为 服务.处理导出会话(URL解码(尾段))
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径.查找("/api/sessions/") == 0:
    # "/api/sessions/" 长 14；截取为 0-based [start, end)，id 从索引 14 起
    设 尾段 为 截取(路径, 14, 长(路径))
    设 响应 为 服务.处理会话详情(尾段)
    返回 加跨域(响应)
  如果 方法 == "DELETE" 且 路径.查找("/api/sessions/") == 0:
    设 尾段 为 截取(路径, 14, 长(路径))
    设 响应 为 服务.处理删除会话(尾段)
    返回 加跨域(响应)
  如果 方法 == "PUT" 且 路径.查找("/api/sessions/") == 0:
    # 浏览器 fetch 会对路径中文做百分号编码（/标题 → /%E6%A0%87%E9%A2%98），先解码再匹配
    设 尾段 为 截取(路径, 14, 长(路径))
    设 解码尾段 为 URL解码(尾段)
    如果 解码尾段.查找("/标题") >= 0:
      设 标识 为 截取(解码尾段, 0, 解码尾段.查找("/标题"))
      设 响应 为 服务.处理更新标题(标识, 请求)
      返回 加跨域(响应)
  如果 方法 == "POST" 且 路径.查找("/api/sessions/") == 0:
    # /api/sessions/<id>/model —— 每个会话单独选模型（DSH chat 框选择器的落点）
    设 尾段 为 截取(路径, 14, 长(路径))
    设 解码尾段 为 URL解码(尾段)
    设 标记 为 解码尾段.查找("/model")
    如果 标记 >= 0:
      设 标识 为 截取(解码尾段, 0, 标记)
      设 响应 为 服务.处理设置会话模型(标识, 请求)
      返回 加跨域(响应)
     # T-0397：/api/sessions/<id>/模式权限 —— 会话内切模式/权限（只写该会话）
     设 模式标记 为 解码尾段.查找("/模式权限")
     如果 模式标记 >= 0:
       设 标识 为 截取(解码尾段, 0, 模式标记)
       设 响应 为 服务.处理设置会话模式权限(标识, 请求)
       返回 加跨域(响应)
    设 响应 为 错误响应(404, "未找到: " + 路径)
    返回 加跨域(响应)
  # ---- E4 契约 3：审批 API + 权限 API ----
  如果 方法 == "GET" 且 路径 == "/api/approvals":
    设 响应 为 服务.处理审批列表(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/approvals/history":
    设 响应 为 服务.处理审批历史(查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径.查找("/api/approvals/") == 0:
    # "/api/approvals/" 长 15；0-based 截取，审批 id 从索引 15 起
    设 尾段 为 截取(路径, 15, 长(路径))
    设 响应 为 服务.处理审批处理(尾段, 请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/permissions":
    设 响应 为 服务.处理获取权限()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/permissions":
    设 响应 为 服务.处理保存权限(请求)
    返回 加跨域(响应)
  # ---- R42（任务2）：真实 webhook 端点（任何方法都进门禁链；非 POST → 405）----
  #   放在兜底 404 之前；R41 非 loopback token 门禁在其上方先执行（webhook 路由继承之）。
  如果 路径 == "/webhook/github":
    设 响应 为 服务.处理webhook(请求)
    返回 加跨域(响应)
  设 响应 为 ["状态": 404, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未找到: " + 方法 + " " + 路径, "type": "not_found"]])]
  返回 加跨域(响应)

导出 Web服务端
# T-0453：待办兜底消费与序号口径对外可见（测试用它判「入队必有人取」与「水位≠最大序号」）
导出 最大事件序号, 事件序号水位, 拉起待办消费, 后台消费待办
导出 全局服务
导出 路由处理器
导出 处理健康检查
导出 处理静态
导出 处理获取配置
导出 处理保存配置
导出 更新客户端
