# ---- 路由层本体（同步方法；异步编排在模块级 路由处理器）----
类 Web服务端:
  属性 服务端 等于 空
  属性 客户端对象 等于 空
  属性 注册表 等于 空
  属性 根 等于 空
  属性 超时值 等于 30.0
  属性 绑定地址 等于 "127.0.0.1"   # R41：HTTP 绑定地址（默认本机回环，保持默认安全）
  属性 令牌 等于 ""                # R41：HARNESS_TOKEN 网络级令牌（非 loopback 绑定时强制）
  属性 请求数 等于 0
  属性 会话表 等于 空
  属性 界面目录 等于 ""   # W3：静态页面根目录；"" 表示不启用静态路由（向后兼容）
  属性 配置元数据 等于 空   # 配置状态：configured/mock/model/endpoint/has_key（不含密钥明文）
  属性 环境文件路径 等于 ""  # .env 绝对路径；POST /api/config 写入此文件
  属性 会话库 等于 空       # E2：会话存储实例（JSONL + 索引）；空表示未启用会话持久化
  属性 令牌会话表 等于 空   # E2：认证令牌 → 会话 id 绑定表
  属性 计量器 等于 空       # E5：令牌计量器（本轮/累计 token 与花费）
  属性 压缩管理器 等于 空   # E5：压缩配置（读环境变量）
  属性 上下文窗口 等于 32768  # E5：上下文窗口（用于计算使用率）
  属性 权限管理器 等于 空   # E4：权限预设管理器
  属性 审批管理器 等于 空   # E4：审批队列管理器
  属性 事件推送队列 等于 空 # E4：SSE 事件推送队列（审批请求等）
  属性 钩子秘密 等于 ""      # R42：GitHub webhook HMAC 秘密（env HARNESS_WEBHOOK_SECRET / GITHUB_WEBHOOK_SECRET）
  属性 钩子来源 等于 "github:webhook:lightharness"  # R42：webhook 交付来源标识
  属性 钩子体上限 等于 1000000  # R42：webhook 请求体上限（env HARNESS_WEBHOOK_MAX_BODY）
  属性 钩子派发记录 等于 空  # R42：webhook 派发记录（默认只记录不外联）
  属性 预设注册表缓存 等于 空  # 第5步：preset → 组装注册表(预设) 缓存（空串不缓存，走启动默认表）
  属性 快捷键目录 等于 空  # R106：快捷键自定义目录（进程内存；空=未初始化，懒加载自 默认目录）
  属性 快捷键已合并 等于 假  # R107：keybindings.json 是否已合并回目录（每次目录重建后合并一次）

  段落 构造:
    设 己.会话表 为 {}
    设 己.令牌会话表 为 {}
    设 己.计量器 为 新建 令牌计量器(取默认模型())
    设 配 为 新建 压缩配置()
    设 己.压缩管理器 为 配
    设 己.上下文窗口 为 配.上下文窗口
    设 己.权限管理器 为 新建 权限管理器()
    设 己.审批管理器 为 新建 审批管理器()
    设 己.事件推送队列 为 []
    # R42：webhook 装配（秘密/上限走环境变量，派发记录默认空）
    设 己.钩子秘密 为 环境变量("HARNESS_WEBHOOK_SECRET", 环境变量("GITHUB_WEBHOOK_SECRET", ""))
    设 己.钩子体上限 为 转整数(环境变量("HARNESS_WEBHOOK_MAX_BODY", "1000000"))
    设 己.钩子派发记录 为 []
    设 己.预设注册表缓存 为 {}

  # 装配：注入客户端（真实或 mock）+ 注册表 + 持久化根 + 静态目录，起 HTTP 服务端
  #   界面目录：绝对路径字符串；"" 表示不启用静态路由（向后兼容老调用，仍 4 参）
  #   R41（任务2）：绑定地址 / 令牌 留空 → 读环境变量（HARNESS_BIND / HARNESS_TOKEN，
  #       后者兼容既有 HARNESS_WEB_TOKEN）；显式传入则覆盖。安全铁律：绑非 loopback
  #       且无令牌 → 拒绝启动（硬报错，不警告了事）。
  段落 配置(客户端对象, 注册表, 根, 超时值, 界面目录="", 配置元数据=空, 环境文件路径="", 绑定地址="", 令牌=""):
    # 兼容旧调用：绑定地址/令牌 留空 → 读环境变量
    如果 绑定地址 == "" 或 绑定地址 == 空:
      设 绑定地址 为 环境变量("HARNESS_BIND", "127.0.0.1")
    如果 令牌 == "" 或 令牌 == 空:
      设 令牌 为 环境变量("HARNESS_TOKEN", 环境变量("HARNESS_WEB_TOKEN", ""))
    # 安全铁律：绑非 loopback 且无令牌 → 拒绝启动
    如果 非 (是回环地址(绑定地址)) 且 (令牌 == "" 或 令牌 == 空):
      抛出 新建 错误("安全铁律：绑定非 loopback 地址(" + 绑定地址 + ") 但未设置 HARNESS_TOKEN，拒绝启动（暴露到局域网必须有令牌）")
    设 己.客户端对象 为 客户端对象
    设 己.注册表 为 注册表
    设 己.根 为 根
    设 己.超时值 为 超时值
    设 己.界面目录 为 界面目录
    设 己.绑定地址 为 绑定地址
    设 己.令牌 为 令牌
    如果 配置元数据 == 空:
      设 己.配置元数据 为 []
    否则:
      设 己.配置元数据 为 配置元数据
    设 己.环境文件路径 为 环境文件路径
    设 己.服务端 为 新建 HTTP服务端(路由处理器, 超时值, 绑定地址)

  # E2：注入会话存储实例（JSONL + 索引）。可在 配置() 前后任意时点调用；
  #   会话库 为空时 /api/sessions* 路由返回 503（不启用），/v1/chat/completions 行为不变。
  段落 设置会话库(会话库):
    设 己.会话库 为 会话库

  # R42：webhook 装配接口（供测试/宿主注入；秘密与体上限默认走环境变量）
  段落 设置钩子秘密(值):
    设 己.钩子秘密 为 值

  段落 设置钩子体上限(值):
    设 己.钩子体上限 为 值

  段落 清空钩子派发():
    设 己.钩子派发记录 为 []
    设 己.预设注册表缓存 为 {}

  段落 钩子派发数():
    返回 长(己.钩子派发记录)

  # 热更新客户端（配置保存后调用；不重建 HTTP 服务端，端口不变）
  段落 更新客户端(客户端对象, 配置元数据=空):
    设 己.客户端对象 为 客户端对象
    如果 配置元数据 != 空:
      设 己.配置元数据 为 配置元数据

  # 内核分配端口（HTTP服务端 构造即 bind(("127.0.0.1", 0))）
  段落 端口():
    返回 己.服务端.端口()

  段落 停止():
    如果 己.服务端 != 空:
      己.服务端.停止()

  # 404 JSON（沿用现有 404 格式：JSON + application/json）
  段落 响应404(路由):
    返回 ["状态": 404, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未找到: " + 路由, "type": "not_found"]])]

  # 静态页面路由（W3 契约 1、4）：仅支持文本资源，文件不存在 → 404（不抛 500）
  #   界面目录 == "" → 未启用 → 一律 404（向后兼容）；静态目录一律用传入路径，不外推当前目录()
  段落 处理静态(路径):
    如果 己.界面目录 == "" 或 己.界面目录 == 空:
      返回 己.响应404(路径)
    设 文件名 为 ""
    设 类型 为 ""
    如果 路径 == "/":
      设 文件名 为 "index.html"
      设 类型 为 "text/html; charset=utf-8"
    否则 如果 路径 == "/app.js":
      设 文件名 为 "app.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/style.css":
      设 文件名 为 "style.css"
      设 类型 为 "text/css; charset=utf-8"
    否则 如果 路径 == "/sidebar.js":
      设 文件名 为 "sidebar.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/messages.js":
      设 文件名 为 "messages.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/tool-card.js":
      设 文件名 为 "tool-card.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/settings.js":
      设 文件名 为 "settings.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/settings.css":
      设 文件名 为 "settings.css"
      设 类型 为 "text/css; charset=utf-8"
    否则 如果 路径 == "/slash-palette.js":
      设 文件名 为 "slash-palette.js"
      设 类型 为 "application/javascript; charset=utf-8"
    否则 如果 路径 == "/index.html":
      设 文件名 为 "index.html"
      设 类型 为 "text/html; charset=utf-8"
    否则:
      返回 己.响应404(路径)
    设 全路径 为 路径连接(己.界面目录, 文件名)
    如果 文件存在(全路径) == 假:
      返回 己.响应404(路径)
    设 内容 为 读取文件(全路径)
    返回 ["状态": 200, "头": ["Content-Type": 类型], "体": 内容]

  # 会话管理：空标识 → 新会话；有标识 → 内存缓存 → 磁盘续写（读入会话）→ 无则新建
  段落 取会话(标识):
    设 工作目录 为 当前目录()
    如果 标识 == "":
      设 新标识 为 "web_" + 转字符串(时间戳())
      设 新会话 为 新建会话(新标识, 工作目录)
      己.会话表[新标识] 为 新会话
      返回 新会话
    如果 己.会话表.包含(标识):
      返回 己.会话表[标识]
    设 会话对象 为 空
    尝试:
      设 会话对象 为 读入会话(己.根, 工作目录, 标识)
    捕获 异常 e:
      设 会话对象 为 新建会话(标识, 工作目录)
    己.会话表[标识] 为 会话对象
    返回 会话对象

  # 提取最后一条用户消息的文本（content 为字符串或 OpenAI 多模态文本片段列表）
  段落 提取用户文本(消息表):
    设 结果 为 ""
    遍历 消息 之 消息表:
      如果 是字典(消息) 且 消息.获取("role", "") == "user":
        设 内容 为 消息.获取("content", "")
        如果 是字符串(内容):
          设 结果 为 内容
        否则 如果 是列表(内容):
          设 拼接 为 ""
          遍历 部分 之 内容:
            如果 是字典(部分) 且 部分.获取("type", "") == "text":
              设 拼接 为 拼接 + 部分.获取("text", "")
          设 结果 为 拼接
    返回 结果

  # 生成非流式对话响应 JSON
  段落 生成对话JSON(会话对象, 模型, 结果):
    设 全文 为 取最终文本(会话对象)
    设 输入 为 结果.获取("输入token", 0)
    设 输出 为 结果.获取("输出token", 0)
    返回 序列化JSON(["id": "chatcmpl-web-" + 转字符串(时间戳()), "object": "chat.completion", "model": 模型, "choices": [["index": 0, "message": ["role": "assistant", "content": 全文], "finish_reason": "stop"]], "usage": ["prompt_tokens": 输入, "completion_tokens": 输出, "total_tokens": 输入 + 输出]])

  # 生成 SSE 流式体：角色块 → 内容增量/工具事件（按序号混排）→ 结束块 → [DONE]
  #   起始序号：只回放 序号 >= 起始序号 的事件；0 = 不限制（回放全部，老调用行为不变）
  #   E5：在结束块之后、[DONE] 之前追加「统计」事件，包含本轮输入/输出、累计总数、花费、上下文使用率
  #   E3：把会话事件 tool/call、tool/result 映射为契约 1 帧（种类=工具调用/工具结果），
  #       与文本增量按事件序号稳定排序混排，驱动前端工具卡片；结尾追加「会话」帧绑定 E2 会话
  段落 生成SSE(会话对象, 模型, 起始序号 = 0):
    设 行表 为 []
    行表.追加(["id": "chatcmpl-web-" + 转字符串(时间戳()), "object": "chat.completion.chunk", "model": 模型, "choices": [["index": 0, "delta": ["role": "assistant", "content": ""], "finish_reason": 空]]])
    设 混排表 为 []
    设 有增量 为 假
    # 文本增量帧（assistant/chunk → OpenAI delta）
    设 块事件表 为 会话对象.查询事件("assistant/chunk", 起始序号, 0)
    遍历 记录 之 块事件表:
      设 块 为 记录["数据"]["chunk"]
      如果 块["type"] == "text-delta" 且 块["text"] != "":
        混排表.追加(["序号": 记录["序号"], "帧": ["choices": [["index": 0, "delta": ["content": 块["text"]], "finish_reason": 空]]]])
        设 有增量 为 真
    # 工具调用事件 → 契约 1「工具调用」帧（参数为模型原始 arguments 文本）
    设 调用事件表 为 会话对象.查询事件("tool/call", 起始序号, 0)
    遍历 记录 之 调用事件表:
      设 调用数据 为 记录["数据"]
      混排表.追加(["序号": 记录["序号"], "帧": ["种类": "工具调用", "工具名": 调用数据.获取("name", ""), "参数": 调用数据.获取("arguments", ""), "轮次": 调用数据.获取("turn", 0), "调用id": 调用数据.获取("callId", ""), "序号": 记录["序号"]]])
    # 工具结果事件 → 契约 1「工具结果」帧（经 源序号 关联调用事件回填工具名）
    设 结果事件表 为 会话对象.查询事件("tool/result", 起始序号, 0)
    遍历 记录 之 结果事件表:
      设 结果数据 为 记录["数据"]
      设 结果消息 为 结果数据.获取("消息", 空)
      设 源序号 为 结果数据.获取("源序号", 0)
      设 工具名 为 ""
      遍历 候选记录 之 调用事件表:
        如果 候选记录["序号"] == 源序号:
          设 候选数据 为 候选记录["数据"]
          设 工具名 为 候选数据.获取("name", "")
      设 内容文本 为 ""
      设 调用id文本 为 ""
      设 是否错误 为 假
      如果 结果消息 != 空:
        设 是否错误 为 结果消息.获取("isError", 假)
        # content 是块表：取 tool-result 块的 toolCallId 与内容；text 块拼接为可读文本，
        # 非块表内容序列化兜底（原先把块表原样塞进「结果」，UI 渲染不出文本）
        设 内容块表 为 结果消息.获取("content", [])
        遍历 块 之 内容块表:
          如果 type(块) == dict 且 块.包含("type") 且 块["type"] == "tool-result":
            设 调用id文本 为 块.获取("toolCallId", 调用id文本)
            设 块内 为 块.获取("content", "")
            如果 type(块内) == list:
              遍历 子块 之 块内:
                如果 type(子块) == dict 且 子块.包含("type") 且 子块["type"] == "text":
                  设 内容文本 为 内容文本 + 子块.获取("text", "")
            否则:
              设 内容文本 为 序列化JSON(块内)
      设 错误文本 为 ""
      如果 是否错误 == 真:
        设 错误文本 为 "执行出错"
      混排表.追加(["序号": 记录["序号"], "帧": ["种类": "工具结果", "工具名": 工具名, "结果": 内容文本, "错误": 错误文本, "是否错误": 是否错误, "调用id": 调用id文本, "序号": 记录["序号"]]])
    # 按事件序号稳定排序（插入排序；光明无 lambda，不用 sort(key=)；压缩后表序≠序号序）
    设 混排表 为 己.排序SSE帧(混排表)
    遍历 项 之 混排表:
      行表.追加(项["帧"])
    # 无增量兜底：整段最终文本
    如果 有增量 == 假:
      设 全文 为 取最终文本(会话对象)
      如果 全文 != "":
        行表.追加(["choices": [["index": 0, "delta": ["content": 全文], "finish_reason": 空]]])
    行表.追加(["choices": [["index": 0, "delta": {}, "finish_reason": "stop"]]])
    # E5：追加统计事件
    设 统计 为 己.生成统计事件()
    行表.追加(统计)
    # E4：追加待审批事件（本轮产生的审批请求通过 SSE 推送给前端）
    遍历 审批项 之 己.审批管理器.全部待审批():
      行表.追加(己.生成审批事件(审批项))
    # E3：会话标识帧（前端据此绑定 E2 会话，驱动侧边栏联动）
    行表.追加(["种类": "会话", "session_id": 会话对象.标识])
    设 输出 为 ""
    遍历 项 之 行表:
      设 输出 为 输出 + "data: " + 序列化JSON(项) + "\n\n"
    设 输出 为 输出 + "data: [DONE]\n\n"
    返回 输出

  # E3：混排帧按 序号 稳定排序（插入排序，返回新列表，不改入参）
  段落 排序SSE帧(项表):
    设 结果 为 []
    遍历 项 之 项表:
      结果.追加(项)
    设 n 为 长(结果)
    设 i 为 1
    当 i < n:
      设 当前 为 结果[i]
      设 j 为 i - 1
      当 j >= 0 且 结果[j]["序号"] > 当前["序号"]:
        结果[j + 1] 为 结果[j]
        设 j 为 j - 1
      结果[j + 1] 为 当前
      设 i 为 i + 1
    返回 结果

  # E5：生成统计事件字典（本轮输入/输出、累计总数、花费、上下文使用率）
  段落 生成统计事件:
    设 本轮 为 己.计量器.本轮统计()
    设 累计 为 己.计量器.累计统计()
    设 本轮总 为 本轮["本轮输入"] + 本轮["本轮输出"]
    设 累计总 为 累计["累计输入"] + 累计["累计输出"]
    设 使用率 为 0
    如果 己.上下文窗口 > 0:
      设 使用率 为 (转浮点(本轮总) * 100.0) / 转浮点(己.上下文窗口)
    设 花费 为 累计["累计花费"]
    返回 ["种类": "统计", "本轮输入": 本轮["本轮输入"], "本轮输出": 本轮["本轮输出"], "累计总": 累计总, "花费": 花费, "上下文使用率": 使用率]

  # 第5步：按请求 preset 取注册表（带缓存）。
  #   空 preset → 启动默认表（己.注册表，HARNESS_PRESET 环境变量口径不变）；
  #   已知预设 → 首次 组装注册表(预设) 后缓存，切换后首轮及以后每轮都运行在新挂载组合下；
  #   未知预设 → 返回 空，由调用方回 400。
  段落 取预设注册表(预设标识):
    如果 预设标识 == 空 或 预设标识 == "":
      返回 己.注册表
    如果 是已知预设(预设标识) == 假:
      返回 空
    如果 己.预设注册表缓存 == 空:
      设 己.预设注册表缓存 为 {}
    如果 字典包含键(己.预设注册表缓存, 预设标识):
      返回 字典获取(己.预设注册表缓存, 预设标识, 空)
    设 表 为 组装注册表(预设标识, 己.根)
    设 己.预设注册表缓存[预设标识] 为 表
    返回 表

  # POST /v1/chat/completions：解析入参 → 会话 → 跑一轮 → 增量保存 → 非流式 JSON / SSE
  段落 处理对话(请求, 令牌 = "", 查询串 = ""):
    尝试:
      设 己.请求数 为 己.请求数 + 1
      设 体字节 为 请求["体"]
      设 文本 为 字符串(体字节, "utf-8")
      设 载荷 为 空
      尝试:
        设 载荷 为 解析JSON(文本)
      捕获 异常 e:
        返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
      如果 载荷 == 空 或 是字典(载荷) == 假:
        返回 错误响应(400, "请求体必须是 JSON 对象")
      设 模型 为 载荷.获取("model", "")
      设 消息表 为 载荷.获取("messages", [])
      如果 是列表(消息表) == 假:
        返回 错误响应(400, "messages 必须是数组")
      设 流式 为 载荷.获取("stream", 假)
      设 会话标识 为 载荷.获取("session_id", "")
      设 会话标识 为 解析会话标识(己, 会话标识, 令牌, 查询串)
      # 第5步：chat 框模式选择——请求携带 preset（minimal/cordis/standard/ptc），
      #   按第 4 步装配逻辑取该模式的注册表（缓存复用）；空则用启动默认表
      设 预设标识 为 载荷.获取("preset", "")
      设 本轮注册表 为 己.取预设注册表(预设标识)
      如果 本轮注册表 == 空:
        返回 错误响应(400, "未知 agent preset: " + 预设标识 + "（可用: minimal / cordis / standard / ptc）")
      设 用户文本 为 己.提取用户文本(消息表)
      如果 用户文本 == "":
        返回 错误响应(400, "messages 缺少用户消息")
      设 会话对象 为 己.取会话(会话标识)
      设 保存前序号 为 长(会话对象.汇集全部事件())
      # E5：切换模型（保持计量器与客户端一致）
      如果 模型 != "" 且 模型 != 空:
        己.计量器.设置模型(模型)
      己.计量器.重置本轮()
      设 结果 为 空
      尝试:
        设 结果 为 跑一轮(己.客户端对象, 本轮注册表, 会话对象, 用户文本)
      捕获 异常 e:
        返回 错误响应(500, "驱动失败: " + 转字符串(e))
      # E5：记录响应（输入/输出 token 与花费）
      如果 结果 != 空 且 type(结果) == dict:
        己.计量器.记录响应(结果)
      如果 结果 != 空 且 结果.包含("种类") 且 结果["种类"] == "error":
        返回 错误响应(500, 转字符串(结果["失败"]))
      尝试:
        增量保存(己.根, 会话对象, 保存前序号)
      捕获 异常 e:
        返回 错误响应(500, "会话保存失败: " + 转字符串(e))
      # E2：每轮对话同时持久化到 JSONL 会话（会话库为空则跳过，行为不变）
      如果 己.会话库 != 空:
        设 持久化错误 为 ""
        尝试:
          己.会话库.追加消息(会话标识, ["角色": "user", "内容": 用户文本])
        捕获 异常 e:
          设 持久化错误 为 转字符串(e)
        尝试:
          己.会话库.追加消息(会话标识, ["角色": "assistant", "内容": 取最终文本(会话对象)])
        捕获 异常 e:
          设 持久化错误 为 转字符串(e)
        如果 持久化错误 != "":
          返回 错误响应(500, "会话持久化失败: " + 持久化错误)
      # E2：首条用户消息驱动标题生成（标题仍为默认值时更新）
      如果 己.会话库 != 空:
        尝试:
          设 当前元数据 为 己.会话库.取元数据(会话标识)
          如果 当前元数据 != 空 且 当前元数据.获取("标题", "") == "新会话":
            设 新标题 为 生成标题([{"角色": "user", "内容": 用户文本}])
            如果 新标题 != "" 且 新标题 != "新会话":
              己.会话库.更新标题(会话标识, 新标题)
        捕获 异常 e:
          设 标题忽略 为 空
      如果 流式 == 真:
        # E3：只回放本轮事件（保存前序号之后），避免同会话续聊重放历史
        设 体 为 己.生成SSE(会话对象, 模型, 保存前序号)
        返回 ["状态": 200, "头": ["Content-Type": "text/event-stream; charset=utf-8"], "体": 体]
      设 体 为 己.生成对话JSON(会话对象, 模型, 结果)
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]
    捕获 异常 e:
      返回 错误响应(500, "处理对话异常: " + 转字符串(e))
  # GET /api/config：返回配置状态（不含密钥明文）
  段落 处理获取配置():
    设 己.请求数 为 己.请求数 + 1
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(己.配置元数据)]

  # ---- 设置持久化（R105 任务线 C）：<持久化根>/settings.json，形状 {行id: 值} ----
  #   落点 = 路径连接(己.根, "settings.json")；己.根 由 配置(客户端对象, 注册表, 根, ...) 第三参注入。
  #   ⚠ 己.根 为空（未装配）→ 降级为「不落盘」：读恒为空字典、写直接返回假，绝不抛异常。
  # 读已存设置() -> 字典；文件不存在 / 坏 JSON / 非字典 → 空字典（绝不抛 500）
  段落 读已存设置():
    设 空表 为 {}
    如果 己.根 == "" 或 己.根 == 空:
      返回 空表
    设 全路径 为 路径连接(己.根, "settings.json")
    如果 文件存在(全路径) == 假:
      返回 空表
    尝试:
      设 文本 为 读取文件(全路径)
      设 表 为 解析JSON(文本)
      如果 是字典(表) == 假:
        返回 空表
      返回 表
    捕获 异常 e:
      返回 空表

  # 写已存设置(表) -> 真假；未装配根 → 假（不落盘、不抛异常）
  段落 写已存设置(表):
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    设 全路径 为 路径连接(己.根, "settings.json")
    尝试:
      写入文件(全路径, 序列化JSON(表))
      返回 真
    捕获 异常 e:
      返回 假

  # 合并已存设置(页结构)：把持久化的 {行id: 值} 覆盖进 通用设置.行集 各行的 "值"。
  #   ⚠ A 线契约：行集为九行模型，第 9 行 shortcuts 类型=按钮、无 "值" 字段 → 跳过不覆盖。
  #   ⚠ 兼容：通用设置 里还没有 行集（A 线未合流的旧形状 {"内置插件": {...}}）→ 原样返回，不报错。
  #     A 线合流后如形状再有变，以任务书 §2 契约为准，本段落只需保证「无行集即原样返回」。
  #   ✅ R105 收口复核（主 agent）：A 线 通用设置块() 产出的确为 {配置文档, 行集}，行集九行、
  #     shortcuts 类型=按钮无「值」字段 —— 与本段落假设一致，无需临时校验器替换。
  段落 合并已存设置(页结构):
    如果 是字典(页结构) == 假:
      返回 页结构
    如果 字典包含键(页结构, "通用设置") == 假:
      返回 页结构
    设 通用 为 页结构["通用设置"]
    如果 是字典(通用) == 假:
      返回 页结构
    如果 字典包含键(通用, "行集") == 假:
      返回 页结构
    设 行集 为 通用["行集"]
    如果 是列表(行集) == 假:
      返回 页结构
    设 存值 为 己.读已存设置()
    设 新集 为 列表创建()
    遍历 行 之 行集:
      如果 是字典(行) == 假:
        列表追加(新集, 行)
      否则:
        设 标识 为 字典获取(行, "id", "")
        设 行类型 为 字典获取(行, "类型", "")
        如果 标识 != "" 且 行类型 != "按钮" 且 字典包含键(存值, 标识) == 真:
          设 覆盖行 为 {}
          遍历 键 之 字典键列表(行):
            如果 键 == "值":
              字典设置(覆盖行, 键, 存值[标识])
            否则:
              字典设置(覆盖行, 键, 行[键])
          列表追加(新集, 覆盖行)
        否则:
          列表追加(新集, 行)
    字典设置(通用, "行集", 新集)
    返回 页结构

  # GET /api/settings：返回设置页结构（四页签 + 各页数据）
  #   通用设置 来自 src/设置页.light（九行行集）；模型/内置插件/Agent预设 三键
  #   R107 任务线 E 起改为 A/B/C 线真实产出（页结构形状不变，仅内容真实化）：
  #     模型      ← 设置模型页.渲染模型页(己.配置元数据)（凭据视图派生，永不回显明文）
  #     内置插件  ← 设置插件页.渲染插件页(内部工具注册表)（会话计数=展平叶子 29/30/6/30）
  #     Agent预设 ← 设置预设页.渲染预设页(已存设置, 开发者工具行值)
  #   返回前仍用 合并已存设置 把 <根>/settings.json 的持久化值合并进 通用设置.行集（R105 语义不变）。
  段落 处理获取设置页():
    设 己.请求数 为 己.请求数 + 1
    设 页结构 为 渲染设置页()
    # ---- 三页真实化（R107 E）----
    设 页结构["模型"] 为 设置页深化.渲染模型页(己.配置元数据)
    # 内置插件页需要内部工具注册表（名单=登记序、描述表含 description 顶键）；
    #   兼容注册表 的 描述表 是 OpenAI wire 形状，须取其 内部表；无 内部表（裸 工具注册表）→ 原样。
    设 插件注册表 为 己.注册表
    如果 插件注册表 == 空:
      设 插件注册表 为 组装注册表(空, 己.根)
    设 内部表 为 插件注册表
    尝试:
      设 内部表 为 插件注册表.内部表
    捕获 异常 e:
      设 内部表 为 插件注册表
    设 页结构["内置插件"] 为 设置页深化.渲染插件页(内部表, "standard", 空)
    设 已存 为 己.读已存设置()
    设 开发者工具值 为 真
    如果 字典包含键(已存, "developerTools"):
      如果 已存["developerTools"] == 假 或 已存["developerTools"] == 0:
        设 开发者工具值 为 假
    设 页结构["Agent预设"] 为 设置页深化.渲染预设页(已存, 开发者工具值)
    设 页结构 为 己.合并已存设置(页结构)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(页结构)]

  # POST /api/config：保存大模型配置到 .env，热更新客户端（端口不变）
  段落 处理保存配置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 密钥 为 载荷.获取("api_key", "")
    设 端点 为 载荷.获取("base_url", "https://api.deepseek.com")
    如果 端点.查找("chat/completions") == -1:
      设 端点 为 端点 + "/chat/completions"
    设 模型 为 载荷.获取("model", 取默认模型())
    如果 密钥 == "" 或 密钥 == 空:
      返回 错误响应(400, "api_key 不能为空")
    # 写 .env（三行；覆盖式写入）
    如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
      设 环境内容 为 "OPENAI_API_KEY=" + 密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
      尝试:
        写入文件(己.环境文件路径, 环境内容)
      捕获 异常 e:
        返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
    # 热更新客户端（真实客户端；端口不变）
    设 新客户端 为 新建 客户端(端点, 密钥, 模型)
    设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
    己.更新客户端(新客户端, 新元数据)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["ok": 1, "message": "配置已保存并热更新", "config": 新元数据])]

  # GET /api/settings/document：设置「配置文档」路径与可用状态 -> {"路径": <串>, "可用": 真假}
  #   R107 任务线 E（P1，R106 遗留纠正）：上游 profile patch 真实路径是
  #   $DSH_HOME/profiles/<profile>/cordis.patch.yml
  #   （packages/boot/app-boot/src/profile.ts:37,40 + :169-175；config-editor/src/index.ts:34,142）。
  #   R106 落的 "<档位>.patch.yml" 文件名与目录分段都不对，本轮修正：
  #     文件名 = 启动配置.补丁文件名（cordis.patch.json，光明 JSON 替代 YAML 的既有偏离）；
  #     目录分段 = 启动配置.资料夹名 + "web"（本仓 Web 运行时 profile 名，沿用 R106）。
  #   ⛔ 保持删除态：不拿 .env 冒充 profile patch；文件不存在 → 路径="" 且 可用=假，不编造绝对路径。
  段落 处理获取设置文档():
    设 己.请求数 为 己.请求数 + 1
    设 profiles目录 为 路径连接(己.根, 启动配置.资料夹名)
    设 web目录 为 路径连接(profiles目录, "web")
    设 全路径 为 路径连接(web目录, 启动配置.补丁文件名)
    设 路径串 为 ""
    设 可用 为 假
    如果 文件存在(全路径) == 真:
      设 路径串 为 全路径
      设 可用 为 真
    设 结果 为 {"路径": 路径串, "可用": 可用, "说明": "~/.dsh/profiles/web/cordis.patch.json 语义"}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/model：模型页配置写回（R107 任务线 E，A 线校验复用）
  #   body {"api_key","base_url","api","display_name","model","models"}（键均可选）：
  #   · 校验全部走 A 线：密钥 校验密钥(明文, 是否已有)（空且已有 → 合法=保持已存）；
  #     models 逐行 校验模型行(行, 既有目录行集)（空 id / 重复 id / 上下文窗口 / 最大输出，逐字消息）。
  #   · api_key 非空才写 .env（三行 OPENAI_API_KEY/BASE_URL/MODEL 兼容不变）并热更新客户端；
  #     空 api_key 不报错、不写 .env（上游语义：留空=保持已存密钥；本仓 .env 为覆盖式三行，
  #     若只重写 端点/模型 行会丢密钥行，故整体跳过——取舍见交付报告）。
  #   · 响应 {"状态":"ok","凭据":{configured,source,writable}}，⛔ 绝不含密钥明文。
  #   · 校验失败 → 400 {"错误": <A 线逐字消息>}。
  段落 处理保存模型配置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    # ---- 凭据现状（是否已有密钥）----
    设 现凭据 为 设置模型页.凭据视图(己.配置元数据)
    设 是否已有 为 现凭据["configured"]
    # ---- 密钥校验（A 线逐字消息）----
    设 密钥 为 字典获取(载荷, "api_key", "")
    设 判密 为 设置模型页.校验密钥(密钥, 是否已有)
    如果 判密["合法"] == 假:
      设 坏密钥体 为 序列化JSON(["错误": 判密["消息"]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏密钥体]
    # ---- 模型行校验（可选键 models；A 线逐字消息）----
    如果 字典包含键(载荷, "models"):
      设 模型行表 为 载荷["models"]
      如果 是列表(模型行表):
        设 既有行 为 设置模型页.模型行集(己.配置元数据)
        遍历 模型行 之 模型行表:
          设 判行 为 设置模型页.校验模型行(模型行, 既有行)
          如果 判行["合法"] == 假:
            设 坏行体 为 序列化JSON(["错误": 判行["消息"]])
            返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏行体]
    # ---- 写 .env + 热更新（api_key 非空才写；响应不含明文）----
    如果 密钥 != "":
      设 端点 为 载荷.获取("base_url", "https://api.deepseek.com")
      如果 端点.查找("chat/completions") == -1:
        设 端点 为 端点 + "/chat/completions"
      设 模型 为 载荷.获取("model", 取默认模型())
      如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
        设 环境内容 为 "OPENAI_API_KEY=" + 密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
        尝试:
          写入文件(己.环境文件路径, 环境内容)
        捕获 异常 e:
          返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
      设 新客户端 为 新建 客户端(端点, 密钥, 模型)
      设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
      己.更新客户端(新客户端, 新元数据)
    # ---- 响应：凭据视图三键（永不回显明文）----
    设 新凭据 为 设置模型页.凭据视图(己.配置元数据)
    设 凭据体 为 {}
    字典设置(凭据体, "状态", "ok")
    字典设置(凭据体, "凭据", 新凭据)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(凭据体)]

  # POST /api/settings：保存单行通用设置 -> body {"行": <行id>, "值": <新值>}
  #   校验：直接调 设置页.校验通用值(行id, 新值) -> {"合法": 真假, "消息": 串}（已实测存在，签名一致）。
  #     未知行id 时 设置页.取通用行 会抛错 → 捕获后按「非法」返回 400，不 500。
  #   合法 → 落盘 <根>/settings.json → 200 {"状态": "ok", "行集": <合并后的完整行集>}；
  #   非法 → 400 {"错误": <校验消息>}（JSON 体，与既有 400 同为 application/json）。
  段落 处理保存设置(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 行标识 为 字典获取(载荷, "行", "")
    如果 行标识 == "" 或 行标识 == 空:
      返回 错误响应(400, "缺少 行 字段")
    设 新值 为 字典获取(载荷, "值", 空)
    # ---- R107 任务线 E（C 线写路径）：行=agentPresetDefault → 设为新任务默认 ----
    #   校验与落盘规则只有一套（设置预设页.设为默认预设），⛔ 本层不复制规则；
    #   开发者工具行值从已存设置读（未存默认 真，与通用设置行默认一致）。
    #   非法（未知预设 / 开发者工具为假）→ 400 {"错误": <C 线逐字消息>}；
    #   合法 → 落盘 settings.json（agentPresetDefault 键）→ 200 {"状态":"ok","默认预设":<id>}。
    如果 行标识 == "agentPresetDefault":
      设 已存设置 为 己.读已存设置()
      设 开发者工具值 为 真
      如果 字典包含键(已存设置, "developerTools"):
        如果 已存设置["developerTools"] == 假 或 已存设置["developerTools"] == 0:
          设 开发者工具值 为 假
      设 默认判定 为 设置预设页.设为默认预设(已存设置, 新值, 开发者工具值)
      如果 默认判定["合法"] == 假:
        设 坏默认体 为 序列化JSON(["错误": 默认判定["消息"]])
        返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏默认体]
      己.写已存设置(默认判定["设置"])
      设 好默认体 为 序列化JSON(["状态": "ok", "默认预设": 默认判定["设置"]["agentPresetDefault"]])
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 好默认体]
    设 校验 为 {"合法": 假, "消息": "未校验"}
    尝试:
      设 校验 为 校验通用值(行标识, 新值)
    捕获 异常 e:
      设 校验 为 {"合法": 假, "消息": 转字符串(e)}
    如果 校验["合法"] == 假:
      设 坏体 为 序列化JSON(["错误": 校验["消息"]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体]
    设 存值 为 己.读已存设置()
    字典设置(存值, 行标识, 新值)
    己.写已存设置(存值)
    设 页结构 为 渲染设置页()
    设 页结构 为 己.合并已存设置(页结构)
    设 行集 为 字典获取(页结构["通用设置"], "行集", 列表创建())
    # R106：行=permission 时，落盘之外同步 权限管理器.设置预设(<映射后预设名>)；
    #   响应在原 {"状态":"ok","行集":[...]} 两键之外追加 "权限预设"（向后兼容，不删原键）。
    #   权限管理器 为空（未装配）时跳过联动，不抛异常。
    设 响应表 为 ["状态": "ok", "行集": 行集]
    如果 行标识 == "permission":
      如果 己.权限管理器 != 空:
        设 映射预设 为 设置生效.档位取预设(新值)
        己.权限管理器.设置预设(映射预设)
        字典设置(响应表, "权限预设", 映射预设)
    设 好体 为 序列化JSON(响应表)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 好体]

  # ---- R106 任务线 C：生效设置端点（接线 A 线生效链）----
  # GET /api/settings/effective?系统偏好=light|dark
  #   读已存设置 → 解析可选 系统偏好（缺省 light，非法按 light）→ 取运行时预设
  #   （权限管理器 非空 → 当前预设()，否则 空）→ 设置生效.生效参数(...) → 200 七键对象。
  #   认证：默认所有 GET 放行（:990-993），无需改白名单。
  段落 处理获取生效设置(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 系统偏好 为 "light"
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 字典包含键(参数, "系统偏好") == 真:
        设 系统偏好 为 参数["系统偏好"]
    如果 系统偏好 != "dark":
      设 系统偏好 为 "light"
    设 已存 为 己.读已存设置()
    设 运行时预设 为 空
    如果 己.权限管理器 != 空:
      设 运行时预设 为 己.权限管理器.当前预设()
    设 生效 为 设置生效.生效参数(已存, 系统偏好, 运行时预设)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(生效)]

  # 取快捷键目录（懒加载；R107 任务线 E 起：目录重建后把 <根>/keybindings.json 的
  #   自定义键合并回默认目录（逐条走 快捷键.应用变更，非法绑定静默跳过不阻断），
  #   每次目录生命周期只合并一次（快捷键已合并 标志）。
  段落 取快捷键目录():
    如果 己.快捷键目录 == 空:
      设 己.快捷键目录 为 快捷键.默认目录("other")
      设 己.快捷键已合并 为 假
    如果 己.快捷键已合并 == 假:
      设 己.快捷键已合并 为 真
      设 绑定表 为 己.读快捷键绑定()
      遍历 命令id 之 字典键列表(绑定表):
        设 合并结果 为 快捷键.应用变更(己.快捷键目录, 命令id, 绑定表[命令id], "other")
        如果 合并结果[1] != "错误":
          设 己.快捷键目录 为 合并结果[0]
    返回 己.快捷键目录

  # 读快捷键绑定() -> {命令id: 物理规范串}；文件缺失/坏 JSON/形状不符 → 空表（绝不抛）
  #   形状 {"version":1,"bindings":{<命令id>:<物理规范串>}}
  段落 读快捷键绑定():
    设 空表 为 {}
    如果 己.根 == "" 或 己.根 == 空:
      返回 空表
    设 全路径 为 路径连接(己.根, "keybindings.json")
    如果 文件存在(全路径) == 假:
      返回 空表
    尝试:
      设 表 为 解析JSON(读取文件(全路径))
      如果 是字典(表) == 假:
        返回 空表
      设 绑定 为 字典获取(表, "bindings", {})
      如果 是字典(绑定) == 假:
        返回 空表
      返回 绑定
    捕获 异常 e:
      返回 空表

  # 落盘快捷键(目录) -> 真假：把目录中的自定义行写 <根>/keybindings.json
  #   形状 {"version":1,"bindings":{<命令id>:<物理规范串>}}；无自定义行 → 写空 bindings（文件仍在，
  #   快捷键文档.可用 首次写入后为真）。本仓 落盘包装 在 web服务器 侧完成（src/快捷键.light 属
  #   R106 D 线独占文件，本轮不改——取舍见交付报告）。
  段落 落盘快捷键(目录):
    如果 己.根 == "" 或 己.根 == 空:
      返回 假
    设 绑定 为 {}
    遍历 行 之 目录:
      如果 字典获取(行, "是否自定义", 假) == 真:
        字典设置(绑定, 行["id"], 行["当前键"])
    设 载荷 为 {"version": 1, "bindings": 绑定}
    尝试:
      写入文件(路径连接(己.根, "keybindings.json"), 序列化JSON(载荷))
      返回 真
    捕获 异常 e:
      返回 假

  # GET /api/shortcuts → {"文档", "自定义计数", "目录"}（接线 D 线模型）
  段落 处理获取快捷键():
    设 己.请求数 为 己.请求数 + 1
    设 文档 为 快捷键.快捷键文档(己.根)
    设 目录 为 己.取快捷键目录()
    设 计数 为 快捷键.自定义计数(目录)
    设 结果 为 {"文档": 文档, "自定义计数": 计数, "目录": 目录}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/shortcuts：body {"命令":<id>,"键":<键串>} 或 {"重置":真}
  #   走 D 线 应用变更 / 重置全部；成功 200 {"状态":"ok","目录":[...]}；
  #   非法/冲突 400 {"错误":<D 线返回消息>}——文案一律取 D 线，本层不拼上游文案。
  段落 处理保存快捷键(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 目录 为 己.取快捷键目录()
    # 全量重置
    如果 字典包含键(载荷, "重置") == 真 且 载荷["重置"] == 真:
      设 新目录 为 快捷键.重置全部(目录)
      设 己.快捷键目录 为 新目录
      # R107：目录变更落盘（重置 → bindings 空表仍写文件，保持 快捷键文档.可用 语义稳定）
      己.落盘快捷键(新目录)
      设 结果 为 {"状态": "ok", "目录": 新目录}
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]
    设 命令id 为 字典获取(载荷, "命令", "")
    设 键串 为 字典获取(载荷, "键", "")
    如果 命令id == "" 或 命令id == 空:
      返回 错误响应(400, "缺少 命令 字段")
    设 应用 为 快捷键.应用变更(目录, 命令id, 键串, "other")
    如果 应用[1] == "错误":
      设 坏体 为 序列化JSON(["错误": 应用[2]])
      返回 ["状态": 400, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 坏体]
    设 己.快捷键目录 为 应用[0]
    # R107：目录变更落盘（自定义键写 keybindings.json）
    己.落盘快捷键(应用[0])
    设 结果 为 {"状态": "ok", "目录": 应用[0]}
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # ---- R42（任务2）：真实 webhook 端点 —— /webhook/github ----
  #   把 HTTP 请求字典转成 网络钩子GitHub.处理请求 的入参形状：
  #     头表 = {小写名: [单值]}（门禁链按小写名查 x-hub-signature-256 / x-github-delivery / x-github-event）
  #     块表 = [{"字节": UTF-8 字节数, "文本": 体文本}]
  #   状态由门禁链决定：验签通过 → 202 并派发；错误签名 401；非 POST 405；
  #   超大 body 413；非 JSON 415；秘密未配置 503。派发默认只记录不外联（不回调 GitHub）。
  段落 处理webhook(请求):
    设 体字节 为 请求["体"]
    设 头字典 为 请求["头"]
    设 头表 为 造钩子头表(头字典)
    设 内容类型 为 取头值(头字典, "Content-Type", "")
    设 内容长度 为 取头值(头字典, "Content-Length", 空)
    设 块 为 ["字节": 长(体字节), "文本": 字符串(体字节, "utf-8")]
    设 块表 为 [块]
    设 钩子请求 为 ["方法": 请求["方法"], "内容类型": 内容类型, "内容长度": 内容长度, "块表": 块表, "头表": 头表]
    设 钩子响应 为 ["状态": 0, "消息": ""]
    处理请求(钩子请求, 钩子响应, 造钩子能力(己))
    设 体 为 序列化JSON(["状态": 钩子响应["状态"], "消息": 钩子响应["消息"]])
    返回 ["状态": 钩子响应["状态"], "头": ["Content-Type": "application/json; charset=utf-8"], "体": 体]

  # ---- E2 会话管理 API ----
  # GET /api/sessions：会话列表（按最后更新倒序）
  段落 处理列表会话():
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 列表 为 己.会话库.列表会话()
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(列表)]

  # GET /api/sessions/current：当前会话（从 token 或 ?session= 获取）
  段落 处理当前会话(令牌, 查询串):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 标识 为 ""
    如果 令牌 != "" 且 令牌 != 空:
      如果 己.令牌会话表.包含(令牌):
        设 标识 为 己.令牌会话表[令牌]
    如果 标识 == "":
      设 查询参数 为 解析查询参数(查询串)
      如果 查询参数.包含("session"):
        设 标识 为 查询参数["session"]
    如果 标识 == "":
      返回 错误响应(400, "未指定会话")
    设 元数据 为 己.会话库.取元数据(标识)
    如果 元数据 == 空:
      返回 错误响应(404, "会话不存在")
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(元数据)]

  # POST /api/sessions：新建会话
  段落 处理新建会话(请求, 令牌):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 标题 为 "新会话"
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
        如果 载荷 != 空 且 是字典(载荷):
          设 新标题 为 载荷.获取("标题", "")
          如果 新标题 != "":
            设 标题 为 新标题
      捕获 异常 e:
        设 占位 为 空
    设 元数据 为 己.会话库.新建会话(标题)
    如果 令牌 != "" 且 令牌 != 空:
      己.令牌会话表[令牌] 为 元数据["id"]
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(元数据)]

  # GET /api/sessions/:id：会话详情（完整消息历史）
  段落 处理会话详情(标识):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 消息表 为 己.会话库.获取会话(标识)
    如果 是字典(消息表) 且 消息表.包含("错误"):
      返回 错误响应(404, 消息表["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["id": 标识, "消息": 消息表])]

  # DELETE /api/sessions/:id：删除会话
  段落 处理删除会话(标识):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 结果 为 己.会话库.删除会话(标识)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # PUT /api/sessions/:id/标题：更新会话标题
  段落 处理更新标题(标识, 请求):
    如果 己.会话库 == 空:
      返回 错误响应(503, "会话持久化未启用")
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 标题 为 "新会话"
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
        如果 载荷 != 空 且 是字典(载荷):
          设 新标题 为 载荷.获取("标题", "")
          如果 新标题 != "":
            设 标题 为 新标题
      捕获 异常 e:
        设 占位 为 空
    设 结果 为 己.会话库.更新标题(标识, 标题)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # ---- E4 契约 3：审批 API ----
  # GET /api/approvals?session=xxx —— 待审批列表
  段落 处理审批列表(查询串):
    设 会话id 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("session"):
        设 会话id 为 参数["session"]
    设 列表 为 己.审批管理器.待审批列表(会话id)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["待审批": 列表, "全部": 己.审批管理器.全部待审批()])]

  # GET /api/approvals/history?session=xxx —— 已处理审批历史
  段落 处理审批历史(查询串):
    设 会话id 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("session"):
        设 会话id 为 参数["session"]
    设 列表 为 己.审批管理器.处理结果列表(会话id)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["已处理": 列表])]

  # POST /api/approvals/:id —— 处理审批（批准/拒绝）
  #   body: {"批准": true/false, "理由": "..."}
  段落 处理审批处理(审批id, 请求):
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 批准 为 假
    设 理由 为 ""
    如果 文本 != "":
      尝试:
        设 载荷 为 解析JSON(文本)
        如果 载荷 != 空 且 是字典(载荷):
          设 批准 为 载荷.获取("批准", 假)
          设 理由 为 载荷.获取("理由", "")
      捕获 异常 e:
        返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    设 结果 为 己.审批管理器.处理审批(审批id, 批准, 理由)
    如果 是字典(结果) 且 结果.包含("错误"):
      返回 错误响应(404, 结果["错误"])
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # GET /api/permissions —— 返回当前权限预设
  段落 处理获取权限:
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["预设": 己.权限管理器.当前预设(), "审批超时": 己.权限管理器.审批超时])]

  # POST /api/permissions —— 更新权限预设
  #   body: {"预设": "全放行"|"按类别"|"全拒绝"|"自定义", "审批超时": 300, "自定义": {"bash": "审批", ...}}
  段落 处理保存权限(请求):
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    如果 文本 == "":
      返回 错误响应(400, "请求体不能为空")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON: " + 转字符串(e))
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    # 更新预设
    如果 载荷.包含("预设"):
      己.权限管理器.设置预设(载荷["预设"])
    # 更新超时
    如果 载荷.包含("审批超时"):
      己.权限管理器.审批超时 为 载荷["审批超时"]
    # 更新自定义工具权限
    如果 载荷.包含("自定义") 且 type(载荷["自定义"]) == dict:
      设 自定义表 为 载荷["自定义"]
      遍历 工具名 之 自定义键表(自定义表):
        己.权限管理器.设置自定义(工具名, 自定义表[工具名])
    # 追加危险模式
    如果 载荷.包含("追加危险模式") 且 type(载荷["追加危险模式"]) == list:
      遍历 片段 之 载荷["追加危险模式"]:
        己.权限管理器.追加危险模式(片段)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["ok": 1, "预设": 己.权限管理器.当前预设(), "审批超时": 己.权限管理器.审批超时])]

  # E4：生成审批请求事件字典（SSE 推送用）
  段落 生成审批事件(审批项):
    返回 ["种类": "审批请求", "审批id": 审批项["审批id"], "会话id": 审批项["会话id"], "轮次": 审批项["轮次"], "工具名": 审批项["工具名"], "参数": 审批项["参数"]]

  # ---- R108 任务线 H：引导端点（C 线） ----
  # GET /api/settings/onboarding -> C 线 渲染引导（查询参数 显式 可选）
  段落 处理获取引导(查询串):
    设 己.请求数 为 己.请求数 + 1
    设 显式 为 ""
    如果 查询串 != "" 且 查询串 != 空:
      设 参数 为 解析查询参数(查询串)
      如果 参数.包含("显式"):
        设 显式 为 参数["显式"]
    # 本仓恒：会话为空白=真（首次进入）、凭据就绪=has_key
    设 会话空白 为 真
    设 凭据就绪 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 凭据就绪 为 真
    设 已存 为 己.读已存设置()
    设 已完成集 为 []
    如果 字典包含键(已存, "引导_welcomeNoticeVersion"):
      列表追加(已完成集, "welcome-notice")
    设 引导 为 设置引导.渲染引导(已完成集, 会话空白, 凭据就绪, 显式)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(引导)]

  # POST /api/settings/onboarding body {"步骤": <步 id>} -> C 线 完成步骤 落盘
  段落 处理保存引导(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 步id 为 载荷.获取("步骤", "")
    如果 步id == "":
      返回 错误响应(400, "缺少步骤字段")
    设 已存 为 己.读已存设置()
    设 新设置 为 空
    尝试:
      设 新设置 为 设置引导.完成步骤(已存, 步id)
    捕获 异常 e:
      返回 错误响应(400, "未知步骤: " + 步id)
    己.写已存设置(新设置)
    # 返回当前步骤
    设 会话空白 为 真
    设 凭据就绪 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 凭据就绪 为 真
    设 已完成集 为 []
    如果 字典包含键(新设置, "引导_welcomeNoticeVersion"):
      列表追加(已完成集, "welcome-notice")
    设 当前 为 设置引导.当前步骤(已完成集, 会话空白, 凭据就绪, "")
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["状态": "ok", "当前步骤": 当前])]

  # ---- R108 任务线 H：凭据端点（E 线） ----
  # GET /api/settings/credential -> E 线凭据视图（响应绝不含明文）
  段落 处理获取凭据():
    设 己.请求数 为 己.请求数 + 1
    # 本仓恒为 env / file 两源之一：有密钥 -> file 来源（.env）
    设 有密钥 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 有密钥 为 真
    设 进程环境有 为 假  # 本仓无独立 env 探测，恒为假
    设 凭据文件有 为 有密钥
    设 项目环境有 为 假
    设 用户环境有 为 假
    设 视图 为 凭据链.解析凭据视图(进程环境有, 凭据文件有, 项目环境有, 用户环境有)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(视图)]

  # POST /api/settings/credential body {"密钥": <串>} -> 先过 E 线 可否写入
  段落 处理保存凭据(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 新密钥 为 载荷.获取("密钥", "")
    # 先过 E 线校验
    设 有密钥 为 假
    如果 己.配置元数据 != 空:
      如果 是字典(己.配置元数据) 且 字典包含键(己.配置元数据, "has_key") 且 己.配置元数据["has_key"] == 1:
        设 有密钥 为 真
    设 视图 为 凭据链.解析凭据视图(假, 有密钥, 假, 假)
    设 校验 为 凭据链.可否写入(视图, 新密钥)
    如果 校验["合法"] == 假:
      返回 错误响应(400, 校验["消息"])
    # 合法 -> 复用既有 .env 写入路径（与 R107 模型配置写回同一条链）
    如果 己.环境文件路径 != "" 且 己.环境文件路径 != 空:
      设 端点 为 "https://api.deepseek.com"
      设 模型 为 取默认模型()
      如果 己.配置元数据 != 空:
        设 端点 为 己.配置元数据.获取("endpoint", 端点)
        设 模型 为 己.配置元数据.获取("model", 模型)
      设 环境内容 为 "OPENAI_API_KEY=" + 新密钥 + "\nOPENAI_BASE_URL=" + 端点 + "\nOPENAI_MODEL=" + 模型 + "\n"
      尝试:
        写入文件(己.环境文件路径, 环境内容)
      捕获 异常 e:
        返回 错误响应(500, "写入 .env 失败: " + 转字符串(e))
      # 热更新客户端
      设 新客户端 为 新建 客户端(端点, 新密钥, 模型)
      设 新元数据 为 ["configured": 1, "mock": 0, "model": 模型, "endpoint": 端点, "has_key": 1]
      己.更新客户端(新客户端, 新元数据)
    # 只回凭据视图三键（不含明文）
    设 新视图 为 凭据链.解析凭据视图(假, 真, 假, 假)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(新视图)]

  # ---- R108 任务线 H：多 provider / 发现端点（D 线） ----
  # GET /api/settings/providers -> D 线 渲染提供商目录
  段落 处理获取提供商():
    设 己.请求数 为 己.请求数 + 1
    # 本仓注册表来源：已注册 route = [deepseek-official]（单提供商）
    设 已注册 为 ["deepseek-official"]
    设 可配置 为 []
    设 命名空间表 为 {}
    设 页 为 模型目录.渲染提供商目录(已注册, 可配置, 命名空间表)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(页)]

  # POST /api/settings/providers/discover body = 发现请求 -> D 线 换算（不写配置）
  段落 处理发现模型(请求):
    设 己.请求数 为 己.请求数 + 1
    设 体字节 为 请求["体"]
    设 文本 为 字符串(体字节, "utf-8")
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(文本)
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    如果 载荷 == 空 或 是字典(载荷) == 假:
      返回 错误响应(400, "请求体必须是 JSON 对象")
    设 baseURL 为 载荷.获取("baseURL", "")
    设 api 为 载荷.获取("api", "")
    设 apiKey 为 载荷.获取("apiKey", "")
    如果 baseURL == "":
      返回 错误响应(400, "请先填写 API 地址，再获取。")
    设 协议 为 模型目录.默认协议
    如果 api != "":
      设 协议 为 api
    # ⚠ 本端点绝不写任何配置；真实 HTTP 由宿主负责。
    #   注入式路径：若载荷带「响应」（原始响应文本），本端点调 D 线 解析发现响应 换算候选（便于宿主注入 mock / 未来接真实 fetch）；
    #   否则只回「地址 + 请求头形状」，候选由宿主侧真实响应驱动。
    设 注入响应 为 载荷.获取("响应", "")
    如果 注入响应 != "":
      设 解析结果 为 模型目录.解析发现响应(注入响应, 协议)
      设 地址2 为 模型目录.发现地址(baseURL, 协议)
      设 头键2 为 自定义键表(模型目录.发现请求头(协议, apiKey))
      # ⛔ 铁律：apiKey 仅本次询问使用，绝不进入任何返回值/日志
      返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["地址": 地址2, "请求头键": 头键2, "候选": 解析结果["候选"], "说明": "注入式响应驱动；apiKey 仅本次使用不落盘不回显"])]
    设 地址 为 模型目录.发现地址(baseURL, 协议)
    设 头 为 模型目录.发现请求头(协议, apiKey)
    设 头键 为 自定义键表(头)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["地址": 地址, "请求头键": 头键, "说明": "真实 HTTP 由宿主负责；本端点只做换算不写配置，apiKey 仅本次使用不落盘不回显"])]

  # ---- R108 任务线 H：插件面板端点（F 线） + R110 宿主执行层接线 ----
  # GET /api/settings/plugin-panel -> 列光明插件（lightplugin 内置 75 个）+ 启停态
  # R113-R1 修复：GET 链路补上 探测管理面（幂等初始化 profile 目录/package.json/
  #   cordis.patch.json/pnpm-workspace.yaml，见 插件执行.light:40-56），并把面板
  #   可用态从硬编码 真 改回探针真实值。此前 GET 从不初始化 profile，
  #   test_r110_e2e 断言「GET 后补丁文件已初始化」恒假（该 example 出生即红）。
  #   兼容 R111「无根部署可用恒真」语义（test_r108新端点.light:76-80，根=""）：
  #   根为空时探针按设计返回不可用，但面板列内置插件不受影响，保持 恒真；
  #   根非空时用探针真实值（pnpm 探测 + profile 初始化）。
  段落 处理获取插件面板():
    设 己.请求数 为 己.请求数 + 1
    设 探针 为 插件执行.探测管理面(己.根)
    设 面板可用 为 真
    如果 己.根 != 空 且 己.根 != "":
      设 面板可用 为 探针["可用"]
    设 行列表 为 插件启停.列插件状态(己.根)
    设 包列表 为 []
    遍历 行 之 行列表:
      设 工具数 为 转字符串(行["工具数"])
      设 卡片 为 {
        "name": 行["name"], "标题": 行["标题"], "版本": "内置",
        "描述": 工具数 + " 个工具", "已安装": 真, "可选": 假,
        "已启用": 行["已启用"], "标签": [], "只读原因": "", "错误": "",
        "组件": [], "工具表": 行["工具表"]
      }
      包列表.追加(卡片)
    设 面板 为 插件面板.渲染插件面板(包列表, [], "", 面板可用)
    返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(面板)]

  # POST /api/settings/plugin-panel/install  body={"spec":"<git URL 或 owner/repo>"}
  # R112：git clone 光明插件仓库到 lightplugin/插件/_外部/，写 installed.json；清缓存后下次请求加载。
  段落 处理安装插件(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 规格 为 ""
    如果 是字典(载荷) == 真:
      设 规格 为 载荷.获取("spec", "")
    设 结果 为 插件安装.安装插件(己.根, 规格)
    # 安装成功清注册表缓存，下次请求加载新插件
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 500
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/plugin-panel/uninstall —— R3：外部插件（git clone）真卸载；内置插件返回可停用提示
  段落 处理卸载插件(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 id 为 ""
    如果 是字典(载荷) == 真:
      设 id 为 载荷.获取("id", "")
    设 结果 为 插件安装.卸载外部插件(己.根, id)
    # 卸载成功清注册表缓存，下次请求按新清单重建
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 400
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]

  # POST /api/settings/plugin-panel/set-enabled  body={"id":"<插件名>", "enabled":true/false}
  段落 处理设置插件启用(请求):
    设 己.请求数 为 己.请求数 + 1
    设 载荷 为 空
    尝试:
      设 载荷 为 解析JSON(字符串(请求["体"], "utf-8"))
    捕获 异常 e:
      返回 错误响应(400, "请求体不是合法 JSON")
    设 id 为 ""
    设 启用 为 真
    如果 是字典(载荷) == 真:
      设 id 为 载荷.获取("id", "")
      设 启用 为 载荷.获取("enabled", 真)
    设 结果 为 插件启停.切换插件(己.根, id, 启用)
    # R113-R1 修复：宿主执行层补接线——对齐上游 writePluginEnabled，启停同时落
    #   cordis.patch.json（插件执行.设置启用）。此前只写 plugins.json，e2e 断言
    #   「补丁写入 demo-e2e」恒假（test_r110_e2e.light:36-41）。
    如果 结果["ok"] == 真:
      设 补丁结果 为 插件执行.设置启用(己.根, id, 启用)
      如果 补丁结果["ok"] == 假:
        设 结果 为 补丁结果
    # 启停变更后清空预设注册表缓存，下次请求按新开关重建
    如果 结果["ok"] == 真:
      设 己.预设注册表缓存 为 {}
    设 状态码 为 200
    如果 结果["ok"] == 假:
      设 状态码 为 400
    返回 ["状态": 状态码, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(结果)]


# ---- E4 辅助：字典键列表（光明语 dict 无 .keys()）----
段落 自定义键表(字典):
  设 结果 为 []
  遍历 键 之 字典:
    结果.追加(键)
  返回 结果



# ---- GET /health ----
段落 处理健康检查(服务):
  设 服务.请求数 为 服务.请求数 + 1
  返回 ["状态": 200, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["status": "ok", "请求数": 服务.请求数])]

# ---- W3 辅助：从查询串提取 token（?token=xxx 或 &token=xxx）----
段落 提取查询令牌(查询串):
  如果 查询串 == "" 或 查询串 == 空:
    返回 ""
  设 位置 为 查询串.查找("token=")
  如果 位置 < 0:
    返回 ""
  设 起 为 位置 + 6   # 长度("token=") = 6
  设 剩余 为 查询串[起:]
  设 尾 为 剩余.查找("&")
  如果 尾 < 0:
    返回 剩余
  返回 剩余[0:尾]

# ---- W3 辅助：解析查询串为字典（?k1=v1&k2=v2）----
段落 解析查询参数(查询串):
  设 结果 为 {}
  如果 查询串 == "" 或 查询串 == 空:
    返回 结果
  设 部分表 为 分割字符串(查询串, "&")
  遍历 部分 之 部分表:
    如果 部分 == "":
      继续
    设 等号 为 部分.查找("=")
    如果 等号 >= 0:
      设 键 为 部分[0:等号]
      设 值 为 部分[等号 + 1:]
      结果[键] 为 值
    否则:
      结果[部分] 为 ""
  返回 结果

# ---- W3 辅助：分割字符串（按分隔符切分）----
段落 分割字符串(文本, 分隔符):
  设 结果 为 []
  设 当前 为 ""
  设 i 为 0
  当 i < 长度(文本):
    如果 文本[i] == 分隔符:
      结果.追加(当前)
      设 当前 为 ""
    否则:
      设 当前 为 当前 + 文本[i]
    设 i 为 i + 1
  如果 当前 != "":
    结果.追加(当前)
  返回 结果

# ---- E2 辅助：解析会话标识（从入参/令牌绑定/查询串中解析）----
段落 解析会话标识(服务, 标识, 令牌, 查询串):
  如果 标识 != "" 且 标识 != 空:
    返回 标识
  如果 令牌 != "" 且 令牌 != 空:
    如果 服务.令牌会话表.包含(令牌):
      返回 服务.令牌会话表[令牌]
  如果 查询串 != "":
    设 参数 为 解析查询参数(查询串)
    如果 参数.包含("session"):
      返回 参数["session"]
  返回 ""

# ---- R41 辅助：判定绑定地址是否 loopback（127.0.0.1 / 127.x / ::1 / localhost）----
段落 是回环地址(地址):
  如果 地址 == "127.0.0.1" 或 地址 == "::1" 或 地址 == "localhost":
    返回 真
  如果 地址.查找("127.") == 0:
    返回 真
  返回 假

# ---- W3 辅助：CORS 头（契约 5）。开关：HARNESS_WEB_CORS=0 时不加，默认加 ----
段落 加跨域(响应):
  如果 环境变量("HARNESS_WEB_CORS", "1") != "0":
    响应["头"]["Access-Control-Allow-Origin"] 为 "*"
  返回 响应

# ---- 模块级单例：处理器（光明类体不能放 异步 段落）通过它拿到服务状态 ----
设 全局服务 为 新建 Web服务端()

# ---- R42 辅助：HTTP 头字典（原名→单值）→ 钩子头表（小写名→[单值]）----
#   门禁链 必需头() 按小写名查（x-hub-signature-256 等）且要求「长度恰 1 的单值表」，
#   故此处统一小写键 + 包成单元素列表。
段落 造钩子头表(头字典):
  设 结果 为 {}
  遍历 名 之 头字典:
    设 低 为 名.lower()
    设 单元 为 [头字典[名]]
    结果[低] 为 单元
  返回 结果

# ---- R42 辅助：大小写不敏感取头值（无则 缺省）----
段落 取头值(头字典, 名字, 缺省):
  设 低名 为 名字.lower()
  遍历 键 之 头字典:
    设 低键 为 键.lower()
    如果 低键 == 低名:
      返回 头字典[键]
  返回 缺省

# ---- R42 辅助：钩子能力（取秘密/当前时间/来源/派发/体上限）----
#   取秘密 与 派发 走模块级单例 全局服务（光明类体不能承载可注入回调）；
#   派发默认只把交付追加进 钩子派发记录（不外联 GitHub）。
段落 钩子取秘密:
  全局 全局服务
  设 值 为 全局服务.钩子秘密
  # 空串归一为 空：门禁链以「秘密==空」判「未配置」（503），空串不等同 空
  如果 值 == "" 或 值 == 空:
    返回 空
  返回 值

段落 钩子当前时间:
  返回 转字符串(时间戳())

段落 钩子派发(投递):
  全局 全局服务
  全局服务.钩子派发记录.追加(投递)

段落 造钩子能力(服务):
  返回 ["取秘密": 钩子取秘密, "当前时间": 钩子当前时间, "来源": 服务.钩子来源, "派发": 钩子派发, "体上限": 服务.钩子体上限]


# ---- 路由处理器：HTTP 服务端每连接回调。请求字典 → 响应字典 ----
#   处理次序：服务未配置 → 认证挂载点（S2）→ 路由分派（health/静态/chat/404）
#   认证：取令牌()=="" 即未启用（S1 全放行）；启用后白名单(GET /health、静态资源)放行，
#         其余校验 X-Auth-Token 头 或 ?token= 查询，二选一即过；失败 401。
#   所有响应统一加 CORS 头（HARNESS_WEB_CORS!=0 时）。
异步 段落 路由处理器(请求):
  设 服务 为 全局服务
  如果 服务.服务端 == 空:
    设 响应 为 错误响应(500, "服务未配置")
    返回 加跨域(响应)
  设 方法 为 请求["方法"]
  设 原路径 为 请求["路径"]
  设 路径 为 原路径
  设 查询串 为 ""
  设 问号 为 路径.查找("?")
  如果 问号 >= 0:
    设 查询串 为 路径[问号 + 1:]
    设 路径 为 路径[0:问号]
  # ---- R41（任务2）：非 loopback + HARNESS_TOKEN 网络级门禁 ----
  #   仅当绑定非 loopback 且配置了令牌时强制（loopback 默认不强制，向后兼容 S1）；
  #   与既有 认证 模块会话令牌（HARNESS_WEB_TOKEN）相互独立、并存不悖。
  设 期望令牌 为 服务.令牌
  设 非回环绑定 为 非 (是回环地址(服务.绑定地址))
  如果 非回环绑定 且 期望令牌 != "" 且 期望令牌 != 空:
    设 头令牌 为 请求["头"].获取("X-Auth-Token", "")
    设 查令牌 为 提取查询令牌(查询串)
    设 令牌相符 为 假
    如果 头令牌 != "" 且 头令牌 != 空 且 头令牌 == 期望令牌:
      设 令牌相符 为 真
    如果 令牌相符 == 假 且 查令牌 != "" 且 查令牌 != 空 且 查令牌 == 期望令牌:
      设 令牌相符 为 真
    如果 令牌相符 == 假:
      设 响应 为 ["状态": 401, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未认证：非 loopback 绑定要求携带 X-Auth-Token", "type": "unauthorized"]])]
      返回 加跨域(响应)
  # ---- 认证挂载点（S2 语义）----
  设 启用认证 为 假
  设 当前令牌 为 取令牌()
  设 令牌 为 ""
  设 头令牌 为 请求["头"].获取("X-Auth-Token", "")
  设 查令牌 为 提取查询令牌(查询串)
  如果 当前令牌 != "" 且 当前令牌 != 空:
    设 启用认证 为 真
  如果 启用认证:
    # 解析出本次请求携带的有效令牌（头优先，其次 ?token=）；无有效令牌 → 令牌 保持 ""
    如果 头令牌 != "" 且 头令牌 != 空 且 校验令牌(头令牌) == 真:
      设 令牌 为 头令牌
    如果 令牌 == "" 且 查令牌 != "" 且 查令牌 != 空 且 校验令牌(查令牌) == 真:
      设 令牌 为 查令牌
    设 白名单放行 为 假
    # 默认：所有 GET 放行（health/静态/未知路径→404 兜底）；认证只保护 POST agent API
    # E2 例外：/api/sessions* 是敏感会话数据（含对话历史），启用认证时 GET 也校验。
    如果 方法 == "GET" 且 路径.查找("/api/sessions") != 0:
      设 白名单放行 为 真
    # E4：审批/权限 API 也走认证
    如果 方法 == "GET" 且 路径.查找("/api/approvals") != 0:
      设 白名单放行 为 真
    如果 方法 == "GET" 且 路径.查找("/api/permissions") != 0:
      设 白名单放行 为 真
    # 配置 API 公开（首次启动无 token 时需保存大模型配置，热更新不重启）
    如果 方法 == "POST" 且 路径 == "/api/config":
      设 白名单放行 为 真
    # R105 任务线 C：设置保存 API 同样公开（与 GET /api/settings 一致，首次启动无 token 时可保存设置）
    如果 方法 == "POST" 且 路径 == "/api/settings":
      设 白名单放行 为 真
    # R106：快捷键保存 API 公开（启用认证时 POST 需白名单放行，否则 401）
    如果 方法 == "POST" 且 路径 == "/api/shortcuts":
      设 白名单放行 为 真
    # R107：模型配置保存 API 同样公开（与 POST /api/config 一致；首次启动无 token 时可配置大模型）
    如果 方法 == "POST" 且 路径 == "/api/settings/model":
      设 白名单放行 为 真
    # R108 任务线 H：新 POST 端点白名单（引导/凭据/发现，与设置保存同级）
    如果 方法 == "POST" 且 路径 == "/api/settings/onboarding":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/credential":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/providers/discover":
      设 白名单放行 为 真
    # R110：插件安装/卸载/启停端点与设置类 POST 同级公开
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/install":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/uninstall":
      设 白名单放行 为 真
    如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/set-enabled":
      设 白名单放行 为 真
    如果 白名单放行 == 假 且 令牌 == "":
      设 响应 为 ["状态": 401, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未认证", "type": "unauthorized"]])]
      返回 加跨域(响应)
  # ---- 路由分派 ----
  如果 方法 == "GET" 且 路径 == "/health":
    设 响应 为 处理健康检查(服务)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 (路径 == "/" 或 路径 == "/app.js" 或 路径 == "/style.css" 或 路径 == "/sidebar.js" 或 路径 == "/messages.js" 或 路径 == "/tool-card.js" 或 路径 == "/settings.js" 或 路径 == "/settings.css" 或 路径 == "/slash-palette.js" 或 路径 == "/index.html"):
    设 响应 为 服务.处理静态(路径)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/config":
    设 响应 为 服务.处理获取配置()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings":
    设 响应 为 服务.处理获取设置页()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/document":
    设 响应 为 服务.处理获取设置文档()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/effective":
    设 响应 为 服务.处理获取生效设置(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/shortcuts":
    设 响应 为 服务.处理获取快捷键()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings":
    设 响应 为 服务.处理保存设置(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/model":
    设 响应 为 服务.处理保存模型配置(请求)
    返回 加跨域(响应)
  # ---- R108 任务线 H：新端点路由 ----
  如果 方法 == "GET" 且 路径 == "/api/settings/onboarding":
    设 响应 为 服务.处理获取引导(查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/onboarding":
    设 响应 为 服务.处理保存引导(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/credential":
    设 响应 为 服务.处理获取凭据()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/credential":
    设 响应 为 服务.处理保存凭据(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/providers":
    设 响应 为 服务.处理获取提供商()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/providers/discover":
    设 响应 为 服务.处理发现模型(请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/settings/plugin-panel":
    设 响应 为 服务.处理获取插件面板()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/install":
    设 响应 为 服务.处理安装插件(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/uninstall":
    设 响应 为 服务.处理卸载插件(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/settings/plugin-panel/set-enabled":
    设 响应 为 服务.处理设置插件启用(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/shortcuts":
    设 响应 为 服务.处理保存快捷键(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/config":
    设 响应 为 服务.处理保存配置(请求)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/v1/chat/completions":
    设 响应 为 服务.处理对话(请求, 令牌, 查询串)
    返回 加跨域(响应)
  # ---- E2 契约 2：会话管理 API（当前会话路由先于 :id 匹配）----
  如果 方法 == "GET" 且 路径 == "/api/sessions":
    设 响应 为 服务.处理列表会话()
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/sessions/current":
    设 响应 为 服务.处理当前会话(令牌, 查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/sessions":
    设 响应 为 服务.处理新建会话(请求, 令牌)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径.查找("/api/sessions/") == 0:
    # "/api/sessions/" 长 14；截取为 0-based [start, end)，id 从索引 14 起
    设 尾段 为 截取(路径, 14, 长(路径))
    设 响应 为 服务.处理会话详情(尾段)
    返回 加跨域(响应)
  如果 方法 == "DELETE" 且 路径.查找("/api/sessions/") == 0:
    设 尾段 为 截取(路径, 14, 长(路径))
    设 响应 为 服务.处理删除会话(尾段)
    返回 加跨域(响应)
  如果 方法 == "PUT" 且 路径.查找("/api/sessions/") == 0:
    # 浏览器 fetch 会对路径中文做百分号编码（/标题 → /%E6%A0%87%E9%A2%98），先解码再匹配
    设 尾段 为 截取(路径, 14, 长(路径))
    设 解码尾段 为 URL解码(尾段)
    如果 解码尾段.查找("/标题") >= 0:
      设 标识 为 截取(解码尾段, 0, 解码尾段.查找("/标题"))
      设 响应 为 服务.处理更新标题(标识, 请求)
      返回 加跨域(响应)
  # ---- E4 契约 3：审批 API + 权限 API ----
  如果 方法 == "GET" 且 路径 == "/api/approvals":
    设 响应 为 服务.处理审批列表(查询串)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/approvals/history":
    设 响应 为 服务.处理审批历史(查询串)
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径.查找("/api/approvals/") == 0:
    # "/api/approvals/" 长 15；0-based 截取，审批 id 从索引 15 起
    设 尾段 为 截取(路径, 15, 长(路径))
    设 响应 为 服务.处理审批处理(尾段, 请求)
    返回 加跨域(响应)
  如果 方法 == "GET" 且 路径 == "/api/permissions":
    设 响应 为 服务.处理获取权限()
    返回 加跨域(响应)
  如果 方法 == "POST" 且 路径 == "/api/permissions":
    设 响应 为 服务.处理保存权限(请求)
    返回 加跨域(响应)
  # ---- R42（任务2）：真实 webhook 端点（任何方法都进门禁链；非 POST → 405）----
  #   放在兜底 404 之前；R41 非 loopback token 门禁在其上方先执行（webhook 路由继承之）。
  如果 路径 == "/webhook/github":
    设 响应 为 服务.处理webhook(请求)
    返回 加跨域(响应)
  设 响应 为 ["状态": 404, "头": ["Content-Type": "application/json; charset=utf-8"], "体": 序列化JSON(["error": ["message": "未找到: " + 方法 + " " + 路径, "type": "not_found"]])]
  返回 加跨域(响应)

