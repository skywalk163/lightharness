# 会话查询过滤.light —— 对标原版 packages/session-query/session-query/src/filters.ts
# 纯逻辑核心：逻辑会话过滤器 + 事件文档过滤器 的编译/物化/匹配（保留输入顺序的 AND 叠加）。
# 不可移植缺口：原版依赖 provider 侧游标（cursor.ts 仅品牌化字符串，无逻辑）、
#            SessionQueryError 类型与配置、语料/文档抽取（corpus/documents/extraction），
#            纯逻辑层只复刻 filters.ts 的谓词与物化校验。

从 字符串工具 导入 去除首尾空白

# 列表按下标取元素（光明无下标取元素原语，用遍历实现）
段落 列表取 接收 列表, i:
  设 计数 为 0
  遍历 元素 之 列表:
    如果 计数 == i: 返回 元素
    设 计数 为 计数 + 1
  返回 空

段落 是数值 接收 值:
  返回 是整数(值) 或 是浮点(值)

# ===== 物化（异步边界前的复制与校验） =====

段落 复制字符串 接收 名称, 值表:
  如果 是列表(值表) == 假 或 存在非字符串(值表):
    抛出 新建 错误("session " + 名称 + " filter values must be an array of strings")
  设 副本 为 []
  遍历 v 之 值表: 列表追加(副本, v)
  返回 副本

段落 存在非字符串 接收 列表:
  遍历 v 之 列表:
    如果 是字符串(v) == 假: 返回 真
  返回 假

段落 复制可空字符串 接收 名称, 值表:
  如果 是列表(值表) == 假:
    抛出 新建 错误("session " + 名称 + " filter values must be an array of strings or null")
  遍历 v 之 值表:
    如果 v != 空 且 是字符串(v) == 假:
      抛出 新建 错误("session " + 名称 + " filter values must be an array of strings or null")
  设 副本 为 []
  遍历 v 之 值表: 列表追加(副本, v)
  返回 副本

段落 复制范围 接收 kind, 范围:
  设 副本 为 {"kind": kind}
  如果 字典包含键(范围, "from"): 字典设置(副本, "from", 字典获取(范围, "from"))
  如果 字典包含键(范围, "to"): 字典设置(副本, "to", 字典获取(范围, "to"))
  校验范围(kind, 副本)
  返回 副本

段落 断言允许值 接收 名称, 值表, 允许:
  遍历 v 之 值表:
    如果 列表包含(允许, v) == 假:
      抛出 新建 错误("session " + 名称 + " filter contains unknown value \"" + 转字符串(v) + "\"")

段落 校验范围 接收 名称, 范围:
  如果 字典包含键(范围, "from") 且 是数值(字典获取(范围, "from")) == 假:
    抛出 新建 错误("session " + 名称 + " filter from must be finite")
  如果 字典包含键(范围, "to") 且 是数值(字典获取(范围, "to")) == 假:
    抛出 新建 错误("session " + 名称 + " filter to must be finite")
  如果 字典包含键(范围, "from") 且 字典包含键(范围, "to") 且 字典获取(范围, "from") > 字典获取(范围, "to"):
    抛出 新建 错误("session " + 名称 + " filter from must be less than or equal to to")

段落 物化会话结果过滤器 接收 过滤器表:
  如果 是列表(过滤器表) == 假:
    抛出 新建 错误("session filters must be an array")
  设 结果 为 []
  遍历 过滤 之 过滤器表:
    设 种类 为 字典获取(过滤, "kind")
    如果 种类 == "id":
      列表追加(结果, {"kind": "id", "values": 复制字符串("id", 字典获取(过滤, "values"))})
    否则如果 种类 == "cwd":
      列表追加(结果, {"kind": "cwd", "values": 复制可空字符串("cwd", 字典获取(过滤, "values"))})
    否则如果 种类 == "created-at":
      列表追加(结果, 复制范围("created-at", 过滤))
    否则如果 种类 == "parent":
      列表追加(结果, {"kind": "parent", "values": 复制可空字符串("parent", 字典获取(过滤, "values"))})
    否则如果 种类 == "availability":
      设 值 为 复制字符串("availability", 字典获取(过滤, "values"))
      断言允许值("availability", 值, ["live", "persisted"])
      列表追加(结果, {"kind": "availability", "values": 值})
    否则:
      抛出 新建 错误("unknown filter kind " + 转字符串(种类))
  返回 结果

段落 物化会话事件结果过滤器 接收 过滤器表:
  如果 是列表(过滤器表) == 假:
    抛出 新建 错误("session filters must be an array")
  设 结果 为 []
  遍历 过滤 之 过滤器表:
    设 种类 为 字典获取(过滤, "kind")
    如果 种类 == "seq" 或 种类 == "time":
      列表追加(结果, 复制范围(种类, 过滤))
    否则如果 种类 == "type":
      列表追加(结果, {"kind": "type", "values": 复制字符串("type", 字典获取(过滤, "values"))})
    否则如果 种类 == "surface":
      设 值 为 复制字符串("surface", 字典获取(过滤, "values"))
      断言允许值("surface", 值, ["current", "shadowed", "log-only"])
      列表追加(结果, {"kind": "surface", "values": 值})
    否则如果 种类 == "text":
      设 文本 为 字典获取(过滤, "text")
      如果 是字符串(文本) == 假:
        抛出 新建 错误("session text filter text must be a string")
      列表追加(结果, {"kind": "text", "text": 文本})
    否则:
      抛出 新建 错误("unknown filter kind " + 转字符串(种类))
  返回 结果

# ===== 匹配（保留输入顺序的 AND 叠加） =====

段落 匹配范围 接收 值, 范围:
  如果 字典包含键(范围, "from") 且 值 < 字典获取(范围, "from"): 返回 假
  如果 字典包含键(范围, "to") 且 值 > 字典获取(范围, "to"): 返回 假
  返回 真

段落 是会话谓词 接收 过滤, 记录:
  设 种类 为 字典获取(过滤, "kind")
  如果 种类 == "id":
    返回 列表包含(字典获取(过滤, "values"), 字典获取(字典获取(记录, "header"), "id"))
  如果 种类 == "cwd":
    返回 列表包含(字典获取(过滤, "values"), 字典获取(字典获取(记录, "header"), "cwd"))
  如果 种类 == "created-at":
    校验范围(种类, 过滤)
    返回 匹配范围(字典获取(字典获取(记录, "header"), "createdAt"), 过滤)
  如果 种类 == "parent":
    返回 列表包含(字典获取(过滤, "values"), 字典获取(字典获取(记录, "header"), "parentSession"))
  如果 种类 == "availability":
    断言允许值(种类, 字典获取(过滤, "values"), ["live", "persisted"])
    遍历 v 之 字典获取(过滤, "values"):
      如果 v == "live" 且 字典获取(记录, "live") == 真: 返回 真
      如果 v == "persisted" 且 字典获取(记录, "persisted") == 真: 返回 真
    返回 假
  抛出 新建 错误("unknown filter kind " + 转字符串(种类))

段落 文本过滤匹配 接收 文档文本, 过滤文本:
  # 复刻 compileSessionTextFilter 的「大小写不敏感 + 空白灵活」语义：
  # 归一（小写、折叠空白）后，过滤令牌须按序作为文档令牌的连续子序列出现。
  设 过滤令牌 为 分割字符串(转小写(去除首尾空白(过滤文本)), 空)
  设 文档令牌 为 分割字符串(转小写(去除首尾空白(文档文本)), 空)
  设 文档指针 为 0
  遍历 令牌 之 过滤令牌:
    设 命中 为 假
    当 文档指针 < 列表长度(文档令牌):
      如果 列表取(文档令牌, 文档指针) == 令牌:
        设 命中 为 真
        设 文档指针 为 文档指针 + 1
        跳出
      设 文档指针 为 文档指针 + 1
    如果 命中 == 假: 返回 假
  返回 真

段落 是事件谓词 接收 过滤, 文档:
  设 种类 为 字典获取(过滤, "kind")
  如果 种类 == "seq":
    校验范围(种类, 过滤)
    返回 匹配范围(字典获取(文档, "seq"), 过滤)
  如果 种类 == "time":
    校验范围(种类, 过滤)
    返回 匹配范围(字典获取(文档, "time"), 过滤)
  如果 种类 == "type":
    返回 列表包含(字典获取(过滤, "values"), 字典获取(文档, "type"))
  如果 种类 == "surface":
    断言允许值("surface", 字典获取(过滤, "values"), ["current", "shadowed", "log-only"])
    返回 列表包含(字典获取(过滤, "values"), 字典获取(文档, "surface"))
  如果 种类 == "text":
    返回 文本过滤匹配(字典获取(文档, "text"), 字典获取(过滤, "text"))
  抛出 新建 错误("unknown filter kind " + 转字符串(种类))

段落 过滤会话结果 接收 记录表, 过滤器表:
  设 结果 为 []
  遍历 记录 之 记录表:
    设 通过 为 真
    遍历 过滤 之 过滤器表:
      如果 是会话谓词(过滤, 记录) == 假:
        设 通过 为 假
        跳出
    如果 通过 == 真: 列表追加(结果, 记录)
  返回 结果

段落 过滤会话事件文档 接收 文档表, 过滤器表:
  设 结果 为 []
  遍历 文档 之 文档表:
    设 通过 为 真
    遍历 过滤 之 过滤器表:
      如果 是事件谓词(过滤, 文档) == 假:
        设 通过 为 假
        跳出
    如果 通过 == 真: 列表追加(结果, 文档)
  返回 结果

# ===== 编译（文本过滤归一） =====

段落 编译会话文本过滤 接收 文本:
  设 修剪 为 去除首尾空白(文本)
  如果 字符串长度(修剪) == 0:
    抛出 新建 错误("session text filter must contain non-whitespace text")
  返回 修剪
