# §1.6 预设行/名册/文档 + 远程错误码（agent-presets/types.ts）
# =====================================================================

段落 是合法信任 接收 值:
  如果 值 == "system":
    返回 真
  返回 值 == "user"

段落 是预设行 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["id", "trust", "isDefault"]) == 假:
    返回 假
  如果 是字符串(值["id"]) == 假 或 字符串长度(值["id"]) == 0:
    返回 假
  如果 是合法信任(值["trust"]) == 假:
    返回 假
  如果 是布尔值(值["isDefault"]) == 假:
    返回 假
  返回 真

段落 是预设名册 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["presets", "authorable"]) == 假:
    返回 假
  如果 是列表(值["presets"]) == 假:
    返回 假
  如果 是布尔值(值["authorable"]) == 假:
    返回 假
  遍历 行 之 值["presets"]:
    如果 是预设行(行) == 假:
      返回 假
  返回 真

段落 是预设文档 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["agentPreset", "trust", "content"]) == 假:
    返回 假
  如果 是字符串(值["agentPreset"]) == 假 或 字符串长度(值["agentPreset"]) == 0:
    返回 假
  如果 是合法信任(值["trust"]) == 假:
    返回 假
  返回 是字符串(值["content"])

段落 预设远程错误码表:
  返回 ["agent-preset/not-found", "agent-preset/invalid", "agent-preset/read-only", "agent-preset/locked"]

段落 是预设远程错误码 接收 值:
  如果 是字符串(值) == 假:
    返回 假
  遍历 码 之 预设远程错误码表():
    如果 值 == 码:
      返回 真
  返回 假

# =====================================================================
# §2 角色行（persona/index.ts）
# =====================================================================

段落 角色前缀段名:
  返回 "deployment:persona-prefix"

段落 角色后缀段名:
  返回 "deployment:persona-suffix"

# Config 默认值：suffix '' / complete false / includeRuntimeContext true
段落 角色配置默认值 接收 前缀:
  返回 {"prefix": 前缀, "suffix": "", "complete": 假, "includeRuntimeContext": 真}

# Config schema 校验：prefix 必填字符串；三个可选字段类型受限
段落 校验角色配置 接收 配置:
  如果 是字典(配置) == 假:
    返回 "persona config must be a mapping"
  如果 字段齐备(配置, ["prefix"]) == 假:
    返回 "persona prefix is required"
  如果 是字符串(配置["prefix"]) == 假:
    返回 "persona prefix must be a string"
  如果 字典包含键(配置, "suffix") == 真 且 是字符串(配置["suffix"]) == 假:
    返回 "persona suffix must be a string"
  如果 字典包含键(配置, "complete") == 真 且 是布尔值(配置["complete"]) == 假:
    返回 "persona complete must be a boolean"
  如果 字典包含键(配置, "includeRuntimeContext") == 真 且 是布尔值(配置["includeRuntimeContext"]) == 假:
    返回 "persona includeRuntimeContext must be a boolean"
  返回 ""

段落 是角色配置 接收 配置:
  返回 校验角色配置(配置) == ""

段落 是布尔值 接收 值:
  # L-129 同族：光明 `0 == 假` 为真，不能用相等判布尔，必须用类型判别
  返回 type(值) == bool

# 空前缀在渲染时丢弃该段（matching the registry）
段落 段是否渲染 接收 文本:
  返回 字符串长度(文本) > 0

# =====================================================================
# §3 设置类型（settings/types.ts）
# =====================================================================

段落 设置来源表:
  返回 ["update", "provider"]

段落 是合法设置来源 接收 值:
  如果 是字符串(值) == 假:
    返回 假
  遍历 源 之 设置来源表():
    如果 值 == 源:
      返回 真
  返回 假

段落 设置应用时机表:
  返回 ["live", "restart"]

段落 是合法应用时机 接收 值:
  如果 是字符串(值) == 假:
    返回 假
  遍历 时 之 设置应用时机表():
    如果 值 == 时:
      返回 真
  返回 假

# JsonValue：null | boolean | number | string | JsonValue[] | {[k]: JsonValue}
段落 是JSON值 接收 值:
  如果 值 == 空:
    返回 真
  如果 是布尔值(值):
    返回 真
  如果 是整数(值):
    返回 真
  如果 是浮点(值):
    返回 真
  如果 是字符串(值):
    返回 真
  如果 是列表(值):
    设 i 为 0
    设 n 为 长度(值)
    当 i < n:
      如果 是JSON值(值[i]) == 假:
        返回 假
      设 i 为 i + 1
    返回 真
  如果 是字典(值):
    遍历 键 之 字典键列表(值):
      # JSON 对象键必须是字符串（上游 JsonValue 的对象分支即此约束）
      如果 是字符串(键) == 假:
        返回 假
      如果 是JSON值(值[键]) == 假:
        返回 假
    返回 真
  返回 假

# 路径：字符串数组（空数组即 section 根）
段落 是路径 接收 值:
  如果 是列表(值) == 假:
    返回 假
  遍历 段 之 值:
    如果 是字符串(段) == 假:
      返回 假
  返回 真

段落 是根路径 接收 路径:
  返回 长度(路径) == 0

# SettingsSecretView：{path, set}
段落 是秘密视图 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["path", "set"]) == 假:
    返回 假
  如果 是路径(值["path"]) == 假:
    返回 假
  返回 是布尔值(值["set"])

# SettingsNamespaceView：ns/schema/value/applies/secrets/revision（+base/user 可选）
段落 是命名空间视图 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["ns", "schema", "value", "applies", "secrets", "revision"]) == 假:
    返回 假
  如果 是字符串(值["ns"]) == 假 或 字符串长度(值["ns"]) == 0:
    返回 假
  如果 是合法应用时机(值["applies"]) == 假:
    返回 假
  如果 是非负整数(值["revision"]) == 假:
    返回 假
  如果 是JSON值(值["schema"]) == 假:
    返回 假
  如果 是JSON值(值["value"]) == 假:
    返回 假
  如果 字典包含键(值, "base") == 真 且 是JSON值(值["base"]) == 假:
    返回 假
  如果 字典包含键(值, "user") == 真 且 是JSON值(值["user"]) == 假:
    返回 假
  如果 是列表(值["secrets"]) == 假:
    返回 假
  遍历 秘密 之 值["secrets"]:
    如果 是秘密视图(秘密) == 假:
      返回 假
  返回 真

段落 造命名空间视图 接收 命名空间, 模式, 解析值, 应用时机, 秘密表, 修订号:
  返回 {"ns": 命名空间, "schema": 模式, "value": 解析值, "applies": 应用时机,
    "secrets": 秘密表, "revision": 修订号}

# SettingsPathOpView：{op:'set',path,value} | {op:'unset',path}
段落 是路径操作 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["op", "path"]) == 假:
    返回 假
  如果 是路径(值["path"]) == 假:
    返回 假
  如果 值["op"] == "set":
    如果 字段齐备(值, ["value"]) == 假:
      返回 假
    返回 是JSON值(值["value"])
  如果 值["op"] == "unset":
    返回 真
  返回 假

# SettingsDescribeValue：{writable, hasDocument, namespaces}
段落 是描述值 接收 值:
  如果 是字典(值) == 假:
    返回 假
  如果 字段齐备(值, ["writable", "hasDocument", "namespaces"]) == 假:
    返回 假
  如果 是布尔值(值["writable"]) == 假:
    返回 假
  如果 是布尔值(值["hasDocument"]) == 假:
    返回 假
  如果 是列表(值["namespaces"]) == 假:
    返回 假
  遍历 视图 之 值["namespaces"]:
    如果 是命名空间视图(视图) == 假:
      返回 假
  返回 真

