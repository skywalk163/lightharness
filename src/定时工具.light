  返回 参数

# 四工具定义：name / description / parameters / output schema / presentCall 卡片形状
段落 四工具定义表:
  返回 [
    {"name": "schedule_create", "description": 创建描述(), "parameters": 创建参数表(), "output": 创建输出骨架(), "调用卡片": {"标题": "Create reminder", "种类": "other", "展示输入": "prompt"}},
    {"name": "schedule_list", "description": 列表描述(), "parameters": 列表参数表(), "output": 列表输出骨架(), "调用卡片": {"标题": "List reminders", "种类": "read"}},
    {"name": "schedule_delete", "description": 删除描述(), "parameters": 删除参数表(), "output": 删除输出骨架(), "调用卡片": {"标题": "Delete reminder", "种类": "other", "展示输入": "id"}},
    {"name": "schedule_update", "description": 更新描述(), "parameters": 更新参数表(), "output": 更新输出骨架(), "调用卡片": {"标题": "Update reminder", "种类": "other", "展示输入": "id"}}
  ]

# renderValue：确定性模型内容（上游 ToolRuntime 已按无损 JSON 输出骨架校验过值）
段落 渲染值(值):
  返回 [{"type": "text", "text": 紧凑JSON(值)}]

# present：纯 generic pending 卡片（rawInput 缺省即省键）
段落 造调用卡片(标题, 种类, 原始输入):
  设 卡片 为 {"card": "generic", "title": 标题, "kind": 种类}
  如果 原始输入 != 空:
    字典设置(卡片, "rawInput", 原始输入)
  返回 卡片

# =====================================================================
# §4 校验纯函数（validateCreateArgs / validateUpdateArgs / 时序变更提取）
# =====================================================================

# validateCreateArgs：未知键或 selector 数 != 1 → invalid_selector；
#   prompt/title 修剪后非空、标题上限；after_seconds 正安全整数；every_seconds 走 间隔非法。
段落 校验创建参数(参数):
  设 白名单 为 ["prompt", "title", "after_seconds", "at", "every_seconds", "daily", "weekly", "cron"]
  设 选择器数 为 0
  遍历 键 之 字典键列表(参数):
    如果 列表包含(白名单, 键) == 假:
      返回 造错误("invalid_selector", "schedule_create accepts exactly one of after_seconds, at, every_seconds, daily, weekly, or cron.")
    如果 键 != "prompt" 且 键 != "title":
      如果 字典获取(参数, 键) != 空:
        设 选择器数 为 选择器数 + 1
  如果 选择器数 != 1:
    返回 造错误("invalid_selector", "schedule_create accepts exactly one of after_seconds, at, every_seconds, daily, weekly, or cron.")
  如果 字符串长度(修剪空白(字典获取(参数, "prompt"))) == 0:
    返回 造错误("invalid_prompt", "prompt must be non-empty after trimming.")
  设 标题 为 字典获取(参数, "title")
  如果 字符串长度(修剪空白(标题)) == 0:
    返回 造错误("invalid_prompt", 必填标题文案())
  如果 字符串长度(修剪空白(标题)) > 最大标题长度():
    返回 造错误("invalid_prompt", "title must be at most " + 转字符串(最大标题长度()) + " characters.")
  设 延迟 为 字典获取(参数, "after_seconds")
  如果 延迟 != 空:
    如果 是安全整数(延迟) == 假 或 延迟 <= 0:
      返回 造错误("invalid_rule", "after_seconds must be a positive safe integer.")
  返回 间隔非法(字典获取(参数, "every_seconds"))

# validateUpdateArgs：至多一个 selector；id 非空且无首尾空白；零 selector 且无标题/提示 → 拒绝
段落 校验更新参数(参数):
  设 白名单 为 ["id", "title", "prompt", "at", "every_seconds", "daily", "weekly", "cron"]
  设 选择器数 为 0
  遍历 键 之 字典键列表(参数):
    如果 列表包含(白名单, 键) == 假:
      返回 造错误("invalid_selector", "schedule_update accepts at most one of at, every_seconds, daily, weekly, or cron.")
    如果 键 != "id" 且 键 != "title" 且 键 != "prompt":
      如果 字典获取(参数, 键) != 空:
        设 选择器数 为 选择器数 + 1
  如果 选择器数 > 1:
    返回 造错误("invalid_selector", "schedule_update accepts at most one of at, every_seconds, daily, weekly, or cron.")
  设 标识 为 字典获取(参数, "id")
  如果 字符串长度(修剪空白(标识)) == 0 或 修剪空白(标识) != 标识:
    返回 造错误("invalid_rule", "schedule_update id must be non-empty without surrounding whitespace.")
  如果 选择器数 == 0 且 字典获取(参数, "title") == 空 且 字典获取(参数, "prompt") == 空:
    返回 造错误("invalid_selector", "schedule_update needs a new title, prompt, or one of at, every_seconds, daily, weekly, or cron.")
  设 标题 为 字典获取(参数, "title")
  如果 标题 != 空:
    如果 字符串长度(修剪空白(标题)) == 0:
      返回 造错误("invalid_prompt", 必填标题文案())
    如果 字符串长度(修剪空白(标题)) > 最大标题长度():
      返回 造错误("invalid_prompt", "title must be at most " + 转字符串(最大标题长度()) + " characters.")
  设 提示 为 字典获取(参数, "prompt")
  如果 提示 != 空:
    如果 字符串长度(修剪空白(提示)) == 0:
      返回 造错误("invalid_prompt", "prompt must be non-empty after trimming.")
  返回 间隔非法(字典获取(参数, "every_seconds"))

# schedule_delete execute 内联 id 校验（先于 agent/闸门检查）
段落 校验删除参数(参数):
  设 标识 为 字典获取(参数, "id")
  如果 字符串长度(修剪空白(标识)) == 0 或 修剪空白(标识) != 标识:
    返回 造错误("invalid_rule", "schedule_delete id must be non-empty without surrounding whitespace.")
  返回 空

# timingChangeFrom：update 携带的那个 timing 替换，空 表请求保留已提交目标
段落 时序变更提取(参数):
  设 值 为 字典获取(参数, "at")
  如果 值 != 空:
    返回 {"kind": "at", "at": 值}
  设 值 为 字典获取(参数, "every_seconds")
  如果 值 != 空:
    返回 {"kind": "every", "every_seconds": 值}
  设 值 为 字典获取(参数, "daily")
  如果 值 != 空:
    返回 {"kind": "daily", "daily": 值}
  设 值 为 字典获取(参数, "weekly")
  如果 值 != 空:
    返回 {"kind": "weekly", "weekly": 值}
  设 值 为 字典获取(参数, "cron")
  如果 值 != 空:
    返回 {"kind": "cron", "cron": 值}
  返回 空

# =====================================================================
# §5 错误映射与间隔校验（invalidInterval / operationError）
# =====================================================================

# Number.isSafeInteger：|v| <= 2^53 - 1
段落 是安全整数(值):
  如果 是整数(值) == 假:
    返回 假
  如果 值 < 0 - 9007199254740991:
    返回 假
  返回 值 <= 9007199254740991

# invalidInterval：空 放行；非安全整数 → invalid_rule；低于下限 → frequency_too_high
段落 间隔非法(每秒):
  如果 每秒 == 空:
    返回 空
  如果 是安全整数(每秒) == 假:
    返回 造错误("invalid_rule", "every_seconds must be a safe integer.")
  如果 每秒 < 最小重复间隔秒():
    返回 造错误("frequency_too_high", "every_seconds must be at least " + 转字符串(最小重复间隔秒()) + ".")
  返回 空

# operationError：ScheduleInputError → 稳定 code 原样透传；其余 → internal_error 不泄露细节
段落 操作错误映射(错误):
  如果 是字典(错误):
    如果 字典包含键(错误, "错误名"):
      如果 错误["错误名"] == "ScheduleInputError":
        返回 {"code": 错误["code"], "message": 错误["message"]}
  返回 造内部错误()

# =====================================================================
# 本地工具
# =====================================================================

段落 造错误(码, 消息):
  返回 {"code": 码, "message": 消息}

段落 造内部错误:
  返回 {"code": "internal_error", "message": "The schedule operation failed."}

段落 拼接列表(甲, 乙):
  设 结果 为 列表创建()
  遍历 项 之 甲:
    列表追加(结果, 项)
  遍历 项 之 乙:
    列表追加(结果, 项)
  返回 结果

段落 创建输出骨架:
  返回 {"oneOf": 拼接列表([视图骨架()], 错误骨架表())}

段落 列表输出骨架:
  返回 {"oneOf": 拼接列表([{"type": "array", "items": 视图骨架()}], 错误骨架表())}

段落 删除输出骨架:
  返回 {"oneOf": 拼接列表([删除成功骨架(), 删除未找到骨架()], 错误骨架表())}

段落 更新输出骨架:
  返回 {"oneOf": 拼接列表([视图骨架(), 更新未变更骨架()], 错误骨架表())}

段落 是空白码(码):
  如果 码 == 9:
    返回 真
  如果 码 == 10:
    返回 真
  如果 码 == 11:
    返回 真
  如果 码 == 12:
    返回 真
  如果 码 == 13:
    返回 真
  如果 码 == 32:
    返回 真
  如果 码 == 160:
    返回 真
  如果 码 == 12288:
    返回 真
  返回 假

段落 修剪空白(文本):
  如果 是字符串(文本) == 假:
    返回 ""
  设 n 为 字符串长度(文本)
  设 首 为 0
  当 首 < n:
    如果 是空白码(字符转ASCII(字符串获取(文本, 首))) == 假:
      跳出
    设 首 为 首 + 1
  设 尾 为 n
  当 尾 > 首:
    如果 是空白码(字符转ASCII(字符串获取(文本, 尾 - 1))) == 假:
      返回 截取(文本, 首, 尾)
    设 尾 为 尾 - 1
  返回 ""
