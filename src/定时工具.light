# =====================================================================
# §2 输出视图骨架（六种 timing 视图 oneOf + 错误骨架）
# =====================================================================

# basicErrorSchema：恰两字段 code(字面量 const)/message
段落 基础错误骨架(码):
  返回 {"type": "object", "additionalProperties": 假, "properties": {"code": {"type": "string", "required": 真, "const": 码}, "message": {"type": "string", "required": 真}}}

段落 错误骨架表:
  设 表 为 列表创建()
  遍历 码 之 稳定错误码表():
    列表追加(表, 基础错误骨架(码))
  返回 表

# SHARED_VIEW_PROPERTIES：id/title/prompt/scheduledAt/state/deliveryMode
段落 共享视图字段:
  返回 {"id": {"type": "string", "required": 真}, "title": {"type": "string", "required": 真}, "prompt": {"type": "string", "required": 真}, "scheduledAt": {"type": "string", "required": 真}, "state": {"type": "string", "required": 真, "enum": ["scheduled", "overdue"]}, "deliveryMode": {"type": "string", "required": 真, "const": "host"}}

# 单个 timing 视图骨架：kind 判别字段 + 额外属性（额外 为 属性字典，空 表无额外）
段落 造视图骨架(种类, 额外):
  设 属性 为 共享视图字段()
  字典设置(属性, "kind", {"type": "string", "required": 真, "const": 种类})
  如果 额外 != 空:
    遍历 键 之 字典键列表(额外):
      字典设置(属性, 键, 额外[键])
  返回 {"type": "object", "additionalProperties": 假, "properties": 属性}

# AFTER/AT/EVERY/DAILY/WEEKLY/CRON 六视图（视图侧键为驼峰 timeZone；工具入参侧才是蛇形 time_zone）
段落 时机视图骨架表:
  返回 [
    造视图骨架("after", {"afterSeconds": {"type": "integer", "required": 真}}),
    造视图骨架("at", 空),
    造视图骨架("every", {"everySeconds": {"type": "integer", "required": 真}}),
    造视图骨架("daily", {"time": {"type": "string", "required": 真}, "timeZone": {"type": "string", "required": 真}}),
    造视图骨架("weekly", {"time": {"type": "string", "required": 真}, "timeZone": {"type": "string", "required": 真}, "weekdays": {"type": "array", "required": 真, "items": {"type": "integer"}}}),
    造视图骨架("cron", {"expression": {"type": "string", "required": 真}, "timeZone": {"type": "string", "required": 真}})
  ]

段落 视图骨架:
  返回 {"oneOf": 时机视图骨架表()}

# ---- delete/update 的非变更分支骨架 ----

段落 删除成功骨架:
  返回 {"type": "object", "additionalProperties": 假, "properties": {"id": {"type": "string", "required": 真}, "deleted": {"type": "boolean", "required": 真, "const": 真}}}

段落 删除未找到骨架:
  返回 {"type": "object", "additionalProperties": 假, "properties": {"id": {"type": "string", "required": 真}, "deleted": {"type": "boolean", "required": 真, "const": 假}, "code": {"type": "string", "required": 真, "const": "schedule_not_found"}}}

段落 更新未变更骨架:
  返回 {"type": "object", "additionalProperties": 假, "properties": {"id": {"type": "string", "required": 真}, "updated": {"type": "boolean", "required": 真, "const": 假}, "code": {"type": "string", "required": 真, "enum": ["schedule_not_found", "schedule_ended", "schedule_conflict"]}}}

# =====================================================================
# §3 四工具 schema 描述与输出视图
# =====================================================================

段落 创建描述:
  返回 "Create a reminder in the current session that delivers prompt when it becomes due. Supply exactly one timing parameter: after_seconds, at, every_seconds, daily, weekly, or cron. Local times that do not exist in the zone are skipped; repeated local times fire once, at the earlier instant. After downtime, a recurring reminder delivers only its latest missed occurrence. Delivery can repeat after a crash."

段落 列表描述:
  返回 "List the active reminders in the current session."

段落 删除描述:
  返回 "Delete a reminder in the current session, active or inactive. Deletion does not retract a reminder message that is already queued."

段落 更新描述:
  返回 "Change a reminder in place, keeping its id. Supply a new title, prompt, or at most one timing parameter; omitted fields keep their stored values. To change a relative delay, create a new reminder."

# SELECTOR_PARAMETERS：create/update 共用的五个 selector 入参（入参侧蛇形 time_zone）
段落 选择器参数表:
  设 每描述 为 "Fixed-rate interval in whole seconds, at least " + 转字符串(最小重复间隔秒()) + ", aligned to the creation time; changing it with schedule_update re-aligns it to the save time."
  返回 {"every_seconds": {"type": "number", "description": 每描述},
    "daily": {"type": "object", "additionalProperties": 假, "description": "Every day at a local time.", "properties": {"time": {"type": "string", "required": 真, "description": "HH:mm:ss with optional 1-3 fractional digits, for example 23:00:00."}, "time_zone": {"type": "string", "required": 真, "description": "UTC or IANA Area/Location, for example Asia/Shanghai."}}},
    "weekly": {"type": "object", "additionalProperties": 假, "description": "On the given weekdays at a local time.", "properties": {"time": {"type": "string", "required": 真, "description": "HH:mm:ss with optional 1-3 fractional digits, for example 09:00:00."}, "time_zone": {"type": "string", "required": 真, "description": "UTC or IANA Area/Location, for example Asia/Shanghai."}, "weekdays": {"type": "array", "required": 真, "description": "ISO weekdays, Monday 1 through Sunday 7, without repetitions.", "items": {"type": "integer"}}}},
    "cron": {"type": "object", "additionalProperties": 假, "description": "Five-field Vixie cron expression in a time zone.", "properties": {"expression": {"type": "string", "required": 真, "description": "minute hour day-of-month month day-of-week, for example \"*/15 9-17 * * 1-5\". When both day fields are restricted, a date matches if either one matches."}, "time_zone": {"type": "string", "required": 真, "description": "UTC or IANA Area/Location, for example Asia/Shanghai."}}},
    "at": {"description": "Absolute target: an RFC 3339 date-time with offset, or a local date, time, and IANA time_zone.", "oneOf": [{"type": "string"}, {"type": "object", "additionalProperties": 假, "properties": {"date": {"type": "string", "required": 真}, "time": {"type": "string", "required": 真}, "time_zone": {"type": "string", "required": 真}}}]}}

# 四工具 parameters：固定字段 + 选择器参数合并（拷贝构造，避免共享可变句柄）
段落 创建参数表:
