# 工具_编辑文件.light —— 编辑文件核心工具（唯一命中替换 / 按行插入）
#
# 工具名：编辑文件
# 参数：  {"路径":"文件路径", "旧文本":"...", "新文本":"...", "全部替换":真/假, "插入行":N}
#   · 替换模式（缺省）：旧文本 必须在文件里唯一命中；多命中时须显式传 全部替换=真。
#   · 插入模式（给了 插入行）：把 新文本 插到前 N 行之后（N=0 插文首，N=总行数 追加文末），不吞原行。
# 返回：  工具结果字典（造工具结果）：成功=编辑后文案 + 替换次数 + 统一差异；失败=isError=真。
#
# 设计：把 DSH fs 面的 edit 命令（packages/fs/tool-fs 的 old_string/new_string）
#   接到 lightharness 的中文工具面上，替代「改一行 = 写文件整文件重写」。
#   纯逻辑一律复用 文件系统工具（校验编辑参数 / 收集命中 / 施加编辑 / 编辑后文案 /
#   行差分表 / 渲染统一差异文本）与 字符串替换编辑器（偏移行号 / 整数表转文本），
#   本模块只做「中文参数 <-> 英文编辑参数」的翻译、行号文案与插入分支，不另造一套。
#
# 依赖注入（测试可离线）：依赖 字典键
#   "读取文件" 段落(路径) -> 文本；"写入文件" 段落(路径, 内容)
#   依赖 非空 = 离线模式（路径原样使用，不落 路径安全 判定，便于临时目录/内存桩）；
#   依赖 空   = 真实模式，走 解析安全路径(取根目录(), 路径) + 文件系统.读取文件/写入文件。

从 工具 导入 造工具定义, 造工具结果
从 文件系统工具 导入 校验编辑参数, 收集命中, 施加编辑, 编辑后文案, 行差分表, 渲染统一差异文本
从 字符串替换编辑器 导入 偏移行号, 整数表转文本
从 文件系统 导入 读取文件, 写入文件
从 工具_路径安全 导入 解析安全路径, 取根目录

导出 编辑文件模式 编辑文件处理 造编辑文件工具定义 注册编辑文件工具。

# 差异呈现的行数预算：两侧都 <= 该行数才渲染统一差异（行差分表 是 O(n*m) DP，
# 大文件改一行不该为「给人看的差异」付平方代价）。
设 差异行预算 为 400

# 工具定义构造时登记的依赖（工具执行流水线只按 执行函数(参数) 单参调用，
# 无法把依赖塞进闭包，故用可变槽保存；测试也可直接给 编辑文件处理 传 依赖）。
设 依赖槽 为 {"依赖": 空}

# ---------------------------------------------------------------------------
# 工具 schema（中文键，与 写文件/读文件 同风格）
# ---------------------------------------------------------------------------
段落 编辑文件模式:
  返回 ["type": "object",
          "properties": ["路径": ["type": "string", "description": "要编辑的文件路径（限项目根内）。Provide `file_path` before other arguments."],
                         "旧文本": ["type": "string", "description": "要被替换的原文片段；必须在文件里唯一命中，要替换多处请显式传 全部替换=真"],
                         "新文本": ["type": "string", "description": "替换后的文本；插入模式下为要插入的文本"],
                         "全部替换": ["type": "boolean", "description": "为真时替换全部命中；缺省为假，此时旧文本必须唯一命中"],
                         "插入行": ["type": "integer", "description": "给了该键即改为按行插入：在前 N 行之后插入新文本（N=0 插文首，N=总行数 追加文末）"]],
          "required": ["路径"]]

# ---------------------------------------------------------------------------
# 依赖解析
# ---------------------------------------------------------------------------
段落 取读回调(依赖):
  如果 依赖 == 空:
    返回 读取文件
  如果 字典包含键(依赖, "读取文件"):
    返回 依赖["读取文件"]
  返回 读取文件

段落 取写回调(依赖):
  如果 依赖 == 空:
    返回 写入文件
  如果 字典包含键(依赖, "写入文件"):
    返回 依赖["写入文件"]
  返回 写入文件

# 中文参数 -> 文件系统工具 的英文编辑参数（校验编辑参数 的口径）
段落 中文参数转西(参数):
  设 转后 为 {}
  如果 字典包含键(参数, "路径"):
    转后["file_path"] 为 参数["路径"]
  如果 字典包含键(参数, "旧文本"):
    转后["old_string"] 为 参数["旧文本"]
  如果 字典包含键(参数, "新文本"):
    转后["new_string"] 为 参数["新文本"]
  如果 字典包含键(参数, "全部替换"):
    转后["replace_all"] 为 参数["全部替换"]
  返回 转后

# ---------------------------------------------------------------------------
# 插入分支：在前 N 行之后插入新文本（不吞原行，N 允许 0 与 总行数）
# ---------------------------------------------------------------------------
段落 执行插入(路径, 原文, 插入行, 参数, 写):
  设 值 为 字典获取(参数, "新文本", 空)
  如果 是字符串(值) == 假:
    返回 造工具结果("新文本必须为字符串", 真)
  设 行表 为 分割字符串(原文, "\n")
  设 总行数 为 列表长度(行表)
  设 范围错 为 假
  如果 是整数(插入行) == 假:
    设 范围错 为 真
  如果 是整数(插入行):
    如果 插入行 < 0:
      设 范围错 为 真
    如果 插入行 > 总行数:
      设 范围错 为 真
  如果 范围错:
    返回 造工具结果("插入行参数无效: " + 转字符串(插入行) + "。应在文件行号范围内: [0, " + 转字符串(总行数) + "]", 真)
  设 新行表 为 []
  设 序号 为 0
  当 序号 < 插入行:
    列表追加(新行表, 行表[序号])
    设 序号 为 序号 + 1
  设 插行表 为 分割字符串(值, "\n")
  遍历 插行 之 插行表:
    列表追加(新行表, 插行)
  设 序号 为 插入行
  当 序号 < 总行数:
    列表追加(新行表, 行表[序号])
    设 序号 为 序号 + 1
  设 新文 为 连接字符串(新行表, "\n")
  尝试:
    写(路径, 新文)
  捕获 错误:
    返回 造工具结果("写入文件失败: " + 转字符串(错误), 真)
  设 文案 为 "已在第 " + 转字符串(插入行) + " 行之后插入 " + 转字符串(列表长度(插行表)) + " 行；文件 " + 路径 + " 已更新（原 " + 转字符串(总行数) + " 行，现 " + 转字符串(列表长度(新行表)) + " 行）"
  返回 造工具结果(拼接差异(路径, 原文, 新文, 文案), 假)

# ---------------------------------------------------------------------------
# 替换分支：唯一命中（缺省）/ 全部替换
# ---------------------------------------------------------------------------
段落 拼接差异(路径, 前文, 后文, 文案):
  设 前行数 为 列表长度(分割字符串(前文, "\n"))
  设 后行数 为 列表长度(分割字符串(后文, "\n"))
  如果 前行数 > 差异行预算:
    返回 文案 + "\n（文件较大，已省略统一差异；改后共 " + 转字符串(后行数) + " 行）"
  如果 后行数 > 差异行预算:
    返回 文案 + "\n（文件较大，已省略统一差异；改后共 " + 转字符串(后行数) + " 行）"
  设 块表 为 行差分表(前文, 后文)
  返回 文案 + "\n" + 渲染统一差异文本(路径, 块表)

段落 执行替换(路径, 原文, 参数, 写):
  设 解析 为 空
  尝试:
    设 解析 为 校验编辑参数(中文参数转西(参数))
  捕获 错误:
    返回 造工具结果(转字符串(错误), 真)
  设 旧串 为 解析["旧串"]
  设 新串 为 解析["新串"]
  设 全部 为 解析["全部替换"]
  设 命中表 为 收集命中(原文, 旧串)
  设 次数 为 列表长度(命中表)
  如果 次数 == 0:
    设 行数 为 列表长度(分割字符串(原文, "\n"))
    返回 造工具结果("未找到旧文本（文件共 " + 转字符串(行数) + " 行，行号范围 [1, " + 转字符串(行数) + "]）：old_string did not appear verbatim in " + 路径, 真)
  设 施加 为 空
  尝试:
    设 施加 为 施加编辑(原文, 旧串, 新串, 全部)
  捕获 错误:
    # 多命中：复用 文件系统工具 现有错误文案，前置中文「命中次数 + 行号」便于模型自纠
    设 行号表 为 偏移行号(原文, 命中表)
    返回 造工具结果("旧文本命中 " + 转字符串(次数) + " 次（行号 [" + 整数表转文本(行号表) + "]）：" + 转字符串(错误), 真)
  如果 施加["许可"] == 假:
    设 行数 为 列表长度(分割字符串(原文, "\n"))
    返回 造工具结果("未找到旧文本（文件共 " + 转字符串(行数) + " 行，行号范围 [1, " + 转字符串(行数) + "]）：old_string did not appear verbatim in " + 路径, 真)
  尝试:
    写(路径, 施加["内容"])
  捕获 错误:
    返回 造工具结果("写入文件失败: " + 转字符串(错误), 真)
  设 文案 为 编辑后文案(路径, 全部) + "\n替换次数: " + 转字符串(次数)
  返回 造工具结果(拼接差异(路径, 原文, 施加["内容"], 文案), 假)

# ---------------------------------------------------------------------------
# 工具处理入口
# ---------------------------------------------------------------------------
段落 编辑文件处理(参数, 依赖 = 空):
  设 用依赖 为 依赖
  如果 用依赖 == 空:
    设 用依赖 为 依赖槽["依赖"]
  设 离线 为 用依赖 != 空
  如果 type(参数) != dict:
    返回 造工具结果("参数必须是字典", 真)
  # 1) 路径：非空字符串；真实模式落 路径安全 判定
  设 路径 为 字典获取(参数, "路径", 空)
  如果 是字符串(路径) == 假:
    返回 造工具结果("路径必须为非空字符串", 真)
  如果 字符串长度(去除空白(路径)) == 0:
    返回 造工具结果("路径必须为非空字符串", 真)
  设 目标 为 路径
  如果 离线 == 假:
    设 安全 为 解析安全路径(取根目录(), 路径)
    如果 安全["ok"] == 假:
      返回 造工具结果("路径安全校验失败: " + 安全["理由"], 真)
    设 目标 为 安全["路径"]
  # 2) 读原文（文件不存在/读失败一律回 工具结果，不把异常抛给流水线）
  设 读 为 取读回调(用依赖)
  设 写 为 取写回调(用依赖)
  设 原文 为 ""
  尝试:
    设 原文 为 读(目标)
  捕获 错误:
    返回 造工具结果("读取文件失败: " + 转字符串(错误), 真)
  # 3) 给了 插入行 走插入分支；否则走唯一命中替换
  设 插入行值 为 空
  如果 字典包含键(参数, "插入行"):
    设 插入行值 为 参数["插入行"]
  如果 插入行值 != 空:
    返回 执行插入(目标, 原文, 插入行值, 参数, 写)
  返回 执行替换(目标, 原文, 参数, 写)

# ---------------------------------------------------------------------------
# 工具定义 / 注册
# ---------------------------------------------------------------------------
段落 造编辑文件工具定义(依赖 = 空):
  设 依赖槽["依赖"] 为 依赖
  设 描述 为 "在项目根内编辑文件：按 旧文本 做替换（旧文本必须在文件里唯一命中；要替换多处显式传 全部替换=真），或按 插入行 在前 N 行之后插入（不吞原行），避免整文件重写"
  返回 造工具定义("编辑文件", 描述, 编辑文件模式(), 编辑文件处理)

段落 注册编辑文件工具(注册表):
  注册表.注册(造编辑文件工具定义())
  返回 真
