# 截图坐标协议.light —— R176-B4：cua 截图/坐标协议纯逻辑移植（A 路清单 B4 #11）
#
# 上游：G:/github/deepseek-harness packages/experimental/cua/src/{protocol.ts,coordinates.ts,types.ts}
#   锚点 dsh-v0.2.1-rc.3 = 1f81c047fc
#
# 上游 → 光明对照表：
#   18 个 method 的严格判别联合          → 图协方法表 / 图协是方法
#   CuaCoordinates.observe 失效规则      → 图协观察窗口（尺寸变化即丢旧映射）
#   CuaCoordinates.screenshot 绑定       → 图协绑截图
#   CuaCoordinates.parameters 换算        → 图协换算参数 / 图协换算单轴
#   STALE_SNAPSHOT / SCREENSHOT_REQUIRED / INVALID_ARGUMENT → 三个错误码与文案
#   imageBase64 的 canonical 校验        → 图协是规范base64
#   坐标/端口类取值域（point/relativePoint/id/pid）→ 图协校验坐标 / 图协校验相对 / 图协校验标识
#
# 换算语义（逐字对齐上游 convert）：
#   - 相对（relative=true，千分比 0..1000 整数）：min(v/1000*轴, max(0, 轴-1))
#     —— 钳制到「窗口最后一像素」，避免落在边界外。
#   - 绝对（像素）：v >= pixels → INVALID_ARGUMENT；否则 v*轴/pixels
#     —— pixels 取**最新截图**的该轴像素数（无截图则 SCREENSHOT_REQUIRED）。
#   - 帧缺失或宽高 <= 0 → STALE_SNAPSHOT（要求先读新鲜窗口状态）。
#   - 换算后必须删除 relative 这个 Host 专有选项（上游 `delete native.relative`）。
#
# 宿主面登记（不移植）：zod schema 运行期、native-client 的 JSON-RPC 派发、macOS AX 观测、
#   剪贴板、截图编码与图像准入全部属宿主面；本模块只做「判别联合的取值域 + 坐标数学 + 映射失效」。
#
# 命名避坑：段落带前缀「图协」，避免与 src/ 其它模块撞名（已 grep 自查）。

从 内置核心判型 导入 是字典, 是字符串, 是列表, 是整数, 是浮点, 是空
从 内置核心字典 导入 字典设置, 字典获取, 字典包含键, 字典键列表, 字典删除
从 内置核心字符串 导入 截取, 开头, 结尾, 字符串包含
从 内置核心列表 导入 列表包含

# =====================================================================
# §1 方法表（18 个 method，严格判别联合）
# =====================================================================

# 图协方法表() -> 18 个方法名（顺序对齐上游 Request 联合顺序）
段落 图协方法表:
  返回 ["getCapabilities", "listApps", "findApps", "getApp", "activate", "show", "listWindows", "getState", "hover", "click", "setValue", "selectText", "performSecondaryAction", "typeText", "paste", "pressKey", "scroll", "drag", "screenshot"]

# 图协是方法(名) -> 真假
段落 图协是方法(名):
  返回 列表包含(图协方法表(), 名)

# 图协坐标方法表() -> 携带坐标的 4 个方法（hover/click/scroll/drag）
段落 图协坐标方法表:
  返回 ["hover", "click", "scroll", "drag"]

# =====================================================================
# §2 取值域（point / relativePoint / id / pid）
# =====================================================================

# 图协校验坐标(值) -> 错误串（""=通过）：非负有限数（point = z.number().nonnegative()）
段落 图协校验坐标(值):
  如果 是整数(值) == 假:
    如果 是浮点(值) == 假:
      返回 "Expected a nonnegative coordinate"
  如果 值 < 0:
    返回 "Expected a nonnegative coordinate"
  如果 值 * 0 != 0:
    返回 "Expected a nonnegative coordinate"
  返回 ""

# 图协校验相对(值) -> 错误串：0..1000 的整数（relativePoint）
段落 图协校验相对(值):
  如果 是整数(值) == 假:
    返回 "Expected an integer thousandth between 0 and 1000"
  如果 值 < 0 或 值 > 1000:
    返回 "Expected an integer thousandth between 0 and 1000"
  返回 ""

# 图协校验标识(值) -> 错误串：正整数且 <= 2^32-1（id）
段落 图协校验标识(值):
  如果 是整数(值) == 假:
    返回 "Expected a positive integer identifier"
  如果 值 < 1:
    返回 "Expected a positive integer identifier"
  如果 值 > 4294967295:
    返回 "Expected a positive integer identifier"
  返回 ""

# 图协校验进程号(值) -> 错误串：正整数且 <= 2^31-1（pid）
段落 图协校验进程号(值):
  如果 是整数(值) == 假:
    返回 "Expected a positive process identifier"
  如果 值 < 1:
    返回 "Expected a positive process identifier"
  如果 值 > 2147483647:
    返回 "Expected a positive process identifier"
  返回 ""

# =====================================================================
# §3 规范 base64（imageBase64 refine：往返重编码必须逐字节相同）
# =====================================================================

# 图协是规范base64(值) -> 真假
#   上游：Buffer.from(value,'base64').toString('base64') === value ——
#   拒绝空白、缺 padding、非零 pad 位、非字母表字符；长度必须是 4 的倍数。
段落 图协是规范base64(值):
  如果 是字符串(值) == 假:
    返回 假
  设 长 为 字符串长度(值)
  如果 长 == 0:
    返回 假
  如果 长 % 4 != 0:
    返回 假
  设 填充 为 0
  如果 结尾(值, "==") == 真:
    设 填充 为 2
  否则 如果 结尾(值, "=") == 真:
    设 填充 为 1
  设 主体 为 截取(值, 0, 长 - 填充)
  设 i 为 0
  当 i < 字符串长度(主体):
    如果 图协是base64字符(截取(主体, i, i + 1)) == 假:
      返回 假
    设 i 为 i + 1
  如果 填充 > 0:
    设 尾字 为 截取(主体, 字符串长度(主体) - 1, 字符串长度(主体))
    设 码 为 图协base64值(尾字)
    如果 填充 == 2:
      如果 码 % 16 != 0:
        返回 假
    否则:
      如果 码 % 4 != 0:
        返回 假
  返回 真

段落 图协是base64字符(字):
  设 码 为 ord(字)
  如果 码 >= 65 且 码 <= 90:
    返回 真
  如果 码 >= 97 且 码 <= 122:
    返回 真
  如果 码 >= 48 且 码 <= 57:
    返回 真
  如果 字 == "+" 或 字 == "/":
    返回 真
  返回 假

段落 图协base64值(字):
  设 码 为 ord(字)
  如果 码 >= 65 且 码 <= 90:
    返回 码 - 65
  如果 码 >= 97 且 码 <= 122:
    返回 码 - 97 + 26
  如果 码 >= 48 且 码 <= 57:
    返回 码 - 48 + 52
  如果 字 == "+":
    返回 62
  如果 字 == "/":
    返回 63
  返回 0

# =====================================================================
# §4 窗口映射（observe / screenshot 的失效规则）
# =====================================================================

# 图协造坐标表() -> {"应用": {应用句柄: {窗口号: 帧}}}
#   帧 = {"宽": 数, "高": 数, "图像": {"宽","高"} | 空}
段落 图协造坐标表:
  设 应用 为 {}
  返回 {"应用": 应用}

段落 图协造帧(宽, 高):
  返回 {"宽": 宽, "高": 高, "图像": 空}

# 图协观察窗口(表, 应用句柄, 窗口表, 窗口号) -> 表（原地更新）
#   上游 observe：
#     - 有 windowId → 以旧表为基础，只更新/删除该窗口；无 windowId → 全新表（完整清单）。
#     - windowId 不在新观测里 → 删除该窗口（窗口已关，旧映射失效）。
#     - 其余窗口：宽高未变 → **保留旧帧**（连同已绑定的截图）；变了 → 换新帧（图像清空）。
段落 图协观察窗口(表, 应用句柄, 窗口表, 窗口号):
  设 应用 为 表["应用"]
  设 旧 为 空
  如果 字典包含键(应用, 应用句柄) == 真:
    设 旧 为 应用[应用句柄]
  设 当前 为 {}
  如果 窗口号 != 空:
    如果 旧 != 空:
      遍历 号 之 字典键列表(旧):
        字典设置(当前, 号, 旧[号])
    设 命中 为 假
    遍历 窗 之 窗口表:
      如果 窗["windowId"] == 窗口号:
        设 命中 为 真
    如果 命中 == 假:
      字典删除(当前, 窗口号)
  遍历 窗 之 窗口表:
    设 宽 为 窗["bounds"]["width"]
    设 高 为 窗["bounds"]["height"]
    设 帧 为 图协造帧(宽, 高)
    如果 旧 != 空:
      如果 字典包含键(旧, 窗["windowId"]) == 真:
        设 旧帧 为 旧[窗["windowId"]]
        如果 旧帧["宽"] == 宽 且 旧帧["高"] == 高:
          设 帧 为 旧帧
    字典设置(当前, 窗["windowId"], 帧)
  字典设置(应用, 应用句柄, 当前)
  返回 表

# 图协绑截图(表, 应用句柄, 窗口号, 窗口宽, 窗口高, 图宽, 图高) -> 表
#   上游 screenshot：把交付给模型的**那张图**绑定到当时的窗口点尺寸。
段落 图协绑截图(表, 应用句柄, 窗口号, 窗口宽, 窗口高, 图宽, 图高):
  设 应用 为 表["应用"]
  如果 字典包含键(应用, 应用句柄) == 假:
    设 新表 为 {}
    字典设置(应用, 应用句柄, 新表)
  设 帧 为 {}
  字典设置(帧, "宽", 窗口宽)
  字典设置(帧, "高", 窗口高)
  设 图像 为 {}
  字典设置(图像, "宽", 图宽)
  字典设置(图像, "高", 图高)
  字典设置(帧, "图像", 图像)
  字典设置(应用[应用句柄], 窗口号, 帧)
  返回 表

# 图协取帧(表, 应用句柄, 窗口号) -> 帧 | 空
段落 图协取帧(表, 应用句柄, 窗口号):
  设 应用 为 表["应用"]
  如果 字典包含键(应用, 应用句柄) == 假:
    返回 空
  设 帧表 为 应用[应用句柄]
  如果 字典包含键(帧表, 窗口号) == 假:
    返回 空
  返回 帧表[窗口号]

# =====================================================================
# §5 坐标换算（parameters）
# =====================================================================

# 图协换算单轴(值, 轴, 图素, 相对) -> {"值": 数, "码": 串, "错误": 串}
#   相对：min(v/1000*轴, max(0, 轴-1))；绝对：v >= 图素 → INVALID_ARGUMENT，否则 v*轴/图素。
段落 图协换算单轴(值, 轴, 图素, 相对):
  如果 相对 == 真:
    设 上限 为 轴 - 1
    如果 上限 < 0:
      设 上限 为 0
    设 换算 为 值 / 1000 * 轴
    如果 换算 > 上限:
      设 换算 为 上限
    返回 {"值": 换算, "码": "", "错误": ""}
  如果 值 >= 图素:
    返回 {"值": 0, "码": "INVALID_ARGUMENT", "错误": "Coordinate is outside the latest screenshot"}
  返回 {"值": 值 * 轴 / 图素, "码": "", "错误": ""}

# 图协换算参数(表, 应用句柄, 窗口号, 参数) -> {"参数": 字典|空, "码": 串, "错误": 串}
#   顺序与上游 parameters 一致：无坐标键 → 原样返回；无帧/宽高<=0 → STALE_SNAPSHOT；
#   绝对坐标但无绑定截图 → SCREENSHOT_REQUIRED；随后逐轴换算；最后删 relative。
段落 图协换算参数(表, 应用句柄, 窗口号, 参数):
  设 有坐标 为 字典包含键(参数, "x") == 真 或 字典包含键(参数, "fromX") == 真
  如果 有坐标 == 假:
    返回 {"参数": 参数, "码": "", "错误": ""}
  设 帧 为 图协取帧(表, 应用句柄, 窗口号)
  如果 帧 == 空:
    返回 {"参数": 空, "码": "STALE_SNAPSHOT", "错误": "Read fresh window state before coordinate input"}
  如果 帧["宽"] <= 0 或 帧["高"] <= 0:
    返回 {"参数": 空, "码": "STALE_SNAPSHOT", "错误": "Read fresh window state before coordinate input"}
  设 相对 为 字典获取(参数, "relative", 假) == 真
  如果 相对 == 假 且 帧["图像"] == 空:
    返回 {"参数": 空, "码": "SCREENSHOT_REQUIRED", "错误": "Take a fresh screenshot before using absolute pixel coordinates"}
  设 图宽 为 帧["宽"]
  设 图高 为 帧["高"]
  如果 帧["图像"] != 空:
    设 图宽 为 帧["图像"]["宽"]
    设 图高 为 帧["图像"]["高"]
  设 结果 为 {}
  遍历 键 之 字典键列表(参数):
    如果 键 != "relative":
      字典设置(结果, 键, 参数[键])
  如果 字典包含键(参数, "x") == 真:
    设 横 为 图协换算单轴(参数["x"], 帧["宽"], 图宽, 相对)
    如果 横["码"] != "":
      返回 {"参数": 空, "码": 横["码"], "错误": 横["错误"]}
    设 纵 为 图协换算单轴(参数["y"], 帧["高"], 图高, 相对)
    如果 纵["码"] != "":
      返回 {"参数": 空, "码": 纵["码"], "错误": 纵["错误"]}
    字典设置(结果, "x", 横["值"])
    字典设置(结果, "y", 纵["值"])
    返回 {"参数": 结果, "码": "", "错误": ""}
  设 起横 为 图协换算单轴(参数["fromX"], 帧["宽"], 图宽, 相对)
  如果 起横["码"] != "":
    返回 {"参数": 空, "码": 起横["码"], "错误": 起横["错误"]}
  设 起纵 为 图协换算单轴(参数["fromY"], 帧["高"], 图高, 相对)
  如果 起纵["码"] != "":
    返回 {"参数": 空, "码": 起纵["码"], "错误": 起纵["错误"]}
  设 终横 为 图协换算单轴(参数["toX"], 帧["宽"], 图宽, 相对)
  如果 终横["码"] != "":
    返回 {"参数": 空, "码": 终横["码"], "错误": 终横["错误"]}
  设 终纵 为 图协换算单轴(参数["toY"], 帧["高"], 图高, 相对)
  如果 终纵["码"] != "":
    返回 {"参数": 空, "码": 终纵["码"], "错误": 终纵["错误"]}
  字典设置(结果, "fromX", 起横["值"])
  字典设置(结果, "fromY", 起纵["值"])
  字典设置(结果, "toX", 终横["值"])
  字典设置(结果, "toY", 终纵["值"])
  返回 {"参数": 结果, "码": "", "错误": ""}

# =====================================================================
# 导出
# =====================================================================

导出 图协方法表, 图协是方法, 图协坐标方法表
导出 图协校验坐标, 图协校验相对, 图协校验标识, 图协校验进程号
导出 图协是规范base64, 图协是base64字符, 图协base64值
导出 图协造坐标表, 图协造帧, 图协观察窗口, 图协绑截图, 图协取帧
导出 图协换算单轴, 图协换算参数
