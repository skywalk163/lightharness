# 外壳环境.light —— 对标上游 packages/shell/shell-env/src/index.ts（200 行，a305303422）
#   + packages/shell/shell/src/types.ts（DSH_ENV_PREFIX 引自 subprocess types = "DSH_"）
#   + packages/util/home-paths/src/index.ts（DSH_HOME_ENV="DSH_HOME"、resolveDshHome 默认 ~/.dsh）
# 工具无关的受信 DSH_* 环境注册表：内置事实（DSH_HOME/DSH_SHELL/DSH_SESSION_ID）由注册表自身
#   拥有（contributor 禁拥），插件经 register 登记「声明键 + 逐执行解析器」，effect 作用域
#   注销降级为返回注销闭包（同步删除，宿主面剔除登记见交付报告）。
#
# 宿主面剔除（任务书 §7）：ctx.effect / Cordis Service / ToolExecution 全部入参化——
#   注册表为普通字典，执行上下文为入参字典（"会话id" 可选键，对齐上游
#   execution.agent.session.header.id 的拍平投影）。
#
# 键序口径：上游 localeCompare 在本轮键集（ASCII 大写字母/数字/下划线）上与码点序一致；
#   光明用字符串 < 码点比较近似（下划线与字母交叉的歧义键未逐一对齐，登记语言差异）。
# 绕法备注：键后缀 ^[A-Z][A-Z0-9_]*$ 用 ASCII 码点手写判定（L-086 正则规避）；
#   字符串原语用内置裸名（L-090）；标识符避开 为 字（L-084）；无 且/或 行内链（L-043 规避）。

从 主目录路径 导入 解析主目录

导出 是后缀合法字符 是合法键后缀 是合法环境键 是保留键 解析家目录 造注册表 名字较前 排序名字表 键序较前 排序键序表 注册贡献者 快照环境 列出变量 是凭证形状键 净化父环境 是控制环境键 注入控制标记。

# DSH_ENV_PREFIX（subprocess types.ts:13）
设 DSH前缀 为 "DSH_"
# DSH_HOME_ENV（home-paths index.ts:18）
设 DSH家目录键 为 "DSH_HOME"
# DSH_SHELL_KEY（shell-env index.ts:70）
设 DSH外壳键 为 "DSH_SHELL"
# DSH_SESSION_ID_KEY（shell-env index.ts:71）
设 DSH会话键 为 "DSH_SESSION_ID"

# 键后缀字符白名单（BASH_ENV_KEY_SUFFIX 的字符集）：A-Z / 0-9 / 下划线
段落 是后缀合法字符(字符):
  设 码 为 码位(字符)
  如果 码 == 95:
    返回 真
  如果 码 >= 65:
    如果 码 <= 90:
      返回 真
  如果 码 >= 48:
    如果 码 <= 57:
      返回 真
  返回 假

# BASH_ENV_KEY_SUFFIX（index.ts:77）^[A-Z][A-Z0-9_]*$：首字符必须 A-Z，其余取白名单
段落 是合法键后缀(后缀):
  设 长 为 字符串长度(后缀)
  如果 长 < 1:
    返回 假
  设 首码 为 码位(字符串获取(后缀, 0))
  如果 首码 < 65:
    返回 假
  如果 首码 > 90:
    返回 假
  设 序号 为 1
  当 序号 < 长:
    如果 是后缀合法字符(字符串获取(后缀, 序号)) == 假:
      返回 假
    设 序号 为 序号 + 1
  返回 真

# 键整体校验（index.ts:119-120）：DSH_ 前缀 + 后缀合法
段落 是合法环境键(键):
  如果 开头(键, DSH前缀) == 假:
    返回 假
  返回 是合法键后缀(截取到末尾(键, 字符串长度(DSH前缀)))

# RESERVED_BASH_ENV_KEYS（index.ts:72-76）：DSH_HOME / DSH_SHELL / DSH_SESSION_ID
段落 是保留键(键):
  如果 键 == DSH家目录键:
    返回 真
  如果 键 == DSH外壳键:
    返回 真
  如果 键 == DSH会话键:
    返回 真
  返回 假

# resolveDshHome（home-paths index.ts:87-91）：显式配置 > DSH_HOME 环境(非空白) > 主目录/.dsh；
#   复用 主目录路径.解析主目录（上游同构投影）
段落 解析家目录(配置值, 环境表, 主目录):
  返回 解析主目录(配置值, 环境表, 主目录)

# 构造注册表（ShellEnvRegistry 构造器，index.ts:97-100）：家目录解析一次并常驻
#   注册表形状：["贡献者表": 名字->贡献者, "键归属": 键->名字, "家目录": 路径]
段落 造注册表(配置家目录, 环境表, 主目录):
  设 家目录 为 解析家目录(配置家目录, 环境表, 主目录)
  返回 ["贡献者表": {}, "键归属": {}, "家目录": 家目录]

# 名字升序比较（collect 的 localeCompare / list 的 key.localeCompare 的码点近似）
段落 名字较前(甲, 乙):
  如果 甲 < 乙:
    返回 真
  返回 假

# 字符串升序选择排序（返回新表，不改入参顺序）
段落 排序名字表(名单):
  设 结果 为 []
  遍历 名字 之 名单:
    列表追加(结果, 名字)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 名字较前(结果[内], 结果[最小]):
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时 为 结果[外]
      设 结果[外] 为 结果[最小]
      设 结果[最小] 为 临时
    设 外 为 外 + 1
  返回 结果

# 声明条目按键升序比较（list() 的 sort by key）
段落 键序较前(甲, 乙):
  如果 甲["键"] < 乙["键"]:
    返回 真
  返回 假

# 声明条目按 键 升序选择排序（返回新表）
段落 排序键序表(条目表):
  设 结果 为 []
  遍历 条目 之 条目表:
    列表追加(结果, 条目)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 键序较前(结果[内], 结果[最小]):
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时条目 为 结果[外]
      设 结果[外] 为 结果[最小]
      设 结果[最小] 为 临时条目
    设 外 为 外 + 1
  返回 结果

# register（index.ts:108-143）：名字非空唯一 -> 逐键（前缀/后缀/保留键/描述非空/键归属唯一）->
#   登记贡献者与键归属 -> 返回注销闭包（同步删除贡献者与键归属，对齐 effect dispose）
#   贡献者形状：["名字": 文本, "变量": 键->["描述": 文本], "解析": 段落(执行上下文)->键值表]
段落 注册贡献者(注册表, 贡献者):
  设 名字 为 贡献者["名字"]
  如果 字符串长度(去除空白(名字)) == 0:
    抛出 新建 错误("bash env contributor 名字必须非空")
  设 贡献者表 为 注册表["贡献者表"]
  如果 字典包含键(贡献者表, 名字):
    抛出 新建 错误("bash env contributor \"" + 名字 + "\" 已注册")
  设 变量 为 贡献者["变量"]
  设 键表 为 字典键列表(变量)
  设 键归属 为 注册表["键归属"]
  遍历 键 之 键表:
    如果 是合法环境键(键) == 假:
      抛出 新建 错误("bash env contributor \"" + 名字 + "\" 声明了非法键 \"" + 键 + "\"")
    如果 是保留键(键):
      抛出 新建 错误("bash env contributor \"" + 名字 + "\" 不能拥有保留键 \"" + 键 + "\"")
    设 项 为 字典获取(变量, 键, 空)
    设 描述 为 项["描述"]
    如果 字符串长度(去除空白(描述)) == 0:
      抛出 新建 错误("bash env contributor \"" + 名字 + "\" 必须描述 \"" + 键 + "\"")
    设 归属 为 字典获取(键归属, 键, 空)
    如果 归属 != 空:
      抛出 新建 错误("bash env 键 \"" + 键 + "\" 已由贡献者 \"" + 归属 + "\" 拥有，贡献者 \"" + 名字 + "\" 不能同时拥有")
  设 贡献者表[名字] 为 贡献者
  遍历 键 之 键表:
    设 键归属[键] 为 名字
  段落 注销:
    字典删除(贡献者表, 名字)
    遍历 键 之 键表:
      字典删除(键归属, 键)
  返回 注销

# 表转「按键升序重建 + 冻结（深拷贝脱钩）」（index.ts:173 的 Object.freeze 排序快照投影）
段落 按键序冻结(表):
  设 键表 为 排序名字表(字典键列表(表))
  设 有序表 为 {}
  遍历 键 之 键表:
    设 有序表[键] 为 字典获取(表, 键, 空)
  返回 冻结(有序表)

# collect（index.ts:150-174）：内置 DSH_HOME/DSH_SHELL -> 执行上下文带 会话id 补 DSH_SESSION_ID ->
#   按名字升序遍历贡献者：resolve 返回表逐键校验（未声明键/非字符串值）-> 按键升序冻结快照
段落 快照环境(注册表, 执行上下文):
  设 值表 为 {}
  设 值表[DSH家目录键] 为 注册表["家目录"]
  设 值表[DSH外壳键] 为 "1"
  如果 执行上下文 != 空:
    设 会话id 为 字典获取(执行上下文, "会话id", 空)
    如果 会话id != 空:
      设 值表[DSH会话键] 为 会话id
  设 贡献者表 为 注册表["贡献者表"]
  设 名单 为 排序名字表(字典键列表(贡献者表))
  遍历 名字 之 名单:
    设 贡献者 为 字典获取(贡献者表, 名字, 空)
    设 解析 为 贡献者["解析"]
    设 返回表 为 解析(执行上下文)
    设 变量 为 贡献者["变量"]
    遍历 项 之 字典项列表(返回表):
      设 键 为 项[0]
      设 值 为 项[1]
      如果 字典包含键(变量, 键) == 假:
        抛出 新建 错误("bash env contributor \"" + 名字 + "\" 返回了未声明键 \"" + 键 + "\"")
      如果 是字符串(值) == 假:
        抛出 新建 错误("bash env contributor \"" + 名字 + "\" 为 \"" + 键 + "\" 返回了非字符串值")
      设 值表[键] 为 值
  返回 按键序冻结(值表)

# list（index.ts:176-190）：贡献者声明扁平化（贡献者/描述/键），按 键 升序；
#   内置键不在 list（上游 TODO(bash-env-list-builtins) 同步：内置事实不枚举）
段落 列出变量(注册表):
  设 结果 为 []
  设 贡献者表 为 注册表["贡献者表"]
  设 名单 为 字典键列表(贡献者表)
  遍历 名字 之 名单:
     设 贡献者 为 字典获取(贡献者表, 名字, 空)
     遍历 项 之 字典项列表(贡献者["变量"]):
       列表追加(结果, ["贡献者": 名字, "描述": 项[1]["描述"], "键": 项[0]])
  返回 排序键序表(结果)

# =====================================================================
# 【R85-B 补位】subprocess 域 0.1.6 增量纯逻辑：环境净化 + 控制通道常量
# 对标源：@deepseek-ai/dsh-subprocess/src/index.ts（SENSITIVE_ENV_PATTERN、
#   scrubbedParentEnv，锚点 ddefc45fbc 0.1.6-alpha.2）+ src/control.ts
#   （SUBPROCESS_CONTROL_FD=7 / SUBPROCESS_CONTROL_ENV='DSH_SUBPROCESS_CONTROL'）
# 移植面：凭证形状键判定（KEY|PASSWORD|SECRET|TOKEN，大小写不敏感）、
#   父环境净化（剔凭证形状 + 剔 DSH_*，大小写不敏感）、控制通道保留键判定、
#   控制标记注入。宿主面（登记不移植）：proxyEnvironmentForChild 代理叠加、
#   Reflect.deleteProperty 进程真实环境删除。
# =====================================================================

# SENSITIVE_ENV_PATTERN（index.ts:47）：/KEY|PASSWORD|SECRET|TOKEN/i
# 光明无正则（L-086 规避），按子串包含近似；大小写不敏感用 转大写 后查
段落 是凭证形状键(键):
  设 上位 为 转大写(键)
  如果 查找子串(上位, "KEY") >= 0:
    返回 真
  如果 查找子串(上位, "PASSWORD") >= 0:
    返回 真
  如果 查找子串(上位, "SECRET") >= 0:
    返回 真
  如果 查找子串(上位, "TOKEN") >= 0:
    返回 真
  返回 假

# scrubbedParentEnv（index.ts:66-80）：删凭证形状键 + 删 DSH_* 前缀（都大小写不敏感）
#   入参 环境表 = 父环境快照（宿主注入）；返回净化后的新表（不改原表）
段落 净化父环境(环境表):
  设 结果 为 {}
  遍历 项 之 字典项列表(环境表):
    设 键 为 项[0]
    设 值 为 项[1]
    如果 值 == 空:
      继续
    如果 是凭证形状键(键) == 真:
      继续
    设 上位 为 转大写(键)
    如果 开头(上位, DSH前缀) == 真:
      继续
    结果[键] 为 值
  返回 结果

# SUBPROCESS_CONTROL_ENV（control.ts:10）
设 SUBPROCESS_CONTROL_ENV 为 "DSH_SUBPROCESS_CONTROL"

# controlEnvironment（control-spawn.ts:27-35）：保留键拒绝 + 注入标记
#   入参 环境表 为新造的干净环境（宿主调用；返回同一表并打标记）
段落 是控制环境键(键):
  设 上位 为 转大写(键)
  如果 上位 == SUBPROCESS_CONTROL_ENV:
    返回 真
  返回 假

# 打标记（对齐 Object.assign 注入 SUBPROCESS_CONTROL_ENV='pipe'；保留键已由调用方先校验）
段落 注入控制标记(环境表, 控制):
  如果 控制 == "pipe":
    环境表[SUBPROCESS_CONTROL_ENV] 为 "pipe"
  返回 环境表
