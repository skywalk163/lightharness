# 模型列表缓存.light —— T-0173 B1 项#2：DeepSeek `GET /models` 缓存（纯逻辑，上游 listing-cache.ts / listing-config.ts 剥离宿主面复刻）
#
# 剥离的宿主面（不移植）：
#   - node:crypto sha256 作用域哈希：本仓作用域直接用 `url\n凭据` 串，粒度等价，仅不隐藏日志里的凭据；
#   - AbortController / signal / 异步 abandonable：纯逻辑无取消，同步模型下「首次等待」与「后台刷新」同为一次同步加载；
#   - dsh-timeout 的 request deadline：timeoutMs 仅作时序边界校验的输入，不参与同步加载；
#   - 真实的 fetch：由调用方注入 加载(url, 凭据) 能力函数。
#
# 保留的纯逻辑：
#   ① 按 凭据+端点 分作用域；② 单飞（同作用域一次在途加载）；③ 超龄后台刷新；
#   ④ 失败保留上次可用值，且只在「失败连（streak）」首次告警；⑤ 时序边界二次校验（默认 5000/600000ms）。
#
# 语言坑规避：L-151（「设 X 为」的 为 前必须有空格）；字典获取 必须三参（含默认值）；字面量不内含换行。

从 内置核心字典 导入 字典获取, 字典包含键, 字典设置
从 内置核心列表 导入 列表长度
从 内置核心判型 导入 是数值, 是整数

# =====================================================================
# §1 时序边界常量与校验（上游 listing-config.ts 逐字）
# =====================================================================

设 默认列表超时_MS 为 5000
设 默认列表最大年龄_MS 为 600000
# 上游 dsh-timeout MAX_TIMER_DELAY_MS：Node 单次计时器最大延时（2^31-1）。
设 最大计时延迟_MS 为 2147483647

# 解析列表时序：校验 timeout/maxAge 边界，缺省取默认；越界抛错（上游 resolveListingTiming 逐字）。
段落 解析列表时序(选项, 属主):
  设 超时 为 默认列表超时_MS
  如果 字典包含键(选项, "modelsTimeoutMs"):
    设 超时 为 字典获取(选项, "modelsTimeoutMs", 空)
  设 年龄 为 默认列表最大年龄_MS
  如果 字典包含键(选项, "modelsMaxAgeMs"):
    设 年龄 为 字典获取(选项, "modelsMaxAgeMs", 空)
  如果 是数值(超时) == 假 或 超时 <= 0 或 超时 > 最大计时延迟_MS:
    抛出 新建 错误(属主 + ": modelsTimeoutMs 必须是正数且不超过 " + 转字符串(最大计时延迟_MS))
  如果 是数值(年龄) == 假 或 是整数(年龄) == 假 或 年龄 < 0:
    抛出 新建 错误(属主 + ": modelsMaxAgeMs 必须是非负安全整数")
  返回 {"timeoutMs": 超时, "maxAgeMs": 年龄}

# =====================================================================
# §2 缓存状态机（上游 ModelListingCache 同步纯逻辑版）
# =====================================================================

# 建模型列表缓存：返回空白状态（作用域/清单/结算时刻/在途/失败标记/代次/关闭）。
段落 建模型列表缓存():
  返回 {"scope": 空, "listing": 空, "settledAt": 空, "inflight": 空, "failing": 假, "generation": 0, "closed": 假}

# 当前视图：无 I/O 返回作用域认证态与最近一次清单。
段落 当前视图(缓存):
  返回 {"authenticated": 缓存["scope"] != 空, "listing": 缓存["listing"]}

# 重定域：换作用域时丢弃清单与结算时刻，代次+1（上游 rescope 逐字，去掉异步取消）。
段落 重定域(缓存, 作用域):
  缓存["scope"] = 作用域
  缓存["listing"] = 空
  缓存["settledAt"] = 空
  缓存["inflight"] = 空
  缓存["failing"] = 假
  缓存["generation"] = 缓存["generation"] + 1

# 启动一次加载（单飞）：已在途则直接返回；否则代次+1，加载成功后写清单+结算时刻+清失败标记，
#   失败则保留上次清单、写结算时刻、置失败标记，且只在失败连首次告警。
段落 启动(缓存, 设置, 凭据, 加载, 现在, 信息, 告警):
  如果 缓存["inflight"] != 空:
    返回
  缓存["generation"] = 缓存["generation"] + 1
  设 代 为 缓存["generation"]
  缓存["inflight"] = 真
  尝试:
    设 清单 为 加载(设置["url"], 凭据)
    如果 代 == 缓存["generation"]:
      缓存["listing"] = 清单
      缓存["settledAt"] = 现在()
      缓存["failing"] = 假
      信息(造加载消息(设置["url"], 清单))
  捕获 错误 为 e:
    如果 代 == 缓存["generation"]:
      如果 缓存["failing"] == 假:
        设 回退 为 (如果 缓存["listing"] == 空 则 "using the bundled catalog" 否则 "keeping the previous catalog")
        告警(造失败消息(设置["url"], e, 回退))
      缓存["settledAt"] = 现在()
      缓存["failing"] = 真
  缓存["inflight"] = 空

段落 造加载消息(地址, 清单):
  返回 "model listing from " + 地址 + " loaded " + 转字符串(列表长度(清单["条目"])) + " model(s), skipped " + 转字符串(清单["跳过"]) + " row(s)"

段落 造失败消息(地址, 错误, 回退):
  返回 "model listing from " + 地址 + " failed (" + 转字符串(错误) + "); " + 回退

# 视图：解析当前凭据的作用域；换域则丢弃；首次访问等待加载，超龄则后台刷新；均返回当前视图。
#   取凭据/加载/现在/信息/告警 均为注入能力函数（宿主面）。
段落 视图(缓存, 设置, 取凭据, 加载, 现在, 信息, 告警):
  设 凭据 为 取凭据(设置["url"])
  如果 缓存["closed"]:
    返回 当前视图(缓存)
  设 作用域 为 空
  如果 凭据 != 空:
    设 作用域 为 设置["url"] + "\n" + 凭据
  如果 作用域 != 缓存["scope"]:
    重定域(缓存, 作用域)
  如果 凭据 != 空:
    如果 缓存["settledAt"] == 空:
      启动(缓存, 设置, 凭据, 加载, 现在, 信息, 告警)
    否则如果 现在() - 缓存["settledAt"] >= 设置["maxAgeMs"]:
      启动(缓存, 设置, 凭据, 加载, 现在, 信息, 告警)
  返回 当前视图(缓存)

# 失效：保留作用域但丢弃清单与结算时刻，下次访问重新等待加载（上游 invalidate 逐字）。
段落 失效(缓存):
  重定域(缓存, 缓存["scope"])

# 释放：关闭缓存，后续访问不再加载、只返回当前视图（上游 dispose 逐字，去掉异步取消）。
段落 释放(缓存):
  缓存["closed"] = 真
  缓存["generation"] = 缓存["generation"] + 1

导出 默认列表超时_MS, 默认列表最大年龄_MS, 最大计时延迟_MS, 解析列表时序, 建模型列表缓存, 当前视图, 重定域, 启动, 视图, 失效, 释放
