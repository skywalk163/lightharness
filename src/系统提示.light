# 上游 PERSONA_SUFFIX_SECTION = 'deployment:persona-suffix'
设 部署角色后缀节名 为 "deployment:persona-suffix"

# 上游 TOOL_ORDER_REST = '<unlisted-tools>'
设 工具排序未列出标记 为 "<unlisted-tools>"

# 上游 SECTION_ORDERS（30+ 位置，HARNESS_IDENTITY=-1000 至 DEPLOYMENT_PERSONA_SUFFIX=10200）
设 节顺序常量表 为 {
