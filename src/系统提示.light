  "TOOL_PTY": 1700,
  "TOOL_WEB_SEARCH": 2000,
  "TOOL_WEB_FETCH": 2100,
  "TOOL_LSP": 2200,
  "TOOL_SESSION_QUERY": 2300,
  "TOOL_GOAL": 2400,
  "TOOL_CORDIS": 2500,
  "TOOL_WORKFLOW": 2600,
  "TOOL_RALPH": 2700,
  "TOOL_SUBAGENT": 2800,
  "TOOL_REPORT": 2900,
