# 上游 CONTEXT_ORDERS（SANDBOX_POLICY=110, APPROVAL_POLICY=115, SUBAGENT_DELEGATION=120）
设 上下文顺序常量表 为 {
  "SANDBOX_POLICY": 110,
  "APPROVAL_POLICY": 115,
  "SUBAGENT_DELEGATION": 120
}

# 变量名前缀扫描用（VARIABLE_NAME = /^[a-z][a-z0-9_]*$/，正则用手动谓词替代）
# 变量名合法字符集（小写字母 + 数字 + 下划线）
设 变量名合法字符集 为 "abcdefghijklmnopqrstuvwxyz0123456789_"

# =====================================================================
# §1 变量名/引用校验（任务 4）
# =====================================================================

# 是否为小写字母（a-z）
段落 是小写字母(字符):
  设 长 为 长(字符)
  如果 长 != 1:
    返回 假
  如果 字符 >= "a" 且 字符 <= "z":
    返回 真
  返回 假

# 是否为数字字符（0-9）
段落 是数字字符(字符):
  设 长 为 长(字符)
  如果 长 != 1:
    返回 假
  如果 字符 >= "0" 且 字符 <= "9":
    返回 真
  返回 假

# 字符是否在合法变量名字符集中（辅助）
段落 在变量名字符集(字符):
  返回 变量名合法字符集.包含(字符)

# 校验变量名（对齐上游 VARIABLE_NAME = /^[a-z][a-z0-9_]*$/）
#   首字符必须小写字母；其余必须小写字母/数字/下划线；非空
段落 校验变量名(名字):
  如果 是字符串(名字) == 假:
    返回 假
  设 长 为 长(名字)
  如果 长 == 0:
    返回 假
  如果 是小写字母(名字[0]) == 假:
    返回 假
  设 i 为 1
  当 i < 长:
    设 c 为 名字[i]
    如果 在变量名字符集(c) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

# 从文本中扫描 {{variable}} 引用列表（对齐 GROUP_AT = /^\{\{([^{}]*)\}\}/）
#   - 只在完整的 {{name}} 内匹配（内层无 { 或 }）
#   - 残缺的 {{ 无对应 }} 不匹配，不抛错（供 renderPrompt 走「未知保留原样」分支）
#   - 返回 {"名字": 名字, "起始": 起始索引, "结束": 结束索引} 的列表
段落 扫描变量引用(文本):
  设 结果 为 []
  设 文本长 为 长(文本)
  设 末 为 0
  当 末 < 文本长:
    设 开 为 文本.查找("{{", 末)
    如果 开 == -1:
      跳出
    设 内 为 文本.查找("}}", 开 + 2)
    如果 内 == -1:
      设 末 为 开 + 2
      继续
    设 内文 为 文本[开 + 2:内]
    设 内文长 为 长(内文)
    设 合法 为 真
    设 j 为 0
    当 j < 内文长:
      如果 内文[j] == "{" 或 内文[j] == "}":
        设 合法 为 假
        跳出
      设 j 为 j + 1
    如果 合法 == 真:
      结果.追加({"名字": 内文, "起始": 开, "结束": 内 + 2})
    设 末 为 内 + 2
  返回 结果

# =====================================================================
# §2 工具排序（任务 4）
# =====================================================================

# 上游 compareToolName：字典序比较工具名，返回 -1/0/1
段落 比较工具名字(名字甲, 名字乙):
  如果 名字甲 < 名字乙:
    返回 -1
  如果 名字甲 > 名字乙:
    返回 1
  返回 0

# 列表副本
段落 列表副本(源列表):
  设 结果 为 []
  遍历 x 之 源列表:
    结果.追加(x)
  返回 结果

# 移除指定索引元素
段落 移除第(源列表, 索引):
  设 结果 为 []
  设 i 为 0
  当 i < 长(源列表):
    如果 i != 索引:
      结果.追加(源列表[i])
    设 i 为 i + 1
  返回 结果

# 按比较器排序（选择排序，等价上游 compareToolName 稳定排序语义）
段落 排序按(源列表, 比较器):
  设 结果 为 []
  设 剩余 为 列表副本(源列表)
  当 长(剩余) > 0:
    设 最小索引 为 0
    设 k 为 1
    当 k < 长(剩余):
      如果 比较器(剩余[k], 剩余[最小索引]) < 0:
        设 最小索引 为 k
      设 k 为 k + 1
    结果.追加(剩余[最小索引])
    设 剩余 为 移除第(剩余, 最小索引)
  返回 结果

# 按工具名字典序比较（包装，供 排序按 使用）
段落 比较工具(甲, 乙):
  返回 比较工具名字(甲["name"], 乙["name"])

# 表包含（判断值是否在列表中，辅助）
段落 表包含(列表, 值):
  遍历 x 之 列表:
    如果 x == 值:
      返回 真
  返回 假

# 上游 validateToolOrder(toolOrder)
#   - 空（None）视为未配置，返回 空
#   - 重复名抛错；必须包含 <unlisted-tools> 位置
段落 校验工具排序(排序配置):
  如果 是空(排序配置) == 真:
    返回 空
  设 已见 为 {}
  遍历 名字 之 排序配置:
    如果 字典包含键(已见, 名字) == 真:
      抛出 新建 错误("工具排序：'" + 名字 + "' 出现多次 [DUPLICATE_TOOL_ORDER]")
    设 已见[名字] 为 真
  如果 字典包含键(已见, 工具排序未列出标记) == 假:
    抛出 新建 错误("工具排序：缺少 '<unlisted-tools>' 位置 [MISSING_REST]")
  返回 排序配置

# 上游 orderTools(tools, toolOrder, knownNames)
#   - 工具名不能是 <unlisted-tools>（保留名）
#   - 无 toolOrder：按 name 字典序排序
#   - 有 toolOrder：校验后按顺序排列，未列出工具在 REST 位置按字典序插入
段落 排序工具(工具表, 排序配置=空, 已知名字=空):
  遍历 t 之 工具表:
    如果 t["name"] == 工具排序未列出标记:
      抛出 新建 错误("工具排序：工具名 '" + 工具排序未列出标记 + "' 是保留名 [RESERVED_TOOL_NAME]")
  如果 排序配置 == 空:
    返回 排序按(工具表, 比较工具)
  校验工具排序(排序配置)
  如果 已知名字 == 空:
    设 已知名字 为 {}
    遍历 t 之 工具表:
      设 已知名字[t["name"]] 为 真
  遍历 名字 之 排序配置:
    如果 名字 != 工具排序未列出标记 且 字典包含键(已知名字, 名字) == 假:
      抛出 新建 错误("工具排序：列出了未注册的工具 '" + 名字 + "' [UNREGISTERED_TOOL]")
  设 已列 为 {}
  遍历 名字 之 排序配置:
    设 已列[名字] 为 真
  设 休息 为 []
  遍历 t 之 工具表:
    如果 字典包含键(已列, t["name"]) == 假:
      休息.追加(t)
  设 休息 为 排序按(休息, 比较工具)
  设 结果 为 []
  遍历 名字 之 排序配置:
    如果 名字 == 工具排序未列出标记:
      遍历 r 之 休息:
        结果.追加(r)
    否则:
      遍历 t 之 工具表:
        如果 t["name"] == 名字:
          结果.追加(t)
  返回 结果

# =====================================================================
# §3 变量插值渲染（任务 4）
# =====================================================================

# 渲染变量插值：{{name}} → 变量表[name]
#   - 无效变量名（不符合 VARIABLE_NAME）→ 抛错（malformed）
#   - 未知变量（名字合法但不在变量表）→ 保留原样（不抛错）
段落 插值(文本, 变量表):
  设 结果 为 ""
  设 文本长 为 长(文本)
  设 末 为 0
  当 末 < 文本长:
    设 开 为 文本.查找("{{", 末)
    如果 开 == -1:
      设 结果 为 结果 + 文本[末:]
      跳出
    设 内 为 文本.查找("}}", 开 + 2)
    如果 内 == -1:
      设 结果 为 结果 + 文本[末:]
      跳出
    设 名 为 文本[开 + 2:内]
    设 名长 为 长(名)
    设 合法 为 真
    设 j 为 0
    当 j < 名长:
      如果 名[j] == "{" 或 名[j] == "}":
        设 合法 为 假
        跳出
      设 j 为 j + 1
    如果 合法 == 假:
      抛出 新建 错误("提示：{{" + 名 + "}} 中变量引用格式错误 [MALFORMED_VARIABLE_REF]")
    如果 校验变量名(名) == 假:
      抛出 新建 错误("提示：变量名 '" + 名 + "' 不符合小写字母开头 + 小写字母数字下划线规则 [INVALID_VARIABLE_NAME]")
    如果 字典包含键(变量表, 名) == 假:
      设 结果 为 结果 + 文本[末:内 + 2]
      设 末 为 内 + 2
      继续
    设 值 为 变量表[名]
    如果 是空(值) == 真:
      设 结果 为 结果 + 文本[末:内 + 2]
      设 末 为 内 + 2
      继续
    如果 是字符串(值) == 假:
      设 值 为 转字符串(值)
    设 结果 为 结果 + 文本[末:开] + 值
    设 末 为 内 + 2
  返回 结果

# 渲染提示（对齐上游 renderPrompt(assembly)）
#   把组装结果的节文本按 {{variable}} 变量表插值，非空节用 \n\n 拼接
段落 渲染提示(组装结果):
  设 变量表 为 组装结果["变量表"]
  设 已渲染 为 []
  遍历 段 之 组装结果["节列表"]:
    设 文本 为 插值(段["文本"], 变量表)
    如果 长(文本) > 0:
      已渲染.追加(文本)
  设 结果 为 ""
  设 首次 为 真
  遍历 文本 之 已渲染:
    如果 首次 == 假:
      设 结果 为 结果 + "\n\n"
    设 结果 为 结果 + 文本
    设 首次 为 假
  返回 结果

# 渲染上下文快照（与 src/提示模板.light 保持一致的头部，供 组装系统提示 结果直用）
段落 渲染上下文快照(组装结果):
  设 变量表 为 组装结果["变量表"]
  设 文本们 为 []
  遍历 上下文 之 组装结果["上下文列表"]:
    设 文本 为 插值(上下文["文本"], 变量表)
    如果 长(文本) > 0:
      文本们.追加(文本)
  设 体 为 ""
  设 首次 为 真
  遍历 文本 之 文本们:
    如果 首次 == 假:
      设 体 为 体 + "\n\n"
    设 体 为 体 + 文本
    设 首次 为 假
  如果 长(体) == 0:
    返回 ""
  返回 "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\n" + 体

# =====================================================================
# §4 注册表构造 + 撤销函数（任务 3）
# =====================================================================

# 建系统提示注册表：初始化所有子表（节表/上下文表/工具提供者/变量表/组装监听器）
段落 建系统提示注册表:
  设 注册表 为 {}
  设 注册表["节值表"] 为 {}
  设 注册表["节顺序"] 为 []
  设 注册表["上下文值表"] 为 {}
  设 注册表["上下文顺序"] 为 []
  设 注册表["工具提供者"] 为 []
  设 注册表["变量表"] 为 {}
  设 注册表["组装监听器"] 为 []
  设 注册表["形态"] 为 "系统提示注册表"
  返回 注册表

# 从列表中删除某个元素（按值匹配，返回新列表）
段落 从列表删除(列表, 元素):
  设 结果 为 []
  遍历 x 之 列表:
    如果 x != 元素:
      结果.追加(x)
  返回 结果

# 撤销节注册（幂等：若表内已无该节则 no-op）
段落 撤销节(注册表, 名字):
  如果 字典包含键(注册表["节值表"], 名字) == 假:
    返回 假
  字典删除(注册表["节值表"], 名字)
  设 注册表["节顺序"] 为 从列表删除(注册表["节顺序"], 名字)
  返回 真

# 撤销上下文注册（幂等）
段落 撤销上下文(注册表, 名字):
  如果 字典包含键(注册表["上下文值表"], 名字) == 假:
    返回 假
  字典删除(注册表["上下文值表"], 名字)
  设 注册表["上下文顺序"] 为 从列表删除(注册表["上下文顺序"], 名字)
  返回 真

# 撤销工具提供者注册（幂等）
段落 撤销工具提供者(注册表, 提供者):
  设 注册表["工具提供者"] 为 从列表删除(注册表["工具提供者"], 提供者)
  返回 真

# 撤销变量注册（幂等）
段落 撤销变量(注册表, 名字):
  如果 字典包含键(注册表["变量表"], 名字) == 假:
    返回 假
  字典删除(注册表["变量表"], 名字)
  返回 真

# 撤销组装监听器注册（幂等）
段落 撤销组装监听器(注册表, 监听器):
  设 注册表["组装监听器"] 为 从列表删除(注册表["组装监听器"], 监听器)
  返回 真

# 注册节（对应上游 section(name, order, text, complete?)）
#   - 名字必须字符串；重复抛错
#   - 文本可字符串或函数（函数在 assemble 时求值）
#   - 返回 undo 引用：撤销节（调用形如 撤销节(注册表, 名字)）
段落 注册节(注册表, 名字, 顺序, 文本, 完整=假):
  如果 是字符串(名字) == 假:
    抛出 新建 错误("系统提示：节名必须为字符串 [INVALID_SECTION_NAME]")
  如果 字典包含键(注册表["节值表"], 名字) == 真:
    抛出 新建 错误("系统提示：节名重复 '" + 名字 + "' [DUPLICATE_SECTION]")
  设 节 为 {"名字": 名字, "顺序": 顺序, "文本": 文本, "完整": 完整}
  设 注册表["节值表"][名字] 为 节
  注册表["节顺序"].追加(名字)
  返回 撤销节

# 注册上下文（对应上游 context(name, order, text)）
段落 注册上下文(注册表, 名字, 顺序, 文本):
  如果 是字符串(名字) == 假:
    抛出 新建 错误("系统提示：上下文名必须为字符串 [INVALID_CONTEXT_NAME]")
  如果 字典包含键(注册表["上下文值表"], 名字) == 真:
    抛出 新建 错误("系统提示：上下文名重复 '" + 名字 + "' [DUPLICATE_CONTEXT]")
  设 上下文 为 {"名字": 名字, "顺序": 顺序, "文本": 文本}
  设 注册表["上下文值表"][名字] 为 上下文
  注册表["上下文顺序"].追加(名字)
  返回 撤销上下文

# 注册工具提供者（对应上游 tool(provider)）
#   提供者签名：() -> {"schemas": [...], "knownNames": [...] | 空}
段落 注册工具提供者(注册表, 提供者):
  注册表["工具提供者"].追加(提供者)
  返回 撤销工具提供者

# 注册变量（对应上游 variable(name, value)）
#   - 变量名必须合法（VARIABLE_NAME）
段落 注册变量(注册表, 名字, 值):
  如果 是字符串(名字) == 假 或 校验变量名(名字) == 假:
    抛出 新建 错误("系统提示：变量名 '" + 名字 + "' 非法 [INVALID_VARIABLE_NAME]")
  设 注册表["变量表"][名字] 为 值
  返回 撤销变量

# 注册组装监听器（对应上游 cordis 事件 system-prompt/assemble）
#   监听器签名：(组装结果, 组装上下文) -> 组装结果（可修改后返回）
段落 注册组装监听器(注册表, 监听器):
  注册表["组装监听器"].追加(监听器)
  返回 撤销组装监听器

# 取已注册节（未注册返回 空）
段落 取节(注册表, 名字):
  如果 字典包含键(注册表["节值表"], 名字):
    返回 注册表["节值表"][名字]
  返回 空

# 取已注册上下文（未注册返回 空）
段落 取上下文(注册表, 名字):
  如果 字典包含键(注册表["上下文值表"], 名字):
    返回 注册表["上下文值表"][名字]
  返回 空

# =====================================================================
# §5 排序 + 文本解析 + complete 处理 + 瀑布流（任务 3）
# =====================================================================

# 解析节的「文本」：静态字符串直接返回，函数形式调用后返回
段落 解析节文本(文本, 组装上下文):
  如果 是字符串(文本) == 真:
    返回 文本
  设 值 为 空
  尝试:
    设 值 为 文本(组装上下文)
  捕获 异常 为 e:
    尝试:
      设 值 为 文本()
    捕获 异常 为 e2:
      抛出 新建 错误("系统提示：节文本既非字符串也非可调用 [INVALID_SECTION_TEXT]")
  如果 是空(值) == 真:
    返回 ""
  如果 是字符串(值) == 假:
    设 值 为 转字符串(值)
  返回 值

# 解析上下文「文本」：与 解析节文本 语义等价
段落 解析上下文文本(文本, 组装上下文):
  返回 解析节文本(文本, 组装上下文)

# 节比较器（按顺序升序，同顺序按名字升序）
段落 比较节顺序(甲, 乙):
  设 甲序 为 甲["顺序"]
  设 乙序 为 乙["顺序"]
  如果 甲序 < 乙序:
    返回 -1
  如果 甲序 > 乙序:
    返回 1
  如果 甲["名字"] < 乙["名字"]:
    返回 -1
  如果 甲["名字"] > 乙["名字"]:
    返回 1
  返回 0

# 排序节：按「顺序」升序，同顺序按「名字」代码单元升序（对齐上游 sortSections）
段落 排序节(节列表):
  返回 排序按(节列表, 比较节顺序)

# 上下文比较器（与 比较节顺序 同规则）
段落 比较上下文顺序(甲, 乙):
  设 甲序 为 甲["顺序"]
  设 乙序 为 乙["顺序"]
  如果 甲序 < 乙序:
    返回 -1
  如果 甲序 > 乙序:
    返回 1
  如果 甲["名字"] < 乙["名字"]:
    返回 -1
  如果 甲["名字"] > 乙["名字"]:
    返回 1
  返回 0

# 排序上下文：与 排序节 同规则
段落 排序上下文(上下文列表):
  返回 排序按(上下文列表, 比较上下文顺序)

# 处理 complete 节（对齐上游 processCompleteSections）
#   - 0 个 complete：直接返回
#   - 1 个 complete：将其恢复为唯一节（其余节被移除）
#   - > 1 个 complete：抛错
段落 处理完整节(组装结果):
  设 节列表 为 组装结果["节列表"]
  设 complete数 为 0
  遍历 节 之 节列表:
    如果 节["完整"] == 真:
      设 complete数 为 complete数 + 1
  如果 complete数 == 0:
    返回 组装结果
  如果 complete数 > 1:
    抛出 新建 错误("系统提示：发现 " + 转字符串(complete数) + " 个 complete 节，仅允许 0 或 1 [MULTIPLE_COMPLETE_SECTIONS]")
  设 完整节 为 空
  遍历 节 之 节列表:
    如果 节["完整"] == 真:
      设 完整节 为 节
      跳出
  设 新节列表 为 []
  新节列表.追加(完整节)
  设 组装结果["节列表"] 为 新节列表
  返回 组装结果

# 组装系统提示（对应上游 assemble(context)）
#   - 收集所有节→排序→解析文本
#   - 收集所有上下文→排序→解析文本
#   - 收集所有工具→应用排序（toolOrder 从组装上下文或注册表取）
#   - 收集所有变量
#   - complete 节处理
#   - 瀑布流（组装监听器依次调用，可修改）
段落 组装系统提示(注册表, 组装上下文=空):
  如果 组装上下文 == 空:
    设 组装上下文 为 {"作用域": 空, "信号": 空, "工具排序": 空}
  设 装配 为 {"节列表": [], "上下文列表": [], "工具列表": [], "变量表": {}, "作用域": 空}

  # §5.1 收集并解析节
  设 节原料 为 []
  遍历 名字 之 注册表["节顺序"]:
    节原料.追加(注册表["节值表"][名字])
  设 节原料 为 排序节(节原料)
  遍历 节 之 节原料:
    设 文本 为 解析节文本(节["文本"], 组装上下文)
    装配["节列表"].追加({"名字": 节["名字"], "顺序": 节["顺序"], "文本": 文本, "完整": 节["完整"]})

  # §5.2 收集并解析上下文
  设 上下文原料 为 []
  遍历 名字 之 注册表["上下文顺序"]:
    上下文原料.追加(注册表["上下文值表"][名字])
  设 上下文原料 为 排序上下文(上下文原料)
  遍历 上下文 之 上下文原料:
    设 文本 为 解析上下文文本(上下文["文本"], 组装上下文)
    装配["上下文列表"].追加({"名字": 上下文["名字"], "顺序": 上下文["顺序"], "文本": 文本})

  # §5.3 收集工具（提供者依次调用，聚合 schemas + knownNames）
  设 工具列表 为 []
  设 已知名 为 {}
  遍历 提供者 之 注册表["工具提供者"]:
    设 结果 为 空
    尝试:
      设 结果 为 提供者(组装上下文)
    捕获 异常 为 e:
      尝试:
        设 结果 为 提供者()
      捕获 异常 为 e2:
        继续
    如果 是空(结果) == 真:
      继续
    设 schemas 为 []
    如果 字典包含键(结果, "schemas") == 真:
      设 schemas 为 结果["schemas"]
    遍历 s 之 schemas:
      工具列表.追加(s)
    如果 字典包含键(结果, "knownNames") == 真:
      遍历 n 之 结果["knownNames"]:
        设 已知名[n] 为 真

  # §5.4 应用工具排序（组装上下文.工具排序 或 注册表.工具排序）
  设 排序配置 为 空
  如果 字典包含键(组装上下文, "工具排序") == 真:
    设 排序配置 为 组装上下文["工具排序"]
  如果 排序配置 == 空 且 字典包含键(注册表, "工具排序") == 真:
    设 排序配置 为 注册表["工具排序"]
  装配["工具列表"] 为 排序工具(工具列表, 排序配置, 已知名)

  # §5.5 收集变量（浅拷贝注册表.变量表）
  设 变量表 为 {}
  遍历 键 之 注册表["变量表"]:
    设 变量表[键] 为 注册表["变量表"][键]
  装配["变量表"] 为 变量表

  # §5.6 作用域占位（组装上下文.作用域）
  如果 字典包含键(组装上下文, "作用域") == 真:
    装配["作用域"] 为 组装上下文["作用域"]

  # §5.7 complete 节处理
  装配 为 处理完整节(装配)

  # §5.8 瀑布流（组装监听器依次调用）
  遍历 监听器 之 注册表["组装监听器"]:
    尝试:
      装配 为 监听器(装配, 组装上下文)
    捕获 异常 为 e:
      尝试:
        装配 为 监听器(装配)
      捕获 异常 为 e2:
        抛出 新建 错误("系统提示：组装监听器调用失败 [LISTENER_ERROR]")
    如果 是空(装配) == 真:
      抛出 新建 错误("系统提示：组装监听器返回空 [LISTENER_NULL]")

  返回 装配

