# 上游 CONTEXT_ORDERS（SANDBOX_POLICY=110, APPROVAL_POLICY=115, SUBAGENT_DELEGATION=120）
设 上下文顺序常量表 为 {
  "SANDBOX_POLICY": 110,
  "APPROVAL_POLICY": 115,
  "SUBAGENT_DELEGATION": 120
}

# 变量名前缀扫描用（VARIABLE_NAME = /^[a-z][a-z0-9_]*$/，正则用手动谓词替代）
# 变量名合法字符集（小写字母 + 数字 + 下划线）
设 变量名合法字符集 为 "abcdefghijklmnopqrstuvwxyz0123456789_"

# =====================================================================
# §1 变量名/引用校验（任务 4）
# =====================================================================

# 是否为小写字母（a-z）
段落 是小写字母(字符):
  设 长 为 长(字符)
  如果 长 != 1:
    返回 假
  如果 字符 >= "a" 且 字符 <= "z":
    返回 真
  返回 假

# 是否为数字字符（0-9）
段落 是数字字符(字符):
  设 长 为 长(字符)
  如果 长 != 1:
    返回 假
  如果 字符 >= "0" 且 字符 <= "9":
    返回 真
  返回 假

# 字符是否在合法变量名字符集中（辅助）
段落 在变量名字符集(字符):
  返回 变量名合法字符集.包含(字符)

# 校验变量名（对齐上游 VARIABLE_NAME = /^[a-z][a-z0-9_]*$/）
#   首字符必须小写字母；其余必须小写字母/数字/下划线；非空
段落 校验变量名(名字):
  如果 是字符串(名字) == 假:
    返回 假
  设 长 为 长(名字)
  如果 长 == 0:
    返回 假
  如果 是小写字母(名字[0]) == 假:
    返回 假
  设 i 为 1
  当 i < 长:
    设 c 为 名字[i]
    如果 在变量名字符集(c) == 假:
      返回 假
    设 i 为 i + 1
  返回 真

# 从文本中扫描 {{variable}} 引用列表（对齐 GROUP_AT = /^\{\{([^{}]*)\}\}/）
#   - R100 路 B：恢复上游双花括号定界。9/25 批次因「字面量 {{ 折叠为 {」的编译器
#     bug 降级成单花括号扫描；该折叠根因已在编译器修复
#     （parser_expr._lp_normalize_braces_plain），本函数恢复与上游正则逐字对齐的
#     {{…}} 语义，定界符仍用 码转字符 构造（防源码期字面量参与折叠）。
#   - 只在完整的 {{name}} 内匹配（内层无 { 或 }）
#   - 残缺的 {{ 无对应 }} 不匹配，不抛错（供 渲染提示 走「未知保留原样」分支）
#   - 返回 {"名字": 名字, "起始": 起始索引, "结束": 结束索引} 的列表
段落 扫描变量引用(文本):
  设 结果 为 []
  设 左花 为 码转字符(123)
  设 右花 为 码转字符(125)
  设 双左 为 左花 + 左花
  设 双右 为 右花 + 右花
  设 文本长 为 长(文本)
  设 末 为 0
  当 末 < 文本长:
    设 开 为 文本.查找(双左, 末)
    如果 开 == -1:
      跳出
    设 内 为 文本.查找(双右, 开 + 2)
    如果 内 == -1:
      设 末 为 开 + 1
      继续
    设 内文 为 文本[开 + 2:内]
    设 内文长 为 长(内文)
    设 合法 为 真
    设 j 为 0
    当 j < 内文长:
      如果 内文[j] == 左花 或 内文[j] == 右花:
        设 合法 为 假
        跳出
      设 j 为 j + 1
    如果 合法 == 真:
      结果.追加({"名字": 内文, "起始": 开, "结束": 内 + 2})
    设 末 为 开 + 1
  返回 结果

# =====================================================================
# §2 工具排序（任务 4）
# =====================================================================

# 上游 compareToolName：字典序比较工具名，返回 -1/0/1
段落 比较工具名字(名字甲, 名字乙):
  如果 名字甲 < 名字乙:
    返回 -1
  如果 名字甲 > 名字乙:
    返回 1
  返回 0

# 列表副本
段落 列表副本(源列表):
  设 结果 为 []
  遍历 x 之 源列表:
    结果.追加(x)
  返回 结果

# 移除指定索引元素
段落 移除第(源列表, 索引):
  设 结果 为 []
  设 i 为 0
  当 i < 长(源列表):
    如果 i != 索引:
      结果.追加(源列表[i])
    设 i 为 i + 1
  返回 结果

# 按比较器排序（选择排序，等价上游 compareToolName 稳定排序语义）
段落 排序按(源列表, 比较器):
  设 结果 为 []
  设 剩余 为 列表副本(源列表)
  当 长(剩余) > 0:
    设 最小索引 为 0
    设 k 为 1
    当 k < 长(剩余):
      如果 比较器(剩余[k], 剩余[最小索引]) < 0:
        设 最小索引 为 k
      设 k 为 k + 1
    结果.追加(剩余[最小索引])
    设 剩余 为 移除第(剩余, 最小索引)
  返回 结果

# 按工具名字典序比较（包装，供 排序按 使用）
段落 比较工具(甲, 乙):
  返回 比较工具名字(甲["name"], 乙["name"])

# 表包含（判断值是否在列表中，辅助）
段落 表包含(列表, 值):
  遍历 x 之 列表:
    如果 x == 值:
      返回 真
  返回 假

# 上游 validateToolOrder(toolOrder)
#   - 空（None）视为未配置，返回 空
#   - 重复名抛错；必须包含 <unlisted-tools> 位置
段落 校验工具排序(排序配置):
  如果 是空(排序配置) == 真:
    返回 空
  设 已见 为 {}
  遍历 名字 之 排序配置:
    如果 字典包含键(已见, 名字) == 真:
      抛出 新建 错误("工具排序：'" + 名字 + "' 出现多次 [DUPLICATE_TOOL_ORDER]")
    设 已见[名字] 为 真
  如果 字典包含键(已见, 工具排序未列出标记) == 假:
    抛出 新建 错误("工具排序：缺少 '<unlisted-tools>' 位置 [MISSING_REST]")
  返回 排序配置

# 上游 orderTools(tools, toolOrder, knownNames)
#   - 工具名不能是 <unlisted-tools>（保留名）
#   - 无 toolOrder：按 name 字典序排序
#   - 有 toolOrder：校验后按顺序排列，未列出工具在 REST 位置按字典序插入
段落 排序工具(工具表, 排序配置=空, 已知名字=空):
  遍历 t 之 工具表:
    如果 t["name"] == 工具排序未列出标记:
      抛出 新建 错误("工具排序：工具名 '" + 工具排序未列出标记 + "' 是保留名 [RESERVED_TOOL_NAME]")
  如果 排序配置 == 空:
    返回 排序按(工具表, 比较工具)
  校验工具排序(排序配置)
  如果 已知名字 == 空:
    设 已知名字 为 {}
    遍历 t 之 工具表:
      设 已知名字[t["name"]] 为 真
  遍历 名字 之 排序配置:
    如果 名字 != 工具排序未列出标记 且 字典包含键(已知名字, 名字) == 假:
      抛出 新建 错误("工具排序：列出了未注册的工具 '" + 名字 + "' [UNREGISTERED_TOOL]")
  设 已列 为 {}
  遍历 名字 之 排序配置:
    设 已列[名字] 为 真
  设 休息 为 []
  遍历 t 之 工具表:
    如果 字典包含键(已列, t["name"]) == 假:
      休息.追加(t)
  设 休息 为 排序按(休息, 比较工具)
  设 结果 为 []
  遍历 名字 之 排序配置:
    如果 名字 == 工具排序未列出标记:
      遍历 r 之 休息:
        结果.追加(r)
    否则:
      遍历 t 之 工具表:
        如果 t["name"] == 名字:
          结果.追加(t)
  返回 结果

# =====================================================================
# §3 变量插值渲染（任务 4）
# =====================================================================

# 渲染变量插值：{{name}} → 变量表[name]
#   - R100 路 B：恢复上游 {{var}} 双花括号定界（编译器折叠根因已修复）。
#   - 无效变量名（内嵌花括号）→ 抛错（malformed）
#   - 未知变量（名字合法但不在变量表）/ 空值 → 保留原样（{{var}} 原文照抄）
段落 插值(文本, 变量表):
  设 结果 为 ""
  设 左花 为 码转字符(123)
  设 右花 为 码转字符(125)
  设 双左 为 左花 + 左花
  设 双右 为 右花 + 右花
  设 文本长 为 长(文本)
  设 末 为 0
  当 末 < 文本长:
    设 开 为 文本.查找(双左, 末)
    如果 开 == -1:
      设 结果 为 结果 + 文本[末:]
      跳出
    设 内 为 文本.查找(双右, 开 + 2)
    如果 内 == -1:
      设 结果 为 结果 + 文本[末:]
      跳出
    设 名 为 文本[开 + 2:内]
    设 名长 为 长(名)
    设 合法 为 真
    设 j 为 0
    当 j < 名长:
      如果 名[j] == 左花 或 名[j] == 右花:
        设 合法 为 假
        跳出
      设 j 为 j + 1
    如果 合法 == 假:
      抛出 新建 错误("提示：{{" + 名 + "}} 中变量引用格式错误 [MALFORMED_VARIABLE_REF]")
    如果 校验变量名(名) == 假:
      抛出 新建 错误("提示：变量名 '" + 名 + "' 不符合小写字母开头 + 小写字母数字下划线规则 [INVALID_VARIABLE_NAME]")
    如果 字典包含键(变量表, 名) == 假:
      设 结果 为 结果 + 文本[末:开] + 双左 + 名 + 双右
      设 末 为 内 + 2
      继续
    设 值 为 变量表[名]
    如果 是空(值) == 真:
      设 结果 为 结果 + 文本[末:开] + 双左 + 名 + 双右
      设 末 为 内 + 2
      继续
    如果 是字符串(值) == 假:
      设 值 为 转字符串(值)
    设 结果 为 结果 + 文本[末:开] + 值
    设 末 为 内 + 2
  返回 结果

# 渲染提示（对齐上游 renderPrompt(assembly)）
#   把组装结果的节文本按 {{variable}} 变量表插值，非空节用 \n\n 拼接
段落 渲染提示(组装结果):
  设 变量表 为 组装结果["变量表"]
  设 已渲染 为 []
  遍历 段 之 组装结果["节列表"]:
    设 文本 为 插值(段["文本"], 变量表)
    如果 长(文本) > 0:
      已渲染.追加(文本)
  设 结果 为 ""
  设 首次 为 真
  遍历 文本 之 已渲染:
    如果 首次 == 假:
      设 结果 为 结果 + "\n\n"
    设 结果 为 结果 + 文本
    设 首次 为 假
  返回 结果

# 渲染上下文快照（与 src/提示模板.light 保持一致的头部，供 组装系统提示 结果直用）
段落 渲染上下文快照(组装结果):
  设 变量表 为 组装结果["变量表"]
  设 文本们 为 []
  遍历 上下文 之 组装结果["上下文列表"]:
    设 文本 为 插值(上下文["文本"], 变量表)
    如果 长(文本) > 0:
      文本们.追加(文本)
  设 体 为 ""
  设 首次 为 真
  遍历 文本 之 文本们:
    如果 首次 == 假:
      设 体 为 体 + "\n\n"
    设 体 为 体 + 文本
    设 首次 为 假
  如果 长(体) == 0:
    返回 ""
  返回 "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\n" + 体

# =====================================================================
# §4 注册表构造 + 撤销函数（任务 3）
# =====================================================================

# 建系统提示注册表：初始化所有子表（节表/上下文表/工具提供者/变量表/组装监听器）
段落 建系统提示注册表:
  设 注册表 为 {}
  设 注册表["节值表"] 为 {}
  设 注册表["节顺序"] 为 []
  设 注册表["上下文值表"] 为 {}
  设 注册表["上下文顺序"] 为 []
  设 注册表["工具提供者"] 为 []
  设 注册表["变量表"] 为 {}
  设 注册表["组装监听器"] 为 []
  设 注册表["形态"] 为 "系统提示注册表"
  返回 注册表

# 从列表中删除某个元素（按值匹配，返回新列表）
段落 从列表删除(列表, 元素):
  设 结果 为 []
  遍历 x 之 列表:
    如果 x != 元素:
      结果.追加(x)
  返回 结果

# 撤销节注册（幂等：若表内已无该节则 no-op）
段落 撤销节(注册表, 名字):
  如果 字典包含键(注册表["节值表"], 名字) == 假:
    返回 假
  字典删除(注册表["节值表"], 名字)
  设 注册表["节顺序"] 为 从列表删除(注册表["节顺序"], 名字)
  返回 真

# 撤销上下文注册（幂等）
段落 撤销上下文(注册表, 名字):
  如果 字典包含键(注册表["上下文值表"], 名字) == 假:
    返回 假
  字典删除(注册表["上下文值表"], 名字)
  设 注册表["上下文顺序"] 为 从列表删除(注册表["上下文顺序"], 名字)
  返回 真

# 撤销工具提供者注册（幂等）
段落 撤销工具提供者(注册表, 提供者):
  设 注册表["工具提供者"] 为 从列表删除(注册表["工具提供者"], 提供者)
  返回 真

# 撤销变量注册（幂等）
段落 撤销变量(注册表, 名字):
  如果 字典包含键(注册表["变量表"], 名字) == 假:
    返回 假
  字典删除(注册表["变量表"], 名字)
  返回 真

# 撤销组装监听器注册（幂等）
段落 撤销组装监听器(注册表, 监听器):
  设 注册表["组装监听器"] 为 从列表删除(注册表["组装监听器"], 监听器)
  返回 真

# 注册节（对应上游 section(name, order, text, complete?)）
#   - 名字必须字符串；重复抛错
#   - 文本可字符串或函数（函数在 assemble 时求值）
#   - 返回 undo 引用：撤销节（调用形如 撤销节(注册表, 名字)）
段落 注册节(注册表, 名字, 顺序, 文本, 完整=假):
  如果 是字符串(名字) == 假:
    抛出 新建 错误("系统提示：节名必须为字符串 [INVALID_SECTION_NAME]")
  如果 字典包含键(注册表["节值表"], 名字) == 真:
    抛出 新建 错误("系统提示：节名重复 '" + 名字 + "' [DUPLICATE_SECTION]")
  设 节 为 {"名字": 名字, "顺序": 顺序, "文本": 文本, "完整": 完整}
  设 注册表["节值表"][名字] 为 节
  注册表["节顺序"].追加(名字)
  返回 撤销节

# 注册上下文（对应上游 context(name, order, text)）
段落 注册上下文(注册表, 名字, 顺序, 文本):
  如果 是字符串(名字) == 假:
    抛出 新建 错误("系统提示：上下文名必须为字符串 [INVALID_CONTEXT_NAME]")
  如果 字典包含键(注册表["上下文值表"], 名字) == 真:
    抛出 新建 错误("系统提示：上下文名重复 '" + 名字 + "' [DUPLICATE_CONTEXT]")
  设 上下文 为 {"名字": 名字, "顺序": 顺序, "文本": 文本}
  设 注册表["上下文值表"][名字] 为 上下文
  注册表["上下文顺序"].追加(名字)
  返回 撤销上下文

# 注册工具提供者（对应上游 tool(provider)）
#   提供者签名：() -> {"schemas": [...], "knownNames": [...] | 空}
段落 注册工具提供者(注册表, 提供者):
  注册表["工具提供者"].追加(提供者)
  返回 撤销工具提供者

# 注册变量（对应上游 variable(name, value)）
#   - 变量名必须合法（VARIABLE_NAME）
段落 注册变量(注册表, 名字, 值):
  如果 是字符串(名字) == 假 或 校验变量名(名字) == 假:
    抛出 新建 错误("系统提示：变量名 '" + 名字 + "' 非法 [INVALID_VARIABLE_NAME]")
  设 注册表["变量表"][名字] 为 值
  返回 撤销变量

# 注册组装监听器（对应上游 cordis 事件 system-prompt/assemble）
#   监听器签名：(组装结果, 组装上下文) -> 组装结果（可修改后返回）
段落 注册组装监听器(注册表, 监听器):
  注册表["组装监听器"].追加(监听器)
  返回 撤销组装监听器

# 取已注册节（未注册返回 空）
段落 取节(注册表, 名字):
  如果 字典包含键(注册表["节值表"], 名字):
    返回 注册表["节值表"][名字]
  返回 空

# 取已注册上下文（未注册返回 空）
段落 取上下文(注册表, 名字):
  如果 字典包含键(注册表["上下文值表"], 名字):
    返回 注册表["上下文值表"][名字]
  返回 空

# =====================================================================
# §5 排序 + 文本解析 + complete 处理 + 瀑布流（任务 3）
# =====================================================================

# 解析节的「文本」：静态字符串直接返回，函数形式调用后返回
段落 解析节文本(文本, 组装上下文):
  如果 是字符串(文本) == 真:
    返回 文本
  设 值 为 空
  尝试:
    设 值 为 文本(组装上下文)
  捕获 异常 为 e:
    尝试:
      设 值 为 文本()
    捕获 异常 为 e2:
      抛出 新建 错误("系统提示：节文本既非字符串也非可调用 [INVALID_SECTION_TEXT]")
  如果 是空(值) == 真:
    返回 ""
  如果 是字符串(值) == 假:
    设 值 为 转字符串(值)
  返回 值

# 解析上下文「文本」：与 解析节文本 语义等价
段落 解析上下文文本(文本, 组装上下文):
  返回 解析节文本(文本, 组装上下文)

# 节比较器（按顺序升序，同顺序按名字升序）
段落 比较节顺序(甲, 乙):
  设 甲序 为 甲["顺序"]
  设 乙序 为 乙["顺序"]
  如果 甲序 < 乙序:
    返回 -1
  如果 甲序 > 乙序:
    返回 1
  如果 甲["名字"] < 乙["名字"]:
    返回 -1
  如果 甲["名字"] > 乙["名字"]:
    返回 1
  返回 0

# 排序节：按「顺序」升序，同顺序按「名字」代码单元升序（对齐上游 sortSections）
段落 排序节(节列表):
  返回 排序按(节列表, 比较节顺序)

# 上下文比较器（与 比较节顺序 同规则）
段落 比较上下文顺序(甲, 乙):
  设 甲序 为 甲["顺序"]
  设 乙序 为 乙["顺序"]
  如果 甲序 < 乙序:
    返回 -1
  如果 甲序 > 乙序:
    返回 1
  如果 甲["名字"] < 乙["名字"]:
    返回 -1
  如果 甲["名字"] > 乙["名字"]:
    返回 1
  返回 0

# 排序上下文：与 排序节 同规则
段落 排序上下文(上下文列表):
  返回 排序按(上下文列表, 比较上下文顺序)

# 处理 complete 节（对齐上游 processCompleteSections）
#   - 0 个 complete：直接返回
#   - 1 个 complete：将其恢复为唯一节（其余节被移除）
#   - > 1 个 complete：抛错
段落 处理完整节(组装结果):
  设 节列表 为 组装结果["节列表"]
  设 complete数 为 0
  遍历 节 之 节列表:
    如果 节["完整"] == 真:
      设 complete数 为 complete数 + 1
  如果 complete数 == 0:
    返回 组装结果
  如果 complete数 > 1:
    抛出 新建 错误("系统提示：发现 " + 转字符串(complete数) + " 个 complete 节，仅允许 0 或 1 [MULTIPLE_COMPLETE_SECTIONS]")
  设 完整节 为 空
  遍历 节 之 节列表:
    如果 节["完整"] == 真:
      设 完整节 为 节
      跳出
  设 新节列表 为 []
  新节列表.追加(完整节)
  设 组装结果["节列表"] 为 新节列表
  返回 组装结果

# 组装系统提示（对应上游 assemble(context)）
#   - 收集所有节→排序→解析文本
#   - 收集所有上下文→排序→解析文本
#   - 收集所有工具→应用排序（toolOrder 从组装上下文或注册表取）
#   - 收集所有变量
#   - complete 节处理
#   - 瀑布流（组装监听器依次调用，可修改）
段落 组装系统提示(注册表, 组装上下文=空):
  如果 组装上下文 == 空:
    设 组装上下文 为 {"作用域": 空, "信号": 空, "工具排序": 空}
  设 装配 为 {"节列表": [], "上下文列表": [], "工具列表": [], "变量表": {}, "作用域": 空}

  # §5.1 收集并解析节
  设 节原料 为 []
  遍历 名字 之 注册表["节顺序"]:
    节原料.追加(注册表["节值表"][名字])
  设 节原料 为 排序节(节原料)
  遍历 节 之 节原料:
    设 文本 为 解析节文本(节["文本"], 组装上下文)
    装配["节列表"].追加({"名字": 节["名字"], "顺序": 节["顺序"], "文本": 文本, "完整": 节["完整"]})

  # §5.2 收集并解析上下文
  设 上下文原料 为 []
  遍历 名字 之 注册表["上下文顺序"]:
    上下文原料.追加(注册表["上下文值表"][名字])
  设 上下文原料 为 排序上下文(上下文原料)
  遍历 上下文 之 上下文原料:
    设 文本 为 解析上下文文本(上下文["文本"], 组装上下文)
    装配["上下文列表"].追加({"名字": 上下文["名字"], "顺序": 上下文["顺序"], "文本": 文本})

  # §5.3 收集工具（提供者依次调用，聚合 schemas + knownNames）
  设 工具列表 为 []
  设 已知名 为 {}
  遍历 提供者 之 注册表["工具提供者"]:
    设 结果 为 空
    尝试:
      设 结果 为 提供者(组装上下文)
    捕获 异常 为 e:
      尝试:
        设 结果 为 提供者()
      捕获 异常 为 e2:
        继续
    如果 是空(结果) == 真:
      继续
    设 schemas 为 []
    如果 字典包含键(结果, "schemas") == 真:
      设 schemas 为 结果["schemas"]
    遍历 s 之 schemas:
      工具列表.追加(s)
    如果 字典包含键(结果, "knownNames") == 真:
      遍历 n 之 结果["knownNames"]:
        设 已知名[n] 为 真

  # §5.4 应用工具排序（组装上下文.工具排序 或 注册表.工具排序）
  设 排序配置 为 空
  如果 字典包含键(组装上下文, "工具排序") == 真:
    设 排序配置 为 组装上下文["工具排序"]
  如果 排序配置 == 空 且 字典包含键(注册表, "工具排序") == 真:
    设 排序配置 为 注册表["工具排序"]
  装配["工具列表"] 为 排序工具(工具列表, 排序配置, 已知名)

  # §5.5 收集变量（浅拷贝注册表.变量表）
  设 变量表 为 {}
  遍历 键 之 注册表["变量表"]:
    设 变量表[键] 为 注册表["变量表"][键]
  装配["变量表"] 为 变量表

  # §5.6 作用域占位（组装上下文.作用域）
  如果 字典包含键(组装上下文, "作用域") == 真:
    装配["作用域"] 为 组装上下文["作用域"]

  # §5.7 complete 节处理
  装配 为 处理完整节(装配)

  # §5.8 瀑布流（组装监听器依次调用）
  遍历 监听器 之 注册表["组装监听器"]:
    尝试:
      装配 为 监听器(装配, 组装上下文)
    捕获 异常 为 e:
      尝试:
        装配 为 监听器(装配)
      捕获 异常 为 e2:
        抛出 新建 错误("系统提示：组装监听器调用失败 [LISTENER_ERROR]")
    如果 是空(装配) == 真:
      抛出 新建 错误("系统提示：组装监听器返回空 [LISTENER_NULL]")

  返回 装配

# =====================================================================
# §6 T-0469：生产系统提示节（把上面的组装框架真正接进 Web/CLI 主路径）
#
# 背景（任务卡实测）：生产会话的系统提示只有三条工具实参契约，模型缺
#   身份 / 规划策略 / 工具选择 / 文件引用与路径规范 / 待办与目标使用引导，
#   复杂任务全靠 bash 试探（T-0461 交接文档里的工具摩擦即由此而来）。
#
# 与 DSH 的对照：DSH 的系统提示是 30+ 顺序槽位的组装系统，各插件各自贡献
#   section（HARNESS_IDENTITY / PLAN_POLICY / FILE_REFERENCE / TOOL_BASH /
#   TOOL_READ / TOOL_WRITE / TOOL_EDIT / TOOL_GLOB / TOOL_GREP / TOOL_JOBS /
#   TOOL_WEB_SEARCH / TOOL_WEB_FETCH / TOOL_GOAL / TOOL_SUBAGENT / present）。
#   本模块把同一批槽位落成本仓中文工具面的节，并复用本文件的 注册节/组装系统提示/渲染提示。
#
# 三条设计约束（勿改）：
#   1) 槽位顺序一律取 节顺序常量表（与上游 SECTION_ORDERS 同值），不另立数字；
#      槽位表里没有的节用相邻槽位 + 偏移，并在下方注理由。
#   2) 工具按在场性渲染：工具名表里没有的工具不出指导段（brainstorm 这类只读预设
#      不该看到 bash/写类指导）。工具名表为空 → 用 标准工具面() 常量（standard 口径）。
#   3) 长度受控（关联 T-0466）：生产提示总字符数不超过 生产提示上限()，
#      超了在尾部截断并留可见标记——绝不把上下文撑爆。
#
# T-0487 接线（六段进生产提示，本节是 系统提示.light 的唯一 owner）：
#   上面 T-0469 那批节之外再挂六个纯文本模块的产物 —— 技能清单 / 运行环境 /
#   权限与审批 / MCP 资源服务器 / 工具纪律 / 协作与长任务。文案一律由各模块
#   自己的段落产出（只调函数，绝不在这里复制第二份），本文件只负责「挂不挂 + 挂哪」。
#   上下文（可选字典）认的键：技能表 / 服务器名表 / 权限预设 / 审批策略 / 环境信息；
#   缺键或模块给空串 → 不注册该节（顺序表不留空洞）。
#   槽位（既有常量 + 偏移，理由见每个注册处）：
#     harness:environment = HARNESS_IDENTITY + 50   plan:discipline = PLAN_POLICY + 50
#     harness:permission  = PLAN_POLICY + 250       skill:catalog   = FILE_REFERENCE + 50
#     mcp:resources       = TOOL_WEB_SEARCH + 50    plan:collab     = TOOL_SUBAGENT - 50
# =====================================================================

# 新增节的字符预算（≈6k tokens 量级：中文 1 字 ≈ 1 token）
#   T-0487：4000 → 6000。六个新节（技能/环境/权限/MCP/纪律/协作）全在场时
#   原文实测 ≈3100 字（旧原文 2047 + 六节约 1040），4000 会逼近上限、再多一条
#   技能/多一个 MCP 服务器就被整段截掉；6000 留得住全上下文与 AGENTS.md 段的余量。
设 生产提示字符上限 为 6000

# 截断标记（判据会断言它只在真的超预算时出现）
设 生产提示截断标记 为 "\n[提示已按预算截断]"

# standard 预设下真实在册的模型可见工具面（与 核心工具 的注册名 + 线名对齐）。
#   只用于「无条件工具名表」时的缺省口径；真实装配可传入自己的名单。
#   T-0487：跟 T-0477 的白名单收口（168 → 22）逐项对齐 组装注册表("standard").名单()；
#     旧常量只有 15 个，`作业状态查询` / `技能列表` / ask-user 族（提问提交/回答提交/
#     待答列出/答案取出）/ `收集子任务结果` / 结构化编辑与 todo_write 都缺，导致
#     「工具选择段」的在場判断与真实工具面自相矛盾。
设 标准工具面 为 [
  "bash", "读文件", "写文件", "搜索文件", "编辑文件",
  "job_start", "job_output", "job_kill", "skill",
  "web_search", "web_fetch", "present",
  "todo_write", "目标", "提问提交", "回答提交", "待答列出", "答案取出",
  "派发子任务", "收集子任务结果", "作业状态查询", "技能列表"
]

段落 生产提示上限():
  返回 生产提示字符上限

# 标准工具面（返回副本，调用方改返回值不污染常量）
段落 取标准工具面():
  返回 列表副本(标准工具面)

# 工具在场：候选名字表里任一在 工具名表 中即算在场（注册名与线名双口径）
段落 工具在场(工具名表, 候选表):
  遍历 候选 之 候选表:
    如果 表包含(工具名表, 候选) == 真:
      返回 真
  返回 假

# ---- §6.1 各节文本（写成段落便于单测逐段取用）----

段落 身份段():
  返回 "你是 lightharness 的编码代理，在受限于项目根的工作目录里干活。\n- 路径与 cd 越界会被工具直接拒绝；换个写法重试同一件事只会浪费一步，改做法而不是改措辞。\n- 先读后改：改任何已有文件前，先用读文件看清当前内容；刚创建或本轮刚改过的文件不必再读。\n- 有对应工具就用工具，不要拼 shell 技巧（heredoc 写文件、手工编码转换、cd 绕守卫）去模拟工具能力。\n- 结论要可验证：说清改了什么、跑了什么、结果如何；没做到就直说没做到。"

段落 规划段():
  返回 "工作方式：先规划，再动手。\n- 多步任务（3 步以上或跨文件）先用待办工具（workflow__todo_write）列出步骤：一次一条祈使句，开始前就把清单写出来。\n- 做完一条立刻标 completed，不要批量补记；计划变了就显式改清单并说明为什么改，不要心里换方案而清单不动。\n- 单步、琐碎的任务跳过清单直接做。\n- 每轮收尾说清：已完成什么、还差什么、下一步做什么。"

段落 待办与目标段():
  返回 "待办与目标的用法：\n- 待办（workflow__todo_write）是「这一轮要做哪几步」，整表替换：每次发送完整列表（不是增量、不是逐项编辑）。\n- 同一时刻只保留一个 in_progress（确实并行推进时除外）；只要还有工作，至少一个任务应是 in_progress；全部做完才允许没有 in_progress。\n- 目标（workflow__goal）是「跨轮要达成的整件事」：一轮结束时整件目标已达成就调它 complete；仍有活就让它保持 active 交给下一轮；被外部条件卡住就写明卡点。\n- 旧名 todo_write / goal 仍作为兼容别名可调用（对应 workflow__todo_write / workflow__goal）；以工具定义里的 function.name 为准。"

段落 工具选择段(工具名表 = 空):
  # 工具感知：只推荐**在场**的工具。只读预设（brainstorm）不该被推荐去写文件/起作业，
  #   否则提示面与工具面自相矛盾（模型按提示去调一个不存在的工具，浪费一步）。
  设 在场 为 工具名表
  如果 是空(在场) == 真 或 type(在场) != list:
    设 在场 为 取标准工具面()
  设 行表 为 ["挑工具的顺序（能用专用工具就不要落到 bash）："]
  如果 工具在场(在场, ["读文件", "read_file"]) == 真:
    行表.追加("- 读文本文件 → 读文件（read_file）；大文件用 offset/limit 分段读，不要整文件灌进上下文。")
  如果 工具在场(在场, ["写文件", "write_file", "编辑文件", "edit_file"]) == 真:
    如果 工具在场(在场, ["编辑文件", "edit_file"]) == 真:
      行表.追加("- 新建或整体重写 → 写文件（write_file）；只改一处 → 编辑文件（edit_file）的命中替换，不要为改一行整文件重写。")
    否则:
      行表.追加("- 新建或整体重写 → 写文件（write_file）。")
  如果 工具在场(在场, ["搜索文件", "search_files"]) == 真:
    行表.追加("- 找文件 → 搜索文件（search_files）「模式=文件名」；找内容 → 「模式=内容」。")
  如果 工具在场(在场, ["bash"]) == 真:
    行表.追加("- 跑命令、跑测试、装依赖才用 bash（命令）；预计久跑的命令用 job_start 起后台作业。")
  如果 工具在场(在场, ["web_search", "web__search", "web_fetch", "web__fetch"]) == 真:
    行表.追加("- 要外部资料用 web__search / web__fetch，不要用 bash 拼 curl。")
  如果 工具在场(在场, ["待办添加", "todo_write", "workflow__todo_write"]) == 真:
    行表.追加("- 多步任务先落一份待办清单（workflow__todo_write），再开始动手。")
  设 结果 为 ""
  设 序号 为 0
  遍历 行 之 行表:
    如果 序号 > 0:
      设 结果 为 结果 + "\n"
    设 结果 为 结果 + 行
    设 序号 为 序号 + 1
  返回 结果

段落 文件引用段():
  返回 "路径与文件引用：\n- 路径先相对项目根书写（如 src/总入口.light），分隔符统一用 \"/\"，不要写反斜杠路径。\n- 用户用 @ 提到的路径是显式引用：相对路径从工作区根解析，绝对路径直接定位；以 \"/\" 结尾的表示目录——要看内容就先列目录，否则当作文件处理。\n- 没有真正读过的文件不要声称读过；改完的文件要能说清改在哪几行。\n- 引用别的文件或行号时写清路径，别只写“那个文件”。"

段落 bash指导段():
  返回 "bash：实参键是「命令」（不是 command）；一次调用只做一件事，别把多步操作塞进一条 && 链让自己看不清失败点。"

段落 读文件指导段():
  返回 "读文件（read_file）：实参键是「路径」；返回带行号，引用行号时以它为准。"

段落 写文件指导段():
  返回 "写文件（write_file）：实参键是「路径」和「内容」；覆盖已有文件前先读，优先用编辑文件做定向修改。"

段落 编辑文件指导段():
  返回 "编辑文件（edit_file）：实参键是「路径」「旧文本」「新文本」；旧文本必须在文件里唯一命中，要替换多处就显式传「全部替换」=真，按行插入传「插入行」。"

段落 搜索文件指导段():
  返回 "搜索文件（search_files）：实参键是「模式」（文件名 / 内容）和「查询」；先用宽查询定位，再读命中文件确认。"

段落 作业指导段():
  返回 "后台作业：job_start 起、job_output 读增量（按偏移推进，别重复读整段）、job_kill 收掉；作业在跑时不要空转等待。"

段落 网页指导段():
  返回 "网页：web__search 检索、web__fetch 抓正文（旧名 web_search / web_fetch 仍可调用）；私网地址与非 http(s) 协议会被拒绝，抓不到就换来源而不是换写法。"

段落 目标工具指导段():
  返回 "目标工具（workflow__goal）：动作取 update / complete / pause；一轮结束时用它确认整项目标的完成度，恢复只能由用户发起。"

段落 子代理指导段():
  返回 "子代理：彼此独立、可以并行的子任务交给派发子任务，别把一个问题拆成串行步骤自己硬跑。"

段落 交付呈现指导段():
  返回 "交付呈现（present）：需要给用户一个可打开的文件交付物时调它，别只在回复里写路径。"

段落 实参契约段():
  返回 "工具调用规则：\n1) 实参必须是合法 JSON 对象，字段名严格使用工具定义（JSON Schema）里的原名，禁止翻译或改写：bash 用「命令」，read_file 用「路径」，write_file 用「路径」和「内容」，search_files 用「模式」和「查询」，edit_file 用「路径」「旧文本」「新文本」。\n2) 工具返回「参数校验失败」时，按其中的字段路径与原因改正后重试；不要原样重发同一个调用。\n3) 同一工具连续 3 次参数校验失败会触发熔断并中止本轮；此时应先说明原因，不要继续重试。"

# 造一个「已绑定在场工具表」的工具选择段闭包：注册节的文本可以是函数，
#   组装时以 组装上下文 调用（§5 解析节文本 已支持），这里固定入参不再依赖上下文。
段落 造工具选择闭包(在场):
  段落 绑定(组装上下文 = 空):
    返回 工具选择段(在场)
  返回 绑定

# ---- §6.2 接线：工具在场则挂对应节 ----

# 上下文取值（T-0487）：上下文 是可选的字典，缺键 / 非字典一律当「没有这份材料」。
#   认的键：技能表 / 服务器名表 / 权限预设 / 审批策略 / 环境信息。
段落 上下文取(上下文, 键):
  如果 是字典(上下文) == 假:
    返回 空
  如果 字典包含键(上下文, 键) == 假:
    返回 空
  返回 上下文[键]

# 造生产提示注册表(工具名表, 上下文) -> 系统提示注册表（已注册全部在场节）
#   工具名表 为空 / 非列表 → 用 标准工具面()。
#   上下文 缺省 空（向后兼容：老调用方只传工具名表，行为不变）。
#   六个新节（T-0487）一律「在场才挂」：上下文缺键 / 模块给空串 → 不注册该节，
#   顺序表不因空节留洞。
段落 造生产提示注册表(工具名表 = 空, 上下文 = 空):
  设 在场 为 工具名表
  如果 是空(在场) == 真 或 type(在场) != list:
    设 在场 为 取标准工具面()
  设 注册表 为 建系统提示注册表()
  # 身份：恒在（HARNESS_IDENTITY = -1000）
  注册节(注册表, "harness:identity", 节顺序常量表["HARNESS_IDENTITY"], 身份段())
  # 运行环境（T-0479）：HARNESS_IDENTITY + 50（-950）——身份之后立刻交代环境，
  #   模型才不会在 pwsh 里写 cat/grep，也不会靠猜日期答「今天」。
  #   槽位表没有环境节，取身份槽位 + 50 偏移。
  设 环境信息 为 上下文取(上下文, "环境信息")
  如果 是空(环境信息) == 假:
    设 环境文本 为 环境段(环境信息)
    如果 长(环境文本) > 0:
      注册节(注册表, "harness:environment", 节顺序常量表["HARNESS_IDENTITY"] + 50, 环境文本)
  # 规划策略：恒在（PLAN_POLICY = 500）
  注册节(注册表, "plan:policy", 节顺序常量表["PLAN_POLICY"], 规划段())
  # 待办/目标引导：PLAN_POLICY + 1（槽位表没有 TOOL_TODO，规划引导的紧邻位）
  注册节(注册表, "plan:todos", 节顺序常量表["PLAN_POLICY"] + 1, 待办与目标段())
  # 工具使用纪律（T-0482）：PLAN_POLICY + 50（550）——纪律紧贴规划策略，
  #   讲的都是「怎么干活」而不是「有什么工具」。模块按在场性裁剪，空串不挂。
  设 纪律文本 为 纪律段文本(在场)
  如果 长(纪律文本) > 0:
    注册节(注册表, "plan:discipline", 节顺序常量表["PLAN_POLICY"] + 50, 纪律文本)
  # 权限与审批边界（T-0480）：PLAN_POLICY + 250（750）——介于规划与文件引用之间，
  #   对应上游 CONTEXT_ORDERS 里 APPROVAL_POLICY(115) 相对 SANDBOX_POLICY(110) 的位置。
  设 权限文本 为 权限段文本(上下文取(上下文, "权限预设"), 上下文取(上下文, "审批策略"))
  如果 长(权限文本) > 0:
    注册节(注册表, "harness:permission", 节顺序常量表["PLAN_POLICY"] + 250, 权限文本)
  # 文件引用与路径规范：FILE_REFERENCE = 900
  注册节(注册表, "file_reference", 节顺序常量表["FILE_REFERENCE"], 文件引用段())
  # 技能清单（T-0478）：FILE_REFERENCE + 50（950）——路径规范之后、工具选择之前；
  #   与 tool:selection 同槽位，靠同顺序按名字升序（skill:catalog < tool:selection）定序。
  #   技能面不在场（skill/技能取用/技能列表 全缺）→ 不挂，免得提示推荐取不到正文的技能。
  设 技能文本 为 ""
  如果 技能段在场(在场) == 真:
    设 技能文本 为 技能段文本(上下文取(上下文, "技能表"))
  如果 长(技能文本) > 0:
    注册节(注册表, "skill:catalog", 节顺序常量表["FILE_REFERENCE"] + 50, 技能文本)
  # 工具选择总则：FILE_REFERENCE + 50（介于路径规范与逐工具指导之间；槽位表无此项）
  #   段文本按在场工具渲染（与下方逐工具指导同一口径），故这里传的是闭包形式。
  注册节(注册表, "tool:selection", 节顺序常量表["FILE_REFERENCE"] + 50, 造工具选择闭包(在场))
  # 逐工具指导：只在工具在场时挂
  如果 工具在场(在场, ["bash"]) == 真:
    注册节(注册表, "tool:bash", 节顺序常量表["TOOL_BASH"], bash指导段())
  如果 工具在场(在场, ["读文件", "read_file"]) == 真:
    注册节(注册表, "tool:read", 节顺序常量表["TOOL_READ"], 读文件指导段())
  如果 工具在场(在场, ["写文件", "write_file"]) == 真:
    注册节(注册表, "tool:write", 节顺序常量表["TOOL_WRITE"], 写文件指导段())
  如果 工具在场(在场, ["编辑文件", "edit_file"]) == 真:
    注册节(注册表, "tool:edit", 节顺序常量表["TOOL_EDIT"], 编辑文件指导段())
  如果 工具在场(在场, ["搜索文件", "search_files"]) == 真:
    注册节(注册表, "tool:grep", 节顺序常量表["TOOL_GREP"], 搜索文件指导段())
  如果 工具在场(在场, ["job_start", "job_output", "job_kill"]) == 真:
    注册节(注册表, "tool:jobs", 节顺序常量表["TOOL_JOBS"], 作业指导段())
  如果 工具在场(在场, ["web_search", "web__search", "web_fetch", "web__fetch"]) == 真:
    注册节(注册表, "tool:web_search", 节顺序常量表["TOOL_WEB_SEARCH"], 网页指导段())
  # MCP 资源服务器（T-0481）：TOOL_WEB_SEARCH + 50（2050）——与网页族相邻（同属「取外部
  #   资料」）。模块自身已要求服务器名表非空且资源工具在场，再空就整段不挂。
  设 MCP文本 为 MCP段文本(上下文取(上下文, "服务器名表"), 在场)
  如果 长(MCP文本) > 0:
    注册节(注册表, "mcp:resources", 节顺序常量表["TOOL_WEB_SEARCH"] + 50, MCP文本)
  如果 工具在场(在场, ["目标", "workflow__goal", "goal"]) == 真:
    注册节(注册表, "tool:goal", 节顺序常量表["TOOL_GOAL"], 目标工具指导段())
  # 协作与长任务（T-0483）：TOOL_SUBAGENT - 50（2750）——紧贴子代理指导之前，
  #   讲的是「怎么委派/怎么收口」，读完紧接着是子代理工具本身。
  设 协作文本 为 协作段文本(在场)
  如果 长(协作文本) > 0:
    注册节(注册表, "plan:collab", 节顺序常量表["TOOL_SUBAGENT"] - 50, 协作文本)
  如果 工具在场(在场, ["派发子任务", "subagent"]) == 真:
    注册节(注册表, "tool:subagent", 节顺序常量表["TOOL_SUBAGENT"], 子代理指导段())
  如果 工具在场(在场, ["present"]) == 真:
    # 交付呈现：槽位表无 TOOL_PRESENT，取 TOOL_REPORT（同属「产出交付物」族，2900）
    注册节(注册表, "tool:present", 节顺序常量表["TOOL_REPORT"], 交付呈现指导段())
  # 实参契约：恒在且恒在末尾（DEPLOYMENT_PERSONA_SUFFIX = 10200，T-0388 的止血段不许被挤到中间）
  注册节(注册表, "harness:tool_contract", 节顺序常量表["DEPLOYMENT_PERSONA_SUFFIX"], 实参契约段())
  返回 注册表

# 渲染后的生产提示（未经预算裁剪；单测可直接比对逐段文案）
段落 生产提示原文(工具名表 = 空, 上下文 = 空):
  设 注册表 为 造生产提示注册表(工具名表, 上下文)
  设 装配 为 组装系统提示(注册表)
  返回 渲染提示(装配)

# 预算裁剪：超上限则截断并留标记（保证返回值长度 <= 上限）
段落 限长提示(文本, 上限):
  如果 是整数(上限) == 假 或 上限 <= 0:
    返回 文本
  设 长值 为 长(文本)
  如果 长值 <= 上限:
    返回 文本
  设 标记 为 生产提示截断标记
  设 保留 为 上限 - 长(标记)
  如果 保留 < 0:
    设 保留 为 0
  返回 文本[0:保留] + 标记

# 生产提示（主入口：总入口.通用工具契约文本 调它）
#   = 按在场工具 + 可选上下文组装的节文本，再按 生产提示上限() 裁剪。
#   上下文 缺省 空：老调用方只传工具名表时，只多出纪律/协作两个静态节。
段落 生产提示文本(工具名表 = 空, 上下文 = 空):
  设 原文 为 生产提示原文(工具名表, 上下文)
  返回 限长提示(原文, 生产提示上限())

