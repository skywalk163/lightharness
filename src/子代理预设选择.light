# 子代理预设选择.light —— R175（T-0175）B3 路纯逻辑复刻
#
# 上游：packages/subagent/tool-subagent/src/preset-selection.ts（dsh-v0.2.1-rc.3，98 行新增）
#   → SubagentPresetSelection：一次委派工具「部署自有的 agent preset 选择」
#     （默认预设 + 模型可选白名单）。
#
# 复刻范围（只做纯逻辑段）：
#   §1 构造校验：白名单去重、默认值必须落在白名单内
#   §2 configured / choices 两个只读判定
#   §3 description：模型可见的选择说明 + 已配置预设描述拼接
#   §4 resolve：模型入参校验 + 部署默认值回落
#   §5 assertProvider：已配置却遇上「不支持独立预设」或「继承父上下文」的提供方 → 报错
#   §6 validate 的纯组装段：候选 id 去重保序；只有白名单内且带 description 的进描述表
#
# 宿主面剥离（上游是 Cordis 服务 + 异步 IO，本模块不含）：
#   - `ctx.get('agentPresets')` → 传「有服务」布尔
#   - `await presets.readDocument(id)` → 传「文档表」(id → {"description": ...})
#   上游 readDocument 对未登记 id 抛错；光明侧等价定为显式抛错（文案见 预选文档缺失()）。
#
# 复刻偏差（登记，见 docs/功能对标/语言缺陷账.md 与 summary）：
#   1) 上游靠 TS 静态类型约束 agentPreset: string / allowedAgentPresets: string[]；
#      光明无类型系统 → 改为运行时守卫，逐条对齐错误文案前缀。
#   2) 上游 `new Set([...])` 保序去重；光明无 Set → 本地 预选去重 用字典当集合，保序一致。
#
# 命名避坑：本地辅助段一律「预选」前缀（src 后端会把被导入模块内联进同一份 Python，
# 同名段会 codegen 重定义，见 子代理核心.light 头部注释 L-119/L-120）。

# =====================================================================
# §1 构造与校验（constructor）
# =====================================================================

# new SubagentPresetSelection(config)
# 配置字典：「默认」= agentPreset（字符串或 空），「白名单」= allowedAgentPresets（字符串列表或 空）
段落 预选新建(配置):
  如果 是字典(配置) == 假:
    抛出 新建 错误("tool-subagent: preset selection config must be an object")
  设 默认 为 字典获取(配置, "默认", 空)
  设 白名单 为 字典获取(配置, "白名单", 空)
  如果 默认 != 空:
    如果 是字符串(默认) == 假:
      抛出 新建 错误("tool-subagent: agentPreset must be a string")
  如果 白名单 != 空:
    如果 预选是字符串列表(白名单) == 假:
      抛出 新建 错误("tool-subagent: allowedAgentPresets must be an array of strings")
    如果 长度(预选去重(白名单)) != 长度(白名单):
      抛出 新建 错误("tool-subagent: allowedAgentPresets contains duplicate preset ids")
    如果 默认 != 空:
      如果 预选含(白名单, 默认) == 假:
        抛出 新建 错误("tool-subagent: agentPreset must be included in allowedAgentPresets")
  返回 {"默认": 默认, "白名单": 白名单}

# =====================================================================
# §2 只读判定（get configured / get choices）
# =====================================================================

# configured：默认值或白名单任一被显式配置
段落 预选已配置(选择):
  如果 选择["默认"] != 空:
    返回 真
  返回 选择["白名单"] != 空

# choices：模型入参里可选的预设 id（未配白名单即 空 = 关闭模型选择）
段落 预选可选表(选择):
  返回 选择["白名单"]

# =====================================================================
# §3 模型可见说明（get description）
# =====================================================================

# 上游：`Agent preset for this child. ${fallback}` + 可选 ` Available presets: ${join('; ')}`
段落 预选描述(选择, 描述表 = 空):
  设 回落 为 "Omit to inherit the parent agent's current preset."
  如果 选择["默认"] != 空:
    设 回落 为 "Omit to use " + 选择["默认"] + "."
  设 文本 为 "Agent preset for this child. " + 回落
  如果 描述表 == 空:
    返回 文本
  如果 长度(描述表) == 0:
    返回 文本
  返回 文本 + " Available presets: " + 连接字符串(描述表, "; ")

# =====================================================================
# §4 入参解析（resolve）
# =====================================================================

# 请求字典可含 "agent_preset"（模型不可信输入）。
# id 缺省 → 用部署默认值；未开白名单 → 禁用；非字符串 / 不在白名单 → 报错。
段落 预选解析(选择, 请求):
  设 id 为 字典获取(请求, "agent_preset", 空)
  如果 id == 空:
    返回 选择["默认"]
  如果 预选可选表(选择) == 空:
    抛出 新建 错误("agent_preset selection is disabled for this tool instance")
  如果 是字符串(id) == 假:
    抛出 新建 错误("agent_preset must be one of: " + 连接字符串(选择["白名单"], ", "))
  如果 预选含(选择["白名单"], id) == 假:
    抛出 新建 错误("agent_preset must be one of: " + 连接字符串(选择["白名单"], ", "))
  返回 id

# =====================================================================
# §5 提供方断言（assertProvider）
# =====================================================================

# 提供方字典：「名字」、「支持预设」（capabilities.agentPreset）、「继承父上下文」。
段落 预选断言提供方(选择, 提供方):
  如果 预选已配置(选择) == 假:
    返回 真
  设 支持 为 字典获取(提供方, "支持预设", 假)
  设 继承 为 字典获取(提供方, "继承父上下文", 假)
  如果 支持 == 真 且 继承 == 假:
    返回 真
  抛出 新建 错误("tool-subagent: provider \"" + 转字符串(字典获取(提供方, "名字", ""))
    + "\" does not support independent agent preset selection")

# =====================================================================
# §6 文档校验的纯组装段（validate）
# =====================================================================

# 候选 id = 默认值 + 白名单（保序去重）；只有白名单内且带 description 的进描述表。
# 返回描述表（"id: 描述" 列表），宿主把它塞进 预选描述。
段落 预选校验服务(选择, 有服务, 文档表):
  如果 预选已配置(选择) == 假:
    返回 []
  如果 有服务 == 假:
    抛出 新建 错误("tool-subagent: agent preset selection requires the agent-presets service")
  设 候选 为 []
  如果 选择["默认"] != 空:
    列表追加(候选, 选择["默认"])
  如果 选择["白名单"] != 空:
    遍历 id 之 选择["白名单"]:
      列表追加(候选, id)
  设 描述 为 []
  遍历 id 之 预选去重(候选):
    设 文档 为 字典获取(文档表, id, 空)
    如果 文档 == 空:
      抛出 新建 错误(预选文档缺失(id))
    如果 预选可选表(选择) != 空 且 预选含(选择["白名单"], id):
      设 说明 为 字典获取(文档, "description", 空)
      如果 说明 != 空:
        列表追加(描述, id + ": " + 说明)
  返回 描述

# 上游由 presets.readDocument 抛错；光明侧统一为显式文案（登记偏差）。
段落 预选文档缺失(id):
  返回 "tool-subagent: agent preset \"" + id + "\" is not registered"

# =====================================================================
# 本地工具（一律「预选」前缀）
# =====================================================================

段落 预选含(列表, 值):
  遍历 项 之 列表:
    如果 项 == 值:
      返回 真
  返回 假

# 保序去重（上游 new Set）
段落 预选去重(列表):
  设 见过 为 {}
  设 结果 为 []
  遍历 项 之 列表:
    如果 字典包含键(见过, 项) == 假:
      设 见过[项] 为 1
      列表追加(结果, 项)
  返回 结果

段落 预选是字符串列表(值):
  如果 是列表(值) == 假:
    返回 假
  遍历 项 之 值:
    如果 是字符串(项) == 假:
      返回 假
  返回 真

导出 预选新建, 预选已配置, 预选可选表, 预选描述, 预选解析, 预选断言提供方, 预选校验服务, 预选文档缺失


# =====================================================================
# §6 子代理中断默认关（0.2.2-rc.1 #15 subagent-interrupt-default）
# =====================================================================
#
# 上游（dsh-v0.2.2-rc.3 = 38a6a5c965）：
#   packages/bundle/base/cordis.patch.yml:389            → tool-subagent-control 行
#                                                          `config.interrupt: false`
#   packages/bundle/web-app/presets/standard.patch.yml:98 → 同
#   packages/bundle/web-app/presets/cordis.patch.yml:94   → 同
#   packages/bundle/web-app/presets/ptc.patch.yml:95      → 同
#   packages/subagent/tool-subagent-control/src/index.ts
#     Config.interrupt?: boolean  默认 true
#     apply(): `const interrupt = config.interrupt !== false`；`if (!interrupt) return`
#              → 关掉时**不注册** interrupt_agent，其余三个工具与 ctx.subagents.interrupt() 照旧
#   packages/bundle/base/README.zh.md:56
#     「tool-subagent-control 行显式设置 interrupt: false，因此普通 subagent 和
#       Team 模式均不提供 interrupt_agent。插件自身的默认值仍为 true。」
#
# 于是**两个层次必须分开**（这正是本条最容易做错的地方）：
#   ① 插件默认 = 真（省略配置的独立组合仍提供中断工具）；
#   ② 内置组合默认 = 假（base 及 Web 的 standard/cordis/ptc 都显式写 false）。
# 关掉中断工具不等于关掉中断能力：消息/发现/收件箱等待三个工具仍在，
# subagent 服务的中断 API（SubagentService.interrupt / Remote interruptByUser）仍在。

# 6.1 内置组合名表：base（headless/sdk/acp 等 profile 都基于它）+ Web 三个 preset。
#     （上游 base 组合包与 web-app presets 是两处配置，这里合并成一张「内置组合」表，
#      因为本仓只对「是不是内置组合」这一层做判定，不做 profile 装配。）
段落 预选内置组合名表():
  返回 ["base", "headless", "sdk", "acp", "standard", "cordis", "ptc"]

# 6.2 某组合名是否为内置组合（大小写不敏感；非字符串一律视为独立组合）
段落 预选是内置组合(名):
  如果 是字符串(名) == 假:
    返回 假
  设 待查 为 转小写(去除空白(名))
  遍历 候选 之 预选内置组合名表():
    如果 转小写(候选) == 待查:
      返回 真
  返回 假

# 6.3 层次①：插件自身默认值 —— 恒为真（上游 `z.boolean().default(true)`）
段落 预选插件默认中断():
  返回 真

# 6.4 层次②：内置组合里中断的默认值（真=内置组合；假=独立组合/插件默认）
#     保留既有签名与语义：入参是「是否内置组合」的布尔判定结果。
段落 预选中断默认(是否内置组合):
  如果 是否内置组合 == 真:
    返回 假
  返回 真

# 6.5 按组合名取该组合的 interrupt 配置值：内置组合 → 假；独立组合 → 空（= 省略，落回插件默认）
段落 预选中断配置值(组合名):
  如果 预选是内置组合(组合名) == 真:
    返回 假
  返回 空

# 6.6 某份配置最终是否提供中断工具（显式配置优先，省略落回插件默认真）。
#     键名同时接受上游线键 `interrupt` 与既有的中文键 `中断`。
段落 预选含中断工具(配置):
  如果 是字典(配置) == 假:
    返回 真
  设 值 为 字典获取(配置, "中断", 空)
  如果 值 == 空:
    设 值 为 字典获取(配置, "interrupt", 空)
  如果 值 == 空:
    返回 预选插件默认中断()
  返回 值

# 6.7 组合名 + 覆盖配置 → 最终是否提供中断工具。
#     覆盖配置留空/缺该键 = 沿用该组合的默认（内置组合 → 假）；显式给值则显式优先。
段落 预选组合含中断(组合名, 覆盖配置 = 空):
  设 覆盖值 为 空
  如果 是字典(覆盖配置):
    设 覆盖值 为 字典获取(覆盖配置, "中断", 空)
    如果 覆盖值 == 空:
      设 覆盖值 为 字典获取(覆盖配置, "interrupt", 空)
  如果 覆盖值 != 空:
    返回 覆盖值
  设 组合值 为 预选中断配置值(组合名)
  如果 组合值 == 空:
    返回 预选插件默认中断()
  返回 组合值

# 6.8 工具名清单：不含 interrupt_agent 时其余三个仍在（Team 模式同规则）
段落 预选工具名表(含中断):
  如果 含中断 == 真:
    返回 ["interrupt_agent", "send_message", "list_agents", "wait_agent"]
  返回 ["send_message", "list_agents", "wait_agent"]

# 6.9 中断能力本身是否仍可用：关掉的只是**工具**，服务 API（含 Remote interruptByUser）仍在。
段落 预选中断服务可用():
  返回 真

# 6.10 工具面总览：把「工具清单」「工具是否含中断」「服务是否可用」三者一次给出。
#      上游 Team 模式同样落在这套控制工具上，所以本段落对 Team 不做分支——
#      差异只在 Team 另有一套 team_task_* 工具（见 src/代理团队.light）。
段落 预选控制工具面(组合名, 覆盖配置 = 空):
  设 含中断 为 预选组合含中断(组合名, 覆盖配置)
  设 面 为 {}
  面["组合名"] 为 组合名
  面["含中断"] 为 含中断
  面["工具名表"] 为 预选工具名表(含中断)
  面["中断服务可用"] 为 预选中断服务可用()
  返回 面

导出 预选新建, 预选已配置, 预选可选表, 预选描述, 预选解析, 预选断言提供方, 预选校验服务, 预选文档缺失
导出 预选中断默认, 预选含中断工具, 预选工具名表
导出 预选内置组合名表, 预选是内置组合, 预选插件默认中断, 预选中断配置值, 预选组合含中断, 预选中断服务可用, 预选控制工具面
