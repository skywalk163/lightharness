# 流式JSON.light —— 对标 packages/bundle/headless/src/json-stream.ts（R87 B4-G1 新增）
#
# 上游纯逻辑面（host 投影循环 projectJsonRun 依赖 ctx.on/agent.session/process.cwd，
#   属宿主接线，本模块不复刻）：
#   L18-19   MAX_STRING_BYTES / MAX_EVENT_BYTES 常量
#   L62-67   truncateUtf8：按字节上限截断 UTF-8，丢弃被劈开的尾字符（U+FFFD）
#   L70-75   boundKey：超长键截断并置截断标志
#   L78-103  boundValue：递归封顶所有字符串与键；深度 >= MAX_DEPTH 切尾防栈溢出
#   L112-118 boundJsonEvent：整值封顶，任一被切即加 truncated 标志
#   L131-149 boundJsonLine：双层降级——先封字符串，行仍超长只留标量，再超长只留 type
#   L157-168 parseArguments：空入参→{}；含非有限数或非法 JSON→保留原文
#   L171-176 resultText：过滤 text 块并拼接
#   L189-213 addUsage：跨尝试累计用量；任一桶缺报即整体省略该桶
#
# ⚠️ 命名铁律：避开 取/生成/导出/导入/新建/模型/事件/类型/部分/原因/全部/工具/模式/
#   用量/打印/抛出/接口/接收/属性/异步/包含/匹配/排序/回调/映射/枚举/返回 词根。
#   （本模块「用量」一词仅出现在上游 StepUsage 语义，函数名改用「累计用量」以贴合。）

从 JSON 导入 解析JSON 序列化JSON

# =====================================================================
# 常量（json-stream.ts L18-19、L60、L21）
# =====================================================================
常量 设 字符串字节上限 为 8192
常量 设 事件字节上限 为 32768
常量 设 换行字节数 为 1
常量 设 深度上限 为 64
常量 设 深度截断标记 为 "[truncated: depth]"

# =====================================================================
# 字节工具（truncateUtf8 的纯逻辑投影）
# =====================================================================

# 字符串的 UTF-8 字节数（对齐 Buffer.byteLength(text,'utf8')）
段落 串字节数(文本):
  返回 长(文本.encode("utf-8"))

# truncateUtf8（L62-67）：按字节上限截断，丢弃被劈开的尾字符
段落 截断UTF8(文本, 字节上限):
  设 全量 为 文本.encode("utf-8")
  设 切片 为 全量[0:字节上限]
  # Python 严格解码遇劈开尾字节会抛错；对齐 Node Buffer.toString 的宽松替换
  设 解码 为 切片.decode("utf-8", "replace")
  # 解码以 U+FFFD 结尾说明最后一个多字节字符被劈开，去掉它
  如果 字符串长度(解码) > 0:
    如果 解码[字符串长度(解码)-1] == "�":
      返回 截取(解码, 0, 字符串长度(解码)-1)
  返回 解码

# =====================================================================
# boundValue / boundKey（L70-103）
# =====================================================================

# boundKey（L70-75）：超长键截断并置标志
段落 封顶键(键, 字节上限, 状态):
  如果 串字节数(键) <= 字节上限:
    返回 键
  字典设置(状态, "截断", 真)
  返回 截断UTF8(键, 字节上限)

# 是否纯数据对象（dict 且非 list；对齐 isRecord）
段落 是记录(值):
  如果 是字典(值) == 假:
    返回 假
  如果 是列表(值):
    返回 假
  返回 真

# boundValue（L78-103）：递归封顶；深度超限切尾
段落 封顶值(值, 字节上限, 状态, 深度):
  如果 是字符串(值):
    如果 串字节数(值) <= 字节上限:
      返回  值
    字典设置(状态, "截断", 真)
    返回 截断UTF8(值, 字节上限)
  如果 是列表(值):
    如果 深度 >= 深度上限:
      字典设置(状态, "截断", 真)
      返回 深度截断标记
    设 重建 为 []
    遍历 项 之 值:
      列表追加(重建, 封顶值(项, 字节上限, 状态, 深度 + 1))
    返回 重建
  如果 是记录(值):
    如果 深度 >= 深度上限:
      字典设置(状态, "截断", 真)
      返回 深度截断标记
    设 重建 为 {}
    遍历 键 之 字典键列表(值):
      设 新键 为 封顶键(键, 字节上限, 状态)
      字典设置(重建, 新键, 封顶值(字典获取(值, 键), 字节上限, 状态, 深度 + 1))
    返回 重建
  返回  值

# boundJsonEvent（L112-118）：整值封顶，任一被切加 truncated 标志
段落 封顶事件(事件, 字符串上限):
  设 状态 为 {"截断": 假}
  设 封顶 为 封顶值(事件, 字符串上限, 状态, 0)
  如果 状态["截断"]:
    字典设置(封顶, "truncated", 真)
  返回 封顶

# =====================================================================
# boundJsonLine（L131-149）：双层降级
# =====================================================================

段落 封顶行(事件, 字符串上限, 事件上限):
  设 上限 为 事件上限 - 换行字节数
  设 封顶 为 封顶事件(事件, 字符串上限)
  设 行 为 序列化JSON(封顶)
  如果 串字节数(行) <= 上限:
    返回 行
  # 第一降级：只保留标量字段（非对象），结构化字段整体丢弃
  设 标量 为 {}
  遍历 键 之 字典键列表(封顶):
    设 子值 为 字典获取(封顶, 键)
    如果 子值 == 空:
      字典设置(标量, 键, 子值)
    否则如果 是字典(子值) == 假 且 是列表(子值) == 假:
      字典设置(标量, 键, 子值)
  字典设置(标量, "truncated", 真)
  设 短行 为 序列化JSON(标量)
  如果 串字节数(短行) <= 上限:
    返回 短行
  # 第二降级：连标量都超长，只留 type 与 truncated
  返回 序列化JSON({"type": 字典获取(封顶, "type"), "truncated": 真})

# =====================================================================
# parseArguments（L157-168）
# =====================================================================

# 递归探测非有限数（inf/nan）：1e400 是合法 JSON 但序列化回 null，须保留原文
段落 含非有限(值):
  如果 是浮点(值):
    如果 值 != 值:
      返回 真
    如果 值 > 1e308:
      返回 真
    如果 值 < -1e308:
      返回 真
    返回 假
  如果 是整数(值):
    返回 假
  如果 是列表(值):
    遍历 项 之 值:
      如果 含非有限(项):
        返回 真
    返回 假
  如果 是字典(值):
    遍历 键 之 字典键列表(值):
      如果 含非有限(字典获取(值, 键)):
        返回 真
    返回 假
  返回 假

段落 解析参数(原文):
  如果 原文 == "":
    返回 {}
  设 已解析 为 空
  设 成 为 真
  尝试:
    设 已解析 为 解析JSON(原文)
  捕获 错误:
    设 成 为 假
  如果 成 == 假:
    返回 原文
  如果 含非有限(已解析):
    返回 原文
  返回 已解析

# =====================================================================
# resultText（L171-176）
# =====================================================================

段落 结果文本(块表):
  设 拼接 为 ""
  遍历 块 之 块表:
    如果 是字典(块):
      如果 字典获取(块, "type", 空) == "text":
        设 文 为 字典获取(块, "text", 空)
        如果 是字符串(文):
          设 拼接 为 拼接 + 文
  返回 拼接

# =====================================================================
# addUsage（L189-213）：跨尝试累计用量
#   inputTokens/outputTokens 恒累加；可选桶仅当两次都报才累加；任一尝试缺报即完整=假
# =====================================================================

段落 两数和(甲, 乙):
  如果 甲 == 空 或 乙 == 空:
    返回 空
  返回 甲 + 乙

段落 累计用量(状态, 下一个):
  如果 下一个 == 空:
    返回 {"用量": 状态["用量"], "完整": 假}
  如果 状态["用量"] == 空:
    返回 {"用量": 下一个, "完整": 状态["完整"]}
  设 旧 为 状态["用量"]
  设 新 为 下一个
  设 条目 为 {"inputTokens": 旧["inputTokens"] + 新["inputTokens"], "outputTokens": 旧["outputTokens"] + 新["outputTokens"]}
  设 合计 为 两数和(取可选(旧, "totalTokens", 空), 取可选(新, "totalTokens", 空))
  如果 合计 != 空:
    字典设置(条目, "totalTokens", 合计)
  设 读缓存 为 两数和(取可选(旧, "cacheReadTokens", 空), 取可选(新, "cacheReadTokens", 空))
  如果 读缓存 != 空:
    字典设置(条目, "cacheReadTokens", 读缓存)
  设 写缓存 为 两数和(取可选(旧, "cacheWriteTokens", 空), 取可选(新, "cacheWriteTokens", 空))
  如果 写缓存 != 空:
    字典设置(条目, "cacheWriteTokens", 写缓存)
  设 推理 为 两数和(取可选(旧, "reasoningTokens", 空), 取可选(新, "reasoningTokens", 空))
  如果 推理 != 空:
    字典设置(条目, "reasoningTokens", 推理)
  返回 {"用量": 条目, "完整": 状态["完整"]}

导出 字符串字节上限 事件字节上限 换行字节数 深度上限 深度截断标记
导出 串字节数 截断UTF8 是记录 封顶键 封顶值 封顶事件 封顶行
导出 含非有限 解析参数 结果文本 两数和 累计用量
