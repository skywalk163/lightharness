# 插件安装.light —— R111 第三版：通过 Git URL 添加光明插件
#
# 借鉴上游 deepseek-harness 的插件安装流程（输入规格→包管理器下载→loader 加载），
# 但换成光明生态：
#   1. 解析 Git URL（https://github.com/owner/repo / owner/repo / git@...）→ repo 名；
#   2. git clone --depth 1 到 lightplugin/插件/_外部/<repo名>/；
#   3. 自动找入口 .light（优先 <repo名>.light，否则根目录第一个 .light）；
#   4. 记录到 <数据根>/installed.json：{name, 路径, 入口}；
#   5. 真正的加载挂载在 组装注册表 → 加载外部插件 时做（重启/清缓存后生效）。
#
# 要求被 clone 的仓库是光明插件格式：根目录有一个暴露 .挂载(注册表) 的 .light 模块。

从 文件系统 导入 文件存在, 目录存在, 创建目录, 删除目录, 文件列表, 遍历目录, 路径连接, 写入文件, 读取文件
从 JSON 导入 解析JSON, 序列化JSON
从 外部命令 导入 执行命令, 命令存在
从 内置核心字典 导入 字典获取, 字典设置, 字典键列表
从 内置核心列表 导入 列表创建, 列表追加
从 内置核心判型 导入 是字典, 是列表
从 内置核心字符串 导入 去除空白, 截取, 结尾, 开头, 字符串包含
从 字符串工具轻量 导入 分割字符串, 连接字符串

设 安装清单名 为 "installed.json"
设 git超时秒 为 120.0

# installed.json 路径(数据根)
段落 安装清单路径(根):
  返回 路径连接(根, 安装清单名)

# 读安装清单(根) -> [{name,路径,入口}]
段落 读安装清单(根):
  如果 根 == 空 或 根 == "":
    返回 []
  设 路径 为 安装清单路径(根)
  如果 文件存在(路径) == 假:
    返回 []
  尝试:
    设 读到 为 解析JSON(读取文件(路径))
  捕获 异常 e:
    返回 []
  如果 是列表(读到) == 假:
    返回 []
  返回 读到

# 写安装清单(根, 表)
段落 写安装清单(根, 表):
  如果 根 == 空 或 根 == "":
    返回
  写入文件(安装清单路径(根), 序列化JSON(表, 2) + "\n")

# 解析 Git 规格 -> {"repo":名, "clone_url":url, "错误":串}。
#   接受 https://github.com/owner/repo(.git)、git@github.com:owner/repo(.git)、owner/repo。
段落 解析Git规格(规格):
  设 规格 为 去除空白(规格)
  如果 规格 == "":
    返回 {"错误": "请输入 GitHub 仓库地址或 owner/repo"}
  设 url 为 规格
  # owner/repo 简写
  如果 字符串包含(规格, "://") == 假 且 字符串包含(规格, "@") == 假:
    如果 字符串包含(规格, "/") == 假:
      返回 {"错误": "格式应为 owner/repo 或完整 GitHub URL"}
    设 url 为 "https://github.com/" + 规格
  # 取 repo 名：先按 ":" 处理 scp 形式，再按 "/" 切最后一段
  设 工作 为 url
  如果 字符串包含(工作, "@") == 真:
    设 冒号段 为 分割字符串(工作, ":")
    设 工作 为 冒号段[长度(冒号段) - 1]
  设 段 为 分割字符串(工作, "/")
  设 repo 为 段[长度(段) - 1]
  如果 结尾(repo, ".git") == 真:
    设 repo 为 截取(repo, 0, 长度(repo) - 4)
  如果 repo == "" 或 字符串包含(repo, "/") == 真:
    返回 {"错误": "无法从地址解析仓库名: " + 规格}
  返回 {"repo": repo, "clone_url": url, "错误": ""}

# 外部插件根目录：lightplugin/插件/_外部/
段落 外部插件根():
  设 兄弟 为 路径连接("..", "lightplugin")
  设 插件根 为 路径连接(兄弟, "插件")
  返回 路径连接(插件根, "_外部")

# 找入口 .light(插件目录) -> 路径 或 空。
#   优先 <目录名>.light；否则根目录第一个非测试 .light。
段落 找入口(插件目录, repo名):
  设 优先 为 路径连接(插件目录, repo名 + ".light")
  如果 文件存在(优先) == 真:
    返回 优先
  设 文件表 为 文件列表(插件目录)
  遍历 名 之 文件表:
    如果 结尾(名, ".light") == 真 且 字符串包含(名, "测试") == 假 且 开头(名, "_") == 假:
      返回 路径连接(插件目录, 名)
  返回 空

# 安装插件(根, 规格) -> {"ok":真假, "错误":串, "repo":名}
段落 安装插件(根, 规格):
  如果 命令存在("git") == 假:
    返回 {"ok": 假, "错误": "未检测到 git 命令，无法从 Git 安装插件。", "repo": ""}
  设 解析 为 解析Git规格(规格)
  如果 字典获取(解析, "错误", "") != "":
    返回 {"ok": 假, "错误": 解析["错误"], "repo": ""}
  设 repo 为 解析["repo"]
  设 url 为 解析["clone_url"]
  设 外根 为 外部插件根()
  如果 目录存在(外根) == 假:
    创建目录(外根)
  设 目标 为 路径连接(外根, repo)
  # 已存在则先删（重新安装）
  如果 目录存在(目标) == 真:
    返回 {"ok": 假, "错误": "插件已存在: " + repo + "（如需重装请先移除）", "repo": repo}
  设 结果 为 执行命令(["git", "clone", "--depth", "1", url, 目标], 真, 空, 空, git超时秒)
  如果 结果.返回码 != 0:
    设 输出 为 转字符串(结果.标准错误)
    返回 {"ok": 假, "错误": "git clone 失败: " + 输出, "repo": repo}
  设 入口 为 找入口(目标, repo)
  如果 入口 == 空:
    # clone 下来但没找到 .light 入口
    返回 {"ok": 假, "错误": "仓库已下载但未找到光明插件入口 .light 文件（仓库根目录需有暴露 .挂载 的 .light 模块）", "repo": repo}
  # 写安装清单
  设 清单 为 读安装清单(根)
  遍历 项 之 清单:
    如果 项["name"] == repo:
      返回 {"ok": 假, "错误": "插件已在清单中: " + repo, "repo": repo}
  列表追加(清单, {"name": repo, "路径": 目标, "入口": 入口})
  写安装清单(根, 清单)
  返回 {"ok": 真, "错误": "", "repo": repo, "入口": 入口}
