# 工具_路径安全.light —— 工具路径安全解析
#
# 所有文件系统类工具（读/写/搜索）必须把目标路径限制在工具根内，
# 拒绝 `..` 越界与绝对路径逃逸（沙箱护栏）。本模块提供统一的解析入口。
#
# 设计要点：
#   - 相对路径基于根解析；绝对路径直接采用（再判定是否落在根内）。
#   - 用 绝对路径(规范化路径(...)) 归一化后做前缀判定，规避 `..` / 符号链接歧义。
#   - 返回 {"ok":真/假, "路径":绝对路径, "理由":""}，调用方据 ok 决定拒绝。
#
# T-0470：工具根从「进程级单一根」升级为「会话级工具根」——
#   - 取根目录(会话cwd) 新增第二优先级（HARNESS_ROOT 之后）；
#   - 取根目录() 零参调用按线程取「当前工具根」（Web 层每轮按会话 cwd 设置），
#     再兜底 HARNESS_CWD / 当前目录()，无 worktree 场景行为与旧版一致；
#   - 工具处理器可用 取调用根(参数) 让单次调用显式指定 工作目录（须过白名单）；
#   - 白名单（工具根白名单）只允许项目根 / ~/.hive/wt / HARNESS_TOOL_ROOTS 配置前缀，
#     线性可配置，避免任意目录逃逸。

导入 os
导入 threading

# ---- 线程级「当前工具根」----
#   Web 服务端在每轮对话的线程里按会话 cwd 设置（同步路径与后台线程各设各的），
#   工具处理器零参调用 取根目录() 时读到本线程的值；跨会话并发互不污染。
设 工具根局部 为 threading.local()

# 额外工具根白名单前缀（os.pathsep 分隔，如 ":/srv/a:/srv/b"）
设 工具根白名单环境 等于 "HARNESS_TOOL_ROOTS"

# ---- 规范路径比较：normcase + normpath（Windows 大小写/分隔符归一）----
段落 规范路径比较(路径):
  如果 路径 == 空 或 长(路径) == 0:
    返回 ""
  设 绝对 为 绝对路径(路径)
  返回 os.path.normcase(os.path.normpath(绝对))

# ---- 路径是否落在根内（根自身也算）----
#   先按平台把路径归一（POSIX 保留 `/`，Windows 大小写与 `\` 归一），
#   再做「根 + 分隔符」前缀判定，避免 /a/bc 冒充 /a/b 的子路径。
段落 路径在根内(路径, 根):
  设 规范路径值 为 规范路径比较(路径)
  设 规范根 为 规范路径比较(根)
  如果 规范根 == "" 或 规范路径值 == "":
    返回 假
  如果 规范路径值 == 规范根:
    返回 真
  如果 开头(规范路径值, 规范根 + "/"):
    返回 真
  如果 开头(规范路径值, 规范根 + "\\"):
    返回 真
  返回 假

# ---- 工具根白名单：项目根 / ~/.hive/wt / HARNESS_TOOL_ROOTS ----
#   说明：会话 cwd 由 Web 层「信任」设置（用户显式选择，T-0395 既有语义不受限）；
#   白名单约束的是「工具参数 / cd 目标」这类不可信入口，避免任意目录逃逸。
段落 工具根白名单():
  设 表 为 []
  设 强制 为 环境变量("HARNESS_ROOT", "")
  如果 强制 != "" 且 强制 != 空:
    列表追加(表, 强制)
  设 项目根 为 当前目录()
  如果 项目根 != "" 且 项目根 != 空:
    列表追加(表, 项目根)
  设 家 为 主目录()
  如果 家 != "" 且 家 != 空:
    列表追加(表, os.path.join(家, ".hive", "wt"))
  设 附加 为 环境变量(工具根白名单环境, "")
  如果 附加 != "" 且 附加 != 空:
    遍历 前缀段 之 分割字符串(附加, os.pathsep):
      设 去空 为 去除空白(前缀段)
      如果 去空 != "":
        列表追加(表, 去空)
  返回 表

# ---- 是否允许作为工具根 / cd 目标（白名单命中）----
段落 是允许工具根(路径):
  如果 路径 == 空 或 长(路径) == 0:
    返回 假
  遍历 前缀 之 工具根白名单():
    如果 路径在根内(路径, 前缀):
      返回 真
  返回 假

# ---- 解析不可信工具根：存在 + 是目录 + 白名单 ----
#   返回 ["ok":真/假, "路径":绝对路径, "理由":""]
段落 解析工具根(路径):
  如果 路径 == 空 或 长(路径) == 0:
    返回 ["ok": 假, "理由": "工具根为空", "路径": ""]
  设 绝对 为 空
  尝试:
    设 绝对 为 绝对路径(路径)
  捕获 错误 异常内容:
    返回 ["ok": 假, "理由": "工具根路径非法: " + 转字符串(异常内容), "路径": ""]
  如果 目录存在(绝对) == 假:
    返回 ["ok": 假, "理由": "工具根不存在或不是目录: " + 绝对, "路径": 绝对]
  如果 是允许工具根(绝对) == 假:
    返回 ["ok": 假, "理由": "工具根不在白名单内（只允许项目根 / ~/.hive/wt / " +
      工具根白名单环境 + " 配置的前缀）: " + 绝对, "路径": 绝对]
  返回 ["ok": 真, "路径": 绝对, "理由": ""]

# ---- 设置/清除/读取本线程当前工具根 ----
#   信任=真：Web 层按「用户选定的会话 cwd」设置，只校验存在（保持 T-0395 语义）；
#   信任=假：工具参数等不可信入口，必须过白名单。
段落 设置工具根(路径, 信任 = 假):
  如果 路径 == 空 或 长(路径) == 0:
    返回 假
  设 绝对 为 空
  尝试:
    设 绝对 为 绝对路径(路径)
  捕获 错误 异常内容:
    返回 假
  如果 目录存在(绝对) == 假:
    返回 假
  如果 信任 == 假 且 是允许工具根(绝对) == 假:
    返回 假
  设 工具根局部.根 为 绝对
  返回 真

段落 清除工具根():
  设 工具根局部.根 为 ""
  返回 真

段落 取工具根覆盖():
  尝试:
    设 值 为 工具根局部.根
    如果 type(值) == str 且 长(值) > 0:
      返回 值
  捕获 错误 异常内容:
    返回 ""
  返回 ""

# ---- 取项目根：优先级（高 → 低）（T-0180 集中化 + T-0470 会话工具根）----
#   1. `HARNESS_ROOT` 环境变量 —— **强制覆盖**（T-0180 红线，保留 CLI headless 既有用法）；
#   2. 会话 cwd —— 调用方显式传入（同进程多会话各用各的根）；
#   3. 本线程工具根 —— Web 层每轮按会话 cwd 设置（不打穿到别的会话/线程）；
#   4. `HARNESS_CWD` 环境变量 —— CLI headless 显式指定工作根的既有入口；
#   5. `当前目录()` —— 兜底，保证零参调用行为与旧版一致。
#   红线：本段落只决定「根从哪里来」，越界判定仍在 解析安全路径 里。
段落 取根目录(会话cwd = 空):
  设 覆盖 为 环境变量("HARNESS_ROOT", "")
  如果 覆盖 != "":
    返回 覆盖
  如果 会话cwd != 空 且 长(会话cwd) > 0:
    返回 会话cwd
  设 工具根 为 取工具根覆盖()
  如果 工具根 != "":
    返回 工具根
  设 环境cwd 为 环境变量("HARNESS_CWD", "")
  如果 环境cwd != "":
    返回 环境cwd
  返回 当前目录()

# ---- 工具处理器取根：单次调用的 工作目录 参数优先（须白名单），否则本线程根 ----
#   工具 schema 不暴露该键（保持既有参数面不变）；它服务于内部/测试与
#   「明确知道自己在哪个 worktree」的调用方。
段落 取调用根(参数):
  如果 参数 != 空 且 type(参数) == dict:
    如果 参数.包含("工作目录"):
      设 候选 为 参数["工作目录"]
      如果 type(候选) == str 且 长(去除空白(候选)) > 0:
        设 解 为 解析工具根(候选)
        如果 解["ok"] == 真:
          返回 解["路径"]
  返回 取根目录()

# ---- 安全解析：根 + 路径 → 绝对路径（含越界判定）----
#   返回 {"ok":真, "路径":绝对路径} 或 {"ok":假, "理由":"...", "路径":绝对路径}
#   注：绝对路径 内部经 normpath，已能消解 `..`，无需再套 规范化路径。
段落 解析安全路径(根, 路径):
  设 候选 为 连接路径(根, 路径)
  设 解析 为 绝对路径(候选)
  设 根绝对 为 绝对路径(根)
  # 根自身或根的直接子路径均合法
  如果 解析 == 根绝对:
    返回 ["ok": 真, "路径": 解析]
  设 前缀斜 为 根绝对 + "/"
  设 前缀反 为 根绝对 + "\\"
  # 前缀判定（兼顾 POSIX `/` 与 Windows `\`）
  如果 解析.查找(前缀斜) == 0:
    返回 ["ok": 真, "路径": 解析]
  如果 解析.查找(前缀反) == 0:
    返回 ["ok": 真, "路径": 解析]
  返回 ["ok": 假, "理由": "路径超出项目根目录范围（拒绝越界访问）", "路径": 解析]

# =====================================================================
# T-0510 命令语义动态风险识别（高危 bash 模式 → 确认门控）
#
#   静态子串表（权限.light 危险模式表）只兜「字面已知模式」；本节把风险
#   识别从「路径」扩展到「命令语义」：按命令结构 + 文件系统状态动态判定
#   高危模式，供 工具执行.light 的确认门控消费（复用 §7 预决确认出口）。
#
#   规则要可复核、误报要低 —— 只识别「明确破坏性」模式：
#     递归强删     rm 带递归旗标（-r / -R / --recursive / 组合短旗标含 r/R）
#     覆盖移动     mv 带 -f/--force；或 mv 一源一目标且目标已存在（非目录）
#     重定向覆盖   裸 `>` 目标文件已存在（`>>` 追加、新建文件、fd 重定向不拦）
#     宽权限变更   chmod 777（0777 同判）
#     递归权限变更 chmod / chown / chgrp 带 -R/--recursive
#   明确不升级（交静态分级 / 审批链，避免误拦正常构建/清理）：
#     rm 无递归（含 rm -f 单文件）、cp、`>>` 追加、`>` 新建文件、
#     chmod 普通模式（644/755/+x）非递归、普通管道与只读命令。
#   已知边界：$() 与反引号载荷摘出为独立段识别一层；单引号内不展开不摘；
#   更深嵌套不识别（保守低误报，字面已知模式由 权限.light 子串表兜底）。
#   逃生舱：环境变量 HARNESS_CMD_RISK_OFF=1 时恒判非高危（生产临时关闭用）。
# =====================================================================

设 命令风险逃生环境 等于 "HARNESS_CMD_RISK_OFF"
设 命令风险递归上限 等于 2

# ---- 逃生舱：置 1/true 时识别恒放行 ----
段落 命令风险逃生():
  设 值 为 环境变量(命令风险逃生环境, "")
  如果 值 == "1" 或 值 == "true" 或 值 == "TRUE":
    返回 真
  返回 假

# ---- 短旗标是否含指定字母（-rf 含 r；-- 开头的长旗标不在此列）----
#   词长 2~4、首字符 -、其余全为字母才判，避免把 -99 / -x=1 之类误读成旗标。
段落 短旗标含字母(词, 字母):
  设 词数 为 字符串长度(词)
  如果 词数 < 2 或 词数 > 4:
    返回 假
  如果 截取(词, 0, 1) != "-":
    返回 假
  如果 截取(词, 1, 2) == "-":
    返回 假
  设 指 为 1
  当 指 < 词数:
    设 字符 为 截取(词, 指, 指 + 1)
    如果 字符 == 字母:
      返回 真
    如果 字符 < "a" 或 字符 > "z":
      如果 字符 < "A" 或 字符 > "Z":
        返回 假
    设 指 为 指 + 1
  返回 假

# ---- 旗标判定：递归 / 强制 / 禁止覆盖 ----
段落 是递归旗标(词):
  如果 词 == "--recursive" 或 词 == "-r" 或 词 == "-R":
    返回 真
  返回 短旗标含字母(词, "r") 或 短旗标含字母(词, "R")

段落 是强制旗标(词):
  如果 词 == "--force":
    返回 真
  返回 短旗标含字母(词, "f")

段落 是禁止覆盖旗标(词):
  如果 词 == "--no-clobber":
    返回 真
  返回 词 == "-n"

# ---- 是否包装词/载体词：越过它找真正的命令名 ----
#   sudo/env/nice 等只换执行环境；xargs 把前面的输出拼成命令行；then/do 是语法词。
段落 是包装词(词):
  返回 词 == "sudo" 或 词 == "env" 或 词 == "nice" 或 词 == "nohup" 或
    词 == "time" 或 词 == "command" 或 词 == "exec" 或 词 == "xargs" 或
    词 == "then" 或 词 == "do" 或 词 == "builtin"

# ---- 是否 shell 载体词（后跟 -c '载荷'）----
段落 是外壳词(词):
  返回 词 == "bash" 或 词 == "sh" 或 词 == "ksh" 或 词 == "zsh" 或 词 == "dash"

# ---- 去掉成对首尾引号（mv 目标 / `>` 目标可能是带引号路径）----
段落 去引号(词):
  设 词数 为 字符串长度(词)
  如果 词数 >= 2:
    设 首字 为 截取(词, 0, 1)
    设 尾字 为 截取(词, 词数 - 1, 词数)
    如果 (首字 == "\"" 且 尾字 == "\"") 或 (首字 == "'" 且 尾字 == "'"):
      返回 截取(词, 1, 词数 - 1)
  返回 词

# ---- 顶层连接符切段：引号感知；单引号内一字不切；$() 与反引号载荷摘为附加段 ----
#   返回段表（顶层段 + 载荷段，载荷段排在宿主段之后）；连接符：| || && ; & 换行。
#   $() / 反引号在宿主段只留占位（语义已包含在载荷段里，占位防误连词）。
段落 命令风险切段(命令):
  设 段表 为 []
  设 载荷表 为 []
  设 当前 为 ""
  设 引号 为 ""
  设 载荷 为 ""
  设 载荷深度 为 0
  设 位置 为 0
  设 总数 为 字符串长度(命令)
  当 位置 < 总数:
    设 字符 为 截取(命令, 位置, 位置 + 1)
    如果 载荷深度 > 0:
      # $() 载荷收集：括号配对，内容进 载荷
      如果 字符 == "(":
        设 载荷深度 为 载荷深度 + 1
        设 载荷 为 载荷 + 字符
      否则:
        如果 字符 == ")":
          设 载荷深度 为 载荷深度 - 1
          如果 载荷深度 == 0:
            列表追加(载荷表, 载荷)
            设 载荷 为 ""
            设 当前 为 当前 + ")"
            设 位置 为 位置 + 1
            继续
        设 载荷 为 载荷 + 字符
      设 位置 为 位置 + 1
      继续
    # 非载荷态
    如果 字符 == "'" 且 引号 == "":
      设 引号 为 "'"
      设 当前 为 当前 + 字符
      设 位置 为 位置 + 1
      继续
    如果 字符 == "\"" 且 引号 == "":
      设 引号 为 "\""
      设 当前 为 当前 + 字符
      设 位置 为 位置 + 1
      继续
    如果 引号 != "" 且 字符 == 引号:
      设 引号 为 ""
      设 当前 为 当前 + 字符
      设 位置 为 位置 + 1
      继续
    # 反引号载荷（单引号内不进到这里——单引号态在上一分支已消费字符）
    如果 字符 == "`" 且 (引号 == "" 或 引号 == "\""):
      设 止 为 命令.查找("`", 位置 + 1)
      如果 止 > 位置:
        列表追加(载荷表, 截取(命令, 位置 + 1, 止))
        设 当前 为 当前 + "`"
        设 位置 为 止 + 1
        继续
    # 顶层连接符（引号外）
    如果 引号 == "":
      如果 字符 == "|":
        如果 位置 + 1 < 总数 且 截取(命令, 位置 + 1, 位置 + 2) == "|":
          列表追加(段表, 当前)
          设 当前 为 ""
          设 位置 为 位置 + 2
          继续
        列表追加(段表, 当前)
        设 当前 为 ""
        设 位置 为 位置 + 1
        继续
      如果 字符 == "&":
        如果 位置 + 1 < 总数 且 截取(命令, 位置 + 1, 位置 + 2) == "&":
          列表追加(段表, 当前)
          设 当前 为 ""
          设 位置 为 位置 + 2
          继续
        列表追加(段表, 当前)
        设 当前 为 ""
        设 位置 为 位置 + 1
        继续
      如果 字符 == ";" 或 字符 == "\n":
        列表追加(段表, 当前)
        设 当前 为 ""
        设 位置 为 位置 + 1
        继续
      # $() 开启：前一个字符是 $ 且本字符是 (
      如果 字符 == "(" 且 结尾(当前, "$"):
        设 载荷深度 为 1
        设 当前 为 当前 + "("
        设 位置 为 位置 + 1
        继续
    设 当前 为 当前 + 字符
    设 位置 为 位置 + 1
  列表追加(段表, 当前)
  遍历 载荷项 之 载荷表:
    列表追加(段表, 载荷项)
  返回 段表

# ---- 引号感知按空白切词：词保留原文（目标判定用 去引号 后再解析）----
段落 命令风险切词(段文本):
  设 词表 为 []
  设 当前 为 ""
  设 引号 为 ""
  设 有词 为 假
  设 位置 为 0
  设 总数 为 字符串长度(段文本)
  当 位置 < 总数:
    设 字符 为 截取(段文本, 位置, 位置 + 1)
    如果 引号 != "":
      如果 字符 == 引号:
        设 引号 为 ""
      设 当前 为 当前 + 字符
      设 位置 为 位置 + 1
      继续
    如果 字符 == "'" 或 字符 == "\"":
      设 引号 为 字符
      设 当前 为 当前 + 字符
      设 有词 为 真
      设 位置 为 位置 + 1
      继续
    如果 字符 == " " 或 字符 == "\t":
      如果 有词 == 真:
        列表追加(词表, 当前)
        设 当前 为 ""
        设 有词 为 假
      设 位置 为 位置 + 1
      继续
    设 当前 为 当前 + 字符
    设 有词 为 真
    设 位置 为 位置 + 1
  如果 有词 == 真:
    列表追加(词表, 当前)
  返回 词表

# ---- 段内裸 `>` 覆盖判定：引号外；`>>` 追加、fd 重定向（2> / >&）不拦 ----
#   命中=目标已存在的普通文件（`>` 到新文件是合法构建输出，不拦）；目标是目录时报错不算覆盖。
段落 重定向覆盖命中(段文本, 当前目录):
  设 位置 为 0
  设 总数 为 字符串长度(段文本)
  设 引号 为 ""
  设 前字 为 ""
  当 位置 < 总数:
    设 字符 为 截取(段文本, 位置, 位置 + 1)
    如果 引号 != "":
      如果 字符 == 引号:
        设 引号 为 ""
      设 前字 为 字符
      设 位置 为 位置 + 1
      继续
    如果 字符 == "'" 或 字符 == "\"":
      设 引号 为 字符
      设 前字 为 字符
      设 位置 为 位置 + 1
      继续
    如果 字符 == ">":
      # `>>` 追加：跳过第二个 >，不判
      如果 前字 == ">":
        设 前字 为 ""
        设 位置 为 位置 + 1
        继续
      # `>&` fd 复制：不判
      如果 前字 == "&":
        设 前字 为 ""
        设 位置 为 位置 + 1
        继续
      # fd 重定向 `2>` / `1>`：不判（stderr/stdout 落盘是常规日志行为）
      设 是fd 为 假
      如果 前字 >= "0" 且 前字 <= "9":
        设 是fd 为 真
      设 后位 为 位置 + 1
      设 后字 为 ""
      如果 后位 < 总数:
        设 后字 为 截取(段文本, 后位, 后位 + 1)
      如果 是fd == 假 且 后字 != ">":
        # 裸 `>`：取目标词（跳过空白，取到空白为止）
        设 扫 为 后位
        当 扫 < 总数:
          设 扫字 为 截取(段文本, 扫, 扫 + 1)
          如果 扫字 == " " 或 扫字 == "\t":
            设 扫 为 扫 + 1
            继续
          跳出
        设 词止 为 扫
        当 词止 < 总数:
          设 词字 为 截取(段文本, 词止, 词止 + 1)
          如果 词字 == " " 或 词字 == "\t":
            跳出
          设 词止 为 词止 + 1
        设 目标 为 去引号(截取(段文本, 扫, 词止))
        如果 目标 != "":
          设 绝对 为 绝对路径(连接路径(当前目录, 目标))
          如果 文件存在(绝对):
            返回 ["命中": 真, "目标": 绝对]
      设 前字 为 字符
      设 位置 为 位置 + 1
      继续
    设 前字 为 字符
    设 位置 为 位置 + 1
  返回 ["命中": 假, "目标": ""]

# ---- 单段语义判定：命令名 + 旗标 + mv 目标存在性 ----
#   返回 {"命中": 真/假, "模式": "", "理由": ""}；命中即明确破坏性模式。
段落 命令风险单段判定(段文本, 当前目录, 深度):
  设 词表 为 命令风险切词(段文本)
  设 词数 为 长(词表)
  设 指 为 0
  # 吞赋值 / export / 包装词前缀，找首有效命令名
  当 指 < 词数:
    设 文 为 词表[指]
    如果 文 == "export":
      设 指 为 指 + 1
      继续
    # FOO=bar 赋值前缀（首字符非 - 且含 =）
    如果 截取(文, 0, 1) != "-" 且 文.查找("=") > 0:
      设 指 为 指 + 1
      继续
    如果 是包装词(文):
      设 指 为 指 + 1
      # 包装词自己的短选项（sudo -E / nice -n 5 / env -i），单独 "-" 不是选项
      当 指 < 词数:
        设 选 为 词表[指]
        如果 截取(选, 0, 1) == "-" 且 选 != "-":
          设 指 为 指 + 1
          继续
        跳出
      继续
    跳出
  如果 指 >= 词数:
    返回 ["命中": 假, "模式": "", "理由": ""]
  # 命令名可能整个带引号（eval "rm -rf x" 载荷切词后首词含引号）→ 去引号再比
  设 命令名 为 去引号(词表[指])
  # eval / 外壳 -c：载荷是命令文本，递归判定（深度受限）
  #   外壳词先跳过自己的旗标（-c / -lc / -e 等，全部以 - 开头）再拼载荷；
  #   载荷整体被一对引号包裹时先去引号（切词后是带引号的整串，直接判会把
  #   "rm -rf x" 当成一个词）；未包裹/多词载荷原样按文本判定。
  如果 深度 < 命令风险递归上限 且 (命令名 == "eval" 或 是外壳词(命令名)):
    设 扫 为 指 + 1
    如果 是外壳词(命令名):
      当 扫 < 词数:
        设 选 为 词表[扫]
        如果 截取(选, 0, 1) == "-" 且 选 != "-":
          设 扫 为 扫 + 1
          继续
        跳出
    设 载荷 为 ""
    当 扫 < 词数:
      设 载荷 为 载荷 + 词表[扫] + " "
      设 扫 为 扫 + 1
    如果 载荷 != "":
      设 内层 为 命令风险文本判定(去引号(去除空白(载荷)), 当前目录, 深度 + 1)
      如果 内层["高危"] == 真:
        返回 ["命中": 真, "模式": 内层["模式"], "理由": 内层["理由"]]
    返回 ["命中": 假, "模式": "", "理由": ""]
  # rm：递归旗标即递归强删；无递归（含 -f 单文件）不升级
  如果 命令名 == "rm":
    设 扫 为 指 + 1
    当 扫 < 词数:
      设 词 为 词表[扫]
      如果 是递归旗标(词):
        返回 ["命中": 真, "模式": "递归强删",
          "理由": "rm 带递归旗标（" + 词 + "）将删除目录树，不可逆"]
      设 扫 为 扫 + 1
    返回 ["命中": 假, "模式": "", "理由": ""]
  # mv：强制旗标即覆盖移动；一源一目标且目标已存在（非目录）→ 默认覆盖语义
  如果 命令名 == "mv":
    设 扫 为 指 + 1
    设 参数数 为 0
    设 目标 为 ""
    设 有禁止覆盖 为 假
    当 扫 < 词数:
      设 词 为 词表[扫]
      如果 是强制旗标(词):
        返回 ["命中": 真, "模式": "覆盖移动",
          "理由": "mv 带强制旗标（" + 词 + "），目标将被无提示覆盖"]
      如果 是禁止覆盖旗标(词):
        设 有禁止覆盖 为 真
      否则:
        如果 截取(词, 0, 1) == "-":
          设 扫 为 扫 + 1
          继续
        设 参数数 为 参数数 + 1
        设 目标 为 词
      设 扫 为 扫 + 1
    如果 有禁止覆盖 == 真:
      返回 ["命中": 假, "模式": "", "理由": ""]
    如果 参数数 == 2 且 目标 != "":
      设 绝对 为 绝对路径(连接路径(当前目录, 去引号(目标)))
      如果 文件存在(绝对):
        返回 ["命中": 真, "模式": "覆盖移动",
          "理由": "mv 目标 " + 目标 + " 已存在，默认覆盖语义将替换其内容"]
    返回 ["命中": 假, "模式": "", "理由": ""]
  # chmod/chown/chgrp：递归变更高危；chmod 777 属宽权限变更
  如果 命令名 == "chmod" 或 命令名 == "chown" 或 命令名 == "chgrp":
    设 扫 为 指 + 1
    当 扫 < 词数:
      设 词 为 词表[扫]
      如果 词 == "-R" 或 词 == "--recursive":
        返回 ["命中": 真, "模式": "递归权限变更",
          "理由": 命令名 + " 带递归旗标将批量改写权限/归属，回滚面大"]
      如果 命令名 == "chmod":
        设 模式 为 去引号(词)
        如果 模式 == "777" 或 模式 == "0777":
          返回 ["命中": 真, "模式": "宽权限变更",
            "理由": "chmod 777 将路径开放为全用户可写，属宽权限变更"]
      设 扫 为 扫 + 1
    返回 ["命中": 假, "模式": "", "理由": ""]
  # 其余命令（含 cp/管道只读等）：不按命令名升级，仅统一看下面的重定向判定
  返回 ["命中": 假, "模式": "", "理由": ""]

# ---- 文本级判定：切段逐段（命令名判定 + 重定向判定），载荷递归共用 ----
#   返回 {"高危": 真/假, "模式": "", "理由": "", "命中段": ""}
段落 命令风险文本判定(命令, 当前目录, 深度):
  设 段表 为 命令风险切段(命令)
  遍历 段 之 段表:
    设 去空 为 去除空白(段)
    如果 去空 == "":
      继续
    设 判 为 命令风险单段判定(去空, 当前目录, 深度)
    如果 判["命中"] == 真:
      返回 ["高危": 真, "模式": 判["模式"], "理由": 判["理由"], "命中段": 去空]
    设 重判 为 重定向覆盖命中(去空, 当前目录)
    如果 重判["命中"] == 真:
      返回 ["高危": 真, "模式": "重定向覆盖",
        "理由": "`>` 目标 " + 重判["目标"] + " 已存在，重定向将覆盖其内容",
        "命中段": 去空]
  返回 ["高危": 假, "模式": "", "理由": "", "命中段": ""]

# ---- 主入口：命令文本 → 高危判定（工具执行.light 确认门控消费）----
#   基准目录 为空时取进程当前目录；返回 {"高危": 真/假, "模式": "", "理由": "", "命中段": ""}
段落 识别命令风险(命令, 基准目录 = 空):
  如果 命令风险逃生() == 真:
    返回 ["高危": 假, "模式": "", "理由": "", "命中段": ""]
  如果 命令 == 空 或 命令 == "":
    返回 ["高危": 假, "模式": "", "理由": "", "命中段": ""]
  如果 是字符串(命令) == 假:
    设 命令 为 转字符串(命令)
  设 目录 为 基准目录
  如果 目录 == 空 或 目录 == "":
    设 目录 为 当前目录()
  返回 命令风险文本判定(命令, 目录, 0)

# =====================================================================
# T-0509 前置校验：破坏性命令（rm / mv）的目标路径
#
#   动机：`bash` 在静态分级里恒为 irreversible（最坏情形），T-0510 已按命令语义
#   识别「明确破坏性」模式（递归强删 / 覆盖移动 / 重定向覆盖 / 权限变更）。
#   但风险门控之外的**路径层**还差一步：破坏性命令的目标到底落在哪。
#   本节点复用本模块已有的切段/切词与 解析安全路径，给执行器提供
#   「rm / mv 的每个目标是否仍在工具根内」这一可复核前置校验：
#     - 绝对路径：按预期根判定，根外即不通过；
#     - 相对路径：按工具根（会话 cwd / HARNESS_ROOT）解析后再判定，根内通过；
#     - 只校验 rm / mv 的操作数，不扩到 cp / 只读命令（保持低误拦）；
#     - 逃生舱沿用 命令风险逃生()（HARNESS_CMD_RISK_OFF=1）。
#   调用方：工具执行.light §7c 具前置校验（与确认门控串联，不另造路径校验）。
# =====================================================================

# 命令破坏性目标(命令) -> 目标词表（rm / mv 的非旗标操作数，已去引号）
#   只做词法提取，不做路径判定；判定见 校验破坏性命令目标。
段落 命令破坏性目标(命令):
  设 目标表 为 []
  如果 是字符串(命令) == 假:
    返回 目标表
  设 段表 为 命令风险切段(命令)
  遍历 段 之 段表:
    设 去空 为 去除空白(段)
    如果 去空 == "":
      继续
    设 词表 为 命令风险切词(去空)
    设 词数 为 长(词表)
    设 指 为 0
    # 吞赋值 / export / 包装词前缀，找首有效命令名（与 命令风险单段判定 同口径）
    当 指 < 词数:
      设 文 为 词表[指]
      如果 文 == "export":
        设 指 为 指 + 1
        继续
      如果 截取(文, 0, 1) != "-" 且 文.查找("=") > 0:
        设 指 为 指 + 1
        继续
      如果 是包装词(文):
        设 指 为 指 + 1
        当 指 < 词数:
          设 选 为 词表[指]
          如果 截取(选, 0, 1) == "-" 且 选 != "-":
            设 指 为 指 + 1
            继续
          跳出
        继续
      跳出
    如果 指 >= 词数:
      继续
    设 命令名 为 去引号(词表[指])
    如果 命令名 != "rm" 且 命令名 != "mv":
      继续
    设 扫 为 指 + 1
    当 扫 < 词数:
      设 词 为 去引号(词表[扫])
      如果 词 != "" 且 截取(词, 0, 1) != "-":
        列表追加(目标表, 词)
      设 扫 为 扫 + 1
  返回 目标表

# 校验破坏性命令目标(命令, 基准目录 = 空) -> {"通过":真/假, "理由":"", "目标表":[]}
#   目标表 每项 {"词","绝对路径","是绝对"}；不通过时 理由 指出第一个越界目标。
段落 校验破坏性命令目标(命令, 基准目录 = 空):
  设 记录 为 []
  设 结果 为 {"通过": 真, "理由": "", "目标表": 记录}
  如果 命令风险逃生() == 真:
    返回 结果
  如果 命令 == 空 或 命令 == "":
    返回 结果
  如果 是字符串(命令) == 假:
    设 命令 为 转字符串(命令)
  设 目标表 为 命令破坏性目标(命令)
  如果 长(目标表) == 0:
    返回 结果
  设 根 为 基准目录
  如果 根 == 空 或 根 == "":
    设 根 为 取根目录()
  设 位置 为 0
  当 位置 < 长(目标表):
    设 词 为 目标表[位置]
    设 解 为 解析安全路径(根, 词)
    如果 解["ok"] == 假:
      返回 {"通过": 假,
        "理由": "目标 \"" + 词 + "\" 不在工具根内（" +
          字典获取(解, "理由", "越界") + "）",
        "目标表": 记录}
    列表追加(记录, {"词": 词, "绝对路径": 解["路径"], "是绝对": os.path.isabs(词)})
    设 位置 为 位置 + 1
  返回 结果
