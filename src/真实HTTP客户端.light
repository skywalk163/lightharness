# 真实HTTP客户端.light —— R41 任务2（真实网络IO）
#
# 用光明 socket 原语实现真实 HTTP/1.1 客户端（GET/POST），作为 #47 web-fetch 的真实
# 请求提供者。设计对齐 stdlib/HTTP服务端.light 的「非阻塞 + 探测就绪 + 让步」轮询模式：
#   - socket 显式 setblocking(假)（POSIX 不继承 O_NONBLOCK，必须显式置，S2 H1 教训）；
#   - connect/send/recv 全部非阻塞，靠 探测就绪 + 异步睡眠 让步，绝不阻塞事件循环
#     （客户端跑在测试主协程里，若阻塞会冻住服务端 处理循环 任务 → 死锁）；
#   - 每次请求一个 monotonic 截止（超时），超时抛 连接中断/读取错误，禁止无限挂起。
#
# 复用 HTTP服务端 暴露的选择器原语，避免重复造轮子。

导入 socket
从 HTTP服务端 导入 新建选择器, 探测就绪, 是否愿等读, 是否愿等写, 关闭选择器, 连接中断, 读取错误

# 异常文本：绕开 e.参数 语言缺陷（同 HTTP服务端.异常文本）
段落 异常文本 接收 e:
  设 a 为 e.args
  如果 长(a) > 0:
    返回 转字符串(a[0])
  返回 ""

# ---- GET ----
异步 段落 真实GET 接收 主机, 端口, 路径, 令牌="", 超时值=5.0:
  返回 等待 真实请求("GET", 主机, 端口, 路径, "", 令牌, 超时值)

# ---- POST ----
异步 段落 真实POST 接收 主机, 端口, 路径, 体文本, 令牌="", 超时值=5.0:
  返回 等待 真实请求("POST", 主机, 端口, 路径, 体文本, 令牌, 超时值)

# ---- 统一请求：非阻塞 connect → 非阻塞 send 循环 → 非阻塞 recv 直到对端关闭 ----
#   返回 ["状态": int(HTTP 状态码), "头": str, "体": str]
异步 段落 真实请求 接收 方法, 主机, 端口, 路径, 体文本, 令牌, 超时值:
  # 构造请求文本（Connection: close → 服务端响应后主动关闭，客户端 recv 到 0 即结束）
  设 头表 为 []
  头表.追加(方法 + " " + 路径 + " HTTP/1.1")
  头表.追加("Host: " + 主机)
  如果 令牌 != "" 且 令牌 != 空:
    头表.追加("X-Auth-Token: " + 令牌)
  如果 方法 == "POST":
    头表.追加("Content-Type: application/json")
    头表.追加("Content-Length: " + 转字符串(长(体文本.encode("utf-8"))))
  头表.追加("Connection: close")
  设 请求文本 为 ""
  设 i 为 0
  当 i < 长(头表):
    设 请求文本 为 请求文本 + 头表[i] + "\r\n"
    设 i 为 i + 1
  设 请求文本 为 请求文本 + "\r\n"
  如果 方法 == "POST":
    设 请求文本 为 请求文本 + 体文本
  设 请求字节 为 请求文本.encode("utf-8")

  设 套接字 为 socket.socket(socket.AF_INET, socket.SOCK_STREAM)
  套接字.setblocking(假)
  设 选择器 为 新建选择器()
  设 缓存 为 b""
  尝试:
    # ---- connect：非阻塞可能 EINPROGRESS，等写就绪 ----
    尝试:
      套接字.connect((主机, 端口))
    捕获 异常 e:
      设 截止 为 单调时钟() + 超时值
      当 真:
        如果 探测就绪(选择器, 套接字, "写"):
          跳出
        如果 单调时钟() >= 截止:
          抛出 新建 连接中断("连接超时")
        等待 异步睡眠(0.0005)
    # ---- send：非阻塞 send 循环（send 不保证一次发完）----
    设 偏移 为 0
    设 截止 为 单调时钟() + 超时值
    当 偏移 < 长(请求字节):
      尝试:
        设 已发 为 套接字.send(请求字节[偏移:])
        设 偏移 为 偏移 + 已发
      捕获 异常 e:
        如果 是否愿等写(e):
          如果 单调时钟() >= 截止:
            抛出 新建 连接中断("发送超时")
          如果 探测就绪(选择器, 套接字, "写"):
            等待 异步睡眠(0)
          否则:
            等待 异步睡眠(0.0005)
        否则:
          抛出 新建 连接中断("发送失败: " + 异常文本(e))
    # ---- recv：非阻塞 recv，直到对端关闭（recv==0）----
    设 截止 为 单调时钟() + 超时值
    当 真:
      设 块 为 空
      尝试:
        设 块 为 套接字.recv(4096)
      捕获 异常 e:
        如果 是否愿等读(e):
          如果 单调时钟() >= 截止:
            抛出 新建 读取错误("读取超时")
          如果 探测就绪(选择器, 套接字, "读"):
            等待 异步睡眠(0)
          否则:
            等待 异步睡眠(0.0005)
          继续
        否则:
          抛出 新建 读取错误("读取失败: " + 异常文本(e))
      如果 长(块) == 0:
        跳出
      设 缓存 为 缓存 + 块
    套接字.close()
  最终:
    关闭选择器(选择器)

  # ---- 解析：状态行 + 头 + 体 ----
  设 分隔 为 缓存.查找(b"\r\n\r\n")
  如果 分隔 < 0:
    返回 ["状态": 0, "头": "", "体": 字符串(缓存, "utf-8")]
  设 头区块 为 缓存[0:分隔]
  设 体字节 为 缓存[分隔 + 4:]
  设 头文本 为 字符串(头区块, "utf-8")
  设 行表 为 头文本.分割("\r\n")
  设 首行 为 行表[0]
  设 部分 为 首行.分割(" ")
  设 状态码 为 转整数(部分[1])
  返回 ["状态": 状态码, "头": 头文本, "体": 字符串(体字节, "utf-8")]

导出 真实GET, 真实POST, 真实请求
