# 子代理深化.light —— 第34轮 任务3：子代理深化
#
# 上游（只读）：G:\github\deepseek-harness\packages\subagent\src\
#   directory.ts（子代理目录）   → §1 父属目录（层级/归属/隔离/切换）
#   inbox.ts（HumanInbox）       → §2 人类收件箱（入队/出队/已读/积压）
#   chunked-list.ts（分块列表）  → §3 不可变追加分块链表
#   depth.ts（DepthLimit）       → §4 嵌套深度限制
#
# 纯逻辑复刻：剔除真实文件系统 I/O（改内存目录树）、持久化（改内存队列）、
#             墙钟时间（改调用方传入的逻辑时刻）。
# 命名避坑：L-119 单字别名保留字（父/长/首/末/空/步/当 等勿作变量名）；
#           L-120 可被关键字序列完全切分的标识符。
# 本模块段落一律以「深」为前缀（与既有 src/分块列表.light 的 追加分块/遍历分块 区分），
# 避免 src 后端把依赖模块内联进同一份 Python 时同名段 codegen 重定义。
# 铁律：父属目录必须隔离（禁止 .. 逃逸）；ChunkedList 不可变；深度创建前检查。

# —— 第48轮 任务2 追加的依赖（只读导入，不改既有段）——
#   分块列表：catalog 投影以不可变分块链表承载 head（对齐上游 appendChunkedList/iterateChunkedList）
#   子代理核心：目录条目谓词与行构造（是目录条目/造目录行）
从 分块列表 导入 追加分块, 遍历分块, 校验分块
从 子代理核心 导入 是目录条目, 造目录行

# =====================================================================
# §0 常量
# =====================================================================

设 深块容量 为 64
设 默认最大深度 为 3
设 消息待办 为 "pending"
设 消息已读 为 "acknowledged"
设 消息已决 为 "resolved"
设 消息状态表 为 [消息待办, 消息已读, 消息已决]
设 优先级表 为 ["low", "normal", "high", "urgent"]
设 默认积压阈值 为 4

# =====================================================================
# §1 父属目录（directory.ts）
# =====================================================================

段落 建目录 接收 名称, 上级 = 空:
  如果 是字符串(名称) == 假 或 字符串长度(名称) == 0:
    抛出 新建 错误("目录名必须为非空串 [INVALID_DIR_NAME]")
  返回 {"名称": 名称, "上级": 上级, "子目录表": {}, "子代理表": {}}

段落 建目录根:
  返回 建目录("根")

段落 加子目录 接收 上级目录, 名称:
  如果 字典包含键(上级目录["子目录表"], 名称) == 真:
    抛出 新建 错误("子目录已存在：" + 名称 + " [DUPLICATE_DIR]")
  设 子 为 建目录(名称, 上级目录)
  字典设置(上级目录["子目录表"], 名称, 子)
  返回 子

段落 删子目录 接收 上级目录, 名称:
  如果 字典包含键(上级目录["子目录表"], 名称) == 假:
    返回 假
  设 新表 为 {}
  遍历 键 之 字典键列表(上级目录["子目录表"]):
    如果 键 != 名称:
      字典设置(新表, 键, 上级目录["子目录表"][键])
  字典设置(上级目录, "子目录表", 新表)
  返回 真

段落 列子目录 接收 目录:
  返回 字典键列表(目录["子目录表"])

# 目录路径：自根向下拼接
段落 目录路径 接收 目录:
  设 段栈 为 []
  设 游标 为 目录
  当 游标 != 空:
    段栈.追加(游标["名称"])
    设 游标 为 游标["上级"]
  设 结果 为 ""
  设 位置 为 长(段栈) - 1
  当 位置 >= 0:
    如果 字符串长度(结果) == 0:
      设 结果 为 段栈[位置]
    否则:
      设 结果 为 结果 + "/" + 段栈[位置]
    设 位置 为 位置 - 1
  返回 结果

# 归属：每个子代理归属且仅归属一个父目录
段落 归属目录 接收 目录, 子代理名:
  如果 字典包含键(目录["子代理表"], 子代理名) == 真:
    返回 假
  字典设置(目录["子代理表"], 子代理名, {"名称": 子代理名, "目录": 目录})
  返回 真

段落 查归属 接收 目录, 子代理名:
  返回 字典获取(目录["子代理表"], 子代理名, 空)

段落 列归属 接收 目录:
  返回 字典键列表(目录["子代理表"])

# 路径切段（去空段）
段落 切段 接收 路径:
  设 段表 为 路径.分割("/")
  设 结果 为 []
  遍历 段 之 段表:
    如果 字符串长度(段) > 0:
      结果.追加(段)
  返回 结果

# 隔离：任何 ".." 一律拒绝（子代理工作目录即其根，不得逃逸到父/兄弟目录）
段落 隔离检查 接收 起点, 路径:
  设 表 为 切段(路径)
  遍历 段 之 表:
    如果 段 == "..":
      返回 {"允许": 假, "错误码": "CROSS_DIRECTORY_DENIED",
        "原因": "禁止跨目录访问：路径含 .."}
  设 目标 为 深解析路径(起点, 路径)
  如果 目标 == 空:
    返回 {"允许": 假, "错误码": "PATH_NOT_FOUND", "原因": "路径不存在：" + 路径}
  返回 {"允许": 真, "错误码": 空, "原因": 空, "目标": 目标}

# 仅向下解析（不含 ..）
段落 深解析路径 接收 起点, 路径:
  如果 路径 == "" 或 路径 == ".":
    返回 起点
  设 当前 为 起点
  遍历 段 之 切段(路径):
    如果 字典包含键(当前["子目录表"], 段) == 假:
      返回 空
    设 当前 为 当前["子目录表"][段]
  返回 当前

段落 切换目录 接收 起点, 路径:
  设 判定 为 隔离检查(起点, 路径)
  如果 判定["允许"] == 假:
    抛出 新建 错误(判定["原因"] + " [" + 判定["错误码"] + "]")
  返回 判定["目标"]

# =====================================================================
# §2 Human Inbox（inbox.ts）
# =====================================================================

段落 建收件箱 接收 积压阈值 = 4:
  如果 积压阈值 <= 0:
    抛出 新建 错误("积压阈值必须为正 [INVALID_BACKLOG_THRESHOLD]")
  返回 {"消息表": [], "序号": 0, "积压阈值": 积压阈值}

段落 建消息 接收 序号, 发送者, 内容, 优先级, 时刻:
  返回 {"序号": 序号, "sender": 发送者, "content": 内容,
    "priority": 优先级, "status": 消息待办, "createdAt": 时刻}

段落 投入消息 接收 收件箱, 发送者, 内容, 优先级 = "normal", 时刻 = 0:
  如果 是字符串(发送者) == 假 或 字符串长度(发送者) == 0:
    抛出 新建 错误("发送者必须为非空串 [INVALID_SENDER]")
  如果 优先级表.包含(优先级) == 假:
    抛出 新建 错误("未知优先级：" + 转字符串(优先级) + " [UNKNOWN_PRIORITY]")
  设 序号 为 收件箱["序号"] + 1
  设 消息 为 建消息(序号, 发送者, 内容, 优先级, 时刻)
  收件箱["消息表"].追加(消息)
  字典设置(收件箱, "序号", 序号)
  返回 消息

# 优先级权重：urgent > high > normal > low
段落 优先级权重 接收 优先级:
  如果 优先级 == "urgent":
    返回 3
  如果 优先级 == "high":
    返回 2
  如果 优先级 == "normal":
    返回 1
  返回 0

# 出队：优先级高者先出，同级按入队序号
段落 取待办 接收 收件箱:
  设 最佳 为 空
  遍历 消息 之 收件箱["消息表"]:
    如果 消息["status"] == 消息待办:
      如果 最佳 == 空:
        设 最佳 为 消息
      否则:
        如果 优先级权重(消息["priority"]) > 优先级权重(最佳["priority"]):
          设 最佳 为 消息
  如果 最佳 == 空:
    返回 空
  字典设置(最佳, "status", 消息已读)
  返回 最佳

段落 标记已读 接收 收件箱, 序号:
  遍历 消息 之 收件箱["消息表"]:
    如果 消息["序号"] == 序号:
      如果 消息["status"] == 消息待办:
        字典设置(消息, "status", 消息已读)
        返回 真
      返回 假
  返回 假

段落 标记已决 接收 收件箱, 序号:
  遍历 消息 之 收件箱["消息表"]:
    如果 消息["序号"] == 序号:
      字典设置(消息, "status", 消息已决)
      返回 真
  返回 假

段落 列举消息 接收 收件箱, 状态 = 空:
  设 结果 为 []
  遍历 消息 之 收件箱["消息表"]:
    如果 状态 == 空:
      结果.追加(消息)
    否则:
      如果 消息["status"] == 状态:
        结果.追加(消息)
  返回 结果

段落 待办数 接收 收件箱:
  返回 长(列举消息(收件箱, 消息待办))

# 积压判定：待办数达到阈值即积压
段落 是否积压 接收 收件箱:
  返回 待办数(收件箱) >= 收件箱["积压阈值"]

# =====================================================================
# §3 ChunkedList（chunked-list.ts）—— 不可变追加链表
# =====================================================================

# 空列表 = 空；节点 = {"值表": [...], "前件": 上一节点 或 无}
段落 深追加 接收 头, 值:
  如果 头 == 空:
    返回 {"值表": [值]}
  如果 长(头["值表"]) >= 深块容量:
    返回 {"值表": [值], "前件": 头}
  # 不可变：复制最新块，旧块共享
  设 新值表 为 []
  遍历 旧值 之 头["值表"]:
    新值表.追加(旧值)
  新值表.追加(值)
  设 新节点 为 {"值表": 新值表}
  如果 字典包含键(头, "前件") == 真:
    字典设置(新节点, "前件", 头["前件"])
  返回 新节点

段落 深栈 接收 头:
  设 块栈 为 []
  设 游标 为 头
  当 游标 != 空:
    块栈.追加(游标)
    如果 字典包含键(游标, "前件") == 真:
      设 游标 为 游标["前件"]
    否则:
      设 游标 为 空
  返回 块栈

# 正序展平（插入序）
段落 深展平 接收 头:
  设 块栈 为 深栈(头)
  设 结果 为 []
  设 位置 为 长(块栈) - 1
  当 位置 >= 0:
    遍历 值 之 块栈[位置]["值表"]:
      结果.追加(值)
    设 位置 为 位置 - 1
  返回 结果

# 逆序展平（最新优先）
段落 深逆展平 接收 头:
  设 块栈 为 深栈(头)
  设 结果 为 []
  遍历 块 之 块栈:
    设 位置 为 长(块["值表"]) - 1
    当 位置 >= 0:
      结果.追加(块["值表"][位置])
      设 位置 为 位置 - 1
  返回 结果

段落 深分块长 接收 头:
  返回 长(深展平(头))

段落 深块数 接收 头:
  返回 长(深栈(头))

# 校验：每块非空且不超过容量
段落 深校验 接收 头:
  如果 头 == 空:
    返回 真
  遍历 块 之 深栈(头):
    设 表 为 块["值表"]
    如果 长(表) == 0 或 长(表) > 深块容量:
      返回 假
  返回 真

# =====================================================================
# §4 深度限制（depth.ts）
# =====================================================================

段落 建子代理 接收 名称, 上级 = 空:
  如果 是字符串(名称) == 假 或 字符串长度(名称) == 0:
    抛出 新建 错误("子代理名必须为非空串 [INVALID_SUBAGENT_NAME]")
  设 深度 为 1
  如果 上级 != 空:
    设 深度 为 上级["深度"] + 1
  返回 {"名称": 名称, "深度": 深度, "上级": 上级, "子代表": []}

# 创建前检查（铁律）：子代深度 = 当前 + 1，超过上限即拒
段落 可否派生 接收 代理, 最大深度 = 3:
  如果 代理 == 空:
    返回 真
  如果 最大深度 <= 0:
    返回 假
  返回 代理["深度"] + 1 <= 最大深度

段落 派生子代 接收 代理, 名称, 最大深度 = 3:
  如果 可否派生(代理, 最大深度) == 假:
    抛出 新建 错误("超出子代理最大深度 " + 转字符串(最大深度) +
      " [SUBAGENT_DEPTH_EXCEEDED]，建议合并子任务或提升深度上限")
  设 子 为 建子代理(名称, 代理)
  代理["子代表"].追加(子)
  返回 子

段落 代理链 接收 代理:
  设 链 为 []
  设 游标 为 代理
  当 游标 != 空:
    链.追加(游标["名称"])
    设 游标 为 游标["上级"]
  返回 链

# 链路深度应与自身深度一致（不变量校验）
段落 深度自洽 接收 代理:
  返回 长(代理链(代理)) == 代理["深度"]

段落 子代数 接收 代理:
  返回 长(代理["子代表"])

