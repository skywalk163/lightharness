# 宿主运行时.light —— 第17轮 宿主接线原型：虚拟宿主运行时核心（对标 #110，原型设计）
# 上游参考（设计灵感，非逐行复刻）：Cordis Context/Service/插件生命周期、packages/boot 启动流程、
#   packages/core/session/src/index.ts 插件结构。
#
# 设计（R17-D1 架构差异登记）：
#   1. 运行时状态机：未初始化 -> 初始化中 -> 运行中 -> 停止中 -> 已停止；任意运行路径失败 -> 错误态。
#      非法转换抛错（如未初始化就停止）。
#   2. 插件形状：{名称, 版本, 依赖列表(插件名), 提供服务列表, 监听事件列表,
#                 安装(函数), 启动(函数), 停止(函数), 卸载(函数)}——钩子接收 插件上下文：
#                 {运行时, 插件名, 注册服务(函数), 依赖服务(函数), 时间}。
#   3. 插件加载器：注册到待加载表；启动时 拓扑排序（依赖先于被依赖，Kahn）+ 依赖缺失检测 +
#      依赖循环检测 + 错误隔离（单插件失败记录错误继续，依赖其服务的后续插件在注入时报缺失）。
#   4. 服务注册表：{服务名: {实例, 提供者}}；注册重复抛；获取缺失抛；尝试获取返回 空。
#      依赖注入：插件启动钩子第二参= 依赖服务名 -> 实例 的字典。
#   5. 运行时事件（轻量监听器表，发布模式，不做 waterfall）：
#      运行时/启动前 运行时/启动后 运行时/停止前 运行时/停止后
#      运行时/插件安装前 运行时/插件安装后 运行时/插件启动失败 运行时/插件停止。
#   6. 元数据：版本/启动时间（注入时间值）/运行时长（获取元数据 时注入当前时间）/插件计数/服务计数。
#
# 绕法：内置裸名（L-090）、无 且/或 行内链（L-043）、标识符避关键字与单字别名切分（L-119/L-120/L-084）、
#   无花括号文案（L-089）、可选键先 字典包含键（L-103）、双层赋值用 字典设置（L-123）、
#   变量名避「尝试」关键字（L-137）。

导出 运行时状态表 是否可转换 造运行时 造插件 注册插件 拓扑排序插件 启动 停止 重启 获取状态 获取元数据 注册服务 获取服务 尝试获取服务 列举服务 监听运行时事件 派发运行时事件。

# 状态集（逐字）
设 运行时状态表 为 ["未初始化", "初始化中", "运行中", "停止中", "已停止", "错误"]

# 合法转换表：{当前: [合法目标...]}；任意态可入「错误」由 异常路径单独处理
段落 是否可转换(当前, 目标):
  如果 当前 == "未初始化":
    如果 目标 == "初始化中":
      返回 真
  如果 当前 == "初始化中":
    如果 目标 == "运行中":
      返回 真
    如果 目标 == "错误":
      返回 真
  如果 当前 == "运行中":
    如果 目标 == "停止中":
      返回 真
  如果 当前 == "停止中":
    如果 目标 == "已停止":
      返回 真
    如果 目标 == "错误":
      返回 真
  返回 假

# 转换：非法转换抛错
段落 转换状态(运行时, 目标):
  如果 是否可转换(运行时["状态"], 目标) == 假:
    抛出 新建 错误("非法运行时状态转换: " + 运行时["状态"] + " -> " + 目标)
  运行时["状态"] 为 目标
  返回 目标

# 造运行时：版本由调用方给定
段落 造运行时(版本):
  设 运行时 为 {}
  运行时["状态"] 为 "未初始化"
  运行时["版本"] 为 版本
  运行时["插件表"] 为 {}
  运行时["加载序"] 为 []
  运行时["服务表"] 为 {}
  运行时["监听器表"] 为 {}
  运行时["错误记录"] 为 []
  运行时["启动时间"] 为 空
  运行时["停止时间"] 为 空
  返回 运行时

# 造插件：钩子缺省为空操作（调用方覆盖）
段落 造插件(名称, 版本, 依赖列表, 提供服务列表, 监听事件列表, 安装函数, 启动函数, 停止函数, 卸载函数):
  设 插件 为 {}
  插件["名称"] 为 名称
  插件["版本"] 为 版本
  插件["依赖列表"] 为 依赖列表
  插件["提供服务列表"] 为 提供服务列表
  插件["监听事件列表"] 为 监听事件列表
  插件["安装"] 为 安装函数
  插件["启动"] 为 启动函数
  插件["停止"] 为 停止函数
  插件["卸载"] 为 卸载函数
  返回 插件

# 注册插件：仅未初始化态可注册（运行中注册属动态加载，原型不开放，登记 R17-D1）
段落 注册插件(运行时, 插件):
  如果 运行时["状态"] != "未初始化":
    抛出 新建 错误("运行时已启动，不能再注册插件: " + 插件["名称"])
  如果 字典包含键(运行时["插件表"], 插件["名称"]):
    抛出 新建 错误("插件重复注册: " + 插件["名称"])
  设 运行时["插件表"][插件["名称"]] 为 插件
  返回 插件["名称"]

# 依赖缺失检测：返回缺失依赖名列表（首个即报）
段落 缺失依赖(插件表, 名称):
  设 插件 为 字典获取(插件表, 名称, 空)
  设 缺表 为 []
  遍历 依赖 之 插件["依赖列表"]:
    如果 字典包含键(插件表, 依赖) == 假:
      列表追加(缺表, 依赖)
  返回 缺表

# 拓扑排序（Kahn）：依赖先于被依赖；依赖缺失/循环抛错（反跑 C 锚点段落）
段落 拓扑排序插件(插件表):
  # 依赖缺失检测
  遍历 名称 之 字典键列表(插件表):
    设 缺表 为 缺失依赖(插件表, 名称)
    如果 列表长度(缺表) > 0:
      抛出 新建 错误("插件依赖缺失: " + 名称 + " 依赖 " + 缺表[0])
  # 入度表 + 邻接表（依赖 -> 依赖者们）
  设 入度表 为 {}
  设 邻接表 为 {}
  遍历 名称 之 字典键列表(插件表):
    设 入度表[名称] 为 列表长度(插件表[名称]["依赖列表"])
  遍历 名称 之 字典键列表(插件表):
    遍历 依赖 之 插件表[名称]["依赖列表"]:
      如果 字典包含键(邻接表, 依赖) == 假:
        设 邻接表[依赖] 为 []
      列表追加(邻接表[依赖], 名称)
  # Kahn：每轮取一个入度 0 且未被排出的节点（按名称稳定序）
  设 已排表 为 []
  设 剩余数 为 列表长度(字典键列表(插件表))
  当 列表长度(已排表) < 剩余数:
    设 选中 为 ""
    设 名称序 为 排序文本表(字典键列表(插件表))
    遍历 名称 之 名称序:
      如果 选中 == "":
        如果 字典包含键(入度表, 名称):
          如果 入度表[名称] == 0:
            设 已排 为 假
            遍历 已名 之 已排表:
              如果 已名 == 名称:
                设 已排 为 真
            如果 已排 == 假:
              设 选中 为 名称
    如果 选中 == "":
      # 无可排节点 -> 依赖循环
      抛出 新建 错误("插件依赖循环: 涉及 " + 转字符串(列表长度(字典键列表(插件表)) - 列表长度(已排表)) + " 个插件")
    列表追加(已排表, 选中)
    字典删除(入度表, 选中)
    如果 字典包含键(邻接表, 选中):
      遍历 依赖者 之 邻接表[选中]:
        设 入度表[依赖者] 为 字典获取(入度表, 依赖者, 0) - 1
  返回 已排表

# 文本升序选择排序（辅助）
段落 排序文本表(名单):
  设 结果 为 []
  遍历 名字 之 名单:
    列表追加(结果, 名字)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 结果[内] < 结果[最小]:
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时 为 结果[外]
      设 结果[外] 为 结果[最小]
      设 结果[最小] 为 临时
    设 外 为 外 + 1
  返回 结果

# 运行时事件（轻量监听器表）
段落 监听运行时事件(运行时, 事件名, 处理器):
  设 表 为 运行时["监听器表"]
  如果 字典包含键(表, 事件名) == 假:
    设 表[事件名] 为 []
  列表追加(表[事件名], 处理器)
  返回 真

段落 派发运行时事件(运行时, 事件名, 数据):
  设 表 为 运行时["监听器表"]
  如果 字典包含键(表, 事件名) == 假:
    返回 假
  遍历 处理器 之 表[事件名]:
    处理器(数据)
  返回 真

# 插件上下文构造（钩子第一参；服务依赖注入：依赖服务(服务名) 查服务表）
段落 造插件上下文(运行时, 插件名, 时间):
  设 上下文 为 {}
  上下文["运行时"] 为 运行时
  上下文["插件名"] 为 插件名
  上下文["时间"] 为 时间
  段落 注册服务(服务名, 实例):
    设 服务表 为 运行时["服务表"]
    如果 字典包含键(服务表, 服务名):
      抛出 新建 错误("服务重复注册: " + 服务名)
    设 项 为 {}
    项["实例"] 为 实例
    项["提供者"] 为 插件名
    设 服务表[服务名] 为 项
    返回 服务名
  段落 依赖服务(服务名):
    设 服务表 为 运行时["服务表"]
    如果 字典包含键(服务表, 服务名) == 假:
      抛出 新建 错误("依赖服务未就绪: " + 服务名)
    返回 字典获取(字典获取(服务表, 服务名, 空), "实例", 空)
  上下文["注册服务"] 为 注册服务
  上下文["依赖服务"] 为 依赖服务
  返回 上下文

# 单插件安装+启动（错误隔离：错误记录并继续）
段落 装载插件(运行时, 名称, 时间):
  设 插件 为 字典获取(运行时["插件表"], 名称, 空)
  派发运行时事件(运行时, "运行时/插件安装前", ["插件": 名称])
  设 上下文 为 造插件上下文(运行时, 名称, 时间)
  设 失败 为 假
  设 失败消息 为 ""
  尝试:
    设 安装钩子 为 插件["安装"]
    安装钩子(上下文)
    设 启动钩子 为 插件["启动"]
    启动钩子(上下文)
  捕获 错误 为 e:
    设 失败 为 真
    设 失败消息 为 转字符串(e)
  如果 失败:
    列表追加(运行时["错误记录"], ["插件": 名称, "阶段": "装载", "消息": 失败消息])
    派发运行时事件(运行时, "运行时/插件启动失败", ["插件": 名称, "消息": 失败消息])
    返回 假
  派发运行时事件(运行时, "运行时/插件安装后", ["插件": 名称])
  列表追加(运行时["加载序"], 名称)
  返回 真

# 单插件停止+卸载（逆序停止路径；错误同样隔离记录）
段落 卸载插件(运行时, 名称, 时间):
  设 插件 为 字典获取(运行时["插件表"], 名称, 空)
  设 上下文 为 造插件上下文(运行时, 名称, 时间)
  设 失败 为 假
  设 失败消息 为 ""
  尝试:
    设 停止钩子 为 插件["停止"]
    停止钩子(上下文)
    设 卸载钩子 为 插件["卸载"]
    卸载钩子(上下文)
  捕获 错误 为 e:
    设 失败 为 真
    设 失败消息 为 转字符串(e)
  如果 失败:
    列表追加(运行时["错误记录"], ["插件": 名称, "阶段": "卸载", "消息": 失败消息])
    返回 假
  派发运行时事件(运行时, "运行时/插件停止", ["插件": 名称])
  返回 真

# 启动：未初始化 -> 初始化中 -> 拓扑排序逐插件装载 -> 运行中
段落 启动(运行时, 时间):
  转换状态(运行时, "初始化中")
  派发运行时事件(运行时, "运行时/启动前", ["版本": 运行时["版本"]])
  设 排序失败 为 假
  设 排序消息 为 ""
  设 顺序表 为 []
  尝试:
    设 顺序表 为 拓扑排序插件(运行时["插件表"])
  捕获 错误 为 e:
    设 排序失败 为 真
    设 排序消息 为 转字符串(e)
  如果 排序失败:
    运行时["状态"] 为 "错误"
    列表追加(运行时["错误记录"], ["插件": "", "阶段": "拓扑排序", "消息": 排序消息])
    抛出 新建 错误(排序消息)
  遍历 名称 之 顺序表:
    装载插件(运行时, 名称, 时间)
  运行时["启动时间"] 为 时间
  转换状态(运行时, "运行中")
  派发运行时事件(运行时, "运行时/启动后", ["插件数": 列表长度(运行时["加载序"])])
  返回 真

# 停止：运行中 -> 停止中 -> 逆序卸载 -> 已停止
段落 停止(运行时, 时间):
  转换状态(运行时, "停止中")
  派发运行时事件(运行时, "运行时/停止前", ["插件数": 列表长度(运行时["加载序"])])
  设 序号 为 列表长度(运行时["加载序"])
  当 序号 > 0:
    设 序号 为 序号 - 1
    卸载插件(运行时, 运行时["加载序"][序号], 时间)
  运行时["停止时间"] 为 时间
  转换状态(运行时, "已停止")
  派发运行时事件(运行时, "运行时/停止后", [])
  返回 真

# 重启：运行中 -> 停止 -> 启动（同一批插件重新装载）
段落 重启(运行时, 停止时间, 启动时间):
  停止(运行时, 停止时间)
  # 重置加载序（插件表保留，重新装载）
  运行时["加载序"] 为 []
  运行时["服务表"] 为 {}
  运行时["状态"] 为 "未初始化"
  启动(运行时, 启动时间)
  返回 真

# 获取状态
段落 获取状态(运行时):
  返回 运行时["状态"]

# 获取元数据（当前时间注入，用于运行时长）
段落 获取元数据(运行时, 当前时间):
  设 元 为 {}
  元["版本"] 为 运行时["版本"]
  元["状态"] 为 运行时["状态"]
  元["启动时间"] 为 运行时["启动时间"]
  元["插件计数"] 为 列表长度(运行时["加载序"])
  元["服务计数"] 为 列表长度(字典键列表(运行时["服务表"]))
  元["错误计数"] 为 列表长度(运行时["错误记录"])
  设 时长 为 0
  如果 运行时["启动时间"] != 空:
    设 时长 为 当前时间 - 运行时["启动时间"]
    如果 时长 < 0:
      设 时长 为 0
  元["运行时长"] 为 时长
  返回 元

# ---------------- 服务注册表（独立操作面） ----------------
段落 注册服务(运行时, 服务名, 实例, 提供者):
  设 服务表 为 运行时["服务表"]
  如果 字典包含键(服务表, 服务名):
    抛出 新建 错误("服务重复注册: " + 服务名)
  设 项 为 {}
  项["实例"] 为 实例
  项["提供者"] 为 提供者
  设 服务表[服务名] 为 项
  返回 服务名

段落 获取服务(运行时, 服务名):
  设 服务表 为 运行时["服务表"]
  如果 字典包含键(服务表, 服务名) == 假:
    抛出 新建 错误("服务不存在: " + 服务名)
  返回 字典获取(字典获取(服务表, 服务名, 空), "实例", 空)

段落 尝试获取服务(运行时, 服务名):
  设 服务表 为 运行时["服务表"]
  如果 字典包含键(服务表, 服务名) == 假:
    返回 空
  返回 字典获取(字典获取(服务表, 服务名, 空), "实例", 空)

段落 列举服务(运行时):
  设 结果 为 []
  设 服务表 为 运行时["服务表"]
  遍历 服务名 之 字典键列表(服务表):
    设 项 为 字典获取(服务表, 服务名, 空)
    列表追加(结果, ["服务": 服务名, "提供者": 项["提供者"]])
  返回 结果
