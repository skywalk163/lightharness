# 工具.light —— 工具注册表 + 执行流水线（对齐原版 core/tools + agent-loop/tool-calls.ts，T10-05 加深）
#
# 数据结构：
#   ToolSchema     { "name", "description", "parameters" }   ← 给模型的工具描述
#   ToolDefinition { "name", "description", "parameters", "execute"(函数), "mode"(执行策略),
#                    "prepare"(前置钩子, 可选), "finalize"(收尾钩子, 可选) }
#   ToolExecutionResult { "content"(块表), "isError"(布尔), "concludesTurn"(布尔), "additionalContexts"(列表), "error" }
# 执行策略："exclusive"（独占总线，形成屏障）/"parallel"（可并行，v1 顺序执行但语义按模式分组）
#
# T10-05 加深点（对标 core/tools json-schema.ts + tool-calls.ts 三阶段）：
#   1) 参数校验：校验参数(模式, 参数) —— JSON Schema 子集校验器，返回结构化错误列表
#      （字段路径用列表 ["参数","秒"]，原因 missing/type/enum/pattern/...）。
#   2) 执行流水线接入：执行 = 准备(prepare, 可改参/拒) → 校验(schema) → 派发(execute) → 收尾(finalize)。
#   3) 红线：不改动 执行的返回结构（content/isError/concludesTurn/additionalContexts/error），
#      只在校验失败时为 error 补「字段错误」详情。
#
# ⚠️ 光明命名规范：成员名避开关键字/运算符词根（工具/模式/参数/类型 等）；
#   成员赋值一律「设 己.X 为 …」；校验器成员名用 校验一层/记错误/可读名/核对相等（无危险词根）。

导入 re

# ---- 构造工具模式（模型可见 schema）----
段落 造工具模式 接收 名字, 描述, 参数:
  返回 ["name": 名字, "description": 描述, "parameters": 参数]

# ---- 构造工具定义（注册用）----
# 策略：执行策略（"parallel"/"exclusive"）；准备/收尾 为可选钩子函数（默认 空）。
# 默认 "exclusive"（对齐上游 execution-mode.spec：isConcurrencySafe 未声明 → exclusive）。
段落 造工具定义 接收 名字, 描述, 参数, 执行函数, 策略="exclusive", 准备=空, 收尾=空:
  返回 ["name": 名字, "description": 描述, "parameters": 参数, "execute": 执行函数, "mode": 策略, "prepare": 准备, "finalize": 收尾]

# ---- 构造执行结果 ----
# 结论=假（缺省）；对齐上游 ToolExecutionResult.concludesTurn 传播语义。
段落 造工具结果 接收 内容, 是否错误, 结论=假:
  返回 ["content": 内容, "isError": 是否错误, "concludesTurn": 结论, "additionalContexts": []]

# ---- 解析模型参数（空→{}；非法 JSON→原文）----
段落 解析参数 接收 原文:
  如果 原文 == "":
    返回 {}
  尝试:
    返回 解析JSON(原文)
  捕获 错误:
    返回 原文

# =====================================================================
# 参数校验器（JSON Schema 校验器，纯光明实现，对齐原版 json-schema.ts 强制子集）
#   强制子集（对齐原版 CONSTRAINT_KEYWORDS）：
#     type / oneOf / properties / required /
#     additionalProperties(仅布尔) / items / enum / const
#   —— 外加 type:null 支持（原版 JsonSchemaScalar 含 null）。
#   超集兼容扩展（原版 assertSupportedJsonSchema 会拒绝，这里宽松保留，因工具参数有用）：
#     pattern / minimum / maximum / minLength / maxLength / minItems / maxItems
#     （属宽松超集，缺失时不影响对原版子集的对齐判定）
#   错误列表项：["路径": [...列表...], "原因": "...", "细节": "..."]
#   路径用列表（如 ["参数","秒"]），避免字符串拼接歧义。
# =====================================================================
类 校验器:
  属性 占位 等于 空

  段落 构造:
    设 己.占位 为 0

  # ---- 入口：根路径标签默认 "参数" ----
  段落 校验 接收 模式, 值, 根标签:
    设 错误表 为 []
    设 根路径 为 [根标签]
    己.校验一层(值, 模式, 根路径, 错误表)
    返回 错误表

  # ---- 分派：逐级校验，每类约束拆成独立方法（扁平化，规避深层嵌套解析错位）----
  段落 校验一层 接收 值, 模式, 路径, 错误表:
    己.校验组合(值, 模式, 路径, 错误表)
    己.校验型(值, 模式, 路径, 错误表)
    己.校验枚举(值, 模式, 路径, 错误表)
    己.校验常量(值, 模式, 路径, 错误表)
    如果 type(值) == dict:
      己.校验对象(值, 模式, 路径, 错误表)
    如果 type(值) == list:
      己.校验数组(值, 模式, 路径, 错误表)
    如果 type(值) == str:
      己.校验字符串(值, 模式, 路径, 错误表)
    如果 (type(值) == int) 或 (type(值) == float):
      己.校验数值(值, 模式, 路径, 错误表)

  # ---- oneOf 关键字（精确匹配一个分支；对齐原版 exact-one 语义）----
  #   若 schema 未声明 oneOf 则跳过；对每个分支递归校验，统计匹配分支数，非 1 即报错。
  段落 校验组合 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("oneOf") == 假:
      返回
    设 分支表 为 模式["oneOf"]
    设 命中 为 0
    遍历 分支 之 分支表:
      设 临时 为 []
      己.校验一层(值, 分支, 路径, 临时)
      如果 长(临时) == 0:
        设 命中 为 命中 加上 1
    如果 命中 != 1:
      己.记错误(错误表, 路径, "oneOf", "需精确匹配一个分支，实际匹配 " 加上 转字符串(命中) 加上 " 个")

  # ---- type 关键字（顺序 if，避免 else-if 链嵌套）----
  段落 校验型 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("type") == 假:
      返回
    设 期望型 为 模式["type"]
    设 已知型 为 假
    设 符合 为 假
    如果 期望型 == "string":
      设 已知型 为 真
      设 符合 为 (type(值) == str)
    如果 期望型 == "integer":
      设 已知型 为 真
      设 符合 为 (type(值) == int)
    如果 期望型 == "number":
      设 已知型 为 真
      设 符合 为 ((type(值) == int) 或 (type(值) == float))
    如果 期望型 == "boolean":
      设 已知型 为 真
      设 符合 为 (type(值) == bool)
    如果 期望型 == "null":
      设 已知型 为 真
      设 符合 为 (值 == 空)
    如果 期望型 == "array":
      设 已知型 为 真
      设 符合 为 (type(值) == list)
    如果 期望型 == "object":
      设 已知型 为 真
      设 符合 为 (type(值) == dict)
    如果 已知型 == 真:
      如果 符合 == 假:
        己.记错误(错误表, 路径, "type", "期望 " 加上 期望型 加上 " 实际 " 加上 己.可读名(值))

  # ---- 值是否符合单个声明 type（供 enum/const 的 type 闸门复用）----
  段落 型相符 接收 值, 期望型:
    如果 期望型 == "string":
      返回 (type(值) == str)
    如果 期望型 == "integer":
      返回 (type(值) == int)
    如果 期望型 == "number":
      返回 ((type(值) == int) 或 (type(值) == float))
    如果 期望型 == "boolean":
      返回 (type(值) == bool)
    如果 期望型 == "null":
      返回 (值 == 空)
    如果 期望型 == "array":
      返回 (type(值) == list)
    如果 期望型 == "object":
      返回 (type(值) == dict)
    返回 假

  # ---- enum 关键字（仅当 type 匹配时才校验；对齐原版 type-gated 语义）----
  段落 校验枚举 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("enum") == 假:
      返回
    如果 模式.包含("type") 且 己.型相符(值, 模式["type"]) == 假:
      返回
    设 命中 为 假
    遍历 候选 之 模式["enum"]:
      如果 己.核对相等(值, 候选):
        设 命中 为 真
    如果 命中 == 假:
      己.记错误(错误表, 路径, "enum", "值不在枚举: " 加上 转字符串(值))

  # ---- const 关键字（仅当 type 匹配时才校验；对齐原版 type-gated 语义）----
  段落 校验常量 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("const") == 假:
      返回
    如果 模式.包含("type") 且 己.型相符(值, 模式["type"]) == 假:
      返回
    如果 己.核对相等(值, 模式["const"]) == 假:
      己.记错误(错误表, 路径, "const", "值不等于常量")

  # ---- object 关键字（仅当 值 是字典时由 校验一层 调用）----
  段落 校验对象 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("properties"):
      设 属性表 为 模式["properties"]
      遍历 键 之 属性表:
        如果 值.包含(键):
          设 子路径 为 己.复制追加(路径, 键)
          己.校验一层(值[键], 属性表[键], 子路径, 错误表)
    如果 模式.包含("required"):
      遍历 键 之 模式["required"]:
        如果 值.包含(键) == 假:
          设 子路径 为 己.复制追加(路径, 键)
          己.记错误(错误表, 子路径, "missing", "缺少必需字段 " 加上 键)
    # additionalProperties: false → 拒绝未声明键（对齐原版强制子集；原版仅支持布尔）
    如果 模式.包含("additionalProperties") 且 模式["additionalProperties"] == 假:
      设 声明 为 {}
      如果 模式.包含("properties"):
        设 声明 为 模式["properties"]
      遍历 键 之 值:
        如果 声明.包含(键) == 假:
          设 子路径 为 己.复制追加(路径, 键)
          己.记错误(错误表, 子路径, "additionalProperties", "未声明的额外字段: " 加上 键)

  # ---- array 关键字（仅当 值 是列表时由 校验一层 调用）----
  段落 校验数组 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("items"):
      设 元素模式 为 模式["items"]
      设 i 为 0
      当 i < 长(值):
        设 子路径 为 己.复制追加(路径, 转字符串(i))
        己.校验一层(值[i], 元素模式, 子路径, 错误表)
        设 i 为 i 加上 1
    如果 模式.包含("minItems"):
      如果 长(值) < 模式["minItems"]:
        己.记错误(错误表, 路径, "minItems", "数组项数小于最小值")
    如果 模式.包含("maxItems"):
      如果 长(值) > 模式["maxItems"]:
        己.记错误(错误表, 路径, "maxItems", "数组项数大于最大值")

  # ---- 字符串约束 ----
  段落 校验字符串 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("minLength"):
      如果 长(值) < 模式["minLength"]:
        己.记错误(错误表, 路径, "minLength", "字符串长度小于最小值")
    如果 模式.包含("maxLength"):
      如果 长(值) > 模式["maxLength"]:
        己.记错误(错误表, 路径, "maxLength", "字符串长度大于最大值")
    如果 模式.包含("pattern"):
      如果 re.search(模式["pattern"], 值) == 空:
        己.记错误(错误表, 路径, "pattern", "不匹配正则 " 加上 模式["pattern"])

  # ---- 数值约束 ----
  段落 校验数值 接收 值, 模式, 路径, 错误表:
    如果 模式.包含("minimum"):
      如果 值 < 模式["minimum"]:
        己.记错误(错误表, 路径, "minimum", "数值小于最小值")
    如果 模式.包含("maximum"):
      如果 值 > 模式["maximum"]:
        己.记错误(错误表, 路径, "maximum", "数值大于最大值")

  # ---- 复制路径并追加一级（消除内联 遍历 p 之 路径 的三层嵌套）----
  段落 复制追加 接收 路径, 键:
    设 副本 为 []
    遍历 p 之 路径:
      副本.追加(p)
    副本.追加(键)
    返回 副本

  # ---- 记录错误（复制路径，避免共享引用污染）----
  段落 记错误 接收 错误表, 路径, 原因, 细节:
    设 副本 为 []
    遍历 p 之 路径:
      副本.追加(p)
    错误表.追加(["路径": 副本, "原因": 原因, "细节": 细节])

  # ---- 人类可读类型名（用于错误细节）----
  段落 可读名 接收 值:
    如果 type(值) == str:
      返回 "字符串"
    如果 type(值) == int:
      返回 "整数"
    如果 type(值) == float:
      返回 "小数"
    如果 type(值) == bool:
      返回 "布尔"
    如果 type(值) == list:
      返回 "数组"
    如果 type(值) == dict:
      返回 "对象"
    如果 值 == 空:
      返回 "空"
    返回 转字符串(type(值))

  # ---- 深比较（列表/字典递归）----
  段落 核对相等 接收 a, b:
    如果 type(a) != type(b):
      返回 假
    如果 type(a) == list:
      如果 长(a) != 长(b):
        返回 假
      设 i 为 0
      当 i < 长(a):
        如果 己.核对相等(a[i], b[i]) == 假:
          返回 假
        设 i 为 i 加上 1
      返回 真
    如果 type(a) == dict:
      如果 长(a) != 长(b):
        返回 假
      遍历 k 之 a:
        如果 b.包含(k) == 假:
          返回 假
        如果 己.核对相等(a[k], b[k]) == 假:
          返回 假
      返回 真
    返回 a == b

# ---- 对外校验入口：根标签固定 "参数"，返回错误列表 ----
段落 校验参数 接收 模式, 参数:
  设 实例 为 新建 校验器()
  返回 实例.校验(模式, 参数, "参数")

# =====================================================================
# 工具注册表
# =====================================================================
# ---- 交互工具接线（R63 收口：R12-D9/D12 由未注册变为 DI 接线就绪）----
# 以下两个工具的 schema 形状早已在纯逻辑模块就绪，但 execute 依赖宿主面
# （用户交互 / 会话存储访问），历史上（第12轮决策）暂不注册进 工具注册表。
# R63 在 src/交互工具.light 用依赖包把宿主面抽象为两个注入回调，接线即注册：
#   1) ask_user_question（审批.light 造提问调用/规范提问答案/提问工具描述）
#      → 交互工具.light 造提问工具定义 / 接线提问工具
#      依赖：提问器(规范化问题)→答案；可选 事件接收 落 approval/asked→decided 审计对。
#   2) session_query（查询工具.light 过滤构造/结果呈现）
#      → 交互工具.light 造会话查询工具定义 / 接线会话查询工具
#      依赖：查询器(过滤表,参数)→收集；可选 标题表/授权父表。
# 用法：接线全部交互工具(注册表, 依赖包)。回归：examples/test_交互工具接线.light。
# ---------------------------------------------------------------------
类 工具注册表:
  属性 登记表 等于 空
  属性 顺序表 等于 空
  属性 统计表 等于 空

  段落 构造:
    设 己.登记表 为 {}
    设 己.顺序表 为 []
    设 己.统计表 为 {}

  # 注册工具；同名覆盖
  段落 注册 接收 定义:
    设 名字 为 定义["name"]
    设 己.登记表[名字] 为 定义
    如果 己.顺序表.包含(名字) == 假:
      己.顺序表.追加(名字)
    如果 己.统计表.包含(名字) == 假:
      设 己.统计表[名字] 为 ["调用次数": 0, "成功次数": 0, "失败次数": 0]
    返回 真

  # 注销工具
  段落 注销 接收 名字:
    如果 己.登记表.包含(名字):
      字典删除(己.登记表, 名字)
      如果 己.统计表.包含(名字):
        字典删除(己.统计表, 名字)
      设 新名单 为 []
      遍历 项 之 己.顺序表:
        如果 项 != 名字:
          新名单.追加(项)
      设 己.顺序表 为 新名单
    返回 真

  # 是否存在
  段落 有无 接收 名字:
    返回 己.登记表.包含(名字)

  # 查找定义
  段落 查找 接收 名字:
    如果 己.登记表.包含(名字):
      返回 己.登记表[名字]
    返回 空

  # 全部已注册名字（登记顺序）
  段落 名单:
    返回 己.顺序表

  # 模型可见的描述表（按登记顺序）
  段落 描述表:
    设 结果 为 []
    遍历 名字 之 己.顺序表:
      设 定义 为 己.登记表[名字]
      结果.追加(["name": 定义["name"], "description": 定义["description"], "parameters": 定义["parameters"]])
    返回 结果

  # 指定工具的执行策略（未注册默认 exclusive，对齐上游 execution-mode.spec）
  段落 执行策略 接收 名字:
    如果 己.登记表.包含(名字):
      返回 己.登记表[名字]["mode"]
    返回 "exclusive"

  # 执行统计（每个工具的调用次数/成功次数/失败次数）
  段落 统计:
    返回 己.统计表

  # v2：批量执行多个工具调用，返回结果列表
  # 调用表每项: ["名字": 工具名, "参数": 原始参数JSON]
  段落 批量执行 接收 调用表:
    设 结果表 为 []
    遍历 调用项 之 调用表:
      设 单项结果 为 己.执行(调用项["名字"], 调用项["参数"])
      结果表.追加(单项结果)
    返回 结果表

  # v2：汇总统计——总调用数/成功数/失败数
  段落 汇总统计:
    设 总调用 为 0
    设 总成功 为 0
    设 总失败 为 0
    遍历 名字 之 己.顺序表:
      如果 己.统计表.包含(名字):
        设 项 为 己.统计表[名字]
        设 总调用 为 总调用 + 项["调用次数"]
        设 总成功 为 总成功 + 项["成功次数"]
        设 总失败 为 总失败 + 项["失败次数"]
    返回 ["总调用": 总调用, "总成功": 总成功, "总失败": 总失败]

  # 执行一个工具调用：名字 + 原始参数 JSON
  # 流水线：准备(prepare) → 校验(schema) → 派发(execute) → 收尾(finalize)
  # 返回 { "content", "isError", "concludesTurn", "additionalContexts", "error" }
  段落 执行 接收 名字, 原始参数:
    如果 己.登记表.包含(名字) == 假:
      返回 ["content": [["type": "text", "text": "未知工具: " 加上 名字]], "isError": 真, "concludesTurn": 假, "additionalContexts": [], "error": ["消息": "未知工具", "代码": "TOOL_NOT_FOUND"]]
    设 条目 为 己.登记表[名字]
    设 参数 为 解析参数(原始参数)
    # 1) 准备钩子（前置，可改参数 / 可拒绝）
    如果 条目.包含("prepare") 且 条目["prepare"] != 空:
      尝试:
        设 准备函数 为 条目["prepare"]
        设 参数 为 准备函数(参数)
      捕获 错误:
        返回 ["content": [["type": "text", "text": "工具准备失败: " 加上 转字符串(错误)]], "isError": 真, "concludesTurn": 假, "additionalContexts": [], "error": ["消息": "工具准备失败", "代码": "TOOL_PREPARE_FAILED", "详情": 转字符串(错误)]]
    # 2) 参数校验（JSON Schema）
    设 模式 为 条目["parameters"]
    设 校验错误 为 校验参数(模式, 参数)
    如果 长(校验错误) > 0:
      返回 ["content": [["type": "text", "text": "参数校验失败"]], "isError": 真, "concludesTurn": 假, "additionalContexts": [], "error": ["消息": "参数校验失败", "代码": "PARAM_SCHEMA_INVALID", "字段错误": 校验错误]]
    # 3) 派发（执行）
    尝试:
      设 执行函数 为 条目["execute"]
      设 值 为 执行函数(参数)
      # T1-S18 concludesTurn 传播：工具函数可返回结果字典（含 concludesTurn）或内容块表（列表）
      设 结论标志 为 假
      设 内容块 为 值
      如果 type(值) == dict 且 值.包含("concludesTurn"):
        设 结论标志 为 值["concludesTurn"]
        如果 值.包含("content"):
          设 内容块 为 值["content"]
      设 结果 为 ["content": 内容块, "isError": 假, "concludesTurn": 结论标志, "additionalContexts": [], "error": 空]
    捕获 错误:
      设 结果 为 ["content": [["type": "text", "text": "工具执行失败: " 加上 转字符串(错误)]], "isError": 真, "concludesTurn": 假, "additionalContexts": [], "error": ["消息": 转字符串(错误), "代码": "TOOL_EXECUTION_FAILED"]]
    # 4) 收尾钩子（execute 后，可读结果/记录；收尾异常不掩盖主结果）
    如果 条目.包含("finalize") 且 条目["finalize"] != 空:
      尝试:
        设 收尾函数 为 条目["finalize"]
        设 占位 为 收尾函数(结果, 参数)
      捕获 错误:
        设 占位 为 空
    # 更新执行统计
    如果 己.统计表.包含(名字):
      设 统计项 为 己.统计表[名字]
      设 统计项["调用次数"] 为 统计项["调用次数"] + 1
      如果 结果["isError"] == 假:
        设 统计项["成功次数"] 为 统计项["成功次数"] + 1
      否则:
        设 统计项["失败次数"] 为 统计项["失败次数"] + 1
    返回 结果
# =====================================================================
# 作用域工具判定（scoped tools，对齐 9d6c964985 / #3853 tool-guidance-restrictions）
#
# 原版语义：每个 guidance 段落检查 ctx.tools.get(name, scope)，仅在其工具
#   对该 agent 可见时渲染；grep 段落的 read 后续句、write 段落的 edit 推荐
#   句按目标工具可见性省略；PTC 能力（wire 呈现 run_code）同样适用。
# 纯逻辑复刻：可见性判定（允许表白名单 / 禁止表黑名单）+ 指导段过滤 +
#   交叉推荐句裁剪。指导段 = { "工具名": "...", "文本": "..." }。
# =====================================================================

# 判定工具可见：允许表非空 → 白名单（名字须在其中）；否则 禁止表 含 名字 → 不可见
段落 判定工具可见 接收 允许表, 禁止表, 名字:
  如果 列表长度(允许表) > 0:
    遍历 允许项 之 允许表:
      如果 允许项 == 名字:
        返回 真
    返回 假
  遍历 禁止项 之 禁止表:
    如果 禁止项 == 名字:
      返回 假
  返回 真

# 过滤指导段：只渲染对当前作用域可见的工具段落（保持原顺序）
# 判定可见 为函数入参（接收 工具名 → 布尔），纯逻辑投影
段落 过滤可见指导 接收 指导段表, 判定可见:
  设 结果 为 []
  遍历 段 之 指导段表:
    如果 判定可见(段["工具名"]):
      结果.追加(段)
  返回 结果

# 裁剪交叉推荐句：指导文本中嵌入的「对另一工具的推荐句」（如 grep 段里的
# " Use read on a matched file ..."）在目标工具不可见时省略（返回 标记 之前部分）。
# 标记 = 推荐句起始文本；关联工具 不可见 → 截断；可见 → 原文。
段落 裁交叉推荐 接收 指导文本, 标记, 关联工具, 判定可见:
  如果 判定可见(关联工具):
    返回 指导文本
  设 位置 为 查找子串位置(指导文本, 标记, 0)
  如果 位置 < 0:
    返回 指导文本
  返回 截取(指导文本, 0, 位置)

# 查找子串首个位置（本地实现，避免依赖外部导入；找不到返回 -1）
段落 查找子串位置 接收 文本, 子串, 起点:
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  如果 m == 0:
    返回 起点
  设 i 为 起点
  当 i <= n - m:
    设 j 为 0
    设 找到 为 真
    当 j < m:
      如果 字符串获取(文本, i + j) != 字符串获取(子串, j):
        设 找到 为 假
        设 j 为 m
      设 j 为 j + 1
    如果 找到:
      返回 i
    设 i 为 i + 1
  返回 -1

# =====================================================================
# R47 深化（#8）：scoped 限制掩码 + 作用域可见视图 + 呈现模式 + PTC 折叠
#
# 上游（只读）：packages/core/tools/src/index.ts
#   restrict({allow?, deny?})（1061-1088）：空过滤器报错；不得点名保留 PTC 运输工具 run_code；
#     未知全局名报错。admits（731-737）：allow 定义 → 名字须在；deny 定义 → 名字不得在。
#   view（1142-1182）：继承面逐名过全链限制求交；作用域自有注册遮蔽继承名且不受限制约束；
#     呈现非 native → 追加保留运输工具 run_code（限制不得波及）。
#   modeFor（892-898）：作用域链就近胜出；全链未声明 → 部署默认 native。
#   collapses（1314-1316）：ptc 且 名字 != run_code 且 非嵌套 → 直接派发被折叠
#     （名字仍可见，但调用只走 run_code 运输）。
# 指导过滤复用既有 过滤可见指导/裁交叉推荐：判定可见 传 限制链放行 的包装即可。
# =====================================================================

# 保留 PTC 运输工具名（上游 RUN_CODE_NAME）
设 代码运输名 为 "run_code"

# 造限制：编译一条作用域限制（allow/deny 掩码）
#   空过滤器（两者都缺席）→ 抛错（上游 restrict({}) 视为配置 bug）；
#   任何一边点名 run_code → 抛错（保留运输工具不可限制，应限制端能力工具）。
段落 造限制 接收 允许表 = 空, 禁止表 = 空:
  设 有允许 为 (允许表 != 空 且 列表长度(允许表) > 0)
  设 有禁止 为 (禁止表 != 空 且 列表长度(禁止表) > 0)
  如果 有允许 == 假 且 有禁止 == 假:
    抛出 新建 错误("限制不得为空掩码：须传 允许表 和/或 禁止表 [EMPTY_RESTRICTION]")
  如果 有允许:
    遍历 名 之 允许表:
      如果 名 == 代码运输名:
        抛出 新建 错误("限制不得点名保留运输工具 " + 代码运输名 + " [RESERVED_TRANSPORT_NAME]")
  如果 有禁止:
    遍历 名 之 禁止表:
      如果 名 == 代码运输名:
        抛出 新建 错误("限制不得点名保留运输工具 " + 代码运输名 + " [RESERVED_TRANSPORT_NAME]")
  设 限制 为 {}
  如果 有允许:
    限制["允许"] 为 允许表
  如果 有禁止:
    限制["禁止"] 为 禁止表
  返回 限制

# 单条限制放行判定（上游 admits）：allow 定义 → 名字须在白名单；deny 定义 → 名字不得在黑名单
段落 限制放行单 接收 限制, 名字:
  如果 限制.包含("允许") 且 列表包含(限制["允许"], 名字) == 假:
    返回 假
  如果 限制.包含("禁止") 且 列表包含(限制["禁止"], 名字):
    返回 假
  返回 真

# 限制链求交：沿作用域链（祖先最远在前、自身最后）每层限制都必须放行
#   （上游 view()：layers.every(layer => layer.admits(name))——任一层否决即不可见）
段落 限制链放行 接收 限制链, 名字:
  遍历 限制 之 限制链:
    如果 限制放行单(限制, 名字) == 假:
      返回 假
  返回 真

# 作用域可见视图（上游 view() 的名字层投影）：
#   继承名单 逐名过 限制链求交 → 可见；自有名单 追加（同名继承名被自有定义遮蔽，
#   名字层视图只出现一次，定义解析归自有；自有注册不受限制约束）；
#   呈现非 native → 追加 保留运输工具 run_code（限制不得波及；已含则不重复）。
段落 作用域可见视图 接收 继承名单, 限制链, 自有名单, 呈现:
  设 可见 为 []
  遍历 名字 之 继承名单:
    如果 限制链放行(限制链, 名字) 且 列表包含(可见, 名字) == 假:
      可见.追加(名字)
  遍历 名字 之 自有名单:
    如果 列表包含(可见, 名字) == 假:
      可见.追加(名字)
  如果 呈现 != "native" 且 列表包含(可见, 代码运输名) == 假:
    可见.追加(代码运输名)
  返回 可见

# 呈现模式判定：作用域链就近胜出（链声明表 = 就近在前；每项为该层声明或 空）
#   全链未声明 → 部署默认 native（上游 modeFor）
段落 呈现模式判定 接收 链声明表:
  遍历 声明 之 链声明表:
    如果 声明 != 空:
      返回 声明
  返回 "native"

# 折叠判定（上游 collapses）：ptc 呈现 + 非嵌套派发 + 名字非 run_code → 折叠
#   被折叠工具的名字仍可见（描述不删），但直接调用被拒、只能经 run_code SDK 子派发；
#   嵌套调用（run_code 内部）不折叠；native/both 不折叠。
段落 折叠判定 接收 名字, 呈现, 嵌套:
  如果 嵌套:
    返回 假
  返回 呈现 == "ptc" 且 名字 != 代码运输名
