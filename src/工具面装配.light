# =====================================================================
# §3 基础纯函数
# =====================================================================

段落 列表副本(表):
  设 结果 为 []
  遍历 项 之 表:
    列表追加(结果, 项)
  返回 结果

段落 交集(甲, 乙):
  设 结果 为 []
  遍历 项 之 甲:
    如果 列表包含(乙, 项) == 真:
      列表追加(结果, 项)
  返回 结果

# 查找加号(串) -> 首个 "+" 的下标；没有返回 -1（不做 split，避免额外依赖）
段落 查找加号(串):
  设 i 为 0
  当 (i < 字符串长度(串)):
    如果 (串[i] == "+"):
      返回 i
    设 i 为 i + 1
  返回 -1

# =====================================================================
# §4 叶子映射
# =====================================================================

# 叶子映射(名字) -> 叶子 id 列表；未知/非字符串返回 []（不瞎猜）
#   返回副本，调用方改返回值不会污染映射表。
段落 叶子映射(名字):
  如果 是字符串(名字) == 假:
    设 空表 为 []
    返回 空表
  如果 字典包含键(叶子映射表, 名字) == 假:
    设 空表 为 []
    返回 空表
  返回 列表副本(叶子映射表[名字])

# 不上叶子(名字) -> 布尔；登记在不上叶子表里的名字明确不映射
段落 不上叶子(名字):
  如果 是字符串(名字) == 假:
    返回 假
  返回 列表包含(不上叶子表, 名字)

# =====================================================================
# §5 预设叶子口径
# =====================================================================

# 基础预设(标识) -> 去掉 "+" 后的左半（"standard+brainstorm" → "standard"）
段落 基础预设(标识):
  如果 是字符串(标识) == 假:
    返回 ""
  设 加位 为 查找加号(标识)
  如果 加位 >= 0:
    返回 截取(标识, 0, 加位)
  返回 标识

# 方法部分(标识) -> "+" 右侧（无 "+" 返回空串）
段落 方法部分(标识):
  如果 是字符串(标识) == 假:
    返回 ""
  设 加位 为 查找加号(标识)
  如果 加位 >= 0:
    返回 截取(标识, 加位 + 1, 字符串长度(标识))
  返回 ""

# 全集减写(全集) -> 剔除写类叶子后的集合（保持全集顺序）
段落 全集减写(全集):
  设 结果 为 []
  遍历 叶 之 全集:
    如果 列表包含(写类叶子, 叶) == 假:
      列表追加(结果, 叶)
  返回 结果

# 补充叶子(预设标识) -> 该预设应额外保留的叶子集合
#   standard / ptc / cordis / default ：全集
#   topdown / bottomup / lazy        ：全集减写类叶子
#   brainstorm                       ：只读叶子
#   minimal                          ：只留 bash 壳叶子族
#   "代理+方法" 组合串               ：两侧口径取交集（方法只删不增）
#   未知                              ：[]（不抛错，查询接口语义）
段落 补充叶子(预设标识):
  如果 是字符串(预设标识) == 假:
    设 空表 为 []
    返回 空表
  设 加位 为 查找加号(预设标识)
  如果 加位 >= 0:
    设 左 为 截取(预设标识, 0, 加位)
    设 右 为 截取(预设标识, 加位 + 1, 字符串长度(预设标识))
    设 左叶 为 补充叶子(左)
    设 右叶 为 补充叶子(右)
    返回 交集(左叶, 右叶)
  如果 预设标识 == "standard":
    返回 列表副本(全集叶子)
  如果 预设标识 == "ptc":
    返回 列表副本(全集叶子)
  如果 预设标识 == "cordis":
    返回 列表副本(全集叶子)
  如果 预设标识 == "default":
    返回 列表副本(全集叶子)
  如果 预设标识 == "topdown":
    返回 全集减写(全集叶子)
  如果 预设标识 == "bottomup":
    返回 全集减写(全集叶子)
  如果 预设标识 == "lazy":
    返回 全集减写(全集叶子)
  如果 预设标识 == "brainstorm":
    返回 列表副本(只读叶子)
  如果 预设标识 == "minimal":
    返回 列表副本(壳叶子)
  设 无叶 为 []
  返回 无叶

# 未映射默认保留(预设标识) -> 布尔
#   标准类（standard/ptc/cordis/default/topdown/bottomup/lazy）：真（宁可多挂，不静默丢）
#   minimal / brainstorm：假（保持收紧）
#   组合串：两侧取「与」（任一侧收紧即收紧）
#   未知：假（保守）
段落 未映射默认保留(预设标识):
  如果 是字符串(预设标识) == 假:
    返回 假
  设 加位 为 查找加号(预设标识)
  如果 加位 >= 0:
    设 左 为 截取(预设标识, 0, 加位)
    设 右 为 截取(预设标识, 加位 + 1, 字符串长度(预设标识))
    设 左值 为 未映射默认保留(左)
    设 右值 为 未映射默认保留(右)
    返回 左值 == 真 且 右值 == 真
  如果 预设标识 == "minimal":
    返回 假
  如果 预设标识 == "brainstorm":
    返回 假
  如果 预设标识 == "standard":
    返回 真
  如果 预设标识 == "ptc":
    返回 真
  如果 预设标识 == "cordis":
    返回 真
  如果 预设标识 == "default":
    返回 真
  如果 预设标识 == "topdown":
    返回 真
  如果 预设标识 == "bottomup":
    返回 真
  如果 预设标识 == "lazy":
    返回 真
  返回 假

# =====================================================================
# §5.5 模型可见白名单（T-0477）
#
# 背景：T-0456 的「未映射默认保留」把 130+ 个没有叶子依据的工具无条件留给模型，
#   standard 工具面涨到 168 个 / schema 46,870 字符，而系统提示只指导其中 15 个。
#   本段改为显式白名单：只有点名保留的工具才进模型面，其余一律注销。
#
# 口径：
#   基础白名单()   —— standard/ptc/cordis/default/topdown/bottomup/lazy 共用基础集
#   工作方法删减() —— 方法维只从基础集删（复用 预设组合.方法删减 的叶子表）
#   只读白名单()   —— brainstorm 专用，只含读/搜/问/网查
#   最小白名单()   —— minimal，只留 bash
#   白名单(标识)   —— 解析组合后落到上述四张表；未知预设抛错（复用 是已知预设）
#
# MCP 工具不进具体名表，用 "mcp__*" 通配 + HARNESS_MCP_TOOLS 开关决定（见 总入口）。
# =====================================================================

设 基础工具名表 为 [
  "bash", "读文件", "写文件", "编辑文件", "搜索文件",
  "job_start", "job_output", "job_kill",
  "skill", "技能列表", "web_search", "web_fetch",
  "present", "todo_write", "目标",
  "派发子任务", "收集子任务结果",
  "提问提交", "回答提交", "待答列出", "答案取出",
  "作业状态查询"
]

设 只读工具名表 为 [
  "读文件", "搜索文件",
  "skill", "技能列表", "技能取用",
  "web_search", "web_fetch", "网页抓取",
  "提问提交", "回答提交", "待答列出", "答案取出"
]

设 最小工具名表 为 ["bash"]

设 MCP白名单通配 为 "mcp__*"

段落 基础白名单():
  返回 列表副本(基础工具名表)

段落 只读白名单():
  返回 列表副本(只读工具名表)

段落 最小白名单():
  返回 列表副本(最小工具名表)

# 追加不重：白名单是集合语义，同名只留一次
段落 追加不重(表, 名):
  如果 列表包含(表, 名) == 假:
    列表追加(表, 名)
  返回 表

# 白名单删减(基, 删) -> 基中剔除 删 里的名字（保持基的顺序）
段落 白名单删减(基, 删):
  设 结果 为 []
  遍历 名 之 基:
    如果 列表包含(删, 名) == 假:
      列表追加(结果, 名)
  返回 结果

# 工作方法删减(方法) -> 从基础白名单里要删掉的工具名
#   叶子依据直接取 预设组合.方法删减（权威表），这里只做「叶子 → 注册名」翻译。
#   方法只删不增：未列出的方法（default/topdown/brainstorm）返回空表或走只读白名单。
段落 工作方法删减(方法):
  设 删叶 为 方法删减(方法)
  设 结果 为 []
  遍历 叶 之 删叶:
    如果 叶 == "tool-goal":
      追加不重(结果, "目标")
    如果 叶 == "tool-ask-user":
      追加不重(结果, "提问提交")
      追加不重(结果, "回答提交")
      追加不重(结果, "待答列出")
      追加不重(结果, "答案取出")
    如果 叶 == "tool-bash" 或 叶 == "tool-pwsh":
      追加不重(结果, "bash")
    如果 叶 == "tool-fs-write":
      追加不重(结果, "写文件")
      追加不重(结果, "编辑文件")
    如果 叶 == "delegation":
      追加不重(结果, "派发子任务")
      追加不重(结果, "收集子任务结果")
  返回 结果

# 白名单(预设标识) -> 该预设下模型可见的工具名表
#   minimal           -> 最小白名单（bash）
#   方法=brainstorm   -> 只读白名单（组合串也按方法维收紧）
#   其余              -> 基础白名单 − 工作方法删减 + MCP 通配
段落 白名单(预设标识):
  如果 是已知预设(预设标识) == 假:
    抛出 新建 错误("未知 agent preset: " + 转字符串(预设标识))
  设 解 为 解析组合(预设标识)
  设 代理 为 解["代理"]
  设 方法 为 解["方法"]
  如果 代理 == "minimal":
    返回 最小白名单()
  如果 方法 == "brainstorm":
    返回 只读白名单()
  设 基 为 基础白名单()
  设 删 为 工作方法删减(方法)
  设 结果 为 白名单删减(基, 删)
  列表追加(结果, MCP白名单通配)
  返回 结果

# =====================================================================
# §5.6 双级可见性（T-0497）
#
# 参考 reactive-agents 的 scoping 模型，把「工具可见性」拆成两个独立级别：
#   allowedTools —— 硬白名单。不在名单里的工具在 schema 构建**之前**就被剪枝：
#                   模型的工具面里根本没有它，既看不到 schema，也没有机会被调用。
#   focusedTools —— 软聚焦。全量工具仍然可调用，只是命中的条目被前置并打上
#                   「聚焦」标记，让模型的注意力先落在重点工具上。
#
# 关键取舍（任务卡要求写进实现注释与卡面）：
#   硬白名单只用于「锁死 surface」的场景（子代理只做 ctx 操作、只读审阅代理等），
#   常规会话一律用 focusedTools。理由是剪枝后模型看不到被删的工具名——真需要那项
#   能力时，它会去「编造一个不存在的工具名」，或用相近工具硬凑参数。硬白名单是
#   刻意的窄化，不是默认优化，因此只在显式 preset 里声明时才生效。
#
# 配置形状（preset 侧由 预设.预设可见性 注入；键名英 / 中两种口径都认）：
#   {"allowedTools": [...], "focusedTools": [...]}
#   {"允许工具": [...], "聚焦工具": [...]}
#   元素是工具名；结尾 "*" 表示前缀通配（例："mcp__*"）。
#
# 向后兼容：两个键都缺 / 都是空表 → 不剪枝、不聚焦，条目表的顺序与条目引用
#   与改动前逐项一致（本段不复制、不重排任何条目）。
# =====================================================================

# 取可见性列表(配置, 键表) → 该组键下登记的字符串项（去重、保序、跳过非串与空白）
段落 取可见性列表(配置, 键表):
  设 结果 为 []
  如果 是字典(配置) == 假:
    返回 结果
  遍历 键 之 键表:
    如果 字典包含键(配置, 键) == 假:
      继续
    设 原 为 配置[键]
    如果 是列表(原) == 假:
      继续
    遍历 项 之 原:
      如果 是字符串(项) == 假:
        继续
      设 去 为 去除空白(项)
      如果 去 == "":
        继续
      如果 列表包含(结果, 去) == 假:
        列表追加(结果, 去)
  返回 结果

# 允许工具表(配置) → 硬白名单（英文键 + 中文键合并，去重保序）
段落 允许工具表(配置):
  设 英键表 为 ["allowedTools"]
  设 中键表 为 ["允许工具"]
  设 甲 为 取可见性列表(配置, 英键表)
  设 乙 为 取可见性列表(配置, 中键表)
  遍历 名 之 乙:
    如果 列表包含(甲, 名) == 假:
      列表追加(甲, 名)
  返回 甲

# 聚焦工具表(配置) → 软聚焦名单（英文键 + 中文键合并，去重保序）
段落 聚焦工具表(配置):
  设 英键表 为 ["focusedTools"]
  设 中键表 为 ["聚焦工具"]
  设 甲 为 取可见性列表(配置, 英键表)
  设 乙 为 取可见性列表(配置, 中键表)
  遍历 名 之 乙:
    如果 列表包含(甲, 名) == 假:
      列表追加(甲, 名)
  返回 甲

# 硬白名单开启(配置) → 真假
#   只有显式登记了非空白名单才算开启；缺键 / 空表一律按「未配置」处理：
#   既避免一次空值误写把整个工具面锁死，也保证常规会话不会被动进入硬白名单。
段落 硬白名单开启(配置):
  设 允许 为 允许工具表(配置)
  返回 列表长度(允许) > 0

# 名匹配模式(模式, 名) → 真假：末尾 "*" 走前缀匹配，其余按全名相等
段落 名匹配模式(模式, 名):
  如果 是字符串(模式) == 假 或 是字符串(名) == 假:
    返回 假
  设 模长 为 字符串长度(模式)
  如果 模长 == 0:
    返回 假
  如果 模式[模长 - 1] == "*":
    设 前缀长 为 模长 - 1
    返回 开头(名, 截取(模式, 0, 前缀长))
  返回 模式 == 名

# 命中名单(名单, 名) → 真假：任一模式命中即真
段落 命中名单(名单, 名):
  遍历 模式 之 名单:
    如果 名匹配模式(模式, 名) == 真:
      返回 真
  返回 假

# 条目工具名(条目) → 串；优先 "工具名"，回退 "标识"，再回退 "id"，都没有给 ""
段落 条目工具名(条目):
  设 空名 为 ""
  如果 是字典(条目) == 假:
    返回 空名
  如果 字典包含键(条目, "工具名") == 真:
    设 名一 为 条目["工具名"]
    如果 是字符串(名一) == 真 且 字符串长度(名一) > 0:
      返回 名一
  如果 字典包含键(条目, "标识") == 真:
    设 名二 为 条目["标识"]
    如果 是字符串(名二) == 真 且 字符串长度(名二) > 0:
      返回 名二
  如果 字典包含键(条目, "id") == 真:
    设 名三 为 条目["id"]
    如果 是字符串(名三) == 真 且 字符串长度(名三) > 0:
      返回 名三
  返回 空名

# 工具可见(名, 配置) → 真假：硬白名单未开启时恒真；开启时必须命中名单
段落 工具可见(名, 配置):
  设 允许 为 允许工具表(配置)
  如果 列表长度(允许) == 0:
    返回 真
  返回 命中名单(允许, 名)

# 标注聚焦(条目, 标记) → 条目的浅副本 + "聚焦" 键（不改原条目，避免污染注册表）
段落 标注聚焦(条目, 标记):
  设 复 为 副本(条目)
  如果 是字典(复) == 假:
    返回 条目
  字典设置(复, "聚焦", 标记)
  返回 复

# 装配可见工具面(条目表, 配置) → {"schema", "剪枝", "聚焦", "顺序", "总数"}
#   schema —— 已剪枝并排好序的条目表（模型 schema 只从这里构建）
#   剪枝   —— 被硬白名单挡掉的条目名（模型永远看不到，重复名只记一次）
#   聚焦   —— 留下来的条目里命中 focusedTools 的名字（按呈现顺序）
#   顺序   —— schema 的条目名顺序：聚焦项在前，其余保持注册表原顺序
#   总数   —— 输入条目数（= schema + 剪枝，重复名场景下按条目数）
#
# 两段顺序固定：① 剪枝 → ② 聚焦重排。剪枝发生在任何呈现之前，
# 不存在「先发 schema 给模型再撤回」的中间态。
段落 装配可见工具面(条目表, 配置):
  设 可见 为 []
  设 剪枝 为 []
  设 硬开 为 硬白名单开启(配置)
  遍历 条目 之 条目表:
    设 名 为 条目工具名(条目)
    如果 硬开 == 真:
      如果 工具可见(名, 配置) == 假:
        如果 列表包含(剪枝, 名) == 假:
          列表追加(剪枝, 名)
        继续
    列表追加(可见, 条目)
  设 聚焦名单 为 聚焦工具表(配置)
  设 前置 为 []
  设 其余 为 []
  设 聚焦 为 []
  遍历 条目 之 可见:
    设 名 为 条目工具名(条目)
    如果 命中名单(聚焦名单, 名) == 真:
      列表追加(前置, 标注聚焦(条目, 真))
      如果 列表包含(聚焦, 名) == 假:
        列表追加(聚焦, 名)
    否则:
      列表追加(其余, 条目)
  设 结果 为 []
  遍历 项 之 前置:
    列表追加(结果, 项)
  遍历 项 之 其余:
    列表追加(结果, 项)
  设 顺序 为 []
  遍历 项 之 结果:
    列表追加(顺序, 条目工具名(项))
  设 面 为 {"schema": 结果, "剪枝": 剪枝, "聚焦": 聚焦, "顺序": 顺序, "总数": 列表长度(条目表)}
  返回 面

# 模型可见条目(条目表, 配置) → schema 构建的唯一输入（= 装配可见工具面().schema）
#   接线点只应当消费这个返回值：剪枝已经在这里发生完了。
段落 模型可见条目(条目表, 配置):
  设 面 为 装配可见工具面(条目表, 配置)
  返回 面["schema"]

# 可见性报告(条目表, 配置) → {"总数", "可见", "剪枝", "聚焦", "硬白名单"}（审计/打印用）
段落 可见性报告(条目表, 配置):
  设 面 为 装配可见工具面(条目表, 配置)
  设 报 为 {"总数": 面["总数"], "可见": 列表长度(面["schema"]), "剪枝": 列表长度(面["剪枝"]), "聚焦": 列表长度(面["聚焦"]), "硬白名单": 硬白名单开启(配置)}
  返回 报

# 造可见性配置(允许 = 空, 聚焦 = 空) → 标准形状（preset 作者与测试构造用）
段落 造可见性配置(允许 = 空, 聚焦 = 空):
  设 允许表 为 []
  如果 是列表(允许) == 真:
    设 允许表 为 副本(允许)
  设 聚焦表 为 []
  如果 是列表(聚焦) == 真:
    设 聚焦表 为 副本(聚焦)
  设 配置 为 {"allowedTools": 允许表, "focusedTools": 聚焦表}
  返回 配置

# =====================================================================
# §6 装配报告
# =====================================================================

# 条目表两种形状（T-0456 接线时按手上有什么选一种）：
#   a) 叶子条目：{"标识": 叶子id, "工具名": 工具名}（总入口.造条目表带映射 的形状）
#   b) 工具条目：{"标识": 工具名}（总入口.造注册表条目表 的形状，覆盖未映射工具）
#   缺 "工具名" 键时按 b) 处理。a) 形状无法报告「完全没进表的未映射工具」，
#   要完整报告请用 b)。
#
# 判定口径与 预设保留工具 对齐：同一工具只要有任一叶子被允许就算保留；
#   无叶子依据的工具按 未映射默认保留(预设) 决定。
段落 装配报告(条目表, 预设标识):
  设 允许 为 补充叶子(预设标识)
  设 默认保留 为 未映射默认保留(预设标识)
  设 状态 为 {}
  设 未映射 为 []
  遍历 项 之 条目表:
    设 名 为 字典获取(项, "工具名", "")
    如果 名 == "" 或 名 == 空:
      设 名 为 字典获取(项, "标识", "")
    如果 名 != "" 且 名 != 空:
      设 映射 为 叶子映射(名)
      如果 长度(映射) == 0:
        如果 列表包含(未映射, 名) == 假:
          列表追加(未映射, 名)
        如果 字典包含键(状态, 名) == 假:
          字典设置(状态, 名, 默认保留)
      否则:
        设 叶 为 字典获取(项, "标识", "")
        设 命中 为 假
        如果 名 != 叶 且 列表包含(允许, 叶) == 真:
          设 命中 为 真
        # b) 形状：标识就是工具名，逐一看该工具的每个映射叶子是否被允许
        如果 名 == 叶:
          遍历 候选 之 映射:
            如果 列表包含(允许, 候选) == 真:
              设 命中 为 真
        如果 命中 == 真:
          字典设置(状态, 名, 真)
        否则:
          如果 字典包含键(状态, 名) == 假:
            字典设置(状态, 名, 假)
  设 保留 为 []
  设 注销 为 []
  设 键表 为 字典键列表(状态)
  遍历 名 之 键表:
    如果 状态[名] == 真:
      列表追加(保留, 名)
    否则:
      列表追加(注销, 名)
  返回 {"保留": 保留, "注销": 注销, "未映射": 未映射}

