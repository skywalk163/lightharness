# 变更请求.light —— 对标上游 packages/experimental/forge/src/{keys,schedule,types}.ts
# + forge-session/src/{commands,projection}.ts（URL 提取与绑定投影纯逻辑）
#
# Provider 中立的「变更请求（CR）」注册表纯逻辑：
#   1) 键归一：repository ref -> forge:host/owner/name#number（全小写）
#   2) 轮询调度：失败指数退避 / merged 停轮 / closed 空闲 / pending 活跃
#   3) URL 提取与比较：从文本中找 PR URL、比较两个 URL 是否指向同一 CR
#   4) 绑定投影：追加新绑定、记录推送分支
#   5) 评审状态归一：宿主 review state -> approved/changes-requested/review-required/none
#   6) 快照概览与失败码（0.2.2-rc.1 #9/#10/#11）：13 个必填字段的缺省/补全/校验、
#      检查的 rerun 标识、失败码语义（unknown/stale/unsupported…）、diff 定 head 的过期判定
#
# 宿主面剔除：gh CLI 调用、Session 事件投影、网络请求全在宿主；本模块只做纯文本/纯逻辑。
# 判据见 examples/test_变更请求.light（R220）与 examples/test_R221_Bf1变更请求快照.light（R221）。

从 内置核心判型 导入 是字典, 是列表, 是布尔, 是整数, 是浮点, 是字符串

导出 变更请求键 下次轮询延迟 URL身份 同变更请求URL 找变更请求URL 找自身URL 绑定追加 记录推送 评审归一 变更请求快照缺省 变更请求快照补全 变更请求快照校验 变更请求检查构造 变更请求失败码集 变更请求失败语义 变更请求失败可重试 变更请求差异过期 变更请求评审读取码

# ===== 一、键归一（keys.ts）=====

段落 变更请求_报错(原因):
  抛出 新建 错误("变更请求：" + 原因)

# 由 repository ref 构造 canonical key：forge:host/owner/name#number（全小写）
段落 变更请求键(ref):
  如果 字典包含键(ref, "repository") == 假:
    变更请求_报错("ref 缺少 repository")
  设 仓 为 ref["repository"]
  如果 字典包含键(仓, "forge") == 假:
    变更请求_报错("repository 缺少 forge")
  如果 字典包含键(仓, "host") == 假:
    变更请求_报错("repository 缺少 host")
  如果 字典包含键(仓, "owner") == 假:
    变更请求_报错("repository 缺少 owner")
  如果 字典包含键(仓, "name") == 假:
    变更请求_报错("repository 缺少 name")
  如果 字典包含键(ref, "number") == 假:
    变更请求_报错("ref 缺少 number")
  设 键文 为 仓["forge"] + ":" + 仓["host"] + "/" + 仓["owner"] + "/" + 仓["name"] + "#" + 转字符串(ref["number"])
  返回 小写(键文)

# ===== 二、轮询调度（schedule.ts）=====

# 选下次轮询延迟：失败按 2^失败数 指数退避并封顶；merged 停轮；closed 空闲；pending/unknown 活跃
# 间隔字典：{活跃间隔, 空闲间隔, 最大退避}
段落 下次轮询延迟(结果, 失败数, 间隔):
  如果 字典包含键(结果, "错误"):
    设 退避 为 间隔["活跃间隔"] * 变更请求_幂(失败数)
    如果 退避 > 间隔["最大退避"]:
      返回 间隔["最大退避"]
    返回 退避
  如果 结果["状态"] == "已合并":
    返回 空
  如果 结果["状态"] == "已关闭":
    返回 间隔["空闲间隔"]
  如果 结果["检查汇总"] == "pending":
    返回 间隔["活跃间隔"]
  如果 结果["可合并"] == "unknown":
    返回 间隔["活跃间隔"]
  返回 间隔["空闲间隔"]

# 简易 2^n（避免内置幂函数不确定性）
段落 变更请求_幂(n):
  设 积 为 1
  设 甲 为 0
  当 甲 < n:
    设 积 为 积 * 2
    设 甲 为 甲 + 1
  返回 积

# ===== 三、URL 身份与提取（commands.ts 纯逻辑）=====

# URL 归一：去 scheme、去 query/fragment、去尾部斜杠、全小写
段落 URL身份(url):
  设 文 为 url
  如果 开头(文, "https://"):
    设 文 为 截取到末尾(文, 8)
  否则如果 开头(文, "http://"):
    设 文 为 截取到末尾(文, 7)
  设 问号位 为 查找子串(文, "?")
  如果 问号位 >= 0:
    设 文 为 截取(文, 0, 问号位)
  设 井号位 为 查找子串(文, "#")
  如果 井号位 >= 0:
    设 文 为 截取(文, 0, 井号位)
  设 还在剥 为 真
  当 还在剥 == 真:
    如果 字符串长度(文) == 0:
      设 还在剥 为 假
    否则:
      设 末位 为 字符串长度(文) - 1
      如果 字符串获取(文, 末位) == "/":
        设 文 为 截取(文, 0, 末位)
      否则:
        设 还在剥 为 假
  返回 小写(文)

# 比较两个 CR URL 是否指向同一页面（忽略 scheme/大小写/query/fragment/尾斜杠）
段落 同变更请求URL(left, right):
  返回 URL身份(left) == URL身份(right)

# 判断一个字符是否是数字 0-9
段落 变更请求_是数字(字符):
  如果 字符 == "0":
    返回 真
  如果 字符 == "1":
    返回 真
  如果 字符 == "2":
    返回 真
  如果 字符 == "3":
    返回 真
  如果 字符 == "4":
    返回 真
  如果 字符 == "5":
    返回 真
  如果 字符 == "6":
    返回 真
  如果 字符 == "7":
    返回 真
  如果 字符 == "8":
    返回 真
  如果 字符 == "9":
    返回 真
  返回 假

# 去掉词尾不属于 URL 的标点
段落 变更请求_清理词尾(词):
  设 文 为 词
  设 还在剥 为 真
  当 还在剥 == 真:
    如果 字符串长度(文) == 0:
      设 还在剥 为 假
    否则:
      设 末位 为 字符串长度(文) - 1
      设 末字 为 字符串获取(文, 末位)
      如果 末字 == ".":
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == ",":
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == ";":
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == ")":
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == ">":
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == '"':
        设 文 为 截取(文, 0, 末位)
      否则如果 末字 == "'":
        设 文 为 截取(文, 0, 末位)
      否则:
        设 还在剥 为 假
  返回 文

# 判断一个词是否是含 /pull/数字 的 URL
段落 变更请求_是URL词(词):
  如果 开头(词, "http") == 假:
    返回 假
  设 拉取位 为 查找子串(词, "/pull/")
  如果 拉取位 < 0:
    返回 假
  设 号位 为 拉取位 + 6
  如果 号位 >= 字符串长度(词):
    返回 假
  设 首字 为 字符串获取(词, 号位)
  返回 变更请求_是数字(首字)

# 从文本中提取所有含 /pull/ 的 URL（按首次出现去重）
段落 找变更请求URL(文本):
  设 词表 为 分割字符串(文本, " ")
  设 结果 为 []
  遍历 词 之 词表:
    设 净词 为 变更请求_清理词尾(词)
    如果 变更请求_是URL词(净词):
      设 已含 为 假
      遍历 已有 之 结果:
        如果 同变更请求URL(已有, 净词):
          设 已含 为 真
      如果 已含 == 假:
        列表追加(结果, 净词)
  返回 结果

# 从 gh pr view/edit/checkout 输出中找自身 URL：
#   行首 "url: <URL>" 或裸 URL 行（在 -- 分隔线之前），加 JSON "url": "<URL>" 成员
段落 找自身URL(文本):
  设 结果 为 []
  设 行表 为 分割字符串(文本, "\n")
  设 已到分隔 为 假
  遍历 行 之 行表:
    如果 已到分隔 == 假:
      设 净行 为 去除空白(行)
      如果 净行 == "--":
        设 已到分隔 为 真
      否则:
        设 候选 为 ""
        如果 开头(净行, "url: "):
          设 候选 为 变更请求_清理词尾(截取到末尾(净行, 5))
        否则如果 变更请求_是URL词(净行):
          设 候选 为 净行
        如果 候选 != "":
          如果 变更请求_是URL词(候选):
            设 已含 为 假
            遍历 已有 之 结果:
              如果 同变更请求URL(已有, 候选):
                设 已含 为 真
            如果 已含 == 假:
              列表追加(结果, 候选)
  # JSON "url": "..." 成员
  设 结果 为 变更请求_扫JSONURL(文本, 结果)
  返回 结果

# 扫描 JSON 中的 "url": "https://.../pull/数字" 成员，追加到结果
段落 变更请求_扫JSONURL(文本, 结果表):
  设 标记 为 '"url": "'
  设 标记长 为 字符串长度(标记)
  设 位置 为 0
  当 位置 < 字符串长度(文本):
    设 命中 为 变更请求_找标记(文本, 标记, 位置)
    如果 命中 < 0:
      设 位置 为 字符串长度(文本)
    否则:
      设 值起 为 命中 + 标记长
      设 值止 为 值起
      设 找引号 为 真
      当 找引号 == 真:
        如果 值止 >= 字符串长度(文本):
          设 找引号 为 假
        否则:
          设 字 为 字符串获取(文本, 值止)
          如果 字 == '"':
            设 找引号 为 假
          否则:
            设 值止 为 值止 + 1
      如果 值止 > 值起:
        设 URL值 为 截取(文本, 值起, 值止)
        如果 变更请求_是URL词(URL值):
          设 已含 为 假
          遍历 已有 之 结果表:
            如果 同变更请求URL(已有, URL值):
              设 已含 为 真
          如果 已含 == 假:
            列表追加(结果表, URL值)
      设 位置 为 值止 + 1
  返回 结果表

# 从位置起找标记（朴素扫描）
段落 变更请求_找标记(文本, 标记, 起):
  设 标记长 为 字符串长度(标记)
  设 文本长 为 字符串长度(文本)
  设 甲 为 起
  当 甲 <= 文本长 - 标记长:
    设 命中 为 真
    设 乙 为 0
    当 乙 < 标记长:
      设 位置甲 为 甲 + 乙
      如果 字符串获取(文本, 位置甲) != 字符串获取(标记, 乙):
        设 命中 为 假
        设 乙 为 标记长
      否则:
        设 乙 为 乙 + 1
    如果 命中 == 真:
      返回 甲
    设 甲 为 甲 + 1
  返回 -1

# ===== 四、绑定投影（projection.ts 纯逻辑）=====

# 追加新绑定：已按 URL 身份存在的跳过，新的以指定来源追加
# 绑定表元素：{url, origin, dismissed}
段落 绑定追加(绑定表, URL表, 来源):
  设 新表 为 绑定表
  遍历 URL 之 URL表:
    设 已含 为 假
    遍历 已有 之 新表:
      如果 同变更请求URL(已有["url"], URL):
        设 已含 为 真
    如果 已含 == 假:
      列表追加(新表, {"url": URL, "origin": 来源, "dismissed": 假})
  返回 新表

# 记录推送分支：同 remote+branch 的旧记录移除，新记录以序号追加到末尾
# 推送表元素：{remote, branch, seq}
段落 记录推送(推送表, 新推送, 序号):
  如果 列表长度(新推送) == 0:
    返回 推送表
  设 保留 为 []
  遍历 旧 之 推送表:
    设 冲突 为 假
    遍历 新 之 新推送:
      如果 旧["remote"] == 新["remote"]:
        如果 旧["branch"] == 新["branch"]:
          设 冲突 为 真
    如果 冲突 == 假:
      列表追加(保留, 旧)
  遍历 新 之 新推送:
    列表追加(保留, {"remote": 新["remote"], "branch": 新["branch"], "seq": 序号})
  返回 保留

# ===== 五、评审状态归一（forge-github 纯逻辑面）=====

# 宿主 review state -> canonical ReviewDecision
# APPROVED -> approved; CHANGES_REQUESTED -> changes-requested;
# REVIEW_REQUIRED -> review-required; 其余 -> none
段落 评审归一(原始):
  如果 原始 == 空:
    返回 "none"
  设 文 为 转大写(转字符串(原始))
  如果 文 == "APPROVED":
    返回 "approved"
  如果 文 == "CHANGES_REQUESTED":
    返回 "changes-requested"
  如果 文 == "REVIEW_REQUIRED":
    返回 "review-required"
  返回 "none"


# ===== 六、快照概览与失败码（0.2.2-rc.1 forge 三条：#9 #10 #11）=====
#
# 上游 `ChangeRequestSnapshot` 有 13 个必填字段（packages/experimental/forge/src/types.ts，
# dsh-v0.2.2-rc.3 = 38a6a5c965）。键名取中文，与上游一一对应：
#   ref              -> 引用
#   branchUpdates    -> 分支更新
#   reviewDecision   -> 评审结论
#   reviewers        -> 评审者              reviewersTruncated        -> 评审者截断
#   canRequestReviews-> 可请求评审          checks                    -> 检查
#   canRerunChecks   -> 可重跑检查          unresolvedThreads         -> 未解决讨论
#   threadsTruncated -> 讨论截断            closingIssues             -> 关联议题
#   closingIssuesTruncated -> 关联议题截断  updatedAt                 -> 更新时间
#
# 指南给的「无平台数据」缺省形状：空数组 / false（本模块 变更请求快照缺省 逐字对齐）。

# 快照字段规格：[中文键, 取值类型]
# 类型名：字典 / 列表 / 布尔 / 数值（整数或浮点）/ 字符串
段落 变更请求快照字段规格():
  返回 [["引用", "字典"], ["分支更新", "列表"], ["评审结论", "字符串"], ["评审者", "列表"], ["评审者截断", "布尔"], ["可请求评审", "布尔"], ["检查", "列表"], ["可重跑检查", "布尔"], ["未解决讨论", "数值"], ["讨论截断", "布尔"], ["关联议题", "列表"], ["关联议题截断", "布尔"], ["更新时间", "字符串"]]

# 无平台数据时的完整快照（引用必须由调用方给）
段落 变更请求快照缺省(引用):
  返回 {"引用": 引用, "分支更新": [], "评审结论": "none", "评审者": [], "评审者截断": 假, "可请求评审": 假, "检查": [], "可重跑检查": 假, "未解决讨论": 0, "讨论截断": 假, "关联议题": [], "关联议题截断": 假, "更新时间": ""}

# 补全：只填缺失的必填字段，**不覆盖**调用方已给的值，也不丢弃额外键（原地改并返回同一字典）
段落 变更请求快照补全(原始, 引用):
  设 缺省 为 变更请求快照缺省(引用)
  遍历 字段 之 变更请求快照字段规格():
    设 键 为 字段[0]
    如果 字典包含键(原始, 键) == 假:
      原始[键] 为 缺省[键]
  返回 原始

# 校验：返回错误串列表（空列表 = 通过）。缺字段与类型不符分别报。
段落 变更请求快照校验(快照):
  设 错误表 为 []
  遍历 字段 之 变更请求快照字段规格():
    设 键 为 字段[0]
    设 类型名 为 字段[1]
    如果 字典包含键(快照, 键) == 假:
      列表追加(错误表, "快照缺少必填字段 " + 键)
    否则如果 变更请求_类型对(快照[键], 类型名) == 假:
      列表追加(错误表, "快照字段 " + 键 + " 应为" + 类型名)
  返回 错误表

# 类型判定（数值 = 整数或浮点；上游 unresolvedThreads 是 number）
段落 变更请求_类型对(值, 类型名):
  如果 类型名 == "字典":
    返回 是字典(值)
  如果 类型名 == "列表":
    返回 是列表(值)
  如果 类型名 == "布尔":
    返回 是布尔(值)
  如果 类型名 == "数值":
    如果 是整数(值):
      返回 真
    返回 是浮点(值)
  如果 类型名 == "字符串":
    返回 是字符串(值)
  返回 假

# 检查构造：rerun 为 ForgeCheckId 或 null（= 提供方无法重跑，例如 commit status）。
# 声明可重跑就必须给标识 —— 上游的 branded id 不能为空。
段落 变更请求检查构造(编号, 名称, 可重跑):
  如果 可重跑 == 真:
    如果 字符串长度(转字符串(编号)) == 0:
      变更请求_报错("可重跑检查缺少标识")
    返回 {"编号": 编号, "名称": 名称, "重跑": 编号}
  返回 {"编号": 编号, "名称": 名称, "重跑": 空}

# 读取失败的完整码集（types.ts：ForgeFailure['code']）
段落 变更请求失败码集():
  返回 ["not-found", "unauthenticated", "too-large", "stale", "unsupported", "unavailable"]

# 失败码语义：可重试 = 换了状态后同一读法有可能成功；需核对 = 结果不明、动作可能已生效。
# 注意 stale 是「可重试」但**必须先拿到新 head**；unsupported/unavailable 是能力缺失，不是读取失败。
# 本卡未覆盖的码（例如操作侧的 failed）一律响亮报错，不静默归类。
段落 变更请求失败语义(码):
  如果 码 == "stale":
    返回 {"码": "stale", "可重试": 真, "需核对": 假, "说明": "补丁不描述请求的 head；等状态更新后按新 head 重读，不要缓存旧 head 的结果"}
  如果 码 == "unsupported":
    返回 {"码": "unsupported", "可重试": 假, "需核对": 假, "说明": "提供方缺少该读取能力，不是可重试的读取失败"}
  如果 码 == "unavailable":
    返回 {"码": "unavailable", "可重试": 假, "需核对": 假, "说明": "提供方未实现该读取"}
  如果 码 == "unknown":
    返回 {"码": "unknown", "可重试": 假, "需核对": 真, "说明": "主机答复无法确认结果，改动可能已生效；核对前不要重试"}
  如果 码 == "not-found":
    返回 {"码": "not-found", "可重试": 假, "需核对": 假, "说明": "主机不暴露该变更请求"}
  如果 码 == "unauthenticated":
    返回 {"码": "unauthenticated", "可重试": 假, "需核对": 假, "说明": "凭据缺失或被拒"}
  如果 码 == "too-large":
    返回 {"码": "too-large", "可重试": 假, "需核对": 假, "说明": "输出超过上限"}
  变更请求_报错("本卡未覆盖的失败码：" + 转字符串(码))

段落 变更请求失败可重试(码):
  返回 变更请求失败语义(码)["可重试"]

# diff 定 head：补丁只在描述请求的 head 时可用；空补丁头同样视为过期（不能拿旧 head 的补丁顶）。
段落 变更请求差异过期(补丁头, 请求头):
  如果 字符串长度(转字符串(补丁头)) == 0:
    返回 真
  返回 转字符串(补丁头) != 转字符串(请求头)

# 评审读取：提供方未实现 readReview 时返回 unsupported（空串表示可读、无失败码）
段落 变更请求评审读取码(提供方实现):
  如果 提供方实现 == 真:
    返回 ""
  返回 "unsupported"