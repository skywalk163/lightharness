# JSONRPC传输.light —— NDJSON JSON-RPC 2.0 传输层（对齐上游 packages/sdk/protocol/src/transport.ts）
#
# 换行分隔（Newline-Delimited JSON-RPC 2.0）字节流协议的纯逻辑复刻：
#   - 三类线帧判别：id+method → 请求；仅 id → 响应；仅 method → 通知（transport.ts:211-223 handleLine）
#   - 非法行忽略：JSON 语法错 / 非对象 / 无 id 无 method 的行静默丢弃（transport.ts:201-209, 221-223）
#   - 错误帧形状：{ code, message, data? }，对齐上游 JsonRpcError（transport.ts:244-250, 256-258）
#   - 服务端分派：无请求处理器 → -32601 method not found；处理器失败 → -32603（transport.ts:226-238）
#   - 流式读侧：增量文本缓冲，按 \n 切完整行，半行保留待续（transport.ts:180-189 drainLines）
#   - 写侧：帧对象 → JSON.stringify + "\n"（transport.ts:260-262 write）
#   - 请求 ID：对齐上游 `req_${randomUUID().replaceAll('-','')}`（transport.ts:122）
#
# 与上游的差异（光明无 byte 流一等原语，按任务书用文本行流 + 显式帧分隔模拟）：
#   - 读侧按「文本块」推入，而非 Buffer + StringDecoder('utf8')；多字节 UTF-8 跨块切断由宿主层负责。
#   - 出站帧收进 己.待发 列表（内存缓冲），由宿主逐行写出；不直接绑定 node:stream Writable。
#   - 未移植 pending 请求映射 / Promise 关联 / AbortSignal / flush / 输入结束失败在途请求
#     （这些依赖 node:stream 与 async/await，属宿主绑定，见交付报告「未移植项」）。
#
# ⚠️ 光明命名规范：成员名避开关键字/运算符词根；成员赋值一律「设 己.X 为 …」。

从 JSON 导入 解析JSON, 序列化JSON

# ---- 错误码常量（对齐 transport.ts:229, 236）----
段落 错误码方法未找到:
  返回 -32601
段落 错误码处理器失败:
  返回 -32603

# ---- 请求 ID（对齐 transport.ts:122 `req_` + 32 位去连字符 UUID）----
# 光明无 node:crypto.randomUUID；按任务书用「时间戳 + 高熵随机」组合。
# 这里取三段随机整数拼接（熵约 10^9 * 10^5 * 10^4 ≈ 10^18），前缀仍为 req_，
# 与上游同为「req_ 前缀 + 高熵唯一段」语义；时间戳提升单调性见报告说明。
段落 造请求ID:
  设 秒段 为 转字符串(随机整数(100000000, 999999999))
  设 千段 为 转字符串(随机整数(10000, 99999))
  设 百段 为 转字符串(随机整数(1000, 9999))
  返回 "req_" + 秒段 + 千段 + 百段

# ---- params 归一化（对齐 transport.ts:272-274 objectParams）----
# 仅普通对象透传；数组 / 标量 / 空 一律塌缩为 {}。
段落 归一化参数(参数):
  如果 是空(参数):
    返回 {}
  如果 是字典(参数):
    返回 参数
  返回 {}

# ---- 错误对象（对齐上游 JsonRpcError wire 形状 transport.ts:244-250）----
# { code: number, message: string, data?: any }；data 为空时不带该字段。
段落 造错误(代码, 消息, 数据):
  设 对象 为 ["code": 代码, "message": 消息]
  如果 数据 != 空:
    对象["data"] 为 数据
  返回 对象

# ---- 帧编码（写侧，对齐 transport.ts:123/159/234/257/261）----
# 请求帧：{ jsonrpc, id, method, params }
段落 造请求帧(标识, 方法, 参数):
  设 帧 为 ["jsonrpc": "2.0", "id": 标识, "method": 方法]
  设 归一 为 归一化参数(参数)
  如果 长度(归一) > 0:
    帧["params"] 为 归一
  返回 帧

# 响应帧：{ jsonrpc, id, result }
段落 造响应帧(标识, 结果):
  返回 ["jsonrpc": "2.0", "id": 标识, "result": 结果]

# 通知帧：{ jsonrpc, method, [params] }；无参数则不带 params（对齐 transport.ts:158-160）
段落 造通知帧(方法, 参数):
  设 帧 为 ["jsonrpc": "2.0", "method": 方法]
  设 归一 为 归一化参数(参数)
  如果 长度(归一) > 0:
    帧["params"] 为 归一
  返回 帧

# 错误响应帧：{ jsonrpc, id, error: { code, message, [data] } }（对齐 transport.ts:256-258）
段落 造错误响应帧(标识, 代码, 消息, 数据):
  返回 ["jsonrpc": "2.0", "id": 标识, "error": 造错误(代码, 消息, 数据)]

# 帧封装成 NDJSON 行：JSON + "\n"（对齐 transport.ts:260-262）
段落 帧编码(消息):
  返回 序列化JSON(消息) 加上 "\n"

# ---- 帧判别（读侧核心，对齐 transport.ts:211-223）----
# 入参必须已是解析后的消息对象。返回：
#   "请求" —— id 为字符串/数字 且 method 为字符串（id+method）
#   "响应" —— id 为字符串/数字（仅 id）
#   "通知" —— method 为字符串（仅 method）
#   "非法" —— 其余（无 id 无 method，或类型不符）→ 调用方忽略（B 点：非法行静默忽略）
段落 判别帧(消息):
  如果 是字典(消息) == 假:
    返回 "非法"
  # 光明字典缺键抛错，先用 .包含 判键存在（对齐上游 frame.id 缺键得 undefined）
  设 有标识 为 假
  如果 消息.包含("id"):
    设 标识 为 消息["id"]
    设 有标识 为 (是字符串(标识) 或 是整数(标识) 或 是浮点(标识))
  设 有方法 为 假
  如果 消息.包含("method"):
    设 方法 为 消息["method"]
    设 有方法 为 是字符串(方法)
  # A 点（反跑）：先判「id+method → 请求」，再判「仅 id → 响应」，最后「仅 method → 通知」
  如果 有标识 且 有方法:
    返回 "请求"
  如果 有标识:
    返回 "响应"
  如果 有方法:
    返回 "通知"
  返回 "非法"

# ---- 增量行解码器（读侧流式，对齐 transport.ts:180-189 drainLines）----
# 光明无 byte 流一等原语：用文本块推入 + 显式 \n 帧分隔模拟。
# 推入(文本)：把文本拼进待定缓冲，按 \n 切出全部完整行（trim 后非空）返回；
#           半行（无 \n 结尾）留在 待定 等下一块——C 点（反跑：半行合并）。
# 收尾()  ：丢弃流末不完整残行（对齐上游 decoder.end() 后残留半行不成帧），返回该残行。
类 NDJSON行解码器:
  属性 待定 等于 ""

  段落 构造:
    设 己.待定 为 ""

  段落 推入(文本):
    设 己.待定 为 己.待定 + 文本
    设 行表 为 []
    设 进行 为 真
    当 进行 == 真:
      设 边界 为 查找子串(己.待定, "\n")
      如果 边界 < 0:
        设 进行 为 假
      否则:
        设 行 为 截取(己.待定, 0, 边界)
        设 己.待定 为 截取(己.待定, 边界 + 1, 字符串长度(己.待定))
        设 行 为 去除空白(行)
        如果 行 != "":
          行表.追加(行)
    返回 行表

  段落 收尾:
    设 残行 为 去除空白(己.待定)
    设 己.待定 为 ""
    返回 残行

# ---- 内存终端（同步模拟 JsonRpcLineTransport 的服务端分派纯逻辑）----
# 对齐 transport.ts:226-238 handleIncomingRequest / 221-223 通知分派：
#   - 安装 onRequest 处理器；入站请求无处理器 → -32601；处理器抛错 → -32603。
#   - 安装 onNotification 处理器；通知无处理器 → 丢弃（上游 drop）。
#   - 入站响应帧：终端侧原样记进 收到响应（不做 pending 关联，pending 留待未移植项）。
#   - 出站帧收进 己.待发（文本行，含结尾 \n），宿主逐个写出。
# 注意：光明无 async/Promise；处理器段落同步返回结果，抛错即视为失败（对齐 await 失败路径）。
类 JSONRPC终端:
  属性 请求处理器 等于 空
  属性 通知处理器 等于 空
  属性 待发 等于 []
  属性 收到响应 等于 []

  段落 构造:
    设 己.请求处理器 为 空
    设 己.通知处理器 为 空
    设 己.待发 为 []
    设 己.收到响应 为 []

  段落 安装请求处理器(处理器):
    设 己.请求处理器 为 处理器

  段落 安装通知处理器(处理器):
    设 己.通知处理器 为 处理器

  # 出站：把帧对象封装成 NDJSON 行塞进 待发（写侧聚合，宿主统一 flush）
  段落 写出(帧):
    己.待发.追加(帧编码(帧))

  # 消费并返回全部待发行（宿主取走写出后清空）
  段落 取待发:
    设 行表 为 己.待发
    设 己.待发 为 []
    返回 行表

  # 主入口：喂入一整行（已切分、已 trim 的文本行），完成判别 + 分派
  # B 点（反跑）：JSON 解析失败 / 判别为非法 → 静默忽略，不抛错。
  段落 接收行(行):
    如果 行 == "":
      返回
    尝试:
      设 消息 为 解析JSON(行)
    捕获 错误:
      返回
    设 种类 为 判别帧(消息)
    如果 种类 == "非法":
      返回
    如果 种类 == "请求":
      己.分派请求(消息)
    否则若 种类 == "通知":
      己.分派通知(消息)
    否则:
      己.收到响应.追加(消息)

  # 请求分派（对齐 transport.ts:226-238）
  段落 分派请求(消息):
    设 标识 为 消息["id"]
    设 方法 为 消息["method"]
    设 原始参数 为 空
    如果 消息.包含("params"):
      设 原始参数 为 消息["params"]
    设 参数 为 归一化参数(原始参数)
    设 处理器 为 己.请求处理器
    如果 处理器 == 空:
      己.写出(造错误响应帧(标识, 错误码方法未找到(), "method not found: " + 方法, 空))
      返回
    尝试:
      设 结果 为 处理器(方法, 参数)
    捕获 错误:
      己.写出(造错误响应帧(标识, 错误码处理器失败(), "handler failed", 空))
      返回
    己.写出(造响应帧(标识, 结果))

  # 通知分派（对齐 transport.ts:221-223）：无处理器丢弃
  段落 分派通知(消息):
    设 处理器 为 己.通知处理器
    如果 处理器 == 空:
      返回
    设 方法 为 消息["method"]
    设 原始参数 为 空
    如果 消息.包含("params"):
      设 原始参数 为 消息["params"]
    设 参数 为 归一化参数(原始参数)
    处理器(方法, 参数)

# =============================================================================
# R74 深化：异步传输层（pending 请求表 / 取消信号 / flush / 流挂接）
#
# 用光明现有一等 async/await（R70-B）做等价实现，不再依赖 node:stream 等宿主包：
#   - pending 请求表：请求发出 → 按 id 挂号 asyncio.Future → 响应按 id 撮合结算
#                      并发多请求各自 pending 条目，互不串味（按 id 寻址）。
#   - 取消信号：复用 src/中止.light 的 中止令牌（AbortSignal 等价）；取消后 pending
#               条目被清理，等待方收到「明确取消异常」，既不挂死也不静默。
#   - flush：把缓冲帧强制写到已挂接的可写流（流挂接的写出侧）。
#   - 流挂接：传输层可挂接到「可读写字节流」（内存/真实 socket 均可），而非只吃/吐字符串。
#
# 设计要点（对齐上游 transport.ts）：
#   - 上行（出站）：写侧 写出() 先把帧塞进 己.待发（NDJSON 行缓冲），flush() 推到流；
#                    与上游「帧 → JSON.stringify + \n → 可写流」一致。
#   - 下行（入站）：收流()/收行() 从流或字符串读行，判别后：请求→分派处理器、
#                    通知→分派、响应→结算对应 pending（按 id）。
#   - 取消竞速：请求任务 vs 轮询中止(令牌)；中止先到则清理 pending 并抛明确异常。
#
# ⚠️ 闭包坑：匿名 `段落 X 接收 参数:` 不能作函数调用实参（L-022 只覆盖赋值/返回）。
#    故「安装请求处理器」一律传具名 段落 的变量名（见 test_R74_路5_JSONRPC深化.light）。
# ⚠️ 类体不支持「异步 段落」：异步逻辑放在模块级 异步 段落，类方法为同步桥（返回协程）。
# ⚠️ Python 方法名直传：Future 用 .set_result/.done/.result()；不用 光明翻译名。
# =============================================================================

从 异步运行时 导入 创建Future, 未来拒绝
从 中止 导入 轮询中止

# ---- 可读写字节流（接口：写文本() / 读一行()）----
# 内存双向回环实现：写文本() 把文本推到「对端」的可读缓冲；读一行() 取本端可读缓冲。
# 传输层挂接此类即获得「流」语义；真实场景换成 socket 流（同样实现 写文本/读一行）即可。
类 内存字节流:
  属性 读入缓冲 等于 []
  属性 读位 等于 0
  属性 对端 等于 空

  段落 构造:
    设 己.读入缓冲 为 []
    设 己.读位 为 0
    设 己.对端 为 空

  # 与另一端点对端互联，构成双向回路
  段落 连接对端(另一流):
    设 己.对端 为 另一流

  # 可写侧：把文本写出到对端的可读缓冲（模拟字节流入对端）
  段落 写文本(文本):
    己.对端.读入缓冲.追加(文本)

  # 可读侧：取本端可读缓冲的下一行；无则空串
  段落 读一行:
    如果 己.读位 >= 长度(己.读入缓冲):
      返回 ""
    设 行 为 己.读入缓冲[己.读位]
    设 己.读位 为 己.读位 + 1
    返回 行

# ---- 异步 JSON-RPC 终端（pending 表 / 取消 / flush / 流挂接）----
类 JSONRPC异步终端:
  属性 请求处理器 等于 空
  属性 通知处理器 等于 空
  属性 待发 等于 []
  属性 挂起表 等于 {}
  属性 流 等于 空
  属性 解码器 等于 空

  段落 构造:
    设 己.请求处理器 为 空
    设 己.通知处理器 为 空
    设 己.待发 为 []
    设 己.挂起表 为 {}
    设 己.流 为 空
    设 己.解码器 为 新建 NDJSON行解码器()

  段落 安装请求处理器(处理器):
    设 己.请求处理器 为 处理器

  段落 安装通知处理器(处理器):
    设 己.通知处理器 为 处理器

  # 出站：把帧封装成 NDJSON 行塞进 待发（写侧聚合，flush 时落流）
  段落 写出(帧):
    己.待发.追加(帧编码(帧))

  # 消费并返回全部待发行（宿主取走写出后清空）
  段落 取待发:
    设 行表 为 己.待发
    设 己.待发 为 []
    返回 行表

  # 流挂接：把传输层接到一个可读写字节流（实现 写文本 / 读一行 接口）
  段落 挂接流(流对象):
    设 己.流 为 流对象

  # flush：把缓冲帧强制写到已挂接的流；返回写出帧数（无流则 0）
  段落 flush:
    如果 己.流 == 空:
      返回 0
    设 计数 为 长度(己.待发)
    遍历 帧 之 己.待发:
      己.流.写文本(帧)
    设 己.待发 为 []
    返回 计数

  # 主入口：喂入一整行（已 trim 的文本行），完成判别 + 分派
  # 响应帧 → 结算 pending；请求帧 → 分派处理器；通知 → 分派；非法/坏行静默忽略
  段落 收行(行):
    如果 行 == "":
      返回
    尝试:
      设 消息 为 解析JSON(行)
    捕获 错误:
      返回
    设 种类 为 判别帧(消息)
    如果 种类 == "非法":
      返回
    如果 种类 == "请求":
      己.分派请求(消息)
    否则若 种类 == "通知":
      己.分派通知(消息)
    否则:
      己.结算响应(消息)

  # 从已挂接的流读所有可用行并逐行处理（流挂接的读入侧）
  段落 收流:
    如果 己.流 == 空:
      返回
    设 行 为 己.流.读一行()
    当 行 != "":
      己.收行(行)
      设 行 为 己.流.读一行()

  # 结算响应：按 id 撮合 pending；成功→set_result(result)，错误→set_exception
  段落 结算响应(消息):
    设 标识 为 消息["id"]
    如果 己.挂起表.包含(标识) == 假:
      返回
    设 未来 为 己.挂起表[标识]
    字典删除(己.挂起表, 标识)
    如果 消息.包含("error"):
      设 错 为 消息["error"]
      未来拒绝(未来, "JSONRPC错误 code=" + 转字符串(错["code"]) + " msg=" + 错["message"])
    否则:
      未来.set_result(消息["result"])

  # 请求分派（对齐 transport.ts:226-238）：无处理器 -32601；处理器失败 -32603
  段落 分派请求(消息):
    设 标识 为 消息["id"]
    设 方法 为 消息["method"]
    设 原始参数 为 空
    如果 消息.包含("params"):
      设 原始参数 为 消息["params"]
    设 参数 为 归一化参数(原始参数)
    设 处理器 为 己.请求处理器
    如果 处理器 == 空:
      己.写出(造错误响应帧(标识, 错误码方法未找到(), "method not found: " + 方法, 空))
      返回
    尝试:
      设 结果 为 处理器(方法, 参数)
    捕获 错误:
      己.写出(造错误响应帧(标识, 错误码处理器失败(), "handler failed", 空))
      返回
    己.写出(造响应帧(标识, 结果))

  # 通知分派：无处理器丢弃
  段落 分派通知(消息):
    设 处理器 为 己.通知处理器
    如果 处理器 == 空:
      返回
    设 方法 为 消息["method"]
    设 原始参数 为 空
    如果 消息.包含("params"):
      设 原始参数 为 消息["params"]
    设 参数 为 归一化参数(原始参数)
    处理器(方法, 参数)

  # 发请求：异步；挂号 pending + 写帧 + 竞速 await（支持 中止令牌）
  # 返回协程，调用方 等待 之（或 创建任务 并发多个）
  段落 发请求(方法, 参数, 令牌):
    返回 协发请求(己, 方法, 参数, 令牌)

# ---- 模块级异步桥（类体不支持 异步 段落）----

# 等待一个 Future 完成并取结果（错误响应会以异常形式冒泡）
异步 段落 等待挂起(未来):
  返回 等待 未来

# 协发请求：挂号 → 写出 → 与 中止令牌 竞速；中止先到则清理 pending + 抛明确异常
异步 段落 协发请求(终端, 方法, 参数, 令牌):
  设 标识 为 造请求ID()
  设 帧 为 造请求帧(标识, 方法, 参数)
  终端.写出(帧)
  设 未来 为 创建Future()
  终端.挂起表[标识] 为 未来
  # 无令牌：直接等结算（错误响应经 等待 抛异常传播）
  如果 令牌 == 空:
    返回 等待 等待挂起(未来)
  # 有令牌：请求任务 vs 轮询中止 竞速
  设 任务甲 为 创建任务(等待挂起(未来))
  设 任务乙 为 创建任务(轮询中止(令牌))
  设 完成对 为 等待 首个完成([任务甲, 任务乙])
  设 待办集 为 完成对[1]
  # 响应先到：结算并返回（错误响应经 .result() 抛异常）
  如果 未来.done():
    任务乙.cancel()
    返回 未来.result()
  # 中止先到：清理 pending + 取消等待任务 + 抛明确取消异常（不挂死、不静默）
  如果 终端.挂起表.包含(标识):
    字典删除(终端.挂起表, 标识)
  任务甲.cancel()
  任务乙.cancel()
  抛出 "请求已取消: " + 转字符串(标识) + " 原因=" + 转字符串(令牌.读来源())
