# 总入口.light —— lightharness CLI 入口（对齐原版 apps/cli headless runner）
#
# 用法（环境变量传参，避免与 light run 的 argv 冲突）：
#   $env:HARNESS_MSG="你好"; $env:DEEPSEEK_API_KEY="sk-..."; python 运行.py examples/运行CLI.light
#
# 环境变量：
#   HARNESS_MSG         用户消息（或 HARNESS_PROMPT_FILE 指向提示文件）
#   HARNESS_PROMPT_FILE 提示文件路径（替代 HARNESS_MSG）
#   HARNESS_RESUME      会话标识：续写已有会话（对齐原版 --resume）
#   HARNESS_REPL        设 1 进入多轮交互模式（对齐原版 TUI 会话）
#   HARNESS_ENDPOINT    端点（默认 https://api.deepseek.com/chat/completions）
#   HARNESS_MODEL       模型（默认 = 取默认模型()，0.1.5 为 deepseek-flash / V41 Flash）
#   DEEPSEEK_API_KEY    API 密钥（必填；也可 HARNESS_API_KEY）
#   .env                项目根目录 .env 亦可配置密钥/端点/模型（DEEPSEEK_API_KEY / HARNESS_API_KEY /
#                       OPENAI_API_KEY；HARNESS_ENDPOINT / OPENAI_BASE_URL；HARNESS_MODEL / OPENAI_MODEL）
#   HARNESS_ROOT        持久化根目录（默认 sessions）
#   HARNESS_SESSION     会话标识（默认 cli_<时间戳>）
#   HARNESS_PRESET      会话内切换的 agent preset（standard / ptc / minimal / cordis；空串 = 不指定）
#     合法 → 按该预设的组合装配挂载集（切换效果超出 blank 窗口：首轮及以后都跑新组合）；
#     非法/未知 → 报错退出并打印可用四键。见 src/预设切换.light（上游 agent-preset-registry/src/session.ts）
#
# 命令面（第 7 轮任务1；对齐 apps/cli/src/args.ts L1-25 + dump-config.ts）：
#   上游哲学：launcher 只解析自己拥有的 flags（profile / --patch / config dumps），
#   其后所有参数原样转交 booted 树内插件解析；DshInvocation 三态 = profile 引导 /
#   dump-config（打印组合配置树、不 boot、不 eval !!js）/ plugin（pnpm 转发）。
#   光明现实映射：光明无 Cordis profile/patch 层系统、无 argv 子命令（本入口用环境变量
#   传参避免与 light run 的 argv 冲突）→ 不做 profile/plugin/argv 解析，把「命令面」
#   等价映射为「环境变量子命令 + 配置来源标注」，profile/patch/plugin 层继续登记宿主面：
#   HARNESS_CMD         子命令（缺省 run）：run / dump-config / version / help
#     run          现有 headless 行为不变（执行运行）
#     dump-config  打印当前生效配置，每项标注「来源」（环境变量 / .env / 内置默认），不 boot 不跑 agent
#     version      打印版本号
#     help         打印用法表
#     其它       打印「未知命令 + help 提示」并以非零退出码结束（抛出）
#
# 可测试导出：组装注册表 / 跑一轮 / 取最终文本（供 mock 客户端测试）
# ⚠️ 光明命名规范 v1：成员名/局部名避开关键字与运算符词根。

从 客户端 导入 客户端, 取默认模型
从 代理 导入 代理循环
从 会话 导入 新建会话
从 工具 导入 工具注册表
从 核心工具 导入 注册全部核心工具
从 生产挂载 导入 挂载全部插件
从 mcp接线 导入 挂载MCP服务器
从 插件启停 导入 读启停表, 加载插件映射, 按启停注销, 动态挂载撞车插件, 加载外部插件
从 持久化 导入 写出会话, 读入会话, 初始化日志, 追加事件行, 日志路径
从 令牌计量 导入 单价表, 取单价
从 压缩E5 导入 压缩配置
从 内置核心字典 导入 字典键列表, 字典包含键, 字典获取
从 内置核心转换 导入 转字符串
导入 re
从 预设切换 导入 装配挂载集, 重建预设
从 预设组合 导入 是已知预设
从 内置核心字符串 导入 开头, 结尾, 截取, 截取到末尾, 去除空白, 查找子串
从 内置核心判型 导入 是字典
从 字符串工具轻量 导入 分割字符串, 连接字符串

# ---- bash 工具已上收至 核心工具/工具_bash（第1步，G1 决策 a）----
# 原手写 执行bash（参数键 "command"，无超时、无路径安全）已删除；
# 生产 bash 由 工具_bash.造bash工具定义 提供（参数键 "命令"，含路径安全/30秒超时/输出归一）。

# ---- 工具线名（wire name）合名化 ----
# 根因①（第八轮实测）：DeepSeek API 对 tools[].function.name 强制 ^[A-Za-z0-9_]{1,64}$
#   （中文名整体 400 Bad Request）。minimal 只挂 bash（合名）故能通；standard/ptc/cordis
#   挂 读文件/写文件/搜索文件（中文名）故全 500。在 兼容注册表 出线口统一合名化：
#   合名原样透出；核心 fs 三件给固定可读线名；其余不合名工具按登记序 tool_<序> 确定性兜底；
#   执行入口按回名表反查，模型可见线名与注册名解耦。
设 合法线名模式 等于 "^[A-Za-z0-9_]{1,64}$"
设 固定线名表 为 {"读文件": "read_file", "写文件": "write_file", "搜索文件": "search_files"}

# ---- OpenAI 兼容工具注册表包装器 ----
# 工具注册表.描述表() 返回 {name,description,parameters} 平铺格式，
# DeepSeek API 要求 {type:"function", function:{name,description,parameters}} 包装。
# 工具.light 只读，在此包装转发（并按上方规则做线名合名化）。
类 兼容注册表:
  属性 内部表 等于 空
  属性 线名表 等于 空   # 注册名 → 线名（模型可见）
  属性 回名表 等于 空   # 线名 → 注册名（执行反查）

  段落 构造(注册表):
    设 己.内部表 为 注册表
    设 己.线名表 为 {}
    设 己.回名表 为 {}
    设 序号 为 0
    遍历 名 之 注册表.名单():
      设 候选 为 己.造线名(名, 序号)
      当 (字典包含键(己.回名表, 候选) == 真) 且 (候选 != 名):
        设 候选 为 候选 + "_d" + 转字符串(序号)
      设 己.线名表[名] 为 候选
      设 己.回名表[候选] 为 名
      设 序号 为 序号 + 1

  # 单名合名化：合名原样；固定表命中取固定线名；其余 tool_<序>
  段落 造线名(名, 序号):
    设 命中 为 re.match(合法线名模式, 名)
    如果 命中 != 空:
      返回 名
    如果 字典包含键(固定线名表, 名) == 真:
      返回 固定线名表[名]
    返回 "tool_" + 转字符串(序号)

  段落 线名(注册名):
    返回 字典获取(己.线名表, 注册名, 注册名)

  段落 回名(线侧名):
    返回 字典获取(己.回名表, 线侧名, 线侧名)

  段落 描述表:
    设 原始 为 己.内部表.描述表()
    设 结果 为 []
    遍历 项 之 原始:
      设 线侧名 为 己.线名(项["name"])
      设 函数 为 ["name": 线侧名, "description": 项["description"], "parameters": 项["parameters"]]
      结果.追加(["type": "function", "function": 函数])
    返回 结果

  段落 执行(名字, 原始参数):
    设 注册名 为 己.回名(名字)
    返回 己.内部表.执行(注册名, 原始参数)

  段落 执行策略(名字):
    设 注册名 为 己.回名(名字)
    返回 己.内部表.执行策略(注册名)

  段落 名单:
    返回 己.内部表.名单()

# ---- 注册内置工具（第1步：核心四件套经 核心工具.注册全部核心工具 统一注册）----
# ---- 第2步：末尾追加 lightplugin 生产挂载；第3步：末尾追加 MCP 直连注册 ----
#   同名覆盖时后挂的赢，核心工具先挂保证 [0..3] 顺序稳定。
段落 组装注册表(预设标识=空, 数据根=空):
  设 注册表 为 新建 工具注册表()
  注册全部核心工具(注册表)
  挂载全部插件(注册表)
  动态挂载撞车插件(注册表)
  挂载MCP服务器(注册表)
  # 第4步（集成 R103/R104 预设装配）：给预设则按挂载集过滤（映射层见 工具名到叶子）
  如果 预设标识 != 空 且 预设标识 != "":
    预设保留工具(注册表, 预设标识)
  # R111：数据根非空时按 <根>/plugins.json 停用显式关闭的光明插件工具
  如果 数据根 != 空 且 数据根 != "":
    加载外部插件(注册表, 数据根)
    设 启停表 为 读启停表(数据根)
    设 映射 为 加载插件映射()
    按启停注销(注册表, 启停表, 映射)
  返回 新建 兼容注册表(注册表)

# ---- 第4步·映射层：真实工具名 → 预设叶子 id（上游包名）----
#   命名空间错位是原死代码根因：注册表条目 标识 用工具名（bash/读文件…），
#   预设展平 id 用上游包名（tool-bash/terminal-bash/tool-fs…），两者对不上。
#   本映射把工具名翻成预设叶子 id，供 按预设过滤 精确匹配；不匹配者（lightplugin / MCP
#   当前四预设无对应叶子）默认不挂载，等 G5 文档外置化按模式补叶子。
#   注意：lightharness 仅有 bash 一种 shell，故所有 shell 族叶子（bash/pwsh 两系）均指向 bash；
#   配合 预设求值能力 的「非 win32」约定，各预设模式下 bash 恒挂载（pwsh 系上游在非 win32 禁用）。
段落 工具名到叶子(名字):
  如果 名字 == "bash":
    返回 ["tool-bash", "terminal-bash", "persistent-bash", "pty", "tool-pwsh", "terminal-pwsh", "persistent-pwsh"]
  如果 名字 == "读文件" 或 名字 == "写文件":
    返回 ["tool-fs"]
  如果 名字 == "搜索文件":
    返回 ["tool-fs-search"]
  # lightplugin / MCP 工具：当前四预设无对应叶子，暂不挂载（G5 后按模式新增）
  返回 []

# ---- 第4步·条目表（带映射）：每个工具按其映射叶子各出一条，附 工具名 便于回写 ----
段落 造条目表带映射(注册表):
  设 表 为 []
  遍历 名字 之 注册表.名单():
    遍历 叶 之 工具名到叶子(名字):
      表.追加(["标识": 叶, "工具名": 名字])
  返回 表

# ---- 第4步·预设 js 求值能力：把 !!js 表达式求值为布尔 ----
#   上游 tool-bash / terminal-bash 带 `process.platform === 'win32'`（win32 禁用），
#   pwsh 系反之。lightharness 仅实现 bash，按「非 win32」约定求值，保证 shell 恒可用；
#   无法识别的表达式抛错，由 预设深化.禁用贡献 降级为 'conditional'→跳过。
段落 预设求值能力(表达式):
  如果 表达式 == "process.platform === 'win32'":
    返回 假
  如果 表达式 == "process.platform !== 'win32'":
    返回 真
  如果 表达式 == "!ctx.get('profileContext')":
    返回 真
  抛出 新建 错误("预设求值能力: 不支持的 js 表达式: " + 表达式)

# ---- 第4步·按预设过滤后只保留命中工具（注册表原地注销未命中项）----
#   ⚠️ 注销时遍历 名单() 的快照副本，避免在迭代中改动顺序表导致漏删。
段落 预设保留工具(注册表, 预设标识):
  如果 是已知预设(预设标识) == 假:
    抛出 "未知 agent preset: " + 转字符串(预设标识) + "（可用: standard / ptc / minimal / cordis）"
  设 表 为 造条目表带映射(注册表)
  设 装配 为 装配挂载集(表, 预设标识, 预设求值能力)
  设 保留 为 []
  遍历 项 之 装配[0]:
    如果 项.包含("工具名") == 真:
      设 名 为 项["工具名"]
      如果 保留.包含(名) == 假:
        保留.追加(名)
  设 名表 为 []
  遍历 名 之 注册表.名单():
    名表.追加(名)
  遍历 名 之 名表:
    如果 保留.包含(名) == 假:
      注册表.注销(名)
  返回 注册表

# ---- 预设分叉支撑（第104轮 任务线A）：注册表工具名 → 条目表（供 装配挂载集 过滤打印）----
# 条目形状与 src/预设挂载过滤.light 的 挂条目标识 对齐（取 "标识" 键）
段落 造注册表条目表(注册表):
  设 条目表 为 []
  遍历 名字 之 注册表.名单():
    条目表.追加(["标识": 名字])
  返回 条目表

# ---- 预设分叉：HARNESS_PRESET → 装配挂载集（可测试导出；未知预设抛错，不静默返回空表）----
# 语义（上游 session.ts）：切换后**首轮及以后每一轮**都跑在新挂载的组合下，故装配一律
#   以「切换后」的预设标识进行；重建读 agentPreset 投影而非只读 header（见 预设切换.重建预设）
段落 解析预设装配(预设标识, 注册表):
  如果 是已知预设(预设标识) == 假:
    抛出 "未知 agent preset: " + 转字符串(预设标识) + "（可用: standard / ptc / minimal / cordis）"
  设 条目表 为 造条目表带映射(注册表)
  返回 装配挂载集(条目表, 预设标识, 预设求值能力)

# ---- 统计会话已有轮次数（续写时 turn 序号连续）----
段落 取已有轮数(会话对象):
  设 计数 为 0
  遍历 事件 之 会话对象.汇集全部事件():
    如果 事件["类型"] == "turn/start":
      设 计数 为 计数 + 1
  返回 计数

# ---- 驱动一轮并返回轮次结果（可测试：客户端可为 mock）----
# ---- 增量保存：从指定事件序号开始，逐个追加到 JSONL（v2，与 #3 协同）----
段落 增量保存(根, 会话对象, 起始序号):
  设 工作目录 为 会话对象.头信息.获取("工作目录", ".")
  设 标识 为 会话对象.标识
  设 路径 为 日志路径(根, 工作目录, 标识)
  如果 文件存在(路径) == 假:
    初始化日志(根, 会话对象)
  遍历 事件记录 之 会话对象.汇集全部事件():
    如果 事件记录["序号"] >= 起始序号:
      追加事件行(根, 工作目录, 标识, 事件记录)
  返回 路径

# ---- 会话列表：列出根目录下所有已有会话（HARNESS_LIST=1）----
段落 列出会话(根):
  如果 目录存在(根) == 假:
    打印 "尚无会话（根目录不存在: " + 根 + "）"
    返回
  设 项目表 为 列出目录(根)
  设 总数 为 0
  遍历 项目名 之 项目表:
    设 项目路径 为 根 + "\\" + 项目名
    如果 目录存在(项目路径):
      设 会话表 为 列出目录(项目路径)
      遍历 会话名 之 会话表:
        设 会话路径 为 项目路径 + "\\" + 会话名 + "\\session.jsonl"
        如果 文件存在(会话路径):
          设 总数 为 总数 + 1
          打印 "  [" + 转字符串(总数) + "] " + 项目名 + " / " + 会话名
  如果 总数 == 0:
    打印 "尚无会话"
  否则:
    打印 "共 " + 转字符串(总数) + " 个会话"

段落 跑一轮(客户端对象, 注册表, 会话对象, 用户文本, 选项=空):
  # #273 总装配链（第6轮 C 线）：解析预设 → 装配挂载集 → 注入团队/子代理注册表
  # → 代理循环按 inbox 驱动（代理.驱动 内部排空 inbox + 每轮后投影刷新）
  设 用了预设 为 假
  设 装配注册表 为 注册表
  # 1) 外部选项预设（R103/R104：组装注册表 含 预设保留工具 过滤）
  如果 选项 != 空 且 选项.包含("预设") 且 选项["预设"] != 空 且 选项["预设"] != "":
    设 装配注册表 为 组装注册表(选项["预设"])
    设 用了预设 为 真
  # 1.5) R109-B：对话内切换——从会话事件投影重建当前生效预设。
  #   语义（上游 session.ts）：agent-preset/selected 事件效果超出 blank 窗口——首轮及以后每一轮
  #   都跑在新挂载组合下。重建读 agentPreset 投影（不只读 header），见 预设切换.重建预设。
  #   会话事件形状为 类型/数据（会话.记录事件 产出），预设切换.预设投影推进 已兼容 data/数据 双键。
  #   未知预设不静默：投影产出的预设标识必须落在四键内，否则抛出。
  设 会话预设 为 重建预设(会话对象.头信息, 会话对象.汇集全部事件())
  如果 会话预设 != 空 且 会话预设 != "":
    如果 是已知预设(会话预设) == 假:
      抛出 "未知 agent preset: " + 转字符串(会话预设) + "（可用: standard / ptc / minimal / cordis）"
    设 装配注册表 为 组装注册表(会话预设)
    设 用了预设 为 真
  # 2) 注入团队/子代理注册表（可选）：合并其工具定义到内部 工具注册表
  如果 选项 != 空 且 选项.包含("团队注册表") 且 选项["团队注册表"] != 空:
    如果 用了预设 == 真:
      设 内部 为 装配注册表.内部表
    否则:
      设 装配注册表 为 新建 兼容注册表(注册表)
      设 内部 为 装配注册表.内部表
    设 团队 为 选项["团队注册表"]
    遍历 名 之 团队.名单():
      内部.注册(团队.查找(名))
  设 代理 为 新建 代理循环(会话对象, 客户端对象, 装配注册表, [])
  设 代理.轮号 为 取已有轮数(会话对象)
  返回 代理.驱动(用户文本)

# ---- 汇集全部助手文本块 ----
段落 取最终文本(会话对象):
  设 结果 为 ""
  遍历 消息 之 会话对象.整理消息():
    如果 消息["role"] == "assistant":
      遍历 块 之 消息["content"]:
        如果 块["type"] == "text":
          设 结果 为 结果 + 块["text"] + "\n"
  返回 结果.去除空白()

# ---- 打印一轮结果 + 最终文本 ----
段落 打印轮次(结果, 会话对象):
  打印 "--- 轮次结束: " + 结果["种类"] + " ---"
  如果 结果["种类"] == "error" 且 结果.包含("失败"):
    设 失败 为 结果["失败"]
    如果 失败 != 空:
      设 详情 为 失败
      如果 是字典(失败):
        如果 失败.包含("消息"):
          设 详情 为 失败["消息"]
          如果 失败.包含("代码"):
            设 详情 为 转字符串(详情) + " [" + 转字符串(失败["代码"]) + "]"
        否则如果 失败.包含("失败"):
          设 详情 为 失败["失败"]
        否则:
          设 详情 为 失败
      打印 "--- 失败原因: " + 转字符串(详情) + " ---"
  打印 "--- 助手最终回复 ---"
  打印 取最终文本(会话对象)

# ---- 多轮交互模式 ----
段落 交互循环(客户端对象, 注册表, 会话对象, 根):
  打印 "进入交互模式（输入 exit 退出）"
  设 继续 为 真
  当 继续:
    打印 ""
    打印 "你 > "
    设 输入 为 读取行().去除空白()
    如果 输入 == "exit" 或 输入 == "退出":
      设 继续 为 假
    否则 如果 输入 == "":
      跳过
    否则:
      设 保存前序号 为 长度(会话对象.汇集全部事件())
      尝试:
        设 结果 为 跑一轮(客户端对象, 注册表, 会话对象, 输入)
        打印轮次(结果, 会话对象)
        增量保存(根, 会话对象, 保存前序号)
      捕获 异常 错误:
        打印 "[请求失败] " + 转字符串(错误)
        打印 "请检查网络连接和 API 密钥后重试"

# ---- 从项目根目录 .env 读取配置值（找不到文件或键则返回 空）----
段落 读取环境文件值(目标键):
  设 环境文件 为 当前目录() + "\\.env"
  如果 文件存在(环境文件) == 假:
    返回 空
  设 内容 为 读取文件(环境文件)
  遍历 行 之 分割字符串(内容, "\n"):
    设 行 为 去除空白(行)
    如果 行 == "":
      跳过
    如果 开头(行, "#"):
      跳过
    设 等号 为 查找子串(行, "=")
    如果 等号 == -1:
      跳过
    设 键 为 去除空白(截取(行, 0, 等号))
    如果 键 != 目标键:
      跳过
    设 值 为 去除空白(截取到末尾(行, 等号 + 1))
    如果 开头(值, "\"") 且 结尾(值, "\""):
      设 值 为 截取(值, 1, 长度(值) - 1)
    返回 值
  返回 空

# ---- 模型解析链（注入式，供测试；主() 用真实环境/文件取值调用）----
# 优先级：环境变量 HARNESS_MODEL → .env HARNESS_MODEL → .env OPENAI_MODEL →
# 内置默认 取默认模型()（0.1.5：DeepSeek V41 Flash，提交 bc5fd3b8dc）。
# 用户显式配置永远优先于内置默认。
段落 解析模型(环境取值, 文件甲取值, 文件乙取值):
  如果 环境取值 不等于 空 且 环境取值 != "":
    返回 环境取值
  如果 文件甲取值 不等于 空 且 文件甲取值 != "":
    返回 文件甲取值
  如果 文件乙取值 不等于 空 且 文件乙取值 != "":
    返回 文件乙取值
  返回 取默认模型()

# ---- run 子命令本体（原 headless 主流程；第 7 轮命令面调度后重命名为 执行运行）----
段落 执行运行:
  设 用户文本 为 环境变量("HARNESS_MSG", 空)
  设 提示文件 为 环境变量("HARNESS_PROMPT_FILE", 空)
  如果 用户文本 == 空 且 提示文件 != 空 且 提示文件 != "":
    尝试:
      设 用户文本 为 读取文件(提示文件).去除空白()
    捕获 异常 错误:
      打印 "错误: 无法读取提示文件 " + 提示文件 + " (" + 转字符串(错误) + ")"
      返回
  # 端点：环境变量 → 项目根 .env（HARNESS_ENDPOINT / OPENAI_BASE_URL）→ 内置默认
  设 端点 为 环境变量("HARNESS_ENDPOINT", 空)
  如果 端点 == 空 或 端点 == "":
    设 端点 为 读取环境文件值("HARNESS_ENDPOINT")
  如果 端点 == 空 或 端点 == "":
    设 端点 为 读取环境文件值("OPENAI_BASE_URL")
    如果 端点 != 空 且 端点 != "" 且 查找子串(端点, "chat/completions") == -1:
      设 端点 为 端点 + "/chat/completions"
  如果 端点 == 空 或 端点 == "":
    设 端点 为 "https://api.deepseek.com/chat/completions"
  # 模型：环境变量 → 项目根 .env（HARNESS_MODEL / OPENAI_MODEL）→ 内置默认 取默认模型()
  设 模型 为 解析模型(环境变量("HARNESS_MODEL", 空), 读取环境文件值("HARNESS_MODEL"), 读取环境文件值("OPENAI_MODEL"))
  # 会话列表模式（不需要 API key）
  设 列表模式 为 环境变量("HARNESS_LIST", "0")
  如果 列表模式 == "1":
    设 根 为 环境变量("HARNESS_ROOT", "sessions")
    打印 "--- 已有会话列表（根: " + 根 + "） ---"
    列出会话(根)
    返回
  # 预设分叉（第104轮 任务线A；对齐 :251 列表模式分叉写法）：HARNESS_PRESET 空串 = 不指定；
  #   合法 → 装配挂载集并打印；非法/未知 → 报错退出并打印可用四键。
  #   ⚠️ 仅新增环境变量分支与打印，不触碰 REPL / 列表 / 单轮三条主路径的控制流。
  设 预设标识 为 环境变量("HARNESS_PRESET", "")
  如果 预设标识 != 空 且 预设标识 != "":
    如果 是已知预设(预设标识) == 假:
      打印 "错误: 未知 agent preset \"" + 预设标识 + "\""
      打印 "可用 preset: standard / ptc / minimal / cordis"
      抛出 "未知 agent preset: " + 预设标识 + "（可用: standard / ptc / minimal / cordis）"
    设 装配 为 解析预设装配(预设标识, 组装注册表())
    打印 "--- agent preset: " + 预设标识 + " ---"
    打印 "挂载条目数: " + 转字符串(长度(装配[0])) + "  跳过条目数: " + 转字符串(长度(装配[1]))
  # 密钥：环境变量 → 项目根 .env（DEEPSEEK_API_KEY / HARNESS_API_KEY / OPENAI_API_KEY）
  设 密钥 为 环境变量("HARNESS_API_KEY", 空)
  如果 密钥 == 空:
    设 密钥 为 环境变量("DEEPSEEK_API_KEY", 空)
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("DEEPSEEK_API_KEY")
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("HARNESS_API_KEY")
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("OPENAI_API_KEY")
  如果 密钥 == 空 或 密钥 == "":
    打印 "错误: 未提供 API 密钥"
    打印 "请在项目根目录 .env 中配置 DEEPSEEK_API_KEY / HARNESS_API_KEY / OPENAI_API_KEY，或设环境变量"
    打印 "示例: 设 HARNESS_MSG 为消息 + DEEPSEEK_API_KEY 为密钥 + python 运行.py examples/运行CLI.light"
    返回
  设 根 为 环境变量("HARNESS_ROOT", "sessions")
  设 会话标识 为 环境变量("HARNESS_SESSION", "cli_" + 转字符串(时间戳()))
  设 续写标识 为 环境变量("HARNESS_RESUME", 空)
  设 工作目录 为 当前目录()

  设 客户端对象 为 新建 客户端(端点, 密钥, 模型)
  设 注册表 为 组装注册表(预设标识)

  # 续写或新建会话
  设 会话对象 为 空
  如果 续写标识 != 空 且 续写标识 != "":
    尝试:
      设 会话对象 为 读入会话(根, 工作目录, 续写标识)
      打印 "--- 已续写会话: " + 续写标识 + " ---"
    捕获 异常 错误:
      打印 "错误: 无法续写会话 " + 续写标识 + " (" + 转字符串(错误) + ")"
      打印 "请检查 HARNESS_RESUME 是否指向有效会话"
      返回
  否则:
    设 会话对象 为 新建会话(会话标识, 工作目录)

  # 交互模式或单轮
  设 交互 为 环境变量("HARNESS_REPL", "0")
  如果 交互 == "1":
    交互循环(客户端对象, 注册表, 会话对象, 根)
  否则:
    如果 用户文本 == 空:
      打印 "用法: 设 HARNESS_MSG 为用户消息 + DEEPSEEK_API_KEY 为密钥，然后 python 运行.py examples/运行CLI.light（或 HARNESS_REPL=1 进交互）"
      返回
    设 保存前序号 为 长度(会话对象.汇集全部事件())
    尝试:
      设 结果 为 跑一轮(客户端对象, 注册表, 会话对象, 用户文本)
      打印轮次(结果, 会话对象)
      设 路径 为 增量保存(根, 会话对象, 保存前序号)
      打印 "--- 已持久化(增量): " + 路径 + " ---"
    捕获 异常 错误:
      打印 "[请求失败] " + 转字符串(错误)
      打印 "请检查网络连接和 API 密钥后重试"

# ============================================================
# 命令面调度（第 7 轮任务1；对齐 apps/cli/src/args.ts + dump-config.ts）
# ============================================================
# 上游对齐点：
#   args.ts L1-25 —— launcher 只解析自己拥有的 flags（profile / --patch / config dumps），
#     其后所有参数原样转交 booted 树内插件解析；DshInvocation 三态 = profile 引导 /
#     dump-config（打印组合配置树、不 boot、不 eval !!js）/ plugin（pnpm 转发）。
#   dump-config.ts runDumpConfig —— 按 layer 打印组合配置，注释命名每个来源文件。
# 光明现实映射（重要）：光明无 Cordis profile/patch 层系统、无 argv 子命令（本入口用
#   环境变量传参避免与 light run 的 argv 冲突）→ 不做 profile/plugin/argv 解析，把
#   「命令面」等价映射为「环境变量子命令 + 配置来源标注」：HARNESS_CMD 选子命令（缺省 run），
#   dump-config 逐项标注「来源」（环境变量 / .env / 内置默认），对齐「命名每个来源」哲学。
#   profile / patch / plugin 层与 argv 子命令解析属宿主面，未映射，维持对标登记。
# ============================================================

# 版本号（对齐 docs/功能对标/对标清单.json「版本」0.1.5-rc.2；-lh 标识 lightharness 复刻分支）
设 版本号 为 "0.1.5-lh"

# 子命令缺省值（对齐 args.ts 的默认 profile 引导）
设 缺省子命令 为 "run"

# ---- 模型解析链的「来源」标注（顺序复用 解析模型：环境变量 → .env HARNESS_MODEL
#      → .env OPENAI_MODEL → 内置默认 取默认模型()）----
段落 取模型来源(环境取值, 文件甲取值, 文件乙取值):
  如果 环境取值 != 空 且 环境取值 != "":
    返回 "环境变量 HARNESS_MODEL"
  如果 文件甲取值 != 空 且 文件甲取值 != "":
    返回 ".env HARNESS_MODEL"
  如果 文件乙取值 != 空 且 文件乙取值 != "":
    返回 ".env OPENAI_MODEL"
  返回 "内置默认 取默认模型()"

# ---- 压缩配置的「来源」标注（压缩E5.压缩配置 构造时读同名环境变量，缺省走类属性）----
段落 取环境变量来源(目标键, 缺省文案):
  设 值 为 环境变量(目标键, 空)
  如果 值 != 空 且 值 != "":
    返回 "环境变量 " + 目标键
  返回 缺省文案

# ---- dump-config：当前生效配置 + 逐项来源标注（不 boot、不跑 agent）----
段落 取配置文本:
  设 行表 为 []
  行表.追加("=== 当前生效配置（版本 " + 版本号 + "） ===")
  行表.追加("子命令: " + 环境变量("HARNESS_CMD", 缺省子命令) + "（来源: 环境变量 HARNESS_CMD，缺省 " + 缺省子命令 + "）")
  行表.追加("命令根: " + 当前目录() + "（来源: 运行时 当前目录()）")
  设 环境取值 为 环境变量("HARNESS_MODEL", 空)
  设 文件甲取值 为 读取环境文件值("HARNESS_MODEL")
  设 文件乙取值 为 读取环境文件值("OPENAI_MODEL")
  行表.追加("模型: " + 解析模型(环境取值, 文件甲取值, 文件乙取值) + "（来源: " + 取模型来源(环境取值, 文件甲取值, 文件乙取值) + "）")
  行表.追加("模型单价表（美元 / 1M tokens，输入 / 输出；来源: 内置默认 令牌计量.单价表）")
  遍历 模型键 之 字典键列表(单价表):
    设 价 为 单价表[模型键]
    行表.追加("  " + 模型键 + "  输入 " + 转字符串(价[0]) + "  输出 " + 转字符串(价[1]))
  设 缺省价 为 取单价("未知模型")
  行表.追加("  未知模型  输入 " + 转字符串(缺省价[0]) + "  输出 " + 转字符串(缺省价[1]) + "（来源: 内置默认 令牌计量.缺省单价表）")
  行表.追加("压缩配置（来源: 环境变量优先，缺省 内置默认 压缩E5.压缩配置）")
  设 压缩表 为 新建 压缩配置().状态()
  行表.追加("  阈值token: " + 转字符串(压缩表["阈值token"]) + "（来源: " + 取环境变量来源("HARNESS_COMPACTION_THRESHOLD", "内置默认 8000") + "）")
  行表.追加("  保留轮数: " + 转字符串(压缩表["保留轮数"]) + "（来源: " + 取环境变量来源("HARNESS_COMPACTION_KEEP_ROUNDS", "内置默认 6") + "）")
  行表.追加("  上下文窗口: " + 转字符串(压缩表["上下文窗口"]) + "（来源: " + 取环境变量来源("HARNESS_MODEL_CONTEXT_WINDOW", "内置默认 32768") + "）")
  行表.追加("会话根: " + 环境变量("HARNESS_ROOT", "sessions") + "（来源: 环境变量 HARNESS_ROOT，缺省 sessions）")
  行表.追加("未列字段: 端点与密钥不打印（HARNESS_ENDPOINT / DEEPSEEK_API_KEY / HARNESS_API_KEY / OPENAI_API_KEY）")
  行表.追加("未映射宿主面: profile / patch / plugin 层与 argv 子命令解析（Cordis 层系统），维持对标登记")
  返回 连接字符串(行表, "\n")

# ---- help：命令用法表（含现有参数表）----
段落 取用法文本:
  设 行表 为 []
  行表.追加("=== lightharness CLI 用法（版本 " + 版本号 + "） ===")
  行表.追加("子命令: 设 HARNESS_CMD 为 子命令（缺省 " + 缺省子命令 + "）")
  行表.追加("  run          headless 运行（执行运行：HARNESS_MSG / HARNESS_PROMPT_FILE / HARNESS_RESUME / HARNESS_REPL=1）")
  行表.追加("  dump-config  打印当前生效配置并逐项标注「来源」（不 boot、不跑 agent）")
  行表.追加("  version      打印版本号")
  行表.追加("  help         打印本用法表")
  行表.追加("未知命令: 打印「未知命令 + help 提示」并以非零退出码结束")
  行表.追加("")
  行表.追加("参数（环境变量；对齐 args.ts「launcher 只解析自己的 flags」）:")
  行表.追加("  HARNESS_CMD=run|dump-config|version|help（缺省 run）")
  行表.追加("  HARNESS_MSG / HARNESS_PROMPT_FILE  用户消息与提示文件")
  行表.追加("  HARNESS_RESUME / HARNESS_SESSION / HARNESS_ROOT  续写会话与持久化根（缺省 sessions）")
  行表.追加("  HARNESS_REPL=1 / HARNESS_LIST=1  交互模式与会话列表")
  行表.追加("  HARNESS_PRESET=standard|ptc|minimal|cordis  会话内切换 agent preset（空串不指定；未知值报错退出并打印可用四键）")
  行表.追加("  HARNESS_ENDPOINT  端点（缺省 https://api.deepseek.com/chat/completions）")
  行表.追加("  HARNESS_MODEL  模型（缺省 取默认模型()，0.1.5 为 deepseek-flash）")
  行表.追加("  DEEPSEEK_API_KEY 或 HARNESS_API_KEY  密钥必填，亦可写入项目根 .env")
  行表.追加("  HARNESS_COMPACTION_THRESHOLD / HARNESS_COMPACTION_KEEP_ROUNDS / HARNESS_MODEL_CONTEXT_WINDOW")
  行表.追加("  CLI 外壳(argv，第6轮#255)：--model/--preset/--prompt/--resume/--list/--config/--help（见 src/cli外壳.light）")
  行表.追加("")
  行表.追加("示例: 设 HARNESS_CMD 为 dump-config，然后 python 运行.py examples/运行CLI.light")
  行表.追加("未映射宿主面: profile / patch / plugin 层与 argv 子命令解析，维持对标登记")
  返回 连接字符串(行表, "\n")

# ---- 子命令分派表（等价上游 DshInvocation 三态）；未知命令返回 假 ----
段落 调度命令(命令):
  如果 命令 == "run":
    执行运行()
    返回 真
  否则如果 命令 == "dump-config":
    打印 取配置文本()
    返回 真
  否则如果 命令 == "version":
    打印 版本号
    返回 真
  否则如果 命令 == "help":
    打印 取用法文本()
    返回 真
  否则:
    打印 "未知命令: " + 命令
    打印 "help 提示: 设 HARNESS_CMD 为 help 查看命令列表（run / dump-config / version / help）"
    返回 假

# ---- 入口（原 headless 主流程迁为 执行运行；本入口只做子命令分派）----
# 命令值 入参供测试注入（缺省读环境变量 HARNESS_CMD，缺省子命令 run）。
# 未知命令时抛出，使进程以非零退出码结束。
段落 主(命令值=空):
  # 第6轮 任务线A（#255）：CLI 外壳外围分叉（对齐 apps/cli argv）。
  # 仅当命令行出现本外壳旗标（--model/--preset/--prompt/--resume/--list/--config/--help）时接管；
  # 否则返回 空，回落下方既有 HARNESS_CMD 子命令分发（既有 env-var 用法与既有用例零变化）。
  # ⚠️ 不改 交互循环 / 执行运行 / 调度命令 既有控制流，只在外围包一层。
  # 延迟导入 cli外壳（其顶层反向 import 本模块），避免循环导入。
  尝试:
    导入 cli外壳
  捕获 错误:
    设 cli外壳 为 空
  如果 cli外壳 != 空:
    设 接管 为 cli外壳.外壳接管(参数列表())
    如果 接管 == "已处理":
      返回
  设 命令 为 环境变量("HARNESS_CMD", 缺省子命令)
  如果 命令值 != 空 且 命令值 != "":
    设 命令 为 命令值
  如果 命令 == 空 或 命令 == "":
    设 命令 为 缺省子命令
  如果 调度命令(命令) == 假:
    抛出 "未知命令: " + 命令 + "（设 HARNESS_CMD 为 help 查看命令列表）"
