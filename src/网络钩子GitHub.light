# 网络钩子GitHub.light —— 对标上游 packages/webhook/webhook-github/src/{body.ts,handler.ts,index.ts,types.ts}（258 行）

#

# 原版对象（deepseek-harness @9d9035b7c1 packages/webhook/webhook-github/src/）：

#   - body.ts    ( 70 行) WebhookHttpError / contentLength / readBoundedUtf8Body（有界读体）

#   - handler.ts (136 行) createGitHubWebhookHandler：方法/类型/体/头/凭据/签名/载荷/派发 十一段门禁链

#   - index.ts   ( 34 行) Config 校验（source 非空且去除空白不变；path 绝对非根无尾斜杠无 ?#）

#   - types.ts   ( 18 行) GitHubJsonObject / GitHubWebhookEvent / WebhookEventMap

#

# ── 宿主绑定剥离表（原版宿主设施 → 本模块投影）────────────────────────────

#   WebhookHttpError(status, message)        → 网络钩子HTTP错误()：新建 错误(消息 + " [WH_状态]")，状态经读错误码()回读

#   contentLength(header)                    → 解析内容长度()：手写 ^(0|[1-9]\d*)$（L-086 禁花括号量词），

#                                               超安全整数(>2^53-1) → 413；缺省(undefined) → 空

#   readBoundedUtf8Body(ctx, req, maxBytes)  → 读有界UTF8体(块表, 上限)：声明长度>上限 → 413；逐块累计>上限 → 413；

#                                               UTF-8 字节数由块表显式给出（"字节" 键），文本拼接由块 "文本" 键承载

#   headersDistinct[name] 单值校验            → 必需头(头表, 名)：值表长度恰 1 且去除空白后非空，否则 400

#   isJsonContentType(value)                 → 是JSON内容类型()：application/json（转小写）+ 至多一个

#                                               charset=utf-8 | charset="utf-8" 参数，手写分段（不用正则）

#   request.method !== 'POST' → 405          → 校验方法()：非 POST 抛 [WH_405]（allow: POST 并入注释语义）

#   octokit Webhooks.verify()                → 验证签名()：sha256= 前缀 + 64 位十六进制校验 + HMAC 恒定时间比较；

#                                               验证失败一律返回 假（吞错语义，不抛），401 由门禁链外层抛出

#   JSON.parse(body)                         → 解析载荷()：捕获 解析JSON 异常 → 400；空/数组/非字典 → 400

#   snapshotJsonValue / Array.isArray        → 是字典() + 空 判定（光明 null/undefined 同为 空）

#   config.source / config.path 校验         → 校验配置()：[WH_CONFIG] 六闸（非串/空/trim 变/非绝对/根/尾斜杠/?/#）

#   dispatch / credentials / receiveTime     → 能力 字典注入（取秘密/当前时间/来源/派发/体上限）

#

# ── 光明降级点（口径明确，勿当 bug）─────────────────────────────────────

#   1. null 与 undefined 在光明同为 空：Content-Length 缺省与「秘密未配置」均以 空 判定；

#      「载荷为 null」由 解析JSON("null") → 空 → 与「非字典」同走 400 闸。

#   2. 恒定时间比较无外部时间可观测，反跑用「失败注入」断言：测试注入错误秘密/错误签名，

#      断言 验证签名() 返回 假；把 恒定时间相等() 变异为恒真（比较被短路）即红。

#      恒定时间相等() 本身实现为 max(长甲,长乙) 次固定循环 + 差异累计，长度不同不短路。

#   3. 区块链为 字节 键显式计数（UTF-8 多字节代价由测试/宿主注入），避免光明串按码点计长偏差。

#   4. 路由注册 effect(() => webServer.register(route))、真实 HTTP 流、凭据读取 为宿主面，整体剥离。

#   5. 签名算法面：stdlib 哈希.HMAC_SHA256 为 pbkdf2 近似（非标准 HMAC-SHA256），

#      见交付报告 §语言差异 L-091；测试内用同一 stdlib 函数生成签名，链路自洽可验证。

#

# ── 反跑判据（3 项，_antirun_webhookgh.py 逐一变异→断言红→恢复→断言绿）──

#   A) 把 恒定时间相等() 调用变异为恒真 返回 真（比较被短路）

#      → 测试「错误秘密 → 验证签名 假」用例红；恢复 → 绿。

#   B) 把 必需头() 的 `列表长度(值表) != 1` 变异为 `< 1`（放行多值）

#      → 测试「同名头双值 → 400」用例红；恢复 → 绿。

#   C) 把 是JSON内容类型() 的「参数区含分号 → 假」分支删除（放行多余参数）

#      → 测试「application/json; charset=utf-8; x=1 → 假」用例红；恢复 → 绿。



从 内置核心转换 导入 转字符串, 转整数

从 内置核心字符串 导入 开头, 去除空白, 截取, 字符串包含, 查找子串

从 内置核心判型 导入 是数字, 是字符串, 是列表, 是字典, 是空

从 内置核心列表 导入 列表长度, 列表获取

从 内置核心字典 导入 字典包含键

从 字符串工具轻量 导入 转小写

从 JSON 导入 解析JSON

从 哈希 导入 HMAC_SHA256



# 原版 handler.ts maxBytes = 1_000_000；Number.MAX_SAFE_INTEGER

设 默认体上限 为 1000000

设 安全整数上限 为 9007199254740991



# =====================================================================

# 一、body.ts —— WebhookHttpError 错误族（状态 ∈ {400,401,405,413,415,503}）

# =====================================================================

段落 网络钩子HTTP错误(状态, 消息):

  返回 消息 + " [WH_" + 转字符串(状态) + "]"



# 错误文本回读状态码：[WH_<数字>] → 数字；找不到返回 0

段落 读错误码(文本):

  设 标记 为 "[WH_"

  设 位置 为 查找子串(文本, 标记)

  如果 (位置 < 0):

    返回 0

  设 起点 为 位置 + 字符串长度(标记)

  设 数字串 为 ""

  设 步 为 起点

  设 尾 为 字符串长度(文本)

  设 完成 为 假

  当 (步 < 尾 且 完成 == 假):

    设 字符 为 字符串获取(文本, 步)

    如果 (字符 == "]"):

      设 完成 为 真

    否则:

      如果 (是数字(字符)):

        设 数字串 为 数字串 + 字符

    设 步 为 步 + 1

  如果 (数字串 == ""):

    返回 0

  返回 转整数(数字串)



# 单字符十六进制判定（0-9 a-f，签名 hex 为小写）

段落 是十六进制字符(字符):

  如果 (是数字(字符)):

    返回 真

  如果 (字符 == "a"):

    返回 真

  如果 (字符 == "b"):

    返回 真

  如果 (字符 == "c"):

    返回 真

  如果 (字符 == "d"):

    返回 真

  如果 (字符 == "e"):

    返回 真

  如果 (字符 == "f"):

    返回 真

  返回 假



# =====================================================================

# 二、body.ts —— contentLength：^(0|[1-9]\d*)$ 手写（L-086 禁花括号量词）

# =====================================================================

段落 是十进制串(文本):

  设 长度 为 字符串长度(文本)

  如果 (长度 == 0):

    返回 假

  设 步 为 0

  当 (步 < 长度):

    如果 (是数字(字符串获取(文本, 步)) == 假):

      返回 假

    设 步 为 步 + 1

  返回 真



段落 解析内容长度(值):

  如果 (值 == 空):

    返回 空

  如果 (是字符串(值) == 假):

    抛出 新建 错误(网络钩子HTTP错误(400, "无效的 Content-Length"))

  设 长度 为 字符串长度(值)

  如果 (是十进制串(值) == 假):

    抛出 新建 错误(网络钩子HTTP错误(400, "无效的 Content-Length"))

  设 首位 为 字符串获取(值, 0)

  如果 (首位 == "0" 且 长度 > 1):

    抛出 新建 错误(网络钩子HTTP错误(400, "无效的 Content-Length"))

  设 数 为 转整数(值)

  如果 (数 > 安全整数上限):

    抛出 新建 错误(网络钩子HTTP错误(413, "请求体过大"))

  返回 数



# =====================================================================

# 三、body.ts —— readBoundedUtf8Body：声明超限 / 逐块累计超限 → 413

# =====================================================================

段落 读有界UTF8体(块表, 上限):

  设 累计 为 0

  设 文本 为 ""

  设 步 为 0

  当 (步 < 列表长度(块表)):

    设 块 为 列表获取(块表, 步)

    设 累计 为 累计 + 块["字节"]

    如果 (累计 > 上限):

      抛出 新建 错误(网络钩子HTTP错误(413, "请求体过大"))

    设 文本 为 文本 + 块["文本"]

    设 步 为 步 + 1

  返回 文本



# =====================================================================

# 四、handler.ts —— requiredHeader：单个非空白值，否则 400

# =====================================================================

段落 必需头(头表, 名):

  设 值表 为 空

  如果 (字典包含键(头表, 名)):

    设 值表 为 头表[名]

  如果 (是列表(值表) == 假):

    抛出 新建 错误(网络钩子HTTP错误(400, "缺少必需头 " + 名))

  如果 (列表长度(值表) != 1):

    抛出 新建 错误(网络钩子HTTP错误(400, "缺少必需头 " + 名))

  设 值 为 列表获取(值表, 0)

  如果 (是字符串(值) == 假):

    抛出 新建 错误(网络钩子HTTP错误(400, "缺少必需头 " + 名))

  如果 (去除空白(值) == ""):

    抛出 新建 错误(网络钩子HTTP错误(400, "缺少必需头 " + 名))

  返回 去除空白(值)



# =====================================================================

# 五、handler.ts —— isJsonContentType：application/json + 至多一个

#     charset=utf-8 | charset="utf-8" 参数（手写分段，不用正则）

# =====================================================================

段落 是JSON内容类型(值):

  如果 (值 == 空):

    返回 假

  设 低 为 转小写(转字符串(值))

  如果 (开头(低, "application/json") == 假):

    返回 假

  设 基长 为 字符串长度("application/json")

  设 剩余 为 截取(低, 基长, 字符串长度(低))

  如果 (剩余 == ""):

    返回 真

  如果 (开头(剩余, ";") == 假):

    返回 假

  设 参数区 为 截取(剩余, 1, 字符串长度(剩余))

  设 参数 为 去除空白(参数区)

  如果 (参数 == ""):

    返回 假

  如果 (字符串包含(参数, ";")):

    返回 假

  如果 (参数 == "charset=utf-8"):

    返回 真

  如果 (参数 == "charset=\"utf-8\""):

    返回 真

  返回 假



# =====================================================================

# 六、handler.ts —— method 门禁

# =====================================================================

段落 校验方法(方法):

  如果 (方法 == "POST"):

    返回 空

  抛出 新建 错误(网络钩子HTTP错误(405, "方法不允许"))



# =====================================================================

# 七、恒定时间比较：固定 max(长甲,长乙) 轮循环 + 差异累计，长度不同不短路

# =====================================================================

段落 恒定时间相等(甲, 乙):

  设 长甲 为 字符串长度(甲)

  设 长乙 为 字符串长度(乙)

  设 长 为 长甲

  如果 (长乙 > 长):

    设 长 为 长乙

  设 差 为 0

  设 步 为 0

  当 (步 < 长):

    设 甲字 为 ""

    设 乙字 为 ""

    如果 (步 < 长甲):

      设 甲字 为 字符串获取(甲, 步)

    如果 (步 < 长乙):

      设 乙字 为 字符串获取(乙, 步)

    如果 (甲字 != 乙字):

      设 差 为 差 + 1

    设 步 为 步 + 1

  如果 (差 == 0):

    返回 真

  返回 假



# =====================================================================

# 八、handler.ts —— octokit verify 语义：验证失败一律 假（吞错），401 由门禁链外层

# =====================================================================

段落 验证签名(秘密, 体, 签名):

  设 前缀 为 "sha256="

  如果 (开头(签名, 前缀) == 假):

    返回 假

  设 笔 为 字符串长度(前缀)

  设 十六进制 为 截取(签名, 笔, 字符串长度(签名))

  如果 (字符串长度(十六进制) != 64):

    返回 假

  设 步 为 0

  当 (步 < 64):

    如果 (是十六进制字符(字符串获取(十六进制, 步)) == 假):

      返回 假

    设 步 为 步 + 1

  设 期望 为 HMAC_SHA256(秘密, 体)

  设 结果 为 恒定时间相等(期望, 十六进制)

  返回 结果



# =====================================================================

# 九、handler.ts —— parsePayload：非对象（含 null / 数组 / 标量）→ 400

# =====================================================================

段落 解析载荷(体):

  设 载荷 为 空

  设 解析失败 为 假

  尝试:

    设 载荷 为 解析JSON(体)

  捕获 异常 为 错误值:

    设 解析失败 为 真

  如果 (解析失败 == 真):

    抛出 新建 错误(网络钩子HTTP错误(400, "请求体不是有效 JSON"))

  如果 (载荷 == 空):

    抛出 新建 错误(网络钩子HTTP错误(400, "GitHub webhook 载荷必须是 JSON 对象"))

  如果 (是字典(载荷) == 假):

    抛出 新建 错误(网络钩子HTTP错误(400, "GitHub webhook 载荷必须是 JSON 对象"))

  返回 载荷



# =====================================================================

# 十、index.ts —— assertConfig：source / path 六闸

# =====================================================================

段落 校验配置(配置):

  设 来源 为 配置["source"]

  如果 (是字符串(来源) == 假):

    抛出 新建 错误("webhook-github source 必须是字符串 [WH_CONFIG]")

  如果 (去除空白(来源) != 来源):

    抛出 新建 错误("webhook-github source 必须是去除空白后不变的字符串 [WH_CONFIG]")

  如果 (来源 == ""):

    抛出 新建 错误("webhook-github source 必须非空 [WH_CONFIG]")

  设 路径 为 配置["path"]

  如果 (是字符串(路径) == 假):

    抛出 新建 错误("webhook-github path 必须是字符串 [WH_CONFIG]")

  如果 (开头(路径, "/") == 假):

    抛出 新建 错误("webhook-github path 必须是绝对路径 [WH_CONFIG]")

  如果 (路径 == "/"):

    抛出 新建 错误("webhook-github path 不能是根路径 [WH_CONFIG]")

  设 尾 为 字符串长度(路径) - 1

  如果 (截取(路径, 尾, 字符串长度(路径)) == "/"):

    抛出 新建 错误("webhook-github path 不能以斜杠结尾 [WH_CONFIG]")

  如果 (字符串包含(路径, "?")):

    抛出 新建 错误("webhook-github path 不能含查询 [WH_CONFIG]")

  如果 (字符串包含(路径, "#")):

    抛出 新建 错误("webhook-github path 不能含片段 [WH_CONFIG]")

  返回 配置



# =====================================================================

# 十一、types.ts —— GitHubWebhookEvent / VerifiedWebhookDelivery 形状

# =====================================================================

段落 构造交付 接收 来源, 交付id, 事件名, 载荷, 接收时间:

  设 事件 为 {"name": 事件名, "payload": 载荷}

  返回 {"kind": "github", "source": 来源, "deliveryId": 交付id, "event": 事件, "receivedAt": 接收时间}



# =====================================================================

# 十二、handler.ts —— createGitHubWebhookHandler 门禁链（能力注入版）

# =====================================================================

段落 处理请求(请求, 响应, 能力):

  设 状态 为 0

  设 消息 为 ""

  尝试:

    校验方法(请求["方法"])

    如果 (是JSON内容类型(请求["内容类型"]) == 假):

      抛出 新建 错误(网络钩子HTTP错误(415, "内容类型必须为 application/json"))

    设 声明 为 解析内容长度(请求["内容长度"])

    如果 (声明 != 空 且 声明 > 能力["体上限"]):

      抛出 新建 错误(网络钩子HTTP错误(413, "请求体过大"))

    设 体文本 为 读有界UTF8体(请求["块表"], 能力["体上限"])

    设 签名值 为 必需头(请求["头表"], "x-hub-signature-256")

    设 交付id值 为 必需头(请求["头表"], "x-github-delivery")

    设 事件值 为 必需头(请求["头表"], "x-github-event")

    设 秘密值 为 能力["取秘密"]()

    如果 (秘密值 == 空):

      抛出 新建 错误(网络钩子HTTP错误(503, "GitHub webhook 秘密未配置"))

    如果 (验证签名(秘密值, 体文本, 签名值) == 假):

      抛出 新建 错误(网络钩子HTTP错误(401, "无效的 webhook 签名"))

    设 载荷值 为 解析载荷(体文本)

    设 投递 为 构造交付(能力["来源"], 交付id值, 事件值, 载荷值, 能力["当前时间"]())

    能力["派发"](投递)

    设 状态 为 202

    设 消息 为 ""

  捕获 异常 为 错误值:

    设 文本 为 转字符串(错误值)

    设 状态 为 读错误码(文本)

    如果 (状态 == 0):

      设 状态 为 503

      设 消息 为 "webhook 入口不可用"

    否则:

      设 消息 为 文本

  响应["状态"] = 状态

  响应["消息"] = 消息

  返回 响应