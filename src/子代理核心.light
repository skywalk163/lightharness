# 子代理核心.light —— 第16轮 任务1：subagent 子代理核心（上）
#
# 上游（只读）：G:\github\deepseek-harness\packages\subagent\subagent\src\
#   catalog.ts（156行）            → §1 父侧目录事件 + 分块投影
#   descriptor.ts（323行）         → §2 持久描述符（版本/校验/快照/折叠）
#   depth.ts（51行）               → §3 委托深度与递归上限
#   error.ts（15行）               → §4 子代理错误类型
#   assistant-output.ts（75行）    → §5 最终助手输出选择
#   inbox.ts（70行）               → §6 激活期收件箱准入
#
# 命名避坑：L-119 单字别名保留字；L-120 可被关键字全覆盖切分的标识符。
# 本地辅助段一律带「核」前缀，避免与同测导入的其它模块同名段冲突
# （src 后端会把依赖模块内联进同一份 Python，同名段会 codegen 重定义）。
# 语言缺陷：L-131（除法 x/0 抛 除零错误，而非 ±Inf/NaN；见交付报告）。
# 本模块无除法未触发；核是有限数 仅作防御性兜底（光明无法产出 inf/nan，故该段实质死代码）。

# 从  时间工具 导入 规范客户端时区（§9 human inbox 提示准入的时区规范化复用 #78 复刻面）
从 时间工具 导入 规范客户端时区

# =====================================================================
# §1 父侧子代理目录（catalog.ts）
# =====================================================================

# SUBAGENT_CATALOG_VERSION
段落 目录载荷版本:
  返回 0

段落 目录模式表:
  返回 ["one-shot", "continuable"]

段落 是目录模式(值):
  如果 是字符串(值) == 假:
    返回 假
  遍历 模 之 目录模式表():
    如果 值 == 模:
      返回 真
  返回 假

# SubagentCatalogEvent 载荷（版本 + 子会话标识 + 创建时间 + 模式 + 标签）
段落 是目录条目(值):
  如果 是字典(值) == 假:
    返回 假
  如果 核字段齐备(值, ["version", "childId", "childCreatedAt", "mode"]) == 假:
    返回 假
  如果 字典获取(值, "version", 空) != 目录载荷版本():
    返回 假
  如果 是字符串(字典获取(值, "childId", 空)) == 假:
    返回 假
  如果 字符串长度(值["childId"]) == 0:
    返回 假
  如果 核是非负整数(字典获取(值, "childCreatedAt", 空)) == 假:
    返回 假
  如果 是目录模式(字典获取(值, "mode", 空)) == 假:
    返回 假
  如果 值["mode"] == "continuable":
    如果 核字段齐备(值, ["label"]) == 假:
      返回 假
    返回 是字符串(值["label"])
  # one-shot：label 可缺省；若存在必须是串
  如果 字典包含键(值, "label") == 真:
    返回 是字符串(值["label"])
  返回 真

# 造目录载荷（子会话标识 + 创建时间 + 模式 + 可选标签）——键序对齐上游对象字面量
段落 造目录条目(模式, 子代理标识, 创建时间, 标签 = 空):
  设 结果 为 {"version": 目录载荷版本(), "childId": 子代理标识,
    "childCreatedAt": 创建时间, "mode": 模式}
  如果 标签 != 空:
    字典设置(结果, "label", 标签)
  返回 结果

# wire.view 行：{id, createdAt, mode, label?}
段落 造目录行(条目):
  设 行 为 {"id": 条目["childId"], "createdAt": 条目["childCreatedAt"], "mode": 条目["mode"]}
  如果 字典包含键(条目, "label") == 真:
    字典设置(行, "label", 条目["label"])
  返回 行

段落 是目录行(值):
  如果 是字典(值) == 假:
    返回 假
  如果 核字段齐备(值, ["id", "createdAt", "mode"]) == 假:
    返回 假
  如果 是字符串(值["id"]) == 假 或 字符串长度(值["id"]) == 0:
    返回 假
  如果 核是非负整数(值["createdAt"]) == 假:
    返回 假
  如果 是目录模式(值["mode"]) == 假:
    返回 假
  如果 值["mode"] == "continuable":
    如果 核字段齐备(值, ["label"]) == 假:
      返回 假
    返回 是字符串(值["label"])
  如果 字典包含键(值, "label") == 真:
    返回 是字符串(值["label"])
  返回 真

# stateVersion
段落 目录状态版本:
  返回 2

# init：仅继承切点，head 可缺省
段落 目录投影初值(继承事件数):
  返回 {"inheritedEventCount": 继承事件数}

# apply：非 subagent/catalog 或 seq 落在继承切点内 → 状态原样
段落 应用目录事件(状态, 事件):
  设 种类 为 ""
  如果 字典包含键(事件, "type") == 真:
    设 种类 为 事件["type"]
  如果 种类 != "subagent/catalog":
    返回 状态
  如果 字典包含键(事件, "seq") == 真:
    如果 事件["seq"] < 状态["inheritedEventCount"]:
      返回 状态
  设 新头 为 核新列表()
  如果 字典包含键(状态, "head") == 真:
    设 新头 为 核拷贝列表(状态["head"])
  列表追加(新头, 事件["data"])
  返回 {"inheritedEventCount": 状态["inheritedEventCount"], "head": 新头}

# wire.view：分块列表 → 目录行列表（保事件序）
段落 目录条目表(状态):
  设 结果 为 核新列表()
  如果 字典包含键(状态, "head") == 假:
    返回 结果
  遍历 条目 之 状态["head"]:
    列表追加(结果, 造目录行(条目))
  返回 结果

段落 校验目录状态(状态):
  如果 是字典(状态) == 假:
    返回 "subagent catalog state must be a mapping"
  如果 核字段齐备(状态, ["inheritedEventCount"]) == 假:
    返回 "subagent catalog state is missing inheritedEventCount"
  如果 核是非负整数(状态["inheritedEventCount"]) == 假:
    返回 "inheritedEventCount must be a non-negative safe integer"
  如果 字典包含键(状态, "head") == 真:
    如果 是列表(状态["head"]) == 假:
      返回 "subagent catalog head must be a chunked list"
    遍历 条目 之 状态["head"]:
      如果 是目录条目(条目) == 假:
        返回 "subagent catalog head entry is invalid"
  返回 ""

段落 是合法目录状态(状态):
  返回 校验目录状态(状态) == ""

# establishCatalogChild：父侧 append 属宿主 IO，本模块只回传载荷
段落 造目录确立载荷(子代理标识, 创建时间, 描述符):
  返回 造目录条目(描述符["mode"], 子代理标识, 创建时间, 字典获取(描述符, "label", 空))

# =====================================================================
# §2 持久子代理描述符（descriptor.ts）
# =====================================================================

段落 描述符版本:
  返回 3

段落 描述符基础键表:
  返回 ["version", "mode", "provider", "label"]

段落 描述符可续键表:
  返回 ["version", "mode", "provider", "label", "agentProvider", "agentModel",
    "agentReasoningEffort", "persona", "toolFilter"]

段落 工具过滤键表:
  返回 ["allow", "deny"]

段落 是工具过滤(值):
  如果 是字典(值) == 假:
    返回 假
  如果 核只含键(值, 工具过滤键表()) == 假:
    返回 假
  设 有允许 为 字典包含键(值, "allow")
  设 有拒绝 为 字典包含键(值, "deny")
  如果 有允许 == 假 且 有拒绝 == 假:
    返回 假
  如果 有允许 == 真 且 是字符串列表(值["allow"]) == 假:
    返回 假
  如果 有拒绝 == 真 且 是字符串列表(值["deny"]) == 假:
    返回 假
  返回 真

段落 是单次描述符(值):
  如果 是字典(值) == 假:
    返回 假
  如果 字典获取(值, "mode", 空) != "one-shot":
    返回 假
  如果 核只含键(值, 描述符基础键表()) == 假:
    返回 假
  如果 核字段齐备(值, ["version", "mode", "provider"]) == 假:
    返回 假
  如果 值["version"] != 描述符版本():
    返回 假
  如果 是字符串(值["provider"]) == 假:
    返回 假
  如果 字典包含键(值, "label") == 真:
    返回 是字符串(值["label"])
  返回 真

段落 是可续描述符(值):
  如果 是字典(值) == 假:
    返回 假
  如果 字典获取(值, "mode", 空) != "continuable":
    返回 假
  如果 核只含键(值, 描述符可续键表()) == 假:
    返回 假
  如果 核字段齐备(值, ["version", "mode", "provider", "label"]) == 假:
    返回 假
  如果 值["version"] != 描述符版本():
    返回 假
  如果 是字符串(值["provider"]) == 假:
    返回 假
  如果 是字符串(值["label"]) == 假:
    返回 假
  遍历 键 之 ["agentProvider", "agentModel", "agentReasoningEffort", "persona"]:
    如果 字典包含键(值, 键) == 真 且 是字符串(值[键]) == 假:
      返回 假
  如果 字典包含键(值, "toolFilter") == 真:
    返回 是工具过滤(值["toolFilter"])
  返回 真

段落 是描述符(值):
  如果 是单次描述符(值):
    返回 真
  返回 是可续描述符(值)

# snapshotSubagentDescriptor：校验并脱敏为持久载荷
段落 造描述符(输入):
  设 模式 为 字典获取(输入, "mode", 空)
  设 提供方 为 字典获取(输入, "provider", 空)
  如果 模式 == "one-shot":
    设 候选 为 {"version": 描述符版本(), "mode": 模式, "provider": 提供方}
    设 标签 为 字典获取(输入, "label", 空)
    如果 标签 != 空:
      字典设置(候选, "label", 标签)
  否则:
    设 候选 为 {"version": 描述符版本(), "mode": 模式, "provider": 提供方,
      "label": 输入["label"]}
    遍历 键 之 ["agentProvider", "agentModel", "agentReasoningEffort", "persona", "toolFilter"]:
      如果 字典包含键(输入, 键) == 真 且 输入[键] != 空:
        字典设置(候选, 键, 输入[键])
  如果 核是JSON安全值(候选, 0) == 假:
    抛出 新建 错误("subagent descriptor is not losslessly JSON-serializable")
  返回 候选

# parseSubagentDescriptor：非当前版本 → 空；当前版本形状不符 → 抛错
段落 解析描述符(值):
  如果 是字典(值) == 假:
    抛出 新建 错误("persisted subagent descriptor payload must be an object")
  如果 是数值标量(字典获取(值, "version", 空)) == 假:
    抛出 新建 错误("persisted subagent descriptor version must be a number")
  如果 值["version"] != 描述符版本():
    返回 空
  设 模式 为 字典获取(值, "mode", 空)
  如果 模式 != "one-shot" 且 模式 != "continuable":
    抛出 新建 错误("persisted subagent descriptor mode must be \"one-shot\" or \"continuable\"")
  如果 模式 == "one-shot":
    如果 核只含键(值, 描述符基础键表()) == 假:
      抛出 新建 错误("persisted subagent descriptor payload has unknown field")
    如果 是字符串(字典获取(值, "provider", 空)) == 假:
      抛出 新建 错误("persisted subagent descriptor provider must be a string")
    设 单次 为 {"version": 描述符版本(), "mode": 模式, "provider": 值["provider"]}
    设 标签 为 核读可选串(值, "label")
    如果 标签 != 空:
      字典设置(单次, "label", 标签)
    返回 单次
  如果 核只含键(值, 描述符可续键表()) == 假:
    抛出 新建 错误("persisted subagent descriptor payload has unknown field")
  如果 是字符串(字典获取(值, "provider", 空)) == 假:
    抛出 新建 错误("persisted subagent descriptor provider must be a string")
  如果 是字符串(字典获取(值, "label", 空)) == 假:
    抛出 新建 错误("persisted subagent descriptor label must be a string")
  设 可续 为 {"version": 描述符版本(), "mode": 模式, "provider": 值["provider"],
    "label": 值["label"]}
  遍历 键 之 ["agentProvider", "agentModel", "agentReasoningEffort", "persona"]:
    设 项 为 核读可选串(值, 键)
    如果 项 != 空:
      字典设置(可续, 键, 项)
  如果 字典包含键(值, "toolFilter") == 真:
    字典设置(可续, "toolFilter", 解析工具过滤(值["toolFilter"]))
  返回 可续

# foldSubagentDescriptor：首条 subagent/descriptor 事件为准
段落 折叠描述符(事件表):
  遍历 事件 之 事件表:
    如果 字典获取(事件, "type", 空) == "subagent/descriptor":
      返回 解析描述符(事件["data"])
  返回 空

段落 解析工具过滤(值):
  如果 是字典(值) == 假:
    抛出 新建 错误("persisted subagent descriptor toolFilter must be an object")
  如果 核只含键(值, 工具过滤键表()) == 假:
    抛出 新建 错误("persisted subagent descriptor toolFilter has unknown field")
  设 允许 为 核读可选字符串数组(值, "allow")
  设 拒绝 为 核读可选字符串数组(值, "deny")
  如果 允许 == 空 且 拒绝 == 空:
    抛出 新建 错误("persisted subagent descriptor toolFilter must declare allow and/or deny")
  设 结果 为 {}
  如果 允许 != 空:
    字典设置(结果, "allow", 允许)
  如果 拒绝 != 空:
    字典设置(结果, "deny", 拒绝)
  返回 结果

# =====================================================================
# §3 委托深度（depth.ts）
# =====================================================================

段落 读委托深度(头部深度, 运行深度):
  如果 运行深度 != 空:
    如果 核是安全整数(运行深度) == 假:
      抛出 新建 错误("agent subagentDepth must be a non-negative safe integer")
    如果 运行深度 < 0:
      抛出 新建 错误("agent subagentDepth must be a non-negative safe integer")
  设 头 为 0
  如果 头部深度 != 空:
    设 头 为 头部深度
  设 运 为 0
  如果 运行深度 != 空:
    设 运 为 运行深度
  # 头部权威且单调：取二者较大值
  如果 头 > 运:
    返回 头
  返回 运

段落 校验最大深度(值):
  如果 值 == 空:
    返回 真
  如果 核是安全整数(值) == 假:
    抛出 新建 错误("subagent maxDepth must be a non-negative safe integer")
  如果 值 < 0:
    抛出 新建 错误("subagent maxDepth must be a non-negative safe integer")
  返回 真

段落 是合法最大深度(值):
  如果 值 == 空:
    返回 真
  如果 核是安全整数(值) == 假:
    返回 假
  返回 值 >= 0

# =====================================================================
# §4 子代理错误（error.ts）
# =====================================================================

段落 子代理错误名:
  返回 "SubagentError"

# 本模块复刻面里唯一出现的具体码（inbox.ts 的关闭拒绝）
段落 子代理错误码表:
  返回 ["ACTIVATION_CLOSING"]

段落 是子代理错误码(值):
  如果 是字符串(值) == 假:
    返回 假
  遍历 码 之 子代理错误码表():
    如果 值 == 码:
      返回 真
  返回 假

# 光明抛错无属性位，按本项目既定约定把码并进消息（"消息 [码]"）
段落 子代理错误消息(消息, 码):
  返回 消息 + " [" + 码 + "]"

段落 造子代理错误(消息, 码):
  返回 {"name": 子代理错误名(), "message": 消息, "code": 码}

段落 是子代理错误(值):
  如果 是字典(值) == 假:
    返回 假
  如果 核字段齐备(值, ["name", "message", "code"]) == 假:
    返回 假
  如果 值["name"] != 子代理错误名():
    返回 假
  如果 是字符串(值["message"]) == 假:
    返回 假
  返回 是子代理错误码(值["code"])

# =====================================================================
# §5 最终助手输出（assistant-output.ts）
# =====================================================================

# joinAssistantStreamText：把流片段按序拼成文本
段落 合并助手流文本(片段表):
  设 结果 为 ""
  遍历 片段 之 片段表:
    如果 是字符串(片段) == 真:
      设 结果 为 结果 + 片段
  返回 结果

# 内容块列表中 text 块拼接
段落 收集助手文本(块表):
  设 结果 为 ""
  遍历 块 之 块表:
    如果 字典获取(块, "type", 空) == "text":
      设 结果 为 结果 + 块["text"]
  返回 结果

# finalAssistantOutput：末条非空 assistant 消息优先，否则回落累计流文本
段落 归一助手输出(事件表):
  设 消息 为 空
  设 部分 为 核新列表()
  遍历 事件 之 事件表:
    设 种类 为 字典获取(事件, "type", 空)
    如果 种类 == "assistant/message":
      设 内容 为 事件["data"]["message"]["content"]
      如果 长度(内容) > 0:
        设 消息 为 内容
    如果 种类 == "assistant/message" 或 种类 == "assistant/attempt":
      设 片段 为 合并助手流文本(事件["data"]["stream"])
      如果 字符串长度(片段) > 0:
        列表追加(部分, 片段)
  如果 消息 != 空:
    返回 消息
  设 全文 为 合并助手流文本(部分)
  如果 字符串长度(全文) > 0:
    返回 [{"type": "text", "text": 全文}]
  返回 空

# =====================================================================
# §6 激活期收件箱（inbox.ts）
# =====================================================================

段落 交付方式表:
  返回 ["queue", "steer"]

段落 是交付方式(值):
  如果 是字符串(值) == 假:
    返回 假
  遍历 式 之 交付方式表():
    如果 值 == 式:
      返回 真
  返回 假

段落 造收件箱(代理标识):
  返回 {"代理标识": 代理标识, "关闭中": 假, "下轮": 核新列表(), "下一步": 核新列表()}

段落 是收件箱(值):
  如果 是字典(值) == 假:
    返回 假
  如果 核字段齐备(值, ["代理标识", "关闭中", "下轮", "下一步"]) == 假:
    返回 假
  如果 是字符串(值["代理标识"]) == 假:
    返回 假
  如果 核是布尔标量(值["关闭中"]) == 假:
    返回 假
  如果 是列表(值["下轮"]) == 假:
    返回 假
  返回 是列表(值["下一步"])

# hasPending：任一投递目的非空
段落 收件箱积压(箱):
  如果 长度(箱["下轮"]) > 0:
    返回 真
  返回 长度(箱["下一步"]) > 0

# deliver：关闭中拒绝（ACTIVATION_CLOSING），否则 steer 进下一步 / queue 进下轮
段落 收件箱投递(箱, 消息, 交付方式):
  如果 箱["关闭中"] == 真:
    抛出 新建 错误(子代理错误消息("subagent \"" + 箱["代理标识"]
      + "\" activation is being disposed; the message was not accepted", "ACTIVATION_CLOSING"))
  如果 交付方式 == "steer":
    列表追加(箱["下一步"], 消息)
  否则:
    列表追加(箱["下轮"], 消息)
  返回 真

# close：同步关闭准入，幂等（已关闭返回假）
段落 收件箱关闭(箱):
  如果 箱["关闭中"] == 真:
    返回 假
  设 箱["关闭中"] 为 真
  返回 真

段落 读收件箱关闭(箱):
  返回 箱["关闭中"]

# =====================================================================
# 本地工具（一律「核」前缀，避免跨模块同名段）
# =====================================================================

段落 核新列表:
  返回 []

段落 核拷贝列表(源):
  设 结果 为 核新列表()
  遍历 项 之 源:
    列表追加(结果, 项)
  返回 结果

段落 核字段齐备(值, 键表):
  遍历 键 之 键表:
    如果 字典包含键(值, 键) == 假:
      返回 假
  返回 真

段落 核只含键(值, 允许键表):
  遍历 键 之 字典键列表(值):
    设 命中 为 假
    遍历 允许 之 允许键表:
      如果 键 == 允许:
        设 命中 为 真
    如果 命中 == 假:
      返回 假
  返回 真

段落 核是整数标量(值):
  返回 type(值) == int

# 版本字段须为「数值」，故 int 与 float 均可（上游 typeof === 'number'）
段落 是数值标量(值):
  如果 核是整数标量(值):
    返回 真
  返回 type(值) == float

段落 核是浮点标量(值):
  返回 type(值) == float

段落 核是布尔标量(值):
  返回 type(值) == bool

段落 核是非负整数(值):
  如果 核是整数标量(值) == 假:
    返回 假
  返回 值 >= 0

# 安全整数：±(2^53 - 1)；且排除 -0（整型 -0 与 0 在光明不可区分，见交付报告偏差登记）
段落 核是安全整数(值):
  如果 核是整数标量(值) == 假:
    返回 假
  如果 值 > 9007199254740991:
    返回 假
  返回 值 >= -9007199254740991

段落 是字符串列表(值):
  如果 是列表(值) == 假:
    返回 假
  遍历 项 之 值:
    如果 是字符串(项) == 假:
      返回 假
  返回 真

# 可选串读取：缺省返回空；存在但非串 → 空（谓词语义下按「不合法」处理）
段落 核读可选串(值, 键):
  如果 字典包含键(值, 键) == 假:
    返回 空
  如果 是字符串(值[键]) == 假:
    返回 空
  返回 值[键]

# 可选字符串数组读取：缺省返回空；存在但非字符串数组 → 抛错（对齐上游 optionalStringArray）
段落 核读可选字符串数组(值, 键):
  如果 字典包含键(值, 键) == 假:
    返回 空
  设 项 为 值[键]
  如果 是字符串列表(项) == 假:
    抛出 新建 错误("persisted subagent descriptor toolFilter." + 键 + " must be an array of strings")
  返回 项

# 无损 JSON 值：近似 isRemoteJsonValue（光明无对象身份，用深度上限替代环路检测）
段落 核是JSON安全值(值, 深度):
  如果 深度 > 128:
    返回 假
  如果 值 == 空:
    返回 真
  如果 核是布尔标量(值):
    返回 真
  如果 是字符串(值):
    返回 真
  如果 核是整数标量(值):
    返回 真
  如果 核是浮点标量(值):
    返回 核是有限数(值)
  如果 是列表(值):
    设 i 为 0
    当 i < 长度(值):
      如果 核是JSON安全值(值[i], 深度 + 1) == 假:
        返回 假
      设 i 为 i + 1
    返回 真
  如果 是字典(值):
    遍历 键 之 字典键列表(值):
      如果 是字符串(键) == 假:
        返回 假
      如果 核是JSON安全值(值[键], 深度 + 1) == 假:
        返回 假
    返回 真
  返回 假

# 有限数：排除 NaN / ±Inf / -0（经文本判定，规避光明无 isFinite 内置）
段落 核是有限数(值):
  设 文本 为 转字符串(值)
  如果 字符串包含(文本, "inf") == 真:
    返回 假
  如果 字符串包含(文本, "nan") == 真:
    返回 假
  返回 文本 != "-0.0"

# =====================================================================
# §7 控制面词汇与行形状（control-types.ts —— 第48轮 任务2 追加）
#   SubagentListEntry（child/diagnostic 行）、SubagentAddress、SubagentCatalog 视图、
#   提示/中断回执。上游由 union 类型承担的形状判别，光明以显式谓词等价提供。
# =====================================================================

# 控制面非空串谓词（上游 z.string().min(1)）
段落 控制非空串(值):
  如果 是字符串(值) == 假:
    返回 假
  返回 字符串长度(值) > 0

# diagnostic 行的 reason 词表（corrupt/unsupported/unavailable；unsupported 不产出仅保留给消费方）
段落 诊断缘由表:
  返回 ["corrupt", "unsupported", "unavailable"]

# child 行的活动状态词表（durable listing 读存储；browser catalog 再采样驱动）
段落 活动状态表:
  返回 ["running", "inactive"]

# childRow：materialize one served identity as its child row
#   continuable 行必须有持久标签（上游类型判别）；one-shot 标签可缺省
段落 造子行(标识, 模式, 标签, 活动, 有子代):
  如果 模式 == "continuable":
    如果 是字符串(标签) == 假 或 字符串长度(标签) == 0:
      抛出 新建 错误("continuable child row requires a durable label [INVALID_CHILD_ROW]")
  设 行 为 {"kind": "child", "id": 标识, "mode": 模式, "activity": 活动, "hasChildren": 有子代}
  如果 标签 != 空:
    字典设置(行, "label", 标签)
  返回 行

# diagnostic 行：候选无 child 行时的受控诊断（每子隔离，不拖垮整个列表）
段落 造诊断行(标识, 缘由):
  如果 列表包含(诊断缘由表(), 缘由) == 假:
    抛出 新建 错误("unknown diagnostic reason [INVALID_DIAGNOSTIC_ROW]")
  返回 {"kind": "diagnostic", "id": 标识, "reason": 缘由}

# SubagentListEntry 谓词：child 行 / diagnostic 行
段落 是控制行(值):
  如果 是字典(值) == 假:
    返回 假
  如果 字典获取(值, "kind", 空) == "child":
    如果 核字段齐备(值, ["id", "mode", "activity", "hasChildren"]) == 假:
      返回 假
    如果 控制非空串(值["id"]) == 假:
      返回 假
    如果 字典获取(值, "mode", 空) == "continuable":
      如果 是字符串(字典获取(值, "label", 空)) == 假:
        返回 假
    否则:
      如果 字典获取(值, "mode", 空) == "one-shot":
        如果 字典包含键(值, "label") == 真:
          如果 是字符串(值["label"]) == 假:
            返回 假
      否则:
        返回 假
    如果 列表包含(活动状态表(), 值["activity"]) == 假:
      返回 假
    返回 核是布尔标量(值["hasChildren"])
  如果 字典获取(值, "kind", 空) == "diagnostic":
    如果 核字段齐备(值, ["id", "reason"]) == 假:
      返回 假
    如果 控制非空串(值["id"]) == 假:
      返回 假
    返回 列表包含(诊断缘由表(), 值["reason"])
  返回 假

# SubagentAddress：持久父/子地址（mode 判别由调用方携带）
段落 造子代理地址(父标识, 子标识, 模式):
  返回 {"parentSessionId": 父标识, "childSessionId": 子标识, "mode": 模式}

# SubagentCatalog 视图（control.ts catalogView 纯化）：
#   durable 行的活动状态由调用方注入的 live 活动表替换；无登记记录的 child 行一律 inactive；
#   diagnostic 行原样透传；parentAvailable 只是投递期提示，prompt 准入才是权威判定
段落 造父目录视图(行表, 活动表, 父可用):
  设 结果 为 []
  遍历 行 之 行表:
    如果 是控制行(行) == 假:
      抛出 新建 错误("catalog view received an invalid row [INVALID_CATALOG_ROW]")
    如果 行["kind"] == "child":
      设 活动 为 字典获取(活动表, 行["id"], "inactive")
      列表追加(结果, 造子行(行["id"], 行["mode"], 字典获取(行, "label", 空), 活动, 行["hasChildren"]))
    否则:
      列表追加(结果, 行)
  返回 {"entries": 结果, "parentAvailable": 父可用}

# 回执形状：提示被收件箱接纳后返回消息标识；中断准入即回执（不承诺目标已静默）
段落 造提示回执(消息标识):
  返回 {"messageId": 消息标识}

段落 造中断回执:
  返回 {"accepted": 真}

# =====================================================================
# §8 父属目录查找（list-children.ts 纯逻辑 —— 第48轮 任务2 追加）
#   语料记录 = 会话头子集：{id, createdAt, parentSession, origin}。
#   剔除查询引擎/投影注册表/并发冷读等宿主面，保留排序、遍历、分类、见证四个纯函数。
# =====================================================================

# sameLifecycle 的 LIFECYCLE_WITNESS_KEYS：同一 id 下区分生命周期的不可变头字段
段落 生命周期见证键表:
  返回 ["version", "id", "createdAt", "cwd", "parentSession", "isSeeded", "delegationDepth", "origin", "agentPreset"]

# sameLifecycle：见证键逐键相等（缺省位也必须一致——删除重建的会话不得漏进旧父的列表）
段落 是同生命周期(头, 期望):
  遍历 键 之 生命周期见证键表():
    设 甲有 为 字典包含键(头, 键)
    设 乙有 为 字典包含键(期望, 键)
    如果 甲有 != 乙有:
      返回 假
    如果 甲有 == 真:
      如果 头[键] != 期望[键]:
        返回 假
  返回 真

# compareCorpusRecords：createdAt 优先，id 字典序决胜；返回 -1/0/1
段落 记录比较(甲, 乙):
  如果 甲["createdAt"] < 乙["createdAt"]:
    返回 -1
  如果 甲["createdAt"] > 乙["createdAt"]:
    返回 1
  如果 甲["id"] < 乙["id"]:
    返回 -1
  如果 甲["id"] > 乙["id"]:
    返回 1
  返回 0

# 稳定有序插入（等价 Array.prototype.sort 的稳定序；不用「排序」命名规避关键字）
段落 有序插入记录表(表, 记):
  设 插位 为 长(表)
  设 序 为 0
  当 序 < 长(表):
    如果 记录比较(表[序], 记) > 0:
      设 插位 为 序
      设 序 为 长(表)
    否则:
      设 序 为 序 + 1
  列表插入(表, 插位, 记)
  返回 表

# subagentParents：origin=subagent 的记录把其父标识收进父代集合（hasChildren 判定源）
段落 父代集合(记录表):
  设 结果 为 []
  遍历 记 之 记录表:
    如果 字典获取(记, "origin", 空) == "subagent":
      设 父 为 字典获取(记, "parentSession", 空)
      如果 父 != 空:
        如果 列表包含(结果, 父) == 假:
          列表追加(结果, 父)
  返回 结果

# descendantCandidates：从完整树无递归构建前序定位候选。
#   普通会话与 one-shot 子代都作途经节点（可续子代理藏在任何父之下都要被发现）；
#   只有 origin=subagent 的候选进入定位表；兄弟按 created,id 有序；深度自根为 1。
段落 后代候选(记录表, 根标识):
  设 邻接 为 {}
  遍历 记 之 记录表:
    设 父 为 字典获取(记, "parentSession", 空)
    如果 父 != 空:
      如果 字典包含键(邻接, 父) == 假:
        字典设置(邻接, 父, [])
      有序插入记录表(邻接[父], 记)
  设 栈 为 []
  设 首批 为 字典获取(邻接, 根标识, [])
  设 位 为 长(首批) - 1
  当 位 >= 0:
    列表追加(栈, {"记": 首批[位], "父": 根标识, "深": 1})
    设 位 为 位 - 1
  设 已访 为 {}
  字典设置(已访, 根标识, 真)
  设 定位表 为 []
  设 顶 为 长(栈) - 1
  当 顶 >= 0:
    设 帧 为 栈[顶]
    设 顶 为 顶 - 1
    设 标识 为 帧["记"]["id"]
    如果 字典包含键(已访, 标识) == 假:
      字典设置(已访, 标识, 真)
      如果 字典获取(帧["记"], "origin", 空) == "subagent":
        列表追加(定位表, {"记": 帧["记"], "父标识": 帧["父"], "深度": 帧["深"]})
      设 子表 为 字典获取(邻接, 标识, [])
      设 位 为 长(子表) - 1
      当 位 >= 0:
        列表追加(栈, {"记": 子表[位], "父": 标识, "深": 帧["深"] + 1})
        设 位 为 位 - 1
      设 顶 为 长(栈) - 1
  返回 定位表

# =====================================================================
# §9 human inbox 准入与拒绝映射（index.ts prompt + control.ts —— 第48轮 任务2 追加）
#   人工提示经浏览器控制面投给可续子代理：载荷校验 → 时区规范化 → 父可用判定 →
#   组装持久消息源；拒绝一律映射到稳定 Remote 码词表。
# =====================================================================

# validateControlRequest 的方法键（control.ts CONTROL_ID_SCHEMAS）
段落 控制方法表:
  返回 ["subagent.list", "subagent.prompt", "subagent.interrupt"]

# validateControlRequest 纯化：返回诊断串，空 = 合法（上游抛 RemoteError gateway/bad-request）
#   list 只需非空父标识；prompt/interrupt 需父/子非空 + mode 必须为 continuable 判别；
#   prompt 额外要求 delivery ∈ {queue, steer}
段落 校验控制载荷(方法, 载荷):
  如果 列表包含(控制方法表(), 方法) == 假:
    返回 "invalid payload for " + 方法
  如果 是字典(载荷) == 假:
    返回 "invalid payload for " + 方法
  如果 控制非空串(字典获取(载荷, "parentSessionId", 空)) == 假:
    返回 "invalid payload for " + 方法
  如果 方法 != "subagent.list":
    如果 控制非空串(字典获取(载荷, "childSessionId", 空)) == 假:
      返回 "invalid payload for " + 方法
    如果 字典获取(载荷, "mode", 空) != "continuable":
      返回 "invalid payload for " + 方法
  如果 方法 == "subagent.prompt":
    设 交付 为 字典获取(载荷, "delivery", 空)
    如果 交付 != "queue":
      如果 交付 != "steer":
        返回 "invalid payload for " + 方法
  返回 ""

# isCancellation：调用方已取消，或错误码 CANCELLED
段落 是取消判定(码, 已取消):
  如果 已取消 == 真:
    返回 真
  返回 码 == "CANCELLED"

# rejectCatalogRead 纯化：目录读拒绝 → Remote 码（取消与缺投影注册表各自成码，其余 internal）
段落 目录读拒绝映射(码):
  如果 码 == "CANCELLED":
    返回 "gateway/cancelled"
  如果 码 == "SUBAGENT_CONTROL_PROJECTIONS_UNAVAILABLE":
    返回 "subagent/projections-unavailable"
  返回 "gateway/internal"

# rejectPrompt 纯化：调用方可行动的准入失败保留专属码，其余一律 internal
段落 提示拒绝映射(码):
  如果 码 == "CANCELLED":
    返回 "gateway/cancelled"
  如果 码 == "MODEL_DOES_NOT_SUPPORT_IMAGES":
    返回 "subagent/attachment-invalid"
  如果 码 == "NOT_RESUMABLE":
    返回 "subagent/not-resumable"
  如果 码 == "UNAUTHORIZED":
    返回 "subagent/unauthorized"
  如果 码 == "DRAINING":
    返回 "subagent/delivery-unavailable"
  如果 码 == "ACTIVATION_CLOSING":
    返回 "subagent/delivery-unavailable"
  如果 码 == "CONTINUATION_UNAVAILABLE":
    返回 "subagent/delivery-unavailable"
  如果 码 == "PERSISTENCE_UNAVAILABLE":
    返回 "subagent/delivery-unavailable"
  返回 "gateway/internal"

# prompt 准入序列（index.ts prompt 纯化）：
#   载荷校验（坏 → gateway/bad-request）→ clientTimeZone 规范化（UTC 或 IANA，坏 →
#   subagent/invalid-time-zone）→ 父不在线（→ subagent/parent-unavailable）→
#   组装持久源 {kind:"user", rpcId: requestId, clientTimeZone?}（时区仅在提供时携带）。
#   返回 {"拒绝": Remote码 或 空, "源": 消息源 或 空}
段落 提示准入(载荷, 父可用):
  设 诊断 为 校验控制载荷("subagent.prompt", 载荷)
  如果 诊断 != "":
    返回 {"拒绝": "gateway/bad-request", "源": 空}
  设 时区 为 空
  如果 字典包含键(载荷, "clientTimeZone") == 真:
    设 时区 为 规范客户端时区(载荷["clientTimeZone"])
    如果 时区 == 空:
      返回 {"拒绝": "subagent/invalid-time-zone", "源": 空}
  如果 父可用 == 假:
    返回 {"拒绝": "subagent/parent-unavailable", "源": 空}
  设 源 为 {"kind": "user", "rpcId": 字典获取(载荷, "requestId", 空)}
  如果 时区 != 空:
    字典设置(源, "clientTimeZone", 时区)
  返回 {"拒绝": 空, "源": 源}

# SubagentError 全码表（本复刻面涉及的错误码词表；§4 的 子代理错误码表 维持第16轮原状不动）
段落 子代理全错误码表:
  返回 ["ACTIVATION_CLOSING", "CANCELLED", "DUPLICATE_CHILD", "DUPLICATE_PROVIDER", "NO_PROVIDER", "UNAUTHORIZED", "NOT_RESUMABLE", "DRAINING", "CONTINUATION_UNAVAILABLE", "PERSISTENCE_UNAVAILABLE", "MODEL_DOES_NOT_SUPPORT_IMAGES"]
