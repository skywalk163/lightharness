# 工作区成员.light —— R175（T-0175）B3 路纯逻辑复刻
#
# 上游：packages/workspace/workspace/src/entity.ts（dsh-v0.2.1-rc.3）
#   `sessionPath(id) === this.record.path`  →  `candidateMatches(id, path)`
#   语义变化：成员判定由「索引路径严格相等」改为「**已记账**的子会话，若其完整
#   cwd 因路径分量缺失而解析不出，则保留归属」——避免目录暂时不可见时把子会话踢出工作区。
#
# 复刻范围（只做 entity.ts 的纯判定与裁决段）：
#   §1 候选匹配：path 解析不出 → 保留；否则要求规范路径严格相等
#   §2 getter sessionIds：record 成员按候选匹配过滤
#   §3 单写路径裁决：update 内「过滤后的成员」与「未变哨兵」判定
#
# 宿主面剥离（上游是 WorkspaceEntityHost + KvTable 事务，本模块不含）：
#   - `host.candidateMatches(id, path)` 的「解析能否成功」由宿主给（本模块收 可解析 标志）
#   - `table().update(...)` 的写链 / unchangedSentinel 抛出 → 本模块把「是否未变」回传，
#     由宿主决定抛哨兵还是提交（纯逻辑面不该含控制流副作用）。
#   - 上游 canonical cwd 由 host 归一（本模块假定双方已是同一约定下的规范串，不再自行折叠）。
#   - types.ts 同批新增的 `TypertResourceMap.workspace` 是**类型级**声明（wr类型擦除），无运行期逻辑 → 不移植。

# =====================================================================
# §1 候选匹配（candidateMatches）
# =====================================================================

# 项 = {"标识": 子会话标识, "规范路径": cwd, "可解析": 真/假}
# 上游注释：Validate an already-accounted session, preserving ownership when its fully
# qualified cwd cannot resolve because a path component is missing.
段落 成员_候选匹配(项, 工作区路径):
  如果 项["可解析"] == 假:
    返回 真
  返回 项["规范路径"] == 工作区路径

# =====================================================================
# §2 getter sessionIds
# =====================================================================

# 记录 = {"路径": 工作区路径, "成员": [项...]}
段落 成员_名单(记录):
  设 保留 为 []
  遍历 项 之 记录["成员"]:
    如果 成员_候选匹配(项, 记录["路径"]) == 真:
      列表追加(保留, 项["标识"])
  返回 保留

# =====================================================================
# §3 单写路径裁决（update 的纯部分）
# =====================================================================

# 当前 = 记录；变更 = 修改器返回的新记录，或 空（表示与当前同一对象，即无改动）。
# 返回 {"未变": 真/假, "成员": [保留下来的标识...]}。
# 对齐上游：`if (changed === current && sessionIds.length === current.sessionIds.length)
#            throw unchangedSentinel`
段落 成员_裁决(当前, 变更):
  设 同对象 为 变更 == 空
  设 目标 为 当前
  如果 同对象 == 假:
    设 目标 为 变更
  设 保留 为 []
  遍历 项 之 目标["成员"]:
    如果 成员_候选匹配(项, 目标["路径"]) == 真:
      列表追加(保留, 项["标识"])
  设 未变 为 假
  如果 同对象 == 真 且 长度(保留) == 长度(当前["成员"]):
    设 未变 为 真
  返回 {"未变": 未变, "成员": 保留}

导出 成员_候选匹配, 成员_名单, 成员_裁决