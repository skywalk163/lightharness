# 工具_写文件.light —— 写文件核心工具
#
# 工具名：写文件
# 参数：  {"路径":"文件路径","内容":"要写入的内容"}
# 返回：  {"写入字节数":N, "路径":"...", "覆盖":真/假}
#
# 安全：路径必须落在 HARNESS_ROOT 内，否则拒绝。
# 行为：自动创建父目录；覆盖已有文件（不阻止，但返回 覆盖=真 提示 agent）。

从 工具 导入 造工具定义
从 工具_路径安全 导入 解析安全路径, 取根目录

段落 写文件模式:
  返回 ["type": "object",
          "properties": ["路径": ["type": "string", "description": "要写入的文件路径（限项目根内）"],
                         "内容": ["type": "string", "description": "要写入的文本内容"]],
          "required": ["路径", "内容"]]

段落 写文件处理(参数):
  设 根 为 取根目录()
  设 安全 为 解析安全路径(根, 参数["路径"])
  如果 安全["ok"] == 假:
    抛出 "路径安全校验失败: " + 安全["理由"]
  设 目标 为 安全["路径"]
  # 覆盖提示
  设 覆盖 为 假
  如果 文件存在(目标):
    设 覆盖 为 真
  # 保证父目录存在
  设 父 为 目录名(目标)
  如果 父 != "" 且 目录存在(父) == 假:
    创建目录(父)
  # 写入
  写入文件(目标, 参数["内容"])
  设 字节 为 文件大小(目标)
  返回 ["写入字节数": 字节, "路径": 目标, "覆盖": 覆盖]

段落 造写文件工具定义():
  返回 造工具定义("写文件", "写入项目根内文件（覆盖或新建），自动创建父目录", 写文件模式(), 写文件处理)

段落 注册写文件工具(注册表):
  注册表.注册(造写文件工具定义())
  返回 真


# ============================================================
# R85 任务E（工具域）：对齐上游 0.1.6 packages/fs/tool-fs/src/{diff,write}.ts
#   - 绳计算块差异：行级 LCS 差异，产出 {路径,旧文本,新文本} 块（对齐 computeHunkDiffs）
#   - 绳解析写参数：file_path 非空校验（对齐 parseWriteArgs）
#   - 绳格式化写输出：写结果信封（对齐 formatWriteOutput）
#   注：sandbox 策略联动（resolvePolicy/schemaFields/mapError）属宿主面，本模块仅登记，不移植。
# ============================================================

# 行级 LCS 差异：返回块表，每块 {路径, 旧文本, 新文本}
段落 绳计算块差异(路径, 前, 后):
  设 前行 为 分割字符串(前, "\n")
  设 后行 为 分割字符串(后, "\n")
  设 n 为 长度(前行)
  设 m 为 长度(后行)
  设 dp 为 []
  设 i 为 0
  当 i <= n:
    设 行 为 []
    设 j 为 0
    当 j <= m:
      列表追加(行, 0)
      设 j 为 j + 1
    列表追加(dp, 行)
    设 i 为 i + 1
  设 i 为 n
  当 i > 0:
    设 j 为 m
    当 j > 0:
      如果 前行[i-1] == 后行[j-1]:
        设 dp[i][j] 为 dp[i-1][j-1] + 1
      否则:
        设 左 为 dp[i-1][j]
        设 上 为 dp[i][j-1]
        如果 左 >= 上:
          设 dp[i][j] 为 左
        否则:
          设 dp[i][j] 为 上
      设 j 为 j - 1
    设 i 为 i - 1
  # 回溯：1=共同 2=删 3=增
  设 操作表 为 []
  设 i 为 n
  设 j 为 m
  当 真:
    如果 i == 0:
      如果 j == 0:
        跳出
    如果 i > 0:
      如果 j > 0:
        如果 前行[i-1] == 后行[j-1]:
          列表追加(操作表, [1, 前行[i-1]])
          设 i 为 i - 1
          设 j 为 j - 1
          继续
    设 走删除 为 假
    如果 i > 0:
      如果 j > 0:
        如果 dp[i-1][j] >= dp[i][j-1]:
          设 走删除 为 真
      否则:
        设 走删除 为 真
    如果 走删除 == 真:
      列表追加(操作表, [2, 前行[i-1]])
      设 i 为 i - 1
    否则:
      列表追加(操作表, [3, 后行[j-1]])
      设 j 为 j - 1
  设 反转表 为 []
  设 k 为 长度(操作表) - 1
  当 k >= 0:
    列表追加(反转表, 操作表[k])
    设 k 为 k - 1
  设 操作表 为 反转表
  # 聚合成块：连续 删/增 合并，遇 共同 切开
  设 块表 为 []
  设 当前旧 为 ""
  设 当前新 为 ""
  设 有改 为 假
  遍历 操作 之 操作表:
    设 类型 为 操作[0]
    设 文本 为 操作[1]
    如果 类型 == 1:
      如果 有改 == 真:
        列表追加(块表, ["路径": 路径, "旧文本": 当前旧, "新文本": 当前新])
        设 当前旧 为 ""
        设 当前新 为 ""
        设 有改 为 假
    否则如果 类型 == 2:
      如果 当前旧 == "":
        设 当前旧 为 文本
      否则:
        设 当前旧 为 当前旧 + "\n" + 文本
      设 有改 为 真
    否则:
      如果 当前新 == "":
        设 当前新 为 文本
      否则:
        设 当前新 为 当前新 + "\n" + 文本
      设 有改 为 真
  如果 有改 == 真:
    列表追加(块表, ["路径": 路径, "旧文本": 当前旧, "新文本": 当前新])
  返回 块表

# 解析写参数：file_path 必须非空（否则抛错，对齐 parseWriteArgs）
段落 绳解析写参数(文件路径, 内容):
  如果 是字符串(文件路径) == 假:
    抛出 新建 错误("file_path 必须为非空字符串")
  如果 字符串长度(文件路径) == 0:
    抛出 新建 错误("file_path 必须为非空字符串")
  返回 ["路径": 文件路径, "内容": 内容]

# 格式化写输出信封（对齐 formatWriteOutput）
段落 绳格式化写输出(显示路径, 操作):
  如果 操作 == "create":
    设 动词 为 "Created"
  否则:
    设 动词 为 "Updated"
  返回 "<path>" + 显示路径 + "</path>\n<type>file</type>\n<content>\n" + 动词 + " file\n</content>"
