# 流.light —— LLM 流式词汇表 + 块组装器（对齐原版 llm/llm/types.ts + assembler.ts）
#
# 七种流块（原始协议，英文键便于 JSON 对齐原版）：
#   block-start      { "type", "index", "blockType" }
#   text-delta       { "type", "index", "text" }
#   reasoning-delta  { "type", "index", "text" }
#   tool-call-delta  { "type", "index", "id", "name?", "argumentsDelta" }
#   block-end        { "type", "index", "block" }
#   usage            { "type", "usage" }
#   finish           { "type", "reason" }
# 完成原因："stop" / "tool-calls" / "max-tokens" / "aborted" / "error"
#
# ⚠️ 光明命名规范 v1：方法名/属性名避开关键字与运算符词根（生成/取/导出/模型/事件/部分/类型…）；
# ⚠️ 全部成员赋值用「设 己.X 为 …」前缀；成员下标赋值先取局部变量再下标（L-003/L-005 绕法）。

# ---- 失败信息（provider 失败事实，策略决定是否重试）----
段落 造失败(消息, 代码):
  返回 ["消息": 消息, "代码": 代码]

# ---- 完成原因 ----
段落 造停止原因:
  返回 ["种类": "stop"]
段落 造工具调用原因:
  返回 ["种类": "tool-calls"]
段落 造超长原因:
  返回 ["种类": "max-tokens"]
段落 造中止原因(失败):
  返回 ["种类": "aborted", "失败": 失败]
段落 造错误原因(失败):
  返回 ["种类": "error", "失败": 失败]

# ---- 用量（token 核算）----
# 不相交计数：输入=未缓存输入；缓存读/缓存写/推理为独立可选桶（对齐上游 0.1.5 TokenUsage
#   inputTokens/outputTokens/totalTokens?/cacheReadTokens?/cacheWriteTokens?/reasoningTokens?）。
# 计费口径（上游 types.ts 注释）：计费输入 = 输入 + 缓存读 + 缓存写 三桶之和；
#   把缓存命中折进总 prompt 计数的适配器（DeepSeek prompt_tokens）须先行减出。
# R47：新增 缓存写 桶（追加在末位，保持既有四参调用兼容）；新增 多块累计 与 计费输入 纯逻辑。
段落 造用量(输入, 输出, 缓存读 = 空, 推理 = 空, 缓存写 = 空):
  设 结果 为 ["输入": 输入, "输出": 输出]
  如果 缓存读 != 空:
    结果["缓存读"] 为 缓存读
  如果 推理 != 空:
    结果["推理"] 为 推理
  如果 缓存写 != 空:
    结果["缓存写"] 为 缓存写
  返回 结果

# 桶读取：用量字典缺桶返回 0（累计/计费统一入口，不混桶）
段落 用量桶值(用量, 桶名):
  如果 用量.包含(桶名) 且 用量[桶名] != 空:
    返回 用量[桶名]
  返回 0

# 多块累计：把若干用量字典按桶累加（缓存读/缓存写/推理各自独立累计，绝不混桶）。
# 桶在所有输入里都缺席 → 结果不带该桶键；totalTokens 任一输入带即累计。
段落 用量累计(用量表):
  设 总输入 为 0
  设 总输出 为 0
  设 总缓存读 为 空
  设 总缓存写 为 空
  设 总推理 为 空
  设 总计 为 空
  遍历 项 之 用量表:
    设 总输入 为 总输入 + 用量桶值(项, "输入")
    设 总输出 为 总输出 + 用量桶值(项, "输出")
    如果 项.包含("缓存读") 且 项["缓存读"] != 空:
      如果 总缓存读 == 空:
        设 总缓存读 为 0
      设 总缓存读 为 总缓存读 + 用量桶值(项, "缓存读")
    如果 项.包含("缓存写") 且 项["缓存写"] != 空:
      如果 总缓存写 == 空:
        设 总缓存写 为 0
      设 总缓存写 为 总缓存写 + 用量桶值(项, "缓存写")
    如果 项.包含("推理") 且 项["推理"] != 空:
      如果 总推理 == 空:
        设 总推理 为 0
      设 总推理 为 总推理 + 用量桶值(项, "推理")
    如果 项.包含("totalTokens") 且 项["totalTokens"] != 空:
      如果 总计 == 空:
        设 总计 为 0
      设 总计 为 总计 + 用量桶值(项, "totalTokens")
  设 结果 为 ["输入": 总输入, "输出": 总输出]
  如果 总缓存读 != 空:
    结果["缓存读"] 为 总缓存读
  如果 总缓存写 != 空:
    结果["缓存写"] 为 总缓存写
  如果 总推理 != 空:
    结果["推理"] 为 总推理
  如果 总计 != 空:
    结果["totalTokens"] 为 总计
  返回 结果

# 计费输入（上游 types.ts：billed input = 输入 + 缓存读 + 缓存写 三桶之和）
段落 计费输入(用量):
  返回 用量桶值(用量, "输入") + 用量桶值(用量, "缓存读") + 用量桶值(用量, "缓存写")

# ---- 七种流块 ----
段落 造块开始(索引, 块种类):
  返回 ["type": "block-start", "index": 索引, "blockType": 块种类]
段落 造文本增量(索引, 文本):
  返回 ["type": "text-delta", "index": 索引, "text": 文本]
段落 造推理增量(索引, 文本):
  返回 ["type": "reasoning-delta", "index": 索引, "text": 文本]
段落 造工具调用增量(索引, 标识, 名字, 参数增量):
  返回 ["type": "tool-call-delta", "index": 索引, "id": 标识, "name": 名字, "argumentsDelta": 参数增量]
段落 造块结束(索引, 块):
  返回 ["type": "block-end", "index": 索引, "block": 块]
段落 造用量块(用量):
  返回 ["type": "usage", "usage": 用量]
段落 造结束(原因):
  返回 ["type": "finish", "reason": 原因]

# v2：合并流块——将流块列表送入组装器，返回组装后的内容块表
段落 合并流块(块表):
  设 组装器 为 新建 块组装器()
  遍历 块 之 块表:
    组装器.送入(块)
  返回 组装器.块表()

# ---- 块组装器：增量把流块组装成内容块与最终助手消息 ----
# 容忍仅增量协议（无 block-start/end）；被 block-end 关闭后的迟到增量忽略。
类 块组装器:
  属性 残块表 等于 空
  属性 顺序表 等于 空
  属性 用度值 等于 空
  属性 结论值 等于 空

  段落 构造:
    设 己.残块表 为 {}
    设 己.顺序表 为 []
    设 己.用度值 为 空
    设 己.结论值 为 空

  # 送入一个流块（流序）
  段落 送入(块):
    设 种类 为 块["type"]
    如果 种类 == "block-start":
      己.确保(块["index"], 块["blockType"])
    否则若 种类 == "text-delta":
      设 残块 为 己.确保(块["index"], "text")
      如果 残块["块"] == 空:
        残块["文本"] 为 残块["文本"] + 块["text"]
    否则若 种类 == "reasoning-delta":
      设 残块 为 己.确保(块["index"], "reasoning")
      如果 残块["块"] == 空:
        残块["文本"] 为 残块["文本"] + 块["text"]
    否则若 种类 == "tool-call-delta":
      设 残块 为 己.确保(块["index"], "tool-call")
      如果 残块["块"] == 空:
        残块["标识"] 为 块["id"]
        如果 块.包含("name") 且 块["name"] != "":
          残块["名字"] 为 块["name"]
        残块["参数增量"] 为 残块["参数增量"] + 块["argumentsDelta"]
    否则若 种类 == "block-end":
      设 残块 为 己.确保(块["index"], 块["block"]["type"])
      如果 残块["块"] == 空:
        残块["块"] 为 块["block"]
    否则若 种类 == "usage":
      设 己.用度值 为 块["usage"]
    否则若 种类 == "finish":
      设 己.结论值 为 块["reason"]

  # 确保索引有残块记录；无则新建并登记顺序
  # ⚠️ L-004 状态性：temp 名与成员同名会生成无害自赋值（self.残块表=self.残块表），但语义正确。
  # 换任何其他 temp 名（残块字典）会让构造里「设 己.残块表 为 {}」错乱拆成 self.残块.表。
  段落 确保(索引, 块种类):
    如果 己.残块表.包含(索引) == 假:
      设 残块表 为 己.残块表
      残块表[索引] 为 ["块种类": 块种类, "文本": "", "标识": 空, "名字": "", "参数增量": "", "块": 空]
      己.顺序表.追加(索引)
    返回 己.残块表[索引]

  # 把残块记录组装为完整内容块（块结束未到则用累计增量）
  段落 组装块(残块, 索引):
    如果 残块["块"] != 空:
      返回 残块["块"]
    如果 残块["块种类"] == "text":
      返回 ["type": "text", "text": 残块["文本"]]
    如果 残块["块种类"] == "reasoning":
      返回 ["type": "reasoning", "text": 残块["文本"]]
    如果 残块["块种类"] == "tool-call":
      返回 ["type": "tool-call", "id": 残块["标识"], "name": 残块["名字"], "arguments": 残块["参数增量"]]
    抛出 "无法组装未知种类块: " + 残块["块种类"]

  # 完成原因；流未给 finish 则默认 stop
  段落 完成原因:
    如果 己.结论值 == 空:
      返回 造停止原因()
    返回 己.结论值

  # 组装已见全部块（流序）；max-tokens 截断丢弃工具调用
  段落 块表:
    设 全部 为 []
    遍历 索引 之 己.顺序表:
      全部.追加(己.组装块(己.残块表[索引], 索引))
    设 原因 为 己.完成原因()
    如果 原因["种类"] == "max-tokens":
      设 结果 为 []
      遍历 块 之 全部:
        如果 块["type"] != "tool-call":
          结果.追加(块)
      返回 结果
    返回 全部

  # 中断可安全收尾的前缀：关闭或打开中的 text/reasoning 非空白块
  段落 中断块:
    设 结果 为 []
    遍历 索引 之 己.顺序表:
      设 残块 为 己.残块表[索引]
      设 种类 为 ""
      如果 残块["块"] != 空:
        设 种类 为 残块["块"]["type"]
      否则:
        设 种类 为 残块["块种类"]
      如果 种类 == "text" 或 种类 == "reasoning":
        设 块 为 己.组装块(残块, 索引)
        如果 块["text"].去除空白() != "":
          结果.追加(块)
    返回 结果

  # 用量（usage 块到达前为空）
  段落 用量:
    返回 己.用度值

  # 组装最终助手消息
  段落 组装消息(来源):
    返回 ["role": "assistant", "content": 己.块表(), "来源": 来源]

导出 造失败
导出 造停止原因
导出 造工具调用原因
导出 造超长原因
导出 造中止原因
导出 造错误原因
导出 造用量
导出 用量桶值
导出 用量累计
导出 计费输入
导出 造块开始
导出 造文本增量
导出 造推理增量
导出 造工具调用增量
导出 造块结束
导出 造用量块
导出 造结束
导出 合并流块
导出 块组装器
