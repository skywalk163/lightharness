# 补丁呈现.light —— 对标上游 packages/fs/tool-fs/src/{apply-patch-output,apply-patch-presentation}.ts
# （dsh-v0.2.2-rc.1 = 66491b05e3，B6）
#
# 这是 apply_patch 工具的「模型面文案与呈现形状」纯函数层：
#   1) 调用前预览（presentPatchCall）：不读盘、不解析路径，把原始补丁文本投影成一张 diff 卡片；
#   2) 结果后呈现（presentPatchResult / patchPresentationMeta）：从宿主回传的 opaque meta 收窄出已知差异；
#   3) 终止文案（renderPatch / patchStopped）：成功摘要 + 逐操作状态 + diff 摘要，给模型看。
#
# 挂到既有 src/应用补丁.light 的导出上：预览用 解析补丁 解析原始文本，不改其语义。
# 本模块段落一律带「补丁」前缀，与既有 src 段落集合不交。
# 执行面（读盘/写盘/preflight/沙箱）在宿主，本模块只做纯文本与字典变换。
# 判据见 examples/test_补丁呈现.light（对齐上游 apply-patch-presentation.spec.ts）。

从 应用补丁 导入 解析补丁
从 内置核心判型 导入 是字典, 是列表, 是字符串

导出 补丁预览调用 补丁预览结果 补丁渲染 补丁呈现元 补丁已停 补丁完成行 补丁停止自元 补丁差异自元

# ===== 有序去重（位置表按出现顺序，对齐上游 Set 插入序）=====

段落 补丁去重(路径表):
  设 结果 为 []
  遍历 路径 之 路径表:
    设 见过 为 假
    遍历 已有 之 结果:
      如果 已有 == 路径:
        设 见过 为 真
    如果 见过 == 假:
      列表追加(结果, 路径)
  返回 结果

# ===== 调用前预览（presentPatchCall）=====
# 解析失败（语法错误）返回空（即上游 undefined）；非解析错误原样抛。

段落 补丁预览调用(补丁文本):
  设 操作表 为 []
  尝试:
    设 操作表 为 解析补丁(补丁文本)
  捕获 异常 为 异常值:
    返回 空
  设 差异表 为 []
  设 路径表 为 []
  遍历 操作 之 操作表:
    设 路径 为 操作["路径"]
    如果 操作["种类"] == "新增":
      列表追加(差异表, {"路径": 路径, "旧文本": 空, "新文本": 操作["内容"]})
      列表追加(路径表, 路径)
    否则如果 操作["种类"] == "删除":
      列表追加(路径表, 路径)
    否则:
      # 更新（含移动）：旧文本 = 所有块旧行拼接；空串归一为空（上游 || null）
      设 旧部 为 []
      设 新部 为 []
      遍历 块 之 操作["块表"]:
        设 块旧 为 块["旧行"]
        设 块新 为 块["新行"]
        遍历 行 之 块旧:
          列表追加(旧部, 行)
        遍历 行 之 块新:
          列表追加(新部, 行)
      设 旧文 为 连接字符串(旧部, "\n")
      设 新文 为 连接字符串(新部, "\n")
      如果 字符串长度(旧文) == 0:
        设 旧文 为空
      列表追加(差异表, {"路径": 路径, "旧文本": 旧文, "新文本": 新文})
      列表追加(路径表, 路径)
      如果 字典包含键(操作, "移动至") == 真:
        如果 操作["移动至"] != 空:
          列表追加(路径表, 操作["移动至"])
  设 唯一表 为 补丁去重(路径表)
  设 数 为 列表长度(唯一表)
  设 词 为 "files"
  如果 数 == 1:
    设 词 为 "file"
  设 标题 为 "Apply patch (" + 转字符串(数) + " " + 词 + ")"
  设 位置表 为 []
  遍历 p 之 唯一表:
    列表追加(位置表, {"路径": p})
  返回 {"卡": "diff", "标题": 标题, "差异表": 差异表, "位置表": 位置表}

# ===== 结果后呈现：opaque meta 收窄（diffsFromMeta / stoppedFromMeta）=====

段落 补丁有效差异(项):
  如果 是字典(项) == 假:
    返回 假
  如果 字典包含键(项, "路径") == 假:
    返回 假
  如果 是字符串(项["路径"]) == 假:
    返回 假
  如果 字典包含键(项, "旧文本") == 假:
    返回 假
  如果 项["旧文本"] != 空:
    如果 是字符串(项["旧文本"]) == 假:
      返回 假
  如果 字典包含键(项, "新文本") == 假:
    返回 假
  如果 是字符串(项["新文本"]) == 假:
    返回 假
  返回 真

# meta 必须是非空字典、差异表为非空列表、每项都是合法 FileDiff；否则返回空（上游 undefined）
段落 补丁差异自元(元):
  如果 是字典(元) == 假:
    返回 空
  如果 字典包含键(元, "差异表") == 假:
    返回 空
  设 候选 为 元["差异表"]
  如果 是列表(候选) == 假:
    返回 空
  如果 列表长度(候选) == 0:
    返回 空
  遍历 项 之 候选:
    如果 补丁有效差异(项) == 假:
      返回 空
  返回 候选

# 仅当 meta 是非空字典且「停止」恰为布尔真时才认账（上游 stopped === true）
段落 补丁停止自元(元):
  如果 是字典(元) == 假:
    返回 假
  如果 字典包含键(元, "停止") == 假:
    返回 假
  如果 元["停止"] == 真:
    返回 真
  返回 假

段落 补丁预览结果(结果):
  如果 是字典(结果) == 假:
    返回 空
  如果 字典包含键(结果, "出错") == 真:
    如果 结果["出错"] == 真:
      返回 空
  设 元 为 空
  如果 字典包含键(结果, "元") == 真:
    设 元 为 结果["元"]
  设 差异 为 补丁差异自元(元)
  如果 差异 == 空:
    返回 空
  设 标题 为 "Apply patch"
  如果 补丁停止自元(元) == 真:
    设 标题 为 "Apply patch (stopped)"
  返回 {"卡": "diff", "标题": 标题, "差异表": 差异}

# ===== 终止判定与完成行（patchStopped / completedLines）=====
# 提交值形状：{"取消": 布尔, "受影响路径": [...], "操作表": [op]}
# op：{"序号": 0基, "种类": add/update/delete/move, "路径", "目标"?, "补丁行",
#      "状态": completed/failed/unknown/skipped, "报文"?, "变更"?:[{路径,前,后}]}

段落 补丁已停(值):
  如果 是字典(值) == 假:
    返回 假
  如果 字典包含键(值, "取消") == 真:
    如果 值["取消"] == 真:
      返回 真
  设 表 为 []
  如果 字典包含键(值, "操作表") == 真:
    设 表 为 值["操作表"]
  遍历 操作 之 表:
    如果 操作["状态"] != "completed":
      返回 真
  返回 假

# 已完成路径行：add→A / update(含move)→M / delete→D，按族序拼；move 记目标路径
段落 补丁完成行(表):
  设 行表 为 []
  遍历 操作 之 表:
    如果 操作["状态"] == "completed":
      如果 操作["种类"] == "add":
        设 落 为 操作["路径"]
        如果 字典包含键(操作, "目标") == 真:
          如果 操作["目标"] != 空:
            设 落 为 操作["目标"]
        列表追加(行表, "A " + 落)
  遍历 操作 之 表:
    如果 操作["状态"] == "completed":
      设 实效 为 操作["种类"]
      如果 操作["种类"] == "move":
        设 实效 为 "update"
      如果 实效 == "update":
        设 落 为 操作["路径"]
        如果 字典包含键(操作, "目标") == 真:
          如果 操作["目标"] != 空:
            设 落 为 操作["目标"]
        列表追加(行表, "M " + 落)
  遍历 操作 之 表:
    如果 操作["状态"] == "completed":
      如果 操作["种类"] == "delete":
        设 落 为 操作["路径"]
        列表追加(行表, "D " + 落)
  返回 行表

# ===== 终止文案（renderPatch）=====

段落 补丁渲染(值):
  如果 补丁已停(值) == 假:
    设 表 为 []
    如果 字典包含键(值, "操作表") == 真:
      设 表 为 值["操作表"]
    如果 列表长度(表) == 0:
      返回 "Success. No operations in patch."
    设 行表 为 ["Success. Updated the following files:"]
    遍历 行 之 补丁完成行(表):
      列表追加(行表, 行)
    返回 连接字符串(行表, "\n")
  设 表 为 值["操作表"]
  设 完成数 为 0
  遍历 操作 之 表:
    如果 操作["状态"] == "completed":
      设 完成数 为 完成数 + 1
  设 行表 为 ["Patch stopped after " + 转字符串(完成数) + " of " + 转字符串(列表长度(表)) + " operations."]
  如果 完成数 > 0:
    列表追加(行表, "Completed:")
    遍历 行 之 补丁完成行(表):
      列表追加(行表, 行)
  # Failed
  设 失败表 为 []
  遍历 操作 之 表:
    如果 操作["状态"] == "failed":
      列表追加(失败表, 操作)
  如果 列表长度(失败表) > 0:
    列表追加(行表, "Failed:")
    遍历 操作 之 失败表:
      设 尾 为 ""
      如果 字典包含键(操作, "目标") == 真:
        如果 操作["目标"] != 空:
          设 尾 为 " -> " + 操作["目标"]
      设 行 为 "- operation " + 转字符串(操作["序号"] + 1) + " (" + 操作["种类"] + " " + 操作["路径"] + 尾 + ", patch line " + 转字符串(操作["补丁行"]) + "): " + 操作["报文"]
      列表追加(行表, 行)
      如果 操作["种类"] == "move":
        设 有变 为 假
        如果 字典包含键(操作, "变更") == 真:
          如果 是列表(操作["变更"]) == 真:
            如果 列表长度(操作["变更"]) > 0:
              设 有变 为 真
        如果 有变 == 真:
          列表追加(行表, "  destination " + 操作["目标"] + " was written; source " + 操作["路径"] + " remains")
  # Outcome unknown
  设 未知表 为 []
  遍历 操作 之 表:
    如果 操作["状态"] == "unknown":
      列表追加(未知表, 操作)
  如果 列表长度(未知表) > 0:
    列表追加(行表, "Outcome unknown:")
    遍历 操作 之 未知表:
      设 尾 为 ""
      如果 字典包含键(操作, "目标") == 真:
        如果 操作["目标"] != 空:
          设 尾 为 " -> " + 操作["目标"]
      列表追加(行表, "- operation " + 转字符串(操作["序号"] + 1) + " (" + 操作["种类"] + " " + 操作["路径"] + 尾 + ", patch line " + 转字符串(操作["补丁行"]) + "): " + 操作["报文"])
  # Not executed（skipped）：只列路径，不带目标/行号/报文
  设 跳过表 为 []
  遍历 操作 之 表:
    如果 操作["状态"] == "skipped":
      列表追加(跳过表, 操作)
  如果 列表长度(跳过表) > 0:
    列表追加(行表, "Not executed:")
    遍历 操作 之 跳过表:
      列表追加(行表, "- operation " + 转字符串(操作["序号"] + 1) + " (" + 操作["种类"] + " " + 操作["路径"] + ")")
  返回 连接字符串(行表, "\n")

# ===== 已知已落差异元数据（patchPresentationMeta）=====
# 创作（前=null）不留 diff；无边界基线的删除（后=null）记为空新文；
# 其余整块差异这里简化为一个 FileDiff（上游 structuredPatch 行级 hunk 切分未移植，见交付说明）。

段落 补丁整块差异(路径, 前, 后):
  返回 [{"路径": 路径, "旧文本": 前, "新文本": 后}]

段落 补丁呈现元累计(差异表, 操作):
  设 变更 为 []
  如果 字典包含键(操作, "变更") == 真:
    如果 是列表(操作["变更"]) == 真:
      设 变更 为 操作["变更"]
  遍历 项 之 变更:
    设 前 为 项["前"]
    设 后 为 项["后"]
    如果 前 != 空:
      如果 后 == 空:
        列表追加(差异表, {"路径": 项["路径"], "旧文本": 前, "新文本": ""})
      否则:
        设 块表 为 补丁整块差异(项["路径"], 前, 后)
        遍历 d 之 块表:
          列表追加(差异表, d)
  返回 空

段落 补丁呈现元(值):
  设 差异表 为 []
  设 表 为 []
  如果 字典包含键(值, "操作表") == 真:
    设 表 为 值["操作表"]
  遍历 操作 之 表:
    设 状态 为 操作["状态"]
    如果 状态 == "completed":
      补丁呈现元累计(差异表, 操作)
    否则如果 状态 == "failed":
      补丁呈现元累计(差异表, 操作)
  返回 {"差异表": 差异表, "已停": 补丁已停(值)}
