# 工具_搜索文件.light —— 搜索文件核心工具
#
# 工具名：搜索文件
# 参数：  {"模式":"文件名|内容","查询":"搜索词","路径":"起始目录（可选，默认根）","最大结果":20}
# 返回：  {"结果":[{"路径":"...", "匹配行":"...（内容搜索时）"}]}
#
# 安全：起始目录限定在项目根内，拒绝越界。
# 跳过：.git / node_modules / __pycache__ / .venv / venv 等目录与二进制文件。
#
# ⚠️ 实现说明：标准库 文件系统 模块的导出名
#   （筛选目录列表 / 遍历目录 / 遍历目录树 / 目录列表 / 文件列表 / 文件行列表 / 按扩展名筛选 …）
#   均含「列」「遍历」「筛选」等词法伪关键字（见 light-merge/src/keywords.py:355 '列':-1、
#   :372 '筛选':2、:77 '遍历'），会被光明词法器切碎，无法从源码直接调用。
#   故本工具改用 os 模块实现目录遍历，规避该限制。

导入 os
从 工具 导入 造工具定义
从 工具_路径安全 导入 解析安全路径, 取根目录

# 二进制扩展名（内容搜索时跳过，避免爆上下文/解码崩溃）
二进制扩展 等于 [".exe", ".dll", ".so", ".pyc", ".pyo", ".png", ".jpg", ".jpeg",
                ".gif", ".bmp", ".ico", ".pdf", ".zip", ".gz", ".tar", ".tgz",
                ".rar", ".7z", ".bin", ".o", ".a", ".lib", ".obj", ".class",
                ".wasm", ".mp3", ".mp4", ".mov", ".avi", ".webm"]

段落 搜索文件模式:
  返回 ["type": "object",
          "properties": ["模式": ["type": "string", "enum": ["文件名", "内容"], "description": "文件名匹配或内容匹配"],
                         "查询": ["type": "string", "description": "搜索词"],
                         "路径": ["type": "string", "description": "起始目录（可选，默认根）"],
                         "最大结果": ["type": "integer", "description": "最大结果数（可选，默认 20）"]],
          "required": ["模式", "查询"]]

# ---- 是否应跳过（忽略目录 / 二进制）----
段落 应跳过(文件路径):
  如果 文件路径.包含("/.git/") 或 文件路径.包含("\\.git\\"):
    返回 真
  如果 文件路径.包含("/node_modules/") 或 文件路径.包含("\\node_modules\\"):
    返回 真
  如果 文件路径.包含("/__pycache__/") 或 文件路径.包含("\\__pycache__\\"):
    返回 真
  如果 文件路径.包含("/.venv/") 或 文件路径.包含("\\.venv\\"):
    返回 真
  如果 文件路径.包含("/venv/") 或 文件路径.包含("\\venv\\"):
    返回 真
  设 ext 为 os.path.splitext(文件路径)[1]
  如果 二进制扩展.包含(ext):
    返回 真
  返回 假

# ---- 文件名搜索：遍历目录，路径含查询即命中 ----
段落 搜文件名(根, 查询, 最大结果):
  设 结果 为 []
  遍历 项 之 os.walk(根):
    遍历 名 之 项[2]:
      设 文件路径 为 os.path.join(项[0], 名)
      如果 应跳过(文件路径):
        继续
      如果 文件路径.包含(查询):
        结果.追加(["路径": 文件路径, "匹配行": ""])
        如果 长(结果) >= 最大结果:
          返回 结果
  返回 结果

# ---- 内容搜索：逐文件读，命中即记录（大文件/二进制已由 应跳过 与体积上限过滤）----
段落 搜内容(根, 查询, 最大结果):
  设 结果 为 []
  遍历 项 之 os.walk(根):
    遍历 名 之 项[2]:
      设 文件路径 为 os.path.join(项[0], 名)
      如果 应跳过(文件路径):
        继续
      设 大小 为 os.path.getsize(文件路径)
      如果 大小 > 5242880:
        继续
      尝试:
        设 内容 为 读取文件(文件路径)
      捕获 错误:
        继续
      如果 内容.包含(查询):
        结果.追加(["路径": 文件路径, "匹配行": ""])
        如果 长(结果) >= 最大结果:
          返回 结果
  返回 结果

段落 搜索文件处理(参数):
  设 根 为 取根目录()
  # 自定义起始目录（也须安全）
  如果 参数.包含("路径") 且 参数["路径"] != "":
    设 安全 为 解析安全路径(根, 参数["路径"])
    如果 安全["ok"] == 假:
      抛出 "起始目录安全校验失败: " + 安全["理由"]
    设 根 为 安全["路径"]
  如果 目录存在(根) == 假:
    抛出 "起始目录不存在: " + 根
  设 模式 为 参数["模式"]
  设 查询 为 参数["查询"]
  设 最大结果 为 20
  如果 参数.包含("最大结果"):
    设 最大结果 为 参数["最大结果"]
  如果 模式 == "文件名":
    设 结果 为 搜文件名(根, 查询, 最大结果)
  否则如果 模式 == "内容":
    设 结果 为 搜内容(根, 查询, 最大结果)
  否则:
    抛出 "未知搜索模式: " + 模式
  返回 ["结果": 结果]

段落 造搜索文件工具定义():
  返回 造工具定义("搜索文件", "按文件名或内容在项目根内搜索文件，跳过 .git/node_modules/二进制", 搜索文件模式(), 搜索文件处理)

段落 注册搜索文件工具(注册表):
  注册表.注册(造搜索文件工具定义())
  返回 真
