# 终端.light —— 交互式终端会话（对齐原版 packages/terminal，P1 v1）
#
# v1 用**管道式**实现：subprocess.Popen(stdin=PIPE, stdout=PIPE, text=True)，
# 读线程把子进程输出累积进缓冲，写入走 stdin，信号经 terminate/kill。
# PTY（ConPTY）不在 v1 范围——需要真 tty 的交互工具请用 stdlib/伪终端.light。
#
# 会话三态：未启动 → 运行中 → 已退出(带退出码)。
#   读取(超时) 返回 { 内容, 原因, 码 }；原因 ∈ 数据 / 超时 / 退出。
#   发信号(信号名)：SIGTERM/SIGINT → terminate；SIGKILL → kill；
#   备注：Windows 无 POSIX 信号，用 terminate/kill 等价表示（POSIX 分支未实测）。
#
# ⚠️ 光明命名规范 v1：成员名避开关键字/运算符词根。
# 只读复用 子进程.light/外部命令.light 的公开能力；本模块自 spawn Popen。

导入 subprocess
导入 threading
导入 time
导入 os
从 伪终端 导入 伪控制台

类 终端会话:
  属性 进程块 等于 空
  属性 入流 等于 空
  属性 出流 等于 空
  属性 读线程 等于 空
  属性 停止标志 等于 假
  属性 缓冲锁 等于 空
  属性 缓冲块 等于 []
  属性 消费点 等于 0
  属性 命令 等于 ""
  属性 参数表 等于 []
  属性 工作目录 等于 空
  属性 环境表 等于 空
  属性 超时 等于 空

  段落 构造 接收 命令, 参数表, 工作目录, 环境表, 超时:
    设 己.命令 为 命令
    设 己.参数表 为 参数表
    设 己.工作目录 为 工作目录
    设 己.环境表 为 环境表
    设 己.超时 为 超时
    设 己.缓冲锁 为 threading.Lock()
    设 己.缓冲块 为 []

  # 启动会话：Popen 管道式 + 启动读线程
  段落 启动:
    设 命令行 为 [己.命令]
    遍历 项 之 己.参数表:
      命令行.追加(项)
    设 环境 为 空
    如果 己.环境表 != 空:
      设 环境 为 os.environ.copy()
      设 遍历键 为 0
      遍历 键 之 己.环境表:
        环境[键] 为 己.环境表[键]
    设 进程块 为 subprocess.Popen(命令行, stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1, cwd=己.工作目录, env=环境)
    设 己.进程块 为 进程块
    设 己.入流 为 进程块.stdin
    设 己.出流 为 进程块.stdout
    设 线程 为 threading.Thread(空, 己.读循环, 空, [])
    线程.daemon 为 真
    设 己.读线程 为 线程
    线程.start()

  # 读线程：持续读行追加进缓冲；EOF 或停止标志则退出
  段落 读循环:
    设 出流 为 己.出流
    当 真:
      如果 己.停止标志 == 真:
        跳出
      尝试:
        设 行 为 出流.readline()
      捕获 错误:
        跳出
      如果 行 == "":
        跳出
      己.缓冲锁.acquire()
      己.缓冲块.追加(行)
      己.缓冲锁.release()

  # 全文合并当前缓冲
  段落 取全文:
    己.缓冲锁.acquire()
    设 全文 为 ""
    遍历 块 之 己.缓冲块:
      全文 为 全文 + 块
    己.缓冲锁.release()
    返回 全文

  # 向 stdin 写入文本；返回是否成功写入
  段落 写入 接收 文本:
    设 入流 为 己.入流
    如果 入流 == 空:
      返回 假
    尝试:
      入流.write(文本)
      入流.flush()
      返回 真
    捕获 错误:
      返回 假

  # 读取：最多等 超时 秒出现新输出；返回 { 内容, 原因, 码 }
  段落 读取 接收 超时:
    设 开始 为 时间戳()
    当 真:
      设 全文 为 己.取全文()
      设 已读 为 己.消费点
      如果 长度(全文) > 已读:
        设 增量 为 全文[已读:]
        己.消费点 为 长度(全文)
        设 码 为 己.取退出码()
        返回 ["内容": 增量, "原因": "数据", "码": 码]
      设 码 为 己.取退出码()
      如果 码 != 空:
        设 全文2 为 己.取全文()
        如果 长度(全文2) > 己.消费点:
          设 增量2 为 全文2[己.消费点:]
          己.消费点 为 长度(全文2)
          返回 ["内容": 增量2, "原因": "数据", "码": 码]
        返回 ["内容": "", "原因": "退出", "码": 码]
      如果 时间戳() - 开始 > 超时:
        返回 ["内容": "", "原因": "超时", "码": 空]
      time.sleep(0.02)

  # 发信号：SIGTERM/SIGINT→terminate；SIGKILL→kill；其余返回假
  段落 发信号 接收 信号名:
    设 进程块 为 己.进程块
    如果 进程块 == 空:
      返回 假
    如果 信号名 == "SIGTERM" 或 信号名 == "SIGINT":
      尝试:
        进程块.terminate()
        返回 真
      捕获 错误:
        返回 假
    如果 信号名 == "SIGKILL":
      尝试:
        进程块.kill()
        返回 真
      捕获 错误:
        返回 假
    返回 假

  # 轮询退出码：短期内多次 poll，避免刚退出尚未落定的竞态
  段落 取退出码:
    设 进程块 为 己.进程块
    如果 进程块 == 空:
      返回 空
    设 码 为 进程块.poll()
    设 计 为 0
    当 码 == 空:
      如果 计 >= 15:
        跳出
      计 为 计 + 1
      time.sleep(0.02)
      码 为 进程块.poll()
    返回 码

  # 会话状态：{ 状态: 未启动/运行中/已退出, 码 }
  段落 状态:
    设 进程块 为 己.进程块
    如果 进程块 == 空:
      返回 ["状态": "未启动", "码": 空]
    设 码 为 己.取退出码()
    如果 码 != 空:
      返回 ["状态": "已退出", "码": 码]
    返回 ["状态": "运行中", "码": 空]

  # 关闭：stdin EOF → 未退则 terminate → join 读线程 → 释放句柄。幂等。
  段落 关闭:
    如果 己.停止标志 == 真:
      返回
    设 己.停止标志 为 真
    设 进程块 为 己.进程块
    如果 进程块 != 空:
      尝试:
        设 入流 为 己.入流
        如果 入流 != 空:
          入流.close()
      捕获 错误:
      设 码 为 己.取退出码()
      如果 码 == 空:
        尝试:
          进程块.terminate()
        捕获 错误:
    设 阅读线程 为 己.读线程
    如果 阅读线程 != 空:
      尝试:
        阅读线程.join(2)
      捕获 错误:
      设 己.读线程 为 空
    设 己.入流 为 空
    设 己.出流 为 空
    设 己.进程块 为 空

# 第11轮松绑（L-010/L-012 已修复）：调用方直接 `新建 终端.终端会话(...)`，
# 无需再经安全名工厂。

# ============================================================
# 伪终端会话 —— PTY 模式（对齐原版 packages/terminal 的 PTY 能力，P1 v2）
#
# 基于语言标准库 stdlib/伪终端.light 的 伪控制台（纯光明实现）：
#   - Windows：ConPTY（CreatePseudoConsole，Win10 1809+）
#   - POSIX：openpty/forkpty
# 提供**真 tty** 交互（行缓冲、ANSI 颜色、交互式程序），区别于上方管道式
# 终端会话。接口与 终端会话 对齐：构造/启动/写入/读取(超时)/发信号/状态/关闭。
#
# 边界（承 stdlib/伪终端.light 语义）：
#   - 输出含原始 ANSI 转义，本层不做解析/剥离（原版 terminal 亦不解析）；
#   - PTY 会话无精确退出码（进程持续交互），状态/读取 的 码 一律为 空；
#   - Windows 无 POSIX 信号：SIGINT→写入 \x03(Ctrl+C)；SIGTERM/SIGKILL→关闭(强杀)。
#   - 平台缺失（<Win10 1809 / 无 pty 模块）时 伪控制台 明确抛错，绝不降级管道。
#
# 状态机：未启动 → 运行中 → 已退出。
#   读取(超时) 返回 { 内容, 原因, 码 }；原因 ∈ 数据 / 超时 / 退出。
# ============================================================
类 伪终端会话:
  属性 命令 等于 ""
  属性 参数表 等于 []
  属性 配置 等于 空
  属性 控制台 等于 空
  属性 消费点 等于 0

  # 构造：保存命令/参数/配置；未 spawn（状态=未启动）
  段落 构造 接收 命令, 参数表, 配置:
    设 己.命令 为 命令
    设 己.参数表 为 参数表
    设 己.配置 为 配置
    设 己.消费点 为 0

  # 启动：spawn 伪控制台（真 tty）
  段落 启动:
    设 命令数组 为 [己.命令]
    遍历 项 之 己.参数表:
      命令数组.追加(项)
    设 控制台 为 新建 伪控制台(命令数组, 己.配置)
    设 己.控制台 为 控制台
    设 己.消费点 为 0

  # 写入：文本 → UTF-8 字节 → ConPTY 输入
  段落 写入 接收 文本:
    设 控制台 为 己.控制台
    如果 控制台 == 空:
      返回 假
    尝试:
      控制台.写输入(文本.encode("utf-8"))
      返回 真
    捕获 错误:
      返回 假

  # 读取：最多等 超时 秒出现新输出；返回 { 内容, 原因, 码 }
  段落 读取 接收 超时:
    设 控制台 为 己.控制台
    如果 控制台 == 空:
      返回 ["内容": "", "原因": "退出", "码": 空]
    设 开始 为 时间戳()
    当 真:
      设 全部 为 控制台.读输出()
      设 文本 为 全部.decode("utf-8", "replace")
      如果 长度(文本) > 己.消费点:
        设 增量 为 文本[己.消费点:]
        己.消费点 为 长度(文本)
        返回 ["内容": 增量, "原因": "数据", "码": 空]
      如果 控制台.是否存活() == 假:
        设 尾块 为 控制台.读输出()
        设 尾文 为 尾块.decode("utf-8", "replace")
        如果 长度(尾文) > 己.消费点:
          设 尾增量 为 尾文[己.消费点:]
          己.消费点 为 长度(尾文)
          返回 ["内容": 尾增量, "原因": "数据", "码": 空]
        返回 ["内容": "", "原因": "退出", "码": 空]
      如果 时间戳() - 开始 > 超时:
        返回 ["内容": "", "原因": "超时", "码": 空]
      time.sleep(0.02)

  # 发信号：SIGINT→写 Ctrl+C；SIGTERM/SIGKILL→关闭(强杀)；其余返回假
  段落 发信号 接收 信号名:
    设 控制台 为 己.控制台
    如果 控制台 == 空:
      返回 假
    如果 信号名 == "SIGINT":
      尝试:
        控制台.写输入("\x03".encode("utf-8"))
        返回 真
      捕获 错误:
        返回 假
    如果 信号名 == "SIGTERM" 或 信号名 == "SIGKILL":
      尝试:
        控制台.关闭()
        返回 真
      捕获 错误:
        返回 假
    返回 假

  # 状态：未启动/运行中/已退出（PTY 无退出码，码=空）
  段落 状态:
    设 控制台 为 己.控制台
    如果 控制台 == 空:
      返回 ["状态": "未启动", "码": 空]
    如果 控制台.是否存活() == 假:
      返回 ["状态": "已退出", "码": 空]
    返回 ["状态": "运行中", "码": 空]

  # 关闭：释放 ConPTY/句柄，幂等
  段落 关闭:
    设 控制台 为 己.控制台
    如果 控制台 == 空:
      返回
    尝试:
      控制台.关闭()
    捕获 错误:
    设 己.控制台 为 空
    设 己.消费点 为 0
