# 消息.light —— 消息值类型与构造段（对齐原版 llm/message.ts）
#
# 光明里消息用字典表示：
#   消息  = { id, role: user|assistant|system, content: [块], source }
#   块    = { type: text|reasoning|tool-call|tool-result, ... }
#   来源  = { kind: user|model|tool, ... }
#
# 本模块只负责「构造」，不负责持久化/投影（那是 会话.light 的事）。

# ---- 标识生成：时间戳 + 随机数凑唯一（光明无 crypto.randomUUID 直接暴露）----
段落 造标识:
  设 时间部分 为 转字符串(时间戳())
  设 随机部分 为 转字符串(随机整数(0, 999999))
  返回 "m_" 加上 时间部分 加上 "_" 加上 随机部分

# ---- 内容块构造 ----

# 造纯文本块
段落 造文本块(文本):
  返回 ["type": "text", "text": 文本]

# 造推理块（reasoning/thinking）
段落 造推理块(文本):
  返回 ["type": "reasoning", "text": 文本]

# 造工具调用块（arguments 是模型产出的原始 JSON 字符串）
段落 造工具调用块(标识, 名字, 参数JSON):
  返回 ["type": "tool-call", "id": 标识, "name": 名字, "arguments": 参数JSON]

# 造工具结果块（内容为块表；是否错误 标记失败）
段落 造工具结果块(工具调用标识, 内容, 是否错误):
  返回 ["type": "tool-result", "toolCallId": 工具调用标识, "content": 内容, "isError": 是否错误]

# 造图片块（data 为 base64 编码，mimeType 默认 image/png）
段落 造图片块(数据, 类型):
  设 mime 为 "image/png"
  如果 类型 != 空:
    设 mime 为 类型
  返回 ["type": "image", "data": 数据, "mimeType": mime]

# 造音频块（data 为 base64 编码，mimeType 默认 audio/wav）
段落 造音频块(数据, 类型):
  设 mime 为 "audio/wav"
  如果 类型 != 空:
    设 mime 为 类型
  返回 ["type": "audio", "data": 数据, "mimeType": mime]

# 造资源块（对齐原版 ResourceContentBlock：resourceId + text + source）
段落 造资源块(资源ID, 文本, 来源):
  设 块 为 ["type": "resource", "resourceId": 资源ID, "text": 文本]
  如果 来源 != 空:
    块["source"] 为 来源
  返回 块

# 造文件块（对齐原版 FileBlock：type=file + attachment 引用）
# 原版在请求装配时把 file 块投影为确定性句柄文本（名字/字节大小/只读保存路径），
# 日志保留结构化引用；光明侧只构造结构化块，投影由装配方负责。
段落 造文件块(附件引用):
  返回 ["type": "file", "attachment": 附件引用]

# ---- 消息构造（脱钩：光明 L-083 修复后提供 深拷贝 一等原语，对齐上游 deep-freeze）----

# ---- 消息构造 ----

# 造用户消息（来源 kind=user）
段落 造用户消息(内容):
  返回 ["id": 造标识(), "role": "user", "content": 深拷贝(内容), "source": ["kind": "user"]]

# 造用户消息（带自定义来源，供插件/注入上下文用）
段落 造用户消息带来源(内容, 来源):
  返回 ["id": 造标识(), "role": "user", "content": 深拷贝(内容), "source": 来源]

# 造助手消息（来源 kind=model，携带 provider/model）
段落 造助手消息(内容, 提供方, 模型):
  返回 ["id": 造标识(), "role": "assistant", "content": 深拷贝(内容), "source": ["kind": "model", "provider": 提供方, "model": 模型]]

# 造助手消息（带回放状态，供适配器私有元数据）
段落 造助手消息带回放(内容, 提供方, 模型, 回放状态):
  设 来源 为 ["kind": "model", "provider": 提供方, "model": 模型]
  如果 回放状态 不等于 空:
    来源["replayState"] 为 回放状态
  返回 ["id": 造标识(), "role": "assistant", "content": 深拷贝(内容), "source": 来源]

# 造工具结果消息（role=user，content=[tool-result 块]，来源 kind=tool）
段落 造工具结果消息(调用标识, 内容, 是否错误):
  设 块 为 造工具结果块(调用标识, 深拷贝(内容), 是否错误)
  返回 ["id": 造标识(), "role": "user", "content": [块], "source": ["kind": "tool", "callId": 调用标识]]

# 造系统消息（对齐原版 createSystemMessage(text, plugin)）
# 空文本 → content = []（表示「无系统提示」）；非空 → 单个 text 块
# 来源恒为 {"kind": "plugin", "plugin": 插件}
段落 造系统消息(文本, 插件):
  设 内容 为 []
  如果 文本 != "":
    列表追加(内容, 造文本块(文本))
  返回 ["id": 造标识(), "role": "system", "content": 深拷贝(内容), "source": ["kind": "plugin", "plugin": 插件]]

# ---- 判别与工具函数 ----

# 消息是否为空内容助手消息（只挂用量，不投影）
段落 助手消息内容为空(消息):
  返回 长度(消息["content"]) == 0

# 取消息的文本块拼接（供 UI/摘要用）
段落 取消息文本(消息):
  设 结果 为 ""
  遍历 块 之 消息["content"]:
    如果 块["type"] == "text":
      设 结果 为 结果 加上 块["text"]
    否则如果 块["type"] == "reasoning":
      设 结果 为 结果 加上 块["text"]
    否则如果 块["type"] == "image":
      设 预览 为 块["data"]
      如果 长度(预览) > 40:
        设 预览 为 预览[0:40] 加上 "..."
      设 结果 为 结果 加上 "[图片 " 加上 块["mimeType"] 加上 ": " 加上 预览 加上 "]"
    否则如果 块["type"] == "audio":
      设 结果 为 结果 加上 "[音频 " 加上 块["mimeType"] 加上 "]"
    否则如果 块["type"] == "resource":
      设 结果 为 结果 加上 "[资源 " 加上 块["resourceId"] 加上 ": " 加上 块["text"] 加上 "]"
    否则如果 块["type"] == "file":
      # 上游 FileBlock 在装配时投影为确定性句柄文本（名字 + 字节大小）；此处同口径
      设 引用 为 块["attachment"]
      设 结果 为 结果 加上 "[文件 " 加上 引用["name"] 加上 ": " 加上 转字符串(引用["bytes"]) 加上 " 字节]"
  返回 结果

# =====================================================================
# §8 图片卸载（0.1.6 新增：llm/src/content.ts 卸载面 + error.ts 错误码）
#
# 上游锚点 ddefc45fbc：
#   packages/llm/llm/src/content.ts:126 contentHasImage
#   packages/llm/llm/src/content.ts:208 base64Length
#   packages/llm/llm/src/content.ts:218 visitImageBlocks
#   packages/llm/llm/src/content.ts:226 replaceOffloadedImages
#   packages/llm/llm/src/content.ts:258 projectOffloadedImages
#   packages/llm/llm/src/content.ts:277 offloadedImagePrefixCount
#   packages/llm/llm/src/content.ts:311 requiredImageOffload
#   packages/llm/llm/src/error.ts:172   IMAGE_OFFLOAD_REQUIRED_CODE
#   packages/llm/llm-deepseek/src/protocols/chat-completions/serialize.ts:408-412
#     —— LlmError 文案与 { offloadImages } 载荷
# 判据锚点：packages/llm/llm/tests/content.spec.ts
#   describe('requiredImageOffload traversal') / ('projectOffloadedImages') / ('requiredImageOffload')
# 语义要点（0.1.6 卸载模型重构核心）：
#   offloaded 标记是 surface 的持久事实；投影时只把已标记块换成路由占位文本，
#   绝不自行卸载。超限时报 IMAGE_OFFLOAD_REQUIRED 并携带「还需卸载的最老张数」，
#   由上游链路记账后重试。预算按「整张量 / 整字节量」取整，不按单张逐张扣。
# 偏离登记：
#   L-132 光明 段落 可作实参传递（先例 examples/test_R85_D_typert.light 段_释放桩），
#     但回调无法捕获调用方局部变量，故 requiredImageOffload 的遍历改写为显式传表的
#     收集器 收集图片字节；同时保留 visitImageBlocks 的回调形态 遍历图片块。
#   L-133 上游以对象同一性（===）判定「无需复制」；光明 == 是深相等，故
#     替换已卸载图片 先用 块表包含已卸载 预扫描，等价保留「无卸载则原样返回」。
#   L-134 Math.ceil(n/3) 与 Math.ceil(x/q) 对正整数改写为纯整数算式
#     整除(n+2, 3) 与 整除(x+q-1, q)，避开浮点除法与 L-126 floor/trunc 分歧。
# =====================================================================

# IMAGE_OFFLOAD_REQUIRED_CODE（error.ts:172 逐字）
段落 卸载错误码:
  返回 "IMAGE_OFFLOAD_REQUIRED"

# base64Length：含填充的 base64 长度 = ceil(bytes/3)*4
段落 基64长度(字节数):
  返回 整除(字节数 + 2, 3) * 4

# contentHasImage：递归识别 image 块（含嵌套 tool-result）
段落 内容含图片(内容):
  遍历 块 之 内容:
    如果 块["type"] == "image":
      返回 真
    如果 块["type"] == "tool-result" 且 内容含图片(块["content"]):
      返回 真
  返回 假

# 块是否为已卸载标记（缺键视为未卸载）
段落 块已卸载(块):
  如果 块.包含("offloaded") 且 块["offloaded"] == 真:
    返回 真
  返回 假

# visitImageBlocks：按消息顺序访问每个图片块，含嵌套 tool-result 内容
段落 遍历图片块(内容, 访问):
  遍历 块 之 内容:
    如果 块["type"] == "image":
      访问(块)
    否则如果 块["type"] == "tool-result":
      遍历图片块(块["content"], 访问)

# requiredImageOffload 的内部收集器：未卸载图片的表示字节长度表（最老在前）
段落 收集图片字节(内容, 预算, 取块字节, 表):
  遍历 块 之 内容:
    如果 块["type"] == "image":
      如果 块已卸载(块) == 假:
        设 字节 为 取块字节(块)
        如果 预算["representation"] == "base64":
          列表追加(表, 基64长度(字节))
        否则:
          列表追加(表, 字节)
    否则如果 块["type"] == "tool-result":
      收集图片字节(块["content"], 预算, 取块字节, 表)

# offloadedImagePrefixCount：超预算时需卸载的最老前缀张数（按整量取整）
段落 卸载前缀数(字节表, 预算):
  设 合计 为 0
  遍历 字节 之 字节表:
    设 合计 为 合计 + 字节
  设 超张 为 0
  如果 预算.包含("maxImages"):
    设 差 为 长度(字节表) - 预算["maxImages"]
    如果 差 > 超张:
      设 超张 为 差
  设 超字节 为 0
  如果 预算.包含("maxBytes"):
    设 差 为 合计 - 预算["maxBytes"]
    如果 差 > 超字节:
      设 超字节 为 差
  如果 超张 == 0 且 超字节 == 0:
    返回 0
  设 张量 为 1
  如果 预算.包含("countQuantum"):
    设 张量 为 预算["countQuantum"]
  设 字节量 为 1
  如果 预算.包含("byteQuantum"):
    设 字节量 为 预算["byteQuantum"]
  设 应卸张 为 0
  如果 超张 != 0:
    设 应卸张 为 整除(超张 + 张量 - 1, 张量) * 张量
  设 应卸字节 为 0
  如果 超字节 != 0:
    设 应卸字节 为 整除(超字节 + 字节量 - 1, 字节量) * 字节量
  设 计数 为 0
  设 已卸字节 为 0
  设 i 为 0
  当 i < 长度(字节表):
    设 字节 为 字节表[i]
    设 字节达标 为 假
    如果 应卸字节 == 0:
      设 字节达标 为 真
    否则如果 字节量 == 1:
      如果 已卸字节 >= 应卸字节:
        设 字节达标 为 真
    否则:
      如果 已卸字节 > 应卸字节:
        设 字节达标 为 真
    如果 计数 >= 应卸张 且 字节达标:
      跳出
    设 已卸字节 为 已卸字节 + 字节
    设 计数 为 计数 + 1
    设 i 为 i + 1
  返回 计数

# requiredImageOffload：还需卸载的最老图片张数；请求已达标时为 0
段落 需卸载数(消息表, 预算, 取块字节):
  设 表 为 列表创建()
  遍历 消息 之 消息表:
    收集图片字节(消息["content"], 预算, 取块字节, 表)
  返回 卸载前缀数(表, 预算)

# 块表（含嵌套）是否含已卸载标记
段落 块表包含已卸载(块表):
  遍历 块 之 块表:
    如果 块["type"] == "image" 且 块已卸载(块):
      返回 真
    如果 块["type"] == "tool-result" 且 块表包含已卸载(块["content"]):
      返回 真
  返回 假

# replaceOffloadedImages：已标记块换成路由占位文本，未改动则原样返回
段落 替换已卸载图片(块表, 占位):
  如果 块表包含已卸载(块表) == 假:
    返回 块表
  设 结果 为 列表创建()
  遍历 块 之 块表:
    如果 块["type"] == "image" 且 块已卸载(块):
      列表追加(结果, ["type": "text", "text": 占位(块["attachment"])])
    否则如果 块["type"] == "tool-result":
      设 副本 为 深拷贝(块)
      副本["content"] 为 替换已卸载图片(块["content"], 占位)
      列表追加(结果, 副本)
    否则:
      列表追加(结果, 块)
  返回 结果

# projectOffloadedImages：逐消息投影，内容未变则复用原消息
段落 投影已卸载图片(消息表, 占位):
  设 结果 为 列表创建()
  遍历 消息 之 消息表:
    设 新内容 为 替换已卸载图片(消息["content"], 占位)
    如果 新内容 == 消息["content"]:
      列表追加(结果, 消息)
    否则:
      设 副本 为 深拷贝(消息)
      副本["content"] 为 新内容
      列表追加(结果, 副本)
  返回 结果

# 造 IMAGE_OFFLOAD_REQUIRED 错误形状（serialize.ts:408-412 文案逐字）
段落 造卸载错误(预算形态, 卸载张数):
  返回 ["name": "LlmError",
    "message": "DeepSeek " + 预算形态 + " request images exceed the route budget; "
      + 转字符串(卸载张数) + " more oldest occurrence(s) must be offloaded.",
    "code": 卸载错误码(), "offloadImages": 卸载张数]

# R85A-OFFLOAD-SECTION

导出 卸载错误码
导出 基64长度
导出 内容含图片
导出 块已卸载
导出 遍历图片块
导出 收集图片字节
导出 卸载前缀数
导出 需卸载数
导出 块表包含已卸载
导出 替换已卸载图片
导出 投影已卸载图片
导出 造卸载错误
