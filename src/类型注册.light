# 类型注册.light —— typert 类型注册纯逻辑（任务卡 L，编号 62）
# 对齐原版：packages/typert/loader/src/index.ts（L61-142 清单校验 / L264-276 判定编解码严格）
#          + packages/typert/registry/src/index.ts（L42-69 三个 key 纯函数）
#          + packages/typert/registry/src/service.ts（L107-180 描述符存储）
#
# 纯逻辑口径：剔除真实 IO 与宿主依赖——zod v4 运行时、./typert 模块加载、远程 invocation
#   派发通道一律以入参字典投影；"zod v4 schema 驱动" 以 schema._def.typeName 字符串存在性
#   判定（zod v4 内部形状）。清单/编解码/模式均为纯字典，无任何网络/子进程/文件 IO。
#
# 命名（避 类型/事件/接收 词根）：service 段→服务段（不叫 TypeService）；keyword 生成函数
#   用 构造注册键/构造包键/构造端点；codec→编解码；manifest 校验→校验清单；event 段→时机段；
#   object 段→对象段；invocation 段→调用段。原版英文键（schema/service/event/object/
#   invocation/codec/name/strict...）作为字符串字面量保留在入参/出参，不做中文改名。
# 成员赋值一律 设 己.X 为 …；成员下标赋值先取临时表再写；字面量一律单行。

导出 校验清单 判定编解码严格 构造注册键 构造包键 构造端点 来源优先级 校验模式段 校验服务段 校验时机段 校验对象段 校验调用段 造描述符存储。

# ===========================================================
# 1) 三个 key 生成纯函数（registry/src/index.ts L42-69）
# ===========================================================
# typertKey → 构造注册键：全局注册主键（唯一标识一个 typet）
段落 构造注册键 接收 名:
  返回 "typert:" + 名

# typertPackageKey → 构造包键：按包聚合的键（用于按包列举/去重）
段落 构造包键 接收 名:
  返回 "typertPackage:" + 名

# typertEndpoint → 构造端点：远程 invocation 寻址端点键
段落 构造端点 接收 名:
  返回 "typertEndpoint:" + 名

# ===========================================================
# 2) requireStrictCodec → 判定编解码严格（loader L264-276）
# ===========================================================
# codec 必须：① 是对象；② strict === true；③ schema 存在且为 zod v4 schema
# （schema._def.typeName 为非空字符串——zod v4 内部形状）。任一不满足抛 [invalid-codec]。
段落 判定编解码严格 接收 编解码:
  如果 是字典(编解码) == 假:
    抛出 新建 错误("codec 必须是对象 [invalid-codec]")
  设 严格 为 取可选(编解码, "strict")
  如果 严格 != 真:
    抛出 新建 错误("codec 必须 strict [invalid-codec]")
  设 模式 为 取可选(编解码, "schema")
  如果 模式 == 空:
    抛出 新建 错误("codec 必须带 schema [invalid-codec]")
  如果 是字典(模式) == 假:
    抛出 新建 错误("codec.schema 必须是 zod v4 schema [invalid-codec]")
  设 定义 为 取可选(模式, "_def")
  如果 定义 == 空:
    抛出 新建 错误("codec.schema 必须是 zod v4 schema [invalid-codec]")
  如果 是字典(定义) == 假:
    抛出 新建 错误("codec.schema 必须是 zod v4 schema [invalid-codec]")
  设 种类 为 取可选(定义, "typeName")
  如果 是字符串(种类) == 假:
    抛出 新建 错误("codec.schema 必须是 zod v4 schema [invalid-codec]")
  返回 真

# ===========================================================
# 3) 清单校验（loader L61-142：解析 ./typert 导出并校验各段）
# ===========================================================
# 校验清单：顶层必须是对象且含 schema 段；service/event/object/invocation 段可缺省，
# 但出现即校验。返回规范化清单，缺省段为 空，schema 段补 description/version 缺省。
段落 校验清单 接收 清单:
  如果 是字典(清单) == 假:
    抛出 新建 错误("typert 导出必须是对象 [invalid-manifest]")
  设 模式段 为 取可选(清单, "schema")
  如果 模式段 == 空:
    抛出 新建 错误("typert 导出缺 schema [invalid-manifest]")
  设 规范模式 为 校验模式段(模式段)
  设 规范服务 为 空
  设 服务段 为 取可选(清单, "service")
  如果 服务段 != 空:
    设 规范服务 为 校验服务段(服务段)
  设 规范时机 为 空
  设 时机段 为 取可选(清单, "event")
  如果 时机段 != 空:
    设 规范时机 为 校验时机段(时机段)
  设 规范对象 为 空
  设 对象段 为 取可选(清单, "object")
  如果 对象段 != 空:
    设 规范对象 为 校验对象段(对象段)
  设 规范调用 为 空
  设 调用段 为 取可选(清单, "invocation")
  如果 调用段 != 空:
    设 规范调用 为 校验调用段(调用段)
  返回 { "schema": 规范模式, "service": 规范服务, "event": 规范时机, "object": 规范对象, "invocation": 规范调用 }

# schema 段：codec（须过 判定编解码严格）+ name（非空字符串）+ description/version（可选字符串）
段落 校验模式段 接收 段:
  如果 是字典(段) == 假:
    抛出 新建 错误("schema 段必须是对象 [invalid-schema]")
  设 编解码 为 取可选(段, "codec")
  如果 编解码 == 空:
    抛出 新建 错误("schema 段缺 codec [invalid-schema]")
  判定编解码严格(编解码)
  设 名字 为 取可选(段, "name")
  如果 名字 == 空 或 名字 == "":
    抛出 新建 错误("schema 段缺 name [invalid-schema]")
  如果 是字符串(名字) == 假:
    抛出 新建 错误("schema.name 必须为字符串 [invalid-schema]")
  设 描述 为 取可选(段, "description")
  如果 描述 == 空:
    设 描述 为 ""
  否则 如果 是字符串(描述) == 假:
    抛出 新建 错误("schema.description 必须为字符串 [invalid-schema]")
  设 版本 为 取可选(段, "version")
  如果 版本 == 空:
    设 版本 为 "1"
  否则 如果 是字符串(版本) == 假:
    抛出 新建 错误("schema.version 必须为字符串 [invalid-schema]")
  返回 { "codec": 编解码, "name": 名字, "description": 描述, "version": 版本 }

# service 段：name（非空字符串）+ description（可选字符串）
段落 校验服务段 接收 段:
  如果 是字典(段) == 假:
    抛出 新建 错误("service 段必须是对象 [invalid-service]")
  设 名字 为 取可选(段, "name")
  如果 名字 == 空 或 名字 == "":
    抛出 新建 错误("service 段缺 name [invalid-service]")
  如果 是字符串(名字) == 假:
    抛出 新建 错误("service.name 必须为字符串 [invalid-service]")
  设 描述 为 取可选(段, "description")
  如果 描述 == 空:
    设 描述 为 ""
  否则 如果 是字符串(描述) == 假:
    抛出 新建 错误("service.description 必须为字符串 [invalid-service]")
  返回 { "name": 名字, "description": 描述 }

# event 段：name（非空字符串）
段落 校验时机段 接收 段:
  如果 是字典(段) == 假:
    抛出 新建 错误("event 段必须是对象 [invalid-event]")
  设 名字 为 取可选(段, "name")
  如果 名字 == 空 或 名字 == "":
    抛出 新建 错误("event 段缺 name [invalid-event]")
  如果 是字符串(名字) == 假:
    抛出 新建 错误("event.name 必须为字符串 [invalid-event]")
  返回 { "name": 名字 }

# object 段：name（非空字符串）
段落 校验对象段 接收 段:
  如果 是字典(段) == 假:
    抛出 新建 错误("object 段必须是对象 [invalid-object]")
  设 名字 为 取可选(段, "name")
  如果 名字 == 空 或 名字 == "":
    抛出 新建 错误("object 段缺 name [invalid-object]")
  如果 是字符串(名字) == 假:
    抛出 新建 错误("object.name 必须为字符串 [invalid-object]")
  返回 { "name": 名字 }

# invocation 段：name（非空字符串）+ service（可选字符串，端点指向）
段落 校验调用段 接收 段:
  如果 是字典(段) == 假:
    抛出 新建 错误("invocation 段必须是对象 [invalid-invocation]")
  设 名字 为 取可选(段, "name")
  如果 名字 == 空 或 名字 == "":
    抛出 新建 错误("invocation 段缺 name [invalid-invocation]")
  如果 是字符串(名字) == 假:
    抛出 新建 错误("invocation.name 必须为字符串 [invalid-invocation]")
  设 服务 为 取可选(段, "service")
  如果 服务 == 空:
    设 服务 为 ""
  否则 如果 是字符串(服务) == 假:
    抛出 新建 错误("invocation.service 必须为字符串 [invalid-invocation]")
  返回 { "name": 名字, "service": 服务 }

# ===========================================================
# 4) 描述符存储（service.ts L107-180：本地/远程 invocation 注册/去重/撤回/查询）
# ===========================================================
# 条目形状：{ "描述符": 原样描述符, "来源": "本地"/"远程" }，键 = 构造注册键(描述符["name"])。
# 优先级：本地(2) > 远程(1)。去重时新来源优先级更高才覆盖，否则保留现有。
段落 来源优先级 接收 来源:
  如果 来源 == "本地":
    返回 2
  返回 1

类 描述符存储:
  属性 描述符表 等于 空

  段落 构造:
    设 己.描述符表 为 {}

  # 登记：键已存在则抛重复；否则写入并返回条目
  段落 登记 接收 来源, 描述符:
    设 键 为 构造注册键(描述符["name"])
    设 表 为 己.描述符表
    如果 字典包含键(表, 键) == 真:
      抛出 新建 错误("描述符已登记: " + 键)
    设 表[键] 为 { "描述符": 描述符, "来源": 来源 }
    返回 表[键]

  # 去重：键已存在则保留/按优先级覆盖，返回 { 新增, 覆盖 }；不存在则新增
  段落 去重 接收 来源, 描述符:
    设 键 为 构造注册键(描述符["name"])
    设 表 为 己.描述符表
    如果 字典包含键(表, 键) == 真:
      设 现有 为 表[键]
      如果 来源优先级(来源) > 来源优先级(现有["来源"]):
        设 表[键] 为 { "描述符": 描述符, "来源": 来源 }
        返回 { "新增": 假, "覆盖": 真 }
      返回 { "新增": 假, "覆盖": 假 }
    设 表[键] 为 { "描述符": 描述符, "来源": 来源 }
    返回 { "新增": 真, "覆盖": 假 }

  # 撤回：键不存在则抛；否则删除并返回原条目
  段落 撤回 接收 键:
    设 表 为 己.描述符表
    如果 字典包含键(表, 键) == 假:
      抛出 新建 错误("描述符未登记: " + 键)
    设 原有 为 表[键]
    字典删除(表, 键)
    返回 原有

  # 查询：键不存在返回 空
  段落 查询 接收 键:
    返回 取可选(己.描述符表, 键)

  # 判定已登记：键是否存在
  段落 判定已登记 接收 键:
    返回 字典包含键(己.描述符表, 键)

  # 条目数：当前登记条数
  段落 条目数:
    返回 长度(己.描述符表)

# 构造描述符存储实例
段落 造描述符存储:
  返回 新建 描述符存储()
