# minimal（order 3）：persona + persistent-shell 组（cordis:group，isolate.terminals）
#   组内 5 子项：pty / terminal-bash / persistent-bash / terminal-pwsh / persistent-pwsh。
#   bash 系在 win32 禁用、pwsh 系在非 win32 禁用（均 !!js 表达式）。
#   persistent-bash / persistent-pwsh 的 description 是多行块标量，此处保留首行。
#   2 个顶层行 + 5 个子项 → 递归 7 行
段落 极简组合行表():
  设 壳组 为 {"id": "persistent-shell", "name": "cordis:group", "group": 真, "config": [
    {"id": "pty", "name": "@deepseek-ai/dsh-terminal", "group": 假, "config": {}, "disabled": 假},
    {"id": "terminal-bash", "name": "@deepseek-ai/dsh-terminal-bash", "group": 假, "config": {"timeoutMs": 300000}, "disabled": {"js表达式": "process.platform === 'win32'"}},
    {"id": "persistent-bash", "name": "@deepseek-ai/dsh-tool-bash-persistent", "group": 假, "config": {"timeoutMs": 300000, "description": "Run commands in a bash shell"}, "disabled": {"js表达式": "process.platform === 'win32'"}, "已截断": ["description"]},
    {"id": "terminal-pwsh", "name": "@deepseek-ai/dsh-terminal-bash", "group": 假, "config": {"shellDialect": "pwsh", "timeoutMs": 300000}, "disabled": {"js表达式": "process.platform !== 'win32'"}},
    {"id": "persistent-pwsh", "name": "@deepseek-ai/dsh-tool-pwsh-persistent", "group": 假, "config": {"timeoutMs": 300000, "description": "Run commands in a PowerShell shell"}, "disabled": {"js表达式": "process.platform !== 'win32'"}, "已截断": ["description"]}], "disabled": 假}
  设 表 为 [
    {"id": "persona", "name": "@deepseek-ai/dsh-persona", "group": 假, "config": {"prefix": "You are a helpful software engineer assistant.", "complete": 真, "includeRuntimeContext": 假}, "disabled": 假},
    壳组]
  返回 表

