# =====================================================================
# §2.5 T-0403：四个「组合型」模式（自上而下 / 自下而上 / 头脑风暴 / 懒人）
#
#   与 shipped 四预设的关系：**不是**新上游 patch.yml 的复刻，而是本仓按 DSH 的模式规格
#   在现有行表上做「增删叶子行」的派生组合。四个模式的差异只在
#   控制流向 / 人机介入点 / 终止条件 三个维度 —— 这三者由提示契约承载
#   （见 src/预设.light 的 模式系统提示 / 模式终止条件），数据层只负责
#   「这个模式能碰到哪些工具」，因此各表一律以 标准组合行表 为基底增删，不整份复制。
#
#   增删依据（逐条对得上任务规格表，改动都要能指回某一行理由）：
#     topdown    —— 全 4 工具 + 目标工具：基底已含 tool-bash/tool-fs-read/tool-fs-write
#                   与 tool-goal，故不删不加（差异全在提示：计划树是一等产物）。
#     bottomup   —— 全 4 工具，**不给**目标工具 → 删 tool-goal；
#                   且「不主动请求确认」→ 删 tool-ask-user（人机介入点在数据层的投影）。
#     brainstorm —— **只给只读工具** → 删 tool-bash / tool-pwsh（写盘与执行入口），
#                   删 tool-fs-write（写文件叶子），删 tool-goal（会推进改动），
#                   删 delegation 组（子 Agent 能绕过只读约束）；
#                   保留 tool-fs-read / tool-fs-search（读文件 / 搜索文件）与压缩、规划。
#     lazy       —— 全 4 工具；「不追问细节、选默认值继续」→ 删 tool-ask-user。
#
#   T-0419 已拆叶子：总入口 把「读文件」映射到 tool-fs-read、「写文件」映射到 tool-fs-write，
#   基底行表也随之拆成两行；brainstorm 删 tool-fs-write 后，**装配层**真的没有「写文件」了，
#   不再只靠数据层叶子集兜底。反证见 tests/test_T0419_工具叶子拆分.py。
#   「目标工具」本仓仍只是声明行（运行时实现见 T-0401/T-0407）。
# =====================================================================

# 增删组合行(基底行表, 删除标识表, 增补行表) -> 新行表
#   按顶层行 id 过滤（组行 id 也参与过滤，删 delegation 即整组 10 行一起走），
#   再把增补行接到尾部；不改动基底行表本身。
段落 增删组合行(基底行表, 删除标识表, 增补行表):
  设 结果 为 []
  遍历 行 之 基底行表:
    设 标识 为 字典获取(行, "id", "")
    如果 列表包含(删除标识表, 标识) == 假:
      列表追加(结果, 行)
  遍历 行 之 增补行表:
    列表追加(结果, 行)
  返回 结果

# 自上而下（order 5）：全 4 工具 + 目标工具，基底原样承担
段落 自上而下组合行表():
  设 空删表 为 []
  设 空增表 为 []
  返回 增删组合行(标准组合行表(), 空删表, 空增表)

# 自下而上（order 6）：全 4 工具，不给目标工具；不主动请求确认 → 不给提问工具
段落 自下而上组合行表():
  设 删表 为 ["tool-goal", "tool-ask-user"]
  设 空增表 为 []
  返回 增删组合行(标准组合行表(), 删表, 空增表)

# 头脑风暴（order 7）：只给只读工具（读文件 / 搜索文件），不给写文件与 bash
段落 头脑风暴组合行表():
  设 删表 为 ["tool-bash", "tool-pwsh", "tool-fs-write", "tool-goal", "delegation"]
  设 空增表 为 []
  返回 增删组合行(标准组合行表(), 删表, 空增表)

# 懒人（order 8）：全 4 工具；不追问细节 → 不给提问工具
段落 懒人组合行表():
  设 删表 为 ["tool-ask-user"]
  设 空增表 为 []
  返回 增删组合行(标准组合行表(), 删表, 空增表)

# =====================================================================
# §2.6 T-0441：两维正交 —— 代理（工具面） × 方法（推进面）
#
#   组合串 = 代理ID + "+" + 方法ID，如 standard+default / ptc+brainstorm。
#   4 代理 × 5 方法 = 20 个合法组合；会话里存的仍是「一个字符串」，
#   复用现有 模式 字段（不加会话库字段、不做数据迁移）。
#
#   兼容别名（解析层做，不改存储语义）：
#     裸代理 id  -> 代理+default
#     裸方法 id  -> standard+方法
#   default 对工具面/提示面都零改动；standard+default 必须与旧 standard 等价。
#
#   工具面规则：组合行表 = 代理行表 − 方法删减。方法**只删不增**：
#     default  删 []
#     topdown  删 []（差异全在提示/终止条件）
#     bottomup 删 [tool-goal, tool-ask-user]
#     brainstorm 删 [tool-bash, tool-pwsh, tool-fs-write, tool-goal, delegation]
#     lazy     删 [tool-ask-user]
# =====================================================================

设 方法缺省 为 "default"

段落 代理预设清单():
  设 表 为 ["standard", "ptc", "minimal", "cordis"]
  返回 表

段落 工作方法清单():
  设 表 为 ["default", "topdown", "bottomup", "brainstorm", "lazy"]
  返回 表

# 查找加号(串) -> 首个 "+" 的下标；没有返回 -1（不做 split，避免额外依赖）
段落 查找加号(串):
  设 i 为 0
  当 (i < 字符串长度(串)):
    如果 (串[i] == "+"):
      返回 i
    设 i 为 i + 1
  返回 -1

# 解析组合(标识) -> {"ok":真假, "代理":串, "方法":串, "错误":串}
#   不抛错：查询接口语义；上层要抛错时自己按 ok 组装文案。
段落 解析组合(标识):
  设 失败 为 {"ok": 假, "代理": "", "方法": "", "错误": "不是合法的组合标识"}
  如果 (是字符串(标识) == 假):
    返回 失败
  如果 (标识 == ""):
    设 空错 为 {"ok": 假, "代理": "", "方法": "", "错误": "组合标识为空"}
    返回 空错
  设 加位 为 查找加号(标识)
  如果 (加位 >= 0):
    设 左 为 截取(标识, 0, 加位)
    设 右 为 截取(标识, 加位 + 1, 字符串长度(标识))
    如果 (查找加号(右) >= 0):
      设 多错 为 {"ok": 假, "代理": "", "方法": "", "错误": "组合串只能有一个 +：" + 标识}
      返回 多错
    如果 (列表包含(代理预设清单(), 左) == 假):
      设 左错 为 {"ok": 假, "代理": "", "方法": "", "错误": "未知代理模式：" + 左}
      返回 左错
    如果 (列表包含(工作方法清单(), 右) == 假):
      设 右错 为 {"ok": 假, "代理": "", "方法": "", "错误": "未知工作方法：" + 右}
      返回 右错
    设 合 为 {"ok": 真, "代理": 左, "方法": 右, "错误": ""}
    返回 合
  如果 (列表包含(代理预设清单(), 标识) == 真):
    设 裸代 为 {"ok": 真, "代理": 标识, "方法": 方法缺省, "错误": ""}
    返回 裸代
  如果 (列表包含(工作方法清单(), 标识) == 真):
    设 裸法 为 {"ok": 真, "代理": "standard", "方法": 标识, "错误": ""}
    返回 裸法
  设 未错 为 {"ok": 假, "代理": "", "方法": "", "错误": "未知预设：" + 标识}
  返回 未错

# 组合串(代理, 方法) -> "代理+方法"；任一维非法返回空串
段落 组合串(代理, 方法):
  如果 (列表包含(代理预设清单(), 代理) == 假):
    返回 ""
  如果 (列表包含(工作方法清单(), 方法) == 假):
    返回 ""
  返回 代理 + "+" + 方法

# 方法删减(方法) -> 顶层行 id 列表（只删不增；未知方法返回空表）
段落 方法删减(方法):
  如果 (方法 == "default"):
    设 空删 为 []
    返回 空删
  如果 (方法 == "topdown"):
    设 上删 为 []
    返回 上删
  如果 (方法 == "bottomup"):
    设 下删 为 ["tool-goal", "tool-ask-user"]
    返回 下删
  如果 (方法 == "brainstorm"):
    设 脑删 为 ["tool-bash", "tool-pwsh", "tool-fs-write", "tool-goal", "delegation"]
    返回 脑删
  如果 (方法 == "lazy"):
    设 懒删 为 ["tool-ask-user"]
    返回 懒删
  设 无删 为 []
  返回 无删

段落 代理行表(代理):
  如果 (代理 == "standard"):
    返回 标准组合行表()
  如果 (代理 == "ptc"):
    返回 编码组合行表()
  如果 (代理 == "minimal"):
    返回 极简组合行表()
  如果 (代理 == "cordis"):
    返回 组装组合行表()
  设 空表 为 []
  返回 空表

# 组合行表(代理, 方法) -> 插件行表（代理行表 − 方法删减）
段落 组合行表(代理, 方法):
  设 基 为 代理行表(代理)
  如果 (是列表(基) == 假):
    设 空基 为 []
    返回 空基
  如果 (长度(基) == 0):
    设 空行 为 []
    返回 空行
  设 删 为 方法删减(方法)
  设 空增 为 []
  返回 增删组合行(基, 删, 空增)

# 组合矩阵() -> 4×5=20 个组合串（代理为外循环，方法序 = 工作方法清单）
段落 组合矩阵():
  设 结果 为 []
  遍历 代理 之 代理预设清单():
    遍历 方法 之 工作方法清单():
      列表追加(结果, 组合串(代理, 方法))
  返回 结果

# =====================================================================
# §3 组合清单：每预设一条 {order, 类别, 插件行表}
#
#   T-0439 分层：8 个预设原本平铺成一条 order 1..8 的线，混了两类东西。
#   现在每个条目显式带 `类别`，取值只有两种：
#     agent  —— Agent 模式：对齐 DSH web-app 的四份 patch.yml，差异在「挂哪些工具」；
#     method —— 工作方法：对齐 trae agent 的 spec/plan/goal 一类工作流，
#               差异在「怎么推进」（控制流向 / 人机介入点 / 终止条件）。
#   类别只是**呈现与统计的维度**，不改变预设机制：会话里存的仍是一个预设 id，
#   切换仍是整份行表替换。故意不做「模式 × 方法」正交组合（那是 8×4 的组合面）。
# =====================================================================

# 类别常量（数据层唯一来源；设置页/ui 只读这里，不另抄一份清单）
设 类别代理 为 "agent"
设 类别方法 为 "method"

段落 组合清单():
  设 标准行 为 标准组合行表()
  设 编码行 为 编码组合行表()
  设 极简行 为 极简组合行表()
  设 组装行 为 组装组合行表()
  # 方法维的条目一律以 standard 为基底派生：这就是旧 8 预设视野（裸方法 id 的兼容语义）。
  设 默认行 为 组合行表("standard", "default")
  设 自上行 为 组合行表("standard", "topdown")
  设 自下行 为 组合行表("standard", "bottomup")
  设 头脑行 为 组合行表("standard", "brainstorm")
  设 懒人行 为 组合行表("standard", "lazy")
  设 标准条目 为 {"order": 1, "类别": 类别代理, "插件行表": 标准行}
  设 编码条目 为 {"order": 2, "类别": 类别代理, "插件行表": 编码行}
  设 极简条目 为 {"order": 3, "类别": 类别代理, "插件行表": 极简行}
  设 组装条目 为 {"order": 4, "类别": 类别代理, "插件行表": 组装行}
  # T-0441：default 是方法维第一条（order 5），其余 4 个方法顺延到 6-9。
  设 默认条目 为 {"order": 5, "类别": 类别方法, "插件行表": 默认行}
  设 自上条目 为 {"order": 6, "类别": 类别方法, "插件行表": 自上行}
  设 自下条目 为 {"order": 7, "类别": 类别方法, "插件行表": 自下行}
  设 头脑条目 为 {"order": 8, "类别": 类别方法, "插件行表": 头脑行}
  设 懒人条目 为 {"order": 9, "类别": 类别方法, "插件行表": 懒人行}
  返回 {"standard": 标准条目, "ptc": 编码条目, "minimal": 极简条目, "cordis": 组装条目, "default": 默认条目, "topdown": 自上条目, "bottomup": 自下条目, "brainstorm": 头脑条目, "lazy": 懒人条目}

# 预设清单(类别="")：由 组合清单 的键按 order 升序生成（不再写死字面量）。
#   后续再加模式只改 组合清单，这里与 是已知预设 自动跟随；
#   order 相同则保持 组合清单 的键插入序（Python 字典有序 + 稳定插入排序）。
#   T-0439：新增可选 `类别` 过滤。空串 = 全部（向后兼容，老调用点一个字都不用改）；
#   "agent" / "method" = 只列该类别；未知类别返回空列表（不抛错，查询接口语义）。
段落 预设清单(类别 = ""):
  设 清单 为 组合清单()
  设 键表 为 字典键列表(清单)
  设 序表 为 {}
  遍历 键 之 键表:
    字典设置(序表, 键, 清单[键]["order"])
  设 结果 为 []
  遍历 键 之 键表:
    列表追加(结果, 键)
    设 尾位 为 长度(结果) - 1
    设 继续移 为 真
    当 尾位 > 0 且 继续移 == 真:
      设 前位 为 尾位 - 1
      如果 序表[结果[前位]] > 序表[结果[尾位]]:
        设 暂存 为 结果[前位]
        设 结果[前位] 为 结果[尾位]
        设 结果[尾位] 为 暂存
        设 尾位 为 前位
      否则:
        设 继续移 为 假
  如果 (类别 == "" 或 类别 == 空):
    返回 结果
  设 筛选 为 []
  遍历 标识 之 结果:
    如果 (清单[标识]["类别"] == 类别):
      列表追加(筛选, 标识)
  返回 筛选

# 预设类别(标识) -> "agent" / "method"；未知预设返回空串（不抛错）
段落 预设类别(预设标识):
  如果 (是字符串(预设标识) == 假):
    返回 ""
  设 清单 为 组合清单()
  如果 (字典包含键(清单, 预设标识) == 假):
    返回 ""
  返回 清单[预设标识]["类别"]

段落 是代理模式(预设标识):
  返回 预设类别(预设标识) == 类别代理

段落 是工作方法(预设标识):
  返回 预设类别(预设标识) == 类别方法

# 预设分组() -> {"agent": [...按 order 升序], "method": [...]}
#   设置页下拉与前端下拉都从这一份派生，避免三处各抄一份清单再漂移。
段落 预设分组():
  设 代理组 为 预设清单(类别代理)
  设 方法组 为 预设清单(类别方法)
  返回 {"agent": 代理组, "method": 方法组}

# T-0441：已知预设 = 可被 解析组合 接受的任意标识
#   裸 8 个旧 id（兼容别名） + 20 个 "代理+方法" 组合串。
段落 是已知预设(预设标识):
  如果 是字符串(预设标识) == 假:
    返回 假
  返回 解析组合(预设标识)["ok"]

# =====================================================================
# §4 查询接口
# =====================================================================

# 组合(预设标识) → 插件行表；未知预设返回 空（不抛错，抛错语义留给上层 预设.造未知道错误）
#   T-0441：入参可以是裸旧 id、也可以是 "代理+方法" 组合串，统一先解析再建表。
段落 组合(预设标识):
  设 解 为 解析组合(预设标识)
  如果 (解["ok"] == 假):
    返回 空
  返回 组合行表(解["代理"], 解["方法"])

# 组合行数：行树递归计数（组行自身 1 行 + 其子行递归）
段落 组合行数(行表):
  设 计数 为 0
  遍历 行 之 行表:
    设 计数 为 计数 + 1
    如果 字典获取(行, "group", 假) == 真:
      设 子表 为 字典获取(行, "config", [])
      设 计数 为 计数 + 组合行数(子表)
  返回 计数

# 组合统计(预设标识) → {声明: 1, 插件行: n, 展平后: m}
#   声明行（preset-*）不在插件行表内，故不计入「插件行」；
#   展平后 = 声明 + 插件行（整棵行树的节点数）。未知预设三值全 0。
段落 组合统计(预设标识):
  设 行表 为 组合(预设标识)
  如果 行表 == 空:
    返回 {"声明": 0, "插件行": 0, "展平后": 0}
  设 插件行 为 组合行数(行表)
  返回 {"声明": 1, "插件行": 插件行, "展平后": 插件行 + 1}

# 预设序(预设标识) → order 常量；未知返回 0
段落 预设序(预设标识):
  如果 是已知预设(预设标识) == 假:
    返回 0
  返回 组合清单()[预设标识]["order"]

