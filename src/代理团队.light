# 代理团队.light —— 对标上游 packages/experimental/agent-team/src/（16 文件，a305303422）
# 多代理协作编排的纯逻辑面（对标 #93），与 subagent 域（单代理执行）互补。
#
# 上游结构映射（以上游真实代码为准）：
#   types.ts        -> 状态枚举与快照形状（任务 pending/in_progress/completed/deleted；
#                      成员阶段 provisioning/active/failed；成员状态 running/idle/inactive/provisioning/failed）
#   task-board.ts   -> 造任务事件 改任务事件（CAS 修订、九动作、授权、依赖校验、写域重叠警告）
#   task-graph.ts   -> 断言任务图 检测依赖环（自引用/重复/缺失/DFS 环；上游无显式拓扑排序）
#   roster.ts       -> 校验成员名（lower-kebab-case ≤64 非 lead）造成员事件 找活跃成员
#   mailbox.ts      -> 发消息事件 确认送达事件 未读数（pending = queued 减 delivered）
#   journal.ts      -> 事件溯源：4 类持久化事件（version 恒 2），折叠团队状态 纯投影
#   activity.ts     -> 近期活动（任务书补充：上游该文件实为变更等待器，见报告 §五）
#   lifecycle.ts    -> 断言团队转移 清理终止任务（任务书补充：上游该文件实为处置所有权，见报告 §五）
#   invariant.ts    -> 校验事件流（candidate 回放违反抛错）
#   validation.ts   -> 需要文本 归一写域（逐字文案）
#   error.ts        -> 错误码以文案承载（结构化 code 未复刻，登记）
#   session-message.ts -> 消息接受判定（user/message 命中或 inbox 折叠）
#   client.ts / persisted.ts / projection.ts -> 宿主面剔除（登记）
#
# 事件形状（version 2，事件溯源）：
#   ["种类", "团队标识", "版本": 2, "时间", "任务"/"成员"/"消息"/"消息标识"/"目标标识"]
# 状态全部由事件表折叠推导（纯函数）；状态变更段落只校验并构造新事件，落库由调用方承担。
# 分页（cursor/limit）与任务书点名的活动聚合/团队状态机为补充实现，报告登记。
# 绕法：内置裸名（L-090）、无 且/或 行内链（L-043）、标识符避关键字（L-084/L-092）、无花括号文案（L-089）。

导出 需要文本 归一写域 校验成员名 折叠团队状态 任务就绪 断言任务图 检测依赖环 判动作门槛 造任务事件 改任务事件 造成员事件 找活跃成员 发消息事件 确认送达事件 未读数 消息接受判定 校验事件流 任务分页 近期活动 断言团队转移 清理终止任务。

# ---------------- validation.ts ----------------
# requiredText（逐字）：trim 空抛 must be non-empty；超长抛 exceeds N characters
段落 需要文本 接收 值, 字段, 上限:
  如果 是字符串(值) == 假:
    抛出 新建 错误(字段 + " must be non-empty")
  如果 字符串长度(去除空白(值)) == 0:
    抛出 新建 错误(字段 + " must be non-empty")
  如果 字符串长度(值) > 上限:
    抛出 新建 错误(字段 + " exceeds " + 转字符串(上限) + " characters")
  返回 值

# writeScope 归一化（逐字规则）：反斜杠转斜杠、去 ./ 前缀、去尾斜杠；空//开头/盘符/空段/../ 非法
段落 归一写域 接收 值:
  设 域 为 替换字符串(值, "\\", "/")
  如果 开头(域, "./"):
    设 域 为 截取到末尾(域, 2)
  当 结尾(域, "/"):
    如果 字符串长度(域) > 1:
      设 域 为 截取(域, 0, 字符串长度(域) - 1)
    否则:
      跳出
  设 非法 为 假
  如果 字符串长度(域) == 0:
    设 非法 为 真
  如果 开头(域, "/"):
    设 非法 为 真
  # 盘符 ^[a-z]:/iu —— 前两字符为字母+冒号
  如果 字符串长度(域) >= 2:
    设 首码 为 码位(字符串获取(域, 0))
    设 是字母 为 假
    如果 首码 >= 65:
      如果 首码 <= 90:
        设 是字母 为 真
    如果 首码 >= 97:
      如果 首码 <= 122:
        设 是字母 为 真
    如果 是字母:
      如果 字符串获取(域, 1) == ":":
        设 非法 为 真
  # 逐段：空段 / . / .. 非法
  设 段表 为 分割字符串(域, "/")
  遍历 段 之 段表:
    如果 段 == "":
      设 非法 为 真
    如果 段 == ".":
      设 非法 为 真
    如果 段 == "..":
      设 非法 为 真
  如果 非法:
    抛出 新建 错误("invalid workspace-relative write scope " + 序列化JSON(值))
  返回 域

# ---------------- roster.ts：成员名 ----------------
# /^[a-z0-9]+(?:-[a-z0-9]+)*$/u 且 ≤64 且非 lead（逐字文案）
段落 校验成员名 接收 名字:
  设 合法 为 真
  设 长 为 字符串长度(名字)
  如果 长 < 1:
    设 合法 为 假
  如果 长 > 64:
    设 合法 为 假
  如果 名字 == "lead":
    设 合法 为 假
  如果 合法:
    设 序号 为 0
    设 前连 为 假
    当 序号 < 长:
      设 码 为 码位(字符串获取(名字, 序号))
      设 是小写 为 假
      如果 码 >= 97:
        如果 码 <= 122:
          设 是小写 为 真
      设 是数字 为 假
      如果 码 >= 48:
        如果 码 <= 57:
          设 是数字 为 真
      设 是连 为 假
      如果 码 == 45:
        设 是连 为 真
      如果 是小写:
        设 前连 为 假
      否则:
        如果 是数字:
          设 前连 为 假
        否则:
          如果 是连:
            如果 前连:
              设 合法 为 假
            设 前连 为 真
          否则:
            设 合法 为 假
      设 序号 为 序号 + 1
    # 首尾不得为连字符
    如果 是连形态(名字):
      设 合法 为 假
  如果 合法 == 假:
    抛出 新建 错误("teammate name must be lower-kebab-case, at most 64 characters, and not \"lead\"")
  返回 名字

# 首尾连字符判定（辅助）
段落 是连形态 接收 名字:
  如果 开头(名字, "-"):
    返回 真
  如果 结尾(名字, "-"):
    返回 真
  返回 假

# ---------------- journal.ts：事件折叠投影 ----------------
# 状态 = ["成员表","任务表","消息表","送达表","下个任务号"]；未知事件抛错（invariant 投影依据）
段落 折叠团队状态 接收 事件表:
  设 状态 为 {}
  设 成员表 为 {}
  设 任务表 为 {}
  设 消息表 为 []
  设 送达表 为 []
  设 下个任务号 为 1
  遍历 事件 之 事件表:
    设 种类 为 事件["种类"]
    如果 种类 == "team/task":
      设 任务 为 事件["任务"]
      设 任务表[任务["标识"]] 为 任务
      设 号 为 转整数(截取到末尾(任务["标识"], 5))
      如果 号 >= 下个任务号:
        设 下个任务号 为 号 + 1
    否则:
      如果 种类 == "team/member":
        设 成员 为 事件["成员"]
        设 成员表[成员["标识"]] 为 成员
      否则:
        如果 种类 == "team/message/queued":
          列表追加(消息表, 事件["消息"])
        否则:
          如果 种类 == "team/message/delivered":
            列表追加(送达表, 事件["消息标识"])
          否则:
            抛出 新建 错误("未知团队事件: " + 种类)
  状态["成员表"] 为 成员表
  状态["任务表"] 为 任务表
  状态["消息表"] 为 消息表
  状态["送达表"] 为 送达表
  状态["下个任务号"] 为 下个任务号
  返回 状态

# ---------------- task-board.ts：就绪判定 ----------------
# ready = blockedBy 全部 completed（上游可运行判定）
段落 任务就绪 接收 任务, 任务表:
  遍历 阻塞标识 之 任务["阻塞于"]:
    如果 字典包含键(任务表, 阻塞标识) == 假:
      返回 假
    如果 任务表[阻塞标识]["状态"] != "completed":
      返回 假
  返回 真

# ---------------- task-graph.ts：图断言 ----------------
# 逐任务（跳过 deleted）：自引用/重复 blocker/缺失或已删 blocker；随后 DFS 环检测
段落 断言任务图 接收 任务表:
  # 活动（非 deleted）任务表投影
  设 活动表 为 {}
  遍历 任务 之 字典值列表(任务表):
    如果 任务["状态"] != "deleted":
      设 活动表[任务["标识"]] 为 任务
  遍历 任务 之 字典值列表(活动表):
    设 已见 为 []
    遍历 阻塞标识 之 任务["阻塞于"]:
      如果 阻塞标识 == 任务["标识"]:
        抛出 新建 错误("team task \"" + 任务["标识"] + "\" cannot block itself")
      如果 列表包含(已见, 阻塞标识):
        抛出 新建 错误("team task \"" + 任务["标识"] + "\" repeats blocker \"" + 阻塞标识 + "\"")
      列表追加(已见, 阻塞标识)
      如果 字典包含键(任务表, 阻塞标识) == 假:
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" for \"" + 任务["标识"] + "\" is missing or deleted")
      如果 任务表[阻塞标识]["状态"] == "deleted":
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" for \"" + 任务["标识"] + "\" is missing or deleted")
  # DFS 环检测（访问中/已访双集）
  设 已访 为 []
  遍历 任务 之 字典值列表(活动表):
    设 访问中 为 []
    设 环 为 检测依赖环(任务表, 任务["标识"], 访问中, 已访)
    如果 环 != "":
      抛出 新建 错误("task dependency cycle includes \"" + 环 + "\"")
  返回 真

# DFS：返回环中任一标识或 ""（访问中回溯移除，防菱形误报）
段落 检测依赖环 接收 任务表, 标识, 访问中, 已访:
  如果 列表包含(已访, 标识):
    返回 ""
  如果 列表包含(访问中, 标识):
    返回 标识
  列表追加(访问中, 标识)
  如果 字典包含键(任务表, 标识):
    如果 任务表[标识]["状态"] != "deleted":
      遍历 阻塞标识 之 任务表[标识]["阻塞于"]:
        设 环 为 检测依赖环(任务表, 阻塞标识, 访问中, 已访)
        如果 环 != "":
          返回 环
  列表追加(已访, 标识)
  # 回溯：从 访问中 移除 标识（重建回写）
  设 保留 为 []
  遍历 已有 之 访问中:
    如果 已有 != 标识:
      列表追加(保留, 已有)
  当 列表长度(访问中) > 0:
    列表弹出(访问中)
  遍历 已有 之 保留:
    列表追加(访问中, 已有)
  返回 ""

# ---------------- task-board.ts：动作状态门槛 ----------------
# 返回错误文案或 ""（claim/reassign 的附加校验在 改任务事件 内）
段落 判动作门槛 接收 动作, 状态, 标识:
  # claim 的 pending+就绪门槛在 改任务事件 分支内（被占检查先于门槛，上游可达语义）
  如果 动作 == "release":
    如果 状态 != "in_progress":
      返回 "only an in-progress task can be released"
  如果 动作 == "complete":
    如果 状态 != "in_progress":
      返回 "only an in-progress task can complete"
  如果 动作 == "reopen":
    如果 状态 != "completed":
      返回 "only a completed task can reopen"
  如果 动作 == "reassign":
    如果 状态 != "pending":
      如果 状态 != "in_progress":
        返回 "only a pending or in-progress task can be reassigned"
  返回 ""

# ---------------- task-board.ts：create ----------------
段落 造任务事件 接收 事件表, 请求, 团队标识, 时间, 配置:
  设 状态 为 折叠团队状态(事件表)
  设 任务表 为 状态["任务表"]
  # 上限（非 deleted 计数）
  设 活动数 为 0
  遍历 任务 之 字典值列表(任务表):
    如果 任务["状态"] != "deleted":
      设 活动数 为 活动数 + 1
  设 任务上限 为 字典获取(配置, "任务上限", 256)
  如果 活动数 >= 任务上限:
    抛出 新建 错误("Team task limit " + 转字符串(任务上限) + " reached")
  设 标识 为 "task-" + 转字符串(状态["下个任务号"])
  如果 字典包含键(任务表, 标识):
    抛出 新建 错误("Team task id space exhausted")
  设 主题 为 需要文本(请求["主题"], "subject", 200)
  设 描述 为 需要文本(请求["描述"], "description", 16384)
  设 阻塞于 为 []
  如果 字典包含键(请求, "阻塞于"):
    遍历 阻塞标识 之 请求["阻塞于"]:
      如果 阻塞标识 == 标识:
        抛出 新建 错误("a team task cannot block itself")
      如果 列表包含(阻塞于, 阻塞标识):
        抛出 新建 错误("duplicate blocker \"" + 阻塞标识 + "\"")
      如果 字典包含键(任务表, 阻塞标识) == 假:
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" not found")
      如果 任务表[阻塞标识]["状态"] == "deleted":
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" not found")
      列表追加(阻塞于, 阻塞标识)
  设 写域 为 []
  如果 字典包含键(请求, "写域"):
    遍历 原域 之 请求["写域"]:
      列表追加(写域, 归一写域(原域))
  设 快照 为 {}
  快照["标识"] 为 标识
  快照["修订"] 为 1
  快照["主题"] 为 主题
  快照["描述"] 为 描述
  快照["状态"] 为 "pending"
  快照["归属"] 为 空
  快照["阻塞于"] 为 阻塞于
  快照["写域"] 为 写域
  # 图断言（候选=现有 + 新任务）
  设 候选表 为 {}
  遍历 任务 之 字典值列表(任务表):
    设 候选表[任务["标识"]] 为 任务
  设 候选表[标识] 为 快照
  断言任务图(候选表)
  设 事件 为 {}
  事件["种类"] 为 "team/task"
  事件["团队标识"] 为 团队标识
  事件["版本"] 为 2
  事件["时间"] 为 时间
  事件["任务"] 为 快照
  返回 ["事件": 事件, "快照": 快照]

# ---------------- task-board.ts：update（CAS + 九动作） ----------------
段落 改任务事件 接收 事件表, 请求, 调用者, 是领队, 团队标识, 时间, 配置:
  设 状态 为 折叠团队状态(事件表)
  设 任务表 为 状态["任务表"]
  设 成员表 为 状态["成员表"]
  设 标识 为 请求["标识"]
  如果 字典包含键(任务表, 标识) == 假:
    抛出 新建 错误("team task \"" + 标识 + "\" not found")
  设 任务 为 任务表[标识]
  如果 任务["状态"] == "deleted":
    抛出 新建 错误("team task \"" + 标识 + "\" is deleted")
  设 期望修订 为 请求["期望修订"]
  如果 期望修订 != 任务["修订"]:
    抛出 新建 错误("stale team task \"" + 标识 + "\" revision " + 转字符串(期望修订) + "; current revision is " + 转字符串(任务["修订"]))
  # 授权：owner 或 lead；claim 无主任务豁免（否则认领语义不可达）
  设 动作 为 请求["动作"]
  如果 是领队 == 假:
    如果 任务["归属"] != 调用者:
      # claim 动作整体豁免（任何人可尝试认领；他人已拥有由 claim 分支报错，上游可达语义）
      设 授权豁免 为 假
      如果 动作 == "claim":
        设 授权豁免 为 真
      如果 授权豁免 == 假:
        抛出 新建 错误("task mutation requires its owner or Team Lead")
  # 动作状态门槛（反跑 B 锚点段落 判动作门槛）
  设 门槛错 为 判动作门槛(动作, 任务["状态"], 标识)
  如果 门槛错 != "":
    抛出 新建 错误(门槛错)
  # 构造新快照（不可变更段拷贝）
  设 新任务 为 {}
  新任务["标识"] 为 任务["标识"]
  新任务["主题"] 为 任务["主题"]
  新任务["描述"] 为 任务["描述"]
  新任务["状态"] 为 任务["状态"]
  新任务["归属"] 为 任务["归属"]
  新任务["阻塞于"] 为 副本(任务["阻塞于"])
  新任务["写域"] 为 副本(任务["写域"])
  新任务["修订"] 为 任务["修订"] + 1
  # 动作语义
  如果 动作 == "claim":
    # 他人已拥有（先于门槛，上游可达语义）
    如果 任务["归属"] != 空:
      如果 任务["归属"] != 调用者:
        抛出 新建 错误("team task \"" + 标识 + "\" is owned by another member")
    # 须 pending 且 blocker 全 completed（合并文案）
    如果 任务["状态"] != "pending":
      抛出 新建 错误("team task \"" + 标识 + "\" is not ready to claim")
    如果 任务就绪(任务, 任务表) == 假:
      抛出 新建 错误("team task \"" + 标识 + "\" is not ready to claim")
    设 新任务["状态"] 为 "in_progress"
    设 新任务["归属"] 为 调用者
  如果 动作 == "release":
    设 新任务["状态"] 为 "pending"
    设 新任务["归属"] 为 空
  如果 动作 == "edit":
    设 有字段 为 假
    如果 字典包含键(请求, "主题"):
      设 新任务["主题"] 为 需要文本(请求["主题"], "subject", 200)
      设 有字段 为 真
    如果 字典包含键(请求, "描述"):
      设 新任务["描述"] 为 需要文本(请求["描述"], "description", 16384)
      设 有字段 为 真
    如果 字典包含键(请求, "写域"):
      设 新写域 为 []
      遍历 原域 之 请求["写域"]:
        列表追加(新写域, 归一写域(原域))
      设 新任务["写域"] 为 新写域
      设 有字段 为 真
    如果 有字段 == 假:
      抛出 新建 错误("task edit requires subject, description, or write_scopes")
  如果 动作 == "set_dependencies":
    如果 字典包含键(请求, "阻塞于") == 假:
      抛出 新建 错误("set_dependencies requires blocked_by")
    设 新阻塞 为 []
    遍历 阻塞标识 之 请求["阻塞于"]:
      如果 阻塞标识 == 标识:
        抛出 新建 错误("a team task cannot block itself")
      如果 列表包含(新阻塞, 阻塞标识):
        抛出 新建 错误("duplicate blocker \"" + 阻塞标识 + "\"")
      如果 字典包含键(任务表, 阻塞标识) == 假:
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" not found")
      如果 任务表[阻塞标识]["状态"] == "deleted":
        抛出 新建 错误("blocker task \"" + 阻塞标识 + "\" not found")
      列表追加(新阻塞, 阻塞标识)
    设 新任务["阻塞于"] 为 新阻塞
  如果 动作 == "complete":
    设 新任务["状态"] 为 "completed"
  如果 动作 == "reopen":
    设 新任务["状态"] 为 "pending"
    设 新任务["归属"] 为 空
  如果 动作 == "reassign":
    # 仅 lead（上游逐字）
    如果 是领队 == 假:
      抛出 新建 错误("only the Team Lead can reassign tasks")
    设 目标 为 字典获取(请求, "归属", 空)
    如果 目标 == 空:
      设 新任务["状态"] 为 "pending"
      设 新任务["归属"] 为 空
    否则:
      # 目标须 active
      如果 字典包含键(成员表, 目标) == 假:
        抛出 新建 错误("active teammate \"" + 目标 + "\" not found")
      如果 成员表[目标]["阶段"] != "active":
        抛出 新建 错误("active teammate \"" + 目标 + "\" not found")
      设 新任务["状态"] 为 "in_progress"
      设 新任务["归属"] 为 目标
  如果 动作 == "delete":
    # 依赖者检查：其他非 deleted 任务 blockedBy 含它
    遍历 其他 之 字典值列表(任务表):
      如果 其他["标识"] != 标识:
        如果 其他["状态"] != "deleted":
          如果 列表包含(其他["阻塞于"], 标识):
            抛出 新建 错误("team task \"" + 标识 + "\" still blocks \"" + 其他["标识"] + "\"")
    设 新任务["状态"] 为 "deleted"
  # 图断言（候选）
  设 候选表 为 {}
  遍历 任务快照 之 字典值列表(任务表):
    设 候选表[任务快照["标识"]] 为 任务快照
  设 候选表[标识] 为 新任务
  断言任务图(候选表)
  设 事件 为 {}
  事件["种类"] 为 "team/task"
  事件["团队标识"] 为 团队标识
  事件["版本"] 为 2
  事件["时间"] 为 时间
  事件["任务"] 为 新任务
  返回 ["事件": 事件, "快照": 新任务]

# ---------------- roster.ts：spawn ----------------
段落 造成员事件 接收 事件表, 请求, 调用者, 是领队, 团队标识, 时间, 配置:
  如果 是领队 == 假:
    抛出 新建 错误("only the Team Lead can create teammates")
  设 状态 为 折叠团队状态(事件表)
  设 成员表 为 状态["成员表"]
  设 名字 为 校验成员名(请求["名称"])
  # 重名
  遍历 成员 之 字典值列表(成员表):
    如果 成员["名称"] == 名字:
      抛出 新建 错误("teammate name \"" + 名字 + "\" was already used in this Team")
  设 成员上限 为 字典获取(配置, "成员上限", 8)
  如果 列表长度(字典键列表(成员表)) >= 成员上限:
    抛出 新建 错误("Team member limit " + 转字符串(成员上限) + " reached")
  设 快照 为 {}
  快照["标识"] 为 请求["标识"]
  快照["名称"] 为 名字
  快照["描述"] 为 请求["描述"]
  快照["提供方"] 为 请求["提供方"]
  快照["上下文"] 为 请求["上下文"]
  快照["阶段"] 为 "provisioning"
  设 事件 为 {}
  事件["种类"] 为 "team/member"
  事件["团队标识"] 为 团队标识
  事件["版本"] 为 2
  事件["时间"] 为 时间
  事件["成员"] 为 快照
  返回 ["事件": 事件, "快照": 快照]

# resolveActiveMember 投影：lead -> "lead"；否则按名称找 active 成员（返回标识或抛）
段落 找活跃成员 接收 事件表, 原名:
  设 名字 为 去除空白(原名)
  如果 名字 == "lead":
    返回 "lead"
  设 状态 为 折叠团队状态(事件表)
  遍历 成员 之 字典值列表(状态["成员表"]):
    如果 成员["名称"] == 名字:
      如果 成员["阶段"] == "active":
        返回 成员["标识"]
  抛出 新建 错误("active teammate \"" + 名字 + "\" not found")

# ---------------- mailbox.ts ----------------
段落 发消息事件 接收 事件表, 发送者标识, 发送者名, 请求, 已处置, 团队标识, 时间, 配置:
  如果 已处置:
    抛出 新建 错误("Agent Teams service is disposing")
  设 状态 为 折叠团队状态(事件表)
  设 成员表 为 状态["成员表"]
  设 目标标识 为 请求["目标标识"]
  # 不能自发
  如果 目标标识 == 发送者标识:
    抛出 新建 错误("a Team member cannot message itself")
  # 目标须 active 成员或 lead
  设 目标活跃 为 假
  如果 目标标识 == "lead":
    设 目标活跃 为 真
  如果 字典包含键(成员表, 目标标识):
    如果 成员表[目标标识]["阶段"] == "active":
      设 目标活跃 为 真
  如果 目标活跃 == 假:
    抛出 新建 错误("active teammate \"" + 目标标识 + "\" not found")
  # 邮箱满（pending 计数）
  设 待上限 为 字典获取(配置, "待投递上限", 64)
  设 待数 为 未读数(事件表, 目标标识)
  如果 待数 >= 待上限:
    抛出 新建 错误("teammate \"" + 目标标识 + "\" has " + 转字符串(待数) + " pending messages")
  # 字节上限（码点近似，行为差异登记）
  设 字节上限 为 字典获取(配置, "消息字节上限", 65536)
  设 内容 为 请求["内容"]
  设 帧文 为 "Team message " + 请求["标识"] + " from " + 发送者名 + ":"
  如果 字符串长度(帧文) + 字符串长度(内容) > 字节上限:
    抛出 新建 错误("team message exceeds " + 转字符串(字节上限) + " bytes")
  设 快照 为 {}
  快照["标识"] 为 请求["标识"]
  快照["发送者标识"] 为 发送者标识
  快照["发送者名"] 为 发送者名
  快照["目标标识"] 为 目标标识
  快照["内容"] 为 内容
  设 事件 为 {}
  事件["种类"] 为 "team/message/queued"
  事件["团队标识"] 为 团队标识
  事件["版本"] 为 2
  事件["时间"] 为 时间
  事件["消息"] 为 快照
  # 目标 active 即即时投递（accepted）；投递失败留队为 queued（宿主面）
  设 投递状态 为 "queued"
  如果 目标活跃:
    设 投递状态 为 "accepted"
  返回 ["事件": 事件, "状态": 投递状态, "快照": 快照]

# 确认送达（append team/message/delivered；反跑 C 锚点）
段落 确认送达事件 接收 事件表, 消息标识, 目标标识, 团队标识, 时间:
  设 事件 为 {}
  事件["种类"] 为 "team/message/delivered"
  事件["团队标识"] 为 团队标识
  事件["版本"] 为 2
  事件["时间"] 为 时间
  事件["消息标识"] 为 消息标识
  事件["目标标识"] 为 目标标识
  列表追加(事件表, 事件)
  返回 事件

# 未读计数：queued 且 未 delivered 的目标消息数
段落 未读数 接收 事件表, 目标标识:
  设 状态 为 折叠团队状态(事件表)
  设 计数 为 0
  遍历 消息 之 状态["消息表"]:
    如果 消息["目标标识"] == 目标标识:
      如果 列表包含(状态["送达表"], 消息["标识"]) == 假:
        设 计数 为 计数 + 1
  返回 计数

# ---------------- session-message.ts ----------------
# messageAccepted 投影：user/message 命中或 inbox 折叠后命中（纯形状：返回是否含接受痕迹）
段落 消息接受判定 接收 事件表, 消息标识:
  # 投影：team/message/delivered 出现该标识即接受（简化纯逻辑面）
  设 状态 为 折叠团队状态(事件表)
  返回 列表包含(状态["送达表"], 消息标识)

# ---------------- invariant.ts ----------------
段落 校验事件流 接收 事件表:
  设 序号 为 0
  遍历 事件 之 事件表:
    设 序号 为 序号 + 1
    设 前缀表 为 []
    设 内序 为 0
    遍历 前事件 之 事件表:
      设 内序 为 内序 + 1
      如果 内序 <= 序号:
        列表追加(前缀表, 前事件)
    设 失败 为 假
    设 消息 为 ""
    尝试:
      设 占 为 折叠团队状态(前缀表)
    捕获 错误 为 e:
      设 失败 为 真
      设 消息 为 转字符串(e)
    如果 失败:
      抛出 新建 错误("session event " + 转字符串(序号) + " violates the Agent Teams stream: " + 消息)
  返回 真

# ---------------- 分页（任务书补充，第11轮 team_task_list 同范式） ----------------
段落 任务分页 接收 任务表, 游标, 限量:
  如果 是整数(限量) == 假:
    抛出 新建 错误("limit must be a positive integer")
  如果 限量 < 1:
    抛出 新建 错误("limit must be a positive integer")
  设 起 为 游标
  如果 起 == 空:
    设 起 为 0
  # 非 deleted 任务按标识序
  设 标识表 为 排序文本表(字典键列表(任务表))
  设 页表 为 []
  设 序号 为 起
  当 序号 < 列表长度(标识表):
    如果 列表长度(页表) < 限量:
      设 任务 为 字典获取(任务表, 标识表[序号], 空)
      如果 任务["状态"] != "deleted":
        列表追加(页表, 任务)
    设 序号 为 序号 + 1
  设 下页 为 空
  如果 起 + 限量 < 列表长度(标识表):
    设 下页 为 起 + 限量
  返回 ["任务表": 页表, "下页游标": 下页]

# 文本升序选择排序（辅助）
段落 排序文本表 接收 名单:
  设 结果 为 []
  遍历 名字 之 名单:
    列表追加(结果, 名字)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最小 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 结果[内] < 结果[最小]:
        设 最小 为 内
      设 内 为 内 + 1
    如果 最小 != 外:
      设 临时 为 结果[外]
      设 结果[外] 为 结果[最小]
      设 结果[最小] 为 临时
    设 外 为 外 + 1
  返回 结果

# ---------------- 活动流（任务书补充：最近 N 条、时间倒序、连续同类型聚合） ----------------
段落 近期活动 接收 事件表, 条数:
  # 事件按时间倒序取最近 条数 条，再对连续同种类聚合
  设 倒表 为 排序事件表(事件表)
  设 截表 为 []
  设 序号 为 0
  当 序号 < 条数:
    如果 序号 < 列表长度(倒表):
      列表追加(截表, 倒表[序号])
    设 序号 为 序号 + 1
  # 聚合：连续同种类合并计数
  设 活动表 为 []
  遍历 事件 之 截表:
    如果 列表长度(活动表) > 0:
      设 末项 为 活动表[列表长度(活动表) - 1]
      如果 末项["种类"] == 事件["种类"]:
        设 末项["次数"] 为 末项["次数"] + 1
        # 倒序遍历下组内首个时间即最近时间，不回退更新
      否则:
        列表追加(活动表, ["种类": 事件["种类"], "次数": 1, "最近时间": 事件["时间"]])
    否则:
      列表追加(活动表, ["种类": 事件["种类"], "次数": 1, "最近时间": 事件["时间"]])
  返回 活动表

# 事件按时间倒序选择排序（返回新表；同时间保持稳定序）
段落 排序事件表 接收 事件表:
  设 结果 为 []
  遍历 事件 之 事件表:
    列表追加(结果, 事件)
  设 总数 为 列表长度(结果)
  设 外 为 0
  当 外 < 总数:
    设 最大 为 外
    设 内 为 外 + 1
    当 内 < 总数:
      如果 结果[内]["时间"] > 结果[最大]["时间"]:
        设 最大 为 内
      设 内 为 内 + 1
    如果 最大 != 外:
      设 临时事件 为 结果[外]
      设 结果[外] 为 结果[最大]
      设 结果[最大] 为 临时事件
    设 外 为 外 + 1
  返回 结果

# ---------------- 生命周期（任务书补充：团队状态机 + 终止清理） ----------------
# 状态集：活跃/暂停/已终止；合法转移：活跃->暂停、暂停->活跃、活跃/暂停->已终止
段落 断言团队转移 接收 当前, 目标:
  设 合法 为 假
  如果 当前 == "活跃":
    如果 目标 == "暂停":
      设 合法 为 真
    如果 目标 == "已终止":
      设 合法 为 真
  如果 当前 == "暂停":
    如果 目标 == "活跃":
      设 合法 为 真
    如果 目标 == "已终止":
      设 合法 为 真
  如果 合法 == 假:
    抛出 新建 错误("invalid team transition: " + 当前 + " -> " + 目标)
  返回 目标

# 终止清理：in_progress 任务标记 deleted（墓碑；任务书 cancelled 文案差异登记）
段落 清理终止任务 接收 任务表:
  设 清理表 为 {}
  遍历 任务 之 字典值列表(任务表):
    设 新任务 为 副本(任务)
    如果 新任务["状态"] == "in_progress":
      设 新任务["状态"] 为 "deleted"
      设 新任务["修订"] 为 新任务["修订"] + 1
    设 清理表[新任务["标识"]] 为 新任务
  返回 清理表
