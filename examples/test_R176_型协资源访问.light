# test_R176_型协资源访问.light —— B4 路 typert principal/资源访问/资源声明登记 判据
# 上游锚点：packages/typert/{protocol/src/principal.ts, protocol/src/remote-access.ts,
#            protocol/src/types.ts 增量, registry/src/service.ts ResourceStore} @ dsh-v0.2.1-rc.3
# 反跑判据：把任一 断言相等 期望值改反，或把 型协登记资源 的 global 保留分支删掉即红。

从 型协资源访问 导入 型协主体, 型协全局资源, 型协资源, 型协是资源, 型协校验段名, 型协校验线名, 型协造资源册, 型协登记资源, 型协注销资源, 型协资源条目, 型协资源字段, 型协事件资源, 型协需访问决策, 型协可转发

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 主:
  # ---------- §1 主体 ----------
  设 owner调用 为 {"peer": {"principal": {"kind": "owner"}}}
  断言相等(型协主体(owner调用), 空, "§1 owner 不记主体")

  设 插件调用 为 {"peer": {"principal": {"kind": "plugin", "name": "x"}}}
  设 主1 为 型协主体(插件调用)
  断言相等(主1["kind"], "plugin", "§1b 非 owner 返回主体")
  断言相等(主1["name"], "x", "§1c 主体字段原样带回")

  断言相等(型协主体(空), 空, "§1d 无调用 → 空")
  断言相等(型协主体({"peer": {}}), 空, "§1e 无 principal → 空")

  # ---------- §2 资源标识 ----------
  设 全 为 型协全局资源()
  断言相等(全["kind"], "global", "§2 global 种类")
  断言真(型协是资源(全), "§2b global 是合法资源")
  设 资 为 型协资源("会话", "s1")
  断言相等(资["id"], "s1", "§2c 带身份资源")
  断言真(型协是资源(资), "§2d 带身份资源合法")
  断言相等(型协是资源({"kind": "会话"}), 假, "§2e 非 global 缺身份 → 非法")
  断言相等(型协是资源({"id": "s1"}), 假, "§2f 缺种类 → 非法")
  断言相等(型协是资源(空), 假, "§2g 空 → 非法")

  # ---------- §3 段名/线名校验 ----------
  断言相等(型协校验段名("会话"), "", "§3 合法段名")
  断言相等(型协校验段名(""), "typert: invalid resource kind \"\" — must be nonempty and must not contain \"#\"", "§3b 空段名文案")
  断言相等(型协校验段名("a#b"), "typert: invalid resource kind \"a#b\" — must be nonempty and must not contain \"#\"", "§3c 含 # 段名文案")

  断言相等(型协校验线名("sessionId"), "", "§3d 合法线名")
  断言相等(型协校验线名("a_b-c.d$1"), "", "§3e 线名允许 _ $ . - 与数字")
  断言相等(型协校验线名(".."), "typert: invalid resource field \"..\" — must contain only RPC endpoint segment characters", "§3f .. 非法")
  断言相等(型协校验线名("a b"), "typert: invalid resource field \"a b\" — must contain only RPC endpoint segment characters", "§3g 空格非法")

  # ---------- §4 资源声明登记 ----------
  设 册 为 型协造资源册()
  设 r1 为 型协登记资源(册, "会话", "sessionId")
  断言真(r1["登记"], "§4 首次登记成功")
  断言相等(型协资源字段(册, "会话"), "sessionId", "§4b 字段可查")

  设 r2 为 型协登记资源(册, "global", "x")
  断言相等(r2["登记"], 假, "§4c global 保留不可登记")
  断言相等(r2["错误"], "typert: resource kind \"global\" is reserved for the built-in global resource", "§4c 保留文案逐字对齐")

  设 r3 为 型协登记资源(册, "会话", "other")
  断言相等(r3["登记"], 假, "§4d 重复种类拒绝")
  断言相等(r3["错误"], "typert: resource kind \"会话\" is already registered", "§4d 重复文案")
  断言相等(型协资源字段(册, "会话"), "sessionId", "§4e 重复失败不改原字段")

  设 r4 为 型协登记资源(册, "任务", "bad name")
  断言相等(r4["登记"], 假, "§4f 非法线名拒绝")
  断言相等(型协资源字段(册, "任务"), 空, "§4g 非法线名不落表")

  设 r5 为 型协登记资源(册, "", "f")
  断言相等(r5["登记"], 假, "§4h 空段名拒绝")

  设 r6 为 型协登记资源(册, "任务", "jobId")
  断言真(r6["登记"], "§4i 第二种类登记成功")
  设 条目 为 型协资源条目(册)
  断言相等(长度(条目), 2, "§4j 条目数")
  断言相等(条目[0]["kind"], "会话", "§4k 插入序第 1")
  断言相等(条目[1]["field"], "jobId", "§4l 插入序第 2 的字段")
  设 变更 为 册["变更"]
  断言相等(长度(变更), 2, "§4m 两次成功登记各一条变更")
  断言相等(变更[1]["key"], "任务", "§4n 变更事件带 key")

  断言真(型协注销资源(册, "会话"), "§4o 注销已存在种类")
  断言相等(型协资源字段(册, "会话"), 空, "§4p 注销后查不到")
  断言相等(型协注销资源(册, "会话"), 假, "§4q 重复注销为假")
  断言相等(型协资源条目(册)[0]["kind"], "任务", "§4r 注销后剩余条目保持序")

  # ---------- §5 事件资源投影 ----------
  设 无声明 为 {"event": "x", "mode": "emit"}
  设 投0 为 型协事件资源(无声明, {})
  断言相等(长度(投0), 1, "§5 无 resources 声明 → 一个资源")
  断言相等(投0[0]["kind"], "global", "§5b 无声明落到 global")

  设 有声明 为 {"event": "y", "mode": "emit", "resources": {"会话": 1, "任务": 1}}
  设 已读 为 {"会话": "s1", "任务": ["j1", "j2"]}
  设 投1 为 型协事件资源(有声明, 已读)
  断言相等(长度(投1), 3, "§5c 单身份 + 身份表展开共 3 条")
  断言相等(投1[0]["id"], "s1", "§5d 首条身份")
  断言相等(投1[2]["id"], "j2", "§5e 身份表按序展开")

  设 已读缺 为 {"会话": "s1"}
  设 投2 为 型协事件资源(有声明, 已读缺)
  断言相等(长度(投2), 1, "§5f 未读到的种类不出现（上游 undefined 语义）")

  # ---------- §6 访问决策边界 ----------
  设 emit条 为 {"event": "y", "mode": "emit"}
  设 wf条 为 {"event": "z", "mode": "waterfall"}
  断言真(型协需访问决策(emit条, 主1), "§6 非 owner + emit 需决策")
  断言相等(型协需访问决策(emit条, 空), 假, "§6b owner 不需决策")
  断言相等(型协需访问决策(wf条, 主1), 假, "§6c waterfall 不走 emit 决策路径")

  设 可1 为 型协可转发(emit条, 主1)
  断言真(可1["可转发"], "§6d emit 可转发给非 owner")
  设 可2 为 型协可转发(wf条, 主1)
  断言相等(可2["可转发"], 假, "§6e waterfall 永不转发非 owner")
  断言相等(可2["原因"], "typert: waterfall events are never forwarded to a non-owner peer", "§6e 原因文案")
  设 可3 为 型协可转发({"event": "q", "mode": "notify"}, 主1)
  断言相等(可3["可转发"], 假, "§6f 非法模式拒绝")

  打印("test_R176_型协资源访问: 全部用例通过")

主()
