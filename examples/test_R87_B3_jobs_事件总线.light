从 任务事件总线 导入 造订阅, 任务总线
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 记录器(表, 标签):
  段落 收(报文):
    表.追加(标签 + ":" + 报文["type"])
  返回 收

段落 炸器(表):
  段落 收(报文):
    表.追加("炸")
    抛出 新建 错误("监听器故意炸")
  返回 收

段落 主程:
  # 1. {owners:'all'} 全域收一切
  设 总线 为 新建 任务总线()
  设 日志 为 []
  设 取消1 为 总线.订阅(空, ["owners": "all"], 记录器(日志, "全部"))
  总线.分发(["type": "registered", "id": "bash-1"], "s1", [])
  总线.分发(["type": "output", "id": "bash-1"], "s1", [])
  断言相等(列表长度(日志), 2, "all 订阅收两条")

  # 2. {owner:'s1'} 只收归属 s1 的报文；无主报文也可达（上游 ownerId===undefined 不跳过）
  设 取消2 为 总线.订阅(空, ["owner": "s1"], 记录器(日志, "s1专属"))
  总线.分发(["type": "registered", "id": "bash-2"], "s1", [])
  总线.分发(["type": "registered", "id": "bash-3"], "s2", [])
  总线.分发(["type": "registered", "id": "bash-4"], 空, [])
  断言相等(列表长度(日志), 7, "前 5 条分发累计 7 条")
  断言相等(日志[2], "全部:registered", "bash-2 all")
  断言相等(日志[3], "s1专属:registered", "bash-2 s1专属")
  断言相等(日志[4], "全部:registered", "bash-3 all")
  断言相等(日志[5], "全部:registered", "bash-4 all（无主）")
  断言相等(日志[6], "s1专属:registered", "bash-4 无主报文也达 owner 订阅")

  # 3. {owners:'scope'} 从无作用域上下文注册 → 全局层，收一切
  设 取消3 为 总线.订阅(空, ["owners": "scope"], 记录器(日志, "全局scope"))
  总线.分发(["type": "settled", "id": "bash-1"], "s2", [])
  断言相等(日志[列表长度(日志)-1], "全局scope:settled", "全局 scope 层收任意 owner")

  # 4. {owners:'scope'} 作用域 A 注册；只有链上含 A 的 owner 可达
  设 取消4 为 总线.订阅("作用域A", ["owners": "scope"], 记录器(日志, "A层"))
  # owner 的链含 A → 送达 A 层
  总线.分发(["type": "progress", "id": "bash-1"], "s1", ["作用域A"])
  断言相等(日志[列表长度(日志)-1], "A层:progress", "链含 A → 送达 A 层")
  # owner 的链不含 A → 不送达 A 层（但 all 与全局 scope 仍收）
  设 标记前 为 列表长度(日志)
  总线.分发(["type": "progress", "id": "bash-2"], "s2", ["作用域B"])
  设 新增 为 列表长度(日志) - 标记前
  断言相等(新增, 2, "链不含 A → A 层不送达（all+全局scope 各一条）")

  # 5. 监听器抛错 containment：告警沉降，后续监听器与后续分发不击穿
  设 炸日志 为 []
  设 取消5 为 总线.订阅(空, ["owners": "all"], 炸器(炸日志))
  总线.分发(["type": "output", "id": "x"], "s9", [])
  断言相等(列表长度(总线.告警列表()), 1, "炸器异常沉降为一条告警")
  总线.分发(["type": "output", "id": "y"], "s9", [])
  断言相等(列表长度(总线.告警列表()), 2, "炸器不击穿后续分发")

  # 6. 注销生效
  断言相等(总线.存活计数(), 5, "注销前 5 条订阅")
  取消1()
  取消2()
  取消3()
  取消4()
  取消5()
  断言相等(总线.存活计数(), 0, "全部注销后 0 条")

  写 "test_R87_B3_jobs_事件总线: 全部用例通过"

主程()
