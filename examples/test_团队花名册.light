  设 场景["请求"] 为 造请求("third", "d", "spawn", "fresh", 造牌())
  检查抛码("超上限", "TEAM_MEMBER_LIMIT", 跑派生)
  断言相等(列表长度(能取局面(根)["成员表"]), 2, "上限内两名")
  返回 真

