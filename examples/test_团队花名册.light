# =====================================================================
# F. 花名册 spawn
# =====================================================================
段落 用例_派生正常:
  设 清 为 清世界()
  设 册 为 造册(4)
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 局 为 建队(根标识)
  设 请 为 造请求("worker", "worker responsibility", "spawn", "fresh", 造牌())
  设 回 为 派生(根, 请)
  断言相等(回["成员"]["名字"], "worker", "派生结果名字")
  断言相等(回["成员"]["角色"], "teammate", "派生结果角色")
  断言相等(列表长度(世界["追加日志"]), 2, "筹备 + 活跃两条边")
  断言相等(世界["追加日志"][0]["data"]["member"]["phase"], "provisioning", "首条筹备边")
  断言相等(世界["追加日志"][1]["data"]["member"]["phase"], "active", "次条活跃边")
  断言相等(列表长度(世界["派生日志"]), 1, "派生成员被调用一次")
  设 局2 为 能取局面(根)
  断言相等(局2["成员表"]["child-1"]["phase"], "active", "折叠后为活跃")
  返回 真

