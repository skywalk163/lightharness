# test_团队花名light —— 对标 #68：成员花名册 + 团队生命周期 + 变更等待者
# 原版：packages/experimental/agent-team/src/{roster.ts, lifecycle.ts, activity.ts}
#   用例对齐 tests/team.spec.ts「Team identity and provisioning」+「Team mailbox and waiting」
#   中的 wait / dispose / settle 段落。
#
# 反跑判据（改反必须红）：
#   1) 成员切换错 —— 用例「反跑_成员切换」断言 roster 子体判为 成员、非 roster 子体判为 队长；
#      若 试隶属 的成员分支被改成一律返回队长即红。
#   2) 生命周期不收束 —— 用例「反跑_不收束」断言已弃置时 TEAM_DISPOSED 拒绝被过滤；
#      若 判取消 恒真/恒假即红。
#   3) 超时窗口越界不抛 —— 用例「反跑_窗口」断言 3600001 / 9999 必抛 TEAM_INVALID_TIMEOUT；
#      若 判时间窗 去掉上/下限判断即红。
#   4) wait 被无关唤醒 —— 用例「反跑_无关唤醒」断言被【别队】唤醒不算命中（返回 超时=真）；
#      若 等候 把「结局==唤醒」当命中即红。
#
# 语言坑规避：
#   - `新建 错误(...)` 只能作 抛出 的直接操作数（L-056），故错误值是字典、抛出点现造。
#   - 捕获变量不用「捕获」开头（捕获甲 会被切词），统一 异常对象。
#   - 写 只吃字面量串（L-055），本文件诊断全部走 抛出 新建 错误。
#   - 断言降级 no-op（L-037），一律 断言相等 / 检查抛码 / 检查消息。
#   - 字面量单行（L-051）；嵌套字面量内不写 \n（L-054）。
#   - 无闭包：抛错场景走「场景字典 + 具名零参段落」的槽位模式。

从 团队花名册 导入 装能力, 设裁决能力, 造册, 造生命, 造器, 解析活跃成员, 造团队错, 团队错文本, 抛团队错, 取错码, 取错文, 造牌, 中止牌, 抛牌因, 切片, 副本, 判成员名, 规整文本, 折子体描述, 判时间窗, 判来源用户, 造结算, 全结算, 永不超时, 默认裁决, 变动数, 关闭变动器, 唤醒, 等候, 移除等待者, 登记, 已关闭, 已弃置, 原因, 令牌, 时限, 中断, 恢复, 关闭, 活体分队, 局面, 隶属地, 列成员, 判取消, 试隶属, 收束, 限时, 派生
从 团队折叠 导入 空折叠状态, 套用记录
从 内置核心转换 导入 转字符串
从 内置核心字典 导入 字典删除

# =====================================================================
# 常量
# =====================================================================
设 根标识 为 "team-root"
设 子标识 为 "child-1"
设 副标识 为 "child-2"

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)

段落 检查抛码 接收 标签, 码, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, "[" + 码 + "]") == 假):
    抛出 新建 错误("错误码不符[" + 标签 + "]：实际=" + 文 + " 期望码=" + 码)

段落 检查消息 接收 标签, 片段, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 片段) == 假):
    抛出 新建 错误("消息不符[" + 标签 + "]：实际=" + 文 + " 应含=" + 片段)

# =====================================================================
# 世界：入参能力的共享可变状态（宿主投影）
# =====================================================================
设 世界 为 {}
设 场景 为 {}

段落 清世界:
  设 占 为 装全部能力()
  设 世界["代理表"] 为 {}
  设 世界["局面表"] 为 {}
  设 世界["追加日志"] 为 []
  设 世界["派生日志"] 为 []
  设 世界["派生抛"] 为 空
  设 世界["落盘抛"] 为 空
  设 世界["恢复表"] 为 {}
  设 世界["恢复抛"] 为 空
  设 世界["计时判定"] 为 假
  设 世界["裁决"] 为 默认裁决
  设 世界["标识序"] 为 0
  设 世界["中断日志"] 为 []
  设 世界["排空日志"] 为 []
  设 世界["局面抛"] 为 空
  设 世界["追加回值"] 为 真
  设 世界["落盘抢占"] 为 假
  设 世界["末根"] 为 空
  返回 真

# ---- 能力函数（全部读 世界）----
段落 能查代理 接收 标识:
  如果 (字典包含键(世界["代理表"], 标识) == 假): 返回 空
  返回 世界["代理表"][标识]

段落 能列代理:
  设 结果 为 []
  遍历 键 之 字典键列表(世界["代理表"]):
    列表追加(结果, 世界["代理表"][键])
  返回 结果

段落 能取局面 接收 根:
  如果 (世界["局面抛"] != 空):
    抛出 新建 错误(世界["局面抛"])
  如果 (字典包含键(世界["局面表"], 根["标识"]) == 假):
    设 表 为 世界["局面表"]
    表[根["标识"]] 为 空折叠状态(根["标识"])
    设 世界["局面表"] 为 表
  设 世界["末根"] 为 根
  返回 世界["局面表"][根["标识"]]

# 追加记录：真正走 #67 的 套用记录，让 #67/#68 交叉校验
段落 能追加记录 接收 根, 种类, 数据:
  设 记 为 {}
  记["type"] 为 种类
  记["data"] 为 数据
  列表追加(世界["追加日志"], 记)
  如果 (世界["追加回值"] == 假): 返回 真
  设 局 为 能取局面(根)
  设 占位 为 套用记录(局, 记)
  返回 真

段落 能造标识:
  设 世界["标识序"] 为 世界["标识序"] + 1
  返回 "child-" + 转字符串(世界["标识序"])

段落 能派生成员 接收 参:
  如果 (世界["派生抛"] != 空):
    抛出 新建 错误(世界["派生抛"])
  列表追加(世界["派生日志"], 参["子标识"])
  设 回 为 {}
  回["标识"] 为 参["子标识"]
  回["messageId"] 为 "msg-1"
  返回 回

# 落盘能力：可注入「并发协调抢先把该成员收束为 failed」，用于复现 settle 竞态
段落 能落盘首轮提示 接收 子标识, 消息号, 牌:
  如果 (世界["落盘抛"] != 空):
    抛出 新建 错误(世界["落盘抛"])
  如果 (世界["落盘抢占"] == 真):
    设 根 为 世界["末根"]
    设 局 为 能取局面(根)
    设 当 为 副本(局["成员表"][子标识])
    当["phase"] 为 "failed"
    当["error"] 为 "reconciled as failed"
    设 数 为 {}
    数["version"] 为 1
    数["teamId"] 为 局["id"]
    数["member"] 为 当
    设 记 为 {}
    记["type"] 为 "team/member"
    记["data"] 为 数
    设 占 为 套用记录(局, 记)
  返回 真

段落 能恢复会话 接收 子标识:
  如果 (世界["恢复抛"] != 空):
    抛出 新建 错误(世界["恢复抛"])
  如果 (字典包含键(世界["恢复表"], 子标识) == 假):
    抛出 新建 错误("no persisted child Session")
  返回 世界["恢复表"][子标识]

段落 能中断子体 接收 子标识, 调用者:
  列表追加(世界["中断日志"], 子标识)
  返回 真

段落 能排空子体 接收 根, 子清单:
  列表追加(世界["排空日志"], 子清单)
  返回 真

段落 能计时器 接收 时限毫秒:
  返回 世界["计时判定"]

# ---- 裁决实现（决定 wait 的三选一停驻点结局）----
段落 裁决_唤醒本队 接收 器, 队标识, 时限毫秒, 牌:
  设 占 为 唤醒(队标识)
  返回 "唤醒"

段落 裁决_唤醒别队 接收 器, 队标识, 时限毫秒, 牌:
  设 占 为 唤醒("other-team")
  返回 "唤醒"

段落 裁决_超时 接收 器, 队标识, 时限毫秒, 牌:
  返回 "超时"

段落 裁决_中止 接收 器, 队标识, 时限毫秒, 牌:
  返回 "中止"

段落 裁决_静默 接收 器, 队标识, 时限毫秒, 牌:
  返回 "唤醒"

段落 裁决_关停 接收 器, 队标识, 时限毫秒, 牌:
  设 占 为 关闭变动器()
  返回 "唤醒"

# =====================================================================
# 构造助手
# =====================================================================
段落 造代理 接收 标识, 键, 父会话, 态, 型:
  设 代 为 {}
  代["标识"] 为 标识
  代["键"] 为 键
  代["父会话"] 为 父会话
  代["态"] 为 态
  代["模型"] 为 型
  代["后缀"] 为 []
  返回 代

段落 放代理 接收 代理:
  设 表 为 世界["代理表"]
  表[代理["标识"]] 为 代理
  设 世界["代理表"] 为 表
  返回 代理

段落 建队 接收 标识:
  设 表 为 世界["局面表"]
  表[标识] 为 空折叠状态(标识)
  设 世界["局面表"] 为 表
  返回 世界["局面表"][标识]

# 直落一条 team/member 边（走 #67 套用记录，故须遵守「首条必 provisioning」的折叠约束）
段落 落成员边 接收 根, 成员:
  设 数 为 {}
  数["version"] 为 1
  数["teamId"] 为 根["标识"]
  数["member"] 为 成员
  设 记 为 {}
  记["type"] 为 "team/member"
  记["data"] 为 数
  设 局 为 能取局面(根)
  设 占位 为 套用记录(局, 记)
  返回 真

# 夹具：把成员收束到目标相位（首落必 provisioning，符合事件溯源约束）
#   已存在则只补终态边；夹具落边不计入可观测的 追加日志
段落 放成员 接收 根, 成员:
  设 局 为 能取局面(根)
  如果 (字典包含键(局["成员表"], 成员["id"]) == 假):
    设 起 为 副本(成员)
    起["phase"] 为 "provisioning"
    设 占位 为 落成员边(根, 起)
  设 局二 为 能取局面(根)
  设 当 为 局二["成员表"][成员["id"]]
  如果 (当["phase"] == "provisioning"):
    如果 (成员["phase"] != "provisioning"):
      设 占位 为 落成员边(根, 成员)
  设 世界["追加日志"] 为 []
  返回 真

段落 造成员 接收 标识, 名字, 相位:
  设 成 为 {}
  成["id"] 为 标识
  成["name"] 为 名字
  成["description"] 为 名字 + " responsibility"
  成["provider"] 为 "spawn"
  成["context"] 为 "fresh"
  成["phase"] 为 相位
  返回 成

段落 造请求 接收 名字, 描述, 提供者, 上下文, 牌:
  设 请 为 {}
  请["名字"] 为 名字
  请["描述"] 为 描述
  请["提示"] 为 [{"type": "text", "text": "go"}]
  请["上下文"] 为 上下文
  请["提供者"] 为 提供者
  请["令牌"] 为 牌
  返回 请

# 装全部能力：把 12 项测试能力以裸名参数注入模块全局（L-057：顶层段落 + 全局裸名调用）
段落 裁决走世界 接收 器, 队标识, 时限毫秒, 牌:
  返回 世界["裁决"](器, 队标识, 时限毫秒, 牌)

段落 装全部能力:
  设 占 为 装能力(能查代理, 能列代理, 能取局面, 能追加记录, 能造标识, 能派生成员, 能落盘首轮提示, 能恢复会话, 能中断子体, 能排空子体, 能计时器, 裁决走世界)
  返回 真
  设 占 为 装能力(能查代理, 能列代理, 能取局面, 能追加记录, 能造标识, 能派生成员, 能落盘首轮提示, 能恢复会话, 能中断子体, 能排空子体, 能计时器, 默认裁决)
  返回 真

段落 放恢复 接收 子标识, 父会话, 模式, 提供者, 种子长, 记录列表:
  设 元 为 {}
  元["parentSession"] 为 父会话
  元["seedLength"] 为 种子长
  设 载 为 {}
  载["元"] 为 元
  载["事件"] 为 记录列表
  设 表 为 世界["恢复表"]
  表[子标识] 为 载
  设 世界["恢复表"] 为 表
  返回 载

段落 造子体后缀 接收 模式, 提供者:
  设 记录列表 为 []
  设 描 为 {}
  描["type"] 为 "subagent/descriptor"
  设 描数 为 {}
  描数["mode"] 为 模式
  描数["provider"] 为 提供者
  描["data"] 为 描数
  列表追加(记录列表, 描)
  设 用 为 {}
  用["type"] 为 "user/message"
  设 用数 为 {}
  设 源 为 {}
  源["kind"] 为 "user"
  用数["source"] 为 源
  用["data"] 为 用数
  列表追加(记录列表, 用)
  返回 记录列表

# =====================================================================
# 槽位运行器（无闭包，抛错场景统一走这里）
# =====================================================================
段落 跑派生:
  设 册 为 场景["册"]
  设 占 为 派生(场景["调用者"], 场景["请求"])
  返回 真

段落 跑中断:
  设 册 为 场景["册"]
  设 占 为 中断(场景["调用者"], 场景["目标名"])
  返回 真

段落 跑隶属:
  设 册 为 场景["册"]
  设 占 为 隶属地(场景["代理"])
  返回 真

段落 跑恢复:
  设 册 为 场景["册"]
  设 占 为 恢复(场景["代理"], 场景["牌"])
  返回 真

段落 跑等候:
  设 器 为 场景["器"]
  设 占 为 等候(场景["队"], 场景["限"], 场景["牌"])
  返回 真

段落 跑限时:
  设 生命 为 场景["生命"]
  设 占 为 限时(场景["操作"])
  返回 真

段落 跑规整:
  设 占 为 规整文本(场景["值"], "description", 200)
  返回 真

段落 操作_成功:
  返回 "ok"

# =====================================================================
# A. 纯函数单元
# =====================================================================
段落 用例_判名:
  断言相等(判成员名("worker"), 真, "worker 合法")
  断言相等(判成员名("worker-2"), 真, "worker-2 合法")
  断言相等(判成员名("a1"), 真, "a1 合法")
  断言相等(判成员名("Lead"), 假, "Lead 非法")
  断言相等(判成员名("lead"), 假, "lead 非法")
  断言相等(判成员名("-bad"), 假, "-bad 非法")
  断言相等(判成员名("bad-"), 假, "bad- 非法")
  断言相等(判成员名("bad_name"), 假, "bad_name 非法")
  断言相等(判成员名("a--b"), 假, "a--b 非法")
  断言相等(判成员名(""), 假, "空名非法")
  设 长名 为 "x"
  设 轮 为 0
  当 轮 < 7:
    设 长名 为 长名 + 长名
    设 轮 为 轮 + 1
  断言相等(字符串长度(长名), 128, "构造 128 字符")
  断言相等(判成员名(长名), 假, "超 64 非法")
  返回 真

段落 用例_规整文本:
  断言相等(规整文本("  hello  ", "description", 200), "hello", "去空白")
  设 场景["值"] 为 "   "
  检查抛码("空白描述", "TEAM_INVALID_ARGUMENT", 跑规整)
  设 场景["值"] 为 ""
  检查抛码("空描述", "TEAM_INVALID_ARGUMENT", 跑规整)
  设 巨串 为 "y"
  设 轮 为 0
  当 轮 < 8:
    设 巨串 为 巨串 + 巨串
    设 轮 为 轮 + 1
  设 场景["值"] 为 巨串
  检查抛码("超长描述", "TEAM_INVALID_ARGUMENT", 跑规整)
  断言相等(规整文本("ok", "provider", 200), "ok", "正常 provider")
  返回 真

段落 用例_判时间窗:
  断言相等(判时间窗(9999), 假, "9999 越下界")
  断言相等(判时间窗(10000), 真, "10000 合界")
  断言相等(判时间窗(60000), 真, "60000 合法")
  断言相等(判时间窗(3600000), 真, "3600000 合界")
  断言相等(判时间窗(3600001), 假, "3600001 越上界")
  断言相等(判时间窗(0), 假, "0 越界")
  断言相等(判时间窗(1.5), 假, "非整数越界")
  返回 真

段落 用例_杂项纯函数:
  设 原 为 [1, 2, 3, 4]
  断言相等(切片(原, 2), [3, 4], "切片 从 2")
  断言相等(切片(原, 0), [1, 2, 3, 4], "切片 从 0")
  断言相等(切片(原, 4), [], "切片 越界为空")
  设 甲 为 {"a": 1}
  设 乙 为 副本(甲)
  乙["a"] 为 2
  断言相等(甲["a"], 1, "副本不污染原对象")
  断言相等(乙["a"], 2, "副本可改")
  设 后缀 为 造子体后缀("continuable", "spawn")
  断言相等(折子体描述(后缀)["mode"], "continuable", "折出子体模式")
  断言相等(折子体描述([]), 空, "无描述返回空")
  断言相等(取错码(造团队错("m", "CODE", 空)), "CODE", "取错码")
  断言相等(取错文(造团队错("m", "CODE", 空)), "m", "取错文")
  断言相等(团队错文本(造团队错("m", "CODE", 空)), "[CODE] m", "错文本")
  返回 真

# =====================================================================
# B. 解析活跃成员（resolveActiveMember）
# =====================================================================
段落 用例_解析活跃:
  设 清 为 清世界()
  设 根 为 造代理(根标识, "k-root", 空, "idle", "mock")
  设 占 为 放代理(根)
  设 局 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 占 为 放成员(根, 造成员(副标识, "newbie", "provisioning"))
  设 局2 为 能取局面(根)
  断言相等(解析活跃成员(根标识, 局2, "lead")["标识"], 根标识, "lead 解析为根")
  断言相等(解析活跃成员(根标识, 局2, "  lead  ")["标识"], 根标识, "lead 去空白")
  断言相等(解析活跃成员(根标识, 局2, "worker")["标识"], 子标识, "活跃成员解析")
  断言相等(解析活跃成员(根标识, 局2, " worker ")["名字"], "worker", "成员名去空白")
  设 场景["局"] 为 局2
  设 场景["名"] 为 "newbie"
  检查抛码("筹备成员不可解析", "TEAM_MEMBER_NOT_FOUND", 跑解析)
  设 场景["名"] 为 "ghost"
  检查抛码("不存在成员", "TEAM_MEMBER_NOT_FOUND", 跑解析)
  返回 真

段落 跑解析:
  设 占 为 解析活跃成员(根标识, 场景["局"], 场景["名"])
  返回 真

段落 用例_解析失败相位:
  设 清 为 清世界()
  设 根 为 造代理(根标识, "k-root", 空, "idle", "mock")
  设 占 为 放代理(根)
  设 局 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "worker", "failed"))
  设 局2 为 能取局面(根)
  设 场景["局"] 为 局2
  设 场景["名"] 为 "worker"
  检查抛码("失败相位不可解析", "TEAM_MEMBER_NOT_FOUND", 跑解析)
  返回 真

# =====================================================================
# C. 生命周期（TeamRuntimeLifecycle）
# =====================================================================
段落 用例_生命周期基础:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  断言相等(已弃置(), 假, "初始未弃置")
  断言相等(原因(), 空, "初始无原因")
  断言相等(令牌()["已中止"], 假, "初始令牌未中止")
  断言相等(时限(), 100, "时限可读")
  设 占 为 关闭()
  断言相等(已弃置(), 真, "关闭后已弃置")
  断言相等(取错码(原因()), "TEAM_DISPOSED", "关闭原因码")
  断言相等(令牌()["已中止"], 真, "关闭后令牌已中止")
  设 原 为 原因()
  设 占 为 关闭()
  断言相等(取错码(原因()), "TEAM_DISPOSED", "关闭幂等")
  返回 真

段落 用例_收束空表:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 败 为 []
  设 占 为 收束([], 败)
  断言相等(列表长度(败), 0, "空表不收束")
  返回 真

段落 用例_收束普通失败:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 败 为 []
  设 普 为 造团队错("ordinary failure before disposal", "ORDINARY", 空)
  设 结 为 [{"状态": "已拒", "值": 空, "理由": 普}]
  设 占 为 收束(结, 败)
  断言相等(列表长度(败), 1, "未弃置时普通失败保留")
  断言相等(取错码(败[0]), "ORDINARY", "保留项码")
  返回 真

段落 用例_收束过滤取消:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 占 为 关闭()
  设 败 为 []
  设 直因 为 原因()
  设 编 为 造团队错("translated cancellation", "TEAM_DISPOSED", 空)
  设 包 为 造团队错("wrapped cancellation", "WRAPPED", 直因)
  设 循 为 造团队错("unrelated cyclic failure", "CYCLIC", 空)
  循["因"] 为 循
  设 结 为 []
  列表追加(结, {"状态": "已拒", "值": 空, "理由": 直因})
  列表追加(结, {"状态": "已拒", "值": 空, "理由": 编})
  列表追加(结, {"状态": "已拒", "值": 空, "理由": 包})
  列表追加(结, {"状态": "已拒", "值": 空, "理由": 循})
  列表追加(结, {"状态": "已完", "值": 1, "理由": 空})
  设 占 为 收束(结, 败)
  断言相等(列表长度(败), 1, "已弃置时仅循环因链保留")
  断言相等(取错码(败[0]), "CYCLIC", "循环因链不被误判为取消")
  返回 真

段落 用例_收束超时:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 世界["计时判定"] 为 真
  设 败 为 []
  设 结 为 [{"状态": "已完", "值": 1, "理由": 空}]
  设 占 为 收束(结, 败)
  断言相等(列表长度(败), 1, "超时记一条失败")
  断言相等(取错码(败[0]), "TEAM_DISPOSAL_TIMEOUT", "超时码")
  返回 真

段落 用例_限时:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 场景["生命"] 为 生命
  设 场景["操作"] 为 操作_成功
  断言相等(限时(操作_成功), "ok", "未超时返回操作值")
  设 世界["计时判定"] 为 真
  检查抛码("超时抛错", "TEAM_DISPOSAL_TIMEOUT", 跑限时)
  检查消息("超时消息含时限", "exceeded 100ms", 跑限时)
  返回 真

段落 用例_判取消未弃置:
  设 清 为 清世界()
  设 生命 为 造生命(100)
  设 编 为 造团队错("coded", "TEAM_DISPOSED", 空)
  断言相等(判取消(编), 假, "未弃置一律不是取消")
  设 占 为 关闭()
  断言相等(判取消(编), 真, "弃置后按码识别")
  断言相等(判取消(原因()), 真, "弃置后按直因识别")
  返回 真

段落 用例_造结算:
  设 清 为 清世界()
  设 结 为 造结算(操作_成功)
  断言相等(结["状态"], "已完", "成功结算状态")
  断言相等(结["值"], "ok", "成功结算值")
  设 占位 为 造结算(跑限时空操作)
  设 结二 为 造结算(跑限时空操作)
  断言相等(结二["状态"], "已拒", "抛错结算状态")
  返回 真

段落 跑限时空操作:
  抛出 新建 错误("[BOOM] boom")

