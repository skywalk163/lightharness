# test_宿主IO_接线.light —— 第6轮 任务B #262 宿主IO 正式集成层 判据
# 运行：python 运行.py examples/test_宿主IO_接线.light
# 判据：接桩出口（宿主转交/带重试宿主调用/造宿主文件桩）在宿主桩 mock 下返回预期形状；
#       纯逻辑段（§1-§6）回归绿由 test_宿主IO.light 承担。

从 宿主IO 导入 造宿主桩, 宿主转交, 带重试宿主调用, 造宿主文件桩, 造内存文件系统
从 宿主IO 导入 造取消令牌, 取消令牌, 造成功结果, 造失败结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 能力：恒等回显
段落 回显能力(参数字典):
  返回 参数字典

# mock 能力：失败后恢复（计数槽驱动，闪避无状态闭包）
设 恢复计数 为 {"次数": 0, "恢复轮": 3}

段落 闪避恢复能力(参数字典):
  全局 恢复计数
  设 恢复计数["次数"] 为 恢复计数["次数"] + 1
  如果 恢复计数["次数"] < 恢复计数["恢复轮"]:
    返回 造失败结果("TIMEOUT", "暂时失败", 空)
  返回 造成功结果("已恢复", 空)

段落 恒NOT_FOUND(参数字典):
  返回 造失败结果("NOT_FOUND", "不可重试", 空)

段落 主:
  # ---- 1. 宿主转交：未知能力 -> UNSUPPORTED_OPERATION ----
  设 空桩 为 造宿主桩({})
  设 r1 为 宿主转交(空桩, "无此能力", {})
  断言真(是失败结果(r1), "1a 未知能力须失败")
  断言相等(r1["错误码"], "UNSUPPORTED_OPERATION", "1b 错误码")
  断言相等(r1["元数据"]["能力"], "无此能力", "1c 元数据能力")

  # ---- 2. 宿主转交：能力路由 + 统一形状包装 + 调用日志 ----
  设 桩 为 造宿主桩({"回显": 回显能力})
  设 r2 为 宿主转交(桩, "回显", {"键": "值"})
  断言真(r2["成功"], "2a 成功形状")
  断言相等(r2["数据"]["键"], "值", "2b 数据透传")
  断言相等(r2["元数据"]["能力"], "回显", "2c 元数据能力")
  断言相等(列表长度(桩["调用日志"]), 1, "2d 调用日志一条")

  # ---- 3. 宿主转交：IO结果形状透传（不二次包装） ----
  设 桩3 为 造宿主桩({"信封": 恒NOT_FOUND})
  设 r3 为 宿主转交(桩3, "信封", {})
  断言真(是失败结果(r3), "3a 信封透传")
  断言相等(r3["错误码"], "NOT_FOUND", "3b 错误码透传")

  # ---- 4. 取消令牌传播：已取消 -> 宿主转交 前置抛错 ----
  设 令牌 为 造取消令牌("req-1")
  取消令牌(令牌, "调用方中止")
  设 已抛 为 假
  尝试:
    设 _r4 为 宿主转交(桩, "回显", {}, 令牌)
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "4a 已取消令牌须抛")

  # ---- 5. 带重试宿主调用：可重试错误码重试至恢复，元数据附重试次数 ----
  设 策略 为 {"最大重试次数": 5, "初始延迟": 1, "延迟倍增因子": 2, "可重试错误码列表": ["TIMEOUT"]}
  设 r5 为 带重试宿主调用(造宿主桩({"恢复": 闪避恢复能力}), "恢复", {}, 策略)
  断言真(r5["成功"], "5a 重试后恢复")
  断言相等(r5["数据"], "已恢复", "5b 数据")
  断言相等(r5["元数据"]["重试次数"], 3, "5c 重试次数")

  # ---- 6. 带重试宿主调用：不可重试错误码立即返回 ----
  设 r6 为 带重试宿主调用(造宿主桩({"信封": 恒NOT_FOUND}), "信封", {}, 策略)
  断言真(是失败结果(r6), "6a 不可重试失败")
  断言相等(r6["元数据"]["重试次数"], 1, "6b 只试一次")

  # ---- 7. 文件 IO 统一形状：造宿主文件桩 + 宿主转交 读写往返 ----
  #   路径用根下文件（§4 写文件 要求父目录已存在，"/" 由 造内存文件系统 预置）
  设 文件系统 为 造内存文件系统()
  设 文件桩 为 造宿主文件桩(文件系统)
  设 r7 为 宿主转交(文件桩, "写", {"路径": "/b.txt", "内容": "你好", "请求ID": "w1"})
  断言真(r7["成功"], "7a 写成功")
  断言相等(r7["元数据"]["操作"], "write", "7b 写形状")
  设 r8 为 宿主转交(文件桩, "读", {"路径": "/b.txt", "请求ID": "r1"})
  断言真(r8["成功"], "8a 读成功")
  断言相等(r8["数据"], "你好", "8b 读往返")

  打印 "--- 第6轮 任务B #262 宿主IO 正式集成层 测试通过 ---"

主()