# test_cli外壳.light —— 光明 CLI 外壳测试（第6轮 任务线A，卡 #255）
#
# 覆盖：
#   1) 解析参数 各旗标取值正确；--help 短路；未知参数抛错
#   2) 斜杠命令表 含 7 命令且映射非空
#   3) 无头运行 给定提示返回最终文本非空（mock 客户端）
#   4) 列会话并选择 接 总入口.列出会话 形状一致（不报错）
#   5) 解析预设 未知 -> 抛错且文案含四键（standard/ptc/minimal/cordis）
#
# 反跑判据（任务书 3 组）：
#   ① 解析参数 未知参数不报错 -> 本用例 1c 立红；
#   ② 无头运行 改成「进 REPL」-> 本用例 3a（返回最终文本非空）立红；
#   ③ 解析预设 未知改「回落 standard」-> 本用例 5a（应抛错）立红。

从 cli外壳 导入 解析参数, 斜杠命令表, 无头运行, 列会话并选择, 解析预设
从 工具 导入 工具注册表
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因
从 内置核心字典 导入 字典键列表
从 文件 导入 删除路径

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) + " 期望=" 加上 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

# ---- mock 客户端：单次文本响应（无工具调用）----
类 假客户端:
  段落 构造():
    设 己.模型名 为 "mock-cli"

  段落 对话响应(网络消息, 选项, 工具表):
    设 块表 为 []
    块表.追加(造块开始(0, "text"))
    块表.追加(造文本增量(0, "你好，CLI"))
    块表.追加(造块结束(0, ["type": "text", "text": "你好，CLI"]))
    块表.追加(造结束(造停止原因()))
    返回 块表

段落 主:
  # 1) 解析参数：各旗标取值正确
  设 配置 为 解析参数(["--model", "m1", "--preset", "minimal", "--prompt", "说你好", "--resume", "abc123", "--list"])
  断言等于(配置["模型"], "m1", "1a 模型取值")
  断言等于(配置["预设"], "minimal", "1b 预设取值")
  断言等于(配置["提示"], "说你好", "1c 提示取值")
  断言等于(配置["续写"], "abc123", "1d 续写取值")
  断言等于(配置["列表"], 真, "1e 列表布尔旗标")
  断言等于(配置["帮助"], 假, "1f 帮助缺省假")

  # 1g) --help 短路返回帮助=真
  设 帮助配置 为 解析参数(["--help"])
  断言等于(帮助配置["帮助"], 真, "1g --help 短路")

  # 1h) 未知参数 -> 抛错
  尝试:
    解析参数(["--bogus", "x"])
    抛出 "1h 应抛错未抛"
  捕获 异常 错误:
    断言真(转字符串(错误).包含("未知命令行参数"), "1h 未知参数应报错")

  # 2) 斜杠命令表：7 命令且映射非空
  设 表 为 斜杠命令表()
  设 键表 为 字典键列表(表)
  断言等于(长度(键表), 7, "2a 斜杠命令数=7")
  断言真(表.包含("/help"), "2b 含 /help")
  断言真(表.包含("/clear"), "2c 含 /clear")
  断言真(表.包含("/model"), "2d 含 /model")
  断言真(表.包含("/compact"), "2e 含 /compact")
  断言真(表.包含("/save"), "2f 含 /save")
  断言真(表.包含("/resume"), "2g 含 /resume")
  断言真(表.包含("/exit"), "2h 含 /exit")
  遍历 键 之 键表:
    如果 表[键] == 空 或 表[键] == "":
      抛出 "2i 斜杠命令映射非空: " 加上 键

  # 3) 无头运行：给定提示返回最终文本非空（mock 客户端 + 空注册表）
  设 假客户端 为 新建 假客户端()
  设 空注册表 为 新建 工具注册表()
  设 文本 为 无头运行(假客户端, 空注册表, ".", "打个招呼")
  断言真(文本 != 空 且 文本 != "", "3a 无头返回最终文本非空")
  断言真(文本.包含("你好，CLI"), "3b 无头文本含 mock 回复")

  # 4) 列会话并选择：接 总入口.列出会话 形状一致（临时根，不报错）
  设 根 为 ".test_cli外壳"
  列会话并选择(根)
  列会话并选择(根)
  如果 目录存在(根):
    删除路径(根)

  # 5) 解析预设：四键合法透传；未知抛错且文案含四键
  断言等于(解析预设("standard"), "standard", "5a standard 透传")
  断言等于(解析预设("ptc"), "ptc", "5b ptc 透传")
  断言等于(解析预设("minimal"), "minimal", "5c minimal 透传")
  断言等于(解析预设("cordis"), "cordis", "5d cordis 透传")
  尝试:
    解析预设("zzz")
    抛出 "5e 应抛错未抛"
  捕获 异常 错误:
    设 文案 为 转字符串(错误)
    断言真(文案.包含("standard"), "5e 报错含 standard")
    断言真(文案.包含("ptc"), "5f 报错含 ptc")
    断言真(文案.包含("minimal"), "5g 报错含 minimal")
    断言真(文案.包含("cordis"), "5h 报错含 cordis")

  打印 "test_cli外壳 PASS"

主()
