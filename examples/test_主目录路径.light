# test_主目录路径.light —— 模块34 主目录路径 对齐判据
# 运行：python 运行.py examples/test_主目录路径.light

从 主目录路径 导入 展开主目录路径, 解析主目录, 主目录路径, 主目录显示, 默认主目录

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 主:
  设 主目录 为 "/home/u"

  # 展开：~ 本身
  断言相等(展开主目录路径("~", 主目录), "/home/u", "~ 展开到操作系统主目录")

  # 展开：~/ 前缀
  断言相等(展开主目录路径("~/a/b", 主目录), 连接路径("/home/u", "a/b"), "~/ 前缀拼接")

  # 展开：Windows ~\ 前缀
  断言相等(展开主目录路径("~\\x", 主目录), 连接路径("/home/u", "x"), "Windows ~\\ 前缀拼接")

  # 展开：非 ~ 前缀原样返回
  断言相等(展开主目录路径("/abs/path", 主目录), "/abs/path", "非 ~ 前缀原样返回")

  # 默认主目录 ~/.dsh
  断言相等(默认主目录(主目录), 连接路径("/home/u", ".dsh"), "默认主目录 = ~/.dsh")

  # 解析：无配置无环境 → 默认
  断言相等(解析主目录(空, {}, 主目录), 连接路径("/home/u", ".dsh"), "解析默认主目录")

  # 解析：显式配置优先
  断言相等(解析主目录("/custom/dsh", {}, 主目录), "/custom/dsh", "显式配置优先")

  # 解析：环境变量优先于默认但低于配置
  断言相等(解析主目录(空, {"DSH_HOME": "/env/dsh"}, 主目录), "/env/dsh", "环境变量覆盖默认")
  断言相等(解析主目录("/cfg", {"DSH_HOME": "/env/dsh"}, 主目录), "/cfg", "配置覆盖环境变量")

  # 解析：纯空白环境变量视为未设置
  断言相等(解析主目录(空, {"DSH_HOME": "   "}, 主目录), 连接路径("/home/u", ".dsh"), "空白环境变量回退默认")

  # 拼接段
  断言相等(主目录路径(主目录, ["a", "b"]), 连接路径(连接路径("/home/u", ".dsh"), "a", "b"), "主目录路径拼接段")
  断言相等(主目录路径(主目录, []), 连接路径("/home/u", ".dsh"), "主目录路径空段返回根")

  # 显示名
  断言相等(主目录显示(解析主目录(空, {}, 主目录), 主目录), "~/.dsh", "默认显示 ~/.dsh")
  断言相等(主目录显示("/tmp/dsh", 主目录), "$DSH_HOME", "非默认显示 $DSH_HOME")

  打印("--- 主目录路径子系统（模块34）测试通过 ---")

主()
