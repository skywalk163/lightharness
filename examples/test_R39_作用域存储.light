# test_R39_作用域存储.light —— 第 39 轮 任务 2 判据：store.ts 存储层复刻
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/scope/src/store.ts（267 行）
#   官方 tests/store.spec.ts 8 用例 → §1..§8 逐条映射：
#     NamedEntries（拥有重复诊断 / 查找 / 插入序 / 活迭代 / 精确幂等 undo / 排空换代）
#     AnonymousEntries（等值独立 / 插入序 / 活迭代 / 幂等 undo / 排空换代）
#     ScopedLayers（global 即时构造 / 读不建层 / merge 命名遮蔽序 / 仅回收空聚合 /
#                   action→notify→undo→notify 顺序 / 幂等与标签 / 工厂与动作失败清理 / 通知抛错回滚）
# 运行：cd lightharness && python 运行.py examples/test_R39_作用域存储.light
# 反跑锚点：§5-05d「推进游标(旧游标)["完成"] 期望 真」改 假 → rc=1；
#           §11-11c「取层(预设键) 期望 空」改 真→假 → rc=1
#
# 光明适配：JS 闭包 undo → 「具名段落 + 模块级槽字典」（下文 撤销… 段落即闭包等价物）；
#           排空换代 → 撤销时若表空则把 己.数据 换为新字典并 ++代数，旧游标持有旧字典 ⇒ 自动失效。

从 测试 导入 断言相等, 断言真
从 内置核心字典 导入 字典设置
从 内置核心字符串 导入 字符串包含
从 作用域 导入 建作用域键, 取作用域链
从 作用域 导入 建上下文, 建作用域, 取作用域上下文
从 作用域 导入 命名条目表, 注销命名条目, 推进游标, 匿名条目表, 注销匿名条目
从 作用域 导入 默认重复报错, 取名字表, 空变更, 建标准层, 造作用域层组, 注销附着

# ---- 模块级槽（替代 JS 闭包捕获）----
设 槽盘 为 {"层": 空, "句柄共享": 空, "句柄共享三": 空, "句柄匿名": 空, "句柄序": 空, "句柄留": 空}
设 序盘 为 {"表": [], "变更数": 0}
设 厂盘 为 {"抛": 假}

# ---- 断言助手 ----
段落 断言抛错 接收 已捕获, 消息, 关键词, 编号:
  断言相等(已捕获, 真, "应抛错未抛 #" + 编号)
  断言真(字符串包含(消息, 关键词), "错误消息不含「" + 关键词 + "」 #" + 编号 + " 实际=" + 消息)
  返回 真

# ---- 调用方拥有的重复诊断 ----
段落 定制重复报错 接收 名字:
  抛出 新建 错误("调用方诊断：" + 名字 + " [CALLER_DUP]")

# ---- 事件记录 ----
段落 记事件 接收 名:
  序盘["表"].追加(名)
  返回 真

段落 重置序盘:
  字典设置(序盘, "表", [])
  字典设置(序盘, "变更数", 0)
  返回 真

# ---- 动作 / 撤销器对（动作接收层；撤销器零参，借槽盘取句柄）----
段落 动作插共享 接收 层:
  槽盘["层"] 为 层
  槽盘["句柄共享"] 为 层.命名.插入("共享", 2)
  返回 撤销插共享

段落 撤销插共享:
  返回 注销命名条目(槽盘["句柄共享"])

段落 动作插共享三 接收 层:
  槽盘["层"] 为 层
  槽盘["句柄共享三"] 为 层.命名.插入("共享", 3)
  返回 撤销插共享三

段落 撤销插共享三:
  返回 注销命名条目(槽盘["句柄共享三"])

段落 动作追加匿名 接收 层:
  槽盘["句柄匿名"] 为 层.匿名.追加("保留")
  返回 撤销追加匿名

段落 撤销追加匿名:
  返回 注销匿名条目(槽盘["句柄匿名"])

段落 动作记序 接收 层:
  记事件("action")
  槽盘["句柄序"] 为 层.命名.插入("x", 1)
  返回 撤销记序

段落 撤销记序:
  记事件("undo")
  返回 注销命名条目(槽盘["句柄序"])

段落 动作保留 接收 层:
  槽盘["句柄留"] 为 层.命名.插入("保留", 1)
  返回 撤销保留

段落 撤销保留:
  返回 注销命名条目(槽盘["句柄留"])

段落 动作抛错 接收 层:
  抛出 新建 错误("动作失败 [ACTION_FAILED]")

段落 变更记序:
  记事件("notify")
  返回 真

段落 变更首次抛错:
  记事件("notify")
  字典设置(序盘, "变更数", 序盘["变更数"] + 1)
  如果 序盘["变更数"] == 1:
    抛出 新建 错误("变更失败 [CHANGE_FAILED]")
  返回 真

段落 工厂可抛 接收 作用域键:
  如果 是空(作用域键) == 假:
    如果 厂盘["抛"] == 真:
      抛出 新建 错误("工厂失败 [FACTORY_FAILED]")
  返回 建标准层(作用域键)

段落 取命名 接收 层:
  返回 层.命名

段落 主:
  设 计数 为 0

  # ===== #00 判据自检 =====
  设 计数 为 计数 + 1
  设 自检 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检 为 真
  断言相等(自检, 真, "00 断言助手自检")
  打印 "OK #00"

  # ===== §1 命名条目表：插入有序 / 查找 / 列表 / 为空 =====
  设 计数 为 计数 + 1
  设 表 为 新建 命名条目表(空)
  断言相等(表.为空(), 真, "01 初始为空")
  设 句柄甲 为 表.插入("a", 1)
  设 句柄乙 为 表.插入("b", 2)
  断言相等(表.取("a"), 1, "01b 取 a")
  断言相等(表.取("b"), 2, "01c 取 b")
  断言相等(表.取("缺失"), 空, "01d 缺失取空")
  断言相等(表.有无("b"), 真, "01e 有无 b")
  断言相等(表.有无("缺失"), 假, "01f 无缺失")
  断言相等(表.名字列表(), ["a", "b"], "01g 插入有序名字")
  断言相等(表.值列表(), [1, 2], "01h 插入有序值")
  断言相等(表.项列表(), [["a", 1], ["b", 2]], "01i 插入有序项")
  断言相等(表.条目数(), 2, "01j 条目数")
  断言相等(表.为空(), 假, "01k 非空")
  打印 "OK #01-01k"

  # ===== §2 重复诊断由调用方拥有 =====
  设 计数 为 计数 + 1
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    表.插入("a", 9)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "DUPLICATE_NAME", "02 缺省重复报错")
  设 自定义表 为 新建 命名条目表(定制重复报错)
  自定义表.插入("k", 1)
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    自定义表.插入("k", 2)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "CALLER_DUP", "02b 调用方拥有诊断")
  断言相等(自定义表.取("k"), 1, "02c 重复插入未污染原值")
  设 已捕获 为 假
  尝试:
    默认重复报错("z")
  捕获 异常 为 e:
    设 已捕获 为 真
  断言相等(已捕获, 真, "02d 默认重复报错可抛")
  打印 "OK #02-02d"

  # ===== §3 幂等 undo：只删自身 / 多次调用安全 =====
  设 计数 为 计数 + 1
  注销命名条目(句柄甲)
  注销命名条目(句柄甲)
  断言相等(表.取("a"), 空, "03 undo 生效")
  断言相等(表.名字列表(), ["b"], "03b undo 只删自身")
  表.插入("a", 3)
  断言相等(表.取("a"), 3, "03c 重插成功")
  注销命名条目(句柄乙)
  断言相等(表.项列表(), [["a", 3]], "03d 幂等后仍只余重插项")
  打印 "OK #03-03d"

  # ===== §4 同一代内游标可见后续插入（活迭代器语义）=====
  设 计数 为 计数 + 1
  设 表二 为 新建 命名条目表(空)
  设 句甲 为 表二.插入("first", 1)
  设 游标 为 表二.游标()
  设 首步 为 推进游标(游标)
  断言相等(首步["完成"], 假, "04a 首步未完成")
  断言相等(首步["值"], 1, "04 首步值")
  表二.插入("second", 2)
  设 次步 为 推进游标(游标)
  断言相等(次步["完成"], 假, "04b 同代可见新增")
  断言相等(次步["值"], 2, "04c 次步值")
  断言相等(列表长度(表二.名字列表()), 2, "04d 两名字")
  注销命名条目(句甲)
  打印 "OK #04-04d"

  # ===== §5 排空 → 换新代：旧游标失效、新代可继续 =====
  设 计数 为 计数 + 1
  设 表三 为 新建 命名条目表(空)
  设 句一 为 表三.插入("first", 1)
  设 旧游标 为 表三.游标()
  断言相等(推进游标(旧游标)["值"], 1, "05 旧游标首步")
  断言相等(表三.代数取(), 0, "05b 未换代")
  注销命名条目(句一)
  断言相等(表三.代数取(), 1, "05c 排空换代")
  表三.插入("replacement", 2)
  断言相等(推进游标(旧游标)["完成"], 真, "05d 旧游标已失效（跨代不可见）")
  断言相等(表三.值列表(), [2], "05e 新代可见新插入")
  设 新游标 为 表三.游标()
  断言相等(推进游标(新游标)["值"], 2, "05f 新游标从头")
  断言相等(推进游标(新游标)["完成"], 真, "05g 新游标走完")
  打印 "OK #05-05g"

  # ===== §6 匿名条目表：等值独立 / 插入序 / 幂等 / 排空换代 =====
  设 计数 为 计数 + 1
  设 匿 为 新建 匿名条目表()
  断言相等(匿.为空(), 真, "06 初始为空")
  设 匿甲 为 匿.追加("同值")
  设 匿乙 为 匿.追加("同值")
  断言相等(匿.条目数(), 2, "06b 等值独立注册")
  断言相等(匿.值列表(), ["同值", "同值"], "06c 插入有序（等值各占一条）")
  断言相等(匿.有无("同值"), 真, "06d 有无值")
  断言相等(匿.有无("别的"), 假, "06e 无此值")
  注销匿名条目(匿甲)
  注销匿名条目(匿甲)
  断言相等(匿.值列表(), ["同值"], "06f undo 幂等且只删自身")
  设 匿游标 为 匿.游标()
  断言相等(推进游标(匿游标)["值"], "同值", "06g 游标取值")
  注销匿名条目(匿乙)
  断言相等(匿.为空(), 真, "06h 排空")
  断言相等(匿.代数取(), 1, "06i 排空换代")
  断言相等(注销匿名条目({"假": "句柄"}), 假, "06j 非法匿名句柄返回假")
  断言相等(注销命名条目({"假": "句柄"}), 假, "06k 非法命名字段句柄返回假")
  打印 "OK #06-06k"

  # ===== §7 标准层 / 取名字表 =====
  设 计数 为 计数 + 1
  设 层标准 为 建标准层()
  断言相等(层标准.键, 空, "07 无键标准层")
  断言相等(层标准.为空(), 真, "07b 空标准层")
  层标准.命名.插入("n", 1)
  断言相等(层标准.为空(), 假, "07c 命名非空")
  层标准.匿名.追加("a")
  断言相等(层标准.为空(), 假, "07d 匿名非空")
  断言相等(取名字表(层标准, 空).取("n"), 1, "07e 缺省取名字表")
  断言相等(取名字表(层标准, 取命名).取("n"), 1, "07f 自定义取表")
  设 键探 为 建作用域键("probe")
  设 层探 为 建标准层(键探)
  断言相等(层探.键, 键探, "07g 标准层记录作用域键")
  打印 "OK #07-07g"

  # ===== §8 作用域层组：非创建读 / 全局层 / merge 基线 =====
  设 计数 为 计数 + 1
  设 根 为 建上下文()
  设 预设键 为 建作用域键("preset")
  设 代理键 为 建作用域键("agent")
  设 预设域 为 建作用域(根, 预设键)
  设 代理域 为 建作用域(根, 代理键, 预设键)
  设 预设上下文 为 取作用域上下文(预设域)
  设 代理上下文 为 取作用域上下文(代理域)
  断言相等(取作用域链(代理键), [代理键, 预设键], "08 父链就近优先")
  设 层组 为 造作用域层组()
  断言相等(层组.层数(), 0, "08b 读前无作用域层")
  断言相等(层组.取层(预设键), 空, "08c 取层不创建")
  断言相等(层组.层数(), 0, "08d 读后仍无层")
  设 全局层 为 层组.全局层()
  全局层.命名.插入("a", 1)
  全局层.命名.插入("共享", 1)
  断言相等(层组.全局.命名.取("a"), 1, "08e 全局属性直读")
  断言相等(层组.取层(空), 空, "08f 空键取层为空")
  断言相等(层组.为空(空), 真, "08g 空键层为空")
  断言相等(层组.合并命名(预设键), {"a": 1, "共享": 1}, "08h 无作用域层时只见全局")
  断言相等(层组.链上层(预设键), [], "08i 无层时链上层为空")
  打印 "OK #08-08i"

  # ===== §9 作用域层：祖先在前 / 就近遮蔽 =====
  设 计数 为 计数 + 1
  设 预设句 为 层组.附着(预设上下文, 动作插共享, "t.preset", 假)
  设 代理句 为 层组.附着(代理上下文, 动作插共享三, "t.agent", 假)
  断言相等(层组.层数(), 2, "09 两个作用域层")
  断言相等(层组.合并命名(预设键), {"a": 1, "共享": 2}, "09b 预设层遮蔽全局")
  断言相等(层组.合并命名(代理键), {"a": 1, "共享": 3}, "09c 最近作用域最终拍板")
  断言相等(列表长度(层组.链上层(代理键)), 2, "09d 链上层含 预设+代理")
  断言相等(层组.链上层(代理键)[0].键, 预设键, "09e 链上层祖先在前")
  断言相等(层组.链上层(代理键)[1].键, 代理键, "09f 链上层自身在后")
  断言相等(层组.链上层(预设键)[0].键, 预设键, "09g 预设处链上层仅自身")
  断言相等(列表长度(层组.层链(代理键)), 3, "09h 层链含全局")
  断言相等(层组.层链(代理键)[0].键, 空, "09i 层链全局最前")
  断言相等(层组.为空(代理键), 假, "09j 代理层非空")
  断言相等(层组.为空(键探), 真, "09k 未建层视为空")
  断言相等(层组.确保层(代理键).键, 代理键, "09l 确保层幂等返回既有层")
  断言相等(层组.层数(), 2, "09m 确保层未新增")
  打印 "OK #09-09m"

  # ===== §10 收集：命名条目沿链（全局→祖→子，就近覆盖）+ 匿名逐层 =====
  设 计数 为 计数 + 1
  设 匿名句 为 层组.附着(代理上下文, 动作追加匿名, "t.anon", 假)
  设 收集果 为 层组.收集(代理键)
  # 收集 = 沿链逐层原样罗列（不去重）；去重视图见 合并命名
  断言相等(列表长度(收集果["命名条目"]), 4, "10 收集命名条目数（逐层罗列）")
  断言相等(收集果["命名条目"][0], {"名": "a", "值": 1}, "10b 全局条目在前")
  断言相等(收集果["命名条目"][1], {"名": "共享", "值": 1}, "10c 全局共享")
  断言相等(收集果["命名条目"][2], {"名": "共享", "值": 2}, "10d 预设层共享")
  断言相等(收集果["命名条目"][3], {"名": "共享", "值": 3}, "10e 代理层共享在最后")
  断言相等(收集果["匿名条目"], ["保留"], "10f 收集匿名条目")
  断言相等(列表长度(层组.收集(键探)["命名条目"]), 2, "10g 无作用域层只收全局")
  断言相等(列表长度(层组.收集(键探)["匿名条目"]), 0, "10h 无作用域层无匿名")
  打印 "OK #10-10h"

  # ===== §11 撤销：仅回收空聚合；仍有条目则保留层 =====
  设 计数 为 计数 + 1
  断言相等(注销附着(预设句), 真, "11 注销预设附着")
  断言相等(注销附着(预设句), 假, "11b 重复注销返回假")
  断言相等(层组.取层(预设键), 空, "11c 空聚合层被回收")
  断言真(层组.取层(代理键) != 空, "11d 代理层保留（仍有条目）")
  断言相等(层组.合并命名(代理键), {"a": 1, "共享": 3}, "11e 回收后遮蔽退回全局")
  断言相等(层组.为空(预设键), 真, "11f 回收后层级为空")
  断言相等(层组.层数(), 1, "11g 层数回落")
  注销附着(代理句)
  注销附着(匿名句)
  断言相等(层组.取层(代理键), 空, "11h 代理层最后回收")
  断言相等(层组.层数(), 0, "11i 归零")
  打印 "OK #11-11i"

  # ===== §12 附着：顺序 / 幂等 / 标签 / 通知开关 =====
  设 计数 为 计数 + 1
  重置序盘()
  设 序组 为 造作用域层组(空, 变更记序)
  设 序句 为 序组.附着(代理上下文, 动作记序, "store.order")
  断言相等(序盘["表"], ["action", "notify"], "12 动作先于通知")
  断言相等(序句["标签"], "store.order", "12b 标签随句柄保留")
  断言相等(序句["通知"], 真, "12c 通知标记")
  注销附着(序句)
  注销附着(序句)
  断言相等(序盘["表"], ["action", "notify", "undo", "notify"], "12d 撤销顺序＋幂等")
  断言相等(序组.取层(代理键), 空, "12e 撤销后层回收")
  断言相等(序组.全局层().为空(), 真, "12f 全局层未留残条")
  打印 "OK #12-12f"

  # 通知=假：不触发变更通知
  设 计数 为 计数 + 1
  重置序盘()
  设 静组 为 造作用域层组(空, 变更记序)
  设 静句 为 静组.附着(代理上下文, 动作保留, "store.kept", 假)
  断言相等(序盘["表"], [], "13 notify=false 不通知")
  断言相等(静句["通知"], 假, "13b 标记为假")
  断言相等(静组.合并命名(代理键)["保留"], 1, "13c 条目已落层")
  注销附着(静句)
  断言相等(序盘["表"], [], "13d 撤销亦不通知")
  断言相等(静组.取层(代理键), 空, "13e 撤销后回收")
  打印 "OK #13-13e"

  # ===== §14 工厂失败：不留层 =====
  设 计数 为 计数 + 1
  字典设置(厂盘, "抛", 真)
  设 抛组 为 造作用域层组(工厂可抛, 空变更)
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    抛组.附着(代理上下文, 动作保留, "store.factory", 假)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "FACTORY_FAILED", "14 工厂失败上抛")
  断言相等(抛组.取层(代理键), 空, "14b 工厂失败不留层")
  断言相等(抛组.层数(), 0, "14c 层数归零")
  打印 "OK #14-14c"

  # ===== §15 动作失败：新建空层回收 / 既有层保留 =====
  设 计数 为 计数 + 1
  字典设置(厂盘, "抛", 假)
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    抛组.附着(代理上下文, 动作抛错, "store.action", 假)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "ACTION_FAILED", "15 动作失败上抛")
  断言相等(抛组.取层(代理键), 空, "15b 新建层动作失败后回收")
  设 既有句 为 抛组.附着(代理上下文, 动作保留, "store.existing", 假)
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    抛组.附着(代理上下文, 动作抛错, "store.existing-fail", 假)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "ACTION_FAILED", "15c 既有层动作失败上抛")
  断言相等(抛组.取层(代理键).命名.取("保留"), 1, "15d 既有层不被丢弃")
  注销附着(既有句)
  打印 "OK #15-15d"

  # ===== §16 通知抛错 → 回滚（notify → undo → notify）且回收空聚合 =====
  设 计数 为 计数 + 1
  重置序盘()
  设 滚组 为 造作用域层组(空, 变更首次抛错)
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    滚组.附着(代理上下文, 动作记序, "store.rollback")
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "CHANGE_FAILED", "16 通知抛错上抛")
  断言相等(["action", "notify", "undo", "notify"], 序盘["表"], "16b 回滚顺序（动作 → 通知抛错 → 撤销 → 通知）")
  断言相等(滚组.取层(代理键), 空, "16c 回滚后回收空聚合")
  断言相等(滚组.层数(), 0, "16d 层数归零")
  打印 "OK #16-16d"

  # ===== §17 全局层附着（无作用域标签）=====
  设 计数 为 计数 + 1
  设 全局组 为 造作用域层组()
  设 全局句 为 全局组.附着(根, 动作保留, "store.global", 假)
  断言相等(全局组.全局层().命名.取("保留"), 1, "17 无标签写入全局层")
  断言相等(全局组.层数(), 0, "17b 不建作用域层")
  注销附着(全局句)
  断言相等(全局组.全局层().为空(), 真, "17c 全局层撤销后为空")
  打印 "OK #17-17c"

  # ===== §18 缺省建层器 / 缺省变更器 =====
  设 计数 为 计数 + 1
  设 缺省组 为 造作用域层组()
  设 缺省层 为 缺省组.确保层(预设键)
  断言相等(缺省层.为空(), 真, "18 缺省建标准层")
  断言相等(缺省层.键, 预设键, "18b 层携带作用域键")
  断言相等(缺省组.层数(), 1, "18c 确保层已登记")
  断言相等(空变更(), 真, "18d 空变更可调用")
  打印 "OK #18-18d"

  打印 "作用域存储 判据通过：" + 转字符串(计数) + " 组"

主()
