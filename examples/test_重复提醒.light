# test_重复提醒.light —— 重复工具调用提醒守卫（模块 #23）反跑判据测试
# 对齐原版 packages/guard/repeat-tool-reminder：连续重复检测 + 阈值升级 + 通配 + 预览截断。
# 运行：python 运行.py examples/test_重复提醒.light
#
# 反跑判据：把任一「断言相等(实际, 期望, 标签)」的 期望 改成反向值，本测试必须立红
#          （抛出 断言失败），否则该判据无效。每条关键断言下方已注明反向改法。

从 重复提醒 导入 重复提醒器, 通配匹配, 校验阈值

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 加上 " 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望)

段落 含于 接收 文本, 子:
  如果 字符串包含(文本, 子) == 真:
    返回 真
  返回 假

段落 主:
  # ---- 用例1：默认阈值 [3,5,8]，第3次触发 GENTLE，第5次触发 DETAILED ----
  设 提醒器 为 新建 重复提醒器({})
  设 工具 为 "search"
  设 参 为 { "q": "hello" }
  设 r1 为 提醒器.观察(工具, 参, "a1")
  设 r2 为 提醒器.观察(工具, 参, "a1")
  设 r3 为 提醒器.观察(工具, 参, "a1")
  设 r4 为 提醒器.观察(工具, 参, "a1")
  设 r5 为 提醒器.观察(工具, 参, "a1")
  断言相等(r1, "", "用例1 第1次不提醒")
  断言相等(r2, "", "用例1 第2次不提醒")
  断言相等(含于(r3, "Carefully analyze the previous result"), 真, "用例1 第3次触发 GENTLE")
  断言相等(r4, "", "用例1 第4次不提醒")
  断言相等(含于(r5, "consecutive_calls: 5"), 真, "用例1 第5次触发 DETAILED 且含计数")
  断言相等(含于(r5, "- tool: search"), 真, "用例1 DETAILED 点名工具")
  # 反跑判据：把 r3 期望改 假 即红；把 r5 的 consecutive_calls: 5 改 3 即红

  # ---- 用例2：参数键序无关（仅键序不同判为相同调用）----
  设 r2a 为 提醒器.观察(工具, { "a": 1, "b": 2 }, "a2")
  设 r2b 为 提醒器.观察(工具, { "b": 2, "a": 1 }, "a2")
  设 r2c 为 提醒器.观察(工具, { "a": 1, "b": 2 }, "a2")
  断言相等(r2a, "", "用例2 键序无关-第1次空")
  断言相等(r2b, "", "用例2 键序无关-第2次空")
  断言相等(含于(r2c, "Carefully analyze"), 真, "用例2 键序无关-第3次触发 GENTLE")
  # 反跑判据：把 r2c 期望改 假 即红

  # ---- 用例3：参数值不同 → 计数列重置 ----
  设 隔离3 为 新建 重复提醒器({})
  设 r3a 为 隔离3.观察(工具, { "q": "A" }, "a3")
  设 r3b 为 隔离3.观察(工具, { "q": "A" }, "a3")
  设 r3c 为 隔离3.观察(工具, { "q": "A" }, "a3")
  断言相等(含于(r3c, "Carefully analyze"), 真, "用例3 第一组第3次触发 GENTLE")
  设 r3d 为 隔离3.观察(工具, { "q": "B" }, "a3")
  设 r3e 为 隔离3.观察(工具, { "q": "B" }, "a3")
  设 r3f 为 隔离3.观察(工具, { "q": "B" }, "a3")
  断言相等(r3d, "", "用例3 换参数后重置-第1次空")
  断言相等(r3e, "", "用例3 换参数后重置-第2次空")
  断言相等(含于(r3f, "Carefully analyze"), 真, "用例3 换参数后第3次再触发 GENTLE")
  # 反跑判据：把 r3d 期望改 含于(...,True) 即红

  # ---- 用例4：include 通配（仅匹配工具被跟踪）----
  设 仅bash 为 新建 重复提醒器({ "包含": ["bash_*"] })
  断言相等(仅bash.观察("read", { "x": 1 }, "b1"), "", "用例4 include 不匹配不跟踪-第1次")
  断言相等(仅bash.观察("read", { "x": 1 }, "b1"), "", "用例4 include 不匹配-第2次")
  断言相等(仅bash.观察("read", { "x": 1 }, "b1"), "", "用例4 include 不匹配-第3次仍空")
  断言相等(仅bash.观察("bash_run", { "x": 1 }, "b1"), "", "用例4 bash 第1次空")
  断言相等(仅bash.观察("bash_run", { "x": 1 }, "b1"), "", "用例4 bash 第2次空")
  断言相等(含于(仅bash.观察("bash_run", { "x": 1 }, "b1"), "Carefully analyze"), 真, "用例4 bash 第3次触发")
  # 反跑判据：把 bash 触发行 期望改 假 即红

  # ---- 用例5：exclude 通配（匹配工具透明）----
  设 排除ls 为 新建 重复提醒器({ "排除": ["ls"] })
  断言相等(排除ls.观察("ls", { "x": 1 }, "c1"), "", "用例5 exclude 匹配不跟踪-第1次")
  断言相等(排除ls.观察("ls", { "x": 1 }, "c1"), "", "用例5 exclude 第3次仍空")
  断言相等(排除ls.观察("read", { "x": 1 }, "c1"), "", "用例5 read 第1次空")
  断言相等(排除ls.观察("read", { "x": 1 }, "c1"), "", "用例5 read 第2次空")
  断言相等(含于(排除ls.观察("read", { "x": 1 }, "c1"), "Carefully analyze"), 真, "用例5 read 第3次触发")
  # 反跑判据：把 read 触发行 期望改 假 即红

  # ---- 用例6：阈值校验 fail-loud ----
  设 抛1 为 假
  尝试:
    校验阈值([1])
  捕获 错误:
    设 抛1 为 真
  结束。
  断言相等(抛1, 真, "用例6 阈值<2 抛错")
  设 抛2 为 假
  尝试:
    校验阈值([])
  捕获 错误:
    设 抛2 为 真
  结束。
  断言相等(抛2, 真, "用例6 空阈值抛错")
  设 抛3 为 假
  尝试:
    校验阈值([3, 3])
  捕获 错误:
    设 抛3 为 真
  结束。
  断言相等(抛3, 真, "用例6 重复阈值抛错")
  断言相等(校验阈值([6, 3, 9]), [3, 6, 9], "用例6 阈值升序去重排序")
  # 反跑判据：把 [3,6,9] 期望改 [6,3,9] 即红

  # ---- 用例7：预览截断（长参数在 DETAILED 提醒里被截断并标注 +N more chars）----
  设 长串 为 ""
  设 k 为 0
  当 k < 600:
    设 长串 为 长串 加上 "X"
    设 k 为 k + 1
  结束。
  设 长参 为 { "body": 长串 }
  设 提醒长 为 新建 重复提醒器({})
  设 _a 为 提醒长.观察("write", 长参, "d1")
  设 _b 为 提醒长.观察("write", 长参, "d1")
  设 _c 为 提醒长.观察("write", 长参, "d1")
  设 _d 为 提醒长.观察("write", 长参, "d1")
  设 _e 为 提醒长.观察("write", 长参, "d1")
  断言相等(含于(_c, "Carefully analyze"), 真, "用例7 第3次触发 GENTLE")
  断言相等(_d, "", "用例7 第4次不提醒")
  断言相等(含于(_e, "more chars"), 真, "用例7 第5次 DETAILED 含截断预览标注")
  # 反跑判据：把 more chars 期望改 假 即红

  # ---- 用例8：代理隔离（不同代理独立计链）----
  设 隔离 为 新建 重复提醒器({})
  断言相等(隔离.观察(工具, 参, "agentX"), "", "用例8 X第1次空")
  断言相等(隔离.观察(工具, 参, "agentX"), "", "用例8 X第2次空")
  断言相等(含于(隔离.观察(工具, 参, "agentX"), "Carefully analyze"), 真, "用例8 X第3次触发")
  断言相等(隔离.观察(工具, 参, "agentY"), "", "用例8 Y独立计链-第1次空")
  # 反跑判据：把 agentY 行 期望改 含于(...,True) 即红

  # ---- 用例9：重置打断循环 ----
  设 重置器 为 新建 重复提醒器({})
  断言相等(重置器.观察(工具, 参, "z1"), "", "用例9 第1次空")
  断言相等(重置器.观察(工具, 参, "z1"), "", "用例9 第2次空")
  断言相等(含于(重置器.观察(工具, 参, "z1"), "Carefully analyze"), 真, "用例9 第3次触发")
  重置器.重置("z1")
  断言相等(重置器.观察(工具, 参, "z1"), "", "用例9 重置后第1次空")
  断言相等(重置器.观察(工具, 参, "z1"), "", "用例9 重置后第2次空")
  断言相等(含于(重置器.观察(工具, 参, "z1"), "Carefully analyze"), 真, "用例9 重置后第3次再触发")
  # 反跑判据：把 重置后第1次 期望改 含于(...,True) 即红

  # ---- 用例10：通配匹配单测（纯光明递归，不依赖 python re）----
  断言相等(通配匹配("mcp_*", "mcp_files"), 真, "用例10 mcp_* 匹配 mcp_files")
  断言相等(通配匹配("mcp_*", "fs"), 假, "用例10 mcp_* 不匹配 fs")
  断言相等(通配匹配("*", "anything"), 真, "用例10 * 匹配任意")
  断言相等(通配匹配("a*", "ab"), 真, "用例10 a* 匹配 ab")
  断言相等(通配匹配("a*b", "axxb"), 真, "用例10 a*b 匹配 axxb")
  断言相等(通配匹配("a*b", "axc"), 假, "用例10 a*b 不匹配 axc")
  断言相等(通配匹配("foo", "foo"), 真, "用例10 字面量相等")
  断言相等(通配匹配("foo", "fo"), 假, "用例10 字面量不等")
  # 反跑判据：把 任一 真 改 假 / 假 改 真 即红

  打印 "--- 重复工具提醒守卫（模块23）测试通过 ---"

主()
