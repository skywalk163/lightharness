# test_T0173_B1令牌折叠.light —— T-0173 B1 项#3：令牌计量折叠回归
# 运行：python 运行.py examples/test_T0173_B1令牌折叠.light
#
# 反跑判据（改反任一期望必须红）：
#   §1 plan/commit：把 追加目标 / 替换增量 / 非法区间抛错 任一改反必须红
#   §2 O(1) 折叠：把 追加增量 / 压缩武装声明 / 替换消费声明 / 无声明零增量 / 声明不符抛错 任一改反必须红
#   §3 语境拆解：把 系统提示保留 / 工具来自请求头 / 压缩遮蔽系统 / 替换移除旧系统 任一改反必须红

从 令牌计量 导入 规划表面令牌, 提交表面令牌, 折叠表面投影, 建语境拆解状态, 应用语境拆解, 估算消息
从 内置核心列表 导入 列表长度

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 信息 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 信息):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 信息)

段落 期望抛错(调用):
  尝试:
    调用()
    返回 假
  捕获 错误 为 e:
    返回 真

段落 造用户消息(序号, 文本):
  返回 ["类型": "user/message", "序号": 序号, "surfaceOp": "append", "数据": ["role": "user", "content": [["type": "text", "text": 文本]]]]

段落 造系统提示(序号, 文本, 操作):
  返回 ["类型": "system/message", "序号": 序号, "surfaceOp": 操作, "数据": ["系统": 文本]]

段落 主:
  # ============ §1 plan/commit 两段式 ============
  设 节点表 为 []
  设 甲 为 造用户消息(1, "ab")
  设 计划甲 为 规划表面令牌(节点表, 甲)
  断言相等(计划甲["目标"], "append", "§1 追加目标=append")
  断言相等(计划甲["增量令牌"], 计划甲["令牌"], "§1 追加增量==令牌")
  提交表面令牌(节点表, 计划甲)
  断言相等(列表长度(节点表), 1, "§1 提交后 1 节点")
  断言相等(节点表[0]["序号"], 1, "§1 节点序号=1")

  # 追加第二条，再替换 [1,2] 区间
  设 乙 为 造用户消息(2, "cd")
  提交表面令牌(节点表, 规划表面令牌(节点表, 乙))
  断言相等(列表长度(节点表), 2, "§1 两条节点")
  设 旧和 为 节点表[0]["启发式令牌"] + 节点表[1]["启发式令牌"]
  设 丙 为 ["类型": "user/message", "序号": 3, "surfaceOp": ["startSeq": 1, "endSeq": 2], "数据": ["role": "user", "content": [["type": "text", "text": "efgh"]]]]
  设 计划丙 为 规划表面令牌(节点表, 丙)
  断言相等(计划丙["目标"]["起序"], 0, "§1 替换起点序=0")
  断言相等(计划丙["目标"]["止序"], 1, "§1 替换终点序=1")
  断言相等(计划丙["增量令牌"], 计划丙["令牌"] - 旧和, "§1 替换增量=新-旧和")
  提交表面令牌(节点表, 计划丙)
  断言相等(列表长度(节点表), 1, "§1 替换后剩 1 节点")
  断言相等(节点表[0]["序号"], 3, "§1 替换后节点序号=3")

  # 非法区间抛错（日志损坏，必须响亮失败）
  段落 坏区间():
    返回 规划表面令牌([], ["类型": "user/message", "序号": 9, "surfaceOp": ["startSeq": 9, "endSeq": 9], "数据": ["role": "user", "content": [["type": "text", "text": "x"]]]])
  断言真(期望抛错(坏区间), "§1 非法区间抛错")

  # ============ §2 O(1) 折叠 ============
  设 压缩 为 ["类型": "compaction/summary", "序号": 5, "数据": ["shadowedSeqs": [1, 2], "shadowedRange": ["start": 1, "end": 2], "shadowedTokenCount": 30]]

  # 追加：增量==令牌，声明清空
  设 折叠 为 折叠表面投影(空, 甲)
  断言相等(折叠["增量令牌"], 估算消息(甲["数据"]), "§2 追加增量==令牌")
  断言相等(折叠["声明"], 空, "§2 追加后声明清空")

  # 压缩事件武装声明
  设 武装 为 折叠表面投影(空, 压缩)
  断言相等(武装["增量令牌"], 0, "§2 压缩增量=0")
  断言相等(武装["声明"]["起"], 1, "§2 声明起=1")
  断言相等(武装["声明"]["止"], 2, "§2 声明止=2")
  断言相等(武装["声明"]["令牌"], 30, "§2 声明令牌=30")

  # 替换消费声明：增量 = 新令牌 - 声明.令牌
  设 替身 为 ["类型": "user/message", "序号": 6, "surfaceOp": ["startSeq": 1, "endSeq": 2], "数据": ["role": "user", "content": [["type": "text", "text": "efgh"]]]]
  设 消费 为 折叠表面投影(武装["声明"], 替身)
  断言相等(消费["增量令牌"], 估算消息(替身["数据"]) - 30, "§2 替换消费声明增量")
  断言相等(消费["声明"], 空, "§2 替换后声明清空")

  # 无声明的替换：零增量（容忍历史漂移）
  设 无声明替换 为 折叠表面投影(空, 替身)
  断言相等(无声明替换["增量令牌"], 0, "§2 无声明替换零增量")

  # 声明区间不符：抛错（相邻事件矛盾，必须响亮失败）
  段落 声明不符():
    设 错声明 为 ["起": 7, "止": 8, "令牌": 10]
    返回 折叠表面投影(错声明, 替身)
  断言真(期望抛错(声明不符), "§2 声明区间不符抛错")

  # 非表面事件：零增量、声明清空
  设 非表面 为 折叠表面投影(空, ["类型": "turn/start", "序号": 9, "数据": 空])
  断言相等(非表面["增量令牌"], 0, "§2 非表面零增量")
  断言相等(非表面["声明"], 空, "§2 非表面声明清空")

  # ============ §3 语境拆解投影 ============
  设 状态 为 建语境拆解状态()
  断言相等(状态["拆解"]["系统令牌"], 0, "§3 初值系统=0")
  断言相等(状态["拆解"]["消息令牌"], 0, "§3 初值消息=0")
  断言相等(状态["拆解"]["工具令牌"], 0, "§3 初值工具=0")

  # 系统提示 append：保留、按序、计入系统令牌
  设 状态 为 应用语境拆解(状态, 造系统提示(1, "你是助手", "append"))
  断言相等(列表长度(状态["系统"]), 1, "§3 系统提示 1 条")
  断言相等(状态["系统"][0]["序号"], 1, "§3 系统序号=1")
  断言相等(状态["拆解"]["系统令牌"], 状态["系统"][0]["令牌"], "§3 系统令牌=节点价")
  断言相等(状态["拆解"]["消息令牌"], 0, "§3 仅系统无消息")

  # 用户消息 append：系统不变，表面总额累加，消息令牌 = 总额 - 系统
  设 状态 为 应用语境拆解(状态, 造用户消息(2, "你好"))
  断言相等(列表长度(状态["系统"]), 1, "§3 系统仍 1 条")
  断言相等(状态["拆解"]["消息令牌"], 状态["表面令牌"] - 状态["拆解"]["系统令牌"], "§3 消息令牌=总额-系统")

  # 请求头：工具价来自 工具模式
  设 头 为 ["类型": "request/header", "序号": 3, "数据": ["工具模式": [["name": "搜索", "parameters": {}]]]]
  设 状态 为 应用语境拆解(状态, 头)
  断言真(状态["拆解"]["工具令牌"] > 0, "§3 工具令牌>0")

  # 压缩事件武装声明（遮蔽系统序号 1）
  设 状态 为 应用语境拆解(状态, 压缩)
  断言相等(状态["声明"]["系统序号表"], [1], "§3 声明遮蔽系统序号=[1]")

  # 替换消费声明（用 user/message，不能用 system 顶替被计量区间）：旧系统被遮蔽移除
  #   表面总额夹断到 0（对齐上游 Math.max(0, ...)），本例声明价大于真实表面故夹为 0
  设 旧总额 为 状态["表面令牌"]
  设 状态 为 应用语境拆解(状态, 替身)
  断言相等(列表长度(状态["系统"]), 0, "§3 替换后旧系统被遮蔽移除")
  设 期望总额 为 旧总额 + 估算消息(替身["数据"]) - 30
  如果 期望总额 < 0:
    设 期望总额 为 0
  断言相等(状态["表面令牌"], 期望总额, "§3 替换后总额=旧+新-声明(夹位0)")
  断言相等(状态["声明"], 空, "§3 替换后声明清空")

  打印("--- T-0173 B1 项#3 令牌折叠 测试通过 ---")

主()
