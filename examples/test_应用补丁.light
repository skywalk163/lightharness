# test_应用补丁.light —— 0.2.2-rc.1 增量移植判据（fs-patch 解析 + 应用）
# 运行：python 运行.py examples/test_应用补丁.light
# 上游：packages/fs/fs-patch/src/{parse,apply}.ts + tests/{parse,apply}.spec.ts（Codex rust-v0.158.0）
#
# 反跑判据（改反源码任一期望必须红）：
#   A. 补丁读更新 里 @@ 锚点截取位 3 -> 4        -> 锚点用例红
#   B. 补丁定位序列 去掉第 3 遍（去首尾空白）      -> 空白容忍用例红
#   C. 应用补丁块 末尾补空行那步删掉              -> 所有 after 断言红

从 应用补丁 导入 解析补丁, 应用补丁块

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言抛含(待测段落, 片段, 标签):
  设 已抛 为 假
  尝试:
    待测段落()
  捕获 异常 为 异常值:
    设 已抛 为 真
    设 报文 为 转字符串(异常值)
    如果 字符串包含(报文, 片段) == 假:
      抛出 新建 错误("断言抛含失败: " + 标签 + " 报文=" + 报文)
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛: " + 标签)

# 造补丁：首尾标记 + 体
段落 造补丁(体表):
  设 全表 为 ["*** Begin Patch"]
  遍历 行 之 体表:
    列表追加(全表, 行)
  列表追加(全表, "*** End Patch")
  返回 连接字符串(全表, "\n")

# 造单文件更新块表
段落 造块(体表):
  设 全表 为 ["*** Update File: a"]
  遍历 行 之 体表:
    列表追加(全表, 行)
  设 操作表 为 解析补丁(造补丁(全表))
  返回 列表获取(操作表, 0)["块表"]

# 抛错包装：光明不支持匿名「段落() 返回 …」，用具名段落承载
段落 抛缺首标记():
  解析补丁("*** Add File: a")

段落 抛缺尾标记():
  解析补丁("*** Begin Patch\n*** Add File: a")

段落 抛未知头():
  解析补丁(造补丁(["*** Bogus File: a"]))

段落 抛环境头():
  解析补丁(造补丁(["*** Environment ID: x"]))

段落 主程():
  # ===== 一、解析 =====

  # 1. 顺序 / 重复路径 / move / 行号 / 内容
  设 综合体 为 ["*** Add File: dir/a.txt", "+hello", "+", "*** Update File: dir/a.txt", "*** Move to: dir/b.txt", "@@ hello", "-hello", "+hi", "+there", " same", "-same", "+same", "@@", " last", "+tail", "*** End of File", "*** Delete File: /tmp/obsolete", "*** Add File: dir/a.txt"]
  设 综合 为 解析补丁(造补丁(综合体))
  断言相等(列表长度(综合), 4, "综合操作数")
  断言相等(列表获取(综合, 0)["种类"], "新增", "0 种类")
  断言相等(列表获取(综合, 0)["路径"], "dir/a.txt", "0 路径")
  断言相等(列表获取(综合, 0)["行号"], 2, "0 行号")
  断言相等(列表获取(综合, 0)["内容"], "hello\n\n", "0 内容")
  断言相等(列表获取(综合, 1)["种类"], "更新", "1 种类")
  断言相等(列表获取(综合, 1)["移动至"], "dir/b.txt", "1 移动至")
  断言相等(列表长度(列表获取(综合, 1)["块表"]), 2, "1 块数")
  设 块一 为 列表获取(列表获取(综合, 1)["块表"], 0)
  断言相等(块一["行号"], 7, "1.0 行号")
  断言相等(块一["锚点"], "hello", "1.0 锚点")
  断言相等(块一["旧行"], ["hello", "same", "same"], "1.0 旧行")
  断言相等(块一["新行"], ["hi", "there", "same", "same"], "1.0 新行")
  断言相等(块一["文末"], 假, "1.0 文末")
  设 块二 为 列表获取(列表获取(综合, 1)["块表"], 1)
  断言相等(块二["行号"], 14, "1.1 行号")
  断言相等(块二["锚点"], 空, "1.1 无锚点")
  断言相等(块二["旧行"], ["last"], "1.1 旧行")
  断言相等(块二["新行"], ["last", "tail"], "1.1 新行")
  断言相等(块二["文末"], 真, "1.1 文末")
  断言相等(列表获取(综合, 2)["种类"], "删除", "2 种类")
  断言相等(列表获取(综合, 2)["路径"], "/tmp/obsolete", "2 路径")
  断言相等(列表获取(综合, 3)["内容"], "", "3 空内容")

  # 2. 空补丁 / 空创建
  断言相等(列表长度(解析补丁(造补丁([]))), 0, "空补丁")
  设 空创建 为 解析补丁(造补丁(["*** Add File: empty"]))
  断言相等(列表获取(空创建, 0)["内容"], "", "空创建内容")

  # 3. heredoc 三种包装（路径与内容原样，不做 shell 求值）
  设 包装表 为 ["<<EOF", "<<'EOF'", "<<\"EOF\""]
  遍历 包装 之 包装表:
    设 内补 为 造补丁(["*** Add File: $(touch sentinel)", "+`literal` $HOME"])
    设 包装文 为 "\n" + 包装 + "\n" + 内补 + "\nEOF\n"
    设 包装果 为 解析补丁(包装文)
    断言相等(列表长度(包装果), 1, "包装操作数 " + 包装)
    断言相等(列表获取(包装果, 0)["路径"], "$(touch sentinel)", "包装路径 " + 包装)
    断言相等(列表获取(包装果, 0)["行号"], 4, "包装行号 " + 包装)
    断言相等(列表获取(包装果, 0)["内容"], "`literal` $HOME\n", "包装内容 " + 包装)

  # 4. CRLF 归一
  设 CRLF体 为 造补丁(["*** Add File: a", "+a", "+b"])
  设 CRLF文 为 替换字符串(CRLF体, "\n", "\r\n")
  设 CRLF果 为 解析补丁(CRLF文)
  断言相等(列表获取(CRLF果, 0)["内容"], "a\nb\n", "CRLF 内容")

  # 5. 保留内容空白；裸空行当上下文
  设 空白体 为 造补丁(["*** Update File: a", "-a\t ", "+b  ", "", " \t", "@@ anchor  ", "+c"])
  设 空白块 为 列表获取(解析补丁(空白体), 0)["块表"]
  设 空白块一 为 列表获取(空白块, 0)
  断言相等(空白块一["旧行"], ["a\t ", "", "\t"], "空白旧行")
  断言相等(空白块一["新行"], ["b  ", "", "\t"], "空白新行")
  设 空白块二 为 列表获取(空白块, 1)
  断言相等(空白块二["行号"], 7, "空白二行号")
  断言相等(空白块二["锚点"], "anchor", "空白二锚点")
  断言相等(空白块二["新行"], ["c"], "空白二新行")

  # 6. 隐式首块（空行 / 空格 / + / - 开头都算首块）
  设 隐式表 为 ["", " ", "+new", "-old"]
  遍历 隐式 之 隐式表:
    设 体 为 ["*** Update File: a"]
    列表追加(体, 隐式)
    设 块表 为 列表获取(解析补丁(造补丁(体)), 0)["块表"]
    断言相等(列表获取(块表, 0)["行号"], 3, "隐式首块行号 " + 隐式)

  # 7. 缩进后的补丁标记算上下文
  设 标记表 为 ["*** Add File: b", "*** Delete File: c", "*** Update File: d", "*** End Patch", "*** Move to: e", "*** End of File", "@@", "*** Environment ID: e"]
  设 缩进体 为 ["*** Update File: a"]
  遍历 行 之 标记表:
    列表追加(缩进体, " " + 行)
  设 缩进块 为 列表获取(列表获取(解析补丁(造补丁(缩进体)), 0)["块表"], 0)
  断言相等(缩进块["旧行"], 标记表, "缩进旧行")
  断言相等(缩进块["新行"], 标记表, "缩进新行")

  # 8. 语法错误：缺首标记 / 缺尾标记 / 未知行
  断言抛含(抛缺首标记, "期望 *** Begin Patch", "缺首标记")
  断言抛含(抛缺尾标记, "期望 *** End Patch", "缺尾标记")
  断言抛含(抛未知头, "期望 Add File", "未知头")
  断言抛含(抛环境头, "不支持 Environment ID", "环境头")

  # ===== 二、应用 =====

  # 1. 多块都在原文里搜索
  设 果一 为 应用补丁块("foo\nbar\nbaz\nqux\n", 造块(["@@", " foo", "-bar", "+BAR", "@@", " baz", "-qux", "+QUX"]))
  断言相等(果一["后文本"], "foo\nBAR\nbaz\nQUX\n", "多块")

  # 2. 交错替换 + EOF 追加
  设 果二 为 应用补丁块("a\nb\nc\nd\ne\nf\n", 造块(["@@", " a", "-b", "+B", "@@", " c", " d", "-e", "+E", "@@", " f", "+g", "*** End of File"]))
  断言相等(果二["后文本"], "a\nB\nc\nd\nE\nf\ng\n", "交错+EOF")

  # 3. 纯追加在前、删除在后（同起点保序）
  设 果三 为 应用补丁块("line1\nline2\nline3\n", 造块(["@@", "+after-context", "+second-line", "@@", " line1", "-line2", "-line3", "+line2-replacement"]))
  断言相等(果三["后文本"], "line1\nline2-replacement\nafter-context\nsecond-line\n", "追加先于删除")

  # 4. ASCII 补丁匹配 Unicode 破折号
  设 果四 为 应用补丁块("import asyncio  # local import – avoids top‑level dep\n", 造块(["-import asyncio  # local import - avoids top-level dep", "+import asyncio  # HELLO"]))
  断言相等(果四["后文本"], "import asyncio  # HELLO\n", "Unicode 破折号")

  # 5. 首行替换 / 末行替换
  设 果五 为 应用补丁块("foo\nbar\nbaz\n", 造块(["-foo", "+FOO", " bar"]))
  断言相等(果五["后文本"], "FOO\nbar\nbaz\n", "首行替换")
  设 果六 为 应用补丁块("foo\nbar\nbaz\n", 造块([" foo", " bar", "-baz", "+BAZ"]))
  断言相等(果六["后文本"], "foo\nbar\nBAZ\n", "末行替换")

  # 6. 纯插入（EOF 标记 / 空文件 / 未终结末行 / 单换行文件）
  设 果七 为 应用补丁块("foo\nbar\nbaz\n", 造块(["+quux", "*** End of File"]))
  断言相等(果七["后文本"], "foo\nbar\nbaz\nquux\n", "EOF 纯插入")
  设 果八 为 应用补丁块("", 造块(["+hello"]))
  断言相等(果八["后文本"], "hello\n", "空文件插入")
  设 果九 为 应用补丁块("hello", 造块(["+world"]))
  断言相等(果九["后文本"], "hello\nworld\n", "未终结末行插入")
  设 果十 为 应用补丁块("hello\n\n", 造块(["+world"]))
  断言相等(果十["后文本"], "hello\nworld\n", "末空行前插入")
  设 果十一 为 应用补丁块("\n", 造块(["+hello"]))
  断言相等(果十一["后文本"], "hello\n", "单换行文件插入")

  # 7. 精确序列 / 空白容忍 / 优先级
  设 果十二 为 应用补丁块("foo\nbar\nbaz\n", 造块(["-bar", "-baz", "+done"]))
  断言相等(果十二["后文本"], "foo\ndone\n", "精确序列")
  设 果十三 为 应用补丁块("foo   \nbar\t\t\n", 造块(["-foo\t", "-bar ", "+done"]))
  断言相等(果十三["后文本"], "done\n", "去尾空白容忍")
  设 果十四 为 应用补丁块("    foo   \n   bar\t\n", 造块(["- foo", "-bar", "+done"]))
  断言相等(果十四["后文本"], "done\n", "去首尾空白容忍")
  设 果十五 为 应用补丁块("x \nx\n", 造块(["-x", "+X"]))
  断言相等(果十五["后文本"], "x \nX\n", "精确优先")
  设 果十六 为 应用补丁块(" x\nx \n", 造块(["-x", "+X"]))
  断言相等(果十六["后文本"], " x\nX\n", "去尾优先于去首尾")
  设 果十七 为 应用补丁块("x–y\n x-y \n", 造块(["-x-y", "+X"]))
  断言相等(果十七["后文本"], "x–y\nX\n", "去首尾优先于标点")

  # 8. 顺序游标：重复序列各取首个剩余
  设 果十八 为 应用补丁块("x\nx\nx\n", 造块(["-x", "+first", "@@", "-x", "+second"]))
  断言相等(果十八["后文本"], "first\nsecond\nx\n", "重复序列游标")

  # 9. 锚点推进 / 重复锚点 / 锚点标点容错
  设 果十九 为 应用补丁块("fn a\nx\nfn b\nx\n", 造块(["@@ fn b", "-x", "+X"]))
  断言相等(果十九["后文本"], "fn a\nx\nfn b\nX\n", "锚点推进")
  设 果二十 为 应用补丁块("fn\nx\nfn\nx\n", 造块(["@@ fn", "-x", "+first", "@@ fn", "-x", "+second"]))
  断言相等(果二十["后文本"], "fn\nfirst\nfn\nsecond\n", "重复锚点")
  设 果二一 为 应用补丁块("fn “a”\nx\n", 造块(["@@ fn \"a\"", "-x", "+X"]))
  断言相等(果二一["后文本"], "fn “a”\nX\n", "锚点标点容错")

  # 10. 纯删除 / 删到空 / 补末尾换行
  设 果二二 为 应用补丁块("a\nb\nc\n", 造块(["-b"]))
  断言相等(果二二["后文本"], "a\nc\n", "纯删除")
  设 果二三 为 应用补丁块("a\n", 造块(["-a"]))
  断言相等(果二三["后文本"], "", "删到空文本")
  设 果二四 为 应用补丁块("a", 造块(["-a", "+b"]))
  断言相等(果二四["后文本"], "b\n", "补末尾换行")

  # 11. EOF 优先尾部 / 可回退到游标之前
  设 果二五 为 应用补丁块("x\nx \n", 造块(["-x", "+X", "*** End of File"]))
  断言相等(果二五["后文本"], "x\nX\n", "EOF 优先尾部")

  # 12. 失败形状：阶段 / 块行号 / 搜索起点
  设 失一 为 应用补丁块("one\n", 造块(["-too", "-many", "-lines"]))
  断言相等(失一["成功"], 假, "失败-模式过长")
  断言相等(失一["失败"]["阶段"], "旧行", "失败-阶段")
  断言相等(失一["失败"]["块行号"], 3, "失败-块行号")
  设 失二 为 应用补丁块("fn\na\n", 造块(["@@ fn", "-missing", "+b"]))
  断言相等(失二["失败"]["阶段"], "旧行", "失败-锚点后旧行")
  断言相等(失二["失败"]["搜索起点"], 1, "失败-搜索起点")
  设 失三 为 应用补丁块("a\n", 造块(["@@ missing", "-a", "+b"]))
  断言相等(失三["失败"]["阶段"], "锚点", "失败-锚点")

  # 13. CRLF：未触碰行保留 CR
  设 果二六 为 应用补丁块("a\r\nb\r\n", 造块(["-a", "+A"]))
  断言相等(果二六["后文本"], "A\nb\r\n", "CRLF 保留")

  写 "--- 测试 应用补丁 通过 ---"

主程()
