# test_插件注册表.light —— R101 任务D 新卡 #243 插件注册表解析 测试
#
# 覆盖：
#   1) 选首个响应注册表：三个源，第一个不可达第二个可达 → 选中第二个（顺序敏感）
#   2) 造安装规格：成功路径（取 latest / 精确版本）
#   3) 反例：全注册表不可达 → 返回空不抛；版本无解 → version-unresolved
#   4) 归类安装失败：network→registry-unreachable, no-matching-version→version-unresolved,
#      integrity→integrity-mismatch, disk-full→write-denied, pnpm-missing→unknown
#   5) 推导启停后清单：启用/禁用/装/卸四操作合成新清单 + 变更说明
#
# 反跑点（改反即红）：
#   反跑1：选首个响应注册表 里「首个可达即返回」改成「选延迟最小」→ 用例1 顺序敏感立红
#   反跑2：造安装规格 里 version-unresolved 分支删掉 → 用例3b 版本无解落到错误分支立红
#   反跑3：归类安装失败 里 integrity-mismatch 分支删掉 → integrity 落 unknown 立红
#   反跑4：推导启停后清单 里「卸=删条目」改成「保留」→ 用例5 卸后清单无此包立红
#
# 运行：cd lightharness && python 运行.py examples/test_插件注册表.light

从 插件注册表 导入 选首个响应注册表, 造安装规格, 归类安装失败, 推导启停后清单

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败: " + 标签)

# ---- 探测可达桩：按预置表返回延迟或空 ----
类 探测桩:
  属性 表 等于 []
  段落 构造(表):
    己.表 为 表
  段落 探测(网址):
    遍历 项 之 己.表:
      如果 项[0] == 网址:
        返回 项[1]
    返回 空

# ---- 读注册表元数据桩：按 URL+包名返回预置元数据 ----
类 元数据桩:
  属性 表 等于 {}
  段落 构造(表):
    己.表 为 表
  段落 读取(URL, 包名):
    设 键 为 URL + "|" + 包名
    如果 字典包含键(己.表, 键):
      返回 己.表[键]
    返回 空

段落 主:
  # ============ 1) 选首个响应注册表：顺序敏感 ============
  设 源表 为 ["https://bad.example.com/", "https://registry.npmmirror.com/", "https://registry.npmjs.org/"]
  # 配置：bad 不可达(空)，npmmirror 可达 200ms，npmjs 可达 50ms（更快但排第二）
  设 探测表 为 [
    ["https://bad.example.com/", 空],
    ["https://registry.npmmirror.com/", 200],
    ["https://registry.npmjs.org/", 50]
  ]
  设 探针 为 新建 探测桩(探测表)
  设 选中 为 选首个响应注册表(源表, 探针.探测)
  # 反跑点1：若改成「选最快」会返回 npmjs（50ms），此处断言 npmmirror 立红
  断言等于(选中, "https://registry.npmmirror.com/", "首个可达胜出（不比较延迟大小）")

  # 全不可达 → 返回空不抛
  设 全坏表 为 ["https://a.example.com/", "https://b.example.com/"]
  设 空探针 为 新建 探测桩([])
  设 抛全坏 为 假
  设 结果全坏 为 空
  尝试:
    设 结果全坏 为 选首个响应注册表(全坏表, 空探针.探测)
  捕获 异常 e:
    设 抛全坏 为 真
  断言真(抛全坏 == 假, "全不可达不抛")
  断言等于(结果全坏, 空, "全不可达返回空")

  # ============ 2) 造安装规格：成功路径 ============
  设 元 为 {
    "dist-tags": {"latest": "1.2.0"},
    "versions": {
      "1.2.0": {"dist": {"shasum": "abc123"}},
      "1.1.0": {"dist": {"shasum": "def456"}}
    }
  }
  设 桩 为 新建 元数据桩({"https://r1/|my-plugin": 元})
  设 规格1 为 造安装规格("my-plugin", "", "https://r1/", 桩.读取)
  断言等于(规格1["错误"], 空, "无约束取 latest 成功")
  断言等于(规格1["解析后版本"], "1.2.0", "latest=1.2.0")
  断言等于(规格1["完整性哈希"], "abc123", "完整性哈希透传")
  断言等于(规格1["来源URL"], "https://r1/", "来源URL透传")

  设 规格2 为 造安装规格("my-plugin", "1.1.0", "https://r1/", 桩.读取)
  断言等于(规格2["错误"], 空, "精确版本 1.1.0 成功")
  断言等于(规格2["解析后版本"], "1.1.0", "精确版本=1.1.0")
  断言等于(规格2["完整性哈希"], "def456", "1.1.0 shasum")

  # ============ 3) 反例：元数据缺失 / 版本无解 ============
  设 空桩 为 新建 元数据桩({})
  设 规格3 为 造安装规格("ghost", "", "https://r1/", 空桩.读取)
  断言等于(规格3["错误"], "registry-unreachable", "元数据缺失→registry-unreachable")

  设 规格4 为 造安装规格("my-plugin", "9.9.9", "https://r1/", 桩.读取)
  断言等于(规格4["错误"], "version-unresolved", "版本无解→version-unresolved（反跑2）")

  # ============ 4) 归类安装失败 ============
  断言等于(归类安装失败({"种类": "network", "文案": "x"})["类别"], "registry-unreachable", "network→registry-unreachable")
  断言等于(归类安装失败({"种类": "timeout", "文案": "x"})["类别"], "registry-unreachable", "timeout→registry-unreachable")
  断言等于(归类安装失败({"种类": "no-matching-version", "文案": "x"})["类别"], "version-unresolved", "no-matching-version→version-unresolved")
  断言等于(归类安装失败({"种类": "not-found", "文案": "x"})["类别"], "version-unresolved", "not-found→version-unresolved")
  断言等于(归类安装失败({"种类": "integrity", "文案": "x"})["类别"], "integrity-mismatch", "integrity→integrity-mismatch（反跑3）")
  断言等于(归类安装失败({"种类": "disk-full", "文案": "x"})["类别"], "write-denied", "disk-full→write-denied")
  断言等于(归类安装失败({"种类": "permission", "文案": "x"})["类别"], "write-denied", "permission→write-denied")
  断言等于(归类安装失败({"种类": "pnpm-missing", "文案": "x"})["类别"], "unknown", "pnpm-missing→unknown")

  # ============ 5) 推导启停后清单 ============
  设 当前 为 {"a": {"启用": 真, "版本": "1.0.0"}, "b": {"启用": 假, "版本": "2.0.0"}}
  设 操作 为 [["启用", "b"], ["禁用", "a"], ["装", "c", "3.0.0"], ["卸", "b"]]
  设 推导 为 推导启停后清单(当前, 操作)
  设 新清单 为 推导["新清单"]
  断言真(字典包含键(新清单, "a"), "a 仍在清单")
  断言等于(新清单["a"]["启用"], 假, "a 被禁用")
  断言等于(新清单["a"]["版本"], "1.0.0", "a 版本不变")
  断言真(字典包含键(新清单, "c"), "c 新装在清单")
  断言等于(新清单["c"]["启用"], 真, "c 默认启用")
  断言等于(新清单["c"]["版本"], "3.0.0", "c 版本=3.0.0")
  # 反跑点4：若「卸 b」不删条目，b 仍在清单立红
  断言真(字典包含键(新清单, "b") == 假, "b 被卸载（从清单删除）")
  断言等于(长度(推导["变更"]), 4, "4 条变更说明")

  打印 "--- 插件注册表测试通过 ---"

主()
