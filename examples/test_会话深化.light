# test_会话深化.light —— 会话 v2：查询事件 + 投影统计
从 会话 导入 会话, 新建会话
从 消息 导入 造文本块, 造用户消息, 造助手消息, 造工具调用块, 造工具结果消息

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # 构造会话并记录事件：turn/start(0), user(1), assistant(2), tool/call(3), tool/result(4), turn/end(5)
  设 会话对象 为 新建会话("sess_v2", "G:\\测试v2")
  会话对象.记录轮次开始()
  设 用户消息 为 造用户消息([造文本块("你好")])
  会话对象.记录事件("user/message", 用户消息)
  设 助手消息 为 造助手消息([造文本块("我是助手"), 造文本块("第二块")], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 助手消息, "重放": 空])
  设 调用 为 造工具调用块("call_1", "查天气", "{\"城市\": \"济宁\"}")
  会话对象.记录事件("tool/call", 调用)
  设 结果消息 为 造工具结果消息("call_1", [造文本块("晴")], 假)
  会话对象.记录工具结果(调用, 结果消息, 真)
  会话对象.记录轮次结束("completed", 空)
  断言等于(会话对象.事件数(), 6, "共6个事件")

  # ===== #1 查询事件 =====
  打印 "=== 查询事件测试 ==="

  # 1a. 按类型过滤
  设 轮次事件 为 会话对象.查询事件("turn/start", 0, 0)
  断言等于(长度(轮次事件), 1, "turn/start 类型1条")
  断言等于(轮次事件[0]["序号"], 0, "turn/start 序号0")

  # 1b. 按序号范围过滤（类型为空不过滤类型）
  设 范围事件 为 会话对象.查询事件("", 1, 3)
  断言等于(长度(范围事件), 3, "序号1-3共3条")
  断言等于(范围事件[0]["序号"], 1, "范围首条序号1")
  断言等于(范围事件[2]["序号"], 3, "范围末条序号3")

  # 1c. 类型+序号组合过滤
  设 组合事件 为 会话对象.查询事件("user/message", 0, 5)
  断言等于(长度(组合事件), 1, "user/message 在0-5范围内1条")
  设 组合空 为 会话对象.查询事件("user/message", 3, 5)
  断言等于(长度(组合空), 0, "user/message 在3-5范围内0条")

  # 1d. 类型为空不过滤类型，序号为0不限制
  设 全部事件 为 会话对象.查询事件("", 0, 0)
  断言等于(长度(全部事件), 6, "空类型+0序号=全部6条")

  # 1e. 开始序号为0不限制下限，结束序号限制上限
  设 上限事件 为 会话对象.查询事件("", 0, 2)
  断言等于(长度(上限事件), 3, "序号0-2共3条")

  # 1f. 结束序号为0不限制上限
  设 下限事件 为 会话对象.查询事件("", 4, 0)
  断言等于(长度(下限事件), 2, "序号4-5共2条")

  打印 "  查询事件全部通过"

  # ===== #2 投影统计 =====
  打印 "=== 投影统计测试 ==="

  # surface 消息：user(1块) + assistant(2块) + tool/result(1块) = 3消息，4块
  设 统计 为 会话对象.投影统计()
  断言等于(统计["消息数"], 3, "投影消息数=3")
  断言等于(统计["总块数"], 4, "总块数=4(1+2+1)")
  设 角色分布 为 统计["角色分布"]
  断言等于(角色分布["user"], 1, "user角色=1")
  断言等于(角色分布["assistant"], 1, "assistant角色=1")
  断言等于(角色分布["tool"], 1, "tool角色=1")

  # 追加一条空内容助手消息（不投影）
  设 空助手 为 造助手消息([], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 空助手, "重放": 空])
  设 统计2 为 会话对象.投影统计()
  断言等于(统计2["消息数"], 3, "空助手不增加消息数")
  断言等于(统计2["总块数"], 4, "空助手不增加块数")

  # 追加一条用户消息
  设 用户消息2 为 造用户消息([造文本块("再问"), 造文本块("一个问题")])
  会话对象.记录事件("user/message", 用户消息2)
  设 统计3 为 会话对象.投影统计()
  断言等于(统计3["消息数"], 4, "新增用户后消息数=4")
  断言等于(统计3["总块数"], 6, "新增2块后总块数=6")
  断言等于(统计3["角色分布"]["user"], 2, "user角色=2")

  打印 "  投影统计全部通过"
  打印 "--- 会话深化测试通过 ---"

主()
