# test_宿主上下文.light —— 第17轮 任务2（宿主上下文与作用域原型）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_宿主上下文.light
# 上游参考：Cordis Context 类型增强、packages/scope 作用域过滤（原型设计，非逐行复刻）
#
# 覆盖：上下文基本操作 / 继承与覆盖 / 查找链 / 列举去重子优先 / 自有属性 / 删除边界 /
#   标识唯一性（根计数器）/ 快照恢复 / 销毁语义 / 作用域匹配（全局/同域/祖先/不匹配）/
#   作用域链 / 上下文传递
#
# 反跑判据（改源码一行测试必须红，恢复后绿）：
#   A=正常：父设置->子覆盖->删除子->回落父（回归绿验证）
#   B=边界：作用域链 global->agent->session 各匹配组合（回归绿验证）
#   C=变异：获取属性 查找链改错（只查当前不查父）-> 子取父属性断言红

从 宿主上下文 导入 造根上下文, 造子上下文, 设置属性, 获取属性, 自有属性, 删除属性, 列举属性, 上下文快照, 恢复上下文, 销毁上下文, 是已销毁, 造作用域, 作用域匹配, 作用域链, 传递上下文

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含(文本, 子串, 标签):
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 检查抛错含(标签, 子串, 运算):
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    设 忽略 为 运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 钩子与抛错场景 ----------
段落 钩子取服务(上下文):
  返回 获取属性(上下文, "服务名")

段落 场子上下文父已销毁:
  设 根 为 造根上下文(空, "ctx-r", 1)
  设 子 为 造子上下文(根, 空, 2)
  销毁上下文(根, 3)
  造子上下文(根, 空, 4)

段落 场销毁后设置:
  设 根 为 造根上下文(空, "ctx-r", 1)
  销毁上下文(根, 2)
  设置属性(根, "键", "值")

段落 场恢复后设置:
  设 根 为 造根上下文(空, "ctx-r", 1)
  恢复上下文(根, ["键": "值"])

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 基本操作与继承（A 判据场景） ============
  设 全局域 为 造作用域("global", "*", 空)
  设 根 为 造根上下文(全局域, "ctx-root", 100)
  断言相等(根["标识"], "ctx-root", "根标识")
  断言相等(根["创建时间"], 100, "根创建时间")
  断言真(根["父"] == 空, "根无父")
  设置属性(根, "层", "根层")
  设置属性(根, "共享", "根值")
  断言相等(获取属性(根, "共享"), "根值", "根取共享")
  断言真(自有属性(根, "共享"), "根自有共享")
  设 子 为 造子上下文(根, 造作用域("agent", "agent-1", 全局域), 110)
  断言相等(子["创建时间"], 110, "子创建时间")
  断言真(子["父"] == 根, "子父引用")
  # 子覆盖父
  设置属性(子, "共享", "子值")
  断言相等(获取属性(子, "共享"), "子值", "子覆盖父")
  断言相等(获取属性(根, "共享"), "根值", "父不受影响")
  # 删除子属性后回落父
  删除属性(子, "共享")
  断言相等(获取属性(子, "共享"), "根值", "删子后回落父")
  # 自有属性
  断言真(自有属性(子, "层") == 假, "层在父非子自有")
  断言真(自有属性(子, "共享") == 假, "删除后非自有")
  设置属性(子, "层", "子层")
  断言真(自有属性(子, "层"), "覆盖后子自有")
  # 删除不存在的属性不崩溃
  删除属性(子, "不存在键")
  # 获取不存在的属性返回空
  断言真(获取属性(子, "不存在键") == 空, "不存在属性返回空")
  # 查找链三级：根 -> 子 -> 孙
  设 孙 为 造子上下文(子, 全局域, 115)
  设置属性(孙, "深层", "孙值")
  断言相等(获取属性(孙, "层"), "子层", "孙取子的层")
  断言相等(获取属性(孙, "共享"), "根值", "孙取根的共享")
  断言相等(获取属性(孙, "深层"), "孙值", "孙取自有")
  # 列举去重（子层键在前）
  设 名单 为 列举属性(孙)
  断言真(列表包含(名单, "深层"), "列举含孙键")
  断言真(列表包含(名单, "共享"), "列举含根键")
  断言真(列表长度(名单) == 列表长度(去重占位(名单)), "列举无重复")

段落 去重占位(名单):
  设 结果 为 []
  遍历 键 之 名单:
    如果 列表包含(结果, 键) == 假:
      列表追加(结果, 键)
  返回 结果

# ---------- 主流程续（分隔段落便于组织） ----------
段落 主续:
  # ============ 2) 标识唯一性（根计数器） ============
  设 根乙 为 造根上下文(空, "ctx-b", 1)
  设 子甲 为 造子上下文(根乙, 空, 2)
  设 子乙 为 造子上下文(根乙, 空, 3)
  设 子丙 为 造子上下文(子乙, 空, 4)
  断言相等(子甲["标识"], "ctx-b-1", "首子标识 1")
  断言相等(子乙["标识"], "ctx-b-2", "次子标识 2")
  断言相等(子丙["标识"], "ctx-b-3", "孙标识 3（链上溯根计数）")
  断言真(子甲["标识"] != 子乙["标识"], "标识唯一")

  # ============ 3) 快照/恢复 ============
  设 根丙 为 造根上下文(空, "ctx-c", 1)
  设置属性(根丙, "基", "基值")
  设 子丁 为 造子上下文(根丙, 空, 2)
  设置属性(子丁, "自有", "自有值")
  # 快照（当前层自有属性；测试前快照 -> 测试后恢复，避免状态污染）
  设 快照 为 上下文快照(子丁)
  断言相等(快照["自有"], "自有值", "快照含自有属性")
  # 变更：新增临时 + 修改自有 + 父层变化
  设置属性(子丁, "临时", "临值")
  设置属性(子丁, "自有", "改值")
  设置属性(根丙, "基", "新基值")
  断言相等(获取属性(子丁, "临时"), "临值", "变更生效")
  # 恢复：清当前层、写回快照（父链不受影响）
  恢复上下文(子丁, 快照)
  断言真(获取属性(子丁, "临时") == 空, "恢复后临时清除")
  断言相等(获取属性(子丁, "自有"), "自有值", "恢复后自有回归")
  断言相等(获取属性(子丁, "基"), "新基值", "父链不受恢复影响")
  # 恢复后设置正常（不被销毁状态阻断）
  设 恢复根 为 造根上下文(空, "ctx-r2", 1)
  恢复上下文(恢复根, ["键": "值"])
  断言相等(获取属性(恢复根, "键"), "值", "恢复后设置读取")

# ---------- 主流程三 ----------
段落 主续乙:
  # ============ 4) 销毁语义 ============
  设 根丁 为 造根上下文(空, "ctx-d", 1)
  设置属性(根丁, "存留", "值")
  设 子戊 为 造子上下文(根丁, 空, 2)
  销毁上下文(子戊, 999)
  断言真(是已销毁(子戊), "销毁标记")
  断言相等(子戊["销毁时间"], 999, "销毁时间")
  检查抛错含("销毁后设置应抛", "上下文已销毁", 场销毁后设置)
  检查抛错含("销毁父后造子应抛", "父上下文已销毁", 场子上下文父已销毁)
  # 读后不失效（设计决策）
  设置属性(根丁, "读测", "可读")
  销毁上下文(根丁, 1000)
  断言相等(获取属性(根丁, "读测"), "可读", "销毁后读取仍可用")

  # ============ 5) 作用域匹配（B 判据场景） ============
  设 全局域 为 造作用域("global", "*", 空)
  设 代理一 为 造作用域("agent", "agent-1", 全局域)
  设 会话一 为 造作用域("session", "session-1", 代理一)
  设 代理二 为 造作用域("agent", "agent-2", 全局域)
  # 全局监听器匹配所有
  断言真(作用域匹配(会话一, 全局域), "全局监听匹配会话事件")
  断言真(作用域匹配(代理一, 全局域), "全局监听匹配代理事件")
  # 同类型同目标
  断言真(作用域匹配(会话一, 会话一), "同域同目标匹配")
  # 祖先匹配：监听器 agent-1 接收其下 session-1 的事件
  断言真(作用域匹配(会话一, 代理一), "祖先 agent 匹配后代 session")
  # 不匹配：其他 agent
  断言真(作用域匹配(代理一, 代理二) == 假, "其他 agent 不匹配")
  # 不匹配：agent-2 的监听器收不到 agent-1 的事件
  断言真(作用域匹配(代理一, 代理二) == 假, "跨代理不匹配")
  # 空 事件作用域 -> 仅全局监听匹配
  断言真(作用域匹配(空, 全局域), "空事件域被全局匹配")
  # 作用域链
  断言相等(作用域链(会话一), ["session:session-1", "agent:agent-1", "global:*"], "作用域链三层")

  # ============ 6) 上下文传递 ============
  设 传递根 为 造根上下文(空, "ctx-p", 1)
  设置属性(传递根, "服务名", "总线")
  设 传递子 为 造子上下文(传递根, 空, 2)
  段落 钩子取服务(上下文):
    返回 获取属性(上下文, "服务名")
  断言相等(传递上下文(钩子取服务, 传递子), "总线", "钩子经传递取链上属性")

  打印("test_宿主上下文 PASS")

主()
主续()
主续乙()
