# test_远端总线_接线.light —— 第6轮 任务B #256 远端 API 总线宿主出口 判据
# 运行：python 运行.py examples/test_远端总线_接线.light
# 判据：接桩出口（经总线转发通知/经总线调用远端）在宿主桩 mock 下返回预期形状；
#       纯逻辑段回归绿由 test_远端总线.light / test_远端白名单.light 承担。

从 远端总线 导入 经总线转发通知, 经总线调用远端
从 宿主IO 导入 造宿主桩, 造成功结果, 造失败结果, 是失败结果, 是成功结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主桩能力：转发通知 回显参数
段落 回显通知(参数字典):
  返回 参数字典

# mock 宿主桩能力：rpc 调用 -> 直接返回载荷（宿主转交 包成 IO成功结果，总线连接器 再包成 {"好": 真, "值": 载荷}）
段落 rpc好(参数字典):
  返回 "rpc-ok"

# mock 宿主桩能力：rpc 调用失败 -> IO失败信封（总线连接器 转成 {"好": 假, "失败": {...}}）
段落 rpc败(参数字典):
  返回 造失败结果("boom", "远端失败", {})

段落 主:
  # ---- 1. 白名单内事件转发：emit 模式透传 ----
  设 桩 为 造宿主桩({"转发通知": 回显通知})
  设 r1 为 经总线转发通知(桩, "commands/change", {"项": 1})
  断言真(r1["成功"], "1a 白名单内转发成功")
  断言相等(r1["数据"]["事件名"], "commands/change", "1b 事件名透传")
  断言相等(r1["数据"]["模式"], "emit", "1c 模式透传")
  断言相等(r1["数据"]["数据"]["项"], 1, "1d 数据透传")

  # ---- 2. waterfall 模式透传 ----
  设 r2 为 经总线转发通知(桩, "user-questions/request", {"问题": "q"})
  断言真(r2["成功"], "2a waterfall 转发成功")
  断言相等(r2["数据"]["模式"], "waterfall", "2b 模式")

  # ---- 3. 白名单外事件 -> INVALID_ARGUMENT（不静默） ----
  设 r3 为 经总线转发通知(桩, "not/whitelisted", {})
  断言真(是失败结果(r3), "3a 白名单外须失败")
  断言相等(r3["错误码"], "INVALID_ARGUMENT", "3b 错误码")

  # ---- 4. 经总线调用远端：宿主桩 rpc 成功 ----
  设 描述符 为 {"命名空间": "test", "方法": "查询", "参数列表": [{"线名": "甲", "来源": "json", "允许空": 真, "编解码": {"严格": 真}}], "结果编解码": {"严格": 真}}
  设 r4 为 经总线调用远端(描述符, 空, {"活跃": 真}, ["值1"], 空, 造宿主桩({"rpc": rpc好}))
  断言真(r4["成功"], "4a rpc 成功")
  断言相等(r4["值"], "rpc-ok", "4b 结果值")

  # ---- 5. 经总线调用远端：宿主桩 rpc 失败 -> 上游失败信封 ----
  设 r5 为 经总线调用远端(描述符, 空, {"活跃": 真}, ["值1"], 空, 造宿主桩({"rpc": rpc败}))
  断言真(是失败结果(r5), "5a rpc 失败信封")
  断言相等(r5["失败"]["代码"], "boom", "5b 失败码透传")

  # ---- 6. mount token 非活跃 -> 已撤回（§六 纯逻辑保留） ----
  设 r6 为 经总线调用远端(描述符, 空, {"活跃": 假}, ["值1"], 空, 造宿主桩({"rpc": rpc好}))
  断言真(是失败结果(r6), "6a 未挂载须失败")
  断言相等(r6["失败"]["代码"], "internal", "6b 已撤回信封码")

  # ---- 7. 调用日志：转发经桩留痕 ----
  设 桩7 为 造宿主桩({"转发通知": 回显通知})
  设 _r7 为 经总线转发通知(桩7, "api-session/status", {})
  断言相等(列表长度(桩7["调用日志"]), 1, "7a 调用日志一条")

  打印 "--- 第6轮 任务B #256 远端总线宿主出口 测试通过 ---"

主()