# test_R85_E_压缩镜像卸载.light —— R85 任务E 压缩域：offloadMessageImages 纯逻辑
从 压缩 导入 绳标记图像卸载

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件))

段落 主:
  # 消息：text, image(0), image(1), tool-result{content:[image(2)]}
  设 消息 为 ["content": [
    ["type": "text", "text": "hi"],
    ["type": "image", "data": "a"],
    ["type": "image", "data": "b"],
    ["type": "tool-result", "content": [["type": "image", "data": "c"]]]
  ]]
  # 标记下标 [1,2]（第二张图 + 嵌套图）
  设 结果 为 绳标记图像卸载(消息, [1, 2])
  设 内容 为 结果["content"]
  断言相等(内容[0]["type"], "text", "文本保持")
  断言为真(字典包含键(内容[1], "offloaded") == 假, "图0未卸载(无offloaded键)")
  断言相等(内容[2]["offloaded"], 真, "图1已卸载")
  设 工 为 内容[3]
  断言相等(工["type"], "tool-result", "工具结果")
  设 内 为 工["content"]
  断言相等(长度(内), 1, "嵌套一张图")
  断言相等(内[0]["offloaded"], 真, "嵌套图已卸载")
  # 原消息不可变
  断言为真(字典包含键(消息["content"][2], "offloaded") == 假, "原消息不变")
  # 已卸载再卸载 → 抛错
  尝试:
    绳标记图像卸载(结果, [1])
    抛出 新建 错误("应为抛错: 已卸载未抛 [NO_THROW]")
  捕获 异常 为 e:
    断言为真(字符串包含(转字符串(e), "already offloaded"), "已卸载错误")
  # 越界下标 → 抛错
  尝试:
    绳标记图像卸载(消息, [9])
    抛出 新建 错误("应为抛错: 越界未抛 [NO_THROW]")
  捕获 异常 为 e2:
    断言为真(字符串包含(转字符串(e2), "does not exist"), "越界错误")

主()
写 "test_R85_E_压缩镜像卸载 PASS"
