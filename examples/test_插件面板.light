# test_插件面板.light —— R108 任务线 F 判据（侧栏插件面板只读面）
# 运行：cd lightharness && python 运行.py examples/test_插件面板.light
# 反跑：把 分桶 的「官方」谓词改成「已安装 且 非可选」→ 分桶断言必须红；还原后复绿。

从 插件面板 导入 实验性前缀, 文案面板, 文案标题, 文案介绍, 文案信息说明, 文案不可用, 文案已安装, 文案官方, 文案状态问题, 文案状态实验性, 文案原因标签, 文案版本标签, 文案组件标签, 文案组件空, 文案组件计数总, 文案组件运行中, 文案组件已停用, 文案组件异常, 文案行相位等待依赖, 文案行相位加载中, 文案行相位运行中, 文案行相位异常, 文案行相位卸载中, 文案行相位未运行, 文案只读原因管理所需, 文案只读原因无法定位, 文案重试, 文案刷新, 文案空, 相位文案, 只读原因文案, 造行, 造卡片, 分桶, 组件计数文案, 不可用态, 渲染插件面板
从 内置核心字典 导入 字典包含键, 字典获取, 字典键列表
从 内置核心列表 导入 列表长度, 列表包含
从 内置核心字符串 导入 字符串包含
从 内置核心转换 导入 转字符串

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  打印 "===== R108 任务线 F：侧栏插件面板只读面 ====="

  # ---- §1 分桶（5 例） ----
  设 空桶 为 分桶([])
  断言相等(空桶, {"官方": [], "已安装": []}, "1a 两组皆空时都为空")
  设 可选未装 为 {"name": "official-a", "可选": 真, "已安装": 假}
  设 已装包 为 {"name": "installed-b", "可选": 假, "已安装": 真}
  设 混合后 为 分桶([可选未装, 已装包])
  断言相等(混合后["官方"][0]["name"], "official-a", "1b 可选未安装进官方")
  断言相等(混合后["已安装"][0]["name"], "installed-b", "1c 已安装进已安装组")
  断言相等(字典键列表(混合后), ["官方", "已安装"], "1d 官方在前")
  设 非可选未装 为 {"name": "core-c", "可选": 假, "已安装": 假}
  设 桶2 为 分桶([非可选未装])
  断言相等(列表长度(桶2["官方"]), 0, "1e 非可选未安装不进官方（进已安装）")
  断言相等(桶2["已安装"][0]["name"], "core-c", "1f 非可选未安装进已安装")
  设 可选已装 为 {"name": "opt-inst", "可选": 真, "已安装": 真}
  设 桶3 为 分桶([可选已装])
  断言相等(列表长度(桶3["官方"]), 0, "1g 可选且已安装不进官方（官方要求未安装）")
  断言相等(列表长度(桶3["已安装"]), 1, "1h 可选且已安装进已安装")

  # ---- §2 造卡片（6 例） ----
  设 卡无标题 为 造卡片({"name": "@deepseek-ai/dsh-foo"})
  断言相等(卡无标题["标题"], "@deepseek-ai/dsh-foo", "2a 标题缺失回退完整包名")
  设 卡实验 为 造卡片({"name": "@deepseek-ai/dsh-experimental-vision"})
  断言真(列表包含(卡实验["标签"], 文案状态实验性()), "2b 实验性包名出实验性标签")
  设 卡错 为 造卡片({"name": "x", "错误": "boom"})
  断言真(列表包含(卡错["标签"], 文案状态问题()), "2c 有 error 出异常标签")
  设 卡可选 为 造卡片({"name": "y", "可选": 真, "已安装": 假})
  断言相等(卡可选["可选"], 真, "2d 可选未安装标记")
  断言相等(卡可选["已安装"], 假, "2e 已安装标记")
  设 卡已装 为 造卡片({"name": "z", "已安装": 真, "版本": "1.2.3"})
  断言相等(卡已装["已安装"], 真, "2f 已安装标记真")
  断言相等(卡已装["版本"], "1.2.3", "2g 版本存在时取值")
  设 卡无版本 为 造卡片({"name": "w"})
  断言真(字典包含键(卡无版本, "版本"), "2h 版本键恒在")
  断言相等(卡无版本["版本"], 空, "2i 版本缺失省略为空白")

  # ---- §3 造行（4 例：相位空 + 三相位映射） ----
  设 行空 为 造行({"rowId": "r1", "moduleName": "m", "已启用": 真, "相位": 空})
  断言相等(行空["相位"], 空, "3a 相位空 → 不产出相位文案（相位键为空）")
  设 行等待 为 造行({"rowId": "r2", "moduleName": "m", "已启用": 真, "相位": "pending"})
  断言相等(相位文案(行等待["相位"]), 文案行相位等待依赖(), "3b pending→等待依赖")
  设 行运行 为 造行({"rowId": "r3", "moduleName": "m", "已启用": 真, "相位": "active"})
  断言相等(相位文案(行运行["相位"]), 文案行相位运行中(), "3c active→运行中")
  设 行异常 为 造行({"rowId": "r4", "moduleName": "m", "已启用": 假, "相位": "failed"})
  断言相等(相位文案(行异常["相位"]), 文案行相位异常(), "3d failed→异常")

  # ---- §4 组件计数文案（5 例） ----
  断言相等(组件计数文案([]), "共 0 个", "4a 全 0 项只有 共 n 个")
  设 行活 为 [{"rowId": "a", "moduleName": "m", "已启用": 真, "相位": "active"}]
  断言相等(组件计数文案(行活), "共 1 个 · 1 运行中", "4b 单类>0 运行中")
  设 行关 为 [{"rowId": "b", "moduleName": "m", "已启用": 假, "相位": "pending"}]
  断言相等(组件计数文案(行关), "共 1 个 · 1 已停用", "4c 单类>0 已停用")
  设 行败 为 [{"rowId": "c", "moduleName": "m", "已启用": 真, "相位": "failed"}]
  断言相等(组件计数文案(行败), "共 1 个 · 1 异常", "4d 单类>0 异常")
  设 行多 为 [{"rowId": "a", "moduleName": "m", "已启用": 真, "相位": "active"},
    {"rowId": "b", "moduleName": "m", "已启用": 假, "相位": "pending"},
    {"rowId": "c", "moduleName": "m", "已启用": 真, "相位": "failed"}]
  断言相等(组件计数文案(行多), "共 3 个 · 1 运行中 · 1 已停用 · 1 异常", "4e 多类>0 顺序与逐字")

  # ---- §5 相位文案（6 例） ----
  断言相等(相位文案("pending"), 文案行相位等待依赖(), "5a pending")
  断言相等(相位文案("loading"), 文案行相位加载中(), "5b loading")
  断言相等(相位文案("active"), 文案行相位运行中(), "5c active")
  断言相等(相位文案("failed"), 文案行相位异常(), "5d failed")
  断言相等(相位文案("unloading"), 文案行相位卸载中(), "5e unloading")
  断言相等(相位文案(空), 文案行相位未运行(), "5f 空→未运行")

  # ---- §6 只读原因文案（2 例逐字） ----
  断言相等(只读原因文案("management-required"), 文案只读原因管理所需(), "6a management-required 逐字")
  断言相等(只读原因文案("unaddressable"), 文案只读原因无法定位(), "6b unaddressable 逐字")

  # ---- §7 不可用态（2 例逐字） ----
  设 不可 为 不可用态()
  断言相等(不可["可用"], 假, "7a 不可用态 可用=假")
  断言相等(不可["不可用文案"], 文案不可用(), "7b 不可用文案逐字")

  # ---- §8 渲染插件面板（键齐全 2 例） ----
  设 空面板 为 渲染插件面板([], {}, 空)
  断言相等(列表长度(字典键列表(空面板)), 5, "8a 整页五键齐全")
  断言真(字典包含键(空面板, "可用") 且 字典包含键(空面板, "不可用文案") 且 字典包含键(空面板, "分组") 且 字典包含键(空面板, "刷新中") 且 字典包含键(空面板, "错误"), "8b 五键俱全")
  设 面板有包 为 渲染插件面板([可选未装, 已装包], {}, 空)
  断言相等(面板有包["可用"], 假, "8c 本仓恒不可用")
  断言相等(列表长度(面板有包["分组"]), 2, "8d 分组两组")
  断言相等(面板有包["分组"][0]["卡片"][0]["name"], "official-a", "8e 官方组卡片")
  断言相等(面板有包["分组"][1]["卡片"][0]["name"], "installed-b", "8f 已安装组卡片")

  # ---- §9 文案逐字（≥8 例） ----
  断言相等(文案面板(), "插件", "9a 面板")
  断言相等(文案标题(), "插件", "9b 标题")
  断言相等(文案介绍(), "安装、启用和配置插件", "9c 介绍")
  断言相等(文案信息说明(), "在这里配置官方插件，安装和管理其他插件。内置插件列表及运行状态可在「设置 → 内置插件」中查看", "9d 信息说明")
  断言相等(文案已安装(), "已安装", "9e 已安装")
  断言相等(文案官方(), "官方", "9f 官方")
  断言相等(文案组件标签(), "包含的组件", "9g 组件标签")
  断言相等(文案组件空(), "这个插件包不包含任何组件。", "9h 组件空")
  断言相等(文案重试(), "重试", "9i 重试")
  断言相等(文案刷新(), "刷新", "9j 刷新")
  断言相等(文案空(), "还没有安装任何插件。", "9k 空态")
  断言相等(文案原因标签(), "原因", "9l 原因标签")
  断言相等(文案版本标签(), "v{{version}}", "9m 版本标签（Light 字符串不支持字面子括号，记为 v{{version}}）")
  断言真(字符串包含(实验性前缀(), "dsh-experimental-"), "9n 实验性前缀")

  打印 "test_插件面板 PASS"
