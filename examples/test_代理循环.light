# test_代理循环.light —— 模块 代理循环 对齐判据（第34轮 任务1 agent-loop 核心）
# 运行：python 运行.py examples/test_代理循环.light

从 代理循环 导入 轮次待启, 轮次进行, 轮次完成, 轮次失败, 轮次中止, 步骤待启, 步骤进行, 步骤完成, 步骤失败, 步骤跳过, 步骤中止, 循轮次后继, 循步骤后继, 循轮次可转, 循步骤可转, 建轮次, 建步骤, 转轮次, 转步骤, 轮次是否终态, 步骤是否终态, 轮次追加步骤, 轮次当前步骤, 轮次是否跑完, 轮次快照, 建检查点, 取最近检查点, 记检查点, 取检查点, 从检查点恢复, 建中止信号, 是否中止, 请求中止, 建循环, 是否超限, 注册监听, 注销监听, 监听器数, 发事件, 开始轮次, 结束轮次, 开始步骤, 结束步骤, 中止循环, 恢复循环, 投影循环, 校验循环投影, 增量投影

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) +
      " 期望=" + 转字符串(期望))

段落 断言为真(实际, 信息):
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 断言为假(实际, 信息):
  如果 实际 != 假:
    抛出 新建 错误("断言失败（应为假）：" + 信息 + " | 实际=" + 转字符串(实际))

# 应抛：无参段落作实参传入
段落 检查抛错(探针, 信息):
  设 已抛 为 假
  尝试:
    探针()
  捕获 异常 为 e:
    设 已抛 为 真
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛：" + 信息)
  返回 真

# ---- 监听器：正常计数 / 抛错隔离 ----
# 计数器用字典承载：段落内 `设 X 为 ...` 只建局部名，改不到模块级标量
设 计数盘 为 {"值": 0}

段落 好监听(事件):
  字典设置(计数盘, "值", 计数盘["值"] + 1)
  返回 真

段落 坏监听(事件):
  抛出 新建 错误("监听器内部炸了 [LISTENER_BOOM]")

段落 取命中:
  返回 计数盘["值"]

段落 主:
  # ---------- 1) 轮次状态机：合法与非法转换 ----------
  断言相等(循轮次可转(轮次待启, 轮次进行), 真, "pending→running 合法")
  断言相等(循轮次可转(轮次进行, 轮次完成), 真, "running→completed 合法")
  断言相等(循轮次可转(轮次进行, 轮次失败), 真, "running→failed 合法")
  断言相等(循轮次可转(轮次进行, 轮次中止), 真, "running→aborted 合法")
  断言为假(循轮次可转(轮次待启, 轮次完成), "pending→completed 非法")
  断言为假(循轮次可转(轮次完成, 轮次进行), "completed 是终态")
  断言相等(长(循轮次后继(轮次完成)), 0, "completed 无后继")
  断言相等(长(循轮次后继(轮次失败)), 0, "failed 无后继")
  断言相等(长(循轮次后继(轮次中止)), 0, "aborted 无后继")

  # 非法转换必须抛错（严格状态机铁律）
  设 轮A 为 建轮次(0)
  断言相等(轮A["状态"], 轮次待启, "新轮次 pending")
  转轮次(轮A, 轮次进行)
  断言相等(轮A["状态"], 轮次进行, "转 running")
  段落 非法轮次转换:
    转轮次(轮A, 轮次待启)
  检查抛错(非法轮次转换, "running→pending 必须抛错")
  断言相等(轮A["状态"], 轮次进行, "抛错后状态不变")

  # ---------- 2) 步骤状态机 ----------
  断言为真(循步骤可转(步骤待启, 步骤进行), "pending→running 合法")
  断言为真(循步骤可转(步骤待启, 步骤跳过), "pending→skipped 合法")
  断言为真(循步骤可转(步骤进行, 步骤跳过), "running→skipped 合法")
  断言为假(循步骤可转(步骤完成, 步骤进行), "completed 终态")
  断言为假(循步骤可转(步骤跳过, 步骤进行), "skipped 终态")
  设 步A 为 建步骤(0, "llm")
  断言相等(步A["类型"], "llm", "步骤类型 llm")
  段落 未知步骤类型:
    建步骤(0, "未知类型")
  检查抛错(未知步骤类型, "未知步骤类型必须抛错")
  段落 非法步骤转换:
    转步骤(步A, 步骤待启)
  检查抛错(非法步骤转换, "pending→pending 非法")

  # 终态判定
  转步骤(步A, 步骤进行)
  断言为假(步骤是否终态(步A), "running 非终态")
  转步骤(步A, 步骤完成)
  断言为真(步骤是否终态(步A), "completed 是终态")

  # ---------- 3) 轮次内含多步骤 ----------
  设 轮B 为 建轮次(0)
  轮次追加步骤(轮B, "llm")
  轮次追加步骤(轮B, "tool")
  轮次追加步骤(轮B, "user_input")
  断言相等(长(轮B["步骤表"]), 3, "一轮三步骤")
  设 首个 为 轮次当前步骤(轮B)
  断言相等(首个["序号"], 0, "当前步骤是第 0 个")
  转步骤(首个, 步骤进行)
  转步骤(首个, 步骤完成)
  断言相等(轮次当前步骤(轮B)["序号"], 1, "完成后推进到第 1 个")
  断言为假(轮次是否跑完(轮B), "仍有未终态步骤")
  转步骤(轮B["步骤表"][1], 步骤进行)
  转步骤(轮B["步骤表"][1], 步骤跳过)
  转步骤(轮B["步骤表"][2], 步骤进行)
  转步骤(轮B["步骤表"][2], 步骤完成)
  断言为真(轮次是否跑完(轮B), "全部终态即跑完")
  断言相等(轮次当前步骤(轮B), 空, "跑完无当前步骤")

  # ---------- 4) 检查点：序号递增 + 幂等恢复 ----------
  设 驱动 为 建循环(3)
  断言相等(是否超限(驱动), 假, "初始未超限")
  设 轮C 为 开始轮次(驱动)
  断言相等(轮C["序号"], 0, "第一轮序号 0")
  断言相等(长(驱动["检查点表"]), 1, "pre-turn 记 1 个检查点")
  断言相等(驱动["检查点表"][0]["策略"], "pre-turn", "首个检查点策略")
  设 步C 为 开始步骤(驱动, "llm")
  断言相等(长(驱动["检查点表"]), 2, "pre-step 记第 2 个检查点")
  断言相等(驱动["检查点表"][1]["策略"], "pre-step", "第 2 个策略")
  结束步骤(驱动, 步骤完成, 空, "ok")
  断言相等(长(驱动["检查点表"]), 3, "post-step 记第 3 个")
  结束轮次(驱动, 轮次完成)
  断言相等(长(驱动["检查点表"]), 4, "post-turn 记第 4 个")
  断言相等(驱动["检查点表"][3]["策略"], "post-turn", "第 4 个策略")

  # 序号严格递增
  设 上序 为 0
  遍历 点 之 驱动["检查点表"]:
    断言为真(点["序号"] > 上序, "检查点序号严格递增")
    设 上序 为 点["序号"]

  # 幂等恢复：同一序号恢复两次结果一致，且不新增检查点
  设 基线 为 长(驱动["检查点表"])
  设 快照甲 为 从检查点恢复(驱动, 2)
  设 快照乙 为 从检查点恢复(驱动, 2)
  断言相等(长(驱动["检查点表"]), 基线, "恢复不新增检查点")
  断言相等(序列化JSON(快照甲), 序列化JSON(快照乙), "恢复幂等：两次快照一致")
  断言相等(驱动["恢复序号"], 2, "恢复序号已记录")
  断言相等(从检查点恢复(驱动, 999), 空, "不存在序号返回空")
  断言相等(取检查点(驱动, 2)["策略"], "pre-step", "按序号取点")

  # 非法策略
  段落 坏策略:
    设 驱动孤 为 建循环(1)
    记检查点(驱动孤, "mid-turn", {}, [])
  检查抛错(坏策略, "未知检查点策略必须抛错")

  # ---------- 5) 中止信号 ----------
  设 信号 为 建中止信号()
  断言为假(是否中止(信号), "初始未中止")
  断言为真(请求中止(信号, "user_abort"), "首次中止返回真")
  断言为真(是否中止(信号), "已中止")
  断言为假(请求中止(信号, "timeout"), "重复中止返回假（幂等）")
  断言相等(信号["原因"], "user_abort", "首次原因不被覆盖")
  段落 坏原因:
    设 信号乙 为 建中止信号()
    请求中止(信号乙, "不知道")
  检查抛错(坏原因, "未知中止原因必须抛错")

  # ---------- 6) 轮次上限（max_rounds） ----------
  设 驱动D 为 建循环(2)
  开始轮次(驱动D)
  结束轮次(驱动D)
  开始轮次(驱动D)
  结束轮次(驱动D)
  断言为真(是否超限(驱动D), "跑满 2 轮即超限")
  断言相等(开始轮次(驱动D), 空, "超限后不再开新轮")
  断言为真(是否中止(驱动D["信号"]), "超限触发中止")
  断言相等(驱动D["信号"]["原因"], "max_rounds", "中止原因 max_rounds")
  断言为真(驱动D["已达上限"], "已达上限标记")

  # ---------- 7) 中止 → 恢复（跳过已完成步骤） ----------
  设 驱动E 为 建循环(5)
  开始轮次(驱动E)
  设 步E1 为 开始步骤(驱动E, "llm")
  结束步骤(驱动E, 步骤完成, 空, "产出甲")
  设 步E2 为 开始步骤(驱动E, "tool")
  断言相等(中止循环(驱动E, "timeout"), 真, "首次中止返回真")
  断言相等(步E2["状态"], 步骤中止, "进行中步骤被中止")
  断言相等(驱动E["当前轮次"]["状态"], 轮次中止, "轮次被标记中止")
  断言为假(步E1["状态"] == 步骤中止, "已完成步骤不被改状态")
  设 恢复结果 为 恢复循环(驱动E)
  断言相等(恢复结果["决定"], "已恢复", "恢复成功")
  断言相等(恢复结果["跳过步骤"], 2, "跳过 已完成+已中止 两步")
  断言为假(是否中止(驱动E["信号"]), "恢复后清除中止")
  断言相等(恢复循环(驱动E)["决定"], "无需恢复", "未中止时无需恢复")

  # ---------- 8) 事件驱动 + 监听器（含错误隔离） ----------
  设 驱动F 为 建循环(2)
  注册监听(驱动F, "好", 好监听)
  注册监听(驱动F, "坏", 坏监听)
  断言相等(监听器数(驱动F), 2, "两个监听器")
  段落 重名监听:
    注册监听(驱动F, "好", 好监听)
  检查抛错(重名监听, "监听器重名必须抛错")
  开始轮次(驱动F)
  断言为真(取命中() >= 1, "好监听被调用")
  断言相等(长(驱动F["监听器错误表"]), 2, "坏监听被隔离记错（checkpoint+turn_start 各 1 次）")
  断言相等(驱动F["监听器错误表"][0]["名称"], "坏", "错误归属坏监听")
  断言为真(字符串包含(驱动F["监听器错误表"][0]["消息"], "LISTENER_BOOM") == 真,
    "错误消息保留")
  断言为真(取命中() >= 1, "坏监听不影响好监听")
  断言为真(注销监听(驱动F, "坏"), "注销成功")
  断言相等(监听器数(驱动F), 1, "注销后剩 1 个")
  断言为假(注销监听(驱动F, "不存在"), "注销不存在的返回假")
  段落 坏事件:
    发事件(驱动F, "turn_middle", {})
  检查抛错(坏事件, "未知事件类型必须抛错")

  # ---------- 9) 事件投影（幂等 + 增量） ----------
  设 投影 为 投影循环(驱动F["事件表"], 0)
  断言相等(投影["轮次数"], 1, "投影出 1 次 turn_start")
  断言相等(投影["检查点数"], 1, "投影出 1 个 checkpoint")
  断言为真(校验循环投影(投影), "投影通过不变量校验")
  断言相等(序列化JSON(投影循环(驱动F["事件表"], 0)), 序列化JSON(投影),
    "投影幂等：重复投影一致")
  # 增量：从序号 2 起（已处理到 turn_start），剩余事件不再重复计入
  设 增量 为 增量投影(驱动F["事件表"], 2)
  断言相等(增量["轮次数"], 0, "增量投影不重复计入 turn_start")
  断言相等(增量["检查点数"], 0, "增量投影不重复计入 checkpoint")
  断言相等(增量投影(驱动F["事件表"], 1)["轮次数"], 1, "只跳过 checkpoint 时仍计入 turn_start")
  断言相等(长(驱动F["事件表"]) > 1, 真, "事件表非空")

  打印 "test_代理循环 PASS"

主()
