# test_R176_远程访问控制.light —— B4 路 #4 远程访问控制规则层判据
# 上游锚点：packages/api/remote-access/src/index.ts @ dsh-v0.2.1-rc.3（decide / allows / grantsFor / follow 帧）
# 反跑判据：把 访判定请求 的 owner 短路删掉，或把「全资源都通过才允许」改成「任一通过即允许」→ 本文件必红。

从 远程访问控制 导入 访跟随动作, 访端点动作, 访事件动作, 访是事件动作, 访资源相同, 访动作表相同, 访角色含动作, 访判定资源, 访判定请求, 访造策略册, 访登记策略, 访注销策略, 访取策略, 访允许项, 访授权表, 访快照基线, 访快照差分

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

# 条件：允许（恒真）
段落 条件允许(入参):
  返回 {"kind": "allow"}

# 条件：拒绝并带原因
段落 条件拒绝(入参):
  返回 {"kind": "deny", "reason": "该资源需二次确认"}

# 策略解释器：恒返回固定原因（对应上游 policy.explain?.(request)）
段落 解释器(请求):
  返回 "策略解释原因"

# 条件：抛错
段落 条件抛错(入参):
  抛出 新建 错误("condition boom")

段落 资源(种类, 号):
  返回 {"kind": 种类, "id": 号}

段落 全局:
  返回 {"kind": "global"}

段落 绑定(资源, 动作表, 条件):
  设 角色 为 {"actions": 动作表}
  设 绑 为 {"resource": 资源, "role": 角色}
  如果 条件 != 空:
    字典设置(绑, "condition", 条件)
  返回 绑

段落 主:
  # ---------- §1 动作构造 ----------
  断言相等(访端点动作("会话", "读取"), "会话/读取", "§1 端点动作")
  断言相等(访事件动作("turn/end"), "event:turn/end", "§1b 事件动作")
  断言真(访是事件动作("event:x"), "§1c 事件动作识别")
  断言相等(访是事件动作("会话/读取"), 假, "§1d 端点动作不是事件动作")
  断言相等(访跟随动作(), "remoteAccess/follow", "§1e 跟随动作")

  # ---------- §2 比较 ----------
  断言真(访资源相同(资源("会话", "s1"), 资源("会话", "s1")), "§2 同资源")
  断言相等(访资源相同(资源("会话", "s1"), 资源("会话", "s2")), 假, "§2b id 不同")
  断言相等(访资源相同(资源("会话", "s1"), 资源("任务", "s1")), 假, "§2c kind 不同")
  断言真(访资源相同(全局(), 全局()), "§2d global 无 id 也相等")
  断言真(访角色含动作({"actions": ["a", "b"]}, "b"), "§2e 角色含动作")
  断言相等(访角色含动作({"actions": ["a"]}, "b"), 假, "§2f 角色不含动作")

  # ---------- §3 单资源判定 ----------
  设 绑1 为 [绑定(资源("会话", "s1"), ["会话/读取"], 空)]
  断言相等(访判定资源(绑1, "会话/读取", 资源("会话", "s1"), 空)["结论"], "allow", "§3 无条件下命中即允许")
  断言相等(访判定资源(绑1, "会话/删除", 资源("会话", "s1"), 空)["结论"], "refuse", "§3b 角色不含动作 → 拒绝")
  断言相等(访判定资源(绑1, "会话/读取", 资源("会话", "s2"), 空)["结论"], "refuse", "§3c 资源不同 → 拒绝")

  设 绑2 为 [绑定(资源("会话", "s1"), ["会话/读取"], 条件允许)]
  断言相等(访判定资源(绑2, "会话/读取", 资源("会话", "s1"), 空)["结论"], "allow", "§3d 条件允许")

  设 绑3 为 [绑定(资源("会话", "s1"), ["会话/读取"], 条件拒绝)]
  设 判3 为 访判定资源(绑3, "会话/读取", 资源("会话", "s1"), 空)
  断言相等(判3["结论"], "refuse", "§3e 条件拒绝")
  断言相等(判3["拒绝"]["reason"], "该资源需二次确认", "§3f 拒绝原因随行")

  设 绑4 为 [绑定(资源("会话", "s1"), ["会话/读取"], 条件抛错)]
  断言相等(访判定资源(绑4, "会话/读取", 资源("会话", "s1"), 空)["结论"], "failed", "§3g 条件抛错 → failed")

  # 首个拒绝被记住，但后续绑定仍可能允许
  设 绑5 为 [绑定(资源("会话", "s1"), ["会话/读取"], 条件拒绝), 绑定(资源("会话", "s1"), ["会话/读取"], 空)]
  断言相等(访判定资源(绑5, "会话/读取", 资源("会话", "s1"), 空)["结论"], "allow", "§3h 后续绑定仍可放行")

  # ---------- §4 请求判定 ----------
  设 册 为 访造策略册()
  设 策略 为 {"bindings": 空, "explain": 空}
  设 登1 为 访登记策略(册, "plugin", 策略)
  断言真(登1["登记"], "§4 登记策略")
  设 登2 为 访登记策略(册, "plugin", 策略)
  断言相等(登2["登记"], 假, "§4b 重复登记拒绝")
  断言相等(登2["错误"], "remote access: principal kind \"plugin\" already has a policy", "§4c 重复文案逐字")
  设 登3 为 访登记策略(册, "owner", 策略)
  断言相等(登3["登记"], 假, "§4d owner 是内置主体，不得登记")

  设 插件 为 {"kind": "plugin", "name": "x"}
  设 属主 为 {"kind": "owner"}

  # owner 恒允许（即使没有任何绑定）
  设 属主请求 为 {"principal": 属主, "action": "会话/删除", "resources": [资源("会话", "s1")]}
  断言相等(访判定请求(册, 属主请求, [], 假)["结论"], "allow", "§4e owner 恒允许")

  # 跟随动作恒允许
  设 跟随请求 为 {"principal": 插件, "action": 访跟随动作(), "resources": [资源("会话", "s1")]}
  断言相等(访判定请求(册, 跟随请求, [], 假)["结论"], "allow", "§4f 跟随动作恒允许")

  # 无策略 → no-allow
  设 无策请求 为 {"principal": {"kind": "unknown"}, "action": "会话/读取", "resources": [资源("会话", "s1")]}
  设 无策 为 访判定请求(册, 无策请求, [], 假)
  断言相等(无策["结论"], "deny", "§4g 无策略拒绝")
  断言相等(无策["原因"], "no-allow", "§4h 无策略原因")

  # 取绑定失败 → policy-failed
  设 读请求 为 {"principal": 插件, "action": "会话/读取", "resources": [资源("会话", "s1")]}
  设 失败 为 访判定请求(册, 读请求, [], 真)
  断言相等(失败["原因"], "policy-failed", "§4i 策略失败原因")

  # 全资源通过才允许（关键：第二个资源不通过 → 整体拒绝）
  设 双资源请求 为 {"principal": 插件, "action": "会话/读取", "resources": [资源("会话", "s1"), 资源("任务", "j1")]}
  设 单绑 为 [绑定(资源("会话", "s1"), ["会话/读取"], 空)]
  断言相等(访判定请求(册, 双资源请求, 单绑, 假)["结论"], "deny", "§4j 资源全集必须全通过")
  设 双绑 为 [绑定(资源("会话", "s1"), ["会话/读取"], 空), 绑定(资源("任务", "j1"), ["会话/读取"], 空)]
  断言相等(访判定请求(册, 双资源请求, 双绑, 假)["结论"], "allow", "§4k 全通过则允许")

  # 条件拒绝原因优先于 explain
  设 解策 为 {"bindings": 空, "explain": 解释器}
  设 册2 为 访造策略册()
  访登记策略(册2, "plugin", 解策)
  设 拒绑 为 [绑定(资源("会话", "s1"), ["会话/读取"], 条件拒绝)]
  设 判拒 为 访判定请求(册2, 读请求, 拒绑, 假)
  断言相等(判拒["原因"], "该资源需二次确认", "§4l 条件原因优先")

  # 无拒绝原因时用 explain()
  设 无拒绑 为 [绑定(资源("会话", "s1"), ["会话/删除"], 空)]
  设 判解 为 访判定请求(册2, 读请求, 无拒绑, 假)
  断言相等(判解["原因"], "策略解释原因", "§4m explain 兜底")

  # ---------- §5 列表过滤 ----------
  断言真(访允许项(册2, 空, "会话/读取", 资源("会话", "s1"), 拒绑), "§5 调用外恒真")
  断言真(访允许项(册2, 属主, "会话/读取", 资源("会话", "s1"), 拒绑), "§5b owner 恒真")
  断言相等(访允许项(册2, 插件, "会话/读取", 资源("会话", "s1"), 拒绑), 假, "§5c 条件拒绝 → 假")
  断言真(访允许项(册2, 插件, "会话/读取", 资源("会话", "s1"), 单绑), "§5d 无条件下允许 → 真")
  断言相等(访允许项(册2, {"kind": "unknown"}, "会话/读取", 资源("会话", "s1"), 单绑), 假, "§5e 无策略 → 假")

  # ---------- §6 授权表 ----------
  设 授绑 为 [绑定(资源("会话", "s1"), ["会话/删除", "会话/读取", "event:turn/end"], 空), 绑定(资源("会话", "s1"), ["会话/标题"], 空)]
  设 授 为 访授权表(授绑)
  断言相等(长度(授), 1, "§6 同资源只出一条授权")
  # 上游 [...candidates].sort() 按 UTF-16 码元序：删(U+5220) < 标(U+6807) < 读(U+8BFB)
  断言相等(授[0]["actions"], ["会话/删除", "会话/标题", "会话/读取"], "§6b 动作去重、排除 event:、码元序")

  设 只事件 为 [绑定(资源("会话", "s2"), ["event:turn/end"], 空)]
  断言相等(长度(访授权表(只事件)), 0, "§6c 只有事件动作的资源不出授权")

  设 条件拒授 为 [绑定(资源("会话", "s3"), ["会话/读取"], 条件拒绝)]
  断言相等(长度(访授权表(条件拒授)), 0, "§6d 条件拒绝的动作不进授权")

  # ---------- §7 快照帧 ----------
  设 基线属主 为 访快照基线(属主, [])
  断言相等(基线属主["owner"], 真, "§7 owner 基线")
  断言相等(字典包含键(基线属主, "grants"), 假, "§7b owner 基线不带 grants")

  设 基线插件 为 访快照基线(插件, 授)
  断言相等(基线插件["owner"], 假, "§7c 非 owner 基线")
  断言相等(长度(基线插件["grants"]), 1, "§7d 带授权")

  设 前表 为 [{"resource": 资源("会话", "s1"), "actions": ["会话/读取"]}]
  设 后表 为 [{"resource": 资源("会话", "s1"), "actions": ["会话/读取", "会话/标题"]}, {"resource": 资源("任务", "j1"), "actions": ["任务/读取"]}]
  设 帧1 为 访快照差分(前表, 后表)
  断言相等(长度(帧1), 2, "§7e 两条 upsert（动作变化 + 新资源）")
  断言相等(帧1[0]["type"], "upsert", "§7f 帧类型")

  设 帧2 为 访快照差分(后表, 前表)
  断言相等(长度(帧2), 2, "§7g 回退：一条 upsert + 一条 remove")
  断言相等(帧2[1]["type"], "remove", "§7h 资源消失出 remove")
  断言相等(帧2[1]["resource"]["id"], "j1", "§7i remove 带资源")

  设 帧3 为 访快照差分(前表, 前表)
  断言相等(长度(帧3), 0, "§7j 无变化无帧")

  # ---------- §8 注销策略 ----------
  断言真(访注销策略(册2, "plugin"), "§8 注销已登记策略")
  断言相等(访取策略(册2, "plugin"), 空, "§8b 注销后取不到")
  断言相等(访注销策略(册2, "plugin"), 假, "§8c 重复注销为假")

  打印("test_R176_远程访问控制: 全部用例通过")

主()
