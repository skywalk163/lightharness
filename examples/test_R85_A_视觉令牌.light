# test_R85_A_视觉令牌.light —— R85 任务 A：DeepSeek 视觉令牌计算器对拍
#
# 判据锚点（verbatim，不自行推算）：
#   ddefc45fbc packages/llm/llm-deepseek/tests/image-tokens.spec.ts
#     describe('DeepSeek image tokens')  it.each(...)
#     describe('DeepSeek request image dimensions')  it.each(...)
# 移植对象：
#   src/令牌计量.light §9 —— common/image-tokens.ts（157 行新增）+ attachment longEdgeDimensions
# 覆盖：18 组上游期望令牌数、10 组上游期望请求尺寸、求解网格五字段、
#       小图放大地板、单边极值网格、fixpoint 收敛、发送尺寸与源尺寸同价不变量、
#       Math.trunc/ceil/round 语义助手。

从 令牌计量 导入 视觉令牌数, 深求请求尺寸, 视觉求解网格, 视觉网格令牌数, 视觉网格格数, 长边尺寸, 截断值, 上浮值

段落 对拍相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 对拍为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(条件))

# 上游 spec it.each(width, height, expectedTokens) —— 18 组
段落 令牌期望表:
  返回 [[100, 100, 184], [544, 544, 184], [640, 480, 206], [800, 800, 422],
    [1024, 768, 496], [1066, 600, 407], [1300, 1300, 994], [1920, 1080, 968],
    [2000, 2000, 994], [5000, 5000, 994], [300, 50, 200], [8192, 100, 593],
    [16, 8192, 590], [9000, 1, 1024], [1, 9000, 1024], [12, 1123, 380],
    [89, 2076, 254], [1224, 1429, 959]]

段落 对拍令牌表:
  遍历 行 之 令牌期望表():
    设 宽 为 行[0]
    设 高 为 行[1]
    设 期望 为 行[2]
    设 令牌 为 视觉令牌数(宽, 高)
    对拍相等(令牌, 期望, "视觉令牌 " + 转字符串(宽) + "x" + 转字符串(高))
    对拍为真(令牌 <= 1024, "令牌不超上限 " + 转字符串(宽) + "x" + 转字符串(高))

# 上游 spec request-dimensions it.each(width, height, sentWidth, sentHeight) —— 10 组
段落 尺寸期望表:
  返回 [[1224, 1429, 1187, 1386], [800, 800, 800, 800], [1302, 1302, 1302, 1302],
    [8192, 78, 8192, 78], [1, 9000, 1, 9000], [1303, 1303, 1302, 1302],
    [2048, 2048, 1302, 1302], [2048, 1024, 1848, 924], [3840, 2160, 1708, 961],
    [1080, 2400, 838, 1862]]

段落 对拍尺寸表:
  遍历 行 之 尺寸期望表():
    设 宽 为 行[0]
    设 高 为 行[1]
    设 期望宽 为 行[2]
    设 期望高 为 行[3]
    设 发送 为 深求请求尺寸(宽, 高)
    对拍相等(发送["width"], 期望宽, "发送宽 " + 转字符串(宽) + "x" + 转字符串(高))
    对拍相等(发送["height"], 期望高, "发送高 " + 转字符串(宽) + "x" + 转字符串(高))

# 上游 spec 不变量：缩放后发送尺寸的令牌数 == 源尺寸令牌数（5 组缩放用例）
段落 对拍同价不变量:
  遍历 行 之 [[1303, 1303], [2048, 2048], [2048, 1024], [3840, 2160], [1080, 2400]]:
    设 宽 为 行[0]
    设 高 为 行[1]
    设 发送 为 深求请求尺寸(宽, 高)
    设 源宽 为 发送["width"]
    设 源高 为 发送["height"]
    对拍相等(视觉令牌数(源宽, 源高), 视觉令牌数(宽, 高), "同价 " + 转字符串(宽) + "x" + 转字符串(高))

# 小图放大地板：上游 'prices small images at the documented scale-up floor'
段落 对拍小图地板:
  对拍相等(视觉令牌数(100, 100), 视觉令牌数(544, 544), "小图地板 100x100 == 544x544")
  对拍相等(视觉令牌数(1, 1), 184, "1x1 放大地板")
  对拍相等(视觉令牌数(28, 28), 184, "28x28 放大地板")
  对拍相等(视觉令牌数(545, 545), 184, "545x545 未超限直投")

段落 主:
  # ① 算术助手：对齐 JS Math.trunc / Math.ceil / Math.round(half-up) / ceilDiv
  对拍相等(截断值(2.9), 2, "trunc 正向")
  对拍相等(截断值(-2.9), -2, "trunc 负向（区别于 floor）")
  对拍相等(截断值(0.9), 0, "trunc 零点九")
  对拍相等(上浮值(2.1), 3, "ceil 正向")
  对拍相等(上浮值(-2.5), -2, "ceil 负向")
  对拍相等(上浮值(3.0), 3, "ceil 整数")
  对拍相等(上浮值(1.0), 1, "ceil 一")

  # ② 网格原语：gridCells / gridTokens
  对拍相等(视觉网格格数(1400), 34, "gridCells(1400)")
  对拍相等(视觉网格格数(14), 1, "gridCells(14)")
  对拍相等(视觉网格格数(1302), 31, "gridCells(1302)")
  对拍相等(视觉网格令牌数(20, 18), 382, "gridTokens(20,18)")
  对拍相等(视觉网格令牌数(1, 1021), 1024, "gridTokens 满预算单行")

  # ③ 求解网格五字段（2000x2000 预算 1024 → 31x31 网格 / 1302 边长）
  设 求解 为 视觉求解网格(2000, 2000, 1024)
  对拍相等(求解["网格高"], 31, "求解网格高")
  对拍相等(求解["网格宽"], 31, "求解网格宽")
  对拍相等(求解["最佳高"], 1302, "求解最佳高")
  对拍相等(求解["最佳宽"], 1302, "求解最佳宽")
  对拍相等(求解["令牌数"], 994, "求解令牌数")

  # ④ 长边尺寸：长边精确、短边半上取整、长边不小于源则原样返回
  设 长边一 为 长边尺寸(2048, 1024, 1848)
  对拍相等(长边一["width"], 1848, "长边尺寸宽")
  对拍相等(长边一["height"], 924, "长边尺寸高（半上取整）")
  设 长边二 为 长边尺寸(1080, 2400, 1862)
  对拍相等(长边二["width"], 838, "长边尺寸竖图宽")
  对拍相等(长边二["height"], 1862, "长边尺寸竖图高")
  设 长边三 为 长边尺寸(800, 800, 900)
  对拍相等(长边三["width"], 800, "长边不小于源宽原样")
  对拍相等(长边三["height"], 800, "长边不小于源高原样")

  # ⑤ 上游令牌期望表（18 组）
  对拍令牌表()

  # ⑥ 上游请求尺寸期望表（10 组）
  对拍尺寸表()

  # ⑦ 上游同价不变量（5 组）
  对拍同价不变量()

  # ⑧ 小图放大地板
  对拍小图地板()

主()
写 "test_R85_A_视觉令牌 PASS"
