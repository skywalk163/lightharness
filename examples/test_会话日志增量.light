# test_会话日志增量.light —— 第13轮 任务4（session 日志域）判据
# 上游：packages/session/session-log-deepseek/src/{index.ts, types.ts, invariant.ts}
# 运行：cd lightharness && LIGHT_MERGE=... python 运行.py examples/test_会话日志增量.light
# 反跑：_antirun_sesslog.py（A 水印不再取最大 / B 线头 seedLength 无条件落键 / C 畸形不再抛错）

从 JSON 导入 序列化JSON
从 会话日志增量 导入 事件类型交付接受, 已知事件类型集, 表面带来源集, 表面无来源集
从 会话日志增量 导入 取字段, 有字段, 是安全整数, 转数字表, 取版本号
从 会话日志增量 导入 线头, 线事件, 线事件公共段, 线化操作
从 会话日志增量 导入 接受至, 构造增量, 确认接受

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# 造会话事件（会话.light 规范中文键形状）
段落 造事件 接收 类型, 序号, 数据:
  返回 {"类型": 类型, "序号": 序号, "时间": 序号 * 10, "数据": 数据}

# 造接受事件（data 用上游线键，供水印折叠读取）
段落 造接受 接收 序号, 通过序号, 格式版本, 会话标识:
  返回 造事件(事件类型交付接受, 序号, {"sessionId": 会话标识, "sessionFormatVersion": 格式版本, "throughSeq": 通过序号})

段落 造视图 接收 头, 事件表, 记忆表:
  返回 {"头": 头, "事件表": 事件表, "记忆表": 记忆表}

# 子串包含（不依赖字符串内置方法）
段落 含错误 接收 容器文本, 子串:
  设 n 为 长度(容器文本)
  设 m 为 长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 容器文本[i:(i + m)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 主:
  打印 "===== 第 13 轮任务 4：session 日志增量（纯逻辑面）====="

  # ---- §1 线头（上游 wireHeader）----
  设 小头 为 {"版本": 2, "标识": "sess_1", "创建时间": 1730000000000}
  设 小线头 为 线头(小头)
  断言相等(小线头["version"], 2, "1a 版本透传")
  断言相等(小线头["id"], "sess_1", "1b 标识字符串化")
  断言相等(小线头["createdAt"], 1730000000000, "1c 创建时间透传")
  断言相等(字典包含键(小线头, "cwd"), 假, "1d 缺省工作目录不落键")
  断言相等(字典包含键(小线头, "parentSession"), 假, "1e 缺省父会话不落键")
  断言相等(字典包含键(小线头, "seedLength"), 假, "1f 未播种不落 seedLength")
  断言相等(字典包含键(小线头, "origin"), 假, "1g 缺省来源不落键")
  断言相等(字典包含键(小线头, "delegationDepth"), 假, "1h 缺省委派深度不落键")
  断言相等(字典包含键(小线头, "agentPreset"), 假, "1i 缺省代理预设不落键")

  设 大头 为 {"版本": 3, "标识": "sess_2", "创建时间": 5, "工作目录": "/work", "父会话": 7, "已播种": 真, "继承事件数": 12, "来源": "subagent", "委派深度": 2, "代理预设": "coding"}
  设 大线头 为 线头(大头)
  断言相等(大线头["cwd"], "/work", "1j 工作目录落键")
  断言相等(大线头["parentSession"], "7", "1k 父会话字符串化")
  断言相等(大线头["seedLength"], 12, "1l 播种时落 seedLength = 继承事件数")
  断言相等(大线头["origin"], "subagent", "1m 来源落键")
  断言相等(大线头["delegationDepth"], 2, "1n 委派深度落键")
  断言相等(大线头["agentPreset"], "coding", "1o 代理预设落键")
  设 未播头 为 {"版本": 3, "标识": "sess_3", "创建时间": 6, "已播种": 假, "继承事件数": 4}
  断言相等(字典包含键(线头(未播头), "seedLength"), 假, "1p 已播种为假不落 seedLength")
  断言相等(取版本号({"版本": [3, 0]}), 3, "1q 版本列表形态取主版本")
  断言相等(取版本号({"版本": {"主": 4, "次": 1}}), 4, "1r 版本字典形态取主版本")

  # ---- §2 线化操作（上游 wireSurfaceOp）----
  断言相等(线化操作("append"), "append", "2a append 原样")
  断言相等(序列化JSON(线化操作({"op": "replace", "startSeq": 3, "endSeq": 5})), 序列化JSON({"op": "replace", "startSeq": 3, "endSeq": 5}), "2b replace 展开")
  断言相等(序列化JSON(线化操作({"操作": "replace", "起序号": 7, "止序号": 9})), 序列化JSON({"op": "replace", "startSeq": 7, "endSeq": 9}), "2c 中文别名等价")

  # ---- §3 线事件（上游 wireEvent 类型分发）----
  设 用户事件 为 {"类型": "user/message", "序号": 4, "时间": 40, "数据": {"content": []}, "表面操作": "append", "来源事件序号": ["2", "3"]}
  设 用户线 为 线事件(用户事件)
  断言相等(用户线["type"], "user/message", "3a 类型透传")
  断言相等(用户线["seq"], 4, "3b 序号透传")
  断言相等(用户线["time"], 40, "3c 时间透传")
  断言相等(用户线["surfaceOp"], "append", "3d 表面操作 append")
  断言相等(序列化JSON(用户线["sourceEventSeqs"]), 序列化JSON([2, 3]), "3e 来源事件序号数字归一")
  断言相等(字典包含键(用户线, "ignorable"), 假, "3f 缺省不落 ignorable")
  断言相等(字典包含键(线事件({"类型": "user/message", "序号": 1, "时间": 1, "数据": {}}), "sourceEventSeqs"), 假, "3g 无来源键不落 sourceEventSeqs")

  设 助手事件 为 {"类型": "assistant/message", "序号": 5, "时间": 50, "数据": {"message": {}}, "表面操作": {"op": "replace", "startSeq": 1, "endSeq": 2}, "来源事件序号": [1]}
  设 助手线 为 线事件(助手事件)
  断言相等(序列化JSON(助手线["surfaceOp"]), 序列化JSON({"op": "replace", "startSeq": 1, "endSeq": 2}), "3h 助手替换操作展开")
  断言相等(字典包含键(助手线, "sourceEventSeqs"), 假, "3i 助手消息不带来源序号")

  设 轮次线 为 线事件({"类型": "turn/start", "序号": 6, "时间": 60, "数据": {"turn": 0}})
  断言相等(轮次线["type"], "turn/start", "3j 已知非表面类型透传")
  断言相等(字典包含键(轮次线, "surfaceOp"), 假, "3k 非表面类型无 surfaceOp")
  断言相等(字典包含键(轮次线, "ignorable"), 假, "3l 非表面类型无 ignorable")

  设 未知可忽略 为 线事件({"类型": "x/未来事件", "序号": 7, "时间": 70, "数据": {"a": 1}, "可忽略": 真, "表面操作": {"奇怪": 1}, "来源事件序号": ["9"]})
  断言相等(未知可忽略["type"], "x/未来事件", "3m 未知类型保留类型")
  断言相等(未知可忽略["ignorable"], 真, "3n 未知可忽略标记为真")
  断言相等(序列化JSON(未知可忽略["surfaceOp"]), 序列化JSON({"奇怪": 1}), "3o 不透明表面操作原样")
  断言相等(序列化JSON(未知可忽略["sourceEventSeqs"]), 序列化JSON(["9"]), "3p 不透明来源序号原样")

  设 未知不可忽略 为 线事件({"类型": "x/未来事件", "序号": 8, "时间": 80, "数据": {}, "表面操作": {"奇怪": 2}})
  断言相等(字典包含键(未知不可忽略, "ignorable"), 假, "3q 未知不可忽略不标记")
  断言相等(字典包含键(未知不可忽略, "surfaceOp"), 假, "3r 未知不可忽略丢表面操作")
  断言相等(长度(已知事件类型集), 56, "3s 已知事件类型词汇 56 项")
  断言相等(列表包含(表面带来源集, "tool/result"), 真, "3t 工具结果属带来源表面集")
  断言相等(列表包含(表面无来源集, "assistant/message"), 真, "3u 助手消息属无来源表面集")

  # ---- §4 接受水印折叠（上游 acceptedThrough）----
  设 头 为 {"版本": 2, "标识": "s_1", "创建时间": 1}
  设 空记忆 为 {}
  设 空视图 为 造视图(头, [], 空记忆)
  断言相等(接受至(空视图), -1, "4a 无接受事件水印为 -1")
  设 日志 为 []
  列表追加(日志, 造事件("user/message", 0, {}))
  列表追加(日志, 造接受(1, 0, 2, "s_1"))
  列表追加(日志, 造事件("assistant/message", 2, {}))
  列表追加(日志, 造接受(3, 2, 2, "s_1"))
  列表追加(日志, 造接受(4, 1, 2, "s_1"))
  设 记忆 为 {}
  设 视图 为 造视图(头, 日志, 记忆)
  断言相等(接受至(视图), 2, "4b 多接受事件取最大（末个更小也不回退）")
  断言相等(取字段(记忆, ["水印"], -1), 2, "4c 水印写入记忆表")
  断言相等(取字段(记忆, ["扫描点"], 0), 5, "4d 扫描点推进到事件数")

  # 4e 版本不符 → 跳过（不抛错）；接受事件自身序号须大于其水印
  设 畸形版本 为 []
  列表追加(畸形版本, 造事件("user/message", 0, {}))
  列表追加(畸形版本, 造接受(1, 0, 1, "s_1"))
  断言相等(接受至(造视图(头, 畸形版本, {})), -1, "4e 格式版本不符跳过")

  # 4f 会话不符 → 跳过
  设 异会话 为 []
  列表追加(异会话, 造事件("user/message", 0, {}))
  列表追加(异会话, 造接受(1, 0, 2, "别的会话"))
  断言相等(接受至(造视图(头, 异会话, {})), -1, "4f 会话标识不符跳过")

  # 4g 头版本非 0 且格式版本缺省（视为 0）→ 跳过
  设 缺版 为 []
  列表追加(缺版, 造事件(事件类型交付接受, 0, {"sessionId": "s_1", "throughSeq": -1}))
  断言相等(接受至(造视图(头, 缺版, {})), -1, "4g 缺省格式版本按 0 与头版本 2 不符则跳过")
  # 4h 头版本 0 时缺省格式版本（0）相符 → 水印通过
  设 零版头 为 {"版本": 0, "标识": "s_1", "创建时间": 1}
  设 缺版二 为 []
  列表追加(缺版二, 造事件("user/message", 0, {}))
  列表追加(缺版二, 造事件(事件类型交付接受, 1, {"sessionId": "s_1", "throughSeq": 0}))
  断言相等(接受至(造视图(零版头, 缺版二, {})), 0, "4h 头版本 0 时缺省格式版本可通过")

  # 4i~4l 畸形 → 抛错
  设 坏版本 为 []
  列表追加(坏版本, 造事件(事件类型交付接受, 0, {"sessionId": "s_1", "sessionFormatVersion": "2", "throughSeq": -1}))
  尝试:
    设 占位一 为 接受至(造视图(头, 坏版本, {}))
    断言真(假, "4i 非安全整数格式版本应抛错")
  捕获 异常 错误:
    断言真(含错误(转字符串(错误), "malformed acceptance format version"), "4i 非安全整数格式版本抛畸形")

  设 负版本 为 []
  列表追加(负版本, 造事件(事件类型交付接受, 0, {"sessionId": "s_1", "sessionFormatVersion": -2, "throughSeq": -1}))
  尝试:
    设 占位二 为 接受至(造视图(头, 负版本, {}))
    断言真(假, "4j 负数格式版本应抛错")
  捕获 异常 错误:
    断言真(含错误(转字符串(错误), "malformed acceptance format version"), "4j 负数格式版本抛畸形")

  设 越界水印 为 []
  列表追加(越界水印, 造事件("user/message", 0, {}))
  列表追加(越界水印, 造接受(1, 1, 2, "s_1"))
  尝试:
    设 占位三 为 接受至(造视图(头, 越界水印, {}))
    断言真(假, "4k 水印不小于自身序号应抛错")
  捕获 异常 错误:
    断言真(含错误(转字符串(错误), "malformed acceptance watermark"), "4k 越界水印抛畸形")

  设 空标识 为 []
  列表追加(空标识, 造事件(事件类型交付接受, 0, {"sessionId": "", "sessionFormatVersion": 2, "throughSeq": -1}))
  尝试:
    设 占位四 为 接受至(造视图(头, 空标识, {}))
    断言真(假, "4l 空会话标识应抛错")
  捕获 异常 错误:
    断言真(含错误(转字符串(错误), "malformed acceptance watermark"), "4l 空会话标识抛畸形")

  # 4m 增量扫描：第二次只扫新增并取更大水印
  设 增量日志 为 []
  列表追加(增量日志, 造事件("user/message", 0, {}))
  列表追加(增量日志, 造接受(1, 0, 2, "s_1"))
  设 增量记忆 为 {}
  设 增量视图 为 造视图(头, 增量日志, 增量记忆)
  断言相等(接受至(增量视图), 0, "4m 首扫水印 0")
  列表追加(增量日志, 造事件("assistant/message", 2, {}))
  列表追加(增量日志, 造接受(3, 2, 2, "s_1"))
  断言相等(接受至(增量视图), 2, "4n 增量扫描推进水印")
  断言相等(取字段(增量记忆, ["扫描点"], 0), 4, "4o 扫描点续推到 4")

  # ---- §5 增量贡献构造（上游 prepare 的 value）----
  设 构造 为 构造增量(视图, 2)
  断言相等(构造["version"], 1, "5a 贡献版本 1")
  断言相等(构造["sessionFormatVersion"], 2, "5b 贡献带会话格式版本")
  断言相等(构造["afterSeq"], 2, "5c afterSeq = 接受点")
  断言相等(构造["throughSeq"], 4, "5d throughSeq = 末事件序号")
  断言相等(长度(构造["events"]), 2, "5e 后缀为接受点之后的事件")
  断言相等(构造["events"][0]["seq"], 3, "5f 后缀起点为接受点 + 1")
  断言相等(构造["session"]["id"], "s_1", "5g 贡献内嵌线头")
  断言相等(构造增量(造视图(头, [], {}), 0) == 空, 真, "5h 空事件表不产出贡献")

  # ---- §6 接受确认（上游 accept 追加的事件）----
  设 确认 为 确认接受(视图, 构造["throughSeq"], 99)
  断言相等(确认["类型"], 事件类型交付接受, "6a 接受事件类型")
  断言相等(确认["序号"], 5, "6b 接受事件序号为当前事件数")
  断言相等(确认["时间"], 99, "6c 接受事件时间透传")
  断言相等(确认["数据"]["throughSeq"], 4, "6d 接受事件水印 = 通过序号")
  断言相等(确认["数据"]["sessionFormatVersion"], 2, "6e 接受事件带会话格式版本")
  断言相等(确认["数据"]["sessionId"], "s_1", "6f 接受事件带会话标识")
  # 追加后水印应推进到 4
  列表追加(日志, 确认)
  断言相等(接受至(造视图(头, 日志, {})), 4, "6g 确认后水印推进")

  打印 "test_会话日志增量 PASS"

主()
