# test_e2b配套.light —— e2b 沙箱配套纯逻辑核心（任务卡 G，对标编号 57）测试
# 运行：python 运行.py examples/test_e2b配套.light  → 必须 rc=0
# 反跑判据：把任一 断言相等/断言真 的期望值改反、或把期望抛改不抛，用例立即红（见各用例旁注）。
#
# 覆盖（对照原版四包纯逻辑）：
#   一、e2b：转义外壳实参 / 受控环境变量 / 是否正有限数 / 校验沙箱配置
#   二、subprocess-e2b process：按时收讫 / 是否已超时 / 是收集形态 / 有溢出 /
#       编码器源文本 / 造编码器 / 造输出重定向 / 造错误重定向 / 转义实参表 / 造内层脚本 / 命令文本
#   三、subprocess-e2b output：是否规范base64 / 造输出解码器 / 解码器推入 / 解码器收尾 /
#       造输出读者 / 读者推入 / 读者尺寸 / 读者失效溢出 / 读者读偏移
#   四、fs-e2b：归一化行尾 / 探测CRLF / 还原行尾 / 解码文本 / 解码规范路径 /
#       字面编辑 / 校验大小上限 / 校验流式上限 / 模拟受限读
#
# 结构：按测试_压缩配套 的既有风格，每个大节一个 段落 用例，主程 串行调用——
# 单个巨型函数体会触发解析器提前脱出块（语言缺陷 L-050，见对齐卡）。

从 Base64 导入 Base64编码, Base64解码
从 e2b配套 导入 转义外壳实参, 受控环境变量, 是否正有限数, 校验沙箱配置, 按时收讫, 是否已超时, 是收集形态, 有溢出, 编码器源文本, 造编码器, 造输出重定向, 造错误重定向, 转义实参表, 造内层脚本, 命令文本, 是否规范base64, 造输出解码器, 解码器推入, 解码器收尾, 造输出读者, 读者推入, 读者尺寸, 读者失效溢出, 读者读偏移, 归一化行尾, 探测CRLF, 还原行尾, 解码文本, 解码规范路径, 字面编辑, 校验大小上限, 校验流式上限, 模拟受限读, 输出完成帧

# ── 判据助手 ──

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 检查抛错 接收 关键词, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 异常 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 "应抛未抛: " + 关键词
  如果 字符串包含(消息, 关键词) == 假:
    抛出 "错误消息未含关键词: " + 关键词 + " 消息=" + 消息
  返回 消息

# 重复拼串助手（构造长文本）
段落 重复串 接收 文本, 次数:
  设 结果 为 ""
  设 序号 为 0
  当 序号 < 次数:
    设 结果 为 结果 + 文本
    设 序号 为 序号 + 1
  返回 结果

# ── 抛错探测段落（具名零参，供 检查抛错 实参）──
段落 抛配置缺密钥:
  校验沙箱配置("", "/home/user/workspace", 300000)
段落 抛配置相对路径:
  校验沙箱配置("k", "relative/path", 300000)
段落 抛配置零超时:
  校验沙箱配置("k", "/home/user/workspace", 0)
段落 抛配置负超时:
  校验沙箱配置("k", "/home/user/workspace", -5)
段落 抛配置超时非数:
  校验沙箱配置("k", "/home/user/workspace", "x")
段落 抛解码重复完成:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, 输出完成帧 + "\n" + 输出完成帧 + "\n")
段落 抛解码完成后数据:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, 输出完成帧 + "\naGVsbG8=\n")
段落 抛解码非法帧:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, "!!!\n")
段落 抛解码非规范帧:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, "a\n")
段落 抛解码空帧:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, "\n")
段落 抛解码截断:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, "aGVsbG8=")
  解码器收尾(解码器, 真)
段落 抛解码不完整:
  设 解码器 为 造输出解码器()
  解码器推入(解码器, "aGVsbG8=\n")
  解码器收尾(解码器, 真)
段落 抛解码二进制:
  解码文本("ab\0cd", "/p/f", 8192)
段落 抛路径空:
  解码规范路径("")
段落 抛路径坏字符:
  解码规范路径("!!!")
段落 抛路径非规范:
  解码规范路径("a")
段落 抛路径帧短:
  解码规范路径("YQ==")
段落 抛路径无尾零:
  解码规范路径(Base64编码("/s/x"))
段落 抛路径内嵌零:
  解码规范路径(Base64编码("/s\0x\0"))
段落 抛路径非绝对:
  解码规范路径(Base64编码("rel\0"))
段落 抛编辑空旧串:
  字面编辑("foo", { "oldString": "", "newString": "x", "replaceAll": 假 }, "/p/f")
段落 抛编辑未找到:
  字面编辑("xx oo yy", { "oldString": "foo", "newString": "bar", "replaceAll": 假 }, "/p/f")
段落 抛编辑二义:
  字面编辑("xx foo yy foo zz", { "oldString": "foo", "newString": "bar", "replaceAll": 假 }, "/p/f")
段落 抛大小超限:
  校验大小上限("/p/f", 200, 100)
段落 抛流式超限:
  校验流式上限("/p/f", 101, 100)
段落 抛读声明超限:
  模拟受限读("/p/f", 200, 100, [])
段落 抛读流中超限:
  模拟受限读("/p/f", 空, 100, [60, 50])

# ════════════ 一、e2b：转义 / 环境 / 校验 ════════════
段落 用例转义环境:
  # 1.1 转义外壳实参
  断言相等(转义外壳实参("abc"), "'abc'", "转义 简单串")
  断言相等(转义外壳实参("a b"), "'a b'", "转义 含空格")
  断言相等(转义外壳实参(""), "''", "转义 空串")
  断言相等(转义外壳实参("it's"), "'it'\"'\"'s'", "转义 含单引号")
  断言相等(转义外壳实参("a'b'c"), "'a'\"'\"'b'\"'\"'c'", "转义 双单引号")
  # 反跑判据：把任一期望值改反即红

  # 1.2 受控环境变量
  设 环境 为 受控环境变量({ "PATH": "/usr/bin", "X": "1" })
  断言相等(环境["PATH"], "/usr/bin", "受控环境 覆盖保留")
  断言相等(环境["X"], "1", "受控环境 覆盖保留2")
  断言真(开头(环境["HOME"], "/.dsh-e2b-control-") == 真, "受控环境 HOME 前缀")
  断言相等(字符串长度(环境["HOME"]), 字符串长度("/.dsh-e2b-control-") + 16, "受控环境 HOME 段长16")
  断言相等(列表长度(字典键列表(环境)), 3, "受控环境 三键")
  # 反跑判据：把前缀/段长/键数任一改反即红
  设 环境2 为 受控环境变量({})
  断言相等(列表长度(字典键列表(环境2)), 1, "受控环境 空覆盖仅HOME")
  # 反跑判据：把 1 改 2 即红

  # 1.3 是否正有限数
  断言真(是否正有限数(300000) == 真, "正有限 整数")
  断言真(是否正有限数(2.5) == 真, "正有限 浮点")
  断言真(是否正有限数(0) == 假, "正有限 零假")
  断言真(是否正有限数(-1) == 假, "正有限 负假")
  断言真(是否正有限数("x") == 假, "正有限 非数假")
  断言真(是否正有限数(空) == 假, "正有限 空假")
  # 反跑判据：任一项 真/假 改反即红

  # 1.4 校验沙箱配置
  断言相等(校验沙箱配置("k", "/home/user/workspace", 300000), 真, "校验 合法通过")
  检查抛错("configure apiKey or set E2B_API_KEY", 抛配置缺密钥)
  检查抛错("cwd must be an absolute Linux path", 抛配置相对路径)
  检查抛错("timeoutMs must be a positive finite number", 抛配置零超时)
  检查抛错("timeoutMs must be a positive finite number", 抛配置负超时)
  检查抛错("timeoutMs must be a positive finite number", 抛配置超时非数)
  # 反跑判据：任一条期望抛改不抛即红

# ════════════ 二、subprocess-e2b process：按时收讫 ════════════
段落 用例按时收讫:
  断言相等(按时收讫(真, "v"), "v", "按时 按时返回值")
  断言相等(按时收讫(假, "v"), 空, "按时 超时返回空")
  断言相等(按时收讫(真, 42), 42, "按时 数值")
  断言真(是否已超时(100, 100) == 真, "超时 到达即超时")
  断言真(是否已超时(100, 99) == 假, "超时 未到不超时")
  断言真(是否已超时(100, 101) == 真, "超时 超过必超时")
  # 反跑判据：任一项改反即红

# ════════════ 三、subprocess-e2b output：帧解码 / 收集预算 ════════════
段落 用例解码器:
  # 3.1 完整帧
  设 解码器 为 造输出解码器()
  断言相等(解码器推入(解码器, "aGVsbG8=\n"), "hello", "解码器 单帧 hello")
  # 反跑判据：把 "hello" 改 "hellp" 即红

  # 3.2 分片推入
  设 解码器2 为 造输出解码器()
  断言相等(解码器推入(解码器2, "aGVs"), "", "解码器 分片1 无帧返回空")
  断言相等(解码器推入(解码器2, "bG8=\n"), "hello", "解码器 分片2 合帧")
  # 反跑判据：把 "hello" 改反即红

  # 3.3 多帧一次推入
  设 解码器3 为 造输出解码器()
  断言相等(解码器推入(解码器3, "aGVsbG8=\nV29ybGQh\n"), "helloWorld!", "解码器 多帧拼接")
  # 反跑判据：把 "helloWorld!" 改反即红

  # 3.4 完成帧 + 收尾
  设 解码器4 为 造输出解码器()
  解码器推入(解码器4, "aGVsbG8=\n" + 输出完成帧 + "\n")
  断言真(解码器收尾(解码器4, 真) == 真, "解码器 完成帧后收尾")
  # 反跑判据：把收尾期望改反即红
  设 解码器5 为 造输出解码器()
  解码器推入(解码器5, 输出完成帧 + "\n")
  断言真(解码器收尾(解码器5, 真) == 真, "解码器 仅完成帧收尾")

  # 3.5 空推入 / 不要求完整收尾清空待定
  设 解码器6 为 造输出解码器()
  断言相等(解码器推入(解码器6, ""), "", "解码器 空推入返回空")
  解码器推入(解码器6, "aGVsbG8=")
  断言真(解码器收尾(解码器6, 假) == 真, "解码器 不要求完整清空")
  断言相等(解码器推入(解码器6, "aGVsbG8=\n"), "hello", "解码器 清空后新帧正常")
  # 反跑判据：任一项改反即红

  # 3.6 非法输入抛错
  检查抛错("duplicate output transport completion", 抛解码重复完成)
  检查抛错("continued after completion", 抛解码完成后数据)
  检查抛错("invalid base64 output transport", 抛解码非法帧)
  检查抛错("invalid base64 output transport", 抛解码非规范帧)
  检查抛错("invalid base64 output transport", 抛解码空帧)
  检查抛错("truncated base64 output transport", 抛解码截断)
  检查抛错("incomplete output transport", 抛解码不完整)
  # 反跑判据：任一条期望抛改不抛即红

  # 3.7 是否规范base64
  断言真(是否规范base64("aGVsbG8=") == 真, "规范base64 hello真")
  断言真(是否规范base64("") == 真, "规范base64 空真")
  断言真(是否规范base64("a") == 假, "规范base64 长度非4假")
  断言真(是否规范base64("aGVsbG8") == 假, "规范base64 缺填充假")
  断言真(是否规范base64("aa==") == 假, "规范base64 尾比特假")
  断言真(是否规范base64("a===") == 假, "规范base64 填充过2假")
  断言真(是否规范base64("a=bc") == 假, "规范base64 中间等号假")
  断言真(是否规范base64("!!!") == 假, "规范base64 坏字符假")
  # 反跑判据：任一项 真/假 改反即红

段落 用例读者:
  # 4.1 尾随裁剪 + 偏移读
  设 读者 为 造输出读者(10, 100, "/s/out.log")
  读者推入(读者, "hello")
  读者推入(读者, "world")
  读者推入(读者, "!")
  断言相等(读者尺寸(读者), 11, "读者 总字节11")
  # 反跑判据：把 11 改 10 即红
  设 读1 为 读者读偏移(读者, 0)
  断言相等(读1["文本"], "elloworld!", "读者 有损偏移0 文本")
  断言相等(读1["下一偏移"], 11, "读者 有损下一偏移")
  断言真(读1["有损"] == 真, "读者 偏移0有损")
  断言相等(读1["溢出档"], "/s/out.log", "读者 有损带溢出档")
  # 反跑判据：任一项改反即红
  设 读2 为 读者读偏移(读者, 5)
  断言相等(读2["文本"], "world!", "读者 偏移5 文本")
  断言真(读2["有损"] == 假, "读者 偏移5无损")
  断言真(取可选(读2, "溢出档") == 空, "读者 无损无溢出档")
  # 反跑判据：任一项改反即红
  设 读3 为 读者读偏移(读者, 11)
  断言相等(读3["文本"], "", "读者 偏移等于总长 空")
  断言真(读3["有损"] == 假, "读者 偏移等于总长无损")
  # 反跑判据：把空/无损改反即红

  # 4.2 失效溢出后不再给溢出档
  读者失效溢出(读者)
  设 读4 为 读者读偏移(读者, 0)
  断言真(读4["有损"] == 真, "读者 失效后仍判有损")
  断言真(取可选(读4, "溢出档") == 空, "读者 失效后无溢出档")
  # 反跑判据：任一项改反即红

  # 4.3 溢出上限缺失 / 总量超上限 → 无溢出档
  设 读者2 为 造输出读者(6, 空, "/s/o")
  读者推入(读者2, "abcd")
  读者推入(读者2, "ef")
  读者推入(读者2, "gh")
  断言相等(读者尺寸(读者2), 8, "读者2 总字节8")
  设 读5 为 读者读偏移(读者2, 0)
  断言相等(读5["文本"], "cdefgh", "读者2 溢出上限空 尾随文本")
  断言真(读5["有损"] == 真, "读者2 有损")
  断言真(取可选(读5, "溢出档") == 空, "读者2 溢出上限空无溢出档")
  # 反跑判据：把 "cdefgh" 改反即红
  设 读者3 为 造输出读者(4, 10, "/s/o")
  读者推入(读者3, "abcdefghijklmnop")
  设 读6 为 读者读偏移(读者3, 0)
  断言相等(读6["文本"], "mnop", "读者3 超上限 尾随4字节")
  断言真(取可选(读6, "溢出档") == 空, "读者3 总量超溢出上限无溢出档")
  # 反跑判据：把 "mnop" 改反即红

  # 4.4 偏移在保留区间内 → 无损 + 起点计算
  设 读者4 为 造输出读者(6, 100, "/s/o")
  读者推入(读者4, "abcd")
  读者推入(读者4, "ef")
  读者推入(读者4, "gh")
  设 读7 为 读者读偏移(读者4, 2)
  断言相等(读7["文本"], "cdefgh", "读者4 偏移2 起点0")
  设 读8 为 读者读偏移(读者4, 3)
  断言相等(读8["文本"], "defgh", "读者4 偏移3 起点1")
  设 读9 为 读者读偏移(读者4, 8)
  断言相等(读9["文本"], "", "读者4 偏移8 空")
  # 反跑判据：任一项改反即红

  # 4.5 空推入 / 恰好满
  设 读者5 为 造输出读者(5, 100, "/s/o")
  读者推入(读者5, "")
  断言相等(读者尺寸(读者5), 0, "读者5 空推入总长0")
  读者推入(读者5, "abcde")
  断言相等(读者尺寸(读者5), 5, "读者5 恰好满总长5")
  设 读10 为 读者读偏移(读者5, 0)
  断言真(读10["有损"] == 假, "读者5 恰好满无损")
  断言相等(读10["文本"], "abcde", "读者5 恰好满文本")
  # 反跑判据：任一项改反即红

# ════════════ 四、fs-e2b：行尾 / 文本 / 规范路径 / 编辑 / 大小 ════════════
段落 用例行尾:
  断言相等(归一化行尾("a\r\nb\r\n"), "a\nb\n", "归一化行尾 CRLF转LF")
  断言相等(归一化行尾("a\nb"), "a\nb", "归一化行尾 LF原样")
  # 反跑判据：任一项改反即红
  断言真(探测CRLF("a\r\nb\r\nc\n") == 真, "探测CRLF 混合偏CRLF真")
  断言真(探测CRLF("a\nb\nc") == 假, "探测CRLF 纯LF假")
  断言真(探测CRLF("a\r\nb") == 真, "探测CRLF 单CRLF真")
  断言真(探测CRLF("a\rb") == 假, "探测CRLF 孤立CR假")
  断言真(探测CRLF("a\rb\n") == 假, "探测CRLF CR+LF假")
  断言真(探测CRLF("") == 假, "探测CRLF 空串假")
  断言真(探测CRLF(重复串("a\r\n", 3000)) == 真, "探测CRLF 长CRLF真")
  断言真(探测CRLF(重复串("a\n", 4000) + "b\r\nc") == 假, "探测CRLF 采样窗只见LF假")
  # 反跑判据：任一项 真/假 改反即红
  断言相等(还原行尾("a\nb", 真), "a\r\nb", "还原行尾 CRLF真")
  断言相等(还原行尾("a\nb", 假), "a\nb", "还原行尾 CRLF假原样")
  断言相等(还原行尾("a\r\nb", 真), "a\r\nb", "还原行尾 先归一后还原")
  # 反跑判据：任一项改反即红

段落 用例文本解码:
  断言相等(解码文本("hello", "/p/f", 8192), "hello", "解码文本 纯文本")
  断言相等(解码文本("", "/p/f", 8192), "", "解码文本 空串")
  断言相等(解码文本("ab\0cd", "/p/f", 2), "ab\0cd", "解码文本 NUL在采样窗外")
  检查抛错("binary file", 抛解码二进制)
  # 反跑判据：任一项改反即红

段落 用例规范路径:
  设 好路径 为 解码规范路径(Base64编码("/home/user/workspace\0"))
  断言相等(好路径, "/home/user/workspace", "规范路径 正常解码")
  # 反跑判据：把期望路径改反即红
  设 好路径2 为 解码规范路径(Base64编码("/s/x\0"))
  断言相等(好路径2, "/s/x", "规范路径 短路径")
  # 反跑判据：把 "/s/x" 改反即红
  检查抛错("invalid base64", 抛路径空)
  检查抛错("invalid base64", 抛路径坏字符)
  检查抛错("invalid base64", 抛路径非规范)
  检查抛错("invalid NUL framing", 抛路径帧短)
  检查抛错("invalid NUL framing", 抛路径无尾零)
  检查抛错("invalid NUL framing", 抛路径内嵌零)
  检查抛错("not absolute", 抛路径非绝对)
  # 反跑判据：任一条期望抛改不抛即红

段落 用例字面编辑:
  设 请求1 为 { "oldString": "foo", "newString": "bar", "replaceAll": 假 }
  断言相等(字面编辑("xx foo yy", 请求1, "/p/f"), "xx bar yy", "字面编辑 单次替换")
  # 反跑判据：把 "xx bar yy" 改反即红
  断言相等(字面编辑("x foo y foo", { "oldString": "foo", "newString": "bar", "replaceAll": 真 }, "/p/f"), "x bar y bar", "字面编辑 全量替换")
  # 反跑判据：把 "x bar y bar" 改反即红
  断言相等(字面编辑("a\nfoo b", { "oldString": "a\r\nfoo", "newString": "a\r\nbaz", "replaceAll": 假 }, "/p/f"), "a\nbaz b", "字面编辑 old/new归一化")
  # 反跑判据：把 "a\nbaz b" 改反即红
  断言相等(字面编辑("a foo b", { "oldString": "foo", "newString": "bar" }, "/p/f"), "a bar b", "字面编辑 缺replaceAll按单次")
  # 反跑判据：把 "a bar b" 改反即红
  检查抛错("old_string must be non-empty", 抛编辑空旧串)
  检查抛错("old_string was not found", 抛编辑未找到)
  检查抛错("old_string matched 2 times", 抛编辑二义)
  # 反跑判据：任一条期望抛改不抛即红

段落 用例大小限制:
  校验大小上限("/p/f", 100, 100)
  校验大小上限("/p/f", 99, 100)
  检查抛错("bytes exceeds the 100-byte limit", 抛大小超限)
  校验流式上限("/p/f", 100, 100)
  检查抛错("content exceeds the 100-byte limit", 抛流式超限)
  # 反跑判据：任一条期望抛改不抛即红
  检查抛错("bytes exceeds the 100-byte limit", 抛读声明超限)
  检查抛错("content exceeds the 100-byte limit", 抛读流中超限)
  断言相等(模拟受限读("/p/f", 空, 100, [40, 30, 20]), 90, "模拟受限读 累计90")
  断言相等(模拟受限读("/p/f", 90, 100, [10]), 10, "模拟受限读 声明预检通过返块和")
  断言相等(模拟受限读("/p/f", 空, 100, [60, 40]), 100, "模拟受限读 累计恰100不抛")
  断言相等(模拟受限读("/p/f", 空, 100, []), 0, "模拟受限读 空块表0")
  # 反跑判据：任一项改反即红

# ════════════ 五、subprocess-e2b process：命令文本 ════════════
段落 用例命令文本:
  设 路径 为 { "组标识档": "/s/pid", "退出码档": "/s/exit", "环境档": "/s/env", "输出档": "/s/out.log", "错误档": "/s/err.log" }
  设 溢形态 为 { "最大字节": 1000, "溢出": { "最大字节": 100000 } }
  设 无溢形态 为 { "最大字节": 500 }

  # 5.1 是收集形态 / 有溢出
  断言真(是收集形态("pipe") == 假, "收集形态 pipe假")
  断言真(是收集形态("inherit") == 假, "收集形态 inherit假")
  断言真(是收集形态(无溢形态) == 真, "收集形态 collect真")
  断言真(有溢出(溢形态) == 真, "有溢出 spill真")
  断言真(有溢出(无溢形态) == 假, "有溢出 无spill假")
  断言真(有溢出("pipe") == 假, "有溢出 pipe假")
  断言真(有溢出({ "最大字节": 5, "溢出": { "最大字节": 10 } }) == 真, "有溢出 内联spill真")
  # 反跑判据：任一项 真/假 改反即红

  # 5.2 编码器 / 重定向逐字
  断言相等(造编码器("X"), "\"$dsh_e2b_env_bin\" -i \"$dsh_e2b_node\" -e 'X'", "造编码器 逐字")
  # 反跑判据：把期望改反即红
  断言相等(造输出重定向(溢形态, "ENC", "/s/out.log"), "> >(\"$dsh_e2b_tee\" --output-error=warn-nopipe >(\"$dsh_e2b_head\" -c 100000 > '/s/out.log') | ENC 2>/dev/null)", "造输出重定向 spill")
  断言相等(造输出重定向(无溢形态, "ENC", "/s/out.log"), "> >(ENC 2>/dev/null)", "造输出重定向 无spill")
  断言相等(造错误重定向(溢形态, "ENC", "/s/err.log"), "2> >(\"$dsh_e2b_tee\" --output-error=warn-nopipe >(\"$dsh_e2b_head\" -c 100000 > '/s/err.log') | ENC >&2 2>/dev/null)", "造错误重定向 spill")
  断言相等(造错误重定向(无溢形态, "ENC", "/s/err.log"), "2> >(ENC >&2 2>/dev/null)", "造错误重定向 无spill")
  # 反跑判据：任一条期望改反即红

  # 5.3 转义实参表
  断言相等(转义实参表([]), "", "转义实参表 空表")
  断言相等(转义实参表(["echo", "hello world", "it's"]), "'echo' 'hello world' 'it'\"'\"'s'", "转义实参表 引号拼接")
  # 反跑判据：把期望改反即红

  # 5.4 编码器源文本
  断言真(开头(编码器源文本(), "(async () => {") == 真, "编码器源 首行")
  断言真(字符串包含(编码器源文本(), "chunk.toString('base64')") == 真, "编码器源 base64调用")
  断言真(字符串包含(编码器源文本(), 输出完成帧) == 真, "编码器源 含完成帧")
  断言真(字符串包含(编码器源文本(), "process.exitCode = 1") == 真, "编码器源 退出码兜底")
  断言真(字符串包含(编码器源文本(), "+ '\\n'") == 真, "编码器源 字面换行转义")
  # 反跑判据：任一项改反即红

  # 5.5 内层脚本（stdout spill + stderr 无 spill）逐行
  设 编码器 为 造编码器(编码器源文本())
  设 输出重定向 为 造输出重定向(溢形态, 编码器, 路径["输出档"])
  设 错误重定向 为 造错误重定向(无溢形态, 编码器, 路径["错误档"])
  设 内层 为 造内层脚本(输出重定向, 错误重定向, 路径)
  断言真(开头(内层, "set +e\n") == 真, "内层 首行set+e")
  断言真(字符串包含(内层, "dsh_e2b_env_bin=$1") == 真, "内层 工具参数1")
  断言真(字符串包含(内层, "shift 7") == 真, "内层 shift7")
  断言真(字符串包含(内层, "dsh_e2b_pgid=\"$(\"$dsh_e2b_ps\" -o pgid= -p \"$$\" | \"$dsh_e2b_tr\" -d \" \")") == 真, "内层 pgid行")
  断言真(字符串包含(内层, "printf '%s\\n' \"$dsh_e2b_pgid\" > '/s/pid'") == 真, "内层 pgid档行")
  断言真(字符串包含(内层, "mapfile -d '' -t dsh_e2b_env < '/s/env'") == 真, "内层 环境档读入")
  断言真(字符串包含(内层, "\"$dsh_e2b_rm\" -f -- '/s/env'") == 真, "内层 环境档删除")
  断言真(字符串包含(内层, "> >(\"$dsh_e2b_tee\" --output-error=warn-nopipe >(\"$dsh_e2b_head\" -c 100000 > '/s/out.log')") == 真, "内层 stdout spill")
  断言真(字符串包含(内层, "2> >(\"$dsh_e2b_env_bin\" -i \"$dsh_e2b_node\" -e ") == 真, "内层 stderr 无spill编码器")
  断言真(字符串包含(内层, "printf '%s\\n' \"$dsh_e2b_status\" > '/s/exit'") == 真, "内层 退出码档行")
  断言真(字符串包含(内层, "exit \"$dsh_e2b_status\"") == 真, "内层 退出行")
  # 反跑判据：任一条改反即红

  # 5.6 命令文本（stdout spill + stderr 无 spill）
  设 规格A 为 { "参数表": ["echo", "hello world", "it's"], "工作目录": "/w", "环境表": {}, "标准流": { "输入": "ignore", "输出": 溢形态, "错误": 无溢形态 }, "宽限毫秒": 5000 }
  设 引导A 为 命令文本(规格A, 路径)
  断言真(开头(引导A, "mapfile -d '' -t dsh_e2b_env < '/s/env'\n") == 真, "命令文本 首行环境档")
  断言真(字符串包含(引导A, "dsh_e2b_env_bin=\"$(command -v env)\"") == 真, "命令文本 env定位")
  断言真(字符串包含(引导A, "dsh_e2b_setsid=\"$(command -v setsid)\"") == 真, "命令文本 setsid定位")
  断言真(字符串包含(引导A, "for dsh_e2b_tool in \"$dsh_e2b_env_bin\"") == 真, "命令文本 工具循环")
  断言真(字符串包含(引导A, "  [[ \"$dsh_e2b_tool\" == /* && -x \"$dsh_e2b_tool\" ]] || exit 125") == 真, "命令文本 校验行")
  断言真(字符串包含(引导A, "done") == 真, "命令文本 循环收尾")
  断言真(字符串包含(引导A, "exec \"$dsh_e2b_env_bin\" -i -- \"${dsh_e2b_env[@]}\" \"$dsh_e2b_setsid\" --wait -- \"$dsh_e2b_bash\" -c ") == 真, "命令文本 exec行")
  断言真(字符串包含(引导A, "(async () => {") == 真, "命令文本 编码器源嵌入")
  断言真(字符串包含(引导A, "for await (const chunk of process.stdin)") == 真, "命令文本 编码器源逐行")
  断言真(字符串包含(引导A, 转义外壳实参(内层)) == 真, "命令文本 引号内层脚本")
  断言真(字符串包含(引导A, " dsh-e2b \"$dsh_e2b_env_bin\" \"$dsh_e2b_node\"") == 真, "命令文本 内层实参头")
  断言真(字符串包含(引导A, "'echo' 'hello world' 'it'\"'\"'s'") == 真, "命令文本 argv引号")
  # 反跑判据：任一条改反即红

  # 5.7 命令文本（stdout 无 spill + stderr spill）
  设 溢形态B 为 { "最大字节": 100, "溢出": { "最大字节": 5000 } }
  设 规格B 为 { "参数表": ["ls", "-l"], "工作目录": "/w", "环境表": {}, "标准流": { "输入": "inherit", "输出": 无溢形态, "错误": 溢形态B }, "宽限毫秒": 1000 }
  设 输出重定向B 为 造输出重定向(无溢形态, 编码器, 路径["输出档"])
  设 错误重定向B 为 造错误重定向(溢形态B, 编码器, 路径["错误档"])
  设 内层B 为 造内层脚本(输出重定向B, 错误重定向B, 路径)
  设 引导B 为 命令文本(规格B, 路径)
  断言真(字符串包含(内层B, "> >(\"$dsh_e2b_env_bin\" -i \"$dsh_e2b_node\" -e ") == 真, "内层B stdout 无spill编码器")
  断言真(字符串包含(内层B, "2> >(\"$dsh_e2b_tee\" --output-error=warn-nopipe >(\"$dsh_e2b_head\" -c 5000 > '/s/err.log')") == 真, "内层B stderr spill")
  断言真(字符串包含(引导B, 转义外壳实参(内层B)) == 真, "命令文本B 引号内层脚本")
  断言真(字符串包含(引导B, "> >(\"$dsh_e2b_tee\" --output-error=warn-nopipe >(\"$dsh_e2b_head\" -c 100000 > '/s/out.log')") == 假, "命令文本B stdout 无spill tee")
  # 反跑判据：任一条改反即红

# ════════════ 主程 ════════════
段落 主程:
  用例转义环境()
  用例按时收讫()
  用例解码器()
  用例读者()
  用例行尾()
  用例文本解码()
  用例规范路径()
  用例字面编辑()
  用例大小限制()
  用例命令文本()
  打印 "--- 测试 e2b配套 通过 ---"

主程()
