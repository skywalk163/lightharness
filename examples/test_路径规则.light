# test_路径规则.light —— 模块60 路径规则 对齐判据
# 运行：python 运行.py examples/test_路径规则.light
#
# 反跑判据（改反任一期望值测试必须红）：
#   - 判定在界内：把某行 锚点/在界内 期望改反（真↔假 / 值↔他值）测试必须红
#   - 判定目标：把 含链接 真↔假、策略 越界抛↔放行 改反测试必须红
#   - 观测策略：把 读/写许可 真↔假、已观测 内容↔他值 改反测试必须红
#   - 解析本地目标：把 需建表 期望、祖先为文件 抛↔不抛 改反测试必须红
#   - 判定写文本/编辑文本：把 许可 真↔假、补换行 内容 改反测试必须红
#   - 整理命中次序：把任一档名/行号期望顺序调换测试必须红
#   - 替换文本：把 未找到/二义 抛↔不抛、唯一替换 结果 改反测试必须红

从 路径规则 导入 判定在界内, 判定目标, 造观测策略, 记录观测, 判定读许可, 判定写许可, 应询问, 解析本地目标, 判定写文本, 判定编辑文本, 施加编辑, 补换行, 整理命中次序, 判定唯一性, 替换文本

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 信息 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 信息:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 信息)

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误 为 e:
    设 抛了 为 真
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)

# ---------- 判定在界内：身份判定入参 ----------
段落 查身份空 接收 路径:
  返回 空

段落 查身份命中 接收 路径:
  如果 路径 == "C:\\沙盒" 或 路径 == "C:\\长名目录":
    返回 "inode-7"
  返回 空

段落 查身份异 接收 路径:
  如果 路径 == "C:\\沙盒":
    返回 "inode-7"
  返回 "inode-9"

# ---------- 判定目标：解析投影入参 ----------
段落 解析原样 接收 路径:
  返回 路径

段落 解析链接 接收 路径:
  如果 路径 == "/w/入/快捷":
    返回 "/w/根/实文件"
  返回 路径

段落 解析链外 接收 路径:
  如果 路径 == "/w/入/快捷":
    返回 "/w/别处/实文件"
  返回 路径

段落 越界只读:
  判定目标("/w/别处/x", "/w/根", "只读", 真, "posix", 解析原样, 查身份空)

段落 越界写:
  判定目标("/w/别处/x", "/w/根", "工作区写", 真, "posix", 解析原样, 查身份空)

段落 根内只读:
  设 解 为 判定目标("/w/根/a", "/w/根", "只读", 真, "posix", 解析原样, 查身份空)
  断言相等(解["目标"], "/w/根/a", "根内目标原样")
  断言真(解["含链接"] == 假, "根内无链接")

段落 链接根内:
  设 解 为 判定目标("/w/入/快捷", "/w/根", "只读", 真, "posix", 解析链接, 查身份空)
  断言相等(解["目标"], "/w/根/实文件", "链接解析到实路径")
  断言真(解["含链接"] == 真, "含链接标记真")

段落 链接越界只读:
  判定目标("/w/入/快捷", "/w/根", "只读", 真, "posix", 解析链外, 查身份空)

段落 解析失败:
  设 解 为 判定目标("/w/根/a", "/w/根", "只读", 真, "posix", 空, 查身份空)
  断言相等(解["目标"], "/w/根/a", "解析失败用原路径")

# ---------- 解析本地目标：投影与类别入参 ----------
段落 解析原样2 接收 路径:
  返回 路径

段落 解析链2 接收 路径:
  如果 路径 == "/w/入/快捷":
    返回 "/w/实/文件"
  返回 路径

段落 查类别目录 接收 路径:
  返回 "目录"

段落 查类别缺 接收 路径:
  如果 路径 == "/w/a" 或 路径 == "/w/a/b":
    返回 "无"
  返回 "目录"

段落 查类别祖文件 接收 路径:
  如果 路径 == "/w/a":
    返回 "文件"
  返回 "目录"

段落 空目标:
  解析本地目标("", "/w", "posix", 解析原样2, 查类别目录)

段落 祖先文件:
  解析本地目标("a/b", "/w", "posix", 解析原样2, 查类别祖文件)

# ---------- 替换判错 ----------
段落 换未找到:
  替换文本("abc", "xyz", "NEW")

段落 换二义:
  替换文本("aXbXc", "X", "Y")

段落 做命中 接收 名, 行:
  返回 ["档名": 名, "行号": 行]

段落 主:
  # ============ 1) containment：判定在界内 ============
  # 目标==根
  设 甲 为 判定在界内("/w/根", "/w/根", 假, 真, "posix", 查身份空)
  断言真(甲["在界内"], "目标==根 应在界内")
  断言相等(甲["锚点"], "/w/根", "目标==根 锚点为目标")
  # 目标在根树内（分量级前缀）
  设 乙 为 判定在界内("/w/根/a/b", "/w/根", 假, 真, "posix", 查身份空)
  断言真(乙["在界内"], "子树应在界内")
  断言相等(乙["锚点"], "/w/根", "子树锚点为根")
  # 兄弟目录不误判（裸前缀会把 根_旁 收进 根）
  设 丙 为 判定在界内("/w/根_旁/a", "/w/根", 假, 真, "posix", 查身份空)
  断言真(丙["在界内"] == 假, "兄弟目录应越界")
  # 大小写别名：win32 忽略大小写
  设 丁 为 判定在界内("C:/A/文件.txt", "c:\\a", 假, 假, "win32", 查身份空)
  断言真(丁["在界内"], "大小写别名应在界内")
  # 大小写敏感时拒绝
  设 戊 为 判定在界内("C:/A/文件.txt", "c:\\a", 假, 真, "win32", 查身份空)
  断言真(戊["在界内"] == 假, "大小写敏感应拒绝")
  # stat 祖先身份回退：词法在根外但祖先共享 inode（Windows 8.3/大小写别名）
  设 亥 为 判定在界内("C:\\长名目录\\子", "C:\\沙盒", 真, 真, "win32", 查身份命中)
  断言真(亥["在界内"], "身份回退应在界内")
  断言相等(亥["锚点"], "C:\\长名目录", "身份回退锚点为共享祖先")
  # 身份回退失败：根身份非空但目标祖先身份不同
  设 庚 为 判定在界内("C:\\别处\\子", "C:\\沙盒", 真, 真, "win32", 查身份异)
  断言真(庚["在界内"] == 假, "身份不同应越界")
  # 可链接=假：不做身份回退
  设 辛 为 判定在界内("C:\\长名目录\\子", "C:\\沙盒", 假, 真, "win32", 查身份命中)
  断言真(辛["在界内"] == 假, "不可链接不回溯身份")
  # 空根一律越界
  设 壬 为 判定在界内("/a", "", 假, 真, "posix", 查身份空)
  断言真(壬["在界内"] == 假, "空根应越界")

  # ============ 2) checkedTarget：判定目标 ============
  # 只读策略：根外目标拒绝
  检查抛错("只读越界应拒", 越界只读)
  # 工作区写策略：根外目标拒绝
  检查抛错("工作区写越界应拒", 越界写)
  # 危险全通：根外放行
  设 全通 为 判定目标("/w/别处/x", "/w/根", "危险全通", 真, "posix", 解析原样, 查身份空)
  断言相等(全通["目标"], "/w/别处/x", "危险全通放行原目标")
  断言真(全通["含链接"] == 假, "无链接标记假")
  # 根内目标：只读放行
  根内只读()
  # 符号链接：实路径投影 + 含链接标记，实路径在根内放行
  链接根内()
  # 符号链接解析到根外：只读拒绝
  检查抛错("链接越界只读应拒", 链接越界只读)
  # 解析失败（解析路径为空）：用原路径判定
  解析失败()

  # ============ 3) 观测策略状态机 ============
  设 策 为 造观测策略()
  断言相等(策["状态"], "缺席", "初始缺席")
  断言真(策["已观测"] == 空, "初始未观测")
  断言真(判定读许可(策) == 假, "缺席拒绝读")
  断言真(判定写许可(策, 空, 假) == 假, "无写意图拒绝写")
  断言真(判定写许可(策, "缺失即建", 假) == 真, "缺席+缺失即建可写")
  断言真(判定写许可(策, "按版本替换", 假) == 假, "缺席+按版本替换拒写")
  断言真(判定写许可(策, "缺失即建", 真) == 假, "缺席+编辑拒写")
  断言真(判定写许可(策, "未知意图", 假) == 假, "未知意图拒写")
  断言真(应询问(策, "缺失即建", 假) == 真, "缺席读拒绝须询问")
  断言真(应询问(策, "按版本替换", 假) == 真, "缺席写拒绝须询问")
  # 记录观测：在场 + 已观测
  设 策2 为 记录观测(策, "内容A")
  断言相等(策2["状态"], "在场", "记录后在场")
  断言相等(策2["已观测"], "内容A", "记录保存内容")
  断言真(判定读许可(策2) == 真, "在场+已观测可读")
  断言真(判定写许可(策2, 空, 假) == 假, "在场仍拒无意图写")
  断言真(判定写许可(策2, "按版本替换", 假) == 真, "在场+按版本替换可写")
  断言真(判定写许可(策2, "缺失即建", 假) == 假, "在场+缺失即建拒写")
  断言真(判定写许可(策2, "按版本替换", 真) == 真, "在场+已观测+编辑可写")
  断言真(应询问(策2, "按版本替换", 假) == 假, "在场按版本替换不询问")
  # 在场但未观测（快照缺失）：拒绝读与编辑
  设 策3 为 ["状态": "在场", "已观测": 空]
  断言真(判定读许可(策3) == 假, "在场未观测拒绝读")
  断言真(判定写许可(策3, "按版本替换", 假) == 真, "在场未观测按版本替换可写")
  断言真(判定写许可(策3, "按版本替换", 真) == 假, "在场未观测编辑拒写")

  # ============ 4) resolveLocalTarget：解析本地目标 ============
  # 空路径抛错
  检查抛错("空目标应抛", 空目标)
  # 相对路径基准拼接
  设 解1 为 解析本地目标("a/b", "/w", "posix", 解析原样2, 查类别目录)
  断言相等(解1["目标"], "/w/a/b", "相对拼接为绝对")
  断言相等(解1["需建表"], [], "祖先已存在无需建")
  # 绝对路径原样
  设 解2 为 解析本地目标("/abs/x", "/w", "posix", 解析原样2, 查类别目录)
  断言相等(解2["目标"], "/abs/x", "绝对原样")
  # 缺失祖先重建：逐级收集
  设 解3 为 解析本地目标("a/b/c", "/w", "posix", 解析原样2, 查类别缺)
  断言相等(解3["目标"], "/w/a/b/c", "拼接目标")
  断言相等(解3["需建表"], ["/w/a/b", "/w/a"], "祖先重建表按自近而远")
  # symlink realpath 投影
  设 解4 为 解析本地目标("/w/入/快捷", "/w", "posix", 解析链2, 查类别目录)
  断言相等(解4["目标"], "/w/实/文件", "realpath 投影")
  # Windows 非目录祖先：抛错
  检查抛错("非目录祖先应抛", 祖先文件)

  # ============ 5) writeText/editText：判定写文本/判定编辑文本 ============
  # 目录拒绝
  设 写1 为 判定写文本("目录", 空, "v1", 假, "x")
  断言真(写1["许可"] == 假, "目录拒写")
  # 不存在 + 非缺失即建：拒绝
  设 写2 为 判定写文本("无", 空, 空, 假, "x")
  断言真(写2["许可"] == 假, "不存在拒写")
  # 不存在 + 缺失即建：许可且内容原样
  设 写3 为 判定写文本("无", 空, 空, 真, "新内容")
  断言真(写3["许可"] == 真, "缺失即建可写")
  断言相等(写3["内容"], "新内容", "缺失即建内容原样")
  # 版本过期拒绝
  设 写4 为 判定写文本("文件", "v2", "v1", 假, "x")
  断言真(写4["许可"] == 假, "版本过期拒写")
  # 版本一致许可
  设 写5 为 判定写文本("文件", "v2", "v2", 假, "y")
  断言真(写5["许可"] == 真, "版本一致可写")
  断言相等(写5["内容"], "y", "内容通过")
  # 编辑：应用编辑 + 恢复换行
  设 编1 为 判定编辑文本("文件", "v1", "v1", 假, "aaa\nbbb", [["起始": 4, "结束": 4, "新文本": "XYZ"]])
  断言相等(编1["内容"], "aaa\nXYZbbb\n", "编辑应用+补换行")
  # 编辑：区间替换
  设 编2 为 判定编辑文本("文件", 空, "v1", 假, "hello world", [["起始": 0, "结束": 5, "新文本": "goodbye"]])
  断言相等(编2["内容"], "goodbye world\n", "区间替换")
  # 缺失即建 + 编辑：以原内容补换行
  设 编3 为 判定编辑文本("无", 空, 空, 真, "", [])
  断言真(编3["许可"] == 真, "缺失即建编辑可写")
  断言相等(编3["内容"], "", "缺失即建空编辑")
  # 补换行边界
  断言相等(补换行("abc"), "abc\n", "无换行补一个")
  断言相等(补换行("abc\n"), "abc\n", "已有换行不动")
  断言相等(补换行(""), "", "空内容不动")
  # 施加编辑单点
  断言相等(施加编辑("abcd", 1, 3, "XY"), "aXYd", "单点替换")

  # ============ 6) 搜索结果排序：整理命中次序 ============
  设 排1 为 整理命中次序([做命中("b", 2), 做命中("a", 5), 做命中("a", 1), 做命中("b", 1)])
  断言相等(排1, [做命中("a", 1), 做命中("a", 5), 做命中("b", 1), 做命中("b", 2)], "按档名再行号升序")
  设 排2 为 整理命中次序([做命中("z", 9)])
  断言相等(排2, [做命中("z", 9)], "单命中原样")

  # ============ 7) 替换唯一性/未找到判错 ============
  检查抛错("未找到应抛", 换未找到)
  检查抛错("二义应抛", 换二义)
  断言相等(替换文本("aXb", "X", "Y"), "aYb", "唯一替换")
  断言真(判定唯一性("aXbXc", "X") == 假, "两次不唯一")
  断言真(判定唯一性("aXb", "X") == 真, "一次唯一")
  断言真(判定唯一性("abc", "X") == 假, "零次不唯一")

  打印("--- 路径规则（模块60）测试通过 ---")

主()
