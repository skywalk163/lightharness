# test_r111用户问题投影.light —— R111-R4 组2：user-questions 折叠状态机探针
# 对标源：packages/interaction/user-questions/src/projection.ts + tests/projection.spec.ts @ dsh-v0.2.0-rc.2
# 反跑判据：
#   破坏 定时标记判定（properties 缺 timeout 也判定时）→ 用例1 立红；
#   破坏 tool/result 分支（挂起/修复 → continued、答案 → 结算、失败 → 丢弃）→ 用例3/4/5/7 立红；
#   破坏 迟到回复结算 → 用例6 立红；破坏 不可读参数忽略 → 用例8 立红。

从 用户问题投影 导入 折叠问题集, 应用问题事件, 是定时提问模式, 读问题表, 是挂起结果, 读答案批次, 定时等待参数名, 问称工具名, 修复结果错误码

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：条件=" + 转字符串(条件))
  返回 真

# ---- 事件构造器 ----
段落 头事件(工具表):
  设 头 为 ["tools": 工具表]
  设 数据 为 ["header": 头]
  返回 ["类型": "request/header", "数据": 数据]

段落 调用事件(调用id, 参数串):
  设 数据 为 ["name": 问称工具名, "arguments": 参数串, "callId": 调用id]
  返回 ["类型": "tool/call", "数据": 数据]

段落 结果事件(调用id, 内容, 错误表, 是错误):
  设 消息 为 ["toolCallId": 调用id, "content": 内容]
  如果 是错误 != 空:
    消息["isError"] 为 是错误
  结束。
  设 数据 为 ["message": 消息]
  如果 错误表 != 空:
    数据["错误"] 为 错误表
  结束。
  返回 ["类型": "tool/result", "数据": 数据]

段落 迟到回复事件(调用id, 答案串):
  设 来源 为 ["kind": "user-question-reply", "callId": 调用id]
  设 数据 为 ["source": 来源, "content": [["type": "text", "text": 答案串]]]
  返回 ["类型": "user/message", "数据": 数据]

# ---- 共享形状 ----
段落 造旧工具:
  返回 ["name": "ask_user_question", "parameters": ["type": "object", "properties": ["questions": ["type": "array"]]]]

段落 造定时工具:
  返回 ["name": "ask_user_question", "parameters": ["type": "object", "properties": ["questions": ["type": "array"], "timeout": ["type": "integer"]]]]

段落 造定时头事件:
  设 工具表 为 [造定时工具()]
  返回 头事件(工具表)

段落 造问题参数串:
  返回 "{\"questions\": [{\"id\": \"q1\", \"question\": \"选哪个？\", \"options\": [{\"label\": \"A\"}, {\"label\": \"B\"}]}]}"

段落 造答案串:
  返回 "{\"answers\": [{\"id\": \"q1\", \"selected\": [\"A\"]}]}"

段落 造挂起串:
  返回 "{\"pending\": true, \"callId\": \"call_1\", \"message\": \"...\"}"

# ---- 单元判定 ----
段落 用例0单元判定:
  断言(是定时提问模式(造定时工具()) == 真, "用例0a: 定时 schema 判真")
  断言(是定时提问模式(造旧工具()) == 假, "用例0b: 旧 schema 判假")
  断言(是定时提问模式(["name": "bash", "parameters": ["properties": ["timeout": 1]]]) == 假, "用例0c: 工具名不符判假")
  设 问题表 为 读问题表(造问题参数串())
  断言(问题表[0]["id"] == "q1", "用例0d: 参数读出 q1")
  断言(问题表[0].获取("multiSelect", 空) == 空, "用例0e: 无 multi_select 不落键")
  断言(是挂起结果([["type": "text", "text": 造挂起串()]]) == 真, "用例0f: 挂起载荷判真")
  断言(是挂起结果([["type": "text", "text": "工具执行失败"]]) == 假, "用例0g: 非 JSON 判假")
  设 答案批次 为 读答案批次([["type": "text", "text": 造答案串()]])
  断言(答案批次[0]["id"] == "q1", "用例0h: 答案读出")
  断言(读答案批次([["type": "text", "text": "失败"]]) == 空, "用例0i: 不可读返回空")
  断言相等(定时等待参数名, "timeout", "用例0j: 定时等待参数名逐字")
  写 "通过: 用例0 单元判定"

# ---- 折叠链路 ----
段落 用例1旧schema不入折叠:
  设 事件表 为 [头事件([造旧工具()]), 调用事件("call_1", 造问题参数串())]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 0, "用例1a: 旧 schema 调用不入集")
  断言(长度(视图["settled"]) == 0, "用例1b: settled 空")
  设 全折叠 为 应用问题事件(["timed": 假, "questions": ["active": [], "settled": []]], 事件表[0])
  断言(全折叠["timed"] == 假, "用例1c: 旧 schema 头不定时")
  写 "通过: 用例1 旧 schema 不入折叠"

段落 用例2定时调用入集open:
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串())]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 1, "用例2a: active 1 条")
  断言相等(视图["active"][0]["callId"], "call_1", "用例2b: callId")
  断言相等(视图["active"][0]["state"], "open", "用例2c: state open")
  断言(视图["active"][0]["questions"][0]["question"] == "选哪个？", "用例2d: 问题读出")
  写 "通过: 用例2 定时调用入集 open"

段落 用例3挂起结果转continued:
  设 挂起内容 为 [["type": "text", "text": 造挂起串()]]
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", 挂起内容, 空, 空)]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 1, "用例3a: 仍 active")
  断言相等(视图["active"][0]["state"], "continued", "用例3b: 挂起转 continued")
  断言(长度(视图["settled"]) == 0, "用例3c: 未结算")
  写 "通过: 用例3 挂起结果转 continued"

段落 用例4修复码转continued:
  设 失败内容 为 [["type": "text", "text": "工具执行中断"]]
  设 修复错误 为 ["code": 修复结果错误码]
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", 失败内容, 修复错误, 空)]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 1, "用例4a: 仍 active")
  断言相等(视图["active"][0]["state"], "continued", "用例4b: 修复码转 continued")
  写 "通过: 用例4 修复码转 continued"

段落 用例5答案结果结算:
  设 答案内容 为 [["type": "text", "text": 造答案串()]]
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", 答案内容, 空, 假)]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 0, "用例5a: active 清空")
  断言(长度(视图["settled"]) == 1, "用例5b: settled 1 条")
  断言相等(视图["settled"][0]["callId"], "call_1", "用例5c: 结算 callId")
  断言(视图["settled"][0]["answers"][0]["id"] == "q1", "用例5d: 答案随批入 settled")
  写 "通过: 用例5 答案结果结算"

段落 用例6迟到回复结算:
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", [["type": "text", "text": 造挂起串()]], 空, 空), 迟到回复事件("call_1", 造答案串())]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 0, "用例6a: 挂起后迟到回复结算")
  断言(长度(视图["settled"]) == 1, "用例6b: settled 1 条")
  # 普通 user/message（非 user-question-reply）不改折叠
  设 普通消息 为 ["类型": "user/message", "数据": ["source": ["kind": "client"], "content": [["type": "text", "text": 造答案串()]]]]
  设 视图2 为 应用问题事件(["timed": 假, "questions": ["active": [["callId": "call_1", "questions": [], "state": "open"]], "settled": []]], 普通消息)
  断言(长度(视图2["questions"]["active"]) == 1, "用例6c: 非迟到回复不改折叠")
  写 "通过: 用例6 迟到回复结算"

段落 用例7失败结果丢弃:
  设 失败内容 为 [["type": "text", "text": "回答批次无效"]]
  设 事件表 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", 失败内容, 空, 真)]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 0, "用例7a: isError 结果从 active 丢弃")
  断言(长度(视图["settled"]) == 0, "用例7b: 未结算")
  # 其他错误（非修复码）也丢弃
  设 其他错误 为 ["code": "SOME_ERROR"]
  设 事件表2 为 [造定时头事件(), 调用事件("call_1", 造问题参数串()), 结果事件("call_1", 失败内容, 其他错误, 空)]
  设 视图2 为 折叠问题集(事件表2)
  断言(长度(视图2["active"]) == 0, "用例7c: 其他错误同样丢弃")
  写 "通过: 用例7 失败结果丢弃"

段落 用例8不可读参数忽略:
  设 事件表 为 [造定时头事件(), 调用事件("call_1", "这不是JSON"), 调用事件("call_1", "{\"questions\": []}")]
  设 视图 为 折叠问题集(事件表)
  断言(长度(视图["active"]) == 0, "用例8a: 畸形/空参数不入集")
  # 无关事件不改折叠
  设 无关 为 ["类型": "turn/start", "数据": ["轮次": 1]]
  设 折叠 为 ["timed": 真, "questions": ["active": [], "settled": []]]
  断言(应用问题事件(折叠, 无关) == 折叠, "用例8b: 无关事件折叠不变")
  写 "通过: 用例8 不可读参数忽略"

用例0单元判定
用例1旧schema不入折叠
用例2定时调用入集open
用例3挂起结果转continued
用例4修复码转continued
用例5答案结果结算
用例6迟到回复结算
用例7失败结果丢弃
用例8不可读参数忽略
写 "test_r111用户问题投影：9 用例全绿"
