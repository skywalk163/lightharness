从 任务拉取泵 导入 校验轮询间隔, 造拉取泵, 抽一轮, 终抽, 记录沉降盆
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错(标签, 运算):
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 抛了 == 假:
    抛出 新建 错误("期望抛错但未抛: " + 标签)

# 脚本源：读(游标) 依次吐出台本里的读回；channel 可缺省
段落 造脚本源(脚本, 流道=空):
  设 柜 为 {"脚本": 脚本, "调用": 0}
  段落 读(游标):
    如果 柜["调用"] >= 列表长度(柜["脚本"]):
      返回 ["text": "", "nextOffset": 游标, "lossy": 假, "spillPath": 空]
    设 读回 为 柜["脚本"][柜["调用"]]
    设 柜["调用"] 为 柜["调用"] + 1
    返回 读回
  设 柜["读"] 为 读
  如果 流道 != 空:
    设 柜["channel"] 为 流道
  返回 柜

段落 段_间隔零:
  设 泵 为 造拉取泵([], 0)

段落 段_间隔负:
  设 泵 为 造拉取泵([], 0 - 1)

段落 段_间隔串:
  设 泵 为 造拉取泵([], "100")

段落 主程:
  # 1. 入参校验
  断言相等(校验轮询间隔(100), 真, "100ms 合法")
  检查抛错("间隔 0 应抛", 段_间隔零)
  检查抛错("间隔负应抛", 段_间隔负)
  检查抛错("间隔串应抛", 段_间隔串)

  # 2. 单源一轮：裸文本无 channel 无 lossy → 裸追加；spill 每次都报
  设 源1 为 造脚本源([["text": "hello", "nextOffset": 5, "lossy": 假, "spillPath": "/tmp/a.log"]])
  设 泵 为 造拉取泵([源1], 50)
  设 盆 为 新建 记录沉降盆()
  抽一轮(泵, 盆)
  断言相等(列表长度(盆.追加表), 1, "一轮追加一块")
  断言相等(盆.追加表[0]["text"], "hello", "裸文本")
  断言相等(字典包含键(盆.追加表[0], "channel"), 假, "无 channel 不带")
  断言相等(字典包含键(盆.追加表[0], "gapBefore"), 假, "非 lossy 不带 gap")
  断言相等(盆.溢录表[0]["index"], 0, "spill index 0")
  断言相等(盆.溢录表[0]["path"], "/tmp/a.log", "spill 路径透传")

  # 3. 游标推进：第二轮 read(cursor=5)，吐下一段
  设 源1 为 造脚本源([
    ["text": "first", "nextOffset": 5, "lossy": 假, "spillPath": 空],
    ["text": "second", "nextOffset": 11, "lossy": 假, "spillPath": 空]
  ])
  设 泵 为 造拉取泵([源1], 50)
  设 盆 为 新建 记录沉降盆()
  抽一轮(泵, 盆)
  抽一轮(泵, 盆)
  断言相等(盆.追加表[0]["text"], "first", "第一轮 first")
  断言相等(盆.追加表[1]["text"], "second", "第二轮 second（游标推进）")

  # 4. lossy 读回 → gapBefore；channel 源 → 带 channel
  设 源2 为 造脚本源([["text": "tail", "nextOffset": 4, "lossy": 真, "spillPath": 空]], "stderr")
  设 泵 为 造拉取泵([源2], 50)
  设 盆 为 新建 记录沉降盆()
  抽一轮(泵, 盆)
  断言相等(盆.追加表[0]["channel"], "stderr", "channel 透传")
  断言相等(盆.追加表[0]["gapBefore"], 真, "lossy 标 gapBefore")

  # 5. 空文本不追加，但 spill 仍报
  设 源3 为 造脚本源([["text": "", "nextOffset": 0, "lossy": 假, "spillPath": "/tmp/empty.log"]])
  设 泵 为 造拉取泵([源3], 50)
  设 盆 为 新建 记录沉降盆()
  抽一轮(泵, 盆)
  断言相等(列表长度(盆.追加表), 0, "空文本不追加")
  断言相等(盆.溢录表[0]["path"], "/tmp/empty.log", "空文本仍报 spill")

  # 6. 多源按序 drain；终抽再抽一次
  设 源甲 为 造脚本源([["text": "A", "nextOffset": 1, "lossy": 假, "spillPath": 空]])
  设 源乙 为 造脚本源([["text": "B", "nextOffset": 1, "lossy": 假, "spillPath": 空]])
  设 泵 为 造拉取泵([源甲, 源乙], 50)
  设 盆 为 新建 记录沉降盆()
  抽一轮(泵, 盆)
  断言相等(盆.追加表[0]["text"], "A", "源甲先")
  断言相等(盆.追加表[1]["text"], "B", "源乙后")
  终抽(泵, 盆)
  断言相等(列表长度(盆.追加表), 2, "终抽：源已耗尽不再追加")

  写 "test_R87_B3_jobs_拉取泵: 全部用例通过"

主程()
