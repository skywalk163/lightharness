# test_R39_系统提示.light —— 第 39 轮 任务 3 判据：system-prompt 核心模块复刻
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/system-prompt/src/index.ts
#   核心契约：section / context / assemble / 瀑布流 / complete 处理 / 撤销
# 运行：cd lightharness && python 运行.py examples/test_R39_系统提示.light
# 覆盖：建注册表/注册节/重复节抛错/注册上下文/注册变量/组装（静态+函数文本）/
#       order排序/complete节(0/1/>1)/瀑布流监听器/undo注销

从 系统提示 导入 建系统提示注册表, 注册节, 注册上下文, 注册变量, 注册工具提供者
从 系统提示 导入 注册组装监听器, 组装系统提示, 渲染提示, 渲染上下文快照
从 系统提示 导入 取节, 取上下文, 排序节, 排序上下文, 解析节文本, 解析上下文文本
从 系统提示 导入 处理完整节
从 系统提示 导入 撤销节, 撤销上下文, 撤销变量, 撤销工具提供者, 撤销组装监听器
从 内置核心字典 导入 字典包含键

段落 断言相等(实际, 期望, 编号):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(实际, 编号):
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）#" + 编号 + "：实际=" + 转字符串(实际))

段落 通过(编号):
  打印 "OK #" + 编号

# 辅助：造 3 个静态节，用于测试 order 排序
段落 造三节(注册表):
  注册节(注册表, "gamma", 300, "G")
  注册节(注册表, "alpha", 100, "A")
  注册节(注册表, "beta", 200, "B")
  返回 注册表

# 辅助：函数式节文本（返回按上下文作用域变化的文本）
段落 动态节文本(上下文):
  设 域 为 ""
  如果 上下文 != 空:
    设 域 为 转字符串(上下文["作用域"])
  返回 "hello-" + 域

# 辅助：追加尾节的监听器（返回新的组装结果）
段落 加后缀监听器(装配, 上下文):
  设 新节列表 为 []
  遍历 节 之 装配["节列表"]:
    如果 节["名字"] == "base":
      新节列表.追加({"名字": 节["名字"], "顺序": 节["顺序"], "文本": 节["文本"] + "-suffix", "完整": 节["完整"]})
    否则:
      新节列表.追加(节)
  新节列表.追加({"名字": "tail", "顺序": 999, "文本": "tail-text", "完整": 假})
  设 装配["节列表"] 为 新节列表
  返回 装配

# 辅助：工具提供者（返回 schemas 与 knownNames）
段落 演示工具提供者(上下文):
  返回 {"schemas": [{"name": "search", "description": "搜索"}, {"name": "read", "description": "读取"}], "knownNames": ["search", "read"]}

段落 主:
  设 计数 为 0

  # ===== #00 判据自检 =====
  设 计数 为 计数 + 1
  设 自检红 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检红 为 真
  断言真(自检红, "00")
  通过("00")

  # ===== §1 建注册表（形态标记） =====
  设 计数 为 计数 + 1
  设 表 为 建系统提示注册表()
  断言相等(表["形态"], "系统提示注册表", "01")
  断言相等(长(表["节顺序"]), 0, "01b")
  断言相等(长(表["上下文顺序"]), 0, "01c")
  断言相等(长(表["工具提供者"]), 0, "01d")
  通过("01-01d")

  # ===== §2 注册节 + 取节 =====
  设 计数 为 计数 + 1
  设 undo 为 注册节(表, "harness-identity", -1000, "You are Deepseek harness.")
  断言相等(表["节值表"]["harness-identity"]["名字"], "harness-identity", "02")
  断言相等(表["节值表"]["harness-identity"]["顺序"], -1000, "02b")
  断言相等(表["节值表"]["harness-identity"]["完整"], 假, "02c")
  设 节 为 取节(表, "harness-identity")
  断言相等(节["文本"], "You are Deepseek harness.", "02d")
  通过("02-02d")

  # ===== §3 重复节名抛错 =====
  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    注册节(表, "harness-identity", 0, "dup")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  断言相等(抛错数, 1, "03")
  通过("03")

  # ===== §4 注册上下文 + 取上下文 =====
  设 计数 为 计数 + 1
  注册上下文(表, "sandbox-policy", 110, "Sandbox is off.")
  设 上下文 为 取上下文(表, "sandbox-policy")
  断言相等(上下文["名字"], "sandbox-policy", "04")
  断言相等(上下文["顺序"], 110, "04b")
  断言相等(取上下文(表, "missing"), 空, "04c")
  通过("04-04c")

  # ===== §5 重复上下文名抛错 =====
  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    注册上下文(表, "sandbox-policy", 999, "dup")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  断言相等(抛错数, 1, "05")
  通过("05")

  # ===== §6 注册变量 =====
  设 计数 为 计数 + 1
  注册变量(表, "model_name", "deepseek-v4-flash")
  注册变量(表, "user_role", "manager")
  断言相等(表["变量表"]["model_name"], "deepseek-v4-flash", "06")
  断言相等(表["变量表"]["user_role"], "manager", "06b")
  通过("06-06b")

  # ===== §7 组装静态文本 =====
  设 计数 为 计数 + 1
  设 装配 为 组装系统提示(表)
  断言相等(长(装配["节列表"]), 1, "07")
  断言相等(装配["节列表"][0]["名字"], "harness-identity", "07b")
  断言相等(装配["节列表"][0]["文本"], "You are Deepseek harness.", "07c")
  断言相等(长(装配["上下文列表"]), 1, "07d")
  断言相等(装配["上下文列表"][0]["文本"], "Sandbox is off.", "07e")
  断言相等(装配["变量表"]["model_name"], "deepseek-v4-flash", "07f")
  通过("07-07f")

  # ===== §8 组装函数文本（动态上下文） =====
  设 计数 为 计数 + 1
  设 表2 为 建系统提示注册表()
  注册节(表2, "dynamic", 0, 动态节文本)
  设 装配2 为 组装系统提示(表2, {"作用域": "coded", "信号": 空, "工具排序": 空})
  断言相等(装配2["节列表"][0]["文本"], "hello-coded", "08")
  断言相等(装配2["作用域"], "coded", "08b")
  通过("08-08b")

  # ===== §9 order 排序（升序，同 order 按 name） =====
  设 计数 为 计数 + 1
  设 表3 为 建系统提示注册表()
  造三节(表3)
  注册节(表3, "beta2", 200, "B2")
  设 装配3 为 组装系统提示(表3)
  断言相等(装配3["节列表"][0]["名字"], "alpha", "09")
  断言相等(装配3["节列表"][1]["名字"], "beta", "09b")
  断言相等(装配3["节列表"][2]["名字"], "beta2", "09c")
  断言相等(装配3["节列表"][3]["名字"], "gamma", "09d")
  通过("09-09d")

  # ===== §10 无 complete 节（0 个）：直接返回 =====
  设 计数 为 计数 + 1
  设 装配4 为 组装系统提示(表3)
  断言相等(长(装配4["节列表"]), 4, "10")
  通过("10")

  # ===== §11 单个 complete 节：恢复为唯一节 =====
  设 计数 为 计数 + 1
  设 表5 为 建系统提示注册表()
  注册节(表5, "a", 100, "A")
  注册节(表5, "b", 200, "B", 真)
  注册节(表5, "c", 300, "C")
  设 装配5 为 组装系统提示(表5)
  断言相等(长(装配5["节列表"]), 1, "11")
  断言相等(装配5["节列表"][0]["名字"], "b", "11b")
  断言相等(装配5["节列表"][0]["文本"], "B", "11c")
  通过("11-11c")

  # ===== §12 >1 个 complete 节：抛错 =====
  设 计数 为 计数 + 1
  设 表6 为 建系统提示注册表()
  注册节(表6, "x", 100, "X", 真)
  注册节(表6, "y", 200, "Y", 真)
  设 抛错数 为 0
  尝试:
    组装系统提示(表6)
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  断言相等(抛错数, 1, "12")
  通过("12")

  # ===== §13 瀑布流监听器（可修改组装结果） =====
  设 计数 为 计数 + 1
  设 表7 为 建系统提示注册表()
  注册节(表7, "base", 0, "base-text")
  注册组装监听器(表7, 加后缀监听器)
  设 装配7 为 组装系统提示(表7)
  断言相等(装配7["节列表"][0]["文本"], "base-text-suffix", "13")
  断言相等(长(装配7["节列表"]), 2, "13b")
  断言相等(装配7["节列表"][1]["名字"], "tail", "13c")
  通过("13-13c")

  # ===== §14 undo 注销（节/上下文/变量） =====
  设 计数 为 计数 + 1
  设 表8 为 建系统提示注册表()
  设 u1 为 注册节(表8, "will-remove", 0, "gone")
  设 u2 为 注册上下文(表8, "will-remove-ctx", 100, "gone-ctx")
  设 u3 为 注册变量(表8, "will_remove_var", "v")
  断言相等(取节(表8, "will-remove") != 空, 真, "14")
  断言相等(取上下文(表8, "will-remove-ctx") != 空, 真, "14a")
  断言相等(字典包含键(表8["变量表"], "will_remove_var"), 真, "14b")
  u1(表8, "will-remove")
  u2(表8, "will-remove-ctx")
  u3(表8, "will_remove_var")
  断言相等(取节(表8, "will-remove"), 空, "14c")
  断言相等(取上下文(表8, "will-remove-ctx"), 空, "14d")
  断言相等(字典包含键(表8["变量表"], "will_remove_var"), 假, "14e")
  通过("14-14e")

  # ===== §15 undo 幂等（重复调用同一 undo 安全） =====
  设 计数 为 计数 + 1
  设 表9 为 建系统提示注册表()
  注册节(表9, "idempotent", 0, "x")
  撤销节(表9, "idempotent")
  撤销节(表9, "idempotent")
  撤销节(表9, "idempotent")
  断言相等(取节(表9, "idempotent"), 空, "15")
  通过("15")

  # ===== §16 注册工具提供者 + 排序工具 =====
  设 计数 为 计数 + 1
  设 表12 为 建系统提示注册表()
  注册工具提供者(表12, 演示工具提供者)
  设 装配12 为 组装系统提示(表12)
  断言相等(长(装配12["工具列表"]), 2, "16")
  断言相等(装配12["工具列表"][0]["name"], "read", "16b")
  断言相等(装配12["工具列表"][1]["name"], "search", "16c")
  通过("16-16c")

  # ===== §17 渲染提示（变量插值 - 简单替换） =====
  设 计数 为 计数 + 1
  设 表10 为 建系统提示注册表()
  注册节(表10, "greet", 0, "Hello, {{name}}. Model: {{model}}.")
  注册变量(表10, "name", "Alice")
  注册变量(表10, "model", "deepseek-v4-flash")
  设 装配10 为 组装系统提示(表10)
  设 渲染 为 渲染提示(装配10)
  断言相等(渲染, "Hello, Alice. Model: deepseek-v4-flash.", "17")
  通过("17")

  # ===== §18 渲染上下文快照（前置 header） =====
  设 计数 为 计数 + 1
  设 表11 为 建系统提示注册表()
  注册上下文(表11, "sandbox-policy", 110, "Sandbox: {{mode}}")
  注册变量(表11, "mode", "strict")
  设 装配11 为 组装系统提示(表11)
  设 快照 为 渲染上下文快照(装配11)
  断言相等(快照.包含("Current runtime context."), 真, "18")
  断言相等(快照.包含("Sandbox: strict"), 真, "18b")
  通过("18-18b")

  # ===== §19 注册组装监听器 → 撤销（幂等） =====
  设 计数 为 计数 + 1
  设 表13 为 建系统提示注册表()
  注册节(表13, "base", 0, "x")
  注册组装监听器(表13, 加后缀监听器)
  断言相等(长(表13["组装监听器"]), 1, "19")
  撤销组装监听器(表13, 加后缀监听器)
  撤销组装监听器(表13, 加后缀监听器)
  断言相等(长(表13["组装监听器"]), 0, "19b")
  通过("19-19b")

  打印 "系统提示 判据通过：" + 转字符串(计数) + " 组"

主()
