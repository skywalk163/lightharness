# test_流.light —— 流词汇表 + 块组装器测试
从 流 导入 块组装器, 造块开始, 造文本增量, 造推理增量, 造工具调用增量, 造块结束, 造用量块, 造用量, 造结束, 造超长原因, 造停止原因
从 消息 导入 造文本块

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ---- 组装器：文本块 ----
  设 组装器 为 新建 块组装器()
  组装器.送入(造块开始(0, "text"))
  组装器.送入(造文本增量(0, "你好"))
  组装器.送入(造文本增量(0, "，光明"))
  组装器.送入(造用量块(造用量(10, 5)))
  组装器.送入(造结束(造停止原因()))
  设 块表 为 组装器.块表()
  断言等于(长度(块表), 1, "一个文本块")
  断言等于(块表[0]["type"], "text", "块类型 text")
  断言等于(块表[0]["text"], "你好，光明", "文本增量拼接")
  断言等于(组装器.完成原因()["种类"], "stop", "完成原因 stop")
  断言等于(组装器.用量()["输入"], 10, "用量输入")
  断言等于(组装器.用量()["输出"], 5, "用量输出")

  # ---- 组装器：工具调用增量（无 block-start/end，纯增量协议）----
  设 组装器2 为 新建 块组装器()
  组装器2.送入(造工具调用增量(0, "call_1", "查询天气", "{\"city\":\"北京\""))
  组装器2.送入(造工具调用增量(0, "call_1", "", "}"))
  设 块表2 为 组装器2.块表()
  断言等于(块表2[0]["type"], "tool-call", "工具调用块")
  断言等于(块表2[0]["id"], "call_1", "调用 id")
  断言等于(块表2[0]["name"], "查询天气", "工具名")
  断言等于(块表2[0]["arguments"], "{\"city\":\"北京\"}", "参数增量拼接")

  # ---- block-end 冻结块 ----
  设 组装器3 为 新建 块组装器()
  组装器3.送入(造块开始(0, "text"))
  组装器3.送入(造文本增量(0, "草稿"))
  组装器3.送入(造块结束(0, 造文本块("冻结")))
  组装器3.送入(造文本增量(0, "迟到"))  # 迟到增量应被忽略
  设 块表3 为 组装器3.块表()
  断言等于(块表3[0]["text"], "冻结", "block-end 冻结优先")

  # ---- max-tokens 截断丢弃工具调用 ----
  设 组装器4 为 新建 块组装器()
  组装器4.送入(造块开始(0, "text"))
  组装器4.送入(造文本增量(0, "思考到一半"))
  组装器4.送入(造工具调用增量(1, "call_x", "工具A", "{}"))
  组装器4.送入(造结束(造超长原因()))
  设 块表4 为 组装器4.块表()
  断言等于(长度(块表4), 1, "max-tokens 只留文本块")
  断言等于(块表4[0]["type"], "text", "保留文本")

  # ---- 中断块：仅非空白 text/reasoning ----
  设 组装器5 为 新建 块组装器()
  组装器5.送入(造块开始(0, "text"))
  组装器5.送入(造文本增量(0, "已说"))
  组装器5.送入(造块开始(1, "text"))
  组装器5.送入(造工具调用增量(2, "call_y", "工具B", "{}"))
  设 中断块 为 组装器5.中断块()
  断言等于(长度(中断块), 1, "中断只保留有内容的文本块")
  断言等于(中断块[0]["text"], "已说", "中断块内容")

  # ---- 组装消息 ----
  设 组装器6 为 新建 块组装器()
  组装器6.送入(造文本增量(0, "最终回答"))
  设 消息 为 组装器6.组装消息("测试")
  断言等于(消息["role"], "assistant", "助手角色")
  断言等于(消息["content"][0]["text"], "最终回答", "消息内容")
  断言等于(消息["来源"], "测试", "消息来源")

  打印 "--- 流词汇表测试通过 ---"

主()
