# test_R35_记录类型边界.light —— R35 任务3 G2 编译门 + 五种边界形态自校验
#
# 结论：记录类型 **不可通用化，保留为 _P0A_MERGE_WHOLE 真护栏**。
# 根因：整串被「类型」在**词尾**劈开（记录 + 类型），类型 是 _P0A_HARD_STMT / _P0A_SUFFIX_SPLIT_KW。
# 通用化尝试与实测：
#   · GR-3（词尾多字硬语句关键字在非语句起始/调用语境并入）→ G1 打红 4 文件：
#     bootstrap/release/stdlib/参数解析.light（参数定义）、断言工具.light（期望类型）、
#     装饰器.light（参数类型）、集合工具.light（创建命名元组类型）。
#     ⇒ 记录类型 与 期望类型/参数类型 **结构上不可分**（同为「非关键字前缀 + 类型」），
#       任何通用规则要么一起并入（打红 3 个 stdlib 文件），要么都不并入（撤条目即打红 2 文件）。
#   · GR-3c（收窄到仅函数调用语境 `X(`）→ G1 = 0 变化，G3 F2 通过，但 **F5 传参位仍 FAIL**
#     ⇒ 按铁律「三重判据全通过才可移除」保留。
#
# 本文件在【保留条目】状态下必须 rc=0（G2 编译门）。
# token 级证据：lightharness/_r35_g3_边界门.py / _r35_g1_engine.py / _r35_probe_变体diff.py
#
# 运行：cd lightharness && python 运行.py examples/test_R35_记录类型边界.light

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 记录类型(目标):
  返回 "类型:" + 目标

段落 消费(入参):
  返回 入参

段落 消费名(入参):
  # 传参位收到的是**函数名**（未调用），此处调用之：
  # 若词法把 记录类型 劈成 记录 + 类型，此处必然语义错。
  返回 入参("张三")

段落 主:
  # F1 设名位
  设 记录类型值 为 "类型:张三"
  断言相等(记录类型值, "类型:张三", "F1 设名位 整词")

  # F2 函数名位（调用语境）
  断言相等(记录类型("张三"), "类型:张三", "F2 函数名位 整词")

  # F4 段落名位
  断言相等(记录类型("李四"), "类型:李四", "F4 段落名位 整词")

  # F5 传参位（首参 / 次参）
  断言相等(消费(记录类型("张三")), "类型:张三", "F5 传参位 首参 整词")
  断言相等(消费名(记录类型), "类型:张三", "F5 传参位 传函数名 整词")

  # 附加形态：值位 / 列表元素 / 条件位
  设 别名 为 记录类型
  断言相等(别名("张三"), "类型:张三", "值位 整词")
  设 表 为 [记录类型]
  断言相等(长度(表), 1, "列表元素 整词")

  # 对照：X类型 复合名（无 MERGE_WHOLE 条目，靠既有通用规则）
  设 期望类型 为 "整数"
  断言相等(期望类型, "整数", "对照：期望类型 复合名整词")
  设 参数类型 为 "文本"
  断言相等(参数类型, "文本", "对照：参数类型 复合名整词")

  打印 "--- test_R35 记录类型边界 通过 ---"

主()
