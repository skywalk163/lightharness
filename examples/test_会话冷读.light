# test_会话冷读.light —— 任务1 会话冷读 测试（对齐上游 cold-read.ts readColdSessionLog）
#
# 覆盖（每判据组含反跑点，改反即红）：
#   1) 平衡日志读取：闭合轮日志 → 冷读返回原事件表（无合成），头/继承事件数/事件状态正确。
#   2) 未闭合轮合成关闭事件（对齐 repair 语义）：写崩中断轮 → 冷读合成
#      tool/result(错误, TOOL_OUTCOME_UNKNOWN) + turn/end{interrupted}，序号连续、时间复用。
#      反跑：去掉合成 → 红
#   3) 只读不写回：冷读前后日志文件字节不变（存储不被修改）。
#   4) 读失败错误传播：会话不存在 / 坏 JSON 行 / 首行非 session 头 → 错误原样上抛。
#
# 运行：cd lightharness && python 运行.py examples/test_会话冷读.light

从 持久化 导入 写出会话
从 会话 导入 新建会话
从 消息 导入 造用户消息, 造文本块
从 会话冷读 导入 冷读会话日志, 冷读事件状态
从 文件系统 导入 路径连接, 创建目录, 写入文件, 读取文件

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 主:
  设 根 为 "tmp_coldread"
  设 工作目录 为 "G:\\work\\proj"

  # ============ 1) 平衡日志读取（无合成） ============
  设 平衡会话 为 新建会话("s_bal", 工作目录)
  平衡会话.记录事件("user/message", 造用户消息([造文本块("你好")]))
  平衡会话.记录轮次开始()
  平衡会话.记录事件("assistant/message", ["消息": ["role": "assistant", "content": [造文本块("好的")]]])
  平衡会话.记录轮次结束(["种类": "completed"], 空)
  设 平衡路径 为 写出会话(根, 平衡会话)

  设 平衡结果 为 冷读会话日志(根, 工作目录, "s_bal")
  断言等于(平衡结果["事件状态"], 冷读事件状态, "事件状态=detached(只读独占)")
  断言等于(平衡结果["头"]["标识"], "s_bal", "头标识一致")
  断言等于(平衡结果["继承事件数"], 0, "平衡会话继承事件数=0")
  断言等于(长度(平衡结果["事件表"]), 4, "平衡日志4事件(无合成)")
  断言等于(平衡结果["事件表"][0]["类型"], "user/message", "事件0 user/message")
  断言等于(平衡结果["事件表"][3]["类型"], "turn/end", "事件3 turn/end")
  断言等于(平衡结果["事件表"][3]["数据"]["原因"]["种类"], "completed", "turn/end 原因保留")

  # ============ 2) 未闭合轮合成关闭事件（对齐 repair 语义） ============
  设 未闭会话 为 新建会话("s_open", 工作目录)
  未闭会话.记录事件("user/message", 造用户消息([造文本块("请执行命令")]))
  未闭会话.记录轮次开始()
  设 调用块 为 {}
  调用块["type"] 为 "tool-call"
  调用块["id"] 为 "call_xyz"
  调用块["name"] 为 "bash"
  设 内容表 为 []
  列表追加(内容表, 调用块)
  设 助手消息 为 {}
  助手消息["role"] 为 "assistant"
  助手消息["content"] 为 内容表
  未闭会话.记录事件("assistant/message", ["消息": 助手消息])
  设 调用数据 为 {}
  调用数据["callId"] 为 "call_xyz"
  调用数据["name"] 为 "bash"
  未闭会话.记录事件("tool/call", 调用数据)
  # 不记录 tool/result、不记录 turn/end —— 模拟写崩中断
  设 未闭路径 为 写出会话(根, 未闭会话)

  设 未闭结果 为 冷读会话日志(根, 工作目录, "s_open")
  断言等于(长度(未闭结果["事件表"]), 6, "未闭合4原始+2合成=6")  # 反跑：去掉合成 → 红
  # 合成1：tool/result（已启动调用 → TOOL_OUTCOME_UNKNOWN）
  设 合成结果 为 未闭结果["事件表"][4]
  断言等于(合成结果["类型"], "tool/result", "合成事件5=tool/result")
  断言等于(合成结果["数据"]["成功"], 假, "合成result成功=假")
  断言等于(合成结果["数据"]["调用"], "call_xyz", "合成result调用=call_xyz")
  断言等于(合成结果["数据"]["错误"]["代码"], "TOOL_OUTCOME_UNKNOWN", "错误码=TOOL_OUTCOME_UNKNOWN(已启动)")
  断言等于(合成结果["序号"], 4, "合成result序号=4(最后真实3+1)")
  # 合成2：turn/end {interrupted}
  设 合成轮结束 为 未闭结果["事件表"][5]
  断言等于(合成轮结束["类型"], "turn/end", "合成事件6=turn/end")
  断言等于(合成轮结束["数据"]["原因"], "interrupted", "轮结束原因=interrupted")
  断言等于(合成轮结束["序号"], 5, "合成turn/end序号=5")
  # 合成事件时间复用最后真实事件时间
  断言等于(合成轮结束["时间"], 合成结果["时间"], "合成时间复用最后真实事件")
  # 原事件表前4条未被改动（只读不写回）
  断言等于(未闭结果["事件表"][0]["类型"], "user/message", "原事件0未变")

  # ============ 3) 只读不写回：读前后日志文件字节不变 ============
  设 读前 为 读取文件(未闭路径)
  设 占 为 冷读会话日志(根, 工作目录, "s_open")
  设 读后 为 读取文件(未闭路径)
  断言等于(读后, 读前, "冷读前后日志文件字节不变(不写回)")

  # ============ 4) 读失败错误传播 ============
  # 4a. 会话不存在 → 抛错
  设 抛缺失 为 假
  尝试:
    冷读会话日志(根, 工作目录, "s_nope")
  捕获 错误 为 e1:
    设 抛缺失 为 真
  断言真(抛缺失, "会话不存在应抛错")
  # 4b. 坏 JSON 行 → 抛错（构造损坏日志：首行正常、第二行坏 JSON）
  设 坏目录 为 路径连接(根, "坏会话")
  创建目录(坏目录)
  设 坏路径 为 路径连接(坏目录, "session.jsonl")
  写入文件(坏路径, "{\"type\":\"session\",\"version\":{\"major\":3,\"minor\":0},\"id\":\"s_bad\",\"createdAt\":1,\"delegationDepth\":0,\"cwd\":\"G:\\\\work\\\\proj\"}\n{broken json}\n")
  设 抛坏行 为 假
  尝试:
    冷读会话日志(根, 工作目录, "s_bad")
  捕获 错误 为 e2:
    设 抛坏行 为 真
  断言真(抛坏行, "坏 JSON 行应抛错(读错误传播)")
  # 4c. 首行非 session 头 → 抛错
  设 错目录 为 路径连接(根, "错头会话")
  创建目录(错目录)
  设 错路径 为 路径连接(错目录, "session.jsonl")
  写入文件(错路径, "{\"type\":\"note\",\"id\":\"s_bad2\"}\n")
  设 抛错头 为 假
  尝试:
    冷读会话日志(根, 工作目录, "s_bad2")
  捕获 错误 为 e3:
    设 抛错头 为 真
  断言真(抛错头, "首行非 session 头应抛错")

  打印 "--- 会话冷读测试通过 ---"

主()
