# test_控制器类型.light —— 对标 #109 域：api 控制器类型合并（workspace-files / settings-controller / workspace-controller）反跑测试
# 原版：packages/api/workspace-files/src/types.ts      (166 行)
#       packages/api/settings-controller/src/types.ts  ( 39 行)
#       packages/api/workspace-controller/src/types.ts (128 行)
#
# 反跑判据（改反必须红，共 3 项，见 _antirun_t6_控制器类型.py）：
#   A) 正常输出 —— 把 造变更存现 / 判变更存在 的键名改坏（如 version 写作 versio）即红：
#      文件变更:存现构造 / 判变存在 / 取变更路径 用例变红；恢复 → 绿。
#   B) 边界 —— 把 判目录打开真 的 opened 判定改坏（== 真 改 != 真）即红：
#      设置:空对象键枚举 / 判目录打开值(空) 用例变红；恢复 → 绿。
#   C) 变异立红（真实语义）—— 把 workspace-files 的变更枚举改坏（判目录项类型 的
#      "directory" 写作 "dir"）即红：目录项:类型枚举 用例变红；恢复 → 绿。
#
# 语言坑规避：
#   - 断言(条件,标签) 降级 no-op（L-037），一律 断言相等。
#   - 写/打印 只吃字面量串（L-055）；诊断全走 抛出 新建 错误。
#   - 布尔严格判别用 是布尔（L-129 0 与 假 混同）。
#   - JSON 文本一律 序列化JSON(...) 构造（L-089）。
#   - 主程 必须显式在文件末尾调用。

从 控制器类型 导入 判文件统计, 造文件统计, 判文本区间, 造文本区间, 判页文本, 造页文本
从 控制器类型 导入 判字节区间, 造字节区间, 判字节窗, 造字节窗
从 控制器类型 导入 判目录项类型, 判目录项, 造目录项, 判目录清单, 造目录清单
从 控制器类型 导入 判变更存在, 判变更缺席, 判文件变更, 造变更存现, 造变更缺席, 取变更路径
从 控制器类型 导入 判就绪帧, 判变更帧, 判监视帧, 造就绪帧, 造变更帧, 取监视帧类别, 取监视帧变更
从 控制器类型 导入 判文件错误码, 判符号种类, 判文件种类, 判文件错误详情
从 控制器类型 导入 判文档打开值, 造文档打开值, 判目录打开真, 判目录打开拒, 判目录打开值
从 控制器类型 导入 造目录打开, 造目录拒绝, 取拒绝路径, 判设置错误码, 判设置拒绝详情, 判设置冲突详情, 判凭据拒绝详情
从 控制器类型 导入 判工作区视图, 造工作区视图, 判创建请求, 造创建请求, 判创建值, 造创建值
从 控制器类型 导入 判改名请求, 造改名请求, 判工作区值, 造工作区值, 判删除请求, 造删除请求, 判删除值, 造删除值
从 控制器类型 导入 判前置请求, 造前置请求, 判顺序值, 造顺序值, 判会话前置请求, 造会话前置请求
从 控制器类型 导入 判归档请求, 造归档请求, 判归档值, 造归档值, 判基线, 造基线
从 控制器类型 导入 判增量更新, 判增量移除, 判增量排序, 判增量归档, 判增量, 取增量类型
从 控制器类型 导入 造增量更新, 造增量移除, 造增量排序, 造增量归档
从 控制器类型 导入 判基线帧, 判跟随帧, 造基线帧, 取跟随帧类型
从 控制器类型 导入 判工作区错误码, 判名称冲突详情, 判移动无效详情, 判目录选择详情, 判工作区错误详情
从 内置核心转换 导入 转字符串
从 控制器类型 导入 是布尔值
从 内置核心字典 导入 字典创建, 字典包含键, 字典键列表
从 内置核心列表 导入 列表创建, 列表长度, 列表获取, 列表追加
从 JSON 导入 序列化JSON

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

# =====================================================================
# 用例：工作区文件域
# =====================================================================
段落 用例_文件统计:
  设 统计 为 造文件统计("/a.txt", "v1", 空)
  断言相等(判文件统计(统计), 真, "文件统计:合法构造判真")
  断言相等(统计["absolutePath"], "/a.txt", "文件统计:绝对路径键")
  断言相等(统计["version"], "v1", "文件统计:版本键")
  断言相等(字典包含键(统计, "bytes"), 假, "文件统计:缺省字节不落键")
  断言相等(判文件统计({"absolutePath": "/a.txt"}), 假, "文件统计:缺版本判假")
  断言相等(判文件统计({"absolutePath": "/a.txt", "version": "v1", "bytes": -1}), 假, "文件统计:负字节判假")
  断言相等(判文件统计({"absolutePath": "/a.txt", "version": "v1", "bytes": 3}), 真, "文件统计:带字节判真")
  断言相等(判文件统计("x"), 假, "文件统计:非字典判假")

段落 用例_区间页:
  设 区间 为 造文本区间(1, 10)
  断言相等(判文本区间(区间), 真, "文本区间:合法构造判真")
  断言相等(判文本区间(造文本区间(空, 空)), 真, "文本区间:全可选判真")
  断言相等(判文本区间({"offset": -1}), 假, "文本区间:负偏移判假")
  设 页 为 造页文本("/a.txt", "v1", 空, 1, "hi", 2, 真)
  断言相等(判页文本(页), 真, "页文本:合法构造判真")
  断言相等(判页文本({"absolutePath": "/a.txt", "version": "v1", "offset": 1, "text": "hi", "lines": 2}), 假, "页文本:缺末尾判假")
  断言相等(判页文本({"absolutePath": "/a.txt", "version": "v1", "offset": 1, "text": "hi", "lines": -1, "eof": 真}), 假, "页文本:负行数判假")
  断言相等(判页文本({"absolutePath": "/a.txt", "version": "v1", "offset": 1, "text": "hi", "lines": 2, "eof": "yes"}), 假, "页文本:末尾非布尔判假")

段落 用例_字节窗:
  设 窗 为 造字节窗("/a.bin", "v1", 10, 0, "aGk=", 真)
  断言相等(判字节窗(窗), 真, "字节窗:合法构造判真")
  断言相等(判字节区间(造字节区间(0, 4)), 真, "字节区间:合法构造判真")
  断言相等(判字节区间({"length": -1}), 假, "字节区间:负长度判假")
  断言相等(判字节窗({"absolutePath": "/a.bin", "version": "v1", "offset": 0, "eof": 真}), 假, "字节窗:缺数据判假")
  断言相等(判字节窗({"absolutePath": "/a.bin", "version": "v1", "offset": 0, "data": 7, "eof": 真}), 假, "字节窗:数据非字符串判假")

段落 用例_目录项:
  断言相等(判目录项类型("file"), 真, "目录项:文件类型判真")
  断言相等(判目录项类型("directory"), 真, "目录项:目录类型判真")
  断言相等(判目录项类型("other"), 真, "目录项:其他类型判真")
  断言相等(判目录项类型("x"), 假, "目录项:未知类型判假")
  设 项 为 造目录项("a.txt", "file", 空)
  断言相等(判目录项(项), 真, "目录项:合法构造判真")
  断言相等(判目录项({"name": "a.txt", "type": "file", "size": -1}), 假, "目录项:负大小判假")
  断言相等(判目录项({"name": "a.txt", "type": "symlink"}), 假, "目录项:类型越界判假")
  断言相等(判目录项({"type": "file"}), 假, "目录项:缺名称判假")

段落 用例_目录清单:
  设 项表 为 列表创建()
  列表追加(项表, 造目录项("a.txt", "file", 空))
  列表追加(项表, 造目录项("src", "directory", 空))
  设 清单 为 造目录清单("", 项表, 假)
  断言相等(判目录清单(清单), 真, "目录清单:合法构造判真")
  设 坏表 为 列表创建()
  列表追加(坏表, "x")
  断言相等(判目录清单({"path": "", "entries": 坏表, "truncated": 假}), 假, "目录清单:坏条目判假")
  断言相等(判目录清单({"path": "", "entries": 项表, "truncated": "yes"}), 假, "目录清单:截断非布尔判假")
  断言相等(判目录清单({"path": "", "entries": "x", "truncated": 假}), 假, "目录清单:条目非表判假")

段落 用例_文件变更:
  设 存现 为 造变更存现("/a.txt", "v1")
  断言相等(判文件变更(存现), 真, "变更:存在形态判真")
  断言相等(判变更存在(存现), 真, "变更:判变存在判真")
  断言相等(判变更缺席(存现), 假, "变更:存在形态非缺席")
  断言相等(取变更路径(存现), "/a.txt", "变更:取路径")
  设 缺席 为 造变更缺席("/a.txt")
  断言相等(判文件变更(缺席), 真, "变更:缺席形态判真")
  断言相等(判变更存在(缺席), 假, "变更:缺席形态非存在")
  断言相等(取变更路径(缺席), "/a.txt", "变更:缺席取路径")
  断言相等(判文件变更({"absolutePath": "/a.txt"}), 假, "变更:缺版本缺缺席判假")
  断言相等(判文件变更({"absent": 真}), 假, "变更:缺绝对路径判假")
  断言相等(取变更路径({"absolutePath": "/a.txt"}), 空, "变更:非法变更取空")

段落 用例_监视帧:
  设 就绪 为 造就绪帧()
  断言相等(判监视帧(就绪), 真, "监视帧:就绪帧判真")
  断言相等(取监视帧类别(就绪), "ready", "监视帧:就绪类别")
  设 变更 为 造变更存现("/a.txt", "v1")
  设 帧 为 造变更帧(变更)
  断言相等(判监视帧(帧), 真, "监视帧:变更帧判真")
  断言相等(取监视帧类别(帧), "change", "监视帧:变更类别")
  断言相等(取监视帧变更(帧), 变更, "监视帧:取变更内容")
  断言相等(判监视帧({"kind": "x"}), 假, "监视帧:未知类别判假")
  断言相等(判变更帧({"kind": "change", "change": {"absolutePath": "/a.txt"}}), 假, "监视帧:坏变更判假")
  断言相等(取监视帧变更(就绪), 空, "监视帧:就绪帧取变更空")

# =====================================================================
# 用例：设置控制器域
# =====================================================================
段落 用例_设置:
  设 打开 为 造文档打开值()
  断言相等(判文档打开值(打开), 真, "设置:文档打开判真")
  设 目录开 为 造目录打开()
  断言相等(判目录打开值(目录开), 真, "设置:目录打开判真")
  断言相等(判目录打开拒(目录开), 假, "设置:目录打开非拒绝")
  设 拒绝 为 造目录拒绝("/x")
  断言相等(判目录打开值(拒绝), 真, "设置:目录拒绝判真")
  断言相等(判目录打开真(拒绝), 假, "设置:目录拒绝非打开")
  断言相等(取拒绝路径(拒绝), "/x", "设置:取拒绝路径")
  设 空设置 为 字典创建()
  断言相等(列表长度(字典键列表(空设置)), 0, "设置:空对象键枚举空表")
  断言相等(判目录打开值(空设置), 假, "设置:空对象目录打开判假")
  断言相等(判文档打开值(空设置), 假, "设置:空对象文档打开判假")

段落 用例_设置错误:
  断言相等(判设置错误码("settings/rejected"), 真, "设置:拒绝码判真")
  断言相等(判设置错误码("settings/conflict"), 真, "设置:冲突码判真")
  断言相等(判设置错误码("credential/rejected"), 真, "设置:凭据码判真")
  断言相等(判设置错误码("x"), 假, "设置:未知码判假")
  断言相等(判设置拒绝详情({"ns": "a"}), 真, "设置:拒绝详情判真")
  断言相等(判设置拒绝详情({}), 假, "设置:拒绝详情缺命名空间判假")
  断言相等(判设置冲突详情({"ns": "a", "expected": 1, "actual": 2}), 真, "设置:冲突详情判真")
  断言相等(判设置冲突详情({"ns": "a", "expected": 1}), 假, "设置:冲突详情缺实际判假")
  断言相等(判设置冲突详情({"ns": "a", "expected": "1", "actual": 2}), 假, "设置:冲突详情期望非整数判假")
  断言相等(判凭据拒绝详情({"ref": "r"}), 真, "设置:凭据拒绝详情判真")
  断言相等(判凭据拒绝详情({}), 假, "设置:凭据拒绝详情缺引用判假")

# =====================================================================
# 用例：工作区控制器域
# =====================================================================
段落 用例_工作区视图:
  设 视 为 造工作区视图("w1", "/w", "标题", ["s1"], "2026-01-01", "2026-01-02")
  断言相等(判工作区视图(视), 真, "工作区:视图判真")
  断言相等(视["title"], "标题", "工作区:视图标题键")
  设 空视 为 造工作区视图("w2", "/w2", "t", [], "a", "b")
  断言相等(判工作区视图(空视), 真, "工作区:空会话表判真")
  断言相等(判工作区视图({"workspaceId": "w1", "path": "/w", "title": "t", "sessionIds": [], "createdAt": "a"}), 假, "工作区:视图缺更新时刻判假")
  断言相等(判工作区视图({"workspaceId": "w1", "path": "/w", "title": "t", "sessionIds": [1], "createdAt": "a", "updatedAt": "b"}), 假, "工作区:会话表含非串判假")
  断言相等(判工作区视图({"workspaceId": 1, "path": "/w", "title": "t", "sessionIds": [], "createdAt": "a", "updatedAt": "b"}), 假, "工作区:标识非串判假")
  断言相等(判工作区视图("x"), 假, "工作区:视图非字典判假")

段落 用例_工作区请求值:
  设 视 为 造工作区视图("w1", "/w", "标题", ["s1"], "2026-01-01", "2026-01-02")
  断言相等(判创建请求(造创建请求("/x")), 真, "工作区:创建请求判真")
  断言相等(判创建请求({"path": 1}), 假, "工作区:创建请求路径非串判假")
  断言相等(判创建值(造创建值(视, 真)), 真, "工作区:创建值判真")
  断言相等(判创建值({"workspace": 视, "created": "yes"}), 假, "工作区:创建值非布尔判假")
  断言相等(判改名请求(造改名请求("w1", "新")), 真, "工作区:改名请求判真")
  断言相等(判工作区值(造工作区值(视)), 真, "工作区:工作区值判真")
  断言相等(判删除请求(造删除请求("w1")), 真, "工作区:删除请求判真")
  断言相等(判删除值(造删除值()), 真, "工作区:删除值判真")
  断言相等(判删除值({"deleted": 假}), 假, "工作区:删除值非真判假")
  断言相等(判前置请求(造前置请求("w1", 空)), 真, "工作区:前置请求缺前置判真")
  断言相等(判前置请求(造前置请求("w1", "w2")), 真, "工作区:前置请求带前置判真")
  断言相等(判前置请求({"workspaceId": "w1", "beforeWorkspaceId": 1}), 假, "工作区:前置请求前置非串判假")
  断言相等(判顺序值(造顺序值(["w1", "w2"])), 真, "工作区:顺序值判真")
  断言相等(判顺序值(造顺序值([])), 真, "工作区:空顺序值判真")
  断言相等(判顺序值({"workspaceIds": [1]}), 假, "工作区:顺序值含非串判假")
  断言相等(判会话前置请求(造会话前置请求("w1", "s1", 空)), 真, "工作区:会话前置请求判真")
  断言相等(判归档请求(造归档请求("s1")), 真, "工作区:归档请求判真")
  断言相等(判归档值(造归档值(["s1"])), 真, "工作区:归档值判真")
  断言相等(判归档值(造归档值([])), 真, "工作区:空归档值判真")

段落 用例_基线增量帧:
  设 视 为 造工作区视图("w1", "/w", "标题", ["s1"], "2026-01-01", "2026-01-02")
  设 基线 为 造基线([视], ["s1"])
  断言相等(判基线(基线), 真, "帧:基线判真")
  断言相等(判基线(造基线([], [])), 真, "帧:空基线判真")
  设 坏基 为 造基线([1], [])
  断言相等(判基线(坏基), 假, "帧:基线含坏项判假")
  设 更新 为 造增量更新(视)
  断言相等(判增量(更新), 真, "帧:更新增量判真")
  断言相等(取增量类型(更新), "upsert", "帧:更新增量类型")
  断言相等(判增量移除(更新), 假, "帧:更新增量非移除")
  设 移除 为 造增量移除("w1")
  断言相等(取增量类型(移除), "remove", "帧:移除增量类型")
  设 排序 为 造增量排序(["w1"])
  断言相等(取增量类型(排序), "order", "帧:排序增量类型")
  设 归档 为 造增量归档(["s1"])
  断言相等(取增量类型(归档), "archived", "帧:归档增量类型")
  断言相等(判增量({"type": "bogus"}), 假, "帧:未知增量类型判假")
  断言相等(判增量({"type": "upsert"}), 假, "帧:更新增量缺工作区判假")
  设 基帧 为 造基线帧(基线)
  断言相等(判跟随帧(基帧), 真, "帧:基线帧判真")
  断言相等(取跟随帧类型(基帧), "baseline", "帧:基线帧类型")
  断言相等(判跟随帧(更新), 真, "帧:增量帧判真")
  断言相等(判基线帧({"type": "baseline"}), 假, "帧:基线帧缺值判假")
  断言相等(取跟随帧类型({"type": "x"}), 空, "帧:未知帧取空")

段落 用例_工作区错误:
  断言相等(判工作区错误码("workspace/invalid-path"), 真, "错误:无效路径码判真")
  断言相等(判工作区错误码("workspace/name-conflict"), 真, "错误:名称冲突码判真")
  断言相等(判工作区错误码("workspace/move-invalid"), 真, "错误:移动无效码判真")
  断言相等(判工作区错误码("directory-picker/unavailable"), 真, "错误:不可用码判真")
  断言相等(判工作区错误码("directory-picker/unreadable"), 真, "错误:不可读码判真")
  断言相等(判工作区错误码("directory-picker/exists"), 真, "错误:已存在码判真")
  断言相等(判工作区错误码("directory-picker/create-failed"), 真, "错误:创建失败码判真")
  断言相等(判工作区错误码("x"), 假, "错误:未知码判假")
  断言相等(判名称冲突详情({"name": "x"}), 真, "错误:名称冲突详情判真")
  断言相等(判移动无效详情({"workspaceId": "w", "sessionId": "s"}), 真, "错误:移动无效详情判真")
  断言相等(判移动无效详情({"workspaceId": "w", "sessionId": "s", "beforeSessionId": "z"}), 真, "错误:移动无效带前置判真")
  断言相等(判移动无效详情({"workspaceId": "w"}), 假, "错误:移动无效缺会话判假")
  断言相等(判目录选择详情({"path": "/x"}), 真, "错误:目录选择路径详情判真")
  断言相等(判目录选择详情({"capability": "c"}), 真, "错误:目录选择能力详情判真")
  断言相等(判目录选择详情({}), 假, "错误:目录选择空详情判假")
  断言相等(判工作区错误详情("workspace/invalid-path", {"path": "/x"}), 真, "错误:无效路径详情判真")
  断言相等(判工作区错误详情("workspace/name-conflict", {"name": "n"}), 真, "错误:名称冲突详情判真")
  断言相等(判工作区错误详情("workspace/move-invalid", {"workspaceId": "w", "sessionId": "s"}), 真, "错误:移动详情判真")
  断言相等(判工作区错误详情("directory-picker/unavailable", {"capability": "c"}), 真, "错误:不可用详情判真")
  断言相等(判工作区错误详情("directory-picker/unreadable", {"path": "/x"}), 真, "错误:不可读详情判真")
  断言相等(判工作区错误详情("directory-picker/exists", {"path": "/x"}), 真, "错误:已存在详情判真")
  断言相等(判工作区错误详情("directory-picker/create-failed", {"path": "/x"}), 真, "错误:创建失败详情判真")
  断言相等(判工作区错误详情("directory-picker/unreadable", {"path": 1}), 假, "错误:不可读详情路径非串判假")
  断言相等(判工作区错误详情("workspace/invalid-path", {"path": "/x"}), 真, "错误:无效路径详情再判真")
  断言相等(判工作区错误详情("x", {"path": "/x"}), 假, "错误:未知码详情判假")

段落 用例_文件错误:
  断言相等(判文件错误码("workspace-file/not-found"), 真, "文件错误:未找到码判真")
  断言相等(判文件错误码("workspace-file/outside-workspace"), 真, "文件错误:越界码判真")
  断言相等(判文件错误码("workspace-file/too-large"), 真, "文件错误:过大码判真")
  断言相等(判文件错误码("workspace-file/not-text"), 真, "文件错误:非文本码判真")
  断言相等(判文件错误码("workspace-file/not-regular-file"), 真, "文件错误:非普通文件码判真")
  断言相等(判文件错误码("workspace-file/not-directory"), 真, "文件错误:非目录码判真")
  断言相等(判文件错误码("x"), 假, "文件错误:未知码判假")
  断言相等(判符号种类("symlink"), 真, "文件错误:符号种类判真")
  断言相等(判文件种类("file"), 真, "文件错误:文件种类判真")
  断言相等(判文件错误详情("workspace-file/too-large", {"path": "/a", "limit": 10}), 真, "文件错误:过大详情判真")
  断言相等(判文件错误详情("workspace-file/too-large", {"path": "/a"}), 假, "文件错误:过大详情缺上限判假")
  断言相等(判文件错误详情("workspace-file/too-large", {"path": "/a", "limit": "10"}), 假, "文件错误:过大详情上限非整数判假")
  断言相等(判文件错误详情("workspace-file/not-regular-file", {"path": "/a", "kind": "directory"}), 真, "文件错误:非普通文件详情判真")
  断言相等(判文件错误详情("workspace-file/not-regular-file", {"path": "/a", "kind": "file"}), 假, "文件错误:非普通文件类别越界判假")
  断言相等(判文件错误详情("workspace-file/not-directory", {"path": "/a", "kind": "symlink"}), 真, "文件错误:非目录详情判真")
  断言相等(判文件错误详情("workspace-file/not-found", {"path": "/a"}), 真, "文件错误:未找到详情判真")
  断言相等(判文件错误详情("workspace-file/not-found", {}), 假, "文件错误:未找到详情缺路径判假")
  断言相等(判文件错误详情("x", {"path": "/a"}), 假, "文件错误:未知码详情判假")

