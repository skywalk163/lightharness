# test_沙箱_freebsd.light —— R67.1 FreeBSD jail 封装纯逻辑对拍（Windows 上不做真 jail）
从 沙箱策略 导入 规范策略, 规范路径
从 沙箱_freebsd 导入 默认jail二进制, 拒绝签名表, 运行器失败签名, 运行器失败退出码, 解析jail二进制, 探测jail可用, 验证工作目录, 约束命令, 运行时失败分类, 匹配拒绝签名
从 环境 导入 设置环境变量, 删除环境变量, 获取环境变量, 环境变量存在
从 文件系统 导入 创建临时文件, 删除临时文件
从 文件 导入 建临时目录
从 内置核心列表 导入 列表包含
导入 os

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败[" + 标签 + "]: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言为真 接收 值, 标签:
  如果 值 != 真:
    抛出 "断言失败[" + 标签 + "]: 期望真，实际=" + 转字符串(值)

段落 断言为假 接收 值, 标签:
  如果 值 == 真:
    抛出 "断言失败[" + 标签 + "]: 期望假，实际=" + 转字符串(值)

段落 主:
  打印 "=== FreeBSD jail 封装测试（纯逻辑）==="

  # ---- 解析二进制：测试钩子 > 环境变量 > 默认 ----
  断言相等(解析jail二进制("/fake/bin"), "/fake/bin", "测试钩子优先")
  断言相等(解析jail二进制(""), 默认jail二进制, "空钩子回默认")
  设 有旧 为 环境变量存在("DSH_JAIL_RUN_BIN")
  设 旧 为 空
  如果 有旧:
    设 旧 为 获取环境变量("DSH_JAIL_RUN_BIN")
  设置环境变量("DSH_JAIL_RUN_BIN", "/env/bin")
  断言相等(解析jail二进制(), "/env/bin", "环境变量生效")
  如果 有旧:
    设置环境变量("DSH_JAIL_RUN_BIN", 旧)
  否则:
    删除环境变量("DSH_JAIL_RUN_BIN")

  # ---- 探测可用：假二进制(不存在) → false；存在的临时文件 → true ----
  断言为假(探测jail可用("/nonexistent/dsh-jail-run"), "假二进制不可用")
  设 临时文件 为 创建临时文件("dsh-jail-probe")
  断言为真(探测jail可用(临时文件), "存在的二进制可用")
  删除临时文件(临时文件)

  # ---- 验证工作目录 ----
  设 临时根 为 建临时目录()
  os.makedirs(临时根, exist_ok=真)    # 确保目录落盘（建临时目录 在某些 stdlib 实现仅返回名）
  断言相等(验证工作目录(临时根), 规范路径(临时根), "存在的绝对目录通过")
  设 抛了 为 假
  尝试:
    验证工作目录("/no/such/dir/xyz")
  捕获 错误:
    设 抛了 为 真
  断言为真(抛了, "不存在目录抛错")
  设 抛了 为 假
  尝试:
    验证工作目录("relative/dir")
  捕获 错误:
    设 抛了 为 真
  断言为真(抛了, "相对目录抛错(规范路径拦)")
  os.rmdir(临时根)

  # ---- 约束命令：argv 构造 + 拒绝签名表 + 执行强度 + 无网络 ----
  设 策略只读 为 规范策略(["模式": "read-only", "工作区根": "/tmp/ws"])
  设 约束 为 约束命令(["true"], 策略只读)
  断言相等(约束["argv"][0], 默认jail二进制, "argv[0]=jailBin(默认)")
  断言为真(列表包含(约束["argv"], "--workspace"), "含--workspace")
  断言相等(约束["argv"][2], "/tmp/ws", "argv 工作区根")
  断言为真(列表包含(约束["argv"], "--mode"), "含--mode")
  断言相等(约束["argv"][4], "read-only", "mode=read-only")
  断言相等(约束["argv"][5], "--", "-- 分隔符位置")
  断言相等(约束["argv"][6], "true", "命令透传")
  断言相等(约束["执行强度"], "full", "执行强度full")
  断言相等(约束["拒绝签名表"], 拒绝签名表, "拒绝签名表一致")
  断言相等(约束["无网络"], 真, "默认无网络")
  # 运行器失败规则形状
  断言相等(约束["运行器失败规则"][0]["允许退出码"], 运行器失败退出码, "失败规则退出码125")
  断言相等(约束["运行器失败规则"][0]["致命签名"], 运行器失败签名, "失败规则签名")

  # workspace-write 模式映射
  设 策略写 为 规范策略(["模式": "workspace-write", "工作区根": "/tmp/ws"])
  设 约束写 为 约束命令(["echo", "hi"], 策略写)
  断言相等(约束写["argv"][4], "workspace-write", "mode=workspace-write")
  断言相等(约束写["argv"][6], "echo", "多段命令透传[0]")
  断言相等(约束写["argv"][7], "hi", "多段命令透传[1]")

  # danger-full-access 绕过：不封装，抛错
  设 危险 为 规范策略(["模式": "danger-full-access", "工作区根": "/tmp/ws"])
  设 抛了 为 假
  尝试:
    约束命令(["true"], 危险)
  捕获 错误:
    设 抛了 为 真
  断言为真(抛了, "danger-full-access不封装抛错")

  # ---- 运行时失败分类：区分命令失败 vs 运行器失败 ----
  设 分类1 为 运行时失败分类(125, "dsh-jail-run: bad workspace")
  断言为真(分类1["是运行器失败"], "exit125+签名→运行器失败")
  断言相等(分类1["详情"], "dsh-jail-run: bad workspace", "详情保留原行")
  设 分类2 为 运行时失败分类(0, "dsh-jail-run: x")
  断言为假(分类2["是运行器失败"], "exit0→非运行器失败")
  设 分类3 为 运行时失败分类(1, "dsh-jail-run: x")
  断言为假(分类3["是运行器失败"], "exit1+签名但不在allowedExitCodes→命令失败")
  设 分类4 为 运行时失败分类(1, "read-only file system")
  断言为假(分类4["是运行器失败"], "EROFS→命令被拒(非运行器)")
  设 分类5 为 运行时失败分类(空, "whatever")
  断言为假(分类5["是运行器失败"], "信号终止→非运行器失败")

  # ---- 匹配拒绝签名（内核方言） ----
  断言为真(匹配拒绝签名(1, "mkdir: read-only file system"), "EROFS命中")
  断言为真(匹配拒绝签名(1, "Permission denied"), "EACCES命中")
  断言为真(匹配拒绝签名(1, "Operation not permitted"), "EPERM命中")
  断言为假(匹配拒绝签名(0, "read-only file system"), "exit0不命中")
  断言为假(匹配拒绝签名(1, "command not found"), "无关错误不命中")

  打印 "--- FreeBSD jail 封装测试通过 ---"

主()
