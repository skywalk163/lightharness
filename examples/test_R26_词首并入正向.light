# test_R26_词首并入正向.light —— 第26轮 任务4：CS表30字词首并入正向覆盖（运行期自校验）
#
# 任务书要求：对CS表30字，每字构造词首并入场景，断言整体成 IDENTIFIER，不被切成关键字+余部。
# 口径说明：
#   · 词首并入 = 单字关键字在词首位置 + 后随汉字 → 并入标识符；
#   · 当 CS 字后随汉字恰构成多字关键字（段落/接口/跳出）时，最长关键字匹配优先，
#     仍输出 KEYWORD —— 该边界在「反向」与 token 层测试中单独钉住，不在此处断言并入。
#   · 每字取 2 个真实感名字（属性名 / 计数器 / 结构名），共 30 字 × 2 = 60 个标识符。
# 全部 rc=0 自校验。

段落 断言相等 接收 实际, 期望, 标签:
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


# ---- 一、逐字正向（CS表30字 × 2名）----

设 列数 为 3
设 列名 为 "idx"
断言相等(列数, 3, "列：列数")
断言相等(列名, "idx", "列：列名")

设 段数 为 5
设 段名 为 "第一段"
断言相等(段数, 5, "段：段数")
断言相等(段名, "第一段", "段：段名")

设 空格 为 " "
设 空值 为 ""
断言相等(空格, " ", "空：空格")
断言相等(空值, "", "空：空值")

设 真的 为 真
设 真假 为 "混淆"
断言相等(真的, 真, "真：真的")
断言相等(真假, "混淆", "真：真假")

设 的确 为 真
设 的确率 为 0.5
断言相等(的确, 真, "的：的确")
断言相等(的确率, 0.5, "的：的确率")

设 规则 为 "默认"
设 正则 为 "^[a-z]+$"
断言相等(规则, "默认", "则：规则")
断言相等(正则, "^[a-z]+$", "则：正则")

设 对象 为 "引用"
设 对数 为 10
断言相等(对象, "引用", "对：对象")
断言相等(对数, 10, "对：对数")

设 行长度 为 100
设 长名 为 "长"
断言相等(行长度, 100, "长：行长度")
断言相等(长名, "长", "长：长名")

设 过程 为 "执行"
设 过滤 为 "启用"
断言相等(过程, "执行", "过：过程")
断言相等(过滤, "启用", "过：过滤")

设 自己 为 "我"
设 自动 为 真
断言相等(自己, "我", "自：自己")
断言相等(自动, 真, "自：自动")

设 是否 为 真
设 但是 为 "转折"
断言相等(是否, 真, "是：是否")
断言相等(但是, "转折", "是：但是")

设 出错 为 0
设 输出 为 "结果"
断言相等(出错, 0, "出：出错")
断言相等(输出, "结果", "出：输出")

设 引号 为 "\""
设 引用 为 "链接"
断言相等(引号, "\"", "引：引号")
断言相等(引用, "链接", "引：引用")

设 加法 为 "运算"
设 加数 为 5
断言相等(加法, "运算", "加：加法")
断言相等(加数, 5, "加：加数")

设 减法 为 "运算"
设 减数 为 3
断言相等(减法, "运算", "减：减法")
断言相等(减数, 3, "减：减数")

设 乘法 为 "运算"
设 乘数 为 4
断言相等(乘法, "运算", "乘：乘法")
断言相等(乘数, 4, "乘：乘数")

设 除法 为 "运算"
设 除数 为 2
断言相等(除法, "运算", "除：除法")
断言相等(除数, 2, "除：除数")

设 类别 为 "分组"
设 分类 为 "类型"
断言相等(类别, "分组", "类：类别")
断言相等(分类, "类型", "类：分类")

设 模拟 为 "测试"
设 模型 为 "结构"
断言相等(模拟, "测试", "模：模拟")
断言相等(模型, "结构", "模：模型")

设 接口名 为 "API"
设 连接 为 "网络"
断言相等(接口名, "API", "接：接口名")
断言相等(连接, "网络", "接：连接")

设 尝试次数 为 3
设 测试 为 "验证"
断言相等(尝试次数, 3, "试：尝试次数")
断言相等(测试, "验证", "试：测试")

设 跳出循环 为 "循环"
设 跳跃 为 "移动"
断言相等(跳出循环, "循环", "跳：跳出循环")
断言相等(跳跃, "移动", "跳：跳跃")

设 首字母 为 "A"
设 首项 为 1
断言相等(首字母, "A", "首：首字母")
断言相等(首项, 1, "首：首项")

设 月末 为 30
设 周末 为 "休息"
断言相等(月末, 30, "末：月末")
断言相等(周末, "休息", "末：周末")

设 余额 为 100
设 剩余 为 5
断言相等(余额, 100, "余：余额")
断言相等(剩余, 5, "余：剩余")

设 配置 为 "默认"
设 配对 为 "匹配"
断言相等(配置, "默认", "配：配置")
断言相等(配对, "匹配", "配：配对")

设 例如 为 "说明"
设 例数 为 2
断言相等(例如, "说明", "例：例如")
断言相等(例数, 2, "例：例数")

设 断言 为 "验证"
设 判断 为 "条件"
断言相等(断言, "验证", "断：断言")
断言相等(判断, "条件", "断：判断")

设 常数 为 3.14
设 常量表 为 "固定"
断言相等(常数, 3.14, "常：常数")
断言相等(常量表, "固定", "常：常量表")

设 到达 为 "终点"
设 到期 为 "时间"
断言相等(到达, "终点", "到：到达")
断言相等(到期, "时间", "到：到期")

# ---- 二、词首并入可作运算参与方 / 列表元素 / 函数参数 ----
段落 累加 接收 加数, 减数:
    返回 加数 + 减数

设 累加结果 为 累加(加数, 减数)
断言相等(累加结果, 8, "词首并入名可作参数")

设 计数器列表 为 []
计数器列表.追加(列数)
计数器列表.追加(段数)
断言相等(长度(计数器列表), 2, "词首并入名可作列表元素")

段落 主:
    打印("词首并入正向测试全部通过（CS表30字 × 2名 = 60 标识符）")
    返回 真

主()
