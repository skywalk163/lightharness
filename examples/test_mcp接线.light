# test_mcp接线.light —— 第3步 MCP 装配胶水的端到端冒烟
# 跑法（在 lightharness/ 下）：python 运行.py examples/test_mcp接线.light
# 用现成 examples/mcp_服务器.py（echo/add）做 stdio MCP server，验证
#   挂载MCP服务器(注册表, 配置路径) 能把 mcp__demo__echo/add 注册进工具注册表。

从 工具 导入 工具注册表
从 mcp接线 导入 挂载MCP服务器
从 JSON 导入 序列化JSON
从 文件系统 导入 写入文件, 删除文件

段落 主:
  # 1) 用当前解释器（运行.py 已把 HARNESS_PY 设为 sys.executable 绝对路径，满足 解析MCP配置 的绝对指令要求）
  设 py 为 环境变量("HARNESS_PY", "python")

  # 2) 写临时配置文件（用 序列化JSON 避免手工转义 Windows 路径反斜杠）
  设 配置 为 ["mcpServers": [
    ["名": "demo", "指令": py, "参数": ["examples/mcp_服务器.py"]]
  ]]
  设 cfg路径 为 当前目录() + "\\_tmp_mcp接线_cfg.json"
  写入文件(cfg路径, 序列化JSON(配置))

  尝试:
    # 3) 挂载到一个干净注册表
    设 注册表 为 新建 工具注册表()
    设 结果 为 挂载MCP服务器(注册表, cfg路径)

    断言(结果["服务器数"] == 1, "应装配出 1 个服务器，实际: " + 转字符串(结果["服务器数"]))
    断言(结果["跳过数"] == 0, "不应有失败服务器，实际跳过: " + 转字符串(结果["跳过数"]))
    断言(长度(结果["已注册"]) == 2, "应注册 echo+add 共 2 个工具，实际: " + 转字符串(结果["已注册"]))

    设 名单 为 注册表.名单()
    断言(名单.包含("mcp__demo__echo"), "注册表名单应含 mcp__demo__echo，实际: " + 转字符串(名单))
    断言(名单.包含("mcp__demo__add"), "注册表名单应含 mcp__demo__add")

    # 4) 真的调一次 echo，验证 dispatch 闭包通
    设 out 为 注册表.执行("mcp__demo__echo", ["text": "你好MCP"])
    断言(out["isError"] == 假, "echo 执行不应报错: " + 转字符串(out))
    设 文本块 为 out["content"][0]["text"]
    断言(文本块.包含("你好MCP"), "echo 应回显原文，实际返回: " + 文本块)

    # 5) 无配置文件 = 静默 no-op（不抛错、不注册）
    设 空表 为 新建 工具注册表()
    设 空结果 为 挂载MCP服务器(空表, 当前目录() + "\\_不存在的_mcp配置.json")
    断言(空结果["服务器数"] == 0, "缺配置文件应 no-op")
    断言(长度(空表.名单()) == 0, "缺配置文件注册表应仍为空")

    # 6) 关闭子进程（避免 stdio server 泄漏）
    遍历 c 之 结果["客户端表"]:
      c.关闭()
  捕获 异常 e:
    删除文件(cfg路径)
    抛出 e

  删除文件(cfg路径)
  打印 "test_mcp接线.light: 全部断言通过（" + 转字符串(长度(结果["已注册"])) + " 个 MCP 工具已注册并可调）"

主()
