# test_R87_B3_基建_打包外露判定.light —— R87 任务 B3 第 3 组 对拍测试
# 覆盖 src/打包导出判定.light：isDeclarationOnlyExport 与 sweepImage 运行时面过滤。
# 运行：python 运行.py examples/test_R87_B3_基建_打包外露判定.light

从 打包导出判定 导入 判仅声明外露, 列运行外露面

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 主:
  # ===== 1. 仅声明外露判定 =====
  断言相等(判仅声明外露("./index.js"), 假, "声明-字符串路径=假")
  断言相等(判仅声明外露(空), 假, "声明-空=假")
  断言相等(判仅声明外露({}), 假, "声明-空对象=假")
  断言相等(判仅声明外露({"types": "./index.d.ts"}), 真, "声明-纯types条件=真")
  断言相等(判仅声明外露({"types": "./a.d.ts", "import": {"types": "./b.d.ts"}}), 真, "声明-嵌套全types=真")
  断言相等(判仅声明外露({"types": "./a.d.ts", "import": "./real.js"}), 假, "声明-含真实目标=假")
  断言相等(判仅声明外露({"types@node": "./a.d.ts"}), 真, "声明-types@子路径=真")
  断言相等(判仅声明外露([{"types": "./a.d.ts"}, {"types": "./b.d.ts"}]), 真, "声明-数组全声明=真")
  断言相等(判仅声明外露([{"types": "./a.d.ts"}, "./real.js"]), 假, "声明-数组含真实=假")

  # ===== 2. 运行时面过滤 =====
  断言相等(列运行外露面(空), ["."], "面-缺省=根面")
  设 全量 为 {".": "./index.js", "./sub": "./sub.js", "./types": "./types.d.ts", "./wild/*": "./lib/*.js", "./decl": {"types": "./decl.d.ts"}}
  设 面 为 列运行外露面(全量)
  断言相等(列表包含(面, "."), 真, "面-含根面")
  断言相等(列表包含(面, "./sub"), 真, "面-含真实子面")
  断言相等(列表包含(面, "./types"), 真, "面-字符串目标types保留")
  断言相等(列表包含(面, "./wild/*"), 假, "面-通配键剔除")
  断言相等(列表包含(面, "./decl"), 假, "面-仅types条件树剔除")
  # 不以 . 开头的键（如 "package.json"）不纳入运行时根
  断言相等(列表包含(面, "package.json"), 假, "面-非.开头剔除")

  写 "test_R87_B3_基建_打包外露判定 PASS"

主()
