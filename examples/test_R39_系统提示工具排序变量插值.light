# test_R39_系统提示工具排序变量插值.light —— 第 39 轮 任务 4 判据
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/system-prompt/src/index.ts
#   工具排序（validateToolOrder / orderTools）+ 变量插值（renderPrompt）
#   + 节顺序常量（SECTION_ORDERS / CONTEXT_ORDERS）+ 变量名校验（VARIABLE_NAME）
# 运行：cd lightharness && python 运行.py examples/test_R39_系统提示工具排序变量插值.light
# 覆盖：
#   1. 节顺序常量完整性（30+ 位置 + 上下文 3 位置 + 保留名 + 部署角色前后缀）
#   2. 工具排序：无配置按字典序
#   3. 工具排序：有配置按配置顺序
#   4. 工具排序：未列出工具在 REST 位置（字典序插入）
#   5. 工具排序：未知配置名抛错
#   6. 工具排序：重复名抛错 / 缺 REST 位置抛错
#   7. 变量插值：简单替换 / 多个变量 / 未知变量保留原样 / 无引用原样
#   8. 变量插值：非法引用抛错（大写字母名 / 内嵌 {} / 空名）
#   9. 变量名校验：合法/非法边界
#  10. 部署角色前后缀常量

从 系统提示 导入 节顺序常量表, 上下文顺序常量表, 工具排序未列出标记
从 系统提示 导入 部署角色前缀节名, 部署角色后缀节名, 变量名合法字符集
从 系统提示 导入 比较工具名字, 校验工具排序, 排序工具
从 系统提示 导入 校验变量名, 扫描变量引用, 插值, 渲染提示
从 系统提示 导入 建系统提示注册表, 注册节, 注册变量
从 系统提示 导入 组装系统提示
从 内置核心字典 导入 字典包含键

# ---------- 断言助手 ----------
段落 断言相等(实际, 期望, 编号):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(实际, 编号):
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）#" + 编号 + "：实际=" + 转字符串(实际))

段落 断言假(实际, 编号):
  如果 实际 != 假:
    抛出 新建 错误("断言失败（应为假）#" + 编号 + "：实际=" + 转字符串(实际))

段落 通过(编号):
  打印 "OK #" + 编号

# ---------- 辅助：造工具列表 ----------
段落 造工具(名, 值):
  返回 {"name": 名, "value": 值}

# ---------- 辅助：取排序后工具名列表 ----------
段落 工具名列表(工具们):
  设 结果 为 []
  遍历 t 之 工具们:
    结果.追加(t["name"])
  返回 结果

# ---------- 辅助：字典是否包含某个值 ----------
段落 值在(列表, 值):
  遍历 x 之 列表:
    如果 x == 值:
      返回 真
  返回 假

# ---------- 辅助：包含子串 ----------
段落 包含(字符串, 子串):
  如果 长(子串) == 0:
    返回 真
  如果 长(字符串) < 长(子串):
    返回 假
  设 i 为 0
  设 上界 为 长(字符串) - 长(子串)
  当 i <= 上界:
    如果 字符串[i:i + 长(子串)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 主:
  设 计数 为 0

  # ===== #00 判据自检：断言助手必须真能报错 =====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检报错 为 真
  断言真(自检报错, "00")
  通过("00")

  # ===== #01 节顺序常量完整性（HARNESS_IDENTITY..DEPLOYMENT_PERSONA_SUFFIX）=====
  设 计数 为 计数 + 1
  设 表 为 节顺序常量表
  断言相等(表["HARNESS_IDENTITY"], -1000, "01")
  断言相等(表["DEPLOYMENT_PERSONA_PREFIX"], 0, "01b")
  断言相等(表["PLAN_POLICY"], 500, "01c")
  断言相等(表["TEAM_POLICY"], 600, "01d")
  断言相等(表["PTC_ONLY"], 800, "01e")
  断言相等(表["FILE_REFERENCE"], 900, "01f")
  断言相等(表["TOOL_BASH"], 1000, "01g")
  断言相等(表["TOOL_PWSH"], 1010, "01h")
  断言相等(表["TOOL_READ"], 1100, "01i")
  断言相等(表["TOOL_WRITE"], 1200, "01j")
  断言相等(表["TOOL_EDIT"], 1300, "01k")
  断言相等(表["TOOL_GLOB"], 1400, "01l")
  断言相等(表["TOOL_GREP"], 1500, "01m")
  断言相等(表["TOOL_JOBS"], 1600, "01n")
  断言相等(表["TOOL_PTY"], 1700, "01o")
  断言相等(表["TOOL_WEB_SEARCH"], 2000, "01p")
  断言相等(表["TOOL_WEB_FETCH"], 2100, "01q")
  断言相等(表["TOOL_LSP"], 2200, "01r")
  断言相等(表["TOOL_SESSION_QUERY"], 2300, "01s")
  断言相等(表["TOOL_GOAL"], 2400, "01t")
  断言相等(表["TOOL_CORDIS"], 2500, "01u")
  断言相等(表["TOOL_WORKFLOW"], 2600, "01v")
  断言相等(表["TOOL_RALPH"], 2700, "01w")
  断言相等(表["TOOL_SUBAGENT"], 2800, "01x")
  断言相等(表["TOOL_REPORT"], 2900, "01y")
  断言相等(表["TOOLS_SDK"], 5000, "01z")
  断言相等(表["DELIVERABLE_FILE_REFERENCES"], 9000, "01A")
  断言相等(表["STRUCTURED_OUTPUT"], 9900, "01B")
  断言相等(表["HARNESS_SOURCE"], 10000, "01C")
  断言相等(表["WEB_SURFACE"], 10100, "01D")
  断言相等(表["DEPLOYMENT_PERSONA_SUFFIX"], 10200, "01E")
  # 单调递增
  断言假(表["HARNESS_IDENTITY"] >= 表["DEPLOYMENT_PERSONA_PREFIX"], "01F")
  断言假(表["DEPLOYMENT_PERSONA_PREFIX"] >= 表["PLAN_POLICY"], "01G")
  断言假(表["TOOL_BASH"] >= 表["TOOLS_SDK"], "01H")
  断言假(表["TOOLS_SDK"] >= 表["DELIVERABLE_FILE_REFERENCES"], "01I")
  断言假(表["STRUCTURED_OUTPUT"] >= 表["DEPLOYMENT_PERSONA_SUFFIX"], "01J")
  通过("01")

  # ===== #02 上下文顺序常量（SANDBOX/Approve/Subagent） =====
  设 计数 为 计数 + 1
  设 上表 为 上下文顺序常量表
  断言相等(上表["SANDBOX_POLICY"], 110, "02")
  断言相等(上表["APPROVAL_POLICY"], 115, "02b")
  断言相等(上表["SUBAGENT_DELEGATION"], 120, "02c")
  断言假(上表["SANDBOX_POLICY"] >= 上表["APPROVAL_POLICY"], "02d")
  断言假(上表["APPROVAL_POLICY"] >= 上表["SUBAGENT_DELEGATION"], "02e")
  通过("02")

  # ===== #03 工具排序未列出标记 + 部署角色前后缀常量 =====
  设 计数 为 计数 + 1
  断言相等(工具排序未列出标记, "<unlisted-tools>", "03")
  断言相等(部署角色前缀节名, "deployment:persona-prefix", "03b")
  断言相等(部署角色后缀节名, "deployment:persona-suffix", "03c")
  通过("03")

  # ===== #04 工具排序：无配置按字典序 =====
  设 计数 为 计数 + 1
  设 甲表 为 [
    造工具("zeta", "Z"),
    造工具("alpha", "A"),
    造工具("beta", "B"),
    造工具("gamma", "G")
  ]
  设 排 为 排序工具(甲表)
  断言相等(工具名列表(排), ["alpha", "beta", "gamma", "zeta"], "04")
  通过("04")

  # 无配置：空列表不抛错
  设 排2 为 排序工具([])
  断言相等(长(排2), 0, "04b")
  通过("04b")

  # ===== #05 工具排序：有配置按配置顺序 =====
  设 计数 为 计数 + 1
  设 已列乙 为 [
    造工具("beta", "B"),
    造工具("alpha", "A"),
    造工具("gamma", "G")
  ]
  设 排乙 为 排序工具(已列乙, ["gamma", "beta", "alpha", 工具排序未列出标记])
  断言相等(工具名列表(排乙), ["gamma", "beta", "alpha"], "05")
  通过("05")

  # ===== #06 工具排序：未列出工具在 REST 位置（字典序插入） =====
  设 计数 为 计数 + 1
  设 混合 为 [
    造工具("apple", "A"),
    造工具("zeta", "Z"),
    造工具("mango", "M")
  ]
  # 配置只列出 zeta，其它落在 REST 位置按字典序：apple, mango
  设 排丙 为 排序工具(混合, [工具排序未列出标记, "zeta"])
  断言相等(工具名列表(排丙), ["apple", "mango", "zeta"], "06")
  通过("06")

  # REST 在开头：全部字典序，与无配置等价
  设 排丁 为 排序工具(混合, [工具排序未列出标记])
  断言相等(工具名列表(排丁), ["apple", "mango", "zeta"], "06b")

  # REST 在中间：混合排序
  设 排戊 为 排序工具(混合, ["zeta", 工具排序未列出标记])
  断言相等(工具名列表(排戊), ["zeta", "apple", "mango"], "06c")
  通过("06c")

  # ===== #07 工具排序：未知配置名抛错 =====
  设 计数 为 计数 + 1
  设 已知 为 [造工具("alpha", "A"), 造工具("beta", "B")]
  设 抛1 为 0
  尝试:
    排序工具(已知, ["alpha", "ghost", 工具排序未列出标记])
  捕获 异常 为 e:
    设 抛1 为 抛1 + 1
  断言相等(抛1, 1, "07")
  通过("07")

  # ===== #08 工具排序：重复名抛错 / 缺 REST 抛错 =====
  设 计数 为 计数 + 1
  设 抛3 为 0
  尝试:
    排序工具([], ["alpha", "alpha", 工具排序未列出标记])
  捕获 异常 为 e:
    设 抛3 为 抛3 + 1
  尝试:
    排序工具([], ["alpha", "beta"])
  捕获 异常 为 e:
    设 抛3 为 抛3 + 1
  断言相等(抛3, 2, "08")
  通过("08")

  # 独立函数直接校验：重复名
  设 抛4 为 0
  尝试:
    校验工具排序(["a", "a", 工具排序未列出标记])
  捕获 异常 为 e:
    设 抛4 为 抛4 + 1
  断言相等(抛4, 1, "08b")

  # 独立函数直接校验：缺 REST
  设 抛5 为 0
  尝试:
    校验工具排序(["a", "b"])
  捕获 异常 为 e:
    设 抛5 为 抛5 + 1
  断言相等(抛5, 1, "08c")

  # 空配置视为未配置：不抛错，返回 空
  设 空配 为 空
  断言相等(校验工具排序(空配), 空配, "08d")
  通过("08b-08d")

  # 保留名工具抛错（工具名本身 = <unlisted-tools>）
  设 抛6 为 0
  尝试:
    排序工具([造工具(工具排序未列出标记, "X")])
  捕获 异常 为 e:
    设 抛6 为 抛6 + 1
  断言相等(抛6, 1, "08e")
  通过("08e")

  # ===== #09 变量插值：简单替换 =====
  设 计数 为 计数 + 1
  设 变量表 为 {"name": "Alice", "city": "Beijing"}
  断言相等(插值("Hi {{name}}!", 变量表), "Hi Alice!", "09")
  通过("09")

  # ===== #10 变量插值：多个变量 =====
  设 计数 为 计数 + 1
  断言相等(
    插值("Hello {{name}} in {{city}}!", 变量表),
    "Hello Alice in Beijing!",
    "10"
  )
  # 同一变量多次引用
  断言相等(
    插值("{{name}} is in {{city}} and {{name}} is happy", 变量表),
    "Alice is in Beijing and Alice is happy",
    "10b"
  )
  通过("10")

  # ===== #11 变量插值：未知变量保留原样 =====
  设 计数 为 计数 + 1
  断言相等(插值("Hi {{unknown_var}}!", 变量表), "Hi {{unknown_var}}!", "11")
  # 混合：已知的替换，未知的保留
  断言相等(
    插值("Hi {{name}} in {{missing}} city", 变量表),
    "Hi Alice in {{missing}} city",
    "11b"
  )
  通过("11")

  # 变量表为空：所有引用保留
  设 空表 为 {}
  断言相等(插值("Hi {{name}}!", 空表), "Hi {{name}}!", "11c")
  通过("11c")

  # 无引用：原样返回
  断言相等(插值("Hi Alice!", 变量表), "Hi Alice!", "11d")
  # 空文本
  断言相等(插值("", 变量表), "", "11e")
  通过("11d-11e")

  # ===== #12 变量插值：非法引用抛错 =====
  设 计数 为 计数 + 1
  # 大写字母名（不合规）
  设 抛7 为 0
  尝试:
    插值("Hi {{NAME}}!", 变量表)
  捕获 异常 为 e:
    设 抛7 为 抛7 + 1
  断言相等(抛7, 1, "12")

  # 内嵌 { } 字符
  设 抛8 为 0
  尝试:
    插值("Hi {{a{b}}}!", 变量表)
  捕获 异常 为 e:
    设 抛8 为 抛8 + 1
  断言相等(抛8, 1, "12b")

  # 内嵌右花括号
  设 抛9 为 0
  尝试:
    插值("Hi {{a}b}}}!", 变量表)
  捕获 异常 为 e:
    设 抛9 为 抛9 + 1
  断言相等(抛9, 1, "12c")

  # 空名 {{}}
  设 抛10 为 0
  尝试:
    插值("Hi {{}}!", 变量表)
  捕获 异常 为 e:
    设 抛10 为 抛10 + 1
  断言相等(抛10, 1, "12d")
  通过("12")

  # ===== #13 变量名校验：合法/非法边界 =====
  设 计数 为 计数 + 1
  断言真(校验变量名("name"), "13")
  断言真(校验变量名("a"), "13b")
  断言真(校验变量名("a_b"), "13c")
  断言真(校验变量名("a1"), "13d")
  断言真(校验变量名("a1_b2_c3"), "13e")
  断言假(校验变量名("Name"), "13f")
  断言假(校验变量名("1name"), "13g")
  断言假(校验变量名("_name"), "13h")
  断言假(校验变量名(""), "13i")
  断言假(校验变量名("na me"), "13j")
  断言假(校验变量名("na-me"), "13k")
  断言假(校验变量名("NAME"), "13l")
  通过("13")

  # ===== #14 扫描变量引用：识别合法/非法引用 =====
  设 计数 为 计数 + 1
  设 结果 为 扫描变量引用("Hi {{name}} in {{city}}!")
  断言相等(长(结果), 2, "14")
  断言相等(结果[0]["名字"], "name", "14b")
  断言相等(结果[0]["起始"], 3, "14c")
  断言相等(结果[1]["名字"], "city", "14d")
  断言相等(长(扫描变量引用("plain text")), 0, "14e")
  # 未闭合：不匹配
  断言相等(长(扫描变量引用("Hi {{name!")), 0, "14f")
  # 内嵌 { } 字符：视为不合法，不记录
  设 嵌 为 扫描变量引用("{{a{b}}}")
  断言相等(长(嵌), 0, "14g")
  通过("14")

  # ===== #15 比较工具名字：字典序 =====
  设 计数 为 计数 + 1
  断言相等(比较工具名字("alpha", "beta"), -1, "15")
  断言相等(比较工具名字("beta", "alpha"), 1, "15b")
  断言相等(比较工具名字("same", "same"), 0, "15c")
  通过("15")

  # ===== #16 渲染提示：把节文本按变量表插值 =====
  设 计数 为 计数 + 1
  设 注册表 为 建系统提示注册表()
  注册变量(注册表, "name", "Bob")
  注册节(注册表, "intro", 100, "Hi {{name}}, welcome!")
  注册节(注册表, "tail", 200, "bye {{name}}")
  设 装配 为 {
    "节列表": [
      {"名字": "intro", "顺序": 100, "文本": "Hi {{name}}, welcome!"},
      {"名字": "tail", "顺序": 200, "文本": "bye {{name}}"}
    ],
    "上下文列表": [],
    "工具列表": [],
    "变量表": 注册表["变量表"]
  }
  断言相等(渲染提示(装配), "Hi Bob, welcome!\n\nbye Bob", "16")
  通过("16")

  # ===== #17 通过 组装系统提示 走完整链路，再渲染 =====
  设 计数 为 计数 + 1
  设 表2 为 建系统提示注册表()
  注册变量(表2, "who", "carol")
  注册节(表2, "s1", 100, "Hello {{who}}")
  注册节(表2, "s2", 200, "{{who}} is here")
  设 装配2 为 组装系统提示(表2)
  断言相等(长(装配2["节列表"]), 2, "17")
  断言相等(
    渲染提示(装配2),
    "Hello carol\n\ncarol is here",
    "17b"
  )
  通过("17")

  # ===== #18 变量名合法字符集完整性 =====
  设 计数 为 计数 + 1
  断言相等(长(变量名合法字符集), 37, "18")
  断言真(变量名合法字符集.包含("a"), "18a")
  断言真(变量名合法字符集.包含("z"), "18b")
  断言真(变量名合法字符集.包含("0"), "18c")
  断言真(变量名合法字符集.包含("9"), "18d")
  断言真(变量名合法字符集.包含("_"), "18e")
  断言假(变量名合法字符集.包含("A"), "18f")
  断言假(变量名合法字符集.包含("-"), "18g")
  断言假(变量名合法字符集.包含(" "), "18h")
  通过("18")

  打印 "系统提示工具排序变量插值 判据通过：" + 转字符串(计数) + " 组"
  返回 真
