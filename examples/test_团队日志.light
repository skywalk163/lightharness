# test_团队日志.light —— 对标 #70：TeamJournal 纯逻辑复刻
# 原版：packages/experimental/agent-team/src/journal.ts（TeamJournal，71 行）
#   用例对齐 tests/team.spec.ts「Team journal / transaction ordering」段落。
#
# 反跑判据（改反必须红）：
#   1) 种类越界不抛 —— 用例「反跑_种类越界」断言 追加落盘 对非可变动种类必抛
#      [TEAM_INVALID_EVENT_TYPE]；若去掉 列表包含 判断即红。
#   2) 落盘缺失 —— 用例「反跑_落盘缺失」断言 追加落盘 必触发 落盘 能力；若删掉 落盘 调用即红。
#   3) 提交缺失 —— 用例「反跑_提交缺失」断言 追加落盘 必触发 提交 能力；若删掉 提交 调用即红。
#   4) 串行乱序 —— 用例「反跑_串行」断言 同一 rootId 的两次 事务 尾序号递增；若 事务 不记录
#      尾 即红。
#   5) 回放错 —— 用例「反跑_回放」断言 回放 复用 折叠团队（成员事件进入 成员表）；若 回放 返回
#      常量而非 折叠团队(根标识,事件表) 即红。
#
# 语言坑规避：
#   - `新建 错误(...)` 只能作 抛出 的直接操作数（L-056），故错误值是字典、抛出点现造。
#   - 写 只吃字面量串（L-055），本文件诊断全部走 抛出 新建 错误。
#   - 断言降级 no-op（L-037），一律 断言相等 / 检查抛码。
#   - 字面量单行（L-051）；嵌套字面量内不写 \n（L-054）。
#   - 无闭包：抛错场景走「具名零参段落」的槽位模式。

从 团队日志 导入 造日志, 回放, 事务, 追加落盘, 可变动种类, 取尾序号
从 内置核心转换 导入 转字符串

# =====================================================================
# 断言框架（同 #68：诊断全走 抛出 新建 错误，不用 写）
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛码 接收 标签, 码, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, "[" + 码 + "]") == 假):
    抛出 新建 错误("错误码不符[" + 标签 + "]：实际=" + 文 + " 期望码=" + 码)

# =====================================================================
# 事件构造助手（复用 #67 验证过的记录形状，供 回放 用例）
# =====================================================================
段落 造记录 接收 种类, 数据, 序号:
  设 记 为 {}
  记["type"] 为 种类
  记["data"] 为 数据
  记["seq"] 为 序号
  记["time"] 为 序号
  返回 记

段落 造成员 接收 覆盖:
  设 成 为 {}
  成["id"] 为 "worker-a"
  成["name"] 为 "worker-a"
  成["description"] 为 "worker"
  成["provider"] 为 "spawn"
  成["context"] 为 "fresh"
  成["phase"] 为 "provisioning"
  遍历 键 之 字典键列表(覆盖):
    成[键] 为 覆盖[键]
  返回 成

段落 造成员记录 接收 队伍, 覆盖, 序号:
  返回 造记录("team/member", {"version": 1, "teamId": 队伍, "member": 造成员(覆盖)}, 序号)

段落 造任务 接收 覆盖:
  设 任 为 {}
  任["id"] 为 "task-1"
  任["revision"] 为 1
  任["subject"] 为 "do"
  任["description"] 为 ""
  任["status"] 为 "pending"
  任["blockedBy"] 为 []
  任["writeScopes"] 为 []
  遍历 键 之 字典键列表(覆盖):
    任[键] 为 覆盖[键]
  返回 任

段落 造任务记录 接收 队伍, 覆盖, 序号:
  返回 造记录("team/task", {"version": 1, "teamId": 队伍, "task": 造任务(覆盖)}, 序号)

# =====================================================================
# 常量
# =====================================================================
设 根标识 为 "team-root"
设 副标识 为 "team-b"
设 录 为 {"追加": [], "落盘": [], "提交": [], "序": []}
设 序表 为 []

# =====================================================================
# 假能力（宿主 session.append / sessions.flush / onCommit 投影）
# =====================================================================
段落 假追加 接收 根标识, 种类, 数据:
  全局 录
  列表追加(录["追加"], {"根": 根标识, "种类": 种类, "数据": 数据})

段落 假落盘 接收 根标识:
  全局 录
  列表追加(录["落盘"], 根标识)

段落 假提交 接收 根标识:
  全局 录
  列表追加(录["提交"], 根标识)

段落 清录:
  全局 录, 序表
  设 录["追加"] 为 []
  设 录["落盘"] 为 []
  设 录["提交"] 为 []
  设 录["序"] 为 []
  设 序表 为 []

# 序记录假能力（把三类调用都记入 序，验证单次调用顺序）
段落 假追加序 接收 根标识, 种类, 数据:
  全局 录
  列表追加(录["序"], "追加")
  列表追加(录["追加"], {"根": 根标识, "种类": 种类, "数据": 数据})

段落 假落盘序 接收 根标识:
  全局 录
  列表追加(录["序"], "落盘")

段落 假提交序 接收 根标识:
  全局 录
  列表追加(录["序"], "提交")

# =====================================================================
# 操作助手（供 事务 用例）
# =====================================================================
段落 操甲:
  全局 序表
  列表追加(序表, "甲")
  返回 "甲"

段落 操乙:
  全局 序表
  列表追加(序表, "乙")
  返回 "乙"

段落 操丙:
  全局 序表
  列表追加(序表, "丙")
  返回 "丙"

段落 操数:
  返回 7

段落 操典:
  设 典 为 {}
  典["k"] 为 "v"
  返回 典

# =====================================================================
# 反跑运算助手（零参 段落，供 检查抛码）
# =====================================================================
段落 反跑_种类越界_运算:
  全局 根标识
  追加落盘(根标识, "team/chat", {})

段落 反跑_种类越界_空_运算:
  全局 根标识
  追加落盘(根标识, "", {})

# =====================================================================
# 用例
# =====================================================================
段落 用例_回放:
  全局 录, 序表, 根标识, 副标识
  全局 录, 序表, 根标识, 副标识

  # ---- 用例_回放（复用 #67 折叠团队）----
  设 空局 为 回放(根标识, [])
  断言相等(字典包含键(空局, "成员表"), 真, "回放空: 含成员表")
  断言相等(字典包含键(空局, "消息表"), 真, "回放空: 含消息表")
  断言相等(字典包含键(空局, "任务表"), 真, "回放空: 含任务表")
  断言相等(长度(字典键列表(空局["成员表"])), 0, "回放空: 成员表空")
  断言相等(长度(字典键列表(空局["任务表"])), 0, "回放空: 任务表空")
  断言相等(字典包含键(空局, "名字索引"), 真, "回放空: 含名字索引")

  设 事甲 为 造成员记录(根标识, {"id": "alice", "name": "alice"}, 1)
  设 局甲 为 回放(根标识, [事甲])
  断言相等(字典包含键(局甲["成员表"], "alice"), 真, "回放_成员: 含 alice")
  断言相等(局甲["成员表"]["alice"]["name"], "alice", "回放_成员: alice name")
  断言相等(长度(字典键列表(局甲["成员表"])), 1, "回放_成员: 仅 1 成员")
  断言相等(局甲["名字索引"]["alice"], "alice", "回放_成员: 名字索引 name→id")

  设 事乙 为 造成员记录(根标识, {"id": "bob", "name": "bob"}, 2)
  设 局双 为 回放(根标识, [事甲, 事乙])
  断言相等(字典包含键(局双["成员表"], "alice"), 真, "回放_双: 含 alice")
  断言相等(字典包含键(局双["成员表"], "bob"), 真, "回放_双: 含 bob")
  断言相等(长度(字典键列表(局双["成员表"])), 2, "回放_双: 2 成员")

  # 反跑_回放：若 回放 返回常量空状态，则 局双 不含 bob → 红（由上方断言守）
  设 事任 为 造任务记录(根标识, {"id": "t1", "subject": "x"}, 3)
  设 局任 为 回放(根标识, [事任])
  断言相等(字典包含键(局任["任务表"], "t1"), 真, "回放_任务: 含 t1")
  断言相等(局任["任务表"]["t1"]["subject"], "x", "回放_任务: t1 subject")

  设 局混 为 回放(根标识, [事甲, 事任])
  断言相等(字典包含键(局混["成员表"], "alice"), 真, "回放_混合: 含 alice")
  断言相等(字典包含键(局混["任务表"], "t1"), 真, "回放_混合: 含 t1")

  # ---- 用例_追加落盘 基本流程 ----

段落 用例_追加落盘:
  全局 录, 序表, 根标识, 副标识
  清录
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  追加落盘(根标识, "team/member", {"id": "alice"})
  断言相等(长度(录["追加"]), 1, "追加落盘: 追加调用1次")
  断言相等(字典包含键(录["追加"][0], "根"), 真, "追加落盘: 含根键")
  断言相等(字典包含键(录["追加"][0], "种类"), 真, "追加落盘: 含种类键")
  断言相等(字典包含键(录["追加"][0], "数据"), 真, "追加落盘: 含数据键")
  断言相等(录["追加"][0]["根"], 根标识, "追加落盘: 记录根标识")
  断言相等(录["追加"][0]["种类"], "team/member", "追加落盘: 记录种类")
  断言相等(字典包含键(录["追加"][0]["数据"], "id"), 真, "追加落盘: 数据含id")
  断言相等(录["追加"][0]["数据"]["id"], "alice", "追加落盘: 数据id=alice")
  断言相等(长度(录["落盘"]), 1, "追加落盘: 落盘1次")
  断言相等(录["落盘"][0], 根标识, "追加落盘: 落盘根标识")
  断言相等(长度(录["提交"]), 1, "追加落盘: 提交1次")
  断言相等(录["提交"][0], 根标识, "追加落盘: 提交根标识")

  # 单次调用顺序：追加 → 落盘 → 提交
  清录
  造日志({"追加": 假追加序, "落盘": 假落盘序, "提交": 假提交序})
  追加落盘(根标识, "team/member", {})
  断言相等(长度(录["序"]), 3, "序: 单次3步")
  断言相等(录["序"][0], "追加", "序: 首步追加")
  断言相等(录["序"][1], "落盘", "序: 次步落盘")
  断言相等(录["序"][2], "提交", "序: 末步提交")

  # 多次调用：每步仍是 追加→落盘→提交
  清录
  造日志({"追加": 假追加序, "落盘": 假落盘序, "提交": 假提交序})
  追加落盘(根标识, "team/member", {})
  追加落盘(根标识, "team/task", {})
  断言相等(长度(录["序"]), 6, "序: 两次6步")
  断言相等(录["序"][0], "追加", "序: 调用1首步追加")
  断言相等(录["序"][1], "落盘", "序: 调用1次步落盘")
  断言相等(录["序"][2], "提交", "序: 调用1末步提交")
  断言相等(录["序"][3], "追加", "序: 调用2首步追加")
  断言相等(录["序"][4], "落盘", "序: 调用2次步落盘")
  断言相等(录["序"][5], "提交", "序: 调用2末步提交")
  断言相等(长度(录["追加"]), 2, "追加落盘: 两次追加")
  断言相等(录["追加"][1]["种类"], "team/task", "追加落盘: 第二次种类=task")

  # ---- 用例_可变动种类合法 ----

段落 用例_可变动:
  全局 录, 序表, 根标识, 副标识
  清录
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  追加落盘(根标识, "team/member", {})
  追加落盘(根标识, "team/task", {})
  追加落盘(根标识, "team/message/queued", {})
  追加落盘(根标识, "team/message/delivered", {})
  断言相等(长度(录["追加"]), 4, "可变动: 4次追加")
  断言相等(录["追加"][0]["种类"], "team/member", "可变动: 0=member")
  断言相等(录["追加"][1]["种类"], "team/task", "可变动: 1=task")
  断言相等(录["追加"][2]["种类"], "team/message/queued", "可变动: 2=queued")
  断言相等(录["追加"][3]["种类"], "team/message/delivered", "可变动: 3=delivered")

  # 可变动种类集合断言
  断言相等(列表包含(可变动种类, "team/member"), 真, "集: member")
  断言相等(列表包含(可变动种类, "team/task"), 真, "集: task")
  断言相等(列表包含(可变动种类, "team/message/queued"), 真, "集: queued")
  断言相等(列表包含(可变动种类, "team/message/delivered"), 真, "集: delivered")
  断言相等(长度(可变动种类), 4, "集: 长度4")
  断言相等(列表包含(可变动种类, "team/chat"), 假, "集: 不含 chat")
  断言相等(列表包含(可变动种类, "conversation"), 假, "集: 不含 conversation")

  # ---- 反跑_种类越界（锚点1）----

段落 用例_反跑:
  全局 录, 序表, 根标识, 副标识
  清录
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  检查抛码("反跑_种类越界_chat", "TEAM_INVALID_EVENT_TYPE", 反跑_种类越界_运算)
  检查抛码("反跑_种类越界_empty", "TEAM_INVALID_EVENT_TYPE", 反跑_种类越界_空_运算)
  断言相等(长度(录["追加"]), 0, "种类越界: 未追加")
  断言相等(长度(录["落盘"]), 0, "种类越界: 未落盘")
  断言相等(长度(录["提交"]), 0, "种类越界: 未提交")

  # ---- 反跑_落盘缺失 / 提交缺失（锚点2/3）----
  清录
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  追加落盘(根标识, "team/task", {})
  断言相等(列表包含(录["落盘"], 根标识), 真, "反跑_落盘缺失: 必触发落盘")
  断言相等(列表包含(录["提交"], 根标识), 真, "反跑_提交缺失: 必触发提交")

  # ---- 用例_事务 ----

段落 用例_事务:
  全局 录, 序表, 根标识, 副标识
  清录
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  设 序表 为 []
  断言相等(事务(根标识, 操甲), "甲", "事务: 返回操作结果")
  断言相等(长度(序表), 1, "事务: 执行1次")
  断言相等(序表[0], "甲", "事务: 序表含甲")

  设 序表 为 []
  事务(根标识, 操甲)
  事务(根标识, 操乙)
  断言相等(长度(序表), 2, "事务: 两次2序")
  断言相等(序表[0], "甲", "事务: 序表[0]=甲")
  断言相等(序表[1], "乙", "事务: 序表[1]=乙")

  # per-root 串行：不同 root 操作按调用序记入全局序表，per-root 各自成链
  设 序表 为 []
  事务(根标识, 操甲)
  事务(副标识, 操乙)
  事务(根标识, 操丙)
  断言相等(长度(序表), 3, "事务_per-root: 3序")
  断言相等(序表[0], "甲", "事务_per-root: [0]=甲(A)")
  断言相等(序表[1], "乙", "事务_per-root: [1]=乙(B)")
  断言相等(序表[2], "丙", "事务_per-root: [2]=丙(A)")

  # 事务 返回非字符串值
  断言相等(事务(根标识, 操数), 7, "事务: 返回数字")
  断言相等(字典包含键(事务(根标识, 操典), "k"), 真, "事务: 返回字典含k")
  断言相等(事务(根标识, 操典)["k"], "v", "事务: 返回字典k=v")

  # 尾序号：同 root 递增（锚点4 反跑_串行）
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  事务(根标识, 操甲)
  事务(根标识, 操乙)
  断言相等(取尾序号(根标识), 2, "事务: 同root尾=2")
  断言相等(取尾序号(副标识), 0, "事务: 异root尾=0")

  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  事务(根标识, 操甲)
  事务(副标识, 操乙)
  断言相等(取尾序号(根标识), 1, "事务: 分root尾A=1")
  断言相等(取尾序号(副标识), 1, "事务: 分root尾B=1")

  # 事务 与 追加落盘 共用尾映射：追加落盘 也递增尾
  造日志({"追加": 假追加, "落盘": 假落盘, "提交": 假提交})
  事务(根标识, 操甲)
  追加落盘(根标识, "team/member", {})
