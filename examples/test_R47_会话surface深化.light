# test_R47_会话surface深化.light —— R47 任务4：surface 投影深化判据
#
# 上游依据（G:\github\deepseek-harness，0.1.5-rc.2）：
#   packages/core/session/src/surface.ts
#     SURFACE_EVENT_TYPES / isSurfaceEvent / deriveEventMessage /
#     validateSessionEventData / foldSurface（节点0保护与遮蔽语义）
#   packages/session/session-format-v2-to-v3/src/payload.ts（header.system 退役）
#
# 覆盖：
#   §1 节点0投影：system/message 聚合为模型可见首条 system 消息；空文本节点不产消息但保留位置；replace 替换
#   §2 遮蔽跳过：被 replace 遮蔽的节点不参与投影（上游「shadowed nodes are excluded」）
#   §3 投影节点消息：deriveEventMessage 四类语义（内嵌流合并 / 空内容→空 / log-only→空）
#   §4 校验表面事件数据：V3 系统提示记录约束 + tool/result 失败元数据一致性
#   §5 V3 记录形状：记录系统提示 只接受 append/replace
#   §6 表面类型判定
#
# 反跑判据：把任一 断言相等/断言真 的期望值改反，或去掉 原始件["遮蔽"] 为 真，即红。
# 运行：cd lightharness && python 运行.py examples/test_R47_会话surface深化.light

从 会话格式 导入 造事件, 投影节点0, 投影表面消息, 投影节点消息, 校验表面事件数据, 记录系统提示
从 会话格式 导入 表面可入类型, 是表面事件, 表面操作取值, 是替换操作, 空内容判定
从 会话 导入 新建会话
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("反跑判据失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("反跑判据失败[" + 标签 + "]")

# 含子串（判据文案核对用）
段落 含子串(原文, 子串):
  设 n 为 长度(原文)
  设 m 为 长度(子串)
  如果 m == 0:
    返回 真
  设 i 为 0
  当 i + m <= n:
    如果 原文[i:(i+m)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

# 造一条本地形状 system/message
段落 系统件(序号, 提示, 操作):
  返回 造事件("system/message", 序号, 1000 + 序号, ["系统": 提示, "表面操作": 操作])

段落 主程:
  # ================= §1 节点0投影 =================
  断言相等(投影节点0([]), 空, "1a 空事件表节点0为空")

  设 表甲 为 []
  列表追加(表甲, 系统件(0, "你是助手。", "append"))
  列表追加(表甲, 系统件(1, "用中文回答。", "append"))
  断言相等(投影节点0(表甲), "你是助手。用中文回答。", "1b append 聚合")

  设 表乙 为 []
  列表追加(表乙, 系统件(0, "旧系统", "append"))
  列表追加(表乙, 系统件(1, "新系统", "replace"))
  断言相等(投影节点0(表乙), "新系统", "1c replace 替换")

  # 空文本节点：不产消息，但保留表面位置（对齐上游「an empty one as no message」+ 节点表长度不变）
  设 表丙 为 []
  列表追加(表丙, 系统件(0, "", "append"))
  设 投影丙 为 投影表面消息(表丙)
  断言相等(投影节点0(表丙), 空, "1d 空文本节点0 无消息")
  断言相等(长度(投影丙["节点表"]), 1, "1e 空文本节点保留位置")
  断言相等(长度(投影丙["消息表"]), 0, "1f 空文本节点不产线消息")

  # 事件级字典 surfaceOp（会话日志增量.light 表示）：op=replace 亦按替换处理
  设 件字典 为 ["类型": "system/message", "序号": 0, "时间": 10, "数据": ["系统": "改写后"],
     "表面操作": ["op": "replace", "startSeq": 0, "endSeq": 0]]
  断言真(是替换操作(表面操作取值(件字典)), "1g 事件级字典 replace 识别")
  设 表丁 为 [件字典]
  断言相等(投影节点0(表丁), "改写后", "1h 事件级 replace 生效")

  # 节点0 置于模型可见消息最前
  设 表戊 为 []
  列表追加(表戊, 系统件(0, "系统提示", "append"))
  设 用户件一 为 造事件("user/message", 1, 2000, ["消息": ["角色": "user", "content": [["type": "text", "text": "你好"]]]])
  列表追加(表戊, 用户件一)
  设 投影戊 为 投影表面消息(表戊)
  断言相等(长度(投影戊["消息表"]), 2, "1i 系统+用户两条")
  断言相等(投影戊["消息表"][0]["角色"], "system", "1j 节点0 最前")
  断言相等(投影戊["消息表"][0]["content"][0]["text"], "系统提示", "1k 节点0 文本")
  断言相等(投影戊["消息表"][1]["角色"], "user", "1l 用户消息在后")

  # ================= §2 遮蔽跳过 =================
  # replace 语义：旧节点打遮蔽标记（会话.light 压缩替换），遮蔽节点不得进入投影
  设 原始件 为 造事件("user/message", 0, 100, ["消息": ["角色": "user", "content": [["type": "text", "text": "原始"]]]])
  设 压缩件 为 造事件("user/message", 1, 200, ["消息": ["角色": "user", "content": [["type": "text", "text": "压缩后"]]]])
  原始件["遮蔽"] 为 真
  设 表己 为 [原始件, 压缩件]
  设 投影己 为 投影表面消息(表己)
  断言相等(长度(投影己["节点表"]), 1, "2a 遮蔽节点不进节点表")
  断言相等(投影己["节点表"][0], 1, "2b 仅保留替换节点序号")
  断言相等(长度(投影己["消息表"]), 1, "2c 遮蔽节点不产消息")
  断言相等(投影己["消息表"][0]["content"][0]["text"], "压缩后", "2d 可见文本为替换节点")

  # 遮蔽的 system/message 不参与节点0（对齐 行为对照 2d 遮蔽后回退）
  设 旧系统件 为 系统件(0, "S1", "append")
  设 新系统件 为 系统件(1, "S2", "replace")
  旧系统件["遮蔽"] 为 真
  断言相等(投影节点0([旧系统件, 新系统件]), "S2", "2e 遮蔽系统节点跳过")

  # 空内容 assistant 节点：不产消息但保留表面位置；log-only 事件不进表面
  设 空助手件 为 造事件("assistant/message", 2, 300, ["消息": ["角色": "assistant", "content": []]])
  设 轮起件 为 造事件("turn/start", 3, 400, [])
  设 表庚 为 [压缩件, 空助手件, 轮起件]
  设 投影庚 为 投影表面消息(表庚)
  断言相等(长度(投影庚["节点表"]), 2, "2f 空内容节点保留、log-only 不进表面")
  断言相等(长度(投影庚["消息表"]), 1, "2g 空内容节点不产消息")
  断言相等(是表面事件(轮起件), 假, "2h turn/start 非表面事件")

  # ================= §3 投影节点消息（deriveEventMessage） =================
  断言相等(投影节点消息(用户件一)["content"][0]["text"], "你好", "3a user canonical 形状")
  设 用户运行件 为 造事件("user/message", 1, 2, ["角色": "user", "content": [["type": "text", "text": "直挂"]]])
  断言相等(投影节点消息(用户运行件)["content"][0]["text"], "直挂", "3b user 运行形状")

  设 流块表 为 []
  列表追加(流块表, ["type": "text", "text": "块B"])
  设 助手底 为 造事件("assistant/message", 2, 3, ["消息": ["角色": "assistant", "content": [["type": "text", "text": "块A"]]]])
  助手底["数据"]["流"] 为 流块表
  设 助手消息 为 投影节点消息(助手底)
  断言相等(长度(助手消息["content"]), 2, "3c 内嵌流并入 content")
  断言相等(助手消息["content"][1]["text"], "块B", "3d 流块内容")

  断言相等(投影节点消息(空助手件), 空, "3e 空内容助手 → 空")
  断言相等(投影节点消息(轮起件), 空, "3f log-only → 空")
  设 工具件 为 造事件("tool/result", 4, 5, ["调用": "c1", "成功": 真, "消息": ["角色": "tool", "content": [["type": "text", "text": "结果"]]]])
  断言相等(投影节点消息(工具件)["角色"], "tool", "3g tool/result 投影")

  断言相等(空内容判定(["content": []]), 空, "3h 空内容判定")
  断言相等(空内容判定(空), 空, "3i 非消息判定")

  # ================= §4 校验表面事件数据（V3 系统提示记录约束） =================
  # 4a 合法：头配置不含系统提示
  设 合法头 为 造事件("request/header", 0, 1, ["配置": ["model": "v41"], "代理预设": "default"])
  断言真(校验表面事件数据(合法头, "request/header at seq 0"), "4a 合法头通过")

  # 4b 系统提示不得留在请求头（V3 提升到 system/message 节点）
  设 文b 为 ""
  设 带提示头 为 造事件("request/header", 1, 2, ["配置": ["model": "v41"], "系统提示": "你是助手"])
  尝试:
    设 占b 为 校验表面事件数据(带提示头, "request/header at seq 1")
    抛出 新建 错误("反跑判据失败[4b]：应抛错却通过")
  捕获 异常 e1:
    设 文b 为 转字符串(e1)
  断言真(含子串(文b, "must omit header.system; use system/message"), "4b 系统提示必须用 system/message")

  # 4c header.system 同样拒绝
  设 文c 为 ""
  设 canonical头 为 造事件("request/header", 2, 3, ["header": ["system": "你是助手"]])
  尝试:
    设 占c 为 校验表面事件数据(canonical头, "request/header at seq 2")
    抛出 新建 错误("反跑判据失败[4c]：应抛错却通过")
  捕获 异常 e2:
    设 文c 为 转字符串(e2)
  断言真(含子串(文c, "must omit header.system"), "4c header.system 退役")

  # 4d header 非字典
  设 文d 为 ""
  设 坏头 为 造事件("request/header", 3, 4, ["header": "字符串"])
  尝试:
    设 占d 为 校验表面事件数据(坏头, "request/header at seq 3")
    抛出 新建 错误("反跑判据失败[4d]：应抛错却通过")
  捕获 异常 e3:
    设 文d 为 转字符串(e3)
  断言真(含子串(文d, "header must be an object"), "4d header 必须字典")

  # 4e 空 tools 必须省略
  设 文e 为 ""
  设 空工具头 为 造事件("request/header", 4, 5, ["header": ["tools": []]])
  尝试:
    设 占e 为 校验表面事件数据(空工具头, "request/header at seq 4")
    抛出 新建 错误("反跑判据失败[4e]：应抛错却通过")
  捕获 异常 e4:
    设 文e 为 转字符串(e4)
  断言真(含子串(文e, "must omit empty tools"), "4e 空 tools 拒绝")

  # 4f 空 adapterDefaults 必须省略
  设 文f 为 ""
  设 空缺省头 为 造事件("request/header", 5, 6, ["header": ["adapterDefaults": {}]])
  尝试:
    设 占f 为 校验表面事件数据(空缺省头, "request/header at seq 5")
    抛出 新建 错误("反跑判据失败[4f]：应抛错却通过")
  捕获 异常 e5:
    设 文f 为 转字符串(e5)
  断言真(含子串(文f, "must omit empty adapterDefaults"), "4f 空 adapterDefaults 拒绝")

  # 4g tool/result 失败元数据一致性：错误 键存在即校验 content[0].isError
  设 文g 为 ""
  设 坏结果 为 造事件("tool/result", 6, 7, ["调用": "c1", "成功": 假, "错误": ["名称": "E"],
    "消息": ["角色": "tool", "content": [["type": "tool-result", "isError": 假]]]])
  尝试:
    设 占g 为 校验表面事件数据(坏结果, "tool/result at seq 6")
    抛出 新建 错误("反跑判据失败[4g]：应抛错却通过")
  捕获 异常 e6:
    设 文g 为 转字符串(e6)
  断言真(含子串(文g, "error requires message content[0].isError === true"), "4g 失败结果须 isError 真")

  设 好结果 为 造事件("tool/result", 7, 8, ["调用": "c1", "成功": 假, "错误": ["名称": "E"],
    "消息": ["角色": "tool", "content": [["type": "tool-result", "isError": 真]]]])
  断言真(校验表面事件数据(好结果, "tool/result at seq 7"), "4h 一致失败结果通过")
  设 普通结果 为 造事件("tool/result", 8, 9, ["调用": "c1", "成功": 真])
  断言真(校验表面事件数据(普通结果, "tool/result at seq 8"), "4i 无错误键不做失败校验")

  # ================= §5 V3 记录形状 =================
  设 会话对象 为 新建会话("r47_surface", ".")
  设 追加记录 为 记录系统提示(会话对象, "你是助手", "append")
  断言相等(追加记录["数据"]["表面操作"], "append", "5a 记录 append 形状")
  断言相等(追加记录["数据"]["系统"], "你是助手", "5b 记录载荷键")
  设 替换记录 为 记录系统提示(会话对象, "重写", "replace")
  断言相等(替换记录["数据"]["表面操作"], "replace", "5c 记录 replace 形状")

  设 文j 为 ""
  尝试:
    设 占j 为 记录系统提示(会话对象, "X", "改写")
    抛出 新建 错误("反跑判据失败[5d]：应抛错却通过")
  捕获 异常 e7:
    设 文j 为 转字符串(e7)
  断言真(含子串(文j, "surfaceOp must be append or replace"), "5d 非法表面操作拒绝")

  设 文k 为 ""
  尝试:
    设 占k 为 记录系统提示(会话对象, "X", 真)
    抛出 新建 错误("反跑判据失败[5e]：应抛错却通过")
  捕获 异常 e8:
    设 文k 为 转字符串(e8)
  断言真(含子串(文k, "surfaceOp must be append or replace"), "5e 非字符串表面操作拒绝")

  # ================= §6 表面类型判定 =================
  断言真(表面可入类型("system/message"), "6a system 可入")
  断言真(表面可入类型("tool/result"), "6b tool/result 可入")
  断言相等(表面可入类型("assistant/attempt"), 假, "6c attempt 不可入")
  设 裸用户件 为 造事件("user/message", 0, 1, ["消息": []])
  断言相等(表面操作取值(裸用户件), "append", "6d 缺省 append")

  写 "test_R47_会话surface深化: 全部用例通过"
  返回 真

主程()