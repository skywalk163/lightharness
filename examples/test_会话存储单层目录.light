# test_会话存储单层目录.light —— 回归：新建会话落到「持久化根/sessions/」单层，
# 不出现 sessions/sessions 双层嵌套（用户问题 1 的入口接线 bug）。
# 运行：python 运行.py examples/test_会话存储单层目录.light
#
# 根因：会话存储.构造(根) 内部会自行拼一层 "sessions"。
# 入口若传「持久化根/sessions」，会落成「持久化根/sessions/sessions」，历史分裂。
# 本测试锁定正确契约：入口传「持久化根」，会话落在「持久化根/sessions」。

从 会话存储 导入 会话存储
从 文件系统 导入 路径连接, 目录存在, 创建目录, 删除目录, 删除文件, 文件存在, 文件列表
从 随机 导入 安全随机令牌
从 内置核心字符串 导入 截取
从 系统接口 导入 是目录

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 清空目录(目录):
  如果 目录存在(目录) == 假:
    返回
  遍历 名字 之 文件列表(目录):
    设 子 为 路径连接(目录, 名字)
    如果 是目录(子):
      清空目录(子)
    否则:
      删除文件(子)
  删除目录(目录)

段落 主:
  设 根 为 路径连接("/tmp", "lh_single_" + 截取(安全随机令牌(), 0, 8))
  创建目录(根)
  设 库 为 新建 会话存储(根)

  # 会话目录 = 根/sessions（单层）
  断言相等(库.取会话目录(), 路径连接(根, "sessions"), "1a 取会话目录单层")

  # 新建会话 → 索引与文件都落在根/sessions
  设 元 为 库.新建会话("单层验证")
  设 会话文件 为 路径连接(根, 路径连接("sessions", 元["id"] + ".jsonl"))
  断言相等(文件存在(会话文件), 真, "2a 会话文件落在根/sessions")
  # 不出现根/sessions/sessions
  断言相等(目录存在(路径连接(根, 路径连接("sessions", "sessions"))), 假, "3a 无双层嵌套")

  # 清理
  清空目录(根)
  打印 "test_会话存储单层目录 通过"

主()
