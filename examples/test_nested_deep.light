# test_nested_deep.light —— R70 任务C 嵌套段落深度加固验证
# 覆盖：≥3层嵌套段落 / 跨多层闭包捕获(读取+修改) / 闭包变量生命周期 /
#       递归嵌套 / 多层nonlocal交互 / 高阶函数返回嵌套段落 /
#       多嵌套段落共享外层变量 / 参数与外层变量同名(shadowing)

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 "断言失败(应为真): " + 标签

段落 主:
  # ============================================================
  # 1. 三层嵌套段落 + 跨多层闭包读取（最内层读取最外层变量）
  # ============================================================
  段落 外层A(a):
    段落 中层B(b):
      段落 内层C(c):
        返回 a + b + c  # 内层读取外层a和中层b
      返回 内层C
    返回 中层B
  设 三层闭包 为 外层A(1)(2)
  断言等于(三层闭包(3), 6, "三层嵌套-跨多层闭包读取")
  断言等于(外层A(10)(20)(30), 60, "三层嵌套-柯里化调用")

  # ============================================================
  # 2. 四层嵌套段落 + 最内层修改最外层变量（多层nonlocal链）
  # ============================================================
  段落 造四层计数器:
    设 计数 为 0
    段落 第一层:
      段落 第二层:
        段落 第三层:
          段落 第四层:
            外层 计数
            设 计数 为 计数 + 1
            返回 计数
          返回 第四层
        返回 第三层
      返回 第二层
    返回 第一层
  设 四层 为 造四层计数器()
  设 四次 为 四层()()()  # 拿到第四层函数
  断言等于(四次(), 1, "四层嵌套-最内层修改最外层(第1次)")
  断言等于(四次(), 2, "四层嵌套-最内层修改最外层(第2次)")
  断言等于(四次(), 3, "四层嵌套-最内层修改最外层(第3次)")

  # ============================================================
  # 3. 闭包变量生命周期 —— 外层函数返回后，闭包仍持有捕获变量
  # ============================================================
  段落 造累加器(初始值):
    设 总和 为 初始值
    段落 累加(数值):
      外层 总和
      设 总和 为 总和 + 数值
      返回 总和
    段落 取值:
      返回 总和
    返回 ["累加": 累加, "取值": 取值]
  设 累加器 为 造累加器(100)
  断言等于(累加器["取值"](), 100, "闭包生命周期-初始值")
  断言等于(累加器["累加"](50), 150, "闭包生命周期-累加后")
  断言等于(累加器["累加"](30), 180, "闭包生命周期-再次累加")
  # 验证：造累加器已返回，但闭包仍持有总和变量
  断言等于(累加器["取值"](), 180, "闭包生命周期-外层返回后仍持有状态")

  # 多个闭包实例互不干扰（各自独立的捕获变量）
  设 累加器A 为 造累加器(0)
  设 累加器B 为 造累加器(0)
  累加器A["累加"](10)
  累加器B["累加"](99)
  断言等于(累加器A["取值"](), 10, "闭包独立性-A实例")
  断言等于(累加器B["取值"](), 99, "闭包独立性-B实例")

  # ============================================================
  # 4. 递归嵌套 —— 嵌套段落中调用自身（递归阶乘）
  # ============================================================
  段落 造阶乘:
    段落 算阶乘(n):
      如果 n <= 1:
        返回 1
      设 递归结果 为 算阶乘(n - 1)  # 嵌套段落递归调用自身
      返回 n * 递归结果
    返回 算阶乘
  设 阶乘 为 造阶乘()
  断言等于(阶乘(1), 1, "递归嵌套-阶乘1")
  断言等于(阶乘(5), 120, "递归嵌套-阶乘5")
  断言等于(阶乘(10), 3628800, "递归嵌套-阶乘10")

  # ============================================================
  # 5. 递归嵌套 —— 嵌套段落调用外层段落（互递归/斐波那契）
  # ============================================================
  段落 造斐波那契:
    设 调用次数 为 0
    段落 算斐波那契(n):
      外层 调用次数
      设 调用次数 为 调用次数 + 1
      如果 n <= 1:
        返回 n
      设 前一项 为 算斐波那契(n - 1)
      设 前两项 为 算斐波那契(n - 2)
      返回 前一项 + 前两项  # 递归调用自身
    段落 取调用次数:
      返回 调用次数
    返回 ["斐波那契": 算斐波那契, "取调用次数": 取调用次数]
  设 斐波那契包 为 造斐波那契()
  断言等于(斐波那契包["斐波那契"](0), 0, "递归嵌套-斐波那契0")
  断言等于(斐波那契包["斐波那契"](1), 1, "递归嵌套-斐波那契1")
  断言等于(斐波那契包["斐波那契"](10), 55, "递归嵌套-斐波那契10")
  断言为真(斐波那契包["取调用次数"]() > 10, "递归嵌套-调用次数统计有效")

  # ============================================================
  # 6. 多层nonlocal交互 —— 中间层同时修改外层变量和被内层修改
  # ============================================================
  段落 造多层修改器:
    设 外层值 为 0
    段落 中间层:
      设 中间值 为 0
      段落 内层修改:
        外层 外层值, 中间值  # 同时声明两个nonlocal
        设 外层值 为 外层值 + 10
        设 中间值 为 中间值 + 5
        返回 [外层值, 中间值]
      返回 内层修改
    返回 中间层
  设 多层修改 为 造多层修改器()()
  断言等于(多层修改(), [10, 5], "多层nonlocal-同时修改两个外层变量(第1次)")
  断言等于(多层修改(), [20, 10], "多层nonlocal-同时修改两个外层变量(第2次)")

  # ============================================================
  # 7. 多个嵌套段落共享外层变量（读写同一闭包变量）
  # ============================================================
  段落 造银行账户(初始余额):
    设 余额 为 初始余额
    设 交易次数 为 0
    段落 存款(金额):
      外层 余额, 交易次数
      设 余额 为 余额 + 金额
      设 交易次数 为 交易次数 + 1
      返回 余额
    段落 取款(金额):
      外层 余额, 交易次数
      如果 金额 > 余额:
        返回 -1  # 余额不足
      设 余额 为 余额 - 金额
      设 交易次数 为 交易次数 + 1
      返回 余额
    段落 查询余额:
      返回 余额
    段落 查询交易次数:
      返回 交易次数
    返回 ["存款": 存款, "取款": 取款, "查询余额": 查询余额, "查询交易次数": 查询交易次数]
  设 账户 为 造银行账户(1000)
  断言等于(账户["查询余额"](), 1000, "共享闭包-初始余额")
  断言等于(账户["存款"](500), 1500, "共享闭包-存款后")
  断言等于(账户["取款"](200), 1300, "共享闭包-取款后")
  断言等于(账户["取款"](9999), -1, "共享闭包-余额不足返回-1")
  断言等于(账户["查询余额"](), 1300, "共享闭包-余额不足不改变余额")
  断言等于(账户["查询交易次数"](), 2, "共享闭包-交易次数统计(存款1+取款成功1, 余额不足不计)")

  # ============================================================
  # 8. 参数与外层变量同名（shadowing）—— 内层参数遮蔽外层变量
  # ============================================================
  段落 造遮蔽测试:
    设 x 为 "外层x"
    段落 内层(x):  # 参数x遮蔽外层x
      返回 x  # 应返回参数值，而非外层值
    段落 读取外层:
      返回 x  # 应返回外层值
    返回 ["内层": 内层, "读取外层": 读取外层]
  设 遮蔽测试 为 造遮蔽测试()
  断言等于(遮蔽测试["内层"]("参数x"), "参数x", "变量遮蔽-内层参数遮蔽外层")
  断言等于(遮蔽测试["读取外层"](), "外层x", "变量遮蔽-外层值不受影响")

  # ============================================================
  # 9. 嵌套段落作为返回值 + 高阶函数链（工厂模式）
  # ============================================================
  段落 造乘法器(倍数):
    段落 乘法(x):
      返回 x * 倍数
    返回 乘法
  设 乘3 为 造乘法器(3)
  设 乘7 为 造乘法器(7)
  断言等于(乘3(14), 42, "高阶函数-乘3器")
  断言等于(乘7(6), 42, "高阶函数-乘7器")
  断言等于(乘3(乘7(2)), 42, "高阶函数-链式调用")

  # ============================================================
  # 10. 深层嵌套（5层）+ 最内层读取所有外层参数
  # ============================================================
  段落 五层嵌套(a):
    段落 第二层(b):
      段落 第三层(c):
        段落 第四层(d):
          段落 第五层(e):
            返回 a + b + c + d + e
          返回 第五层
        返回 第四层
      返回 第三层
    返回 第二层
  断言等于(五层嵌套(1)(2)(3)(4)(5), 15, "五层嵌套-最内层读取所有外层参数")
  断言等于(五层嵌套(10)(20)(30)(40)(50), 150, "五层嵌套-大数值验证")

  打印 "--- R70任务C 嵌套段落深度加固 全部通过 (10组场景, 30+断言) ---"

主()
