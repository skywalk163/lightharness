# test_抓取_接线.light —— 第6轮 任务B #260 本地 HTTP(S) 抓取宿主出口 判据
# 运行：python 运行.py examples/test_抓取_接线.light
# 判据：接桩出口（抓取策略.宿主抓取出口 注入式 / 真实抓取提供.经宿主抓取 宿主桩）
#       在宿主桩 mock 下返回预期形状；公网目标拒绝不静默。
#       纯逻辑段回归绿由 test_抓取策略.light / test_R42_真实抓取.light 承担。

从 抓取策略 导入 宿主抓取出口, 校验抓取地址, 分类内容类型
从 真实抓取提供 导入 经宿主抓取, 允许抓取
从 宿主IO 导入 造宿主桩, 造成功结果, 造失败结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 抓取函数：注入 宿主抓取出口 的 抓取函数（真实层=真实HTTP客户端往返，此处=桩）
段落 mock抓取(网址):
  返回 [200, "text/html; charset=utf-8", "<html>你好</html>"]

# mock 宿主桩能力：真实抓取 -> [状态, 内容类型, 体]
段落 桩抓取(参数字典):
  返回 [200, "application/json", "{\"ok\": 真}"]

# mock 抓取函数：二进制体用例
段落 二进制抓取(网址):
  返回 [200, "image/png", "...."]

段落 主:
  # ---- 1. 抓取策略.宿主抓取出口：mock 抓取 + 允许抓取 注入 ----
  设 r1 为 宿主抓取出口(空, "http://127.0.0.1:8080/x", mock抓取, 允许抓取)
  断言真(r1["成功"], "1a 抓取出口成功")
  断言相等(r1["数据"]["状态"], 200, "1b 状态")
  断言相等(r1["数据"]["内容类型"], "text/html; charset=utf-8", "1c 内容类型")
  断言相等(r1["数据"]["分类"], "html", "1d 分类")
  断言相等(r1["数据"]["体"], "<html>你好</html>", "1e 体透传")
  断言相等(r1["元数据"]["主机"], "127.0.0.1", "1f 主机元数据")

  # ---- 2. 真实抓取提供.经宿主抓取：宿主桩能力转发 ----
  设 桩 为 造宿主桩({"真实抓取": 桩抓取})
  设 r2 为 经宿主抓取(桩, "http://localhost:3000/api")
  断言真(r2["成功"], "2a 经宿主抓取成功")
  断言相等(r2["数据"][0], 200, "2b 状态")
  断言相等(r2["数据"][1], "application/json", "2c 内容类型")
  断言相等(r2["数据"][2], "{\"ok\": 真}", "2d 体")
  断言相等(桩["调用日志"][0]["参数"]["主机"], "localhost", "2e 主机路由参数")
  断言相等(桩["调用日志"][0]["参数"]["端口"], 3000, "2f 显式端口")
  断言相等(桩["调用日志"][0]["参数"]["路径"], "/api", "2g 路径")

  # ---- 3. 公网 IP 目标 -> PERMISSION_DENIED（放行判定保留，不静默） ----
  设 桩3 为 造宿主桩({"真实抓取": 桩抓取})
  设 r3 为 经宿主抓取(桩3, "https://8.8.8.8/dns-query")
  断言真(是失败结果(r3), "3a 公网 IP 须失败")
  断言相等(r3["错误码"], "PERMISSION_DENIED", "3b 错误码")
  断言相等(列表长度(桩3["调用日志"]), 0, "3c 公网目标不留调用痕")

  # ---- 4. 公网域名 -> PERMISSION_DENIED ----
  设 r4 为 宿主抓取出口(空, "https://example.com/", mock抓取, 允许抓取)
  断言真(是失败结果(r4), "4a 公网域名须失败")
  断言相等(r4["错误码"], "PERMISSION_DENIED", "4b 错误码")

  # ---- 5. URL 非法 -> INVALID_ARGUMENT ----
  设 r5 为 经宿主抓取(造宿主桩({"真实抓取": 桩抓取}), "不是URL")
  断言真(是失败结果(r5), "5a 非法 URL 须失败")
  断言相等(r5["错误码"], "INVALID_ARGUMENT", "5b 错误码")

  # ---- 6. 凭据 URL -> INVALID_ARGUMENT（校验抓取地址 保留） ----
  设 r6 为 经宿主抓取(造宿主桩({"真实抓取": 桩抓取}), "http://user:pass@127.0.0.1/")
  断言真(是失败结果(r6), "6a 凭据 URL 须失败")

  # ---- 7. 宿主桩缺能力 -> UNSUPPORTED_OPERATION ----
  设 r7 为 经宿主抓取(造宿主桩({}), "http://127.0.0.1/x")
  断言真(是失败结果(r7), "7a 缺能力须失败")
  断言相等(r7["错误码"], "UNSUPPORTED_OPERATION", "7b 错误码")

  # ---- 8. 二进制体分类为空 ----
  设 r8 为 宿主抓取出口(空, "http://127.0.0.1/p.png", 二进制抓取, 允许抓取)
  断言相等(r8["数据"]["分类"], 空, "8a 二进制分类为空")

  打印 "--- 第6轮 任务B #260 抓取宿主出口 测试通过 ---"

主()