# test_预设挂载过滤.light —— 第103轮 任务线B：按预设组合过滤注册表条目（只挂载组合内的条目）
# 上游：packages/preset/agent-presets/src/mount.ts（挂载预设 = 按组合声明装配条目）
# 被测：src/预设挂载过滤.light
# 运行：cd lightharness && python 运行.py examples/test_预设挂载过滤.light
#
# 实测口径（2026-09-30，以 src/预设深化.light 的 展平行 真实行为为准）：
#   展平行 **不产出组行自身**（组行只递归），故「扁平 id 集」= 叶子行 id 集：
#     minimal 6（persona / pty / terminal-bash / persistent-bash / terminal-pwsh / persistent-pwsh，
#               组行 persistent-shell 不在集内）
#     standard 29、ptc 30、cordis 30（三个组行 planning / compaction / delegation 均不在集内）
#   对照：src/预设组合.light 的 组合统计（插件行 7 / 展平后 8）是**含组行与 preset-* 声明行**
#   的计数口径 —— 与本模块的「可挂载 id 数」不是同一口径，故本用例挂载数以 6 为上限，不凑 7/8。
#
# 求值能力口径（!!js 表达式的纯逻辑替身）：按平台判定
#   win32：「=== 'win32'」判真 → terminal-bash / persistent-bash 禁用（2）
#   linux：「!== 'win32'」判真 → terminal-pwsh / persistent-pwsh 禁用（2）
#   两者**对称**，故不存在「linux 全挂载」；真正的全挂载只在「没有表达式判真」时出现（恒假求值 → 6/0/0）。
#   题面写的「注入 linux → 全挂载」与上游 minimal.patch.yml 的语义不符（pwsh 系在非 win32 才启用），
#   本用例按实测写断言，差异见交付报告。
#
# 语言坑规避：诊断一律走 抛出 新建 错误（L-055/L-160：打印只吃字面量串或字符串变量）；
#   列表/字典字面量单行；`设 X 为` 的 为 前留空格（L-151）；模块级计数用字典承载（第34轮）。

从 预设挂载过滤 导入 按预设过滤, 过滤统计, 组合覆盖率, 挂扁平标识表, 挂启用表, 挂条目标识, 是禁用跳过
从 预设组合 导入 组合统计
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串包含
从 内置核心列表 导入 列表包含, 列表追加, 列表创建

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真，实际假")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 应抛错：返回异常消息串（未抛错则判失败）
段落 检查抛错(用例, 标签):
  设 消息 为 "未抛错"
  尝试:
    用例()
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
  如果 消息 == "未抛错":
    抛出 新建 错误("断言失败[" + 标签 + "]：应抛错未抛")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)
  返回 消息

# =====================================================================
# 求值能力（!!js 表达式的纯逻辑替身）
# =====================================================================
段落 平台判定(表达式, 平台):
  如果 字符串包含(表达式, "=== 'win32'") == 真:
    返回 平台 == "win32"
  如果 字符串包含(表达式, "!== 'win32'") == 真:
    返回 平台 != "win32"
  抛出 新建 错误("无法求值：" + 表达式)

段落 视窗求值(表达式):
  返回 平台判定(表达式, "win32")

段落 非视窗求值(表达式):
  返回 平台判定(表达式, "linux")

段落 恒假求值(表达式):
  返回 假

# =====================================================================
# 注册表条目表（minimal 组合扁平 id 全覆盖）
# =====================================================================
段落 造极简注册表():
  返回 [
    {"标识": "persona", "名称": "@deepseek-ai/dsh-persona"},
    {"标识": "pty", "名称": "@deepseek-ai/dsh-terminal"},
    {"标识": "terminal-bash", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-bash", "名称": "@deepseek-ai/dsh-tool-bash-persistent"},
    {"标识": "terminal-pwsh", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-pwsh", "名称": "@deepseek-ai/dsh-tool-pwsh-persistent"}]

段落 造带外条目注册表():
  返回 [
    {"标识": "persona", "名称": "@deepseek-ai/dsh-persona"},
    {"标识": "pty", "名称": "@deepseek-ai/dsh-terminal"},
    {"标识": "terminal-bash", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-bash", "名称": "@deepseek-ai/dsh-tool-bash-persistent"},
    {"标识": "terminal-pwsh", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-pwsh", "名称": "@deepseek-ai/dsh-tool-pwsh-persistent"},
    {"标识": "tool-web", "名称": "@deepseek-ai/dsh-tool-web"},
    {"标识": "tool-plugin-manager", "名称": "@deepseek-ai/dsh-plugin-manager/tools"}]

段落 造缺项注册表():
  返回 [
    {"标识": "persona", "名称": "@deepseek-ai/dsh-persona"},
    {"标识": "pty", "名称": "@deepseek-ai/dsh-terminal"},
    {"标识": "terminal-bash", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-bash", "名称": "@deepseek-ai/dsh-tool-bash-persistent"},
    {"标识": "terminal-pwsh", "名称": "@deepseek-ai/dsh-terminal-bash"}]

# 取挂载表的标识列表（便于顺序断言）
段落 取标识表(条目表):
  设 表 为 列表创建()
  遍历 条目 之 条目表:
    列表追加(表, 挂条目标识(条目))
  返回 表

# =====================================================================
# 主程
# =====================================================================
段落 主程():
  打印 "===== 第 103 轮任务线 B：按预设过滤注册表条目（只挂载组合内条目）====="

  # ---- §1 扁平 id 集：组行展开（组行自身不产出）----
  设 极简扁平 为 挂扁平标识表("minimal", 空)
  断言相等(长度(极简扁平), 6, "1a minimal 扁平 id 数（组行不计）")
  断言真(列表包含(极简扁平, "persona"), "1b 扁平集含 persona")
  断言真(列表包含(极简扁平, "terminal-bash"), "1c 扁平集含组内行 terminal-bash")
  断言真(列表包含(极简扁平, "persistent-shell") == 假, "1d 组行 persistent-shell 不在扁平集")
  断言相等(长度(挂扁平标识表("standard", 空)), 29, "1e standard 扁平 id 数")
  断言真(列表包含(挂扁平标识表("standard", 空), "planning") == 假, "1f standard 组行 planning 不在扁平集")
  断言相等(长度(挂扁平标识表("ptc", 空)), 30, "1g ptc 扁平 id 数")
  断言相等(长度(挂扁平标识表("cordis", 空)), 30, "1h cordis 扁平 id 数")
  断言相等(组合统计("minimal"), {"声明": 1, "插件行": 7, "展平后": 8}, "1i 对照：组合统计口径含组行与声明行")

  # ---- §2 恒假求值（无表达式判真）→ 组合内全挂载 ----
  设 极简表 为 造极简注册表()
  断言相等(组合覆盖率(极简表, "minimal"), 真, "2a minimal 全覆盖")
  设 统计0 为 过滤统计(极简表, "minimal", 恒假求值)
  断言相等(统计0, [6, 0, 0], "2b 恒假求值 挂载6/跳过0/禁用0")
  设 结果0 为 按预设过滤(极简表, "minimal", 恒假求值)
  断言相等(长度(结果0[0]), 6, "2c 挂载条目数")
  断言相等(长度(结果0[1]), 0, "2d 跳过条目数")
  断言相等(取标识表(结果0[0]), ["persona", "pty", "terminal-bash", "persistent-bash", "terminal-pwsh", "persistent-pwsh"], "2e 挂载保注册表顺序")
  断言相等(结果0[0][2]["名称"], "@deepseek-ai/dsh-terminal-bash", "2f 挂载表返回注册表条目原对象")

  # ---- §3 win32 求值能力：bash 系被禁用 ----
  设 统计1 为 过滤统计(极简表, "minimal", 视窗求值)
  断言相等(统计1, [4, 2, 2], "3a win32 挂载4/跳过2/禁用2")
  设 结果1 为 按预设过滤(极简表, "minimal", 视窗求值)
  断言相等(取标识表(结果1[0]), ["persona", "pty", "terminal-pwsh", "persistent-pwsh"], "3b win32 挂载 bash 系被剔除")
  断言相等(结果1[1][0]["标识"], "terminal-bash", "3c win32 首个跳过项 terminal-bash")
  断言相等(结果1[1][0]["原因"], "字面禁用", "3d win32 跳过原因 字面禁用")
  断言相等(结果1[1][1]["标识"], "persistent-bash", "3e win32 第二个跳过项 persistent-bash")
  断言相等(长度(结果1[0]), 4, "3f win32 挂载数")
  断言相等(组合覆盖率(极简表, "minimal"), 真, "3g 覆盖率与禁用无关")

  # ---- §4 linux 求值能力（实测：pwsh 系被禁用，与题面「全挂载」不符）----
  设 统计2 为 过滤统计(极简表, "minimal", 非视窗求值)
  断言相等(统计2, [4, 2, 2], "4a linux 挂载4/跳过2/禁用2（pwsh 系禁用）")
  设 结果2 为 按预设过滤(极简表, "minimal", 非视窗求值)
  断言相等(取标识表(结果2[0]), ["persona", "pty", "terminal-bash", "persistent-bash"], "4b linux 挂载 pwsh 系被剔除")
  断言相等(结果2[1][0]["标识"], "terminal-pwsh", "4c linux 首个跳过项 terminal-pwsh")
  断言相等(结果2[1][1]["标识"], "persistent-pwsh", "4d linux 第二个跳过项 persistent-pwsh")
  断言真(列表包含(取标识表(结果2[0]), "terminal-pwsh") == 假, "4e linux 挂载表不含 terminal-pwsh")

  # ---- §5 求值能力为空：!!js 无法求值 → conditional 记跳过 ----
  设 统计3 为 过滤统计(极简表, "minimal")
  断言相等(统计3, [2, 4, 4], "5a 空求值能力 挂载2/跳过4/禁用4")
  设 结果3 为 按预设过滤(极简表, "minimal")
  断言相等(取标识表(结果3[0]), ["persona", "pty"], "5b 空求值能力 仅字面未禁用者挂载")
  断言相等(结果3[1][0]["原因"], "条件禁用", "5c 空求值能力 跳过原因 条件禁用")
  断言相等(长度(结果3[1]), 4, "5d 空求值能力 四条件行全跳过")
  断言相等(是禁用跳过("条件禁用"), 真, "5e 条件禁用计入禁用跳过")
  断言相等(是禁用跳过("组合外"), 假, "5f 组合外不计入禁用跳过")

  # ---- §6 组合外条目 ----
  设 外表 为 造带外条目注册表()
  设 统计4 为 过滤统计(外表, "minimal", 恒假求值)
  断言相等(统计4, [6, 2, 0], "6a 组合外 挂载6/跳过2/禁用0")
  设 结果4 为 按预设过滤(外表, "minimal", 恒假求值)
  断言相等(结果4[1][0]["标识"], "tool-web", "6b 首个跳过项为组合外条目")
  断言相等(结果4[1][0]["原因"], "组合外", "6c 跳过原因 组合外")
  断言相等(结果4[1][1]["标识"], "tool-plugin-manager", "6d 第二个跳过项")
  断言相等(组合覆盖率(外表, "minimal"), 真, "6e 多余条目不影响覆盖率")
  设 缺表 为 造缺项注册表()
  断言相等(组合覆盖率(缺表, "minimal"), 假, "6f 缺 persistent-pwsh → 覆盖率假")
  设 统计5 为 过滤统计(缺表, "minimal", 恒假求值)
  断言相等(统计5, [5, 0, 0], "6g 缺项注册表 挂载5")

  # ---- §7 未知预设抛错 ----
  段落 用未知():
    按预设过滤(极简表, "zzz")
  段落 用未知统计():
    过滤统计(极简表, "zzz")
  段落 用未知覆盖():
    组合覆盖率(极简表, "zzz")
  段落 用空标识():
    按预设过滤(极简表, 空)
  段落 用非串标识():
    挂扁平标识表(7, 空)
  设 消息1 为 检查抛错(用未知, "7a")
  断言真(字符串包含(消息1, "not found"), "7b 未知预设消息含 not found")
  断言真(字符串包含(消息1, "zzz"), "7c 未知预设消息含标识")
  设 消息2 为 检查抛错(用未知统计, "7d")
  断言真(字符串包含(消息2, "not found"), "7e 过滤统计 未知预设抛错")
  设 消息3 为 检查抛错(用未知覆盖, "7f")
  断言真(字符串包含(消息3, "not found"), "7g 组合覆盖率 未知预设抛错")
  设 消息4 为 检查抛错(用空标识, "7h")
  断言真(字符串包含(消息4, "not found"), "7i 空预设标识抛错")
  设 消息5 为 检查抛错(用非串标识, "7j")
  断言真(字符串包含(消息5, "not found"), "7k 非串预设标识抛错")

  # ---- §8 条目标识归一化 ----
  断言相等(挂条目标识({"标识": "x"}), "x", "8a 条目标识 取 标识")
  断言相等(挂条目标识({"id": "y"}), "y", "8b 条目标识 回退 id")
  断言相等(挂条目标识({"标识": ""}), 空, "8c 条目标识 空串")
  断言相等(挂条目标识({}), 空, "8d 条目标识 缺失")
  断言相等(挂条目标识(7), 空, "8e 条目标识 非字典")
  设 启用表 为 挂启用表("minimal", 空)
  断言相等(启用表["persona"], 真, "8f 启用表 persona 启用")
  断言相等(启用表["terminal-bash"], "conditional", "8g 启用表 空求值能力 → conditional")

  打印 "test_预设挂载过滤 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试预设挂载过滤 通过 ---"
  返回 真

主程()
