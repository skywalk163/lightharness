# test_设置引导.light —— R108 任务线 C 判据（src/设置引导.light）
# 上游锚点：G:\github\deepseek-harness HEAD=e5b5ccbfcb（0.2.0-rc.1）
#   - SettingsRoot.tsx:133-143          判定逻辑（ready + blank + 按 order）
#   - DeepSeekOnboardingDialog.tsx:59-92 deepseek-official 从凭据就绪派生完成性
#   - ui-settings-models/index.ts:149-161 两步注册（order -100 / 0）
#   - locales.ts:228-237                文案逐字
# 运行：python 运行.py examples/test_设置引导.light
#
# 语言坑规避：断言诊断走 抛出 新建 错误（L-055/L-160）；列表/字典字面量先赋变量再作实参（L-047）；
#   「为」前留空格（L-151）；未知 id 抛错用例用 尝试/捕获 包裹。

从 设置引导 导入 引导版本, 引导步表, 当前步骤, 完成步骤, 渲染引导, 引导文案

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言假(条件, 标签):
  如果 条件 != 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望假值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §1 步表结构（2 步，order -100/0，字段齐全）
# =====================================================================
段落 用例_步表:
  设 表 为 引导步表()
  断言相等(长度(表), 2, "1a 步表共 2 步")
  断言相等(表[0]["id"], "welcome-notice", "1b 第 1 步 id")
  断言相等(表[0]["顺序"], -100, "1c 第 1 步 order=-100")
  断言相等(表[1]["id"], "deepseek-official", "1d 第 2 步 id")
  断言相等(表[1]["顺序"], 0, "1e 第 2 步 order=0")
  # 字段齐全
  遍历 步 之 表:
    断言真(字典包含键(步, "id"), "1f1 字段 id")
    断言真(字典包含键(步, "顺序"), "1f2 字段 顺序")
    断言真(字典包含键(步, "标题"), "1f3 字段 标题")
    断言真(字典包含键(步, "正文"), "1f4 字段 正文")
    断言真(字典包含键(步, "主按钮"), "1f5 字段 主按钮")
    断言真(字典包含键(步, "次按钮"), "1f6 字段 次按钮")
    断言真(字典包含键(步, "可跳过"), "1f7 字段 可跳过")
  # 可跳过：welcome-notice 不可跳过，deepseek-official 可跳过
  断言假(表[0]["可跳过"], "1g welcome-notice 不可跳过")
  断言真(表[1]["可跳过"], "1h deepseek-official 可跳过")

# =====================================================================
# §2 文案逐字（两段长正文逐字全等 + 按钮文案）
# =====================================================================
段落 用例_文案逐字:
  设 表 为 引导文案()
  断言相等(表["welcomeTitle"], "预览版说明", "2a welcomeTitle")
  断言相等(表["welcomeContinue"], "继续", "2b welcomeContinue")
  断言相等(表["welcomeError"], "暂时无法保存确认状态，请重试。", "2c welcomeError")
  断言相等(表["onboardingTitle"], "添加一个 API Key 开始使用", "2d onboardingTitle")
  断言相等(表["onboardingDescription"], "配置 DeepSeek 官方模型，即可开始使用。", "2e onboardingDescription")
  断言相等(表["onboardingLater"], "稍后配置", "2f onboardingLater")
  断言相等(表["onboardingSave"], "保存并继续", "2g onboardingSave")
  断言相等(表["onboardingSaving"], "保存中…", "2h onboardingSaving")
  断言相等(表["keyRequired"], "请输入 API 密钥后继续。", "2i keyRequired")
  # 两段长正文逐字全等（不是「包含」）
  设 期望body1 为 "DeepSeek Harness 目前的 0.2 版本仍处于预览阶段，还有许多地方需要持续改进和打磨，希望听取广大开发者和用户的反馈建议。现在，新的桌面端面向广泛用户，开发者相关的进阶功能可在配置中开启使用。预计 DeepSeek Harness 的产品功能以及插件 API 都会继续快速迭代、持续演化，并逐渐趋于稳定。"
  设 期望body2 为 "我们期待与全球用户和开发者一起，在开源、可复用、可组合的基础设施之上，共同探索智能上限。欢迎大家用 DeepSeek Harness 将想法变成现实，与社区一起丰富插件生态。"
  断言相等(表["welcomeBody1"], 期望body1, "2j welcomeBody1 逐字")
  断言相等(表["welcomeBody2"], 期望body2, "2k welcomeBody2 逐字")

# =====================================================================
# §3 当前步骤判定（核心逻辑 8 例）
# =====================================================================
段落 用例_当前步骤:
  # 3a 会话非空白 -> 空
  断言相等(当前步骤([], 假, 假), 空, "3a 会话非空白 -> 空")
  # 3b 空白且全部未完成 -> 首个（welcome-notice）
  断言相等(当前步骤([], 真, 假), "welcome-notice", "3b 空白未完成 -> welcome-notice")
  # 3c 已完成 welcome-notice，未完成 deepseek-official -> deepseek-official
  断言相等(当前步骤(["welcome-notice"], 真, 假), "deepseek-official", "3c 完成第1步 -> deepseek-official")
  # 3d 两步都完成 -> 空
  断言相等(当前步骤(["welcome-notice", "deepseek-official"], 真, 假), 空, "3d 两步都完成 -> 空")
  # 3e 凭据就绪 且 非显式 -> deepseek-official 视为已完成（跳过）
  断言相等(当前步骤(["welcome-notice"], 真, 真), 空, "3e 凭据就绪 -> 跳过 deepseek-official")
  # 3f 凭据就绪但会话非空白 -> 空
  断言相等(当前步骤(["welcome-notice"], 假, 真), 空, "3f 凭据就绪但非空白 -> 空")
  # 3g 显式请求 -> 忽略一切取该步（即使会话非空白）
  断言相等(当前步骤([], 假, 假, "deepseek-official"), "deepseek-official", "3g 显式请求忽略空白")
  # 3h 未知显式 id -> 抛错
  设 抛了 为 假
  尝试:
    当前步骤([], 真, 假, "unknown-step")
  捕获 错误:
    设 抛了 为 真
  断言真(抛了, "3h 未知显式 id 抛错")

# =====================================================================
# §4 完成步骤（不改入参 / 置键 / deepseek-official 原样）
# =====================================================================
段落 用例_完成步骤:
  # 4a welcome-notice 置键
  设 旧设置 为 {"其他键": "其他值"}
  设 新设置 为 完成步骤(旧设置, "welcome-notice")
  断言真(字典包含键(新设置, "引导_welcomeNoticeVersion"), "4a1 置键存在")
  断言相等(新设置["引导_welcomeNoticeVersion"], 引导版本(), "4a2 键值=版本号")
  # 4b 不改入参（旧设置无此键）
  断言假(字典包含键(旧设置, "引导_welcomeNoticeVersion"), "4b 入参未被改动")
  断言相等(旧设置["其他键"], "其他值", "4b2 入参其他键保留")
  # 4c deepseek-official 原样返回（无持久化键）
  设 旧设置2 为 {"其他键": "其他值2"}
  设 新设置2 为 完成步骤(旧设置2, "deepseek-official")
  断言相等(新设置2, 旧设置2, "4c deepseek-official 原样返回")
  # 4d 完成 welcome-notice 后，当前步骤推进到 deepseek-official
  设 完成集 为 []
  断言相等(当前步骤(完成集, 真, 假), "welcome-notice", "4d1 初始 welcome-notice")
  设 新设置3 为 完成步骤({}, "welcome-notice")
  设 新完成集 为 ["welcome-notice"]
  断言相等(当前步骤(新完成集, 真, 假), "deepseek-official", "4d2 完成后推进到 deepseek-official")

# =====================================================================
# §5 引导版本常量
# =====================================================================
段落 用例_版本:
  断言相等(引导版本(), "2026-09-28.1", "5a 版本常量")

# =====================================================================
# §6 渲染引导（整页形状）
# =====================================================================
段落 用例_渲染:
  设 页 为 渲染引导([], 真, 假)
  断言真(字典包含键(页, "步骤"), "6a1 字段 步骤")
  断言真(字典包含键(页, "当前步骤"), "6a2 字段 当前步骤")
  断言真(字典包含键(页, "自动"), "6a3 字段 自动")
  断言相等(长度(页["步骤"]), 2, "6b 步骤列表 2 步")
  断言相等(页["当前步骤"], "welcome-notice", "6c 当前步骤=welcome-notice")
  断言相等(页["自动"], 真, "6d 自动=真")

# =====================================================================
段落 主程():
  用例_步表()
  用例_文案逐字()
  用例_当前步骤()
  用例_完成步骤()
  用例_版本()
  用例_渲染()
  打印 "test_设置引导 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置引导 通过 ---"
  返回 真

主程()
