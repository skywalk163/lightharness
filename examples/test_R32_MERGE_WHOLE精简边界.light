# test_R32_MERGE_WHOLE精简边界.light —— R32 任务3/4 G2 编译门 + 边界形态自校验
#
# _P0A_MERGE_WHOLE 10 条逐条验证结论（G1 语料 856 文件 token 零变化 ∧ G3 边界门）：
#   · 移除 7 条：导出事件表 / 退出码 / 接收参数 / 外部命令 / 排序依据 / 输出块表 / 返回码
#     —— 整串语义由既有通用规则接住（设名预扫描 / 函数调用语境整串合并 /
#        成员访问规则），移除后边界形态 token 流与基线逐 token 一致；
#   · 保留 3 条（真护栏）：整理模型消息（传参位被 模 劈开）/ 非空块（函数名位
#     被 非 劈开）/ 记录类型（G1 打红 2 文件且函数名位被 类型 劈开，R30 新增）。
#
# 本文件在【移除前】与【移除后】都必须 rc=0（G2 编译门，两态各跑一次）。
# token 级证据：lightharness/_antirun_r32_t34_MERGE_WHOLE逐条验证.py
#
# 运行：cd lightharness && python 运行.py examples/test_R32_MERGE_WHOLE精简边界.light

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

# ---- 移除 7 条：段落名 + 传参调用位整词 ----
段落 退出码:
  返回 72
段落 接收参数:
  返回 73
段落 外部命令:
  返回 74
段落 输出块表:
  返回 76
段落 返回码:
  返回 77

# ---- 保留 3 条（真护栏）：同形态必须整词 ----
段落 整理模型消息:
  返回 81
段落 非空块:
  返回 82
段落 记录类型:
  返回 83

段落 主:
  # 移除条目：函数名 + 传参调用位整词（调用语境整串合并通用规则接住）
  断言相等(退出码(), 72, "退出码 函数名整词")
  断言相等(接收参数(), 73, "接收参数 函数名整词")
  断言相等(外部命令(), 74, "外部命令 函数名整词")
  断言相等(输出块表(), 76, "输出块表 函数名整词")
  断言相等(返回码(), 77, "返回码 函数名整词")

  # 移除条目：设名位整词（预扫描接住）
  设 导出事件表 为 5
  断言相等(导出事件表, 5, "导出事件表 设名位整词")
  设 排序依据 为 6
  断言相等(排序依据, 6, "排序依据 设名位整词")

  # 保留条目：MERGE_WHOLE 真护栏，整词语义必须保持
  断言相等(整理模型消息(), 81, "整理模型消息 函数名整词（保留）")
  断言相等(非空块(), 82, "非空块 函数名整词（保留）")
  断言相等(记录类型(), 83, "记录类型 函数名整词（保留）")

  打印 "--- test_R32 MERGE_WHOLE 精简边界 通过 ---"

主()
