# test_审批深化.light —— 审批 v2：记录查询 + 统计v2 + 批量策略 + 配置
从 审批 导入 审批管理器

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 审批 为 新建 审批管理器("approve")
  审批.设置策略("危险工具", "deny")
  审批.设置策略("需确认", "ask")

  # 生成审批记录
  审批.请求审批("安全工具", {})       # approve → 批准
  审批.请求审批("危险工具", {})       # deny → 拒绝
  审批.请求审批("需确认", {})         # ask → 待审批
  审批.请求审批("安全工具", {"x":1})  # approve → 批准
  审批.请求审批("危险工具", {"y":2})  # deny → 拒绝

  # ===== 记录查询 =====
  打印 "=== 记录查询测试 ==="

  # 按工具名过滤
  设 按工具 为 审批.查询记录("安全工具", "", 空, 空)
  断言等于(长度(按工具), 2, "安全工具2条")

  # 按状态过滤：批准
  设 批准记录 为 审批.查询记录("", "批准", 空, 空)
  断言等于(长度(批准记录), 2, "批准状态2条")

  # 按状态过滤：拒绝
  设 拒绝记录 为 审批.查询记录("", "拒绝", 空, 空)
  断言等于(长度(拒绝记录), 2, "拒绝状态2条")

  # 按状态过滤：待审批
  设 待审批记录 为 审批.查询记录("", "待审批", 空, 空)
  断言等于(长度(待审批记录), 1, "待审批状态1条")

  # 工具名+状态组合
  设 组合记录 为 审批.查询记录("危险工具", "拒绝", 空, 空)
  断言等于(长度(组合记录), 2, "危险工具+拒绝=2条")

  # 空条件不过滤（全部）
  设 全部记录 为 审批.查询记录("", "", 空, 空)
  断言等于(长度(全部记录), 5, "空条件=全部5条")

  # 记录含状态和时间字段
  断言等于(全部记录[0].包含("状态"), 真, "记录含状态字段")
  断言等于(全部记录[0].包含("时间"), 真, "记录含时间字段")

  打印 "  记录查询全部通过"

  # ===== 审批统计v2 =====
  打印 "=== 统计v2测试 ==="
  设 统计v2 为 审批.统计v2()
  断言等于(统计v2["总数"], 5, "总数=5")
  断言等于(统计v2["批准数"], 2, "批准数=2")
  断言等于(统计v2["拒绝数"], 2, "拒绝数=2")
  断言等于(统计v2["待审批数"], 1, "待审批数=1")

  打印 "  统计v2通过"

  # ===== 批量策略配置 =====
  打印 "=== 批量策略配置测试 ==="
  设 审批2 为 新建 审批管理器("deny")
  审批2.批量设置策略(["工具A": "approve", "工具B": "approve", "工具C": "deny"])
  断言等于(审批2.请求审批("工具A", {})["批准"], 真, "工具A被批量批准")
  断言等于(审批2.请求审批("工具B", {})["批准"], 真, "工具B被批量批准")
  断言等于(审批2.请求审批("工具C", {})["批准"], 假, "工具C被批量拒绝")
  断言等于(审批2.请求审批("未知工具", {})["批准"], 假, "未知工具走默认deny")

  打印 "  批量策略配置通过"

  # ===== 配置设置/读取 =====
  打印 "=== 配置测试 ==="
  审批2.设置配置(["默认审批人": "张三", "超时时间": 30, "自动批准列表": ["工具A", "工具B"]])
  设 配置 为 审批2.取配置()
  断言等于(配置["默认审批人"], "张三", "默认审批人")
  断言等于(配置["超时时间"], 30, "超时时间")
  断言等于(长度(配置["自动批准列表"]), 2, "自动批准列表2项")

  打印 "  配置通过"
  打印 "--- 审批深化测试通过 ---"

主()
