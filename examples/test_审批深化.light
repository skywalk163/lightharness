# test_审批深化.light —— 审批深化：记录查询 + 统计（已迁移到 E4 新契约）
# 旧版（策略/统计v2/批量策略/配置）接口已被 E4 权限与审批框架取代：
#   - 策略/批量策略 → src/权限.light 的权限预设与自定义表
#   - 查询记录/统计v2 → 审批.light 的 审批查询记录 / 审批统计
从 审批 导入 审批管理器, 审批统计, 审批查询记录

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 审批 为 新建 审批管理器()

  # 生成审批记录（直接请求 + 手工处理，模拟外部裁决）
  设 a1 为 审批.请求审批("s1", 1, "安全工具", {})
  审批.处理审批(a1, 真, "")            # 批准
  设 a2 为 审批.请求审批("s1", 2, "危险工具", {})
  审批.处理审批(a2, 假, "策略拒绝")     # 拒绝
  审批.请求审批("s1", 3, "需确认", {})  # 留在待审批
  设 a4 为 审批.请求审批("s1", 4, "安全工具", {"x": 1})
  审批.处理审批(a4, 真, "")            # 批准
  设 a5 为 审批.请求审批("s1", 5, "危险工具", {"y": 2})
  审批.处理审批(a5, 假, "策略拒绝")     # 拒绝

  # ===== 记录查询 =====
  打印 "=== 记录查询测试 ==="

  # 按工具名过滤
  设 按工具 为 审批查询记录(审批, "安全工具", "")
  断言等于(长度(按工具), 2, "安全工具2条")

  # 按状态过滤：批准
  设 批准记录 为 审批查询记录(审批, "", "已批准")
  断言等于(长度(批准记录), 2, "批准状态2条")

  # 按状态过滤：拒绝
  设 拒绝记录 为 审批查询记录(审批, "", "已拒绝")
  断言等于(长度(拒绝记录), 2, "拒绝状态2条")

  # 按状态过滤：待审批
  设 待审批记录 为 审批查询记录(审批, "", "待审批")
  断言等于(长度(待审批记录), 1, "待审批状态1条")

  # 工具名+状态组合
  设 组合记录 为 审批查询记录(审批, "危险工具", "已拒绝")
  断言等于(长度(组合记录), 2, "危险工具+拒绝=2条")

  # 空条件不过滤（全部）
  设 全部记录 为 审批查询记录(审批, "", "")
  断言等于(长度(全部记录), 5, "空条件=全部5条")

  # 记录含状态字段
  断言等于(全部记录[0].包含("状态"), 真, "记录含状态字段")

  打印 "  记录查询全部通过"

  # ===== 审批统计 =====
  打印 "=== 统计测试 ==="
  设 统计 为 审批统计(审批)
  断言等于(统计["总数"], 5, "总数=5")
  断言等于(统计["批准数"], 2, "批准数=2")
  断言等于(统计["拒绝数"], 2, "拒绝数=2")
  断言等于(统计["待审批数"], 1, "待审批数=1")

  打印 "  统计通过"
  打印 "--- 审批深化测试通过 ---"

主()
