# test_R25_词尾并入正向.light —— 第25轮 任务3：18 个「词尾并入」候选字的正向覆盖（运行期自校验）
#
# 任务书要求：17 类词尾并入场景每类至少 1 个用例（`配/段` 拆为 2 字，实验证 18 字）。
# 每类取 2 个真实感名字（属性名 / 类名 / 调用名 / 异常名 / 结构助词），覆盖：
#   · 单字词尾并入后整体成 IDENTIFIER；
#   · 该名字可作赋值目标、可作实参、可参与运算、可作列表元素。
# 全部 rc=0 自校验。

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


# ---- 一、逐字正向（18 字）----
设 标准输出 为 1
设 退出码输出 为 "exit"
断言相等(标准输出, 1, "出：标准输出")
断言相等(退出码输出, "exit", "出：退出码输出")

设 日期列 为 2
设 索引列 为 "idx"
断言相等(日期列, 2, "列：日期列")
断言相等(索引列, "idx", "列：索引列")

设 规则 为 3
设 正则 为 "^a+$"
断言相等(规则, 3, "则：规则")
断言相等(正则, "^a+$", "则：正则")

设 文件未找到 为 4
设 收到 为 "recv"
断言相等(文件未找到, 4, "到：文件未找到")
断言相等(收到, "recv", "到：收到")

设 首异常 为 5
设 常数 为 "const"
断言相等(首异常, 5, "常：首异常")
断言相等(常数, "const", "常：常数")

设 最后索引 为 6
设 引用 为 "ref"
断言相等(最后索引, 6, "引：最后索引")
断言相等(引用, "ref", "引：引用")

设 符号链接 为 7
设 连接 为 "link"
断言相等(符号链接, 7, "接：符号链接")
断言相等(连接, "link", "接：连接")

设 截断 为 8
设 中断 为 "irq"
断言相等(截断, 8, "断：截断")
断言相等(中断, "irq", "断：中断")

设 月末 为 9
设 末尾 为 "tail"
断言相等(月末, 9, "末：月末")
断言相等(末尾, "tail", "末：末尾")

设 成绩的长度 为 10
设 函数的参数 为 "args"
断言相等(成绩的长度, 10, "的：成绩的长度")
断言相等(函数的参数, "args", "的：函数的参数")

设 标准输出失真 为 11
设 全真 为 "alltrue"
断言相等(标准输出失真, 11, "真：标准输出失真")
断言相等(全真, "alltrue", "真：全真")

设 有界队列类 为 12
设 字典类 为 "dict"
断言相等(有界队列类, 12, "类：有界队列类")
断言相等(字典类, "dict", "类：字典类")

设 测试 为 13
设 测试用例 为 "case"
断言相等(测试, 13, "试：测试")
断言相等(测试用例, "case", "试：测试用例")

设 最后心跳跳过 为 14
设 跳过点 为 "skip"
断言相等(最后心跳跳过, 14, "跳：最后心跳跳过")
断言相等(跳过点, "skip", "跳：跳过点")

设 通过 为 15
设 过滤器 为 "filter"
断言相等(通过, 15, "过：通过")
断言相等(过滤器, "filter", "过：过滤器")

设 块长 为 16
设 长度 为 "len"
断言相等(块长, 16, "长：块长")
断言相等(长度, "len", "长：长度")

设 配置项 为 17
设 配额 为 "quota"
断言相等(配置项, 17, "配：配置项")
断言相等(配额, "quota", "配：配额")

设 代码段 为 18
设 阶段 为 "phase"
断言相等(代码段, 18, "段：代码段")
断言相等(阶段, "phase", "段：阶段")


# ---- 二、混合场景 ----
# 2.1 同一行多个词尾并入
设 结果 为 日期列 + 块长 + 最后索引
断言相等(结果, 2 + 16 + 6, "同行多个词尾并入")

# 2.2 嵌套：函数返回值赋给「类字尾」的变量
段落 取初始(值):
    返回 值
设 队列类 为 取初始(有界队列类)
断言相等(队列类, 12, "嵌套调用 + 类字尾变量名")

# 2.3 列表元素 / 实参位置
设 名表 为 [标准输出, 块长, 配置项]
断言相等(名表[0], 1, "词尾并入名字可作列表元素")
断言相等(转字符串(标准输出), "1", "词尾并入名字可作实参")

# 2.4 字典键（字符串键不受词法影响）
设 映射 为 {"输出列": 1, "块长": 2}
断言相等(映射["输出列"], 1, "字典键 输出列")
断言相等(映射["块长"], 2, "字典键 块长")

打印 "test_R25_词尾并入正向 全部通过"
