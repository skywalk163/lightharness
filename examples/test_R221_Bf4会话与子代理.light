# test_R221_Bf4会话与子代理.light —— R221-Bf4 判据（批量追加 / 上下文提醒 / 中断默认关）
# 运行：python 运行.py examples/test_R221_Bf4会话与子代理.light
# 上游：packages/session/session（Session.append 双重重载，dsh-v0.2.2-rc.3）
#       runtime-context 提醒（user/message source.kind='runtime-context'）
#       packages/bundle/web-app/presets/{standard,cordis,ptc}.patch.yml（interrupt: false）
# 指南：docs/upgrade-guide/v0.2.2-rc.1/{session-append-overloads,runtime-context-reminders,subagent-interrupt-default}
#
# 覆盖上游用例（逐条标注）：
#   [ap1] 数组追加返回数组、单事件追加返回单条（两种重载形状不同）
#   [ap2] 批内序号连续，且与逐条追加的结果等价
#   [ap3] 空数组 → 空数组、日志不变
#   [ap4] 任一条不合法 → 整批不落盘（不产生半批）
#   [ctx1] 首次/后续两种引导语不同；首份不宣称覆盖更早上下文
#   [ctx2] 正文包在 <system-reminder> 内；未知引导种类响亮报错
#   [ctx3] 清空标记 form=snapshot + sections 为空
#   [ctx4] 缺 source.sections 的旧 runtime-context 记录需要刷新一次；其他记录不需要
#   [sub1] 内置组合默认 interrupt=false（Team 同规则）；插件默认仍为 true
#   [sub2] 显式配置优先；省略落回插件默认真
#   [sub3] 不含中断时其余三个工具仍在
#
# 反跑判据（改反源码任一期望必须红）：
#   A. 预选中断默认 里内置组合返回 真                 -> sub1 用例红
#   B. 追加事件批 里「先全量校验再落盘」改成边验边写   -> ap4 用例红

从 会话 导入 新建会话
从 会话日志深化 导入 创建日志, 获取写锁, 追加事件, 追加事件批, 上下文提醒文本, 上下文清空标记, 上下文需刷新
从 子代理预设选择 导入 预选中断默认, 预选含中断工具, 预选工具名表

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含(文, 片段, 标签):
  如果 字符串包含(转字符串(文), 片段) == 假:
    抛出 新建 错误("断言含失败: " + 标签 + " 文=" + 转字符串(文))

段落 断言抛含(待测段落, 片段, 标签):
  设 已抛 为 假
  尝试:
    待测段落()
  捕获 异常 为 异常值:
    设 已抛 为 真
    如果 字符串包含(转字符串(异常值), 片段) == 假:
      抛出 新建 错误("断言抛含失败: " + 标签 + " 报文=" + 转字符串(异常值))
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛: " + 标签)

# ---------- 造事件数组 ----------

段落 造一批(时间):
  返回 [["turn/start", {"turn": 1}, 时间], ["user/message", {"content": [{"type": "text", "text": "hi"}]}, 时间 + 1]]

段落 造坏批(时间):
  返回 [["turn/start", {"turn": 1}, 时间], ["user/message", {"content": [{"type": "text", "text": "hi"}]}, "不是整数"]]

# 反跑包装：内含非法时间戳的批次
段落 跑坏批(日志, 时间):
  返回 追加事件批(日志, 造坏批(时间))

段落 主程():
  # ===== 一、会话 批量记录（ap1）=====

  # 1. 单事件仍返回单条（形状不因新增重载而变）
  设 会话甲 为 新建会话("s1", "/tmp/wd")
  设 单条 为 会话甲.记录事件("turn/start", {"turn": 1})
  断言真(是列表(单条) == 假, "ap-单事件返回非数组")
  断言相等(单条["序号"], 0, "ap-单事件序号0")

  # 2. 数组返回数组，长度与输入一致
  设 会话乙 为 新建会话("s2", "/tmp/wd")
  设 批 为 会话乙.记录事件批([["turn/start", {"turn": 1}], ["user/message", {"content": [{"type": "text", "text": "hi"}]}]])
  断言真(是列表(批), "ap-数组返回数组")
  断言相等(列表长度(批), 2, "ap-批量两条")

  # 3. 批内序号连续
  断言相等(批[0]["序号"], 0, "ap-批序号0")
  断言相等(批[1]["序号"], 1, "ap-批序号1")

  # ===== 二、日志层批量追加（ap2/ap3/ap4）=====

  # 4. 批内序号连续，且等于逐条追加的结果
  设 日志甲 为 创建日志("s-log", 3, 1000)
  设 批记录 为 追加事件批(日志甲, 造一批(100))
  断言相等(列表长度(批记录), 2, "ap-日志批两条")
  断言相等(批记录[0]["序号"], 0, "ap-日志批序号0")
  断言相等(批记录[1]["序号"], 1, "ap-日志批序号1")

  # 5. 与逐条追加等价（同类型/载荷/时间戳/序号）
  设 日志乙 为 创建日志("s-log", 3, 1000)
  设 逐条甲 为 追加事件(日志乙, "turn/start", {"turn": 1}, 100)
  设 逐条乙 为 追加事件(日志乙, "user/message", {"content": [{"type": "text", "text": "hi"}]}, 101)
  断言相等(批记录[0]["类型"], 逐条甲["类型"], "ap-等价类型0")
  断言相等(批记录[1]["类型"], 逐条乙["类型"], "ap-等价类型1")
  断言相等(批记录[1]["时间"], 逐条乙["时间"], "ap-等价时间1")
  断言相等(批记录[0]["序号"], 逐条甲["序号"], "ap-等价序号0")

  # 6. 空数组 → 空数组，日志末尾序号不变
  设 空批 为 追加事件批(日志甲, [])
  断言相等(空批, [], "ap-空批返回空")
  断言相等(日志甲["末尾序号"], 1, "ap-空批不改末尾")

  段落 跑坏批包装():
    返回 跑坏批(日志甲, 200)
  段落 非数组包装():
    返回 追加事件批(日志甲, "不是数组")
  段落 坏引导包装():
    返回 上下文提醒文本("点什么", "x")

  # 7. 任一条不合法 → 整批不落盘（ap4）
  设 前长 为 列表长度(日志甲["事件表"])
  断言抛含(跑坏批包装, "时间戳必须为安全整数", "ap-坏批报错")
  断言相等(列表长度(日志甲["事件表"]), 前长, "ap-坏批不落盘")

  # 8. 非数组入参 → 响亮报错
  断言抛含(非数组包装, "要求事件数组", "ap-非数组报错")

  # ===== 三、运行时上下文提醒（ctx1..ctx4）=====

  # 9. 首次与后续引导语不同，且首份不宣称覆盖
  设 首次文 为 上下文提醒文本("首次", "工作目录 /tmp/wd")
  设 后续文 为 上下文提醒文本("后续", "工作目录 /tmp/wd")
  断言真(首次文 != 后续文, "ctx-两种引导不同")
  断言含(首次文, "不覆盖更早的上下文", "ctx-首次不覆盖")
  断言含(后续文, "覆盖对话摘要里保留的旧上下文", "ctx-后续覆盖摘要")

  # 10. 正文被包在 system-reminder 内（首尾都在）
  断言含(首次文, "<system-reminder>", "ctx-开标签")
  断言含(首次文, "</system-reminder>", "ctx-闭标签")
  断言含(首次文, "工作目录 /tmp/wd", "ctx-正文在内")

  # 11. 未知引导种类 → 响亮报错
  断言抛含(坏引导包装, "未知的上下文引导种类", "ctx-未知种类报错")

  # 12. 清空标记形状
  设 标记 为 上下文清空标记()
  断言相等(标记["form"], "snapshot", "ctx-标记form")
  断言相等(标记["sections"], [], "ctx-标记空sections")

  # 13. 旧记录刷新判定（缺 sections 才要刷）
  断言真(上下文需刷新({"source": {"kind": "runtime-context"}}), "ctx-旧记录需刷新")
  断言真(上下文需刷新({"source": {"kind": "runtime-context", "sections": []}}) == 假, "ctx-已带sections不刷")
  断言真(上下文需刷新({"source": {"kind": "user"}}) == 假, "ctx-其他来源不刷")
  断言真(上下文需刷新({"类型": "x"}) == 假, "ctx-无source不刷")

  # ===== 四、子代理中断默认关（sub1..sub3）=====

  # 14. 内置组合默认关闭；独立组合/插件默认真（两个层次分开）
  断言相等(预选中断默认(真), 假, "sub-内置默认关")
  断言相等(预选中断默认(假), 真, "sub-插件默认真")

  # 15. 省略配置落回插件默认真；显式配置优先
  断言真(预选含中断工具({}), "sub-省略默认真")
  断言真(预选含中断工具({"中断": 真}), "sub-显式真")
  断言真(预选含中断工具({"中断": 假}) == 假, "sub-显式假")
  断言真(预选含中断工具(空), "sub-空配置默认真")

  # 16. 不含中断时其余三个工具仍在
  设 无中断 为 预选工具名表(假)
  断言相等(列表长度(无中断), 3, "sub-无中断三工具")
  断言相等(无中断[0], "send_message", "sub-首工具send_message")
  断言真(列表包含(无中断, "interrupt_agent") == 假, "sub-不含interrupt")

  # 17. 含中断时四个工具齐
  设 有中断 为 预选工具名表(真)
  断言相等(列表长度(有中断), 4, "sub-含中断四工具")
  断言相等(有中断[0], "interrupt_agent", "sub-首工具interrupt")

  写 "--- 测试 R221_Bf4会话与子代理 通过 ---"

主程()