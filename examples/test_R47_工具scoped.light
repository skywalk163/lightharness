# test_R47_工具scoped.light —— 第47轮 任务3（#8 scoped 可见性 + 指导过滤 + PTC 决策面）
#
# 运行：cd lightharness && python 运行.py examples/test_R47_工具scoped.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖（纯逻辑面，不接宿主权限总线）：
#   - 限制掩码：allow/deny 单条判定；空过滤器抛错；保留名 run_code 不可限制
#   - 限制链求交：任一层否决即不可见（上游 layers.every(admits)）
#   - 作用域可见视图：继承面过滤 + 自有注册遮蔽/不受限 + ptc/both 注入 run_code
#   - 呈现模式：作用域链就近胜出；全链未声明 → native
#   - 折叠判定：ptc + 非嵌套 + 非 run_code → 折叠；嵌套/native/both 不折叠
#   - 指导过滤：限制链放行包装 → 过滤可见指导 / 裁交叉推荐
#   - PTC 预决：allow/deny/ask 三种类；ask 经审批链收敛（无通道/allowed-once/denied/cancelled）
#   - 守卫否决单调性：守卫拒绝不可被放行翻案

从 工具 导入 代码运输名, 造限制, 限制放行单, 限制链放行, 作用域可见视图, 呈现模式判定, 折叠判定
从 工具 导入 过滤可见指导, 裁交叉推荐, 判定工具可见
从 工具执行 导入 决放行, 决拒绝, 决询问, 预决表, 批准放行, 批准拒绝, 批准取消, 审批结果表
从 工具执行 导入 具造预决, 具询问收敛, 具守卫裁决

段落 检相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检真 接收 条件, 标签:
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

段落 检抛错 接收 函数值, 标签:
  设 抛了 为 假
  尝试:
    函数值()
  捕获 异常 为 e:
    设 抛了 为 真
  检真(抛了, 标签)

段落 主:
  # ============ 0) 常量表形状 ============
  检相等(代码运输名, "run_code", "保留运输名")
  检相等(预决表, ["allow", "deny", "ask"], "预决三种类")
  检相等(审批结果表, ["allowed-once", "denied", "cancelled"], "审批结果表")

  # ============ 1) 限制掩码 ============
  # 1a. allow 白名单
  设 仅读 为 造限制(["read"], 空)
  检真(限制放行单(仅读, "read"), "限制_allow命中")
  检真(限制放行单(仅读, "write") == 假, "限制_allow未命中拒绝")
  # 1b. deny 黑名单
  设 禁写 为 造限制(空, ["write"])
  检真(限制放行单(禁写, "read"), "限制_deny未命中放行")
  检真(限制放行单(禁写, "write") == 假, "限制_deny命中拒绝")
  # 1c. 空过滤器抛错
  检抛错(空限制, "限制_空过滤器抛错")
  # 1d. 保留名 run_code 不可限制
  检抛错(限制run, "限制_保留名抛错")

  # ============ 2) 限制链求交 ============
  # 链 = [祖先层限制, 自身层限制]：每层都放行才可见
  设 链全过 为 [造限制(["read", "write", "grep"], 空), 造限制(空, ["edit"])]
  检真(限制链放行(链全过, "read"), "链求交_两层都过")
  检真(限制链放行(链全过, "edit") == 假, "链求交_自身层否决")
  # 祖先层 allow 未含 → 即使自身层无意见也拒
  设 链祖先拒 为 [造限制(["read"], 空), 造限制(空, ["write"])]
  检真(限制链放行(链祖先拒, "write") == 假, "链求交_祖先层allow未含")

  # ============ 3) 作用域可见视图 ============
  设 全局名单 为 ["read", "write", "edit", "grep"]
  # 3a. native + 无限制 → 继承面原样
  检相等(作用域可见视图(全局名单, [], [], "native"), ["read", "write", "edit", "grep"], "视图_native全继承")
  # 3b. 限制过滤继承面
  设 链1 为 [仅读]
  检相等(作用域可见视图(全局名单, 链1, [], "native"), ["read"], "视图_限制过滤继承")
  # 3c. 自有注册追加且不受限制约束（自有名不在祖先 allow 里也可见）
  检相等(作用域可见视图(全局名单, 链1, ["自有工具"], "native"), ["read", "自有工具"], "视图_自有不受限")
  # 3d. ptc 呈现注入 run_code（限制链不含它也可见）
  检相等(作用域可见视图(全局名单, 链1, [], "ptc"), ["read", "run_code"], "视图_ptc注入run_code")
  # 3e. both 呈现同样注入
  检真(列表包含(作用域可见视图(全局名单, [], [], "both"), "run_code"), "视图_both注入")

  # ============ 4) 呈现模式就近胜出 ============
  检相等(呈现模式判定(["ptc", "native"]), "ptc", "呈现_就近胜出")
  检相等(呈现模式判定([空, "both", "ptc"]), "both", "呈现_跳过空声明")
  检相等(呈现模式判定([空, 空]), "native", "呈现_全链未声明默认native")

  # ============ 5) 折叠判定 ============
  检真(折叠判定("read", "ptc", 假), "折叠_ptc直接派发read折叠")
  检真(折叠判定("run_code", "ptc", 假) == 假, "折叠_run_code不折叠")
  检真(折叠判定("read", "ptc", 真) == 假, "折叠_嵌套调用不折叠")
  检真(折叠判定("read", "native", 假) == 假, "折叠_native不折叠")
  检真(折叠判定("read", "both", 假) == 假, "折叠_both不折叠")

  # ============ 6) 指导过滤（限制链包装可见性） ============
  设 指导段表 为 [
    ["工具名": "read", "文本": "read 读文件。 Use edit on a matched file to change it."],
    ["工具名": "edit", "文本": "edit 编辑文件。"],
    ["工具名": "grep", "文本": "grep 搜索内容。 Use read on a matched file next."]]
  # 闭包包装：只放行 read/grep（edit 被限制）
  设 链2 为 [造限制(["read", "grep"], 空)]
  段落 可见判定 接收 名字:
    返回 限制链放行(链2, 名字)
  设 过滤后 为 过滤可见指导(指导段表, 可见判定)
  检相等(长度(过滤后), 2, "指导_限制过滤段数")
  检相等(过滤后[0]["工具名"], "read", "指导_保序read")
  检相等(过滤后[1]["工具名"], "grep", "指导_保序grep")
  # 交叉推荐句裁剪：read 段推荐 edit，edit 不可见 → 截断
  设 裁后 为 裁交叉推荐(过滤后[0]["文本"], " Use edit", "edit", 可见判定)
  检真(裁后.查找(" Use edit") < 0, "指导_交叉推荐被裁")
  设 未裁 为 裁交叉推荐(指导段表[2]["文本"], " Use read", "read", 可见判定)
  检相等(未裁, 指导段表[2]["文本"], "指导_目标可见原文保留")

  # ============ 7) PTC 预决确认决策面 ============
  # 7a. 造预决与形状
  设 允 为 具造预决(决放行)
  检相等(允["种类"], "allow", "预决_allow")
  设 拒 为 具造预决(决拒绝, "危险命令")
  检相等(拒["理由"], "危险命令", "预决_deny携带理由")
  设 问 为 具造预决(决询问, "需用户确认")
  检相等(问["种类"], "ask", "预决_ask")
  # 7b. 非 ask 原样收敛
  检相等(具询问收敛(允)["种类"], "allow", "收敛_allow原样")
  检相等(具询问收敛(拒)["种类"], "deny", "收敛_deny原样")
  # 7c. ask 收敛：无通道 → deny；allowed-once → allow；denied/cancelled/未知 → deny
  检相等(具询问收敛(问, 空, 假)["种类"], "deny", "收敛_ask无通道deny")
  检相等(具询问收敛(问, 批准放行, 真)["种类"], "allow", "收敛_allowed-once放行")
  检相等(具询问收敛(问, 批准拒绝, 真)["种类"], "deny", "收敛_denied拒绝")
  检相等(具询问收敛(问, 批准取消, 真)["种类"], "deny", "收敛_cancelled拒绝")
  检相等(具询问收敛(问, "其他", 真)["种类"], "deny", "收敛_未知结果拒绝")
  # 7d. allow 携带理由 → 抛错
  检抛错(allow理由, "预决_allow带理由抛错")

  # ============ 8) 守卫否决单调性 ============
  设 拒绝决 为 具造预决(决放行)
  设 裁1 为 具守卫裁决("审计冻结期禁写", 拒绝决)
  检相等(裁1["种类"], "deny", "守卫_否决翻案为deny")
  设 裁2 为 具守卫裁决(空, 允)
  检相等(裁2["种类"], "allow", "守卫_无否决原样")
  设 裁3 为 具守卫裁决(空, 问)
  检相等(裁3["种类"], "ask", "守卫_无否决ask透传")

  # ============ 9) 未知预决种类抛错 ============
  检抛错(坏种类, "预决_未知种类抛错")

  打印 "R47 工具scoped：限制掩码/链求交/作用域视图/呈现就近/折叠/指导过滤/PTC收敛 全部通过"

# 供 检抛错 使用的命名函数
段落 空限制:
  造限制(空, 空)
段落 限制run:
  造限制(["run_code"], 空)
段落 allow理由:
  具造预决(决放行, "不该有理由")
段落 坏种类:
  具造预决("maybe")

主()
