# test_R26_词首并入混合.light —— 第26轮 任务4：词首并入与关键字切分混合场景（运行期自校验）
#
# 任务书要求：同一文件内同时出现「CS 单字词首并入成标识符」与「关键字词首切分」，
#   验证两条路径互不干扰：
#     · 出错 成标识符 与 如果 切分为 KEYWORD 共存；
#     · 类型 成标识符 与 类 切分为 KEYWORD 共存；
#     · 设置 成标识符 与 设 切分为 KEYWORD 共存；
#     · 加法 成标识符 与 加 作运算符共存；
#     · 真的 成标识符 与 返回 切分为 KEYWORD 共存；
#     · 空格 成标识符 与 空 作值字面量共存。
# 全部 rc=0 自校验。

段落 断言相等 接收 实际, 期望, 标签:
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

# ---- 模块级类定义（类名/属性名走词首并入，类关键字本身切分）----
类 类别:
    属性 分类 等于 "子类型"

类 对象类:
    属性 姓名 等于 "张三"

# ---- 1. 出错（并入）与 如果（切分）----
段落 测试出错与如果 接收 出错:
    如果 出错 > 5:
        返回 出错
    否则:
        返回 0

设 出错 为 7
断言相等(测试出错与如果(出错), 7, "出错并入 + 如果切分")

# ---- 2. 类型（并入）与 类（切分）----
设 类型 为 "int"
断言相等(类型, "int", "类型并入 + 类切分（模块级类定义）")
设 类别实例 为 类别()
断言相等(类别实例.分类, "子类型", "类别并入作类名 + 分类并入作属性名")

# ---- 3. 设置（并入）与 设（切分）----
设 设置 为 真
设 X 为 设置
断言相等(设置, 真, "设置并入")
断言相等(X, 真, "设切分（赋值）")

# ---- 4. 加法（并入）与 加（运算符）----
设 加法 为 "运算"
设 加结果 为 1 加 2
断言相等(加法, "运算", "加法并入")
断言相等(加结果, 3, "加作运算符")

# ---- 5. 减法（并入）与 减（运算符）----
设 减法 为 "运算"
设 减结果 为 5 减 3
断言相等(减法, "运算", "减法并入")
断言相等(减结果, 2, "减作运算符")

# ---- 6. 真的（并入）与 返回（切分）----
段落 测试真的与返回:
    设 真的 为 真
    返回 真的

设 真的 为 真
断言相等(测试真的与返回(), 真, "真的并入 + 返回切分")

# ---- 7. 空格（并入）与 空（值字面量）----
段落 测试空格与空:
    设 空值 为 空
    设 空格 为 " "
    返回 空格

断言相等(测试空格与空(), " ", "空格并入 + 空作值字面量")

# ---- 8. 段落（切分）定义名含 CS 字（并入）----
段落 测试段落与段:
    段落 段落数:
        返回 3
    设 段数 为 段落数()
    返回 段数

断言相等(测试段落与段(), 3, "段落切分 + 段落数并入 + 段数并入")

# ---- 9. 对象（并入）与 点号成员访问，姓名（并入）----
设 对象 为 对象类()
断言相等(对象.姓名, "张三", "对象并入 + 点号成员访问 + 姓名并入")

# ---- 10. 对于（并入）与 对象（并入）同名域共存 ----
设 对于 为 "针对"
设 对象实例 为 "实例"
断言相等(对于, "针对", "对于并入")
断言相等(对象实例, "实例", "对象并入")

# ---- 11. 是否为（并入）与 是否（并入）----
设 是否为 为 真
设 是否 为 假
断言相等(是否为, 真, "是否为并入")
断言相等(是否, 假, "是否并入")

# ---- 12. 异常（并入）与 常数（并入）----
设 异常 为 "错误"
设 常数 为 3.14
断言相等(异常, "错误", "异常并入")
断言相等(常数, 3.14, "常数并入")

# ---- 13. 测试（并入）与 尝试（并入）与 尝试/捕获（切分）----
段落 测试名与尝试:
    设 测试次数 为 2
    设 尝试结果 为 "成功"
    尝试:
        返回 尝试结果
    捕获 异常 错误:
        返回 测试次数

断言相等(测试名与尝试(), "成功", "测试次数并入 + 尝试结果并入 + 尝试/捕获切分")

# ---- 14. 长名链式：CS 字 + 关键字 + CS 字 混合 ----
设 断言计数 为 1
设 计数器 为 断言计数
断言相等(计数器, 1, "断言/计数/相等 混合长名链")

# ---- 主入口 ----
段落 主:
    打印("词首并入混合场景测试全部通过（14 组并/切混合）")
    返回 真

主()
