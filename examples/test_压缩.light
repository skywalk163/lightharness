# test_压缩.light —— 上下文压缩策略测试（P1 v1）
# 反跑判据：把压缩后消息数断言 3 改成 2 即红。

从 压缩 导入 压缩到最近, 取消息文本
从 会话 导入 新建会话
从 消息 导入 造用户消息, 造助手消息, 造文本块, 造工具调用块, 造工具结果消息

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 会话对象 为 新建会话("压缩测试", 当前目录())

  # 用户提问1
  设 用户1 为 造用户消息([造文本块("今天天气如何")])
  会话对象.记录事件("user/message", 用户1)
  # 助手回答1
  设 助手1 为 造助手消息([造文本块("今天晴天")], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 助手1])
  # 工具调用 + 结果
  设 调用块 为 造工具调用块("bash", "echo hi", "abc")
  设 助手2 为 造助手消息([调用块], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 助手2])
  设 结果消息 为 造工具结果消息("abc", [造文本块("hi")], 假)
  会话对象.记录事件("tool/result", ["消息": 结果消息, "调用": 调用块, "成功": 真])
  # 用户提问2（保留对象）
  设 用户2 为 造用户消息([造文本块("明天呢")])
  会话对象.记录事件("user/message", 用户2)
  # 助手回答2（保留对象）
  设 助手3 为 造助手消息([造文本块("明天多云")], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 助手3])

  设 消息表 为 会话对象.整理消息()
  断言等于(长度(消息表), 6, "压缩前 6 条消息")

  # 压缩：保留最近 2 条表面消息
  设 压缩后 为 压缩到最近(会话对象, 2)
  断言等于(长度(压缩后), 3, "压缩后 3 条（摘要+保留2）")
  断言等于(压缩后[0]["content"][0]["text"].包含("压缩摘要"), 真, "第1条是压缩摘要")
  断言等于(取消息文本(压缩后[1]), "明天呢", "保留第1条是最后用户消息")

  打印 "test_压缩 PASS"

主()
