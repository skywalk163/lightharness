# R70 任务B 验收用例：async/await 协程语法（src 后端）
#
# 覆盖验收标准：
#   ① 异步段落定义（异步 段落）                → async def
#   ② 等待表达式（等待 X()）                    → await X()
#   ③ 顺序执行 + 异步睡眠（异步睡眠(秒)）         → asyncio.sleep
#   ④ 并发执行（并发等待 = asyncio.gather）      → 多个协程同时 await
#   ⑤ 异常传播（尝试 / 捕获 跨 await）           → 异常正常冒泡并被接住
#   ⑥ 计时区分「顺序」与「并发」（并发收益）
#   ⑦ 模块级 异步 段落 主 自动被事件循环驱动      → asyncio.run(主())
#
# 运行：python 运行.py examples/test_async_await.light
# 期望：全部断言通过，末行打印 "--- test_async_await 全部断言通过 ---"
#       （任一断言失败会以 抛出 终止，运行器返回非零退出码）

段落 断言相等 接收 实际, 期望, 标签:
    如果 实际 != 期望:
        抛出 "断言失败[" + 标签 + "]: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
    如果 条件 == 假:
        抛出 "断言失败[" + 标签 + "]: 条件应为真"

# ── 被测协程：异步睡眠后返回消息 ──
异步 段落 延迟 接收 消息, 秒:
    等待 异步睡眠(秒)
    返回 消息

# ── 入口：模块级 异步 段落 主 → asyncio.run(主()) 自动驱动 ──
异步 段落 主:
    # ① ② 异步段落 + 等待表达式 + 返回
    设 a 为 等待 延迟("甲", 0.1)
    设 b 为 等待 延迟("乙", 0.1)
    断言相等(a, "甲", "顺序等待-甲")
    断言相等(b, "乙", "顺序等待-乙")

    # ③ 异步睡眠 + 顺序计时（两段 sleep 依次执行，耗时≈两sleep之和）
    设 起点 为 时间戳()
    设 序甲 为 等待 延迟("x", 0.1)
    设 序乙 为 等待 延迟("y", 0.1)
    设 顺序耗时 为 时间戳() - 起点
    断言真(顺序耗时 >= 0.15, "顺序执行：耗时应≈两sleep之和(0.2s)，实测=" + 转字符串(顺序耗时))

    # ④ 并发执行（并发等待 = asyncio.gather），耗时≈单sleep（远小于之和）
    设 t1 为 延迟("p", 0.1)
    设 t2 为 延迟("q", 0.1)
    设 并发起点 为 时间戳()
    设 结果 为 等待 并发等待([t1, t2])
    设 并发耗时 为 时间戳() - 并发起点
    断言相等(结果, ["p", "q"], "并发等待-结果顺序")
    断言真(并发耗时 < 0.18, "并发执行：耗时应≈单sleep(0.1s)，实测=" + 转字符串(并发耗时))
    # 顺序明显长于并发（并发净收益应≥0.05s）
    断言真(顺序耗时 - 并发耗时 >= 0.05, "并发收益：顺序-并发应≥0.05s，实测=" + 转字符串(顺序耗时 - 并发耗时))

    # ⑤ 异常传播：异步内 抛出 经 await 冒泡，被 尝试/捕获 接住
    尝试:
        等待 抛出异步()
    捕获:
        打印("异常传播：已接住异步异常")

    打印("--- test_async_await 全部断言通过 ---")

# ── 在异步上下文内抛出的协程（用于验证跨 await 异常传播）──
异步 段落 抛出异步:
    抛出 "异步内异常"
