# R70 任务B 验收用例：async/await 协程语法（src 后端）
#
# 覆盖验收标准：
#   ① 异步段落定义（异步 段落）                → async def
#   ② 等待表达式（等待 X()）                    → await X()
#   ③ 顺序执行 + 异步睡眠（异步睡眠(秒)）         → asyncio.sleep
#   ④ 并发执行（并发等待 = asyncio.gather）      → 多个协程同时 await
#   ⑤ 异常传播（尝试 / 捕获 跨 await）           → 异常正常冒泡并被接住
#   ⑥ 计时区分「顺序」与「并发」（并发收益）
#   ⑦ 模块级 异步 段落 主 自动被事件循环驱动      → asyncio.run(主())
#
# 运行：python 运行.py examples/test_async_await.light
# 期望：全部断言通过，末行打印 "--- test_async_await 全部断言通过 ---"
#       （任一断言失败会以 抛出 终止，运行器返回非零退出码）

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 "断言失败[" + 标签 + "]: 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
    如果 条件 == 假:
        抛出 "断言失败[" + 标签 + "]: 条件应为真"

# ── 被测协程：异步睡眠后返回消息 ──
异步 段落 延迟(消息, 秒):
    等待 异步睡眠(秒)
    返回 消息

# ── 入口：模块级 异步 段落 主 → asyncio.run(主()) 自动驱动 ──
异步 段落 主:
    # ① ② 异步段落 + 等待表达式 + 返回
    设 a 为 等待 延迟("甲", 0.1)
    设 b 为 等待 延迟("乙", 0.1)
    断言相等(a, "甲", "顺序等待-甲")
    断言相等(b, "乙", "顺序等待-乙")

    # ③ 异步睡眠 + 顺序计时（两段 sleep 依次执行，耗时≈两sleep之和）
    设 起点 为 时间戳()
    设 序甲 为 等待 延迟("x", 0.1)
    设 序乙 为 等待 延迟("y", 0.1)
    设 顺序耗时 为 时间戳() - 起点
    # R74：此处原硬断言「顺序耗时 >= 0.15」会随机器/并发负载随机红
    # （本机隔离跑两次 sleep 实测 0.32s，xdist 并发下实测仅 0.14s；平台 asyncio.sleep(0.1)x2 基线 0.21s）。
    # 绝对墙钟下限不可靠，改为弱下限 0.08s —— 只防「sleep 被整体去掉」的退化（届时耗时≈0），
    # 「串行 vs 并发」的本质判据交给下面的并发收益相对断言。
    断言真(顺序耗时 >= 0.08, "顺序执行：应确实发生两段 sleep（弱下限 0.08s），实测=" + 转字符串(顺序耗时))

    # ④ 并发执行（并发等待 = asyncio.gather），耗时≈单sleep（远小于之和）
    设 t1 为 延迟("p", 0.1)
    设 t2 为 延迟("q", 0.1)
    设 并发起点 为 时间戳()
    设 结果 为 等待 并发等待([t1, t2])
    设 并发耗时 为 时间戳() - 并发起点
    断言相等(结果, ["p", "q"], "并发等待-结果顺序")
    # R86：绝对阈值 0.18 → 0.35（0.86 实机归因，证据见 R86 任务C 交付记录）：
    #   * gather 并发有效：0.86 单进程 15 次采样 conc=0.102~0.138s、seq=0.206~0.224s，收益稳定≈0.10s；
    #   * 8 进程 CPU 密集争抢下 conc 仍 ≤0.141s（asyncio.sleep 由内核定时器驱动，CPU 争抢影响极小）；
    #   * R85 全量偶发 0.26s>0.18s（0.86 xdist 4 worker 高负载调度抖动），R86 同环境全量复跑未复现。
    #   绝对阈值定位是「防并发整体退化为串行」（退化时 conc 稳定≈0.20s+，且收益≈0 会触发下方相对断言），
    #   0.35s 容纳抖动余量；串行退化的本质判据由下方「顺序-并发 ≥ 0.05s」相对断言兜底。
    断言真(并发耗时 < 0.35, "并发执行：耗时应≈单sleep(0.1s)，实测=" + 转字符串(并发耗时))
    # 顺序明显长于并发（并发净收益应≥0.05s）
    断言真(顺序耗时 - 并发耗时 >= 0.05, "并发收益：顺序-并发应≥0.05s，实测=" + 转字符串(顺序耗时 - 并发耗时))

    # ⑤ 异常传播：异步内 抛出 经 await 冒泡，被 尝试/捕获 接住
    尝试:
        等待 抛出异步()
    捕获:
        打印("异常传播：已接住异步异常")

    打印("--- test_async_await 全部断言通过 ---")

# ── 在异步上下文内抛出的协程（用于验证跨 await 异常传播）──
异步 段落 抛出异步:
    抛出 "异步内异常"
