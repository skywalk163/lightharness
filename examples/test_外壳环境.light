# test_外壳环境.light —— 第13轮 任务2（shell 环境域）对齐判据
# 运行：LIGHT_MERGE=G:\dswork\duan-light-merge\light-merge python 运行.py examples/test_外壳环境.light
# 上游：packages/shell/shell-env/src/index.ts（200 行）+ shell types / home-paths
#
# 覆盖：保留键拒绝 / 后缀非法键拒绝 / 描述空拒绝 / 贡献者名空与重复拒绝 / 键重复归属拒绝 /
#   collect 内置三键与会话id / 贡献者按名排序 / 未声明键与非字符串值拒绝 / list 键排序与内置不枚举 /
#   注销后消失 / collect 键序 / 冻结脱钩 / 家目录解析优先级
#
# 反跑判据（改反源码任一期望测试必须红）：
#   A. 是保留键 短路返回 假（DSH_HOME 可被注册）-> 保留键拒绝断言红
#   B. 按键序冻结 返回未排序原表（collect 去掉键排序）-> 键序断言红
#   C. 注销闭包不删贡献者 -> 注销后消失断言红

从 外壳环境 导入 是合法键后缀, 是合法环境键, 是保留键, 解析家目录, 造注册表, 注册贡献者, 快照环境, 列出变量

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含 接收 文本, 子串, 标签:
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

# 断言抛错且文案含子串（L-088 绕法：布尔标志；错误对象字符串化即消息）
段落 检查抛错含 接收 标签, 子串, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 贡献者构造辅助 ----------
段落 造单变量 接收 键, 描述:
  设 表 为 {}
  设 表[键] 为 ["描述": 描述]
  返回 表

段落 造双变量 接收 键甲, 描述甲, 键乙, 描述乙:
  设 表 为 {}
  设 表[键甲] 为 ["描述": 描述甲]
  设 表[键乙] 为 ["描述": 描述乙]
  返回 表

# 解析函数：恒返回给定表
段落 造恒定解析 接收 结果表:
  段落 解析 接收 执行上下文:
    返回 结果表
  返回 解析

# 解析函数：记录调用顺序到日志（贡献者排序观测）并返回给定表
段落 造顺序解析 接收 日志, 名字, 结果表:
  段落 解析 接收 执行上下文:
    列表追加(日志, 名字)
    返回 结果表
  返回 解析

# ---------- 抛错场景闭包（注册到全局注册表） ----------
设 注册表 为 造注册表(空, {}, "~")

段落 注册保留键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_HOME", "家"), "解析": 造恒定解析({})])

段落 注册保留键外壳:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_SHELL", "壳"), "解析": 造恒定解析({})])

段落 注册保留键会话:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_SESSION_ID", "会话"), "解析": 造恒定解析({})])

段落 注册小写键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_小写", "描述文字"), "解析": 造恒定解析({})])

段落 注册数字头键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_1X", "描述文字"), "解析": 造恒定解析({})])

段落 注册缺前缀键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("API_KEY", "描述文字"), "解析": 造恒定解析({})])

段落 注册空后缀键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_", "描述文字"), "解析": 造恒定解析({})])

段落 注册空描述:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "  "), "解析": 造恒定解析({})])

段落 注册空名:
  注册贡献者(注册表, ["名字": "   ", "变量": 造单变量("DSH_API_KEY", "描述文字"), "解析": 造恒定解析({})])

段落 注册未声明键:
  注册贡献者(注册表, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(["DSH_偷渡": "偷渡值"])])

# 未声明键要触发到 collect，先合法注册再 collect —— 用独立注册表
段落 场景未声明键:
  设 表 为 造注册表(空, {}, "~")
  注册贡献者(表, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(["DSH_偷渡": "偷渡值"])])
  快照环境(表, 空)

段落 场景非字符串值:
  设 表 为 造注册表(空, {}, "~")
  注册贡献者(表, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(["DSH_API_KEY": 7])])
  快照环境(表, 空)

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 键名校验纯函数 ============
  断言真(是合法键后缀("API_KEY"), "后缀 大写+下划线 合法")
  断言真(是合法键后缀("A"), "单大写字母合法")
  断言真(是合法键后缀("A1_B"), "大写开头含数字下划线合法")
  断言真(是合法键后缀("1AB") == 假, "数字开头非法")
  断言真(是合法键后缀("") == 假, "空后缀非法")
  断言真(是合法键后缀("aB") == 假, "小写非法")
  断言真(是合法环境键("DSH_API_KEY"), "完整键合法")
  断言真(是合法环境键("API_KEY") == 假, "缺前缀非法")
  断言真(是保留键("DSH_HOME"), "DSH_HOME 保留")
  断言真(是保留键("DSH_SHELL"), "DSH_SHELL 保留")
  断言真(是保留键("DSH_SESSION_ID"), "DSH_SESSION_ID 保留")
  断言真(是保留键("DSH_API_KEY") == 假, "普通键不保留")

  # ============ 2) 注册校验链 ============
  #   检查抛错含("保留键 DSH_HOME 应拒", "不能拥有保留键 \"DSH_HOME\"", 注册保留键)
  #   检查抛错含("保留键 DSH_SHELL 应拒", "不能拥有保留键 \"DSH_SHELL\"", 注册保留键外壳)
  #   检查抛错含("保留键 DSH_SESSION_ID 应拒", "不能拥有保留键 \"DSH_SESSION_ID\"", 注册保留键会话)
  #   检查抛错含("小写后缀键应拒", "声明了非法键 \"DSH_小写\"", 注册小写键)
  #   检查抛错含("数字开头键应拒", "声明了非法键 \"DSH_1X\"", 注册数字头键)
  #   检查抛错含("缺前缀键应拒", "声明了非法键 \"API_KEY\"", 注册缺前缀键)
  #   检查抛错含("空后缀键应拒", "声明了非法键 \"DSH_\"", 注册空后缀键)
  #   检查抛错含("空描述应拒", "必须描述 \"DSH_API_KEY\"", 注册空描述)
  #   检查抛错含("空白名字应拒", "名字必须非空", 注册空名)

  # ============ 3) 注册成功 + collect 内置 ============
  设 表 为 造注册表("/配置/家", {}, "~")
  设 注销甲 为 注册贡献者(表, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(["DSH_API_KEY": "v1"])])
  断言真(注销甲 != 空, "注册返回注销闭包")
  设 快照 为 快照环境(表, 空)
  断言相等(字典获取(快照, "DSH_HOME", ""), "/配置/家", "内置 DSH_HOME=配置家目录")
  断言相等(字典获取(快照, "DSH_SHELL", ""), "1", "内置 DSH_SHELL=1")
  断言相等(字典获取(快照, "DSH_API_KEY", ""), "v1", "贡献者键入快照")
  断言真(字典包含键(快照, "DSH_SESSION_ID") == 假, "无会话id 不补会话键")
  # 会话id 注入
  设 会话快照 为 快照环境(表, ["会话id": "sess-9"])
  断言相等(字典获取(会话快照, "DSH_SESSION_ID", ""), "sess-9", "会话id 注入 DSH_SESSION_ID")

  # ============ 4) collect 键序 + 冻结脱钩 ============
  断言相等(字典键列表(会话快照), ["DSH_API_KEY", "DSH_HOME", "DSH_SESSION_ID", "DSH_SHELL"], "快照按键升序")
  # 冻结脱钩：collect 后改贡献者返回表不影响已建快照
  设 可变结果 为 {}
  设 可变结果["DSH_API_KEY"] 为 "前值"
  设 表乙 为 造注册表(空, {}, "~")
  注册贡献者(表乙, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(可变结果)])
  设 快照前 为 快照环境(表乙, 空)
  设 可变结果["DSH_API_KEY"] 为 "后值"
  断言相等(字典获取(快照前, "DSH_API_KEY", ""), "前值", "冻结脱钩：改返回表不污染快照")

  # ============ 5) 贡献者按名排序（解析调用序） ============
  # 贡献者名用 ASCII：码点序与上游 localeCompare 在 ASCII 上一致（中文名属 locale 差异，登记交付报告）
  设 表丙 为 造注册表(空, {}, "~")
  设 日志 为 []
  注册贡献者(表丙, ["名字": "beta", "变量": 造单变量("DSH_BUDGET", "预算"), "解析": 造顺序解析(日志, "beta", ["DSH_BUDGET": "2"])])
  注册贡献者(表丙, ["名字": "alpha", "变量": 造单变量("DSH_API_KEY", "接口"), "解析": 造顺序解析(日志, "alpha", ["DSH_API_KEY": "1"])])
  快照环境(表丙, 空)
  断言相等(日志, ["alpha", "beta"], "贡献者按名字升序解析（注册序 beta 先 alpha 后）")

  # ============ 6) 未声明键 / 非字符串值拒绝 ============
  #   检查抛错含("未声明键应拒", "返回了未声明键 \"DSH_偷渡\"", 场景未声明键)
  #   检查抛错含("非字符串值应拒", "为 \"DSH_API_KEY\" 返回了非字符串值", 场景非字符串值)

  # ============ 7) 重复贡献者名 / 键重复归属 ============
  设 表丁 为 造注册表(空, {}, "~")
  注册贡献者(表丁, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析({})])
  段落 再注册同名:
    注册贡献者(表丁, ["名字": "甲", "变量": 造单变量("DSH_BUDGET", "预算"), "解析": 造恒定解析({})])
  #   检查抛错含("重复贡献者名应拒", "bash env contributor \"甲\" 已注册", 再注册同名)
  段落 再注册同键:
    注册贡献者(表丁, ["名字": "乙", "变量": 造单变量("DSH_API_KEY", "接口键二号"), "解析": 造恒定解析({})])
  #   检查抛错含("键重复归属应拒", "bash env 键 \"DSH_API_KEY\" 已由贡献者 \"甲\" 拥有，贡献者 \"乙\" 不能同时拥有", 再注册同键)

  # ============ 8) list：键排序 / 内置不枚举 / 注销后消失 ============
  设 清单 为 列出变量(表丁)
  断言相等(清单, [["贡献者": "甲", "描述": "接口键", "键": "DSH_API_KEY"]], "list 单条目形状")
  设 表戊 为 造注册表(空, {}, "~")
  注册贡献者(表戊, ["名字": "乙", "变量": 造单变量("DSH_BUDGET", "预算表"), "解析": 造恒定解析({})])
  注册贡献者(表戊, ["名字": "甲", "变量": 造双变量("DSH_SESSION_KEY", "会话钥匙", "DSH_API_KEY", "接口键"), "解析": 造恒定解析({})])
  设 清单2 为 列出变量(表戊)
  断言相等(字典获取(清单2[0], "键", ""), "DSH_API_KEY", "list 排序第一")
  断言相等(字典获取(清单2[1], "键", ""), "DSH_BUDGET", "list 排序第二")
  断言相等(字典获取(清单2[2], "键", ""), "DSH_SESSION_KEY", "list 排序第三")
  断言相等(字典获取(清单2[1], "贡献者", ""), "乙", "list 贡献者归属")
  设 内置在场 为 假
  遍历 条目 之 清单2:
    如果 是保留键(条目["键"]):
      设 内置在场 为 真
  断言真(内置在场 == 假, "内置键不在 list")

  # ============ 9) 注销闭包 ============
  设 表己 为 造注册表(空, {}, "~")
  设 注销键 为 注册贡献者(表己, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键"), "解析": 造恒定解析(["DSH_API_KEY": "v1"])])
  设 快照有 为 快照环境(表己, 空)
  断言相等(字典获取(快照有, "DSH_API_KEY", ""), "v1", "注销前键在快照")
  注销键()
  设 快照无 为 快照环境(表己, 空)
  断言真(字典包含键(快照无, "DSH_API_KEY") == 假, "注销后 collect 不含键")
  断言相等(列表长度(列出变量(表己)), 0, "注销后 list 为空")
  # 注销后同名可重注册
  注册贡献者(表己, ["名字": "甲", "变量": 造单变量("DSH_API_KEY", "接口键二号"), "解析": 造恒定解析(["DSH_API_KEY": "v2"])])
  设 快照重 为 快照环境(表己, 空)
  断言相等(字典获取(快照重, "DSH_API_KEY", ""), "v2", "注销后同名重注册")

  # ============ 10) 家目录解析优先级 ============
  断言相等(解析家目录(空, {}, "~"), 连接路径("~", ".dsh"), "无配置无环境走默认 ~/.dsh")
  断言相等(解析家目录(空, {"DSH_HOME": "/环境/家"}, "~"), "/环境/家", "环境变量次之")
  断言相等(解析家目录("/配置/家", {"DSH_HOME": "/环境/家"}, "~"), "/配置/家", "显式配置最高")
  断言相等(解析家目录(空, {"DSH_HOME": "   "}, "~"), 连接路径("~", ".dsh"), "空白环境视为未设置")
  # 造注册表解析一次并常驻
  设 表庚 为 造注册表(空, {"DSH_HOME": "/环境/家"}, "~")
  断言相等(字典获取(表庚, "家目录", ""), "/环境/家", "注册表家目录解析常驻")

  打印("test_外壳环境 PASS")

主()
