# test_快捷键.light —— R106 任务线 D 判据（src/快捷键.light）
# 上游锚点：G:\github\deepseek-harness HEAD=e5b5ccbfcb（0.2.0-rc.1）
#   - binding.ts:27-33/:49-51/:91-100  键位规范/排序/primary/web 允许集
#   - configuration.ts:96-113          校验与保留规则
#   - ui-shortcuts locales.ts/fixed.ts 文案逐字与 fixed 三件
# 运行：PYTHONUTF8=1 python 运行.py examples/test_快捷键.light
#
# 语言坑规避：断言诊断走 抛出 新建 错误（L-055/L-160）；列表/字典字面量先赋变量再作实参（L-047）；
#   「为」前留空格（L-151）；键位抛错用例用 尝试/捕获 包裹。

从 快捷键 导入 键位规范, 展示键串, 默认目录, 是保留组合, 校验键位, 查冲突
从 快捷键 导入 应用变更, 重置命令, 重置全部, 自定义计数, 快捷键文档, 解析键串, 冲突文案
从 快捷键 导入 文案不支持键, 文案保留, 文案需修饰键, 文案过多键, 文案不支持浏览器, 文案冲突
从 cli外壳 导入 斜杠命令表
从 文件系统 导入 路径连接

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言假(条件, 标签):
  如果 条件 != 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望假值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 取条目(目录, 条目id):
  遍历 条目 之 目录:
    如果 条目["id"] == 条目id:
      返回 条目
  返回 空

# =====================================================================
# §1 键位规范（7 例：Mac/非 Mac 同串不同解、排序、primary 去重、归一、双/三非修饰键抛错）
# =====================================================================
段落 用例_键位规范:
  # 1a/1b 同串不同解：Mod 在 macos→Meta、其它→Control（binding.ts:49-51）
  断言相等(键位规范("Mod+/", "other"), "control+Slash", "1a 非mac Mod 展开为 Control")
  断言相等(键位规范("Mod+/", "macos"), "meta+Slash", "1b mac Mod 展开为 Meta")
  # 1c 排序：control→alt→shift→meta（binding.ts:33）
  断言相等(键位规范("Alt+Shift+Ctrl+J", "other"), "control+alt+shift+KeyJ", "1c 修饰键固定排序")
  # 1d primary 去重：Mod+Ctrl（非 mac）→ 单个 Control
  断言相等(键位规范("Mod+Ctrl+J", "other"), "control+KeyJ", "1d primary 去重")
  # 1e 键名归一：单字母大写
  断言相等(键位规范("ctrl+k", "other"), "control+KeyK", "1e 单字母归一大写")
  # 1f 具名键
  断言相等(键位规范("Ctrl+Escape", "other"), "control+Escape", "1f 具名键 Escape")
  # 1g/1h 双/三非修饰键（Editor.tsx:114 字符串模型等价）
  断言相等(解析键串("Ctrl+J+K", "other")["错误"], 文案不支持键, "1g 双非修饰键 unsupported-key")
  断言相等(解析键串("Ctrl+J+K+L", "other")["错误"], 文案过多键, "1h 三非修饰键 too-many-keys")
  # 1g 抛错路径：键位规范 必须真抛
  设 抛了 为 假
  尝试:
    键位规范("Ctrl+J+K", "other")
  捕获 错误:
    设 抛了 为 真
  断言真(抛了, "1g2 双非修饰键真抛")
  # 1i 展示键串回显（Mod 形式：主修饰词回显 Mod，可与键串入参层互换）
  断言相等(展示键串("control+Slash", "other"), "Mod+/", "1i 展示回显 非mac 主修饰")
  断言相等(展示键串("meta+Slash", "macos"), "Mod+/", "1i2 展示回显 mac 主修饰")
  断言相等(展示键串("control+alt+KeyJ", "other"), "Mod+Alt+J", "1i3 非mac 非主修饰")
  断言相等(展示键串("control+meta+KeyP", "macos"), "Ctrl+Mod+P", "1i4 mac 双修饰排序回显")

# =====================================================================
# §2 默认目录（fixed 三项逐字 + 字段齐全 + 命令七件 + cli外壳 对账）
# =====================================================================
段落 用例_默认目录:
  设 目录 为 默认目录("other")
  断言相等(长度(目录), 10, "2a 目录共 10 行（fixed 3 + 命令 7）")
  # fixed 三件标签逐字（locales.ts:34）
  断言相等(取条目(目录, "fixed.move")["标签"], "移动菜单选择", "2b fixed.move 标签")
  断言相等(取条目(目录, "fixed.select")["标签"], "选择菜单项", "2c fixed.select 标签")
  断言相等(取条目(目录, "fixed.dismiss")["标签"], "关闭菜单或顶层弹窗", "2d fixed.dismiss 标签")
  # 默认键（fixed.ts rows）
  断言相等(取条目(目录, "fixed.move")["默认键"], "↑ / ↓", "2e move 默认键")
  断言相等(取条目(目录, "fixed.select")["默认键"], "Enter", "2f select 默认键")
  断言相等(取条目(目录, "fixed.dismiss")["默认键"], "Esc", "2g dismiss 默认键")
  # 分组（locales.ts:32）
  断言相等(取条目(目录, "fixed.move")["分组"], "菜单与弹层", "2h fixed 分组")
  断言相等(取条目(目录, "/help")["分组"], "应用操作", "2i 命令分组")
  # 字段齐全：六键（id/标签/分组/默认键/当前键/是否自定义）
  遍历 条目 之 目录:
    断言真(字典包含键(条目, "id"), "2j1 字段 id")
    断言真(字典包含键(条目, "标签"), "2j2 字段 标签")
    断言真(字典包含键(条目, "分组"), "2j3 字段 分组")
    断言真(字典包含键(条目, "默认键"), "2j4 字段 默认键")
    断言真(字典包含键(条目, "当前键"), "2j5 字段 当前键")
    断言真(字典包含键(条目, "是否自定义"), "2j6 字段 是否自定义")
  # fixed 键是裸键（会被校验拒），但目录照常收录——fixed 单列不受校验约束
  断言相等(取条目(目录, "fixed.move")["当前键"], "↑ / ↓", "2k fixed 当前键=默认键")
  # 命令行默认无键位（unbound 语义）
  断言相等(取条目(目录, "/help")["默认键"], "", "2l 命令默认键为空")
  # 与 cli外壳.斜杠命令表 对账：命令 id 集一致（防两处漂移）
  设 命令id表 为 []
  遍历 条目2 之 目录:
    如果 条目2["分组"] == "应用操作":
      列表追加(命令id表, 条目2["id"])
  设 外壳表 为 斜杠命令表()
  断言相等(长度(命令id表), 长度(字典键列表(外壳表)), "2m 命令数与 cli外壳 一致")
  遍历 外壳id 之 字典键列表(外壳表):
    断言真(列表包含(命令id表, 外壳id), "2n 命令id 对账 " + 外壳id)

# =====================================================================
# §3 校验键位（5 例：无修饰键 / 仅 Shift / 三修饰键合法 / 保留组合 / 合法 / 浏览器不允许）
# =====================================================================
段落 用例_校验键位:
  # 3a 无修饰键（configuration.ts:100）
  设 结果A 为 校验键位("KeyJ", "other", "web")
  断言相等(结果A["合法"], 假, "3a 无修饰键非法")
  断言相等(结果A["消息"], 文案需修饰键, "3a2 modifier-required 文案")
  # 3b 仅 Shift
  设 结果B 为 校验键位("Shift+KeyJ", "other", "web")
  断言相等(结果B["合法"], 假, "3b 仅 Shift 非法")
  断言相等(结果B["消息"], 文案需修饰键, "3b2 仅 Shift 文案")
  # 3c 三修饰键合法（configuration.ts:101，windows/macos）
  设 结果C 为 校验键位("control+alt+shift+KeyK", "windows", "web")
  断言相等(结果C["合法"], 真, "3c 三修饰键合法")
  # 3d 保留组合
  设 结果D 为 校验键位("control+KeyC", "other", "web")
  断言相等(结果D["合法"], 假, "3d 保留组合非法")
  断言相等(结果D["消息"], 文案保留, "3d2 reserved 文案")
  # 3e 合法：web 回退白名单（binding.ts:101-105 Slash+primary）
  设 结果E 为 校验键位("control+Slash", "other", "web")
  断言相等(结果E["合法"], 真, "3e Mod+/ 合法")
  # 3f linux web：Alt-only（无 primary 修饰键）→ unsupported-browser
  #   注：含 primary 的 Ctrl+字母 本仓 web 建模为放行（C 线 §C⑪ Mod+J 改键需要），
  #   故 unsupported-browser 用例改用 Alt-only，与「Alt+K 判 unsupported-browser」决策一致。
  设 结果F 为 校验键位("alt+KeyK", "other", "web")
  断言相等(结果F["合法"], 假, "3f linux web Alt-only 非法")
  断言相等(结果F["消息"], 文案不支持浏览器, "3f2 unsupported-browser 文案")

# =====================================================================
# §4 保留规则 4 例 + desktop 1 例
# =====================================================================
段落 用例_保留规则:
  # 4a Escape（configuration.ts:104 具名键表）
  断言真(是保留组合("Escape", "other", "web"), "4a Escape 保留")
  # 4b primary+C（:106）
  断言真(是保留组合("control+KeyC", "other", "web"), "4b 非 mac primary+C 保留")
  # 4c 非 mac 含 meta（:108）
  断言真(是保留组合("control+meta+KeyJ", "other", "web"), "4c 非 mac 含 meta 保留")
  # 4d mac control+meta（:109）
  断言真(是保留组合("control+meta+KeyP", "macos", "web"), "4d mac control+meta 保留")
  # 4e desktop 运行时一律不保留（任务书口径，文件头已登记与上游 :98 的差异）
  断言假(是保留组合("control+KeyC", "other", "desktop"), "4e desktop 不保留")

# =====================================================================
# §5 查冲突（3 例：无冲突 / 单冲突 / 自定义后冲突与清除后不冲突）
# =====================================================================
段落 用例_查冲突:
  设 目录 为 默认目录("other")
  # 5a 无冲突
  断言相等(长度(查冲突(目录, "/help", "control+alt+KeyJ", "other")), 0, "5a 无冲突")
  # 5b 单冲突：裸 Enter 撞 fixed.select
  设 冲突B 为 查冲突(目录, "/help", "Enter", "other")
  断言相等(长度(冲突B), 1, "5b 单冲突")
  断言相等(冲突B[0], "选择菜单项", "5b2 冲突标签")
  # 5c 自定义 /help 后占用该键；重置后让出
  设 变更结果 为 应用变更(目录, "/help", "Ctrl+Alt+J", "windows")
  设 目录2 为 变更结果[0]
  设 冲突C 为 查冲突(目录2, "/clear", "control+alt+KeyJ", "windows")
  断言相等(长度(冲突C), 1, "5c1 自定义后冲突")
  断言相等(冲突C[0], "显示可用命令与快捷键", "5c2 冲突标签为自定义命令")
  设 目录3 为 重置命令(目录2, "/help")
  断言相等(长度(查冲突(目录3, "/clear", "control+alt+KeyJ", "windows")), 0, "5c3 重置后不冲突")

# =====================================================================
# §6 应用变更（3 例：成功 / 非法 / 冲突；附 fixed 不可改）
# =====================================================================
段落 用例_应用变更:
  设 目录 为 默认目录("other")
  # 6a 成功
  设 好结果 为 应用变更(目录, "/help", "Ctrl+Alt+J", "windows")
  断言相等(好结果[1], "ok", "6a 成功状态")
  断言相等(好结果[2], "", "6a2 成功无消息")
  断言相等(取条目(好结果[0], "/help")["当前键"], "Mod+Alt+J", "6a3 当前键更新（Mod 形式回显）")
  断言相等(取条目(好结果[0], "/help")["是否自定义"], 真, "6a4 自定义标记")
  断言相等(自定义计数(好结果[0]), 1, "6a5 计数=1")
  # 6b 非法：裸键（无修饰键）→ 原目录 + modifier-required 文案
  设 坏结果 为 应用变更(目录, "/help", "J", "other")
  断言相等(坏结果[1], "错误", "6b 非法状态")
  断言相等(坏结果[2], 文案需修饰键, "6b2 非法文案")
  断言相等(自定义计数(坏结果[0]), 0, "6b3 原目录未被改动")
  # 6c 冲突：/clear 抢 /help 已占用的 Ctrl+Alt+J → conflict 文案
  # （fixed 裸键走不到冲突层：校验键位先拦，顺序与上游 configuration.ts 一致）
  设 占先 为 应用变更(目录, "/help", "Ctrl+Alt+J", "windows")
  设 撞结果 为 应用变更(占先[0], "/clear", "Ctrl+Alt+J", "windows")
  断言相等(撞结果[1], "错误", "6c 冲突状态")
  设 冲突期望 为 冲突文案(["显示可用命令与快捷键"])
  断言相等(撞结果[2], 冲突期望, "6c2 conflict 文案")
  # 6d fixed 行可改（C 线 §C⑪：POST fixed.move Mod+J → 200；fixed 走同一管线，默认裸键仅不被目录校验拒）
  设 固定结果 为 应用变更(目录, "fixed.move", "Mod+J", "other")
  断言相等(固定结果[1], "ok", "6d fixed.move 可改")
  断言相等(取条目(固定结果[0], "fixed.move")["当前键"], "Mod+J", "6d2 fixed.move 当前键（Mod 形式回显）")
  断言相等(取条目(固定结果[0], "fixed.move")["是否自定义"], 真, "6d3 fixed.move 自定义")

# =====================================================================
# §7 重置命令 / 重置全部 / 自定义计数（4 例）
# =====================================================================
段落 用例_重置与计数:
  设 目录 为 默认目录("other")
  断言相等(自定义计数(目录), 0, "7a 初始计数 0")
  设 结果1 为 应用变更(目录, "/help", "Ctrl+Alt+J", "windows")
  设 结果2 为 应用变更(结果1[0], "/model", "Ctrl+Alt+M", "windows")
  断言相等(自定义计数(结果2[0]), 2, "7b 两次变更计数 2")
  设 目录3 为 重置命令(结果2[0], "/help")
  断言相等(取条目(目录3, "/help")["当前键"], "", "7c 重置命令恢复默认键")
  断言相等(取条目(目录3, "/help")["是否自定义"], 假, "7c2 重置命令清除标记")
  断言相等(自定义计数(目录3), 1, "7c3 重置后计数 1")
  设 目录4 为 重置全部(结果2[0])
  断言相等(自定义计数(目录4), 0, "7d 重置全部计数 0")
  断言相等(取条目(目录4, "/model")["当前键"], "", "7d2 重置全部恢复默认")

# =====================================================================
# §8 快捷键文档路径（2 例：不存在 → 可用=假；临时落盘 → 可用=真）
# =====================================================================
段落 用例_文档路径:
  设 根 为 "G:/dswork/duan-light-merge/lightharness"
  设 文档1 为 快捷键文档(根)
  断言相等(文档1["路径"], 路径连接(根, "keybindings.json"), "8a 路径拼接")
  断言假(文档1["可用"], "8a2 仓根无 keybindings.json → 可用=假")
  设 临时根 为 创建临时目录("lh_sc_test")
  设 临时路径 为 路径连接(临时根, "keybindings.json")
  写入文件(临时路径, "{}")
  设 文档2 为 快捷键文档(临时根)
  断言真(文档2["可用"], "8b 落盘后可用=真")
  删目录树(临时根)

# =====================================================================
# §9 上游文案逐字比对（6 例，locales.ts:6-8/:11/:17）
# =====================================================================
段落 用例_文案逐字:
  断言相等(文案冲突, "已被「{{commands}}」占用", "9a conflict")
  断言相等(文案保留, "此组合由系统或文本编辑操作保留。", "9b reserved")
  断言相等(文案需修饰键, "请同时按下 Command、Ctrl 或 Alt 修饰键。", "9c modifier-required")
  断言相等(文案过多键, "最多同时按下两个非修饰键。请松开后重试。", "9d too-many-keys")
  断言相等(文案不支持键, "暂不支持这个按键。", "9e unsupported-key")
  断言相等(文案不支持浏览器, "此浏览器暂不支持该组合。", "9f unsupported-browser")

# =====================================================================
段落 主程():
  用例_键位规范()
  用例_默认目录()
  用例_校验键位()
  用例_保留规则()
  用例_查冲突()
  用例_应用变更()
  用例_重置与计数()
  用例_文档路径()
  用例_文案逐字()
  打印 "test_快捷键 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试快捷键 通过 ---"
  返回 真

主程()
