# test_R85_E_杂域_上下文.light —— R85 任务E 杂域-上下文域：0.1.6 session-reference 的 label/displayTitle
# 对应上游：packages/context/session-reference/src/{index,types}.ts
#   （projectedTitle → projectedLabels；候选新增 displayTitle；mention 取 displayTitle ?? label；
#     过滤条件并入 displayTitle）
# 注：agent-instructions 0.1.6 为纯改名（workspaceContext → agentInstructions，文案未变），
#     语义无变化，故本判据不覆盖，仅在甄别表登记。
从 会话引用深化 导入 会话引用标签, 提及用标签, 候选匹配查询

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件))

段落 主:
  # ---- label / displayTitle 推导 ----
  设 有标题 为 会话引用标签("标题甲", 空, "s1")
  断言相等(有标题["label"], "标题甲", "有标题取标题")
  断言相等(有标题["displayTitle"], "标题甲", "无子代理标题回落label")

  设 无标题 为 会话引用标签(空, 空, "s2")
  断言相等(无标题["label"], "s2", "无标题回落id")
  断言相等(无标题["displayTitle"], "s2", "无标题展示回落label")

  设 带子代理 为 会话引用标签("标题甲", ["label": "子代理X"], "s1")
  断言相等(带子代理["label"], "标题甲", "label仍取标题")
  断言相等(带子代理["displayTitle"], "子代理X", "子代理标签优先")

  设 子代理无名 为 会话引用标签("标题甲", ["label": 空], "s1")
  断言相等(子代理无名["displayTitle"], "标题甲", "子代理无名回落label")

  # ---- mention 取 displayTitle ?? label ----
  断言相等(提及用标签(["label": "L", "displayTitle": "D"]), "D", "提及用展示标题")
  断言相等(提及用标签(["label": "L"]), "L", "缺展示标题回落label")
  断言相等(提及用标签(["label": "L", "displayTitle": 空]), "L", "展示标题空回落label")

  # ---- 过滤：查询为空恒真；否则 id/cwd/label/displayTitle 不区分大小写包含 ----
  断言为真(候选匹配查询("", "s1", "工作目录", "标签", "展示") == 真, "空查询恒真")
  断言为真(候选匹配查询("S1", "s1", 空, "标签", "展示") == 真, "id不区分大小写")
  断言为真(候选匹配查询("目录", "s1", "工作目录", "标签", "展示") == 真, "cwd匹配")
  断言为真(候选匹配查询("标", "s1", 空, "标签", "展示") == 真, "label匹配")
  断言为真(候选匹配查询("展示", "s1", 空, "标签", "展示名") == 真, "displayTitle匹配")
  断言为真(候选匹配查询("zzz", "s1", "工作目录", "标签", "展示") == 假, "无匹配为假")
  断言为真(候选匹配查询("目录", "s1", 空, "标签", "展示") == 假, "cwd缺失不误命中")
