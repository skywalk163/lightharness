# test_R30_位运算符通用化_快速.light —— R30 任务1 快速验证
#
# 规则：词首前缀类 `_P0A_HEAD_MERGE_PREFIX = {位, 应, 除}`。
#   以「位」为词首、后随关键字的复合名（位+与 / 位+异或 / 位+或 / 位+非）
#   在调用语境 / 非语句起始位置**整串并入 IDENTIFIER**，不再被关键字「与/或/非」劈开。
#   （位/应 非关键字；除 被 DUAL 抑制后成标识符。见 lexer.py L2390。）
#
# 语义级判据：位与/位异或/位或/位非 是语言按位运算符（code_generator.py:263-268）。
#   若词法把复合名劈开成 位+与 等，则 `3 位与 1` 无法解析为位运算 ⇒ rc≠0 或结果错。
# 反向：位 独立作标识符不受影响；与/或/非/当 仍是各自的关键字。
#
# 运行：cd light-merge && python cli/light.py run ../lightharness/examples/test_R30_位运算符通用化_快速.light

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签

# 复合名作为函数名（词法若劈开成 位+与 则此定义处直接语法错误）
段落 位与(a, b):
  返回 a

段落 位异或(a, b):
  返回 b

段落 位或(a, b):
  返回 a + b

段落 主:
  # 反向：位 独立作标识符（位 非关键字）
  设 位 为 7
  断言相等(位, 7, "位 独立作标识符")

  # 正向 A：复合名整词成按位运算符（中缀 / 一元前缀）
  断言相等(3 位与 1, 1, "位与 整词成中缀运算符")
  断言相等(3 位异或 1, 2, "位异或 整词成中缀运算符")
  断言相等(3 位或 1, 3, "位或 整词成中缀运算符")
  断言相等(位非 3, 0 - 4, "位非 整词成一元前缀运算符")

  # 正向 B：调用语境整词成 IDENTIFIER（IDENTIFIER + '(' 走函数调用路径）
  断言相等(位与(1, 2), 1, "位与 调用语境整词成标识符")
  断言相等(位异或(1, 2), 2, "位异或 调用语境整词成标识符")
  断言相等(位或(1, 2), 3, "位或 调用语境整词成标识符")

  # 反向：与 / 或 / 非 仍是各自的关键字（逻辑用法不受影响）
  设 甲 为 真
  设 乙 为 假
  断言相等(甲 与 乙, 假, "与 仍为逻辑关键字")
  断言相等(甲 或 乙, 真, "或 仍为逻辑关键字")
  断言相等(非 假, 真, "非 仍为逻辑关键字")

  打印 "--- test_R30 位运算符通用化 通过 ---"

主()
