# test_会话持久化JSONL_接线.light —— 第6轮 任务E #279 会话持久化JSONL接线 判据
# 运行：python 运行.py examples/test_会话持久化JSONL_接线.light
# 判据：接线存储写会话（形状归一+全量写）→ 接线存储读会话（扫描日志）→ 接线存储追加事件；
#       纯逻辑回归绿由 test_会话持久化JSONL.light 承担。

从 会话持久化JSONL 导入 接线存储写会话, 接线存储读会话, 接线存储追加事件
从 会话存储 导入 会话存储
从 文件系统 导入 删除文件
导入 shutil

段落 清场(路径):
  尝试:
    shutil.rmtree(路径, 真)
  捕获 错误:
    设 占 为 真

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  清场("tmp_r6e_jsonl根")
  设 存储 为 新建 会话存储("tmp_r6e_jsonl根")
  设 头 为 {"type": "session", "version": {"major": 3, "minor": 0}, "id": "j1", "createdAt": 0, "cwd": "/w", "isSeeded": 假, "delegationDepth": 0}

  # ---- 1. 写会话：中文类型键自动归一（会话.light 事件直接可写） ----
  设 事件表 为 [{"类型": "user/message", "序号": 0, "时间": 0, "数据": {"文本": "第一"}},
    {"类型": "turn/end", "序号": 1, "时间": 1, "数据": {"原因": "completed"}}]
  设 写结果 为 接线存储写会话(存储, "j1", 头, 事件表, 0)
  断言相等(写结果["行数"], 3, "1a 头+2事件=3行")

  # ---- 2. 读会话：扫描日志 读回（闭环） ----
  设 读结果 为 接线存储读会话(存储, "j1")
  断言相等(读结果["事件数"], 2, "2a 读回两事件")
  断言相等(读结果["事件表"][0]["种类"], "user/message", "2b 事件种类")

  # ---- 3. 增量追加：追加一事件再读 ----
  设 追加表 为 [{"种类": "user/message", "序号": 3, "时间": 2, "数据": {"文本": "增量"}}]
  设 追加结果 为 接线存储追加事件(存储, "j1", 追加表, 2)
  断言相等(追加结果["追加行数"], 1, "3a 追加一行")
  设 读结果2 为 接线存储读会话(存储, "j1")
  断言相等(读结果2["事件数"], 3, "3b 共三事件")

  # ---- 4. 已有种类键直写（不双归一） ----
  设 写结果2 为 接线存储写会话(存储, "j2", 头, [{"种类": "user/message", "序号": 0, "时间": 0, "数据": {}}], 0)
  设 读结果3 为 接线存储读会话(存储, "j2")
  断言相等(读结果3["事件数"], 1, "4a 种类键直写")

  打印 "--- 第6轮 任务E #279 会话持久化JSONL接线 测试通过 ---"

主()