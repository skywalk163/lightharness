# test_推荐决策.light —— 0.2.2-rc.1 增量移植判据（B5：推荐决策与行动卡状态机）
# 运行：python 运行.py examples/test_推荐决策.light
# 上游：action-cards/src/{projection,index}.ts + plugin-recommendations/src/{index,skill}.ts
#       + creation-recommendations/src/{index,types}.ts + official-bundles/src/{bundles,plugin-manager}.ts
#       + plugin-detail/src/{document,files}.ts（锚点 66491b05e3）
#
# 反跑判据（改反源码任一期望必须红，见交付记录）：
#   A（值反）荐应用事件 里「旧卡标 replaced」的条件：字典包含键(旧决策, 旧号) == 假 → == 真
#              → 「新卡替换未开工旧卡」用例红
#   B（抛反）荐语言链 里首片长度上界 8 → 9 → 「../x 非法」与「zh-Hans-CN 切链」用例红
#
# 覆盖的上游用例（≥60%）：
#   projection.spec.ts  5/5：准入与忽略坏参数 / 一卡一轮 + replaced / 排队计数 / 继承前缀 / 待报水位 / 视图同一份
#   act.spec.ts        10/11：未知卡 / 未注册动词 / 非根 / 关闭中 / 访问与只读闸 / 忽略（含 kind 数据）/
#                            并发合并（本模块不建 Promise，只验 accepted 分支）/ 重复注册 / 对账先于动作 /
#                            对账失败 / record 合法性 / 种类退役后仍可忽略
#   tool.spec.ts        6/7：技能载入后声明 / 未知动作 / 空标题 / 细节非法 / 嵌套调用 / 一卡一轮 / 非根
#   recommendations     8/9：目录 eligible / describe available 与 refused / enable 三态 / 已开 / 错误码 /
#                            rejected / unconfirmed / 对账
#   creation.spec.ts    9/29：位置校验 / create 拒非法位置 / 在途取消 / installed 的 keep 与 undo /
#                            removed 的 restore / 恢复对账 installed / 恢复失败 unconfirmed / 忽略回落 / 收据字段
#   official-bundles    2/2：模板五条 / 离线目录五条不变量
#   document.spec.ts    5/5：语言链 / Markdown 去 BOM 与前置块 / meta.detail 合法与非法 / README 回落 /
#                            图片去向

从 推荐决策 导入 荐初始状态, 荐折叠, 荐应用事件, 荐读视图, 荐校验提议参数, 荐记录决策, 荐裁定忽略, 荐裁定动作, 荐提议准入, 荐插件可荐, 荐插件目录, 荐描述卡, 荐插件开启结果, 荐插件对账, 荐页面位置合法, 荐页面裁定, 荐页面恢复, 荐恢复失败, 荐页面忽略数据, 荐模板包, 荐重写安装模板, 荐剔除退役包, 荐目录条目问题, 荐语言链, 荐校验详情路径, 荐详情路径, 荐Markdown正文, 荐README名, 荐图片去向

# ---- 判据辅助（与 test_应用补丁.light 同款口径）----

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言假(条件, 标签):
  如果 条件 != 假:
    抛出 新建 错误("断言假失败: " + 标签)

# 抛错包装：光明不支持匿名「段落() 返回 …」，用具名段落承载
段落 抛语言链相对():
  荐语言链("../x")

段落 抛语言链空():
  荐语言链("")

段落 抛语言链短首片():
  荐语言链("a")

段落 抛语言链长首片():
  荐语言链("abcdefghi")

段落 抛语言链坏子片():
  荐语言链("zh-__")

段落 抛详情路径绝对():
  荐详情路径("/README.md", "meta.detail")

段落 抛详情路径上跳():
  荐详情路径("../x.md", "meta.detail")

段落 抛详情路径非MD():
  荐详情路径("README.txt", "meta.detail")

段落 断言抛含(待测段落, 片段, 标签):
  设 已抛 为 假
  尝试:
    待测段落()
  捕获 异常 为 异常值:
    设 已抛 为 真
    设 报文 为 转字符串(异常值)
    如果 字符串包含(报文, 片段) == 假:
      抛出 新建 错误("断言抛含失败: " + 标签 + " 报文=" + 报文)
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛: " + 标签)

# ---- 造事件（对齐 projection.spec.ts 的 turn/call/result/spliced/records 五个工厂）----

段落 造轮起(号, 轮值):
  返回 {"型": "轮起", "序号": 号, "轮": 轮值}

段落 造调用(号, 调用号, 参数文本, 轮值):
  返回 {"型": "工具调用", "序号": 号, "轮": 轮值, "调用号": 调用号, "工具名": "propose_action", "参数文本": 参数文本}

段落 造结果(号, 调用号, 是错):
  返回 {"型": "工具结果", "序号": 号, "调用号": 调用号, "错误": 是错}

段落 造记录(号, 调用号, 动作, 阶段, 数据=空):
  设 决策 为 {"callId": 调用号, "action": 动作, "phase": 阶段}
  如果 数据 != 空:
    设 决策["data"] 为 数据
  返回 {"型": "插件记录", "序号": 号, "数据": 决策}

段落 造收件(号, 插入, 移除, 目标):
  设 事件 为 {"型": "收件", "序号": 号, "目标": 目标, "插入": 插入}
  如果 移除 >= 0:
    设 事件["移除"] 为 移除
  返回 事件

段落 造用户消息(号, 来源, 水位):
  返回 {"型": "用户消息", "序号": 号, "来源": 来源, "水位": 水位}

# 一个合法提议的 JSON（details 里 value 是 string，与 fixture 一致）
设 参数甲 为 "{\"action\": \"test_action\", \"title\": \"Counter\", \"brief\": \"Keep count visible\", \"details\": {\"value\": \"a\"}}"

段落 主程():
  # ===== 一、action-cards projection.spec.ts：折叠 =====

  # 1. 成功的 propose_action 在它那一轮成为卡片；失败 / 坏 JSON / 坏参数 / 别的工具 / 无关结果都不产生卡片
  设 状一 为 荐初始状态()
  设 列一 为 [造轮起(0, 1), 造调用(1, "c1", 参数甲, 1), 造结果(2, "c1", 假)]
  设 果一 为 荐折叠(列一, 状一)
  设 提一 为 果一["视图"]["提议"]
  设 卡一 为 提一["c1"]
  断言相等(卡一["callId"], "c1", "1 卡 callId")
  断言相等(卡一["turn"], 1, "1 卡轮")
  断言相等(卡一["action"], "test_action", "1 卡动作")
  断言相等(卡一["title"], "Counter", "1 卡标题")
  断言相等(卡一["details"], {"value": "a"}, "1 卡细节")
  断言相等(果一["在途"], {}, "1 在途清空")

  设 列二 为 [造调用(0, "c2", 参数甲, 1), 造结果(1, "c2", 真)]
  设 果二 为 荐折叠(列二, 荐初始状态())
  断言相等(果二["视图"]["提议"], {}, "1 失败结果不成卡")
  设 列三 为 [造调用(0, "c3", "{broken", 1)]
  设 果三 为 荐折叠(列三, 荐初始状态())
  断言相等(果三["视图"]["提议"], {}, "1 坏 JSON 不成卡")
  设 列四 为 [造调用(0, "c4", "{\"action\": \"test_action\", \"title\": \" \", \"brief\": \"x\", \"details\": {}}", 1)]
  设 果四 为 荐折叠(列四, 荐初始状态())
  断言相等(果四["视图"]["提议"], {}, "1 空标题不成卡")
  设 列五 为 [造调用(0, "c5", "{\"action\": \"test_action\", \"title\": \"t\", \"brief\": \"b\", \"details\": \"text\"}", 1)]
  设 果五 为 荐折叠(列五, 荐初始状态())
  断言相等(果五["视图"]["提议"], {}, "1 非对象 details 不成卡")
  设 列六 为 [造调用(0, "c6", 参数甲, 1)]
  设 列六改 为 [造调用(0, "c6", 参数甲, 1)]
  # 换成别的工具名
  设 列六二 为 [{"型": "工具调用", "序号": 0, "轮": 1, "调用号": "c6", "工具名": "other_tool", "参数文本": 参数甲}]
  设 果六 为 荐折叠(列六二, 荐初始状态())
  断言相等(果六["视图"]["提议"], {}, "1 别的工具不成卡")

  # 2. 标题去首尾空白；未结算的调用留在「在途」，下一轮开头清空
  设 果七 为 荐折叠([造调用(0, "c7", "{\"action\": \"test_action\", \"title\": \"  Counter  \", \"brief\": \"b\", \"details\": {}}", 1), 造结果(1, "c7", 假)], 荐初始状态())
  设 卡七 为 果七["视图"]["提议"]["c7"]
  断言相等(卡七["title"], "Counter", "2 标题去空白")

  设 果八 为 荐折叠([造调用(0, "c8", 参数甲, 1)], 荐初始状态())
  断言相等(字典键列表(果八["在途"]), ["c8"], "2 未结算留在在途")
  设 果九 为 荐应用事件(果八, 造轮起(1, 2))
  断言相等(果九["在途"], {}, "2 下一轮清空在途")

  # 3. 一卡一轮：同轮的第二个成功调用不换卡，只清在途
  设 果十 为 荐折叠([造轮起(0, 1), 造调用(1, "a", 参数甲, 1), 造结果(2, "a", 假), 造调用(3, "b", 参数甲, 1), 造结果(4, "b", 假)], 荐初始状态())
  断言相等(字典键列表(果十["视图"]["提议"]), ["a"], "3 一卡一轮只留首卡")
  断言相等(果十["在途"], {}, "3 同轮第二卡清在途")

  # 4. 新轮的新卡把「未开工」旧卡标 replaced
  设 果十一 为 荐折叠([造轮起(0, 1), 造调用(1, "a", 参数甲, 1), 造结果(2, "a", 假), 造轮起(3, 2), 造调用(4, "c", 参数甲, 2), 造结果(5, "c", 假)], 荐初始状态())
  设 决十一 为 果十一["视图"]["决策"]
  断言相等(决十一["a"], {"callId": "a", "action": "test_action", "phase": "replaced"}, "4 旧卡被 replaced")
  断言相等(字典包含键(决十一, "c"), 假, "4 新卡无决策")

  # 5. 已开工（有决策）的旧卡不被 replaced —— 种类已经在做这件事了
  设 状开工 为 荐折叠([造记录(0, "a", "test_action", "creating")], 果十一)
  设 果十二 为 荐折叠([造轮起(1, 2), 造调用(2, "d", 参数甲, 2), 造结果(3, "d", 假)], 果十)
  设 决十二 为 果十二["视图"]["决策"]
  断言相等(决十二["a"]["phase"], "replaced", "5 未开工旧卡被替换")
  # 把旧卡先记成 creating，再出新卡：creating 保留
  设 果十三 为 荐折叠([造轮起(0, 1), 造调用(1, "a", 参数甲, 1), 造结果(2, "a", 假), 造记录(3, "a", "test_action", "creating"), 造轮起(4, 2), 造调用(5, "c", 参数甲, 2), 造结果(6, "c", 假)], 荐初始状态())
  断言相等(果十三["视图"]["决策"]["a"]["phase"], "creating", "5 开工旧卡不被替换")

  # 6. 替换跨种类：别的 action 的新卡也替换未开工旧卡
  设 参数乙 为 "{\"action\": \"other_action\", \"title\": \"Other\", \"brief\": \"b\", \"details\": {}}"
  设 果十四 为 荐折叠([造轮起(0, 1), 造调用(1, "a", 参数甲, 1), 造结果(2, "a", 假), 造轮起(3, 2), 造调用(4, "d", 参数乙, 2), 造结果(5, "d", 假)], 荐初始状态())
  断言相等(果十四["视图"]["决策"]["a"]["phase"], "replaced", "6 跨种类替换")

  # 7. 排队计数：只认 next-turn 目标，移除可回退，下限 0
  设 果十五 为 荐折叠([造收件(0, 1, -1, "next-step"), 造收件(1, 2, -1, "next-turn")], 荐初始状态())
  断言相等(果十五["排队"], 2, "7 只计 next-turn")
  设 果十六 为 荐折叠([造收件(0, 2, -1, "next-turn"), 造收件(1, 0, 2, "next-turn")], 荐初始状态())
  断言相等(果十六["排队"], 0, "7 移除回落")
  设 果十七 为 荐折叠([造收件(0, 0, 5, "next-turn")], 荐初始状态())
  断言相等(果十七["排队"], 0, "7 移除下限 0")

  # 8. 继承前缀：序号早于继承点的事件一律不动状态
  设 状继 为 荐初始状态(9)
  设 果十八 为 荐折叠([造轮起(0, 1), 造调用(1, "a", 参数甲, 1), 造结果(2, "a", 假)], 状继)
  断言相等(果十八, 状继, "8 继承前缀不产生卡")

  # 9. 待报水位：记录进待报，卡片自己的状态通知把 ≤ 水位的清掉；用户消息不清
  设 果十九 为 荐折叠([造记录(0, "a", "test_action", "creating"), 造记录(1, "b", "test_action", "dismissed")], 荐初始状态())
  断言相等(果十九["待报"], {"a": 0, "b": 1}, "9 决策进待报")
  设 果二十 为 荐应用事件(果十九, 造用户消息(9, "action-cards", 0))
  断言相等(果二十["待报"], {"b": 1}, "9 水位清 a")
  设 果二一 为 荐应用事件(果十九, 造用户消息(10, "user", 99))
  断言相等(果二一["待报"], {"a": 0, "b": 1}, "9 用户消息不清待报")

  # 10. 坏记录跳过（phase 空），后续读不受影响；视图就是 state 里那一份
  设 果二二 为 荐折叠([造记录(0, "a", "test_action", "")], 荐初始状态())
  断言相等(果二二["视图"]["决策"], {}, "10 坏记录跳过")
  设 果二三 为 荐折叠([造记录(0, "a", "test_action", "creating")], 荐初始状态())
  设 视二三 为 荐读视图(果二三)
  断言相等(视二三["决策"]["a"]["phase"], "creating", "10 视图即 state 视图")
  设 果二四 为 荐应用事件(果二三, 造收件(1, 1, -1, "next-turn"))
  设 视二四 为 荐读视图(果二四)
  断言相等(视二四["决策"]["a"]["phase"], "creating", "10 内部变化不换视图内容")

  # ===== 二、action-cards act.spec.ts：record / dismiss / perform =====

  # 11. record 只认已注册或曾注册动作；派生阶段不许记
  设 注一 为 荐记录决策(果二三, {"callId": "a", "action": "other_action", "phase": "done"}, ["test_action"], [])
  断言相等(注一["成"], 假, "11 未注册动作拒记")
  断言相等(注一["因"], "action-cards: cannot record a decision for unregistered action \"other_action\"", "11 未注册文案")
  设 注二 为 荐记录决策(果二三, {"callId": "a", "action": "test_action", "phase": "replaced"}, ["test_action"], [])
  断言相等(注二["成"], 假, "11 派生阶段拒记")
  断言相等(注二["因"], "action-cards: phase \"replaced\" is derived from the log and cannot be recorded", "11 派生文案")
  设 注三 为 荐记录决策(果二三, {"callId": "a", "action": "test_action", "phase": "interrupted"}, ["test_action"], ["test_action"])
  断言相等(注三["成"], 真, "11 退役种类仍可记")

  # 12. dismiss：未开工卡记 dismissed（带 kind 数据）；已记终态或非开出阶段则 settle 原决策
  设 提甲 为 {"callId": "call-1", "action": "test_action", "details": {"value": "a"}}
  设 忽一 为 荐裁定忽略(提甲, 空, ["failed"], {"value": "a", "choice": "later"})
  断言相等(忽一["状态"], "settled", "12 未开工忽略 settled")
  断言相等(忽一["决策"]["phase"], "dismissed", "12 忽略阶段")
  断言相等(忽一["决策"]["data"], {"value": "a", "choice": "later"}, "12 忽略带数据")
  设 忽二 为 荐裁定忽略(提甲, {"callId": "call-1", "action": "test_action", "phase": "dismissed"}, ["failed"], 空)
  断言相等(忽二["决策"]["phase"], "dismissed", "12 已终态 settle 原决策")
  设 忽三 为 荐裁定忽略(提甲, {"callId": "call-1", "action": "test_action", "phase": "running", "data": {"step": 1}}, ["failed"], 空)
  断言相等(忽三["决策"]["phase"], "running", "12 非开出阶段 settle 原决策")
  设 忽四 为 荐裁定忽略(提甲, {"callId": "call-1", "action": "test_action", "phase": "failed"}, ["failed"], {"value": "a"})
  断言相等(忽四["决策"]["phase"], "dismissed", "12 开出阶段可再忽略")
  设 忽五 为 荐裁定忽略(提甲, 空, [], 空)
  断言相等(忽五["决策"]["phase"], "dismissed", "12 无 kind 数据也记 dismissed")
  断言相等(字典包含键(忽五["决策"], "data"), 假, "12 无 kind 数据不带 data")

  # 13. perform：未注册 / 缺全局许可 / 终态 / 只读 四道闸
  设 执一 为 荐裁定动作(空, {"writes": 假}, {"已注册": 假})
  断言相等(执一["因"], "unavailable", "13 未注册 unavailable")
  设 执二 为 荐裁定动作(空, {"writes": 假}, {"全局许可": 假})
  断言相等(执二["因"], "access-denied", "13 缺全局许可")
  设 执三 为 荐裁定动作({"callId": "call-1", "action": "test_action", "phase": "dismissed"}, {"writes": 假}, {})
  断言相等(执三["状态"], "settled", "13 终态不再执行")
  设 执四 为 荐裁定动作(空, {"writes": 真}, {"只读": 真})
  断言相等(执四["因"], "read-only", "13 只读拒绝 writes 动词")
  设 执五 为 荐裁定动作(空, {"writes": 真}, {"只读": 假})
  断言相等(执五["状态"], "交种类处理", "13 可写则交种类")
  设 执六 为 荐裁定动作(空, {"writes": 假}, {"只读": 真})
  断言相等(执六["状态"], "交种类处理", "13 非 writes 动词不受只读限制")

  # ===== 三、action-cards tool.spec.ts：propose_action 准入八道闸 =====

  # 14. 每道闸的错误码与文案（逐条对齐上游 tool.spec.ts）
  设 基上 为 {"种类技能": {"test_action": "test-skill"}, "已注册动作表": ["test_action"], "本轮": 1,
