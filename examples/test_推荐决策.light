  # ===== 四、plugin-recommendations：目录 / describe / enable =====

  设 包甲 为 {"name": "official-search", "official": 真, "optional": 真, "availability": "installation", "enabled": 假, "meta": {"title": {"en": "Search", "zh": "搜索"}, "description": "Search past conversations."}}
  设 包禁 为 {"name": "custom", "official": 假, "optional": 真, "availability": "installation", "enabled": 假}
  设 包缺 为 {"name": "missing", "official": 真, "optional": 真, "availability": "missing", "enabled": 假}
  设 包非选 为 {"name": "on-demand", "official": 真, "optional": 假, "availability": "installation", "enabled": 假}
  设 包只读 为 {"name": "read-only", "official": 真, "optional": 真, "availability": "installation", "enabled": 假, "readOnlyReason": "management-required"}
  设 包错 为 {"name": "failed", "official": 真, "optional": 真, "availability": "installation", "enabled": 假, "error": {"code": "operation-error", "diagnostic": "load failed"}}
  设 包集 为 [包甲, 包禁, 包缺, 包非选, 包只读, 包错]

  # 15. eligible：official + optional + 可用 + 无只读理由 + 无 error
  断言相等(荐插件可荐(包甲), 真, "15 合格包")
  断言相等(荐插件可荐(包禁), 假, "15 非官方")
  断言相等(荐插件可荐(包缺), 假, "15 availability=missing")
  断言相等(荐插件可荐(包非选), 假, "15 非 optional")
  断言相等(荐插件可荐(包只读), 假, "15 只读理由")
  断言相等(荐插件可荐(包错), 假, "15 error")
  设 包无元 为 {"name": "bare", "official": 真, "optional": 真, "availability": "installation", "enabled": 真}
  断言相等(荐插件可荐(包无元), 真, "15 无 meta 也合格")

  # 16. 目录：只列合格项；title/description 逐级回落
  设 目一 为 荐插件目录(包集)
  断言相等(列表长度(目一), 1, "16 目录只列合格项")
  设 目首 为 列表获取(目一, 0)
  断言相等(目首["name"], "official-search", "16 目录名")
  断言相等(目首["title"], {"en": "Search", "zh": "搜索"}, "16 目录标题取 meta.title")
  断言相等(目首["description"], "Search past conversations.", "16 目录描述取 meta.description")
  断言相等(目首["enabled"], 假, "16 目录启用态")
  设 包述 为 {"name": "described", "official": 真, "optional": 真, "availability": "installation", "enabled": 假, "description": "History search"}
  设 目二 为 荐插件目录([包述, 包无元])
  设 目二首 为 列表获取(目二, 0)
  断言相等(目二首["title"], "described", "16 无 meta 标题回落到包名")
  断言相等(目二首["description"], "History search", "16 无 meta 描述回落到包 description")
  设 目二末 为 列表获取(目二, 1)
  断言相等(目二末["title"], "bare", "16 两者都无标题用包名")
  断言相等(目二末["description"], "", "16 两者都无描述用空串")

  # 17. describe：unknown / unavailable / not-live-root / closing / available
  设 提卡 为 {"callId": "call-plugin-1", "action": "enable_official_plugin", "details": {"name": "official-search"}}
  设 描一 为 荐描述卡(提卡, [包甲])
  断言相等(描一["状态"], "available", "17 可用卡")
