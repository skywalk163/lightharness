  设 提页 为 {"callId": "call-page", "action": "create_personalized_page", "details": {"slot": "page"}}
  设 描三 为 荐描述卡(提页, [包甲])
  断言相等(描三["因"], "unknown", "17 别的种类 unknown")
  设 提无 为 {"callId": "call-n", "action": "enable_official_plugin", "details": {}}
  设 描四 为 荐描述卡(提无, [包甲])
  断言相等(描四["因"], "unknown", "17 details 无 name unknown")
  设 描五 为 荐描述卡(提卡, [])
  断言相等(描五["因"], "unavailable", "17 目录空 unavailable")
  设 描六 为 荐描述卡(提卡, [包禁])
  断言相等(描六["因"], "unavailable", "17 非官方 unavailable")
  设 描七 为 荐描述卡(提卡, [包甲], {"存活": 假})
  断言相等(描七["因"], "closing", "17 关闭中")
  设 描八 为 荐描述卡(提卡, [包甲], {"是根": 假})
  断言相等(描八["因"], "not-live-root", "17 非根")
  设 包无元二 为 {"name": "official-search", "official": 真, "optional": 真, "availability": "installation", "enabled": 真}
  设 描九 为 荐描述卡(提卡, [包无元二])
  断言相等(描九["标题"], "official-search", "17 无 meta 标题回落")
  断言相等(描九["描述"], "", "17 无描述回落空串")

  # 18. enable 阶段机：首次 enabled / 二次幂等 / 已开 already-enabled / failed 可重试 / restart-required / rejected
  设 决零 为 {"callId": "call-plugin-1", "action": "enable_official_plugin"}
  设 变应用 为 {"申请": "applied"}
  设 开一 为 荐插件开启结果(决零, 包甲, 变应用)
  断言相等(开一["状态"], "settled", "18 首次开启 settled")
  断言相等(开一["决策"]["phase"], "enabled", "18 首次开启 enabled")
  断言相等(开一["决策"]["data"], {"errorCode": 空}, "18 enabled 带空错误码")
  设 开二 为 荐插件开启结果(开一["决策"], 包甲, 变应用)
  断言相等(开二["决策"]["phase"], "enabled", "18 二次幂等不重开")
  设 包已开 为 {"name": "official-search", "official": 真, "optional": 真, "availability": "installation", "enabled": 真}
  设 开三 为 荐插件开启结果(决零, 包已开, 变应用)
  断言相等(开三["决策"]["phase"], "already-enabled", "18 已开 already-enabled")
  设 变重启 为 {"申请": "restart-required"}
  设 开四 为 荐插件开启结果(决零, 包甲, 变重启)
