  断言相等(开四["决策"]["data"]["application"], "restart-required", "18 记 application")
  设 变失败 为 {"申请": "failed", "错误码": "incompatible-version"}
  设 开五 为 荐插件开启结果(决零, 包甲, 变失败)
  断言相等(开五["决策"]["phase"], "failed", "18 失败记 failed")
  断言相等(开五["决策"]["data"], {"errorCode": "incompatible-version"}, "18 只记错误码不记诊断")
  设 决失 为 {"callId": "call-plugin-1", "action": "enable_official_plugin", "phase": "failed"}
  设 开六 为 荐插件开启结果(决失, 包甲, 变应用)
  断言相等(开六["决策"]["phase"], "enabled", "18 failed 可重试")
  设 变拒 为 {"申请": "rejected"}
  设 开七 为 荐插件开启结果(决零, 包甲, 变拒)
  断言相等(开七["决策"]["data"], {"errorCode": "operation-error"}, "18 拒绝记通用码")
  设 开八 为 荐插件开启结果(决零, 包禁, 变应用)
  断言相等(开八["因"], "unavailable", "18 非合格包拒开")
  设 开九 为 荐插件开启结果(决零, 空, 变应用)
  断言相等(开九["因"], "unavailable", "18 目录里没有该包")
  设 开十 为 荐插件开启结果(决零, 包甲, 空)
  断言相等(开十["状态"], "unconfirmed", "18 卸载打断记 unconfirmed")
  断言相等(开十["因"], "closing", "18 unconfirmed 原因")
  设 决未 为 {"callId": "call-plugin-1", "action": "enable_official_plugin", "phase": "unconfirmed"}
  设 开十一 为 荐插件开启结果(决未, 包已开, 变应用)
  断言相等(开十一["决策"]["phase"], "enabled", "18 unconfirmed 后已开记 enabled")

  # 19. 对账：只把 unconfirmed 且现在已开的翻成 enabled
  设 对一 为 荐插件对账("unconfirmed", 包已开)
  断言相等(对一["成"], 真, "19 unconfirmed 对账成")
  断言相等(对一["阶段"], "enabled", "19 对账阶段")
  设 对二 为 荐插件对账("failed", 包已开)
  断言相等(对二["成"], 假, "19 非 unconfirmed 不对账")
  设 对三 为 荐插件对账("unconfirmed", 包甲)
  断言相等(对三["成"], 假, "19 尚未开启不对账")

  # ===== 五、creation-recommendations：位置、动词、对账 =====

  # 20. 位置校验：三槽位 + 自定义位置 1..1000
  断言相等(荐页面位置合法({"slot": "page"}), 真, "20 page 合法")
  断言相等(荐页面位置合法({"slot": "sidebar-left"}), 真, "20 sidebar-left 合法")
  断言相等(荐页面位置合法({"slot": "sidebar-right"}), 真, "20 sidebar-right 合法")
  断言相等(荐页面位置合法({"slot": "bottom"}), 假, "20 未知槽位")
  断言相等(荐页面位置合法({"slot": "page", "customLocation": "左侧栏，放在会话里"}), 真, "20 自定义位置")
  断言相等(荐页面位置合法({"slot": "page", "customLocation": "  "}), 假, "20 空自定义位置")
  断言相等(荐页面位置合法({"slot": "page", "customLocation": 7}), 假, "20 非字符串自定义位置")
  设 长文 为 字符串重复("x", 1001)
  断言相等(荐页面位置合法({"slot": "page", "customLocation": 长文}), 假, "20 超 1000 字")
  设 满文 为 字符串重复("x", 1000)
  断言相等(荐页面位置合法({"slot": "page", "customLocation": 满文}), 真, "20 正好 1000 字")
  断言相等(荐页面位置合法(空), 假, "20 非对象")

  # 21. create 必须先有合法位置；无收据 + create → 记 creating 的 accepted
  设 裁一 为 荐页面裁定(空, "create", 假, 假, 假)
  断言相等(裁一["状态"], "refused", "21 create 非法位置")
  断言相等(裁一["因"], "invalid-location", "21 非法位置文案")
  设 裁二 为 荐页面裁定(空, "create", 真, 假, 假)
  断言相等(裁二["状态"], "accepted", "21 create accepted")
  断言相等(裁二["阶段"], "creating", "21 记 creating")
  断言相等(裁二["决策"]["action"], "create_personalized_page", "21 决策动作名")
  设 裁三 为 荐页面裁定(空, "keep", 真, 假, 假)
  断言相等(裁三["因"], "unavailable", "21 无收据时非 create 动词")

  # 22. 在途作业：一律 accepted，cancel 且未到 installing 才真要取消
  设 收进 为 {"callId": "call-1", "action": "create_personalized_page", "phase": "creating", "slot": "page", "bundleName": "@dsh-local/view-1"}
  设 裁四 为 荐页面裁定(收进, "cancel", 真, 真, 假)
  断言相等(裁四["状态"], "accepted", "22 在途取消 accepted")
  断言相等(裁四["取消"], 真, "22 creating 可取消")
  设 收装 为 {"callId": "call-1", "action": "create_personalized_page", "phase": "installing", "slot": "page", "bundleName": "@dsh-local/view-1"}
  设 裁五 为 荐页面裁定(收装, "cancel", 真, 真, 假)
  断言相等(裁五["取消"], 假, "22 installing 不可取消")
  设 裁六 为 荐页面裁定(收进, "create", 真, 真, 假)
  断言相等(裁六["状态"], "accepted", "22 在途再点 create 也 accepted")

  # 23. installed / kept：keep 与 undo；其它动词 settle 原收据
  设 收装好 为 {"callId": "call-1", "action": "create_personalized_page", "phase": "installed", "slot": "page", "bundleName": "@dsh-local/view-1"}
  设 裁七 为 荐页面裁定(收装好, "create", 真, 假, 真)
  断言相等(裁七["状态"], "settled", "23 installed 后 create 不再执行")
  断言相等(裁七["决策"]["phase"], "installed", "23 settle 原收据")
  设 裁八 为 荐页面裁定(收装好, "keep", 真, 假, 真)
  断言相等(裁八["决策"]["phase"], "kept", "23 keep 记 kept")
  设 裁九 为 荐页面裁定(收装好, "undo", 真, 假, 真)
  断言相等(裁九["决策"]["phase"], "removed", "23 undo 记 removed")
  设 收无包 为 {"callId": "call-1", "action": "create_personalized_page", "phase": "installed", "slot": "page"}
  设 裁十 为 荐页面裁定(收无包, "undo", 真, 假, 真)
  断言相等(裁十["因"], "unavailable", "23 无 bundleName 不可 undo")

  # 24. removed：restore 已装则 settled installed，未装则交 installing；其它动词 settle
  设 收撤 为 {"callId": "call-1", "action": "create_personalized_page", "phase": "removed", "slot": "page", "bundleName": "@dsh-local/view-1"}
  设 裁十一 为 荐页面裁定(收撤, "restore", 真, 假, 真)
  断言相等(裁十一["决策"]["phase"], "installed", "24 restore 已装 settled")
  设 裁十二 为 荐页面裁定(收撤, "restore", 真, 假, 假)
  断言相等(裁十二["状态"], "accepted", "24 restore 未装交安装")
  断言相等(裁十二["阶段"], "installing", "24 restore 记 installing")
  设 裁十三 为 荐页面裁定(收撤, "create", 真, 假, 假)
  断言相等(裁十三["决策"]["phase"], "removed", "24 removed 后 create settle")
  设 裁十四 为 荐页面裁定(收撤, "cancel", 真, 假, 假)
  断言相等(裁十四["决策"]["phase"], "removed", "24 removed 后 cancel settle")

  # 25. recover：已装事实把 creating/installing/unconfirmed 翻成 installed；
  #     否则 creating/installing/unconfirmed → interrupted；非对账阶段不产出
  设 收甲 为 {"callId": "a", "phase": "creating", "slot": "page", "bundleName": "@dsh-local/view-a"}
  设 收乙 为 {"callId": "b", "phase": "installing", "slot": "page", "bundleName": "@dsh-local/view-b"}
  设 收丙 为 {"callId": "c", "phase": "unconfirmed", "slot": "page", "bundleName": "@dsh-local/view-c"}
  设 收丁 为 {"callId": "d", "phase": "installed", "slot": "page", "bundleName": "@dsh-local/view-d"}
  设 收戊 为 {"callId": "e", "phase": "failed", "slot": "page", "bundleName": "@dsh-local/view-e"}
  设 恢一 为 荐页面恢复([收甲, 收乙, 收丙, 收丁, 收戊], ["@dsh-local/view-a"])
  断言相等(列表长度(恢一), 3, "25 只产出可对账且变了的")
  设 恢首 为 列表获取(恢一, 0)
  断言相等(恢首["callId"], "a", "25 首条是 a")
  断言相等(恢首["phase"], "installed", "25 a 已装翻 installed")
  设 恢次 为 列表获取(恢一, 1)
  断言相等(恢次["callId"], "b", "25 次条是 b")
  断言相等(恢次["phase"], "interrupted", "25 b 未装翻 interrupted")
  设 恢三 为 列表获取(恢一, 2)
  断言相等(恢三["callId"], "c", "25 三条是 c")
  断言相等(恢三["phase"], "interrupted", "25 c unconfirmed 翻 interrupted")
  设 恢二 为 荐页面恢复([收甲, 收乙, 收丙], [], ["b"])
  断言相等(列表长度(恢二), 2, "25 在途作业跳过")
  设 恢四 为 荐页面恢复([收甲], [], [])
  断言相等(列表长度(恢四), 1, "25 无在途则全部可对账")

  # 26. 恢复失败：未收口的一律 unconfirmed，已 installed 的留在原位
  #     （上游 页面重开阶段 不含 unconfirmed，所以收丙 不参与这一支）
  设 败一 为 荐恢复失败([收甲, 收乙, 收丙, 收丁, 收戊], [])
  断言相等(列表长度(败一), 3, "26 只翻未收口的三个")
  设 败首 为 列表获取(败一, 0)
  断言相等(败首["phase"], "unconfirmed", "26 失败记 unconfirmed")
  设 败二 为 荐恢复失败([收甲, 收乙], ["a"])
  断言相等(列表长度(败二), 1, "26 在途作业跳过")

  # 27. 忽略数据：非法槽位回落到提议里的；自定义位置非法则不带
  设 提页甲 为 {"callId": "call-1", "action": "create_personalized_page", "details": {"slot": "sidebar-left"}}
  设 忽六 为 荐页面忽略数据(提页甲, {"slot": "page", "customLocation": "右侧"})
  断言相等(忽六["slot"], "page", "27 合法槽位采用")
  断言相等(忽六["customLocation"], "右侧", "27 自定义位置采用")
  设 忽七 为 荐页面忽略数据(提页甲, {"slot": "bottom"})
  断言相等(忽七["slot"], "sidebar-left", "27 非法槽位回落")
  断言相等(字典包含键(忽七, "customLocation"), 假, "27 无自定义位置不带键")
  设 忽八 为 荐页面忽略数据(提页甲, {"slot": "page", "customLocation": "  "})
  断言相等(字典包含键(忽八, "customLocation"), 假, "27 空白自定义位置不带键")
  设 忽九 为 荐页面忽略数据(提页甲, 空)
  断言相等(忽九["slot"], "sidebar-left", "27 无载荷用提议槽位")

  # ===== 六、official-bundles：模板与目录 =====

  # 28. 五个 profile 模板：除 sdk-minimal 外都叠在 base 上
  设 模一 为 荐模板包("acp")
  断言相等(模一, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-acp-app"], "28 acp 模板")
  设 模二 为 荐模板包("web")
  断言相等(模二, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"], "28 web 模板")
  设 模三 为 荐模板包("headless")
  断言相等(模三, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"], "28 headless 模板")
  设 模四 为 荐模板包("sdk")
  断言相等(模四, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-sdk-app"], "28 sdk 模板")
  设 模五 为 荐模板包("sdk-minimal")
  断言相等(模五, ["@deepseek-ai/dsh-sdk-minimal"], "28 sdk-minimal 独立")
  断言相等(荐模板包("nope"), 空, "28 无该模板")

  # 29. 安装方旧元组整条命中才重写；其它列表原样
  设 旧头 为 ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app", "@deepseek-ai/dsh-headless"]
  设 重一 为 荐重写安装模板("headless", 旧头)
  断言相等(重一, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"], "29 旧元组被重写")
  设 重二 为 荐重写安装模板("headless", ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"])
  断言相等(重二, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless"], "29 已正确的不动")
  设 重三 为 荐重写安装模板("web", ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"])
  断言相等(重三, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"], "29 无旧元组的模式原样")
  设 重四 为 荐重写安装模板("headless", ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless", "@deepseek-ai/dsh-web-app"])
  断言相等(重四, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-headless", "@deepseek-ai/dsh-web-app"], "29 顺序不同不重写")

  # 30. 退役包剔除
  设 剔一 为 荐剔除退役包(["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-experimental-schedule-bundle", "@deepseek-ai/dsh-web-app"])
  断言相等(剔一, ["@deepseek-ai/dsh-base", "@deepseek-ai/dsh-web-app"], "30 退役包被剔除")
  设 剔二 为 荐剔除退役包(["@deepseek-ai/dsh-base"])
  断言相等(剔二, ["@deepseek-ai/dsh-base"], "30 无退役包不动")

  # 31. 目录条目五条不变量：包名、无 version、双语 title/description、内联 svg base64
  设 目条目 为 {"packageName": "@deepseek-ai/dsh-cua-bundle", "platforms": ["darwin"], "listedByDefault": 假,
    "meta": {"title": {"en": "Computer use", "zh": "Computer Use"}, "description": {"en": "macOS only", "zh": "仅 macOS"}, "icon": "data:image/svg+xml;base64,PHN2Zz4="}}
  断言相等(荐目录条目问题(目条目), 空, "31 合法条目")
  设 目缺名 为 {"meta": {"title": {"en": "a", "zh": "b"}, "description": {"en": "c", "zh": "d"}, "icon": "data:image/svg+xml;base64,x"}}
  断言相等(荐目录条目问题(目缺名), "目录条目缺少 packageName", "31 缺包名")
  设 目版本 为 {"packageName": "@x/y", "version": "1.0.0", "meta": {"title": {"en": "a", "zh": "b"}, "description": {"en": "c", "zh": "d"}, "icon": "data:image/svg+xml;base64,x"}}
  断言相等(荐目录条目问题(目版本), "目录条目不得带 version", "31 带 version")
  设 目单语 为 {"packageName": "@x/y", "meta": {"title": {"en": "a"}, "description": {"en": "c", "zh": "d"}, "icon": "data:image/svg+xml;base64,x"}}
  断言相等(荐目录条目问题(目单语), "目录条目 title 缺 en 或 zh", "31 title 单语")
  设 目空述 为 {"packageName": "@x/y", "meta": {"title": {"en": "a", "zh": "b"}, "description": {"en": " ", "zh": "d"}, "icon": "data:image/svg+xml;base64,x"}}
  断言相等(荐目录条目问题(目空述), "目录条目 description 的 en/zh 不得为空", "31 description 空")
  设 目图标 为 {"packageName": "@x/y", "meta": {"title": {"en": "a", "zh": "b"}, "description": {"en": "c", "zh": "d"}, "icon": "data:image/png;base64,x"}}
  断言相等(荐目录条目问题(目图标), "目录条目 icon 必须是内联 svg base64", "31 图标类型")
  设 目无元 为 {"packageName": "@x/y"}
  断言相等(荐目录条目问题(目无元), "目录条目缺少 meta", "31 缺 meta")

  # ===== 七、plugin-detail：语言链 / meta.detail / Markdown / README / 图片 =====

  # 32. 语言链：切前缀 + 兜底 en，去重保序
  断言相等(荐语言链("zh-Hans-CN"), ["zh-hans-cn", "zh-hans", "zh", "en"], "32 zh-Hans-CN 链")
  断言相等(荐语言链("en-US"), ["en-us", "en"], "32 en-US 链")
  断言相等(荐语言链("en"), ["en"], "32 en 链")
  断言相等(荐语言链("ZH-CN"), ["zh-cn", "zh", "en"], "32 大小写归一")
  断言抛含(抛语言链相对, "Not a language id", "32 ../x 非法")
  断言抛含(抛语言链空, "Not a language id", "32 空串非法")
  断言抛含(抛语言链短首片, "Not a language id", "32 首片过短")
  断言抛含(抛语言链长首片, "Not a language id", "32 首片过长")
  断言抛含(抛语言链坏子片, "Not a language id", "32 子片含下划线")

  # 33. meta.detail：合法相对 Markdown 路径；八类非法各一句规则
  设 详一 为 荐校验详情路径("guide/DETAIL.md")
  断言相等(详一["成"], 真, "33 合法详情路径")
  断言相等(详一["值"], "guide/DETAIL.md", "33 合法路径原样")
  设 详二 为 荐校验详情路径(空)
  断言相等(详二["成"], 真, "33 缺省值为空也合法")
  断言相等(详二["值"], 空, "33 缺省值即上游 undefined")
  设 详三 为 荐校验详情路径("guide/D.markdown")
  断言相等(详三["成"], 真, "33 .markdown 合法")
  设 详四 为 荐校验详情路径("/README.md")
  断言相等(详四["规则"], "must be a relative path inside the package", "33 绝对路径")
  设 详五 为 荐校验详情路径("../x.md")
  断言相等(详五["规则"], "must be a relative path inside the package", "33 上跳")
  设 详六 为 荐校验详情路径("guide/./x.md")
  断言相等(详六["规则"], "must be a relative path inside the package", "33 单点段")
  设 详七 为 荐校验详情路径("guide//x.md")
  断言相等(详七["规则"], "must be a relative path inside the package", "33 空段")
  设 详八 为 荐校验详情路径("guide\\x.md")
  断言相等(详八["规则"], "must be a relative path inside the package", "33 反斜杠")
  设 详九 为 荐校验详情路径("https://example.com/x.md")
  断言相等(详九["规则"], "must be a relative path inside the package", "33 协议前缀")
  设 详十 为 荐校验详情路径("README.txt")
  断言相等(详十["规则"], "must name a Markdown file", "33 非 Markdown")
  设 详十一 为 荐校验详情路径(" ")
  断言相等(详十一["规则"], "must be a non-empty string", "33 空白")
  设 详十二 为 荐校验详情路径(7)
  断言相等(详十二["规则"], "must be a non-empty string", "33 非字符串")
  断言抛含(抛详情路径绝对, "meta.detail must be a relative path inside the package", "33 抛错版带标签")
  断言抛含(抛详情路径上跳, "must be a relative path", "33 抛错版上跳")
  断言抛含(抛详情路径非MD, "must name a Markdown file", "33 抛错版非 Markdown")

  # 34. Markdown：去一个前导 BOM，再去首个前置块（只去第一个）
  设 文一 为 荐Markdown正文("\uFEFF---\ntitle: x\n---\n# A\n\n---\nkept: rule\n---\n")
  断言相等(文一, "# A\n\n---\nkept: rule\n---\n", "34 去 BOM 与首个前置块")
  设 文二 为 荐Markdown正文("---\r\nk: v\r\n---")
  断言相等(文二, "", "34 CRLF 前置块后为空")
  设 文三 为 荐Markdown正文("# B")
  断言相等(文三, "# B", "34 无前置块原样")
  设 文四 为 荐Markdown正文("")
  断言相等(文四, "", "34 空串")
  设 文五 为 荐Markdown正文("---\n# A")
  断言相等(文五, "---\n# A", "34 无收尾不当前置块")

  # 35. README 名：README_NAMES 序优先，同序按名字升序
  断言相等(荐README名(["README.md", "readme.md", "Readme.md", "README.markdown", "README"]), "README.md", "35 五名齐时取 README.md")
  断言相等(荐README名(["README", "README.md"]), "README.md", "35 序优先")
  断言相等(荐README名(["readme.md", "Readme.md"]), "readme.md", "35 同序按名字升序")
  断言相等(荐README名(["notes.txt"]), 空, "35 无 README")
  断言相等(荐README名(["README.MD"]), "README.MD", "35 大小写不敏感匹配但原名返回")
  断言相等(荐README名([]), 空, "35 空目录")

  # 36. 图片去向：查询串与片段被忽略、按文档目录解析、七种后缀、越界与坏转义拒绝
  设 图一 为 荐图片去向("guide/DETAIL.md", "img/a.png?raw=1#x")
  断言相等(图一["路径"], "guide/img/a.png", "36 相对图片")
  断言相等(图一["媒体类型"], "image/png", "36 png 类型")
  设 图二 为 荐图片去向("guide/DETAIL.md", "/logo.SVG")
  断言相等(图二["路径"], "logo.SVG", "36 根绝对图片")
  断言相等(图二["媒体类型"], "image/svg+xml", "36 svg 类型")
  设 图三 为 荐图片去向("guide/DETAIL.md", "./a%20b.webp")
  断言相等(图三["路径"], "guide/a b.webp", "36 百分号解码")
  断言相等(图三["媒体类型"], "image/webp", "36 webp 类型")
  设 图四 为 荐图片去向("README.md", "b.jpeg")
  断言相等(图四["路径"], "b.jpeg", "36 jpeg 类型")
  断言相等(图四["媒体类型"], "image/jpeg", "36 jpeg")
  设 图五 为 荐图片去向("README.md", "c.gif")
  断言相等(图五["媒体类型"], "image/gif", "36 gif 类型")
  设 图六 为 荐图片去向("README.md", "d.avif")
  断言相等(图六["媒体类型"], "image/avif", "36 avif 类型")
  设 图七 为 荐图片去向("README.md", "e.jpg")
  断言相等(图七["媒体类型"], "image/jpeg", "36 jpg 类型")
  断言相等(荐图片去向("guide/DETAIL.md", "../../etc/passwd.png"), 空, "36 越界拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", ".."), 空, "36 上跳拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", "/"), 空, "36 空路径拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", "notes.txt"), 空, "36 非图片拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", "img\\a.png"), 空, "36 反斜杠拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", "%E0%A4%A.png"), 空, "36 坏转义拒绝")
  断言相等(荐图片去向("guide/DETAIL.md", "%zz.png"), 空, "36 非十六进制拒绝")

  # 37. 正例：`写` 只能吃变量——下标先落变量再写（本仓库的静默坑，留一条回归）
  设 表样 为 [{"k": 1}]
  设 首样 为 列表获取(表样, 0)
  设 值样 为 首样["k"]
  断言相等(值样, 1, "37 下标先落变量")

  写 "--- 测试 推荐决策 通过 ---"

# 上下文浅复制（判据侧用，等价于模块里的 荐复制字典）
段落 荐复制上下文(源):
  设 出 为 {}
  遍历 键 之 字典键列表(源):
    设 值 为 源[键]
    设 出[键] 为 值
  返回 出

主程()
