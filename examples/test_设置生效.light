# test_设置生效.light —— R106 任务线 A：设置生效链纯逻辑换算验收
# 被测：src/设置生效.light
# 运行：cd lightharness && PYTHONUTF8=1 python 运行.py examples/test_设置生效.light
#
# 语言坑：断言诊断走 抛出 新建 错误（L-055/L-160）；字典/列表字面量单行；
#   抛错用例用 尝试/捕获 内联（光明不便于传段落引用作实参）。

从 设置生效 导入 权限档位表, 档位取预设, 预设取档位
从 设置生效 导入 解析主题, 解析字号, 解析语言, 解析链接目标, 生效参数
从 权限 导入 预设全放行, 预设按类别, 预设全拒绝, 预设自定义
从 内置核心字典 导入 字典设置, 字典包含键

设 通过盘 为 {"通过": 0}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言含(列表, 项, 标签):
  设 命中 为 假
  遍历 候选 之 列表:
    如果 候选 == 项:
      设 命中 为 真
  如果 命中 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：列表不含 " + 转字符串(项))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言不含(列表, 项, 标签):
  设 命中 为 假
  遍历 候选 之 列表:
    如果 候选 == 项:
      设 命中 为 真
  如果 命中 == 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：列表不应含 " + 转字符串(项))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# §1 三档映射双向
段落 用例_档位映射:
  断言相等(档位取预设("readOnly"), 预设全拒绝, "1a readOnly→全拒绝")
  断言相等(档位取预设("workspaceWrite"), 预设按类别, "1b workspaceWrite→按类别")
  断言相等(档位取预设("fullAccess"), 预设全放行, "1c fullAccess→全放行")
  断言相等(预设取档位("全拒绝")[0], "readOnly", "1d 全拒绝→readOnly")
  断言相等(预设取档位("按类别")[0], "workspaceWrite", "1e 按类别→workspaceWrite")
  断言相等(预设取档位("全放行")[0], "fullAccess", "1f 全放行→fullAccess")
  # 自定义回落默认档
  设 回落 为 预设取档位("自定义")
  断言相等(回落[0], "workspaceWrite", "1g 自定义→回落workspaceWrite")
  断言相等(回落[1], "自定义档回落默认档", "1h 自定义回落说明")
  # 未知档位抛错
  设 抛错 为 假
  尝试:
    档位取预设("bogus")
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "1i 未知档位抛错")
  # 未知预设抛错
  设 抛错 为 假
  尝试:
    预设取档位("bogus")
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "1j 未知预设抛错")

# §2 主题
段落 用例_主题:
  断言相等(解析主题("light", "light"), "light", "2a light原样")
  断言相等(解析主题("dark", "light"), "dark", "2b dark原样")
  断言相等(解析主题("system", "dark"), "dark", "2c system+dark偏好")
  断言相等(解析主题("system", "light"), "light", "2d system+light偏好")
  断言相等(解析主题("system", "bogus"), "light", "2e system+非法偏好→light")
  设 抛错 为 假
  尝试:
    解析主题("neon", "light")
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "2f 非法外观抛错")

# §3 字号
段落 用例_字号:
  断言相等(解析字号(12), 12, "3a 12合法")
  断言相等(解析字号(17), 17, "3b 17合法")
  设 抛错 为 假
  尝试:
    解析字号(11)
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "3c 11越界抛错")
  设 抛错 为 假
  尝试:
    解析字号(18)
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "3d 18越界抛错")

# §4 语言 / 链接目标
段落 用例_语言链接:
  断言相等(解析语言("zh"), "zh", "4a zh")
  断言相等(解析语言("en"), "en", "4b en")
  设 抛错 为 假
  尝试:
    解析语言("fr")
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "4c 非法语言抛错")
  断言相等(解析链接目标("sidebar"), "_self", "4d sidebar→_self")
  断言相等(解析链接目标("newTab"), "_blank", "4e newTab→_blank")
  设 抛错 为 假
  尝试:
    解析链接目标("modal")
  捕获 异常 e:
    设 抛错 为 真
  断言相等(抛错, 真, "4f 非法链接目标抛错")

# §5 生效参数总装
段落 用例_生效参数:
  # 空字典取默认
  设 空表 为 {}
  设 默认值 为 生效参数(空表)
  断言相等(默认值["主题"], "light", "5a 默认主题light")
  断言相等(默认值["字号"], 14, "5b 默认字号14")
  断言相等(默认值["语言"], "zh", "5c 默认语言zh")
  断言相等(默认值["链接目标"], "_self", "5d 默认链接_self")
  断言相等(默认值["权限档位"], "workspaceWrite", "5e 默认权限档workspaceWrite")
  断言相等(默认值["权限预设"], 预设按类别, "5f 默认权限预设按类别")
  # 全覆盖
  设 全表 为 {}
  字典设置(全表, "permission", "fullAccess")
  字典设置(全表, "appearance", "dark")
  字典设置(全表, "fontSize", 17)
  字典设置(全表, "language", "en")
  字典设置(全表, "linkOpening", "newTab")
  设 全覆盖 为 生效参数(全表)
  断言相等(全覆盖["主题"], "dark", "5g 全覆盖主题dark")
  断言相等(全覆盖["字号"], 17, "5h 全覆盖字号17")
  断言相等(全覆盖["权限档位"], "fullAccess", "5i 全覆盖权限档")
  断言相等(全覆盖["权限预设"], 预设全放行, "5j 全覆盖权限预设")
  断言相等(全覆盖["链接目标"], "_blank", "5k 全覆盖链接_blank")
  断言含(全覆盖["降级项"], "语言", "5l en降级项含语言")
  # 部分覆盖：只设 appearance=system + dark偏好
  设 部表 为 {}
  字典设置(部表, "appearance", "system")
  设 部分值 为 生效参数(部表, "dark")
  断言相等(部分值["主题"], "dark", "5m system+dark偏好终值dark")
  断言相等(部分值["字号"], 14, "5n 部分覆盖字号回落14")
  # 运行时预设覆盖设置表（全放行）
  设 存表 为 {}
  字典设置(存表, "permission", "readOnly")
  设 运行覆盖 为 生效参数(存表, "light", "全放行")
  断言相等(运行覆盖["权限预设"], 预设全放行, "5o 运行时预设权威全放行")
  断言相等(运行覆盖["权限档位"], "fullAccess", "5p 运行时预设档位fullAccess")
  # zh 降级项不含语言
  设 中表 为 {}
  字典设置(中表, "language", "zh")
  设 中值 为 生效参数(中表)
  断言不含(中值["降级项"], "语言", "5q zh降级项不含语言")
  # 运行时预设=自定义 → 档位回落 workspaceWrite 且降级项含权限
  设 自定义值 为 生效参数(空表, "light", "自定义")
  断言相等(自定义值["权限档位"], "workspaceWrite", "5r 自定义回落档位")
  断言含(自定义值["降级项"], "权限", "5s 自定义降级项含权限")
  # 默认（zh + 非自定义档）降级项不许为空数组充数：必含三条未落地能力
  设 未落地 为 ["工作步骤展示", "性能与用量", "代码工作工具"]
  遍历 能力 之 未落地:
    断言含(默认值["降级项"], 能力, "5u 默认降级项含未落地能力_" + 能力)
  断言真(长度(默认值["降级项"]) >= 3, "5v 降级项非空")
  设 默认降级 为 ["工作步骤展示", "性能与用量", "代码工作工具"]
  断言相等(默认值["降级项"], 默认降级, "5w 默认降级项确切内容与顺序")
  # 七键齐全性
  设 七键 为 ["主题", "字号", "语言", "链接目标", "权限档位", "权限预设", "降级项"]
  遍历 键 之 七键:
    断言真(字典包含键(默认值, 键), "5t 七键齐全_" + 键)

段落 主程():
  用例_档位映射()
  用例_主题()
  用例_字号()
  用例_语言链接()
  用例_生效参数()
  打印 "test_设置生效 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置生效 通过 ---"
  返回 真

主程()
