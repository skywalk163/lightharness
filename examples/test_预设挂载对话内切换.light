# test_预设挂载对话内切换.light —— R109-B：对话内预设切换后注册表按新预设装配
# 被测：src/总入口.light.跑一轮（对话内重启路径接通 预设切换.重建预设）
# 运行：cd lightharness && python 运行.py examples/test_预设挂载对话内切换.light
#
# 上游语义（packages/preset/agent-preset-registry/src/session.ts）：
#   事件 'agent-preset/selected' 效果**超出 blank 窗口**——首轮及以后每一轮都跑在新挂载组合下；
#   重建读 agentPreset 投影（不只读 header）；未知预设不静默。
#
# 本测试用假客户端记录每轮收到的工具表长度，验证对话内切换事件写入会话后，
# 后续轮次的注册表确实按新预设过滤（而不是沿用启动时的注册表）。
#
# 实测口径（2026-10-01，组装注册表(预设).名单() 真实工具名数）：
#   全量(无预设) = 148；minimal = 1（仅 bash）；standard/ptc/cordis = 4（bash/读文件/写文件/搜索文件）
#   minimal 与其余三预设的工具数差异显著，足以作为切换生效的断言指纹。
#
# 反跑判据（单点破坏-还原）：
#   反跑1：把 跑一轮 里的「会话预设重建」段删掉 → 切换后第二轮工具表仍为全量 → 用例立红。
#
# 语言坑规避：诊断走 抛出 新建 错误；列表/字典字面量单行；设 X 为 为 前留空格。

从 总入口 导入 组装注册表, 跑一轮
从 会话 导入 新建会话
从 消息 导入 造文本块
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串包含

设 通过盘 为 {"通过": 0}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  通过盘["通过"] = 通过盘["通过"] + 1

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真")
  通过盘["通过"] = 通过盘["通过"] + 1

段落 检查抛错(用例, 标签):
  设 消息 为 "未抛错"
  尝试:
    用例()
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
  如果 消息 == "未抛错":
    抛出 新建 错误("断言失败[" + 标签 + "]：应抛错未抛")
  通过盘["通过"] = 通过盘["通过"] + 1
  返回 消息

# ---- 假客户端：记录每轮收到的工具表长度，返回纯文本完成响应 ----
类 记录客户端:
  属性 模型名 等于 "test-model"
  属性 工具数表 等于 空

  段落 构造():
    设 己.工具数表 为 []

  段落 对话响应(网络消息, 选项, 工具表):
    己.工具数表.追加(长度(工具表))
    # 返回纯文本块 + 停止原因，不触发工具调用（一轮 completed）
    设 块表 为 []
    块表.追加(["type": "text", "text": "ok"])
    返回 块表

# =====================================================================
# 主程
# =====================================================================
段落 主程():
  打印 "===== R109-B：对话内预设切换接入总入口 ====="

  # ---- §1 基线：全量注册表工具数（自洽 + 钉死）----
  设 全量注册表 为 组装注册表()
  设 全量数 为 长度(全量注册表.名单())
  断言真(全量数 > 100, "1a 全量注册表工具数>100（自洽，不钉死）")
  打印 "  全量注册表工具数 = " + 转字符串(全量数)

  # ---- §2 对话内切换：无切换事件 → 沿用启动注册表（全量）----
  设 会话1 为 新建会话("t_switch1", ".")
  设 客1 为 新建 记录客户端()
  设 注1 为 组装注册表()  # 全量
  跑一轮(客1, 注1, 会话1, "第一轮：无预设")
  断言相等(客1.工具数表[0], 全量数, "2a 第一轮无切换 → 工具表=全量")

  # ---- §3 切换到 minimal → 下一轮工具表应缩到 1（仅 bash）----
  会话1.记录事件("agent-preset/selected", ["agentPreset": "minimal"])
  跑一轮(客1, 注1, 会话1, "第二轮：已切 minimal")
  断言相等(客1.工具数表[1], 1, "3a 切 minimal 后第二轮 → 工具表=1（仅 bash）")
  断言真(客1.工具数表[1] < 客1.工具数表[0], "3b minimal 工具数显著少于全量")

  # ---- §4 再切到 ptc → 工具表应回到 4 ----
  会话1.记录事件("agent-preset/selected", ["agentPreset": "ptc"])
  跑一轮(客1, 注1, 会话1, "第三轮：已切 ptc")
  断言相等(客1.工具数表[2], 4, "4a 切 ptc 后第三轮 → 工具表=4")
  断言真(客1.工具数表[2] > 客1.工具数表[1], "4b ptc 工具数多于 minimal")

  # ---- §5 再切到 cordis → 工具表应保持 4 ----
  会话1.记录事件("agent-preset/selected", ["agentPreset": "cordis"])
  跑一轮(客1, 注1, 会话1, "第四轮：已切 cordis")
  断言相等(客1.工具数表[3], 4, "5a 切 cordis 后第四轮 → 工具表=4")

  # ---- §6 启动时带预设（HARNESS_PRESET 等价）+ 对话内再切换 ----
  设 会话2 为 新建会话("t_switch2", ".")
  设 客2 为 新建 记录客户端()
  设 注2 为 组装注册表("minimal")  # 启动即 minimal
  跑一轮(客2, 注2, 会话2, "第一轮：启动=minimal")
  断言相等(客2.工具数表[0], 1, "6a 启动 minimal → 第一轮工具表=1")
  # 对话内切到 ptc
  会话2.记录事件("agent-preset/selected", ["agentPreset": "ptc"])
  跑一轮(客2, 注2, 会话2, "第二轮：切 ptc")
  断言相等(客2.工具数表[1], 4, "6b minimal 启动后切 ptc → 第二轮工具表=4")

  # ---- §7 未知预设抛错（不静默空表）----
  设 会话3 为 新建会话("t_switch3", ".")
  设 客3 为 新建 记录客户端()
  设 注3 为 组装注册表()
  会话3.记录事件("agent-preset/selected", ["agentPreset": "zzz"])
  段落 用未知():
    跑一轮(客3, 注3, 会话3, "切了未知预设")
  设 消息 为 检查抛错(用未知, "7a 未知预设跑一轮应抛错")
  断言真(字符串包含(消息, "未知 agent preset"), "7b 抛错消息含 未知 agent preset")
  断言真(字符串包含(消息, "zzz"), "7c 抛错消息含未知标识")

  # ---- §8 无关事件不触发重建 ----
  设 会话4 为 新建会话("t_switch4", ".")
  设 客4 为 新建 记录客户端()
  设 注4 为 组装注册表()
  跑一轮(客4, 注4, 会话4, "第一轮")
  断言相等(客4.工具数表[0], 全量数, "8a 第一轮全量")
  # 记录无关事件（不是切换事件）
  会话4.记录事件("turn/start", [])
  跑一轮(客4, 注4, 会话4, "第二轮：只有无关事件")
  断言相等(客4.工具数表[1], 全量数, "8b 无关事件不重建 → 仍全量")

  打印 "test_预设挂载对话内切换 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试预设挂载对话内切换 通过 ---"
  返回 真

主程()
