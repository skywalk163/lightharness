# test_流深化.light —— 流 v2：合并流块
从 流 导入 块组装器, 合并流块, 造块开始, 造文本增量, 造推理增量, 造工具调用增量, 造块结束, 造用量块, 造用量, 造结束, 造停止原因

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ===== 合并流块：文本+推理+工具调用 =====
  打印 "=== 合并流块测试 ==="
  设 流块表 为 []
  流块表.追加(造块开始(0, "text"))
  流块表.追加(造文本增量(0, "你好"))
  流块表.追加(造文本增量(0, "，光明"))
  流块表.追加(造块开始(1, "reasoning"))
  流块表.追加(造推理增量(1, "思考中"))
  流块表.追加(造工具调用增量(2, "call_1", "查天气", "{\"city\":\"北京\"}"))
  流块表.追加(造用量块(造用量(100, 50)))
  流块表.追加(造结束(造停止原因()))

  设 组装块 为 合并流块(流块表)
  断言等于(长度(组装块), 3, "合并后3个内容块")
  断言等于(组装块[0]["type"], "text", "第1块text")
  断言等于(组装块[0]["text"], "你好，光明", "文本拼接正确")
  断言等于(组装块[1]["type"], "reasoning", "第2块reasoning")
  断言等于(组装块[1]["text"], "思考中", "推理文本正确")
  断言等于(组装块[2]["type"], "tool-call", "第3块tool-call")
  断言等于(组装块[2]["id"], "call_1", "工具调用id")
  断言等于(组装块[2]["name"], "查天气", "工具名")

  # ===== 合并流块：空列表 =====
  设 空合并 为 合并流块([])
  断言等于(长度(空合并), 0, "空列表合并为0块")

  # ===== 合并流块：纯增量无block-start =====
  设 纯增量 为 []
  纯增量.追加(造文本增量(0, "直接文本"))
  纯增量.追加(造结束(造停止原因()))
  设 纯增量结果 为 合并流块(纯增量)
  断言等于(长度(纯增量结果), 1, "纯增量也能合并")
  断言等于(纯增量结果[0]["text"], "直接文本", "纯增量文本正确")

  打印 "--- 流深化测试通过 ---"

主()
