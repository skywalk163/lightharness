# test_套接字事件循环.light —— R66 子任务 66.3：事件循环 × 套接字 集成回归
#
# 场景：用 事件循环.light 驱动一个非阻塞 TCP echo 服务器（套接字.light 提供套接字），
# 3 个客户端并发连接、各发一条消息、收全回显、主动断开；服务器端按「对端关闭 →
# 拆链」收尾。另验证定时器清理（取消未触发的保险定时器）与优雅关闭（停止 后
# 循环退出、回调表清空、资源释放）。
#
# 回显链路刻意走了完整的 读事件 → 挂待发队列 → 尝试直发 → 没发完挂写事件 →
# 写事件排空 的路径（消息很小通常一次发完，写事件腿是给「发送缓冲满」准备的，
# 大载荷压测不在这里做——那是压力轮的事）。
#
# 运行：cd lightharness && python 运行.py examples/test_套接字事件循环.light
从 事件循环 导入 事件循环
从 套接字 导入 新建TCP套接字, SO_REUSEADDR, SOL_SOCKET
导入 threading
导入 time
导入 errno

# 共享状态：回调无闭包，全走模块级表
设 状态 为 {
  "循环": 空,
  "服务": 空,
  "连接": {},
  "待发": {},
  "待关闭": {},
  "回显完成": [],
  "保险定时器": 0,
  "保险触发": 0,
  "保险取消": 0,
  "收尾错误": ""
}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + "；实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 愿等(e):
  设 错误号 为 getattr(e, "errno", 空)
  返回 错误号 == errno.EAGAIN 或 错误号 == errno.EWOULDBLOCK

# ---------- 服务端回调 ----------
段落 服务可读(fd):
  尝试:
    设 对 为 状态["服务"].接受()
  捕获 异常 e:
    # 事件就绪但 accept 竞态落空（EAGAIN）是正常路径，等下一轮
    返回
  设 连 为 对[0]
  连.设置阻塞(假)
  设 新fd 为 连.文件号()
  状态["连接"][新fd] 为 连
  状态["待发"][新fd] 为 b""
  状态["待关闭"][新fd] 为 假
  状态["循环"].注册读(新fd, 连接可读)

段落 排空待发(fd):
  设 缓存 为 状态["待发"][fd]
  当 长度(缓存) > 0:
    尝试:
      设 n 为 状态["连接"][fd].发送(缓存)
    捕获 异常 e:
      如果 愿等(e):
        # 发送缓冲满：留给写事件，别自旋
        返回
      拆链(fd)
      返回
    如果 n == 0:
      返回
    设 缓存 为 缓存[n:]
    状态["待发"][fd] 为 缓存
  # 待发清空：写事件腿撤掉；若对端已关，这时候才真正拆链
  状态["循环"].注销写(fd)
  如果 状态["待关闭"][fd]:
    拆链(fd)

段落 连接可读(fd):
  设 连 为 状态["连接"][fd]
  尝试:
    设 数据 为 连.接收(4096)
  捕获 异常 e:
    如果 愿等(e):
      返回
    拆链(fd)
    返回
  如果 长度(数据) == 0:
    # 对端关闭：没有待发数据就立刻拆，否则等写腿排空后再拆
    状态["待关闭"][fd] 为 真
    状态["循环"].注销读(fd)
    如果 长度(状态["待发"][fd]) == 0:
      拆链(fd)
    返回
  状态["待发"][fd] 为 状态["待发"][fd] + 数据
  排空待发(fd)

段落 拆链(fd):
  设 连 为 状态["连接"][fd]
  状态["循环"].注销读(fd)
  状态["循环"].注销写(fd)
  连.关闭()
  状态["连接"].pop(fd)
  状态["待发"].pop(fd)
  状态["待关闭"].pop(fd)

# ---------- 保险定时器（测取消清理） ----------
段落 保险定时器触发:
  状态["保险触发"] 为 状态["保险触发"] + 1

# ---------- 收尾（由 立即调度 派发） ----------
段落 收尾:
  # 保险定时器应在触发前被取消——这就是「定时器清理」的验证点
  状态["保险取消"] 为 状态["循环"].取消定时器(状态["保险定时器"])
  状态["循环"].停止()

# ---------- 客户端 ----------
段落 客户线程(编号):
  设 客 为 新建TCP套接字()
  客.设置超时(5.0)
  客.连接("127.0.0.1", 状态["端口"])
  设 消息 为 b"hello-echo-" + 转字符串(编号).encode("utf-8") + b"-end"
  客.发送全部(消息)
  设 收到 为 b""
  当 长度(收到) < 长度(消息):
    设 块 为 客.接收(4096)
    如果 长度(块) == 0:
      抛出 "客户端 " + 转字符串(编号) + " 对端提前关闭"
    设 收到 为 收到 + 块
  状态["回显完成"].追加([编号, 收到 == 消息])
  客.关闭()

段落 主:
  # ---- 起服务器 ----
  设 循环 为 新建 事件循环()
  状态["循环"] 为 循环
  设 服务 为 新建TCP套接字()
  服务.设置选项(SOL_SOCKET, SO_REUSEADDR, 1)
  服务.绑定("127.0.0.1", 0)
  服务.监听(8)
  服务.设置阻塞(假)
  状态["服务"] 为 服务
  状态["端口"] 为 服务.本地地址()[1]
  循环.注册读(服务.文件号(), 服务可读)

  # 保险定时器：如果 15 秒内没被取消并停止，说明流程卡死（触发会留下计数）
  状态["保险定时器"] 为 循环.延时回调(15000, 保险定时器触发)

  # ---- 循环跑在子线程 ----
  设 线 为 threading.Thread(target=循环.运行持续)
  线.start()

  # ---- 3 客户端并发 ----
  设 线程表 为 []
  设 n 为 0
  当 n < 3:
    线程表.追加(threading.Thread(target=客户线程, args=[n]))
    设 n 为 n + 1
  遍历 t 之 线程表:
    t.start()
  遍历 t 之 线程表:
    t.join(10000)
    断言真(t.is_alive() == 假, "客户端线程未卡死")

  # ---- 校验回显 + 优雅关闭 ----
  断言相等(长度(状态["回显完成"]), 3, "三个客户端都完成回显")
  遍历 项 之 状态["回显完成"]:
    断言真(项[1], "客户端 " + 转字符串(项[0]) + " 回显内容一致")
  # 客户端已断开，等服务端把三条连接都拆干净（EOF 拆链是异步的）
  设 截止 为 time.monotonic() + 2.0
  当 长度(状态["连接"]) > 0 且 time.monotonic() < 截止:
    time.sleep(0.01)
  断言相等(长度(状态["连接"]), 0, "对端关闭后服务端连接全部拆链")
  循环.立即调度(收尾)
  线.join(5000)
  断言真(线.is_alive() == 假, "运行持续 在停止后退出")
  断言相等(状态["保险取消"], 真, "保险定时器在触发前被取消（定时器清理）")
  断言相等(状态["保险触发"], 0, "被取消的定时器没有触发")
  服务.关闭()
  循环.关闭()
  断言真(循环.运行一次(10) == 假, "关闭后循环不可再运行")

  输出("test_套接字事件循环.light 全部断言通过（4 组 / 多客户端并发回显+EOF拆链+定时器清理+优雅关闭）")

主()
