# test_会话导入导出.light —— 会话 JSON 信封导出/导入回归
# 运行：python 运行.py examples/test_会话导入导出.light

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 认证 导入 初始化认证
从 总入口 导入 组装注册表
从 JSON 导入 解析JSON, 序列化JSON
从 字符串处理 导入 编码
从 文件系统 导入 创建目录, 删除目录, 路径连接, 文件列表, 删除文件, 文件存在
从 系统接口 导入 是目录
从 随机 导入 安全随机令牌
从 内置核心字符串 导入 截取
从 文件系统 导入 目录存在
从 系统接口 导入 切换工作目录
从 会话存储 导入 会话存储

设 通过盘 为 {"通过": 0}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  通过盘["通过"] = 通过盘["通过"] + 1

段落 造请求(方法, 路径, 体):
  返回 ["方法": 方法, "路径": 路径, "头": {}, "体": 体]

段落 清空目录(目录):
  如果 目录存在(目录) == 假:
    返回
  遍历 名字 之 文件列表(目录):
    设 子 为 路径连接(目录, 名字)
    如果 是目录(子): 清空目录(子)
    否则: 删除文件(子)
  删除目录(目录)


异步 段落 主测试:
  初始化认证()
  设 根 为 路径连接("/tmp", "lh_io_" + 截取(安全随机令牌(), 0, 8))
  创建目录(根)
  设 会话库 为 新建 会话存储(路径连接(根, "sessions"))
  全局服务.配置(空, 组装注册表(), 路径连接(根, "cfg"), 5.0, "", 空)
  全局服务.设置会话库(会话库)

  # ① 新建会话 + 追加两条消息
  设 元 为 会话库.新建会话("原始标题")
  会话库.追加消息(元["id"], ["角色": "user", "内容": "问题一"])
  会话库.追加消息(元["id"], ["角色": "assistant", "内容": "回答一"])

  # ② 导出
  设 r1 为 等待 路由处理器(造请求("GET", "/api/sessions/" + 元["id"] + "/export", b''))
  断言相等(r1["状态"], 200, "1a 导出 200")
  设 env 为 解析JSON(r1["体"])
  断言相等(env["标题"], "原始标题", "1b 标题一致")
  断言相等(长度(env["消息"]), 2, "1c 消息数=2")
  断言相等(env["消息"][0]["内容"], "问题一", "1d 首条内容一致")

  # ③ 导入
  设 导入体 为 序列化JSON(["格式版本": 1, "标题": "导入副本", "消息": env["消息"]])
  设 r2 为 等待 路由处理器(造请求("POST", "/api/sessions/import", 编码(导入体)))
  断言相等(r2["状态"], 200, "2a 导入 200")
  设 res 为 解析JSON(r2["体"])
  断言相等(res["导入消息数"], 2, "2b 导入消息数=2")
  断言相等(res["标题"], "导入副本", "2c 导入标题")

  # ④ 导入的会话可读回
  设 r3 为 等待 路由处理器(造请求("GET", "/api/sessions/" + res["id"], b''))
  设 detail 为 解析JSON(r3["体"])
  断言相等(长度(detail["消息"]), 2, "3a 导入会话消息数=2")
  断言相等(detail["消息"][1]["内容"], "回答一", "3b 内容无损")

  # ⑤ 非法导入 -> 400
  设 r4 为 等待 路由处理器(造请求("POST", "/api/sessions/import", b'{}'))
  断言相等(r4["状态"], 400, "4a 缺少消息 400")

  # ⑥ 导出不存在会话 -> 404
  设 r5 为 等待 路由处理器(造请求("GET", "/api/sessions/notexist/export", b''))
  断言相等(r5["状态"], 404, "5a 导出不存在 404")

  切换工作目录("/tmp")
  清空目录(根)
  打印 "test_会话导入导出 通过 断言数=" + 转字符串(通过盘["通过"])
  返回 真

异步 运行 主测试()
