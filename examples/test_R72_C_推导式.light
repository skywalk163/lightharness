# test_R72_C_推导式.light —— R72任务C 测试
# 验证列表/字典/集合推导式完善性
# 覆盖：基础推导、条件过滤（如果/若）、多重遍历、嵌套推导、遍历关键字变体（之/在/于/中的）、
#       中文循环变量、推导式作函数参数、复杂表达式、空可迭代、范围推导、字符串遍历、链式调用

段落 断言等于 接收 实际, 期望, 标签 = "":
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ✓ " + 标签

段落 断言真 接收 条件, 标签 = "":
  如果 条件 != 真:
    抛出 "断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件)
  打印 "  ✓ " + 标签

段落 主:
  打印 "===== R72-C 列表/字典/集合推导式测试 ====="

  # §1 列表推导基础
  打印 "--- §1 列表推导基础 ---"
  断言等于([x * x 遍历 x 之 [1, 2, 3]], [1, 4, 9], "1a 基础列表推导")
  断言等于([x + 1 遍历 x 之 范围(5)], [1, 2, 3, 4, 5], "1b 范围列表推导")
  断言等于([x 遍历 x 之 [10, 20, 30]], [10, 20, 30], "1c 恒等列表推导")

  # §2 列表推导条件过滤
  打印 "--- §2 列表推导条件过滤 ---"
  断言等于([x 遍历 x 之 范围(10) 如果 x % 2 == 0], [0, 2, 4, 6, 8], "2a 条件用'如果'")
  断言等于([x 遍历 x 之 范围(10) 若 x % 2 == 0], [0, 2, 4, 6, 8], "2b 条件用'若'")
  断言等于([x 遍历 x 之 范围(20) 如果 x > 10 且 x < 15], [11, 12, 13, 14], "2c 复合条件")
  断言等于([x 遍历 x 之 [1, 2, 3] 如果 假], [], "2d 条件全假")
  断言等于([x 遍历 x 之 [1, 2, 3] 如果 真], [1, 2, 3], "2e 条件全真")

  # §3 字典推导基础
  打印 "--- §3 字典推导基础 ---"
  断言等于({x: x*x 遍历 x 之 [1, 2, 3]}, {1: 1, 2: 4, 3: 9}, "3a 基础字典推导")
  断言等于({c: c + c 遍历 c 之 "abc"}, {"a": "aa", "b": "bb", "c": "cc"}, "3b 字符串键字典推导")
  断言等于({x: x * 2 遍历 x 之 范围(3)}, {0: 0, 1: 2, 2: 4}, "3c 范围字典推导")

  # §4 字典推导条件过滤
  打印 "--- §4 字典推导条件过滤 ---"
  断言等于({x: x*x 遍历 x 之 范围(5) 如果 x % 2 == 0}, {0: 0, 2: 4, 4: 16}, "4a 字典推导条件用'如果'")
  断言等于({x: x*x 遍历 x 之 范围(5) 若 x % 2 == 0}, {0: 0, 2: 4, 4: 16}, "4b 字典推导条件用'若'")
  断言等于({x: x 遍历 x 之 [1, 2, 3] 如果 x > 5}, {}, "4c 字典推导条件全假")

  # §5 集合推导式
  打印 "--- §5 集合推导式 ---"
  设 s1 为 {x * x 遍历 x 之 [1, 2, 2, 3, 3, 3]}
  断言等于(长(s1), 3, "5a 集合推导去重")
  断言等于(排序列表(s1), [1, 4, 9], "5b 集合推导内容正确")
  设 s2 为 {x 遍历 x 之 范围(5) 如果 x % 2 == 0}
  断言等于(长(s2), 3, "5c 集合推导条件过滤")
  断言等于(排序列表(s2), [0, 2, 4], "5d 集合推导条件内容")

  # §6 多重遍历
  打印 "--- §6 多重遍历 ---"
  断言等于([x + y 遍历 x 之 ["a", "b"] 遍历 y 之 ["1", "2"]], ["a1", "a2", "b1", "b2"], "6a 双重遍历")
  断言等于([x + y + z 遍历 x 之 ["a"] 遍历 y 之 ["b"] 遍历 z 之 ["c"]], ["abc"], "6b 三重遍历")
  断言等于([x * y 遍历 x 之 范围(4) 遍历 y 之 范围(4) 如果 x == y], [0, 1, 4, 9], "6c 多重遍历带条件")
  断言等于([x + 文本(n) 遍历 x 之 ["a", "b"] 遍历 n 之 范围(2)], ["a0", "a1", "b0", "b1"], "6d 多重遍历不同类型")

  # §7 嵌套推导
  打印 "--- §7 嵌套推导 ---"
  断言等于([[i * j 遍历 j 之 范围(3)] 遍历 i 之 范围(3)], [[0, 0, 0], [0, 1, 2], [0, 2, 4]], "7a 二维矩阵推导")
  断言等于([[x 遍历 x 之 范围(2)] 遍历 y 之 范围(2)], [[0, 1], [0, 1]], "7b 嵌套恒等推导")

  # §8 遍历关键字变体
  打印 "--- §8 遍历关键字变体 ---"
  断言等于([x * x 遍历 x 在 [1, 2, 3]], [1, 4, 9], "8a 列表推导用'在'")
  断言等于([x * x 遍历 x 于 [1, 2, 3]], [1, 4, 9], "8b 列表推导用'于'")
  断言等于([x * x 遍历 x 中的 [1, 2, 3]], [1, 4, 9], "8c 列表推导用'中的'")
  断言等于({x: x*x 遍历 x 在 [1, 2, 3]}, {1: 1, 2: 4, 3: 9}, "8d 字典推导用'在'")
  断言等于({x: x*x 遍历 x 于 [1, 2, 3]}, {1: 1, 2: 4, 3: 9}, "8e 字典推导用'于'")
  断言等于({x: x*x 遍历 x 中的 [1, 2, 3]}, {1: 1, 2: 4, 3: 9}, "8f 字典推导用'中的'")

  # §9 中文循环变量
  打印 "--- §9 中文循环变量 ---"
  断言等于([项 * 项 遍历 项 之 [1, 2, 3]], [1, 4, 9], "9a 单字中文变量")
  断言等于([元素 * 2 遍历 元素 之 [1, 2, 3]], [2, 4, 6], "9b 双字中文变量")
  断言等于({键: 值 遍历 键, 值 之 [["a", 1], ["b", 2]]}, {"a": 1, "b": 2}, "9c 双目标中文变量")

  # §10 推导式作函数参数
  打印 "--- §10 推导式作函数参数 ---"
  断言等于(求和([x 遍历 x 之 范围(5)]), 10, "10a 列表推导作求和参数")
  断言等于(长([x 遍历 x 之 范围(100)]), 100, "10b 列表推导作长度参数")
  断言等于(最大值([x * x 遍历 x 之 范围(5)]), 16, "10c 列表推导作最大值参数")
  断言等于(最小值([x 遍历 x 之 范围(5, 10)]), 5, "10d 列表推导作最小值参数")

  # §11 复杂表达式与方法调用
  打印 "--- §11 复杂表达式与方法调用 ---"
  断言等于([x * 2 + 1 遍历 x 之 范围(5) 如果 x > 1], [5, 7, 9], "11a 复杂表达式+条件")
  断言等于([w.长度() 遍历 w 之 ["hello", "world", "test"]], [5, 5, 4], "11b 推导式中调用方法")
  断言等于([x 遍历 x 之 范围(5)].长度(), 5, "11c 推导式结果链式调用")

  # §12 空可迭代与边界情况
  打印 "--- §12 空可迭代与边界情况 ---"
  断言等于([x 遍历 x 之 []], [], "12a 空列表推导")
  断言等于({x: x 遍历 x 之 []}, {}, "12b 空字典推导")
  断言等于({x 遍历 x 之 []}, 集合(), "12c 空集合推导")
  断言等于([x 遍历 x 之 [42]], [42], "12d 单元素列表推导")
  断言等于({x: x 遍历 x 之 [42]}, {42: 42}, "12e 单元素字典推导")

  # §13 推导式引用外部变量
  打印 "--- §13 推导式引用外部变量 ---"
  设 倍数 为 3
  断言等于([x * 倍数 遍历 x 之 [1, 2, 3]], [3, 6, 9], "13a 引用外部数值变量")
  设 前缀 为 "item_"
  断言等于([前缀 + 文本(x) 遍历 x 之 范围(3)], ["item_0", "item_1", "item_2"], "13b 引用外部字符串变量")

  # §14 字符串遍历推导
  打印 "--- §14 字符串遍历推导 ---"
  断言等于([c 遍历 c 之 "abc"], ["a", "b", "c"], "14a 字符串字符推导")
  断言等于([c + c 遍历 c 之 "ab"], ["aa", "bb"], "14b 字符串字符变换推导")

  打印 ""
  打印 "===== R72-C 推导式全部测试通过 ====="
