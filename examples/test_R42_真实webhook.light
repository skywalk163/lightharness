# test_R42_真实webhook.light —— 第42轮 任务2 验收（真实webhook端点）
#
# 运行：cd lightharness && python 运行.py examples/test_R42_真实webhook.light
# 退出码 0 = 全部断言通过。
#
# 覆盖：
#   - 本机起 web服务器 → POST /webhook/github（本地 HMAC sha256 签发）→ 202 + 派发一次；
#   - 错误签名 → 401；
#   - 非 POST（GET）→ 405；
#   - 超大 body（超 体上限）→ 413；
#   - 秘密未配置 → 503；
#   - 安全铁律继承：非 loopback + token，无 token → 401，带 token + 好签名 → 202；
#     非 loopback 无 token → 配置阶段拒绝启动（抛错）。
#
# 说明：真实 POST 需自定义 X-Hub-Signature-256 / X-GitHub-Delivery / X-GitHub-Event 头，
#   R41 真实HTTP客户端 的固定头不覆盖，故本测试内自带一个「非阻塞 + 探测就绪 + 让步」
#   的原始 HTTP 客户端（同 R41 客户端同源手法，主协程里必须 等待 让步，否则死锁）。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 HTTP服务端 导入 处理循环, 新建选择器, 探测就绪, 是否愿等读, 是否愿等写, 关闭选择器
从 哈希 导入 HMAC_SHA256
从 JSON 导入 序列化JSON
导入 socket

# ---- 断言助手 ----
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

# ---- 异常文本（绕开 e.参数 缺陷，同 HTTP服务端.异常文本）----
段落 异常文本(e):
  设 a 为 e.args
  如果 长(a) > 0:
    返回 转字符串(a[0])
  返回 ""

# ---- 原始 HTTP 请求：非阻塞 connect/send/recv + monotonic 截止，支持自定义头 ----
异步 段落 原始请求(主机, 端口, 方法, 路径, 头行表, 体文本, 超时值):
  设 体字节 为 体文本.encode("utf-8")
  设 请求文本 为 方法 + " " + 路径 + " HTTP/1.1\r\n"
  设 请求文本 为 请求文本 + "Host: " + 主机 + "\r\n"
  遍历 行 之 头行表:
    设 请求文本 为 请求文本 + 行 + "\r\n"
  如果 体文本 != "":
    设 请求文本 为 请求文本 + "Content-Length: " + 转字符串(长(体字节)) + "\r\n"
  设 请求文本 为 请求文本 + "Connection: close\r\n\r\n"
  如果 体文本 != "":
    设 请求文本 为 请求文本 + 体文本
  设 请求字节 为 请求文本.encode("utf-8")

  设 套接字 为 socket.socket(socket.AF_INET, socket.SOCK_STREAM)
  套接字.setblocking(假)
  设 选择器 为 新建选择器()
  设 缓存 为 b""
  尝试:
    # connect：非阻塞 EINPROGRESS → 等写就绪
    尝试:
      套接字.connect((主机, 端口))
    捕获 异常 e:
      设 截止 为 单调时钟() + 超时值
      当 真:
        如果 探测就绪(选择器, 套接字, "写"):
          跳出
        如果 单调时钟() >= 截止:
          抛出 新建 错误("连接超时")
        等待 异步睡眠(0.0005)
    # send：非阻塞 send 循环
    设 偏移 为 0
    设 截止 为 单调时钟() + 超时值
    当 偏移 < 长(请求字节):
      尝试:
        设 已发 为 套接字.send(请求字节[偏移:])
        设 偏移 为 偏移 + 已发
      捕获 异常 e:
        如果 是否愿等写(e):
          如果 单调时钟() >= 截止:
            抛出 新建 错误("发送超时")
          如果 探测就绪(选择器, 套接字, "写"):
            等待 异步睡眠(0)
          否则:
            等待 异步睡眠(0.0005)
        否则:
          抛出 新建 错误("发送失败: " + 异常文本(e))
    # recv：非阻塞 recv 直到对端关闭
    设 截止 为 单调时钟() + 超时值
    当 真:
      设 块 为 空
      尝试:
        设 块 为 套接字.recv(4096)
      捕获 异常 e:
        如果 是否愿等读(e):
          如果 单调时钟() >= 截止:
            抛出 新建 错误("读取超时")
          如果 探测就绪(选择器, 套接字, "读"):
            等待 异步睡眠(0)
          否则:
            等待 异步睡眠(0.0005)
          继续
        否则:
          抛出 新建 错误("读取失败: " + 异常文本(e))
      如果 长(块) == 0:
        跳出
      设 缓存 为 缓存 + 块
    套接字.close()
  最终:
    关闭选择器(选择器)

  # 解析：状态行 + 头 + 体
  设 分隔 为 缓存.查找(b"\r\n\r\n")
  如果 分隔 < 0:
    返回 ["状态": 0, "头": "", "体": 字符串(缓存, "utf-8")]
  设 头文本 为 字符串(缓存[0:分隔], "utf-8")
  设 体 为 字符串(缓存[分隔 + 4:], "utf-8")
  设 行表 为 头文本.分割("\r\n")
  设 部分 为 行表[0].分割(" ")
  返回 ["状态": 转整数(部分[1]), "头": 头文本, "体": 体]

# ---- 构头 ----
段落 造钩子头(签名, 交付id, 事件名):
  返回 ["X-Hub-Signature-256: " + 签名, "X-GitHub-Delivery: " + 交付id, "X-GitHub-Event: " + 事件名, "Content-Type: application/json"]

# ---- 长填充（构造超大体）----
段落 造填充(个数):
  设 结果 为 ""
  设 i 为 0
  当 i < 个数:
    设 结果 为 结果 + "a"
    设 i 为 i + 1
  返回 结果

异步 段落 主测试:
  设 基 为 当前目录()
  设 秘密 为 "secret"

  # =====================================================================
  # 会话A：loopback（127.0.0.1）+ 无 token → webhook 路由全场景
  # =====================================================================
  全局服务.配置(空, 空, 基, 5.0, "", [], "", 绑定地址="127.0.0.1", 令牌="")
  全局服务.设置钩子秘密(秘密)
  全局服务.清空钩子派发()
  设 任务A 为 创建任务(处理循环(全局服务.服务端))
  设 端口A 为 全局服务.端口()
  断言真(端口A > 0, "A_内核端口已分配")

  设 体 为 序列化JSON(["action": "opened", "repository": ["name": "duan"]])
  设 好签 为 "sha256=" + HMAC_SHA256(秘密, 体)

  # --- A1：好签名 → 202 且派发一次 ---
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "POST", "/webhook/github", 造钩子头(好签, "dlv-1", "push"), 体, 5.0)
  断言相等(r["状态"], 202, "A_好签名202")
  断言相等(全局服务.钩子派发数(), 1, "A_派发一次")
  断言相等(全局服务.钩子派发记录[0]["kind"], "github", "A_投递kind")
  断言相等(全局服务.钩子派发记录[0]["event"]["name"], "push", "A_投递事件名")
  断言相等(全局服务.钩子派发记录[0]["event"]["payload"]["repository"]["name"], "duan", "A_投递载荷")
  断言相等(全局服务.钩子派发记录[0]["deliveryId"], "dlv-1", "A_投递deliveryId")

  # --- A2：错误签名 → 401 ---
  设 坏签 为 "sha256=" + HMAC_SHA256("wrong", 体)
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "POST", "/webhook/github", 造钩子头(坏签, "dlv-2", "push"), 体, 5.0)
  断言相等(r["状态"], 401, "A_错签名401")

  # --- A3：非 POST（GET）→ 405 ---
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "GET", "/webhook/github", ["Content-Type: application/json"], "", 5.0)
  断言相等(r["状态"], 405, "A_非POST405")

  # --- A4：超大 body → 413（把体上限压到 200，发 259 字节体）---
  全局服务.设置钩子体上限(200)
  设 大 为 "{\"x\":\"" + 造填充(250) + "\"}"
  设 大签 为 "sha256=" + HMAC_SHA256(秘密, 大)
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "POST", "/webhook/github", 造钩子头(大签, "dlv-3", "push"), 大, 5.0)
  断言相等(r["状态"], 413, "A_超大body413")
  全局服务.设置钩子体上限(1000000)

  # --- A5：秘密未配置 → 503 ---
  全局服务.设置钩子秘密("")
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "POST", "/webhook/github", 造钩子头(好签, "dlv-4", "push"), 体, 5.0)
  断言相等(r["状态"], 503, "A_秘密空503")
  全局服务.设置钩子秘密(秘密)

  # --- A6：普通路径不受影响（404 兜底）---
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "GET", "/nope", [], "", 5.0)
  断言相等(r["状态"], 404, "A_未知路径404")

  # --- A7：与宿主标准 HMAC-SHA256 对拍（互操作性；真实 GitHub 签名同标准）---
  #   外签由 Python hmac.new(b"secret", b'{"action":"opened"}', sha256) 外部算出（RFC 2104），
  #   非本链路生成 —— 端点接受它 → 可与真实 GitHub X-Hub-Signature-256 对拍（报告 §四）。
  全局服务.清空钩子派发()
  设 外体 为 "{\"action\":\"opened\"}"
  设 外签 为 "sha256=d42142b53efbc7cf5cd20b6e074eb33707e0de3b368f698e6d6f6c824ffb8d37"
  设 r 为 等待 原始请求("127.0.0.1", 端口A, "POST", "/webhook/github", 造钩子头(外签, "dlv-7", "push"), 外体, 5.0)
  断言相等(r["状态"], 202, "A_外部标准签名202")
  断言相等(全局服务.钩子派发数(), 1, "A_外部签名派发一次")

  全局服务.停止()

  # =====================================================================
  # 会话B：非 loopback（0.0.0.0）+ token → 继承 R41 令牌门禁
  # =====================================================================
  设 令牌B 为 "r42-hook-token"
  全局服务.配置(空, 空, 基, 5.0, "", [], "", 绑定地址="0.0.0.0", 令牌=令牌B)
  全局服务.设置钩子秘密(秘密)
  全局服务.清空钩子派发()
  设 任务B 为 创建任务(处理循环(全局服务.服务端))
  设 端口B 为 全局服务.端口()
  断言真(端口B > 0, "B_内核端口已分配")

  # --- B1：无 token → 401（R41 门禁先于 webhook）---
  设 r 为 等待 原始请求("127.0.0.1", 端口B, "POST", "/webhook/github", 造钩子头(好签, "dlv-5", "push"), 体, 5.0)
  断言相等(r["状态"], 401, "B_无token401")

  # --- B2：带 token + 好签名 → 202 ---
  设 全头 为 造钩子头(好签, "dlv-6", "push")
  全头.追加("X-Auth-Token: " + 令牌B)
  设 r 为 等待 原始请求("127.0.0.1", 端口B, "POST", "/webhook/github", 全头, 体, 5.0)
  断言相等(r["状态"], 202, "B_带token好签名202")
  断言相等(全局服务.钩子派发数(), 1, "B_派发一次")

  全局服务.停止()

  # =====================================================================
  # 会话C：安全铁律继承 —— 非 loopback 无 token → 配置阶段拒启动
  # =====================================================================
  设 拒 为 假
  尝试:
    全局服务.配置(空, 空, 基, 5.0, "", [], "", 绑定地址="0.0.0.0", 令牌="")
  捕获 异常 e:
    设 拒 为 真
  断言真(拒, "C_非loopback无token_拒绝启动")

  写 "任务2 全部断言通过（真实webhook：好签名202派发/错签名401/非POST405/超大413/秘密空503；非loopback令牌门禁继承 rc=0）\n"

异步 运行 主测试()
