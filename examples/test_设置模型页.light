# test_设置模型页.light —— R107 任务线 A：设置页「模型」子页真实化 判据
#
# 上游：ui-settings-models/src/client/locales.ts zh 段（125-219 逐字）+ ModelsSection.tsx:385-702
# 本仓：src/设置模型页.light（唯一数据权威）；只读复用 客户端/模型信息。
# 运行：cd lightharness && PYTHONUTF8=1 python 运行.py examples/test_设置模型页.light
# 反跑：把 设置模型页.校验模型行 的「id 重复」判定去掉 → 6b 用例必须红；用 cp 备份还原后复跑绿
#   （⛔ 禁止 git checkout -- src/设置模型页.light，会丢本轮未提交改动）。

从 设置模型页 导入 文案表, 凭据视图, 提供商行集, 模型行集, 模型目录继承
从 设置模型页 导入 协议选项, 模型选项区, 校验模型行, 校验密钥, 渲染模型页
从 客户端 导入 取模型目录, 按ID取模型
从 内置核心字典 导入 字典包含键, 字典键列表, 字典设置
从 内置核心列表 导入 列表创建, 列表追加, 列表长度
从 内置核心转换 导入 转字符串

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  打印 "===== R107 任务线 A：设置页「模型」子页真实化 ====="

  # ---- §1 凭据视图（CredentialInfo 三键，永不回显） ----
  设 元数据一 为 {"has_key": 1, "mock": 0, "model": "deepseek-flash", "endpoint": "https://api.deepseek.com", "configured": 1}
  设 视图一 为 凭据视图(元数据一)
  断言相等(视图一["configured"], 真, "1a 有密钥 → configured 真")
  设 元数据二 为 {"has_key": 0, "mock": 1, "model": "", "endpoint": ""}
  设 视图二 为 凭据视图(元数据二)
  断言相等(视图二["configured"], 假, "1b 无密钥 → configured 假")
  设 视图键 为 字典键列表(视图一)
  断言相等(列表长度(视图键), 3, "1c 返回恰三键（不含任何明文槽）")
  断言真(字典包含键(视图一, "configured") 且 字典包含键(视图一, "source") 且 字典包含键(视图一, "writable"), "1c2 三键名逐字")
  设 元数据三 为 {"has_key": 1, "writable": 0}
  设 视图三 为 凭据视图(元数据三)
  断言相等(视图三["writable"], 假, "1d 宿主显式 writable=0 → 假；有密钥默认 source=file")
  断言相等(视图三["source"], "file", "1d2 有密钥且无显式 source → file（T-2）")

  # ---- §2 提供商行集（单提供商，取舍 T-1） ----
  设 行集 为 提供商行集(元数据一)
  断言相等(列表长度(行集), 1, "2a 单提供商单行")
  设 行 为 行集[0]
  设 期望键 为 ["provider", "显示名", "自定义", "命名空间", "设置路径", "凭据", "可删除", "错误"]
  遍历 键 之 期望键:
    断言真(行.包含(键), "2a2 提供商行含键 " + 键)
  断言相等(行["provider"], "deepseek-official", "2b provider 固定 deepseek-official")
  断言相等(行["显示名"], "DeepSeek", "2b2 显示名 DeepSeek")
  断言相等(行["命名空间"], "llm-deepseek", "2c 命名空间 llm-deepseek")
  断言真(行["可删除"] == 假 且 行["自定义"] == 假 且 行["错误"] == "", "2d 可删除假/自定义假/错误空")
  断言相等(行["凭据"]["configured"], 真, "2e 凭据随元数据已配置")

  # ---- §3 模型行集（目录 4 条投影） ----
  设 目录行 为 模型行集(元数据一)
  断言相等(列表长度(目录行), 4, "3a 模型行 = 目录 4 条")
  设 期望序 为 列表创建()
  列表追加(期望序, "deepseek-flash")
  列表追加(期望序, "deepseek-v4-flash")
  列表追加(期望序, "deepseek-v4-pro")
  列表追加(期望序, "deepseek-v4-flash-vision-exp")
  设 实际序 为 列表创建()
  遍历 条目 之 目录行:
    列表追加(实际序, 条目["id"])
  断言相等(实际序, 期望序, "3b id 序与目录一致")
  设 行键 为 ["id", "name", "上下文窗口", "最大输出", "输入类型"]
  遍历 条目 之 目录行:
    遍历 键 之 行键:
      断言真(条目.包含(键), "3c 模型行含键 " + 键)
  断言相等(目录行[0]["name"], "DeepSeek-V41-Flash", "3c2 首行 name 投影")
  设 全部空输出 为 真
  遍历 条目 之 目录行:
    如果 条目["最大输出"] != 空:
      设 全部空输出 为 假
  断言真(全部空输出, "3d 本仓目录无 maxTokens → 最大输出 全 空（上游：使用提供商默认值）")
  设 期望flash输入 为 ["text", "image"]
  断言相等(目录行[0]["输入类型"], 期望flash输入, "3e flash 输入类型 text+image")

  # ---- §4 协议选项（存储键 api，标签逐字） ----
  设 选项 为 协议选项()
  断言相等(列表长度(选项), 3, "4a 协议选项 3 条")
  断言相等(选项[0]["值"], "openai-completions", "4b 值 openai-completions")
  断言相等(选项[0]["标签"], "OpenAI Chat Completions", "4c 标签逐字一")
  断言相等(选项[1]["标签"], "OpenAI Responses", "4d 标签逐字二")
  断言相等(选项[2]["标签"], "Anthropic Messages", "4e 标签逐字三")

  # ---- §5 模型选项区（上游 modelAdvanced 展开区内容） ----
  设 flash条目 为 按ID取模型("deepseek-flash")
  断言真(flash条目 != 空, "5a 目录命中 deepseek-flash")
  设 区 为 模型选项区(flash条目)
  断言相等(区["上下文窗口"], 1000000, "5b 上下文窗口 1000000")
  断言相等(区["最大输出"], 空, "5c 最大输出 缺失 → 空")
  设 期望输入 为 ["text", "image"]
  断言相等(区["输入类型"], 期望输入, "5d 输入类型 text+image")
  断言相等(列表长度(区["推理努力表"]), 4, "5e 推理努力表 4 条")
  断言相等(区["默认努力"], "high", "5f 默认努力 high")

  # ---- §6 校验模型行（消息逐字，含末尾句号） ----
  设 空id行 为 {"id": "", "上下文窗口": 1000000}
  设 判一 为 校验模型行(空id行, 目录行)
  断言相等(判一["合法"], 假, "6a 空 id 非法")
  断言相等(判一["消息"], "模型 ID 不能为空。", "6a2 逐字：模型 ID 不能为空。")
  设 重复行 为 {"id": "deepseek-flash", "上下文窗口": 1000000}
  设 判二 为 校验模型行(重复行, 目录行)
  断言相等(判二["合法"], 假, "6b 重复 id 非法（反跑锚点：删此判定则本条红）")
  断言相等(判二["消息"], "模型 ID 不能重复。", "6b2 逐字：模型 ID 不能重复。")
  设 坏窗口行 为 {"id": "m1", "上下文窗口": "abc"}
  设 判三 为 校验模型行(坏窗口行, 目录行)
  断言相等(判三["消息"], "上下文窗口必须是正数，例如 131072、256K 或 1M。", "6c 逐字：上下文窗口必须是正数…")
  设 负窗口行 为 {"id": "m1", "上下文窗口": -1}
  断言相等(校验模型行(负窗口行, 目录行)["合法"], 假, "6c2 负数窗口非法")
  设 坏输出行 为 {"id": "m1", "上下文窗口": 1000000, "最大输出": 0}
  设 判四 为 校验模型行(坏输出行, 目录行)
  断言相等(判四["消息"], "最大输出 token 数必须是正数，例如 8192、64K 或 1M。", "6d 逐字：最大输出 token 数必须是正数…")
  设 好行 为 {"id": "m1", "上下文窗口": "256K", "最大输出": 8192}
  设 判五 为 校验模型行(好行, 目录行)
  断言相等(判五["合法"], 真, "6e 合法行通过（256K 后缀解析，T-6）")
  断言相等(判五["消息"], "", "6e2 合法行消息空")

  # ---- §7 校验密钥（永不回显；留空=保持已存） ----
  设 判密一 为 校验密钥("", 真)
  断言相等(判密一["合法"], 真, "7a 空且已有 → 合法（上游约定：留空=保持已存）")
  设 判密二 为 校验密钥("", 假)
  断言相等(判密二["合法"], 假, "7b 空且未有 → 非法")
  断言相等(判密二["消息"], "请输入 API 密钥；若该提供商以其他方式鉴权，可以留空。", "7b2 逐字：keyBlankNew")
  设 判密三 为 校验密钥("sk bad key", 假)
  断言相等(判密三["合法"], 假, "7c 含空白 → 非法（T-5）")
  断言相等(判密三["消息"], "该 API 密钥格式错误，请检查。", "7c2 逐字：格式错误消息")
  设 判密四 为 校验密钥("sk-abc123XYZ", 假)
  断言相等(判密四["合法"], 真, "7d 正常密钥合法")
  设 判密五 为 校验密钥("sk-abc123XYZ", 真)
  断言相等(列表长度(字典键列表(判密五)), 2, "7e 校验结论只含 合法/消息 两键（无值槽）")

  # ---- §8 渲染模型页（整页七键） ----
  设 页 为 渲染模型页(元数据一)
  设 页键 为 ["说明", "只读", "提供商行", "模型行", "模型目录继承", "可用提供商", "协议选项"]
  遍历 键 之 页键:
    断言真(页.包含(键), "8a 整页含键 " + 键)
  断言相等(列表长度(页键), 7, "8a2 七键")
  设 空页 为 渲染模型页(元数据二)
  断言真(空页["只读"] == 假, "8b 未配置 → 只读=假")
  断言相等(空页["提供商行"][0]["凭据"]["configured"], 假, "8b2 未配置 → 凭据.configured=假（前端红点依据）")
  断言相等(空页["模型目录继承"], 真, "8b3 未自定义 → 模型目录继承=真")
  设 页二 为 渲染模型页(元数据一)
  断言相等(页二["提供商行"][0]["凭据"]["configured"], 真, "8c 已配置 → 凭据.configured=真")
  断言相等(页二["说明"], "填入各提供商的 API 密钥即可使用其模型。", "8d 说明逐字 = 上游 intro")

  # ---- §9 文案逐字（上游 locales.ts zh 原串） ----
  设 表 为 文案表()
  断言相等(表["intro"], "填入各提供商的 API 密钥即可使用其模型。", "9a intro 逐字（:128）")
  断言相等(表["keyStored"], "已配置——输入新值可替换", "9b keyStored 逐字（:161）")
  断言相等(表["modelsInherited"], "正在使用适配器默认模型", "9c modelsInherited 逐字（:169）")
  断言相等(表["addModel"], "添加模型", "9d addModel 逐字（:184）")
  断言相等(表["readOnly"], "当前部署的设置文档为只读。", "9e readOnly 逐字（:154）")
  断言相等(表["advancedHint"], "其余字段在 cordis.patch.yml 中，请直接编辑对应段。", "9f advancedHint 逐字（:195）")
  断言相等(表["modelAdvanced"], "模型选项", "9g modelAdvanced 逐字（:180）")
  断言相等(表["customApi"], "API 协议", "9h customApi 逐字（:215，存储键为 api，无 protocol）")

  # ---- §10 目录只读复用一致性（不另造数据） ----
  断言相等(列表长度(页["模型行"]), 列表长度(取模型目录()), "10a 模型行数 == 目录数")

  打印 "test_设置模型页 PASS（39+ 断言全绿）"

主()
