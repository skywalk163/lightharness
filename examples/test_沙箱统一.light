# test_沙箱统一.light —— R69 子任务 69.4：沙箱统一入口测试
#
# 验证：约束() 结构、danger-full-access 逃生口、fail-closed/已实现分支、升级辅助。
# 运行：cd lightharness && python 运行.py examples/test_沙箱统一.light
#
# R86 方案 b：freebsd-jail / landlock / rlimits 已实现约束执行；
# windows-acl / seatbelt 等未实现 → fail-closed（测试按各自平台分支验证）。

从 沙箱统一 导入 约束, 运行, 请求升级, 需要升级
从 沙箱探测 导入 当前平台, 探测可用后端
导入 sys, os

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言包含(文本, 片段, 标签):
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段 + "；实际=" + 文本[0:200]

段落 主:
  设 平台 为 当前平台()
  打印("当前平台: " + 平台)

  # ============================================================
  # 1) 约束() 返回有效结构（普通策略）
  # ============================================================
  设 策略1 为 ["模式": "read-only", "工作区根": "/tmp/test-sandbox"]
  # R86 收口：jail（freebsd-jail）的 nullfs 挂载源目录必须存在，否则 dsh-jail-run
  # 报 runner_failure（Windows/Linux rlimits 不依赖目录故不暴露）。统一建目录再跑。
  os.makedirs(策略1["工作区根"], exist_ok=True)
  设 约束1 为 约束(["echo", "hello"], 策略1)
  断言真("后端" 在 约束1, "约束结果含 后端 字段")
  断言真("执行强度" 在 约束1, "约束结果含 执行强度 字段")
  断言真("argv" 在 约束1, "约束结果含 argv 字段")
  断言真("策略" 在 约束1, "约束结果含 策略 字段")
  断言真("已实现" 在 约束1, "约束结果含 已实现 字段")
  断言真("是逃生口" 在 约束1, "约束结果含 是逃生口 字段")
  断言相等(约束1["是逃生口"], 假, "普通策略不是逃生口")
  打印("约束后端: " + 约束1["后端"] + " 已实现=" + 转字符串(约束1["已实现"]))

  # ============================================================
  # 2) danger-full-access 逃生口
  # ============================================================
  设 策略2 为 ["模式": "danger-full-access", "工作区根": "/tmp"]
  设 约束2 为 约束(["echo", "no-sandbox"], 策略2)
  断言相等(约束2["后端"], "none", "逃生口后端为 none")
  断言相等(约束2["是逃生口"], 真, "danger-full-access 是逃生口")
  断言相等(约束2["已实现"], 真, "逃生口已实现（直跑）")
  断言相等(约束2["argv"], ["echo", "no-sandbox"], "逃生口 argv 为原始命令")

  # ============================================================
  # 3) fail-closed / 已实现分支：未实现后端的 运行() 抛错，已实现后端真执行
  # ============================================================
  设 已实现集合 为 ["freebsd-jail", "landlock", "rlimits"]
  设 后端名3 为 约束1["后端"]
  设 后端已实现 为 假
  遍历 b 之 已实现集合:
    如果 后端名3 == b:
      后端已实现 为 真
  如果 后端已实现:
    # 已实现后端（freebsd-jail / landlock / rlimits）：运行() 应真执行并成功
    设 运行结果3 为 运行(["echo", "hello"], 策略1, 5000)
    断言相等(运行结果3["分类"], "success", "已实现后端 运行() 成功")
    打印("已实现后端 " + 后端名3 + " 真执行通过（fail-closed 不触发）")
  否则:
    # 未实现后端（seatbelt / windows-acl 等）：fail-closed，运行() 抛错
    设 抛错 为 假
    设 错误消息 为 ""
    尝试:
      运行(["echo", "hello"], 策略1, 5000)
    捕获 错误:
      抛错 为 真
      错误消息 为 转字符串(错误)
    断言真(抛错, "未实现后端 运行() 应 fail-closed 抛错")
    断言包含(错误消息, "未完全实现", "错误消息含 未完全实现")
    打印("fail-closed 验证通过: " + 错误消息[0:80])

  # ============================================================
  # 4) 升级辅助：需要升级()
  # ============================================================
  # read-only → workspace-write 是严格更宽
  设 需要1 为 需要升级(["模式": "read-only", "工作区根": "/tmp"], "workspace-write")
  断言真(需要1, "read-only → workspace-write 需要升级")

  # read-only → read-only 不是更宽
  设 需要2 为 需要升级(["模式": "read-only", "工作区根": "/tmp"], "read-only")
  断言真(需要2 == 假, "read-only → read-only 不需要升级")

  # ============================================================
  # 5) 升级辅助：请求升级() 构造有效请求
  # ============================================================
  设 升级请求 为 请求升级(["模式": "read-only", "工作区根": "/tmp"], "workspace-write", "需要写临时文件", "command")
  断言真(升级请求 != 空, "请求升级返回非空")
  断言真("目标类型" 在 升级请求, "升级请求含 目标类型 字段")
  断言相等(升级请求["目标类型"], "wider-modes", "wider-modes 升级目标类型为 wider-modes")
  断言相等(升级请求["目标模式"], "workspace-write", "升级目标模式为 workspace-write")
  断言相等(升级请求["当前模式"], "read-only", "升级请求当前模式为 read-only")

  # 请求升级 对不更宽的模式抛错
  设 升级抛错 为 假
  尝试:
    请求升级(["模式": "workspace-write", "工作区根": "/tmp"], "read-only", "降级", "command")
  捕获 错误:
    升级抛错 为 真
  断言真(升级抛错, "请求升级 对不更宽的模式抛错")

  # ============================================================
  # 6) FreeBSD 平台特定：约束应返回已实现的 freebsd-jail
  # ============================================================
  如果 平台 == "freebsd":
    断言相等(约束1["后端"], "freebsd-jail", "FreeBSD 上选中 freebsd-jail")
    断言相等(约束1["已实现"], 真, "FreeBSD 上 freebsd-jail 已实现")
    断言真(长度(约束1["argv"]) > 0, "FreeBSD 上约束 argv 非空")
    # argv 首项应为 dsh-jail-run 二进制路径
    断言包含(约束1["argv"][0], "dsh-jail-run", "argv 首项含 dsh-jail-run")
    打印("FreeBSD 约束 argv[0]: " + 约束1["argv"][0])

  # ============================================================
  # 7) R86 方案 b：partial 档位（landlock/rlimits）e2e——约束命令/超时/资源限制三态
  #    仅 Linux 实测（0.86）；Windows 无 resource 模块、选 windows-acl，跳过。
  # ============================================================
  如果 平台 == "linux":
    断言相等(约束1["已实现"], 真, "Linux 上约束后端已实现（landlock 或 rlimits）")
    断言真(约束1["后端"] == "landlock" 或 约束1["后端"] == "rlimits", "Linux 上选中 landlock 或 rlimits")
    断言真(长度(约束1["argv"]) >= 3, "Linux 上约束 argv 非空")
    # argv 首项为包装解释器（sys.executable），第二项为 -c（包装代码模式）
    断言包含(转字符串(约束1["argv"][0]), "python", "约束 argv 首项为 python 解释器")
    断言相等(约束1["argv"][1], "-c", "约束 argv 第二项为 -c")
    断言相等(约束1["无网络"], 真, "landlock/rlimits 档位声明 无网络=真（对齐 landlock 语义）")

    # 三态 1：约束命令真执行（包装进程 setrlimit 后 exec 原命令）
    设 r1 为 运行(["echo", "rlimits-e2e-ok"], 策略1, 5000)
    断言相等(r1["分类"], "success", "e2e-1 约束命令真执行 success")
    断言包含(r1["执行结果"].标准输出, "rlimits-e2e-ok", "e2e-1 标准输出含命令输出")
    打印("e2e-1 约束命令真执行: success")

    # 三态 2：超时（sleep 30s + 1000ms 超时 → 是否超时=真）
    设 r2 为 运行(["sleep", "30"], 策略1, 1000)
    断言相等(r2["执行结果"].是否超时, 真, "e2e-2 超时触发（sleep 30 超 1000ms）")
    打印("e2e-2 超时: 触发")

    # 三态 3：资源限制（包装代码 RLIMIT_AS=512MB 限制下大内存分配应被拒）
    #   bytearray(1GB) 超出 AS 硬限 → MemoryError，命令快速非 0 退出（不依赖 CPU 硬限等待）
    设 r3 为 运行([sys.executable, "-c", "x = bytearray(1073741824)"], 策略1, 15000)
    断言真(r3["执行结果"].退出码 != 0, "e2e-3 资源限制生效（1GB 分配超 AS 硬限被拒）")
    打印("e2e-3 资源限制: AS 硬限生效（退出码=" + 转字符串(r3["执行结果"].退出码) + "）")
  否则:
    打印("R86 方案 b e2e 跳过（平台 " + 平台 + " 非 Linux，选 " + 后端名3 + "）")

  打印("test_沙箱统一 全部断言通过（7 组 / 约束结构+逃生口+已实现分支+需要升级+请求升级+平台特定+R86 b e2e）")
