# test_文件系统工具.light —— 第14轮 任务1（fs 工具域）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_文件系统工具.light
# 上游：packages/fs/tool-fs/src/（11 文件）
#
# 覆盖：错误族文案 / read 参数校验与行范围 / 渲染 envelope 与 footer 三态 / 行截断与字节预算 /
#   语言映射 / read-image 扩展名声明+字节嗅探+元数据形状 / write 校验与 create-update 信封 /
#   edit 校验与多命中策略与确认文案 / diff LCS（无变化/替换/插入/删除/独立块/FileDiff）/ 呈现形状
#
# 反跑判据（改反源码任一期望测试必须红）：
#   A. 行差分表 LCS 匹配条件失效（不再计算公共子序列）-> 无变化空差异/上下文行断言红
#   B. 施加编辑 多命中条件放宽 -> 多命中抛错断言红
#   C. 解析读参数 上界校验放宽 -> limit 超上限抛错断言红

从 文件系统工具 导入 提示读错误, 守卫编辑前提, 解析读参数, 判读目标, 造读窗口, 渲染读输出, 语言自路径, 图媒体类型, 造图元数据, 渲染图输出, 判写参数, 写操作判定, 写后信封, 校验编辑参数, 施加编辑, 编辑后文案, 行差分表, 差异到文件差异, 渲染统一差异文本, 呈现读调用, 呈现写调用, 呈现编辑调用, 执行读命令, 执行写命令, 执行编辑命令

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含 接收 文本, 子串, 标签:
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 检查抛错含 接收 标签, 子串, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    设 忽略 为 运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 内存文件系统宿主 ----------
段落 造宿主:
  设 文件表 为 {}  # 抑制L166
  设 版本表 为 {}
  设 已观察快照 为 {}  # 抑制L166
  段落 查信息 接收 路径:
    如果 字典包含键(文件表, 路径):
      返回 ["类型": "文件", "大小": 字符串长度(字典获取(文件表, 路径, "")), "版本": 字典获取(版本表, 路径, 1)]
    返回 空
  段落 读文本 接收 路径:
    返回 字典获取(文件表, 路径, "")
  段落 写文本 接收 路径, 内容:
    设 文件表[路径] 为 内容
    设 版本表[路径] 为 字典获取(版本表, 路径, 1) + 1
    返回 字典获取(版本表, 路径, 1)
  段落 读头字节 接收 路径, 字节数:
    返回 字典获取(头字节表, 路径, [])
  设 头字节表 为 {}  # 抑制L166
  返回 ["查信息": 查信息, "读文本": 读文本, "写文本": 写文本, "读头字节": 读头字节, "文件表": 文件表, "已观察": 已观察快照, "头字节表": 头字节表]

# ---------- 全局宿主与抛错闭包 ----------
设 宿主 为 造宿主()
设 文件表 为 宿主["文件表"]
设 已观察快照 为 宿主["已观察"]
设 头字节表 为 宿主["头字节表"]

段落 读空路径:
  解析读参数({"file_path": "  "}, 2000)

段落 读缺路径:
  解析读参数({}, 2000)

段落 读零偏移:
  解析读参数({"file_path": "/a", "offset": 0}, 2000)

段落 读零上限:
  解析读参数({"file_path": "/a", "limit": 0}, 2000)

段落 读超上限:
  解析读参数({"file_path": "/a", "limit": 3000}, 2000)

段落 写空路径:
  判写参数({"file_path": "", "content": "x"})

段落 写缺内容:
  判写参数({"file_path": "/a"})

段落 编辑空路径:
  校验编辑参数({"file_path": " ", "old_string": "甲", "new_string": "乙"})

段落 编辑缺旧串:
  校验编辑参数({"file_path": "/a", "new_string": "乙"})

段落 编辑等串:
  校验编辑参数({"file_path": "/a", "old_string": "同", "new_string": "同"})

段落 编辑多命中:
  施加编辑("甲乙甲乙", "甲", "丙", 假)

段落 编辑未找到:
  施加编辑("甲乙", "戊", "丙", 假)

段落 编辑未观察:
  执行编辑命令({"file_path": "/守卫.txt", "old_string": "甲", "new_string": "乙"}, 宿主)

段落 编辑不存在:
  执行编辑命令({"file_path": "/无.txt", "old_string": "甲", "new_string": "乙"}, 宿主)

段落 编辑读后被删:
  执行编辑命令({"file_path": "/删了.txt", "old_string": "甲", "new_string": "乙"}, 宿主)

段落 读不存在:
  执行读命令({"file_path": "/无.txt"}, 宿主)

段落 图坏扩展:
  图媒体类型("/i.bmp", [])

段落 图嗅探失败:
  图媒体类型("/i", [1, 2, 3, 4, 5, 6, 7, 8])

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 错误族文案 ============
  断言相等(提示读错误("FS_NOT_OBSERVED", "/f.txt", ""), "cannot modify \"/f.txt\": file has not been read — read the file, then retry", "未观察文案")
  断言相等(提示读错误("FS_STALE_VERSION", "/f.txt", "stale file version"), "stale file version — re-read the file, then retry", "版本过期文案")
  断言相等(提示读错误("其他", "/f.txt", "原样"), "原样", "其他码透传")
  断言相等(判读目标(空, "/x.txt"), "cannot read \"/x.txt\": not found", "读不存在文案")
  断言相等(判读目标(["类型": "目录"], "/x.txt"), "cannot read \"/x.txt\": not a regular file", "读目录文案")
  断言相等(判读目标(["类型": "文件"], "/x.txt"), "", "读文件放行")
  断言相等(守卫编辑前提(真, "v2", "v2", "/f")["许可"], 真, "守卫版本一致许可")
  断言相等(守卫编辑前提(真, "v1", "v2", "/f")["文案"], "stale file version — re-read the file, then retry", "守卫版本过期")

  # ============ 2) read 参数校验 ============
  检查抛错含("read 空路径应抛", "file_path must be a non-empty string", 读空路径)
  检查抛错含("read 缺路径应抛", "file_path must be a non-empty string", 读缺路径)
  检查抛错含("read 零偏移应抛", "offset must be a positive integer", 读零偏移)
  检查抛错含("read 零上限应抛", "limit must be a positive integer", 读零上限)
  检查抛错含("read 超上限应抛", "limit must be less than or equal to 2000", 读超上限)
  设 解析 为 解析读参数({"file_path": "/a"}, 2000)
  断言相等(解析["偏移"], 1, "offset 默认 1")
  断言相等(解析["上限"], 2000, "limit 默认上限")

  # ============ 3) read 窗口与渲染 ============
  设 五行 为 ["一行", "二行", "三行", "四行", "五行"]
  设 窗全 为 造读窗口(五行, 1, 2000, "/f.txt", 2000, 51200)
  断言相等(窗全["总行数"], 5, "总行数")
  断言相等(列表长度(窗全["行表"]), 5, "全量收行")
  设 输出全 为 渲染读输出("/f.txt", 窗全)
  断言含(输出全, "1: 一行", "行号渲染")
  断言含(输出全, "(End of file - total 5 lines)", "EOF 尾注")
  断言含(输出全, "<path>/f.txt</path>", "envelope 头")
  断言含(输出全, "<type>file</type>", "envelope 类型")
  设 窗窗 为 造读窗口(五行, 2, 2, "/f.txt", 2000, 51200)
  断言相等(窗窗["行表"][0]["号"], 2, "窗口首行号")
  断言相等(列表长度(窗窗["行表"]), 2, "窗口限量")
  设 输出窗 为 渲染读输出("/f.txt", 窗窗)
  断言含(输出窗, "(Showing lines 2-3 of 5. Use offset=4 to continue.)", "窗口尾注")
  # 字节预算（字节上限=6：首行 2 码点收，第二行预算超）
  设 窗预 为 造读窗口(五行, 1, 2000, "/f.txt", 2000, 6)
  断言相等(列表长度(窗预["行表"]), 2, "字节预算截行")
  断言相等(窗预["字节截断"], 真, "字节截断标记")
  设 输出截 为 渲染读输出("/f.txt", 窗预)
  断言含(输出截, "(Output capped. Showing lines 1-2. Use offset=3 to continue.)", "字节截断尾注")
  # offset 越 EOF
  设 文件表["/越界.txt"] 为 "甲"
  设 宿主["读上限"] 为 2000
  段落 读越界:
    执行读命令({"file_path": "/越界.txt", "offset": 5}, 宿主)
  检查抛错含("offset 越界应抛", "offset 5 is out of range for \"/越界.txt\" (1 lines)", 读越界)
  # 行截断（行上限=5）
  设 窗截 为 造读窗口(["超长内容行文字"], 1, 2000, "/长.txt", 5, 51200)
  断言含(窗截["行表"][0]["文本"], "... (line truncated to 5 chars)", "行截断尾注")
  # 字节预算（字节上限=6：首行 2 码点收，第二行预算超）
  设 窗预 为 造读窗口(["甲", "乙", "丙"], 1, 2000, "/b.txt", 2000, 4)
  断言相等(列表长度(窗预["行表"]), 2, "字节预算截行")
  断言相等(窗预["字节截断"], 真, "字节截断标记")

  # ============ 4) 语言映射 ============
  断言相等(语言自路径("/a/main.ts"), "ts", "ts 映射")
  断言相等(语言自路径("/a/x.PY"), "py", "大小写归一")
  断言真(语言自路径("/a/无扩展") == 空, "无扩展空")
  断言真(语言自路径("/a/.隐藏") == 空, "点文件空")

  # ============ 5) read-image ============
  断言相等(图媒体类型("/i.png", []), "image/png", "png 声明")
  断言相等(图媒体类型("/i.JPG", []), "image/jpeg", "jpg 声明大小写")
  设 文件表["/无扩展"] 为 "图"
  头字节表["/无扩展"] 为 [137, 80, 78, 71, 13, 10, 26, 10]
  断言相等(图媒体类型("/无扩展", 头字节表["/无扩展"]), "image/png", "PNG 签名嗅探")
  头字节表["/无扩展"] 为 [255, 216, 255, 224]
  断言相等(图媒体类型("/无扩展", 头字节表["/无扩展"]), "image/jpeg", "JPEG 签名嗅探")
  头字节表["/无扩展"] 为 [82, 73, 70, 70, 0, 0, 0, 0, 87, 69, 66, 80]
  断言相等(图媒体类型("/无扩展", 头字节表["/无扩展"]), "image/webp", "WEBP 签名嗅探")
  检查抛错含("不支持扩展应抛", "does not declare a supported image format", 图坏扩展)
  检查抛错含("嗅探失败应抛", "the file content is not a supported image format", 图嗅探失败)
  设 元 为 造图元数据("att-1", "image/png", 2048, 64, 32, "截图.png", 128, 64)
  断言相等(元["attachmentId"], "att-1", "附件标识")
  断言相等(元["originalDimensions"]["width"], 128, "原始尺寸")
  设 图输出 为 渲染图输出("/i.png", 造图元数据("att-1", "image/png", 2048, 64, 32, 空, 空, 空))
  断言含(图输出, "<type>image</type>", "图 envelope 类型")
  断言含(图输出, "image/png image, 64x32 px, 2048 bytes", "图说明行")
  设 图缩 为 渲染图输出("/i.png", 元)
  断言含(图缩, "downscaled from 128x64 px", "降采样后缀")

  # ============ 6) write ============
  检查抛错含("write 空路径应抛", "file_path must be a non-empty string", 写空路径)
  检查抛错含("write 缺内容应抛", "content must be a string", 写缺内容)
  断言相等(写操作判定(假), "create", "不存在为 create")
  断言相等(写操作判定(真), "update", "存在为 update")
  断言相等(写后信封("/w.txt", "create"), "<path>/w.txt</path>\n<type>file</type>\n<content>\nCreated file\n</content>", "create 信封")
  断言含(写后信封("/w.txt", "update"), "Updated file", "update 信封")
  设 写果 为 执行写命令({"file_path": "/新.txt", "content": "正文"}, 宿主)
  断言相等(写果["操作"], "create", "写新文件 create")
  断言相等(字典获取(文件表, "/新.txt", ""), "正文", "写落盘")
  设 写果2 为 执行写命令({"file_path": "/新.txt", "content": "改文"}, 宿主)
  断言相等(写果2["操作"], "update", "再写 update")

  # ============ 7) edit ============
  检查抛错含("edit 空路径应抛", "file_path must be a non-empty string", 编辑空路径)
  检查抛错含("edit 缺旧串应抛", "old_string must be a non-empty string", 编辑缺旧串)
  检查抛错含("edit 等串应抛", "old_string and new_string must differ", 编辑等串)
  设 文件表["/编.txt"] 为 "甲乙甲乙"
  已观察快照["/编.txt"] 为 1
  检查抛错含("edit 多命中应抛", "old_string matched 2 times", 编辑多命中)
  设 施全 为 施加编辑("甲乙甲乙", "甲", "丙", 真)
  断言相等(施全["内容"], "丙乙丙乙", "replace_all 全替换")
  设 施单 为 施加编辑("甲乙丙戊", "乙", "丁", 假)
  断言相等(施单["内容"], "甲丁丙戊", "唯一命中替换")
  断言相等(施加编辑("甲乙", "戊", "丙", 假)["许可"], 假, "未找到许可假")
  检查抛错含("edit 未观察应抛", "file has not been read", 编辑未观察)
  检查抛错含("edit 未读不存在应抛未观察", "file has not been read", 编辑不存在)
  # 读后被删：观察登记在 -> editText 存在性 -> NOT_FOUND
  设 文件表["/删了.txt"] 为 "甲"
  执行读命令({"file_path": "/删了.txt"}, 宿主)
  字典删除(文件表, "/删了.txt")
  检查抛错含("edit 读后被删应抛 not found", "not found", 编辑读后被删)
  断言相等(编辑后文案("/e.txt", 假), "The file /e.txt has been updated successfully.", "edit 单命中文案")
  断言相等(编辑后文案("/e.txt", 真), "The file /e.txt has been updated. All occurrences were successfully replaced.", "edit 全替换文案")
  # 集成：先读后改
  设 文件表["/流.txt"] 为 "一\n二\n三"
  执行读命令({"file_path": "/流.txt"}, 宿主)
  设 编果 为 执行编辑命令({"file_path": "/流.txt", "old_string": "二", "new_string": "贰"}, 宿主)
  断言相等(字典获取(文件表, "/流.txt", ""), "一\n贰\n三", "edit 集成落盘")
  断言相等(编果["输出"], "The file /流.txt has been updated successfully.", "edit 集成文案")
  断言相等(编果["差异"][0]["newText"], "一\n贰\n三", "edit 差异新文本")

  # ============ 8) diff（LCS 行级） ============
  断言相等(行差分表("a\nb", "a\nb"), [], "无变化空差异")
  设 块1 为 行差分表("甲\n乙\n丙\n丁\n戊\n己\n庚\n辛", "甲\n乙\n改\n丁\n戊\n己\n庚\n辛")
  断言相等(列表长度(块1), 1, "单替换单块")
  断言相等(块1[0]["前起"], 1, "块前起含上下文")
  断言相等(块1[0]["行表"], [" 甲", " 乙", "-丙", "+改", " 丁", " 戊", " 己"], "替换行与上下文行")
  设 块2 为 行差分表("一\n二\n三", "一\n加\n二\n三\n四")
  断言相等(渲染统一差异文本("/g.txt", 块2), "--- a//g.txt\n+++ b//g.txt\n@@ -1,3 +1,5 @@\n 一\n+加\n 二\n 三\n+四\n", "插入块统一差异")
  设 块3 为 行差分表("一\n二\n三\n四", "一\n四")
  断言含(渲染统一差异文本("/h.txt", 块3), "-二", "删除行")
  断言含(渲染统一差异文本("/h.txt", 块3), "-三", "删除行二")
  # 分散替换独立块
  设 块4 为 行差分表("改\n乙\n丙\n丁\n戊\n己\n庚\n辛\n壬", "新\n乙\n丙\n丁\n戊\n己\n庚\n辛\n壬2")
  断言相等(列表长度(块4), 2, "分散替换独立块")
  # FileDiff 形状
  设 文差 为 差异到文件差异("/x.txt", 行差分表("", "新行"))
  断言真(文差[0]["oldText"] == 空, "纯插入旧文本空")
  断言相等(文差[0]["newText"], "新行", "纯插入新文本")
  # 统一差异头省略 ,1
  设 块单 为 行差分表("头\n尾", "头\n中\n尾")
  断言含(渲染统一差异文本("/m.txt", 块单), "@@", "统一差异块头")

  # ============ 9) 呈现形状 ============
  设 形读 为 呈现读调用("/r.txt", 3, 10)
  断言相等(形读["卡片"], "generic", "read 卡片")
  断言相等(形读["种类"], "read", "read 种类")
  断言相等(形读["标题"], "Read /r.txt (3 - 12)", "read 窗口标题")
  设 形写 为 呈现写调用("/w.txt", "内容")
  断言相等(形写["卡片"], "diff", "write 卡片")
  断言相等(形写["标题"], "Write /w.txt", "write 标题")
  断言真(形写["差异"][0]["旧文本"] == 空, "write 旧文本空")
  设 形编 为 呈现编辑调用("/e.txt", "旧", "新")
  断言相等(形编["标题"], "Edit /e.txt", "edit 标题")
  断言相等(形编["差异"][0]["旧文本"], "旧", "edit 旧文本")
  断言相等(呈现编辑调用("/e.txt", "", "新")["差异"][0]["旧文本"], 空, "edit 空旧串呈 null")

  # ============ 10) read 集成（语言/输出） ============
  设 文件表["/码.py"] 为 "甲\n乙"
  设 读果 为 执行读命令({"file_path": "/码.py"}, 宿主)
  断言相等(读果["语言"], "py", "read 语言提示")
  断言含(读果["输出"], "1: 甲", "read 集成渲染")

  打印("test_文件系统工具 PASS")

主()
