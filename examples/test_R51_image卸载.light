# test_R51_image卸载.light —— R51 任务1：image/offload 事件 + 图像卸载投影
#
# 上游依据（G:\github\deepseek-harness，0.1.6-alpha.1 = 提交 ea53423b60）：
#   packages/compaction/compaction-image-offload/src/{image-offload.ts,projection.ts,project-message.ts,index.ts}
#   packages/llm/llm/src/content.ts（offloadedImageText / replaceOffloadedImages / projectOffloadedImages）
#   docs/persistence-changes/2026-09-14-image-offload.zh.md（持久化变更登记：新增 event:image/offload）
#
# 为什么是 P0：上游该变更条目明确「不认识 `image/offload` 的旧版本拒绝读取这些日志」——
#   本仓读取器必须显式认识该事件，否则 0.1.6 会话日志读不了（不是「忽略未知类型」的宽松策略）。
#
# 覆盖：
#   §1 事件词汇：已知事件类型 认识 image/offload；未知事件仍拒绝（严格校验）
#   §2 会话与嵌套 tool-result 图像节点（当前表面节点判定）
#   §3 卸载最旧图像（对齐 offloadOldestImages）：深度优先取最旧 N 个出现位置并落盘决策
#   §4 投影（对齐 imageOffloadProjection.project）：只标选中的出现位置、消息标识不变、原事件不被就地改写
#   §5 占位文本渲染（对齐 replaceOffloadedImages）：已卸载出现位置渲染为占位、未卸载原样保留
#   §6 跨事件叠加：同一 seq 可再卸载其它下标（计数包含此前已卸载的出现位置）
#   §7 无可卸载 → 返回假且不落盘
#   §8 载荷/目标原子校验（空 targets / 缺键 / 多余键 / 非表面节点 / 非输入节点 / 重复 seq / 索引越界或非严格递增）
#   §9 重复卸载与下标越界抛错；换行/无关事件不产映射
#
# 反跑判据：把任一 断言真/断言相等 的期望值改反即红；把 断言拒 的文案子串改错即红。
# 运行：cd lightharness && python 运行.py examples/test_R51_image卸载.light

从 会话 导入 新建会话
从 消息 导入 造用户消息, 造文本块, 造工具结果块, 造助手消息
从 会话格式 导入 已知事件类型, 校验事件载荷, 取事件序号, 当前表面节点
从 会话格式 导入 投影图像卸载, 投影消息产生带卸载, 卸载消息图像, 替换消息卸载占位, 校验图像卸载载荷
从 压缩 导入 卸载最旧图像
从 JSON 导入 序列化JSON

# ---- 断言助手 ----
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("反跑判据失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 (条件 == 假):
    抛出 新建 错误("反跑判据失败[" + 标签 + "]")

# 含子串（不依赖标准库，避免无参 .查找 的返回形状差异）
段落 含子串 接收 原文, 子串:
  设 n 为 长度(原文)
  设 m 为 长度(子串)
  如果 m == 0:
    返回 真
  设 i 为 0
  当 i + m <= n:
    如果 原文[i:(i+m)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

# 子串出现次数（用于数占位文本条数）
段落 数子串 接收 原文, 子串:
  设 次数 为 0
  设 n 为 长度(原文)
  设 m 为 长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 原文[i:(i+m)] == 子串:
      设 次数 为 次数 + 1
      设 i 为 i + m
    否则:
      设 i 为 i + 1
  返回 次数

# 深度优先收集图像块的 offloaded 标记（对齐上游测试的 marked()）
段落 标记序列 接收 块表:
  设 结果 为 []
  遍历 块 之 块表:
    设 种类 为 ""
    如果 是字典(块):
      设 种类 为 块.获取("type", "")
    如果 种类 == "image":
      列表追加(结果, 块.获取("offloaded", 假) == 真)
    否则如果 种类 == "tool-result":
      设 内层 为 标记序列(块["content"])
      遍历 项 之 内层:
        列表追加(结果, 项)
  返回 结果

# 造带附件的图像块（走 图像身份 的 attachment 分支）
段落 造附件图像块 接收 名:
  返回 ["type": "image",
    "attachment": ["attachmentId": "sha256:" + 名, "name": 名, "mediaType": "image/png",
      "bytes": 1, "width": 1, "height": 1]]

# 断言「给定载荷必须抛错，且异常文案含指定子串」
段落 断言拒 接收 数据, 子串, 标签, 表:
  设 文 为 ""
  尝试:
    设 占 为 校验图像卸载载荷(数据, 当前表面节点(表), 表)
    抛出 新建 错误("反跑判据失败[" + 标签 + "]：应抛错却通过")
  捕获 异常 e:
    设 文 为 转字符串(e)
  如果 含子串(文, 子串) == 假:
    抛出 新建 错误("反跑判据失败[" + 标签 + "]：文案=" + 文 + " 未含 " + 子串)

段落 主程:
  # =====================================================================
  # §1 事件词汇：认识 image/offload（P0 硬兼容）
  # =====================================================================
  断言真(已知事件类型("image/offload"), "1a_词汇表认识 image/offload")
  断言真(校验事件载荷("image/offload", ["targets": [["seq": 0, "imageIndexes": [0]]]], 真), "1b_合法载荷通过严格校验")
  设 文0 为 ""
  尝试:
    设 占 为 校验事件载荷("image/unknown", ["targets": []], 真)
    抛出 新建 错误("反跑判据失败[1c]：应抛错却通过")
  捕获 异常 e0:
    设 文0 为 转字符串(e0)
  断言真(含子串(文0, "unsupported event type"), "1c_未知事件仍被拒绝")

  # =====================================================================
  # §2 会话：系统头 + 含嵌套 tool-result 的用户消息（3 张图，深度优先 0/1/2）
  # =====================================================================
  设 会话对象 为 新建会话("r51-images", "G:/dswork")
  设 占s 为 会话对象.记录事件("system/message", ["系统": "你是有用助手", "表面操作": "append"])
  设 图1 为 造附件图像块("first")
  设 图2 为 造附件图像块("nested")
  设 图3 为 造附件图像块("third")
  设 图1原样 为 序列化JSON(图1)
  设 用户体 为 造用户消息([造文本块("看这三张图"), 图1, 造工具结果块("call-1", [图2, 造文本块("尾")], 假), 图3])
  设 事件1 为 会话对象.记录事件("user/message", 用户体)
  # 快照（副本=浅拷贝）：汇集全部事件 返回类内列表本身，后续记录会改到同一列表；
  #   本用例需要一份「未含任何 image/offload 的 0.1.5 形状日志」作对照。
  设 表 为 副本(会话对象.汇集全部事件())
  断言相等(长度(表), 2, "2a_事件数=2")
  断言相等(取事件序号(表, 事件1["序号"])["类型"], "user/message", "2b_按序号取到事件")
  断言真(列表包含(当前表面节点(表), 事件1["序号"]), "2c_用户节点是当前表面节点")
  断言相等(长度(当前表面节点(表)), 2, "2d_当前表面节点=系统头+用户消息")

  # =====================================================================
  # §3 卸载最旧图像（对齐 offloadOldestImages(session, sourceEventSeqs, count)）
  # =====================================================================
  设 结果1 为 卸载最旧图像(会话对象, [事件1["序号"]], 2)
  断言真(结果1 == 真, "3a_首次卸载返回真")
  设 表2 为 会话对象.汇集全部事件()
  断言相等(长度(表2), 3, "3b_落盘一条 image/offload")
  设 卸载事件 为 取事件序号(表2, 2)
  断言相等(卸载事件["类型"], "image/offload", "3c_事件类型正确")
  断言相等(卸载事件["数据"]["targets"][0]["seq"], 事件1["序号"], "3d_target seq 指向输入节点")
  断言相等(卸载事件["数据"]["targets"][0]["imageIndexes"], [0, 1], "3e_深度优先取最旧两个出现位置")

  # =====================================================================
  # §4 投影：只标选中出现位置 / 标识不变 / 原事件不被就地改写
  # =====================================================================
  设 覆盖表 为 投影图像卸载(表2)
  断言真(字典包含键(覆盖表, 事件1["序号"]), "4a_投影覆盖表含目标节点")
  断言相等(标记序列(覆盖表[事件1["序号"]]["content"]), [真, 真, 假], "4b_只标选中的出现位置（含嵌套 tool-result）")
  断言相等(覆盖表[事件1["序号"]]["id"], 用户体["id"], "4c_消息标识不变")
  断言相等(序列化JSON(取事件序号(表2, 事件1["序号"])), 序列化JSON(事件1), "4d_原事件不被就地改写")
  断言相等(序列化JSON(取事件序号(表2, 事件1["序号"])["数据"]["content"][1]), 图1原样, "4e_原始图像块逐字节不变")
  设 消息表 为 投影消息产生带卸载(表2)
  断言相等(长度(消息表), 2, "4f_模型可见消息=系统头+用户消息")
  断言相等(数子串(序列化JSON(消息表), "image omitted to fit request image limits"), 2, "4g_两条占位文本")
  断言真(含子串(序列化JSON(消息表), "first"), "4h_占位文本含附件身份")

  # =====================================================================
  # §5 跨事件叠加：已卸载的出现位置仍计入下标，二次卸载取到下标 2
  # =====================================================================
  设 结果2 为 卸载最旧图像(会话对象, [事件1["序号"]], 1)
  断言真(结果2 == 真, "5a_二次卸载返回真")
  设 表3 为 会话对象.汇集全部事件()
  断言相等(表3[3]["数据"]["targets"][0]["imageIndexes"], [2], "5b_二次卸载取到下标2")
  断言相等(标记序列(投影图像卸载(表3)[事件1["序号"]]["content"]), [真, 真, 真], "5c_两次决策叠加后全部标记")
  断言相等(数子串(序列化JSON(投影消息产生带卸载(表3)), "image omitted to fit request image limits"), 3, "5d_三条占位文本")

  # =====================================================================
  # §6 无可卸载 → 返回假且不落盘
  # =====================================================================
  设 结果3 为 卸载最旧图像(会话对象, [事件1["序号"]], 1)
  断言真(结果3 == 假, "6a_无可卸载返回假")
  断言相等(长度(会话对象.汇集全部事件()), 4, "6b_不落盘新事件")
  # 非输入类型的源序号被跳过（assistant 节点不参与）
  断言真(卸载最旧图像(会话对象, [], 3) == 假, "6c_空源序号表返回假")

  # =====================================================================
  # §7 载荷/目标原子校验
  # =====================================================================
  设 好 为 ["seq": 事件1["序号"], "imageIndexes": [0]]
  断言拒(["targets": []], "nonempty targets array", "7a_空 targets 被拒", 表2)
  断言拒(["targets": "bad"], "nonempty targets array", "7b_非数组 targets 被拒", 表2)
  断言拒([], "nonempty targets array", "7c_非对象载荷被拒", 表2)
  断言拒(["targets": 好, "extra": 真], "nonempty targets array", "7d_载荷多余键被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": []]]], "nonempty imageIndexes", "7e_空 imageIndexes 被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": [0], "extra": 真]]], "each target must contain", "7f_目标多余键被拒", 表2)
  断言拒(["targets": [["seq": "-1", "imageIndexes": [0]]]], "each target must contain", "7g_非数字 seq 被拒", 表2)
  断言拒(["targets": [["seq": -1, "imageIndexes": [0]]]], "each target must contain", "7h_负 seq 被拒", 表2)
  断言拒(["targets": [["seq": 999, "imageIndexes": [0]]]], "is not a current surface node", "7i_非表面节点 seq 被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": [-1]]]], "strictly increasing", "7j_负索引被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": [0.5]]]], "strictly increasing", "7k_非整数索引被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": [1, 0]]]], "strictly increasing", "7l_非递增索引被拒", 表2)
  断言拒(["targets": [["seq": 事件1["序号"], "imageIndexes": [0, 0]]]], "strictly increasing", "7m_重复索引被拒", 表2)
  断言拒(["targets": [好, 好]], "duplicate target seq", "7n_事件内重复 seq 被拒", 表2)

  # 助手节点（表面节点但非输入）被拒；被 replace 遮蔽后不再是当前表面节点
  设 会话2 为 新建会话("r51-assistant", "G:/dswork")
  设 占s2 为 会话2.记录事件("system/message", ["系统": "提示", "表面操作": "append"])
  设 助手事件 为 会话2.记录事件("assistant/message", ["消息": 造助手消息([造文本块("答")], "deepseek", "flash")])
  设 表助 为 会话2.汇集全部事件()
  断言拒(["targets": [["seq": 助手事件["序号"], "imageIndexes": [0]]]], "must be user/message or tool/result", "7o_助手目标被拒", 表助)
  设 占z 为 会话2.压缩替换(助手事件["序号"], 助手事件["序号"], [["类型": "user/message", "数据": 造用户消息([造文本块("摘要")]), "源序号表": [助手事件["序号"]]]])
  设 表遮 为 会话2.汇集全部事件()
  断言拒(["targets": [["seq": 助手事件["序号"], "imageIndexes": [0]]]], "is not a current surface node", "7p_被遮蔽节点被拒", 表遮)

  # =====================================================================
  # §8 重复卸载 / 下标越界 抛错（无部分应用）
  # =====================================================================
  设 投影消息 为 投影图像卸载(表3)[事件1["序号"]]
  设 文8a 为 ""
  尝试:
    设 占a 为 卸载消息图像(投影消息, [0])
    抛出 新建 错误("反跑判据失败[8a]：应抛错却通过")
  捕获 异常 e8a:
    设 文8a 为 转字符串(e8a)
  断言真(含子串(文8a, "already offloaded"), "8a_重复卸载抛错")
  设 文8b 为 ""
  尝试:
    设 占b 为 卸载消息图像(投影消息, [3])
    抛出 新建 错误("反跑判据失败[8b]：应抛错却通过")
  捕获 异常 e8b:
    设 文8b 为 转字符串(e8b)
  断言真(含子串(文8b, "does not exist"), "8b_越界下标抛错")

  # =====================================================================
  # §9 占位渲染与无关事件
  # =====================================================================
  断言相等(数子串(序列化JSON(替换消息卸载占位(投影消息)), "image omitted to fit request image limits"), 3, "9a_已卸载出现位置全渲染占位")
  断言真(含子串(序列化JSON(替换消息卸载占位(投影消息)), "third"), "9b_未卸载图像原样保留")
  断言相等(替换消息卸载占位(用户体)["id"], 用户体["id"], "9c_无卸载时返回原消息")
  断言相等(数子串(序列化JSON(投影消息产生带卸载(表)), "image omitted"), 0, "9d_未卸载日志不产生占位")
  断言相等(长度(投影图像卸载(表)), 0, "9e_无 image/offload 事件时覆盖表为空")

  写 "test_R51_image卸载: 全部用例通过"
  返回 真

主程()
