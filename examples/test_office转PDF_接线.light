# test_office转PDF_接线.light —— 第6轮 任务E #283 Office→PDF 队列接线 判据
# 运行：python 运行.py examples/test_office转PDF_接线.light
# 判据：接线办公转工具（依赖注入转换器）：注册 → 执行 → mock 转换结果投影；
#       纯逻辑回归绿由 test_R85_D_office转PDF.light 承担。

从 office转PDF 导入 接线办公转工具, 办转构造结果
从 工具 导入 工具注册表
从 JSON 导入 解析JSON

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 转换器：返回 办转构造结果 形状
段落 mock转换器(内容, 扩展名):
  返回 办转构造结果("%PDF-1.4 mock-body
%%EOF", [], "cache-key-1", 真)

段落 主:
  # ---- 1. 一行注册：office_to_pdf 工具可见 ----
  设 注册表 为 新建 工具注册表()
  断言真(接线办公转工具(注册表, {"转换器": mock转换器}), "1a 接线返回真")
  断言真(注册表.有无("office_to_pdf"), "1b 注册表可见")

  # ---- 2. 执行：mock 转换器 → 提交转换 → 投影输出 ----
  设 定义 为 注册表.查找("office_to_pdf")
  设 结果 为 定义["execute"]({"sourceKey": "doc-1", "extension": "docx", "content": "模拟文档", "version": "2"})
  断言真(结果["isError"] == 假, "2a 执行成功")
  设 提交 为 解析JSON(结果["content"][0]["text"])
  断言真(是字典(提交), "2b 提交结果字典")
  断言真(提交["重复"] == 假, "2c 首次非重复")
  断言真(序列化JSON(提交).包含("doc-1"), "2d 身份透传")

  # ---- 3. 描述表可见（列表含 name=office_to_pdf 条目） ----
  设 见到 为 假
  遍历 条目 之 注册表.描述表():
    如果 条目["name"] == "office_to_pdf":
      设 见到 为 真
  断言真(见到, "3a 描述表")

  # ---- 4. 未注入转换器（无钩子服务）-> 执行抛错（provider 不可用语义保留） ----
  设 空表 为 新建 工具注册表()
  设 已抛 为 假
  尝试:
    设 结果4 为 空表.查找("office_to_pdf")["execute"]({"sourceKey": "doc-2", "extension": "xlsx", "content": "x"})
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "4a 未注册工具不可执行")

  打印 "--- 第6轮 任务E #283 office转PDF 接线 测试通过 ---"

主()