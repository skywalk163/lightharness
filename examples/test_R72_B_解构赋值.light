# test_R72_B_解构赋值.light —— G-05 解构赋值与多值返回（R72 任务B）
#
# 覆盖：
#   §1 基础解构（无括号多目标 / 括号元组解构 / 方括号列表解构 / 多值字面量）
#   §2 多值返回（`返回 甲, 乙` / 返回列表 / 返回元组 / 返回迭代器）
#   §3 星号 rest 目标（尾 rest / 头 rest / 中间 rest / 全 rest / 空 rest）
#   §4 嵌套分组目标（圆括号 / 方括号 / 嵌套内带 rest / 两层嵌套）
#   §5 交换与解构共存（a, b = b, a / 普通赋值不受影响）
#   §6 裸解构赋值（无 `设`，`甲, 乙 为 expr`）——改前是静默空操作，本单修复
#   §7 作用域（段落内 / 嵌套段落内 / 循环内 / 类方法内）
#
# 反向哨兵另见 examples/test_R72_B_双星号.light / _空目标.light / _星号非名.light
# （预期 rc!=0，登记在 tests/test_回归.py 的 EXPECT_RED）。

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ok " + 标签

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 "断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件)
  打印 "  ok " + 标签

# ── 供 §2 使用的多值返回段落 ──────────────────────────────────────────
段落 取坐标:
  返回 [10, 20]

段落 取三值:
  返回 7, 8, 9

段落 取分数:
  返回 (95, "优秀")

段落 取范围:
  返回 范围(3)

# ── 供 §7 使用 ────────────────────────────────────────────────────────
段落 层内解构 接收 数据:
  设 左, 右 为 数据
  返回 左 + 右

段落 嵌套解构 接收 数据:
  段落 内层:
    设 甲, 乙 为 数据
    返回 甲 * 乙
  返回 内层()

类 坐标点:
  段落 构造 接收 横, 纵:
    己.横 为 横
    己.纵 为 纵
  段落 分量和:
    设 甲, 乙 为 [己.横, 己.纵]
    返回 甲 + 乙
  段落 星号和:
    设 首项, *余项 为 [己.横, 己.纵, 100, 200]
    返回 首项 + 余项[2]

段落 主:
  打印 "===== R72-B 解构赋值与多值返回 ====="

  # ── §1 基础解构 ──────────────────────────────────────────────────
  打印 "--- §1 基础解构 ---"

  # 任务书三条期望语法之一：设 x, y 为 取坐标()
  设 x, y 为 取坐标()
  断言相等(x, 10, "1a 设 x, y 为 取坐标() 首值")
  断言相等(y, 20, "1b 设 x, y 为 取坐标() 次值")

  # 任务书三条期望语法之二：设 a, b, c 为 [1, 2, 3]
  设 a, b, c 为 [1, 2, 3]
  断言相等(a, 1, "1c 列表解构 首")
  断言相等(b, 2, "1d 列表解构 中")
  断言相等(c, 3, "1e 列表解构 末")

  # 任务书三条期望语法之三：设 (d, e) 为 (4, 5)
  设 (d, e) 为 (4, 5)
  断言相等(d, 4, "1f 元组括号解构 首")
  断言相等(e, 5, "1g 元组括号解构 次")

  # 方括号目标 + 圆括号值
  设 [f, g] 为 (6, 7)
  断言相等(f, 6, "1h 方括号目标 首")
  断言相等(g, 7, "1i 方括号目标 次")

  # 多值字面量右侧（逗号分隔）
  设 h, i2, j 为 1, 2, 3
  断言相等(h, 1, "1j 多值字面量 首")
  断言相等(i2, 2, "1k 多值字面量 中")
  断言相等(j, 3, "1l 多值字面量 末")

  # 单目标接列表（不得被误判为解构）
  设 单个 为 [1, 2]
  断言相等(单个[1], 2, "1m 单目标接列表仍是整体赋值")

  # 字符串也是可迭代对象，可解构
  设 字一, 字二 为 "甲乙"
  断言相等(字一, "甲", "1n 字符串解构 首字")
  断言相等(字二, "乙", "1o 字符串解构 次字")

  # ── §2 多值返回 ──────────────────────────────────────────────────
  打印 "--- §2 多值返回 ---"
  设 取得甲, 取得乙, 取得丙 为 取三值()
  断言相等(取得甲, 7, "2a 返回 7, 8, 9 → 首")
  断言相等(取得乙, 8, "2b 返回 7, 8, 9 → 中")
  断言相等(取得丙, 9, "2c 返回 7, 8, 9 → 末")

  设 分数, 评级 为 取分数()
  断言相等(分数, 95, "2d 元组返回 → 数值")
  断言相等(评级, "优秀", "2e 元组返回 → 字符串")

  设 序一, 序二, 序三 为 取范围()
  断言相等(序一, 0, "2f 迭代器返回 → 0")
  断言相等(序二, 1, "2g 迭代器返回 → 1")
  断言相等(序三, 2, "2h 迭代器返回 → 2")

  # ── §3 星号 rest 目标 ────────────────────────────────────────────
  打印 "--- §3 星号 rest 目标 ---"
  设 首项, *余项 为 [1, 2, 3, 4]
  断言相等(首项, 1, "3a 尾 rest 首项")
  断言相等(余项, [2, 3, 4], "3b 尾 rest 余项")

  设 *前置项, 末项 为 [1, 2, 3, 4]
  断言相等(前置项, [1, 2, 3], "3c 头 rest 前置项")
  断言相等(末项, 4, "3d 头 rest 末项")

  设 头项, *中间项, 尾项 为 [1, 2, 3, 4, 5]
  断言相等(头项, 1, "3e 中间 rest 头项")
  断言相等(中间项, [2, 3, 4], "3f 中间 rest 中间项")
  断言相等(尾项, 5, "3g 中间 rest 尾项")

  设 *全部项 为 [1, 2, 3]
  断言相等(全部项, [1, 2, 3], "3h 全 rest（单目标）")

  设 唯一项, *空余项 为 [9]
  断言相等(唯一项, 9, "3i 空 rest 唯一项")
  断言相等(空余项, [], "3j 空 rest 余项为空列表")

  # 星号解构的余项是列表（不是元组），可继续增删
  列表追加(余项, 99)
  断言相等(余项, [2, 3, 4, 99], "3k rest 余项是可变列表")

  # ── §4 嵌套分组目标 ──────────────────────────────────────────────
  打印 "--- §4 嵌套分组目标 ---"
  设 m, (n1, n2) 为 [1, [2, 3]]
  断言相等(m, 1, "4a 嵌套 外层")
  断言相等(n1, 2, "4b 嵌套 内层首")
  断言相等(n2, 3, "4c 嵌套 内层次")

  设 外一, [内一, 内二] 为 [1, [2, 3]]
  断言相等(外一, 1, "4d 方括号嵌套 外层")
  断言相等(内一, 2, "4e 方括号嵌套 内层首")
  断言相等(内二, 3, "4f 方括号嵌套 内层次")

  设 甲一, (乙一, *丙一) 为 [1, [2, 3, 4]]
  断言相等(甲一, 1, "4g 嵌套内 rest 外层")
  断言相等(乙一, 2, "4h 嵌套内 rest 首")
  断言相等(丙一, [3, 4], "4i 嵌套内 rest 余")

  设 层一, (层二, (层三, 层四)) 为 [1, [2, [3, 4]]]
  断言相等(层一, 1, "4j 两层嵌套 L1")
  断言相等(层二, 2, "4k 两层嵌套 L2")
  断言相等(层三, 3, "4l 两层嵌套 L3")
  断言相等(层四, 4, "4m 两层嵌套 L4")

  # ── §5 交换与解构共存 ────────────────────────────────────────────
  打印 "--- §5 交换与共存 ---"
  设 交甲 为 1
  设 交乙 为 2
  设 交甲, 交乙 为 交乙, 交甲
  断言相等(交甲, 2, "5a 交换后 交甲")
  断言相等(交乙, 1, "5b 交换后 交乙")

  # 与单目标普通赋值共存、互不干扰
  设 普通 为 100
  断言相等(普通, 100, "5c 普通赋值不受影响")
  设 解构一, 解构二 为 [10, 20]
  断言相等(解构一 + 解构二, 30, "5d 解构与普通赋值共存")
  断言相等(普通, 100, "5e 解构未污染普通赋值")

  # ── §6 裸解构赋值（无 `设`）──────────────────────────────────────
  # 改前：`甲, 乙 为 expr` 被当作逗号流水线表达式语句静默吞掉（编译期零提示、
  # 运行期什么都不发生）。本单改为按裸赋值语义生成解包语句。
  打印 "--- §6 裸解构赋值 ---"
  设 裸一 为 0
  设 裸二 为 0
  裸一, 裸二 为 [8, 9]
  断言相等(裸一, 8, "6a 裸解构 首（改前恒为 0）")
  断言相等(裸二, 9, "6b 裸解构 次（改前恒为 0）")

  设 裸三 为 0
  设 裸四 为 []
  裸三, *裸四 为 [1, 2, 3]
  断言相等(裸三, 1, "6c 裸解构含 rest 首")
  断言相等(裸四, [2, 3], "6d 裸解构含 rest 余")

  # 裸解构也可用于已有变量之间的交换
  设 裸五 为 "前"
  设 裸六 为 "后"
  裸五, 裸六 为 裸六, 裸五
  断言相等(裸五, "后", "6e 裸解构交换 裸五")
  断言相等(裸六, "前", "6f 裸解构交换 裸六")

  # 回归哨兵：裸流水线表达式语句（无 `为`）不受影响，仍走原路径
  断言真(真, "6g 非解构的逗号表达式语句路径未受影响")

  # ── §7 作用域 ────────────────────────────────────────────────────
  打印 "--- §7 作用域 ---"
  断言相等(层内解构([3, 4]), 7, "7a 段落内解构")
  断言相等(嵌套解构([5, 6]), 30, "7b 嵌套段落内解构")

  设 点位 为 新建 坐标点(3, 4)
  断言相等(点位.分量和(), 7, "7c 类方法内解构")
  断言相等(点位.星号和(), 203, "7d 类方法内星号解构")

  设 累加 为 0
  遍历 对 之 [[1, 2], [3, 4], [5, 6]]:
    设 环一, 环二 为 对
    累加 加为 环一 + 环二
  断言相等(累加, 21, "7e 循环体内解构")

  打印 "test_R72_B_解构赋值 全部通过"
