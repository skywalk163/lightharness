# test_进程树.light —— 进程树.light 回归测试（R64 复活：零测试→全断言对拍）
#
# 进程树.light 是 stdlib 里的高级进程执行引擎（进程组分离/信号升级/有界输出+spill/
# 总超时+空闲超时/字节层采集+智能解码），但历史上零测试、零接线，等于死代码。
# 本用例把它的每条核心路径都跑一遍并断言，改反即红。
#
# 运行：cd lightharness && python 运行.py examples/test_进程树.light

从 进程树 导入 进程树, 执行结果
导入 os
导入 tempfile

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言包含 接收 文本, 片段, 标签:
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段 + "；实际=" + 文本.截取(0, 200)

# 便捷：启动+等待，返回执行结果
段落 跑 接收 命令数组, 配置, 超时毫秒:
  设 树 为 新建 进程树(命令数组, 配置)
  设 开动 为 树.启动()
  断言真(开动, "启动成功: " + 转字符串(命令数组))
  返回 树.等待(超时毫秒)

段落 主:
  # ============================================================
  # 1) 基本执行：退出码 0 + 标准输出
  # ============================================================
  设 r1 为 跑(["python", "-c", "print('hello-processtree')"], {}, 10000)
  断言相等(r1.退出码, 0, "基本执行退出码0")
  断言包含(r1.标准输出, "hello-processtree", "基本执行标准输出")
  断言相等(r1.是否超时, 假, "基本执行不超时")

  # ============================================================
  # 2) 非零退出码
  # ============================================================
  设 r2 为 跑(["python", "-c", "import sys; sys.exit(42)"], {}, 10000)
  断言相等(r2.退出码, 42, "非零退出码精确回传")

  # ============================================================
  # 3) stderr 分离
  # ============================================================
  设 r3 为 跑(["python", "-c", "import sys; sys.stderr.write('err-stream\\n'); sys.stdout.write('out-stream\\n')"], {}, 10000)
  断言包含(r3.标准输出, "out-stream", "stdout 分离")
  断言包含(r3.标准错误, "err-stream", "stderr 分离")

  # ============================================================
  # 4) 有界输出 + spill：限尾字节很小，输出很大，验证溢出文件 + 省略标记
  # ============================================================
  设 溢出目录 为 tempfile.mkdtemp()
  设 大输出 为 "print('A' * 50000)"
  设 r4 为 跑(["python", "-c", 大输出], ["限尾字节": 2048, "溢出目录": 溢出目录], 15000)
  断言相等(r4.退出码, 0, "大输出退出码0")
  断言真(r4.溢出文件 != 空, "溢出文件路径非空")
  断言真(os.path.exists(r4.溢出文件), "溢出文件真实存在")
  设 溢出大小 为 os.path.getsize(r4.溢出文件)
  断言真(溢出大小 > 2048, "溢出文件内容大于尾部窗口: " + 转字符串(溢出大小))
  断言包含(r4.标准输出, "已省略", "标准输出含省略标记")
  断言包含(r4.标准输出, "AAAA", "尾部窗口保留末尾内容")

  # ============================================================
  # 5) 总超时 + 杀进程树：长 sleep 配短超时，验证超时标志 + 进程被杀死
  # ============================================================
  设 r5 为 跑(["python", "-c", "import time; time.sleep(30)"], ["宽限期毫秒": 2000], 800)
  断言相等(r5.是否超时, 真, "总超时触发")
  断言真(r5.退出码 != 0, "超时后退出码非0（被杀死）")

  # ============================================================
  # 6) 空闲超时：进程不输出也不退出，空闲超时触发
  # ============================================================
  设 r6 为 跑(["python", "-c", "import time; time.sleep(30)"], ["空闲超时毫秒": 600, "宽限期毫秒": 2000], 15000)
  断言相等(r6.是否超时, 真, "空闲超时触发")

  # ============================================================
  # 7) 环境注入：注入环境变量，子进程打印验证
  # ============================================================
  设 r7 为 跑(["python", "-c", "import os; print(os.environ.get('LHARNESS_TEST_VAR','MISSING'))"], ["注入环境": ["LHARNESS_TEST_VAR": "injected-value-42"]], 10000)
  断言相等(r7.退出码, 0, "环境注入退出码0")
  断言包含(r7.标准输出, "injected-value-42", "注入环境变量被子进程读到")

  # ============================================================
  # 8) 启动失败：不存在的命令，返回故障而非崩溃
  # ============================================================
  设 坏树 为 新建 进程树(["nonexistent_command_xyz_12345"], {})
  设 开动8 为 坏树.启动()
  断言相等(开动8, 假, "不存在的命令启动失败")
  设 r8 为 坏树.等待(5000)
  断言相等(r8.退出码, -1, "启动失败退出码-1")
  断言真(长度(r8.标准错误) > 0, "启动失败有错误信息")

  # ============================================================
  # 9) 解码失真标志：注入坏字节，验证 发生解码替换 标志位
  # ============================================================
  设 r9 为 跑(["python", "-c", "import sys; sys.stdout.buffer.write(b'\\xff\\xfe\\x80valid'); sys.stdout.buffer.write(b'\\n')"], ["编码": "utf-8"], 10000)
  断言相等(r9.退出码, 0, "坏字节退出码0")
  断言相等(r9.发生解码替换, 真, "坏字节触发解码替换标志")
  断言相等(r9.标准输出失真, 真, "stdout 失真标志位")

  输出("test_进程树.light 全部断言通过（9 组 / 基本+退出码+stderr+spill+总超时+空闲超时+环境注入+启动失败+失真标志）")
