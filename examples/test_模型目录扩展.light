# test_模型目录扩展.light —— R108 任务线 D 判据（src/模型目录.light）
# 上游锚点：G:\github\deepseek-harness HEAD=e5b5ccbfcb（0.2.0-rc.1）
#   - store.ts:42-70           joinProviderDirectory 合并规则
#   - store.ts:117-119         deriveKeyRef 凭据引用派生
#   - CustomProviderCard.tsx:52 route 正则
#   - discovery.ts:117-122     URL 构造与鉴权头分叉
#   - discovery.ts             解析规则（data 数组优先 / models 对象兜底 / 字段别名）
# 运行：python 运行.py examples/test_模型目录扩展.light
#
# 语言坑规避：断言诊断走 抛出 新建 错误（L-055/L-160）；列表/字典字面量先赋变量再作实参（L-047）；
#   「为」前留空格（L-151）；JSON 解析用例用 尝试/捕获 包裹。

从 模型目录 导入 派生凭据引用, 校验收据路由, 合并提供商目录, 可删除判定, 删除序列
从 模型目录 导入 构造发现请求, 发现地址, 发现请求头, 解析发现响应, 渲染提供商目录, 发现文案
从 模型目录 导入 协议白名单, 默认协议

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言假(条件, 标签):
  如果 条件 != 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望假值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §1 派生凭据引用（4 例）
# =====================================================================
段落 用例_派生凭据引用:
  断言相等(派生凭据引用("deepseek-official"), "DEEPSEEK_OFFICIAL_API_KEY", "1a 简单 route")
  断言相等(派生凭据引用("custom-provider"), "CUSTOM_PROVIDER_API_KEY", "1b 含短横线")
  断言相等(派生凭据引用("my@api/v2"), "MY_API_V2_API_KEY", "1c 含 @ 和 /")
  断言相等(派生凭据引用("openai"), "OPENAI_API_KEY", "1d 全小写")

# =====================================================================
# §2 校验收据路由（5 例）
# =====================================================================
段落 用例_校验收据路由:
  # 2a 空 -> 非法
  设 空结果 为 校验收据路由("", [])
  断言假(空结果["合法"], "2a 空 route 非法")
  # 2b 数字开头 -> 非法
  设 数字结果 为 校验收据路由("1abc", [])
  断言假(数字结果["合法"], "2b 数字开头非法")
  # 2c 大写 -> 非法
  设 大写结果 为 校验收据路由("MyProvider", [])
  断言假(大写结果["合法"], "2c 大写非法")
  # 2d 重名 -> 非法
  设 重名结果 为 校验收据路由("custom", ["custom", "other"])
  断言假(重名结果["合法"], "2d 重名非法")
  断言相等(重名结果["消息"], "已有提供商使用了这个 ID。", "2d2 重名消息")
  # 2e 合法
  设 合法结果 为 校验收据路由("my-custom-provider", ["other"])
  断言真(合法结果["合法"], "2e 合法 route")
  断言相等(合法结果["消息"], "", "2e2 合法无消息")

# =====================================================================
# §3 合并提供商目录（6 例 + 入参未就地改动 1 例）
# =====================================================================
段落 用例_合并目录:
  # 3a 上游单测那条：['custom','deepseek-official','deepseek-account','openai']
  #   -> ['deepseek-account','deepseek-official','custom','openai']
  设 已注册 为 ["custom", "deepseek-official", "deepseek-account", "openai"]
  设 可配置 为 []
  设 合并结果 为 合并提供商目录(已注册, 可配置)
  断言相等(长度(合并结果), 4, "3a1 合并后 4 行")
  断言相等(合并结果[0]["provider"], "deepseek-account", "3a2 第 0 位 account")
  断言相等(合并结果[1]["provider"], "deepseek-official", "3a3 第 1 位 official")
  断言相等(合并结果[2]["provider"], "custom", "3a4 第 2 位 custom")
  断言相等(合并结果[3]["provider"], "openai", "3a5 第 3 位 openai")
  # 3b 可配置表有内容
  设 条目1 为 {}
  条目1["provider"] 为 "deepseek-official"
  条目1["显示名"] 为 "DeepSeek 官方"
  条目1["命名空间"] 为 "llm-deepseek"
  条目1["设置路径"] 为 ["llm", "deepseek"]
  设 可配置2 为 [条目1]
  设 已注册2 为 ["deepseek-official", "custom"]
  设 合并结果2 为 合并提供商目录(已注册2, 可配置2)
  断言相等(长度(合并结果2), 2, "3b1 合并后 2 行")
  断言相等(合并结果2[0]["provider"], "deepseek-official", "3b2 account/official 排序")
  断言相等(合并结果2[0]["活动"], 真, "3b3 已注册活动=真")
  断言相等(合并结果2[1]["provider"], "custom", "3b4 custom 在后")
  断言相等(合并结果2[1]["命名空间"], "", "3b5 未声明命名空间=空")
  断言相等(长度(合并结果2[1]["设置路径"]), 0, "3b6 未声明设置路径=空表")
  # 3c 入参未被就地改动
  设 已注册3 为 ["custom", "deepseek-account"]
  设 可配置3 为 []
  设 原长度 为 长度(已注册3)
  设 可配置原长度 为 长度(可配置3)
  设 合并结果3 为 合并提供商目录(已注册3, 可配置3)
  断言相等(长度(已注册3), 原长度, "3c1 已注册表未被改动")
  断言相等(长度(可配置3), 可配置原长度, "3c2 可配置表未被改动")
  # 3d 可配置条目的 活动 计算
  设 条目2 为 {}
  条目2["provider"] 为 "third-party"
  条目2["显示名"] 为 "第三方"
  设 可配置4 为 [条目2]
  设 已注册4 为 ["deepseek-official"]
  设 合并结果4 为 合并提供商目录(已注册4, 可配置4)
  设 third行 为 空
  遍历 行 之 合并结果4:
    如果 行["provider"] == "third-party":
      设 third行 为 行
  断言真(third行 != 空, "3d1 third-party 存在")
  断言相等(third行["活动"], 假, "3d2 未注册活动=假")
  # 3e 凭据引用自动派生
  断言相等(合并结果[2]["凭据引用"], "CUSTOM_API_KEY", "3e1 custom 凭据引用")
  断言相等(合并结果[3]["凭据引用"], "OPENAI_API_KEY", "3e2 openai 凭据引用")

# =====================================================================
# §4 可删除判定（4 例）
# =====================================================================
段落 用例_可删除:
  # 构造测试用 provider 行
  设 行 为 {}
  行["provider"] 为 "custom"
  行["命名空间"] 为 "llm-custom"
  行["设置路径"] 为 ["llm", "customProviders", "custom"]
  行["凭据引用"] 为 "CUSTOM_API_KEY"
  # 4a 全部满足 -> 可删除
  设 用户视图 为 {}
  设 用户段 为 {}
  字典设置(用户段, "custom", {})
  设 用户层2 为 {}
  字典设置(用户层2, "customProviders", 用户段)
  字典设置(用户视图, "llm", 用户层2)
  设 基座视图 为 {}
  设 可删 为 可删除判定(行, {}, 用户视图, 基座视图)
  断言真(可删, "4a 四条件满足可删除")
  # 4b 命名空间为空 -> 不可删
  设 行2 为 深拷贝(行)
  行2["命名空间"] 为 ""
  设 可删2 为 可删除判定(行2, {}, 用户视图, 基座视图)
  断言假(可删2, "4b 命名空间空不可删")
  # 4c 设置路径为空 -> 不可删
  设 行3 为 深拷贝(行)
  行3["设置路径"] 为 []
  设 可删3 为 可删除判定(行3, {}, 用户视图, 基座视图)
  断言假(可删3, "4c 设置路径空不可删")
  # 4d 基座层存在 -> 不可删
  设 基座视图2 为 {}
  设 基座段 为 {}
  字典设置(基座段, "custom", {})
  设 基座层2 为 {}
  字典设置(基座层2, "customProviders", 基座段)
  字典设置(基座视图2, "llm", 基座层2)
  设 可删4 为 可删除判定(行, {}, 用户视图, 基座视图2)
  断言假(可删4, "4d 基座层存在不可删")

# =====================================================================
# §5 删除序列（2 例，顺序：凭据在前）
# =====================================================================
段落 用例_删除序列:
  设 行 为 {}
  行["provider"] 为 "custom"
  行["凭据引用"] 为 "CUSTOM_API_KEY"
  行["设置路径"] 为 ["llm", "custom", "custom"]
  设 序列 为 删除序列(行)
  断言相等(长度(序列), 2, "5a 删除序列共 2 步")
  断言相等(序列[0]["阶段"], "凭据", "5a1 第 1 步是凭据")
  断言相等(序列[0]["引用"], "CUSTOM_API_KEY", "5a2 凭据引用")
  断言相等(序列[1]["阶段"], "配置", "5a3 第 2 步是配置")
  断言相等(序列[1]["路径"], ["llm", "custom", "custom"], "5a4 配置路径")

# =====================================================================
# §6 发现地址（4 例）
# =====================================================================
段落 用例_发现地址:
  # 6a OpenAI 系，无尾斜杠
  断言相等(发现地址("https://api.openai.com/v1", "openai-completions"), "https://api.openai.com/v1/models", "6a OpenAI 无尾斜杠")
  # 6b OpenAI 系，有尾斜杠
  断言相等(发现地址("https://api.openai.com/v1/", "openai-completions"), "https://api.openai.com/v1/models", "6b OpenAI 去尾斜杠")
  # 6c Anthropic，基址以 /v1 结尾 -> 去掉后再加 /v1/models
  断言相等(发现地址("https://api.anthropic.com/v1", "anthropic-messages"), "https://api.anthropic.com/v1/models?limit=1000", "6c Anthropic /v1 结尾")
  # 6d Anthropic，基址不以 /v1 结尾
  断言相等(发现地址("https://api.anthropic.com", "anthropic-messages"), "https://api.anthropic.com/v1/models?limit=1000", "6d Anthropic 非 /v1 结尾")

# =====================================================================
# §7 发现请求头（4 例：三协议 + 无密钥）
# =====================================================================
段落 用例_发现请求头:
  # 7a Anthropic + 密钥
  设 头a 为 发现请求头("anthropic-messages", "sk-ant-xxx")
  断言相等(头a["accept"], "application/json", "7a1 accept 恒有")
  断言相等(头a["anthropic-version"], "2023-06-01", "7a2 anthropic-version")
  断言相等(头a["x-api-key"], "sk-ant-xxx", "7a3 x-api-key")
  # 7b OpenAI completions + 密钥
  设 头b 为 发现请求头("openai-completions", "sk-openai-xxx")
  断言相等(头b["accept"], "application/json", "7b1 accept")
  断言相等(头b["authorization"], "Bearer sk-openai-xxx", "7b2 authorization Bearer")
  # 7c OpenAI responses + 密钥
  设 头c 为 发现请求头("openai-responses", "sk-xxx")
  断言相等(头c["authorization"], "Bearer sk-xxx", "7c1 responses 也是 Bearer")
  # 7d 无密钥
  设 头d 为 发现请求头("openai-completions", "")
  断言相等(头d["accept"], "application/json", "7d1 accept 仍有")
  断言假(字典包含键(头d, "authorization"), "7d2 无密钥无 authorization")
  断言假(字典包含键(头d, "x-api-key"), "7d3 无密钥无 x-api-key")

# =====================================================================
# §8 解析发现响应（8 例）
# =====================================================================
段落 用例_解析响应:
  # 8a data 数组
  设 json_a 为 "{\"data\": [{\"id\": \"gpt-4o\", \"name\": \"GPT-4o\", \"contextWindow\": 128000, \"maxTokens\": 16384}]}"
  设 结果a 为 解析发现响应(json_a, "openai-completions")
  断言相等(结果a["错误"], "", "8a1 无错误")
  断言相等(长度(结果a["候选"]), 1, "8a2 候选 1 个")
  断言相等(结果a["候选"][0]["id"], "gpt-4o", "8a3 id")
  断言相等(结果a["候选"][0]["name"], "GPT-4o", "8a4 name")
  断言相等(结果a["候选"][0]["contextWindow"], 128000, "8a5 contextWindow")
  断言相等(结果a["候选"][0]["maxTokens"], 16384, "8a6 maxTokens")
  # 8b models 对象
  设 json_b 为 "{\"models\": {\"claude-3\": {\"display_name\": \"Claude 3\"}, \"claude-3.5\": {}}}"
  设 结果b 为 解析发现响应(json_b, "anthropic-messages")
  断言相等(结果b["错误"], "", "8b1 无错误")
  断言相等(长度(结果b["候选"]), 2, "8b2 候选 2 个")
  # 找到 claude-3
  设 找到3 为 假
  遍历 候 之 结果b["候选"]:
    如果 候["id"] == "claude-3":
      设 找到3 为 真
      断言相等(候["name"], "Claude 3", "8b3 display_name 别名")
  断言真(找到3, "8b4 claude-3 存在")
  # 8c 皆无 -> 错误
  设 json_c 为 "{\"other\": []}"
  设 结果c 为 解析发现响应(json_c, "openai-completions")
  断言真(结果c["错误"] != "", "8c1 有错误")
  断言相等(长度(结果c["候选"]), 0, "8c2 候选为空")
  # 8d 空 id 跳过
  设 json_d 为 "{\"data\": [{\"id\": \"\"}, {\"id\": \"valid-model\"}]}"
  设 结果d 为 解析发现响应(json_d, "openai-completions")
  断言相等(长度(结果d["候选"]), 1, "8d1 空 id 被跳过")
  断言相等(结果d["候选"][0]["id"], "valid-model", "8d2 保留有效 id")
  # 8e 重复 id 去重
  设 json_e 为 "{\"data\": [{\"id\": \"dup\"}, {\"id\": \"dup\"}, {\"id\": \"unique\"}]}"
  设 结果e 为 解析发现响应(json_e, "openai-completions")
  断言相等(长度(结果e["候选"]), 2, "8e1 去重后 2 个")
  # 8f 别名字段命中
  设 json_f 为 "{\"data\": [{\"id\": \"model-x\", \"context_window\": 200000, \"max_output_tokens\": 8192, \"displayName\": \"Model X\"}]}"
  设 结果f 为 解析发现响应(json_f, "openai-completions")
  断言相等(结果f["候选"][0]["contextWindow"], 200000, "8f1 context_window 别名")
  断言相等(结果f["候选"][0]["maxTokens"], 8192, "8f2 max_output_tokens 别名")
  断言相等(结果f["候选"][0]["name"], "Model X", "8f3 displayName 别名")
  # 8g 未定义省略键
  设 json_g 为 "{\"data\": [{\"id\": \"minimal\"}]}"
  设 结果g 为 解析发现响应(json_g, "openai-completions")
  断言假(字典包含键(结果g["候选"][0], "name"), "8g1 无 name 省略键")
  断言假(字典包含键(结果g["候选"][0], "contextWindow"), "8g2 无 contextWindow 省略键")
  断言假(字典包含键(结果g["候选"][0], "maxTokens"), "8g3 无 maxTokens 省略键")
  # 8h inputModalities 省略
  设 json_h 为 "{\"data\": [{\"id\": \"with-modalities\", \"inputModalities\": [\"text\", \"image\"]}]}"
  设 结果h 为 解析发现响应(json_h, "openai-completions")
  断言假(字典包含键(结果h["候选"][0], "inputModalities"), "8h1 listing 路径省略 inputModalities")

# =====================================================================
# §9 渲染提供商目录（键齐全 2 例 + 静态目录偏离声明 1 例）
# =====================================================================
段落 用例_渲染目录:
  设 页 为 渲染提供商目录(["deepseek-official", "custom"], [], {})
  断言真(字典包含键(页, "提供商行"), "9a1 键 提供商行")
  断言真(字典包含键(页, "静态目录偏离声明"), "9a2 键 静态目录偏离声明")
  断言真(字典包含键(页, "协议白名单"), "9a3 键 协议白名单")
  断言真(字典包含键(页, "默认协议"), "9a4 键 默认协议")
  断言相等(长度(页["提供商行"]), 2, "9a5 2 行")
  # 偏离声明非空
  断言真(页["静态目录偏离声明"] != "", "9b1 偏离声明非空")
  # 协议白名单 3 条
  断言相等(长度(页["协议白名单"]), 3, "9c1 协议白名单 3 条")
  断言相等(页["默认协议"], "openai-completions", "9c2 默认协议")

# =====================================================================
# §10 构造发现请求（空值省略键）
# =====================================================================
段落 用例_构造请求:
  设 请求1 为 构造发现请求()
  断言相等(长度(字典键列表(请求1)), 0, "10a 全空时无键")
  设 请求2 为 构造发现请求("openai", "https://api.openai.com/v1", "openai-completions", "sk-xxx")
  断言相等(请求2["provider"], "openai", "10b1 provider")
  断言相等(请求2["baseURL"], "https://api.openai.com/v1", "10b2 baseURL")
  断言相等(请求2["api"], "openai-completions", "10b3 api")
  断言相等(请求2["apiKey"], "sk-xxx", "10b4 apiKey")

# =====================================================================
# §11 文案逐字（≥8 例）
# =====================================================================
段落 用例_文案逐字:
  设 表 为 发现文案()
  断言相等(表["fetchModels"], "获取可用模型", "11a fetchModels")
  断言相等(表["fetching"], "正在询问提供商…", "11b fetching")
  断言相等(表["fetchNeedsBaseUrl"], "请先填写 API 地址，再获取。", "11c fetchNeedsBaseUrl")
  断言相等(表["fetchEmpty"], "该提供商没有列出任何模型，请手动添加。", "11d fetchEmpty")
  断言相等(表["fetchTitle"], "选择要添加的模型", "11e fetchTitle")
  断言相等(表["fetchDescription"], "以下是模型提供商的可用模型，勾选要添加的模型。", "11f fetchDescription")
  断言相等(表["customRouteInvalid"], "需以小写字母开头，之后可用小写字母、数字和短横线。", "11g customRouteInvalid")
  断言相等(表["customRouteTaken"], "已有提供商使用了这个 ID。", "11h customRouteTaken")

# =====================================================================
段落 主程():
  用例_派生凭据引用()
  用例_校验收据路由()
  用例_合并目录()
  用例_可删除()
  用例_删除序列()
  用例_发现地址()
  用例_发现请求头()
  用例_解析响应()
  用例_渲染目录()
  用例_构造请求()
  用例_文案逐字()
  打印 "test_模型目录扩展 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试模型目录扩展 通过 ---"
  返回 真

主程()
