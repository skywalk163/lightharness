# test_R41_真实网络IO.light —— 第41轮 任务2 验收（宿主层真实网络IO）
#
# 运行：cd lightharness && python 运行.py examples/test_R41_真实网络IO.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖：
#   - 本机起 web服务器（内核分配端口），真实HTTP客户端（非阻塞 socket）GET /health → 200；
#   - 真实HTTP客户端 POST /v1/chat/completions（mock 客户端驱动，零真实 token）→ 200；
#   - 非 loopback 绑定 + HARNESS_TOKEN：带 token → 200，不带 token → 401；
#   - 安全铁律：非 loopback 绑定且无 token → 配置阶段拒绝启动（抛错）。
#
# 语言坑规避：请求体用 b'...' 字节字面量（处理对话 内部 字符串(体字节,"utf-8") 要求 bytes）；
#   真实客户端是异步非阻塞（跑在主协程里，若阻塞会冻住服务端 处理循环 任务 → 死锁），
#   故必须 等待 真实GET/真实POST 让出事件循环。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 HTTP服务端 导入 处理循环
从 总入口 导入 组装注册表
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因
从 真实HTTP客户端 导入 真实GET, 真实POST
从 文件系统 导入 写入文件, 文件存在, 删除文件, 路径连接, 目录存在, 删除目录, 创建目录

# ---- 断言助手 ----
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

# ---- mock 客户端（使 /v1/chat/completions 返回 200，不消耗真实 token）----
类 模拟客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 回应表 等于 空
  属性 应答序号 等于 0

  段落 构造(回应清单):
    设 己.模型名 为 "deepseek-chat"
    设 己.回应表 为 回应清单
    设 己.应答序号 为 0

  段落 对话响应(消息表, 选项表, 工具表):
    如果 己.应答序号 >= 长(己.回应表):
      设 己.应答序号 为 长(己.回应表) - 1
    设 回应文本 为 己.回应表[己.应答序号]
    设 己.应答序号 为 己.应答序号 + 1
    返回 [造块开始(0, "text"), 造文本增量(0, 回应文本), 造块结束(0, ["type": "text", "text": 回应文本]), 造结束(造停止原因())]

段落 聊天体:
  返回 '{"model":"x","messages":[{"role":"user","content":"hi"}]}'

异步 段落 主测试:
  设 基 为 当前目录()
  设 会话根 为 路径连接(基, "r41_net_sandbox")
  如果 目录存在(会话根) == 假:
    创建目录(会话根)
  设 客户端 为 新建 模拟客户端(["r41 real net mock reply"])
  设 注册表 为 组装注册表()

  # =====================================================================
  # 场景A：loopback（127.0.0.1）+ 无 token → 全部 200（向后兼容 S1）
  # =====================================================================
  全局服务.配置(客户端, 注册表, 会话根, 5.0, "", [], "", 绑定地址="127.0.0.1", 令牌="")
  设 任务A 为 创建任务(处理循环(全局服务.服务端))
  设 端口A 为 全局服务.端口()
  断言真(端口A > 0, "A_内核端口已分配")

  设 r 为 等待 真实GET("127.0.0.1", 端口A, "/health")
  断言相等(r["状态"], 200, "A_health_200")

  设 r 为 等待 真实POST("127.0.0.1", 端口A, "/v1/chat/completions", 聊天体())
  断言相等(r["状态"], 200, "A_chat_200")
  断言真(r["体"].查找("r41 real net mock reply") >= 0, "A_chat_回应含mock标记")

  全局服务.停止()

  # =====================================================================
  # 场景B：非 loopback（0.0.0.0）+ token → 带 token 200，不带 401
  #   （客户端连 127.0.0.1:port，0.0.0.0 覆盖回环；服务端按 绑定地址 判非 loopback 强制令牌）
  # =====================================================================
  设 令牌B 为 "r41-secret-token"
  全局服务.配置(客户端, 注册表, 会话根, 5.0, "", [], "", 绑定地址="0.0.0.0", 令牌=令牌B)
  设 任务B 为 创建任务(处理循环(全局服务.服务端))
  设 端口B 为 全局服务.端口()
  断言真(端口B > 0, "B_内核端口已分配")

  设 r 为 等待 真实GET("127.0.0.1", 端口B, "/health", 令牌=令牌B)
  断言相等(r["状态"], 200, "B_health_带token_200")

  设 r 为 等待 真实POST("127.0.0.1", 端口B, "/v1/chat/completions", 聊天体(), 令牌=令牌B)
  断言相等(r["状态"], 200, "B_chat_带token_200")

  设 r 为 等待 真实GET("127.0.0.1", 端口B, "/health")
  断言相等(r["状态"], 401, "B_health_不带token_401")
  断言真(r["体"].查找("未认证") >= 0, "B_401_体含未认证")

  全局服务.停止()

  # =====================================================================
  # 场景C：安全铁律 —— 非 loopback 绑定 + 无 token → 拒绝启动（配置抛错）
  # =====================================================================
  设 拒绝 为 假
  尝试:
    全局服务.配置(客户端, 注册表, 会话根, 5.0, "", [], "", 绑定地址="0.0.0.0", 令牌="")
  捕获 异常 e:
    设 拒绝 为 真
  断言真(拒绝 == 真, "C_非loopback无token_拒绝启动")

  # ---- 清理（递归删，会话持久化会写入嵌套子目录）----
  尝试:
    删目录树(会话根)
  捕获 异常 e:
    写 "清理会话根跳过: "; 写 转字符串(e)

  写 "任务2 全部断言通过（真实网络IO：loopback GET/POST 200；非loopback 令牌门禁 200/401；无token拒启动 rc=0）\n"

异步 运行 主测试()
