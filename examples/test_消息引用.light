# test_消息引用.light —— 0.2.2-rc.1 增量移植判据（message-quotes 引文解码 / 区间 / 规则 / 准入）
# 运行：python 运行.py examples/test_消息引用.light
# 上游：packages/session/message-quotes/src/{client/quote-text.ts, client/quote-rule.ts,
#       client/index.ts, client/QuoteSelection.tsx, client/locales.ts}
#       + tests/{quote-text.client.spec.ts, browser-plugin.client.spec.tsx, quote-selection.client.spec.tsx}
#
# 上游用例覆盖对照（逐条对应）：
#   quote-text.spec  it#1 归一化 + 单层解码        -> 本文件 一.1
#   quote-text.spec  it#2 连续引用行 + 原文偏移    -> 一.2 / 一.6
#   quote-text.spec  it#3 比较符/缩进代码/空白段  -> 一.3 / 一.4
#   browser-plugin   evaluator 首节点 id 'quote'   -> 二.1 / 二.2
#   browser-plugin   \n\n 分隔降级为显示空格        -> 二.3 / 二.5 / 二.6
#   browser-plugin   非 selection / 读文本失败 / 会话缺失 / 已移除 / 子代理 -> 三.1-三.6
#   quote-selection  insertQuote 成功才清选区并关闭 -> 四.1-四.3
#   locales.ts       八语言文案 + NS               -> 五.1-五.5
#
# 反跑判据（改反源码任一期望必须红）：
#   A. 引文缩进上限 3 -> 2                       -> 一.5「三空格引用」红
#   B. 引用准入 触发 != selection 的返回 假->真   -> 三.2「非选区触发」红
#   C. 引文区间 有效性判据 != "" -> == ""         -> 一.4「空白引文段」红

从 消息引用 导入 引文文本, 引文区间, 引文规则匹配, 引文规则次序, 投影标记, 引用准入, 引用插入, 引文文案, 引文命名空间

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 主程():
  # ===== 一、引文解码与区间 =====

  # 1. 行尾归一（CRLF）+ 只去一层引用标记（嵌套 > 保留）
  断言相等(引文文本("> first\r\n  > > nested\n>third"), "first\n> nested\nthird", "1 归一化+单层解码")

  # 2. 连续引用行并成一段，偏移按原文（含前置普通段与前导空格）
  设 区间一 为 引文区间("before\n\n> first\n> line\n\n> second\n\nafter")
  断言相等(列表长度(区间一), 2, "2 区间段数")
  断言相等(列表获取(区间一, 0)["起点"], 8, "2 首段起点")
  断言相等(列表获取(区间一, 0)["终点"], 22, "2 首段终点")
  断言相等(列表获取(区间一, 1)["起点"], 24, "2 次段起点")
  断言相等(列表获取(区间一, 1)["终点"], 32, "2 次段终点")

  # 3. 比较符 / 四空格缩进代码 / 空白引文段都不算引文
  断言相等(列表长度(引文区间("a > b\n    > code\n> \n>")), 0, "3 比较符与缩进代码")
  断言相等(列表长度(引文区间("")), 0, "3 空文本")

  # 4. 空白引文段（剥完为空）不登记，但相邻真实引文不受影响
  #    注意 "> \n>x" 是同一块的连续两行（上游 matchAll 也并成一段），故这里用空行隔开
  断言相等(列表长度(引文区间("> \n>x")), 1, "4 空白行并入同块")
  断言相等(列表获取(引文区间("> \n>x"), 0)["终点"], 5, "4 同块终点")
  断言相等(列表长度(引文区间("> \n\n>x")), 1, "4 空白段不登记")
  断言相等(列表获取(引文区间("> \n\n>x"), 0)["起点"], 4, "4 真实段起点")

  # 5. 三空格引用算引文（上游 {0,3} 上界）；四空格不算
  断言相等(引文文本("   > three"), "three", "5 三空格引用")
  断言相等(引文文本("    > code"), "    > code", "5 四空格缩进")

  # 6. CRLF 与 Tab：  "  > first\r\n>second" 是一段 [0,18)
  设 区间二 为 引文区间("  > first\r\n>second")
  断言相等(列表长度(区间二), 1, "6 CRLF 段数")
  断言相等(列表获取(区间二, 0)["起点"], 0, "6 CRLF 起点")
  断言相等(列表获取(区间二, 0)["终点"], 18, "6 CRLF 终点")
  断言相等(引文文本(">\tq"), "q", "6 Tab 分隔")
  断言相等(引文文本("> a\r> b"), "a\nb", "6 孤立 CR 归一")

  # 7. 两个独立引用块（中间空行）互不粘连
  设 区间三 为 引文区间(">a\n\n>b")
  断言相等(列表长度(区间三), 2, "7 独立块数")
  断言相等(列表获取(区间三, 1)["起点"], 4, "7 次块起点")

  # ===== 二、引文规则与投影标记 =====

  # 1. 区间起点处产出「引用」节点，数据是解码后的文本
  设 节一 为 引文规则匹配("> excerpt", 0)
  断言相等(节一["类型"], "引用", "1 引用节点类型")
  断言相等(节一["起点"], 0, "1 引用节点起点")
  断言相等(节一["终点"], 9, "1 引用节点终点")
  断言相等(节一["数据"]["文本"], "excerpt", "1 引用节点文本")

  # 2. 区间前两位若是 \n\n，先产出「文本」分隔节点（显示为空格）
  设 节二 为 引文规则匹配("a\n\n> q", 0)
  断言相等(节二["类型"], "文本", "2 分隔节点类型")
  断言相等(节二["起点"], 1, "2 分隔节点起点")
  断言相等(节二["终点"], 3, "2 分隔节点终点")
  断言相等(节二["数据"]["显示"], " ", "2 分隔显示为空格")

  # 3. 游标推过分隔后，同一位置取到的是引用节点
  设 节三 为 引文规则匹配("a\n\n> q", 3)
  断言相等(节三["类型"], "引用", "3 游标推进后取引用")
  断言相等(节三["数据"]["文本"], "q", "3 游标推进后文本")

  # 4. 无引文时规则不命中
  断言相等(引文规则匹配("plain", 0), 空, "4 普通文本不命中")
  断言相等(引文规则次序(), -10, "4 规则次序 -10")

  # 5. 投影标记：普通文本 -> 分隔 -> 引用 -> 分隔 -> 普通文本
  设 节表 为 投影标记("a\n\n> q\n\nb")
  断言相等(列表长度(节表), 5, "5 投影节点数")
  断言相等(列表获取(节表, 0)["终点"], 1, "5 首普通文本终点")
  断言相等(列表获取(节表, 1)["数据"]["显示"], " ", "5 前置分隔显示空格")
  断言相等(列表获取(节表, 2)["类型"], "引用", "5 中间是引用节点")
  断言相等(列表获取(节表, 2)["数据"]["文本"], "q", "5 引用节点文本")
  断言相等(列表获取(节表, 3)["终点"], 8, "5 后置分隔终点")
  断言相等(列表获取(节表, 4)["终点"], 9, "5 尾普通文本终点")

  # 6. 纯引用文本：投影只有一个引用节点
  设 节表二 为 投影标记("> only")
  断言相等(列表长度(节表二), 1, "6 纯引用节点数")
  断言相等(列表获取(节表二, 0)["数据"]["文本"], "only", "6 纯引用文本")

  # ===== 三、选区准入 =====

  # 1. 可写会话里的有效选区
  断言相等(引用准入("selection", 真, 真, 假, 假, "", 假), 真, "1 有效选区准入")
  # 2. 非选区触发（如原生右键菜单）不抢
  断言相等(引用准入("contextmenu", 真, 真, 假, 假, "", 假), 假, "2 非选区触发拒绝")
  # 3. 读不到选区文本
  断言相等(引用准入("selection", 假, 真, 假, 假, "", 假), 假, "3 无选区文本拒绝")
  # 4. 会话不存在
  断言相等(引用准入("selection", 真, 假, 假, 假, "", 假), 假, "4 会话缺失拒绝")
  # 5. 会话已移除
  断言相等(引用准入("selection", 真, 真, 真, 假, "", 假), 假, "5 已移除拒绝")
  # 6. 子代理会话：continuable + 父可用才准入
  断言相等(引用准入("selection", 真, 真, 假, 真, "continuable", 真), 真, "6 子代理可续准入")
  断言相等(引用准入("selection", 真, 真, 假, 真, "continuable", 假), 假, "6 父不可用拒绝")
  断言相等(引用准入("selection", 真, 真, 假, 真, "one-shot", 真), 假, "6 一次性子代理拒绝")

  # ===== 四、插入时序 =====

  # 1. 选区失效：只关闭，不插入、不清选区
  设 插一 为 引用插入(空, 真)
  断言相等(插一["动作"], "关闭", "1 失效关闭")
  断言相等(插一["清除选区"], 假, "1 失效不清选区")
  # 2. 插入被拒：保持原样，不关闭也不清选区
  设 插二 为 引用插入("hi", 假)
  断言相等(插二["动作"], "保持", "2 插入被拒保持")
  断言相等(插二["插入"], 假, "2 插入被拒未插入")
  # 3. 插入成功：先清选区再关闭
  设 插三 为 引用插入("hi", 真)
  断言相等(插三["动作"], "插入并关闭", "3 成功动作")
  断言相等(插三["清除选区"], 真, "3 成功清选区")

  # ===== 五、文案与命名空间 =====

  断言相等(引文文案("zh"), "引用文本", "1 中文文案")
  断言相等(引文文案("en"), "Quote text", "2 英文文案")
  断言相等(引文文案("ja"), "テキストを引用", "3 日文文案")
  断言相等(引文文案("xx"), "", "4 未知语言空串")
  断言相等(引文命名空间(), "messageQuotes", "5 命名空间")

  写 "--- 测试 消息引用 通过 ---"

主程()
