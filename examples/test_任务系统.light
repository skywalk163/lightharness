# test_任务系统.light —— 模块 #53（对标编号 53）反跑测试
# 覆盖原版两处纯逻辑：
#   packages/jobs/jobs-local/src/index.ts
#     L131-154 start 入口校验：controller/owner、kind、label、outputLimitBytes、
#              并发槽位 active>=maxConcurrentJobsPerOwner、kind-count ID
#     L192-197 list 归属过滤          L205-213 read 产出投影 + 终态标 reported
#     L215-228 kill 状态迁移与返回码（终态→already-finished；否则→stopping+reported）
#     L230-279 wait 时限校验 + 「等待超时」与「caller 取消」区分
#     L321-328 并发槽位计数           L416-428 settle 首胜 + waiters>0 标 reported
#   packages/jobs/tool-jobs/src/index.ts
#     L205-222 配置与预算自检（waitTimeoutMs / maxWaitTimeoutMs / maxConsecutiveWakes）
#     L226-230 人类输入认领重置连续唤醒预算
#     L293-300 唤醒预算耗尽降级注入     L333 wait 时限取 min(timeout_ms ?? waitDefault, waitCap)
#
# 反跑判据：把任一 断言相等 的期望值改反即红；把任一 检查抛错 用例改为「不抛」即红。
# 语言坑规避：写 只接受单个变量/字面量（表达式一律先 设 成变量再 写）；
#             抛错判据走 检查抛错 + 具名零参段落（匿名闭包不可用作实参）。

从 任务系统 导入 终态清单, 活动态清单, 默认槽位上限, 等待超时码, 安全整数上限, 判终态, 判活动态, 判安全整数, 判有限正数, 造任务册, 判有控制器, 造记录, 造快照, 定位记录, 校验归属, 活动任务数, 判有空槽, 查类别序号, 构造任务标识, 校验启动, 登记任务, 列出快照, 读取产出, 执行终止, 结算任务, 记入等待者, 移出等待者, 校验等待时限, 判定等待结局, 推演等待, 校验投递方式, 校验插件配置, 约束等待时限, 查唤醒次数, 判定投递, 记入唤醒, 重置唤醒
从 JSON 导入 序列化JSON
从 内置核心转换 导入 转字符串

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)

# =====================================================================
# 1. 状态谓词（jobs-local L66-68 isTerminal / L325 活动态）
# =====================================================================
段落 用例状态谓词:
  断言相等(判终态("completed"), 真, "completed 是终态")
  断言相等(判终态("killed"), 真, "killed 是终态")
  断言相等(判终态("failed"), 真, "failed 是终态")
  断言相等(判终态("running"), 假, "running 非终态")
  断言相等(判终态("stopping"), 假, "stopping 非终态")
  断言相等(判活动态("running"), 真, "running 是活动态")
  断言相等(判活动态("stopping"), 真, "stopping 是活动态")
  断言相等(判活动态("completed"), 假, "completed 非活动态")
  断言相等(列表长度(终态清单), 3, "终态清单 3 项")
  断言相等(列表长度(活动态清单), 2, "活动态清单 2 项")

# =====================================================================
# 2. 数值谓词（L137-139 安全整数 / L233 有限正数）
# =====================================================================
段落 用例数值谓词:
  断言相等(判安全整数(1), 真, "1 是安全整数")
  断言相等(判安全整数(0), 真, "0 是安全整数")
  断言相等(判安全整数(0 - 5), 真, "-5 是安全整数")
  断言相等(判安全整数(安全整数上限), 真, "2^53-1 是安全整数")
  断言相等(判安全整数(安全整数上限 + 1), 假, "2^53 不是安全整数")
  断言相等(判安全整数(1.5), 假, "小数不是安全整数")
  断言相等(判安全整数("3"), 假, "字符串不是安全整数")
  断言相等(判安全整数(空), 假, "空不是安全整数")
  断言相等(判有限正数(1), 真, "1 是有限正数")
  断言相等(判有限正数(0.5), 真, "0.5 是有限正数")
  断言相等(判有限正数(0), 假, "0 不是正数")
  断言相等(判有限正数(0 - 1), 假, "-1 不是正数")
  断言相等(判有限正数("5"), 假, "字符串不是有限正数")
  断言相等(判有限正数(空), 假, "空不是有限正数")

# =====================================================================
# 3. 任务册与控制器分层（jobs-local L315-319 servesOwner）
# =====================================================================
段落 用例控制器:
  设 册 为 造任务册(空)
  断言相等(册["槽位上限"], 默认槽位上限, "缺省槽位上限 = 10")
  断言相等(默认槽位上限, 10, "默认槽位上限常量")
  断言相等(等待超时码, "TASK_WAIT_TIMEOUT", "等待超时码常量")
  断言相等(判有控制器(册, 空), 真, "全域控制器服务无主任务")
  断言相等(判有控制器(册, "s1"), 真, "全域控制器服务任意归属")
  设 册["全域控制器"] 为 0
  断言相等(判有控制器(册, 空), 假, "无控制器时无主任务也不可用")
  断言相等(判有控制器(册, "s1"), 假, "无控制器时 s1 不可用")
  设 名单 为 ["s1"]
  设 册["归属控制器"] 为 名单
  断言相等(判有控制器(册, "s1"), 真, "归属控制器只服务 s1")
  断言相等(判有控制器(册, "s2"), 假, "归属控制器不服务 s2")
  断言相等(判有控制器(册, 空), 假, "归属控制器不服务无主任务")
  设 册 为 造任务册(3)
  断言相等(册["槽位上限"], 3, "显式槽位上限")

# =====================================================================
# 4. 记录与快照投影（jobs-local L363-377 snapshot：可选字段缺席则整键不出现）
# =====================================================================
段落 用例快照投影:
  设 记录 为 造记录("bash-1", "bash", "跑测试", "s1", 1024, 1000)
  断言相等(记录["status"], "running", "新记录初始 running")
  断言相等(记录["reported"], 假, "新记录未上报")
  断言相等(记录["waiters"], 0, "新记录无等待者")
  设 快照 为 造快照(记录)
  断言相等(快照["id"], "bash-1", "快照 id")
  断言相等(快照["kind"], "bash", "快照 kind")
  断言相等(快照["label"], "跑测试", "快照 label")
  断言相等(快照["status"], "running", "快照 status")
  断言相等(快照["startedAt"], 1000, "快照 startedAt")
  断言相等(快照["reported"], 假, "快照 reported")
  断言相等(快照["outputLimitBytes"], 1024, "有输出上限则出键")
  断言相等(快照["ownerSession"], "s1", "有归属则出 ownerSession")
  断言相等(字典包含键(快照, "detail"), 假, "无详情则不出 detail 键")
  断言相等(字典包含键(快照, "finishedAt"), 假, "未完成则不出 finishedAt 键")
  设 裸记录 为 造记录("sleep-1", "sleep", "睡", 空, 空, 5)
  设 裸快照 为 造快照(裸记录)
  断言相等(字典包含键(裸快照, "outputLimitBytes"), 假, "无输出上限则不出键")
  断言相等(字典包含键(裸快照, "ownerSession"), 假, "无归属则不出 ownerSession 键")
  设 册 为 造任务册(4)
  设 标识 为 登记任务(册, ["kind": "bash", "label": "x"], 10)
  设 完成后 为 结算任务(册, 标识, "completed", "ok", "产出文本", 20)
  断言相等(完成后["detail"], "ok", "结算后 detail 出键")
  断言相等(完成后["finishedAt"], 20, "结算后 finishedAt 出键")
  设 记录2 为 定位记录(册, 标识)
  断言相等(记录2["output"], "产出文本", "记录保留产出（快照不投影 output）")
  设 快照2 为 造快照(记录2)
  断言相等(字典包含键(快照2, "output"), 假, "快照不投影 output 字段")

# =====================================================================
# 5. 并发槽位（jobs-local L321-328 + L143-148）
# =====================================================================
段落 用例并发槽位:
  设 册 为 造任务册(2)
  断言相等(活动任务数(册, "s1"), 0, "初始无活动任务")
  断言相等(判有空槽(册, "s1"), 真, "初始有空槽")
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a", "owner": "s1"], 1)
  断言相等(活动任务数(册, "s1"), 1, "登记 1 条后活动数 1")
  断言相等(活动任务数(册, "s2"), 0, "槽位按归属隔离")
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b", "owner": "s1"], 2)
  断言相等(活动任务数(册, "s1"), 2, "登记 2 条后活动数 2")
  断言相等(判有空槽(册, "s1"), 假, "达到上限则无空槽")
  设 占位 为 执行终止(册, 乙, "s1")
  断言相等(活动任务数(册, "s1"), 2, "stopping 仍占槽位")
  断言相等(判有空槽(册, "s1"), 假, "stopping 仍无空槽")
  设 完成后 为 结算任务(册, 乙, "killed", 空, 空, 3)
  断言相等(活动任务数(册, "s1"), 1, "终态后释放槽位")
  断言相等(判有空槽(册, "s1"), 真, "释放后有空槽")

# =====================================================================
# 6. kind-count ID（jobs-local L151-153）
# =====================================================================
段落 用例任务标识:
  设 册 为 造任务册(10)
  断言相等(查类别序号(册, "bash"), 1, "首次 bash 序号 1")
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  断言相等(甲, "bash-1", "首个 bash 任务 ID")
  断言相等(查类别序号(册, "bash"), 2, "登记后序号推进到 2")
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b"], 2)
  断言相等(乙, "bash-2", "第二个 bash 任务 ID")
  设 丙 为 登记任务(册, ["kind": "sleep", "label": "c"], 3)
  断言相等(丙, "sleep-1", "sleep 独立计数")
  断言相等(查类别序号(册, "sleep"), 2, "sleep 序号独立推进")
  断言相等(构造任务标识("bash", 3), "bash-3", "标识拼接格式")
  断言相等(构造任务标识("x", 10), "x-10", "多位数序号拼接")

# =====================================================================
# 7. start 入口校验（jobs-local L131-148 全部拒绝路径）
# =====================================================================
段落 段_无控制器:
  设 册 为 造任务册(2)
  设 册["全域控制器"] 为 0
  设 占位 为 校验启动(["kind": "bash", "label": "x"], 册)

段落 段_kind空:
  设 册 为 造任务册(2)
  设 占位 为 校验启动(["kind": "", "label": "x"], 册)

段落 段_label空:
  设 册 为 造任务册(2)
  设 占位 为 校验启动(["kind": "bash", "label": ""], 册)

段落 段_上限零:
  设 册 为 造任务册(2)
  设 占位 为 校验启动(["kind": "bash", "label": "x", "outputLimitBytes": 0], 册)

段落 段_上限负:
  设 册 为 造任务册(2)
  设 占位 为 校验启动(["kind": "bash", "label": "x", "outputLimitBytes": 0 - 1], 册)

段落 段_上限小数:
  设 册 为 造任务册(2)
  设 占位 为 校验启动(["kind": "bash", "label": "x", "outputLimitBytes": 1.5], 册)

段落 段_槽位满:
  设 册 为 造任务册(1)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 占位 为 校验启动(["kind": "bash", "label": "b"], 册)

段落 用例启动校验:
  检查抛错("无控制器应抛", 段_无控制器)
  检查抛错("kind 空串应抛", 段_kind空)
  检查抛错("label 空串应抛", 段_label空)
  检查抛错("outputLimitBytes=0 应抛", 段_上限零)
  检查抛错("outputLimitBytes<0 应抛", 段_上限负)
  检查抛错("outputLimitBytes 非安全整数应抛", 段_上限小数)
  检查抛错("槽位满应抛", 段_槽位满)
  设 册 为 造任务册(2)
  断言相等(校验启动(["kind": "bash", "label": "x", "outputLimitBytes": 1024], 册), 真, "合法规格通过校验")
  断言相等(校验启动(["kind": "bash", "label": "x"], 册), 真, "省略输出上限亦合法")

段落 用例启动原子性:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b"], 2)
  断言相等(活动任务数(册, 空), 2, "已登记两条")
  断言相等(查类别序号(册, "bash"), 3, "下一个序号为 3")
  设 抛了 为 假
  尝试:
    设 占位 为 登记任务(册, ["kind": "", "label": "c"], 3)
  捕获 错误:
    设 抛了 为 真
  断言相等(抛了, 真, "非法 kind 登记应抛")
  断言相等(活动任务数(册, 空), 2, "校验失败不写记录")
  断言相等(查类别序号(册, "bash"), 3, "校验失败不推进计数器")

# =====================================================================
# 8. list 归属过滤（jobs-local L192-197）
# =====================================================================
段落 用例列出快照:
  设 册 为 造任务册(10)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a", "owner": "s1"], 1)
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b", "owner": 空], 2)
  设 丙 为 登记任务(册, ["kind": "sleep", "label": "c", "owner": "s2"], 3)
  设 见1 为 列出快照(册, "s1")
  断言相等(列表长度(见1), 2, "s1 见自身 + 无主任务")
  设 见2 为 列出快照(册, "s2")
  断言相等(列表长度(见2), 2, "s2 见自身 + 无主任务")
  设 见0 为 列出快照(册, 空)
  断言相等(列表长度(见0), 1, "无 agent 调用者只见无主任务")

# =====================================================================
# 9. kill 状态迁移与返回码（jobs-local L215-228）
# =====================================================================
段落 段_跨归属终止:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a", "owner": "s1"], 1)
  设 码 为 执行终止(册, 甲, "s2")

段落 用例终止:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a", "owner": "s1"], 1)
  设 记录 为 定位记录(册, 甲)
  设 码 为 执行终止(册, 甲, "s1")
  断言相等(码, "requested", "running 上终止 → requested")
  断言相等(记录["status"], "stopping", "running → stopping")
  断言相等(记录["reported"], 真, "终止即标 reported")
  设 码2 为 执行终止(册, 甲, "s1")
  断言相等(码2, "requested", "stopping 非终态，再终止仍 requested")
  断言相等(记录["status"], "stopping", "重复终止不迁状态")
  设 完成后 为 结算任务(册, 甲, "killed", 空, 空, 9)
  设 码3 为 执行终止(册, 甲, "s1")
  断言相等(码3, "already-finished", "终态上终止 → already-finished")
  断言相等(记录["status"], "killed", "终态不被终止改写")
  断言相等(记录["reported"], 真, "终态终止仍标 reported")
  段_终态分支未标前()
  检查抛错("跨归属终止应抛", 段_跨归属终止)
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b", "owner": 空], 2)
  设 码4 为 执行终止(册, 乙, 空)
  断言相等(码4, "requested", "无主任务对无 agent 调用者开放")

# 终态任务在「尚未标 reported」时被 kill，也必须补标 reported
段落 段_终态分支未标前:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 完成后 为 结算任务(册, 甲, "completed", 空, 空, 2)
  设 记录 为 定位记录(册, 甲)
  断言相等(记录["reported"], 假, "无人等待时结算不上报")
  设 码 为 执行终止(册, 甲, 空)
  断言相等(码, "already-finished", "completed 上终止返回 already-finished")
  断言相等(记录["reported"], 真, "already-finished 分支补标 reported")

# =====================================================================
# 10. read 产出投影 + 终态标 reported（jobs-local L205-213）
# =====================================================================
段落 用例读取产出:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 读1 为 读取产出(册, 甲, 空)
  断言相等(读1["text"], "", "非终态读取为空串")
  设 记录 为 定位记录(册, 甲)
  断言相等(记录["reported"], 假, "非终态读取不标 reported")
  设 完成后 为 结算任务(册, 甲, "completed", 空, "结果文本", 5)
  设 读2 为 读取产出(册, 甲, 空)
  断言相等(读2["text"], "结果文本", "终态读取返回产出")
  断言相等(记录["reported"], 真, "终态读取标 reported")
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b"], 6)
  设 完成后 为 结算任务(册, 乙, "failed", "坏了", 空, 7)
  设 读3 为 读取产出(册, 乙, 空)
  断言相等(读3["text"], "", "终态无产出仍返回空串")

# =====================================================================
# 11. settle 首胜（jobs-local L416-428）
# =====================================================================
段落 用例首胜结算:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 完成后 为 结算任务(册, 甲, "completed", "首次", "OUT1", 100)
  设 记录 为 定位记录(册, 甲)
  断言相等(记录["status"], "completed", "首次结算写终态")
  断言相等(记录["detail"], "首次", "首次结算写详情")
  断言相等(记录["output"], "OUT1", "首次结算写产出")
  断言相等(记录["finishedAt"], 100, "首次结算写完成时刻")
  断言相等(记录["reported"], 假, "无人等待时不标 reported")
  设 迟到 为 结算任务(册, 甲, "killed", "迟到", "OUT2", 200)
  断言相等(记录["status"], "completed", "迟到结算被丢弃")
  断言相等(记录["detail"], "首次", "迟到结算不改详情")
  断言相等(记录["output"], "OUT1", "迟到结算不改产出")
  断言相等(记录["finishedAt"], 100, "迟到结算不改完成时刻")
  设 乙 为 登记任务(册, ["kind": "bash", "label": "b"], 2)
  设 计次 为 记入等待者(册, 乙)
  断言相等(计次, 1, "记入等待者后计数 1")
  设 完成后 为 结算任务(册, 乙, "completed", 空, 空, 300)
  设 记录2 为 定位记录(册, 乙)
  断言相等(记录2["reported"], 真, "有人等待时结算标 reported")
  设 丙 为 登记任务(册, ["kind": "bash", "label": "c"], 3)
  设 占位 为 执行终止(册, 丙, 空)
  设 完成后 为 结算任务(册, 丙, "killed", 空, 空, 400)
  设 记录3 为 定位记录(册, 丙)
  断言相等(记录3["status"], "killed", "stopping 可被结算到 killed")

# =====================================================================
# 12. 等待者记账（jobs-local L240/244-246/273-275）
# =====================================================================
段落 用例等待者记账:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  断言相等(记入等待者(册, 甲), 1, "首次记入 = 1")
  断言相等(记入等待者(册, 甲), 2, "再次记入 = 2")
  断言相等(移出等待者(册, 甲), 1, "移出 = 1")
  断言相等(移出等待者(册, 甲), 0, "再移出 = 0")
  断言相等(移出等待者(册, 甲), 0, "等待者计数不为负")

# =====================================================================
# 13. wait 时限校验（jobs-local L233-235）
# =====================================================================
段落 段_时限零:
  设 占位 为 校验等待时限(0)

段落 段_时限负:
  设 占位 为 校验等待时限(0 - 1)

段落 段_时限空:
  设 占位 为 校验等待时限(空)

段落 段_时限串:
  设 占位 为 校验等待时限("100")

段落 用例等待时限:
  断言相等(判定等待结局(假, 真), "timeout", "到达期限 → timeout")
  断言相等(判定等待结局(真, 假), "aborted", "仅信号中止 → aborted")
  断言相等(判定等待结局(真, 真), "timeout", "期限优先于中止")
  断言相等(判定等待结局(假, 假), "settled", "二者皆无 → settled")
  断言相等(校验等待时限(1), 真, "正数时限合法")
  断言相等(校验等待时限(0.5), 真, "小数正时限合法")
  检查抛错("时限 0 应抛", 段_时限零)
  检查抛错("时限负数应抛", 段_时限负)
  检查抛错("时限为空应抛", 段_时限空)
  检查抛错("时限为字符串应抛", 段_时限串)

# =====================================================================
# 14. 推演等待全路径（jobs-local L230-279）
# =====================================================================
段落 段_等待跨归属:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a", "owner": "s1"], 1)
  设 局 为 推演等待(册, 甲, 100, "s2", 假, 假, 空)

段落 段_等待非法时限:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 0, 空, 假, 假, 空)

段落 段_等待已取消:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 100, 空, 真, 假, 空)

段落 段_等待被取消:
  设 册 为 造任务册(2)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 100, 空, 真, 假, 空)

段落 用例推演等待:
  检查抛错("跨归属 wait 应抛", 段_等待跨归属)
  检查抛错("wait 时限非法应抛", 段_等待非法时限)
  检查抛错("wait 前已取消应抛", 段_等待已取消)
  检查抛错("wait 中被取消应抛", 段_等待被取消)
  段_等待已终态()
  段_等待到期()
  段_等待到期且结算()
  段_等待结算()
  段_等待后状态不变()

# 已进入终态：不等待、直接标 reported，结局 settled
段落 段_等待已终态:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 完成后 为 结算任务(册, 甲, "completed", 空, 空, 2)
  设 局 为 推演等待(册, 甲, 100, 空, 真, 真, 空)
  断言相等(局["结局"], "settled", "已终态直接 settled（不进等待分支）")
  断言相等(局["快照"]["reported"], 真, "已终态等待标 reported")
  断言相等(局["快照"]["status"], "completed", "已终态状态不变")

# 等待超时：任务仍存活，状态与 reported 均不变
段落 段_等待到期:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 记录 为 定位记录(册, 甲)
  设 局 为 推演等待(册, 甲, 100, 空, 假, 真, 空)
  断言相等(局["结局"], "timeout", "到期 → timeout")
  断言相等(局["快照"]["status"], "running", "超时后任务仍 running")
  断言相等(局["快照"]["reported"], 假, "超时不标 reported")
  断言相等(记录["waiters"], 0, "等待结束后等待者归零")

# 到期与结算同时发生：结局仍是 timeout，但因已终态而标 reported
段落 段_等待到期且结算:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 100, 空, 假, 真, "failed")
  断言相等(局["结局"], "timeout", "到期优先，结局为 timeout")
  断言相等(局["快照"]["status"], "failed", "结算仍生效")
  断言相等(局["快照"]["reported"], 真, "终态补标 reported")

# 等待期间结算：结局 settled，waiters>0 期间结算即标 reported
段落 段_等待结算:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 100, 空, 假, 假, "completed")
  断言相等(局["结局"], "settled", "无中止无到期 → settled")
  断言相等(局["快照"]["status"], "completed", "结算写终态")
  断言相等(局["快照"]["reported"], 真, "有人等待时结算标 reported")
  设 记录 为 定位记录(册, 甲)
  断言相等(记录["waiters"], 0, "结算后等待者已移出")

# 结局 settled 但未提供结算阶段（契约外）：状态原样返回
段落 段_等待后状态不变:
  设 册 为 造任务册(4)
  设 甲 为 登记任务(册, ["kind": "bash", "label": "a"], 1)
  设 局 为 推演等待(册, 甲, 100, 空, 假, 假, 空)
  断言相等(局["结局"], "settled", "未提供结算阶段的 settled")
  断言相等(局["快照"]["status"], "running", "未结算则状态不变")
  断言相等(局["快照"]["reported"], 假, "未终态则不标 reported")

# =====================================================================
# 15. tool-jobs 配置与预算（tool-jobs L205-222）
# =====================================================================
段落 段_默认超上限:
  设 占位 为 校验插件配置(600001, 600000, 3)

段落 段_预算小数:
  设 占位 为 校验插件配置(30000, 600000, 1.5)

段落 段_预算空:
  设 占位 为 校验插件配置(30000, 600000, 空)

段落 段_投递非法:
  设 占位 为 校验投递方式("nope")

段落 用例插件配置:
  断言相等(校验插件配置(30000, 600000, 3), 真, "默认配置合法")
  断言相等(校验插件配置(600000, 600000, 1), 真, "默认等于上限合法")
  断言相等(校验投递方式("wakeup"), 真, "wakeup 合法")
  断言相等(校验投递方式("quiet"), 真, "quiet 合法")
  检查抛错("waitTimeoutMs 超过上限应抛", 段_默认超上限)
  检查抛错("maxConsecutiveWakes 小数应抛", 段_预算小数)
  检查抛错("maxConsecutiveWakes 为空应抛", 段_预算空)
  检查抛错("非法 completionDelivery 应抛", 段_投递非法)
  # 边界锁定：原版 min(1) 由 schemastery Config 强制（z.number().min(1)），
  #   apply()（L220）只查 Number.isSafeInteger，故 0 在代码层不抛。
  断言相等(校验插件配置(30000, 600000, 0), 真, "预算 0 在代码层合法（min(1) 属 schema 层）")
  断言相等(校验插件配置(30000, 600000, 0 - 2), 真, "负预算在代码层同样只查安全整数")

# =====================================================================
# 16. wait 时限取定（tool-jobs L333）
# =====================================================================
段落 用例约束时限:
  断言相等(约束等待时限(空, 30000, 600000), 30000, "未给 timeout_ms 取默认")
  断言相等(约束等待时限(5000, 30000, 600000), 5000, "小于默认取给定值")
  断言相等(约束等待时限(900000, 30000, 600000), 600000, "超过硬上限被压住")
  断言相等(约束等待时限(空, 900000, 600000), 600000, "默认本身超限也被压住")
  断言相等(约束等待时限(600000, 30000, 600000), 600000, "恰好等于上限")
  设 时限 为 约束等待时限(900000, 30000, 600000)
  断言相等(校验等待时限(时限), 真, "压住后的时限仍合法")

# =====================================================================
# 17. 唤醒预算（tool-jobs L226-230 / L293-300）
# =====================================================================
段落 用例唤醒预算:
  断言相等(判定投递("wakeup", 真, 0, 3), "followup", "闲置且预算充足 → followup")
  断言相等(判定投递("wakeup", 假, 0, 3), "inject", "繁忙 → inject")
  断言相等(判定投递("quiet", 真, 0, 3), "inject", "quiet 投递 → inject")
  断言相等(判定投递("wakeup", 真, 2, 3), "followup", "预算未耗尽 → followup")
  断言相等(判定投递("wakeup", 真, 3, 3), "inject", "预算耗尽 → inject")
  设 已用表 为 {}
  断言相等(查唤醒次数(已用表, "s1"), 0, "初始已用 0")
  设 首 为 记入唤醒(已用表, "s1", 3, "wakeup", 真)
  断言相等(首["投递"], "followup", "第 1 次唤醒开轮")
  断言相等(首["已用"], 1, "第 1 次后已用 1")
  设 次 为 记入唤醒(已用表, "s1", 3, "wakeup", 真)
  断言相等(次["已用"], 2, "第 2 次后已用 2")
  设 第三轮 为 记入唤醒(已用表, "s1", 3, "wakeup", 真)
  断言相等(第三轮["已用"], 3, "第 3 次后已用 3")
  设 第四轮 为 记入唤醒(已用表, "s1", 3, "wakeup", 真)
  断言相等(第四轮["投递"], "inject", "第 4 次降级注入")
  断言相等(第四轮["已用"], 3, "降级不再扣预算")
  设 忙 为 记入唤醒(已用表, "s1", 3, "wakeup", 假)
  断言相等(忙["投递"], "inject", "繁忙调用者只注入")
  断言相等(忙["已用"], 3, "注入不扣预算")
  设 重置后 为 重置唤醒(已用表, "s1")
  断言相等(重置后, 0, "人类输入认领后预算重置")
  设 再 为 记入唤醒(已用表, "s1", 3, "wakeup", 真)
  断言相等(再["投递"], "followup", "重置后可再次开轮")
  断言相等(再["已用"], 1, "重置后已用重新计数")

