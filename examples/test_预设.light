# test_预设.light —— 对标 #72：agent-presets 纯逻辑复刻
# 原版：packages/preset/agent-presets/src/{specifier,preset,metadata,session,discovery,mount,authoring}.ts
#   （index.ts 装配层 / invariant.ts Cordis 宿主绑定 不在本批白名单，未复刻）
#
# 复刻边界：node:fs / node:path / js-yaml / node:module / Cordis 运行时 一律投影为
#   「入参能力函数 / 注入字典」。fiber 对象同一性 → 标识图（父标识 + 纤维表）；
#   service store → 服务列表（每项 {name,fiber标识,在根隔离}）；YAML 解析 → 解析能力。
#
# 反跑判据（改反必须红，见 _task72_report.md 实测）：
#   ① 标识合法 首字符闸移除 → "-bad" 误判合法即红
#   ② 条目列表问题 空名闸移除 → 空名行误判过关即红
#   ③ 不可解析行 解析闸移除 → 不存在的包误判可解析即红
#   ④ 扫描根排序 比较符取反 → 顺序颠倒即红
#   ⑤ 在纤维内 环回闸移除（父==自身仍继续）→ 非隶属误判隶属即红
#   ⑥ 可删判定 trust 闸移除 → system 预设误判可删即红
#   ⑦ 造未知道错误 消息丢 id → 消息断言失败即红
#   ⑧ 预设投影应用 selected 分支恒返回状态 → 推进失效即红
#
# 语言坑规避：断言一律 断言相等（L-037 no-op）；写 只吃字面量串；
#   字典键带引号（L-063）；列表/字典字面量一律单行（L-051）；嵌套字面量内不写 \n（L-054）；
#   错误对象不可当字典，捕获后 转字符串 取消息（L-055 配套）；主程() 显式调用。

从 预设 导入 分类行标识符, 是绝对, 前缀是, 标识合法, 校验预设标识, 可用文本, 造未知道错误, 造锁错误, 造挂载错误, 造只读错误, 造坏请求错误, 造内部错误, 文本, 提取显示元数据, 造显示元数据记录, 预设投影初值, 预设投影应用, 行启用, 条目列表问题, 不可解析行, 合成问题, 应前, 交换元素, 扫描根排序, 发现预设, 在纤维内, 泄出服务, 排序名, 未激活行, 名文本, 明细分支, 挂载明细, 可写根, 可删判定, 可复制元数据

# =====================================================================
# 断言框架（诊断全部走 抛出 新建 错误，不用 写）
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛文(标签, 子串, 运算):
  设 抛了 为 假
  设 文 为 ""
  尝试: 运算()
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 子串) == 假):
    抛出 新建 错误("错误消息不符[" + 标签 + "]：实际=" + 文 + " 期望含=" + 子串)

# =====================================================================
# 一、specifier.ts —— 行标识符分类
# =====================================================================
段落 用例_分类行标识符:
  断言相等(分类行标识符("cordis:x")["种类"], "builtin", "分类_cordis")
  断言相等(分类行标识符("./a/b")["种类"], "preset", "分类_相对")
  断言相等(分类行标识符("file:/x/y")["种类"], "file", "分类_fileURL")
  断言相等(分类行标识符("/abs/path")["种类"], "file", "分类_绝对")
  断言相等(分类行标识符("C:\\x")["种类"], "file", "分类_盘符")
  断言相等(分类行标识符("@scope/pkg")["种类"], "package", "分类_包")
  断言相等(分类行标识符("cordis:x")["标识符"], "cordis:x", "分类_标识符保留")

段落 用例_是绝对:
  断言相等(是绝对("/abs"), 真, "绝对_根")
  断言相等(是绝对("C:\\x"), 真, "绝对_盘符")
  断言相等(是绝对("./rel"), 假, "绝对_相对")
  断言相等(是绝对("pkg"), 假, "绝对_包")
  断言相等(是绝对(""), 假, "绝对_空")

# =====================================================================
# 二、preset.ts —— 标识校验 + 远程错误构造
# =====================================================================
段落 用例_标识合法:
  断言相等(标识合法("abc"), 真, "标识_小写")
  断言相等(标识合法("a1"), 真, "标识_字母数字")
  断言相等(标识合法("my-preset-2"), 真, "标识_连字符")
  断言相等(标识合法("-bad"), 假, "标识_连字符开头")
  断言相等(标识合法("Bad"), 假, "标识_大写")
  断言相等(标识合法(""), 假, "标识_空")
  断言相等(校验预设标识("abc"), 真, "校验别名")

段落 用例_错误构造:
  设 错 为 造未知道错误("p1", ["a", "b"])
  断言相等(错["码"], "agent-preset-not-found", "未知道_码")
  断言相等(错["消息"], "agent-presets: preset \"p1\" not found (available: a, b)", "未知道_消息")
  断言相等(错["详情"]["agentPreset"], "p1", "未知道_详情")
  设 锁 为 造锁错误("s1", "p1")
  断言相等(锁["码"], "agent-preset-locked", "锁_码")
  断言相等(锁["详情"]["sessionId"], "s1", "锁_会话")
  设 挂 为 造挂载错误("p1", "boom")
  断言相等(挂["码"], "agent-preset-invalid", "挂载_码")
  断言相等(挂["详情"]["reason"], "boom", "挂载_理由")
  设 只读 为 造只读错误("p1", "shipped")
  断言相等(只读["码"], "agent-preset-read-only", "只读_码")
  设 坏 为 造坏请求错误()
  断言相等(坏["码"], "bad-request", "坏请求_码")
  设 内 为 造内部错误()
  断言相等(内["码"], "internal", "内部_码")
  断言相等(可用文本([]), "none", "可用文本_空")
  断言相等(可用文本(["x"]), "x", "可用文本_单")

# =====================================================================
# 三、metadata.ts —— 显示元数据
# =====================================================================
段落 用例_文本:
  断言相等(文本("  hi  "), "hi", "文本_去空白")
  断言相等(文本(""), 空, "文本_空串")
  断言相等(文本(空), 空, "文本_非串")
  断言相等(文本(123), 空, "文本_数字")

段落 用例_提取显示元数据:
  断言相等(提取显示元数据({"name":"N","description":"D","order":3}), {"name":"N","description":"D","order":3}, "提取_全")
  断言相等(提取显示元数据({}), {}, "提取_空")
  断言相等(提取显示元数据({"name":"  ","description":"","order":"x"}), {}, "提取_滤除")
  断言相等(提取显示元数据({"order":2.5}), {}, "提取_浮点order")

段落 用例_造显示元数据记录:
  断言相等(造显示元数据记录({"name":"N","description":"D"}), {"name":"N","description":"D"}, "渲染_取舍")
  断言相等(造显示元数据记录({}), 空, "渲染_全空")

# =====================================================================
# 四、session.ts —— 投影 reducer
# =====================================================================
段落 用例_投影:
  断言相等(预设投影初值({"agentPreset":"x"}), "x", "初值_有")
  断言相等(预设投影初值({}), 空, "初值_无")
  断言相等(预设投影应用("x", {"type":"agent-preset/selected","data":{"agentPreset":"y"}}), "y", "应用_选中")
  断言相等(预设投影应用("x", {"type":"other"}), "x", "应用_保持")

# =====================================================================
# 五、discovery.ts —— 发现纯逻辑
# =====================================================================
# 行解析能力桩：builtin/preset/file → 真；package 仅 "ok-pkg" 命中
段落 解析能力_桩(分类, 预设基, 宿主基):
  如果 (分类["种类"] == "builtin"): 返回 真
  如果 (分类["种类"] == "preset"): 返回 真
  如果 (分类["种类"] == "file"): 返回 真
  如果 (分类["标识符"] == "ok-pkg"): 返回 真
  返回 假

段落 用例_条目列表问题:
  断言相等(条目列表问题([{"name":"x"}], ""), 空, "形状_合法")
  断言相等(条目列表问题("notlist", ""), "the composition must be a top-level list of plugin rows", "形状_非列表")
  断言相等(条目列表问题([{"name":""}], ""), "row 1 names no plugin (a \"name\" string is required)", "形状_空名")
  断言相等(条目列表问题([{"name":123}], ""), "row 1 names no plugin (a \"name\" string is required)", "形状_非串名")
  断言相等(条目列表问题(["notmap"], ""), "row 1 is not a plugin row (expected a map with a \"name\")", "形状_非字典")
  断言相等(条目列表问题([{"name":"g","group":真,"config":[{"name":""}]}], ""), "row 1 row 1 names no plugin (a \"name\" string is required)", "形状_分组")

段落 用例_不可解析行:
  设 行 为 [{"id":"r1","name":"ok-pkg"}, {"id":"r2","name":"missing-pkg"}]
  设 不可 为 不可解析行(行, "p", "h", 解析能力_桩, "")
  断言相等(列表长度(不可), 1, "不可解析_计数")
  断言相等(列表获取(不可, 0)["名"], "missing-pkg", "不可解析_命中")
  断言相等(列表获取(不可, 0)["标签"], "row \"r2\"", "不可解析_标签")
  设 行2 为 [{"name":"missing-pkg","disabled":真}]
  断言相等(列表长度(不可解析行(行2, "p", "h", 解析能力_桩, "")), 0, "不可解析_跳过disabled")

段落 合成读能力(路径):
  返回 "name: x"

段落 合成解能力(内容):
  返回 [{"name":"cordis:x"}]

段落 合成解坏(内容):
  抛出 新建 错误("YAML boom")

段落 合成读坏(路径):
  抛出 新建 错误("ENOENT")

段落 合成解缺包(内容):
  返回 [{"id":"r1","name":"ghost-pkg"}]

段落 用例_合成问题:
  断言相等(合成问题("/p/agent.cordis.yml", "h", 合成读能力, 合成解能力), 空, "合成_合法")
  断言相等(合成问题("/p/agent.cordis.yml", "h", 合成读能力, 合成解坏), "the composition is not valid YAML: YAML boom", "合成_YAML坏")
  断言相等(合成问题("/p/missing.yml", "h", 合成读坏, 合成解能力), "the composition file agent.cordis.yml cannot be read", "合成_读坏")
  设 问题 为 合成问题("/p/agent.cordis.yml", "h", 合成读能力, 合成解缺包)
  断言相等(问题, "row \"r1\" names a plugin that cannot be resolved: ghost-pkg", "合成_不可解析")

段落 用例_扫描根排序:
  设 列表 为 [{"id":"b","order":2},{"id":"a","order":1},{"id":"c"},{"id":"d","order":1}]
  设 排序后 为 扫描根排序(列表)
  断言相等(列表获取(排序后, 0)["id"], "a", "排序_a")
  断言相等(列表获取(排序后, 1)["id"], "d", "排序_d同序")
  断言相等(列表获取(排序后, 2)["id"], "b", "排序_b")
  断言相等(列表获取(排序后, 3)["id"], "c", "排序_c无序")

段落 用例_发现预设:
  设 根表 为 [{"预设列表":[{"id":"x","trust":"system"},{"id":"y","trust":"system"}]}, {"预设列表":[{"id":"x","trust":"user"},{"id":"z","trust":"user"}]}]
  设 发现 为 发现预设(根表)
  断言相等(列表长度(发现), 3, "发现_去重计数")
  断言相等(列表获取(发现, 0)["id"], "x", "发现_首根")
  断言相等(列表获取(发现, 0)["trust"], "system", "发现_首根信任")

# =====================================================================
# 六、mount.ts —— 审计纯逻辑
# =====================================================================
段落 用例_在纤维内:
  设 纤维表 为 {"r":{"父标识":"r"}, "m":{"父标识":"r"}, "c":{"父标识":"m"}}
  断言相等(在纤维内(纤维表, "c", "r"), 真, "隶属_深层")
  断言相等(在纤维内(纤维表, "m", "r"), 真, "隶属_直接")
  断言相等(在纤维内(纤维表, "r", "c"), 假, "隶属_反向")
  断言相等(在纤维内(纤维表, "x", "r"), 假, "隶属_无此纤维")

段落 用例_泄出服务:
  设 纤维表 为 {"r":{"父标识":"r"}, "m":{"父标识":"r"}}
  设 服务 为 [{"name":"s1","fiber标识":"m","在根隔离":真},{"name":"s2","fiber标识":"x","在根隔离":真},{"name":"s3","fiber标识":"m","在根隔离":假}]
  设 漏 为 泄出服务(服务, 纤维表, "r")
  断言相等(列表长度(漏), 1, "泄出_计数")
  断言相等(列表获取(漏, 0), "s1", "泄出_命中")
  设 服务2 为 [{"name":"zebra","fiber标识":"m","在根隔离":真},{"name":"alpha","fiber标识":"m","在根隔离":真}]
  断言相等(泄出服务(服务2, 纤维表, "r"), ["alpha", "zebra"], "泄出_排序")

段落 用例_未激活行:
  设 条目 为 [{"id":"p1","name":"Plugin1","disabled":假,"fiber":{"inject":["svcA","svcB"],"已有":{"svcA":真}}},{"id":"p2","name":"Plugin2","disabled":真,"fiber":{"inject":["x"],"已有":{}}},{"id":"p3","name":"Plugin3","disabled":假,"fiber":空}]
  设 未激 为 未激活行(条目)
  断言相等(列表长度(未激), 2, "未激活_计数")
  断言相等(列表获取(未激, 0), "p1 (Plugin1): waiting for svcB", "未激活_缺服务")
  断言相等(列表获取(未激, 1), "p3 (Plugin3): never started", "未激活_无fiber")

段落 用例_挂载明细:
  设 换行 为 chr(10)
  设 平 为 {"消息":"loader failed"}
  断言相等(挂载明细(平), "loader failed", "明细_平")
  设 分支错 为 {"消息":"loader failed","分支":[{"消息":"row 1 boom"}]}
  断言相等(挂载明细(分支错), "loader failed" + 换行 + "- row 1 boom", "明细_一层")
  设 嵌套 为 {"消息":"outer","原因":{"消息":"mid","分支":[{"消息":"inner1"},{"消息":"inner2"}]}}
  断言相等(挂载明细(嵌套), "outer" + 换行 + "- mid" + 换行 + "- inner1" + 换行 + "- inner2", "明细_嵌套")

# =====================================================================
# 七、authoring.ts —— 作者面纯逻辑
# =====================================================================
# 可删判定相关测试数据（Light 不做调用方局部变量的闭包捕获，抛错桩函数需读模块级全局）
设 系统预设 为 {"id":"p","trust":"system","path":"/s/p"}
设 越界 为 {"id":"p","trust":"user","path":"/other/p"}
设 相对 为 {"id":"p","trust":"user","path":"rel/p"}

段落 抛_无user根 ():
  可写根([{"trust":"system","path":"/s"}])

段落 用例_可写根:
  设 根列表 为 [{"trust":"system","path":"/s"},{"trust":"user","path":"/u"}]
  断言相等(可写根(根列表), "/u", "可写根_首个user")
  检查抛文("可写根_无user", "no user-writable preset root", 抛_无user根)

段落 抛_系统预设 ():
  可删判定(系统预设, "/u")

段落 抛_越界 ():
  可删判定(越界, "/u")

段落 抛_相对 ():
  可删判定(相对, "/u")

段落 用例_可删判定:
  设 用户预设 为 {"id":"p","trust":"user","path":"/u/p"}
  断言相等(可删判定(用户预设, "/u"), 真, "可删_user")
  检查抛文("可删_system", "it ships with the deployment", 抛_系统预设)
  检查抛文("可删_越界", "does not live under the writable preset root", 抛_越界)
  检查抛文("可删_相对", "does not live under the writable preset root", 抛_相对)

段落 用例_可复制元数据:
  设 源 为 {"description":"keep me"}
  设 复制 为 可复制元数据(源, "copyName")
  断言相等(复制, {"name":"copyName","description":"keep me"}, "复制_取舍")
  断言相等(可复制元数据({"order":3}, "copyOnly"), {"name":"copyOnly"}, "复制_仅name")

# =====================================================================
# 八、反跑判据（源正确时这些断言恒成立；源被改反则变红，详见报告）
# =====================================================================
段落 反跑_标识合法:
  断言相等(标识合法("-bad"), 假, "反跑_连字符开头必须非法")

段落 反跑_条目列表问题:
  断言相等(条目列表问题([{"name":""}], ""), "row 1 names no plugin (a \"name\" string is required)", "反跑_空名必须拒")

段落 反跑_不可解析行:
  设 行 为 [{"id":"r2","name":"missing-pkg"}]
  断言相等(列表长度(不可解析行(行, "p", "h", 解析能力_桩, "")), 1, "反跑_缺失包必须不可解析")

段落 反跑_扫描根排序:
  设 列表 为 [{"id":"b","order":2},{"id":"a","order":1}]
  断言相等(列表获取(扫描根排序(列表), 0)["id"], "a", "反跑_小order在前")

段落 反跑_在纤维内:
  设 纤维表 为 {"r":{"父标识":"r"}, "m":{"父标识":"r"}}
  断言相等(在纤维内(纤维表, "x", "r"), 假, "反跑_无关节点必须不隶属")

段落 抛_反跑系统 ():
  可删判定(系统预设, "/u")

段落 反跑_可删判定:
  设 系统预设 为 {"id":"p","trust":"system","path":"/s/p"}  # 抑制L166
  检查抛文("反跑_系统预设不可删", "it ships with the deployment", 抛_反跑系统)

段落 反跑_造未知道错误:
  设 错 为 造未知道错误("p1", ["a", "b"])
  断言相等(字符串包含(错["消息"], "p1"), 真, "反跑_消息须含id")

段落 反跑_预设投影应用:
  断言相等(预设投影应用("x", {"type":"agent-preset/selected","data":{"agentPreset":"y"}}), "y", "反跑_选中须推进")

