# test_R71_A_三元表达式.light —— R71 任务A（G-01 三元表达式）
# 验收（任务书 R71-A）：
#   1. 基础三元（数字/字符串/布尔）
#   2. 嵌套三元
#   3. 三元作为函数参数
#   4. 三元与算术运算混合
#   5. 三元条件为假时取否则分支
#   6. 形式1（如果…则…否则…）与后置式（值 如果 条件 否则 值）等价性断言
#   附加边界：列表/字典字面量内三元（不吞逗号）、返回语句三元、
#             函数多参数中三元后逗号、语句位置 如果 不受影响、缺省否则分支。

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 "断言失败(应为真): " + 标签

设 x 为 10
设 y 为 3

# ── 1. 基础三元（数字/字符串/布尔） ──
设 r_num 为 如果 x > 5 则 1 否则 0
断言等于(r_num, 1, "基础三元-数字")

设 r_str 为 如果 x > 5 则 "大" 否则 "小"
断言等于(r_str, "大", "基础三元-字符串")

设 r_bool 为 如果 x > 5 则 真 否则 假
断言等于(r_bool, 真, "基础三元-布尔")

# ── 2. 嵌套三元 ──
# 嵌套在则分支
设 r_nest_then 为 如果 x > 5 则 如果 y > 5 则 "两大" 否则 "x大y小" 否则 "全小"
断言等于(r_nest_then, "x大y小", "嵌套三元-则分支")

# 嵌套在否则分支
设 r_nest_else 为 如果 x > 100 则 "a" 否则 如果 x > 5 则 "b" 否则 "c"
断言等于(r_nest_else, "b", "嵌套三元-否则分支")

# 后置式嵌套
设 r_nest_post 为 "甲" 如果 x > 100 否则 "乙" 如果 x > 5 否则 "丙"
断言等于(r_nest_post, "乙", "嵌套三元-后置式")

# ── 3. 三元作为函数参数 ──
段落 描述(值):
  返回 "值是" + 值
断言等于(描述(如果 x > 5 则 "大" 否则 "小"), "值是大", "三元作函数参数")

# 三元后跟后续参数（逗号不被三元吞掉）
段落 两参(a, b):
  返回 a * 100 + b
断言等于(两参(如果 x > 5 则 1 否则 2, 7), 107, "三元后多参数逗号")

# ── 4. 三元与算术运算混合 ──
# 条件含算术
设 r_cond_arith 为 如果 x + 1 > 10 则 "过十" 否则 "未过十"
断言等于(r_cond_arith, "过十", "三元条件含算术")

# 括号内三元结果参与算术
设 r_paren 为 (如果 x > 5 则 10 否则 20) + 1
断言等于(r_paren, 11, "括号三元参与算术")

# 否则分支含算术（条件为假时验证分支整体求值）
设 r_else_arith 为 如果 x > 100 则 1 否则 0 + 100
断言等于(r_else_arith, 100, "否则分支含算术")

# 三元结果再比较
设 r_cmp 为 (如果 x > 5 则 20 否则 1) > 15
断言等于(r_cmp, 真, "三元结果再比较")

# ── 5. 条件为假时取否则分支 ──
设 r_false 为 如果 x < 5 则 "小" 否则 "不小"
断言等于(r_false, "不小", "假条件取否则分支")

# ── 6. 形式1与后置式等价性 ──
设 p1 为 如果 x > 5 则 "大" 否则 "小"
设 p2 为 "大" 如果 x > 5 否则 "小"
断言为真(p1 == p2, "前缀式与后置式等价")

# 那么变体与则变体等价
设 p3 为 如果 x > 5 那么 "大" 否则 "小"
断言等于(p3, p1, "那么变体与则变体等价")

# ── 附加：容器字面量内三元（回归：逗号不被吞） ──
设 lst 为 [如果 x > 5 则 1 否则 2, 如果 x < 5 则 3 否则 4]
断言等于(列表长度(lst), 2, "列表内三元-长度")
断言等于(lst[0], 1, "列表内三元-首元素")
断言等于(lst[1], 4, "列表内三元-次元素")

设 dct 为 {"a": 如果 x > 5 则 10 否则 20}
断言等于(dct["a"], 10, "字典值内三元")

# ── 附加：返回语句三元（回归：不再生成裸 return） ──
段落 取标签(n):
  返回 如果 n > 5 则 "大数" 否则 "小数"
断言等于(取标签(8), "大数", "返回语句三元-真")
断言等于(取标签(2), "小数", "返回语句三元-假")

# 返回语句后置三元 + 多值返回逗号共存
段落 多值(c):
  返回 1 如果 c 否则 2, 3
设 mv_a, mv_b 为 多值(假)
断言等于(mv_a, 2, "后置三元后多值-首")
断言等于(mv_b, 3, "后置三元后多值-次")

# ── 附加：缺省否则分支（缺省 None/空） ──
设 r_noelse 为 如果 x > 100 则 "大"
断言等于(r_noelse, 空, "缺省否则分支为空")

# ── 附加：语句位置 如果 不受影响 ──
设 语句检查 为 "未进入"
如果 x > 5:
  设 语句检查 为 "已进入"
断言等于(语句检查, "已进入", "语句位置如果-真分支")

设 语句否则 为 "未走否则"
如果 x < 5:
  设 语句否则 为 "走了真分支"
否则:
  设 语句否则 为 "走了否则"
断言等于(语句否则, "走了否则", "语句位置如果-否则分支")

打印("test_R71_A_三元表达式 全部通过")
