# R88-A 回归：溢出保留 retainContent（对照上游 spill-policy/src/retention.ts）
从 溢出保留 导入 保留内容, 计价, 适配文本
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 主程():
  # 0. 预算 0 → 头/尾皆空
  设 r0 为 保留内容([{"类型": "文本", "文本": "你好世界abc"}], 0)
  断言相等(列表长度(r0["头"]), 0, "预算0: 头空")
  断言相等(列表长度(r0["尾"]), 0, "预算0: 尾空")

  # 1. 总内容在预算内 → 原样保留，无省略
  设 r1 为 保留内容([{"类型": "文本", "文本": "短"}], 100)
  断言相等(列表长度(r1["头"]), 1, "够放: 头含全块")
  断言相等(r1["头"][0]["文本"], "短", "够放: 文本原样")
  断言相等(r1["省略字节"], 0, "够放: 省略字节0")
  断言相等(r1["省略图片"], 0, "够放: 省略图片0")

  # 2. 纯文本超长 → 头/尾各半，中间省略；省略字节 = 总长 - 头 - 尾
  设 长文 为 ""
  设 k 为 0
  当 k < 100:
    设 长文 为 长文 + "x"
    设 k 为 k + 1
  设 r2 为 保留内容([{"类型": "文本", "文本": 长文}], 20)
  断言相等(列表长度(r2["头"]), 1, "长文本: 头有块")
  断言相等(列表长度(r2["尾"]), 1, "长文本: 尾有块")
  断言相等(字符串长度(r2["头"][0]["文本"]), 10, "长文本: 头10字符(ceil 20/2)")
  断言相等(字符串长度(r2["尾"][0]["文本"]), 10, "长文本: 尾10字符(floor 20/2)")
  断言相等(r2["省略字节"], 80, "长文本: 省略80字节")

  # 3. 图片整块不可分割：图片代价1000，预算不够时图片整块省略
  设 r3 为 保留内容(
    [{"类型": "文本", "文本": "AAA"}, {"类型": "图片", "描述": "img1"}, {"类型": "文本", "文本": "BBB"}],
    4
  )
  断言相等(列表长度(r3["头"]), 1, "图片场景: 头有文本块")
  断言相等(字符串长度(r3["头"][0]["文本"]), 2, "图片场景: 头适配2字符")
  断言相等(r3["省略图片"], 1, "图片场景: 图片整块省略")
  设 找到图 为 假
  遍历 b 之 r3["头"]:
    如果 b["类型"] == "图片":
      设 找到图 为 真
  遍历 b 之 r3["尾"]:
    如果 b["类型"] == "图片":
      设 找到图 为 真
  断言相等(找到图, 假, "图片场景: 头/尾均不含图片")

  # 4. 预算够放图片 → 图片整块保留
  设 r4 为 保留内容(
    [{"类型": "图片", "描述": "img1"}],
    2000
  )
  断言相等(列表长度(r4["头"]), 1, "够放图片: 头保留图片")
  断言相等(r4["头"][0]["类型"], "图片", "够放图片: 头是图片")
  断言相等(r4["省略图片"], 0, "够放图片: 无图片省略")

  # 5. 多块文本依次填满头预算
  设 r5 为 保留内容(
    [{"类型": "文本", "文本": "AA"}, {"类型": "文本", "文本": "BB"}, {"类型": "文本", "文本": "CC"}],
    6
  )
  断言相等(列表长度(r5["头"]), 2, "多块: 头含AA+截断B")
  断言相等(r5["头"][0]["文本"], "AA", "多块: 头第一块完整")
  断言相等(字符串长度(r5["头"][1]["文本"]), 1, "多块: 头第二块截断1字符")

  写 "test_R88_A_溢出保留: 全部用例通过"

主程()
