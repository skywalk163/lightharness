# test_钩子协议.light —— 对标 #56：hooks 钩子协议纯逻辑覆盖测试
#
# 反跑判据（必红验证）：
#   1) 把任一 断言相等 的期望值改反 → 测试必须红（RC≠0，报 断言失败）。
#      例：把 用例退出码阻断 里 断言相等(裁定, "block", ...) 的 "block" 改成 "allow" 即红。
#   2) 把任一 检查抛错 用例的前提抹除（让它不再抛）→ 测试必须红。
#      例：把 段_科德非法正则 里的非法正则 "[" 改成合法 "Bash"，该用例即红。
#   两条均已在本机手动改反实测确认 RC=1 后改回。
#
# 语言坑规避（与 src/钩子协议.light 同款）：
#   L-049 多行字面量破坏块缩进 → 所有字面量单行书写。
#   L-045 写 只吃单变量/字面量 → 表达式一律先 设 成变量再 写。
#   L-050 捕获 错误 as 变量 不支持 → 捕获 错误: + 布尔标志。
#   L-051 字符串含 {标识符} 会被当插值 → 需花括号处用 插件根标记()/项目目录标记() 构造。
#   匿名闭包不可用作实参 → 抛错判据一律用具名零参段落。

从 钩子协议 导入 阻断退出码, 方言科德, 方言克劳德, 科德时机表, 克劳德时机表, 无甄别时机表, 字面式, 左花括号, 前置兜底, 后置兜底, 停止兜底, 判通配, 判字面式, 编译可用, 甄别诊断, 甄别命中, 读字符串, 读布尔, 读对象, 顶层裁定, 许可裁定值, 判数值, 解析钩子产出, 应用结构化, 裁定等级, 等级裁定, 连接缘由, 合并钩子产出, 插件根标记, 项目目录标记, 替换指令, 析时机表, 丢弃甄别式, 解析科德配置, 解析克劳德配置, 普通输出作上下文, 决断前置步, 决断器前置, 决断器后置, 决断停止, 择决断缘由
从 JSON 导入 序列化JSON 解析JSON

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 抛了 == 假:
    抛出 新建 错误("应抛错却没抛[" + 标签 + "]")

# =====================================================================
# A. matcher.ts —— 甄别判定
# =====================================================================
段落 用例甄别通配:
  断言相等(判通配(空), 真, "缺失即通配")
  断言相等(判通配(""), 真, "空串即通配")
  断言相等(判通配("*"), 真, "星号即通配")
  断言相等(判通配("Bash"), 假, "普通式非通配")
  断言相等(判通配(".*"), 假, "点星非通配")

段落 用例甄别字面:
  断言相等(判字面式("Bash"), 真, "纯词字符是字面量")
  断言相等(判字面式("Edit|Write"), 真, "竖线分隔仍是字面量")
  断言相等(判字面式("Bash_2"), 真, "数字下划线是字面量")
  断言相等(判字面式("^Ba"), 假, "含锚点不是字面量")
  断言相等(判字面式("a-b"), 假, "含连字符不是字面量")
  断言相等(判字面式("a.*"), 假, "含点星不是字面量")
  断言相等(判字面式(空), 假, "非字符串不是字面量")

段落 用例甄别编译:
  断言相等(编译可用("a+"), 真, "合法正则可编译")
  断言相等(编译可用("^Bash$"), 真, "锚定正则可编译")
  断言相等(编译可用("["), 假, "左括号非法")
  断言相等(编译可用("("), 假, "左圆括号非法")
  断言相等(编译可用("a**"), 假, "重复符叠加非法")
  断言相等(编译可用(空), 假, "非字符串不可编译")

段落 用例甄别诊断:
  断言相等(甄别诊断(空, 方言科德), 空, "通配无诊断")
  断言相等(甄别诊断("*", 方言克劳德), 空, "星号无诊断")
  断言相等(甄别诊断("Bash", 方言克劳德), 空, "克劳德字面量无诊断")
  断言相等(甄别诊断("Edit|Write", 方言克劳德), 空, "克劳德竖线无诊断")
  断言相等(甄别诊断("Bash", 方言科德), 空, "科德按正则亦合法")
  设 诊断 为 甄别诊断("[", 方言科德)
  断言相等(诊断, "invalid codex regex matcher \"[\"", "科德非法正则诊断串")
  设 诊断2 为 甄别诊断("[", 方言克劳德)
  断言相等(诊断2, "invalid claude-code regex matcher \"[\"", "克劳德非法正则诊断串")

段落 用例甄别命中:
  断言相等(甄别命中(空, "任意", 方言科德), 真, "缺失通配命中")
  断言相等(甄别命中("", "任意", 方言克劳德), 真, "空串通配命中")
  断言相等(甄别命中("*", "任意", 方言科德), 真, "星号通配命中")
  断言相等(甄别命中("Bash", "Bash", 方言克劳德), 真, "克劳德字面量精确命中")
  断言相等(甄别命中("Bash", "bash", 方言克劳德), 假, "克劳德字面量大小写敏感")
  断言相等(甄别命中("Edit|Write", "Write", 方言克劳德), 真, "克劳德竖线第二项命中")
  断言相等(甄别命中("Edit|Write", "Read", 方言克劳德), 假, "克劳德竖线未列不命中")
  断言相等(甄别命中("Bash", "xBashx", 方言克劳德), 假, "克劳德字面量不做子串")
  断言相等(甄别命中("ash", "xBashx", 方言科德), 真, "科德正则非锚定命中")
  断言相等(甄别命中("^Bash$", "Bash", 方言科德), 真, "科德锚定全等命中")
  断言相等(甄别命中("^Bash$", "xBash", 方言科德), 假, "科德锚定拒绝前缀")
  断言相等(甄别命中("[", "x", 方言科德), 假, "科德非法正则记未命中")
  断言相等(甄别命中("^Ba", "Bash", 方言克劳德), 真, "克劳德非字面量走正则")

# =====================================================================
# B. codec.ts —— 产出解析
# =====================================================================
段落 用例退出码阻断:
  设 产出 为 解析钩子产出(2, "", "  不准  ", 空)
  断言相等(产出["裁定"], "block", "退出码2 → block")
  断言相等(产出["缘由"], "不准", "stderr 去空白作缘由")
  设 产出2 为 解析钩子产出(2, "", "   ", 空)
  断言相等(产出2["裁定"], "block", "空 stderr 仍 block")
  断言相等(取可选(产出2, "缘由", 空), 空, "空 stderr 不设缘由")
  设 产出3 为 解析钩子产出(0, "随便输出", "", 空)
  断言相等(取可选(产出3, "裁定", 空), 空, "退出码0 无裁定")
  断言相等(产出3["标准输出"], "随便输出", "普通 stdout 原样保留")
  设 产出4 为 解析钩子产出(1, "", "boom", 空)
  断言相等(取可选(产出4, "裁定", 空), 空, "退出码1 非阻断")
  断言相等(产出4["标准错误"], "boom", "退出码1 保留 stderr")

段落 用例非结构化:
  设 产出 为 解析钩子产出(0, "  纯文本  ", "", 空)
  断言相等(取可选(产出, "裁定", 空), 空, "纯文本无裁定")
  断言相等(产出["标准输出"], "纯文本", "纯文本去空白保留")
  # 以花括号开头但 JSON 非法 → 宽容降级为纯文本，不抛错
  设 产出2 为 解析钩子产出(0, "{坏掉的", "", 空)
  断言相等(取可选(产出, "裁定", 空), 空, "非法 JSON 不产裁定")
  断言相等(产出2["标准输出"], "{坏掉的", "非法 JSON 保留原文")
  设 产出3 为 解析钩子产出(0, "[1,2]", "", 空)
  断言相等(取可选(产出3, "裁定", 空), 空, "数组 stdout 不解析")

段落 用例续行标志:
  设 甲 为 解析钩子产出(0, "{\"continue\": false}", "", 空)
  断言相等(甲["续行标志"], 假, "显式 false 记录")
  设 乙 为 解析钩子产出(0, "{\"continue\": true}", "", 空)
  断言相等(乙["续行标志"], 真, "显式 true 记录")
  设 丙 为 解析钩子产出(0, "{\"continue\": 1}", "", 空)
  断言相等(取可选(丙, "续行标志", 空), 空, "数字 1 不是布尔，忽略")
  设 丁 为 解析钩子产出(0, "{\"stopReason\": \"够了\"}", "", 空)
  断言相等(丁["停止缘由"], "够了", "停止缘由记录")

段落 用例顶层裁定:
  设 甲 为 解析钩子产出(0, "{\"decision\": \"approve\"}", "", 空)
  断言相等(甲["裁定"], "approve", "顶层 approve 生效")
  设 乙 为 解析钩子产出(0, "{\"decision\": \"block\", \"reason\": \"不行\"}", "", 空)
  断言相等(乙["裁定"], "block", "顶层 block 生效")
  断言相等(乙["缘由"], "不行", "顶层 reason 生效")
  # 关键：越界的 deny/allow/ask 在顶层一律无效，绝不能变成真阻断
  设 丙 为 解析钩子产出(0, "{\"decision\": \"deny\"}", "", 空)
  断言相等(取可选(丙, "裁定", 空), 空, "顶层 deny 越界被忽略")
  设 丁 为 解析钩子产出(0, "{\"decision\": \"allow\"}", "", 空)
  断言相等(取可选(丁, "裁定", 空), 空, "顶层 allow 无效")
  设 戊 为 解析钩子产出(0, "{\"decision\": \"ask\"}", "", 空)
  断言相等(取可选(戊, "裁定", 空), 空, "顶层 ask 无效")
  设 消息产出 为 解析钩子产出(0, "{\"systemMessage\": \"提示\"}", "", 空)
  断言相等(消息产出["系统消息"], "提示", "系统消息记录")

段落 用例专属时机匹配:
  设 产出 为 解析钩子产出(0, "{\"decision\": \"approve\", \"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\"}}", "", "PreToolUse")
  断言相等(产出["裁定"], "deny", "专属许可裁定覆盖顶层")
  断言相等(产出["钩子时机名"], "PreToolUse", "判别器照实记录")
  设 产出2 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"ask\", \"permissionDecisionReason\": \"要问\", \"additionalContext\": \"补充\"}}", "", "PreToolUse")
  断言相等(产出2["裁定"], "ask", "ask 生效")
  断言相等(产出2["缘由"], "要问", "许可缘由生效")
  断言相等(产出2["附加上下文"], "补充", "附加上下文生效")

段落 用例专属时机不符:
  # 判别器命名别的时机 → 时机作用域内字段全丢弃，但判别器本身仍记录
  设 产出 为 解析钩子产出(0, "{\"decision\": \"approve\", \"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\", \"additionalContext\": \"补充\"}}", "", "PostToolUse")
  断言相等(产出["裁定"], "approve", "错名专属块不覆盖裁定")
  断言相等(产出["钩子时机名"], "PreToolUse", "判别器仍记录")
  断言相等(取可选(产出, "附加上下文", 空), 空, "错名专属块的上下文被丢弃")

段落 用例专属缺名:
  # 缺判别器 == 不匹配，同样丢弃
  设 产出 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"permissionDecision\": \"deny\"}}", "", "PreToolUse")
  断言相等(取可选(产出, "裁定", 空), 空, "缺名专属块不产裁定")
  断言相等(取可选(产出, "钩子时机名", 空), 空, "缺名则无判别器记录")

段落 用例专属无守卫:
  # 不给预期时机 → 守卫关闭，专属块照单应用
  设 产出 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"permissionDecision\": \"deny\"}}", "", 空)
  断言相等(产出["裁定"], "deny", "无守卫时专属块生效")

段落 用例更新入参:
  设 产出 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"updatedInput\": {\"a\": 1}}}", "", "PreToolUse")
  设 更新 为 产出["更新入参"]
  断言相等(更新["a"], 1, "更新入参对象生效")
  设 产出2 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"hookEventName\": \"PreToolUse\", \"updatedInput\": 5}}", "", "PreToolUse")
  断言相等(取可选(产出2, "更新入参", 空), 空, "非对象更新入参被忽略")

段落 用例读辅助:
  设 表 为 ["字": "甲", "数": 3, "真": 真, "假": 假, "表": ["x"]]
  断言相等(读字符串(表, "字"), "甲", "读字符串取到")
  断言相等(读字符串(表, "数"), 空, "读字符串拒数字")
  断言相等(读字符串(表, "缺"), 空, "读字符串缺键")
  断言相等(读布尔(表, "真"), 真, "读布尔取真")
  断言相等(读布尔(表, "假"), 假, "读布尔取假")
  断言相等(读布尔(表, "数"), 空, "读布尔拒数字")
  断言相等(读对象(表["表"]), 空, "读对象拒列表")
  设 内 为 读对象(取可选(表, "字", 空))
  断言相等(内, 空, "读对象拒字符串")
  断言相等(顶层裁定("approve"), "approve", "顶层裁定认 approve")
  断言相等(顶层裁定("block"), "block", "顶层裁定认 block")
  断言相等(顶层裁定("deny"), 空, "顶层裁定拒 deny")
  断言相等(许可裁定值("allow"), "allow", "许可裁认定 allow")
  断言相等(许可裁定值("ask"), "ask", "许可裁认定 ask")
  断言相等(许可裁定值("block"), 空, "许可裁定拒 block")
  断言相等(判数值(3), 真, "判数值认整数")
  断言相等(判数值(1.5), 真, "判数值认浮点")
  断言相等(判数值(真), 假, "判数值拒布尔")
  断言相等(判数值("3"), 假, "判数值拒字符串")

# =====================================================================
# C. merge.ts —— 多钩子合并
# =====================================================================
段落 用例裁定等级:
  断言相等(裁定等级("deny"), 3, "deny 三级")
  断言相等(裁定等级("block"), 3, "block 同级 deny")
  断言相等(裁定等级("ask"), 2, "ask 二级")
  断言相等(裁定等级("allow"), 1, "allow 一级")
  断言相等(裁定等级("approve"), 1, "approve 同级 allow")
  断言相等(裁定等级(空), 0, "无裁定零级")
  断言相等(等级裁定(3), "deny", "三级回落 deny")
  断言相等(等级裁定(2), "ask", "二级回落 ask")
  断言相等(等级裁定(1), "allow", "一级回落 allow")
  断言相等(等级裁定(0), "none", "零级回落 none")

段落 用例合并优先级:
  断言相等(合并钩子产出([])["裁定"], "none", "空表回落 none")
  断言相等(合并钩子产出([])["停止"], 假, "空表不停止")
  设 甲 为 解析钩子产出(0, "{\"decision\": \"approve\"}", "", 空)
  设 乙 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"permissionDecision\": \"ask\"}}", "", 空)
  设 丙 为 解析钩子产出(0, "{\"hookSpecificOutput\": {\"permissionDecision\": \"deny\"}}", "", 空)
  断言相等(合并钩子产出([甲])["裁定"], "allow", "approve 合并为 allow")
  断言相等(合并钩子产出([甲, 乙])["裁定"], "ask", "ask 压过 allow")
  断言相等(合并钩子产出([甲, 乙, 丙])["裁定"], "deny", "deny 压过 ask")
  断言相等(合并钩子产出([丙, 乙, 甲])["裁定"], "deny", "顺序无关仍取最严")
  设 丁 为 解析钩子产出(2, "", "硬拦", 空)
  断言相等(合并钩子产出([甲, 丁])["裁定"], "deny", "block 与 deny 同级归 deny")

段落 用例合并缘由:
  设 断1 为 ["裁定": "deny", "缘由": "第一个"]
  设 断2 为 ["裁定": "deny", "缘由": "第二个"]
  设 问 为 ["裁定": "ask", "缘由": "问的缘由"]
  设 合并 为 合并钩子产出([断1, 断2, 问])
  断言相等(合并["裁定"], "deny", "deny 胜出")
  设 期望 为 "第一个" + "\n\n" + "第二个"
  断言相等(合并["缘由"], 期望, "同级缘由双换行连接")
  设 合并2 为 合并钩子产出([问])
  断言相等(合并2["缘由"], "问的缘由", "仅 ask 时取其缘由")
  设 合并3 为 合并钩子产出([["裁定": "deny"]])
  断言相等(取可选(合并3, "缘由", 空), 空, "无缘由则不设")
  断言相等(连接缘由(["甲", "乙"]), "甲" + "\n\n" + "乙", "连接缘由双换行")
  断言相等(连接缘由([]), "", "空缘由表连成空串")

段落 用例合并停止:
  设 停1 为 ["续行标志": 假, "停止缘由": "先停"]
  设 停2 为 ["续行标志": 假, "停止缘由": "后停"]
  设 合并 为 合并钩子产出([停1, 停2])
  断言相等(合并["停止"], 真, "续行假 → 停止")
  断言相等(合并["停止缘由"], "先停", "停止缘由取首个")
  设 合并2 为 合并钩子产出([["续行标志": 真], ["续行标志": 假]])
  断言相等(合并2["停止"], 真, "首个为假即粘住")
  断言相等(合并钩子产出([["续行标志": 真]])["停止"], 假, "全真不停止")
  断言相等(合并钩子产出([{}])["停止"], 假, "缺续行标志不停止")

段落 用例合并上下文:
  设 甲 为 ["附加上下文": "甲文", "系统消息": "甲息"]
  设 乙 为 ["附加上下文": "乙文", "系统消息": "乙息"]
  设 合并 为 合并钩子产出([甲, 乙])
  断言相等(合并["附加上下文表"], ["甲文", "乙文"], "附加上下文按序累积")
  断言相等(合并["系统消息表"], ["甲息", "乙息"], "系统消息按序累积")
  设 合并2 为 合并钩子产出([["附加上下文": ""], ["系统消息": ""]])
  断言相等(列表长度(合并2["附加上下文表"]), 0, "空上下文不累积")
  断言相等(列表长度(合并2["系统消息表"]), 0, "空消息不累积")

# =====================================================================
# D. hooks-claude-code config.ts —— 指令替换
# =====================================================================
段落 用例指令替换:
  设 标记 为 插件根标记()
  断言相等(标记, "$" + "{" + "CLAUDE_PLUGIN_ROOT" + "}", "插件根标记构造正确")
  设 标记2 为 项目目录标记()
  断言相等(标记2, "$" + "{" + "CLAUDE_PROJECT_DIR" + "}", "项目目录标记构造正确")
  设 甲 为 替换指令("run " + 标记 + "/x.sh", "/plug", 空)
  断言相等(甲, "run /plug/x.sh", "插件根被替换")
  设 乙 为 替换指令("run " + 标记2 + "/y.sh", 空, "/proj")
  断言相等(乙, "run /proj/y.sh", "项目目录被替换")
  设 丙 为 替换指令("run " + 标记 + " " + 标记, "/p", 空)
  断言相等(丙, "run /p /p", "多处出现全部替换")
  设 丁 为 替换指令("run " + 标记 + "/x.sh", 空, 空)
  断言相等(丁, "run " + 标记 + "/x.sh", "变量未提供则原样保留")
  设 戊 为 替换指令("a " + 标记 + " b " + 标记2, "/p", "/q")
  断言相等(戊, "a /p b /q", "两个标记同时替换")

# =====================================================================
# E. hooks-codex config.ts —— 科德配置解析
# =====================================================================
段落 用例科德配置:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"matcher\": \"Bash\", \"hooks\": [{\"command\": \"ls\"}, {\"command\": \"pwd\"}]}]}")
  设 结果 为 解析科德配置(原始)
  设 配置 为 结果["配置"]
  设 组表 为 配置["PreToolUse"]
  断言相等(列表长度(组表), 1, "一组")
  设 组 为 列表获取(组表, 0)
  断言相等(组["甄别式"], "Bash", "甄别式保留")
  断言相等(列表长度(组["指令表"]), 2, "两条指令")
  设 首条 为 列表获取(组["指令表"], 0)
  断言相等(首条["指令"], "ls", "首条指令")
  断言相等(取可选(首条, "时长毫秒", 空), 空, "无时长则不设字段")
  断言相等(列表长度(结果["跳过表"]), 0, "无跳过项")

段落 用例科德包装:
  # { hooks: {...} } 包装与裸映射等价
  设 包装 为 解析JSON("{\"hooks\": {\"Stop\": [{\"hooks\": [{\"command\": \"s\"}]}]}}")
  设 裸 为 解析JSON("{\"Stop\": [{\"hooks\": [{\"command\": \"s\"}]}]}")
  设 甲 为 解析科德配置(包装)["配置"]
  设 乙 为 解析科德配置(裸)["配置"]
  断言相等(列表长度(甲["Stop"]), 1, "包装形式可解析")
  断言相等(列表长度(乙["Stop"]), 1, "裸映射可解析")
  设 空配置 为 解析科德配置(空)["配置"]
  断言相等(列表长度(字典键列表(空配置)), 0, "非对象 → 空配置")
  设 列配置 为 解析科德配置([1, 2])["配置"]
  断言相等(列表长度(字典键列表(列配置)), 0, "数组 → 空配置")

段落 用例科德丢弃甄别式:
  设 原始 为 解析JSON("{\"UserPromptSubmit\": [{\"matcher\": \"Bash\", \"hooks\": [{\"command\": \"p\"}]}], \"Stop\": [{\"matcher\": \"Bash\", \"hooks\": [{\"command\": \"s\"}]}]}")
  设 配置 为 解析科德配置(原始)["配置"]
  设 提交组 为 列表获取(配置["UserPromptSubmit"], 0)
  断言相等(取可选(提交组, "甄别式", 空), 空, "UserPromptSubmit 丢弃 matcher")
  设 停止组 为 列表获取(配置["Stop"], 0)
  断言相等(取可选(停止组, "甄别式", 空), 空, "Stop 丢弃 matcher")
  断言相等(丢弃甄别式("Stop"), 真, "Stop 在丢弃表内")
  断言相等(丢弃甄别式("PreToolUse"), 假, "PreToolUse 不在丢弃表内")

段落 用例科德跳过:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"hooks\": [{\"type\": \"prompt\", \"command\": \"x\"}, {\"command\": \"ls\", \"async\": true}, {\"command\": 5}, {\"command\": \"ok\"}]}]}")
  设 结果 为 解析科德配置(原始)
  设 跳过表 为 结果["跳过表"]
  断言相等(列表长度(跳过表), 2, "两跳过项")
  断言相等(列表获取(跳过表, 0)["缘由"], "unsupported \"prompt\" hook", "非 command 记不支持")
  断言相等(列表获取(跳过表, 1)["缘由"], "async hook", "async 记异步跳过")
  设 组表 为 结果["配置"]["PreToolUse"]
  设 指令表 为 列表获取(组表, 0)["指令表"]
  断言相等(列表长度(指令表), 1, "只剩一条可用指令")
  断言相等(列表获取(指令表, 0)["指令"], "ok", "command 非字符串被静默丢弃")

段落 用例科德时长:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"hooks\": [{\"command\": \"a\", \"timeout\": 30}, {\"command\": \"b\", \"timeoutSec\": 45}, {\"command\": \"c\"}]}]}")
  设 指令表 为 列表获取(解析科德配置(原始)["配置"]["PreToolUse"], 0)["指令表"]
  断言相等(列表获取(指令表, 0)["时长毫秒"], 30, "timeout 别名生效")
  断言相等(列表获取(指令表, 1)["时长毫秒"], 45, "timeoutSec 别名生效")
  断言相等(取可选(列表获取(指令表, 2), "时长毫秒", 空), 空, "无时长不设字段")

段落 段_科德非法正则:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"matcher\": \"[\", \"hooks\": [{\"command\": \"ls\"}]}]}")
  设 占位 为 解析科德配置(原始)

段落 段_科德非法正则无指令:
  # 整组无可用指令时不校验 matcher，故合法正则组被剔除后不应抛错
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"matcher\": \"[\", \"hooks\": []}]}")
  设 结果 为 解析科德配置(原始)
  断言相等(列表长度(字典键列表(结果["配置"])), 0, "空指令组被剔除")

段落 用例科德未知时机:
  设 原始 为 解析JSON("{\"NotAnEvent\": [{\"hooks\": [{\"command\": \"x\"}]}], \"PreToolUse\": [{\"hooks\": [{\"command\": \"y\"}]}]}")
  设 配置 为 解析科德配置(原始)["配置"]
  断言相等(取可选(配置, "NotAnEvent", 空), 空, "未知时机被忽略")
  断言相等(列表长度(配置["PreToolUse"]), 1, "已知时机保留")
  断言相等(列表长度(科德时机表), 5, "科德五时机")

# =====================================================================
# F. hooks-claude-code config.ts —— 克劳德配置解析
# =====================================================================
段落 用例克劳德配置:
  设 标记 为 插件根标记()
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"matcher\": \"Edit|Write\", \"hooks\": [{\"command\": \"run " + 标记 + "/x.sh\"}]}]}")
  设 结果 为 解析克劳德配置(原始, "/plug", 空)
  设 组 为 列表获取(结果["配置"]["PreToolUse"], 0)
  断言相等(组["甄别式"], "Edit|Write", "克劳德字面量甄别式保留")
  设 条 为 列表获取(组["指令表"], 0)
  断言相等(条["指令"], "run /plug/x.sh", "解析期即完成变量替换")
  断言相等(列表长度(克劳德时机表), 7, "克劳德七时机")

段落 用例克劳德子代理时机:
  设 原始 为 解析JSON("{\"SubagentStart\": [{\"hooks\": [{\"command\": \"a\"}]}], \"SubagentStop\": [{\"hooks\": [{\"command\": \"b\"}]}]}")
  设 配置 为 解析克劳德配置(原始, 空, 空)["配置"]
  断言相等(列表长度(配置["SubagentStart"]), 1, "SubagentStart 受支持")
  断言相等(列表长度(配置["SubagentStop"]), 1, "SubagentStop 受支持")

段落 用例克劳德跳过:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"hooks\": [{\"type\": \"prompt\", \"command\": \"x\"}, {\"command\": \"ls\", \"async\": true}]}]}")
  设 结果 为 解析克劳德配置(原始, 空, 空)
  设 跳过表 为 结果["跳过表"]
  断言相等(列表长度(跳过表), 1, "只跳过非 command")
  断言相等(列表获取(跳过表, 0)["型"], "prompt", "跳过项记型而非缘由")
  设 指令表 为 列表获取(结果["配置"]["PreToolUse"], 0)["指令表"]
  断言相等(列表长度(指令表), 1, "async 钩子在克劳德侧仍保留")
  断言相等(列表获取(指令表, 0)["指令"], "ls", "保留的是 async 那条")

段落 用例克劳德时长:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"hooks\": [{\"command\": \"a\", \"timeout\": 12}]}]}")
  设 条 为 列表获取(列表获取(解析克劳德配置(原始, 空, 空)["配置"]["PreToolUse"], 0)["指令表"], 0)
  断言相等(条["时长毫秒"], 12, "克劳德只认 timeout")

段落 段_克劳德非法正则:
  设 原始 为 解析JSON("{\"PreToolUse\": [{\"matcher\": \"(\", \"hooks\": [{\"command\": \"ls\"}]}]}")
  设 占位 为 解析克劳德配置(原始, 空, 空)

段落 用例析时机表:
  设 包装 为 解析JSON("{\"hooks\": {\"Stop\": []}}")
  设 裸 为 解析JSON("{\"Stop\": []}")
  设 甲 为 析时机表(包装)
  设 乙 为 析时机表(裸)
  断言相等(字典包含键(甲, "Stop"), 真, "包装取内层")
  断言相等(字典包含键(乙, "Stop"), 真, "裸映射取自身")
  断言相等(析时机表(空), 空, "非对象返回空")

# =====================================================================
# G. hooks-codex index.ts L152-156 —— 普通 stdout 作附加上下文
# =====================================================================
段落 用例普通上下文:
  设 甲 为 普通输出作上下文(["退出码": 0, "标准输出": "一段说明"], 真)
  断言相等(甲["附加上下文"], "一段说明", "干净普通输出作上下文")
  设 乙 为 普通输出作上下文(["退出码": 0, "标准输出": "说明"], 假)
  断言相等(取可选(乙, "附加上下文", 空), 空, "允许标志假则不设")
  设 丙 为 普通输出作上下文(["退出码": 1, "标准输出": "说明"], 真)
  断言相等(取可选(丙, "附加上下文", 空), 空, "非零退出不设")
  设 丁 为 普通输出作上下文(["退出码": 0, "标准输出": "{\"a\": 1}"], 真)
  断言相等(取可选(丁, "附加上下文", 空), 空, "JSON 开头不外泄为散文")
  设 戊 为 普通输出作上下文(["退出码": 0, "标准输出": "", "附加上下文": "已有"], 真)
  断言相等(戊["附加上下文"], "已有", "已有上下文不覆盖")

# =====================================================================
# H. hooks-codex index.ts L198-253 —— 扩展点纯决策映射
# =====================================================================
段落 用例扩展点:
  断言相等(决断前置步("deny", 假), "reject", "前置步 deny → reject")
  断言相等(决断前置步("deny", 真), "reject", "前置步 deny 优先于上下文")
  断言相等(决断前置步("none", 真), "enter", "仅上下文 → enter")
  断言相等(决断前置步("none", 假), "pass", "无裁定无上下文 → pass")
  断言相等(决断前置步("allow", 真), "enter", "allow 不否决仍可注入")
  断言相等(决断器前置("deny"), "deny", "工具前置 deny → deny")
  断言相等(决断器前置("ask"), "pass", "科德不认 ask")
  断言相等(决断器前置("allow"), "pass", "allow 放行")
  断言相等(决断器后置("deny"), "block", "工具后置 deny → block")
  断言相等(决断器后置("none"), "pass", "工具后置无裁定放行")
  断言相等(决断停止("deny"), "steer", "停止 deny → steer 强制续跑")
  断言相等(决断停止("allow"), "pass", "停止 allow 放行")

段落 用例兜底缘由:
  断言相等(择决断缘由("有理由", 前置兜底), "有理由", "有缘由则用原值")
  断言相等(择决断缘由("", 前置兜底), "blocked by PreToolUse hook", "空串回落兜底")
  断言相等(择决断缘由(空, 后置兜底), "blocked by PostToolUse hook", "缺值回落兜底")
  断言相等(择决断缘由(空, 停止兜底), "continue: blocked by Stop hook", "停止兜底文案")

段落 用例常量:
  断言相等(阻断退出码, 2, "阻断退出码为 2")
  断言相等(方言科德, "codex", "科德方言名")
  断言相等(方言克劳德, "claude-code", "克劳德方言名")
  断言相等(字面式, "^[A-Za-z0-9_|]+$", "字面式判别式")
  断言相等(左花括号, "{", "左花括号常量")
  断言相等(列表长度(无甄别时机表), 2, "两个无甄别时机")

