# test_闭包嵌套.light —— L-078 闭包/嵌套函数支持验证
# 覆盖：嵌套段落定义 / 闭包读取外层变量 / 外层(nonlocal)修改外层变量 /
#       闭包作回调传递 / 高阶函数 / 多层嵌套 / 多参数 / 匿名闭包与嵌套协作

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # 1. 嵌套段落 + 闭包读取外层变量
  段落 加法器 接收 x:
    段落 加 接收 y:
      返回 x + y
    返回 加
  设 add5 为 加法器(5)
  断言等于(add5(3), 8, "闭包读取外层变量")
  断言等于(add5(10), 15, "闭包持久状态")

  # 2. 外层(nonlocal)修改外层变量 —— 计数器
  段落 造计数器:
    设 计数 为 0
    段落 递增:
      外层 计数
      设 计数 为 计数 + 1
      返回 计数
    段落 取值:
      返回 计数
    返回 ["递增": 递增, "取值": 取值]
  设 c 为 造计数器()
  断言等于(c["递增"](), 1, "计数器第一次")
  断言等于(c["递增"](), 2, "计数器第二次")
  断言等于(c["取值"](), 2, "计数器取值")

  # 3. 闭包作回调传递（高阶函数）
  段落 映射表 接收 列表, 回调:
    设 结果 为 []
    遍历 项 之 列表:
      列表追加(结果, 回调(项))
    返回 结果
  设 加倍 为 段落 接收 x:
    返回 x * 2
  断言等于(映射表([1, 2, 3], 加倍), [2, 4, 6], "闭包作回调")
  设 加一 为 段落 接收 x:
    返回 x + 1
  断言等于(映射表([1, 2, 3], 加一), [2, 3, 4], "匿名闭包作回调")

  # 4. 多层嵌套闭包
  段落 外层A 接收 a:
    段落 中层B 接收 b:
      段落 内层C 接收 c:
        返回 a + b + c
      返回 内层C
    返回 中层B
  断言等于(外层A(1)(2)(3), 6, "多层嵌套闭包")

  # 5. 闭包捕获多个外层变量
  段落 造拼接器 接收 前缀, 后缀:
    段落 拼接 接收 中间:
      返回 前缀 + 中间 + 后缀
    返回 拼接
  设 括起来 为 造拼接器("[", "]")
  断言等于(括起来("hello"), "[hello]", "闭包捕获多变量")

  # 6. 嵌套段落内定义多个嵌套函数
  段落 计算器 接收 初始:
    设 值 为 初始
    段落 加 接收 x:
      外层 值
      设 值 为 值 + x
      返回 值
    段落 乘 接收 x:
      外层 值
      设 值 为 值 * x
      返回 值
    段落 当前:
      返回 值
    返回 ["加": 加, "乘": 乘, "当前": 当前]
  设 calc 为 计算器(10)
  断言等于(calc["加"](5), 15, "计算器加")
  断言等于(calc["乘"](2), 30, "计算器乘")
  断言等于(calc["当前"](), 30, "计算器当前")

  打印 "--- 闭包/嵌套函数全部通过 ---"

主()
