# test_CLI命令面.light —— 第 7 轮任务1：总入口 多命令调度 + dump-config
# 运行：python 运行.py examples/test_CLI命令面.light
#
# 对齐上游 apps/cli/src/args.ts（L1-25 launcher 哲学 + DshInvocation 三态）与
# dump-config.ts（runDumpConfig：按 layer 打印组合配置，注释命名每个来源文件）。
# 光明映射：环境变量 HARNESS_CMD 选子命令（缺省 run），dump-config 逐项标注「来源」。
#
# 覆盖：
#   ① 版本号常量
#   ② dump-config 输出含 模型/单价/阈值token 且标注「来源」
#   ③ help 用法表含全部命令名 + 参数表
#   ④ 未知命令：调度命令 返回 假 且 入口 主 抛出「未知命令」（→ 进程非零退出码）
#   ⑤ run 缺省路径：缺省子命令为 run，且无密钥时该分支正常返回 真（不破坏既有 headless 行为）
#
# 反跑判据：见 _antirun_cli_cmds.py（A 来源标注改坏 → 本用例红；B 未知命令退出码改 0 → 红）。

导入 总入口
从 总入口 导入 取配置文本, 取用法文本, 调度命令, 取模型来源, 读取环境文件值, 版本号, 缺省子命令

段落 断言包含(文本, 片段, 标签):
  如果 字符串包含(文本, 片段) == 假:
    抛出 "断言失败: " + 标签 + "（缺少片段 " + 片段 + "）"

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 检查抛错(标签, 运算):
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 异常 错误:
    设 抛了 为 真
    设 消息 为 转字符串(错误)
  如果 抛了 == 假:
    抛出 "应抛未抛: " + 标签
  返回 消息

段落 抛未知命令:
  总入口.主("bogus")

# 是否有可用密钥（有则跳过 run 分支真实执行，避免测试触发网络请求）
段落 有可用密钥:
  如果 环境变量("HARNESS_API_KEY", 空) != 空:
    返回 真
  如果 环境变量("DEEPSEEK_API_KEY", 空) != 空:
    返回 真
  如果 环境变量("OPENAI_API_KEY", 空) != 空:
    返回 真
  设 密钥名表 为 ["DEEPSEEK_API_KEY", "HARNESS_API_KEY", "OPENAI_API_KEY"]
  遍历 密钥名 之 密钥名表:
    设 文件值 为 读取环境文件值(密钥名)
    如果 文件值 != 空 且 文件值 != "":
      返回 真
  返回 假

段落 主:
  # ① 版本号
  断言等于(版本号, "0.1.5-lh", "版本号应为 0.1.5-lh")

  # ② dump-config 配置文本：模型 / 单价 / 阈值token / 来源标注
  设 配置 为 取配置文本()
  断言包含(配置, "来源", "dump-config 必须逐项标注来源")
  断言包含(配置, "模型:", "dump-config 应打印模型行")
  断言包含(配置, "模型单价表", "dump-config 应打印模型单价表")
  断言包含(配置, "0.27", "dump-config 单价表应含 deepseek 单价 0.27")
  断言包含(配置, "未知模型", "dump-config 单价表应含未知模型回落价")
  断言包含(配置, "阈值token", "dump-config 应打印压缩阈值")
  断言包含(配置, "保留轮数", "dump-config 应打印保留轮数")
  断言包含(配置, "上下文窗口", "dump-config 应打印上下文窗口")
  断言包含(配置, "压缩配置", "dump-config 应有压缩配置段")
  断言包含(配置, "未映射宿主面", "dump-config 应声明未映射宿主面")
  断言包含(配置, "未列字段", "dump-config 应声明不打印端点与密钥")

  # ③ help 用法表：全部命令名 + 参数表
  设 用法 为 取用法文本()
  断言包含(用法, "run", "用法表应含 run")
  断言包含(用法, "dump-config", "用法表应含 dump-config")
  断言包含(用法, "version", "用法表应含 version")
  断言包含(用法, "help", "用法表应含 help")
  断言包含(用法, "HARNESS_CMD", "用法表应含 HARNESS_CMD")
  断言包含(用法, "HARNESS_MSG", "用法表应含 HARNESS_MSG")
  断言包含(用法, "HARNESS_PROMPT_FILE", "用法表应含 HARNESS_PROMPT_FILE")
  断言包含(用法, "HARNESS_ENDPOINT", "用法表应含 HARNESS_ENDPOINT")
  断言包含(用法, "HARNESS_MODEL", "用法表应含 HARNESS_MODEL")
  断言包含(用法, "HARNESS_ROOT", "用法表应含 HARNESS_ROOT")
  断言包含(用法, "HARNESS_RESUME", "用法表应含 HARNESS_RESUME")
  断言包含(用法, "HARNESS_REPL", "用法表应含 HARNESS_REPL")
  断言包含(用法, "HARNESS_LIST", "用法表应含 HARNESS_LIST")

  # ④ 未知命令：分派返回 假，入口抛出「未知命令」（→ 进程非零退出码）
  断言等于(调度命令("bogus"), 假, "未知命令应返回 假")
  设 错误文案 为 检查抛错("未知命令应使入口抛出", 抛未知命令)
  断言包含(错误文案, "未知命令", "入口抛错文案应含未知命令")

  # ⑤ run 缺省路径不受影响
  断言等于(缺省子命令, "run", "缺省子命令应为 run")
  如果 有可用密钥() == 假:
    断言等于(调度命令(缺省子命令), 真, "缺省子命令应命中 run 分支并返回 真")
  否则:
    打印 "[跳过] run 缺省分支真实执行（当前环境存在 API 密钥，避免触发网络请求）"

  # 来源标注单元校验（环境变量 → .env HARNESS_MODEL → .env OPENAI_MODEL → 内置默认）
  断言等于(取模型来源("m", "", ""), "环境变量 HARNESS_MODEL", "模型来源应优先环境变量")
  断言等于(取模型来源("", "", ""), "内置默认 取默认模型()", "模型来源应回落到内置默认")

  打印 "test_CLI命令面 PASS"

主()
