# test_类型系统.light —— 第14轮 任务5（类型系统域）判据
# 上游：packages/typert/{protocol/src/{index.ts,types.ts,remote-error.ts},
#        generator/src/{model.ts,renderer.ts,emitter.ts,analyzer.ts}}
# 运行：cd lightharness && LIGHT_MERGE=... python 运行.py examples/test_类型系统.light
# 反跑：_antirun_typert.py（A 相等改引用相等 / B union 渲染不加 ` | ` / C 不检测重复符号）
#
# ⚠️ L-089 绕法：含「{标识符}」的字符串字面量会触发插值 —— 本文件用 花左/花右 单花括号字面量拼接
#    构造所有含花括号的源码文本与期望串（单 `"{"` / `"}"` 字面量安全，已探针确认）。

从 JSON 导入 序列化JSON, 解析JSON
从 类型系统 导入 是合法远程段, 是段字符, 是合法方法, 方法枚举
从 类型系统 导入 造消息ID, 造请求, 造响应, 造错误响应, 造通知, 序列化消息, 解析消息
从 类型系统 导入 造远程错误, 是远程错误
从 类型系统 导入 造节点, 造原语, 造字面量, 造联合, 造交叉, 造数组, 造元组, 造对象, 造函数, 造引用
从 类型系统 导入 造属性成员, 造方法成员, 造作用域, 作用域注册, 作用域查找
从 类型系统 导入 节点相等, 可赋值, 取字段, 有字段
从 类型系统 导入 分词, 记号下标, 取记号, 声明种类, 取声明名, 取形参表, 取关键字后名, 跳过尖括号
从 类型系统 导入 分析声明, 造符号表, 注册符号, 有符号, 查找符号, 取文档描叙, 定位子串
从 类型系统 导入 渲染节点, 渲染成员, 渲染符号, 渲染文档, 需括号
从 类型系统 导入 声明文件头, 名比较, 排序名, 只导出公开, 发射声明文件, 连接文本

# 花括号字面量（L-089 绕法）
设 花左 为 "{"
设 花右 为 "}"

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 含子串 接收 文本, 子串:
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 主:
  打印 "===== 第 14 轮任务 5：类型系统域（纯逻辑面）====="

  # ---- §1 协议 ----
  断言相等(是合法远程段("svc.method"), 真, "1a 段语法 常规")
  断言相等(是合法远程段("a-b_c$1"), 真, "1b 段语法 含 -_$")
  断言相等(是合法远程段("."), 假, "1c 段语法 拒绝点")
  断言相等(是合法远程段(".."), 假, "1d 段语法 拒绝双点")
  断言相等(是合法远程段(""), 假, "1e 段语法 拒绝空")
  断言相等(是合法远程段("a/b"), 假, "1f 段语法 拒绝斜杠")
  断言相等(是合法远程段("中文段"), 假, "1g 段语法 拒绝非 ASCII")
  断言相等(是合法远程段(7), 假, "1h 段语法 拒绝非串")
  断言相等(是段字符("A"), 真, "1i 段字符 大写字母")
  断言相等(是段字符("/"), 假, "1j 段字符 斜杠")

  断言相等(方法枚举, ["analyze", "render", "emit", "listSymbols"], "1k 方法枚举")
  断言相等(是合法方法("analyze"), 真, "1l 合法方法 analyze")
  断言相等(是合法方法("listSymbols"), 真, "1m 合法方法 listSymbols")
  断言相等(是合法方法("compile"), 假, "1n 非法方法 compile")

  断言相等(造消息ID(7), "req_7", "1o 消息 id 前缀")
  设 请求 为 造请求("req_1", "analyze", {"file": "a.ts"})
  断言相等(请求["id"], "req_1", "1p 请求 id")
  断言相等(请求["kind"], "request", "1q 请求 kind")
  断言相等(请求["method"], "analyze", "1r 请求 method")
  断言相等(请求["params"]["file"], "a.ts", "1s 请求 params")
  设 响应 为 造响应("req_1", {"ok": 真})
  断言相等(响应["kind"], "response", "1t 响应 kind")
  断言相等(响应["result"]["ok"], 真, "1u 响应 result")
  设 错误响应 为 造错误响应("req_2", "gateway/bad-request", "bad")
  断言相等(错误响应["kind"], "error", "1v 错误响应 kind")
  断言相等(错误响应["error"]["code"], "gateway/bad-request", "1w 错误响应 code")
  设 通知 为 造通知("render", {"x": 1})
  断言相等(通知["kind"], "notification", "1x 通知 kind")
  断言相等(字典包含键(通知, "id"), 假, "1y 通知无 id")

  尝试:
    设 占位未知法 为 造请求("req_3", "compile", {})
    断言真(假, "1z 非法方法应抛错")
  捕获 异常 错误一:
    断言真(含子串(转字符串(错误一), "unknown typert method"), "1z 非法方法构造请求抛错")

  设 往返 为 解析消息(序列化消息(请求))
  断言相等(往返["method"], "analyze", "1z2 消息序列化/解析往返")

  设 远端错 为 造远程错误("gateway/internal", "boom", {"a": 1})
  断言相等(远端错["isDSHRemoteError"], 真, "1z3 远端错误结构标记")
  断言相等(远端错["name"], "RemoteError", "1z4 远端错误 name")
  断言相等(远端错["code"], "gateway/internal", "1z5 远端错误 code")
  断言相等(是远程错误(远端错), 真, "1z6 结构化识别 真")
  断言相等(是远程错误({"code": "x"}), 假, "1z7 缺标记 判假")
  断言相等(是远程错误({"isDSHRemoteError": 真, "code": 7}), 假, "1z8 code 非串 判假")
  断言相等(是远程错误("str"), 假, "1z9 非字典 判假")

  # ---- §2 类型 IR ----
  设 串 为 造原语("string")
  设 数 为 造原语("number")
  断言相等(串["种类"], "primitive", "2a 原语种类")
  断言相等(串["名称"], "string", "2b 原语名称")
  设 联合 为 造联合([串, 数])
  断言相等(联合["种类"], "union", "2c 联合种类")
  断言相等(长(联合["成员"]), 2, "2d 联合成员数")
  断言相等(造交叉([串, 数])["种类"], "intersection", "2e 交叉种类")
  断言相等(造数组(串)["元素"]["名称"], "string", "2f 数组元素")
  断言相等(造元组([串, 数])["种类"], "tuple", "2g 元组种类")
  设 属性 为 造属性成员("a", 串, 假, 假)
  断言相等(属性["种类"], "property", "2h 属性成员种类")
  断言相等(属性["名称"], "a", "2i 属性成员名")
  断言相等(造对象([属性])["种类"], "object", "2j 对象种类")
  断言相等(造函数([], 数)["返回"]["名称"], "number", "2k 函数返回")
  断言相等(造引用("Foo", [串])["名称"], "Foo", "2l 引用名")
  断言相等(造节点("primitive", {"名称": "boolean"})["名称"], "boolean", "2m 通用造节点合并字段")

  设 域外 为 造作用域(空, {}, {})
  设 域内 为 造作用域(域外, {}, {})
  作用域注册(域外, "outer", 1)
  作用域注册(域内, "inner", 2)
  断言相等(作用域查找(域内, "inner"), 2, "2n 本层查找")
  断言相等(作用域查找(域内, "outer"), 1, "2o 父链查找")
  断言相等(作用域查找(域内, "missing"), 空, "2p 查找缺失返回空")

  # ---- §3 结构相等与可赋值 ----
  断言相等(节点相等(造原语("string"), 造原语("string")), 真, "3a 同原语相等")
  断言相等(节点相等(造原语("string"), 造原语("number")), 假, "3b 异原语不等")
  断言相等(节点相等(造联合([串, 数]), 造联合([造原语("string"), 造原语("number")])), 真, "3c 联合结构相等")
  断言相等(节点相等(造联合([串, 数]), 造联合([数, 串])), 假, "3d 联合顺序敏感")
  断言相等(节点相等(造字面量("42", "number"), 造字面量("42", "number")), 真, "3e 字面量相等")
  断言相等(节点相等(造字面量("42", "number"), 造字面量("43", "number")), 假, "3f 字面量文本不等")
  断言相等(节点相等(造数组(串), 造数组(造原语("string"))), 真, "3g 数组结构相等")
  断言相等(节点相等(造对象([造属性成员("a", 串, 假, 假)]), 造对象([造属性成员("a", 造原语("string"), 假, 假)])), 真, "3h 对象结构相等")
  断言相等(节点相等(造对象([造属性成员("a", 串, 假, 假)]), 造对象([造属性成员("a", 串, 真, 假)])), 假, "3i 对象可选性差异不等")
  断言相等(节点相等(造引用("Foo", [串]), 造引用("Foo", [造原语("string")])), 真, "3j 引用相等")
  断言相等(节点相等(造引用("Foo", [串]), 造引用("Bar", [串])), 假, "3k 引用名不同不等")
  断言相等(节点相等(造函数([], 串), 造函数([], 造原语("string"))), 真, "3l 函数相等")
  断言相等(节点相等(造节点("mystery", {}), 造节点("mystery", {})), 真, "3m 未知种类按 JSON 形状比较")

  断言相等(可赋值(串, 造原语("string")), 真, "3n 相同可赋值")
  断言相等(可赋值(串, 造原语("any")), 真, "3o 任意→any")
  断言相等(可赋值(串, 造原语("unknown")), 真, "3p 任意→unknown")
  断言相等(可赋值(造原语("never"), 串), 真, "3q never→任意")
  断言相等(可赋值(串, 数), 假, "3r string→number 不可")
  断言相等(可赋值(造字面量("42", "number"), 数), 真, "3s 数字字面量→number")
  断言相等(可赋值(造字面量("42", "number"), 串), 假, "3t 数字字面量→string 不可")
  断言相等(可赋值(串, 造联合([串, 数])), 真, "3u string→(string|number)")
  断言相等(可赋值(造联合([串, 数]), 串), 假, "3v (string|number)→string 不可")
  断言相等(可赋值(造联合([串, 数]), 造联合([串, 数, 造原语("boolean")])), 真, "3w 联合子集→超集")
  断言相等(可赋值(造数组(串), 造数组(造原语("string"))), 真, "3x string[]→string[]")
  断言相等(可赋值(造数组(串), 造数组(数)), 假, "3y string[]→number[] 不可")
  断言相等(可赋值(造元组([串, 数]), 造数组(造联合([串, 数]))), 真, "3z 元组→联合数组")
  断言相等(可赋值(造引用("Foo", [串]), 造引用("Foo", [造原语("string")])), 真, "3z2 同引用同实参")
  断言相等(可赋值(造引用("Foo", [串]), 造引用("Foo", [数])), 假, "3z3 同引用异实参")
  断言相等(可赋值(造引用("Foo", [串]), 造引用("Bar", [串])), 假, "3z4 异引用名")
  设 点 为 造对象([造属性成员("x", 数, 假, 假), 造属性成员("y", 数, 假, 假)])
  设 点三 为 造对象([造属性成员("x", 数, 假, 假), 造属性成员("y", 数, 假, 假), 造属性成员("z", 数, 假, 假)])
  断言相等(可赋值(点三, 点), 真, "3z5 结构宽→窄")
  断言相等(可赋值(点, 点三), 假, "3z6 结构窄→宽 不可")

  # ---- §4 分析器 ----
  设 记号 为 分词("class A " + 花左 + " x: string " + 花右)
  断言相等(记号[0], "class", "4a 分词 首记号")
  断言相等(记号[1], "A", "4b 分词 次记号")
  断言相等(记号[2], 花左, "4c 分词 花括号记号")
  断言相等(记号[4], ":", "4d 分词 冒号记号")
  断言相等(记号下标(记号, "x"), 3, "4e 记号下标")
  断言相等(取记号(记号, 99), "", "4f 越界取记号返回空")

  设 类符 为 分析声明("export abstract class Foo<T extends Bar> extends Base implements I " + 花左, "pkg")
  断言相等(类符["名称"], "Foo", "4g 类名提取")
  断言相等(类符["种类"], "class", "4h 类种类")
  断言相等(类符["导出"], 真, "4i 导出修饰符")
  断言相等(类符["抽象"], 真, "4j 抽象修饰符")
  断言相等(类符["静态"], 假, "4k 非静态")
  断言相等(类符["形参"], ["T"], "4l 形参提取（跳过 extends 约束）")
  断言相等(类符["继承"], ["Base"], "4m 继承提取")
  断言相等(类符["实现"], ["I"], "4n 实现提取")
  断言相等(类符["包"], "pkg", "4o 所属包")

  设 双参 为 分析声明("export class Pair2<T, U> " + 花左, "pkg")
  断言相等(双参["形参"], ["T", "U"], "4p 多形参提取")
  设 无参 为 分析声明("export class Plain " + 花左, "pkg")
  断言相等(无参["形参"], [], "4q 无泛型")
  断言相等(无参["继承"], [], "4r 无继承")
  断言相等(无参["抽象"], 假, "4s 非抽象")

  设 接符 为 分析声明("export interface Bar extends Base, Other " + 花左, "pkg")
  断言相等(接符["名称"], "Bar", "4t 接口名")
  断言相等(接符["种类"], "interface", "4u 接口种类")
  断言相等(接符["继承"], ["Base", "Other"], "4v 接口多继承")

  设 函符 为 分析声明("export function greet(name: string): string " + 花左, "pkg")
  断言相等(函符["名称"], "greet", "4w 函数名")
  断言相等(函符["种类"], "function", "4x 函数种类")

  设 别符 为 分析声明("export type Pair = [string, number];", "pkg")
  断言相等(别符["名称"], "Pair", "4y 别名")
  断言相等(别符["种类"], "alias", "4z 别名种类")

  设 枚符 为 分析声明("export enum Color " + 花左 + " Red = 1 " + 花右, "pkg")
  断言相等(枚符["名称"], "Color", "4z2 枚举名")
  断言相等(枚符["种类"], "enum", "4z3 枚举种类")

  设 只读符 为 分析声明("export class Box " + 花左 + " static readonly x: string " + 花右, "pkg")
  断言相等(只读符["静态"], 真, "4z4 静态修饰符")
  断言相等(只读符["只读"], 真, "4z5 只读修饰符")

  断言相等(取文档描叙("/**\n * Greets a user.\n */\nexport function greet(" + 花右), "Greets a user.", "4z6 JSDoc 首行摘要")
  断言相等(取文档描叙("export class A " + 花左), "", "4z7 无文档返回空")
  断言相等(定位子串("abcdef", "cd"), 2, "4z8 子串定位")
  断言相等(定位子串("abcdef", "zz"), -1, "4z9 子串定位未命中")

  设 表 为 造符号表("pkg")
  注册符号(表, 类符)
  注册符号(表, 函符)
  注册符号(表, 别符)
  断言相等(有符号(表, "Foo"), 真, "4z10 有符号")
  断言相等(有符号(表, "nope"), 假, "4z11 无符号")
  断言相等(查找符号(表, "Foo")["名称"], "Foo", "4z12 查找符号")
  断言相等(查找符号(表, "nope"), 空, "4z13 查找缺失返回空")
  断言相等(表["顺序"], ["Foo", "greet", "Pair"], "4z14 注册顺序")

  尝试:
    设 占位重复 为 注册符号(表, 类符)
    断言真(假, "4z15 重复符号应抛错")
  捕获 异常 错误二:
    断言真(含子串(转字符串(错误二), "duplicate symbol Foo"), "4z15 重复符号抛错")

  # ---- §5 渲染器 ----
  断言相等(渲染节点(串), "string", "5a 原语渲染")
  断言相等(渲染节点(造字面量("42", "number")), "42", "5b 字面量渲染")
  断言相等(渲染节点(造联合([串, 数])), "string | number", "5c 联合分隔符")
  断言相等(渲染节点(造交叉([串, 数])), "string & number", "5d 交叉分隔符")
  断言相等(渲染节点(造数组(串)), "string[]", "5e 数组渲染")
  断言相等(渲染节点(造数组(造联合([串, 数]))), "(string | number)[]", "5f 联合数组加括号")
  断言相等(渲染节点(造数组(造数组(串))), "string[][]", "5g 嵌套数组不加括号")
  断言相等(渲染节点(造元组([串, 数])), "[string, number]", "5h 元组渲染")
  断言相等(渲染节点(造对象([造属性成员("a", 串, 假, 假)])), 花左 + " a: string; " + 花右, "5i 对象渲染")
  断言相等(渲染节点(造对象([])), 花左 + 花右, "5j 空对象渲染")
  断言相等(渲染节点(造对象([造属性成员("a", 串, 真, 真)])), 花左 + " readonly a?: string; " + 花右, "5k 只读可选成员")
  断言相等(渲染节点(造函数([{"名称": "a", "节点": 串, "可选": 假}], 数)), "(a: string) => number", "5l 函数渲染")
  断言相等(渲染节点(造函数([{"名称": "a", "节点": 串, "可选": 真}], 数)), "(a?: string) => number", "5m 可选参数渲染")
  断言相等(渲染节点(造引用("Foo", [])), "Foo", "5n 无实参引用")
  断言相等(渲染节点(造引用("Foo", [串, 数])), "Foo<string, number>", "5o 有实参引用")
  断言相等(需括号(造联合([串, 数])), 真, "5p 联合需括号")
  断言相等(需括号(串), 假, "5q 原语不需括号")
  断言相等(渲染成员(造方法成员("m", [{"名称": "x", "节点": 数, "可选": 假}], 串)), "m(x: number): string", "5r 方法成员渲染")

  设 类成员 为 [造属性成员("a", 串, 假, 假), 造方法成员("m", [], 数)]
  设 类符号 为 {"名称": "Foo", "种类": "class", "形参": ["T"], "继承": ["Base"], "实现": [], "抽象": 假, "成员": 类成员}
  断言相等(渲染符号(类符号), 连接文本(["export class Foo<T> extends Base " + 花左, "    a: string;", "    m(): number;", 花右], "\n"), "5s 类符号渲染")
  设 抽象类 为 {"名称": "Abs", "种类": "class", "形参": [], "继承": [], "实现": ["I"], "抽象": 真, "成员": []}
  断言相等(渲染符号(抽象类), "export abstract class Abs implements I " + 花左 + "\n" + 花右, "5t 抽象类渲染")
  设 别名符号 为 {"名称": "Pair", "种类": "alias", "形参": [], "节点": 造元组([串, 数])}
  断言相等(渲染符号(别名符号), "export type Pair = [string, number];", "5u 别名渲染")
  设 形参别名 为 {"名称": "Box", "种类": "alias", "形参": ["T"], "节点": 造引用("T", [])}
  断言相等(渲染符号(形参别名), "export type Box<T> = T;", "5v 带形参别名渲染")
  断言相等(渲染文档("摘要"), "/**\n * 摘要\n */", "5w JSDoc 渲染")
  断言相等(渲染文档(""), "", "5x 空文档渲染空串")

  尝试:
    设 占位怪节 为 渲染节点(造节点("mystery", {}))
    断言真(假, "5y 未知节点种类应抛错")
  捕获 异常 错误三:
    断言真(含子串(转字符串(错误三), "unsupported type node kind"), "5y 未知节点种类抛错")

  # ---- §6 发射器 ----
  断言相等(声明文件头(), "/* Generated by @deepseek-ai/dsh-typert-generator from FaceModel — do not edit. */", "6a 声明文件头")
  断言相等(排序名(["c", "a", "b"]), ["a", "b", "c"], "6b 名称排序")
  断言相等(排序名([]), [], "6c 空表排序")
  断言相等(排序名(["b", "a", "b"]), ["a", "b", "b"], "6d 重复名排序稳定")
  断言相等(名比较("a", "b"), -1, "6e 名比较 小于")
  断言相等(名比较("b", "a"), 1, "6f 名比较 大于")
  断言相等(名比较("a", "a"), 0, "6g 名比较 相等")

  设 发射表 为 造符号表("pkg2")
  注册符号(发射表, {"名称": "Zeta", "种类": "alias", "导出": 真, "形参": [], "节点": 造原语("string")})
  注册符号(发射表, {"名称": "Alpha", "种类": "alias", "导出": 真, "形参": [], "节点": 造原语("number")})
  注册符号(发射表, {"名称": "内部", "种类": "alias", "导出": 假, "形参": [], "节点": 造原语("boolean")})
  断言相等(只导出公开(发射表), ["Zeta", "Alpha"], "6h 只导出公开过滤")
  设 发射文 为 发射声明文件(发射表)
  断言真(含子串(发射文, "Generated by @deepseek-ai/dsh-typert-generator"), "6i 发射含头注释")
  断言真(含子串(发射文, "export type Alpha = number;"), "6j 发射含 Alpha")
  断言真(含子串(发射文, "export type Zeta = string;"), "6k 发射含 Zeta")
  断言相等(含子串(发射文, "内部"), 假, "6l 发射不含非导出符号")
  设 头先 为 定位子串(发射文, "Generated by")
  设 甲先 为 定位子串(发射文, "Alpha")
  设 乙先 为 定位子串(发射文, "Zeta")
  断言相等(头先 < 甲先, 真, "6m 头注释在声明之前")
  断言相等(甲先 < 乙先, 真, "6n 声明按名排序（Alpha 先于 Zeta）")
  断言相等(截取(发射文, 字符串长度(发射文) - 1, 字符串长度(发射文)), "\n", "6o 发射以换行收尾")

  设 文档表 为 造符号表("pkg3")
  注册符号(文档表, {"名称": "Doc", "种类": "alias", "导出": 真, "形参": [], "节点": 造原语("string"), "文档": "文档摘要"})
  断言真(含子串(发射声明文件(文档表), "/**\n * 文档摘要\n */\nexport type Doc = string;"), "6p 发射含 JSDoc")

  打印 "test_类型系统 PASS"

主()
