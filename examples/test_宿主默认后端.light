# test_宿主默认后端.light —— 第8轮 A线 #292 真实 OS 后端默认化判据
# 运行：python 运行.py examples/test_宿主默认后端.light
# 判据：
#   桩未接 -> 走真后端（外部命令/进程树/e2b local-sim/审批管理器/遥测收集器，真实执行）
#   桩已接 -> 走桩（R7 桩套件，预设退出码/输出，不触真实 OS）
#   桩后接（先真后端，再接桩）-> 切换到桩
#   真后端失败（不存在的命令）-> 信封返回不崩（fail-closed）
#   退出码映射：真后端非零退出码精确保留（exit 3 -> 退出码 3）

从 宿主桩 导入 造宿主桩套件, 设预设进程, 取钩子历史, 取遥测表, 取审批表
从 宿主默认后端 导入 默认后端或桩, 真子进程执行, 真凭据读取, 真沙箱执行, 真审批记录, 真遥测记录
从 宿主默认后端 导入 取默认凭据提供者, 取默认遥测收集器
从 子进程 导入 接桩子进程, 运行进程默认, 子进程桩已接
从 沙箱 导入 接桩沙箱, 运行受限默认, 沙箱桩已接
从 e2b客户端 导入 接桩e2b, 执行代码默认, e2b桩已接
从 交互命令 导入 接桩交互, 记录审批默认, 交互桩已接
从 反馈 导入 接桩遥测, 记录遥测默认, 遥测桩已接
从 钩子 导入 宿主钩子默认, 取默认钩子系统
从 宿主IO 导入 是失败结果, 是成功结果

# ---- 钩子默认路径收集器（光明无闭包：模块级槽） ----
设 钩子收集槽 为 {"事件表": []}

段落 收集处理器(上下文):
  全局 钩子收集槽
  钩子收集槽["事件表"].追加(上下文["事件"])
  返回 空

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  设 套件 为 造宿主桩套件()
  设 桩 为 套件["桩"]
  设 状态 为 套件["状态"]

  # ============ #12 子进程：桩未接 -> 真后端（真实 OS 执行） ============
  断言真(子进程桩已接() == 假, "1a 前置：子进程桩未接")
  设 r1 为 运行进程默认("echo hello", 30)
  断言真(是成功结果(r1), "1b 真后端执行成功信封")
  断言相等(字典获取(r1["元数据"], "后端", ""), "真后端", "1c 元数据标记真后端")
  断言真(字符串包含(r1["数据"]["标准输出"], "hello"), "1d 真实输出含hello")
  断言相等(r1["数据"]["退出码"], 0, "1e 退出码0")
  # 退出码映射：非零退出码精确保留
  设 r2 为 运行进程默认("exit 3", 30)
  断言真(是成功结果(r2), "2a exit3 命令本身执行成功")
  断言相等(r2["数据"]["退出码"], 3, "2b 退出码精确保留为3")
  # 真后端失败（不存在的命令）-> 信封返回不崩
  设 r3 为 运行进程默认("definitely_not_a_cmd_xyz_1234", 30)
  断言真(是成功结果(r3) 或 是失败结果(r3), "3a 不存在命令返回信封不崩")
  如果 是成功结果(r3):
    断言真(r3["数据"]["退出码"] != 0, "3b 不存在命令退出码非0")

  # ============ #12 子进程：桩后接 -> 切换到桩 ============
  设预设进程(状态, "echo preset", 0, "PRESET\n")
  接桩子进程(桩)
  断言真(子进程桩已接(), "4a 子进程桩已接")
  设 r4 为 运行进程默认("echo preset", 5000)
  断言真(是成功结果(r4), "4b 桩路径成功信封")
  断言相等(r4["数据"]["标准输出"], "PRESET\n", "4c 桩预设输出")
  断言相等(字典获取(r4["元数据"], "后端", "桩"), "桩", "4d 元数据判定走桩")

  # ============ #13 沙箱：桩未接 -> 真后端（进程树引擎） ============
  断言真(沙箱桩已接() == 假, "5a 前置：沙箱桩未接")
  设 r5 为 运行受限默认("echo sandbox-ok", 30000, 空)
  断言真(是成功结果(r5), "5b 真沙箱执行成功信封")
  断言相等(字典获取(r5["元数据"], "后端", ""), "真后端", "5c 元数据标记真后端")
  断言真(字符串包含(r5["数据"]["标准输出"], "sandbox-ok"), "5d 真实输出含sandbox-ok")
  断言相等(r5["数据"]["资源限制"], "process-tree", "5e 进程树引擎标记")
  # 桩后接 -> 切换到桩
  接桩沙箱(桩)
  设 r6 为 运行受限默认("echo preset", 5000, "/work")
  断言相等(r6["数据"]["资源限制"], "stub-sandbox", "6a 桩路径沙箱标记")

  # ============ #21 e2b：桩未接 -> 真后端（既有 local-sim 本地模拟） ============
  断言真(e2b桩已接() == 假, "7a 前置：e2b桩未接")
  设 r7 为 执行代码默认("print(11+22)")
  断言真(是成功结果(r7), "7b local-sim 执行成功信封")
  断言相等(字典获取(r7["元数据"], "后端", ""), "真后端", "7c 元数据标记真后端")
  断言真(字符串包含(r7["数据"]["标准输出"], "33"), "7d 本地模拟输出33")
  断言相等(r7["数据"]["模式"], "local-sim", "7e 本地模拟模式标记")
  断言相等(r7["数据"]["资源限制"], "local-sim", "7f local-sim 资源标记")
  # 桩后接 -> 切换到桩
  设预设进程(状态, "e2b:print('hi')", 0, "hi\n")
  接桩e2b(桩)
  设 r8 为 执行代码默认("print('hi')")
  断言相等(r8["数据"]["资源限制"], "stub-sandbox", "8a 桩路径沙箱标记")
  断言相等(r8["数据"]["标准输出"], "hi\n", "8b 桩预设输出")

  # ============ #17 交互审批：桩未接 -> 真后端（审批管理器真链路） ============
  断言真(交互桩已接() == 假, "9a 前置：交互桩未接")
  设 r9 为 记录审批默认("bash", "批准", "ok")
  断言真(是成功结果(r9), "9b 审批真后端成功信封")
  断言相等(r9["数据"]["批准"], 真, "9c 审批管理器批准")
  断言相等(r9["数据"]["状态"], "已批准", "9d 状态已批准")
  设 r10 为 记录审批默认("rm", "拒绝", "危险操作")
  断言相等(r10["数据"]["批准"], 假, "10a 审批管理器拒绝")
  断言相等(r10["数据"]["状态"], "已拒绝", "10b 状态已拒绝")
  # 桩后接 -> 切换到桩（桩审批表可断言）
  接桩交互(桩)
  设 r11 为 记录审批默认("bash", "批准", "桩路径")
  断言真(是成功结果(r11), "11a 桩路径成功")
  断言相等(列表长度(取审批表(状态)), 1, "11b 桩审批表一条")

  # ============ #19 遥测：桩未接 -> 真后端（遥测收集器真链路） ============
  断言真(遥测桩已接() == 假, "12a 前置：遥测桩未接")
  设 r12 为 记录遥测默认("tool_call", 1, {"工具": "bash"})
  断言真(是成功结果(r12), "12b 遥测真后端成功信封")
  断言相等(r12["数据"]["span名"], "tool_call", "12c span名")
  设 收集器 为 取默认遥测收集器()
  断言真(列表长度(收集器.获取全部span()) >= 1, "12d 真收集器span已落")
  # 桩后接 -> 切换到桩（桩遥测表可断言）
  接桩遥测(桩)
  设 r13 为 记录遥测默认("token_usage", 150, {"模型": "deepseek"})
  断言真(是成功结果(r13), "13a 桩路径成功")
  断言相等(列表长度(取遥测表(状态)), 1, "13b 桩遥测表一条")

  # ============ #10 钩子：桩为空 -> 本地钩子系统发布（默认路径） ============
  设 系统 为 取默认钩子系统()
  系统.订阅("capability", "pre", 收集处理器)
  设 r14 为 宿主钩子默认(空, "PreToolUse", "pre", {"工具": "bash"}, "sess-d")
  断言真(是成功结果(r14), "14a 默认钩子派发成功")
  断言相等(字典获取(r14["元数据"], "后端", ""), "真后端", "14b 元数据标记真后端")
  断言相等(r14["数据"]["已派发"], 真, "14c 已派发标记")
  设 事件表 为 钩子收集槽["事件表"]
  断言相等(列表长度(事件表), 1, "14d 处理器收到一条事件")
  断言相等(事件表[0]["类型"], "pre", "14e 事件类型")
  断言相等(事件表[0]["数据"]["工具"], "bash", "14f 事件数据")
  # 非宿主钩子域 -> INVALID_ARGUMENT（fail-closed）
  设 r15 为 宿主钩子默认(空, "session", "x", {}, "sess-d")
  断言真(是失败结果(r15), "15a 非宿主域失败")
  # 桩路径：宿主桩非空 -> 走桩（取钩子历史可断言）
  设 r16 为 宿主钩子默认(桩, "Stop", "stop", {"原因": "done"}, "sess-d")
  断言真(是成功结果(r16), "16a 桩路径成功")
  断言相等(列表长度(取钩子历史(状态)), 1, "16b 桩钩子历史一条")

  # ============ 凭据：真凭据读取（本地凭证提供者真链路） ============
  设 提供者 为 取默认凭据提供者()
  提供者.置("TEST_DEFAULT_KEY", "v9")
  设 r17 为 默认后端或桩(空, 真凭据读取, "凭据读取", {"凭据名": "TEST_DEFAULT_KEY"})
  断言真(是成功结果(r17), "17a 凭据真后端成功信封")
  断言相等(r17["数据"]["值"], "v9", "17b 凭据值")
  断言相等(r17["数据"]["源"], "user-env", "17c 来源层")
  设 r18 为 默认后端或桩(空, 真凭据读取, "凭据读取", {"凭据名": "NOT_CONFIGURED_XYZ"})
  断言真(是失败结果(r18), "18a 未配置凭据失败信封")
  断言相等(r18["错误码"], "NOT_FOUND", "18b NOT_FOUND")

  打印 "--- 第8轮 A线 #292 宿主默认后端测试通过（真后端默认路径 + 桩为测试注入） ---"

主()
