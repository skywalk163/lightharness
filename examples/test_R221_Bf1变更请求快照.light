# test_R221_Bf1变更请求快照.light —— R221-Bf1 判据（forge 快照概览 / diff 定 head / 评审读取码）
# 运行：python 运行.py examples/test_R221_Bf1变更请求快照.light
# 上游：packages/experimental/forge/src/types.ts（dsh-v0.2.2-rc.3 = 38a6a5c965）
# 指南：docs/upgrade-guide/v0.2.2-rc.1/{forge-change-request-overview,forge-pinned-diff,forge-review-reads}
#
# 覆盖上游用例（逐条标注）：
#   [snap1] 无平台数据时 13 个必填字段齐全，缺省形状为空数组/false（指南逐字给定）
#   [snap2] 补全只填缺失字段，不覆盖已给值，不丢弃额外键
#   [check1] rerun 为标识或 null；声明可重跑却无标识要响亮报错
#   [fail1] 六个读取失败码齐全；stale 可重试（须换新 head）、unsupported/unavailable 是能力缺失
#   [fail2] unknown 结果不明：不可重试、需核对
#   [diff1] 补丁头与请求头不等即过期；空补丁头同样过期（不能拿旧 head 顶）
#   [review1] 提供方未实现 readReview -> unsupported
#
# 反跑判据（改反源码任一期望必须红）：
#   A. 变更请求差异过期 里 空补丁头 返回 假   -> diff 用例红
#   B. 变更请求失败语义 里 unknown 的可重试改 真 -> fail2 用例红

从 变更请求 导入 变更请求快照缺省, 变更请求快照补全, 变更请求快照校验, 变更请求检查构造, 变更请求失败码集, 变更请求失败语义, 变更请求失败可重试, 变更请求差异过期, 变更请求评审读取码

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言列表含(表, 片段, 标签):
  设 命中 为 假
  遍历 项 之 表:
    如果 字符串包含(转字符串(项), 片段):
      设 命中 为 真
  如果 命中 == 假:
    抛出 新建 错误("断言列表含失败: " + 标签 + " 片段=" + 片段 + " 表=" + 序列化JSON(表))

段落 断言抛含(待测段落, 片段, 标签):
  设 已抛 为 假
  尝试:
    待测段落()
  捕获 异常 为 异常值:
    设 已抛 为 真
    设 报文 为 转字符串(异常值)
    如果 字符串包含(报文, 片段) == 假:
      抛出 新建 错误("断言抛含失败: " + 标签 + " 报文=" + 报文)
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛: " + 标签)

段落 造引用():
  返回 {"repository": {"forge": "github", "host": "github.com", "owner": "acme", "name": "demo"}, "number": 7}

段落 造检查():
  返回 变更请求检查构造("run-12", "build", 真)

# 反跑包装：可重跑但无标识（应抛）
段落 造坏检查():
  返回 变更请求检查构造("", "build", 真)

# 反跑包装：本卡未覆盖的码（应抛）
段落 查未覆盖码():
  返回 变更请求失败语义("failed")

段落 主程():
  # ===== 一、缺省快照（snap1）=====

  # 1. 13 个必填字段全部齐（缺一个都要红）
  设 快照 为 变更请求快照缺省(造引用())
  断言相等(列表长度(快照), 13, "缺省-字段数")
  断言真(字典包含键(快照, "引用"), "缺省-有引用")
  断言真(字典包含键(快照, "分支更新"), "缺省-有分支更新")
  断言真(字典包含键(快照, "评审结论"), "缺省-有评审结论")
  断言真(字典包含键(快照, "评审者"), "缺省-有评审者")
  断言真(字典包含键(快照, "评审者截断"), "缺省-有评审者截断")
  断言真(字典包含键(快照, "可请求评审"), "缺省-有可请求评审")
  断言真(字典包含键(快照, "检查"), "缺省-有检查")
  断言真(字典包含键(快照, "可重跑检查"), "缺省-有可重跑检查")
  断言真(字典包含键(快照, "未解决讨论"), "缺省-有未解决讨论")
  断言真(字典包含键(快照, "讨论截断"), "缺省-有讨论截断")
  断言真(字典包含键(快照, "关联议题"), "缺省-有关联议题")
  断言真(字典包含键(快照, "关联议题截断"), "缺省-有关联议题截断")
  断言真(字典包含键(快照, "更新时间"), "缺省-有更新时间")

  # 2. 缺省形状按指南逐字：空数组 / false / 0 / none
  断言相等(快照["评审者"], [], "缺省-评审者空")
  断言相等(快照["评审者截断"], 假, "缺省-评审者不截断")
  断言相等(快照["关联议题"], [], "缺省-关联议题空")
  断言相等(快照["关联议题截断"], 假, "缺省-关联议题不截断")
  断言相等(快照["分支更新"], [], "缺省-分支更新空")
  断言相等(快照["可请求评审"], 假, "缺省-不可请求评审")
  断言相等(快照["可重跑检查"], 假, "缺省-不可重跑")
  断言相等(快照["讨论截断"], 假, "缺省-讨论不截断")
  断言相等(快照["未解决讨论"], 0, "缺省-未解决为0")
  断言相等(快照["评审结论"], "none", "缺省-评审结论none")

  # 3. 缺省快照本身通过校验（不许自己都不合法）
  断言相等(变更请求快照校验(快照), [], "缺省-校验通过")

  # 4. 引用被原样带入
  断言相等(快照["引用"]["number"], 7, "缺省-引用号")

  # ===== 二、补全（snap2）=====

  # 5. 空表补全 → 13 字段齐
  设 原始 为 {}
  设 补齐 为 变更请求快照补全(原始, 造引用())
  断言相等(列表长度(补齐), 13, "补全-字段数")
  断言相等(变更请求快照校验(补齐), [], "补全-校验通过")

  # 6. 已给值不被覆盖
  设 半 为 {"评审者": [{"kind": "user", "login": "ann"}], "讨论截断": 真}
  设 半补 为 变更请求快照补全(半, 造引用())
  断言相等(列表长度(半补["评审者"]), 1, "补全-保留已给评审者")
  断言相等(半补["讨论截断"], 真, "补全-保留已给截断")
  断言相等(半补["可请求评审"], 假, "补全-补上可请求评审")

  # 7. 额外键不丢（比如宿主自带的 headSha）
  设 带额外 为 {"headSha": "abc123"}
  设 带额外补 为 变更请求快照补全(带额外, 造引用())
  断言相等(带额外补["headSha"], "abc123", "补全-保留额外键")

  # 8. 补全原地改的是同一个字典
  断言真(带额外补 == 带额外, "补全-原地")

  # ===== 三、校验（snap1 的拒绝面）=====

  # 9. 缺字段 → 报「缺少必填字段 <键>」
  设 缺一 为 变更请求快照缺省(造引用())
  设 删掉 为 字典删除(缺一, "检查")
  设 缺错 为 变更请求快照校验(缺一)
  断言相等(列表长度(缺错), 1, "校验-缺一只有一条")
  断言列表含(缺错, "快照缺少必填字段 检查", "校验-缺字段文案")

  # 10. 类型不符 → 报「应为<类型>」
  设 坏型 为 变更请求快照缺省(造引用())
  坏型["评审者"] 为 "ann"
  设 型错 为 变更请求快照校验(坏型)
  断言列表含(型错, "快照字段 评审者 应为列表", "校验-类型文案")

  # 11. 截断标志必须是布尔（不是 0/1）
  设 坏布尔 为 变更请求快照缺省(造引用())
  坏布尔["讨论截断"] 为 1
  断言列表含(变更请求快照校验(坏布尔), "快照字段 讨论截断 应为布尔", "校验-布尔文案")

  # 12. 未解决讨论接受浮点（上游是 number）
  设 浮点快照 为 变更请求快照缺省(造引用())
  浮点快照["未解决讨论"] 为 2.5
  断言相等(变更请求快照校验(浮点快照), [], "校验-数值可为浮点")

  # ===== 四、检查的 rerun（check1）=====

  # 13. 可重跑 → 重跑 = 标识
  断言相等(造检查()["重跑"], "run-12", "检查-可重跑带标识")

  # 14. 不可重跑 → null（空）
  设 不可 为 变更请求检查构造("run-9", "status", 假)
  断言相等(不可["重跑"], 空, "检查-不可重跑为null")
  断言相等(不可["名称"], "status", "检查-名称")

  # 15. 可重跑但无标识 → 响亮报错
  断言抛含(造坏检查, "可重跑检查缺少标识", "检查-无标识报错")

  # ===== 五、失败码（fail1 / fail2）=====

  # 16. 六个读取码齐全且顺序固定
  设 码集 为 变更请求失败码集()
  断言相等(列表长度(码集), 6, "失败码-六个")
  断言相等(码集[0], "not-found", "失败码-首")
  断言相等(码集[3], "stale", "失败码-含stale")
  断言相等(码集[4], "unsupported", "失败码-含unsupported")
  断言相等(码集[5], "unavailable", "失败码-含unavailable")

  # 17. stale：可重试、不需核对
  设 过 为 变更请求失败语义("stale")
  断言相等(过["可重试"], 真, "stale-可重试")
  断言相等(过["需核对"], 假, "stale-不需核对")
  断言列表含([过["说明"]], "新 head", "stale-说明提新head")

  # 18. unsupported：能力缺失，不是可重试失败
  设 不支 为 变更请求失败语义("unsupported")
  断言相等(不支["可重试"], 假, "unsupported-不可重试")
  断言相等(不支["需核对"], 假, "unsupported-不需核对")
  断言列表含([不支["说明"]], "能力", "unsupported-说明提能力")

  # 19. unavailable：同上（未实现）
  断言相等(变更请求失败可重试("unavailable"), 假, "unavailable-不可重试")

  # 20. unknown：不可重试、必须核对（改动可能已生效）
  设 不明 为 变更请求失败语义("unknown")
  断言相等(不明["可重试"], 假, "unknown-不可重试")
  断言相等(不明["需核对"], 真, "unknown-需核对")
  断言列表含([不明["说明"]], "可能已生效", "unknown-说明提已生效")

  # 21. 其余三码各自的说明
  断言列表含([变更请求失败语义("not-found")["说明"]], "不暴露", "not-found-说明")
  断言列表含([变更请求失败语义("unauthenticated")["说明"]], "凭据", "unauthenticated-说明")
  断言列表含([变更请求失败语义("too-large")["说明"]], "上限", "too-large-说明")

  # 22. 未覆盖的码必须响亮报错（不静默归类）
  断言抛含(查未覆盖码, "本卡未覆盖的失败码", "未覆盖码-报错")

  # ===== 六、diff 定 head（diff1）=====

  # 23. 头相等 → 不过期
  断言相等(变更请求差异过期("abc", "abc"), 假, "diff-同头不过期")

  # 24. 头不等 → 过期（不能拿旧 head 的补丁）
  断言相等(变更请求差异过期("abc", "def"), 真, "diff-异头过期")

  # 25. 空补丁头 → 过期
  断言相等(变更请求差异过期("", "abc"), 真, "diff-空补丁头过期")

  # 26. 请求头为空但补丁头非空 → 过期（没有可对齐的 head）
  断言相等(变更请求差异过期("abc", ""), 真, "diff-空请求头过期")

  # ===== 七、评审读取（review1）=====

  # 27. 提供方实现了 readReview → 无失败码
  断言相等(变更请求评审读取码(真), "", "review-已实现无码")

  # 28. 未实现 → unsupported（能力缺失，不是读取失败）
  断言相等(变更请求评审读取码(假), "unsupported", "review-未实现unsupported")

  # 29. 该码本身可查语义
  断言相等(变更请求失败可重试(变更请求评审读取码(假)), 假, "review-unsupported不可重试")

  写 "--- 测试 R221_Bf1变更请求快照 通过 ---"

主程()