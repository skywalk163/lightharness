# test_R85_D_插件管理.light —— R85 任务 D 子任务对拍测试
# 导入 src/插件管理.light 的纯逻辑段落，覆盖：install-spec 校验、内存补丁应用、
# 失败分类、管理失败、构建审批谓词、操作编排、工具定义、manager 注入 mock 安装钩子。
# 运行：python 运行.py examples/test_R85_D_插件管理.light

导入 插件管理
从 插件管理 导入 插校验规格, 插造规格, 插应用补丁, 插分类失败, 插管理失败, 插构建需审批, 插锚定路径规格, 插编排操作, 插工具定义, 插建管理器, 插安装

段落 插断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

# 自定义抛错检查辅助：捕获异常并返回消息串
段落 插断言抛错(标签, 运算):
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 异常 错误:
    设 抛了 为 真
    设 消息 为 转字符串(错误)
  如果 抛了 == 假:
    抛出 "应抛未抛: " + 标签
  返回 消息

# ---- 抛错样例（命名 段落，作为 插断言抛错 的运算参数）----
段落 抛空规格:
  插校验规格("")

段落 抛相对路径:
  插校验规格("./rel")

段落 抛坏包名:
  插校验规格("Bad Name")

段落 抛空范围:
  插校验规格("foo@")

段落 抛非gitURL:
  插校验规格("https://example.com/foo.txt")

段落 抛无宿主钩子:
  插安装(插建管理器(空), "lodash", 空)

段落 抛补丁未命中:
  插应用补丁("abc", ["类型": "查找替换", "查找": "z", "替换": "y"])

# ---- mock 宿主面：模拟 Node 安装执行，仅回显归一规格/计划/选项 ----
段落 模拟安装执行(归一, 计划, 选项):
  返回 ["退出码": 0, "输出": "mock install ok", "截断": 假, "日志路径": "/tmp/x.log", "种类": "unknown", "收到规格": 归一, "收到计划步数": 列表长度(计划)]

段落 主:
  # ===== 1. install-spec 合法校验（registry / scoped+range / git / 绝对路径 / file:）=====
  设 规格1 为 插校验规格("lodash")
  插断言相等(字典获取(规格1, "种类"), "registry", "规格1-种类")
  插断言相等(字典获取(规格1, "名"), "lodash", "规格1-名")
  设 规格2 为 插校验规格("@scope/name@1.2.3")
  插断言相等(字典获取(规格2, "种类"), "registry", "规格2-种类")
  插断言相等(字典获取(规格2, "名"), "@scope/name", "规格2-名")
  插断言相等(字典获取(规格2, "范围"), "1.2.3", "规格2-范围")
  设 规格3 为 插校验规格("github:user/repo")
  插断言相等(字典获取(规格3, "种类"), "git", "规格3-种类")
  设 规格4 为 插校验规格("/abs/pkg")
  插断言相等(字典获取(规格4, "种类"), "path", "规格4-种类")
  设 规格5 为 插校验规格("file:/abs/pkg")
  插断言相等(字典获取(规格5, "种类"), "path", "规格5-种类")

  # ===== 2. install-spec 非法校验（各情形均抛 INVALID_SPEC）=====
  设 消息空 为 插断言抛错("空规格", 抛空规格)
  插断言相等(字符串包含(消息空, "INVALID_SPEC"), 真, "空规格-码")
  设 消息相对 为 插断言抛错("相对路径", 抛相对路径)
  插断言相等(字符串包含(消息相对, "INVALID_SPEC"), 真, "相对路径-码")
  设 消息坏名 为 插断言抛错("坏包名", 抛坏包名)
  插断言相等(字符串包含(消息坏名, "INVALID_SPEC"), 真, "坏包名-码")
  设 消息空范围 为 插断言抛错("空范围", 抛空范围)
  插断言相等(字符串包含(消息空范围, "INVALID_SPEC"), 真, "空范围-码")
  设 消息URL 为 插断言抛错("非gitURL", 抛非gitURL)
  插断言相等(字符串包含(消息URL, "INVALID_SPEC"), 真, "非gitURL-码")

  # ===== 3. patch 在内存字符串上应用（查找替换 / 全替换 / 行操作）=====
  设 内容甲 为 "hello world"
  设 补丁甲 为 ["类型": "查找替换", "查找": "world", "替换": "light"]
  插断言相等(插应用补丁(内容甲, 补丁甲), "hello light", "补丁-查找替换")
  设 内容乙 为 "a b a b"
  设 补丁乙 为 ["类型": "查找替换", "查找": "a", "替换": "X", "全部": 真]
  插断言相等(插应用补丁(内容乙, 补丁乙), "X b X b", "补丁-全替换")
  设 内容丙 为 "line1\nline2\nline3"
  设 补丁插入 为 ["类型": "行插入", "行号": 1, "文本": "new"]
  插断言相等(插应用补丁(内容丙, 补丁插入), "line1\nnew\nline2\nline3", "补丁-行插入")
  设 补丁删除 为 ["类型": "行删除", "行号": 1]
  插断言相等(插应用补丁(内容丙, 补丁删除), "line1\nline3", "补丁-行删除")
  设 补丁行替换 为 ["类型": "行替换", "行号": 1, "文本": "X"]
  插断言相等(插应用补丁(内容丙, 补丁行替换), "line1\nX\nline3", "补丁-行替换")
  设 消息未命中 为 插断言抛错("补丁未命中", 抛补丁未命中)
  插断言相等(字符串包含(消息未命中, "PATCH_NOT_FOUND"), 真, "补丁-未命中")

  # ===== 4. 失败分类（不同输入 → 不同类别）=====
  插断言相等(插分类失败(["日志": "npm error code E404", "超时": 假]), "not-found", "失败-未找到")
  插断言相等(插分类失败(["日志": "ENOSPC: no space left on device"]), "disk-full", "失败-磁盘满")
  插断言相等(插分类失败(["日志": "EACCES: permission denied"]), "permission", "失败-权限")
  插断言相等(插分类失败(["日志": "ERR_PNPM_TARBALL_INTEGRITY broken"]), "integrity", "失败-完整性")
  插断言相等(插分类失败(["日志": "ENOTFOUND example.com"]), "network", "失败-网络")
  插断言相等(插分类失败(["日志": "ERR_PNPM_IGNORED_BUILDS"]), "build-blocked", "失败-构建拦截")
  插断言相等(插分类失败(["超时": 真]), "timeout", "失败-超时")
  插断言相等(插分类失败(["原因码": "ENOENT"]), "pnpm-missing", "失败-pnpm缺失")
  插断言相等(插分类失败(["日志": "some random error"]), "unknown", "失败-未知")

  # ===== 5. 管理失败分类（码 → 消息）=====
  设 管理失败 为 插管理失败("unknown-plugin")
  插断言相等(字典获取(管理失败, "码"), "unknown-plugin", "管理失败-码")
  插断言相等(字符串包含(字典获取(管理失败, "消息"), "未知插件"), 真, "管理失败-消息")

  # ===== 6. 构建审批谓词（需 / 不需审批）=====
  设 需审批 为 插构建需审批(["待决构建": ["foo", "bar"], "已批准构建": []])
  插断言相等(需审批, 真, "审批-需审批")
  设 不需审批 为 插构建需审批(["待决构建": ["foo"], "已批准构建": ["foo", "bar"]])
  插断言相等(不需审批, 假, "审批-不需")

  # ===== 7. 操作编排：有序计划，且含宿主面边界「执行安装」步 =====
  设 计划 为 插编排操作(规格1)
  插断言相等(是列表(计划), 真, "编排-是列表")
  插断言相等(列表长度(计划), 5, "编排-步数")
  插断言相等(字典获取(计划[1], "步"), "执行安装", "编排-执行安装步")
  设 锚定 为 插锚定路径规格("file:./foo", "/cwd")
  插断言相等(锚定, "/cwd/./foo", "编排-锚定路径")

  # ===== 8. 工具定义 schema（纯部分）=====
  设 工具 为 插工具定义()
  插断言相等(字典获取(工具, "名"), "plugin_manager", "工具-名")
  插断言相等(列表包含(字典获取(工具, "动作表"), "install_bundle"), 真, "工具-含install_bundle")

  # ===== 9. manager 装配 + 注入 mock 安装钩子（真实执行交给宿主面）=====
  设 管理器 为 插建管理器(["执行安装": 模拟安装执行])
  设 安装结果 为 管理器["安装"](管理器, "lodash", 空)
  插断言相等(字典获取(安装结果, "退出码"), 0, "安装-退出码")
  插断言相等(字典获取(安装结果, "输出"), "mock install ok", "安装-输出")
  插断言相等(字典获取(安装结果, "收到计划步数"), 5, "安装-计划步数")

  # ===== 10. 无宿主钩子时正确抛错（宿主面未登记）=====
  设 消息无钩子 为 插断言抛错("无宿主钩子", 抛无宿主钩子)
  插断言相等(字符串包含(消息无钩子, "NO_HOST_HOOK"), 真, "安装-无钩子码")

  # ===== 11. types 构造辅助 =====
  设 构造规格 为 插造规格("myplugin", "registry")
  插断言相等(字典获取(构造规格, "名"), "myplugin", "构造-名")
  插断言相等(字典获取(构造规格, "种类"), "registry", "构造-种类")

  写 "test_R85_D_插件管理 PASS"
