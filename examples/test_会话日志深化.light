# test_会话日志深化.light —— 第 34 轮 任务 4 判据：会话事件日志完善复刻
# 上游：deepseek-harness 0.1.5-rc.2 packages/session/src/{event-log,projection,incremental-scan,watermark}.ts
# 运行：cd lightharness && python 运行.py examples/test_会话日志深化.light
# 覆盖：§0 安全整数/-0 判定、§1 追加-only 日志、§2 事件投影、§3 增量扫描、§4 水印折叠、§5 整链回放

从 会话日志深化 导入 安全整数上限值, 交付接受类型, 已知类型集, 载荷模式表
从 会话日志深化 导入 判定安全整数, 是负零, 取格式版本, 校验载荷, 记录副本, 记录表副本, 判定扫描点
从 会话日志深化 导入 创建日志, 获取写锁, 释放写锁, 追加事件, 读取范围, 读取全部, 校验日志
从 会话日志深化 导入 取项, 有项
从 会话日志深化 导入 空状态, 投影一个, 投影全部, 投影增量, 校验投影
从 会话日志深化 导入 创建扫描器, 扫描一批, 扫描快照, 从快照恢复, 校验扫描器
从 会话日志深化 导入 创建水印, 折叠一个, 折叠至, 校验水印, 下一扫描起点
从 会话日志深化 导入 整链回放, 整链校验

段落 必等 接收 实际, 期望, 编号:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际 " + 转字符串(实际) + "，期望 " + 转字符串(期望))
  返回 真

段落 通过 接收 编号:
  打印 "OK #" + 编号
  返回 真

段落 造接受事件 接收 序号, 会话标识, 版本, 通过序号:
  设 数据 为 {}
  数据["sessionId"] 为 会话标识
  数据["sessionFormatVersion"] 为 版本
  数据["throughSeq"] 为 通过序号
  设 记录 为 {}
  记录["类型"] 为 交付接受类型
  记录["序号"] 为 序号
  记录["时间"] 为 序号
  记录["数据"] 为 数据
  返回 记录

段落 主:
  设 计数 为 0

  # ===== 判据自检：断言助手必须真能报错 =====
  设 计数 为 计数 + 1
  设 自检命中 为 假
  尝试:
    必等(1, 2, "自检")
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 自检命中 为 真
    如果 字符串包含(转字符串(错误), "断言失败") == 假:
      抛出 新建 错误("断言失败 #00：断言助手错误信息不符")
  如果 自检命中 == 假:
    抛出 新建 错误("断言失败 #00：断言助手未生效")
  通过("00")

  # ===== §0 判定安全整数：布尔/空/浮点/复合/负数/超限 一律拒收 =====
  设 计数 为 计数 + 1
  必等(判定安全整数(0), 真, "01a")
  必等(判定安全整数(42), 真, "01b")
  必等(判定安全整数(安全整数上限值), 真, "01c")
  通过("01")
  设 计数 为 计数 + 1
  必等(判定安全整数(安全整数上限值 + 1), 假, "02a")
  必等(判定安全整数(-5), 假, "02b")
  必等(判定安全整数(0.0), 假, "02c")
  必等(判定安全整数(1.5), 假, "02d")
  必等(判定安全整数(真), 假, "02e")
  必等(判定安全整数(空), 假, "02f")
  必等(判定安全整数([]), 假, "02g")
  必等(判定安全整数({}), 假, "02h")
  通过("02")
  设 计数 为 计数 + 1
  必等(判定安全整数("-0"), 假, "03a")
  必等(判定安全整数("-0.0"), 假, "03b")
  必等(判定安全整数("  -0  "), 假, "03c")
  必等(是负零("-0.00"), 真, "03d")
  必等(是负零("-1"), 假, "03e")
  必等(判定安全整数("12"), 真, "03f")
  必等(判定安全整数("1.5"), 假, "03g")
  必等(判定安全整数("abc"), 假, "03h")
  必等(判定安全整数("-7"), 假, "03i")
  通过("03")
  设 计数 为 计数 + 1
  必等(取格式版本({"格式版本": 3}), 3, "04a")
  必等(取格式版本({"版本": {"主": 5, "次": 2}}), 5, "04b")
  必等(取格式版本({"sessionFormatVersion": [7, 0]}), 7, "04c")
  通过("04")
  设 计数 为 计数 + 1
  必等(长度(已知类型集), 56, "05a")
  必等(长度(载荷模式表), 14, "05b")
  通过("05")

  # ===== §0 载荷模式：类型未知 / 载荷非字典 / 缺必选键 / 多余键 =====
  设 计数 为 计数 + 1
  必等(长度(校验载荷("unknown/x", {})), 1, "06a")
  必等(长度(校验载荷("user/message", [])), 1, "06b")
  必等(长度(校验载荷("user/message", {"content": ""})), 0, "06c")
  必等(长度(校验载荷("tool/call", {"tool": "bash"})), 1, "06d")
  必等(长度(校验载荷("tool/call", {"tool": "bash", "args": {}, "timeoutMs": 5})), 0, "06e")
  必等(长度(校验载荷("tool/call", {"tool": "bash", "args": {}, "foo": 1})), 1, "06f")
  通过("06")

  # ===== §1 创建日志：会话标识/格式版本/创建时间 校验 =====
  设 计数 为 计数 + 1
  设 命中1 为 假
  尝试:
    创建日志("", 1, 1)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中1 为 真
    如果 字符串包含(转字符串(错误), "会话标识") == 假:
      抛出 新建 错误("断言失败 #07：错误信息应含 会话标识")
  如果 命中1 == 假:
    抛出 新建 错误("断言失败 #07：空会话标识未抛错")
  通过("07")
  设 计数 为 计数 + 1
  设 命中2 为 假
  尝试:
    创建日志("s1", "x", 1)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中2 为 真
  如果 命中2 == 假:
    抛出 新建 错误("断言失败 #08：格式版本非整数未抛错")
  设 命中3 为 假
  尝试:
    创建日志("s1", 1, "y")
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中3 为 真
  如果 命中3 == 假:
    抛出 新建 错误("断言失败 #08：创建时间非整数未抛错")
  通过("08")

  # ===== §1 追加事件：严格 seq 递增 + 写入数 + 时间戳校验 =====
  设 日志 为 创建日志("s1", 2, 100)
  设 条1 为 追加事件(日志, "turn/start", {"turn": 0}, 101)
  设 条2 为 追加事件(日志, "user/message", {"content": "你好"}, 102)
  设 条3 为 追加事件(日志, "tool/call", {"tool": "bash", "args": {"cmd": "ls"}}, 103)
  必等(取项(条1, ["序号"], -1), 0, "09a")
  必等(取项(条2, ["序号"], -1), 1, "09b")
  必等(取项(条3, ["序号"], -1), 2, "09c")
  必等(取项(日志, ["末尾序号"], -1), 2, "09d")
  必等(取项(日志, ["写入数"], -1), 3, "09e")
  通过("09")
  设 计数 为 计数 + 1
  设 命中4 为 假
  尝试:
    追加事件(日志, "user/message", {"content": "x"}, -1)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中4 为 真
  如果 命中4 == 假:
    抛出 新建 错误("断言失败 #10：负时间戳未抛错")
  通过("10")
  设 计数 为 计数 + 1
  设 命中5 为 假
  尝试:
    追加事件(日志, "user/message", {"content": "x", "extra": 1}, 104)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中5 为 真
    如果 字符串包含(转字符串(错误), "多余键") == 假:
      抛出 新建 错误("断言失败 #11：错误信息应含 多余键")
  如果 命中5 == 假:
    抛出 新建 错误("断言失败 #11：多余键未抛错")
  通过("11")
  设 计数 为 计数 + 1
  设 命中6 为 假
  尝试:
    追加事件(日志, "unknown/x", {}, 105)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中6 为 真
    如果 字符串包含(转字符串(错误), "类型未知") == 假:
      抛出 新建 错误("断言失败 #12：错误信息应含 类型未知")
  如果 命中6 == 假:
    抛出 新建 错误("断言失败 #12：未知类型未抛错")
  通过("12")

  # ===== §1 写锁：互斥 + 释放 + 持锁追加 =====
  获取写锁(日志, "t1")
  必等(取项(日志, ["锁持有者"], 空) == "t1", 真, "13a")
  获取写锁(日志, "t1")
  设 计数 为 计数 + 1
  设 命中7 为 假
  尝试:
    获取写锁(日志, "t2")
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中7 为 真
    如果 字符串包含(转字符串(错误), "持有写锁") == 假:
      抛出 新建 错误("断言失败 #13：错误信息应含 持有写锁")
  如果 命中7 == 假:
    抛出 新建 错误("断言失败 #13：异持有者未抛错")
  通过("13")
  设 计数 为 计数 + 1
  设 命中8 为 假
  尝试:
    追加事件(日志, "user/message", {"content": "x"}, 106)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中8 为 真
    如果 字符串包含(转字符串(错误), "写锁") == 假:
      抛出 新建 错误("断言失败 #14：错误信息应含 写锁")
  如果 命中8 == 假:
    抛出 新建 错误("断言失败 #14：持锁追加未抛错")
  通过("14")
  设 计数 为 计数 + 1
  设 命中9 为 假
  尝试:
    释放写锁(日志, "t2")
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中9 为 真
  如果 命中9 == 假:
    抛出 新建 错误("断言失败 #15：错误释放者未抛错")
  释放写锁(日志, "t1")
  必等(取项(日志, ["锁持有者"], "x") == 空, 真, "15b")
  通过("15")

  # ===== §1 读取范围/全量 + 越界 =====
  设 段 为 读取范围(日志, 0, 1)
  必等(长度(段), 2, "16a")
  必等(取项(段[0], ["类型"], ""), "turn/start", "16b")
  设 全部 为 读取全部(日志)
  必等(长度(全部), 3, "16c")
  段[0]["类型"] 为 "改坏"
  必等(取项(日志["事件表"][0], ["类型"], ""), "turn/start", "16d")
  设 计数 为 计数 + 1
  设 命中10 为 假
  尝试:
    读取范围(日志, 0, 9)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中10 为 真
    如果 字符串包含(转字符串(错误), "止序号越界") == 假:
      抛出 新建 错误("断言失败 #17：错误信息应含 止序号越界")
  如果 命中10 == 假:
    抛出 新建 错误("断言失败 #17：止序号越界未抛错")
  设 命中11 为 假
  尝试:
    读取范围(日志, -1, 0)
    抛出 新建 错误("不应到达")
  捕获 异常 错误:
    设 命中11 为 真
  如果 命中11 == 假:
    抛出 新建 错误("断言失败 #17：负起序号未抛错")
  通过("17")

  # ===== §1 校验日志：合法日志 + 断点 + 多余键 =====
  设 校验1 为 校验日志(日志)
  必等(取项(校验1, ["有效"], 假), 真, "18a")
  必等(长度(取项(校验1, ["问题表"], [])), 0, "18b")
  设 坏日志 为 创建日志("s2", 2, 1)
  追加事件(坏日志, "turn/start", {"turn": 0}, 2)
  设 坏条 为 {}
  坏条["类型"] 为 "user/message"
  坏条["序号"] 为 5
  坏条["时间"] 为 6
  坏条["数据"] 为 {"content": "x", "多余": 1}
  列表追加(坏日志["事件表"], 坏条)
  坏日志["末尾序号"] 为 5
  设 校验2 为 校验日志(坏日志)
  必等(取项(校验2, ["有效"], 真), 假, "18c")
  必等(长度(取项(校验2, ["问题表"], [])) >= 2, 真, "18d")
  通过("18")

  # ===== §2 投影全部：四类状态折叠 =====
  设 全日志 为 创建日志("s3", 2, 1)
  追加事件(全日志, "turn/start", {"turn": 0}, 2)
  追加事件(全日志, "user/message", {"content": "你好"}, 3)
  追加事件(全日志, "assistant/message", {"content": []}, 4)
  追加事件(全日志, "system/message", {"content": "sys"}, 5)
  追加事件(全日志, "step/start", {"turn": 0}, 6)
  追加事件(全日志, "tool/call", {"tool": "bash", "args": {"cmd": "ls"}}, 7)
  追加事件(全日志, "tool/call", {"tool": "read", "args": {}}, 8)
  追加事件(全日志, "tool/result", {"tool": "bash", "status": "成功"}, 9)
  追加事件(全日志, "tool/result", {"tool": "ghost", "status": "成功"}, 10)
  追加事件(全日志, "approval/asked", {"id": "a1", "content": "允许?"}, 11)
  追加事件(全日志, "approval/decided", {"id": "a1", "decision": "已批准"}, 12)
  追加事件(全日志, "approval/decided", {"id": "zz", "decision": "已拒绝"}, 13)
  追加事件(全日志, "session/title", {"title": "标题"}, 14)
  追加事件(全日志, "model/selection", {"model": "m1"}, 15)
  追加事件(全日志, "todo/write", {"items": []}, 16)
  追加事件(全日志, "turn/end", {"turn": 0}, 17)
  追加事件(全日志, 交付接受类型, {"sessionId": "s3", "sessionFormatVersion": 2, "throughSeq": 15}, 18)
  设 全量 为 读取全部(全日志)
  设 状态 为 投影全部(全量, 0)
  设 计数 为 计数 + 1
  必等(长度(取项(状态, ["消息表"], [])), 3, "19a")
  必等(长度(取项(状态, ["工具记录表"], [])), 2, "19b")
  必等(长度(取项(状态, ["审批表"], [])), 1, "19c")
  必等(取项(状态, ["已投影至"], -1), 16, "19d")
  必等(取项(状态, ["投影数"], -1), 17, "19e")
  设 元 为 取项(状态, ["元数据"], {})
  必等(取项(元, ["轮次数"], -1), 1, "19f")
  必等(取项(元, ["步次数"], -1), 1, "19g")
  必等(取项(元, ["接受数"], -1), 1, "19h")
  必等(取项(元, ["未处理数"], -1), 1, "19i")
  必等(取项(元, ["孤儿结果数"], -1), 1, "19j")
  必等(取项(元, ["孤儿裁决数"], -1), 1, "19k")
  必等(取项(元, ["标题"], ""), "标题", "19l")
  必等(取项(元, ["模型"], ""), "m1", "19m")
  通过("19")
  设 计数 为 计数 + 1
  设 消息表 为 取项(状态, ["消息表"], [])
  必等(取项(消息表[0], ["角色"], ""), "用户", "20a")
  必等(取项(消息表[0], ["片段数"], -1), 1, "20b")
  必等(取项(消息表[1], ["角色"], ""), "助手", "20c")
  必等(取项(消息表[1], ["片段数"], -1), 0, "20d")
  必等(取项(消息表[2], ["角色"], ""), "系统", "20e")
  通过("20")
  设 计数 为 计数 + 1
  设 工具表 为 取项(状态, ["工具记录表"], [])
  必等(取项(工具表[0], ["工具名"], ""), "bash", "21a")
  必等(取项(工具表[0], ["状态"], ""), "成功", "21b")
  必等(取项(工具表[0], ["结果序号"], -1), 7, "21c")
  必等(取项(工具表[1], ["工具名"], ""), "read", "21d")
  必等(取项(工具表[1], ["状态"], ""), "进行中", "21e")
  必等(取项(工具表[1], ["结果序号"], "x") == 空, 真, "21f")
  设 审批表 为 取项(状态, ["审批表"], {})
  必等(取项(审批表["a1"], ["状态"], ""), "已批准", "21g")
  必等(字典包含键(审批表, "zz") == 假, 真, "21h")
  通过("21")
  设 计数 为 计数 + 1
  设 尾态 为 投影全部(全量, 12)
  必等(取项(尾态, ["投影数"], -1), 5, "22a")
  必等(长度(取项(尾态, ["消息表"], [])), 0, "22b")
  必等(取项(取项(尾态, ["元数据"], {}), ["接受数"], -1), 1, "22c")
  设 重建 为 投影全部(全量, 0)
  必等(取项(重建, ["投影数"], -1) == 取项(状态, ["投影数"], -1), 真, "22d")
  必等(长度(取项(重建, ["消息表"], [])) == 长度(取项(状态, ["消息表"], [])), 真, "22e")
  通过("22")

  # ===== §2 投影增量：幂等 + 续投 =====
  设 计数 为 计数 + 1
  投影增量(状态, 全量)
  必等(取项(状态, ["本次新增"], -1), 0, "23a")
  必等(取项(状态, ["投影数"], -1), 17, "23b")
  必等(长度(取项(状态, ["消息表"], [])), 3, "23c")
  必等(取项(状态, ["已投影至"], -1), 16, "23d")
  通过("23")
  设 计数 为 计数 + 1
  设 半态 为 空状态("s3", 2)
  设 半表 为 读取范围(全日志, 0, 11)
  投影增量(半态, 半表)
  必等(取项(半态, ["已投影至"], -1), 11, "24a")
