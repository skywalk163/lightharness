# test_异步PTY.light —— R69 子任务 69.2：事件循环驱动的异步 PTY 测试
#
# 验证：异步启动、输出回调、写入输入、完成回调、窗口缩放、优雅关闭。
# 运行：cd lightharness && python 运行.py examples/test_异步PTY.light
#
# 光明无闭包：回调全用顶层段落，共享状态走模块级 状态 表。

从 事件循环 导入 事件循环
从 异步PTY 导入 异步PTY
导入 time
导入 系统接口

# 模块级共享状态
设 状态 为 {"输出": b"", "输出计数": 0, "完成输出": b"", "完成触发": 假}

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言包含(文本, 片段, 标签):
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段 + "；实际=" + 文本[0:300]

# ---------- 平台适配（返回 bytes） ----------
段落 外壳名:
  如果 系统接口.是否Windows():
    返回 "cmd.exe"
  返回 "sh"

段落 换行字节:
  如果 系统接口.是否Windows():
    返回 b"\r\n"
  返回 b"\n"

# ---------- 顶层回调 ----------
段落 记输出(块):
  状态["输出"] 为 状态["输出"] + 块
  状态["输出计数"] 为 状态["输出计数"] + 1

段落 记完成(输出, 码):
  状态["完成输出"] 为 输出
  状态["完成触发"] 为 真

# 跑循环直到完成或超时（毫秒），超时则强制关闭
段落 跑到完成(环, 终端, 超时毫秒):
  设 截止 为 time.time() + 超时毫秒 / 1000.0
  当 真:
    如果 终端.已完成:
      环.运行一次(0)
      跳出
    如果 time.time() > 截止:
      # 超时强制关闭，触发收尾
      终端.关闭()
      环.运行一次(100)
      跳出
    环.运行一次(50)

段落 主:
  # ============================================================
  # 1) 基本异步 PTY：启动 + 写入 + 输出回调 + exit 完成回调
  # ============================================================
  状态["输出"] 为 b""
  状态["输出计数"] 为 0
  状态["完成输出"] 为 b""
  状态["完成触发"] 为 假
  设 环1 为 新建 事件循环()
  设 终端1 为 新建 异步PTY(环1)
  终端1.启动([外壳名()], ["宽度": 80, "高度": 24], 记完成, 记输出)
  # 等 shell 启动
  设 启动截止 为 time.time() + 5
  当 time.time() < 启动截止 且 终端1.是否存活() == 假:
    环1.运行一次(50)
  断言真(终端1.是否存活(), "启动后 PTY 存活")
  # 写入 echo 命令
  设 写ok 为 终端1.写输入(b"echo ASYNCPTY-OK" + 换行字节())
  断言真(写ok, "写入输入成功")
  # 轮询直到输出含标记（15s 预算）
  设 输出截止 为 time.time() + 15
  当 time.time() < 输出截止:
    环1.运行一次(50)
    如果 状态["输出"].decode("utf-8", "replace").包含("ASYNCPTY-OK"):
      跳出
  设 输出文本 为 状态["输出"].decode("utf-8", "replace")
  断言包含(输出文本, "ASYNCPTY-OK", "输出回调收到 echo 结果")
  断言真(状态["输出计数"] >= 1, "输出回调至少触发一次")
  # 发送 exit 让 shell 自然退出
  终端1.写输入(b"exit" + 换行字节())
  跑到完成(环1, 终端1, 15000)
  断言真(状态["完成触发"], "完成回调被触发")
  设 完成文本 为 状态["完成输出"].decode("utf-8", "replace")
  断言包含(完成文本, "ASYNCPTY-OK", "完成输出含全部内容")
  终端1.关闭()
  环1.关闭()

  # ============================================================
  # 2) 窗口缩放
  # ============================================================
  状态["完成触发"] 为 假
  设 环2 为 新建 事件循环()
  设 终端2 为 新建 异步PTY(环2)
  终端2.启动([外壳名()], ["宽度": 80, "高度": 24], 记完成, 空)
  设 启动截止2 为 time.time() + 5
  当 time.time() < 启动截止2 且 终端2.是否存活() == 假:
    环2.运行一次(50)
  设 缩放ok 为 终端2.设窗口大小(120, 40)
  断言真(缩放ok, "窗口缩放成功")
  终端2.写输入(b"exit" + 换行字节())
  跑到完成(环2, 终端2, 15000)
  终端2.关闭()
  环2.关闭()

  # ============================================================
  # 3) 关闭语义：关闭后 写输入/设窗口大小 返回假
  # ============================================================
  设 环3 为 新建 事件循环()
  设 终端3 为 新建 异步PTY(环3)
  终端3.启动([外壳名()], ["宽度": 80, "高度": 24], 记完成, 空)
  设 启动截止3 为 time.time() + 5
  当 time.time() < 启动截止3 且 终端3.是否存活() == 假:
    环3.运行一次(50)
  终端3.关闭()
  设 写关后 为 终端3.写输入(b"echo after-close\n")
  断言真(写关后 == 假, "关闭后写输入返回假")
  设 缩放关后 为 终端3.设窗口大小(100, 30)
  断言真(缩放关后 == 假, "关闭后设窗口大小返回假")
  环3.关闭()

  打印("test_异步PTY 全部断言通过（3 组 / 基本读写+完成回调+窗口缩放+关闭语义）")
