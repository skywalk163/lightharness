# test_R71_C_数值字面量.light —— R71任务C 测试
# 验证十六进制(0x)、二进制(0b)、八进制(0o)整数字面量支持
# 覆盖：大小写前缀、前导零、算术混合、比较混合、转字符串、文件权限位场景

段落 断言等于 接收 实际, 期望, 标签 = "":
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ✓ " + 标签

段落 断言真 接收 条件, 标签 = "":
  如果 条件 != 真:
    抛出 "断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件)
  打印 "  ✓ " + 标签

段落 主:
  打印 "===== R71-C 数值字面量测试 ====="

  # §1 十六进制（0x / 0X）
  打印 "--- §1 十六进制 ---"
  断言等于(0xFF, 255, "1a 0xFF 大写 → 255")
  断言等于(0xff, 255, "1b 0xff 小写 → 255")
  断言等于(0x1a2b, 6699, "1c 0x1a2b 混合 → 6699")
  断言等于(0XAB, 171, "1d 0XAB 大写X → 171")
  断言等于(0x00FF, 255, "1e 0x00FF 前导零 → 255")
  断言等于(0x0, 0, "1f 0x0 零值 → 0")
  断言等于(0x10, 16, "1g 0x10 → 16")
  断言等于(0xFFFFFF, 16777215, "1h 0xFFFFFF 24位全1 → 16777215")

  # §2 二进制（0b / 0B）
  打印 "--- §2 二进制 ---"
  断言等于(0b1010, 10, "2a 0b1010 → 10")
  断言等于(0B1111, 15, "2b 0B1111 大写B → 15")
  断言等于(0b0001, 1, "2c 0b0001 前导零 → 1")
  断言等于(0b0, 0, "2d 0b0 零值 → 0")
  断言等于(0b1, 1, "2e 0b1 → 1")
  断言等于(0b10000000, 128, "2f 0b10000000 → 128")
  断言等于(0b11111111, 255, "2g 0b11111111 8位全1 → 255")

  # §3 八进制（0o / 0O）—— L-161 缺陷关闭验证
  打印 "--- §3 八进制（L-161） ---"
  断言等于(0o644, 420, "3a 0o644 文件权限 → 420")
  断言等于(0o755, 493, "3b 0o755 文件权限 → 493")
  断言等于(0O777, 511, "3c 0O777 大写O → 511")
  断言等于(0o007, 7, "3d 0o007 前导零 → 7")
  断言等于(0o0, 0, "3e 0o0 零值 → 0")
  断言等于(0o10, 8, "3f 0o10 → 8")
  断言等于(0o777, 511, "3g 0o777 9位全1 → 511")

  # §4 与算术运算混合
  打印 "--- §4 算术混合 ---"
  断言等于(0xFF + 1, 256, "4a 0xFF + 1 → 256")
  断言等于(0b1010 + 0b0101, 15, "4b 0b1010 + 0b0101 → 15")
  断言等于(0o10 * 0o10, 64, "4c 0o10 * 0o10 → 64")
  断言等于(0x10 - 0b1000, 8, "4d 0x10 - 0b1000 → 8")
  断言等于(0xF0 / 0x10, 15.0, "4e 0xF0 / 0x10 → 15.0")
  断言等于(0b1111 % 0b11, 0, "4f 0b1111 % 0b11 → 0")

  # §5 与比较运算混合
  打印 "--- §5 比较混合 ---"
  断言真(0b1010 == 10, "5a 0b1010 == 10")
  断言真(0xFF == 255, "5b 0xFF == 255")
  断言真(0o644 == 420, "5c 0o644 == 420")
  断言真(0x10 > 0b1111, "5d 0x10 > 0b1111 (16 > 15)")
  断言真(0o10 < 0x10, "5e 0o10 < 0x10 (8 < 16)")
  断言真(0b1010 != 0b1011, "5f 0b1010 != 0b1011")

  # §6 转字符串后值正确
  打印 "--- §6 转字符串 ---"
  断言等于(转字符串(0xFF), "255", "6a 转字符串(0xFF) → \"255\"")
  断言等于(转字符串(0b1010), "10", "6b 转字符串(0b1010) → \"10\"")
  断言等于(转字符串(0o644), "420", "6c 转字符串(0o644) → \"420\"")

  # §7 三种进制等价性
  打印 "--- §7 进制等价性 ---"
  断言真(0xFF == 0b11111111, "7a 0xFF == 0b11111111")
  断言真(0o377 == 0xFF, "7b 0o377 == 0xFF (255)")
  断言真(0b1010 == 0o12, "7c 0b1010 == 0o12 (10)")
  断言真(0x10 == 0o20, "7d 0x10 == 0o20 (16)")

  # §8 作为函数参数和列表元素
  打印 "--- §8 函数参数与集合 ---"
  设 列表 为 [0xFF, 0b1010, 0o644]
  断言等于(列表[0], 255, "8a 列表元素 0xFF")
  断言等于(列表[1], 10, "8b 列表元素 0b1010")
  断言等于(列表[2], 420, "8c 列表元素 0o644")

  设 字典 为 {"hex": 0x10, "bin": 0b1000, "oct": 0o10}
  断言等于(字典["hex"], 16, "8d 字典值 0x10")
  断言等于(字典["bin"], 8, "8e 字典值 0b1000")
  断言等于(字典["oct"], 8, "8f 字典值 0o10")

  打印 "===== R71-C 全部测试通过 ====="

主()
