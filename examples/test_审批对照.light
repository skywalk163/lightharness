# test_审批对照.light —— 第12轮任务6：审批域对照收口（#73 未覆盖子包）
# 上游：packages/interaction/user-approval（index.ts 278 / invariant.ts 101 / types.ts 84）
#       + packages/interaction/tool-ask-user（index.ts 97）
# 覆盖：开轮判定（hasOpenTurn 倒序扫描）/ 裁决结果四闭集 / 词汇外归一 unavailable /
#       ask|never 策略切换与校验 / never 自动拒绝（分派前确定性）/ 无应答者 fail-closed /
#       审计对（approval/asked + approval/decided）形状与可选字段 / 开轮外抛错 /
#       never|ask 文案逐字 / 提问工具入参规范化（multi_select→multiSelect、可选缺省不落键）/
#       答案形状（selected 复制、custom 仅携带时出现）。
# 反跑判据：_antirun_approval.py（A never改ask / B 结果集少一种 / C 开轮判定改错 → 红）
# 运行：cd lightharness && python 运行.py examples/test_审批对照.light

从 审批 导入 审批管理器, 是开轮, 规范审批结果, 策略文案, 造提问调用, 规范提问答案
从 审批 导入 结果允许一次, 结果拒绝, 结果撤回, 结果不可用, 审批结果词汇
从 审批 导入 策略询问, 策略从不, 审批策略词汇, 从不文案, 询问文案, 提问工具描述

段落 核验(标签, 实际, 期望, 备注):
  如果 实际 != 期望:
    打印 "✗ 失败：" + 标签 + " 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际) + " (" + 备注 + ")"
    抛出 新建 错误("第12轮任务6 断言失败: " + 标签)
  打印 "✓ " + 标签 + " (" + 备注 + ")"
  返回 真

段落 核验真(标签, 条件, 备注):
  返回 核验(标签, 条件, 真, 备注)

段落 核验含(标签, 容器文本, 子串, 备注):
  设 命中 为 假
  设 n 为 长度(容器文本)
  设 m 为 长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 容器文本[i:(i+m)] == 子串:
      设 命中 为 真
    设 i 为 i + 1
  返回 核验真(标签, 命中, 备注)

段落 造轮开始(序号):
  返回 ["类型": "turn/start", "序号": 序号, "时间": 序号, "数据": 空]

段落 造轮结束(序号):
  返回 ["类型": "turn/end", "序号": 序号, "时间": 序号, "数据": 空]

段落 造用户消息事件(序号):
  返回 ["类型": "user/message", "序号": 序号, "时间": 序号, "数据": ["content": []]]

段落 制造应答者(返回值):
  段落 应答(工具名, 理由):
    返回 返回值
  返回 应答

段落 主:
  打印 "===== 第 12 轮任务 6：审批域对照收口 ====="

  # ---- §1 对标 invariant.ts:33/39 + index.ts:77-84 hasOpenTurn（倒序扫描）----
  设 空表 为 []
  核验真("1a 空日志无开轮", 是开轮(空表) == 假, "上游 return false")
  设 表甲 为 []
  列表追加(表甲, 造用户消息事件(0))
  列表追加(表甲, 造轮开始(1))
  核验真("1b turn/start 开轮", 是开轮(表甲) == 真, "倒序先遇 turn/start")
  设 表乙 为 []
  列表追加(表乙, 造轮开始(0))
  列表追加(表乙, 造轮结束(1))
  核验真("1c turn/end 闭合", 是开轮(表乙) == 假, "倒序先遇 turn/end")
  设 表丙 为 []
  列表追加(表丙, 造轮开始(0))
  列表追加(表丙, 造轮结束(1))
  列表追加(表丙, 造用户消息事件(2))
  列表追加(表丙, 造轮开始(3))
  核验真("1d 多轮取最近", 是开轮(表丙) == 真, "上一轮已闭合、本轮开启")

  # ---- §2 对标 types.ts:32 ApprovalOutcome 四结果闭集 ----
  核验("2a 词汇四值", 转字符串(审批结果词汇), "['allowed-once', 'rejected', 'cancelled', 'unavailable']", "上游 OUTCOMES")
  核验("2b 允许一次", 结果允许一次, "allowed-once", "唯一授权")
  核验("2c 不可用", 结果不可用, "unavailable", "fail-closed")
  核验真("2d 词汇内原样", 规范审批结果(结果允许一次) == "allowed-once", "合法返回透传")
  核验("2e 词汇外归一", 规范审批结果("sure"), 结果不可用, "rogue return → unavailable")
  核验("2f 空值归一", 规范审批结果(空), 结果不可用, "空亦 fail-closed")

  # ---- §3 对标 index.ts:60/63/92-97 策略 ask|never 与 setApprovalPolicy 校验 ----
  核验("3a 策略闭集", 转字符串(审批策略词汇), "['ask', 'never']", "上游 APPROVAL_POLICIES")
  设 管理器 为 新建 审批管理器()
  核验("3b 缺省 ask", 管理器.取审批策略(), 策略询问, "上游 Config default 'ask'")
  管理器.设置审批策略(策略从不)
  核验("3c 切换 never", 管理器.取审批策略(), 策略从不, "setApprovalPolicy 生效")
  管理器.设置审批策略(策略询问)
  核验("3d 切回 ask", 管理器.取审批策略(), 策略询问, "可逆切换")
  尝试:
    管理器.设置审批策略("always")
    核验真("3e 非法策略拒绝", 假, "词汇外应抛错")
  捕获 异常 错误:
    核验含("3e 非法策略拒绝", 转字符串(错误), 'approval policy must be one of "ask" or "never"', "上游 TypeError 文案")

  # ---- §4 对标 index.ts:207-226 request 流程（开轮前置 + 审计对 + 策略裁决）----
  设 开轮表 为 []
  列表追加(开轮表, 造轮开始(0))
  设 管理器乙 为 新建 审批管理器()
  # 4a never：分派前确定性拒绝，不落应答者
  管理器乙.设置审批策略(策略从不)
  设 哨兵应答 为 制造应答者(结果允许一次)
  设 审计包 为 管理器乙.请求审批审计(开轮表, "bash", 哨兵应答, "call_1", "需要执行命令")
  核验("4a never 自动拒绝", 审计包["结果"], 结果拒绝, "策略裁决先于分派（上游 decide:266）")
  # 4b 审计对：asked + decided 同 id、闭会话形状
  核验("4b asked 类型", 审计包["询问审计"]["类型"], "approval/asked", "types.ts:44")
  核验("4c asked id 对齐", 审计包["询问审计"]["数据"]["id"], 审计包["决定审计"]["数据"]["id"], "同一 id 配对")
  核验("4d asked 工具名", 审计包["询问审计"]["数据"]["工具名"], "bash", "types.ts:46")
  核验("4e asked callId", 审计包["询问审计"]["数据"]["callId"], "call_1", "可选字段携带")
  核验("4f asked reason", 审计包["询问审计"]["数据"]["reason"], "需要执行命令", "可选字段携带")
  核验("4g decided 类型", 审计包["决定审计"]["类型"], "approval/decided", "types.ts:55")
  核验("4h decided 结果", 审计包["决定审计"]["数据"]["结果"], "rejected", "闭集结果")
  # 4i ask + 无应答者 → fail-closed unavailable
  管理器乙.设置审批策略(策略询问)
  设 审计包乙 为 管理器乙.请求审批审计(开轮表, "写文件", 空, 空, 空)
  核验("4i 无应答者不可用", 审计包乙["结果"], 结果不可用, "waterfall 兜底 fail-closed")
  # 4j ask + 应答者允许 → allowed-once
  设 审计包丙 为 管理器乙.请求审批审计(开轮表, "bash", 制造应答者(结果允许一次), 空, 空)
  核验("4j 应答者放行", 审计包丙["结果"], 结果允许一次, "唯一授权路径")
  # 4k ask + 应答者异常返回 → 归一 unavailable
  设 审计包丁 为 管理器乙.请求审批审计(开轮表, "bash", 制造应答者("当然"), 空, 空)
  核验("4k 词汇外归一", 审计包丁["结果"], 结果不可用, "rogue answerer fail-closed")
  # 4l 开轮外 → 抛错（上游 index.ts:209-215）
  设 无轮表 为 []
  列表追加(无轮表, 造用户消息事件(0))
  尝试:
    设 占位四 为 管理器乙.请求审批审计(无轮表, "bash", 空, 空, 空)
    核验真("4l 开轮外抛错", 假, "无开轮应抛错")
  捕获 异常 错误:
    核验含("4l 开轮外抛错", 转字符串(错误), "outside an open turn", "上游 request 前置文案")

  # ---- §5 对标 index.ts:66-68 文案（逐字对齐）----
  核验("5a never 文案", 策略文案(策略从不), 从不文案, "上游 NEVER_SENTENCE")
  核验("5b ask 文案", 策略文案(策略询问), 询问文案, "上游 ASK_SENTENCE")
  核验含("5c never 文案要点", 从不文案, "do not request sandbox escalation", "禁沙箱提权提示")
  核验含("5d ask 文案要点", 询问文案, "fails closed", "无应答者 fail-closed 语义")

  # ---- §6 对标 tool-ask-user index.ts 提问工具形状 ----
  核验真("6a 工具描述", 长度(提问工具描述) > 190, "上游 description 逐字（长度 " + 转字符串(长度(提问工具描述)) + "）")
  核验含("6a2 描述要点", 提问工具描述, "each with a stable id that will be echoed in the answer", "多问题+id 回显语义")
  设 问题表 为 []
  列表追加(问题表, ["id": "q1", "question": "继续吗？", "header": "确认", "options": [["label": "是"]], "multi_select": 真])
  列表追加(问题表, ["id": "q2", "question": "原因？"])
  设 调用 为 造提问调用(问题表)
  核验("6b 首问形状", 转字符串(调用[0]["multiSelect"]), "True", "multi_select → multiSelect")
  核验("6c header 透传", 调用[0]["header"], "确认", "可选字段携带")
  核验真("6d 次问无可选键", (字典包含键(调用[1], "header") == 假) 且 (字典包含键(调用[1], "options") == 假), "缺省不落键（上游条件展开）")
  核验真("6e 次问无 multiSelect", 字典包含键(调用[1], "multiSelect") == 假, "同上")
  # 答案形状：selected 复制、custom 仅携带时出现
  设 答案表 为 []
  列表追加(答案表, ["id": "q1", "selected": ["是"], "custom": "备注"])
  列表追加(答案表, ["id": "q2", "selected": ["A", "B"]])
  设 输出 为 规范提问答案(答案表)
  核验("6f answers 包裹", 转字符串(字典包含键(输出, "answers")), "True", "上游 output.schema answers 必填")
  核验("6g 首案 custom", 输出["answers"][0]["custom"], "备注", "custom 仅携带时出现")
  核验真("6h 次案无 custom", 字典包含键(输出["answers"][1], "custom") == 假, "缺省不落键")
  核验("6i 多选保留", 转字符串(列表长度(输出["answers"][1]["selected"])), "2", "selected 复制")

  打印 "===== 第 12 轮任务 6：审批域对照收口全部通过 ====="
