# -*- coding: utf-8 -*-
# R20 任务1（L-084 / L-092 / L-137 / 词法嵌入最大匹配）关键字前缀标识符词法回归套件
#
# 覆盖「以语句关键字开头 / 含关键字 / 词尾为关键字」的标识符在表达式与定义上下文
# 被词法器正确识别为单个 IDENTIFIER（而非被切碎），同时确认合法语句关键字
# （设 X 为 Y / 返回 Y / 甲加乙 中缀）不被误并。
#
# 验收：本文件被 test_回归.py 全量门禁收集，必须 rc==0。
段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

# ── 1. 以语句关键字开头的函数名（去重占位 / 作用域匹配）──
段落 去重占位(列表):
    设 结果 为 []
    遍历 项 之 列表:
        如果 列表包含(结果, 项) == 假:
            列表追加(结果, 项)
    返回 结果

段落 作用域匹配(名称):
    返回 名称

# ── 2. 含关键字的函数名（排序函数 / 遍历器 / 筛选器 / 求和函数 / 读取器 / 输出流）──
段落 排序函数(列表):
    返回 排序(列表)

段落 遍历器(列表):
    设 计数 为 0
    遍历 项 之 列表:
        设 计数 为 计数 加 1
    返回 计数

段落 筛选器(列表, 阈值):
    设 结果 为 []
    遍历 项 之 列表:
        如果 项 大于 阈值:
            列表追加(结果, 项)
    返回 结果

段落 求和函数(列表):
    设 总和 为 0
    遍历 项 之 列表:
        设 总和 为 总和 加 项
    返回 总和

段落 读取器(字典, 键):
    返回 字典获取(字典, 键, 空)

段落 输出流(文本):
    返回 文本

# ── 3. 运算符动词内嵌函数名（删除属性：除 是运算符动词，必须并入标识符）──
段落 删除属性(对象, 键):
    字典设置(对象, 键, "已删除")
    返回 字典获取(对象, 键)

# ── 4. 词尾为 为/返回/尝试 且后跟值起始：必须切出赋值/返回关键字（不并入）──
段落 合并为(前缀):
    设 合并 为 {}
    字典设置(合并, 前缀, 真)
    返回 合并

# ── 5. 词尾为 为/返回/尝试 且后跟 ( ：是函数名，受保护不切 ──
段落 头版本为(头, 主体):
    返回 连接字符串([头, 主体])

段落 结算被终止尝试(轮次, 步骤):
    返回 连接字符串([轮次, 步骤])

段落 内层返回(判断):
    返回 判断

# ── 6. 关键字在词中 / 词尾后跟非值起始：仍合并 ──
段落 返回表(行):
    返回 行

段落 尝试记录(事件):
    返回 事件

段落 为字(单位):
    返回 单位

段落 行为(动作):
    返回 动作

段落 末位行为(动作):
    返回 动作

# ── 7. 入口：真实调用与断言 ──
段落 主:
    设 输入 为 [3, 1, 3, 2, 1]
    断言相等(去重占位(输入), [3, 1, 2], "去重占位")
    断言相等(作用域匹配("事件A"), "事件A", "作用域匹配")
    断言相等(排序函数(输入), [1, 1, 2, 3, 3], "排序函数")
    断言相等(遍历器(输入), 5, "遍历器")
    断言相等(筛选器(输入, 2), [3, 3], "筛选器")
    断言相等(求和函数(输入), 10, "求和函数")
    设 字典A 为 {"共享": "原值"}
    断言相等(删除属性(字典A, "共享"), "已删除", "删除属性")
    断言相等(读取器(字典A, "共享"), "已删除", "读取器")
    设 合并结果 为 合并为("键X")
    断言相等(合并结果, {"键X": 真}, "合并为")
    断言相等(头版本为("v", "主体"), "v主体", "头版本为")
    断言相等(结算被终止尝试("r1", "s2"), "r1s2", "结算被终止尝试")
    断言相等(内层返回(真), 真, "内层返回")
    断言相等(返回表([1, 2]), [1, 2], "返回表")
    断言相等(尝试记录("e"), "e", "尝试记录")
    断言相等(为字("米"), "米", "为字")
    断言相等(行为("跳"), "跳", "行为")
    断言相等(末位行为("跑"), "跑", "末位行为")
    断言相等(输出流("hello"), "hello", "输出流")

    # ── 8. 合法语句关键字不被误并 ──
    设 甲 为 10
    设 乙 为 20
    断言相等(甲加乙, 30, "甲加乙中缀")
    设 丙 为 甲加乙
    断言相等(丙, 30, "甲加乙赋值")
    返回 真
