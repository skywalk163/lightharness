从 提示模板 导入 插值, 渲染提示, 渲染上下文段, 连接上下文段, 渲染上下文快照, 校验工具顺序, 排序工具
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))
段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)
段落 主:
  # ---- 插值：严格 {{变量}} 替换 ----
  断言相等(插值("Hello {{name}}!", {"name": "World"}, "section", "t"), "Hello World!", "简单替换")
  断言相等(插值("a{{x}}b{{y}}c", {"x": "1", "y": "2"}, "section", "t"), "a1b2c", "多次替换")
  断言相等(插值("无变量文本", {}, "section", "t"), "无变量文本", "无变量原样")
  断言相等(插值("值={{v}}", {"v": ""}, "section", "t"), "值=", "空字符串值正常渲染")
  检查抛错("未知变量抛错", 段_未知)
  检查抛错("畸形空格名抛错", 段_空格名)
  检查抛错("畸形花括号抛错", 段_花括号)
  检查抛错("值缺失抛错", 段_值缺)
  断言相等(插值("a {{ b", {}, "section", "t"), "a {{ b", "孤立 {{ 视为原文")
  # ---- renderPrompt：丢弃空段、双换行连接 ----
  设 装配1 为 {"sections": [{"name": "a", "text": "X{{v}}Y"}, {"name": "e", "text": ""}, {"name": "b", "text": "plain"}], "contexts": [], "tools": [], "variables": {"v": "Z"}}
  断言相等(渲染提示(装配1), "XZY\n\nplain", "渲染提示丢弃空段并连接")
  # ---- 上下文快照 ----
  设 装配2 为 {"sections": [], "contexts": [{"name": "c1", "text": "ctx {{v}}"}], "tools": [], "variables": {"v": "V"}}
  断言相等(渲染上下文段(装配2), [{"name": "c1", "text": "ctx V"}], "渲染上下文段")
  断言相等(渲染上下文快照(装配2), "Current runtime context. This snapshot supersedes earlier runtime-context snapshots.\n\nctx V", "渲染上下文快照带信封")
  设 装配3 为 {"sections": [], "contexts": [{"name": "c1", "text": ""}], "tools": [], "variables": {}}
  断言相等(渲染上下文快照(装配3), "", "空上下文快照返回空")
  # ---- 校验工具顺序 ----
  断言相等(校验工具顺序(空), 空, "未配置顺序返回空")
  断言相等(校验工具顺序(["<unlisted-tools>"]), ["<unlisted-tools>"], "含 rest 标记合法")
  检查抛错("重复名抛错", 段_重复名)
  检查抛错("缺 rest 抛错", 段_缺rest)
  # ---- 排序工具 ----
  设 工具表 为 [{"name": "b"}, {"name": "a"}, {"name": "c"}]
  断言相等(排序工具(工具表, 空, {"a": 真, "b": 真, "c": 真}), [{"name": "a"}, {"name": "b"}, {"name": "c"}], "无顺序按字典序")
  设 工具表2 为 [{"name": "b"}, {"name": "a"}, {"name": "c"}]
  断言相等(排序工具(工具表2, ["c", "<unlisted-tools>", "a"], {"a": 真, "b": 真, "c": 真}), [{"name": "c"}, {"name": "b"}, {"name": "a"}], "rest 处插入未列工具")
  检查抛错("未知工具名抛错", 段_未知工具)
  设 工具表3 为 [{"name": "<unlisted-tools>"}]
  检查抛错("保留名抛错", 段_保留名)
  打印 "--- 提示模板纯逻辑核心（模块43）测试通过 ---"
段落 段_未知:
  插值("{{x}}", {}, "section", "t")
段落 段_空格名:
  插值("{{a b}}", {"a b": ""}, "section", "t")
段落 段_花括号:
  插值("{{a}b}}", {}, "section", "t")
段落 段_值缺:
  插值("{{x}}", {"x": 空}, "section", "t")
段落 段_重复名:
  校验工具顺序(["a", "a"])
段落 段_缺rest:
  校验工具顺序(["a"])
段落 段_未知工具:
  排序工具([{"name": "b"}], ["z", "<unlisted-tools>"], {"b": 真})
段落 段_保留名:
  排序工具([{"name": "<unlisted-tools>"}], 空, {"<unlisted-tools>": 真})
主()
