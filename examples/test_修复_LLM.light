# test_修复_LLM.light —— 第9轮任务2 修复回归（T3-D1 totalTokens / T3-D2 消息脱钩）
从 客户端 导入 翻译用量
从 消息 导入 造文本块, 造用户消息, 造用户消息带来源, 造助手消息, 造助手消息带回放, 造工具结果消息, 造系统消息, 拷贝内容块表

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ---- T3-D1：翻译用量 补 totalTokens = prompt_tokens + completion_tokens（原始合计，含缓存命中）----
  # 上游语义见 llm-deepseek/src/translate.ts:58-68，totalTokens 是原始合计，不等于「未缓存输入+输出」
  设 用1 为 翻译用量(["prompt_tokens": 100, "completion_tokens": 20, "prompt_cache_hit_tokens": 40])
  断言等于(用1.包含("totalTokens"), 真, "T3-D1 用量1 含 totalTokens")
  断言等于(用1["totalTokens"], 120, "T3-D1 用量1 totalTokens=100+20=120（含缓存命中，≠输入+输出=80）")
  断言等于(用1["输入"], 60, "T3-D1 用量1 输入=100-40")
  断言等于(用1["输出"], 20, "T3-D1 用量1 输出=20")
  断言等于(用1["缓存读"], 40, "T3-D1 用量1 缓存读=40")

  设 用2 为 翻译用量(["prompt_tokens": 50, "completion_tokens": 5])
  断言等于(用2.包含("totalTokens"), 真, "T3-D1 用量2 含 totalTokens")
  断言等于(用2["totalTokens"], 55, "T3-D1 用量2 totalTokens=50+5=55")
  断言等于(用2.包含("缓存读"), 假, "T3-D1 用量2 无缓存字段")

  # 推理 token 桶独立于 totalTokens（totalTokens = prompt+completion）
  设 用3 为 翻译用量(["prompt_tokens": 10, "completion_tokens": 3, "completion_tokens_details": ["reasoning_tokens": 2]])
  断言等于(用3["totalTokens"], 13, "T3-D1 用量3 totalTokens=10+3=13（与推理桶无关）")
  断言等于(用3["推理"], 2, "T3-D1 用量3 推理桶=2")

  # ---- T3-D2：消息构造深拷贝脱钩（光明无深拷贝，绕法逐块拷贝，登记 L-083）----
  # 用户消息：调用方改原 content 列表 / 原块字段，均不影响已构造消息
  设 原内容 为 [造文本块("你好")]
  设 用户 为 造用户消息(原内容)
  列表追加(原内容, 造文本块("污染"))
  断言等于(长度(用户["content"]), 1, "T3-D2 用户消息：追加原列表不影响已构造消息")
  断言等于(用户["content"][0]["text"], "你好", "T3-D2 用户消息：原块文本未被污染")

  设 原内容2 为 [造文本块("原文")]
  设 用户2 为 造用户消息(原内容2)
  原内容2[0]["text"] 为 "被改"
  断言等于(用户2["content"][0]["text"], "原文", "T3-D2 用户消息：改原块字段不影响已构造消息")

  # 用户消息带来源 同样脱钩
  设 原来源 为 [造文本块("x")]
  设 用户3 为 造用户消息带来源(原来源, ["kind": "user"])
  列表追加(原来源, 造文本块("y"))
  断言等于(长度(用户3["content"]), 1, "T3-D2 用户消息带来源：脱钩")

  # 助手消息
  设 原助手 为 [造文本块("回答")]
  设 助手 为 造助手消息(原助手, "p", "m")
  列表追加(原助手, 造文本块("x"))
  断言等于(长度(助手["content"]), 1, "T3-D2 助手消息：追加原列表不影响")
  断言等于(助手["source"]["kind"], "model", "T3-D2 助手消息：source.kind=model")

  # 助手消息带回放
  设 原助手2 为 [造文本块("r")]
  设 助手2 为 造助手消息带回放(原助手2, "p", "m", ["tag": "replay"])
  列表追加(原助手2, 造文本块("z"))
  断言等于(长度(助手2["content"]), 1, "T3-D2 助手消息带回放：脱钩")
  断言等于(助手2["source"]["replayState"]["tag"], "replay", "T3-D2 助手消息带回放：replayState 保留")

  # 工具结果消息：内层 content 也脱钩
  设 原结果 为 [造文本块("结果")]
  设 工具结果 为 造工具结果消息("c1", 原结果, 假)
  列表追加(原结果, 造文本块("x"))
  断言等于(长度(工具结果["content"]), 1, "T3-D2 工具结果消息：外层[块]脱钩")
  断言等于(长度(工具结果["content"][0]["content"]), 1, "T3-D2 工具结果消息：tool-result 块 content 脱钩")

  # 造系统消息：content 本地构造（空文本 → []，非空 → 单 text 块）
  设 系统 为 造系统消息("你是助手", "system-prompt")
  断言等于(长度(系统["content"]), 1, "T3-D2 系统消息：非空→单 text 块")
  断言等于(系统["content"][0]["text"], "你是助手", "T3-D2 系统消息文本")

  # 拷贝内容块表 独立验证（任意块形状逐键拷贝，且与原表/原块脱钩）
  设 表 为 [["type": "text", "text": "a"], ["type": "tool-call", "id": "k", "name": "n", "arguments": "{}"]]
  设 副本 为 拷贝内容块表(表)
  断言等于(长度(副本), 2, "T3-D2 拷贝：长度一致")
  列表追加(表, ["type": "text", "text": "b"])
  断言等于(长度(副本), 2, "T3-D2 拷贝：改原表不影响副本")
  表[0]["text"] 为 "改了"
  断言等于(副本[0]["text"], "a", "T3-D2 拷贝：改原块字段不影响副本")

  打印 "--- 第9轮任务2 LLM 修复回归 通过 ---"

主()
