# test_R40_会话存储.light —— 第 40 轮 任务 2 判据：宿主底座加固
#
# 上游：deepseek-harness 0.1.5-rc.2（会话持久化会话存储）
# 本轮新增/加固点：
#   1) os.replace Windows 竞态修复（退避重试：0.1/0.2/0.4/0.8/1.6 秒）
#   2) test_会话存储 残留放大清理（本测试显式清理自身残留，并断言清理生效）
#   3) AbortSignal 占位评估（只出结论，不改代码；见 _task2 交付报告）
#
# 运行：cd lightharness && python 运行.py examples/test_R40_会话存储.light
# 覆盖：
#   #00 断言助手自检
#   #01 正常写入路径（回归，5 次追加 + 读取 + 删除）
#   #02 重复写入不覆盖（追加模式实证）
#   #03 保存索引替换默认路径成功（os.replace 正常）
#   #04 保存索引替换失败（缺目录）→ 抛错且包含重试次数
#   #05 多次保存索引连续正常（幂等）
#   #06 会话删除清理
#   #07 残留放大：多次新建会话后完整清理，断言 sessions 目录清空
#   #08 新实例重建索引不残留
#   #09 AbortSignal 占位：注册表 signal 留空占位（登记）
#   #10 最终清理：sessions 目录清空断言
# 判据：rc=0

从 会话存储 导入 会话存储, 生成会话标识, 生成标题
从 会话存储 导入 保存索引替换, 保存索引替换函数, 保存索引重试间隔, 保存索引最大重试
从 系统提示 导入 建系统提示注册表, 注册节, 注册变量, 组装系统提示
从 JSON 导入 序列化JSON, 解析JSON
从 文件系统 导入 创建目录, 目录存在, 文件存在, 读取文件, 写入文件, 删除文件, 删除目录, 路径连接
导入 os
导入 time

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败（为假）: " + 标签

段落 断言假 接收 条件, 标签:
  如果 条件 == 真:
    抛出 "断言失败（应为假）: " + 标签

# 清理辅助：把指定会话目录下的所有文件删除
段落 清空会话目录 接收 目录:
  如果 目录存在(目录) == 假:
    返回 真
  设 清单 为 os.listdir(目录)
  遍历 名 之 清单:
    尝试:
      删除文件(路径连接(目录, 名))
    捕获 异常 ee:
      设 忽略 为 空
  返回 真

段落 主:
  设 计数 为 0

  # ---- 准备：临时根目录 ----
  设 基 为 当前目录()
  设 根 为 路径连接(基, "_e2_R40_会话存储_tmp")
  # 若上次失败留下残留，先清理
  尝试:
    如果 目录存在(路径连接(根, "sessions")):
      清空会话目录(路径连接(根, "sessions"))
      删除目录(路径连接(根, "sessions"))
  捕获 异常 e:
    设 忽略 为 空
  如果 目录存在(根) == 假:
    创建目录(根)

  # ===== #00 断言助手自检 =====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 e:
    设 自检报错 为 真
  断言真(自检报错, "#00")
  写 "OK #00\n"

  # ===== #01 正常写入路径（回归） =====
  设 计数 为 计数 + 1
  设 存储 为 新建 会话存储(根)
  设 会话目录 为 存储.取会话目录()
  断言真(目录存在(会话目录), "#01 sessions 目录自动创建")
  断言真(文件存在(路径连接(会话目录, "_index.json")), "#01 索引文件创建")

  设 s1 为 存储.新建会话("R40 会话")
  设 id1 为 s1["id"]
  断言真(长(id1) > 0, "#01 新建会话返回 id")
  断言相等(存储.取元数据(id1)["消息数"], 0, "#01 初始消息数 0")
  断言真(文件存在(存储.取会话文件(id1)), "#01 JSONL 落盘")

  存储.追加消息(id1, {"角色": "user", "内容": "hello"})
  存储.追加消息(id1, {"角色": "assistant", "内容": "hi there"})
  断言相等(存储.取元数据(id1)["消息数"], 2, "#01 追加2条后消息数=2")
  设 历史 为 存储.获取会话(id1)
  断言相等(长(历史), 2, "#01 会话历史 2 条")
  断言相等(历史[0]["内容"], "hello", "#01 首条内容")
  写 "OK #01\n"

  # ===== #02 重复写入不覆盖（追加模式实证） =====
  设 计数 为 计数 + 1
  设 追加前长度 为 文件大小(存储.取会话文件(id1))
  存储.追加消息(id1, {"角色": "user", "内容": "again"})
  存储.追加消息(id1, {"角色": "user", "内容": "one more"})
  设 追加后长度 为 文件大小(存储.取会话文件(id1))
  断言真(追加后长度 > 追加前长度, "#02 追加后文件变大")
  设 历史2 为 存储.获取会话(id1)
  断言相等(长(历史2), 4, "#02 4 条消息全在")
  断言相等(历史2[0]["内容"], "hello", "#02 首条未被覆盖")
  写 "OK #02\n"

  # ===== #03 保存索引替换默认路径成功 =====
  设 计数 为 计数 + 1
  # 用当前索引文件测试：把临时路径（写入会话 id 内容）rename 到 _index.json.bak
  设 索引备份 为 路径连接(会话目录, "_index.json.bak")
  设 临时备份 为 路径连接(会话目录, "_index.json.bak.tmp")
  设 索引内容 为 读取文件(路径连接(会话目录, "_index.json"))
  写入文件(临时备份, 索引内容)
  断言相等(保存索引替换(临时备份, 索引备份), 真, "#03 默认路径成功返回真")
  断言真(文件存在(索引备份), "#03 目标文件存在")
  断言假(文件存在(临时备份), "#03 临时文件已消失")
  # 清理备份
  删除文件(索引备份)
  写 "OK #03\n"

  # ===== #04 保存索引替换失败 → 抛错且含重试次数 =====
  设 计数 为 计数 + 1
  # 构造失败：目标路径的父目录不存在
  设 缺失目录 为 路径连接(根, "_不存在目录_")
  断言假(目录存在(缺失目录), "#04 目标父目录不存在（前提）")
  设 缺失临时 为 路径连接(会话目录, "_缺失.tmp")
  写入文件(缺失临时, "{}")
  设 缺失目标 为 路径连接(缺失目录, "_index.json")
  设 抛错 为 假
  设 错误消息 为 ""
  尝试:
    保存索引替换(缺失临时, 缺失目标, 保存索引替换函数, [0, 0, 0, 0, 0], 5)
  捕获 异常 e:
    设 抛错 为 真
    错误消息 为 转字符串(e)
  断言真(抛错, "#04 缺目录时应抛错")
  断言真(错误消息.查找("重试") >= 0, "#04 错误消息含『重试』")
  断言真(错误消息.查找("5") >= 0, "#04 错误消息含失败次数『5』")
  写 "OK #04\n"

  # ===== #05 多次保存索引连续正常（幂等） =====
  设 计数 为 计数 + 1
  存储.追加消息(id1, {"角色": "user", "内容": "幂等1"})
  存储.追加消息(id1, {"角色": "user", "内容": "幂等2"})
  存储.追加消息(id1, {"角色": "user", "内容": "幂等3"})
  存储.追加消息(id1, {"角色": "user", "内容": "幂等4"})
  存储.追加消息(id1, {"角色": "user", "内容": "幂等5"})
  断言相等(存储.取元数据(id1)["消息数"], 9, "#05 5 次追加后消息数=9")
  写 "OK #05\n"

  # ===== #06 会话删除清理 =====
  设 计数 为 计数 + 1
  设 删除结果 为 存储.删除会话(id1)
  断言相等(删除结果["删除"], id1, "#06 返回被删 id")
  断言真(文件存在(存储.取会话文件(id1)) == 假, "#06 JSONL 文件已删除")
  设 列表 为 存储.列表会话()
  断言相等(长(列表), 0, "#06 索引条目已清空")
  写 "OK #06\n"

  # ===== #07 残留放大：多次新建会话后完整清理 =====
  设 计数 为 计数 + 1
  设 ids 为 []
  设 i 为 0
  当 i < 10:
    设 s 为 存储.新建会话("批 " + 转字符串(i))
    ids.追加(s["id"])
    设 i 为 i + 1
  断言相等(长(ids), 10, "#07 批量创建 10 会话")
  断言相等(长(存储.列表会话()), 10, "#07 索引 10 条目")
  # 完整清理
  遍历 id 之 ids:
    存储.删除会话(id)
  断言相等(长(存储.列表会话()), 0, "#07 清理后索引为空")
  # 确认 sessions 目录内无残留 JSONL
  设 目录清单 为 os.listdir(会话目录)
  设 残留数 为 0
  遍历 名 之 目录清单:
    如果 名.查找(".jsonl") >= 0:
      设 残留数 为 残留数 + 1
  断言相等(残留数, 0, "#07 无 JSONL 残留")
  写 "OK #07\n"

  # ===== #08 新实例重建索引不残留 =====
  设 计数 为 计数 + 1
  设 存储2 为 新建 会话存储(根)
  断言相等(长(存储2.列表会话()), 0, "#08 新实例索引空")
  设 索引原文 为 读取文件(路径连接(存储2.取会话目录(), "_index.json"))
  设 索引回读 为 解析JSON(索引原文)
  断言相等(长(索引回读["会话"]), 0, "#08 索引回读一致")
  设 有临时 为 文件存在(路径连接(存储2.取会话目录(), "_index.json.tmp"))
  断言假(有临时, "#08 无 tmp 残留")
  写 "OK #08\n"

  # ===== #09 AbortSignal 占位（登记，不改代码） =====
  设 计数 为 计数 + 1
  # R39 系统提示组装上下文 signal 字段留空占位
  # 验证：注册表结构可正常工作，signal 字段不引入副作用
  设 提示表 为 建系统提示注册表()
  注册变量(提示表, "who", "carol")
  注册节(提示表, "s1", 100, "Hello {{who}}")
  设 装配 为 组装系统提示(提示表)
  断言相等(长(装配["节列表"]), 1, "#09 组装 1 节正常")
  断言相等(装配["节列表"][0]["文本"], "Hello {{who}}", "#09 节文本原样")
  写 "OK #09\n"

  # ===== #10 最终清理：sessions 目录清空断言 =====
  设 计数 为 计数 + 1
  清空会话目录(会话目录)
  删除目录(会话目录)
  尝试:
    删除目录(根)
  捕获 异常 ee:
    设 忽略 为 空
  断言假(目录存在(根), "#10 临时根目录已清理")
  写 "OK #10\n"

  打印 "--- 第40轮任务2 会话存储加固（竞态+残留+占位评估） 通过 ---"
  打印 "共 " + 转字符串(计数) + " 组"
  返回 真

主()
