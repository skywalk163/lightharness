# test_钩子_接线.light —— 第6轮 任务B #259 宿主钩子触发出口 判据
# 运行：python 运行.py examples/test_钩子_接线.light
# 判据：接桩出口（经宿主触发钩子）在宿主桩 mock 下返回预期形状，三域可触发；
#       纯逻辑段（三事件域总线 + message/pause/resume 决策面）回归绿由 test_钩子.light 承担。

从 钩子 导入 经宿主触发钩子, 是宿主钩子域, 新建钩子系统, 造钩子事件
从 宿主IO 导入 造宿主桩, 造成功结果, 造失败结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主桩能力：宿主钩子 -> 回显参数
段落 宿主钩子回显(参数字典):
  返回 参数字典

# 本地总线回归锚点收集器（顶层段落；计数用模块级槽承载）
设 收到 为 [0]

段落 收集(上下文):
  全局 收到
  设 收到[0] 为 收到[0] + 1
  返回 空

段落 主:
  # ---- 1. 三域词表判定 ----
  断言真(是宿主钩子域("PreToolUse"), "1a PreToolUse 在域表")
  断言真(是宿主钩子域("PostToolUse"), "1b PostToolUse 在域表")
  断言真(是宿主钩子域("Stop"), "1c Stop 在域表")
  断言真(是宿主钩子域("session") == 假, "1d 本地域不在宿主域表")

  # ---- 2. 经宿主触发钩子：三域各触发一次，事件形状与 发布 一致 ----
  设 桩 为 造宿主桩({"宿主钩子": 宿主钩子回显})
  设 r1 为 经宿主触发钩子(桩, "PreToolUse", "tools/pre-execute", {"名": "bash"}, 空)
  断言真(r1["成功"], "2a PreToolUse 触发成功")
  断言相等(r1["数据"]["事件"]["域"], "PreToolUse", "2b 域透传")
  断言相等(r1["数据"]["事件"]["类型"], "tools/pre-execute", "2c 时机透传")
  断言相等(r1["数据"]["事件"]["数据"]["名"], "bash", "2d 数据透传")
  设 r2 为 经宿主触发钩子(桩, "PostToolUse", "tools/post-execute", {"名": "读文件"}, 空)
  断言真(r2["成功"], "2e PostToolUse 触发成功")
  设 r3 为 经宿主触发钩子(桩, "Stop", "agent/turn-stopping", {"轮": 1}, 空)
  断言真(r3["成功"], "2f Stop 触发成功")
  断言相等(列表长度(桩["调用日志"]), 3, "2g 三次调用留痕")

  # ---- 3. 会话对象透传 ----
  设 会话 为 {"标识": "s1"}
  设 r4 为 经宿主触发钩子(桩, "PreToolUse", "tools/pre-execute", {}, 会话)
  断言相等(r4["数据"]["会话"]["标识"], "s1", "3a 会话透传")

  # ---- 4. 非宿主域 -> INVALID_ARGUMENT（本地总线域不走宿主触发） ----
  设 r5 为 经宿主触发钩子(桩, "session", "session/event", {}, 空)
  断言真(是失败结果(r5), "4a 本地域须失败")
  断言相等(r5["错误码"], "INVALID_ARGUMENT", "4b 错误码")

  # ---- 5. 宿主桩缺能力 -> UNSUPPORTED_OPERATION（不静默） ----
  设 r6 为 经宿主触发钩子(造宿主桩({}), "PreToolUse", "tools/pre-execute", {}, 空)
  断言真(是失败结果(r6), "5a 缺能力须失败")
  断言相等(r6["错误码"], "UNSUPPORTED_OPERATION", "5b 错误码")

  # ---- 6. 既有三事件域总线纯逻辑不受影响（回归锚点） ----
  设 系统 为 新建钩子系统()
  系统.订阅("agent", "turn/start", 收集)
  系统.发布("agent", "turn/start", {"轮": 1}, 空)
  断言相等(收到[0], 1, "6a 本地总线发布仍生效")

  打印 "--- 第6轮 任务B #259 宿主钩子触发出口 测试通过 ---"

主()