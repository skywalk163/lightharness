# test_R72_D_星号解包.light —— R72 任务 D（G-07，低优先级）
#
# 任务书：docs/功能对标/光明语言语法缺陷清零_R71-R73三轮并发开发任务书.md §四 D
# 缺陷：G-07 星号解包不完善——`f(*lst)` / `f(**dict)` 调用解包此前报
#       「意外的标记: 「*」」（历史遗留的死代码分支只放行了 Identifier 实参）。
# 修复面（light-merge/src/）：
#   · parser_expr.py：新增 _try_parse_unpack_arg()（KeywordArg('*'/'**', 值) 承载，
#     不新增 AST 节点——真实 kwargs 名来自 IDENTIFIER/KEYWORD，永不含 `*`），
#     接入 6 个调用实参收集点（动词括号/标识符方括号/链式/成员方法）；
#     _parse_list_literal 支持 [*表, 4] 任意位置的星号展开（Python 3.5+ 口径）。
#   · code_generator.py / code_generator_unified.py：识别解包 KeywordArg，
#     发射 `*expr` / `**expr`。
#   · type_inferencer.py：含解包实参的调用跳过静态期参数数量比对（展开后
#     个数不可知），交由 Python 运行期 TypeError 把关；不含解包的调用不变。
# 反向哨兵（预期编译失败）登记于 tests/test_回归.py EXPECT_RED。
# 改前此文件 rc!=0；改后 25 断言 rc=0。

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ok " + 标签

段落 求和 接收 a, b, c:
  返回 a + b + c

段落 两和 接收 a, b:
  返回 a + b

段落 造人 接收 姓名, 年龄:
  返回 {"姓名": 姓名, "年龄": 年龄}

段落 三参 接收 甲, 乙, 丙:
  返回 [甲, 乙, 丙]

段落 可变接收 接收 *参数:
  返回 列表(参数)

段落 可变双接 接收 *参数, **关键字:
  返回 [列表(参数), 关键字]

段落 取前缀 接收 s, n, m, k:
  返回 长度(s[0:n]) + m + k
段落 主:
  设 参数 为 [1, 2, 3]
  设 关键字参数 为 {"姓名": "张三", "年龄": 18}

  # §1 基础星号解包
  断言相等(求和(*参数), 6, "1a 求和(*参数)")
  断言相等(求和(*[4, 5, 6]), 15, "1b 字面量列表解包")
  断言相等(求和(*范围(3)), 3, "1c 调用返回值解包")

  # §2 双星号关键字解包
  断言相等(造人(**关键字参数), {"姓名": "张三", "年龄": 18}, "2a 造人(**关键字参数)")
  断言相等(造人(**{"姓名": "李四", "年龄": 20}), {"姓名": "李四", "年龄": 20}, "2b 字面量字典解包")

  # §3 混合：位置 + 星号 + 双星号
  断言相等(三参(1, *参数[1:]), [1, 2, 3], "3a 位置+星号下标")
  断言相等(三参(*参数[0:2], 9), [1, 2, 9], "3b 星号+位置（星号在前）")
  断言相等(造人("王五", **{"年龄": 30}), {"姓名": "王五", "年龄": 30}, "3c 位置+双星号")
  断言相等(造人("赵六", 年龄 = 22), {"姓名": "赵六", "年龄": 22}, "3d 位置+具名实参（回归）")

  # §4 内置动词 / 可变元数动词
  断言相等(取前缀("光明之路", *范围(3)), 0 + 3, "4a 可变元数动词+星号（s[0:0] 空切片）")
  断言相等(可变接收(*参数), [1, 2, 3], "4b 用户可变参数接收")
  断言相等(可变双接(1, 2, *参数, 姓名 = "张三"), [[1, 2, 1, 2, 3], {"姓名": "张三"}], "4c 用户双星号形参")

  # §5 列表字面量星号展开
  断言相等([*参数, 4], [1, 2, 3, 4], "5a [*表, 4]")
  断言相等([0, *参数], [0, 1, 2, 3], "5b [0, *表]")
  断言相等([*参数[0:2], 9, *参数[2:]], [1, 2, 9, 3], "5c 多个星号项")
  断言相等([*[1, 2], [3, 4]], [1, 2, [3, 4]], "5d [*嵌套列表, 另一列表] 星号只展开一层")

  # §6 字典字面量双星号展开（既有能力，回归哨兵）
  设 字典一 为 {"a": 1}
  设 字典二 为 {"b": 2}
  断言相等({**字典一, **字典二}, {"a": 1, "b": 2}, "6a 两个双星号")
  断言相等({**字典一, "c": 3}, {"a": 1, "c": 3}, "6b 双星号+普通条目")
  断言相等({"k": 1, **字典二}, {"k": 1, "b": 2}, "6c 普通条目+双星号")
  断言相等({**{"x": 1}, **{"y": 2}}, {"x": 1, "y": 2}, "6d 字面量双星号")

  打印 "test_R72_D_星号解包 全部通过"
