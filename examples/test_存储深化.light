# test_存储深化.light —— 存储 v2：批量存值 + 清空 + 条目数
从 存储 导入 存储
从 文件 导入 建临时目录, 拼路径, 删除路径

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 临时目录 为 建临时目录()
  设 存储路径 为 拼路径(临时目录, "测试存储.json")

  # ===== 批量存值 =====
  打印 "=== 批量存值测试 ==="
  设 存储对象 为 新建 存储(存储路径, "测试空间")
  存储对象.批量存值(["键1": "值1", "键2": 42, "键3": ["嵌套": "数据"]])

  断言等于(存储对象.读值("键1"), "值1", "批量存键1")
  断言等于(存储对象.读值("键2"), 42, "批量存键2")
  断言等于(存储对象.读值("键3")["嵌套"], "数据", "批量存键3嵌套")
  断言等于(存储对象.条目数(), 3, "批量存后条目数3")

  # 重开读回验证持久化
  设 存储对象2 为 新建 存储(存储路径, "测试空间")
  断言等于(存储对象2.读值("键1"), "值1", "重开读回键1")
  断言等于(存储对象2.读值("键2"), 42, "重开读回键2")
  断言等于(存储对象2.条目数(), 3, "重开后条目数3")

  # ===== 单键存值不影响其他 =====
  存储对象2.存值("键4", "额外")
  断言等于(存储对象2.条目数(), 4, "新增后条目数4")
  断言等于(存储对象2.读值("键1"), "值1", "原有键不受影响")

  # ===== 清空 =====
  打印 "=== 清空测试 ==="
  存储对象2.清空()
  断言等于(存储对象2.条目数(), 0, "清空后条目数0")
  断言等于(存储对象2.读值("键1"), 空, "清空后读不到键1")

  # 重开验证清空已持久化
  设 存储对象3 为 新建 存储(存储路径, "测试空间")
  断言等于(存储对象3.条目数(), 0, "重开后清空持久化")

  # 不同命名空间隔离
  设 存储对象4 为 新建 存储(存储路径, "另一空间")
  存储对象4.存值("隔离键", "隔离值")
  断言等于(存储对象4.条目数(), 1, "另一空间1条")
  设 存储对象5 为 新建 存储(存储路径, "测试空间")
  断言等于(存储对象5.条目数(), 0, "测试空间仍为空（隔离）")

  # 清理
  删除路径(临时目录)

  打印 "--- 存储深化测试通过 ---"

主()
