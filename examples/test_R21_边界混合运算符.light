# test_R21_边界混合运算符.light —— 第21轮 任务4：边界混合场景 + 运算符关键字表达式

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
    如果 条件 != 真:
        抛出 新建 错误("断言真失败: " + 标签)

段落 去重占位(输入):
    返回 输入 * 2

段落 排序函数(输入):
    返回 输入 * 3

段落 筛选器(输入):
    返回 输入 * 4

段落 如果条件函数(输入):
    返回 输入 * 5

段落 主:
    # 边界1：与合法语句相邻
    如果 真:
        断言相等(如果条件函数(1), 5, "相邻语句")
    # 边界2：同一行多个关键字前缀标识符嵌套
    断言相等(去重占位(排序函数(筛选器(1))), 24, "同行嵌套调用")
    # 边界3：关键字前缀标识符作为嵌套段落的段名
    段落 主内层返回():
        返回 7
    断言相等(主内层返回(), 7, "嵌套段名")
    # 边界4：ASCII 与中文混合标识符
    设 test函数结果 为 9
    断言相等(test函数结果, 9, "ASCII中文混合")
    # 边界5：含数字的标识符
    设 函数1结果 为 8
    断言相等(函数1结果, 8, "含数字标识符")
    # 运算符关键字（确保仍按关键字切分）
    设 甲 为 真
    设 乙 为 假
    断言真(甲 != 乙, "运算符上下文一")
    断言真(1 == 1, "等于形态")
    断言真(2 > 1, "大于形态")
    断言真(列表包含([1, 2], 1), "成员形态")
    打印 "test_R21_边界混合运算符 PASS"

主()
