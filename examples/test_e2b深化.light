# test_e2b深化.light —— e2b客户端 v2：会话管理/超时配置/连接状态查询
# 用模拟/桩数据验证，不发起真实网络连接
从 e2b客户端 导入 E2BClient

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 主:
  # ===== 会话管理 =====
  打印 "=== 会话管理测试 ==="
  设 客户端 为 新建 E2BClient("", 空)  # 无API key → 本地模拟

  # 初始无会话
  设 初始列表 为 客户端.列出会话()
  断言等于(长度(初始列表), 0, "初始无会话")

  # 创建会话
  设 会话ID1 为 客户端.创建会话()
  断言真(会话ID1.包含("sess_"), "会话ID以sess_开头")
  设 会话ID2 为 客户端.创建会话()

  # 列出会话
  设 列表 为 客户端.列出会话()
  断言等于(长度(列表), 2, "创建后有2个会话")
  断言等于(列表[0]["状态"], "active", "会话状态active")

  # 关闭会话
  设 关闭结果 为 客户端.关闭会话(会话ID1)
  断言等于(关闭结果, 真, "关闭成功返回真")
  设 列表2 为 客户端.列出会话()
  断言等于(列表2[0]["状态"], "closed", "关闭后状态closed")

  # 关闭不存在的会话
  设 关闭不存在 为 客户端.关闭会话("nonexistent")
  断言等于(关闭不存在, 假, "关闭不存在会话返回假")
  打印 "  会话管理通过"

  # ===== 超时配置 =====
  打印 "=== 超时配置测试 ==="
  设 客户端2 为 新建 E2BClient("", 空)
  断言等于(客户端2.超时秒, 30, "默认超时30秒")
  # 超时可通过属性配置
  设 客户端2.超时秒 为 60
  断言等于(客户端2.超时秒, 60, "设置超时60秒")
  设 连接状态 为 客户端2.连接状态查询()
  断言等于(连接状态["超时秒"], 60, "连接状态含超时60秒")
  打印 "  超时配置通过"

  # ===== 连接状态查询 =====
  打印 "=== 连接状态查询测试 ==="
  设 客户端3 为 新建 E2BClient("", 空)

  # 未启动状态
  设 状态0 为 客户端3.连接状态查询()
  断言等于(状态0["状态"], "未连接", "未启动时状态未连接")
  断言等于(状态0["活跃会话数"], 0, "未启动时活跃会话0")
  断言等于(状态0["总执行次数"], 0, "未启动时执行次数0")

  # 启动后（本地模拟）
  客户端3.启动()
  设 状态1 为 客户端3.连接状态查询()
  断言等于(状态1["状态"], "本地模拟", "启动后状态本地模拟")
  断言真(状态1["最后心跳"] != 空, "启动后有最后心跳")

  # 创建会话后活跃数增加
  客户端3.创建会话()
  设 状态2 为 客户端3.连接状态查询()
  断言等于(状态2["活跃会话数"], 1, "创建会话后活跃数=1")

  # 远程模式状态
  设 客户端4 为 新建 E2BClient("fake_api_key_123", 空)
  客户端4.启动()
  设 状态远程 为 客户端4.连接状态查询()
  断言等于(状态远程["状态"], "远程模式", "有API key时状态远程模式")
  打印 "  连接状态查询通过"

  打印 "--- e2b深化测试通过 ---"

主()
