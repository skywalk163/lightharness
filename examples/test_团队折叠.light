# test_团队折叠.light —— 对标 #67：团队事件折叠状态机 + 消息接受判定
# 原版用例对齐：packages/experimental/agent-team/tests/fold.spec.ts
#   + session-message.ts 的 pendingInboxMessages / messageAccepted
#
# 反跑判据（改反必须红）：
#   1) 把某事件套用到错误成员 —— 用例「反跑_成员归属」断言成员表只含 子、不含 旁人；
#      若 并入成员 写错键（如按 name 存）即红。
#   2) revision 不递增 —— 用例「反跑_修订递增」断言 revision 必须 +1；
#      若允许跳号（如 1 -> 3）或允许原地覆盖即红（对应违规用例两条）。
#   3) inbox 剪枝错误 —— 用例「反跑_信匣剪枝」断言删除段生效；
#      若 剪接 忽略 removedCount（只插不删）即红。
#
# 语言坑规避：
#   - 写 只吃「字面量串或已设的字符串变量」，`写 f(x)` 会把函数对象传给底层 write（L-055），
#     故本文件只用 `写 "字面量"`；诊断信息一律走 抛出 新建 错误（函数实参上下文 + 拼接正常）。
#   - 抛错判据走 检查抛错 + 具名零参段落（匿名闭包不可作实参，L-022 已修复但沿用既定写法）。
#   - 断言降级 no-op（L-037），一律用 断言相等 / 检查抛错。
#   - 变量不用「状态 / 字典 / 映射」作标识符（L-041），折叠状态一律称「局」。
#   - 是字典/是列表 放 或/且 链须加括号（L-036 伴生）。

从 团队折叠 导入 空折叠状态, 是否团队记录, 套用记录, 折叠团队, 待领消息, 是否空折叠, 校验任务接线, 校验载荷, 校验内容块, 判数值形状, 判安全序号, 算任务序号, 待领信匣, 已入列, 剪接
从 JSON 导入 序列化JSON
从 内置核心转换 导入 转字符串

# =====================================================================
# 常量（对齐 fold.spec.ts 的 ROOT / TEAM / CHILD）
# =====================================================================
设 根 为 "team-root"
设 队 为 "team-root"
设 子 为 "child-a"
设 旁人 为 "child-b"
设 旁支 为 "ancestor"

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)

# =====================================================================
# 构造助手（对齐 fold.spec.ts 的 event/member/task/message）
# =====================================================================
段落 造记录 接收 种类, 数据, 序号:
  设 记 为 {}
  记["type"] 为 种类
  记["data"] 为 数据
  记["seq"] 为 序号
  记["time"] 为 序号
  返回 记

段落 造成员 接收 覆盖:
  设 成 为 {}
  成["id"] 为 子
  成["name"] 为 "worker-a"
  成["description"] 为 "worker"
  成["provider"] 为 "spawn"
  成["context"] 为 "fresh"
  成["phase"] 为 "provisioning"
  遍历 键 之 字典键列表(覆盖):
    成[键] 为 覆盖[键]
  返回 成

段落 造任务 接收 覆盖:
  设 任 为 {}
  任["id"] 为 "task-1"
  任["revision"] 为 1
  任["subject"] 为 "subject"
  任["description"] 为 "description"
  任["status"] 为 "pending"
  任["blockedBy"] 为 []
  任["writeScopes"] 为 []
  遍历 键 之 字典键列表(覆盖):
    任[键] 为 覆盖[键]
  返回 任

段落 造消息 接收 覆盖:
  设 消 为 {}
  消["id"] 为 "message-1"
  消["senderId"] 为 根
  消["senderName"] 为 "lead"
  消["targetId"] 为 子
  消["delivery"] 为 "quiet"
  消["content"] 为 [{"type": "text", "text": "hello"}]
  遍历 键 之 字典键列表(覆盖):
    消[键] 为 覆盖[键]
  返回 消

段落 造成员记录 接收 队伍, 覆盖, 序号:
  返回 造记录("team/member", {"version": 1, "teamId": 队伍, "member": 造成员(覆盖)}, 序号)

段落 造任务记录 接收 队伍, 覆盖, 序号:
  返回 造记录("team/task", {"version": 1, "teamId": 队伍, "task": 造任务(覆盖)}, 序号)

段落 造排队记录 接收 队伍, 覆盖, 序号:
  返回 造记录("team/message/queued", {"version": 1, "teamId": 队伍, "message": 造消息(覆盖)}, 序号)

段落 造送达记录 接收 队伍, 消息标识, 目标标识, 序号:
  返回 造记录("team/message/delivered", {"version": 1, "teamId": 队伍, "messageId": 消息标识, "targetId": 目标标识}, 序号)

# agent/inbox/spliced 记录（session-message.ts）
段落 造剪接记录 接收 目标, 起点, 删除数, 插入清单, 序号:
  设 数据 为 {}
  数据["target"] 为 目标
  数据["start"] 为 起点
  数据["removedCount"] 为 删除数
  数据["inserted"] 为 插入清单
  返回 造记录("agent/inbox/spliced", 数据, 序号)

# 省略 removedCount 的剪接记录（对齐 `removedCount ?? 0`）
段落 造剪接记录简 接收 目标, 起点, 插入清单, 序号:
  设 数据 为 {}
  数据["target"] 为 目标
  数据["start"] 为 起点
  数据["inserted"] 为 插入清单
  返回 造记录("agent/inbox/spliced", 数据, 序号)

段落 造用户消息 接收 文本, 序号:
  设 数据 为 {}
  数据["text"] 为 文本
  返回 造记录("user/message", 数据, 序号)

# 判定谓词：命中 text == "目标语"
段落 判命中 接收 消息:
  如果 (是字典(消息) == 假): 返回 假
  如果 (字典包含键(消息, "text") == 假): 返回 假
  如果 消息["text"] == "目标语": 返回 真
  返回 假

# =====================================================================
# 1. 初态与团队记录判定
# =====================================================================
段落 用例初态与判定:
  设 局 为 空折叠状态(根)
  断言相等(局["id"], 队, "初态 id 为团队标识")
  断言相等(局["下一任务号"], 1, "初态下一任务号为 1")
  断言相等(是否空折叠(局), 真, "初态为空折叠")
  断言相等(列表长度(字典键列表(局["成员表"])), 0, "初态成员表空")
  断言相等(列表长度(字典键列表(局["任务表"])), 0, "初态任务表空")
  断言相等(是否团队记录(造记录("team/member", {}, 0)), 真, "team/member 是团队记录")
  断言相等(是否团队记录(造记录("team/task", {}, 0)), 真, "team/task 是团队记录")
  断言相等(是否团队记录(造记录("team/message/queued", {}, 0)), 真, "queued 是团队记录")
  断言相等(是否团队记录(造记录("team/message/delivered", {}, 0)), 真, "delivered 是团队记录")
  断言相等(是否团队记录(造记录("turn/start", {}, 0)), 假, "turn/start 非团队记录")
  断言相等(是否团队记录(造记录("user/message", {}, 0)), 假, "user/message 非团队记录")
  断言相等(是否团队记录("x"), 假, "非字典非团队记录")

# =====================================================================
# 2. 折叠当前团队记录并忽略继承记录（fold.spec 用例一）
# =====================================================================
段落 用例折叠与忽略:
  设 列表 为 []
  列表追加(列表, 造成员记录(旁支, {}, 0))
  列表追加(列表, 造成员记录(队, {}, 1))
  列表追加(列表, 造成员记录(队, {"phase": "active"}, 2))
  列表追加(列表, 造任务记录(队, {"id": "task-7"}, 3))
  列表追加(列表, 造排队记录(队, {}, 4))
  设 局 为 折叠团队(根, 列表)
  断言相等(局["id"], 队, "折叠后 id")
  断言相等(列表长度(字典键列表(局["成员表"])), 1, "继承成员被忽略，仅 1 成员")
  断言相等(列表长度(字典键列表(局["任务表"])), 1, "任务数 1")
  断言相等(列表长度(待领消息(局)), 1, "待领消息 1")
  断言相等(局["下一任务号"], 8, "task-7 推进下一任务号到 8")
  断言相等(局["成员表"][子]["name"], "worker-a", "成员名")
  断言相等(局["成员表"][子]["phase"], "active", "成员已激活")
  断言相等(是否团队记录(列表[0]), 真, "继承记录形态上仍是团队记录")

# =====================================================================
# 3. 成员身份与生命周期
# =====================================================================
段落 用例成员正常:
  设 列表 为 []
  列表追加(列表, 造成员记录(队, {}, 0))
  列表追加(列表, 造成员记录(队, {"phase": "active"}, 1))
  设 局 为 折叠团队(根, 列表)
  断言相等(列表长度(字典键列表(局["成员表"])), 1, "同成员两阶段仍 1 条")
  断言相等(局["成员表"][子]["phase"], "active", "provisioning -> active 合法")
  断言相等(局["名字索引"]["worker-a"], 子, "名字索引登记")
  断言相等(局["成员表"][子]["provider"], "spawn", "成员快照整体替换")

段落 段_首条非预备:
  设 列表 为 [造成员记录(队, {"phase": "active"}, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 段_改名:
  设 列表 为 []
  列表追加(列表, 造成员记录(队, {}, 0))
  列表追加(列表, 造成员记录(队, {"name": "renamed", "phase": "active"}, 1))
  设 占位 为 折叠团队(根, 列表)

段落 段_激活后失败:
  设 列表 为 []
  列表追加(列表, 造成员记录(队, {}, 0))
  列表追加(列表, 造成员记录(队, {"phase": "active"}, 1))
  列表追加(列表, 造成员记录(队, {"phase": "failed"}, 2))
  设 占位 为 折叠团队(根, 列表)

段落 段_重名:
  设 列表 为 []
  列表追加(列表, 造成员记录(队, {}, 0))
  列表追加(列表, 造成员记录(队, {"id": 旁人}, 1))
  设 占位 为 折叠团队(根, 列表)

段落 用例成员违规:
  检查抛错("首条必须 provisioning 应抛", 段_首条非预备)
  检查抛错("改不可变身份字段应抛", 段_改名)
  检查抛错("active -> failed 非法应抛", 段_激活后失败)
  检查抛错("成员名被他人占用应抛", 段_重名)

# =====================================================================
# 4. task 修订连续性
# =====================================================================
段落 用例修订连续:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"revision": 2, "status": "in_progress"}, 1))
  设 局 为 折叠团队(根, 列表)
  断言相等(列表长度(字典键列表(局["任务表"])), 1, "两修订仍 1 任务")
  断言相等(局["任务表"]["task-1"]["revision"], 2, "修订递增到 2")
  断言相等(局["任务表"]["task-1"]["status"], "in_progress", "状态随修订更新")

段落 段_首修订非一:
  设 列表 为 [造任务记录(队, {"revision": 2}, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 段_修订跳号:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"revision": 3}, 1))
  设 占位 为 折叠团队(根, 列表)

段落 用例修订违规:
  检查抛错("首条须从 revision 1 起应抛", 段_首修订非一)
  检查抛错("修订跳号应抛", 段_修订跳号)

# =====================================================================
# 5. 依赖图四类违规（对齐 fold.spec「rejects every invalid ... relation」）
# =====================================================================
段落 用例接线正常:
  设 表 为 {}
  表["task-1"] 为 造任务({})
  断言相等(校验任务接线(表, 造任务({"id": "task-2", "blockedBy": ["task-1"]})), 真, "合法依赖放行")
  断言相等(校验任务接线(表, 造任务({"id": "task-2"})), 真, "无依赖放行")

段落 段_阻塞缺失:
  设 列表 为 [造任务记录(队, {"blockedBy": ["missing"]}, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 段_自我阻塞:
  设 列表 为 [造任务记录(队, {"blockedBy": ["task-1"]}, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 段_阻塞重复:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"id": "task-2", "blockedBy": ["task-1", "task-1"]}, 1))
  设 占位 为 折叠团队(根, 列表)

段落 段_依赖成环:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"id": "task-2", "blockedBy": ["task-1"]}, 1))
  列表追加(列表, 造任务记录(队, {"revision": 2, "blockedBy": ["task-2"]}, 2))
  设 占位 为 折叠团队(根, 列表)

段落 段_阻塞已删:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"id": "task-2", "blockedBy": ["task-1"]}, 1))
  列表追加(列表, 造任务记录(队, {"revision": 2, "status": "deleted"}, 2))
  设 占位 为 折叠团队(根, 列表)

段落 用例接线违规:
  检查抛错("阻塞任务缺失应抛", 段_阻塞缺失)
  检查抛错("自我阻塞应抛", 段_自我阻塞)
  检查抛错("阻塞项重复应抛", 段_阻塞重复)
  检查抛错("依赖成环应抛", 段_依赖成环)
  检查抛错("阻塞任务已删除应抛", 段_阻塞已删)

# =====================================================================
# 6. 任务编号分配（nextTaskNumber）
# =====================================================================
段落 用例编号分配:
  设 局 为 折叠团队(根, [造任务记录(队, {"id": "external-task"}, 0)])
  断言相等(局["下一任务号"], 1, "非数值任务标识不改编号")
  设 局2 为 折叠团队(根, [造任务记录(队, {"id": "task-3"}, 0)])
  断言相等(局2["下一任务号"], 4, "task-3 推进到 4")
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {"id": "task-5"}, 0))
  列表追加(列表, 造任务记录(队, {"id": "task-2"}, 1))
  设 局3 为 折叠团队(根, 列表)
  断言相等(局3["下一任务号"], 6, "取历史最大值推进，不被小号回退")
  断言相等(判数值形状("task-1"), 真, "task-1 命中数值形状")
  断言相等(判数值形状("external-task"), 假, "非数值形状不命中")
  断言相等(判数值形状("task-"), 假, "空后缀不命中")
  断言相等(判安全序号("task-9007199254740991"), 真, "安全上限内放行")
  断言相等(判安全序号("task-9007199254740992"), 假, "超安全上限拒绝")
  断言相等(算任务序号("task-007"), 7, "前导零按数值解析")

段落 段_编号超界:
  设 列表 为 [造任务记录(队, {"id": "task-9007199254740992"}, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 用例编号违规:
  检查抛错("任务编号超出安全整数应抛", 段_编号超界)

# =====================================================================
# 7. 信箱排队 / 送达关系
# =====================================================================
段落 用例信箱正常:
  设 列表 为 []
  列表追加(列表, 造排队记录(队, {}, 0))
  列表追加(列表, 造送达记录(队, "message-1", 子, 1))
  设 局 为 折叠团队(根, 列表)
  断言相等(列表长度(待领消息(局)), 0, "送达后无待领")
  断言相等(列表长度(字典键列表(局["已送达"])), 1, "已送达登记 1 条")
  设 局2 为 折叠团队(根, [造排队记录(队, {}, 0)])
  断言相等(列表长度(待领消息(局2)), 1, "仅排队未送达 -> 待领 1")

段落 段_排队两次:
  设 列表 为 []
  列表追加(列表, 造排队记录(队, {}, 0))
  列表追加(列表, 造排队记录(队, {}, 1))
  设 占位 为 折叠团队(根, 列表)

段落 段_未排队先送达:
  设 列表 为 [造送达记录(队, "message-1", 子, 0)]
  设 占位 为 折叠团队(根, 列表)

段落 段_目标变更:
  设 列表 为 []
  列表追加(列表, 造排队记录(队, {}, 0))
  列表追加(列表, 造送达记录(队, "message-1", "other", 1))
  设 占位 为 折叠团队(根, 列表)

段落 段_送达两次:
  设 列表 为 []
  列表追加(列表, 造排队记录(队, {}, 0))
  列表追加(列表, 造送达记录(队, "message-1", 子, 1))
  列表追加(列表, 造送达记录(队, "message-1", 子, 2))
  设 占位 为 折叠团队(根, 列表)

段落 用例信箱违规:
  检查抛错("重复排队应抛", 段_排队两次)
  检查抛错("未排队先送达应抛", 段_未排队先送达)
  检查抛错("送达目标变更应抛", 段_目标变更)
  检查抛错("重复送达应抛", 段_送达两次)

# =====================================================================
# 8. 持久载荷严格校验（对齐 fold.spec「validates every current-version ... payload」）
# =====================================================================
段落 段_成员名非串:
  设 坏 为 造成员({})
  坏["name"] 为 42
  设 占位 为 折叠团队(根, [造记录("team/member", {"version": 1, "teamId": 队, "member": 坏}, 0)])

段落 段_阻塞非串:
  设 坏 为 造任务({})
  坏["blockedBy"] 为 [42]
  设 占位 为 折叠团队(根, [造记录("team/task", {"version": 1, "teamId": 队, "task": 坏}, 0)])

段落 段_内容文本非串:
  设 坏 为 造消息({})
  坏["content"] 为 [{"type": "text", "text": 42}]
  设 占位 为 折叠团队(根, [造记录("team/message/queued", {"version": 1, "teamId": 队, "message": 坏}, 0)])

段落 段_送达目标非串:
  设 占位 为 折叠团队(根, [造记录("team/message/delivered", {"version": 1, "teamId": 队, "messageId": "message-1", "targetId": 42}, 0)])

段落 段_成员多余键:
  设 坏 为 造成员({})
  坏["unexpected"] 为 真
  设 占位 为 折叠团队(根, [造记录("team/member", {"version": 1, "teamId": 队, "member": 坏}, 0)])

段落 段_队伍标识非串:
  设 占位 为 折叠团队(根, [造记录("team/task", {"version": 1, "teamId": 42, "task": 造任务({})}, 0)])

段落 用例载荷违规:
  检查抛错("成员名非字符串应抛", 段_成员名非串)
  检查抛错("阻塞项非字符串应抛", 段_阻塞非串)
  检查抛错("文本块 text 非字符串应抛", 段_内容文本非串)
  检查抛错("送达目标非字符串应抛", 段_送达目标非串)
  检查抛错("成员多余键应抛（strict）", 段_成员多余键)
  检查抛错("队伍标识非字符串应抛", 段_队伍标识非串)

# =====================================================================
# 9. 内容块 merge-extensible（核心类型严校验 + 插件类型保留）
# =====================================================================
段落 用例内容块:
  设 插件 为 {"type": "plugin/custom", "payload": {"value": 1}}
  设 局 为 折叠团队(根, [造排队记录(队, {"content": [插件]}, 0)])
  设 待 为 待领消息(局)
  断言相等(列表长度(待), 1, "插件内容块仍可排队")
  断言相等(序列化JSON(待[0]["content"][0]), 序列化JSON(插件), "插件内容块原样保留")
  设 局2 为 折叠团队(根, [造排队记录(队, {"content": [{"type": "text", "text": "ok"}]}, 0)])
  设 待2 为 待领消息(局2)
  断言相等(待2[0]["content"][0]["text"], "ok", "核心 text 块合法")
  断言相等(校验内容块({"type": "tool-result", "toolCallId": "c1", "content": [{"type": "text", "text": "x"}]}), 真, "嵌套 tool-result 合法")

段落 段_嵌套块非法:
  设 占位 为 校验内容块({"type": "tool-result", "toolCallId": "c1", "content": [{"type": "text", "text": 42}]})

段落 段_核心块字段错:
  设 占位 为 校验内容块({"type": "text", "text": 42})

段落 用例内容块违规:
  检查抛错("嵌套内容块非法应抛", 段_嵌套块非法)
  检查抛错("核心块字段类型错应抛", 段_核心块字段错)

# =====================================================================
# 10. 版本门与继承记录（不解码版本即忽略 / 当前版本仍须校验）
# =====================================================================
段落 用例版本门:
  设 局 为 空折叠状态(根)
  设 抛了 为 假
  尝试:
    设 占位 为 套用记录(局, 造记录("team/task", {"version": 2, "teamId": 队, "task": 造任务({})}, 0))
  捕获 错误:
    设 抛了 为 真
  断言相等(抛了, 真, "同团队不支持版本应抛")
  断言相等(是否空折叠(局), 真, "抛错后状态未变")
  设 局2 为 折叠团队(根, [造记录("team/task", {"version": 2, "teamId": 旁支, "task": 造任务({})}, 0)])
  断言相等(是否空折叠(局2), 真, "不支持版本的继承记录被忽略")
  断言相等(套用记录(局, 造记录("turn/start", {}, 0)), 假, "非团队记录静默忽略")
  断言相等(套用记录(局, 造成员记录(旁支, {}, 0)), 假, "他团队成员记录静默忽略")

段落 段_继承记录仍校验:
  设 坏 为 造任务({})
  坏["subject"] 为 42
  设 占位 为 折叠团队(根, [造记录("team/task", {"version": 1, "teamId": 旁支, "task": 坏}, 0)])

段落 用例继承校验:
  检查抛错("继承的当前版本记录仍须校验应抛", 段_继承记录仍校验)

# =====================================================================
# 11. 待领信匣（pendingInboxMessages）
# =====================================================================
段落 用例信匣:
  断言相等(列表长度(待领信匣([])), 0, "空事件列表无待领")
  设 列表 为 [造剪接记录("next-turn", 0, 0, ["A", "B"], 0)]
  设 匣 为 待领信匣(列表)
  断言相等(列表长度(匣), 2, "插入两条")
  断言相等(匣[0], "A", "首条为 A")
  断言相等(匣[1], "B", "次条为 B")
  # next-turn 与 next-step 分桶，结果 next-turn 优先
  设 列表2 为 []
  列表追加(列表2, 造剪接记录("next-step", 0, 0, ["C"], 0))
  列表追加(列表2, 造剪接记录("next-turn", 0, 0, ["A", "B"], 1))
  设 匣2 为 待领信匣(列表2)
  断言相等(列表长度(匣2), 3, "两桶合计 3 条")
  断言相等(匣2[0], "A", "next-turn 桶在前")
  断言相等(匣2[2], "C", "next-step 桶在后")
  # 删除段：起点 1 删 1 条
  设 列表3 为 []
  列表追加(列表3, 造剪接记录("next-turn", 0, 0, ["A", "B", "C"], 0))
  列表追加(列表3, 造剪接记录("next-turn", 1, 1, [], 1))
  设 匣3 为 待领信匣(列表3)
  断言相等(列表长度(匣3), 2, "删除一条后剩 2 条")
  断言相等(匣3[0], "A", "删除后首条仍 A")
  断言相等(匣3[1], "C", "B 已被删除")
  # 中间插入（不删）
  设 列表4 为 []
  列表追加(列表4, 造剪接记录("next-turn", 0, 0, ["A", "B"], 0))
  列表追加(列表4, 造剪接记录("next-turn", 1, 0, ["X"], 1))
  设 匣4 为 待领信匣(列表4)
  断言相等(列表长度(匣4), 3, "中间插入后 3 条")
  断言相等(匣4[1], "X", "X 插在中间")
  # removedCount 缺省视为 0
  设 列表5 为 []
  列表追加(列表5, 造剪接记录("next-turn", 0, 0, ["A", "B"], 0))
  列表追加(列表5, 造剪接记录简("next-turn", 1, ["Y"], 1))
  设 匣5 为 待领信匣(列表5)
  断言相等(列表长度(匣5), 3, "缺省 removedCount 视为 0 -> 3 条")
  断言相等(匣5[1], "Y", "缺省删除数时仅插入")
  # 未知 target 忽略
  设 列表6 为 [造剪接记录("other-turn", 0, 0, ["Z"], 0)]
  断言相等(列表长度(待领信匣(列表6)), 0, "未知 target 被忽略")

段落 用例剪接单元:
  设 结果 为 剪接(["a", "b", "c"], 1, 1, ["x", "y"])
  断言相等(列表长度(结果), 4, "剪接后长度 4")
  断言相等(结果[0], "a", "剪接头段保留")
  断言相等(结果[1], "x", "插入段首位")
  断言相等(结果[3], "c", "删除后尾段保留")
  设 结果2 为 剪接(["a", "b"], 0, 2, [])
  断言相等(列表长度(结果2), 0, "全删后为空")

# =====================================================================
# 12. 已入列（messageAccepted）
# =====================================================================
段落 用例已入列:
  断言相等(已入列([], 判命中), 假, "空列表不命中")
  设 列表 为 [造用户消息("目标语", 0)]
  断言相等(已入列(列表, 判命中), 真, "历史消息命中")
  设 列表2 为 [造用户消息("其他", 0)]
  断言相等(已入列(列表2, 判命中), 假, "历史消息不命中")
  设 列表3 为 [造剪接记录("next-turn", 0, 0, [{"text": "目标语"}], 0)]
  断言相等(已入列(列表3, 判命中), 真, "待领队列命中")
  设 列表4 为 [造剪接记录("next-step", 0, 0, [{"text": "目标语"}], 0)]
  断言相等(已入列(列表4, 判命中), 真, "next-step 桶命中")
  设 列表5 为 []
  列表追加(列表5, 造剪接记录("next-turn", 0, 0, [{"text": "目标语"}], 0))
  列表追加(列表5, 造剪接记录("next-turn", 0, 1, [], 1))
  断言相等(已入列(列表5, 判命中), 假, "待领队列剪除后不命中")
  设 列表6 为 []
  列表追加(列表6, 造用户消息("其他", 0))
  列表追加(列表6, 造用户消息("目标语", 1))
  断言相等(已入列(列表6, 判命中), 真, "多条历史中后条命中")

# =====================================================================
# 13. 反跑判据锚点（改反必须红）
# =====================================================================
段落 反跑_成员归属:
  设 列表 为 []
  列表追加(列表, 造成员记录(队, {}, 0))
  列表追加(列表, 造成员记录(队, {"phase": "active"}, 1))
  设 局 为 折叠团队(根, 列表)
  断言相等(字典包含键(局["成员表"], 子), 真, "事件须套用到 子 名下")
  断言相等(字典包含键(局["成员表"], 旁人), 假, "不得套用到 旁人 名下")
  断言相等(字典包含键(局["成员表"], "worker-a"), 假, "成员表按 id 索引、不按 name")

段落 反跑_修订递增:
  设 列表 为 []
  列表追加(列表, 造任务记录(队, {}, 0))
  列表追加(列表, 造任务记录(队, {"revision": 2}, 1))
  列表追加(列表, 造任务记录(队, {"revision": 3, "status": "completed"}, 2))
  设 局 为 折叠团队(根, 列表)
  断言相等(局["任务表"]["task-1"]["revision"], 3, "修订须逐次 +1 到 3")
  断言相等(局["任务表"]["task-1"]["status"], "completed", "末次修订状态生效")

段落 反跑_信匣剪枝:
  设 列表 为 []
  列表追加(列表, 造剪接记录("next-turn", 0, 0, ["A", "B", "C"], 0))
  列表追加(列表, 造剪接记录("next-turn", 0, 2, ["D"], 1))
  设 匣 为 待领信匣(列表)
  断言相等(列表长度(匣), 2, "删 2 插 1 后剩 2 条")
  断言相等(匣[0], "D", "插入段落在被删位置")
  断言相等(匣[1], "C", "未删尾段保留")

