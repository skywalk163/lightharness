# test_R89_D_turnWindow分页.light —— R89-D 半移植回归用例
# 对齐上游 commit 50ba2c8bb2 `fix(session): align history pagination with turn boundaries`
# 的纯算法面（paginate + validateHistoryWindow），移植到 会话历史分页.light。
#
# 反跑点（改反即红）：
#   1) 无 轮次窗口 时退化为「按 maxMessages 数消息」——去掉计数逻辑即红；
#   2) 有 轮次窗口 时，页面起点必须落在 turn/start 的序号上（不从一轮中间切开）——
#      把 turn 计数去掉（只按 minMessages 切）即红；
#   3) 两个最小值是「且」关系：只满足消息数、轮数不够 → 继续往上翻（不切）；
#   4) 历史耗尽（两个最小值都没凑够）→ 切=0、还有更多=假（全量返回）；
#   5) maxMessages 触发时用 groupStart（含 sourceEventSeqs 回退）——去掉回退即红；
#   6) 校验：minMessages>maxMessages / <=0 / minTurns<=0 → 不合法原因串。
#
# 运行：cd lightharness && python 运行.py examples/test_R89_D_turnWindow分页.light

从 会话历史分页 导入 历史分页, 校验历史窗口, 历史消息类型表

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

# 造一个事件：序号递增；类型 + 可选界面操作 + 可选来源序号表
段落 加事件(表, 类型):
  设 序 为 长度(表)
  列表追加(表, ["序号": 序, "类型": 类型])
  返回 表

段落 加消息(表, 类型):
  设 序 为 长度(表)
  列表追加(表, ["序号": 序, "类型": 类型, "界面操作": "append"])
  返回 表

# 布局：turn/start, user, asst×3, turn/end, turn/start, user, asst×3, turn/end, ...
段落 造三轮(每轮回复数):
  设 表 为 []
  设 轮 为 1
  当 轮 <= 3:
    加事件(表, "turn/start")
    加消息(表, "user/message")
    设 步 为 1
    当 步 <= 每轮回复数:
      加消息(表, "assistant/message")
      设 步 为 步 + 1
    结束
    加事件(表, "turn/end")
    设 轮 为 轮 + 1
  结束
  返回 表

段落 主:
  # ============ 1) 无轮次窗口：退化为按 maxMessages 数消息 ============
  设 表 为 造三轮(3)
  设 页 为 历史分页(表, 空, 4, 空, 空)
  # 末轮：turn/start(12) user(13) asst(14,15,16) turn/end(17)；数到第 4 条消息(user 13)
  # → 切=13，页面 = 13..17（4 条消息 + 尾随 turn/end）
  断言等于(长度(页["事件表"]), 5, "无窗口：4 条消息 + 尾随 turn/end")
  断言真(页["还有更多"] == 真, "无窗口：应有更多")
  断言等于(页["事件表"][0]["序号"], 13, "无窗口：切点=第 4 条消息自身序号")
  断言等于(页["事件表"][0]["类型"], "user/message", "无窗口：首条是 user/message")

  # ============ 2) 有轮次窗口：起点落在 turn/start 上（不切一轮中间）============
  #  三轮 × (1 user + 3 asst)：minMessages=4, minTurns=2 → 从倒数第 3 个 turn/start 起
  # 三轮各 6 事件（0..5 / 6..11 / 12..17），turn/start 在 0 / 6 / 12。
  # minMessages=4 + minTurns=2：从尾往前数够 4 条消息后需再越过 2 个 turn/start
  # → 切=6（第 2 轮的 turn/start），页面起点必须是 turn/start，绝不从一轮中间切开。
  设 页2 为 历史分页(造三轮(3), 空, 500, 空, ["最少消息": 4, "最少轮次": 2])
  断言等于(页2["事件表"][0]["序号"], 6, "turnWindow：起点落在第 2 轮 turn/start(6)")
  断言等于(页2["事件表"][0]["类型"], "turn/start", "turnWindow：起点类型是 turn/start")
  断言真(页2["还有更多"] == 真, "turnWindow：切=6>0 → 有更多")

  # ============ 3) 「且」关系：轮数不够时继续往上翻 ============
  #  minTurns=3 → 需要越过 3 个 turn/start；三轮布局里第 3 个（最早的）就是首轮 → 切=0
  设 页3 为 历史分页(造三轮(3), 空, 500, 空, ["最少消息": 4, "最少轮次": 3])
  断言等于(页3["事件表"][0]["序号"], 0, "minTurns=3：翻到最早一轮")
  断言真(页3["还有更多"] == 假, "minTurns=3：切=0 → 无更多")

  # ============ 4) 历史耗尽：两个最小值都没凑够 → 全量返回 ============
  设 页4 为 历史分页(造三轮(3), 空, 500, 空, ["最少消息": 200, "最少轮次": 9])
  断言等于(长度(页4["事件表"]), 长度(造三轮(3)), "耗尽：返回全量")
  断言真(页4["还有更多"] == 假, "耗尽：还有更多=假")

  # ============ 5) maxMessages 触发时用 groupStart（来源序号回退）============
  设 表5 为 造三轮(3)
  设 末 为 长度(表5) - 1        # 17（turn/end，不计消息）
  # 末条消息是 16（assistant）；给它挂来源序号 15 → 切点应按最小来源序号回退到 15
  设 改写 为 表5[16]
  设 改写["来源序号表"] 为 [15]
  设 表5[16] 为 改写
  设 页5 为 历史分页(表5, 空, 1, 空, 空)
  断言等于(页5["事件表"][0]["序号"], 15, "groupStart：按最小来源序号回退到 15")
  断言真(页5["还有更多"] == 真, "groupStart：切点 >0 → 有更多")

  # ============ 6) 前序号（beforeSeq）截断 ============
  设 表6 为 造三轮(3)
  设 页6 为 历史分页(表6, 3, 500, 空, 空)
  断言等于(长度(页6["事件表"]), 3, "beforeSeq=3：只取序号 0..2")
  断言等于(页6["事件表"][2]["序号"], 2, "beforeSeq=3：末条序号=2")

  # ============ 7) 窗口校验 ============
  断言等于(校验历史窗口(500, ["最少消息": 50, "最少轮次": 2]), "", "合法窗口")
  断言等于(校验历史窗口(500, 空), "", "无窗口合法")
  断言真(校验历史窗口(10, ["最少消息": 50, "最少轮次": 2]) != "", "minMessages>maxMessages → 不合法")
  断言真(校验历史窗口(500, ["最少消息": 0, "最少轮次": 2]) != "", "minMessages<=0 → 不合法")
  断言真(校验历史窗口(500, ["最少消息": 50, "最少轮次": 0]) != "", "minTurns<=0 → 不合法")
  断言真(校验历史窗口(500, ["最少消息": 50]) != "", "缺 minTurns → 不合法")

  # ============ 8) 消息类型表 ============
  断言等于(长度(历史消息类型表), 2, "MESSAGE_TYPES = user/message + assistant/message")

  输出 "test_R89_D_turnWindow分页: 全部断言通过"
