# test_交付.light —— 路6(F) 交付/文件/工具/MCP/压缩 1.5 增量测试
#
# 覆盖（每判据组含反跑点，改反即红）：
#   1) 交付纯逻辑（tool-present）：交付参数校验、会话文件系统边界跟随、
#      不可变交付声明、交付事件规整、文件变更 vs 交付物（显式交付）
#      反跑：把「文件通过」的 有效=真 断言改反 → 红
#   2) scoped tools（#3853）：可见性判定、指导段过滤、交叉推荐句裁剪
#      反跑：把 过滤可见指导 段数断言改反 → 红
#   3) web guidance scoped：渲染Web指导/渲染作用域Web指导
#      反跑：把 渲染Web指导 段数断言改反 → 红
#   4) workspace 路径加固：判定完全限定、解析工作区路径、默认标题、
#      规范化路径平台、判定盘符根、上层路径终止
#      反跑：把 判定完全限定("C:\\proj","win32")=真 断言改反 → 红
#   5) mcp 分页循环（#3846）：合并分页、重复光标抛错、无光标终止
#      反跑：把「重复光标应抛错」断言改反 → 红
#   6) compaction summarizer：造压缩指令、包摘要框架、检查摘要文本、
#      压缩.light 检查点接入
#      反跑：把 包摘要框架 块数断言改反 → 红
#
# 运行：python 运行.py examples/test_交付.light

从 交付 导入 判定交付参数, 判定交付文件, 判定声明可用, 造交付事件, 判定需交付, 判定全空白
从 工具 导入 判定工具可见, 过滤可见指导, 裁交叉推荐
从 网页搜索 导入 渲染Web指导, 渲染作用域Web指导
从 工作区 导入 判定Windows风格路径, 判定绝对工作区路径, 解析工作区路径, 判定完全限定, 默认标题, 规范化路径平台
从 路径规则 导入 判定盘符根, 上层路径
从 mcp客户端 导入 消费分页工具表
从 压缩配套 导入 造压缩指令, 包摘要框架, 检查摘要文本
从 压缩 导入 造检查点消息
从 会话 导入 新建会话
从 消息 导入 造用户消息, 造助手消息, 造文本块

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言假 接收 条件, 标签:
  如果 条件 != 假:
    抛出 新建 错误("断言假失败: " + 标签)

# 类别投影：仅 常规/目录/缺失
段落 查类别 接收 路径:
  如果 路径 == "缺":
    返回 "无"
  如果 路径 == "目":
    返回 "目录"
  返回 "文件"

# 会话文件系统边界投影：除 界外 外均可访问
段落 判定可访问 接收 路径:
  如果 路径 == "界外":
    返回 假
  返回 真

# ============ 1) 交付纯逻辑 ============
段落 测试交付参数:
  设 规整 为 判定交付参数([["路径": "a.txt", "描述": "文件A", "多余": 1]], 8)
  断言相等(长度(规整), 1, "单文件规整")
  断言相等(规整[0]["路径"], "a.txt", "路径保留")
  断言相等(规整[0]["描述"], "文件A", "描述保留")
  断言假(规整[0].包含("多余"), "多余键被拒绝")
  设 抛空 为 假
  尝试:
    判定交付参数([], 8)
  捕获 错误 为 e1:
    设 抛空 为 真
  断言真(抛空, "空文件表应抛错")
  设 抛超 为 假
  尝试:
    判定交付参数([["路径": "a"], ["路径": "b"], ["路径": "c"], ["路径": "d"], ["路径": "e"], ["路径": "f"], ["路径": "g"], ["路径": "h"], ["路径": "i"]], 8)
  捕获 错误 为 e2:
    设 抛超 为 真
  断言真(抛超, "超上限应抛错")
  设 抛空路径 为 假
  尝试:
    判定交付参数([["路径": "   "]], 8)
  捕获 错误 为 e3:
    设 抛空路径 为 真
  断言真(抛空路径, "全空白路径应抛错")
  断言真(判定全空白(" \t\n"), "全空白判定")

段落 测试交付文件:
  设 通过 为 判定交付文件("常规.txt", 查类别, 判定可访问)
  断言真(通过["有效"], "常规文件通过")  # 反跑：改反 → 红
  设 抛目录 为 假
  尝试:
    判定交付文件("目", 查类别, 判定可访问)
  捕获 错误 为 e1:
    设 抛目录 为 真
  断言真(抛目录, "目录应拒绝")
  设 抛缺失 为 假
  尝试:
    判定交付文件("缺", 查类别, 判定可访问)
  捕获 错误 为 e2:
    设 抛缺失 为 真
  断言真(抛缺失, "缺失应拒绝")
  设 抛界外 为 假
  尝试:
    判定交付文件("界外", 查类别, 判定可访问)
  捕获 错误 为 e3:
    设 抛界外 为 真
  断言真(抛界外, "界外应拒绝")

段落 测试不可变声明:
  断言真(判定声明可用("常规.txt", 查类别), "存在文件声明可用")
  断言假(判定声明可用("缺", 查类别), "缺失文件声明不可用")  # 反跑：改反 → 红

段落 测试交付事件:
  设 交付 为 造交付事件(7, "call-9", [["路径": "a.txt", "描述": "A", "多余": 1]])
  断言相等(交付["轮次"], 7, "轮次保留")
  断言相等(交付["调用标识"], "call-9", "调用标识保留")
  断言相等(交付["文件表"][0]["路径"], "a.txt", "文件路径")
  断言假(交付["文件表"][0].包含("多余"), "事件文件表已规整")

段落 测试显式交付:
  设 已声明 为 [["路径": "a.txt"], ["路径": "b.txt"]]
  设 改动 为 [["路径": "a.txt"], ["路径": "b.txt"], ["路径": "c.txt"]]
  设 结果 为 判定需交付(已声明, 改动)
  断言相等(长度(结果["已交付"]), 2, "已声明为交付物")
  断言相等(长度(结果["未交付"]), 1, "未声明为未交付")  # 反跑：改反 → 红
  断言相等(结果["未交付"][0], "c.txt", "未交付路径")

# ============ 2) scoped tools ============
段落 测试作用域工具:
  断言真(判定工具可见(["glob", "grep"], [], "glob"), "白名单含 glob")
  断言假(判定工具可见(["glob", "grep"], [], "read"), "白名单不含 read")
  断言假(判定工具可见([], ["read"], "read"), "黑名单含 read")
  断言真(判定工具可见([], ["read"], "grep"), "黑名单不含 grep")
  段落 判可见 接收 名:
    返回 判定工具可见([], ["read"], 名)
  设 段表 为 [["工具名": "glob", "文本": "Use the glob tool to discover files by path pattern."], ["工具名": "grep", "文本": "Use the grep tool to search file contents."], ["工具名": "read", "文本": "Use the read tool to read files."]]
  设 可见段 为 过滤可见指导(段表, 判可见)
  断言相等(长度(可见段), 2, "read 不可见时只留 2 段")  # 反跑：改反 → 红
  设 指导文本 为 "Use the grep tool to search file contents. Use read on a matched file when you need surrounding context."
  设 裁剪后 为 裁交叉推荐(指导文本, " Use read on a matched file", "read", 判可见)
  断言相等(裁剪后, "Use the grep tool to search file contents.", "read 不可见时裁剪交叉推荐句")  # 反跑：改反 → 红
  设 保留 为 裁交叉推荐(指导文本, " Use read on a matched file", "glob", 判可见)
  断言相等(保留, 指导文本, "关联工具可见时原文保留")

# ============ 3) web guidance ============
段落 测试Web指导:
  段落 判全可见 接收 名:
    返回 真
  段落 判禁搜索 接收 名:
    如果 名 == "search":
      返回 假
    返回 真
  设 全 为 渲染Web指导(判全可见)
  断言相等(长度(全), 2, "全可见 2 段")
  断言相等(全[0]["工具名"], "search", "search 在前")
  设 禁搜 为 渲染Web指导(判禁搜索)
  断言相等(长度(禁搜), 1, "禁 search 只留 1 段")  # 反跑：改反 → 红
  断言相等(禁搜[0]["工具名"], "fetch", "只留 fetch")
  设 作用域 为 渲染作用域Web指导(["fetch"], [])
  断言相等(长度(作用域), 1, "白名单 fetch 只留 1 段")
  断言相等(作用域[0]["工具名"], "fetch", "fetch 段")
  设 黑域 为 渲染作用域Web指导([], ["search"])
  断言相等(长度(黑域), 1, "黑名单 search 只留 fetch")
  断言真(判定工具可见(["search"], [], "search"), "search 白名单可见")

# ============ 4) workspace 路径加固 ============
段落 测试工作区路径:
  断言真(判定Windows风格路径("C:\\proj"), "win 盘符路径")
  断言真(判定Windows风格路径("\\\\server\\share"), "UNC 路径")
  断言假(判定Windows风格路径("/a/b"), "posix 非 win 风格")
  断言真(判定绝对工作区路径("/a/b"), "posix 绝对")
  断言假(判定绝对工作区路径("a/b"), "相对非绝对")
  断言相等(解析工作区路径("C:\\work", "src/a.txt"), "C:\\work\\src/a.txt", "win cwd 反斜杠分隔")
  断言相等(解析工作区路径("C:/work", "src/a.txt"), "C:/work/src/a.txt", "win cwd 正斜杠分隔")
  断言相等(解析工作区路径("/home/u", "/abs/p"), "/abs/p", "绝对原样")
  断言相等(解析工作区路径("", "rel"), "rel", "无 cwd 原样")
  断言真(判定完全限定("C:\\proj", "win32"), "win32 盘符完全限定")  # 反跑：改反 → 红
  断言假(判定完全限定("\\rel", "win32"), "win32 裸根拒绝")
  断言真(判定完全限定("/abs", "posix"), "posix 绝对完全限定")
  断言假(判定完全限定("rel", "posix"), "posix 相对拒绝")
  断言相等(默认标题("C:\\proj\\sub", "win32"), "sub", "默认标题末段")
  断言相等(默认标题("C:\\", "win32"), "C:\\", "默认标题根拼写")
  断言相等(规范化路径平台("C:\\", "win32"), "C:/", "win 盘符根保留")  # 反跑：改反 → 红
  断言相等(规范化路径平台("C:\\proj", "win32"), "C:/proj", "win 盘符子路径")
  断言相等(规范化路径平台("/a/b", "posix"), "/a/b", "posix 不变")
  断言真(判定盘符根("C:\\"), "恰盘符根")
  断言真(判定盘符根("C:/"), "恰盘符根正斜杠")
  断言假(判定盘符根("C:\\proj"), "子路径非盘符根")
  断言相等(上层路径("C:\\proj\\sub", "win32"), "C:\\proj", "上层路径")
  断言相等(上层路径("C:\\", "win32"), "", "win 盘符根终止")  # 反跑：改反 → 红

# ============ 5) mcp 分页循环 ============
段落 测试分页:
  设 页1 为 ["工具表": [["name": "echo"], ["name": "add"]], "下一光标": "c1"]
  设 页2 为 ["工具表": [["name": "mul"]], "下一光标": "c2"]
  设 页3 为 ["工具表": [["name": "div"]]]
  设 合并 为 消费分页工具表([页1, 页2, 页3], "demo")
  断言相等(长度(合并), 4, "三页合并 4 工具")
  断言相等(合并[3]["name"], "div", "末页工具")
  设 页重复 为 ["工具表": [], "下一光标": "c1"]
  设 抛了 为 假
  尝试:
    消费分页工具表([页1, 页重复], "demo")
  捕获 错误 为 e1:
    设 抛了 为 真
  断言真(抛了, "重复光标应抛错")  # 反跑：改反 → 红

# ============ 6) compaction summarizer ============
段落 测试压缩摘要:
  设 指令 为 造压缩指令()
  断言真(指令.包含("## Primary Request and Intent"), "指令含首节标题")
  断言真(指令.包含("## Critical Context"), "指令含末节标题")
  断言真(指令.包含("## Files and Code"), "指令含文件节")
  设 摘要块 为 [["类型": "text", "文本": "核心结论"]]
  设 框架 为 包摘要框架(摘要块)
  断言相等(长度(框架), 3, "框架三块")  # 反跑：改反 → 红
  断言真(框架[0]["文本"].包含("<compacted-summary>"), "前导含开标签")
  断言相等(框架[2]["文本"], "</compacted-summary>", "闭合标签")
  设 纯文本 为 检查摘要文本([["类型": "text", "文本": "a"], ["类型": "text", "文本": "b"]])
  断言相等(长度(纯文本), 2, "纯文本保留")
  设 抛图 为 假
  尝试:
    检查摘要文本([["类型": "image", "文本": "x"]])
  捕获 错误 为 e2:
    设 抛图 为 真
  断言真(抛图, "图片摘要应抛错")

段落 测试检查点接入:
  设 会话对象 为 新建会话("交付测试", 当前目录())
  设 用户 为 造用户消息([造文本块("问题一")])
  会话对象.记录事件("user/message", 用户)
  设 助手 为 造助手消息([造文本块("回答一")], "deepseek", "deepseek-chat")
  会话对象.记录事件("assistant/message", ["消息": 助手])
  设 检查点 为 造检查点消息(会话对象, 1)
  断言相等(长度(检查点["content"]), 3, "检查点消息三块")
  断言真(检查点["content"][0]["文本"].包含("automatically generated checkpoint"), "检查点前导")
  断言真(检查点["content"][2]["文本"].包含("</compacted-summary>"), "检查点闭合")

段落 主:
  设 哑 为 0
  测试交付参数()
  测试交付文件()
  测试不可变声明()
  测试交付事件()
  测试显式交付()
  测试作用域工具()
  测试Web指导()
  测试工作区路径()
  测试分页()
  测试压缩摘要()
  测试检查点接入()
  打印 "test_交付 PASS"

主()
