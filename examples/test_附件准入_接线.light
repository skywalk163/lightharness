# test_附件准入_接线.light —— 第6轮 任务E #285 等比/长边投影接线 判据
# 运行：python 运行.py examples/test_附件准入_接线.light
# 判据：投影图片附件块（绳请求长边尺寸 等比收边 → 消息.造图片块 附件块）；
#       纯逻辑回归绿由 test_附件准入.light / test_附件准入1.5.light 承担。

从 附件准入 导入 投影图片附件块, 绳请求长边尺寸
从 消息 导入 造图片块

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 长边超限 -> 等比收边（宽高比保持 2:1） ----
  设 块 为 投影图片附件块("QUJD", "image/png", 2000, 1000, 500)
  断言相等(块["width"], 500, "1a 宽收边")
  断言相等(块["height"], 250, "1b 高等比")
  断言相等(块["type"], "image", "1c 消息图片块类型")

  # ---- 2. 长边不足 -> 原尺寸 ----
  设 块2 为 投影图片附件块("QUJD", "image/png", 400, 300, 1000)
  断言相等(块2["width"], 400, "2a 原宽")
  断言相等(块2["height"], 300, "2b 原高")

  # ---- 3. 竖图（高为长边） ----
  设 块3 为 投影图片附件块("QUJD", "image/png", 300, 900, 300)
  断言相等(块3["height"], 300, "3a 高收边")
  断言相等(块3["width"], 100, "3b 宽等比")

  # ---- 4. 与 消息.造图片块 形状同构（回归锚点） ----
  设 原块 为 造图片块("QUJD", "image/png")
  遍历 键 之 字典键列表(原块):
    断言真(字典包含键(块, 键), "4a 保留键 " + 键)

  # ---- 5. 绳请求长边尺寸 直接调用（既有纯逻辑保留） ----
  设 尺寸 为 绳请求长边尺寸(100, 100, 50)
  断言相等(尺寸["width"], 50, "5a 方图收边")
  断言相等(尺寸["height"], 50, "5b 方图等比")

  打印 "--- 第6轮 任务E #285 附件投影接线 测试通过 ---"

主()