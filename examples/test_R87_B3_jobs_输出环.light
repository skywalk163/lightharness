从 输出环 导入 安全尾, 输出环
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 主程:
  # 1. 安全尾：ASCII 与多字节 UTF-8
  设 尾1 为 安全尾("ABCD", 2)
  断言相等(尾1["text"], "CD", "ASCII 尾 2 字节")
  断言相等(尾1["bytes"], 2, "ASCII 尾字节数")
  设 尾2 为 安全尾("会会", 3)
  断言相等(尾2["text"], "会", "单块超 cap 留一个完整字")
  断言相等(尾2["bytes"], 3, "留一个字 = 3 字节")
  # "A会" total=4, max=2 → target=2; 边界 0/1/4; 首个>=2 是 4 → 空尾
  设 尾3 为 安全尾("A会", 2)
  断言相等(尾3["text"], "", "窗口落在续字节上 → 空尾（不回退捞 A）")
  断言相等(尾3["bytes"], 0, "空尾 0 字节")
  设 尾4 为 安全尾("A会", 3)
  断言相等(尾4["text"], "会", "max=3 留会")
  断言相等(尾4["bytes"], 3, "会 3 字节")

  # 2. 追加与绝对偏移
  设 环 为 新建 输出环()
  断言相等(环.追加("", 空, 8), 假, "空串不写")
  断言相等(环.追加("hello", 空, 8), 真, "写 hello")
  断言相等(环.总数, 5, "total=5")
  断言相等(环.最早, 0, "保留全部 earliest=0")
  断言相等(环.追加("world", 空, 8), 真, "写 world")
  断言相等(环.总数, 10, "total=10")
  断言相等(环.保留字节, 5, "修头后保留 5 字节（world）")
  断言相等(环.最早, 5, "earliest 前进到 5（hello 被驱逐）")

  # 3. readFrom：重叠块 + lossy + next
  设 读1 为 环.读自(0)
  断言相等(读1["下一偏移"], 10, "next=total=10")
  断言相等(读1["有损"], 真, "from=0 < earliest=5 → 有损")
  断言相等(列表长度(读1["块表"]), 1, "只见 world 一块")
  断言相等(读1["块表"][0]["at"], 5, "world 绝对偏移 5")
  断言相等(读1["块表"][0]["text"], "world", "world 原文")
  设 读2 为 环.读自(5)
  断言相等(读2["有损"], 假, "from=5 == earliest → 非有损")
  断言相等(列表长度(读2["块表"]), 1, "from=5 仍见 world")
  设 读3 为 环.读自(10)
  断言相等(列表长度(读3["块表"]), 0, "from=total → 空")
  断言相等(读3["有损"], 假, "from=total 非有损")

  # 4. 单块超大：UTF-8 安全尾 + gapBefore
  设 环2 为 新建 输出环()
  环2.追加("会会会", 空, 5)
  断言相等(环2.总数, 9, "三会 total=9 字节")
  断言相等(环2.保留字节, 3, "只留 3 字节")
  断言相等(环2.最早, 6, "earliest=6（前两被裁）")
  设 读4 为 环2.读自(0)
  断言相等(列表长度(读4["块表"]), 1, "单块仍在")
  断言相等(读4["块表"][0]["text"], "会", "留尾部一个会")
  断言相等(读4["块表"][0]["at"], 6, "块 at 前进到 6")
  断言相等(读4["块表"][0]["gapBefore"], 真, "单块裁剪标 gapBefore")

  # 5. 流道透传
  设 环3 为 新建 输出环()
  环3.追加("out\n", ["channel": "stdout"], 64)
  环3.追加("err\n", ["channel": "stderr"], 64)
  设 读5 为 环3.读自(0)
  断言相等(读5["块表"][0]["channel"], "stdout", "stdout 流道透传")
  断言相等(读5["块表"][1]["channel"], "stderr", "stderr 流道透传")

  写 "test_R87_B3_jobs_输出环: 全部用例通过"

主程()
