# test_R48_hooks三事件.light —— 第48轮 任务3（#10 hooks三事件域深化：message/pause/resume）
#
# 运行：cd lightharness && python 运行.py examples/test_R48_hooks三事件.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖（纯逻辑面；#56 matcher 与既有钩子协议段零改动）：
#   message 域 —— hook-protocol events.ts 持久钩子消息对：概要化标准错误（500 上限+省略号）、
#      hook/invoked 载荷（matcher 缺省省略）、decision 派生（裁定优先 → 续行假 stop → pass）、
#      hook/result 载荷（退出码存在才带、stderr 概要非空才带、时长必带）
#   运行纯核 —— runner.ts：timeoutSec 秒转毫秒覆盖默认 10 分钟、信号致死退出码归一空、
#      基建故障产出（无退出码、失败记 stderr、非阻断）
#   pause 域 —— hook-protocol detached.ts 静默跟踪：登记幂等、落定即清、排水触发中止、
#      在飞非空续等、排水中迟到登记续等、清空即静默、恢复由新建跟踪器重新接纳
#   三钩子点 —— 钩子.light 纯决策：message 处理器否决优先且首个缘由浮出、
#      pause 在飞/迟到登记不可入暂停、resume 恢复三态（忙/待机/续跑，词表对齐 循恢复决策）
#
# 命名避坑：断言助手 检相等/检真，避开与被导入模块段同名。

从 钩子协议 导入 概要上限默认, 概要化标准错误, 造发起载荷, 派生钩子裁定, 造结果载荷
从 钩子协议 导入 默认钩子时长, 运行时长毫秒, 落码归一, 故障产出, 解析钩子产出
从 钩子协议 导入 造跟踪器, 跟踪登记, 跟踪落定, 跟踪排水决策, 造恢复跟踪器
从 钩子 导入 消息钩子判定, 暂停钩子决策, 恢复钩子决策

段落 检相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 检真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")
  返回 真

段落 主:
  打印 "===== 第48轮 任务3：hooks 三事件域深化（message/pause/resume） ====="

  # ============ 1) message 域：events.ts 持久钩子消息对 ============
  检相等(概要上限默认, 500, "消息_概要上限默认")
  检真(概要化标准错误("   ", 500) == 空, "消息_空白stderr概要为空")
  检相等(概要化标准错误("  坏了  ", 500), "坏了", "消息_去首尾空白")
  设 长文 为 ""
  设 序 为 0
  当 序 < 30:
    设 长文 为 长文 + "0123456789"
    设 序 为 序 + 1
  检相等(概要化标准错误(长文, 500), 长文, "消息_未超限原样")
  检相等(概要化标准错误(长文, 10), "0123456789…", "消息_超限截断加省略号")
  # hook/invoked 载荷：matcher 缺省省略
  检相等(造发起载荷(2, "PreToolUse", "codex", "h-1", 空), {"turn": 2, "point": "PreToolUse", "dialect": "codex", "handlerId": "h-1"}, "消息_发起载荷无甄别")
  检相等(造发起载荷(2, "PreToolUse", "codex", "h-1", "^bash$"), {"turn": 2, "point": "PreToolUse", "dialect": "codex", "handlerId": "h-1", "matcher": "^bash$"}, "消息_发起载荷带甄别")
  # decision 派生：已解析裁定优先；续行假 → stop；缺省 pass
  检相等(派生钩子裁定({"裁定": "deny"}), "deny", "消息_裁定优先")
  检相等(派生钩子裁定({"续行标志": 假}), "stop", "消息_续行假为stop")
  检相等(派生钩子裁定({}), "pass", "消息_缺省为pass")
  检相等(派生钩子裁定({"续行标志": 真}), "pass", "消息_续行真为pass")
  # hook/result 载荷：阻断产出（退出码 2）
  设 产 为 解析钩子产出(2, "", "超额", "PreToolUse")
  设 载荷 为 造结果载荷(1, "PreToolUse", "h-1", 产, 概要上限默认, 120)
  检相等(载荷, {"turn": 1, "point": "PreToolUse", "handlerId": "h-1", "decision": "block", "exitCode": 2, "stderrSummary": "超额", "durationMs": 120}, "消息_结果载荷阻断")
  # 干净退出：退出码 0 必带、空 stderr 概要省略
  设 产 为 解析钩子产出(0, "", "", "Stop")
  设 载荷 为 造结果载荷(1, "Stop", "h-2", 产, 500, 5)
  检相等(载荷, {"turn": 1, "point": "Stop", "handlerId": "h-2", "decision": "pass", "exitCode": 0, "durationMs": 5}, "消息_干净退出载荷")

  # ============ 2) runner 纯核 ============
  检相等(默认钩子时长, 600000, "运行_默认时长十分钟")
  检相等(运行时长毫秒(空, 默认钩子时长), 600000, "运行_无配置用兜底")
  检相等(运行时长毫秒(30, 600000), 30000, "运行_秒转毫秒覆盖")
  检真(落码归一(空) == 空, "运行_信号致死无码")
  检相等(落码归一(2), 2, "运行_数值码原样")
  设 产 为 故障产出("shell 不可用")
  检相等(产["退出码"], 空, "运行_故障无退出码")
  检相等(产["标准错误"], "shell 不可用", "运行_故障记stderr")
  检真(字典包含键(产, "裁定") == 假, "运行_故障非阻断")

  # ============ 3) pause 域：detached 静默跟踪 ============
  设 跟 为 造跟踪器()
  检真(跟["已中止"] == 假, "挂起_初始未中止")
  跟踪登记(跟, "run-1")
  跟踪登记(跟, "run-2")
  跟踪登记(跟, "run-1")
  检相等(长(跟["在飞表"]), 2, "挂起_登记幂等")
  设 判 为 跟踪排水决策(跟, 假)
  检真(判["续等"], "挂起_在飞非空续等")
  检相等(判["缘由"], "in-flight", "挂起_在飞缘由")
  检真(跟["已中止"], "挂起_排水触发中止")
  跟踪落定(跟, "run-1")
  跟踪落定(跟, "run-2")
  检相等(长(跟["在飞表"]), 0, "挂起_落定即清")
  设 判 为 跟踪排水决策(跟, 真)
  检真(判["续等"], "挂起_迟到登记续等")
  检相等(判["缘由"], "late-track", "挂起_迟到缘由")
  设 判 为 跟踪排水决策(跟, 假)
  检真(判["续等"] == 假, "挂起_清空即静默")
  # 恢复：排水后的恢复接纳 = 新建跟踪器
  设 恢复跟 为 造恢复跟踪器()
  跟踪登记(恢复跟, "run-9")
  检相等(长(恢复跟["在飞表"]), 1, "挂起_恢复跟踪器重新接纳")
  检真(恢复跟["已中止"] == 假, "挂起_恢复跟踪器未中止")

  # ============ 4) 三钩子点（钩子.light 纯决策） ============
  # message：无人表态放行；否决拒绝且首个缘由浮出
  设 判 为 消息钩子判定([])
  检真(判["放行"], "点_无处理器放行")
  设 判 为 消息钩子判定([空, {"裁定": "enter"}])
  检真(判["放行"], "点_不表态放行")
  设 判 为 消息钩子判定([{"裁定": "reject", "缘由": "禁止"}, {"裁定": "reject", "缘由": "其二"}])
  检真(判["放行"] == 假, "点_否决拒绝")
  检相等(判["缘由"], "禁止", "点_首个缘由浮出")
  设 判 为 消息钩子判定([{"裁定": "reject", "缘由": ""}])
  检相等(判["缘由"], "", "点_空缘由仍拒绝")
  # pause：静默可暂停；在飞/迟到登记不可入暂停
  设 判 为 暂停钩子决策(0, 0)
  检真(判["可暂停"], "点_静默可暂停")
  设 判 为 暂停钩子决策(1, 0)
  检真(判["可暂停"] == 假, "点_在飞不可暂停")
  检真(判["续等"], "点_在飞需续等")
  设 判 为 暂停钩子决策(0, 2)
  检真(判["可暂停"] == 假, "点_迟到登记不可暂停")
  检相等(判["缘由"], "late-track", "点_迟到缘由")
  # resume：恢复三态（忙/待机/续跑）
  设 判 为 恢复钩子决策("running", 真, 假, 真, 假)
  检相等(判["动作"], "忙", "点_非idle忙")
  检真(判["可恢复"] == 假, "点_非idle不可恢复")
  设 判 为 恢复钩子决策("idle", 假, 假, 真, 假)
  检相等(判["动作"], "忙", "点_排水未清忙")
  设 判 为 恢复钩子决策("idle", 真, 假, 真, 真)
  检相等(判["动作"], "待机", "点_否决待机")
  检真(判["可恢复"] == 假, "点_否决不可恢复")
  设 判 为 恢复钩子决策("idle", 真, 真, 假, 假)
  检相等(判["动作"], "续跑", "点_待唤续跑")
  检真(判["可恢复"], "点_续跑可恢复")
  设 判 为 恢复钩子决策("idle", 真, 假, 真, 假)
  检相等(判["动作"], "续跑", "点_有待办续跑")
  设 判 为 恢复钩子决策("idle", 真, 假, 假, 假)
  检相等(判["动作"], "待机", "点_无事待机")
  检真(判["可恢复"], "点_待机可恢复")

  打印 "R48 hooks三事件：消息对/运行纯核/挂起静默/三钩子点 全部通过"

主()
