# test_超时策略.light —— 对标 #52：超时策略与超时工具纯逻辑 反跑测试
# 覆盖边界：
#   - 读超时限定：正有效值 / 超阈值 / 负数 / 0 / 缺省 / 无上限
#   - 推导截止：无超时 / 无超时+已中止 / 超时优先 / 取消优先 / 正常剩余 / 已超时后取消
#   - 推导缘由：code 匹配 / 不匹配 / 空对象 / 缺代码键
#   - 读时长毫秒：限定 / 限定超阈值 / 不定 / 跟随 / 空策略 / 缺种类 / 限定缺毫秒
#   - 判定策略结局：无超时→继续 / 继续剩余 / 超时获胜→TOOL_TIMEOUT / 取消优先 / 上限 clamp 生效
# 反跑判据：把任一 断言相等 的期望值改反即红；把任一 检查抛错 用例改为不抛即红。
# 命名避开词根（取/原因/工具/模式/返回/包含 等）；断言一律走 抛出（L-037）。

从 JSON 导入 序列化JSON
从 超时策略 导入 读超时限定, 推导截止, 推导缘由, 读时长毫秒, 判定策略结局

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

# ---- clampTimeout（读超时限定） ----
段落 用例clamp:
  断言相等(读超时限定(30, 50, 100), 30, "正有效值原样保留")
  断言相等(读超时限定(200, 50, 100), 100, "超阈值被掐到上限")
  断言相等(读超时限定(-5, 50, 100), 50, "负值回落默认")
  断言相等(读超时限定(0, 50, 100), 50, "零回落默认")
  断言相等(读超时限定(空, 50, 100), 50, "缺省回落默认")
  断言相等(读超时限定(200, 50, 空), 200, "无上限则原样保留")
  断言相等(读超时限定(10, 50, 100), 10, "低于上限小于默认也保留请求值")
  断言相等(读超时限定(120, 90, 100), 100, "超阈值大于默认仍掐到上限")

# ---- deadline（推导截止） ----
段落 用例截止:
  # 无超时
  设 无 = 推导截止(0, 假, 1000)
  断言相等(无["剩余毫秒"], 空, "无超时剩余为空")
  断言相等(无["被中止"], 假, "无超时未中止")
  设 无中止 = 推导截止(空, 真, 100)
  断言相等(无中止["剩余毫秒"], 空, "无超时剩余为空(中止)")
  断言相等(无中止["被中止"], 真, "无超时仍可中止")
  # 超时优先（未中止但已耗达/超时）
  设 到点 = 推导截止(100, 假, 100)
  断言相等(到点["剩余毫秒"], 0, "恰好到点→超时获胜")
  断言相等(到点["被中止"], 假, "超时获胜不算中止")
  设 越过 = 推导截止(100, 假, 150)
  断言相等(越过["剩余毫秒"], 0, "已越过→超时获胜")
  # 中止优先（已中止，即便未到点）
  设 中止 = 推导截止(100, 真, 30)
  断言相等(中止["剩余毫秒"], 70, "中止优先保留剩余")
  断言相等(中止["被中止"], 真, "中止优先已中止")
  # 已超时后中止：cancel 仍先赢，剩余钳到 0
  设 迟中止 = 推导截止(100, 真, 200)
  断言相等(迟中止["剩余毫秒"], 0, "超时后中止剩余钳 0")
  断言相等(迟中止["被中止"], 真, "超时后中止仍算中止")
  # 正常剩余
  设 中 = 推导截止(100, 假, 40)
  断言相等(中["剩余毫秒"], 60, "正常剩余")
  断言相等(中["被中止"], 假, "未中止未中止")

# ---- timeoutOf（推导缘由） ----
段落 用例缘由:
  断言相等(推导缘由(["代码": "total"]), "total", "code total→total")
  断言相等(推导缘由(["代码": "length"]), "length", "code length→length")
  断言相等(推导缘由(["代码": "idle"]), "idle", "code idle→idle")
  断言相等(推导缘由(["代码": "EIO"]), 空, "code 不匹配→空")
  断言相等(推导缘由(["其他": 1]), 空, "缺代码键→空")
  断言相等(推导缘由(空), 空, "空对象→空")

# ---- timeoutMs 读取（读时长毫秒） ----
段落 用例读毫秒:
  断言相等(读时长毫秒(["种类": "限定", "毫秒": 30], 50, 100), 30, "限定原样")
  断言相等(读时长毫秒(["种类": "限定", "毫秒": 200], 50, 100), 100, "限定超阈值掐头")
  断言相等(读时长毫秒(["种类": "限定"], 50, 100), 50, "限定缺毫秒回落默认")
  断言相等(读时长毫秒(["种类": "不定"], 50, 100), 0, "不定→无本地超时")
  断言相等(读时长毫秒(["种类": "跟随"], 50, 100), 0, "跟随→无本地超时")
  断言相等(读时长毫秒(["其他": 1], 50, 100), 50, "缺种类回落默认")
  断言相等(读时长毫秒(空, 50, 100), 50, "空策略回落默认")

# ---- timeout-policy 判定策略结局 ----
段落 用例判定:
  # 无本地超时 → 继续（剩余空）
  设 无 = 判定策略结局(["种类": "不定"], 假, 5000, 50, 100)
  断言相等(无["种类"], "继续", "不定→继续")
  断言相等(无["剩余毫秒"], 空, "不定→剩余空")
  # 限定未到点 → 继续（剩余）且取消优先
  设 续 = 判定策略结局(["种类": "限定", "毫秒": 100], 假, 40, 50, 1000)
  断言相等(续["种类"], "继续", "限定未到点→继续")
  断言相等(续["剩余毫秒"], 60, "限定未到点剩余 60")
  设 停 = 判定策略结局(["种类": "限定", "毫秒": 100], 真, 30, 50, 1000)
  断言相等(停["种类"], "中止", "已中止→中止优先")
  断言相等(停["剩余毫秒"], 70, "已中止→剩余 70")
  # 超时获胜 → 结构化 TOOL_TIMEOUT（缘由跟随策略）
  设 超时 = 判定策略结局(["种类": "限定", "毫秒": 100, "缘由": "length"], 假, 100, 50, 1000)
  断言相等(超时["种类"], "tool-timeout", "到点→tool-timeout")
  断言相等(超时["代码"], "TOOL_TIMEOUT", "结构化代码")
  断言相等(超时["缘由"], "length", "缘由取自策略")
  断言相等(超时["超时毫秒"], 100, "超时毫秒")
  断言相等(超时["剩余毫秒"], 0, "超时→剩余 0")
  # 超阈值 clamp 生效后仍超时
  设 掐 = 判定策略结局(["种类": "限定", "毫秒": 5000], 假, 5000, 50, 100)
  断言相等(掐["种类"], "tool-timeout", "上限 clamp 后仍超时")
  断言相等(掐["超时毫秒"], 100, "clamp 后超时毫秒")
  # 默认预填：限定 30 但 elapsed 远超默认 50 → 仍超时（默认生效）
  设 默 = 判定策略结局(["种类": "限定", "毫秒": 30], 假, 5000, 50, 100)
  断言相等(默["种类"], "tool-timeout", "限定小于默认按请求值")
  断言相等(默["超时毫秒"], 30, "请求值优先于默认")

用例clamp()
用例截止()
用例缘由()
用例读毫秒()
用例判定()
写 "--- 超时策略与超时工具纯逻辑（#52）测试通过 ---"