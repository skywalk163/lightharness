# test_R176_截图坐标协议.light —— B4 路 #11 cua 截图/坐标协议判据
# 上游锚点：packages/experimental/cua/src/{protocol.ts,coordinates.ts} @ dsh-v0.2.1-rc.3
# 反跑判据：把 图协换算单轴 的相对钳制删掉（或把 SCREENSHOT_REQUIRED 分支删掉）→ 本文件必红。

从 截图坐标协议 导入 图协方法表, 图协是方法, 图协坐标方法表, 图协校验坐标, 图协校验相对, 图协校验标识, 图协校验进程号, 图协是规范base64, 图协造坐标表, 图协观察窗口, 图协绑截图, 图协取帧, 图协换算单轴, 图协换算参数

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 断言近(甲, 乙, 信息):
  设 差 为 甲 - 乙
  如果 差 < 0:
    设 差 为 0 - 差
  如果 差 > 0.0001:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 造窗口(号, 宽, 高):
  设 界 为 {"x": 0, "y": 0, "width": 宽, "height": 高}
  返回 {"windowId": 号, "bounds": 界}

段落 主:
  # ---------- §1 方法表 ----------
  断言相等(长度(图协方法表()), 19, "§1 19 个 method（18 个业务 + screenshot）")
  断言真(图协是方法("screenshot"), "§1b screenshot 在表内")
  断言真(图协是方法("drag"), "§1c drag 在表内")
  断言相等(图协是方法("delete"), 假, "§1d 未声明方法拒绝（严格判别联合）")
  断言相等(长度(图协坐标方法表()), 4, "§1e 四个坐标方法")

  # ---------- §2 取值域 ----------
  断言相等(图协校验坐标(0), "", "§2 0 合法")
  断言相等(图协校验坐标(12.5), "", "§2b 小数合法")
  断言相等(图协校验坐标(0 - 1), "Expected a nonnegative coordinate", "§2c 负数拒绝")
  断言相等(图协校验相对(0), "", "§2d 相对下界")
  断言相等(图协校验相对(1000), "", "§2e 相对上界")
  断言相等(图协校验相对(1001), "Expected an integer thousandth between 0 and 1000", "§2f 相对越界")
  断言相等(图协校验相对(1.5), "Expected an integer thousandth between 0 and 1000", "§2g 相对必须整数")
  断言相等(图协校验标识(1), "", "§2h id 下界")
  断言相等(图协校验标识(4294967295), "", "§2i id 上界")
  断言相等(图协校验标识(4294967296), "Expected a positive integer identifier", "§2j id 越界")
  断言相等(图协校验进程号(2147483647), "", "§2k pid 上界")
  断言相等(图协校验进程号(2147483648), "Expected a positive process identifier", "§2l pid 越界")

  # ---------- §3 规范 base64 ----------
  断言真(图协是规范base64("aGVsbG8="), "§3 带一个 padding 的规范串")
  断言真(图协是规范base64("aGk="), "§3b 短串")
  断言真(图协是规范base64("YWJj"), "§3c 无 padding 但长度对齐")
  断言相等(图协是规范base64("aGVsbG8"), 假, "§3d 缺 padding 拒绝")
  断言相等(图协是规范base64("aGVs bG8="), 假, "§3e 含空白拒绝")
  断言相等(图协是规范base64("aGVsbG8=x"), 假, "§3f 非字母表字符拒绝")
  断言相等(图协是规范base64(""), 假, "§3g 空串拒绝")
  断言相等(图协是规范base64("abc"), 假, "§3h 长度非 4 倍数拒绝")
  断言相等(图协是规范base64("ab=="), 假, "§3i 非零 pad 位拒绝（ab== 的重编码是 aQ==）")

  # ---------- §4 观察与失效 ----------
  设 表 为 图协造坐标表()
  设 窗表 为 [造窗口(7, 800, 600)]
  图协观察窗口(表, "app1", 窗表, 空)
  设 帧1 为 图协取帧(表, "app1", 7)
  断言相等(帧1["宽"], 800, "§4 观察建帧")
  断言相等(帧1["图像"], 空, "§4b 新帧无截图绑定")

  图协绑截图(表, "app1", 7, 800, 600, 1600, 1200)
  设 帧2 为 图协取帧(表, "app1", 7)
  断言相等(帧2["图像"]["宽"], 1600, "§4c 截图绑定图素")

  # 尺寸未变 → 保留旧帧（连同已绑定截图）
  图协观察窗口(表, "app1", [造窗口(7, 800, 600)], 空)
  断言相等(图协取帧(表, "app1", 7)["图像"]["宽"], 1600, "§4d 尺寸未变保留旧映射")

  # 尺寸变化 → 换新帧，截图绑定失效
  图协观察窗口(表, "app1", [造窗口(7, 1024, 768)], 空)
  设 帧3 为 图协取帧(表, "app1", 7)
  断言相等(帧3["宽"], 1024, "§4e 尺寸变化换新帧")
  断言相等(帧3["图像"], 空, "§4f 尺寸变化即失效旧截图映射")

  # 局部观察：windowId 不在观测里 → 删除该窗口
  图协观察窗口(表, "app1", [造窗口(7, 1024, 768), 造窗口(8, 400, 300)], 空)
  断言相等(图协取帧(表, "app1", 8)["宽"], 400, "§4g 第二个窗口入表")
  图协观察窗口(表, "app1", [造窗口(7, 1024, 768)], 8)
  断言相等(图协取帧(表, "app1", 8), 空, "§4h 窗口关闭后映射删除")
  断言相等(图协取帧(表, "app1", 7)["宽"], 1024, "§4i 局部观察不影响其它窗口")

  # ---------- §5 坐标换算 ----------
  # 相对：千分比 → 点，钳制到 轴-1
  设 相1 为 图协换算单轴(500, 800, 1600, 真)
  断言近(相1["值"], 400, "§5 500‰ = 半宽")
  设 相2 为 图协换算单轴(1000, 800, 1600, 真)
  断言近(相2["值"], 799, "§5b 1000‰ 钳制到 宽-1")

  # 绝对：按截图图素换算
  设 绝1 为 图协换算单轴(800, 800, 1600, 假)
  断言近(绝1["值"], 400, "§5c 图素 800/1600 → 半宽")
  设 绝2 为 图协换算单轴(1600, 800, 1600, 假)
  断言相等(绝2["码"], "INVALID_ARGUMENT", "§5d 越界拒绝")
  断言相等(绝2["错误"], "Coordinate is outside the latest screenshot", "§5e 越界文案")

  # ---------- §6 参数换算总入口 ----------
  设 表2 为 图协造坐标表()
  图协观察窗口(表2, "app1", [造窗口(7, 800, 600)], 空)

  # 无帧 → STALE_SNAPSHOT
  设 无帧 为 图协换算参数(表2, "app9", 7, {"x": 10, "y": 10})
  断言相等(无帧["码"], "STALE_SNAPSHOT", "§6 无帧拒绝")
  断言相等(无帧["错误"], "Read fresh window state before coordinate input", "§6b STALE 文案")

  # 有帧但无截图 + 绝对坐标 → SCREENSHOT_REQUIRED
  设 无图 为 图协换算参数(表2, "app1", 7, {"x": 10, "y": 10})
  断言相等(无图["码"], "SCREENSHOT_REQUIRED", "§6c 绝对坐标需先截图")
  断言相等(无图["错误"], "Take a fresh screenshot before using absolute pixel coordinates", "§6d 文案")

  # 相对坐标无需截图
  设 相参 为 图协换算参数(表2, "app1", 7, {"x": 500, "y": 500, "relative": 真})
  断言相等(相参["码"], "", "§6e 相对坐标无需截图")
  断言近(相参["参数"]["x"], 400, "§6f 相对换算结果")
  断言相等(字典包含键(相参["参数"], "relative"), 假, "§6g relative 选项被删除（Host 专有）")

  # 绑定截图后绝对坐标可换算
  图协绑截图(表2, "app1", 7, 800, 600, 1600, 1200)
  设 绝参 为 图协换算参数(表2, "app1", 7, {"x": 800, "y": 600})
  断言相等(绝参["码"], "", "§6h 绝对坐标可换算")
  断言近(绝参["参数"]["x"], 400, "§6i 横轴换算")
  断言近(绝参["参数"]["y"], 300, "§6j 纵轴换算")

  # 拖拽四角
  设 拖参 为 图协换算参数(表2, "app1", 7, {"fromX": 0, "fromY": 0, "toX": 1600, "toY": 1200})
  断言相等(拖参["码"], "INVALID_ARGUMENT", "§6k 拖拽终点越界拒绝")
  设 拖参2 为 图协换算参数(表2, "app1", 7, {"fromX": 0, "fromY": 0, "toX": 800, "toY": 600})
  断言相等(拖参2["码"], "", "§6l 拖拽四角合法")
  断言近(拖参2["参数"]["toX"], 400, "§6m 拖拽终点换算")

  # 无坐标键原样返回
  设 纯参 为 图协换算参数(表2, "app1", 7, {"appHandle": "app1", "windowId": 7})
  断言相等(纯参["码"], "", "§6n 无坐标键不换算")
  断言相等(纯参["参数"]["windowId"], 7, "§6o 原样返回")

  打印("test_R176_截图坐标协议: 全部用例通过")

主()
