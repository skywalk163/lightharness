# test_工具深.light —— 工具执行流水线深对齐测试（T10-05 验收 §4）
# 覆盖：
#   §4.1 schema 校验通过（含嵌套 object + 数组 item）
#   §4.2 缺 required → isError + 字段路径(列表) + 原因 missing（反跑判据：isError 改假→红）
#   §4.3 类型/枚举/正则 错误
#   §4.4 prepare/finalize 调用顺序 + 改参数 + 拒绝（反跑判据：prepare 计数改反→红）
#   §4.5 轻量不回归：注册/执行/未知工具

从 工具 导入 校验参数, 工具注册表, 造工具定义, 造工具模式, 造工具结果, 解析参数

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 加上 " 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 主:
  # ---------- §4.1 合法参数（嵌套 object + 数组 item）----------
  设 嵌套模式 为 ["type": "object", "properties": ["配置": ["type": "object", "properties": ["超时": ["type": "number"], "名字": ["type": "string"]], "required": ["超时", "名字"]], "标签": ["type": "array", "items": ["type": "string"]]], "required": ["配置", "标签"]]
  设 合法参数 为 ["配置": ["超时": 5, "名字": "x"], "标签": ["a", "b"]]
  设 错1 为 校验参数(嵌套模式, 合法参数)
  断言相等(长(错1), 0, "嵌套合法无错误")

  设 注册表 为 新建 工具注册表()
  段落 回显 接收 参数:
    返回 [["type": "text", "text": "ok"]]
  注册表.注册(造工具定义("回显", "回显", 嵌套模式, 回显))
  设 结果1 为 注册表.执行("回显", "{\"配置\": {\"超时\": 5, \"名字\": \"x\"}, \"标签\": [\"a\", \"b\"]}")
  断言相等(结果1["isError"], 假, "嵌套合法执行成功")

  # ---------- §4.2 缺 required → isError + 字段路径(列表) + missing ----------
  设 秒模式 为 ["type": "object", "properties": ["秒": ["type": "number"]], "required": ["秒"]]
  设 错2 为 校验参数(秒模式, ["其他": 1])
  断言相等(长(错2), 1, "缺秒有1错误")
  断言相等(错2[0]["路径"], ["参数", "秒"], "字段路径为[参数,秒]")
  断言相等(错2[0]["原因"], "missing", "原因为missing")

  段落 恒回 接收 参数:
    返回 [["type": "text", "text": "x"]]
  注册表.注册(造工具定义("定时器", "定时器", 秒模式, 恒回))
  设 结果2 为 注册表.执行("定时器", "{\"其他\": 1}")
  断言相等(结果2["isError"], 真, "缺必填→isError")            # 反跑判据：改 假→红
  断言相等(结果2["error"]["代码"], "PARAM_SCHEMA_INVALID", "校验失败代码")
  断言相等(结果2["error"]["字段错误"][0]["原因"], "missing", "错误含missing")
  断言相等(结果2["error"]["字段错误"][0]["路径"], ["参数", "秒"], "错误含字段路径")

  # ---------- §4.3 类型 / 枚举 / 正则 错误 ----------
  设 错3 为 校验参数(秒模式, ["秒": "不是数字"])
  断言相等(长(错3), 1, "类型错误1条")
  断言相等(错3[0]["原因"], "type", "原因为type")               # 反跑判据：改 非type→红

  设 枚举模式 为 ["type": "object", "properties": ["颜色": ["type": "string", "enum": ["红", "绿"]]], "required": ["颜色"]]
  设 错4 为 校验参数(枚举模式, ["颜色": "蓝"])
  断言相等(错4[0]["原因"], "enum", "原因为enum")               # 反跑判据：改 非enum→红

  设 正则模式 为 ["type": "object", "properties": ["码": ["type": "string", "pattern": "^\\d+$"]], "required": ["码"]]
  设 错5 为 校验参数(正则模式, ["码": "abc"])
  断言相等(错5[0]["原因"], "pattern", "原因为pattern")         # 反跑判据：改 非pattern→红

  # 数字范围
  设 范围模式 为 ["type": "object", "properties": ["年龄": ["type": "integer", "minimum": 0, "maximum": 120]], "required": ["年龄"]]
  设 错6 为 校验参数(范围模式, ["年龄": 200])
  断言相等(错6[0]["原因"], "maximum", "原因为maximum")
  设 错7 为 校验参数(范围模式, ["年龄": -5])
  断言相等(错7[0]["原因"], "minimum", "原因为minimum")

  # ---------- §4.4 prepare / finalize 顺序 + 改参数 + 拒绝 ----------
  设 计数 为 ["准备": 0, "执行": 0, "收尾": 0]
  段落 准备段 接收 参数:
    计数["准备"] = 计数["准备"] + 1
    参数["补全"] = 真
    返回 参数
  段落 执行段 接收 参数:
    计数["执行"] = 计数["执行"] + 1
    返回 [["type": "text", "text": "补全=" 加上 转字符串(参数["补全"])]]
  段落 收尾段 接收 结果, 参数:
    计数["收尾"] = 计数["收尾"] + 1

  注册表.注册(造工具定义("钩子", "钩子工具", ["type": "object"], 执行段, "parallel", 准备段, 收尾段))
  设 结果6 为 注册表.执行("钩子", "{}")
  断言相等(结果6["isError"], 假, "钩子执行成功")
  断言相等(计数["准备"], 1, "prepare调用1次")                 # 反跑判据：改 0→红
  断言相等(计数["执行"], 1, "execute调用1次")
  断言相等(计数["收尾"], 1, "finalize调用1次")
  断言真(结果6["content"][0]["text"] == "补全=True", "prepare改的参数传入execute")

  # 拒绝：prepare 抛错
  段落 拒绝准备 接收 参数:
    抛出 "被拒绝"
  注册表.注册(造工具定义("拒绝工具", "拒绝", ["type": "object"], 执行段, "parallel", 拒绝准备, 收尾段))
  设 结果7 为 注册表.执行("拒绝工具", "{}")
  断言相等(结果7["isError"], 真, "prepare拒绝→isError")
  断言相等(结果7["error"]["代码"], "TOOL_PREPARE_FAILED", "拒绝代码")

  # ---------- §4.5 轻量不回归 ----------
  断言相等(注册表.有无("回显"), 真, "回显已注册")
  断言相等(注册表.执行策略("回显"), "parallel", "默认并行")
  设 结果8 为 注册表.执行("不存在", "{}")
  断言相等(结果8["isError"], 真, "未知工具失败")
  断言相等(结果8["error"]["代码"], "TOOL_NOT_FOUND", "未知工具代码")
  断言相等(解析参数(""), {}, "空参数→{}")
  断言相等(解析参数("{\"x\": 1}")["x"], 1, "合法JSON解析")

  # ---------- §4.6 对齐原版强制子集新增关键字（oneOf / additionalProperties:false / type:null）----------
  # oneOf：精确匹配一个分支
  设 oneOf模式 为 ["type": "object", "properties": ["值": ["oneOf": [["type": "string"], ["type": "number"]]]], "required": ["值"]]
  断言相等(长(校验参数(oneOf模式, ["值": "abc"])), 0, "oneOf 匹配string通过")
  断言相等(长(校验参数(oneOf模式, ["值": 42])), 0, "oneOf 匹配number通过")
  设 oneOf错1 为 校验参数(oneOf模式, ["值": 真])
  断言相等(长(oneOf错1), 1, "oneOf 不匹配任何→1错")
  断言相等(oneOf错1[0]["原因"], "oneOf", "oneOf 原因")
  # oneOf 精确匹配：同时命中两个分支应报错
  设 双匹配 为 ["oneOf": [["type": "string"], ["const": "hello"]]]
  设 oneOf错2 为 校验参数(双匹配, "hello")
  断言相等(长(oneOf错2), 1, "oneOf 命中两分支→1错(精确匹配)")
  断言相等(oneOf错2[0]["原因"], "oneOf", "oneOf 精确匹配原因")

  # additionalProperties:false → 拒绝未声明键
  设 闭模式 为 ["type": "object", "properties": ["a": ["type": "string"]], "additionalProperties": 假]
  断言相等(长(校验参数(闭模式, ["a": "x"])), 0, "仅声明键通过")
  设 闭错 为 校验参数(闭模式, ["a": "x", "b": "y"])
  断言相等(长(闭错), 1, "额外键→1错")
  断言相等(闭错[0]["原因"], "additionalProperties", "additionalProperties 原因")
  断言相等(闭错[0]["路径"], ["参数", "b"], "额外键路径[参数,b]")

  # type:null
  设 空模式 为 ["type": "null"]
  断言相等(长(校验参数(空模式, 空)), 0, "null类型值通过")
  设 空错 为 校验参数(空模式, "x")
  断言相等(长(空错), 1, "null类型非null→1错")
  断言相等(空错[0]["原因"], "type", "null类型原因")
  # enum/const 含 null（原版 JsonSchemaScalar 含 null）
  设 空枚举 为 ["type": "null", "enum": [空, 1]]
  断言相等(长(校验参数(空枚举, 空)), 0, "enum含null且值为null通过")
  断言相等(长(校验参数(空枚举, 2)), 1, "enum含null值不符→1错")

  打印 "--- test_工具深 通过 ---"

主()
