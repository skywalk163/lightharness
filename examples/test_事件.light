# test_事件.light —— 事件总线测试（订阅/发布/瀑布/取消/闭包捕获）
# ⚠️ 光明缺陷：闭包内不能直接改外层局部标量（UnboundLocalError），需用可变字典承载共享状态。
从 事件 导入 事件总线

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 状态 为 {"计数": 0, "顺序": "", "顺序2": "", "计数2": 0}

  # ---- 订阅 + 发布 ----
  设 总线 为 新建 事件总线()
  段落 处理器A 接收 参数:
    状态["计数"] = 状态["计数"] + 1
    参数["命中"] 为 真
  总线.订阅("agent/开始", 处理器A)
  设 参数1 为 ["x": 1]
  总线.发布("agent/开始", 参数1)
  断言等于(状态["计数"], 1, "发布一次调用一次")
  断言等于(参数1["命中"], 真, "监听器可改参数")

  # ---- 瀑布：消费停链 ----
  段落 监听B 接收 参数:
    状态["顺序"] = 状态["顺序"] + "B"
    返回 假
  段落 监听C 接收 参数:
    状态["顺序"] = 状态["顺序"] + "C"
    返回 真
  段落 监听D 接收 参数:
    状态["顺序"] = 状态["顺序"] + "D"
    返回 假
  段落 收尾E 接收 参数:
    状态["顺序"] = 状态["顺序"] + "E"
  总线.订阅("agent/请求", 监听B)
  总线.订阅("agent/请求", 监听C)
  总线.订阅("agent/请求", 监听D)
  设 瀑布结果 为 总线.瀑布("agent/请求", {}, 收尾E)
  断言等于(状态["顺序"], "BC", "C 消费停链，D 与收尾不执行")
  断言等于(瀑布结果, 真, "瀑布返回消费")

  # ---- 瀑布：无人消费则收尾 ----
  段落 监听F 接收 参数:
    状态["顺序2"] = 状态["顺序2"] + "F"
    返回 假
  段落 收尾G 接收 参数:
    状态["顺序2"] = 状态["顺序2"] + "G"
  总线.订阅("agent/其他", 监听F)
  设 瀑布结果2 为 总线.瀑布("agent/其他", {}, 收尾G)
  断言等于(状态["顺序2"], "FG", "无人消费则收尾执行")
  断言等于(瀑布结果2, 假, "瀑布返回未消费")

  # ---- 有监听器 ----
  断言等于(总线.有监听器("agent/开始"), 真, "已有监听器")
  断言等于(总线.有监听器("不存在"), 假, "无监听器")

  # ---- 取消处理器（闭包捕获） ----
  设 取消 为 总线.订阅("agent/临时", 处理器A)
  断言等于(总线.有监听器("agent/临时"), 真, "订阅后存在")
  取消()
  断言等于(总线.有监听器("agent/临时"), 假, "取消后移除")
  总线.发布("agent/临时", {})
  断言等于(状态["计数"], 1, "取消后不再触发")

  打印 "--- 事件总线测试通过 ---"

主()
