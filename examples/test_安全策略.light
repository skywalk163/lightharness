# test_安全策略.light —— 安全策略模块测试
# 覆盖：凭证名校验、脱敏（值/文本/白名单）、匿名ID生成/校验/一致性、
#        策略谓词（规则匹配/默认允许）、ACL规则解析/判定（拒绝优先）、
#        溢出目录命名/阈值判定/清理顺序/清理目标
#
# 反跑判据见文件末尾注释块。

从 安全策略 导入 校验凭证名, 判定敏感名, 脱敏值, 脱敏文本, 判定已脱敏, 构造匿名标识, 校验匿名标识, 判定标识一致, 策略谓词, 解析界限规则, 访问界限规则, 界限判定器, 构造溢出目录名, 判定超阈, 溢出条目, 整理清理顺序, 计算清理目标

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言失败(期望真): " + 标签)

段落 断言假 接收 条件, 标签:
  如果 条件 != 假:
    抛出 新建 错误("断言失败(期望假): " + 标签)

# 辅助：恒真判定函数（策略谓词用）
段落 恒真 接收 上下文:
  返回 真

# 辅助：恒假判定函数
段落 恒假 接收 上下文:
  返回 假

# ===== 1. 凭证名校验 =====
段落 测试凭证名:
  断言真(校验凭证名("API_KEY"), "合法名 API_KEY")
  断言真(校验凭证名("_secret"), "合法名 _secret")
  断言真(校验凭证名("a"), "合法名单字符")
  断言假(校验凭证名(""), "空名不合法")
  断言假(校验凭证名("123abc"), "数字开头不合法")
  断言假(校验凭证名("key-dash"), "含连字符不合法")
  断言假(校验凭证名("key space"), "含空格不合法")

# ===== 2. 敏感名判定 =====
段落 测试敏感名:
  设 黑名单 为 ["SECRET", "KEY", "TOKEN", "PASSWORD"]
  断言真(判定敏感名("API_SECRET", 黑名单), "含 SECRET")
  断言真(判定敏感名("MY_KEY", 黑名单), "含 KEY")
  断言真(判定敏感名("ACCESS_TOKEN", 黑名单), "含 TOKEN")
  断言假(判定敏感名("USERNAME", 黑名单), "不含任何黑名单词")
  断言假(判定敏感名("普通配置", 黑名单), "中文名不在黑名单")

# ===== 3. 脱敏值 =====
段落 测试脱敏值:
  断言相等(脱敏值("sk-abc12345", 2, 2), "sk***45", "保留头2尾2")
  断言相等(脱敏值("abcdef", 2, 2), "ab***ef", "6字符保留头2尾2")
  断言相等(脱敏值("ab", 2, 2), "***", "短于头+尾返回星号")
  断言相等(脱敏值("abc", 2, 2), "***", "等于头+尾返回星号")
  断言相等(脱敏值("abcde", 2, 2), "ab***de", "恰好头+尾+1字符")
  断言相等(脱敏值("sk-abcdefghij", 3, 4), "sk-***ghij", "保留头3尾4")

# ===== 4. 脱敏文本 =====
段落 测试脱敏文本:
  设 前缀表 为 ["sk-"]
  设 空白名单 为 []
  断言相等(脱敏文本("key=sk-abc12345 end", 前缀表, 空白名单), "key=sk***45 end", "脱敏sk-凭证")
  断言相等(脱敏文本("no secrets here", 前缀表, 空白名单), "no secrets here", "无匹配不变")
  断言相等(脱敏文本("sk-abc sk-xyz", 前缀表, 空白名单), "sk***bc sk***yz", "多匹配全脱敏")
  设 白名单 为 ["sk-abc12345"]
  断言相等(脱敏文本("key=sk-abc12345 end", 前缀表, 白名单), "key=sk-abc12345 end", "白名单不脱敏")
  断言真(判定已脱敏("sk***45"), "含星号判定已脱敏")
  断言假(判定已脱敏("sk-abc12345"), "无星号判定未脱敏")

# ===== 5. 匿名ID生成与校验 =====
段落 测试匿名标识:
  设 标识 为 构造匿名标识("user1", "salt")
  断言真(开头(标识, "anon-"), "标识前缀 anon-")
  断言相等(字符串长度(标识), 13, "标识长度=5+8")
  断言真(校验匿名标识(标识), "合法标识校验通过")
  断言假(校验匿名标识("anon xyz"), "非法格式校验失败")
  断言假(校验匿名标识("anon-1234567"), "7位后缀不合法")
  断言假(校验匿名标识("anon-123456789"), "9位后缀不合法")
  断言假(校验匿名标识("anon-ZZZZZZZZ"), "非十六进制不合法")
  断言假(校验匿名标识("user-12345678"), "错误前缀不合法")
  断言真(判定标识一致("user1", "salt", 标识), "同种子盐一致")
  断言假(判定标识一致("user2", "salt", 标识), "不同种子不一致")
  断言假(判定标识一致("user1", "salt2", 标识), "不同盐不一致")
  设 标识2 为 构造匿名标识("user1", "salt")
  断言相等(标识, 标识2, "确定性：同输入同输出")

# ===== 6. 策略谓词 =====
段落 测试策略谓词:
  设 策略 为 新建 策略谓词(假)
  策略.添加规则("read", 恒真, 真)
  策略.添加规则("write", 恒假, 真)
  策略.添加规则("delete", 恒真, 假)
  断言相等(策略.规则数(), 3, "3条规则")
  断言真(策略.判定("read", {}), "read 恒真→允许")
  断言假(策略.判定("write", {}), "write 恒假→不匹配→默认拒绝")
  断言假(策略.判定("delete", {}), "delete 恒真→拒绝")
  断言假(策略.判定("unknown", {}), "未知操作→默认拒绝")
  设 宽松策略 为 新建 策略谓词(真)
  断言真(宽松策略.判定("anything", {}), "默认允许")

# ===== 7. ACL规则解析 =====
段落 测试ACL解析:
  设 规则 为 解析界限规则("S-1-1-0:read:allow")
  断言相等(规则.主体, "S-1-1-0", "主体")
  断言相等(规则.权限, "read", "权限")
  断言真(规则.允许, "allow→真")
  设 规则2 为 解析界限规则("S-1-2-0:*:deny")
  断言相等(规则2.权限, "*", "通配权限")
  断言假(规则2.允许, "deny→假")
  设 抛了格式错 为 假
  尝试:
    设 坏规则 为 解析界限规则("badformat")
  捕获 异常 e:
    设 抛了格式错 为 真
  断言真(抛了格式错, "格式错误应抛错")
  设 抛了动作错 为 假
  尝试:
    设 坏动作 为 解析界限规则("S-1-1-0:read:maybe")
  捕获 异常 e:
    设 抛了动作错 为 真
  断言真(抛了动作错, "非法动作应抛错")

# ===== 8. ACL判定（拒绝优先）=====
段落 测试ACL判定:
  设 判定器 为 新建 界限判定器()
  设 允读 为 新建 访问界限规则("S-1-1-0", "read", 真)
  设 拒写 为 新建 访问界限规则("S-1-1-0", "write", 假)
  判定器.添加规则(允读)
  判定器.添加规则(拒写)
  断言真(判定器.判定("S-1-1-0", "read"), "允许read")
  断言假(判定器.判定("S-1-1-0", "write"), "拒绝write")
  断言假(判定器.判定("S-1-1-0", "execute"), "未配置execute→拒绝")
  断言假(判定器.判定("S-1-9-9", "read"), "未知主体→拒绝")
  断言相等(判定器.规则数(), 2, "2条规则")
  # 拒绝优先：同主体同权限同时有allow和deny
  设 判定器2 为 新建 界限判定器()
  设 允读2 为 新建 访问界限规则("S-1-1-0", "read", 真)
  设 拒读2 为 新建 访问界限规则("S-1-1-0", "read", 假)
  判定器2.添加规则(允读2)
  判定器2.添加规则(拒读2)
  断言假(判定器2.判定("S-1-1-0", "read"), "拒绝优先于允许")
  # 通配权限
  设 判定器3 为 新建 界限判定器()
  设 通配拒 为 新建 访问界限规则("S-1-1-0", "*", 假)
  判定器3.添加规则(通配拒)
  断言假(判定器3.判定("S-1-1-0", "read"), "通配拒绝")
  断言假(判定器3.判定("S-1-1-0", "write"), "通配拒绝write")
  设 判定器4 为 新建 界限判定器()
  设 通配允 为 新建 访问界限规则("S-1-1-0", "*", 真)
  判定器4.添加规则(通配允)
  断言真(判定器4.判定("S-1-1-0", "read"), "通配允许read")
  断言真(判定器4.判定("S-1-1-0", "write"), "通配允许write")

# ===== 9. 溢出目录命名 =====
段落 测试溢出目录名:
  断言相等(构造溢出目录名("spill", "sess1", 3), "spill-sess1-3", "目录名拼接")
  断言相等(构造溢出目录名("tmp", "abc", 0), "tmp-abc-0", "序号0")
  断言相等(构造溢出目录名("overflow", "xyz", 99), "overflow-xyz-99", "两位序号")

# ===== 10. 阈值判定 =====
段落 测试阈值判定:
  断言真(判定超阈(100, 50), "100>50 超阈")
  断言假(判定超阈(50, 100), "50<100 未超")
  断言假(判定超阈(100, 100), "100=100 未超(严格大于)")
  断言假(判定超阈(0, 0), "0=0 未超")
  设 抛了负阈 为 假
  尝试:
    设 坏判定 为 判定超阈(10, -1)
  捕获 异常 e:
    设 抛了负阈 为 真
  断言真(抛了负阈, "负上限应抛错")

# ===== 11. 清理顺序 =====
段落 测试清理顺序:
  设 e1 为 新建 溢出条目("dir1", 100, 1000)
  设 e2 为 新建 溢出条目("dir2", 200, 500)
  设 e3 为 新建 溢出条目("dir3", 50, 2000)
  设 顺序 为 整理清理顺序([e1, e2, e3])
  断言相等(列表长度(顺序), 3, "3个目录")
  断言相等(顺序[0], "dir2", "最旧(dir2@500)排首位")
  断言相等(顺序[1], "dir1", "次旧(dir1@1000)")
  断言相等(顺序[2], "dir3", "最新(dir3@2000)")
  # 单条目
  设 单条 为 整理清理顺序([e1])
  断言相等(列表长度(单条), 1, "单条目")
  断言相等(单条[0], "dir1", "单条目目录名")
  # 空列表
  设 空结果 为 整理清理顺序([])
  断言相等(列表长度(空结果), 0, "空列表")

# ===== 12. 清理目标计算 =====
段落 测试清理目标:
  设 e1 为 新建 溢出条目("dir1", 100, 1000)
  设 e2 为 新建 溢出条目("dir2", 200, 500)
  设 e3 为 新建 溢出条目("dir3", 50, 2000)
  # 总大小=350，上限=150 → 需清理最旧的dir2(200)，剩150<=150
  设 目标 为 计算清理目标([e1, e2, e3], 150)
  断言相等(列表长度(目标), 1, "清理1个")
  断言相等(目标[0], "dir2", "清理最旧dir2")
  # 上限=0 → 全部清理
  设 全清 为 计算清理目标([e1, e2, e3], 0)
  断言相等(列表长度(全清), 3, "上限0全清")
  # 上限很大 → 无需清理
  设 无清 为 计算清理目标([e1, e2, e3], 99999)
  断言相等(列表长度(无清), 0, "上限足够不清")
  # 单条目超过上限
  设 单清 为 计算清理目标([e1], 50)
  断言相等(列表长度(单清), 1, "单条目超限清理")
  断言相等(单清[0], "dir1", "清理dir1")

段落 主:
  测试凭证名()
  测试敏感名()
  测试脱敏值()
  测试脱敏文本()
  测试匿名标识()
  测试策略谓词()
  测试ACL解析()
  测试ACL判定()
  测试溢出目录名()
  测试阈值判定()
  测试清理顺序()
  测试清理目标()
  打印 "--- 安全策略模块测试通过 ---"

# ===========================================================
# 反跑判据（手动改反确认真红再改回）
#
# 1. 凭证名校验 真->假：
#    把「断言真(校验凭证名("API_KEY"), "合法名 API_KEY")」
#    改为 断言假(校验凭证名("API_KEY"), ...)
#    真->假，测试必须红。
#
# 2. 脱敏值 值改反：
#    把「断言相等(脱敏值("sk-abc12345", 2, 2), "sk***45", ...)」
#    改为 断言相等(脱敏值("sk-abc12345", 2, 2), "sk-abc12345", ...)
#    值"sk***45"->"sk-abc12345"（值->他值），测试必须红。
#
# 3. 脱敏文本白名单 值改反：
#    把「断言相等(脱敏文本("key=sk-abc12345 end", 前缀表, 白名单), "key=sk-abc12345 end", ...)」
#    改为 断言相等(脱敏文本("key=sk-abc12345 end", 前缀表, 白名单), "key=sk***45 end", ...)
#    值->他值，测试必须红。
#
# 4. 匿名标识确定性 真->假：
#    把「断言相等(标识, 标识2, "确定性：同输入同输出")」
#    改为 断言相等(标识, "anon-00000000", ...)
#    值->他值，测试必须红。
#
# 5. 匿名标识校验 真->假：
#    把「断言真(校验匿名标识(标识), "合法标识校验通过")」
#    改为 断言假(校验匿名标识(标识), ...)
#    真->假，测试必须红。
#
# 6. 策略谓词判定 真->假：
#    把「断言真(策略.判定("read", {}), "read 恒真→允许")」
#    改为 断言假(策略.判定("read", {}), ...)
#    真->假，测试必须红。
#
# 7. ACL解析格式错误 抛->不抛：
#    把「断言真(抛了格式错, "格式错误应抛错")」
#    改为 断言假(抛了格式错, ...)
#    抛->不抛，测试必须红。
#
# 8. ACL拒绝优先 真->假：
#    把「断言假(判定器2.判定("S-1-1-0", "read"), "拒绝优先于允许")」
#    改为 断言真(判定器2.判定("S-1-1-0", "read"), ...)
#    假->真，测试必须红。
#
# 9. 阈值判定 真->假：
#    把「断言真(判定超阈(100, 50), "100>50 超阈")」
#    改为 断言假(判定超阈(100, 50), ...)
#    真->假，测试必须红。
#
# 10. 清理顺序 值改反：
#     把「断言相等(顺序[0], "dir2", "最旧(dir2@500)排首位")」
#     改为 断言相等(顺序[0], "dir1", ...)
#     值"dir2"->"dir1"（值->他值），测试必须红。
#
# 11. 清理目标 值改反：
#     把「断言相等(目标[0], "dir2", "清理最旧dir2")」
#     改为 断言相等(目标[0], "dir1", ...)
#     值"dir2"->"dir1"（值->他值），测试必须红。
