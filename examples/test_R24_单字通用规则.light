# test_R24_单字通用规则.light —— 第24轮 任务3：单字保护表通用化（运行期自校验）
#
# 覆盖 _COMPOUND_SAFE_SINGLE_KEYWORDS 30 → 17 后，被删 13 字
# （例 出 则 常 引 接 是 末 试 跳 过 长 首）在**词首/词中/词尾**各位置的
# 通用规则行为，以及运算符/值字面量单字不受影响。
#
# 规则总览（替代逐词白名单的两条通用规则）：
#   · R23任务2 后缀位置规则：多字非运算符关键字在词中/词尾并入标识符；
#   · R24任务3 CR1 成员访问段首并入：成员/关系分隔符（之/在/于/为/与）之后
#     新段的段首单字非运算符关键字是成员名前缀 → 并入标识符。
#     （CR1 的精确 token 形态由 tests/test_R24_的递归_token.py 覆盖）
#
# 全部 rc=0 自校验。

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


# ---- 一、词首：被删 13 字打头的自由名整体成词（词首并入规则）----
设 首项 为 1
断言相等(首项, 1, "首项 词首整体成词")

设 末尾 为 2
断言相等(末尾, 2, "末尾 词首整体成词")

设 例子 为 3
断言相等(例子, 3, "例子 词首整体成词")

设 常规 为 4
断言相等(常规, 4, "常规 词首整体成词")

设 引用 为 5
断言相等(引用, 5, "引用 词首整体成词")

设 跳过 为 6
断言相等(跳过, 6, "跳过 词首整体成词")

设 长度 为 7
断言相等(长度, 7, "长度 词首整体成词")

设 接口 为 8
断言相等(接口, 8, "接口 词首整体成词")

# ---- 二、词中/词尾：多字非运算符关键字并入（R23任务2 后缀位置规则）----
设 处理函数 为 "fn"
断言相等(处理函数, "fn", "处理函数 词尾并入")

设 输出格式 为 "fmt"
断言相等(输出格式, "fmt", "输出格式 词尾并入")

设 错误己 为 "err"
断言相等(错误己, "err", "错误己 词尾并入（_TRAILING_ALIAS_CLASS）")

# ---- 三、运算符单字不受影响 ----
设 甲 为 3
设 乙 为 4
断言相等(甲 + 乙, 7, "运算符 + 语义不受影响")

设 加法 为 10
断言相等(加法, 10, "加法 整体成词（运算符词首构词）")

设 乘法表 为 20
断言相等(乘法表, 20, "乘法表 整体成词")

设 余数 为 30
断言相等(余数, 30, "余数 整体成词")

# ---- 四、值字面量单字不受影响 ----
设 标记 为 真
断言相等(标记, 真, "真 独立成词")
设 空标记 为 空
断言相等(空标记 == 空, 真, "空 独立成词")

# ---- 五、100+ 自由名护栏（任务书通用约束 4）----
设 去空格 为 "去空格"
断言相等(去空格, "去空格", "复核自由名整体成词")

设 索引 为 "idx"
断言相等(索引, "idx", "索引 整体成词")

设 种类 为 "kind"
断言相等(种类, "kind", "种类 整体成词")

# ---- 六、被删 13 字参与运算/容器/实参 ----
设 汇总 为 首项 + 末尾 + 例子 + 常规 + 引用 + 跳过 + 长度 + 接口
断言相等(汇总, 36, "被删字打头的自由名参与加法")

设 名表 为 [首项, 长度, 跳过]
断言相等(名表[1], 7, "被删字打头的自由名可作列表元素")

断言相等(转字符串(首项), "1", "被删字打头的自由名可作实参")

打印 "test_R24_单字通用规则 全部通过"
