# test_宿主IO.light —— 第17轮任务5 宿主IO抽象层原型 判据
# 上游：子进程.light/文件系统工具.light/流.light（设计灵感）｜ 本路自包含内存模拟
# 运行：cd lightharness && python 运行.py examples/test_宿主IO.light
# 反跑：_antirun_t5_宿主IO.py（A 文件系统round-trip / B 进程退出码 / C 重试判定）

从 宿主IO 导入 造内存文件系统, 写文件, 读文件, 文件存在, 删除文件, 列目录, 创建目录, 重命名, 获取文件信息
从 宿主IO 导入 拼接路径, 规范化路径, 获取父目录, 获取文件名, 获取扩展名, 是绝对路径
从 宿主IO 导入 造内存进程表, 预设进程结果, 启动进程, 取进程结果, 终止进程, 列举进程
从 宿主IO 导入 造IO事件总线, 派发IO事件, 监听IO事件
从 宿主IO 导入 造取消令牌, 取消令牌, 监听取消, 令牌已取消, 校验未取消
从 宿主IO 导入 造成功结果, 造失败结果, 是成功结果, 是失败结果, IO错误码表, 退避延迟, 带重试执行

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 总是NOT_FOUND:
  返回 造失败结果("NOT_FOUND", "故意不可重试", 空)

段落 总是TIMEOUT:
  返回 造失败结果("TIMEOUT", "故意可重试", 空)

段落 总是成功操作:
  返回 造成功结果("ok", 空)

段落 空处理器 接收 数据:
  设 占位 为 真

段落 主:
  打印 "===== 第17轮任务5：宿主IO抽象层原型 ====="

  # ---- §1 IO结果统一形状 ----
  断言相等(列表长度(IO错误码表()), 8, "1a 错误码表8项")
  设 成功 为 造成功结果("d", {"操作": "x"})
  断言真(是成功结果(成功), "1b 成功结果判别")
  设 失败 为 造失败结果("NOT_FOUND", "缺", 空)
  断言真(是失败结果(失败), "1c 失败结果判别")
  断言相等(失败["错误码"], "NOT_FOUND", "1d 失败含错误码")

  # ---- §2 取消令牌 ----
  设 令牌 为 造取消令牌("io-1")
  断言相等(令牌已取消(令牌), 假, "2a 令牌初未取消")
  设 触发 为 {"触发": 假}
  段落 IO取消处理器 接收 原因:
    设 触发["触发"] 为 真
  监听取消(令牌, IO取消处理器)
  取消令牌(令牌, "测试")
  断言相等(令牌已取消(令牌), 真, "2b 取消后已取消")
  断言相等(触发["触发"], 真, "2c 取消回调触发")
  设 未抛 为 真
  尝试:
    校验未取消(令牌)
  捕获 异常:
    设 未抛 为 假
  断言相等(未抛, 假, "2d 已取消时校验未取消抛错")

  # ---- §3 路径操作 ----
  断言相等(拼接路径(["/a", "b", "c"]), "/a/b/c", "3a 拼接路径")
  断言相等(规范化路径("/a/b/../c"), "/a/c", "3b 规范化路径去父")
  断言相等(获取父目录("/a/b/c.txt"), "/a/b", "3c 获取父目录")
  断言相等(获取文件名("/a/b/c.txt"), "c.txt", "3d 获取文件名")
  断言相等(获取扩展名("/a/b/c.txt"), ".txt", "3e 获取扩展名")
  断言相等(是绝对路径("/a"), 真, "3f 绝对路径判别")
  断言相等(是绝对路径("a/b"), 假, "3g 相对路径判别")

  # ---- §4 内存文件系统（A 锚点 1b）----
  设 fs 为 造内存文件系统()
  断言真(是成功结果(创建目录(fs, "/data", "mk1")), "4a 创建目录")
  设 写 为 写文件(fs, "/data/a.txt", "hello-io", "w1")
  断言真(是成功结果(写), "4b 写文件成功")
  设 读 为 读文件(fs, "/data/a.txt", "r1")
  断言相等(读["数据"], "hello-io", "4c 读文件返回写入内容")   # 反跑 A 锚点
  设 列 为 列目录(fs, "/data", "l1")
  断言相等(列表长度(列["数据"]), 1, "4d 列目录含1文件")
  断言相等(列["数据"][0], "a.txt", "4e 列目录文件名正确")
  设 删 为 删除文件(fs, "/data/a.txt", "d1")
  断言真(是成功结果(删), "4f 删除文件成功")
  断言相等(文件存在(fs, "/data/a.txt"), 假, "4g 删除后不存在")
  设 读缺 为 读文件(fs, "/data/a.txt", "r2")
  断言相等(读缺["错误码"], "NOT_FOUND", "4h 读已删文件返回NOT_FOUND")
  断言真(是成功结果(创建目录(fs, "/data2", "mk2")), "4i 创建目录2")
  断言真(是成功结果(写文件(fs, "/data2/b.txt", "x", "w2")), "4j 写文件到目录2")
  设 重 为 重命名(fs, "/data2/b.txt", "/data2/c.txt", "rn1")
  断言真(是成功结果(重), "4k 重命名成功")
  断言相等(文件存在(fs, "/data2/c.txt"), 真, "4l 重命名后新名存在")
  设 信息 为 获取文件信息(fs, "/data2/c.txt", "st1")
  断言相等(信息["数据"]["大小"], 1, "4m 文件信息大小正确")

  # ---- §5 内存进程（B 锚点 5b/5c/5d）----
  设 进程表 为 造内存进程表()
  预设进程结果(进程表, "echo", 42, "hello")
  设 启动 为 启动进程(进程表, "echo", [], "p1")
  断言真(是成功结果(启动), "5a 启动进程成功")
  设 进程ID 为 启动["数据"]["进程ID"]
  设 进程结果 为 取进程结果(进程表, 进程ID, "p2")
  断言相等(进程结果["数据"]["退出码"], 42, "5b 取进程结果返回预设退出码")   # 反跑 B 锚点
  断言相等(进程结果["数据"]["标准输出"], "hello", "5c 取进程结果返回预设输出")   # 反跑 B 锚点
  设 终止不存在 为 终止进程(进程表, "proc-999", "p3")
  断言相等(终止不存在["错误码"], "NOT_FOUND", "5d 终止不存在进程返回NOT_FOUND")   # 反跑 B 锚点
  设 列举 为 列举进程(进程表, "p4")
  断言真(列表长度(列举["数据"]) >= 1, "5e 列举进程含已启动进程")

  # ---- §6 IO超时与重试（C 锚点见 6a）----
  断言相等(退避延迟(100, 2, 1), 100, "6a 退避延迟第1次")
  断言相等(退避延迟(100, 2, 3), 400, "6b 退避延迟第3次")
  设 策略 为 {"最大重试次数": 2, "初始延迟": 100, "延迟倍增因子": 2, "可重试错误码列表": []}
  设 重试1 为 带重试执行(总是NOT_FOUND, 策略)
  断言相等(重试1["元数据"]["重试次数"], 1, "6c 不可重试错误不重试")   # 反跑 C 锚点（NOT_FOUND不重试→1次）
  设 策略2 为 {"最大重试次数": 2, "初始延迟": 100, "延迟倍增因子": 2, "可重试错误码列表": ["TIMEOUT"]}
  设 重试2 为 带重试执行(总是TIMEOUT, 策略2)
  断言相等(重试2["元数据"]["重试次数"], 3, "6d 可重试错误重试到上限")
  断言相等(重试2["错误码"], "TIMEOUT", "6e 重试耗尽返回最后错误")
  设 重试3 为 带重试执行(总是成功操作, 策略)
  断言相等(重试3["元数据"]["重试次数"], 1, "6f 成功操作不重试")
  断言相等(重试3["数据"], "ok", "6g 成功结果透传")

  # ---- §7 IO事件（事件入总线自带 历史 字段，避免用模块级变量承载接收记录）----
  设 总线 为 造IO事件总线()
  监听IO事件(总线, "io/completed", 空处理器)
  派发IO事件(总线, "io/completed", {"请求ID": "x"})
  断言相等(列表长度(总线["历史"]), 1, "7a IO事件入历史")
  断言相等(总线["历史"][0]["数据"]["请求ID"], "x", "7b IO事件数据正确")
  断言相等(列表长度(字典获取(总线["监听表"], "io/completed", [])), 1, "7c 监听器已注册")
  派发IO事件(总线, "io/completed", {"请求ID": "y"})
  断言相等(列表长度(总线["历史"]), 2, "7d 多次派发累计")

  打印 "test_宿主IO PASS"
