# test_设置预设页.light —— R107 任务线 C：Agent预设页真实化 判据
# 被测：src/设置预设页.light（本文件与其配套新增，不修改任何现有文件）
# 上游锚点：G:\github\deepseek-harness\packages\client\ui-agent-preset
#   src/client/locales.ts（zh 段文案逐字）+ AgentPresetDocument（查看配置正文）
# 运行：cd lightharness && python 运行.py examples/test_设置预设页.light
#
# 语言坑规避：断言诊断一律走 抛出 新建 错误（写/打印 只吃字面量串，L-055/L-160）；
#   列表/字典字面量单行且不直接作实参（L-047/L-051）；模块级标量在段落体内改不动 → 计数用字典。

从 设置预设页 导入 预设配置文档, 预设卡, 分组列表, 默认预设标识, 设为默认预设, 渲染预设页
从 设置预设页 导入 文案表, 弹窗标题, 抛未知预设, 默认部署预设
从 预设组合 导入 组合, 组合统计, 预设清单
从 JSON 导入 解析JSON
从 内置核心字典 导入 字典设置, 字典包含键
从 内置核心列表 导入 列表创建, 列表追加
从 内置核心转换 导入 转字符串

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 求值能力（测试注入）：恒假 → 全部 !!js 条件按「不禁用」解析
段落 恒假求值(表达式):
  返回 假

# =====================================================================
# §1 预设配置文档（四预设：成员数 / 文本可还原 / 行形状 / 三态启用 / 未知抛错）
# =====================================================================
段落 用例_预设配置文档:
  设 标识表 为 ["standard", "ptc", "minimal", "cordis"]
  设 期望成员 为 {"standard": 33, "ptc": 34, "minimal": 8, "cordis": 34}
  遍历 标识 之 标识表:
    设 文档 为 预设配置文档(标识)
    设 统计 为 组合统计(标识)
    断言相等(文档["成员数"], 统计["展平后"], "1a " + 标识 + " 成员数==组合统计.展平后")
    断言相等(文档["成员数"], 期望成员[标识], "1b " + 标识 + " 成员数值逐字")
    断言真(字符串长度(文档["文本"]) > 0, "1c " + 标识 + " 文本非空")
    断言相等(解析JSON(文档["文本"]), 组合(标识), "1d " + 标识 + " 文本可被解析JSON还原")
    断言真(长度(文档["行"]) > 0, "1e " + 标识 + " 行非空")
    设 首行 为 文档["行"][0]
    断言真(字典包含键(首行, "entryId"), "1f " + 标识 + " 首行含 entryId")
    断言真(字典包含键(首行, "moduleName"), "1g " + 标识 + " 首行含 moduleName")
    断言真(字典包含键(首行, "配置"), "1h " + 标识 + " 首行含 配置")
    遍历 行 之 文档["行"]:
      设 启用态合法 为 假
      如果 行["启用"] == 真:
        设 启用态合法 为 真
      如果 行["启用"] == 假:
        设 启用态合法 为 真
      如果 行["启用"] == "conditional":
        设 启用态合法 为 真
      断言相等(启用态合法, 真, "1i " + 标识 + " 启用只取三值")
  # 求值能力=空：!!js 条件全部落 conditional，且必带禁用条件
  设 标准文档 为 预设配置文档("standard")
  设 有条件 为 假
  遍历 行 之 标准文档["行"]:
    如果 行["启用"] == "conditional":
      设 有条件 为 真
      断言真(字符串长度(行["禁用条件"]) > 0, "1j conditional 行必带禁用条件")
  断言相等(有条件, 真, "1k standard 含 conditional 行（求值能力=空）")
  断言相等(标准文档["行"][0]["entryId"], "persona", "1l standard 首行 entryId=persona")
  # 两条口径对照：行长度=展平叶子（上游 UI 口径），成员数=展平后（含声明行与组行）
  断言相等(长度(标准文档["行"]), 29, "1m standard 展平叶子 29")
  断言相等(标准文档["成员数"], 33, "1n standard 展平后 33（≠叶子数）")
  # 恒假求值：conditional 全部解析为启用，叶子数不变
  设 放行文档 为 预设配置文档("standard", 恒假求值)
  设 仍条件 为 假
  遍历 行 之 放行文档["行"]:
    如果 行["启用"] == "conditional":
      设 仍条件 为 真
  断言相等(仍条件, 假, "1o 恒假求值后无 conditional")
  断言相等(长度(放行文档["行"]), 29, "1p 求值不改叶子数")
  # 未知预设抛错（文案复用 预设.造未知道错误）
  设 抛了 为 假
  设 文 为 ""
  尝试:
    设 坏 为 预设配置文档("不存在的预设")
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  断言相等(抛了, 真, "1q 未知预设抛错")
  断言真(字符串包含(文, "not found"), "1r 错误复用 造未知道错误 文案")
  断言真(字符串包含(文, "standard"), "1s 错误消息含可用清单")

# =====================================================================
# §2 预设卡（字段齐全 / 配置.成员数==组合统计.展平后 / 是否默认随已存设置 / 名称逐字）
# =====================================================================
段落 用例_预设卡:
  设 空存 为 {}
  设 标识表 为 ["standard", "ptc", "minimal", "cordis"]
  遍历 标识 之 标识表:
    设 卡 为 预设卡(标识, 空存)
    断言相等(卡["id"], 标识, "2a 卡 id=" + 标识)
    断言真(字典包含键(卡, "名称"), "2b " + 标识 + " 卡含 名称")
    断言真(字典包含键(卡, "描述"), "2c " + 标识 + " 卡含 描述")
    断言真(字典包含键(卡, "是否内置"), "2d " + 标识 + " 卡含 是否内置")
    断言真(字典包含键(卡, "顺序"), "2e " + 标识 + " 卡含 顺序")
    断言真(字典包含键(卡, "失败原因"), "2f " + 标识 + " 卡含 失败原因")
    断言相等(卡["失败原因"], 空, "2g " + 标识 + " 失败原因=空（本仓无 broken）")
    断言相等(卡["是否内置"], 真, "2h " + 标识 + " 是否内置=真")
    断言真(字典包含键(卡, "帮助"), "2i " + 标识 + " 卡含 帮助")
    断言真(字典包含键(卡["帮助"], "模式说明"), "2j " + 标识 + " 帮助含 模式说明")
    断言真(字典包含键(卡["帮助"], "如何使用"), "2k " + 标识 + " 帮助含 如何使用")
    断言真(字符串长度(卡["帮助"]["模式说明"]) > 0, "2l " + 标识 + " 模式说明非空")
    断言真(字典包含键(卡, "配置"), "2m " + 标识 + " 卡含 配置")
    断言真(字典包含键(卡["配置"], "文本"), "2n " + 标识 + " 配置含 文本")
    断言真(字典包含键(卡["配置"], "行"), "2o " + 标识 + " 配置含 行")
    断言相等(卡["配置"]["成员数"], 组合统计(标识)["展平后"], "2p " + 标识 + " 配置.成员数==组合统计.展平后")
  # 名称逐字（上游 locales.ts 四预设名）
  断言相等(预设卡("standard", 空存)["名称"], "标准模式", "2q standard 名称")
  断言相等(预设卡("ptc", 空存)["名称"], "PTC 模式", "2r ptc 名称")
  断言相等(预设卡("minimal", 空存)["名称"], "极简模式", "2s minimal 名称")
  断言相等(预设卡("cordis", 空存)["名称"], "创造模式", "2t cordis 名称")
  # 默认标记：空设置 → standard；用户默认 ptc → ptc 卡标记
  断言相等(预设卡("standard", 空存)["是否默认"], 真, "2u 空设置 standard 默认")
  断言相等(预设卡("ptc", 空存)["是否默认"], 假, "2v 空设置 ptc 非默认")
  设 存ptc 为 {"agentPresetDefault": "ptc"}
  断言相等(预设卡("ptc", 存ptc)["是否默认"], 真, "2w 用户默认 ptc 卡标记")
  断言相等(预设卡("standard", 存ptc)["是否默认"], 假, "2x 用户默认下 standard 非默认")
  # 未知预设抛错
  设 抛了 为 假
  尝试:
    设 坏卡 为 预设卡("不存在的预设", 空存)
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "2y 未知预设造卡抛错")

# =====================================================================
# §3 分组列表（两分组都在 / 四预设全在内置组 / 自定义组空但存在）
# =====================================================================
段落 用例_分组列表:
  设 空存 为 {}
  设 组集 为 分组列表(空存)
  断言相等(长度(组集), 2, "3a 两分组")
  断言相等(组集[0]["分组"], "内置", "3b 首组=内置")
  断言相等(组集[1]["分组"], "自定义", "3c 次组=自定义")
  断言相等(长度(组集[0]["预设"]), 4, "3d 内置组四卡")
  断言相等(长度(组集[1]["预设"]), 0, "3e 自定义组空")
  设 序表 为 列表创建()
  遍历 卡 之 组集[0]["预设"]:
    列表追加(序表, 卡["id"])
  设 期望序 为 ["standard", "ptc", "minimal", "cordis"]
  断言相等(序表, 期望序, "3f 内置组顺序 standard→ptc→minimal→cordis")

# =====================================================================
# §4 默认预设标识（无键回落 / 用户默认生效 / 非法值回落 / 空串回落）
# =====================================================================
段落 用例_默认预设标识:
  断言相等(默认预设标识(空), "standard", "4a 无设置回落 standard")
  断言相等(默认部署预设(), "standard", "4b 部署默认=standard")
  设 存ptc 为 {"agentPresetDefault": "ptc"}
  断言相等(默认预设标识(存ptc), "ptc", "4c 用户默认生效")
  设 存坏 为 {"agentPresetDefault": "no-such"}
  断言相等(默认预设标识(存坏), "standard", "4d 非法值回落 standard")
  设 存空串 为 {"agentPresetDefault": ""}
  断言相等(默认预设标识(存空串), "standard", "4e 空串回落 standard")
  设 存非串 为 {"agentPresetDefault": 3}
  断言相等(默认预设标识(存非串), "standard", "4f 非串回落 standard")
  设 存无键 为 {"其他": 1}
  断言相等(默认预设标识(存无键), "standard", "4g 无键回落 standard")

# =====================================================================
# §5 设为默认预设（成功不改入参 / 未知非法 / 开发者工具关逐字 / 读回 / 默认参）
# =====================================================================
段落 用例_设为默认预设:
  设 原 为 {"其他": 1}
  设 结果 为 设为默认预设(原, "ptc", 真)
  断言相等(结果["合法"], 真, "5a 合法设默认")
  断言相等(结果["消息"], "", "5b 合法时消息空")
  断言相等(结果["设置"]["agentPresetDefault"], "ptc", "5c 新设置置 agentPresetDefault")
  断言相等(结果["设置"]["其他"], 1, "5d 原键保留")
  断言真(字典包含键(原, "agentPresetDefault") == 假, "5e 入参未被改动")
  断言相等(默认预设标识(结果["设置"]), "ptc", "5f 新设置可被 默认预设标识 读回")
  # 未知预设 → 非法，消息含合法四键
  设 坏结果 为 设为默认预设(空, "no-such", 真)
  断言相等(坏结果["合法"], 假, "5g 未知预设非法")
  断言真(字符串包含(坏结果["消息"], "no-such"), "5h 消息回显非法标识")
  断言真(字符串包含(坏结果["消息"], "standard"), "5i 消息含 standard")
  断言真(字符串包含(坏结果["消息"], "ptc"), "5j 消息含 ptc")
  断言真(字符串包含(坏结果["消息"], "minimal"), "5k 消息含 minimal")
  断言真(字符串包含(坏结果["消息"], "cordis"), "5l 消息含 cordis")
  # 开发者工具关 → 逐字文案
  设 拒绝 为 设为默认预设(空, "ptc", 假)
  断言相等(拒绝["合法"], 假, "5m 开发者工具关 → 非法")
  断言相等(拒绝["消息"], "请先在通用设置中开启代码工作工具，再设置默认值", "5n 逐字文案 enableDevToolsToSetDefault")
  # 开发者工具默认参（=真）
  设 默认参结果 为 设为默认预设(空, "minimal")
  断言相等(默认参结果["合法"], 真, "5o 开发者工具默认真 → 合法")
  断言相等(默认参结果["设置"]["agentPresetDefault"], "minimal", "5p 默认参设 minimal")

# =====================================================================
# §6 渲染预设页（四键齐全 / 默认回落 / 开发者工具透传 / 分组透传）
# =====================================================================
段落 用例_渲染预设页:
  设 页 为 渲染预设页()
  断言真(字典包含键(页, "说明"), "6a 页含 说明")
  断言真(字典包含键(页, "分组"), "6b 页含 分组")
  断言真(字典包含键(页, "默认预设"), "6c 页含 默认预设")
  断言真(字典包含键(页, "开发者工具"), "6d 页含 开发者工具")
  断言相等(页["默认预设"], "standard", "6e 默认预设回落 standard")
  断言相等(页["开发者工具"], 真, "6f 开发者工具默认真")
  断言相等(长度(页["分组"]), 2, "6g 两组分组")
  断言相等(长度(页["分组"][0]["预设"]), 4, "6h 内置组四卡")
  设 页关 为 渲染预设页(空, 假)
  断言相等(页关["开发者工具"], 假, "6i 开发者工具可关")
  设 存ptc 为 {"agentPresetDefault": "ptc"}
  设 页ptc 为 渲染预设页(存ptc)
  断言相等(页ptc["默认预设"], "ptc", "6j 用户默认透传到页")

# =====================================================================
# §7 上游文案逐字（locales.ts zh 段）
# =====================================================================
段落 用例_文案逐字:
  设 表 为 文案表()
  断言相等(表["nav"], "Agent 预设", "7a nav")
  断言相等(表["sectionIntro"], "选择 Agent 的工具和工作方式。日常任务用「标准模式」，扩展 DSH 的能力用「创造模式」。", "7b sectionIntro")
  断言相等(表["builtInGroup"], "内置", "7c builtInGroup")
  断言相等(表["customGroup"], "自定义", "7d customGroup")
  断言相等(表["setDefault"], "设为新任务默认", "7e setDefault")
  断言相等(表["view"], "查看配置", "7f view")
  断言相等(表["inUse"], "新任务默认", "7g inUse")
  断言相等(表["noDescription"], "暂无描述。", "7h noDescription")
  断言相等(表["brokenBadge"], "加载失败", "7i brokenBadge")
  断言相等(表["close"], "关闭", "7j close")
  断言相等(表["enableDevToolsToSetDefault"], "请先在通用设置中开启代码工作工具，再设置默认值", "7k enableDevToolsToSetDefault")
  断言相等(弹窗标题("标准模式"), "查看配置 · 标准模式", "7l 弹窗标题 查看配置 · 预设名")
  # 页 说明 与 sectionIntro 同源逐字
  设 页 为 渲染预设页()
  断言相等(页["说明"], 表["sectionIntro"], "7m 页说明==sectionIntro")

段落 主程():
  用例_预设配置文档()
  用例_预设卡()
  用例_分组列表()
  用例_默认预设标识()
  用例_设为默认预设()
  用例_渲染预设页()
  用例_文案逐字()
  打印 "test_设置预设页 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置预设页 通过 ---"
  返回 真

主程()
