# test_R71_E_stdlib原语.light —— R71 任务E（L-160 主目录 / L-174 随机UUID）
# 验收（任务书 R71-E）：
#   UUID：唯一性 / 长度36 / v4格式（连字符位置、版本位、变体位、十六进制字符）
#         / 1000 次唯一性统计（零碰撞）
#   主目录：非空 / 是真实存在的目录 / 跨平台（Windows=USERPROFILE，POSIX=HOME）
#         / 与路径拼接可用 / 与 环境变量 一致性
# 全部零导入内置：主目录() / 随机UUID() / 环境变量() / 目录存在() / 连接路径() 等。

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 "断言失败(应为真): " + 标签

# ── 1. UUID 基础属性 ──
设 id1 为 随机UUID()
设 id2 为 随机UUID()

# 唯一性
断言为真(id1 != id2, "UUID两次调用不同")

# 长度 36
断言等于(字符串长度(id1), 36, "UUID长度36")

# 连字符位置（8-4-4-4-12）
断言等于(id1[8], "-", "UUID连字符1")
断言等于(id1[13], "-", "UUID连字符2")
断言等于(id1[18], "-", "UUID连字符3")
断言等于(id1[23], "-", "UUID连字符4")

# 分段长度
设 段 为 分割字符串(id1, "-")
断言等于(列表长度(段), 5, "UUID分段数")
断言等于(字符串长度(段[0]), 8, "UUID段1长度")
断言等于(字符串长度(段[1]), 4, "UUID段2长度")
断言等于(字符串长度(段[2]), 4, "UUID段3长度")
断言等于(字符串长度(段[3]), 4, "UUID段4长度")
断言等于(字符串长度(段[4]), 12, "UUID段5长度")

# v4 版本位：第 3 段首字符是 '4'
断言等于(段[2][0], "4", "UUID版本位=4")

# RFC 4122 变体位：第 4 段首字符是 8/9/a/b
断言为真(段[3][0] == "8" 或 段[3][0] == "9" 或 段[3][0] == "a" 或 段[3][0] == "b", "UUID变体位")

# 全部字符都是十六进制或连字符
设 合法字符 为 "0123456789abcdef-"
设 全合法 为 真
遍历 c 之 id1:
  如果 字符串包含(合法字符, c) == 假:
    设 全合法 为 假
断言为真(全合法, "UUID字符全为十六进制")

# ── 2. UUID 1000 次唯一性统计（零碰撞） ──
设 批量 为 []
设 n 为 0
当 n < 1000:
  列表追加(批量, 随机UUID())
  设 n 为 n 加上 1
断言等于(列表长度(批量), 1000, "UUID批量数量")

设 碰撞 为 0
设 i 为 0
当 i < 1000:
  设 j 为 i 加上 1
  当 j < 1000:
    如果 批量[i] == 批量[j]:
      设 碰撞 为 碰撞 加上 1
    设 j 为 j 加上 1
  设 i 为 i 加上 1
断言等于(碰撞, 0, "UUID一千次零碰撞")

# ── 3. 主目录 ──
设 home 为 主目录()

# 非空
断言为真(字符串长度(home) > 0, "主目录非空")

# 是真实存在的目录
断言为真(目录存在(home), "主目录真实存在")

# 与环境变量一致性：Windows 取 USERPROFILE，POSIX 取 HOME
设 兜底一致性 为 假
如果 环境变量("USERPROFILE") != 空:
  如果 home == 环境变量("USERPROFILE"):
    设 兜底一致性 为 真
如果 环境变量("HOME") != 空:
  如果 home == 环境变量("HOME"):
    设 兜底一致性 为 真
断言为真(兜底一致性, "主目录与环境变量一致")

# 重复调用稳定（同一进程内主目录不变）
断言等于(主目录(), home, "主目录调用稳定")

# 与路径拼接可用（拼接结果落在主目录下）
设 配置路径 为 连接路径(home, ".config", "app")
断言为真(查找子串(配置路径, ".config") > 0, "主目录路径拼接")

打印("test_R71_E_stdlib原语 全部通过")
