# test_R176_acp轮次状态.light —— B4 路 ACP rc.3 轮次/取消结算状态机判据
# 上游锚点：packages/acp/acp/src/session.ts + tests/turns.spec.ts（新增 420 行）@ dsh-v0.2.1-rc.3
# 反跑判据：把 轮次失败 的 messageQueued 前置删掉、或把 轮次终结 的轮号匹配放宽 → 本文件必红。

从 acp轮次状态 导入 造轮次状态, 轮次跟随, 轮次终结, 轮次失败, 轮次取消开始, 轮次取消完成, 轮次需结算

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 主:
  # ---------- §1 构造 ----------
  设 初 为 造轮次状态()
  断言相等(初["turn"], 空, "§1 初始无轮号")
  断言相等(初["messageQueued"], 假, "§1b 初始无入队消息")

  # ---------- §2 turn/start 跟随 ----------
  设 s1 为 造轮次状态()
  字典设置(s1, "messageQueued", 真)
  轮次跟随(s1, 1)
  断言相等(s1["turn"], 1, "§2 turn/start 设轮号")
  轮次终结(s1, 1, "completed")
  断言相等(s1["endReason"], "completed", "§2b turn/end 记原因")
  轮次跟随(s1, 2)
  断言相等(s1["turn"], 2, "§2c 新 turn/start 让轮号跟随")
  断言相等(s1["endReason"], 空, "§2d 跟随新轮时清旧终结原因")

  # ---------- §3 turn/end 只对当前轮生效 ----------
  设 s2 为 造轮次状态()
  轮次跟随(s2, 5)
  轮次终结(s2, 4, "aborted")
  断言相等(s2["endReason"], 空, "§3 旧轮的 turn/end 不覆盖当前轮")
  轮次终结(s2, 5, "interrupted")
  断言相等(s2["endReason"], "interrupted", "§3b 同轮 turn/end 生效")

  设 s3 为 造轮次状态()
  轮次终结(s3, 1, "completed")
  断言相等(s3["endReason"], 空, "§3c 无轮号时 turn/end 不改状态")

  # ---------- §4 失败记录（rc.3 不再按轮号过滤） ----------
  设 s4 为 造轮次状态()
  字典设置(s4, "messageQueued", 真)
  轮次跟随(s4, 7)
  轮次失败(s4, "boom")
  断言相等(s4["agentError"], "boom", "§4 同轮失败被记录")
  设 s5 为 造轮次状态()
  字典设置(s5, "messageQueued", 真)
  轮次跟随(s5, 7)
  轮次终结(s5, 7, "completed")
  轮次失败(s5, "interval-failure")
  断言相等(s5["agentError"], "interval-failure", "§4b 轮已终结后失败仍记录（rc.2 会跳过）")
  轮次终结(s5, 8, "completed")
  断言相等(s5["agentError"], "interval-failure", "§4c 非当前轮的 turn/end 不清失败")
  轮次终结(s5, 7, "completed")
  断言相等(s5["agentError"], 空, "§4d 同轮 turn/end 清失败")

  设 s6 为 造轮次状态()
  轮次失败(s6, "x")
  断言相等(s6["agentError"], 空, "§4e 未入队消息不记失败")

  # ---------- §5 取消完成判定 ----------
  设 s7 为 造轮次状态()
  字典设置(s7, "messageQueued", 真)
  轮次取消开始(s7, 假)
  断言相等(轮次取消完成(s7, "running"), 假, "§5 取消中且仍 running → 未完成")
  断言真(轮次取消完成(s7, "idle"), "§5b 转 idle → 取消完成")

  设 s8 为 造轮次状态()
  字典设置(s8, "messageQueued", 真)
  轮次取消开始(s8, 真)
  断言真(轮次取消完成(s8, "running"), "§5c 取消启动时已空闲 → 立即完成（维护期公开空闲）")

  设 s9 为 造轮次状态()
  字典设置(s9, "messageQueued", 真)
  断言相等(轮次取消完成(s9, "idle"), 假, "§5d 未请求取消 → 不算取消完成")

  设 s10 为 造轮次状态()
  轮次取消开始(s10, 真)
  断言相等(轮次取消完成(s10, "idle"), 假, "§5e 无入队消息 → 不结算")

  # ---------- §6 结算触发 ----------
  设 s11 为 造轮次状态()
  断言相等(轮次需结算(s11), 假, "§6 干净状态不需结算")
  轮次取消开始(s11, 假)
  断言真(轮次需结算(s11), "§6b 取消中需结算")
  设 s12 为 造轮次状态()
  字典设置(s12, "messageQueued", 真)
  轮次失败(s12, "err")
  断言真(轮次需结算(s12), "§6c 有失败需结算")

  打印("test_R176_acp轮次状态: 全部用例通过")

主()
