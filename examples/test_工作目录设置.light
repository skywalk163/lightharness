# test_工作目录设置.light —— 工作目录 API 回归（GET/POST /api/cwd）
# 运行：python 运行.py examples/test_工作目录设置.light
# 覆盖：初始来源=启动、POST 校验（不存在拒绝 / 存在切换+持久化）、GET 回读、
#       新会话携带该 cwd、无效 body 400。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 认证 导入 初始化认证
从 总入口 导入 组装注册表
从 JSON 导入 解析JSON, 序列化JSON
从 文件系统 导入 创建目录, 删除目录, 目录存在, 路径连接, 文件存在, 文件列表, 删除文件
从 系统接口 导入 是目录
从 随机 导入 安全随机令牌
从 内置核心字符串 导入 截取
从 字符串处理 导入 编码
从 系统接口 导入 切换工作目录
从 文件系统 导入 读取文件

设 通过盘 为 {"通过": 0}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  通过盘["通过"] = 通过盘["通过"] + 1

段落 造请求(方法, 路径, 体):
  返回 ["方法": 方法, "路径": 路径, "头": {}, "体": 体]

段落 清空目录(目录):
  如果 目录存在(目录) == 假:
    返回
  遍历 名字 之 文件列表(目录):
    设 子 为 路径连接(目录, 名字)
    如果 是目录(子):
      清空目录(子)
    否则:
      删除文件(子)
  删除目录(目录)

异步 段落 主测试:
  初始化认证()
  设 根 为 路径连接("/tmp", "lh_cwd_" + 截取(安全随机令牌(), 0, 8))
  设 目标 为 路径连接(根, "workspace")
  创建目录(目标)
  全局服务.配置(空, 组装注册表(), 根, 5.0, "", 空)

  # ① 初始 GET：来源=启动
  设 r1 为 等待 路由处理器(造请求("GET", "/api/cwd", b''))
  断言相等(r1["状态"], 200, "1a GET /api/cwd 200")
  设 b1 为 解析JSON(r1["体"])
  断言相等(b1["来源"], "启动", "1b 未设置来源=启动")

  # ② POST 不存在的目录 -> 400
  设 badBody 为 序列化JSON(["工作目录": 路径连接(根, "不存在")])
  设 r2 为 等待 路由处理器(造请求("POST", "/api/cwd", 编码(badBody)))
  断言相等(r2["状态"], 400, "2a 不存在目录 400")

  # ③ POST 有效目录 -> 200 + 持久化
  设 goodBody 为 序列化JSON(["工作目录": 目标])
  设 r3 为 等待 路由处理器(造请求("POST", "/api/cwd", 编码(goodBody)))
  断言相等(r3["状态"], 200, "3a 有效目录 200")
  设 b3 为 解析JSON(r3["体"])
  断言相等(b3["工作目录"], 目标, "3b 回显绝对目录")

  # ④ GET 回读：来源=设置
  设 r4 为 等待 路由处理器(造请求("GET", "/api/cwd", b''))
  设 b4 为 解析JSON(r4["体"])
  断言相等(b4["来源"], "设置", "4a 回读来源=设置")
  断言相等(b4["工作目录"], 目标, "4b 回读目录一致")

  # ⑤ settings.json 落盘键
  设 cfgp 为 路径连接(根, "settings.json")
  断言相等(文件存在(cfgp), 真, "5a settings.json 存在")
  设 存值 为 解析JSON(读取文件(cfgp))
  断言相等(存值["工作目录"], 目标, "5b 工作目录键已持久化")

  # ⑥ 无效 body -> 400
  设 r6 为 等待 路由处理器(造请求("POST", "/api/cwd", b'{}'))
  断言相等(r6["状态"], 400, "6a 空 body 400")

  # 清理：切回原目录再删（避免删除正在使用的 cwd）
  切换工作目录("/tmp")
  清空目录(根)
  打印 "test_工作目录设置 通过 断言数=" + 转字符串(通过盘["通过"])
  返回 真

异步 运行 主测试()
