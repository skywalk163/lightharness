# test_R38_集成测试.light —— 第 38 轮 任务 3 判据：agent-tool-presentation 集成
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/agent-tool-presentation/
#   tests/agent-tool-presentation.spec.ts（官方 7 用例 + 隐含 disposer = 8 契约，§1 逐条映射）
# 运行：cd lightharness && python 运行.py examples/test_R38_集成测试.light
# 覆盖：§1 八用例映射、§2 端到端三模式对比、§3 代理循环联动（llm 步骤按作用域过滤）
# 依赖：任务1 src/工具展示.light（含零修改适配层 工具展示注册表代理）+ src/工具.light + src/代理循环.light

从 测试 导入 断言相等, 断言真, 断言异常
从 工具 导入 工具注册表, 造工具定义
从 工具展示 导入 工具展示插件名, 工具展示依赖, 工具展示模式表, 运行代码工具名, 部署默认展示
从 工具展示 导入 校验展示模式, 建工具展示配置, 校验工具展示配置
从 工具展示 导入 获取作用域展示, 应用工具展示, 注销工具展示
从 工具展示 导入 是否待代码运行时, 等待代码运行时, 获取可见工具, 生成工具SDK
从 工具展示 导入 工具展示注册表代理, 造代理工具展示
从 代理循环 导入 建循环, 开始轮次, 结束轮次, 开始步骤, 结束步骤, 步骤型表, 轮次是否终态
从 代码运行时 导入 代码运行时

# 造演示工具注册表：echo / search / write_file（对齐任务书 3.2；执行函数不被调用）
段落 建演示注册表:
  设 注册 为 新建 工具注册表()
  注册.注册(造工具定义("echo", "回显输入文本。", ["type": "object"], 空))
  注册.注册(造工具定义("search", "搜索文件内容。", ["type": "object"], 空))
  注册.注册(造工具定义("write_file", "写入文本文件。", ["type": "object"], 空))
  返回 注册

# 取可见工具名列表（描述表元素为 {"name","description","parameters"}）
段落 名列表(可见):
  设 名 为 []
  遍历 项 之 可见:
    名.追加(项["name"])
  返回 名

段落 通过编号(编号):
  打印 "OK #" + 编号
  返回 真

段落 主:
  设 计数 为 0

  # ===== #00 判据自检 =====
  设 计数 为 计数 + 1
  设 自检红 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检红 为 真
  断言真(自检红, "自检：断言助手必须真能报错")
  断言相等(步骤型表, ["llm", "tool", "user_input"], "代理循环步骤型表前置")

  # ===== §1.1 用例1：声明使用 tools 而不持有 codeRuntime（inject=['tools']）=====
  设 计数 为 计数 + 1
  断言相等(工具展示插件名, "tool-presentation", "插件名对齐上游")
  断言相等(工具展示依赖, ["tools"], "inject 只声明 tools")
  断言真(工具展示依赖.包含("codeRuntime") == 假, "codeRuntime 不在静态依赖中")
  # native 行必须在无运行时部署中可 mount
  设 表 为 建演示注册表()
  设 甲配置 为 建工具展示配置("native")
  应用工具展示(甲配置, "s1", 表)
  断言真(甲配置["已应用"], "native 无运行时直接应用")
  断言相等(获取作用域展示("s1"), "native", "native 作用域生效")
  通过编号("1")

  # ===== §1.2 用例2：给特定 agent PTC，其余保持 native（作用域隔离）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  设 编码配置 为 建工具展示配置("ptc")
  应用工具展示(编码配置, "coded", 表, 运行时)
  设 朴素配置 为 建工具展示配置("native")
  应用工具展示(朴素配置, "plain", 表)
  断言相等(名列表(获取可见工具("coded", 表)), ["run_code"], "ptc 作用域只见 run_code")
  断言相等(名列表(获取可见工具("plain", 表)), ["echo", "search", "write_file"], "native 作用域见全部")
  设 报文 为 生成工具SDK(表)
  断言真(报文["文本"].查找("echo") >= 0, "SDK 含 echo")
  断言相等(长(报文["条目"]), 3, "SDK 列出 3 个真实工具")
  通过编号("2")

  # ===== §1.3 用例3：both 模式两者都展示 =====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  设 双配置 为 建工具展示配置("both")
  应用工具展示(双配置, "both-scope", 表, 运行时)
  断言相等(名列表(获取可见工具("both-scope", 表)), ["echo", "search", "write_file", "run_code"], "both = 全部 + run_code")
  通过编号("3")

  # ===== §1.4 用例4：agent 卸载恢复部署默认（HMR 安全 / disposer）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  设 卸配置 为 建工具展示配置("ptc")
  应用工具展示(卸配置, "gone", 表, 运行时)
  断言相等(获取作用域展示("gone"), "ptc", "卸载前 ptc 生效")
  断言真(注销工具展示(卸配置), "注销返回真")
  断言相等(获取作用域展示("gone"), 部署默认展示, "卸载后恢复部署默认")
  断言相等(名列表(获取可见工具("gone", 表)), ["echo", "search", "write_file"], "卸载后可见工具回全量")
  通过编号("4")

  # ===== §1.5 用例5：等待部署未组合的 codeRuntime（pending，不应用）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 悬配置 为 建工具展示配置("ptc")
  应用工具展示(悬配置, "waiting", 表)
  断言真(是否待代码运行时(悬配置), "ptc 无运行时 → pending")
  断言真(悬配置["已应用"] == 假, "pending 未应用")
  断言相等(获取作用域展示("waiting"), 部署默认展示, "pending 作用域回退部署默认")
  断言相等(名列表(获取可见工具("waiting", 表)), ["echo", "search", "write_file"], "pending 可见工具为全量（不静默降级为空）")
  通过编号("5")

  # ===== §1.6 用例6：codeRuntime 到达后应用 =====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 悬配置 为 建工具展示配置("ptc")
  应用工具展示(悬配置, "late", 表)
  断言真(是否待代码运行时(悬配置), "先 pending")
  等待代码运行时(悬配置, 新建 代码运行时(5))
  断言真(悬配置["已应用"], "运行时到达后已应用")
  断言真(是否待代码运行时(悬配置) == 假, "pending 解除")
  断言相等(获取作用域展示("late"), "ptc", "作用域转为 ptc")
  断言相等(名列表(获取可见工具("late", 表)), ["run_code"], "可见工具转 run_code")
  通过编号("6")

  # ===== §1.7 用例7：mode 必填，不设默认值 =====
  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    建工具展示配置(空)
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  尝试:
    建工具展示配置("advanced")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  断言相等(抛错数, 2, "mode 缺省/非法 → 抛错")
  断言真(校验展示模式("") == 假, "空串非法")
  断言真(校验展示模式("PTC") == 假, "大小写敏感（对齐上游 z.union）")
  断言真(校验展示模式("ptc"), "合法值通过")
  断言真(校验工具展示配置("不是字典") == 假, "非字典配置非法")
  断言真(校验工具展示配置(建工具展示配置("both")), "合法配置通过")
  断言相等(工具展示模式表, ["native", "ptc", "both"], "模式表对齐上游")
  通过编号("7")

  # ===== §1.8 用例8（隐含契约）：presentAs 返回 disposer，可重复注销（幂等）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  设 柄配置 为 建工具展示配置("both")
  设 句柄 为 应用工具展示(柄配置, "disp", 表, 运行时)
  断言真(句柄 == 柄配置, "apply 返回配置句柄充当 disposer")
  断言真(注销工具展示(句柄), "首次注销真")
  断言真(注销工具展示(句柄), "重复注销幂等（不抛错）")
  断言相等(获取作用域展示("disp"), 部署默认展示, "注销后回部署默认")
  断言真(注销工具展示("不是字典") == 假, "非法句柄注销返回假")
  通过编号("8")

  # ===== §2 端到端三模式对比（任务书 3.2：明确的工具列表差异）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  设 結果 为 {}
  设 甲 为 建工具展示配置("native")
  应用工具展示(甲, "m-native", 表)
  设 乙 为 建工具展示配置("ptc")
  应用工具展示(乙, "m-ptc", 表, 运行时)
  设 丙 为 建工具展示配置("both")
  应用工具展示(丙, "m-both", 表, 运行时)
  断言相等(名列表(获取可见工具("m-native", 表)), ["echo", "search", "write_file"], "native：3 个原生工具")
  断言相等(名列表(获取可见工具("m-ptc", 表)), ["run_code"], "ptc：仅 run_code")
  断言相等(名列表(获取可见工具("m-both", 表)), ["echo", "search", "write_file", "run_code"], "both：4 个（3 原生 + run_code）")
  设 报文 为 生成工具SDK(表)
  断言真(报文["文本"].查找("search") >= 0, "SDK 文本含 search")
  断言真(报文["文本"].查找("write_file") >= 0, "SDK 文本含 write_file")
  断言真(报文["文本"].查找("echo") >= 0, "SDK 文本含 echo")
  # PTC 下模型经 SDK 看到 run_code 的 schema
  设 运行模式 为 获取可见工具("m-ptc", 表)[0]
  断言相等(运行模式["name"], "run_code", "ptc 唯一工具名")
  断言真(字典包含键(运行模式, "parameters"), "run_code schema 携带参数")
  通过编号("9")

  # ===== §3 代理循环联动（任务书 3.3：llm 步骤中按作用域过滤）=====
  设 计数 为 计数 + 1
  设 表 为 建演示注册表()
  设 运行时 为 新建 代码运行时(5)
  # 两个作用域：coded（ptc）与 plain（native），各自包装代理注册表
  设 编码侧 为 造代理工具展示("loop-coded", 表, "ptc", 运行时)
  设 朴素侧 为 造代理工具展示("loop-plain", 表, "native")
  断言相等(名列表(编码侧["代理注册表"].描述表()), ["run_code"], "llm 步骤：coded 代理只见 run_code")
  断言相等(名列表(朴素侧["代理注册表"].描述表()), ["echo", "search", "write_file"], "llm 步骤：plain 代理见全部")
  # 代理注册表对其余方法原样委托（host-plane 不变的语义）
  断言相等(编码侧["代理注册表"].名单(), ["echo", "search", "write_file"], "名单委托不变（注册表本体未过滤）")
  断言真(编码侧["代理注册表"].有无("echo"), "有无委托")
  断言相等(编码侧["代理注册表"].执行策略("echo"), "exclusive", "执行策略委托（默认 exclusive）")
  # 代理循环真实状态机：llm 步骤中取各作用域可见工具
  设 驱动 为 建循环(3)
  开始轮次(驱动)
  开始步骤(驱动, "llm")
  设 步内编码 为 编码侧["代理注册表"].描述表()
  设 步内朴素 为 朴素侧["代理注册表"].描述表()
  断言相等(名列表(步内编码), ["run_code"], "循环 llm 步骤内 coded 隔离生效")
  断言相等(名列表(步内朴素), ["echo", "search", "write_file"], "循环 llm 步骤内 plain 隔离生效")
  结束步骤(驱动)
  结束轮次(驱动)
  断言真(轮次是否终态(驱动["轮次表"][0]), "循环轮次正常终结")
  # 卸载 coded 的展示后，其代理注册表回部署默认（HMR 安全贯穿循环）
  注销工具展示(编码侧["配置"])
  断言相等(名列表(编码侧["代理注册表"].描述表()), ["echo", "search", "write_file"], "注销后 coded 代理回全量")
  通过编号("10")

  打印 "R38 集成测试 判据通过：" + 转字符串(计数) + " 组"

主()
