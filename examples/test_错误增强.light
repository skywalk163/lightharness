# test_错误增强.light —— 第18轮任务3 测试（#118 / R18-D3）
# 验证 src/错误增强.light 的 10 个错误处理工具函数，覆盖正常/边界/异常三态。
# 反跑锚点：A=造结构化错误→抛出→捕获→解析，码/消息/详情 round-trip 一致；
#           B=尝试执行抛出异常的函数，返回默认值不传播；
#           C=抛出结构化错误的消息格式化改错（不含码）→ 解析错误码测试立红。

从 错误增强 导入 造结构化错误, 抛出结构化错误, 解析错误消息, 获取最后异常
从 错误增强 导入 错误码, 错误消息, 尝试执行, 尝试执行详情, 错误链, 是错误

# ── 断言辅助段 ──
段落 断言相等(实际, 期望, 标签 = ""):
  如果 实际 == 期望:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望))

段落 断言真(条件, 标签 = ""):
  如果 条件 == 真:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 期望为真 实际=" 加上 转字符串(条件))

# ── 异常触发段（供 尝试执行 / 抛出 使用）──
段落 抛E1:
  抛出结构化错误("E1", "出错", {"k": 1})

段落 得42:
  返回 42

段落 必炸:
  抛出结构化错误("BOOM", "炸了", 空)

段落 主:
  打印 "===== test_错误增强 ====="

  # §0 获取最后异常：未抛时返回空（需在首次抛出前）
  断言相等(获取最后异常(), 空, "0a 未抛异常时返回空")

  # §1 造结构化错误（L-099）
  设 e1 为 造结构化错误("E1", "出错", {"k": 1})
  断言相等(字典获取(e1, "码", 空), "E1", "1a 码正确")
  断言相等(字典获取(e1, "消息", 空), "出错", "1b 消息正确")
  断言相等(字典获取(e1, "详情", 空), {"k": 1}, "1c 详情正确")
  断言真(字典获取(e1, "时间", 空) != 空, "1d 时间非空")
  设 e2 为 造结构化错误("E2", "无详情")
  断言相等(字典获取(e2, "详情", 空), 空, "1e 详情可选为空")

  # §2 抛出结构化错误 + 解析 round-trip（L-099 / L-088）
  设 捕获消息 为 空
  尝试:
    抛E1()
  捕获 异常:
    设 捕获消息 为 获取最后异常()
  设 解析 为 解析错误消息(捕获消息)
  断言相等(字典获取(解析, "码", 空), "E1", "2a 解析出码")
  断言相等(字典获取(解析, "消息", 空), "出错", "2b 解析出消息")
  断言相等(字典获取(解析, "详情", 空), {"k": 1}, "2c 解析出详情")

  # §3 解析错误消息（配合 L-099）
  断言相等(解析错误消息("不是JSON"), 空, "3a 非法消息返空")
  设 s3 为 造结构化错误("Z", "z")
  断言相等(解析错误消息(序列化JSON(s3)), s3, "3b 合法消息还原（含时间一致）")

  # §4 获取最后异常：抛出后返回最后消息（L-088）
  断言真(获取最后异常() != 空, "4a 抛出后返回非空最后异常")

  # §5 错误码 / 错误消息（配合 L-099）
  断言相等(错误码(e1), "E1", "5a 从字典取码")
  断言相等(错误消息(e1), "出错", "5b 从字典取消息")
  断言相等(错误码(捕获消息), "E1", "5c 从消息串取码")
  断言相等(错误消息(捕获消息), "出错", "5d 从消息串取消息")

  # §6 是错误（B级）
  断言真(是错误(e1) == 真, "6a 结构化错误对象为真")
  断言真(是错误(捕获消息) == 真, "6b 序列化消息串为真")
  断言真(是错误("普通字符串") == 假, "6c 普通字符串为假")
  断言真(是错误(42) == 假, "6d 普通数值为假")

  # §7 尝试执行（B级，反跑 B 锚点）：异常返默认不传播
  断言相等(尝试执行(得42, 空, -1), 42, "7a 正常执行返结果")
  断言相等(尝试执行(必炸, 空, "缺省"), "缺省", "7b 异常返默认不传播")

  # §8 尝试执行详情（B级）
  设 d1 为 尝试执行详情(得42)
  断言真(字典获取(d1, "成功", 空) == 真, "8a 成功为真")
  断言相等(字典获取(d1, "结果", 空), 42, "8b 成功结果")
  设 d2 为 尝试执行详情(必炸)
  断言真(字典获取(d2, "成功", 空) == 假, "8c 失败为假")
  断言真(字典获取(d2, "错误", 空) != 空, "8d 失败带错误信息")

  # §9 错误链（B级）
  断言相等(错误链([e1]), "E1: 出错", "9a 单错误链")
  断言相等(错误链([e1, e2]), "E1: 出错; E2: 无详情", "9b 多错误链组合")
  断言相等(错误链([]), "", "9c 空列表返回空串")

  # §10 组合（反跑 A 锚点）：造→抛→捕获→解析，码/消息/详情 round-trip 一致
  设 构造 为 造结构化错误("R1", "组合", {"n": 7})
  设 抛消息 为 空
  尝试:
    抛出结构化错误("R1", "组合", {"n": 7})
  捕获 异常:
    设 抛消息 为 获取最后异常()
  设 回 为 解析错误消息(抛消息)
  断言相等(字典获取(回, "码", 空), 字典获取(构造, "码", 空), "10a 组合码一致")
  断言相等(字典获取(回, "消息", 空), 字典获取(构造, "消息", 空), "10b 组合消息一致")
  断言相等(字典获取(回, "详情", 空), 字典获取(构造, "详情", 空), "10c 组合详情一致")

  打印 "test_错误增强 PASS"
