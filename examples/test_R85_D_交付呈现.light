# R85 任务 D 判据：0.1.6 tool-present 新增 present 交付工具（src/交付呈现.light）
# 纯逻辑对拍：配置校验 / 文件形状 / 执行前校验（含注入 fs 钩子）/ 输出渲染 / 交付事件投影

从 交付呈现 导入 交呈构造配置, 交呈构造文件, 交呈执行, 交呈渲染输出, 交呈构造交付事件, 交呈默认上限, 交呈工具名
从 字符串增强 导入 码转字符

# =====================================================================
# 断言辅助
# =====================================================================

段落 交呈断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 交呈断言包含(消息, 关键词, 标签):
  如果 字符串包含(消息, 关键词) == 假:
    抛出 新建 错误("断言失败: " + 标签 + " 消息未含[" + 关键词 + "] 实际=" + 消息)

# mock 文件系统钩子：取文件类型 —— 约定 "file" 为常规文件，其余为非常规/未找到
段落 交呈模拟类型(路径):
  如果 字符串包含(路径, "目录") == 真:
    返回 "directory"
  如果 字符串包含(路径, "缺失") == 真:
    返回 "未找到"
  返回 "file"

段落 交呈造环境(有会话, 边界开放, 末轮, 上限):
  设 配置 为 交呈构造配置(上限)
  设 环境 为 ["有会话": 有会话, "边界开放": 边界开放, "末轮": 末轮, "配置": 配置, "宿主钩子": ["取文件类型": 交呈模拟类型]]
  返回 环境

# =====================================================================
# 主
# =====================================================================

段落 主():
  # ① 常量 + 配置校验
  交呈断言相等(交呈工具名(), "present", "工具名")
  交呈断言相等(交呈默认上限(), 8, "默认上限")
  设 配置三 为 交呈构造配置(3)
  交呈断言相等(配置三["maxFiles"], 3, "配置整数")
  设 配置字典 为 交呈构造配置(["maxFiles": 5])
  交呈断言相等(配置字典["maxFiles"], 5, "配置字典入参")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈构造配置(0)
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 配置零抛错 应抛错但未抛")
  交呈断言包含(消息, "positive integer", "配置零抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈构造配置(-2)
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 配置负数抛错 应抛错但未抛")
  交呈断言包含(消息, "positive integer", "配置负数抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈构造配置("x")
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 配置非整数抛错 应抛错但未抛")
  交呈断言包含(消息, "positive integer", "配置非整数抛错")

  # ② 交付文件形状
  设 文件一 为 交呈构造文件("/a.txt", "说明")
  交呈断言相等(文件一["path"], "/a.txt", "文件路径")
  交呈断言相等(文件一["description"], "说明", "文件说明")

  # ③ 执行前校验：会话 / 边界 / 数量 / 空路径 / 文件类型
  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(假, 真, 1, 8), ["文件列表": []])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 无会话抛错 应抛错但未抛")
  交呈断言包含(消息, "agent Session", "无会话抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 假, 1, 8), ["文件列表": []])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 边界未开放抛错 应抛错但未抛")
  交呈断言包含(消息, "open turn", "边界未开放抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 真, 1, 8), ["文件列表": []])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 零文件抛错 应抛错但未抛")
  交呈断言包含(消息, "accepts 1 to 8", "零文件抛错")

  设 超量 为 [交呈构造文件("/1", "a"), 交呈构造文件("/2", "b"), 交呈构造文件("/3", "c"), 交呈构造文件("/4", "d"), 交呈构造文件("/5", "e"), 交呈构造文件("/6", "f"), 交呈构造文件("/7", "g"), 交呈构造文件("/8", "h"), 交呈构造文件("/9", "i")]
  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 真, 1, 8), ["文件列表": 超量])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 超量抛错 应抛错但未抛")
  交呈断言包含(消息, "accepts 1 to 8", "超量抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 真, 1, 8), ["文件列表": [交呈构造文件("   ", "空")]])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 空路径抛错 应抛错但未抛")
  交呈断言包含(消息, "non-empty file path", "空路径抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 真, 1, 8), ["文件列表": [交呈构造文件("/某目录/x", "d")]])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 目录非文件抛错 应抛错但未抛")
  交呈断言包含(消息, "not a regular file", "目录非文件抛错")

  设 捕获 为 假
  设 消息 为 ""
  尝试:
    交呈执行(交呈造环境(真, 真, 1, 8), ["文件列表": [交呈构造文件("/缺失/x", "d")]])
  捕获 异常 为 e:
    设 捕获 为 真
    设 消息 为 转字符串(e)
  如果 捕获 != 真:
    抛出 新建 错误("断言失败: 缺失文件抛错 应抛错但未抛")
  交呈断言包含(消息, "not a regular file", "缺失文件抛错")

  # ④ 合法执行 → {turn, files}
  设 合法 为 交呈执行(交呈造环境(真, 真, 7, 8), ["文件列表": [交呈构造文件("/out/report.pdf", "报告"), 交呈构造文件("/out/log.txt", "日志")]])
  交呈断言相等(合法["turn"], 7, "返回轮号")
  交呈断言相等(列表长度(合法["files"]), 2, "返回文件数")

  # ⑤ 输出渲染：每行 "Presented <path>"
  设 渲染 为 交呈渲染输出(合法)
  交呈断言包含(渲染, "Presented /out/report.pdf", "渲染行1")
  交呈断言包含(渲染, "Presented /out/log.txt", "渲染行2")
  交呈断言包含(渲染, 码转字符(10), "渲染含换行")

  # ⑥ 交付事件投影 payload
  设 事件 为 交呈构造交付事件(7, "call-9", 合法["files"])
  交呈断言相等(事件["turn"], 7, "事件轮号")
  交呈断言相等(事件["callId"], "call-9", "事件调用ID")
  交呈断言相等(列表长度(事件["files"]), 2, "事件文件数")

  写 "test_R85_D_交付呈现 PASS"
