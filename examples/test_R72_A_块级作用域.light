# test_R72_A_块级作用域.light —— L-172 块级作用域（R72 任务A）
# 语法：令 X 为 V —— 在 如果/否则/遍历/当/尝试 块内声明块级变量：
#       块内可见（含嵌套块与匿名闭包捕获）、块外名称错误；
#       设 X 为 V 保持既有函数级泄漏行为不变。
# 覆盖：最小复现、兄弟块同名隔离、当/遍历/尝试块、嵌套块读外层、
#       匿名闭包捕获（读/裸赋值写穿/外层+设）、块级变量持函数值、
#       函数顶层与模块顶层 令 向后兼容、类方法内块级作用域。

段落 主:
    # ── ① 任务书最小复现：块内可见、块外名称错误 ──
    如果 真:
        令 块内 为 42
        断言(块内 == 42, "块内可见")
    设 拦截 为 "未触发"
    尝试:
        打印(块内)
        拦截 为 "泄漏"
    捕获:
        拦截 为 "已拦截"
    断言(拦截 == "已拦截", "块外引用块级变量应名称错误")

    # ── ② 兄弟块同名隔离 ──
    如果 真:
        令 值 为 10
        断言(值 == 10, "兄弟块1")
    如果 真:
        令 值 为 1
        断言(值 == 1, "兄弟块2 同名互不干扰")

    # ── ③ 当循环：块级变量 + 增量赋值 ──
    设 i 为 0
    当 i < 3:
        令 轮 为 i
        断言(轮 == i, "当循环块内可见")
        i 加为 1
    断言(i == 3, "当循环正常退出")

    # ── ④ 遍历块：块级变量 ──
    设 合计 为 0
    遍历 项 于 [1, 2, 3, 4]:
        令 双倍 为 项 * 2
        合计 加为 双倍
    断言(合计 == 20, "遍历块内 令 累加")

    # ── ⑤ 尝试/捕获/最终 块 ──
    设 结果 为 0
    尝试:
        令 局部值 为 40
        结果 为 局部值 + 2
    捕获:
        结果 为 -1
    断言(结果 == 42, "尝试块内 令 参与运算")

    # ── ⑥ 嵌套块：内层读外层块级变量 ──
    如果 真:
        令 外层值 为 "外"
        如果 真:
            令 内层值 为 外层值 + "内"
            断言(内层值 == "外内", "内层块读外层块级变量")

    # ── ⑦ 匿名闭包捕获块级变量（逃逸块后仍可读）──
    段落 造读器:
        令 基数 为 10
        如果 真:
            令 步长 为 5
            设 读值 为 段落 接收: 返回 基数 + 步长
            返回 读值
    设 读器 为 造读器()
    断言(读器() == 15, "闭包逃逸块后读块级变量")

    # ── ⑧ 匿名闭包裸赋值写穿块级变量（自动 nonlocal 到 mangled 名）──
    段落 造步进器:
        如果 真:
            令 计数 为 0
            设 步进 为 段落 接收:
                计数 为 计数 + 1
            步进()
            步进()
            返回 计数
    断言(造步进器() == 2, "闭包裸赋值写穿块级变量")

    # ── ⑨ 外层 显式声明 + 设 写块级变量 ──
    段落 造加法器:
        如果 真:
            令 量 为 1
            设 增加 为 段落 接收:
                外层 量
                设 量 为 量 + 41
            增加()
            返回 量
    断言(造加法器() == 42, "外层+设 写块级变量")

    # ── ⑩ 块级变量持函数值并调用 ──
    如果 真:
        令 添三 为 段落 接收 甲:
            返回 甲 + 3
        断言(添三(39) == 42, "块级变量持函数值并调用")

    # ── ⑪ 函数顶层 令 = 设（向后兼容）──
    段落 顶层令:
        令 局部 为 7
        返回 局部
    断言(顶层令() == 7, "函数顶层 令 等价 设")

    # ── ⑫ 设 落到已可见块级变量（同函数块内）──
    如果 真:
        令 总数 为 100
        设 总数 为 总数 + 1
        断言(总数 == 101, "设 写已可见块级变量")

    # ── ⑬ 否则分支内 令 ──
    段落 分支令:
        设 判定 为 假
        如果 判定:
            令 结果 为 "真分支"
            返回 结果
        否则:
            令 结果 为 "假分支"
            返回 结果
    断言(分支令() == "假分支", "否则分支内 令")

    # ── ⑭ 设 保持函数级泄漏（既有行为不回归）──
    如果 真:
        设 函数级 为 100
    断言(函数级 == 100, "设 仍为函数级泄漏")

    打印("test_R72_A PASS")
