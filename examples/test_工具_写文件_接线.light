# test_工具_写文件_接线.light —— 第6轮 任务E #284 行级 LCS 块差异接线 判据
# 运行：python 运行.py examples/test_工具_写文件_接线.light
# 判据：写文件差异信封（绳计算块差异 行级 LCS + 绳格式化写输出 信封一行产出）；
#       纯逻辑回归绿由 test_R85_E_工具.diff.light 承担。

从 工具_写文件 导入 写文件差异信封, 绳计算块差异
从 内置核心字符串 导入 字符串包含, 开头

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 新建文件（前文本空）-> create 信封 + 单块差异 ----
  设 r1 为 写文件差异信封("/a.txt", "", "第一行\n第二行")
  断言相等(r1["操作"], "create", "1a 空前文本=create")
  断言真(开头(r1["信封"], "<path>/a.txt</path>"), "1b 信封头")
  断言真(字符串包含(r1["信封"], "Created file"), "1c 信封动词")
  断言相等(列表长度(r1["块差异表"]), 1, "1d 一块差异")
  断言相等(r1["块差异表"][0]["旧文本"], "", "1e 旧文本空")
  断言相等(r1["块差异表"][0]["新文本"], "第一行\n第二行", "1f 新文本")

  # ---- 2. 更新文件（有前文本）-> update 信封 ----
  设 r2 为 写文件差异信封("/a.txt", "旧一\n旧二\n旧三", "旧一\n新二\n旧三")
  断言相等(r2["操作"], "update", "2a 有前文本=update")
  断言真(字符串包含(r2["信封"], "Updated file"), "2b 信封动词")
  断言相等(r2["块差异表"][0]["旧文本"], "旧二", "2c 旧块")
  断言相等(r2["块差异表"][0]["新文本"], "新二", "2d 新块")

  # ---- 3. 无变化 -> 空块差异表 ----
  设 r3 为 写文件差异信封("/a.txt", "同文", "同文")
  断言相等(列表长度(r3["块差异表"]), 0, "3a 无变化零块")

  # ---- 4. 绳计算块差异 直接调用（既有纯逻辑保留） ----
  设 块表 为 绳计算块差异("/b.txt", "甲\n乙", "甲\n丙\n乙")
  断言相等(块表[0]["旧文本"], "", "4a 插入场景旧空")
  断言相等(块表[0]["新文本"], "丙", "4b 插入行")

  打印 "--- 第6轮 任务E #284 写文件 LCS 信封接线 测试通过 ---"

主()