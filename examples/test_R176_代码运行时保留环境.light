# test_R176_代码运行时保留环境.light —— B4 路 ptc-runtime stateOwner/保留环境 判据
# 上游锚点：packages/ptc-runtime/ptc-runtime/src/{index.ts,types.ts} 增量 +
#            ptc-runtime-node/src/persistent.ts（新增）@ dsh-v0.2.1-rc.3
# 反跑判据：把 判保留运行准入 的「运行中」分支删掉（或把 结算运行 的属主键空删记录删掉）即红。

从 代码运行时保留环境 导入 程序形态表, 缺省程序形态, 判程序形态, 是保留请求, 造保留环境册, 取环境记录, 判保留运行准入, 策略相同, 登记运行, 结算运行, 标记清理未完, 标记清理完成, 标记环境关闭, 释放属主, 环境数

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 策略A:
  返回 {"mode": "workspace-write", "workspaceRoot": "/w", "sessionId": "s1"}

段落 主:
  # ---------- §1 程序形态 ----------
  断言相等(程序形态表(), ["function-body", "repl"], "§1 两值词表")
  断言相等(缺省程序形态(), "function-body", "§1b 缺省形态")
  断言真(判程序形态("repl"), "§1c repl 合法")
  断言真(判程序形态("function-body"), "§1d function-body 合法")
  断言相等(判程序形态("module"), 假, "§1e 第三值不合法")

  # ---------- §2 保留请求判定 ----------
  断言相等(是保留请求({"program": "x"}), 假, "§2 无 stateOwner → 临时环境")
  断言相等(是保留请求({"program": "x", "stateOwner": 空}), 假, "§2b stateOwner 为空 → 临时环境")
  断言真(是保留请求({"program": "x", "stateOwner": "o1"}), "§2c 有属主 → 保留")
  断言相等(是保留请求(空), 假, "§2d 非字典 → 假")

  # ---------- §3 准入状态机 ----------
  设 册 为 造保留环境册()
  断言相等(环境数(册), 0, "§3 初始空册")

  # 无属主 → 临时环境恒准入
  设 临 为 判保留运行准入(册, 空, 策略A())
  断言真(临["准入"], "§3b 无属主恒准入")
  断言相等(临["复用"], 假, "§3b 不复用")

  # 首次有属主 → 准入、不复用
  设 首 为 判保留运行准入(册, "o1", 策略A())
  断言真(首["准入"], "§3c 首跑准入")
  断言相等(首["复用"], 假, "§3c 首跑无环境可复用")

  设 记1 为 登记运行(册, "o1", 策略A())
  断言相等(记1["代号"], 1, "§3d 首环境代号 1")
  断言相等(环境数(册), 1, "§3e 册里一个环境")

  # 运行中再次请求 → 拒绝并发
  设 并发 为 判保留运行准入(册, "o1", 策略A())
  断言相等(并发["准入"], 假, "§3f 同属主并发拒绝")
  断言相等(并发["错误"], "persistent PTC does not accept concurrent runs for one state owner", "§3f 并发文案逐字")

  # 结算后可复用
  设 结1 为 结算运行(册, "o1")
  断言真(结1, "§3g 结算成功")
  设 复用 为 判保留运行准入(册, "o1", 策略A())
  断言真(复用["准入"], "§3h 结算后可再跑")
  断言相等(复用["复用"], 真, "§3h 复用既有环境")

  # 策略变更 → 拒绝，须先 release
  设 换策 为 判保留运行准入(册, "o1", {"mode": "read-only", "workspaceRoot": "/w", "sessionId": "s1"})
  断言相等(换策["准入"], 假, "§3i 策略变更拒绝")
  断言相等(换策["错误"], "persistent PTC: release the retained environment before changing its sandbox policy", "§3i 策略文案逐字")

  # 清理未完 → 拒绝
  设 标 为 标记清理未完(册, "o1")
  断言真(标, "§3j 标记清理未完")
  设 未清 为 判保留运行准入(册, "o1", 策略A())
  断言相等(未清["准入"], 假, "§3k 清理未完拒绝")
  断言相等(未清["错误"], "persistent PTC environment cleanup is incomplete; release the owner before running another program", "§3k 清理文案逐字")
  标记清理完成(册, "o1")
  设 已清 为 判保留运行准入(册, "o1", 策略A())
  断言真(已清["准入"], "§3l 清理完成后恢复准入")

  # 环境已关闭 → 准入但重建（不复用、代号推进）
  设 关 为 标记环境关闭(册, "o1")
  断言真(关, "§3m 标记关闭")
  设 重建 为 判保留运行准入(册, "o1", 策略A())
  断言真(重建["准入"], "§3n 关闭后准入")
  断言相等(重建["复用"], 假, "§3n 关闭后不复用旧环境")
  设 记2 为 登记运行(册, "o1", 策略A())
  断言相等(记2["代号"], 2, "§3o 重建得到新代号")

  # 释放属主：幂等
  结算运行(册, "o1")
  断言真(释放属主(册, "o1"), "§3p 释放已存在属主")
  断言相等(释放属主(册, "o1"), 假, "§3q 重复释放为假（幂等）")
  断言相等(环境数(册), 0, "§3r 释放后册空")

  # ---------- §4 临时环境不留痕 ----------
  设 册2 为 造保留环境册()
  登记运行(册2, 空, 策略A())
  断言相等(环境数(册2), 1, "§4 临时环境运行期间在册")
  结算运行(册2, 空)
  断言相等(环境数(册2), 0, "§4b 临时环境结算即销毁")

  # ---------- §5 策略比较 ----------
  断言真(策略相同(策略A(), 策略A()), "§5 同策略相等")
  断言相等(策略相同(策略A(), {"mode": "workspace-write", "workspaceRoot": "/other", "sessionId": "s1"}), 假, "§5b 工作区不同 → 不等")
  断言相等(策略相同(策略A(), {"mode": "workspace-write", "workspaceRoot": "/w", "sessionId": "s2"}), 假, "§5c 会话不同 → 不等")
  断言相等(策略相同(空, 策略A()), 假, "§5d 非字典 → 不等")

  打印("test_R176_代码运行时保留环境: 全部用例通过")

主()
