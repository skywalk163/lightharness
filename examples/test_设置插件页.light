# test_设置插件页.light —— R107 任务线B：内置插件页真实化 判据
# 被测：src/设置插件页.light
# 上游：packages/client/ui-settings-plugin-inventory + host/plugin-inventory
# 运行：cd lightharness && python 运行.py examples/test_设置插件页.light
#
# 计数口径关键：成员计数 = 展平叶子数（29/30/6/30）；按模式概览 = 展平后（33/34/8/34）
#   两者严格区分，各有标签，不得混用。

从 设置插件页 导入 成员行集, 会话插件分组, 全局插件分组, 预设切换器
从 设置插件页 导入 渲染插件页, 文案说明, 文案会话分组, 文案会话副标题
从 设置插件页 导入 文案全局分组, 文案全局副标题, 文案全局已停用由预设提供
从 设置插件页 导入 启用态转字符串, 配置状态文案, 包名取标题, 按模式概览带标注
从 预设挂载过滤 导入 挂扁平标识表
从 预设组合 导入 组合统计, 预设清单
从 内置核心字典 导入 字典包含键, 字典获取
从 内置核心列表 导入 列表包含
从 内置核心字符串 导入 开头

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §0 模拟注册表（全局插件分组用）
# =====================================================================
类 模拟注册表:
  属性 名单表 等于 []
  属性 描述表数据 等于 []
  段落 构造:
    设 己.名单表 为 ["tool-bash", "tool-fs", "tool-web", "unknown-tool-x"]
    设 己.描述表数据 为 [
      {"name": "tool-bash", "description": "执行 bash 命令", "parameters": {}},
      {"name": "tool-fs", "description": "文件系统操作", "parameters": {}},
      {"name": "tool-web", "description": "网页搜索", "parameters": {}},
      {"name": "unknown-tool-x", "description": "未在预设中", "parameters": {}}]
  段落 名单:
    返回 己.名单表
  段落 描述表:
    返回 己.描述表数据

# =====================================================================
# §1 文案逐字断言（≥6 例）
# =====================================================================
段落 用例_文案逐字:
  断言相等(文案说明(), "查看内置部署的插件列表", "T1 说明文案逐字")
  断言相等(文案会话分组(), "会话插件", "T2 会话分组名逐字")
  断言相等(文案会话副标题(), "由 Agent 预设按会话组成", "T3 会话副标题逐字")
  断言相等(文案全局分组(), "全局插件", "T4 全局分组名逐字")
  断言相等(文案全局副标题(), "系统与所有会话共用", "T5 全局副标题逐字")
  断言相等(文案全局已停用由预设提供(), "全局已停用，由 Agent 预设按会话提供", "T6 全局已停用文案逐字")

# =====================================================================
# §2 小工具函数
# =====================================================================
段落 用例_小工具:
  断言相等(启用态转字符串(真), "enabled", "T7 启用态真->enabled")
  断言相等(启用态转字符串(假), "disabled", "T8 启用态假->disabled")
  断言相等(启用态转字符串("conditional"), "conditional", "T9 启用态conditional->conditional")
  断言相等(配置状态文案(真), "已启用", "T10 配置状态真->已启用")
  断言相等(配置状态文案(假), "已停用", "T11 配置状态假->已停用")
  断言相等(配置状态文案("conditional"), "条件启用", "T12 配置状态conditional->条件启用")
  断言相等(包名取标题("@deepseek-ai/dsh-persona"), "dsh-persona", "T13 包名取标题末段")
  断言相等(包名取标题("cordis:group"), "cordis:group", "T14 无斜杠取原名")

# =====================================================================
# §3 成员行集（6 例）
# =====================================================================
段落 用例_成员行集:
  设 行集 为 成员行集("standard", 空)
  断言相等(长度(行集), 29, "T15 standard 叶子 29 条")
  断言真(字典包含键(行集[0], "entryId"), "T16 首条含 entryId")
  断言真(字符串长度(行集[0]["entryId"]) > 0, "T17 首条 entryId 非空")
  # moduleName 以 @deepseek-ai/ 开头
  设 前缀对 为 真
  遍历 行 之 行集:
    如果 开头(行["moduleName"], "@deepseek-ai/") == 假:
      设 前缀对 为 假
  断言真(前缀对, "T18 moduleName 以 @deepseek-ai/ 开头")
  # 启用态只取三值
  设 态对 为 真
  遍历 行 之 行集:
    如果 行["启用"] != "enabled" 且 行["启用"] != "disabled" 且 行["启用"] != "conditional":
      设 态对 为 假
  断言真(态对, "T19 启用态只取三值")
  # 配置状态逐字合法
  设 态对2 为 真
  遍历 行 之 行集:
    如果 行["配置状态"] != "已启用" 且 行["配置状态"] != "已停用" 且 行["配置状态"] != "条件启用":
      设 态对2 为 假
  断言真(态对2, "T20 配置状态逐字合法")
  # 运行状态恒空
  设 空对 为 真
  遍历 行 之 行集:
    如果 行["运行状态"] != 空:
      设 空对 为 假
  断言真(空对, "T21 运行状态恒空")

# =====================================================================
# §4 四预设计数逐字 + 口径对照（5 例）
# =====================================================================
段落 用例_计数口径:
  断言相等(长度(挂扁平标识表("standard", 空)), 29, "T22 standard 叶子=29")
  断言相等(长度(挂扁平标识表("ptc", 空)), 30, "T23 ptc 叶子=30")
  断言相等(长度(挂扁平标识表("minimal", 空)), 6, "T24 minimal 叶子=6")
  断言相等(长度(挂扁平标识表("cordis", 空)), 30, "T25 cordis 叶子=30")
  # 与展平后不等的对照断言
  设 统计 为 组合统计("standard")
  断言真(29 != 统计["展平后"], "T26 叶子数29 != 展平后" + 转字符串(统计["展平后"]))

# =====================================================================
# §5 会话插件分组（3 例）
# =====================================================================
段落 用例_会话分组:
  设 分组 为 会话插件分组("standard", 空)
  断言相等(分组["副标题"], "由 Agent 预设按会话组成", "T27 会话副标题逐字")
  断言相等(分组["默认展开"], 真, "T28 会话默认展开真")
  断言相等(分组["计数"], 29, "T29 会话计数=29")
  # 未知预设抛错
  设 抛错 为 假
  尝试:
    会话插件分组("not-exist", 空)
  捕获 异常甲:
    设 抛错 为 真
  断言真(抛错, "T30 未知预设抛错")

# =====================================================================
# §6 全局插件分组（4 例）
# =====================================================================
段落 用例_全局分组:
  设 注册表 为 模拟注册表()
  设 分组 为 全局插件分组(注册表, 空)
  断言相等(分组["计数"], 4, "T31 全局计数==名单长度4")
  断言相等(分组["默认展开"], 假, "T32 全局默认展开假")
  断言相等(分组["失败数"], 0, "T33 失败数=0")
  # 由预设提供为真假二值（tool-bash 在预设里，unknown-tool-x 不在）
  设 bash行 为 空
  设 unknown行 为 空
  遍历 项 之 分组["项"]:
    如果 项["entryId"] == "tool-bash":
      设 bash行 为 项
    如果 项["entryId"] == "unknown-tool-x":
      设 unknown行 为 项
  断言真(bash行 != 空, "T34 找到 tool-bash 行")
  如果 bash行 != 空:
    断言真(bash行["由预设提供"] == 真, "T35 tool-bash 由预设提供=真")
  断言真(unknown行 != 空, "T36 找到 unknown-tool-x 行")
  如果 unknown行 != 空:
    断言真(unknown行["由预设提供"] == 假, "T37 unknown-tool-x 由预设提供=假")

# =====================================================================
# §7 预设切换器（3 例）
# =====================================================================
段落 用例_切换器:
  设 切换器 为 预设切换器()
  断言相等(长度(切换器), 4, "T38 切换器四项")
  断言相等(切换器[0]["id"], "standard", "T39 首项 standard")
  断言相等(切换器[0]["标签"], "标准模式", "T40 首项标签=标准模式")
  断言相等(切换器[0]["是否默认"], 真, "T41 standard 是默认")

# =====================================================================
# §8 渲染插件页 键齐全（2 例）
# =====================================================================
段落 用例_渲染页:
  设 注册表 为 模拟注册表()
  设 页 为 渲染插件页(注册表, "standard", 空)
  断言真(字典包含键(页, "说明"), "T42 页含说明")
  断言真(字典包含键(页, "来源"), "T43 页含来源")
  断言真(字典包含键(页, "按模式概览"), "T44 页含按模式概览")
  断言真(字典包含键(页, "按模式"), "T45 页含按模式")
  断言真(字典包含键(页, "预设切换器"), "T46 页含预设切换器")
  断言真(字典包含键(页, "分组"), "T47 页含分组")
  断言相等(长度(页["分组"]), 2, "T48 分组两个")
  # 分组名
  断言相等(页["分组"][0]["分组"], "会话插件", "T49 第一组=会话插件")
  断言相等(页["分组"][1]["分组"], "全局插件", "T50 第二组=全局插件")

# =====================================================================
# §9 按模式概览口径标注（1 例）
# =====================================================================
段落 用例_口径标注:
  设 概览 为 按模式概览带标注()
  断言相等(长度(概览), 4, "T51 概览四项")
  设 含口径 为 真
  遍历 项 之 概览:
    如果 字典包含键(项, "口径") == 假:
      设 含口径 为 假
  断言真(含口径, "T52 概览每项含口径标注")
  断言相等(概览[0]["口径"], "patch 声明行数（含组行）", "T53 口径文案逐字")

# =====================================================================
# 执行全部用例
# =====================================================================
用例_文案逐字()
用例_小工具()
用例_成员行集()
用例_计数口径()
用例_会话分组()
用例_全局分组()
用例_切换器()
用例_渲染页()
用例_口径标注()

写 "全部通过！断言数=" + 转字符串(通过盘["通过"])