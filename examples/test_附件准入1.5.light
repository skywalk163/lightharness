# test_附件准入1.5.light —— 0.1.5 通用文件附件 + 消息词汇表（#48 / #4）反跑测试
# 覆盖：空串策略（图片 reject / 文件 accept）、错误码文案区分 Image/File、
#       存文件输入（零字节合法）、造文件引用（确定性/bytes/name 规整）、准入编码文件、
#       造系统消息（空→content 空；非空→text 块 + plugin source）、造文件块。
# 反跑判据：文件空串「放行」改「拒绝」→ 红；文件文案改回 Image → 红；
#           引用确定性改随机 → 红；造系统消息 空文本改 content 非空 → 红。
# 注意：写 只接受字面量串（L-045）；布尔链拆多行（L-043）；缺键用 字典包含键 守卫（L-036）。

从 JSON 导入 序列化JSON
从 附件准入 导入 判定规范base64按策略, 规整文件名, 存文件输入, 造文件引用, 准入编码文件, 存输入
从 消息 导入 造系统消息, 造文件块, 取消息文本

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

# 抛错 + 文案片段校验（既有 检查抛错 只判抛不判文案，此处需区分 Image/File 错误码）
段落 检查抛错文案(标签, 运算, 片段):
  设 消息 为 ""
  尝试:
    运算()
  捕获 错误:
    设 消息 为 转字符串(错误)
  如果 消息 == "":
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 查找子串(消息, 片段) == -1:
    抛出 新建 错误("错误文案不含[" + 片段 + "]: " + 标签 + " 实际=" + 消息)

# ---- 空串策略参数化 ----
段落 用例空串策略:
  断言相等(判定规范base64按策略("", "reject"), 假, "图片：空串 reject → 假")
  断言相等(判定规范base64按策略("", "accept"), 真, "文件：空串 accept → 真（零字节合法）")
  断言相等(判定规范base64按策略("AAAA", "reject"), 真, "非空串 reject 仍按规范判定")
  断言相等(判定规范base64按策略("AAB=", "accept"), 假, "非规范串 accept 仍为假")

# ---- 图片：错误文案含 Image ----
段落 段_图片空串:
  存输入(["data": "", "mediaType": "image/png"])

段落 段_图片非规范:
  存输入(["data": "AAB=", "mediaType": "image/png"])

段落 用例图片错误文案:
  检查抛错文案("图片空串文案含 Image", 段_图片空串, "Image")
  检查抛错文案("图片非规范文案含 Image", 段_图片非规范, "Image")

# ---- 文件：空串放行（零字节文件合法）----
段落 用例文件空串放行:
  设 结果 为 存文件输入(["data": ""])
  断言相等(结果["data"], 0, "零字节文件合法：data=0")
  断言相等(字典包含键(结果, "name"), 假, "未传 name 时不带该键")

# ---- 文件：非规范拒绝，文案含 File ----
段落 段_文件非规范:
  存文件输入(["data": "AAB="])

段落 用例文件非规范:
  检查抛错文案("文件非规范文案含 File", 段_文件非规范, "File")

# ---- 文件：规范通过 ----
段落 用例存文件输入:
  设 结果 为 存文件输入(["data": "AAAA", "name": "a.txt"])
  断言相等(结果["data"], 3, "规范 base64 → 3 字节")
  断言相等(结果["name"], "a.txt", "name 透传")

# ---- name 规整（剥离目录路径）----
段落 用例规整文件名:
  断言相等(规整文件名("dir/a.txt"), "a.txt", "剥离 / 路径")
  断言相等(规整文件名("a/b/c.txt"), "c.txt", "剥离多级路径")
  断言相等(规整文件名("a.txt"), "a.txt", "无路径不变")

# ---- 造文件引用 ----
段落 用例造文件引用:
  设 引用 为 造文件引用(["data": "AAAA", "name": "dir/a.txt"])
  断言相等(引用["bytes"], 3, "bytes 精确")
  断言相等(引用["name"], "a.txt", "name 规整去路径")
  断言相等(查找子串(引用["attachmentId"], "file-"), 0, "attachmentId 前缀 file-")

段落 用例引用确定性:
  设 甲 为 造文件引用(["data": "AAAA", "name": "a.txt"])
  设 乙 为 造文件引用(["data": "AAAA", "name": "a.txt"])
  断言相等(甲["attachmentId"], 乙["attachmentId"], "同输入同 attachmentId（确定性）")

段落 用例引用缺省名:
  设 引用 为 造文件引用(["data": "AAAA"])
  断言相等(引用["name"], "attachment", "未传 name → 缺省 attachment")

# ---- 准入编码文件 端到端（对齐 admitEncodedFile）----
段落 用例准入编码文件:
  设 引用 为 准入编码文件(["data": "AAAA", "name": "x/y.zip"])
  断言相等(引用["name"], "y.zip", "端到端：name 规整")
  断言相等(引用["bytes"], 3, "端到端：bytes 精确")
  设 空引用 为 准入编码文件(["data": ""])
  断言相等(空引用["bytes"], 0, "端到端：空串零字节合法")

# ---- 造系统消息（对齐 createSystemMessage）----
段落 用例造系统消息空:
  设 消息 为 造系统消息("", "system-prompt")
  断言相等(消息["role"], "system", "role=system")
  断言相等(长度(消息["content"]), 0, "空文本 → content 空（无系统提示）")
  断言相等(消息["source"]["kind"], "plugin", "source.kind=plugin")
  断言相等(消息["source"]["plugin"], "system-prompt", "source.plugin 透传")

段落 用例造系统消息非空:
  设 消息 为 造系统消息("你好", "my-plugin")
  断言相等(消息["role"], "system", "role=system")
  断言相等(长度(消息["content"]), 1, "非空 → 1 个块")
  断言相等(消息["content"][0]["type"], "text", "块类型 text")
  断言相等(消息["content"][0]["text"], "你好", "块文本")
  断言相等(消息["source"]["kind"], "plugin", "source.kind=plugin")
  断言相等(消息["source"]["plugin"], "my-plugin", "source.plugin 透传")

# ---- 造文件块（对齐 FileBlock）----
段落 用例造文件块:
  设 引用 为 造文件引用(["data": "AAAA", "name": "a.txt"])
  设 块 为 造文件块(引用)
  断言相等(块["type"], "file", "块类型 file")
  断言相等(块["attachment"]["name"], "a.txt", "attachment 引用透传")
  断言相等(块["attachment"]["bytes"], 3, "attachment bytes")
  # file 块须被投影为确定性句柄文本（名字 + 字节大小），不能静默跳过
  断言相等(取消息文本(["content": [块]]), "[文件 a.txt: 3 字节]", "取消息文本 投影 file 块句柄文本")

用例空串策略()
用例图片错误文案()
用例文件空串放行()
用例文件非规范()
用例存文件输入()
用例规整文件名()
用例造文件引用()
用例引用确定性()
用例引用缺省名()
用例准入编码文件()
用例造系统消息空()
用例造系统消息非空()
用例造文件块()
写 "--- 附件准入1.5 / 消息词汇表 测试通过 ---"
