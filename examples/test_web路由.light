# test_web路由.light —— W3 服务端路由扩展验收（反跑测试，建议新建）
#
# 运行通道：
#   python 运行.py examples/test_web路由.light                      # 默认（CORS 开、auth 经 初始化认证 随机令牌）
#   HARNESS_WEB_TOKEN=test-token python 运行.py examples/test_web路由.light   # 固定令牌分支
#   HARNESS_WEB_CORS=0 python 运行.py examples/test_web路由.light    # CORS 关闭分支
#
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 退出码非 0（反跑靠此立红）。
# 测试机制：直接调用模块级 路由处理器（HTTP 服务端每连接回调的同一函数）并断言响应字典，
#   同时仍经 全局服务.配置() 真正 bind 内核端口（满足"自起服务 + 内核端口"），
#   比起真 socket 客户端在光明异步模型下更确定、零抖动。
#
# 语言坑规避：断言一律 断言相等（L-037 no-op）；请求体用 b'...' 字节字面量
#   （处理对话 内部 字符串(体字节,"utf-8") 要求 bytes，字符串() 对 str 会报错）；
#   查询串 token 解析手写（不依赖 分割字符串 第二参）。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 认证 导入 初始化认证, 取令牌, 校验令牌
从 总入口 导入 组装注册表
从 文件系统 导入 写入文件, 文件存在, 删除文件, 路径连接, 目录存在, 删除目录, 创建目录
从 JSON 导入 解析JSON
从 字符串处理 导入 编码
从 内置核心字典 导入 字典包含键
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因

# ---- 断言助手（失败即抛 错误，驱动非零退出）----
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

# ---- mock 客户端（对齐 运行Web服务器.light 模拟客户端，使 处理对话 能返回 200）----
类 模拟客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 回应表 等于 空
  属性 应答序号 等于 0

  段落 构造(回应清单):
    设 己.模型名 为 "deepseek-chat"
    设 己.回应表 为 回应清单
    设 己.应答序号 为 0

  段落 对话响应(消息表, 选项表, 工具表):
    如果 己.应答序号 >= 长(己.回应表):
      设 己.应答序号 为 长(己.回应表) - 1
    设 回应文本 为 己.回应表[己.应答序号]
    设 己.应答序号 为 己.应答序号 + 1
    返回 [造块开始(0, "text"), 造文本增量(0, 回应文本), 造块结束(0, ["type": "text", "text": 回应文本]), 造结束(造停止原因())]

# ---- 请求构造助手 ----
段落 造请求(方法, 路径, 令牌头, 体):
  设 头 为 {}
  如果 令牌头 != "" 且 令牌头 != 空:
    头["X-Auth-Token"] 为 令牌头
  返回 ["方法": 方法, "路径": 路径, "头": 头, "体": 体]

段落 聊天体:
  返回 b'{"model":"x","messages":[{"role":"user","content":"hi"}]}'

# 取行值(行集, 行id)：从设置行集里取该行的 "值"；无此行或按钮行（无 值 字段）→ 空
段落 取行值(行集, 标识):
  设 结果 为 空
  遍历 行 之 行集:
    如果 行["id"] == 标识:
      如果 字典包含键(行, "值") == 真:
        设 结果 为 行["值"]
  返回 结果

# =====================================================================
# 主测试（异步：路由处理器是异步段落）
# =====================================================================
异步 段落 主测试:
  # ---- 准备：临时 webui 目录 + 会话根（调用方负责绝对路径）----
  设 基 为 当前目录()
  设 界面库 为 路径连接(基, "_w3_webui")
  设 会话根 为 路径连接(基, "_w3_sess")
  如果 目录存在(界面库) == 假:
    创建目录(界面库)
  写入文件(路径连接(界面库, "index.html"), "<!doctype html><html><body>WEBUI_INDEX</body></html>")
  写入文件(路径连接(界面库, "app.js"), "console.log('WEBUI_APPJS');")
  写入文件(路径连接(界面库, "style.css"), "/* WEBUI_CSS */ color-red")
  如果 目录存在(会话根) == 假:
    创建目录(会话根)

  设 客户端 为 新建 模拟客户端(["web mock reply"])
  设 注册表 为 组装注册表()

  # 内核端口 bind 检查（自起服务 + 内核端口 的实证）
  全局服务.配置(客户端, 注册表, 会话根, 30.0, 界面库)
  断言真(全局服务.端口() > 0, "内核端口已分配")

  # ---- 阶段1：向后兼容 —— 未配置 界面目录("") → GET / 返回 404 ----
  全局服务.停止()
  全局服务.配置(客户端, 注册表, 会话根, 30.0, "")   # 界面目录 空
  设 响应 为 等待 路由处理器(造请求("GET", "/", "", b''))
  断言相等(响应["状态"], 404, "兼容_未配置界面目录_GET根_404")

  # ---- 阶段2：静态路由启用（auth 仍禁用，S1 全放行）----
  全局服务.停止()
  全局服务.配置(客户端, 注册表, 会话根, 30.0, 界面库)

  设 响应 为 等待 路由处理器(造请求("GET", "/", "", b''))
  断言相等(响应["状态"], 200, "静态_GET根_200")
  断言相等(响应["头"].获取("Content-Type", ""), "text/html; charset=utf-8", "静态_GET根_类型")
  断言真(响应["体"].查找("WEBUI_INDEX") >= 0, "静态_GET根_含标记")

  设 响应 为 等待 路由处理器(造请求("GET", "/app.js", "", b''))
  断言相等(响应["状态"], 200, "静态_GETappjs_200")
  断言相等(响应["头"].获取("Content-Type", ""), "application/javascript; charset=utf-8", "静态_GETappjs_类型")
  断言真(响应["体"].查找("WEBUI_APPJS") >= 0, "静态_GETappjs_含标记")

  设 响应 为 等待 路由处理器(造请求("GET", "/style.css", "", b''))
  断言相等(响应["状态"], 200, "静态_GETcss_200")
  断言相等(响应["头"].获取("Content-Type", ""), "text/css; charset=utf-8", "静态_GETcss_类型")
  断言真(响应["体"].查找("WEBUI_CSS") >= 0, "静态_GETcss_含标记")

  设 响应 为 等待 路由处理器(造请求("GET", "/nope.js", "", b''))
  断言相等(响应["状态"], 404, "静态_GET未知_404")

  # ---- CORS 头：默认(HARNESS_WEB_CORS!=0) 应含 Access-Control-Allow-Origin:* ----
  #   若以 HARNESS_WEB_CORS=0 运行，则断言该头不存在（自一致，两模式跨两次运行覆盖）----
  设 响应 为 等待 路由处理器(造请求("GET", "/health", "", b''))
  设  cors开关 为 环境变量("HARNESS_WEB_CORS", "1")
  如果 cors开关 == "0":
    断言相等(响应["头"].获取("Access-Control-Allow-Origin", "<无>"), "<无>", "CORS关闭_无头")
  否则:
    断言相等(响应["头"].获取("Access-Control-Allow-Origin", "<无>"), "*", "CORS开启_有头")

  # ---- S1：auth 未启用 → /v1/chat/completions 无 token 也 200（全放行）----
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "", 聊天体()))
  断言相等(响应["状态"], 200, "S1_无token聊天_200")

  # ---- 阶段3：认证启用（S2 语义）----
  初始化认证()
  设 令牌 为 取令牌()
  断言真(令牌 != "" 且 令牌 != 空, "S2_令牌非空")
  # 若固定令牌环境变量在场，额外校验一致性
  设 固定 为 环境变量("HARNESS_WEB_TOKEN", "")
  如果 固定 != "" 且 固定 != 空:
    断言相等(令牌, 固定, "S2_固定令牌一致")

  # 无 token → 401
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "", 聊天体()))
  断言相等(响应["状态"], 401, "S2_无token_401")
  断言相等(响应["体"].查找("未认证") >= 0, 真, "S2_401_体含未认证")

  # 正确 X-Auth-Token 头 → 200（mock 走通）
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", 令牌, 聊天体()))
  断言相等(响应["状态"], 200, "S2_正确头token_200")

  # 错误 token → 401
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "wrong-token", 聊天体()))
  断言相等(响应["状态"], 401, "S2_错误头token_401")

  # URL query ?token= → 200
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions?token=" + 令牌, "", 聊天体()))
  断言相等(响应["状态"], 200, "S2_查询token_200")

  # /health 白名单 → 无 token 也 200
  设 响应 为 等待 路由处理器(造请求("GET", "/health", "", b''))
  断言相等(响应["状态"], 200, "S2_health白名单_200")

  # 静态资源白名单 → 无 token 也 200
  设 响应 为 等待 路由处理器(造请求("GET", "/", "", b''))
  断言相等(响应["状态"], 200, "S2_静态白名单_200")

  # 未知静态路径在认证启用时也应 404（不被 401 拦下；/favicon.ico 同场景）
  设 响应 为 等待 路由处理器(造请求("GET", "/nope.js", "", b''))
  断言相等(响应["状态"], 404, "S2_未知静态_404")

  # =====================================================================
  # 阶段4：设置读/写 API + 静态白名单扩条目（R105 任务线 C）
  #   认证已在阶段3 启用 —— 本阶段全部请求不带 token，
  #   POST /api/settings 与 GET /api/settings/* 必须仍放行（否则会拿到 401）。
  # =====================================================================
  # ① 静态白名单：/settings.js、/settings.css → 200
  写入文件(路径连接(界面库, "settings.js"), "console.log('WEBUI_SETTINGS_JS');")
  写入文件(路径连接(界面库, "settings.css"), "/* WEBUI_SETTINGS_CSS */ color-blue")
  设 响应 为 等待 路由处理器(造请求("GET", "/settings.js", "", b''))
  断言相等(响应["状态"], 200, "设置静态_GETsettingsjs_200")
  断言相等(响应["头"].获取("Content-Type", ""), "application/javascript; charset=utf-8", "设置静态_GETsettingsjs_类型")
  设 响应 为 等待 路由处理器(造请求("GET", "/settings.css", "", b''))
  断言相等(响应["状态"], 200, "设置静态_GETsettingscss_200")
  断言相等(响应["头"].获取("Content-Type", ""), "text/css; charset=utf-8", "设置静态_GETsettingscss_类型")

  # ② GET /api/settings：200 且 通用设置.行集 为九行、id 序齐全
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  断言相等(响应["状态"], 200, "设置_GET_200")
  设 页 为 解析JSON(响应["体"])
  设 通用 为 页["通用设置"]
  设 行集 为 通用["行集"]
  断言相等(长(行集), 12, "设置_GET_行集十二行")
  设 标识串 为 ""
  遍历 行 之 行集:
    设 标识串 为 标识串 + 行["id"] + ","
  断言相等(标识串, "permission,language,appearance,fontSize,transcriptView,performanceUsage,linkOpening,developerTools,shortcuts,composerEnter,sessionLogDeepseek,currentVersion,", "设置_GET_十二行id齐全")

  # ③ POST /api/settings 合法值 → 200 + 落盘 + GET 回读已变
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"developerTools","值":false}'))
  断言相等(响应["状态"], 200, "设置_POST开关合法_200")
  设 回 为 解析JSON(响应["体"])
  断言相等(回["状态"], "ok", "设置_POST开关合法_状态ok")
  设 存文件 为 路径连接(会话根, "settings.json")
  断言相等(文件存在(存文件), 真, "设置_POST_落盘settingsjson")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"fontSize","值":16}'))
  断言相等(响应["状态"], 200, "设置_POST数字合法_200")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  设 页2 为 解析JSON(响应["体"])
  设 行集2 为 页2["通用设置"]["行集"]
  断言相等(取行值(行集2, "developerTools"), 假, "设置_回读_developerTools为假")
  断言相等(取行值(行集2, "fontSize"), 16, "设置_回读_fontSize为16")

  # ④ POST /api/settings 非法值 → 400 且体含 错误 键
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"fontSize","值":99}'))
  断言相等(响应["状态"], 400, "设置_POST字号越界_400")
  设 坏 为 解析JSON(响应["体"])
  断言相等(字典包含键(坏, "错误"), 真, "设置_POST字号越界_体含错误键")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"nope","值":1}'))
  断言相等(响应["状态"], 400, "设置_POST未知行_400")

  # ⑤ GET /api/settings/document → 200 且含 路径 + 可用
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/document", "", b''))
  断言相等(响应["状态"], 200, "设置文档_GET_200")
  设 文档 为 解析JSON(响应["体"])
  断言相等(字典包含键(文档, "路径"), 真, "设置文档_含路径键")
  断言相等(字典包含键(文档, "可用"), 真, "设置文档_含可用键")

  # ⑥ 持久化文件写坏 JSON → GET /api/settings 仍 200 不 500，值回落默认
  写入文件(存文件, "{ 这不是合法 JSON")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  断言相等(响应["状态"], 200, "设置_坏JSON_仍200")
  设 页3 为 解析JSON(响应["体"])
  设 行集3 为 页3["通用设置"]["行集"]
  断言相等(取行值(行集3, "developerTools"), 真, "设置_坏JSON_回落默认真")

  # =====================================================================
  # 阶段5：R106 任务线 C —— 静态补洞 / 生效链 / 权限联动 / 文档语义 / 快捷键
  #   临时静态文件一律写入本测试自建假界面目录（_w3_webui），不碰真实 webui/。
  #   认证已在阶段3 启用：GET 默认放行；GET /api/permissions 例外需带 token。
  # =====================================================================
  # ① 静态白名单：/slash-palette.js → 200（P0 真 bug）
  写入文件(路径连接(界面库, "slash-palette.js"), "console.log('R106_PALETTE');")
  设 响应 为 等待 路由处理器(造请求("GET", "/slash-palette.js", "", b''))
  断言相等(响应["状态"], 200, "R106_静态_palette_200")
  断言相等(响应["头"].获取("Content-Type", ""), "application/javascript; charset=utf-8", "R106_静态_palette_类型")
  断言真(响应["体"].查找("R106_PALETTE") >= 0, "R106_静态_palette_含标记")
  # ② /index.html → 200 且与 / 同内容
  设 响应根 为 等待 路由处理器(造请求("GET", "/", "", b''))
  设 响应idx 为 等待 路由处理器(造请求("GET", "/index.html", "", b''))
  断言相等(响应idx["状态"], 200, "R106_静态_indexhtml_200")
  断言相等(响应idx["体"], 响应根["体"], "R106_静态_indexhtml_同根内容")
  # ③ GET /api/settings/effective → 200 且七键齐全
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/effective", "", b''))
  断言相等(响应["状态"], 200, "R106_effective_200")
  设 生效 为 解析JSON(响应["体"])
  断言真(字典包含键(生效, "主题"), "R106_effective_键主题")
  断言真(字典包含键(生效, "字号"), "R106_effective_键字号")
  断言真(字典包含键(生效, "语言"), "R106_effective_键语言")
  断言真(字典包含键(生效, "链接目标"), "R106_effective_键链接目标")
  断言真(字典包含键(生效, "权限档位"), "R106_effective_键权限档位")
  断言真(字典包含键(生效, "权限预设"), "R106_effective_键权限预设")
  断言真(字典包含键(生效, "降级项"), "R106_effective_键降级项")
  # ⑧ GET /api/settings/document：两键齐全，profile patch 不存在 → 可用假、路径空
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/document", "", b''))
  断言相等(响应["状态"], 200, "R106_document_200")
  设 文档 为 解析JSON(响应["体"])
  断言真(字典包含键(文档, "路径"), "R106_document_含路径")
  断言真(字典包含键(文档, "可用"), "R106_document_含可用")
  断言相等(文档["可用"], 假, "R106_document_profile不存在_可用假")
  断言相等(文档["路径"], "", "R106_document_profile不存在_路径空")
  # ⑩ GET /api/shortcuts → 200 三键齐全，目录含 fixed.move/select/dismiss
  设 响应 为 等待 路由处理器(造请求("GET", "/api/shortcuts", "", b''))
  断言相等(响应["状态"], 200, "R106_shortcuts_GET_200")
  设 短 为 解析JSON(响应["体"])
  断言真(字典包含键(短, "文档"), "R106_shortcuts_键文档")
  断言真(字典包含键(短, "自定义计数"), "R106_shortcuts_键计数")
  断言真(字典包含键(短, "目录"), "R106_shortcuts_键目录")
  设 目录表 为 短["目录"]
  设 有move 为 假
  设 有select 为 假
  设 有dismiss 为 假
  遍历 项 之 目录表:
    如果 项["id"] == "fixed.move":
      设 有move 为 真
    如果 项["id"] == "fixed.select":
      设 有select 为 真
    如果 项["id"] == "fixed.dismiss":
      设 有dismiss 为 真
  断言真(有move, "R106_shortcuts_含fixed.move")
  断言真(有select, "R106_shortcuts_含fixed.select")
  断言真(有dismiss, "R106_shortcuts_含fixed.dismiss")
  # ⑪ shortcuts 往返：POST Mod+J → 当前键变、是否自定义；非法 J → 400 modifier-required；重置 → 计数0
  设 响应 为 等待 路由处理器(造请求("POST", "/api/shortcuts", "", b'{"命令":"fixed.move","键":"Mod+J"}'))
  断言相等(响应["状态"], 200, "R106_shortcuts_POST改键_200")
  设 改后 为 解析JSON(响应["体"])
  设 新目录 为 改后["目录"]
  设 move改 为 假
  遍历 项 之 新目录:
    如果 项["id"] == "fixed.move":
      断言相等(项["当前键"], "Mod+J", "R106_shortcuts_fixedmove当前键（Mod 形式回显）")
      断言相等(项["是否自定义"], 真, "R106_shortcuts_fixedmove自定义")
      设 move改 为 真
  断言真(move改, "R106_shortcuts_找到fixed.move")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/shortcuts", "", b'{"命令":"fixed.move","键":"J"}'))
  断言相等(响应["状态"], 400, "R106_shortcuts_无修饰键_400")
  设 坏短 为 解析JSON(响应["体"])
  断言真(坏短["错误"].查找("请同时按下 Command、Ctrl 或 Alt 修饰键。") >= 0, "R106_shortcuts_无修饰键文案")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/shortcuts", "", b'{"重置":true}'))
  断言相等(响应["状态"], 200, "R106_shortcuts_重置_200")
  设 重置后 为 解析JSON(响应["体"])
  设 响应 为 等待 路由处理器(造请求("GET", "/api/shortcuts", "", b''))
  设 短2 为 解析JSON(响应["体"])
  断言相等(短2["自定义计数"], 0, "R106_shortcuts_重置后计数0")
  # ④ POST appearance=system → effective 带 ?系统偏好=dark 为 dark，不带为 light
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"appearance","值":"system"}'))
  断言相等(响应["状态"], 200, "R106_POST_appearance_system_200")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/effective?系统偏好=dark", "", b''))
  设 效dark 为 解析JSON(响应["体"])
  断言相等(效dark["主题"], "dark", "R106_effective_system_dark偏好")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/effective", "", b''))
  设 效light 为 解析JSON(响应["体"])
  断言相等(效light["主题"], "light", "R106_effective_system_缺省light")
  # ⑨ POST appearance=dark → effective 主题 dark
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"appearance","值":"dark"}'))
  断言相等(响应["状态"], 200, "R106_POST_appearance_dark_200")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/effective", "", b''))
  设 效d 为 解析JSON(响应["体"])
  断言相等(效d["主题"], "dark", "R106_effective_appearance_dark")
  # ⑤ POST permission=fullAccess → 权限预设全放行 + GET /api/permissions 回读全放行（带 token）
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"permission","值":"fullAccess"}'))
  断言相等(响应["状态"], 200, "R106_POST_perm_full_200")
  设 存perm 为 解析JSON(响应["体"])
  断言相等(存perm["权限预设"], "全放行", "R106_POST_perm_full_预设全放行")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/permissions", 令牌, b''))
  断言相等(响应["状态"], 200, "R106_GET_permissions_200")
  设 回perm 为 解析JSON(响应["体"])
  断言相等(回perm["预设"], "全放行", "R106_GET_permissions_回读全放行")
  # ⑥ POST permission=readOnly → 权限预设全拒绝
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"permission","值":"readOnly"}'))
  断言相等(响应["状态"], 200, "R106_POST_perm_readonly_200")
  设 存perm2 为 解析JSON(响应["体"])
  断言相等(存perm2["权限预设"], "全拒绝", "R106_POST_perm_readonly_预设全拒绝")
  # ⑦ POST 非法档位 bogus → 400 含 错误
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"permission","值":"bogus"}'))
  断言相等(响应["状态"], 400, "R106_POST_perm_bogus_400")
  设 坏perm 为 解析JSON(响应["体"])
  断言真(字典包含键(坏perm, "错误"), "R106_POST_perm_bogus_含错误")

  # =====================================================================
  # 阶段6：R107 任务线 E —— 三页真实化 / 模型写回 / 配置文档路径 / 快捷键落盘
  # =====================================================================
  # ① GET /api/settings 模型 键 = A 线形状（提供商行/模型行非空且字段齐全）
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  断言相等(响应["状态"], 200, "R107_settings_GET_200")
  设 页R107 为 解析JSON(响应["体"])
  断言真(字典包含键(页R107, "模型"), "R107_settings_含模型键")
  断言真(字典包含键(页R107, "内置插件"), "R107_settings_含插件键")
  断言真(字典包含键(页R107, "Agent预设"), "R107_settings_含预设键")
  设 模型页R107 为 页R107["模型"]
  断言真(长度(模型页R107["提供商行"]) > 0, "R107_模型页_提供商行非空")
  断言相等(模型页R107["提供商行"][0]["provider"], "deepseek-official", "R107_模型页_provider")
  断言相等(长度(模型页R107["模型行"]), 4, "R107_模型页_模型行四条")
  # ② 内置插件 键：成员条数 == 计数（一致性断言；反跑锚点：接线改回占位 → 此处红）
  设 插件页R107 为 页R107["内置插件"]
  断言相等(长度(插件页R107["分组"]), 2, "R107_插件页_两组")
  设 会话组R107 为 插件页R107["分组"][0]
  断言相等(会话组R107["分组"], "会话插件", "R107_插件页_会话分组")
  断言相等(长度(会话组R107["项"]), 会话组R107["计数"], "R107_插件页_计数一致")
  断言相等(会话组R107["计数"], 29, "R107_插件页_standard展平叶子29")
  设 全局组R107 为 插件页R107["分组"][1]
  断言相等(长度(全局组R107["项"]), 全局组R107["计数"], "R107_插件页_全局计数一致")
  # ③ Agent预设 键：四卡且每卡含配置详情块
  设 预设页R107 为 页R107["Agent预设"]
  断言相等(长度(预设页R107["分组"][0]["预设"]), 4, "R107_预设页_内置四卡")
  遍历 卡R107 之 预设页R107["分组"][0]["预设"]:
    断言真(字典包含键(卡R107, "配置"), "R107_预设页_卡含配置块")
  # ③2 C 线写路径：POST agentPresetDefault=ptc → 200 + 落盘 + 回读；非法 → 400 逐字
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"agentPresetDefault","值":"ptc"}'))
  断言相等(响应["状态"], 200, "R107_POST_默认预设ptc_200")
  设 回默认R107 为 解析JSON(响应["体"])
  断言相等(回默认R107["默认预设"], "ptc", "R107_POST_默认预设ptc_回读")
  断言相等(文件存在(存文件), 真, "R107_POST_默认预设_落盘settingsjson")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings", "", b'{"行":"agentPresetDefault","值":"bogus"}'))
  断言相等(响应["状态"], 400, "R107_POST_默认预设非法_400")
  设 坏默认R107 为 解析JSON(响应["体"])
  断言真(坏默认R107["错误"].查找("合法预设") >= 0, "R107_POST_默认预设非法_文案含合法清单")
  # ④ 模型页 凭据 随配置元数据有无密钥变化（.env 有无的运行时观察点：has_key）
  设 客户端R107 为 新建 模拟客户端(["r107"])
  全局服务.停止()
  全局服务.配置(客户端R107, 注册表, 会话根, 30.0, 界面库, ["configured": 1, "mock": 1, "model": "deepseek-flash", "endpoint": "https://api.deepseek.com", "has_key": 1])
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  设 页有R107 为 解析JSON(响应["体"])
  断言相等(页有R107["模型"]["提供商行"][0]["凭据"]["configured"], 真, "R107_凭据_haskey1_真")
  全局服务.停止()
  全局服务.配置(客户端R107, 注册表, 会话根, 30.0, 界面库)
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings", "", b''))
  设 页无R107 为 解析JSON(响应["体"])
  断言相等(页无R107["模型"]["提供商行"][0]["凭据"]["configured"], 假, "R107_凭据_无key_假")
  # ⑤ POST /api/settings/model 带 api_key → 200 且响应绝不含密钥明文（逐字符断言）
  设 密钥串R107 为 "sk-r107-secret-abc123XYZ"
  设 模型体串 为 "{\"api_key\":\"" + 密钥串R107 + "\",\"base_url\":\"https://api.deepseek.com\",\"model\":\"deepseek-flash\"}"
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings/model", "", 编码(模型体串)))
  断言相等(响应["状态"], 200, "R107_POST_model_带key_200")
  断言真(响应["体"].查找(密钥串R107) == -1, "R107_POST_model_响应无密钥明文")
  设 回模型R107 为 解析JSON(响应["体"])
  断言相等(回模型R107["状态"], "ok", "R107_POST_model_状态ok")
  断言相等(回模型R107["凭据"]["configured"], 真, "R107_POST_model_凭据configured真")
  # ⑥ POST 空 api_key → 200 不报错（留空=保持已存）
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings/model", "", b'{"base_url":"https://api.deepseek.com"}'))
  断言相等(响应["状态"], 200, "R107_POST_model_空key_200")
  # ⑦ POST 非法（模型 ID 重复）→ 400 且 错误 含上游逐字消息
  设 重复体串 为 "{\"models\":[{\"id\":\"deepseek-flash\",\"上下文窗口\":1000}]}"
  设 响应 为 等待 路由处理器(造请求("POST", "/api/settings/model", "", 编码(重复体串)))
  断言相等(响应["状态"], 400, "R107_POST_model_重复id_400")
  断言真(响应["体"].查找("模型 ID 不能重复。") >= 0, "R107_POST_model_重复id_逐字文案")
  # ⑧ GET /api/settings/document：文件名修正为 cordis.patch.json（逐字）；存在→可用真路径含文件名；不存在→可用假路径空
  设 patch目录R107 为 路径连接(路径连接(会话根, "profiles"), "web")
  如果 目录存在(patch目录R107) == 假:
    创建目录(patch目录R107)
  写入文件(路径连接(patch目录R107, "cordis.patch.json"), "[]")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/document", "", b''))
  断言相等(响应["状态"], 200, "R107_document_200")
  设 文档R107 为 解析JSON(响应["体"])
  断言真(文档R107["路径"].查找("cordis.patch.json") >= 0, "R107_document_路径含cordispatchjson")
  断言相等(文档R107["可用"], 真, "R107_document_存在_可用真")
  删除文件(路径连接(patch目录R107, "cordis.patch.json"))
  设 响应 为 等待 路由处理器(造请求("GET", "/api/settings/document", "", b''))
  设 文档空R107 为 解析JSON(响应["体"])
  断言相等(文档空R107["可用"], 假, "R107_document_不存在_可用假")
  断言相等(文档空R107["路径"], "", "R107_document_不存在_路径空")
  # ⑨ 快捷键落盘：改一键 → keybindings.json 存在 → 文档.可用真 → 重建目录后读回自定义值
  设 响应 为 等待 路由处理器(造请求("POST", "/api/shortcuts", "", b'{"命令":"fixed.move","键":"Mod+K"}'))
  断言相等(响应["状态"], 200, "R107_shortcuts_POST改键_200")
  设 键文件R107 为 路径连接(会话根, "keybindings.json")
  断言相等(文件存在(键文件R107), 真, "R107_shortcuts_落盘keybindingsjson")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/shortcuts", "", b''))
  设 短R107 为 解析JSON(响应["体"])
  断言相等(短R107["文档"]["可用"], 真, "R107_shortcuts_文档可用真")
  # 模拟重启：清进程内目录 → 下次 GET 懒加载默认目录并从 keybindings.json 合并
  设 全局服务.快捷键目录 为 空
  设 全局服务.快捷键已合并 为 假
  设 响应 为 等待 路由处理器(造请求("GET", "/api/shortcuts", "", b''))
  设 短重启R107 为 解析JSON(响应["体"])
  设 读回键R107 为 ""
  遍历 项R107 之 短重启R107["目录"]:
    如果 项R107["id"] == "fixed.move":
      设 读回键R107 为 项R107["当前键"]
  断言相等(读回键R107, "Mod+K", "R107_shortcuts_重启读回自定义键")

  # 清理临时目录（尽力而为，失败不阻断验收：会话根可能含嵌套子目录）
  全局服务.停止()
  尝试:
    删除文件(存文件)
    删除文件(路径连接(会话根, "keybindings.json"))
  捕获 异常 e:
    设 忽略存 为 空
  尝试:
    删除文件(路径连接(界面库, "index.html"))
    删除文件(路径连接(界面库, "app.js"))
    删除文件(路径连接(界面库, "style.css"))
    删除文件(路径连接(界面库, "settings.js"))
    删除文件(路径连接(界面库, "settings.css"))
    删除文件(路径连接(界面库, "slash-palette.js"))
    删除目录(界面库)
  捕获 异常 e:
    写 "清理界面库跳过: "; 写 转字符串(e)
  尝试:
    删除目录(会话根)
  捕获 异常 e:
    写 "清理会话根跳过: "; 写 转字符串(e)

  写 "--- 测试web路由(静态/CORS/认证) 通过 ---"

异步 运行 主测试()
