# test_词法安全.light —— 第18轮 任务6（标识符与词法安全库）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_词法安全.light
# 修复对象：L-084/L-092/L-101/L-119/L-120/L-137/L-143（A级检查）/ L-087（B级）/
#   L-094/L-095（C级绕法指南）
#
# 反跑判据（改源码一行测试必须红，恢复后绿）：
#   A=正常：保留字表+是保留字+安全标识符 组合使用（回归绿验证）
#   B=边界：安全标识符对保留字候选名返回备选或自动后缀，可切分检查正确识别（回归绿验证）
#   C=变异：单字别名串移除 配 字 -> 是保留字("配置") 断言立红
#     （注：为 字同时被多字关键字表兜底，单字锚点选仅存在于 L-119 单字表的 配）

从 词法安全 导入 保留字表, 是保留字, 标识符可切分检查, 安全标识符, 标识符规范化, 是内置映射名, 变量名安全检查, 生成安全变量名, 模块名安全检查, 绕法指南

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含(文本, 子串, 标签):
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 保留字表（反跑 C 锚点数据） ============
  设 全表 为 保留字表()
  断言真(列表长度(全表) > 40, "保留字表非空且规模合理")
  断言真(列表包含(全表, "为"), "含 为 字")
  断言真(列表包含(全表, "返回"), "含 返回")
  断言真(列表包含(全表, "回调"), "含 回调")
  断言真(列表包含(全表, "作用域"), "含 作用域")
  断言真(列表包含(全表, "尝试"), "含 尝试")
  断言真(列表包含(全表, "设"), "含单字 设")
  # 元素全为字符串
  设 全字符串 为 真
  遍历 项 之 全表:
    如果 是字符串(项) == 假:
      设 全字符串 为 假
  断言真(全字符串, "元素全为字符串")

  # ============ 2) 是保留字（反跑 C 断言） ============
  设 判甲 为 是保留字("行为")
  断言真(判甲["是保留字"], "行为 含 为 字")
  断言相等(判甲["匹配的保留字"], "为", "行为 匹配 为")
  设 判乙 为 是保留字("配置")
  断言真(判乙["是保留字"], "配置 含 单字别名 配")
  断言相等(判乙["匹配的保留字"], "配", "配置 匹配 配")
  断言真(是保留字("返回")["是保留字"], "纯保留字 返回")
  断言真(是保留字("回调")["是保留字"], "回调 保留")
  断言真(是保留字("作用域")["是保留字"], "作用域 保留")
  断言真(是保留字("参数为取")["是保留字"], "含 为 子串")
  断言真(是保留字("尝试态")["是保留字"], "含 尝试 子串")
  断言真(是保留字("存储核心")["是保留字"] == 假, "安全名判假")
  断言真(是保留字("")["是保留字"] == 假, "空串判假")

  # ============ 3) 可切分检查（L-120） ============
  断言真(标识符可切分检查("设为"), "设+为 可完全切分")
  断言真(标识符可切分检查("返回为"), "返回+为 可完全切分")
  断言真(标识符可切分检查("存储核心") == 假, "不可切分")
  断言真(标识符可切分检查("回调") == 假, "单保留字不叫切分（整体匹配）")

  # ============ 4) 安全标识符（A/B 判据） ============
  断言相等(安全标识符("存储核心", ""), "存储核心", "安全名原样")
  断言相等(安全标识符("回调", "处理器"), "处理器", "保留字返回备选")
  断言相等(安全标识符("回调", ""), "回调_安全", "无备选自动后缀")
  断言相等(安全标识符("设为", "设值"), "设值", "可切分返回备选")
  断言真(安全标识符("作用域", "") == "作用域_安全", "作用域 自动后缀")

  # ============ 5) 标识符规范化 ============
  断言相等(标识符规范化("参数为取"), "参数取", "移除 为 字")
  断言相等(标识符规范化("存储核心"), "存储核心", "安全名不变")
  断言相等(标识符规范化("返回"), "返回_安全", "全保留字退化为后缀名")

  # ============ 6) 内置映射名（L-087） ============
  断言真(是内置映射名("码位"), "码位 内置")
  断言真(是内置映射名("字典获取"), "字典获取 内置")
  断言真(是内置映射名("存储核心") == 假, "普通名非内置")

  # ============ 7) 变量名安全检查 ============
  设 安检 为 变量名安全检查("存储核心")
  断言真(安检["安全"], "安全名通过")
  设 坏检 为 变量名安全检查("回调")
  断言真(坏检["安全"] == 假, "保留字不安全")
  断言真(列表长度(坏检["问题列表"]) > 0, "问题列表非空")
  设 数字检 为 变量名安全检查("1甲")
  断言真(数字检["安全"] == 假, "数字开头不安全")

  # ============ 8) 生成安全变量名 ============
  设 名一 为 生成安全变量名("临时", "测试上下文")
  设 名二 为 生成安全变量名("临时", "测试上下文")
  断言含(名一, "临时", "生成名含前缀")
  断言真(名一 != 名二, "两次生成不同")
  断言真(是保留字(名一)["是保留字"] == 假, "生成名非保留字")

  # ============ 9) 模块名安全检查（L-094 配套） ============
  断言真(模块名安全检查("会话"), "既有模块名冲突")
  断言真(模块名安全检查("新域模块") == 假, "新模块名不冲突")

  # ============ 10) 绕法指南（C级） ============
  断言含(绕法指南("L-084"), "避开 为 字", "L-084 指南")
  断言含(绕法指南("L-095"), "宿主面标准 hmac", "L-095 指南")
  断言含(绕法指南("L-098"), "闭包包装", "L-098 指南引用工具库")
  断言真(绕法指南("L-999") == 空, "未知编号返回空")

  打印("test_词法安全 PASS")

主()
