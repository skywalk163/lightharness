# test_类型系统_接线.light —— 第6轮 任务E #276 typert 接线 判据
# 运行：python 运行.py examples/test_类型系统_接线.light
# 判据：typert校验工具参数（工具 schema 面）+ typert推断消息块种类（客户端消息形状面）
#       + 型协登记查找项（类型注册 描述符存储面）；纯逻辑回归绿由 test_类型系统.light 承担。

从 类型系统 导入 typert校验工具参数, typert推断消息块种类, 工具模式转typert节点, typert值节点, 造原语, 造字面量, 可赋值
从 typert协议 导入 型协构造查找定义, 型协登记查找项
从 类型注册 导入 造描述符存储

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. typert 校验工具参数：合法参数通过 ----
  设 模式 为 {"type": "object", "required": ["路径"], "properties": {"路径": {"type": "string"}, "次数": {"type": "integer"}}}
  设 r1 为 typert校验工具参数(模式, {"路径": "a.txt", "次数": 2})
  断言真(r1[0], "1a 合法参数通过")
  断言相等(列表长度(r1[1]), 0, "1b 错误表空")

  # ---- 2. 必填缺失 + 类型不符 -> 错误表非空 ----
  设 r2 为 typert校验工具参数(模式, {"次数": "不是数字"})
  断言真(r2[0] == 假, "2a 缺路径须不通过")
  断言真(列表长度(r2[1]) >= 2, "2b 缺路径+类型不符两条错")

  # ---- 3. 类型不符单独报 ----
  设 r3 为 typert校验工具参数(模式, {"路径": "a.txt", "次数": "x"})
  断言真(r3[0] == 假, "3a 次数类型不符")
  断言真(列表长度(r3[1]) == 1, "3b 恰一条错")

  # ---- 4. 模式转节点 + 可赋值（既有纯逻辑回归锚点） ----
  设 节点 为 工具模式转typert节点(模式)
  断言真(是字典(节点), "4a 对象节点")
  断言真(可赋值(造字面量("a", "string"), 造原语("string")), "4b 字面量可赋原语")
  断言真(可赋值(typert值节点(1), 造原语("number")) == 假 或 可赋值(typert值节点(1), 造原语("number")) == 真, "4c 值节点可判")

  # ---- 5. 客户端消息块种类推断（词表对齐 客户端.消息块输入） ----
  设 内容 为 [{"type": "text", "text": "hi"}, {"type": "tool_use", "id": "1"}, {"type": "image"}, {"type": "别的东西"}]
  设 r5 为 typert推断消息块种类(内容)
  断言相等(列表长度(r5["种类表"]), 4, "5a 四块")
  断言相等(r5["种类表"][1], "tool_use", "5b 种类透传")
  断言相等(r5["未知块数"], 1, "5c 未知块计数")

  # ---- 6. 型协查找项登记到 类型注册 描述符存储 ----
  设 存储 为 造描述符存储()
  设 查找 为 型协构造查找定义("键1", "参数名", "线字段", "主机类型", "线类型")
  设 r6 为 型协登记查找项(存储, 查找)
  断言相等(r6["键"], "typert:键1", "6a 注册键")
  断言相等(r6["存储条目数"], 1, "6b 条目数")
  断言真(存储.判定已登记(r6["键"]), "6c 可查询")

  # ---- 7. 非法查找定义 -> 抛错（纯逻辑判定保留） ----
  设 已抛 为 假
  尝试:
    设 _r7 为 型协登记查找项(存储, {"不是": "查找项"})
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "7a 形状非法须抛")

  打印 "--- 第6轮 任务E #276 typert 接线 测试通过 ---"

主()