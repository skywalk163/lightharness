# test_审批_接线.light —— 第6轮 任务E #288 审批/交互命令接权限闸门 判据
# 运行：python 运行.py examples/test_审批_接线.light
# 判据：接线审批到权限（权限.检查 的「审批」分类 → 审批管理器.请求审批 生成审批单）
#       + 接线权限预设到闸门（旋钮事件 → 推导预设 → 权限管理器.设置预设）；
#       纯逻辑回归绿由 test_审批.light / test_交互命令.light / test_权限.light 承担。

从 审批 导入 接线审批到权限, 审批管理器
从 权限 导入 权限管理器, 预设全放行
从 交互命令 导入 接线权限预设到闸门

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 权限判「审批」→ 生成审批单 ----
  设 权限对象 为 新建 权限管理器()
  设 审批器 为 新建 审批管理器()
  设 r1 为 接线审批到权限(权限对象, 审批器, "会话1", 3, "bash", {"命令": "git commit -m x"})
  断言相等(r1["分类"], "审批", "1a 修改命令判审批")
  断言真(r1["需审批"], "1b 需审批")
  断言真(字符串长度(r1["审批id"]) > 0, "1c 审批单已生成")
  断言真(审批器.取审批(r1["审批id"]) != 空, "1d 审批单可查")

  # ---- 2. 只读命令判放行 -> 无审批单 ----
  设 r2 为 接线审批到权限(权限对象, 审批器, "会话1", 4, "bash", {"命令": "ls"})
  断言相等(r2["分类"], "放行", "2a 只读命令判放行")
  断言真(r2["需审批"] == 假, "2b 不需审批")
  断言相等(r2["审批id"], 空, "2c 无审批单")

  # ---- 3. 全放行预设 -> 即使修改命令也放行 ----
  设 权限对象2 为 新建 权限管理器()
  权限对象2.设置预设(预设全放行)
  设 r3 为 接线审批到权限(权限对象2, 审批器, "会话1", 5, "bash", {"命令": "rm -rf /"})
  断言相等(r3["分类"], "放行", "3a 全放行预设")
  断言相等(r3["审批id"], 空, "3b 无审批单")

  # ---- 4. 旋钮事件推导预设 → 应用到闸门 ----
  设 权限对象3 为 新建 权限管理器()
  设 预设表 为 {"standard": {"sandbox": "standard", "approval": "ask"}}
  设 r4 为 接线权限预设到闸门(权限对象3, [{"type": "permission/preset", "data": {"preset": "standard"}}], "standard", "ask", 预设表)
  断言相等(r4, "standard", "4a 推导出预设名")
  断言相等(权限对象3.当前预设(), "standard", "4b 闸门已应用")

  # ---- 5. 空事件 -> 默认旋钮值推导（推导面保留） ----
  设 r5 为 接线权限预设到闸门(权限对象3, [], "standard", "ask", 预设表)
  断言相等(r5, "standard", "5a 空事件走默认")

  打印 "--- 第6轮 任务E #288 审批/权限闸门接线 测试通过 ---"

主()