# test_R73_C_数据类.light —— R73 任务C：数据类/记录类型（G-10）
# 目标：支持 `记录 名: 字段1, 字段2` 一键生成构造/相等/哈希/字符串表示
# 对齐 Python @dataclass / MoonBit struct

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "✓ " + 标签

段落 断言为真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 "断言失败: " + 标签
  打印 "✓ " + 标签

# === §1 基础记录类型：构造与字段访问 ===
记录 点: x, y

段落 主:
  打印 "=== §1 基础记录类型 ==="
  设 p1 为 点(3, 4)
  断言等于(p1.x, 3, "1a 字段访问 x")
  断言等于(p1.y, 4, "1b 字段访问 y")

  # === §2 自动生成 __eq__ 相等比较 ===
  打印 "=== §2 相等比较 ==="
  设 p2 为 点(3, 4)
  设 p3 为 点(5, 6)
  断言为真(p1 == p2, "2a 同值记录相等")
  断言为真(p1 != p3, "2b 异值记录不等")

  # === §3 自动生成 __repr__ 字符串表示 ===
  打印 "=== §3 字符串表示 ==="
  设 repr_str 为 转字符串(p1)
  断言为真(repr_str 包含 "点", "3a repr 包含类名")
  断言为真(repr_str 包含 "x=3", "3b repr 包含字段x")
  断言为真(repr_str 包含 "y=4", "3c repr 包含字段y")

  # === §4 带默认值的记录 ===
  打印 "=== §4 默认值 ==="
  记录 人: 姓名, 年龄 = 0, 邮箱 = 空
  设 张三 为 人("张三")
  断言等于(张三.姓名, "张三", "4a 必填字段")
  断言等于(张三.年龄, 0, "4b 默认值年龄")
  断言等于(张三.邮箱, 空, "4c 默认值邮箱")

  设 李四 为 人("李四", 25, "lisi@example.com")
  断言等于(李四.年龄, 25, "4d 覆盖默认值年龄")
  断言等于(李四.邮箱, "lisi@example.com", "4e 覆盖默认值邮箱")

  # === §5 关键字参数构造 ===
  打印 "=== §5 关键字参数构造 ==="
  设 王五 为 人(姓名="王五", 年龄=30)
  断言等于(王五.姓名, "王五", "5a 关键字参数姓名")
  断言等于(王五.年龄, 30, "5b 关键字参数年龄")
  断言等于(王五.邮箱, 空, "5c 关键字参数省略默认值")

  # === §6 记录作为字典键（自动 __hash__）===
  打印 "=== §6 哈希与字典键 ==="
  设 缓存 为 {}
  缓存[点(1, 2)] = "A"
  缓存[点(3, 4)] = "B"
  断言等于(缓存[点(1, 2)], "A", "6a 同值记录作为键命中")
  断言等于(缓存[点(3, 4)], "B", "6b 另一个记录键命中")
  断言等于(长度(缓存), 2, "6c 两个不同键")

  # === §7 记录嵌套 ===
  打印 "=== §7 记录嵌套 ==="
  记录 线段: 起点, 终点
  设 seg 为 线段(点(0, 0), 点(10, 10))
  断言等于(seg.起点.x, 0, "7a 嵌套字段起点x")
  断言等于(seg.终点.y, 10, "7b 嵌套字段终点y")
  设 seg2 为 线段(点(0, 0), 点(10, 10))
  断言为真(seg == seg2, "7c 嵌套记录相等比较")

  # === §8 记录字段可变性 ===
  打印 "=== §8 字段可变性 ==="
  设 p 为 点(1, 2)
  p.x = 100
  断言等于(p.x, 100, "8a 字段可修改")
  设 p_copy 为 点(1, 2)
  断言为真(p != p_copy, "8b 修改后不相等")

  # === §9 多字段记录 ===
  打印 "=== §9 多字段记录 ==="
  记录 颜色: 红, 绿, 蓝, 透明度 = 255
  设 c 为 颜色(255, 128, 0)
  断言等于(c.红, 255, "9a 字段红")
  断言等于(c.绿, 128, "9b 字段绿")
  断言等于(c.蓝, 0, "9c 字段蓝")
  断言等于(c.透明度, 255, "9d 默认透明度")

  # === §10 记录在列表中 ===
  打印 "=== §10 记录在集合操作中 ==="
  设 点列表 为 [点(1, 1), 点(2, 2), 点(3, 3)]
  断言等于(长度(点列表), 3, "10a 列表长度")
  断言为真(点(2, 2) 在 点列表, "10b 包含判断")
  断言为真(点(9, 9) 不在 点列表, "10c 不包含判断")

  打印 ""
  打印 "===== R73-C 数据类全部测试通过 ====="

主()
