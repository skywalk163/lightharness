# test_工具_小工具.light —— 第11轮任务3：util 8 包复刻测试
# 覆盖：分块列表 / 双端队列 / 加密 / 值工具 / 品牌 / 时间工具 / 包清单 / 工作区路径。
# 每包 ≥3 断言，总计 ≥24 断言。

从 分块列表 导入 追加分块, 遍历分块, 校验分块, 块容量
从 双端队列 导入 双端队列
从 加密 导入 字节转Base64, 随机UUID, 摘要
从 值工具 导入 是JSON值, 快照JSON值, 深相等JSON, 断言永不
从 品牌 导入 打品牌字符串, 打品牌数字
从 时间工具 导入 规范客户端时区
从 包清单 导入 读包清单DSH, 校验Bundle清单, 校验Profile清单, 校验Client清单
从 工作区路径 导入 是绝对工作区路径, 是Windows风格路径, 解析工作区路径
从 工作区路径 导入 工作区标题, 路径分部, 缩写主目录路径
从 工作区路径 导入 会话文件地址, 绝对文件地址, 解析文件地址

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ── 1. 分块列表 ──────────────────────────────────────────
  设 头 为 空
  设 头 为 追加分块(头, "a")
  设 头 为 追加分块(头, "b")
  设 头 为 追加分块(头, "c")
  断言等于(遍历分块(头), ["a", "b", "c"], "分块顺序 a,b,c")
  断言等于(校验分块(头), 真, "三元素检查点合法")
  # 填满一块后新开一块：追加 块容量+5 个
  设 大 为空
  设 i 为 0
  当 i < 块容量 + 5:
    设 大 为 追加分块(大, i)
    设 i 为 i + 1
  设 大全 为 遍历分块(大)
  断言等于(长(大全), 块容量 + 5, "跨越块边界总数")
  断言等于(大全[0], 0, "块边界首元素")
  断言等于(大全[块容量 + 5 - 1], 块容量 + 5 - 1, "块边界末元素")

  # ── 2. 双端队列 ──────────────────────────────────────────
  设 队列 为 新建 双端队列()
  队列.队尾推入(1)
  队列.队尾推入(2)
  队列.队首推入(0)
  断言等于(队列.大小(), 3, "队列三元素")
  断言等于(队列.队首弹出(), 0, "队首弹出 0")
  断言等于(队列.队首弹出(), 1, "队首弹出 1")
  断言等于(队列.队首弹出(), 2, "队首弹出 2")
  断言等于(队列.队首弹出(), 空, "空队列弹出空")
  断言等于(队列.大小(), 0, "弹空后大小为 0")
  # 循环回绕：超最小容量后仍保序
  设 队列2 为 新建 双端队列()
  设 j 为 0
  当 j < 40:
    队列2.队尾推入(j)
    设 j 为 j + 1
  断言等于(队列2.队首弹出(), 0, "回绕首弹 0")
  断言等于(队列2.队首弹出(), 1, "回绕次弹 1")
  队列2.清空()
  断言等于(队列2.大小(), 0, "清空后为 0")

  # ── 3. 加密 ─────────────────────────────────────────────
  断言等于(字节转Base64("hello"), "aGVsbG8=", "base64 hello")
  设 摘要1 为 摘要("abc")
  设 摘要2 为 摘要("abc")
  断言等于(摘要1, 摘要2, "SHA256 确定性")
  断言等于(长(摘要1), 64, "SHA256 hex 64 位")
  设 uid 为 随机UUID()
  断言等于(长(uid), 36, "UUID 长度 36")
  断言等于(uid[14], "4", "UUID v4 版本位")

  # ── 4. 值工具 ────────────────────────────────────────────
  断言等于(是JSON值(空), 真, "null 是 JSON 值")
  断言等于(是JSON值("文本"), 真, "字符串是 JSON 值")
  断言等于(是JSON值([1, "x", {"a": True}]), 真, "嵌套数组对象是 JSON 值")
  断言等于(是JSON值({"非串键": 1}), 真, "字符串键对象是 JSON 值")
  断言等于(是JSON值([1, [2, [3]]]), 真, "深嵌套是 JSON 值")
  设 坏键 为 {1: "x"}
  断言等于(是JSON值(坏键), 假, "数字键对象非 JSON 值")
  断言等于(深相等JSON([1, 2], [1, 2]), 真, "数组深相等")
  断言等于(深相等JSON([1, 2], [1, 3]), 假, "数组元素不同")
  断言等于(深相等JSON({"a": {"b": 1}}, {"a": {"b": 1}}), 真, "对象深相等")
  断言等于(深相等JSON({"a": 1}, {"a": 1, "b": 2}), 假, "多余键不等")
  设 原 为 {"n": 1, "表": [9, 8]}
  设 复 为 快照JSON值(原)
  设 复["表"][0] 为 999
  断言等于(原["表"][0], 9, "快照与原值解耦")
  # 断言永不：应抛错
  设 抛了 为 假
  尝试:
    断言永不("不可能值", "测试上下文")
  捕获 错误:
    设 抛了 为 真
  断言等于(抛了, 真, "断言永不抛错")

  # ── 5. 品牌 ──────────────────────────────────────────────
  断言等于(打品牌字符串("sess-1"), "sess-1", "字符串品牌恒等")
  断言等于(打品牌数字(42), 42, "数字品牌恒等")
  断言等于(类型(打品牌数字(7)), 类型(7), "品牌不改类型")

  # ── 6. 时间工具 ──────────────────────────────────────────
  断言等于(规范客户端时区("UTC"), "UTC", "UTC 通过")
  断言等于(规范客户端时区("Asia/Shanghai"), "Asia/Shanghai", "IANA 通过")
  断言等于(规范客户端时区(" bogus"), 空, "含前导空白拒绝")
  断言等于(规范客户端时区("NotAZone"), 空, "无斜杠拒绝")
  断言等于(规范客户端时区(""), 空, "空串拒绝")

  # ── 7. 包清单 ────────────────────────────────────────────
  设 包JSON 为 {"dsh": {"patch": "cordis.patch.yml", "profile": {"bundles": ["a", "b"]}}}
  设 dsh 为 读包清单DSH(包JSON)
  断言等于(dsh["patch"], "cordis.patch.yml", "读出 dsh.patch")
  断言等于(读包清单DSH({}), {}, "无 dsh 返回空字典")
  断言等于(校验Bundle清单({"patch": "p.yml"}), 真, "Bundle 合法")
  断言等于(校验Bundle清单({}), 假, "Bundle 缺 patch 拒")
  断言等于(校验Profile清单({"bundles": ["a"], "patchReload": "live"}), 真, "Profile 合法")
  断言等于(校验Profile清单({"patchReload": "nope"}), 假, "Profile 非法 reload 拒")
  断言等于(校验Client清单({"platform": "web"}), 真, "Client 合法")
  断言等于(校验Client清单({}), 假, "Client 缺 platform 拒")

  # ── 8. 工作区路径 ────────────────────────────────────────
  断言等于(是绝对工作区路径("/a/b"), 真, "POSIX 斜杠绝对")
  断言等于(是绝对工作区路径("C:/a/b"), 真, "盘符绝对")
  断言等于(是绝对工作区路径("rel/x"), 假, "相对非绝对")
  断言等于(是Windows风格路径("\\\\server\\share"), 真, "UNC 判定")
  断言等于(解析工作区路径("/home/ws", "rel/x"), "/home/ws/rel/x", "相对拼接")
  断言等于(解析工作区路径("/home/ws", "/abs/x"), "/abs/x", "绝对路径原样")
  断言等于(工作区标题("/a/b/c.txt"), "c.txt", "工作区标题")
  设 分部 为 路径分部("/a/b/c")
  断言等于(分部["名字"], "c", "路径分部名字")
  断言等于(缩写主目录路径("/home/ys/notes.txt", "/home/ys"), "~/notes.txt", "主目录缩写")
  # 文件地址编解码往返
  设 地址 为 会话文件地址("sess-1", "a b/c#d.txt")
  设 回读 为 解析文件地址(地址)
  断言等于(回读["sessionId"], "sess-1", "会话地址回读会话")
  断言等于(回读["path"], "a b/c#d.txt", "会话地址回读路径")
  设 绝地 为 绝对文件地址("C:/x/y.txt")
  设 绝回 为 解析文件地址(绝地)
  断言等于(绝回["path"], "C:/x/y.txt", "绝对地址回读盘符")

  打印("--- 工具小工具测试通过 ---")

主()
