# test_数值兼容.light —— 第18轮任务2 测试（#117 / R18-D2）
# 验证 src/数值兼容.light 的 10 个数值/数学兼容函数，覆盖正常/边界/异常三态。
# 反跑锚点：A=取整半数上+安全除+JS真值组合；B=安全除分母为0返默认 / JS真值对空列表空字典判真；
#           C=取整半数上改银行家舍入（2.5→2）→ 2.5 断言立红。

从 数值兼容 导入 取整半数上, 安全除, JS真值, JS相等, 指数解析
从 数值兼容 导入 科学计数法, 是有限数, 钳位, 线性插值, 除零安全
从 数学 导入 绝对值

# ── 断言辅助段 ──
段落 断言相等(实际, 期望, 标签 = ""):
  如果 实际 == 期望:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望))

段落 断言真(条件, 标签 = ""):
  如果 条件 == 真:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 期望为真 实际=" 加上 转字符串(条件))

段落 断言近似(实际, 期望, 容差, 标签 = ""):
  如果 绝对值(实际 减去 期望) < 容差:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 实际=" 加上 转字符串(实际) 加上 " 期望≈" 加上 转字符串(期望))

段落 主:
  打印 "===== test_数值兼容 ====="

  # §1 取整半数上（L-125）
  断言相等(取整半数上(2.5), 3, "1a 2.5→3")
  断言相等(取整半数上(0.5), 1, "1b 0.5→1")
  断言相等(取整半数上(1.5), 2, "1c 1.5→2")
  断言相等(取整半数上(2.4), 2, "1d 2.4→2")
  断言相等(取整半数上(-0.5), 0, "1e -0.5→0")
  断言相等(取整半数上(-2.5), -2, "1f -2.5→-2（half-up=向+Inf）")

  # §2 安全除（L-131）
  断言相等(安全除(10, 2), 5, "2a 正常除法")
  断言相等(安全除(1, 0), 0, "2b 分母为0返默认0")
  断言相等(安全除(1, 0, -1), -1, "2c 分母为0返自定义默认")
  断言相等(安全除(0, 5), 0, "2d 分子为0")

  # §3 JS真值（L-129）
  断言真(JS真值(0) == 假, "3a 0判假")
  断言真(JS真值("") == 假, "3b 空串判假")
  断言真(JS真值(空) == 假, "3c null判假")
  断言真(JS真值([]) == 真, "3d 空列表判真")
  断言真(JS真值({}) == 真, "3e 空字典判真")
  断言真(JS真值("0") == 真, "3f 字符串0判真")
  断言真(JS真值(假) == 假, "3g false判假")
  断言真(JS真值(1) == 真, "3h 1判真")
  断言真(JS真值("hello") == 真, "3i 字符串判真")

  # §4 JS相等（配合 L-129）
  断言真(JS相等(0, 假) == 假, "4a 0===假为假")
  断言真(JS相等(1, 真) == 假, "4b 1===真为假")
  断言真(JS相等(5, 5) == 真, "4c 同类型同值真")
  断言真(JS相等("5", 5) == 假, "4d 不同类型假")
  断言真(JS相等(真, 真) == 真, "4e 布尔相等")

  # §5 指数解析（L-085）
  断言相等(指数解析("1e3"), 1000, "5a 正指数")
  断言相等(指数解析("1.5e2"), 150, "5b 小数系数")
  断言近似(指数解析("2e-3"), 0.002, 1e-9, "5c 负指数")
  断言相等(指数解析("1E4"), 10000, "5d 大写E")
  断言相等(指数解析("abc"), 空, "5e 非法格式返空")
  断言相等(指数解析("e3"), 空, "5f 无系数返空")

  # §6 科学计数法（L-085）
  断言相等(科学计数法(2, 3), 2000, "6a 正常构造")
  断言相等(科学计数法(1.5, 2), 150, "6b 小数系数")
  断言近似(科学计数法(5, -3), 0.005, 1e-9, "6c 负指数")
  断言相等(科学计数法(0, 5), 0, "6d 零系数")

  # §7 是有限数（配合 L-131）
  断言真(是有限数(100) == 真, "7a 正常数为真")
  断言真(是有限数(1.5e308) == 假, "7b 超大数(≥1e308)为假")
  断言真(是有限数("x") == 假, "7c 非数值为假")

  # §8 钳位
  断言相等(钳位(5, 0, 10), 5, "8a 范围内不变")
  断言相等(钳位(-3, 0, 10), 0, "8b 小于最小返最小")
  断言相等(钳位(99, 0, 10), 10, "8c 大于最大返最大")

  # §9 线性插值
  断言相等(线性插值(0, 10, 0), 0, "9a 比例0→起点")
  断言相等(线性插值(0, 10, 1), 10, "9b 比例1→终点")
  断言相等(线性插值(0, 10, 0.5), 5, "9c 比例0.5→中点")

  # §10 除零安全（配合 L-131）
  设 r1 为 除零安全(10, 2)
  断言真(字典获取(r1, "成功", 空) == 真, "10a 正常成功")
  断言相等(字典获取(r1, "商", 空), 5, "10b 正常商")
  设 r2 为 除零安全(10, 0)
  断言真(字典获取(r2, "成功", 空) == 假, "10c 除零失败")
  断言相等(字典获取(r2, "错误", 空), "除零", "10d 除零错误文本")

  # §11 组合（反跑 A 锚点）：取整半数上 + 安全除 + JS真值
  断言相等(取整半数上(安全除(25, 2)), 13, "11a 取整半数上+安全除组合")
  断言真(JS真值(安全除(0, 0)) == 假, "11b 安全除返默认0→JS真值判假")
  断言真(JS真值(除零安全(1, 0)) == 真, "11c 除零安全返字典→JS真值判真")

  打印 "test_数值兼容 PASS"
