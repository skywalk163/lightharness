# test_网络钩子GitHub.light —— 对标 #71 域：webhook-github 门禁链纯逻辑反跑测试
# 原版：packages/webhook/webhook-github/src/{body.ts, handler.ts, index.ts, types.ts}
# 用例对齐：body.ts contentLength/readBoundedUtf8Body、handler.ts 十一段门禁链、index.ts assertConfig
#
# 反跑判据（改反必须红，共 3 项，见 _antirun_webhookgh.py）：
#   A) 签名闸 —— 把 恒定时间相等() 变异为恒真（比较被短路）即红：
#      错误秘密/错误签名 用例（验证签名 必须返回 假）变红；恢复 → 绿。
#   B) 单值闸 —— 必需头 长度判定 `!= 1` 改为 `< 1`（放行多值）即红：
#      同名头双值（["a","b"]）必须 400 的用例变红；恢复 → 绿。
#   C) 内容节奏闸 —— 是JSON内容类型 删除「参数区含分号 → 假」分支即红：
#      "application/json; charset=utf-8; x=1" 必须为 假 的用例变红；恢复 → 绿。
#
# 语言坑规避：
#   - 断言(条件,标签) 降级 no-op（L-037），一律 断言相等 / 检查抛码。
#   - 写/打印 只吃字面量串（L-055）；诊断全走 抛出 新建 错误。
#   - 字面量一律单行（L-051）；嵌套字面量内不写 \n（L-054）。
#   - JSON 文本一律 序列化JSON(...) 构造（L-089）。
#   - 无闭包：抛出场景走「具名段落（槽运算）+ 全局装配槽」。
#   - 主程 必须显式在文件末尾调用。

从 网络钩子GitHub 导入 网络钩子HTTP错误, 读错误码, 是十六进制字符
从 网络钩子GitHub 导入 解析内容长度, 读有界UTF8体, 必需头, 是JSON内容类型, 校验方法
从 网络钩子GitHub 导入 恒定时间相等, 验证签名, 解析载荷, 校验配置, 构造交付, 处理请求
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串包含, 截取
从 内置核心判型 导入 是字典, 是字符串
从 内置核心列表 导入 列表追加, 列表长度
从 内置核心字典 导入 字典获取
从 JSON 导入 解析JSON, 序列化JSON
从 哈希 导入 HMAC_SHA256

# =====================================================================
# 断言框架（同 test_webhook会话.light 约定）
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛码(标签, 码, 运算):
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常 为 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, "[" + 码 + "]") == 假):
    抛出 新建 错误("错误码不符[" + 标签 + "]：实际=" + 文 + " 期望码=" + 码)

# =====================================================================
# 全局装配槽 + 观察槽（宿主能力调用记录）
# =====================================================================
设 槽 为 {}
设 派发记录 为 []
设 响应 为 {}

# 一段分发：所有抛错用例经 槽["操作"] 分发到目标函数（参数全在 槽 里）
段落 槽运算:
  全局 槽
  如果 (槽["操作"] == "解析内容长度"):
    解析内容长度(槽["值"])
    返回 空
  如果 (槽["操作"] == "读有界"):
    读有界UTF8体(槽["块表"], 槽["上限"])
    返回 空
  如果 (槽["操作"] == "必需头"):
    必需头(槽["头表"], 槽["名"])
    返回 空
  如果 (槽["操作"] == "校验方法"):
    校验方法(槽["方法"])
    返回 空
  如果 (槽["操作"] == "解析载荷"):
    解析载荷(槽["体"])
    返回 空
  如果 (槽["操作"] == "校验配置"):
    校验配置(槽["配置"])
    返回 空
  抛出 新建 错误("未知槽操作: " + 槽["操作"] + " [TEST]")

# 宿主假能力（对应 handler.ts 的 credentialRef / dispatch / receiveTime 注入面）
段落 假取秘密:
  全局 槽
  返回 槽["秘密"]

段落 假当前时间:
  返回 "2026-09-13T09:27:43Z"

段落 假派发(投递):
  全局 派发记录
  列表追加(派发记录, 投递)

段落 造能力(秘密):
  返回 {"取秘密": 假取秘密, "当前时间": 假当前时间, "来源": "github:webhook:任务6", "派发": 假派发, "体上限": 1000000}

段落 造请求(内容类型, 内容长度, 块表, 头表, 方法):
  返回 {"方法": 方法, "内容类型": 内容类型, "内容长度": 内容长度, "块表": 块表, "头表": 头表}

# =====================================================================
# 用例分组
# =====================================================================
段落 用例_内容长度:
  全局 槽
  断言相等(解析内容长度("0"), 0, "内容长度:0")
  断言相等(解析内容长度("123"), 123, "内容长度:123")
  设 槽 为 {"操作": "解析内容长度", "值": "12x"}
  检查抛码("内容长度:非十进制", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析内容长度", "值": " 12"}
  检查抛码("内容长度:空白", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析内容长度", "值": "-5"}
  检查抛码("内容长度:负数", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析内容长度", "值": "012"}
  检查抛码("内容长度:前导零", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析内容长度", "值": "99999999999999999999999999"}
  检查抛码("内容长度:超安全整数", "WH_413", 槽运算)

段落 用例_读有界:
  全局 槽
  断言相等(读有界UTF8体([], 100), "", "读有界:空体")
  断言相等(读有界UTF8体([{"字节": 5, "文本": "hello"}], 100), "hello", "读有界:单块")
  断言相等(读有界UTF8体([{"字节": 2, "文本": "he"}, {"字节": 3, "文本": "llo"}], 100), "hello", "读有界:多块")
  设 槽 为 {"操作": "读有界", "块表": [{"字节": 6, "文本": "aaaaaa"}, {"字节": 6, "文本": "bbbbbb"}], "上限": 10}
  检查抛码("读有界:累计超限", "WH_413", 槽运算)

段落 用例_必需头:
  全局 槽
  断言相等(必需头({"x-github-event": ["push"]}, "x-github-event"), "push", "必需头:单值")
  断言相等(必需头({"x-github-event": ["  push  "]}, "x-github-event"), "push", "必需头:去除空白")
  设 槽 为 {"操作": "必需头", "头表": {}, "名": "x-github-event"}
  检查抛码("必需头:缺失", "WH_400", 槽运算)
  设 槽 为 {"操作": "必需头", "头表": {"x-github-event": ["a", "b"]}, "名": "x-github-event"}
  检查抛码("必需头:双值", "WH_400", 槽运算)
  设 槽 为 {"操作": "必需头", "头表": {"x-github-event": ["   "]}, "名": "x-github-event"}
  检查抛码("必需头:空白值", "WH_400", 槽运算)

段落 用例_内容类型:
  断言相等(是JSON内容类型("application/json"), 真, "内容类型:裸")
  断言相等(是JSON内容类型("Application/JSON; charset=utf-8"), 真, "内容类型:大小写")
  断言相等(是JSON内容类型("application/json; charset=\"utf-8\""), 真, "内容类型:引号charset")
  断言相等(是JSON内容类型("text/plain"), 假, "内容类型:非json")
  断言相等(是JSON内容类型("application/json; charset=utf-8; x=1"), 假, "内容类型:多余参数")
  断言相等(是JSON内容类型("application/json;"), 假, "内容类型:尾分号")
  断言相等(是JSON内容类型(""), 假, "内容类型:空串")

段落 用例_方法:
  全局 槽
  断言相等(校验方法("POST"), 空, "方法:POST放行")
  设 槽 为 {"操作": "校验方法", "方法": "GET"}
  检查抛码("方法:GET拒绝", "WH_405", 槽运算)

段落 用例_恒定时间:
  断言相等(恒定时间相等("abc", "abc"), 真, "恒定时间:相等")
  断言相等(恒定时间相等("abc", "abd"), 假, "恒定时间:不等")
  断言相等(恒定时间相等("abc", "abcd"), 假, "恒定时间:长度不同")

段落 用例_签名:
  设 秘密 为 "secret"
  设 体 为 "hello"
  设 好签 为 "sha256=" + HMAC_SHA256(秘密, 体)
  断言相等(验证签名(秘密, 体, 好签), 真, "签名:正确")
  设 错签 为 "sha256=" + HMAC_SHA256("wrong", 体)
  断言相等(验证签名(秘密, 体, 错签), 假, "签名:错误秘密")
  断言相等(验证签名(秘密, 体, "sha1=" + HMAC_SHA256("secret", "hello")), 假, "签名:前缀错")
  断言相等(验证签名(秘密, 体, "sha256=zzzz"), 假, "签名:格式坏")
  断言相等(验证签名(秘密, 体, "sha256=" + 截取(好签, 7, 70)), 假, "签名:长度错")

段落 用例_载荷:
  全局 槽
  设 载荷 为 解析载荷(序列化JSON({"ref": "refs/heads/main"}))
  断言相等(是字典(载荷), 真, "载荷:对象")
  设 槽 为 {"操作": "解析载荷", "体": "{oops"}
  检查抛码("载荷:非JSON", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析载荷", "体": "[1, 2]"}
  检查抛码("载荷:数组", "WH_400", 槽运算)
  设 槽 为 {"操作": "解析载荷", "体": "null"}
  检查抛码("载荷:null", "WH_400", 槽运算)

段落 用例_配置:
  全局 槽
  设 配置 为 {"source": "github", "path": "/webhook"}
  设 结果 为 校验配置(配置)
  断言相等(结果["path"], "/webhook", "配置:合法")
  设 槽 为 {"操作": "校验配置", "配置": {"source": "github", "path": "/webhook/"}}
  检查抛码("配置:尾斜杠", "WH_CONFIG", 槽运算)
  设 槽 为 {"操作": "校验配置", "配置": {"source": "github", "path": "webhook"}}
  检查抛码("配置:非绝对", "WH_CONFIG", 槽运算)
  设 槽 为 {"操作": "校验配置", "配置": {"source": "github", "path": "/"}}
  检查抛码("配置:根路径", "WH_CONFIG", 槽运算)
  设 槽 为 {"操作": "校验配置", "配置": {"source": "  github", "path": "/webhook"}}
  检查抛码("配置:trim变", "WH_CONFIG", 槽运算)
  设 槽 为 {"操作": "校验配置", "配置": {"source": "github", "path": "/webhook?x=1"}}
  检查抛码("配置:查询", "WH_CONFIG", 槽运算)
  设 槽 为 {"操作": "校验配置", "配置": {"source": "github", "path": "/webhook#frag"}}
  检查抛码("配置:片段", "WH_CONFIG", 槽运算)

段落 用例_构造交付:
  设 投递 为 构造交付("github:webhook", "d-1", "push", {"ref": "main"}, "2026-09-13T09:27:43Z")
  断言相等(投递["kind"], "github", "交付:kind")
  断言相等(投递["source"], "github:webhook", "交付:source")
  断言相等(投递["deliveryId"], "d-1", "交付:deliveryId")
  断言相等(投递["event"]["name"], "push", "交付:event.name")
  断言相等(投递["event"]["payload"]["ref"], "main", "交付:event.payload")
  断言相等(投递["receivedAt"], "2026-09-13T09:27:43Z", "交付:receivedAt")

段落 用例_处理请求:
  全局 槽, 派发记录, 响应
  设 秘密 为 "secret"
  设 体 为 序列化JSON({"ref": "refs/heads/main", "repository": {"name": "duan"}})
  设 签名 为 "sha256=" + HMAC_SHA256(秘密, 体)
  设 头表 为 {"x-hub-signature-256": [签名], "x-github-delivery": ["dlv-001"], "x-github-event": ["push"]}
  设 能力 为 造能力(秘密)
  设 槽 为 {"秘密": 秘密}
  设 派发记录 为 []
  设 响应 为 {"状态": 0, "消息": ""}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 头表, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 202, "处理:成功202")
  断言相等(列表长度(派发记录), 1, "处理:派发一次")
  断言相等(派发记录[0]["kind"], "github", "处理:投递kind")
  断言相等(派发记录[0]["event"]["name"], "push", "处理:投递事件名")
  断言相等(派发记录[0]["event"]["payload"]["repository"]["name"], "duan", "处理:投递载荷")
  断言相等(派发记录[0]["deliveryId"], "dlv-001", "处理:投递deliveryId")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 头表, "GET")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 405, "处理:方法405")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 坏头 为 {"x-hub-signature-256": [签名], "x-github-delivery": ["dlv-001"], "x-github-event": ["pull_request"]}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 坏头, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 202, "处理:事件名不同仍202")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 请求 为 造请求("text/plain", "123", [{"字节": 字符串长度(体), "文本": 体}], 头表, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 415, "处理:内容类型415")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 缺头 为 {"x-hub-signature-256": [签名]}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 缺头, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 400, "处理:缺头400")
  设 槽 为 {"秘密": 空}
  设 响应 为 {"状态": 0, "消息": ""}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 头表, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 503, "处理:秘密空503")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 坏签 为 "sha256=" + HMAC_SHA256("wrong", 体)
  设 错头 为 {"x-hub-signature-256": [坏签], "x-github-delivery": ["dlv-001"], "x-github-event": ["push"]}
  设 请求 为 造请求("application/json", "123", [{"字节": 字符串长度(体), "文本": 体}], 错头, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 401, "处理:坏签名401")
  设 槽 为 {"秘密": "secret"}
  设 响应 为 {"状态": 0, "消息": ""}
  设 请求 为 造请求("application/json", "999999999999", [{"字节": 字符串长度(体), "文本": 体}], 头表, "POST")
  处理请求(请求, 响应, 能力)
  断言相等(响应["状态"], 413, "处理:声明超限413")

# =====================================================================
段落 主程:
  全局 槽, 派发记录, 响应
  用例_内容长度()
  用例_读有界()
  用例_必需头()
  用例_内容类型()
  用例_方法()
  用例_恒定时间()
  用例_签名()
  用例_载荷()
  用例_配置()
  用例_构造交付()
  用例_处理请求()
  打印 "test_网络钩子GitHub PASS"

主程()