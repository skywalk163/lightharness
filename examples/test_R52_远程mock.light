# test_R52_远程mock.light —— 第52轮 任务2（test-support/remote-mock 纯逻辑，#189 面）
#
# 运行：cd lightharness && python 运行.py examples/test_R52_远程mock.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 上游：deepseek-harness 0.1.6-alpha.1（ea53423b60）
#   packages/test-support/remote-mock/src/{remote-mock.ts, streams.ts, log.ts}
#
# 覆盖（纯逻辑面，不接真实网络；同步步进替代 Promise 语义——偏差登记见交付报告）：
#   信封/脚本 —— ok 信封；frames（推完即结束）；openStream（推完保持开放）
#   拟流 —— 推入计数/等待者直达；结束与失败仅 open 生效；读取四态（值/完/败/挂起）；
#           单消费者约束；排空判定；取消清队；脚本抛错 → 流失败
#   日志 —— calls/streams 过滤、requests 首参表（$events 剔除）、unmatched、全局序号
#   拟真 —— 一元值/函数规则、无规则 miss+消息（不记调用）、函数规则抛 → failed 记录；
#           流声明保留语义、装载顺序、模式判定、开放 miss、活流控制计数、
#           载荷解包、断言无未匹配、$events ready 帧代数递增
#
# 命名避坑：断言助手 检相等/检真/检空串/抛错数，避开与被导入模块段同名。

从 远程mock 导入 造成功信封, 造帧脚本, 造开放脚本, 造拟流, 拟流推入, 拟流结束, 拟流失败
从 远程mock 导入 拟流读取, 拟流排空否, 拟流取消, 拟流跑脚本, 拟流排队数
从 远程mock 导入 造拟真日志, 日志记调用, 日志记流, 日志记未匹配, 日志调用, 日志流, 日志请求, 日志未匹配
从 远程mock 导入 造远程拟真, 拟真一元, 拟真流声明, 拟真装载, 拟真模式, 拟真端点表
从 远程mock 导入 拟真派发, 拟真开放, 活流逐个推入, 活流逐个结束, 活流逐个失败
从 远程mock 导入 拟真参数解包, 拟真断言无未匹配, 造事件拟真, 无规则消息, 造规范错误

段落 检相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 检真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")
  返回 真

段落 主:
  打印 "===== 第52轮 任务2：remote-mock 纯逻辑（RemoteMock/RemoteTable/StreamScript） ====="

  # ============ 1) 信封与脚本构造 ============
  检相等(造成功信封(7), {"ok": 真, "value": 7}, "信_ok信封")
  检相等(造帧脚本([1, 2]), {"种类": "帧", "项表": [1, 2]}, "信_帧脚本")
  检相等(造开放脚本([]), {"种类": "开放", "初始表": []}, "信_开放脚本缺省")

  # ============ 2) 拟流：推入/读取/定局 ============
  设 流 为 造拟流({"端点": "a/b", "参数": [], "状态": "open", "已推": 0, "序号": 1})
  # 帧脚本：推完即结束；读取依次得值后得完
  拟流跑脚本(流, 造帧脚本(["甲", "乙"]), [])
  检相等(流["记录"]["已推"], 2, "流_已推计数")
  检相等(拟流读取(流)["态"], "值", "流_读首值")
  检相等(拟流读取(流)["态"], "值", "流_读次值")
  检相等(拟流读取(流)["态"], "完", "流_结束后读取得完")
  # 开放脚本：推初始项后保持开放；挂起后经控制推入直达信箱
  设 流 为 造拟流({"端点": "a/c", "参数": [], "状态": "open", "已推": 0, "序号": 2})
  拟流跑脚本(流, 造开放脚本(["初"]), [])
  检相等(拟流读取(流)["态"], "值", "流_开放脚本初项")
  设 判 为 拟流读取(流)
  检相等(判["态"], "挂起", "流_队空挂起")
  检相等(拟流排空否(流), 真, "流_挂起即已排空")
  拟流推入(流, "活推")
  检相等(判["信箱"][0]["值"], "活推", "流_推送直达信箱")
  检相等(流["记录"]["状态"], "open", "流_推送不改变状态")
  # 定局：结束仅 open 生效；失败携带错误
  拟流结束(流)
  检相等(流["记录"]["状态"], "ended", "流_结束定局")
  拟流推入(流, "迟到")
  检相等(流["记录"]["已推"], 2, "流_非open推入忽略")
  设 流 为 造拟流({"端点": "a/d", "参数": [], "状态": "open", "已推": 0, "序号": 3})
  拟流失败(流, {"name": "Error", "message": "坏了"})
  检相等(流["记录"]["状态"], "failed", "流_失败定局")
  设 判 为 拟流读取(流)
  检相等(判["态"], "败", "流_失败读取")
  检相等(判["错误"]["message"], "坏了", "流_失败错误透传")
  # 单消费者约束：已有等待者再读 → 抛
  设 流 为 造拟流({"端点": "a/e", "参数": [], "状态": "open", "已推": 0, "序号": 4})
  拟流读取(流)
  设 抛错数 为 0
  尝试:
    拟流读取(流)
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "流_单消费者抛错")
  # 取消：open → cancelled + 清队 + 信箱完；取消后清队总是执行
  设 流 为 造拟流({"端点": "a/f", "参数": [], "状态": "open", "已推": 0, "序号": 5})
  拟流推入(流, "积压")
  设 判 为 拟流读取(流)
  检相等(判["态"], "值", "流_先读积压")
  设 判 为 拟流读取(流)
  检相等(判["态"], "挂起", "流_再读挂起")
  拟流取消(流)
  检相等(流["记录"]["状态"], "cancelled", "流_取消状态")
  检相等(判["信箱"][0]["完"], 真, "流_取消信箱完")
  检相等(拟流排队数(流), 0, "流_取消清队")
  # 脚本抛错 → 流失败
  段落 炸脚本 接收 参数, 句柄:
    抛出 新建 错误("脚本炸了")
  设 流 为 造拟流({"端点": "a/g", "参数": [], "状态": "open", "已推": 0, "序号": 6})
  拟流跑脚本(流, 炸脚本, [])
  检相等(流["记录"]["状态"], "failed", "流_脚本抛错转失败")

  # ============ 3) 日志 ============
  设 日志 为 造拟真日志()
  日志记调用(日志, "tools/add", [{"值": 1}])
  日志记流(日志, "$events", [])
  日志记流(日志, "term/follow", [{"id": "t1"}])
  日志记未匹配(日志, "无/规则", "unary")
  检相等(长(日志调用(日志)), 1, "志_调用全表")
  检相等(长(日志流(日志, "term/follow")), 1, "志_流按端点过滤")
  检相等(长(日志流(日志, "无")), 0, "志_流过滤空")
  # requests：首参表，无端点剔除 $ 前缀
  检相等(日志请求(日志), [{"值": 1}, {"id": "t1"}], "志_请求首参表剔除事件")
  检相等(日志请求(日志, "$events"), [], "志_事件端点显式请求为空")
  检相等(日志未匹配(日志), [{"端点": "无/规则", "方式": "unary"}], "志_未匹配")
  # 全局序号跨表递增（上游 seq 从 0 起）
  检相等(日志调用(日志)[0]["序号"], 0, "志_序号0")
  检相等(日志流(日志, "$events")[0]["序号"], 1, "志_序号1")

  # ============ 4) 拟真：一元派发 ============
  设 拟 为 造远程拟真()
  拟真一元(拟, "tools/add", {"ok": 真, "value": 3})
  检相等(拟真模式(拟, "tools/add"), "unary", "拟_一元模式")
  检相等(拟真派发(拟, "tools/add", [{"值": 1}, {"值": 2}]), {"ok": 真, "value": 3}, "拟_值规则verbatim")
  检相等(日志调用(拟["日志"], "tools/add")[0]["状态"], "answered", "拟_派发记answered")
  # 函数规则：加法器
  段落 加法 接收 参数:
    返回 {"ok": 真, "value": 参数[0]["值"] + 参数[1]["值"]}
  拟真一元(拟, "math/sum", 加法)
  检相等(拟真派发(拟, "math/sum", [{"值": 2}, {"值": 3}]), {"ok": 真, "value": 5}, "拟_函数规则调用")
  # 无规则：miss（不记调用）+ 消息含已注册端点
  设 抛错数 为 0
  尝试:
    拟真派发(拟, "无/规则", [])
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "拟_无规则抛错")
  检真(列表包含(日志调用(拟["日志"]), {"端点": "无/规则"}) == 假, "拟_无规则不记调用")
  设 消 为 无规则消息(拟, "无/规则")
  检真(字符串包含(消, "no rule for 无/规则"), "拟_消息含端点")
  检真(字符串包含(消, "tools/add"), "拟_消息含已注册")
  # 函数规则同步抛 → failed 记录 + 上抛
  段落 炸规则 接收 参数:
    抛出 新建 错误("规则炸")
  拟真一元(拟, "math/bomb", 炸规则)
  设 抛错数 为 0
  尝试:
    拟真派发(拟, "math/bomb", [])
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "拟_规则抛错上抛")
  检相等(日志调用(拟["日志"], "math/bomb")[0]["状态"], "failed", "拟_规则抛错记failed")

  # ============ 5) 拟真：流开放与活流控制 ============
  设 拟 为 造远程拟真()
  # 声明无脚本 → 保留既有脚本；装载顺序 unary→streams→stream
  拟真流声明(拟, "term/follow", 造开放脚本(["初"]))
  拟真流声明(拟, "term/follow", 空)
  检相等(拟真模式(拟, "term/follow"), "stream", "拟_流模式")
  拟真装载(拟, {"unary": {"tools/x": 1}, "streams": ["term/bare"], "stream": {"term/run": 造帧脚本([9])}})
  检相等(拟真模式(拟, "term/bare"), "stream", "拟_无脚本声明为流")
  检相等(拟真模式(拟, "tools/x"), "unary", "拟_装载一元")
  # 开放：端点命中脚本；无脚本声明开放 → miss 抛
  设 流 为 拟真开放(拟, "term/follow", [{"id": "t9"}])
  检相等(流["记录"]["参数"], [{"id": "t9"}], "拟_流记录参数")
  检相等(拟流读取(流)["值"], "初", "拟_开放脚本首项")
  设 抛错数 为 0
  尝试:
    拟真开放(拟, "term/bare", [])
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "拟_无脚本声明开放miss")
  # 活流控制：推入/结束/失败 只作用 open 态并返回数量
  检相等(活流逐个推入(拟, "term/follow", "二"), 1, "拟_活流推入数")
  检相等(拟流读取(流)["值"], "二", "拟_活流推入到达")
  检相等(活流逐个结束(拟, "term/follow"), 1, "拟_活流结束数")
  检相等(流["记录"]["状态"], "ended", "拟_活流结束后状态")
  设 流 为 拟真开放(拟, "term/follow", [{"id": "t10"}])
  检相等(活流逐个失败(拟, "term/follow", {"name": "Error", "message": "上游断"}), 1, "拟_活流失败数")
  检相等(流["记录"]["状态"], "failed", "拟_活流失败后状态")
  # 端点表
  检相等(拟真端点表(拟), ["term/bare", "term/follow", "term/run", "tools/x"], "拟_端点表字典序")

  # ============ 6) 载荷解包与断言无未匹配 ============
  检相等(拟真参数解包("a/b", {"args": [1, 2]}), [1, 2], "解_数组参数")
  检相等(拟真参数解包("a/b", {"args": {"值": 1}}), [{"值": 1}], "解_对象参数包单")
  设 抛错数 为 0
  尝试:
    拟真参数解包("a/b", {"其它": 1})
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "解_坏载荷抛错")
  # 断言无未匹配：干净静默；有未匹配抛清单
  设 拟 为 造远程拟真()
  拟真一元(拟, "a/有", 1)
  拟真断言无未匹配(拟)
  检真(拟真派发(拟, "a/有", []) == 1, "断_派发后仍静默")
  设 抛错数 为 0
  尝试:
    拟真派发(拟, "a/无", [])
    拟真断言无未匹配(拟)
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "断_有未匹配抛错")

  # ============ 7) 事件拟真（$events ready 帧） ============
  设 拟 为 造事件拟真()
  检相等(拟真模式(拟, "$events"), "stream", "事_事件端点为流")
  设 流 为 拟真开放(拟, "$events", [])
  设 帧 为 拟流读取(流)["值"]
  检相等(帧["type"], "ready", "事_ready帧")
  检相等(帧["clientId"], "mock-client-1", "事_代数1")
  检相等(帧["host"], {"home": "/home/mock"}, "事_缺省宿主")
  设 流 为 拟真开放(拟, "$events", [])
  检相等(拟流读取(流)["值"]["clientId"], "mock-client-2", "事_代数递增")
  打印 "R52 远程mock：信封脚本/拟流四态/单消费者/日志/派发规则/活流控制/载荷解包/事件端点 全部通过"

主()
