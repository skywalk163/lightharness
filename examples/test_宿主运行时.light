# test_宿主运行时.light —— 第17轮 任务1（宿主运行时与插件生命周期原型）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_宿主运行时.light
# 上游参考：Cordis Context/Service/插件生命周期模式（原型设计，非逐行复刻）
#
# 覆盖：状态机（合法转换/非法转换抛错）/ 插件注册（重复注册/运行中注册拒）/
#   拓扑排序（依赖序/依赖缺失/依赖循环）/ 生命周期钩子顺序（安装->启动->逆序停止->卸载）/
#   服务注册表（注册/获取/尝试获取/列举/重复注册/缺失抛错）/ 依赖注入 / 错误隔离 /
#   元数据 / 运行时事件 / 重启
#
# 反跑判据（改源码一行测试必须红，恢复后绿）：
#   A=正常：注册 2 个依赖插件->加载全部->服务可获取->停止全部，输出一致（回归绿验证）
#   B=边界：依赖循环插件 -> 加载报错不崩溃（错误被捕获记录）（回归绿验证）
#   C=变异：拓扑排序 Kahn 入度选择改错（退化为注册序装载）-> 依赖先于被依赖的断言红

从 宿主运行时 导入 造运行时, 造插件, 注册插件, 拓扑排序插件, 启动, 停止, 重启, 获取状态, 获取元数据, 注册服务, 获取服务, 尝试获取服务, 列举服务, 监听运行时事件, 派发运行时事件, 是否可转换

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含 接收 文本, 子串, 标签:
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 检查抛错含 接收 标签, 子串, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    设 忽略 为 运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 钩子段落（顶层，避 L-091 内联限制） ----------
设 钩子日志 为 []

段落 空安装 接收 上下文:
  列表追加(钩子日志, "安装:" + 上下文["插件名"])
段落 空启动 接收 上下文:
  列表追加(钩子日志, "启动:" + 上下文["插件名"])
段落 空停止 接收 上下文:
  列表追加(钩子日志, "停止:" + 上下文["插件名"])
段落 空卸载 接收 上下文:
  列表追加(钩子日志, "卸载:" + 上下文["插件名"])
段落 坏启动 接收 上下文:
  抛出 新建 错误("启动失败注入")
段落 存储装服务 接收 上下文:
  上下文["注册服务"]("kv", ["内存kv"])
段落 应用注入 接收 上下文:
  设 值 为 上下文["依赖服务"]("kv")
  列表追加(钩子日志, "注入kv:" + 转字符串(列表长度(值)))

# ---------- 抛错场景 ----------
段落 场未初始化就停止:
  设 运行时 为 造运行时("0.1")
  停止(运行时, 1)

段落 场已停止再停止:
  设 运行时 为 造运行时("0.1")
  启动(运行时, 1)
  停止(运行时, 2)
  停止(运行时, 3)

段落 场重复注册:
  设 运行时 为 造运行时("0.1")
  注册插件(运行时, 造插件("甲", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  注册插件(运行时, 造插件("甲", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))

段落 场运行中注册:
  设 运行时 为 造运行时("0.1")
  注册插件(运行时, 造插件("甲", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(运行时, 1)
  注册插件(运行时, 造插件("乙", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))

段落 场依赖缺失:
  设 运行时 为 造运行时("0.1")
  注册插件(运行时, 造插件("甲", "1", ["不存在"], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(运行时, 1)

段落 场依赖循环:
  设 运行时 为 造运行时("0.1")
  注册插件(运行时, 造插件("甲", "1", ["乙"], [], [], 空安装, 空启动, 空停止, 空卸载))
  注册插件(运行时, 造插件("乙", "1", ["甲"], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(运行时, 1)

段落 场服务重复:
  设 运行时 为 造运行时("0.1")
  注册服务(运行时, "kv", ["x"], "甲")
  注册服务(运行时, "kv", ["y"], "乙")

段落 场服务缺失:
  获取服务(造运行时("0.1"), "无")

段落 场非法转换:
  转换状态占位()

段落 转换状态占位:
  抛出 新建 错误("占位")

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 状态机 ============
  断言相等(是否可转换("未初始化", "初始化中"), 真, "未初始化->初始化中")
  断言相等(是否可转换("初始化中", "运行中"), 真, "初始化中->运行中")
  断言相等(是否可转换("运行中", "停止中"), 真, "运行中->停止中")
  断言相等(是否可转换("停止中", "已停止"), 真, "停止中->已停止")
  断言相等(是否可转换("未初始化", "停止中"), 假, "未初始化不可直接停止")
  断言相等(是否可转换("已停止", "运行中"), 假, "已停止不可直接运行")
  检查抛错含("未初始化就停止应抛", "非法运行时状态转换: 未初始化 -> 停止中", 场未初始化就停止)
  检查抛错含("已停止再停止应抛", "非法运行时状态转换: 已停止 -> 停止中", 场已停止再停止)
  设 运行时 为 造运行时("0.1-test")
  断言相等(获取状态(运行时), "未初始化", "初始状态")
  启动(运行时, 100)
  断言相等(获取状态(运行时), "运行中", "启动后运行中")
  停止(运行时, 200)
  断言相等(获取状态(运行时), "已停止", "停止后已停止")

  # ============ 2) 插件注册 ============
  检查抛错含("重复注册应抛", "插件重复注册: 甲", 场重复注册)
  检查抛错含("运行中注册应抛", "不能再注册插件", 场运行中注册)

  # ============ 3) 拓扑排序 ============
  设 排序运行时 为 造运行时("0.1")
  注册插件(排序运行时, 造插件("丙", "1", ["乙"], [], [], 空安装, 空启动, 空停止, 空卸载))
  注册插件(排序运行时, 造插件("甲", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  注册插件(排序运行时, 造插件("乙", "1", ["甲"], [], [], 空安装, 空启动, 空停止, 空卸载))
  设 序 为 拓扑排序插件(排序运行时["插件表"])
  断言相等(序, ["甲", "乙", "丙"], "拓扑序依赖先于被依赖")
  检查抛错含("依赖缺失应抛", "插件依赖缺失: 甲 依赖 不存在", 场依赖缺失)
  检查抛错含("依赖循环应抛", "插件依赖循环", 场依赖循环)

  # ============ 4) 生命周期钩子顺序（A 判据场景） ============
  当 列表长度(钩子日志) > 0:
    列表弹出(钩子日志)
  设 运行时 为 造运行时("0.1")
  注册插件(运行时, 造插件("存储", "1.0", [], ["kv"], [], 存储装服务, 空启动, 空停止, 空卸载))
  注册插件(运行时, 造插件("应用", "1.0", ["存储"], [], [], 空安装, 应用注入, 空停止, 空卸载))
  启动(运行时, 100)
  断言相等(获取状态(运行时), "运行中", "启动后运行中")
  # 服务注册表
  断言相等(列表长度(获取服务(运行时, "kv")), 1, "服务实例可获取")
  断言真(尝试获取服务(运行时, "kv") != 空, "尝试获取命中")
  断言真(尝试获取服务(运行时, "无此服务") == 空, "尝试获取未命中返回空")
  检查抛错含("服务缺失应抛", "服务不存在: 无", 场服务缺失)
  检查抛错含("服务重复应抛", "服务重复注册: kv", 场服务重复)
  设 清单 为 列举服务(运行时)
  断言相等(清单, [["服务": "kv", "提供者": "存储"]], "列举服务含提供者")
  # 依赖注入：应用插件启动时拿到存储服务的 kv 实例（通过钩子日志验证）
  停止(运行时, 200)
  断言相等(获取状态(运行时), "已停止", "停止后已停止")
  # 钩子顺序：安装->启动（拓扑序），停止->卸载（逆序）
  # 实际序列：存储安装(装服务,无日志) -> 存储启动 -> 应用安装 -> 应用启动(注入) -> 逆序停止卸载
  断言相等(钩子日志[0], "启动:存储", "依赖先装载启动")
  断言相等(钩子日志[1], "安装:应用", "被依赖后安装")
  断言相等(钩子日志[2], "注入kv:1", "依赖注入命中")
  断言相等(钩子日志[3], "停止:应用", "逆序停止")
  断言相等(钩子日志[4], "卸载:应用", "逆序卸载")
  断言相等(钩子日志[5], "停止:存储", "存储后停止")
  断言相等(钩子日志[6], "卸载:存储", "存储后卸载")

  # ============ 5) 依赖注入 ============
  设 注入运行时 为 造运行时("0.1")
  注册插件(注入运行时, 造插件("核心", "1.0", [], ["总线"], [], 空安装, 空启动, 空停止, 空卸载))
  注册服务(注入运行时, "总线", ["事件总线"], "核心")
  # 注册直接服务后再启动第二插件使用 依赖服务 注入
  注册插件(注入运行时, 造插件("消费", "1.0", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(注入运行时, 10)
  断言相等(列表长度(获取服务(注入运行时, "总线")), 1, "注入环境服务可用")

  # ============ 6) 错误隔离 ============
  设 隔离运行时 为 造运行时("0.1")
  注册插件(隔离运行时, 造插件("坏插件", "1.0", [], [], [], 空安装, 坏启动, 空停止, 空卸载))
  注册插件(隔离运行时, 造插件("好插件", "1.0", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(隔离运行时, 10)
  # 坏插件失败被记录，好插件仍装载
  设 元数据 为 获取元数据(隔离运行时, 20)
  断言相等(元数据["插件计数"], 1, "失败插件不计入加载序")
  断言相等(元数据["错误计数"], 1, "错误被记录")
  断言相等(获取状态(隔离运行时), "运行中", "错误隔离后运行时仍运行")
  设 好服务 为 注册服务(隔离运行时, "好服务", ["x"], "好插件")
  断言相等(获取服务(隔离运行时, "好服务"), ["x"], "好插件服务可用")

  # ============ 7) 元数据与事件 ============
  设 事件运行时 为 造运行时("0.2")
  设 事件记录 为 []
  段落 记事件 接收 数据:
    列表追加(事件记录, 转字符串(字典获取(数据, "插件数", -1)))
  监听运行时事件(事件运行时, "运行时/启动后", 记事件)
  注册插件(事件运行时, 造插件("甲", "1", [], [], [], 空安装, 空启动, 空停止, 空卸载))
  启动(事件运行时, 1000)
  断言相等(事件记录, ["1"], "启动后事件携带插件数")
  设 元乙 为 获取元数据(事件运行时, 1500)
  断言相等(元乙["版本"], "0.2", "元数据版本")
  断言相等(元乙["启动时间"], 1000, "元数据启动时间")
  断言相等(元乙["运行时长"], 500, "运行时长计算")
  # 重启
  重启(事件运行时, 2000, 3000)
  断言相等(获取状态(事件运行时), "运行中", "重启后运行中")
  断言相等(获取元数据(事件运行时, 3500)["启动时间"], 3000, "重启后新启动时间")
  停止(事件运行时, 4000)
  断言相等(获取状态(事件运行时), "已停止", "最终停止")

  打印("test_宿主运行时 PASS")

主()
