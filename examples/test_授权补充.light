# test_授权补充.light —— R102 任务G：authorization 0.2.0-rc.1 补缺测试
#
# 覆盖 授权补充.light 新补 4 段纯逻辑：
#   A. 提交守卫(已中止/槽在/令牌匹配) → CANCELLED 或放行
#   B. 取消应中止(提交中) → 提交期不中止
#   C. 提交后授权判定(已观察提交, 存储仍配置) → authorized / NOT_COMMITTED 两支
#   D. 结算不变式(在飞) → settled 后键必须已释放
#
# 反跑 3 组（破坏-还原验证）：
#   反跑1：提交守卫删掉「槽在」判断 → 槽不在也放行，用例A2立红
#   反跑2：取消应中止把「提交中→假」改成「永远真」→ 用例B1立红
#   反跑3：提交后授权判定删掉「存储仍配置」分支 → 删除记录被当成功，用例C2立红
#
# 运行：cd lightharness && python 运行.py examples/test_授权补充.light

从 授权补充 导入 提交守卫, 取消应中止, 提交后授权判定, 结算不变式
从 授权补充 导入 码已取消, 码未提交, 构造补充错误
从 授权链 导入 解析授权错误

# ===== 断言工具 =====
段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
    如果 条件 != 真:
        抛出 "断言失败: " + 标签

段落 断言假(条件, 标签):
    如果 条件 != 假:
        抛出 "断言失败(应假): " + 标签

# 从 "[CODE] 消息" 文本提取码
段落 码(错误文本):
    如果 错误文本 == 空:
        返回 "空"
    设 解析 为 解析授权错误(错误文本)
    返回 解析["码"]

打印 "=== A. 提交守卫 ==="

# A1. 已中止 → CANCELLED
设 a1 为 提交守卫(真, 真, 真)
断言相等(码(a1), 码已取消, "A1 已中止→CANCELLED")

# A2. 尝试槽已释放（槽在=假）→ CANCELLED
设 a2 为 提交守卫(假, 假, 真)
断言相等(码(a2), 码已取消, "A2 槽不在→CANCELLED")

# A3. 尝试令牌不匹配（旧会话撞上一次尝试的槽）→ CANCELLED
设 a3 为 提交守卫(假, 真, 假)
断言相等(码(a3), 码已取消, "A3 令牌不匹配→CANCELLED")

# A4. 正常 → 放行（空）
设 a4 为 提交守卫(假, 真, 真)
断言相等(a4, 空, "A4 正常放行")

打印 "=== B. 取消应中止 ==="

# B1. 提交中 → cancel 不中止（等待持久化完成）
设 b1 为 取消应中止(真)
断言假(b1, "B1 提交中cancel不中止")

# B2. 非提交中 → cancel 正常中止
设 b2 为 取消应中止(假)
断言真(b2, "B2 非提交中cancel中止")

打印 "=== C. 提交后授权判定 ==="

# C1. 未观察到提交 → NOT_COMMITTED
设 c1 为 提交后授权判定(假, 真, "scope/key-a")
断言相等(c1["结果"], "错误", "C1 未提交结果=错误")
断言相等(码(c1["错误"]), 码未提交, "C1 未提交→NOT_COMMITTED")

# C2. 观察到提交但存储中记录被删（configured=false）→ NOT_COMMITTED
设 c2 为 提交后授权判定(真, 假, "scope/key-a")
断言相等(c2["结果"], "错误", "C2 删记录结果=错误")
断言相等(码(c2["错误"]), 码未提交, "C2 删记录→NOT_COMMITTED")

# C3. 已提交且存储仍配置 → authorized
设 c3 为 提交后授权判定(真, 真, "scope/key-a")
断言相等(c3["结果"], "authorized", "C3 正常authorized")

打印 "=== D. 结算不变式 ==="

# D1. settled 时键仍在飞 → 破裂
设 d1 为 结算不变式(真)
断言真(长度(d1) > 0, "D1 在飞→破裂消息非空")

# D2. settled 时键已释放 → 通过
设 d2 为 结算不变式(假)
断言相等(d2, 空, "D2 已释放→通过")

打印 ""
打印 "test_授权补充 PASS"
