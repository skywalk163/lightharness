# test_R41_真实文件IO.light —— 第41轮 任务1 验收（宿主层真实文件IO）
#
# 运行：cd lightharness && python 运行.py examples/test_R41_真实文件IO.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖：写→读→编辑→目录→删除→原子写崩溃恢复 全链；跨平台嵌套路径；
#       越界拒绝（沙箱护栏）；与 文件系统工具.light 宿主入参字典的对接。

从 真实文件系统提供者 导入 文件存在提供, 读文件提供, 写文件提供, 创建目录提供, 删除文件提供, 重命名提供, 列目录提供, 获取文件信息提供, 原子写文件提供, 查信息, 读文本, 写文本, 读头字节, 造宿主字典
从 文件系统工具 导入 执行写命令, 执行读命令
从 工具_路径安全 导入 取根目录

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

段落 主测试:
  设 根 为 取根目录()
  设 沙盒 为 "r41_io_sandbox"
  # 清理（删目录树 是光明内建：递归删除）
  如果 目录存在(沙盒) == 真:
    删目录树(沙盒)

  # ---- 1. 创建目录 ----
  设 r 为 创建目录提供(沙盒, "t1")
  断言真(r["成功"] == 真, "创建目录成功")
  断言真(目录存在(沙盒) == 真, "目录已落在磁盘")

  # ---- 2. 写文件（层1 提供者）----
  设 内容 为 "第一行\n第二行\n第三行"
  设 r 为 写文件提供(沙盒 + "/甲.txt", 内容, "t2")
  断言真(r["成功"] == 真, "写文件成功")
  断言相等(r["元数据"]["大小"], 字符串长度(内容), "写回大小一致")

  # ---- 3. 读文件（层1 提供者）----
  设 r 为 读文件提供(沙盒 + "/甲.txt", "t3")
  断言真(r["成功"] == 真, "读文件成功")
  断言相等(r["数据"], 内容, "读回内容一致")

  # ---- 4. 对接 文件系统工具.light 宿主入参字典：写 + 读 ----
  设 宿主 为 造宿主字典()
  设 r 为 执行写命令({"file_path": 沙盒 + "/甲.txt", "content": "经工具层改写"}, 宿主)
  断言真(r != 空, "执行写命令返回")
  设 r 为 执行读命令({"file_path": 沙盒 + "/甲.txt", "offset": 1, "limit": 2000}, 宿主)
  设 输出 为 r["输出"]
  断言真(输出.查找("经工具层改写") >= 0, "工具层读回改写内容")

  # ---- 5. 列目录 ----
  设 r 为 列目录提供(沙盒, "t5")
  断言真(r["成功"] == 真, "列目录成功")
  断言真(列表包含(r["数据"], "甲.txt"), "列目录含 甲.txt")

  # ---- 6. 查信息（层2 宿主字典形状）----
  设 信息 为 查信息(沙盒 + "/甲.txt")
  断言真(信息 != 空, "查信息非空")
  断言相等(信息["类型"], "文件", "类型=文件")
  断言真(信息["大小"] > 0, "大小>0")

  # ---- 7. 获取文件信息（层1 提供者形状）----
  设 r 为 获取文件信息提供(沙盒 + "/甲.txt", "t7")
  断言真(r["成功"] == 真, "获取文件信息成功")
  断言真(r["数据"]["是目录"] == 假, "是目录=假")

  # ---- 8. 读头字节（图片嗅探契约）----
  写入文件(沙盒 + "/头.txt", "AB")
  设 头 为 读头字节(沙盒 + "/头.txt", 2)
  断言相等(头, [65, 66], "读头字节=ASCII AB")

  # ---- 9. 原子写崩溃恢复（临时落盘后、替换前目标保持旧版）----
  写入文件(沙盒 + "/原子.txt", "旧版")
  设 父 为 目录名(沙盒 + "/原子.txt")
  设 名 为 文件名(沙盒 + "/原子.txt")
  设 临时 为 父 + "/" + "." + 名 + ".tmp"
  写入文件(临时, "新版")                       # 模拟「崩溃前临时已落盘」
  断言相等(读取文件(沙盒 + "/原子.txt"), "旧版", "崩溃瞬间目标未动")
  原子替换(临时, 沙盒 + "/原子.txt")           # 提交
  断言相等(读取文件(沙盒 + "/原子.txt"), "新版", "提交后目标新版")
  断言真(文件存在(临时) == 假, "提交后临时消失")

  # ---- 9b. 原子写（正常路径，单调用）----
  设 r 为 原子写文件提供(沙盒 + "/原子2.txt", "原子内容", "t9b")
  断言真(r["成功"] == 真, "原子写文件成功")
  断言相等(读取文件(沙盒 + "/原子2.txt"), "原子内容", "原子写读回一致")

  # ---- 10. 跨平台嵌套路径（多层段 + 自动建父目录）----
  设 嵌套 为 沙盒 + "/嵌套/子/c.txt"
  设 r 为 写文件提供(嵌套, "嵌套内容", "t10")
  断言真(r["成功"] == 真, "嵌套写成功")
  设 r 为 读文件提供(嵌套, "t10r")
  断言相等(r["数据"], "嵌套内容", "嵌套读回一致")
  设 r 为 列目录提供(沙盒 + "/嵌套/子", "t10l")
  断言真(列表包含(r["数据"], "c.txt"), "嵌套列目录含 c.txt")

  # ---- 11. 沙箱越界拒绝（HARNESS_ROOT 护栏）----
  设 r 为 文件存在提供("../r41_越界_probe_zzz", "t11")
  断言真(r["成功"] == 假, "越界请求被拒")
  断言相等(r["错误码"], "PERMISSION_DENIED", "越界错误码")
  设 r 为 写文件提供("../r41_越界_probe_zzz/逃逸.txt", "x", "t11b")
  断言真(r["成功"] == 假, "越界写被拒")
  断言相等(r["错误码"], "PERMISSION_DENIED", "越界写错误码")

  # ---- 12. 重命名 + 删除 ----
  # 注：文件存在提供 返回 IO结果 统一形状——"成功"=操作是否完成（越界/异常才为假），
  #     文件是否存在这一布尔在 "数据" 字段（与 宿主IO.light 形状一致）。
  设 r 为 重命名提供(沙盒 + "/甲.txt", 沙盒 + "/乙.txt", "t12")
  断言真(r["成功"] == 真, "重命名成功")
  断言真(文件存在提供(沙盒 + "/甲.txt", "t12a")["数据"] == 假, "旧名已不存在")
  断言真(文件存在提供(沙盒 + "/乙.txt", "t12b")["数据"] == 真, "新名存在")
  设 r 为 删除文件提供(沙盒 + "/乙.txt", "t12c")
  断言真(r["成功"] == 真, "删除成功")
  断言真(文件存在提供(沙盒 + "/乙.txt", "t12d")["数据"] == 假, "删除后不存在")

  # ---- 收尾清理 ----
  删目录树(沙盒)

  写入输出("任务1 全部断言通过（真实文件IO：写/读/编辑/目录/删除/原子写崩溃恢复/跨平台/沙箱护栏 全链 rc=0）\n")

段落 主:
  主测试()
