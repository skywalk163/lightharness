# test_压缩配套.light —— 压缩配套纯逻辑核心（任务卡 D，对标编号 54）测试
# 运行：python 运行.py examples/test_压缩配套.light  → 必须 rc=0
# 反跑判据：把任一 断言相等/断言真 的期望值改反，用例立即红（见各用例旁注）。
#
# 覆盖（对照原版四包纯逻辑）：
#   一、tool-result-pruner：统计码点 / 度量内容 / 裁剪内容 / 整理裁剪配置
#   二、compaction-basic config：整理基础配置 / 整理目标策略 / 确定预算
#   三、tool-pairing：条目增量 / 建立缓存 / 扩展缓存 / 同步平衡缓存 / 切口平衡 / 配对平衡前/后
#   四、region：选择可压缩区
#   五、checkpoint：造检查点来源 / 是否检查点来源
#
# 结构：按测试_任务系统 的既有风格，每个大节一个 段落 用例，主程 串行调用——
# 单个巨型函数体会触发解析器提前脱出块（语言缺陷 L-050，见对齐卡）。

从 压缩配套 导入 统计码点, 度量内容, 裁剪内容, 整理裁剪配置, 整理基础配置, 整理目标策略, 确定预算, 选择可压缩区, 配对平衡前, 配对平衡后, 条目增量, 建立缓存, 扩展缓存, 切口平衡, 同步平衡缓存, 造检查点来源, 是否检查点来源, 压缩省略标记

# ── 判据助手 ──

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 检查抛错 接收 关键词, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 异常 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 "应抛未抛: " + 关键词
  如果 字符串包含(消息, 关键词) == 假:
    抛出 "错误消息未含关键词: " + 关键词 + " 消息=" + 消息
  返回 消息

# 重复拼串助手（构造长文本）
段落 重复串 接收 文本, 次数:
  设 结果 为 ""
  设 序号 为 0
  当 序号 < 次数:
    设 结果 为 结果 + 文本
    设 序号 为 序号 + 1
  返回 结果

# ── 抛错探测段落（具名零参，供 检查抛错 实参）──
段落 抛裁剪未知键:
  整理裁剪配置({ "未知键": 1 })
段落 抛裁剪不变量:
  整理裁剪配置({ "阈值字符": 100, "头字符": 60, "尾字符": 40 })
段落 抛裁剪阈值零:
  整理裁剪配置({ "阈值字符": 0 })
段落 抛裁剪负数:
  整理裁剪配置({ "尾字符": -1 })
段落 抛裁剪小数:
  整理裁剪配置({ "头字符": 2.5 })
段落 抛基础未知键:
  整理基础配置({ "未知键": 1 })
段落 抛基础互斥:
  整理基础配置({ "保留比例": 0.1, "保留条数": 50 })
段落 抛基础比例越界:
  整理基础配置({ "阈值比例": 0.8, "保留比例": 0.9 })
段落 抛基础自动非布尔:
  整理基础配置({ "自动": "是" })
段落 抛基础重复策略:
  整理基础配置({ "策略表": [ { "提供方": "p", "模型": "m", "保留比例": 0.1 }, { "提供方": "p", "模型": "m", "保留比例": 0.2 } ] })
段落 抛基础策略非数组:
  整理基础配置({ "策略表": { "提供方": "p" } })
段落 抛基础策略缺项:
  整理基础配置({ "策略表": [ { "提供方": "p", "保留比例": 0.1 } ] })
段落 抛基础摘要不配对:
  整理基础配置({ "摘要提供方": "pp" })
段落 抛预算窗口零:
  设 基础 为 整理基础配置({})
  设 策略 为 整理目标策略(基础, { "提供方": "p", "模型": "m" })
  确定预算(策略, 0)
段落 抛预算窗口负:
  设 基础 为 整理基础配置({})
  设 策略 为 整理目标策略(基础, { "提供方": "p", "模型": "m" })
  确定预算(策略, -5)
段落 抛预算保留越界:
  设 基础 为 整理基础配置({ "保留条数": 102400 })
  设 策略 为 整理目标策略(基础, { "提供方": "p", "模型": "m" })
  确定预算(策略, 128000)
段落 抛配对损坏:
  设 坏日志表 为 [ { "序号": 0, "类型": "tool/result", "数据": {} } ]
  设 坏节点 为 []
  坏节点.追加(0)
  设 坏表面 为 { "节点表": 坏节点, "事件表": 坏日志表, "生成代": 0, "平衡缓存": 空 }
  建立缓存(坏日志表, 坏节点, 0)
段落 抛配对缺序号:
  设 日志表 为 [ { "序号": 0, "类型": "user/message", "数据": {} } ]
  设 单节点 为 []
  单节点.追加(0)
  设 表面 为 { "节点表": 单节点, "事件表": 日志表, "生成代": 0, "平衡缓存": 空 }
  配对平衡前(表面, 99)
段落 抛区域不符:
  设 日志表 为 [ { "序号": 0, "类型": "user/message", "数据": {} } ]
  设 单节点 为 []
  单节点.追加(0)
  设 表面 为 { "节点表": 单节点, "事件表": 日志表, "生成代": 0, "平衡缓存": 空 }
  选择可压缩区(表面, [ { "序号": 7, "条数": 5 } ], 10)

# ════════════ 一、tool-result-pruner ════════════
段落 用例裁剪:
  # 1.1 统计码点（Unicode 码点，非 UTF-16 单元）
  断言相等(统计码点(""), 0, "统计码点 空串 0")
  断言相等(统计码点("😀a中"), 3, "统计码点 emoji+ascii+中文")
  # 反跑判据：把 3 改 2 即红
  断言相等(统计码点(压缩省略标记), 39, "统计码点 标记 39 码点")
  # 反跑判据：把 39 改 38 即红

  # 1.2 度量内容（text 块计数，非 text 块计 0）
  设 混合块 为 [ { "类型": "text", "文本": "abc" }, { "类型": "resource", "文本": "xyz" }, { "类型": "text", "文本": "😀中" } ]
  断言相等(度量内容(混合块), 5, "度量内容 非文本块计0")
  # 反跑判据：把 5 改 4 即红
  断言相等(度量内容([]), 0, "度量内容 空表 0")

  # 1.3 裁剪内容：预算内 → 空（原样保留）
  断言相等(裁剪内容([ { "类型": "text", "文本": "abc" } ], 100, 3, 2), 空, "裁剪内容 预算内返回空")
  # 反跑判据：把 空 改为非空即红

  # 1.4 裁剪内容：超预算单块 → 头 + 标记 + 尾
  设 长文本 为 重复串("x", 200)
  设 剪1 为 裁剪内容([ { "类型": "text", "文本": 长文本 } ], 50, 3, 2)
  设 期望1 为 "xxx" + 压缩省略标记 + "xx"
  断言真(剪1 != 空, "裁剪内容 超预算非空")
  断言相等(列表长度(剪1), 1, "裁剪内容 单块结果1块")
  断言相等(剪1[0]["类型"], "text", "裁剪内容 结果块类型")
  断言相等(剪1[0]["文本"], 期望1, "裁剪内容 头+标记+尾")
  # 反跑判据：把 期望1 的头改 "xx" 即红
  断言相等(度量内容(剪1), 44, "裁剪内容 裁剪后码点=3+39+2")
  # 反跑判据：把 44 改 43 即红

  # 1.5 裁剪内容：多块（text + resource + text）保留 resource 顺序，标记只插一次
  设 剪2 为 裁剪内容([ { "类型": "text", "文本": 重复串("a", 100) }, { "类型": "resource", "文本": "R" }, { "类型": "text", "文本": 重复串("b", 100) } ], 50, 3, 2)
  断言相等(列表长度(剪2), 3, "裁剪内容 三块结果3块")
  断言相等(剪2[0]["文本"], "aaa" + 压缩省略标记, "裁剪内容 首块头段+标记")
  断言相等(剪2[1], { "类型": "resource", "文本": "R" }, "裁剪内容 非文本块原样")
  # 反跑判据：把 resource 原样断言改错即红
  断言相等(剪2[2]["文本"], "bb", "裁剪内容 末块尾段")
  断言相等(度量内容(剪2), 44, "裁剪内容 多块裁剪后码点")
  # 反跑判据：把 44 改 45 即红

  # 1.6 裁剪内容：头字符 0（全部从头部移除）
  设 剪3 为 裁剪内容([ { "类型": "text", "文本": 长文本 } ], 50, 0, 2)
  断言相等(剪3[0]["文本"], 压缩省略标记 + "xx", "裁剪内容 头0 只保留标记+尾")
  # 反跑判据：把期望改反即红

  # 1.7 裁剪内容：尾字符 0
  设 剪4 为 裁剪内容([ { "类型": "text", "文本": 长文本 } ], 50, 3, 0)
  断言相等(剪4[0]["文本"], "xxx" + 压缩省略标记, "裁剪内容 尾0 只保留头+标记")
  # 反跑判据：把期望改反即红

  # 1.8 整理裁剪配置：默认值
  设 配1 为 整理裁剪配置({})
  断言相等(配1["阈值字符"], 8192, "整理裁剪配置 默认阈值 8192")
  断言相等(配1["头字符"], 4096, "整理裁剪配置 默认头 4096")
  断言相等(配1["尾字符"], 1024, "整理裁剪配置 默认尾 1024")
  # 反跑判据：任一项改反即红

  # 1.9 整理裁剪配置：覆盖 + 不变量成立
  设 配2 为 整理裁剪配置({ "阈值字符": 100, "头字符": 10, "尾字符": 5 })
  断言相等(配2["阈值字符"], 100, "整理裁剪配置 覆盖阈值")
  断言相等(配2["头字符"], 10, "整理裁剪配置 覆盖头")
  断言相等(配2["尾字符"], 5, "整理裁剪配置 覆盖尾")
  # 反跑判据：任一项改反即红

  # 1.10 整理裁剪配置：非法输入抛错
  检查抛错("unknown key", 抛裁剪未知键)
  检查抛错("must be at most thresholdChars", 抛裁剪不变量)   # head60+marker39+tail40=139 > 100
  检查抛错("positive integer", 抛裁剪阈值零)
  检查抛错("non-negative integer", 抛裁剪负数)
  检查抛错("non-negative integer", 抛裁剪小数)  # headChars 属非负整数校验
  # 反跑判据：任一条期望抛改不抛即红

# ════════════ 二、compaction-basic config ════════════
段落 用例基础配置:
  # 2.1 整理基础配置：默认值
  设 基1 为 整理基础配置({})
  断言相等(基1["阈值比例"], 0.8, "整理基础配置 默认阈值比例")
  断言相等(基1["保留比例"], 0.16, "整理基础配置 默认保留比例")
  断言相等(基1["最大条数"], 8192, "整理基础配置 默认最大条数")
  断言相等(基1["压缩重试"], 1, "整理基础配置 默认压缩重试")
  断言相等(基1["溢出重试"], 1, "整理基础配置 默认溢出重试")
  断言相等(基1["自动"], 真, "整理基础配置 默认自动")
  断言相等(列表长度(基1["策略表"]), 0, "整理基础配置 默认策略表空")
  # 反跑判据：任一项改反即红

  # 2.2 整理基础配置：覆盖
  设 基2 为 整理基础配置({ "阈值比例": 0.5, "保留比例": 0.1, "最大条数": 4096, "压缩重试": 2, "溢出重试": 3, "自动": 假 })
  断言相等(基2["阈值比例"], 0.5, "整理基础配置 覆盖阈值比例")
  断言相等(基2["保留比例"], 0.1, "整理基础配置 覆盖保留比例")
  断言相等(基2["最大条数"], 4096, "整理基础配置 覆盖最大条数")
  断言相等(基2["压缩重试"], 2, "整理基础配置 覆盖压缩重试")
  断言相等(基2["溢出重试"], 3, "整理基础配置 覆盖溢出重试")
  断言相等(基2["自动"], 假, "整理基础配置 覆盖自动")
  # 反跑判据：任一项改反即红

  # 2.3 整理基础配置：保留条数 形态（与 保留比例 互斥）
  设 基3 为 整理基础配置({ "保留条数": 100 })
  断言相等(基3["保留条数"], 100, "整理基础配置 保留条数形态")
  断言真(取可选(基3, "保留比例") == 空, "整理基础配置 保留比例缺席")
  # 反跑判据：把 100 改 99 即红

  # 2.4 整理基础配置：非法输入抛错
  检查抛错("unknown key", 抛基础未知键)
  检查抛错("mutually exclusive", 抛基础互斥)
  检查抛错("retainRatio", 抛基础比例越界)
  检查抛错("auto must be a boolean", 抛基础自动非布尔)
  检查抛错("duplicate model policy", 抛基础重复策略)
  检查抛错("must be an array", 抛基础策略非数组)
  检查抛错("must be a non-empty string", 抛基础策略缺项)
  检查抛错("must be set together", 抛基础摘要不配对)
  # 反跑判据：任一条期望抛改不抛即红

  # 2.5 整理目标策略：无覆盖 → 继承默认
  设 策1 为 整理目标策略(基1, { "提供方": "deepseek", "模型": "deepseek-chat" })
  断言相等(策1["目标"]["提供方"], "deepseek", "整理目标策略 目标提供方")
  断言相等(策1["目标"]["模型"], "deepseek-chat", "整理目标策略 目标模型")
  断言相等(策1["阈值比例"], 0.8, "整理目标策略 继承阈值比例")
  断言相等(策1["保留比例"], 0.16, "整理目标策略 继承保留比例")
  断言相等(策1["最大条数"], 8192, "整理目标策略 继承最大条数")
  # 反跑判据：任一项改反即红

  # 2.6 整理目标策略：精确覆盖生效
  设 基4 为 整理基础配置({ "策略表": [ { "提供方": "deepseek", "模型": "deepseek-chat", "阈值比例": 0.6, "保留条数": 400 } ] })
  设 策2 为 整理目标策略(基4, { "提供方": "deepseek", "模型": "deepseek-chat" })
  断言相等(策2["阈值比例"], 0.6, "整理目标策略 覆盖阈值比例")
  断言相等(策2["保留条数"], 400, "整理目标策略 覆盖保留条数")
  断言真(取可选(策2, "保留比例") == 空, "整理目标策略 覆盖后保留比例缺席")
  # 反跑判据：把 0.6 改 0.8 即红
  设 策3 为 整理目标策略(基4, { "提供方": "deepseek", "模型": "other-model" })
  断言相等(策3["阈值比例"], 0.8, "整理目标策略 未命中回退默认")
  # 反跑判据：把 0.8 改 0.6 即红

  # 2.7 确定预算：上下文窗口 → token 预算
  设 预1 为 确定预算(策1, 128000)
  断言相等(预1["上下文窗口"], 128000, "确定预算 上下文窗口")
  断言相等(预1["阈值条数"], 102400, "确定预算 阈值条数=128000*0.8")
  # 反跑判据：把 102400 改 102399 即红
  断言相等(预1["保留条数"], 20480, "确定预算 保留条数=128000*0.16")
  # 反跑判据：把 20480 改 20479 即红

  # 2.8 确定预算：显式 保留条数 不缩放
  设 预2 为 确定预算(策2, 128000)
  断言相等(预2["保留条数"], 400, "确定预算 显式保留条数")
  # 反跑判据：把 400 改 399 即红

  # 2.9 确定预算：非法上下文 / 保留越界 抛错
  检查抛错("contextWindow", 抛预算窗口零)
  检查抛错("contextWindow", 抛预算窗口负)
  检查抛错("must be less than threshold tokens", 抛预算保留越界)
  # 反跑判据：任一条期望抛改不抛即红

# ════════════ 三、tool-pairing ════════════
# 事件表：0=user, 1=assistant(1 tool-call), 2=tool/result, 3=assistant(0),
#         4=assistant(2 tool-call), 5=tool/result, 6=tool/result, 7=user
# 切口表（8 节点 9 切口）：[真,真,假,真,真,假,假,真,真]
段落 用例配对平衡:
  设 日志表 为 []
  日志表.追加({ "序号": 0, "类型": "user/message", "数据": {} })
  日志表.追加({ "序号": 1, "类型": "assistant/message", "数据": { "消息": { "content": [ { "类型": "tool-call", "名称": "bash" } ] } } })
  日志表.追加({ "序号": 2, "类型": "tool/result", "数据": {} })
  日志表.追加({ "序号": 3, "类型": "assistant/message", "数据": { "消息": { "content": [] } } })
  日志表.追加({ "序号": 4, "类型": "assistant/message", "数据": { "消息": { "content": [ { "类型": "tool-call" }, { "类型": "tool-call" } ] } } })
  日志表.追加({ "序号": 5, "类型": "tool/result", "数据": {} })
  日志表.追加({ "序号": 6, "类型": "tool/result", "数据": {} })
  日志表.追加({ "序号": 7, "类型": "user/message", "数据": {} })
  设 表面 为 { "节点表": [0, 1, 2, 3, 4, 5, 6, 7], "事件表": 日志表, "生成代": 0, "平衡缓存": 空 }

  # 3.1 条目增量
  断言相等(条目增量(日志表[0]), 0, "条目增量 user 0")
  断言相等(条目增量(日志表[1]), 1, "条目增量 assistant 1 tool-call")
  断言相等(条目增量(日志表[2]), -1, "条目增量 tool/result -1")
  断言相等(条目增量(日志表[3]), 0, "条目增量 assistant 0 tool-call")
  断言相等(条目增量(日志表[4]), 2, "条目增量 assistant 2 tool-call")
  # 反跑判据：任一项改反即红

  # 3.2 配对平衡前/后（同步缓存）
  断言真(配对平衡前(表面, 0) == 真, "配对平衡前 0 切口0 平衡")
  断言真(配对平衡前(表面, 1) == 真, "配对平衡前 1 切口1 平衡")
  断言真(配对平衡前(表面, 2) == 假, "配对平衡前 2 未闭合 非平衡")
  断言真(配对平衡后(表面, 2) == 真, "配对平衡后 2 切口3 平衡")
  断言真(配对平衡前(表面, 4) == 真, "配对平衡前 4 平衡")
  断言真(配对平衡前(表面, 5) == 假, "配对平衡前 5 未闭合 非平衡")
  断言真(配对平衡后(表面, 6) == 真, "配对平衡后 6 切口7 平衡")
  断言真(配对平衡后(表面, 7) == 真, "配对平衡后 7 表面尾 平衡")
  # 反跑判据：任一 真/假 改反即红

  # 3.3 同步平衡缓存：完整切口表 + 进行中=0
  设 缓存 为 同步平衡缓存(表面)
  断言相等(缓存["切口表"], [真, 真, 假, 真, 真, 假, 假, 真, 真], "同步平衡缓存 切口表")
  断言相等(缓存["进行中"], 0, "同步平衡缓存 表面尾进行中0")
  # 反跑判据：把切口表任一项改反即红

  # 3.4 扩展缓存：先小后大增量折叠
  设 日志表短 为 [ 日志表[0], 日志表[1], 日志表[2], 日志表[3] ]
  设 表面短 为 { "节点表": [0, 1, 2, 3], "事件表": 日志表短, "生成代": 0, "平衡缓存": 空 }
  设 缓存短 为 同步平衡缓存(表面短)
  断言相等(缓存短["切口表"], [真, 真, 假, 真, 真], "扩展缓存 短表面切口表")
  # 反跑判据：把 [真,真,假,真,真] 任一项改反即红
  # 同代追加 4..7 → 增量扩展
  设 表面长 为 { "节点表": [0, 1, 2, 3, 4, 5, 6, 7], "事件表": 日志表, "生成代": 0, "平衡缓存": 缓存短 }
  设 缓存长 为 同步平衡缓存(表面长)
  断言相等(缓存长["切口表"], [真, 真, 假, 真, 真, 假, 假, 真, 真], "扩展缓存 增量扩展后切口表")
  断言相等(缓存长["进行中"], 0, "扩展缓存 扩展后进行中0")
  # 反跑判据：把扩展后切口表任一项改反即红

  # 3.5 生成代变化 → 重建
  设 表面换代 为 { "节点表": [0, 1, 2, 3], "事件表": 日志表短, "生成代": 1, "平衡缓存": 缓存短 }
  设 缓存换 为 同步平衡缓存(表面换代)
  断言相等(缓存换["生成代"], 1, "同步平衡缓存 换代重建")
  # 反跑判据：把 1 改 0 即红

  # 3.6 损坏表面 / 缺序号 抛错
  检查抛错("no matching tool-call", 抛配对损坏)
  检查抛错("not found", 抛配对缺序号)
  # 反跑判据：任一条期望抛改不抛即红

  返回 表面

# ════════════ 四、region ════════════
段落 用例区域 接收 表面:
  # 价格节点：8 节点各 10 token
  设 价格表 为 []
  设 序号 为 0
  当 序号 < 8:
    价格表.追加({ "序号": 序号, "条数": 10 })
    设 序号 为 序号 + 1

  # 4.1 保留 10 token → 只留末节点；起点=首节点，终点=6
  设 区1 为 选择可压缩区(表面, 价格表, 10)
  断言相等(区1["起点"], 0, "选择可压缩区 起点=最旧节点")
  断言相等(区1["终点"], 6, "选择可压缩区 保留10 终点6")
  # 反跑判据：把 6 改 5 即红

  # 4.2 保留 30 token → 保留起点5 不平衡 → 左移到4
  设 区2 为 选择可压缩区(表面, 价格表, 30)
  断言相等(区2["起点"], 0, "选择可压缩区 起点=0")
  断言相等(区2["终点"], 3, "选择可压缩区 保留30 终点3")
  # 反跑判据：把 3 改 2 即红

  # 4.3 保留 100 token（覆盖全表面）→ 空
  断言相等(选择可压缩区(表面, 价格表, 100), 空, "选择可压缩区 保留全覆盖 空")
  # 反跑判据：把 空 改非空即红

  # 4.4 空价格节点 → 空；表面与价格不匹配 → 抛错
  断言相等(选择可压缩区(表面, [], 10), 空, "选择可压缩区 空价格 空")
  检查抛错("token-meter surface does not match", 抛区域不符)
  # 反跑判据：任一条期望改反即红

# ════════════ 五、checkpoint ════════════
段落 用例检查点:
  # 5.1 造检查点来源：无命令标识
  设 点1 为 造检查点来源("cid-1", 空)
  断言相等(点1["种类"], "plugin", "造检查点来源 种类")
  断言相等(点1["插件"], "compact", "造检查点来源 插件")
  断言相等(点1["压缩标识"], "cid-1", "造检查点来源 压缩标识")
  断言真(取可选(点1, "来源命令标识") == 空, "造检查点来源 无命令标识缺席")
  # 反跑判据：任一项改反即红

  # 5.2 造检查点来源：带命令标识
  设 点2 为 造检查点来源("cid-2", "cmd-9")
  断言相等(点2["来源命令标识"], "cmd-9", "造检查点来源 命令标识")
  # 反跑判据：把 "cmd-9" 改 "cmd-8" 即红

  # 5.3 是否检查点来源
  断言真(是否检查点来源(点1) == 真, "是否检查点来源 真")
  断言真(是否检查点来源({ "种类": "plugin", "插件": "other" }) == 假, "是否检查点来源 插件不符 假")
  断言真(是否检查点来源({ "种类": "user" }) == 假, "是否检查点来源 种类不符 假")
  # 反跑判据：任一 真/假 改反即红

# ════════════ 主程 ════════════
段落 主程:
  用例裁剪()
  用例基础配置()
  设 表面 为 用例配对平衡()
  用例区域(表面)
  用例检查点()
  打印 "--- 测试压缩配套 通过 ---"

主程()
