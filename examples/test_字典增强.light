# test_字典增强.light —— 第18轮任务1 测试（#116 / R18-D1）
# 验证 src/字典增强.light 的 10 个字典工具函数，含正常/边界/异常三态。
# 反跑锚点：A=字典获取+深度设置+序列化JSON排序组合；B=深度设置中间层自动建/深度获取缺层返默认；
#           C=深度设置只设第一层（变异）→ 双层赋值测试立红。

从 字典增强 导入 字典获取, 深度设置, 深度获取, 键规范化, 序列化JSON排序
从 字典增强 导入 造身份令牌, 字典合并, 字典深拷贝, 属性获取, 空字典
从 内置核心判型 导入 是字符串

# ── 断言辅助段 ──
段落 断言相等(实际, 期望, 标签 = ""):
  如果 实际 == 期望:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望))

段落 断言真(条件, 标签 = ""):
  如果 条件 == 真:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 期望为真 实际=" 加上 转字符串(条件))

段落 应抛错(标签, 块):
  设 炸 为 假
  尝试:
    块()
  捕获 异常:
    设 炸 为 真
  如果 炸 == 真:
    打印 "  ✓ " 加上 标签
  否则:
    抛出 新建 错误("断言失败[" 加上 标签 加上 "] 期望抛错但未抛")

# ── 异常触发段（供 应抛错 调用）──
段落 深度设置空路径:
  深度设置({}, [], 1)

段落 深度设置非字典中间层:
  设 d 为 {"a": "字符串"}
  深度设置(d, ["a", "b"], 1)

段落 主:
  打印 "===== test_字典增强 ====="

  # §1 字典获取（L-135/L-103）
  设 d1 为 {"x": 10}
  断言相等(字典获取(d1, "x", 空), 10, "1a 存在键返回值")
  断言相等(字典获取(d1, "y", 空), 空, "1b 不存在键返回默认空")
  断言相等(字典获取(d1, "y", -1), -1, "1c 不存在键返回自定义默认")
  断言相等(字典获取({}, "z", "缺"), "缺", "1d 空字典缺键返回默认")

  # §2 深度设置（L-123）
  设 d2 为 {}
  深度设置(d2, ["甲", "乙"], 2)
  断言相等(字典获取(d2, "甲", 空), {"乙": 2}, "2a 双层赋值成功")
  设 d2b 为 {}
  深度设置(d2b, ["一", "二", "三"], 9)
  断言相等(字典获取(d2b, "一", 空), {"二": {"三": 9}}, "2b 三层赋值成功")
  设 d2c 为 {"p": {}}
  深度设置(d2c, ["p", "q", "r"], 5)
  断言相等(字典获取(d2c, "p", 空), {"q": {"r": 5}}, "2c 中间层自动创建")
  应抛错("2d 空键路径报错", 深度设置空路径)
  应抛错("2e 非字典中间层报错", 深度设置非字典中间层)

  # §3 深度获取
  设 d3 为 {"a": {"b": {"c": 7}}}
  断言相等(深度获取(d3, ["a", "b", "c"], 空), 7, "3a 多层获取成功")
  断言相等(深度获取(d3, ["a", "x", "c"], 空), 空, "3b 中间层缺失返默认")
  断言相等(深度获取(d3, ["a"], 空), {"b": {"c": 7}}, "3c 单层中段返回")
  断言相等(深度获取(d3, [], 空), d3, "3d 空键路径返回原字典")
  断言相等(深度获取(d3, ["a", "b", "z"], "无"), "无", "3e 末尾缺失返默认")

  # §4 键规范化（L-116）
  设 d4 为 {"b": 1, "a": 2}
  断言相等(字典键列表(键规范化(d4)), ["a", "b"], "4a 无序字典键规范化排序")
  设 d4b 为 {"z": {"y": 1, "x": 2}, "a": 3}
  断言相等(字典键列表(键规范化(d4b)), ["a", "z"], "4b 嵌套字典递归规范化外层排序")
  断言相等(字典键列表(键规范化({})), [], "4c 空字典规范化")

  # §5 序列化JSON排序（L-116）
  设 甲 为 {"b": 1, "a": 2}
  设 乙 为 {"a": 2, "b": 1}
  断言相等(序列化JSON排序(甲), 序列化JSON排序(乙), "5a 同内容不同键序序列化一致")
  设 甲嵌套 为 {"x": {"b": 1, "a": 2}}
  设 乙嵌套 为 {"x": {"a": 2, "b": 1}}
  断言相等(序列化JSON排序(甲嵌套), 序列化JSON排序(乙嵌套), "5b 嵌套字典序列化一致")
  断言相等(序列化JSON排序({}), "{}", "5c 空字典序列化")

  # §6 造身份令牌（L-127）
  设 t1 为 造身份令牌()
  设 t2 为 造身份令牌()
  断言真(t1 != t2, "6a 两次调用返回不同令牌")
  断言真(是字符串(t1) == 真, "6b 令牌为字符串")
  设 dt 为 {}
  字典设置(dt, t1, "v")
  断言相等(字典获取(dt, t1, 空), "v", "6c 令牌可作字典键")

  # §7 字典合并
  设 A 为 {"k": 1, "onlyA": "a"}
  设 B 为 {"k": 2, "onlyB": "b"}
  断言相等(字典合并(A, B, 真)["k"], 2, "7a 覆盖模式B覆盖A")
  断言相等(字典合并(A, B, 假)["k"], 1, "7b 不覆盖模式A优先")
  断言相等(字典合并(A, {}, 真)["onlyA"], "a", "7c 空B合并保留A")
  断言相等(字典获取(字典合并(A, B, 真), "onlyB", 空), "b", "7d 合并带B独有键")

  # §8 字典深拷贝
  设 原 为 {"a": {"b": [1, 2]}, "c": 3}
  设 拷 为 字典深拷贝(原)
  设 内层 为 原["a"]
  内层["b"].追加(3)
  断言相等(深度获取(拷, ["a", "b"], 空), [1, 2], "8a 拷贝后改原不影响拷")
  断言相等(字典获取(拷, "c", 空), 3, "8b 嵌套字典拷贝值正确")
  断言相等(字典深拷贝({}), {}, "8c 空字典深拷贝")

  # §9 属性获取（L-096）
  设 d9 为 {"name": "x"}
  断言相等(属性获取(d9, "name", 空), "x", "9a 存在键返回")
  断言相等(属性获取(d9, "miss", "默认"), "默认", "9b 不存在返回默认")
  断言相等(属性获取("非字典", "k", 空), 空, "9c 非字典对象返回默认")

  # §10 空字典（L-100）
  设 e1 为 空字典()
  断言相等(e1, {}, "10a 返回空字典")
  字典设置(e1, "k", 1)
  断言相等(字典获取(e1, "k", 空), 1, "10b 空字典可赋值")
  断言真(是字典(e1) == 真, "10c 空字典是字典类型")

  # §11 组合（反跑 A 锚点）：字典获取 + 深度设置 + 序列化JSON排序
  设 配置 为 {}
  深度设置(配置, ["db", "host"], "127.0.0.1")
  深度设置(配置, ["db", "port"], 5432)
  断言相等(字典获取(配置, "db", 空), {"host": "127.0.0.1", "port": 5432}, "11a 深度设置组合")
  设 配置乱序 为 {"db": {"port": 5432, "host": "127.0.0.1"}}
  断言相等(序列化JSON排序(配置), 序列化JSON排序(配置乱序), "11b 组合后键序规范化一致")
  断言相等(深度获取(配置, ["db", "port"], 空), 5432, "11c 深度获取组合")

  打印 "test_字典增强 PASS"
