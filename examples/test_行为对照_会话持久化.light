# test_行为对照_会话持久化.light —— 第 8 轮任务 2：会话/持久化 行为级对照验证
#
# 上游依据（G:\github\deepseek-harness @ 9d9035b7c1，0.1.5-rc.2）：
#   packages/core/session/tests/*.spec.ts（15 spec）
#   packages/session/session-persistence-jsonl/tests/*.spec.ts（13 spec）
#
# 只翻译「既有测试未覆盖」的可断言纯逻辑场景；已覆盖域见交付报告对照表。
#   §1 surface 空投影 / 用户消息上浮            ← surface.spec.ts
#   §2 节点0 append 连接 / replace 替换 / 遮蔽跳过 ← surface.spec.ts
#   §3 压缩替换 区间校验（✅第9轮 T2-D1 修复）      ← surface.spec.ts
#   §4 sourceEventSeqs 快照（✅第9轮 T2-D2 修复）   ← surface.spec.ts
#   §5 可选字段省略 + 版本还原（✅第9轮 T2-D3 修复） ← canonical-envelopes.spec.ts
#   §6 非负安全整数准入 / 负零（✅任务5 T2-D4 对齐）          ← sequence-types.spec.ts
#   §7 持久化恢复错误路径                        ← jsonl.spec.ts
#   §8 迁移不支持版本抛错 + 空日志抛错            ← v2-system-migration / v2-ptc-migration.spec.ts
#
# 反跑判据：任一「核验*」的期望值改反 / 任一节删除 → 红（详见 _antirun_session_contrast.py）。
# 运行：cd lightharness && python 运行.py examples/test_行为对照_会话持久化.light

从 持久化 导入 读入会话带策略, 日志路径
从 会话 导入 新建会话
从 会话格式 导入 造头, 编码V0头, 解码V0头, 造事件, 事件带来源, 投影节点0, 安全整数
从 会话格式 导入 定义迁移, 创建链, 迁移会话, 版本文本, 造目录, V3编解码, 目录恢复
从 会话格式 导入 迁移头V0V1, 迁移事件V0V1, 迁移头V1V2, 迁移事件V1V2, 迁移头V2V3, 迁移事件V2V3
从 JSON 导入 序列化JSON

# ---- 断言助手（命名避开 builtin_map：不用 断言/文本/类型/当前目录 作标识符）----
段落 含子串 接收 原文, 子串:
  设 n 为 长度(原文)
  设 m 为 长度(子串)
  如果 m == 0:
    返回 真
  设 i 为 0
  当 i + m <= n:
    如果 原文[i:(i+m)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 核验 接收 标签, 实际, 期望, 备注:
  如果 实际 != 期望:
    打印 "✗ 失败：" + 标签 + " 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际) + " (" + 备注 + ")"
    抛出 "第8轮任务2 断言失败: " + 标签
  打印 "✓ " + 标签 + " (" + 备注 + ")"
  返回 真

段落 核验真 接收 标签, 条件, 备注:
  返回 核验(标签, 条件, 真, 备注)

段落 核验含 接收 标签, 容器文本, 子串, 备注:
  返回 核验真(标签, 含子串(容器文本, 子串), 备注)

# ---- 对照链（只用导出符号拼装，等价 会话格式.标准链）----
段落 造对照链:
  设 表 为 []
  列表追加(表, 定义迁移("v0-to-v1", 0, 0, 1, 0, 迁移头V0V1, 迁移事件V0V1))
  列表追加(表, 定义迁移("v1-to-v2", 1, 0, 2, 0, 迁移头V1V2, 迁移事件V1V2))
  列表追加(表, 定义迁移("v2-to-v3", 2, 0, 3, 0, 迁移头V2V3, 迁移事件V2V3))
  返回 创建链(表)

# ---- 临时日志根目录 ----
段落 取对照根:
  返回 当前目录() + "\\_contrast_r8t2_tmp"

段落 主:
  打印 "===== 第 8 轮任务 2：会话/持久化 行为对照 ====="

  # ================= §1 对标 surface.spec.ts「empty surface yields empty nodes」
  #                「rejected-context and user messages appear on surface」
  设 会话甲 为 新建会话("kong1", ".")
  核验真("1a 空会话投影为空", 长度(会话甲.整理消息()) == 0, "空 surface 产生空节点列表")
  核验真("1b 空事件表节点0为空", 投影节点0([]) == 空, "空 surface 节点0 = 无消息")
  设 占1 为 会话甲.记录事件("user/message", ["role": "user", "content": [["type": "text", "text": "你好"]]])
  核验真("1c 用户消息上浮", 长度(会话甲.整理消息()) == 1, "user/message 出现在 surface")
  核验真("1d 首事件序号为0", 占1["序号"] == 0, "事件身份与日志偏移分离：首条序号0")

  # ================= §2 对标 surface.spec.ts「projects a system node as the leading
  #                system-role message」「build with replace splices out shadowed nodes」
  设 会话乙 为 新建会话("jie0", ".")
  设 系统一 为 会话乙.记录系统提示("S1", "append")
  核验("2a 节点0首投影", 会话乙.投影节点0(), "S1", "system/message 成为节点0")
  设 系统二 为 会话乙.记录系统提示("S2", "append")
  核验("2b append 连接", 会话乙.投影节点0(), "S1S2", "append 语义为连接")
  设 系统三 为 会话乙.记录系统提示("S3", "replace")
  核验("2c replace 替换", 会话乙.投影节点0(), "S3", "replace 遮蔽此前节点")
  系统三["遮蔽"] 为 真
  核验("2d 遮蔽后回退", 会话乙.投影节点0(), "S1S2", "被遮蔽的 system/message 跳过")
  设 界面 为 会话乙.整理消息()
  核验真("2e 节点0置于最前", 界面[0]["role"] == "system", "system 角色消息领先")

  # ================= §3 对标 surface.spec.ts「throws when replace start is not found /
  #                end is not found / start is after end」
  # ✅ 第9轮 T2-D1 已修复：无效区间抛错，文案对齐上游。
  设 会话丙 为 新建会话("bianjie", ".")
  设 占2 为 会话丙.记录事件("user/message", ["role": "user", "content": [["type": "text", "text": "a"]]])
  设 占3 为 会话丙.记录事件("assistant/message", ["消息": ["标识": "m1", "content": [["type": "text", "text": "b"]]]])
  尝试:
    设 占4 为 会话丙.压缩替换(7, 9, [])
    核验真("3a 起点不存在抛错", 假, "起点不存在应抛错")
  捕获 异常 错误:
    核验含("3a 起点不存在抛错", 转字符串(错误), "surface replace: start seq 7 not found", "上游同文案")
  尝试:
    设 占5 为 会话丙.压缩替换(9, 7, [])
    核验真("3b 起点大于终点抛错", 假, "start>end 应抛错")
  捕获 异常 错误:
    核验含("3b 起点大于终点抛错", 转字符串(错误), "start seq 9 is after end seq 7", "上游同文案")
  尝试:
    设 占5b 为 会话丙.压缩替换(0, 9, [])
    核验真("3b2 终点不存在抛错", 假, "终点不存在应抛错")
  捕获 异常 错误:
    核验含("3b2 终点不存在抛错", 转字符串(错误), "surface replace: end seq 9 not found", "上游同文案")
  设 占6 为 会话丙.压缩替换(0, 1, [])
  核验真("3c 命中区间才遮蔽", 占3.包含("遮蔽") 且 占2.包含("遮蔽"), "合法区间遮蔽语义仍在")

  # ================= §4 对标 surface.spec.ts「sourceEventSeqs is snapshot so caller
  #                mutation does not affect logged event」
  # ✅ 第9轮 T2-D2 已修复：事件带来源 经 副本() 做快照，调用方改动不透传。
  设 源表 为 [1, 2]
  设 事件甲 为 造事件("tool/result", 5, 0, ["消息": "x"])
  设 占7 为 事件带来源(事件甲, 源表)
  列表追加(源表, 99)
  核验真("4a 调用方改动不透传", 长度(事件甲["来源事件序号"]) == 2, "上游快照语义：记录后与源表脱钩")
  核验("4b 快照内容一致", 事件甲["来源事件序号"][1], 2, "拷贝值与源表一致")

  # ================= §5 对标 canonical-envelopes.spec.ts「accepts absent optional
  #                fields」「preserves nested headers」
  设 头甲 为 造头(3, 0, "hdr1", 42, 空, 空, 空, 假)
  设 行甲 为 编码V0头(头甲)
  核验真("5a 空可选字段省略 cwd", 字典包含键(行甲, "cwd") == 假, "可选字段缺省时不落键")
  核验真("5b 空可选字段省略 agentPreset", 字典包含键(行甲, "agentPreset") == 假, "同上")
  核验真("5c 非种子不落 seedLength", 字典包含键(行甲, "seedLength") == 假, "同上")
  核验("5d 标识保留", 行甲["id"], "hdr1", "嵌套头字段保留")
  核验真("5e 嵌套版本对象英文键", 行甲["version"]["major"] == 3 且 行甲["version"]["minor"] == 0, "JSON 形状对齐上游 canonical envelope")
  # ✅ 第9轮 T2-D3 已修复：编码V0头/编码V2头 统一英文键，编码→解码版本还原。
  设 头乙 为 解码V0头(行甲)
  核验("5f 往返版本还原", 版本文本(头乙["版本"]), "3.0", "对齐上游：编码→解码还原 3.0")
  核验("5g 往返标识", 头乙["标识"], "hdr1", "标识往返一致")

  # ================= §6 对标 sequence-types.spec.ts「admits non-negative safe integers」
  #                「rejects a negative-zero seq at the restored event boundary」
  核验真("6a 零准入", 安全整数(0, "seq") == 真, "0 是合法非负整数")
  尝试:
    设 占8 为 安全整数(-1, "seq")
    核验真("6b 负数拒绝", 假, "负序号应抛错")
  捕获 异常 错误:
    核验含("6b 负数拒绝", 转字符串(错误), "must be non-negative", "上游同文案")
  尝试:
    设 占9 为 安全整数(1.5, "seq")
    核验真("6c 非整数拒绝", 假, "小数应抛错")
  捕获 异常 错误:
    核验含("6c 非整数拒绝", 转字符串(错误), "must be an integer", "上游同文案")
  # ✅ 任务5 T2-D4 已对齐：是负零 原语提供后，恢复边界可显式拒绝负零序号。
  #    上游 Object.is(value, -0) 对 -0 抛 non-negative safe integer；光明侧
  #    浮点 -0.0（转浮点("-0.0") 构造）走 是负零 → must be non-negative。
  #    注：JSON 文本 "-0" 在 Python/光明中解析为整数 0，符号位在解析层丢失
  #    （JS 数字无 int/float 之分，JSON.parse("-0") 保留 -0）——该形态无法在
  #    语言层区分，属宿主解析差异；数值域负零（float -0.0）已显式拒绝。
  尝试:
    设 占负零 为 安全整数(转浮点("-0.0"), "seq")
    核验真("6d 负零拒绝", 假, "负零序号应抛错")
  捕获 异常 错误:
    核验含("6d 负零拒绝", 转字符串(错误), "must be non-negative", "上游同语义")

  # ================= §7 对标 jsonl.spec.ts「first row must be a session header /
  #                missing log / strict vs recoverable bad rows」
  设 对照根 为 取对照根()
  创建目录(对照根)
  设 占A 为 日志路径(对照根, "G:/p", "缺失会话")
  尝试:
    设 占B 为 读入会话带策略(对照根, "G:/p", "缺失会话", "strict")
    核验真("7a 缺日志拒绝", 假, "文件不存在应抛错")
  捕获 异常 错误:
    核验含("7a 缺日志拒绝", 转字符串(错误), "会话日志不存在", "上游同语义")

  设 头行 为 ["type": "event", "seq": 0]
  写入文件(日志路径(对照根, "G:/p", "坏头"), 序列化JSON(头行) + "\n")
  尝试:
    设 占C 为 读入会话带策略(对照根, "G:/p", "坏头", "strict")
    核验真("7b 首行非session拒绝", 假, "首行必须是 session 头")
  捕获 异常 错误:
    核验含("7b 首行非session拒绝", 转字符串(错误), "会话日志首行不是 session 头", "上游同语义")

  设 好头 为 ["type": "session", "version": ["major": 3, "minor": 0], "id": "mix1", "createdAt": 1, "delegationDepth": 0, "cwd": "G:/p"]
  设 好事件 为 ["type": "user/message", "seq": 0, "time": 1, "data": ["消息": "ok"]]
  设 混合全文 为 序列化JSON(好头) + "\n" + "这不是合法JSON的坏行" + "\n" + 序列化JSON(好事件) + "\n"
  写入文件(日志路径(对照根, "G:/p", "mix1"), 混合全文)
  尝试:
    设 占D 为 读入会话带策略(对照根, "G:/p", "mix1", "strict")
    核验真("7c strict坏行抛错", 假, "strict 遇坏行必须抛错")
  捕获 异常 错误:
    打印 "✓ 7c strict坏行抛错（错误=" + 转字符串(错误) + "）"
  设 宽容会话 为 读入会话带策略(对照根, "G:/p", "mix1", "recoverable")
  核验真("7d recoverable跳过续读", 宽容会话.事件数() == 1, "坏行跳过后好事件完整")
  核验("7e 恢复事件内容", 宽容会话.汇集全部事件()[0]["数据"]["消息"], "ok", "载荷逐字还原")

  # ================= §8 对标 v2-system-migration / v2-ptc-migration.spec.ts
  #                「unsupported session format migration」+ 目录恢复 空日志
  设 对照链 为 造对照链()
  设 头丙 为 造头(2, 1, "odd1", 1, "G:/p", 空, 空, 假)
  尝试:
    设 占E 为 迁移会话(对照链, 头丙, [], ["主": 3, "次": 0])
    核验真("8a 链外版本抛错", 假, "2.1 不在迁移链上应抛错")
  捕获 异常 错误:
    核验含("8a 链外版本抛错", 转字符串(错误), "unsupported session format migration 2.1", "上游同文案")
  设 对照目 为 造目录("current", V3编解码, 对照链, ["主": 3, "次": 0])
  尝试:
    设 占F 为 目录恢复(对照目, [])
    核验真("8b 空日志抛错", 假, "空行表应抛错")
  捕获 异常 错误:
    核验含("8b 空日志抛错", 转字符串(错误), "empty session log", "上游同语义")
  核验真("8c 链内版本推进", 版本文本(迁移会话(对照链, 造头(1, 0, "mig1", 1, "G:/p", 空, 空, 假), [], ["主": 3, "次": 0])["头"]["版本"]) == "3.0", "1.0 沿链推进到 3.0")

  打印 "===== 第 8 轮任务 2 行为对照：全部通过 ====="
  如果 目录存在(对照根):
    删目录树(对照根)
