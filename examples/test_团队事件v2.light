# test_团队事件v2.light —— #65/#66 事件版本 1->2 收口 + 与 #67 折叠互操作
# 对照上游：agent-team/src/types.ts SessionEventMap（version:2）+ task-graph.ts + task-board.ts
#   + fold.spec.ts / projection-events.spec.ts 的事件版本用例
#
# 覆盖：
#   1) v2 内层载荷：member/task/queued/delivered 四条通知 version==2
#   2) delivery 字段移除：送达通知无 delivery 键
#   3) v2 信封包装：{type, data:{version:2,teamId,...}} 形状
#   4) #65 产出记录喂 #67 折叠团队（member/task/queued+delivered）
#   5) fold 宽容兼容：v1 本团队 -> unsupported 抛错；v1 非本团队 -> 静默忽略
#   6) #66 看板投影 v2：中文记录 -> TeamTaskSnapshot + 信封
#   7) #66 投影记录喂 #67 折叠跑通互操作
#
# 反跑判据（改反必红）：
#   A) 送达通知 version 改回 1 / 加 delivery 键 -> 红
#   B) #66 状态映射待办->pending 改错 -> 折叠校验红
#   C) 信封缺 data.version -> 折叠校验红

从 团队依赖图 导入 构造成员快照, 构造任务快照, 构造成员通知, 构造任务通知, 构造排队通知, 构造送达通知, 包装成员记录, 包装任务记录, 包装排队记录, 包装送达记录
从 团队折叠 导入 折叠团队, 是否空折叠, 待领消息
从 团队看板 导入 团队看板, 映射看板状态, 投影v2任务, 投影v2记录
从 JSON 导入 序列化JSON

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败(期望真): " + 标签)

段落 检查抛错(标签, 运算):
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)

# =====================================================================
# 常量
# =====================================================================
设 根 为 "team-root"
设 子 为 "child-a"

# =====================================================================
# 1. v2 内层载荷形状（types.ts SessionEventMap version:2）
# =====================================================================
段落 用例内层载荷v2:
  设 成员快照 为 构造成员快照(子, "worker-a", "worker", "spawn", "fresh", "provisioning", 空)
  设 成员通知 为 构造成员通知(根, 成员快照)
  断言相等(成员通知["version"], 2, "成员通知 version==2")
  断言相等(成员通知["teamId"], 根, "成员通知 teamId")
  断言相等(成员通知["member"]["phase"], "provisioning", "成员通知 member.phase")

  设 任务快照 为 构造任务快照("task-1", 1, "subject", "description", "pending", 空, [], [])
  设 任务通知 为 构造任务通知(根, 任务快照)
  断言相等(任务通知["version"], 2, "任务通知 version==2")
  断言相等(任务通知["teamId"], 根, "任务通知 teamId")
  断言相等(任务通知["task"]["status"], "pending", "任务通知 task.status")

  设 排队通知 为 构造排队通知(根, 任务快照)
  断言相等(排队通知["version"], 2, "排队通知 version==2")

  设 送达通知 为 构造送达通知(根, "msg-1", 子)
  断言相等(送达通知["version"], 2, "送达通知 version==2")
  断言相等(送达通知["messageId"], "msg-1", "送达通知 messageId")
  断言相等(送达通知["targetId"], 子, "送达通知 targetId")
  # delivery 字段移除（v1->v2 关键差异）
  断言真(字典包含键(送达通知, "delivery") == 假, "送达通知无 delivery 字段")

# =====================================================================
# 2. v2 信封包装（#65 产出记录直接喂 #67 折叠）
# =====================================================================
段落 用例信封包装:
  设 任务快照 为 构造任务快照("task-1", 1, "subject", "description", "pending", 空, [], [])
  设 记 为 包装任务记录(根, 任务快照, 1)
  断言相等(记["type"], "team/task", "信封 type==team/task")
  断言相等(记["data"]["version"], 2, "信封 data.version==2")
  断言相等(记["data"]["teamId"], 根, "信封 data.teamId")
  断言相等(记["data"]["task"]["id"], "task-1", "信封 data.task.id")

  设 成员快照 为 构造成员快照(子, "worker-a", "worker", "spawn", "fresh", "provisioning", 空)
  设 记2 为 包装成员记录(根, 成员快照, 2)
  断言相等(记2["type"], "team/member", "信封 type==team/member")

# =====================================================================
# 3. #65 产出记录喂 #67 折叠团队（互操作）
# =====================================================================
段落 用例折叠互操作:
  设 成员快照 为 构造成员快照(子, "worker-a", "worker", "spawn", "fresh", "provisioning", 空)
  设 任务快照 为 构造任务快照("task-1", 1, "subject", "description", "pending", 空, [], [])
  设 消息快照 为 {"id": "msg-1", "senderId": 根, "senderName": "lead", "targetId": 子, "content": [{"type": "text", "text": "hello"}]}
  设 记成员 为 包装成员记录(根, 成员快照, 1)
  设 记任务 为 包装任务记录(根, 任务快照, 2)
  设 记排队 为 包装排队记录(根, 消息快照, 3)
  设 局面 为 折叠团队(根, [记成员, 记任务, 记排队])
  断言真(字典包含键(局面["成员表"], 子), "折叠后成员表含子")
  断言真(字典包含键(局面["任务表"], "task-1"), "折叠后任务表含 task-1")
  断言相等(列表长度(待领消息(局面)), 1, "排队未送达 -> 待领 1 条")
  # 送达后待领清空
  设 记送达 为 包装送达记录(根, "msg-1", 子, 4)
  设 局面2 为 折叠团队(根, [记成员, 记任务, 记排队, 记送达])
  断言相等(列表长度(待领消息(局面2)), 0, "送达后待领清空")

# =====================================================================
# 4. fold 宽容兼容：v1 事件
# =====================================================================
段落 段_v1本团队:
  设 任务快照 为 构造任务快照("task-9", 1, "s", "d", "pending", 空, [], [])
  设 记 为 {"type": "team/task", "data": {"version": 1, "teamId": 根, "task": 任务快照}, "seq": 9}
  设 占位 为 折叠团队(根, [记])

段落 用例v1宽容:
  # 本团队 v1 -> 抛 unsupported event version
  检查抛错("本团队 v1 事件必抛 unsupported", 段_v1本团队)
  # 非本团队 v1 -> 静默忽略（fold 宽容兼容保留）
  设 任务快照 为 构造任务快照("task-9", 1, "s", "d", "pending", 空, [], [])
  设 记 为 {"type": "team/task", "data": {"version": 1, "teamId": "other-team", "task": 任务快照}, "seq": 9}
  设 局面 为 折叠团队(根, [记])
  断言真(是否空折叠(局面), "非本团队 v1 静默忽略 -> 空折叠")

# =====================================================================
# 5. #66 看板投影 v2 + 互操作
# =====================================================================
段落 用例看板投影:
  断言相等(映射看板状态("待办"), "pending", "待办->pending")
  断言相等(映射看板状态("进行中"), "in_progress", "进行中->in_progress")
  断言相等(映射看板状态("完成"), "completed", "完成->completed")

  设 已记 为 []
  段落 收记录(记录):
    列表追加(已记, 记录)
  设 板 为 新建 团队看板(收记录)
  设 占位 为 板.创建("a", [], 0)
  设 占位 为 板.创建("b", ["a"], 0)
  设 占位 为 板.完成("a")
  设 记录a 为 板.查询("a")
  设 v2a 为 投影v2记录(根, "a", 记录a, 1, 1)
  断言相等(v2a["type"], "team/task", "看板投影 type==team/task")
  断言相等(v2a["data"]["version"], 2, "看板投影 data.version==2")
  断言相等(v2a["data"]["task"]["status"], "completed", "看板投影 a.status==completed")
  断言相等(v2a["data"]["task"]["blockedBy"], [], "看板投影 a.blockedBy 空")
  设 记录b 为 板.查询("b")
  设 v2b 为 投影v2记录(根, "b", 记录b, 1, 2)
  断言相等(v2b["data"]["task"]["blockedBy"], ["a"], "看板投影 b.blockedBy==[a]")
  # 互操作：投影记录喂 #67 折叠（先 a 后 b，拓扑序）
  设 局面 为 折叠团队(根, [v2a, v2b])
  断言真(字典包含键(局面["任务表"], "a"), "折叠后含 a")
  断言真(字典包含键(局面["任务表"], "b"), "折叠后含 b")
  断言相等(局面["任务表"]["b"]["blockedBy"], ["a"], "折叠后 b.blockedBy 保留")

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  用例内层载荷v2()
  用例信封包装()
  用例折叠互操作()
  用例v1宽容()
  用例看板投影()
  写 "test_团队事件v2: 全部用例通过"

主程()
