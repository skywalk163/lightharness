# test_R85_E_工具.diff.light —— R85 任务E 工具域：tool-fs 行级差异 / 写参数 / 写输出
从 工具_写文件 导入 绳计算块差异, 绳解析写参数, 绳格式化写输出

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件))

段落 主:
  # ① 行级 LCS 差异：单处修改
  设 前 为 "alpha\nbeta\ngamma\ndelta"
  设 后 为 "alpha\nBETA\ngamma\ndelta"
  设 块表 为 绳计算块差异("x.txt", 前, 后)
  断言相等(长度(块表), 1, "单改块数")
  断言相等(块表[0]["路径"], "x.txt", "块路径")
  断言相等(块表[0]["旧文本"], "beta", "旧文本")
  断言相等(块表[0]["新文本"], "BETA", "新文本")

  # ② 多处分散修改 → 多块
  设 前二 为 "a\nb\nc\nd\ne"
  设 后二 为 "a\nX\nc\nY\ne"
  设 块二 为 绳计算块差异("f", 前二, 后二)
  断言相等(长度(块二), 2, "两改块数")
  断言相等(块二[0]["旧文本"], "b", "块一旧")
  断言相等(块二[0]["新文本"], "X", "块一新")
  断言相等(块二[1]["旧文本"], "d", "块二旧")
  断言相等(块二[1]["新文本"], "Y", "块二新")

  # ③ 纯插入（前为空）
  设 块三 为 绳计算块差异("g", "", "new line")
  断言相等(长度(块三), 1, "插入块数")
  断言相等(块三[0]["旧文本"], "", "插入旧空")
  断言相等(块三[0]["新文本"], "new line", "插入新")

  # ④ 完全相同 → 空块表
  断言相等(长度(绳计算块差异("h", "same", "same")), 0, "相同为空")

  # ⑤ 解析写参数：合法返回；空路径抛错
  设 解析 为 绳解析写参数("p.txt", "hi")
  断言相等(解析["路径"], "p.txt", "解析路径")
  断言相等(解析["内容"], "hi", "解析内容")
  尝试:
    绳解析写参数("", "x")
    抛出 新建 错误("应为抛错: 空路径未抛 [NO_THROW]")
  捕获 异常 为 e:
    断言为真(字符串包含(转字符串(e), "file_path"), "空路径错误信息")

  # ⑥ 格式化写输出
  设 创 为 绳格式化写输出("/a/b", "create")
  断言为真(字符串包含(创, "Created"), "创建动词")
  设 更 为 绳格式化写输出("/a/b", "update")
  断言为真(字符串包含(更, "Updated"), "更新动词")
  断言为真(字符串包含(更, "<path>/a/b</path>"), "路径元素")

主()
写 "test_R85_E_工具.diff PASS"
