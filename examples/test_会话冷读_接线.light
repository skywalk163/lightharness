# test_会话冷读_接线.light —— 第6轮 任务E #277 会话冷读接线 判据
# 运行：python 运行.py examples/test_会话冷读_接线.light
# 判据：冷读列出会话（总入口.列出会话 布局真读）+ 接线冷读会话文件（会话存储文件面）；
#       纯逻辑回归绿由 test_会话冷读.light 承担。

从 会话冷读 导入 冷读列出会话, 接线冷读会话文件
从 会话持久化JSONL 导入 生成行序列
从 文件系统 导入 创建目录, 写入文件, 读取文件
从 会话存储 导入 会话存储
导入 shutil

段落 清场(路径):
  尝试:
    shutil.rmtree(路径, 真)
  捕获 错误:
    设 占 为 真

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 造日志文本(会话标识):
  设 头 为 {"type": "session", "version": {"major": 3, "minor": 0}, "id": 会话标识, "createdAt": 0, "cwd": "/w", "isSeeded": 假, "delegationDepth": 0}
  设 事件 为 {"种类": "user/message", "序号": 0, "时间": 0, "数据": {"文本": "你好"}}
  设 行表 为 生成行序列(头, 0, [事件])
  设 文本 为 ""
  遍历 行 之 行表:
    设 文本 为 文本 + 行
  返回 文本

段落 主:
  清场("tmp_r6e_冷读根")
  清场("tmp_r6e_存储根")
  # ---- 1. 冷读列出会话：按 冷读会话日志 布局（根/<工作目录投影>/<标识>/session.jsonl）----
  # 探针实证：日志路径 = 根\--proj--\标识\session.jsonl（工作目录 proj 投影为 --proj--）
  设 根 为 "tmp_r6e_冷读根"
  创建目录(根 + "/--proj--/sess-a")
  写入文件(根 + "/--proj--/sess-a/session.jsonl", 造日志文本("sess-a"))
  创建目录(根 + "/--proj--/sess-b")
  写入文件(根 + "/--proj--/sess-b/session.jsonl", 造日志文本("sess-b"))
  设 清单 为 冷读列出会话(根)
  断言相等(列表长度(清单), 2, "1a 两个会话")
  断言相等(清单[0]["会话"], "sess-a", "1b 会话名")
  断言相等(清单[0]["事件数"], 1, "1c 冷读事件数")

  # ---- 2. 坏会话不中断列举 ----
  创建目录(根 + "/--proj--/sess-c")
  写入文件(根 + "/--proj--/sess-c/session.jsonl", "不是JSON")
  设 清单2 为 冷读列出会话(根)
  断言相等(列表长度(清单2), 3, "2a 坏会话也列出")
  断言真(开头(清单2[2]["事件状态"], "读失败"), "2b 读失败状态")

  # ---- 3. 接线冷读会话文件：直接读 JSONL 文本 ----
  设 文件结果 为 接线冷读会话文件(根 + "/--proj--/sess-a/session.jsonl")
  断言相等(文件结果["事件数"], 2, "3a 行数=头+事件")
  断言相等(文件结果["事件状态"], "ok", "3b 状态")

  # ---- 4. 会话存储 文件面：真建存储 → 写会话 → 接线冷读读回 ----
  设 存储 为 新建 会话存储("tmp_r6e_存储根")
  设 元数据 为 存储.新建会话("测试标题")
  设 标识 为 元数据["id"]
  设 头 为 {"type": "session", "version": {"major": 3, "minor": 0}, "id": 标识, "createdAt": 0, "cwd": "/w", "isSeeded": 假, "delegationDepth": 0}
  设 事件 为 {"种类": "user/message", "序号": 0, "时间": 0, "数据": {"文本": "hi"}}
  设 行表 为 生成行序列(头, 0, [事件])
  设 文本 为 ""
  遍历 行 之 行表:
    设 文本 为 文本 + 行
  写入文件(存储.取会话文件(标识), 文本)
  设 文件结果2 为 接线冷读会话文件(存储.取会话文件(标识))
  断言相等(文件结果2["事件数"], 2, "4a 存储文件可冷读")

  打印 "--- 第6轮 任务E #277 会话冷读接线 测试通过 ---"

主()