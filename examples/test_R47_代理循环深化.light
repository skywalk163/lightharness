# test_R47_代理循环深化.light —— 第47轮 任务2（#7 请求头四原因 + 暂停恢复 + 轮次驱动粘滞）
#
# 运行：cd lightharness && python 运行.py examples/test_R47_代理循环深化.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖（纯决策面，不接真实事件总线/真实LLM——R40/R43 已接真）：
#   - 请求头四原因：initial/resume/change/series 判定序列（对齐上游 agent.ts:570-581）
#     · 首请求无基线 → initial；首请求有基线（进程重启/fork）→ resume
#     · 后续头变 → change（系列边界携带 startsSeries）；头同+系列边界 → series；头同无边界 → 不记录
#     · 头相等深比较（嵌套 config/tools）
#   - 相位机暂停恢复：running 可暂停/idle 拒绝；fold 折算；闩锁唤醒收敛重放
#   - 轮次驱动：max-tokens 粘滞（completed 不得降级）；无终结续跑；有终结+待办续跑；有终结+无待办跳出
#
# 命名避坑：本文件断言助手用 局部 段落名 检相等/检真，避开与 代理循环 导出段同名冲突。

从 代理循环 导入 请求头原因表, 步骤终因表, 相位表, 循环请求头原因, 循头相等
从 代理循环 导入 循建相位机, 循相位可转, 循相位转, 循暂停决策, 循折算状态, 循恢复决策
从 代理循环 导入 循请求唤醒, 循相位收敛, 循终因合并, 循轮次续跑

段落 检相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

段落 主:
  # ============ 0) 常量表形状 ============
  检相等(请求头原因表, ["initial", "resume", "change", "series"], "请求头四原因表")
  检相等(步骤终因表, ["completed", "max-tokens"], "步骤终因表")
  检相等(相位表, ["idle", "running", "maintenance"], "相位表")

  # ============ 1) 请求头四原因判定序列（对齐 agent.ts:570-581）============
  # 1a. 循环实例首请求 + 日志无基线 → initial
  设 决 为 循环请求头原因(假, 假, 假, 假)
  检相等(决["原因"], "initial", "四原因_首请求无基线_initial")
  检真(决["记录"], "四原因_initial记录")

  # 1b. 循环实例首请求 + 日志已有头事件（进程重启/fork 种子）→ resume
  设 决 为 循环请求头原因(假, 真, 假, 假)
  检相等(决["原因"], "resume", "四原因_首请求有基线_resume")

  # 1c. 已登记 + 头变化 → change；系列边界携带 开始系列
  设 决 为 循环请求头原因(真, 真, 真, 真)
  检相等(决["原因"], "change", "四原因_头变_change")
  检真(决["开始系列"], "四原因_change携带开始系列")

  # 1c2. 已登记 + 头变化 + 无系列边界 → change 不携带开始系列
  设 决 为 循环请求头原因(真, 真, 真, 假)
  检相等(决["原因"], "change", "四原因_头变无边界_change")
  检真(决["开始系列"] == 假, "四原因_change无边界不带系列")

  # 1d. 已登记 + 头相同 + 系列边界 → series
  设 决 为 循环请求头原因(真, 真, 假, 真)
  检相等(决["原因"], "series", "四原因_头同有边界_series")

  # 1e. 已登记 + 头相同 + 无系列边界 → 不记录（上游不追加 header 事件）
  设 决 为 循环请求头原因(真, 真, 假, 假)
  检相等(决["原因"], 空, "四原因_头同无边界_不记录")
  检真(决["记录"] == 假, "四原因_不记录标志")

  # 1f. 头相等深比较：嵌套 config/tools 变与不变
  设 头甲 为 ["config": ["model": "deepseek-flash", "temperature": 0.7], "tools": [["name": "bash"]]]
  设 头乙 为 ["config": ["model": "deepseek-flash", "temperature": 0.7], "tools": [["name": "bash"]]]
  设 头丙 为 ["config": ["model": "deepseek-v4-pro", "temperature": 0.7], "tools": [["name": "bash"]]]
  检真(循头相等(头甲, 头乙), "头相等_嵌套同构")
  检真(循头相等(头甲, 头丙) == 假, "头相等_模型不同即变")
  # 头变 → change；头同 → series（组合验证）
  检相等(循环请求头原因(真, 真, 循头相等(头甲, 头丙) == 假, 假)["原因"], "change", "组合_头变判change")
  检相等(循环请求头原因(真, 真, 循头相等(头甲, 头乙) == 假, 真)["原因"], "series", "组合_头同判series")

  # ============ 2) 相位机：暂停恢复纯决策面 ============
  # 2a. idle → running；running 可暂停；idle/maintenance 拒绝暂停
  设 相位 为 循建相位机(7)
  检相等(相位["相态"], "idle", "相位机_初始idle")
  检相等(相位["上轮次"], 7, "相位机_上轮次携带")
  循相位转(相位, "running")
  设 停 为 循暂停决策(相位)
  检真(停["可暂停"], "暂停_running可暂停")
  检相等(停["动作"], "挂起", "暂停_running动作")
  设 停2 为 循暂停决策(循建相位机(0))
  检真(停2["可暂停"] == 假, "暂停_idle拒绝")
  循相位转(相位, "idle")
  循相位转(相位, "maintenance")
  设 停3 为 循暂停决策(相位)
  检真(停3["可暂停"] == 假, "暂停_maintenance拒绝")

  # 2b. fold 折算：暂停瞬间折算为快照
  循相位转(相位, "idle")
  循相位转(相位, "running")
  设 快照 为 循折算状态(相位)
  检相等(快照["相态"], "running", "折算_相态")
  检相等(快照["上轮次"], 7, "折算_上轮次")

  # 2c. 唤醒闩锁：非 idle 闩待唤；收敛重放；idle 直接开跑
  设 闩 为 循请求唤醒(相位)
  检真(闩["已闩锁"], "唤醒_running闩锁")
  检真(相位["待唤"], "唤醒_待唤标志置位")
  设 收 为 循相位收敛(相位)
  检相等(收["相态"], "idle", "收敛_回idle")
  检真(收["重放唤醒"], "收敛_重放待唤")
  检真(相位["待唤"] == 假, "收敛_闩已清")
  设 直 为 循请求唤醒(循建相位机(0))
  检真(直["已闩锁"] == 假, "唤醒_idle直接开跑")

  # 2d. 恢复决策：忙 / 续跑 / 待机
  设 恢复机 为 循建相位机(2)
  设 折算空 为 循折算状态(恢复机)
  检相等(循恢复决策(恢复机, 折算空, 假)["动作"], "待机", "恢复_idle无待办_待机")
  检相等(循恢复决策(恢复机, 折算空, 真)["动作"], "续跑", "恢复_idle有待办_续跑")
  循相位转(恢复机, "running")
  检相等(循恢复决策(恢复机, 折算空, 真)["动作"], "忙", "恢复_running_忙")
  检真(循恢复决策(恢复机, 折算空, 真)["可恢复"] == 假, "恢复_忙不可恢复")
  # 折算带待唤 → idle 也续跑
  循相位转(恢复机, "idle")
  设 折算闩 为 ["相态": "running", "上轮次": 2, "待唤": 真]
  检相等(循恢复决策(恢复机, 折算闩, 假)["动作"], "续跑", "恢复_折算待唤_续跑")

  # 2e. 非法转换拒收
  设 守卫机 为 循建相位机(0)
  循相位转(守卫机, "maintenance")
  设 抛错数 为 0
  尝试:
    循相位转(守卫机, "running")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "相位_maintenance不可直达running")

  # ============ 3) 轮次驱动：粘滞 + 续跑判定 ============
  # 3a. max-tokens 粘滞：触顶后 completed 不得降级
  检相等(循终因合并(空, "completed"), "completed", "终因_首步completed")
  检相等(循终因合并(空, "max-tokens"), "max-tokens", "终因_首步触顶")
  检相等(循终因合并("max-tokens", "completed"), "max-tokens", "终因_粘滞不降级")
  检相等(循终因合并("max-tokens", "max-tokens"), "max-tokens", "终因_连续触顶")

  # 3b. 轮次续跑判定
  检真(循轮次续跑(空, 假), "续跑_无终结恒续跑")
  检真(循轮次续跑("completed", 真), "续跑_有终结有待办")
  检真(循轮次续跑("max-tokens", 真), "续跑_触顶有待办")
  检真(循轮次续跑("completed", 假) == 假, "续跑_有终结无待办跳出")

  # 3c. 未知步骤终因拒收
  设 抛错数2 为 0
  尝试:
    循终因合并(空, "aborted")
  捕获 异常 为 e:
    设 抛错数2 为 抛错数2 + 1
  检相等(抛错数2, 1, "终因_未知步骤终因抛错")

  打印 "R47 代理循环深化：四原因映射/暂停恢复/轮次驱动粘滞 全部通过"

主()
