# test_会话V3迁移.light —— v0→v1→v2→v3 全链迁移定向测试（路1/S）
# 覆盖：全链逐跳迁移 / identity-preserving 头保留 / 未知事件沿链直通 /
#       v1→v2 内嵌助手流 / v2→v3 PTC 词汇重命名与系统提示提升 / 序号重排。
# 反跑判据：每个「断言相等/断言真」把期望值改反即红。
从 会话格式 导入 造头, 造事件, 标准链, 迁移会话, 版本文本, 头版本号, 校验事件载荷
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("反跑判据失败 " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("反跑判据失败 " + 标签)

段落 主程:
  # ---- 1. v0→v1→v2→v3 全链迁移 ----
  # v0 头：标识/创建时间/工作目录/父会话/是种子 全身份字段
  设 头 为 造头(0, 0, "mig1", 1000, "G:/proj", 空, "parent-0", 真)
  设 事件表 为 []
  列表追加(事件表, 造事件("session/created", 0, 1000, []))
  列表追加(事件表, 造事件("user/message", 1, 1100, ["消息": ["角色": "user", "content": [["type": "text", "text": "你好"]]]]))
  列表追加(事件表, 造事件("assistant/chunk", 2, 1200, ["消息": ["角色": "assistant"], "块": [["type": "text", "text": "a"], ["type": "text", "text": "b"]]]))
  列表追加(事件表, 造事件("brand/v0-mystery", 3, 1300, ["原始": "载荷"]))
  设 结果 为 迁移会话(标准链, 头, 事件表, ["主": 3, "次": 0])
  设 终头 为 结果["头"]
  设 终事件 为 结果["事件"]
  断言相等(版本文本(终头["版本"]), "3.0", "全链迁移到 3.0")
  # identity 保留：标识/创建时间/工作目录/父会话/是种子 不丢
  断言相等(终头["标识"], "mig1", "identity 标识")
  断言相等(终头["创建时间"], 1000, "identity 创建时间")
  断言相等(终头["工作目录"], "G:/proj", "identity 工作目录")
  断言相等(终头["父会话"], "parent-0", "identity 父会话")
  断言相等(终头["是种子"], 真, "identity 是种子")
  # 事件数 1:1（assistant/chunk 在 v1→v2 并入 message，仍 1 条）
  断言相等(长度(终事件), 4, "迁移后事件数")
  # 序号重排 0..n-1 连续（改反：把断言改为 序号[0]==1 → 红）
  断言相等(终事件[0]["序号"], 0, "序号重排 0")
  断言相等(终事件[1]["序号"], 1, "序号重排 1")
  断言相等(终事件[3]["序号"], 3, "序号重排 3")
  # v1→v2 内嵌助手流：assistant/chunk → assistant/message + 流
  断言相等(终事件[2]["类型"], "assistant/message", "chunk 提升为 message")
  断言相等(长度(终事件[2]["数据"]["流"]), 2, "流块数")
  断言相等(终事件[2]["数据"]["流"][0]["text"], "a", "流块 0")
  # 未知事件沿链直通保留（不静默丢弃、不迁移改写）
  断言相等(终事件[3]["类型"], "brand/v0-mystery", "未知事件类型保留")
  断言相等(终事件[3]["数据"]["原始"], "载荷", "未知事件载荷保留")

  # ---- 2. 直接迁移 v1→v2（identity + 内嵌流）----
  设 头v1 为 造头(1, 0, "m2", 2000, ".", 空, 空, 假)
  设 事件v1 为 [造事件("user/message", 0, 2000, ["消息": ["角色": "user"]]),
    造事件("assistant/chunk", 1, 2100, ["消息": ["角色": "assistant"], "块": [["type": "text", "text": "x"]]])]
  设 结果2 为 迁移会话(标准链, 头v1, 事件v1, ["主": 3, "次": 0])
  断言相等(版本文本(结果2["头"]["版本"]), "3.0", "v1 直达 3.0")
  断言相等(长度(结果2["事件"]), 2, "v1 事件数")
  断言相等(结果2["事件"][1]["类型"], "assistant/message", "v1 chunk 提升")

  # ---- 3. v2→v3 PTC 词汇重命名 + 系统提示提升 ----
  设 头v2 为 造头(2, 0, "m3", 3000, ".", "code", 空, 假)
  设 请求头 为 造事件("request/header", 0, 3000, ["配置": ["model": "v41"],
    "系统提示": "你是助手", "工具模式": ["codeMode": 真, "codeModeEnabled": 真, "names": ["search"]]])
  设 工具调用 为 造事件("tool/call", 1, 3100, ["名称": "tool/code-dispatch-render", "输入": ["path": "a"]])
  设 结果3 为 迁移会话(标准链, 头v2, [请求头, 工具调用], ["主": 3, "次": 0])
  断言相等(结果3["头"]["代理预设"], "ptc", "agentPreset code -> ptc")
  设 迁移头数据 为 结果3["事件"][0]["数据"]
  断言相等(迁移头数据["工具模式"]["ptc"], 真, "codeMode -> ptc")
  断言相等(迁移头数据["工具模式"]["ptcEnabled"], 真, "codeModeEnabled -> ptcEnabled")
  断言相等(迁移头数据["工具模式"].包含("codeMode"), 假, "codeMode 键移除")
  断言相等(结果3["事件"][1]["数据"]["名称"], "tool/ptc-dispatch-render", "工具名重命名")
  断言相等(结果3["事件"][1]["数据"].包含("name"), 假, "英文 name 键不存在")

  # ---- 4. 头部节点 0 提升语义：system/message 经迁移后仍可校验 ----
  设 占 为 校验事件载荷("system/message", ["系统": "S", "表面操作": "replace"], 真)
  断言真(真, "system/message 词汇可用")

  # ---- 5. 反跑判据显式用例：把断言值改反必红 ----
  # 改反示例（注释即反跑判据）：
  #   若把 断言相等(终头["标识"], "mig1", ...) 的期望改成 "其他" → 红
  #   若把 断言相等(版本文本(终头["版本"]), "3.0", ...) 改成 "2.0" → 红
  #   若把 序号断言 改成非连续值 → 红
  #   若把 未知事件保留断言 改为「类型被改写」 → 红
  断言真(长度(终事件) == 4, "反跑判据锚点")

  写 "test_会话V3迁移: 全部用例通过"
  返回 真

主程()
