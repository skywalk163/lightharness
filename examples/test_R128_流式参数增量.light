# R128 C 线：流式参数「增量语义」回归（R126-B2 纯函数版 → R128 状态句柄增量版）
# 对标 packages/util/values/src/partial-json.ts（上游 dsh-v0.2.1-alpha.1，commit 5badb15009 666 行）
#
# 核心判据：**增量调用序列的最终结果 ≡ 全量重扫结果**，且**跨调用不重扫已消费前缀**
#   （可观测：状态["已读"] = #consumed 只增不回头；状态["步计"] 累计步进次数与全量重扫相等，
#    远小于「每次追加都全量重扫」的朴素基线）。
#
# 对拍组（≥5）：
#   组1 完整 JSON 分段追加 → 视图全等对拍
#   组2 残缺串分段追加 → 每一步「流式串文 ≡ 参数字符串前缀(当前前缀)」
#   组3 转义引号被切在反斜杠处（跨段转义挂起记忆）
#   组4 嵌套容器分段追加 → 每步键表对拍 + 最终视图对拍
#   组5 超长文本分段追加 → 最终视图对拍 + 位移/步计对拍（增量 vs 全量 vs 朴素重扫）
# 语义组：
#   组6 complete 携带此前内容读发现的内容错（降级登记 3 闭环）
#   组7 reads 记忆层：refresh 变更检测 + length step 粒度（降级登记 2 闭环）
#   组8 stringExceeds 限长判据
#   组9 settle（定着）：就地密闭 / 不匹配另起 / 密闭后追加抛错（降级登记 1 闭环）

从 流式参数 导入 参数键表 参数字段完整 参数字符串前缀 参数字符串长度 参数值 残缺参数视图 扫描顶层
从 流式参数 导入 流式扫描器 流式追加 流式定着 流式扫描 流式进度
从 流式参数 导入 流式键表 流式含字段 流式字段完整 流式串文 流式串前缀 流式串长度 流式串超限
从 流式参数 导入 流式值 流式闭合 流式无效 流式刷新 流式视图

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 信息 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(值, 信息):
  如果 值 == 假:
    抛出 新建 错误("断言失败[" + 信息 + "]：期望真，实际=" + 转字符串(值))

段落 断言为假(值, 信息):
  如果 值 == 真:
    抛出 新建 错误("断言失败[" + 信息 + "]：期望假，实际=" + 转字符串(值))

# 把全文按固定宽度切成若干段（模拟流式分片）
段落 切段(全文, 宽):
  设 段表 为 []
  设 i 为 0
  当 i < 字符串长度(全文):
    设 止 为 i + 宽
    如果 止 > 字符串长度(全文):
      设 止 为 字符串长度(全文)
    列表追加(段表, 截取(全文, i, 止))
    设 i 为 止
  返回 段表

# 视图全等对拍：键表/字段表/闭合/无效 四项
段落 断言视图相等(增量视, 全量视, 信息):
  断言相等(增量视["键表"], 全量视["键表"], 信息 + " 键表")
  断言相等(增量视["字段表"], 全量视["字段表"], 信息 + " 字段表")
  断言相等(增量视["闭合"], 全量视["闭合"], 信息 + " 闭合")
  断言相等(增量视["无效"], 全量视["无效"], 信息 + " 无效")

段落 主:
  设 反斜杠 为 "\\"

  # ══ 组1：完整 JSON 分段追加 → 视图全等对拍 ══
  设 全文1 为 " { \"名\" : 123 , \"表\" : [ 1 , 2 ] , \"串\" : \"甲乙\" } "
  设 状态1 为 流式扫描器()
  设 前缀1 为 ""
  遍历 段 之 切段(全文1, 7):
    流式追加(状态1, 段)
    设 前缀1 为 前缀1 + 段
    # 每步：键表与闭合状态都应与「对当前前缀全量重扫」一致
    断言相等(流式键表(状态1), 参数键表(前缀1), "组1 逐步键表")
    设 全量视 为 残缺参数视图(前缀1)
    断言相等(流式闭合(状态1), 全量视["闭合"], "组1 逐步闭合")
  断言视图相等(流式视图(状态1), 残缺参数视图(全文1), "组1 最终视图")
  设 进1 为 流式进度(状态1)
  设 全1 为 扫描顶层(全文1)
  断言相等(进1["已读"], 全1["已读"], "组1 增量位移等于全量位移")
  断言相等(进1["步计"], 全1["步计"], "组1 增量步计等于全量步计")

  # ══ 组2：残缺串分段追加 → 每步前缀对拍（增量读 ≡ 全量重扫读） ══
  设 全文2 为 "{\"a\":\"hello world\",\"b\":42}"
  设 状态2 为 流式扫描器()
  设 前缀2 为 ""
  遍历 段 之 切段(全文2, 5):
    流式追加(状态2, 段)
    设 前缀2 为 前缀2 + 段
    断言相等(流式串文(状态2, "a"), 参数字符串前缀(前缀2, "a"), "组2 逐步串文")
    断言相等(流式串长度(状态2, "a"), 参数字符串长度(前缀2, "a"), "组2 逐步串长")
    断言相等(流式值(状态2, "b"), 参数值(前缀2, "b"), "组2 逐步值")
    断言相等(流式字段完整(状态2, "a"), 参数字段完整(前缀2, "a"), "组2 逐步完整")
  断言视图相等(流式视图(状态2), 残缺参数视图(全文2), "组2 最终视图")

  # ══ 组3：转义引号被切在反斜杠处（跨段转义挂起记忆） ══
  # 切点正好落在反斜杠之后：第一段以悬空反斜杠结尾，第二段以被转义的引号开头。
  设 全文3 为 "{\"a\":\"he" + 反斜杠 + "\"llo\",\"b\":2}"
  设 状态3 为 流式扫描器()
  流式追加(状态3, "{\"a\":\"he" + 反斜杠)
  断言相等(流式串文(状态3, "a"), "he", "组3 悬空转义处先读到有效前缀")
  断言为假(流式字段完整(状态3, "a"), "组3 串未闭")
  流式追加(状态3, "\"llo\",\"b\":2}")
  断言相等(流式串文(状态3, "a"), "he\"llo", "组3 跨段转义引号不截断")
  断言相等(流式串文(状态3, "a"), 参数字符串前缀(全文3, "a"), "组3 增量串文等于全量")
  断言视图相等(流式视图(状态3), 残缺参数视图(全文3), "组3 最终视图")
  # 反例：不切在转义处（按 4 字宽）也应等价
  设 状态3b 为 流式扫描器()
  遍历 段 之 切段(全文3, 4):
    流式追加(状态3b, 段)
  断言视图相等(流式视图(状态3b), 残缺参数视图(全文3), "组3b 常规切分视图")

  # ══ 组4：嵌套容器分段追加 → 每步键表对拍 + 最终视图对拍 ══
  设 全文4 为 "{\"a\":{\"b\":[1,2,{\"c\":\"xy\"}]},\"d\":true,\"e\":null}"
  设 状态4 为 流式扫描器()
  设 前缀4 为 ""
  遍历 段 之 切段(全文4, 6):
    流式追加(状态4, 段)
    设 前缀4 为 前缀4 + 段
    断言相等(流式键表(状态4), 参数键表(前缀4), "组4 逐步键表")
    断言相等(流式含字段(状态4, "a"), 字典包含键(残缺参数视图(前缀4)["键表"], "a"), "组4 逐步含字段")
  断言视图相等(流式视图(状态4), 残缺参数视图(全文4), "组4 最终视图")
  设 视4 为 流式视图(状态4)
  断言相等(视4["字段表"]["a"]["b"][2]["c"], "xy", "组4 嵌套深层串")
  断言相等(视4["字段表"]["d"], 真, "组4 布尔值")
  断言相等(视4["字段表"]["e"], 空, "组4 null 值")

  # ══ 组5：超长文本分段追加 → 位移 / 步计 / 视图 三重对拍 ══
  设 长体 为 ""
  设 k 为 0
  当 k < 300:
    设 长体 为 长体 + "字串段落0123456789"
    设 k 为 k + 1
  设 全文5 为 "{\"a\":\"" + 长体 + "\",\"b\":7}"
  设 状态5 为 流式扫描器()
  设 前缀5 为 ""
  设 朴素步计 为 0
  设 朴素已读 为 0
  遍历 段 之 切段(全文5, 100):
    流式追加(状态5, 段)
    设 前缀5 为 前缀5 + 段
    # 每步都触发一次读（强制续扫），模拟真实流式消费
    流式键表(状态5)
    流式串文(状态5, "a")
    # 朴素基线：同一前缀「从零全量重扫」的步计/位移累加
    设 朴扫 为 扫描顶层(前缀5)
    设 朴素步计 为 朴素步计 + 朴扫["步计"]
    设 朴素已读 为 朴素已读 + 朴扫["已读"]
  设 进5 为 流式进度(状态5)
  设 全扫5 为 扫描顶层(全文5)
  断言相等(进5["已读"], 字符串长度(全文5), "组5 增量已消费位移等于全文长")
  断言相等(进5["步计"], 全扫5["步计"], "组5 增量步计等于全量步计")
  断言为真(朴素步计 > 进5["步计"] * 5, "组5 朴素重扫步计远大于增量步计")
  断言为真(朴素已读 > 进5["已读"] * 5, "组5 朴素重扫位移远大于增量位移（跨调用不重扫）")
  断言视图相等(流式视图(状态5), 残缺参数视图(全文5), "组5 最终视图")

  # ══ 组6：complete 携带此前内容读发现的内容错（降级登记 3） ══
  设 文6 为 "{\"a\":\"ok" + 反斜杠 + "u12zz\"}"
  设 状态6 为 流式扫描器()
  流式追加(状态6, 文6)
  断言为真(流式字段完整(状态6, "a"), "组6 未读内容时完整为真（只判边界）")
  断言相等(流式串文(状态6, "a"), "ok", "组6 内容读保留有效前缀")
  断言为假(流式字段完整(状态6, "a"), "组6 内容错被完整判定记忆")
  断言为真(流式无效(状态6), "组6 流式无效含内容错（对齐上游 invalid）")
  断言为假(流式视图(状态6)["无效"], "组6 视图无效仍只报结构错（降级登记 6）")
  断言为假(字典包含键(流式视图(状态6)["字段表"], "a"), "组6 错串不进字段表")
  # 纯函数层每次新开状态，不共享记忆 → 仍只判边界（与 R126 判据 9 同口径）
  断言为真(参数字段完整(文6, "a"), "组6 纯函数层完整只判边界")

  # ══ 组7：reads 记忆层 —— 刷新变更检测 + length step 粒度（降级登记 2） ══
  设 状态7 为 流式扫描器()
  流式追加(状态7, "{\"a\":\"abc")
  断言相等(流式串长度(状态7, "a", 5, 0), 3, "组7 首读长度")
  断言为假(流式刷新(状态7), "组7 无新文本时刷新报无变化")
  流式追加(状态7, "defgh")
  断言为真(流式刷新(状态7), "组7 长度跨越 step 粒度 → 报变化")
  断言相等(流式串长度(状态7, "a", 5, 0), 8, "组7 续读长度")

  # 粒度吸收：step=10 时 3→8 仍在同一格，刷新不应报变化
  设 状态7b 为 流式扫描器()
  流式追加(状态7b, "{\"a\":\"abc")
  断言相等(流式串长度(状态7b, "a", 10, 0), 3, "组7b 首读长度")
  断言为假(流式刷新(状态7b), "组7b 首刷无变化")
  流式追加(状态7b, "defgh")
  断言为假(流式刷新(状态7b), "组7b step=10 粒度吸收 → 仍无变化")
  流式追加(状态7b, "ijklm")
  断言为真(流式刷新(状态7b), "组7b 长度 13 越过 10 格 → 报变化")

  # keys 读的变更检测（比较值 = 键表长度）
  设 状态7c 为 流式扫描器()
  流式追加(状态7c, "{\"a\":1")
  断言相等(流式键表(状态7c), ["a"], "组7c 首读键表")
  断言为假(流式刷新(状态7c), "组7c 无新文本无变化")
  流式追加(状态7c, ",\"b\":2")
  断言为真(流式刷新(状态7c), "组7c 新键出现 → 报变化")
  断言相等(流式键表(状态7c), ["a", "b"], "组7c 键表已长")

  # ══ 组8：stringExceeds 限长判据 ══
  设 状态8 为 流式扫描器()
  流式追加(状态8, "{\"a\":\"ab")
  断言为假(流式串超限(状态8, "a", 4), "组8 未达上限")
  流式追加(状态8, "cdef")
  断言为真(流式串超限(状态8, "a", 4), "组8 已超上限")
  断言为假(流式串超限(状态8, "a", 100), "组8 限长放宽后不超")
  # 前缀读：限长 prefix 与全量重扫的截取一致
  设 全文8b 为 "{\"a\":\"abcdefghij\"}"
  设 状态8b 为 流式扫描器()
  遍历 段 之 切段(全文8b, 3):
    流式追加(状态8b, 段)
  断言相等(流式串前缀(状态8b, "a", 4), "abcd", "组8b 限长前缀")
  断言相等(流式串前缀(状态8b, "a", 4), 截取(参数字符串前缀(全文8b, "a"), 0, 4), "组8b 限长前缀等于全量截取")

  # ══ 组9：settle（定着）—— 就地密闭 / 不匹配另起 / 密闭后追加抛错 ══
  设 状态9 为 流式扫描器()
  流式追加(状态9, "{\"a\":")
  流式追加(状态9, "1}")
  设 定9 为 流式定着(状态9, "{\"a\":1}")
  断言为真(定9["密闭"], "组9 定着后密闭")
  断言相等(定9["块"], ["{\"a\":1}"], "组9 定着后并为单段")
  断言相等(流式值(定9, "a"), 1, "组9 定着后仍可读")
  断言为假(流式刷新(定9), "组9 密闭后读表清空，刷新恒假")
  设 抛了 为 假
  尝试:
    流式追加(定9, "x")
  捕获 错误:
    设 抛了 为 真
  断言为真(抛了, "组9 密闭后追加抛错")
  # 定着文本与已收分片不符 → 另起密闭视图（缓存不复用）
  设 状态9b 为 流式扫描器()
  流式追加(状态9b, "{\"a\":")
  设 定9b 为 流式定着(状态9b, "{\"b\":2}")
  断言为真(定9b["密闭"], "组9b 不匹配时另起密闭视图")
  断言相等(流式视图(定9b)["字段表"], {"b": 2}, "组9b 另起视图按新文本解析")
  # 定着后可继续读全文（含此前未扫完的部分）
  设 状态9c 为 流式扫描器()
  流式追加(状态9c, "{\"a\":\"xy")
  设 定9c 为 流式定着(状态9c, "{\"a\":\"xyz\"}")
  断言相等(流式串文(定9c, "a"), "xyz", "组9c 定着后续读补齐")

  打印 "test_R128_流式参数增量 PASS"

主()
