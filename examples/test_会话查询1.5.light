# test_会话查询1.5.light —— 第5轮任务4 会话查询新能力测试（#36）
#
# 覆盖（每判据组含反跑点，改反即红）：
#   1) 抽取事件文本（对齐 extraction.ts）：user/message、assistant/message（内嵌流
#      合并后文本）、tool/call、tool/result、todo/write 各至少 1 例；
#      请求信封/结构化边界（request/header、turn/start、assistant/attempt）→ 空文本。
#      反跑：把 user/message 抽取断言改空 → 红
#   2) 表面三分类（对齐 documents.ts + foldSurface）：构造 system/message append +
#      user/message + system/message replace 序列 → seq0 shadowed、其余 current；
#      纯非表面事件 → log-only。
#      反跑：把 shadowed 断言改 current → 红
#   3) 血缘追踪（对齐 tracing.ts）：父子孙三代会话 → 祖先链/根/complete/后代树；
#      循环父 → 抛错；目标缺失 → 抛错。
#   4) 头兼容（对齐 sources.ts）：六字段全等通过；任一字段不等 → 抛错。
#      反跑：把时间不等抛错改为放行 → 红
#   5) 逻辑语料（对齐 corpus.ts 纯逻辑面）：合并存活/持久 → 排序与 live/persisted 标记；
#      同 id 头冲突 → 抛错。
#
# 运行：python 运行.py examples/test_会话查询1.5.light

从 会话查询 导入 抽取事件文本, 折叠表面, 分析事件日志, 构建事件记录, 构建事件搜索文档, 校验头兼容, 追踪事件, 追踪会话, 合并会话记录, 解析会话语料, 解析逻辑会话
从 消息 导入 造文本块, 造助手消息, 造用户消息, 造工具结果消息, 造工具调用块
从 会话 导入 新建会话

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

# 事件构造辅助（序号即时间，简化断言）
段落 造事件(序号, 类型, 数据):
  返回 ["类型": 类型, "序号": 序号, "时间": 序号, "数据": 数据]

# ============ 1) 抽取 ============
段落 测试抽取:
  # user/message：数据为消息本体
  设 用户事件 为 造事件(0, "user/message", 造用户消息([造文本块("今天天气如何")]))
  断言相等(抽取事件文本(用户事件), "今天天气如何", "user 文本抽取")  # 反跑：改反 → 红
  # assistant/message：内嵌流合并后文本
  设 助手事件 为 造事件(1, "assistant/message", ["消息": 造助手消息([造文本块("天气晴朗")], "deepseek", "m"), "流": [造文本块("适合出行")]])
  断言相等(抽取事件文本(助手事件), "天气晴朗\n适合出行", "assistant 内嵌流合并抽取")  # 反跑：改反 → 红
  # tool/call：名称 + 输入
  设 调用事件 为 造事件(2, "tool/call", ["名称": "bash", "输入": "echo hi"])
  断言相等(抽取事件文本(调用事件), "bash\necho hi", "tool/call 抽取")
  # tool/result：消息文本 + 错误
  设 结果事件 为 造事件(3, "tool/result", ["消息": 造工具结果消息("c1", [造文本块("hi")], 假), "成功": 真])
  断言相等(抽取事件文本(结果事件), "hi", "tool/result 文本抽取")
  # todo/write：项表 状态+内容
  设 待办事件 为 造事件(4, "todo/write", ["项表": [["状态": "in_progress", "内容": "任务一"], ["状态": "done", "内容": "任务二"]]])
  断言相等(抽取事件文本(待办事件), "in_progress\n任务一\ndone\n任务二", "todo/write 抽取")
  # 结构化边界/请求信封 → 空文本
  设 头事件 为 造事件(5, "request/header", ["配置": ["model": "deepseek"]])
  断言相等(抽取事件文本(头事件), "", "request/header 空文本")
  设 轮始事件 为 造事件(6, "turn/start", [])
  断言相等(抽取事件文本(轮始事件), "", "turn/start 空文本")
  设 尝试事件 为 造事件(7, "assistant/attempt", ["消息": ["标识": "x", "content": [造文本块("草稿")]]])
  断言相等(抽取事件文本(尝试事件), "", "assistant/attempt 空文本")

# ============ 2) 表面三分类 ============
段落 测试表面分类:
  # append 节点0 + user + replace 节点0 → seq0 shadowed、seq1/seq2 current
  设 系统甲 为 造事件(0, "system/message", ["系统": "提示A", "表面操作": "append"])
  设 用户 为 造事件(1, "user/message", 造用户消息([造文本块("问题")]))
  设 系统乙 为 造事件(2, "system/message", ["系统": "提示B", "表面操作": "replace"])
  设 记录表 为 构建事件记录("会话A", [系统甲, 用户, 系统乙])
  断言相等(记录表[0]["表面"], "shadowed", "replace 后旧节点 shadowed")  # 反跑：改反 → 红
  断言相等(记录表[1]["表面"], "current", "append 消息 current")
  断言相等(记录表[2]["表面"], "current", "replace 节点 current")
  # log-only：纯非表面事件（中间夹在表面事件里也保持 log-only）
  设 步骤 为 造事件(0, "step/start", [])
  设 用户2 为 造事件(1, "user/message", 造用户消息([造文本块("Q")]))
  设 结束 为 造事件(2, "turn/end", ["原因": "completed"])
  设 记录2 为 构建事件记录("会话B", [步骤, 用户2, 结束])
  断言相等(记录2[0]["表面"], "log-only", "step/start log-only")
  断言相等(记录2[1]["表面"], "current", "user current")
  断言相等(记录2[2]["表面"], "log-only", "turn/end log-only")
  # 搜索文档：结构事件被省略
  设 文档 为 构建事件搜索文档("会话B", [步骤, 用户2, 结束])
  断言相等(长度(文档), 1, "搜索文档只含语义事件")
  断言相等(文档[0]["文本"], "Q", "文档文本")

# ============ 3) 血缘追踪 ============
段落 测试血缘:
  设 根头 为 ["标识": "r1", "创建时间": 1, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 子头 为 ["标识": "c1", "创建时间": 2, "工作目录": "/w", "父会话": "r1", "种子长度": 空]
  设 孙头 为 ["标识": "g1", "创建时间": 3, "工作目录": "/w", "父会话": "c1", "种子长度": 空]
  设 记录表 为 [["头": 根头, "live": 真, "persisted": 假], ["头": 子头, "live": 真, "persisted": 假], ["头": 孙头, "live": 真, "persisted": 假]]
  设 血缘 为 追踪会话(记录表, "g1")
  断言真(血缘["完整"], "孙会话完整谱系")
  断言相等(血缘["根"]["头"]["标识"], "r1", "根为最祖先")
  断言相等(长度(血缘["祖先"]), 2, "祖先链长度 2")
  断言相等(血缘["祖先"][1]["头"]["标识"], "r1", "祖先末位为根")
  # 后代树：从 r1 看后代含 c1 与 g1
  设 血缘根 为 追踪会话(记录表, "r1")
  断言相等(长度(血缘根["后代"]), 1, "根直接后代 1")
  断言相等(血缘根["后代"][0]["会话"]["头"]["标识"], "c1", "直接后代 c1")
  断言相等(长度(血缘根["后代"][0]["后代"]), 1, "c1 后代 1")
  断言相等(血缘根["后代"][0]["后代"][0]["会话"]["头"]["标识"], "g1", "孙代 g1")
  # 循环父 → 抛错
  设 环头 为 ["标识": "x", "创建时间": 1, "工作目录": "/w", "父会话": "x", "种子长度": 空]
  设 抛环 为 假
  尝试:
    追踪会话([["头": 环头, "live": 真, "persisted": 假]], "x")
  捕获 错误 为 e1:
    设 抛环 为 真
  断言真(抛环, "循环父应抛错")
  # 目标缺失 → 抛错
  设 抛缺 为 假
  尝试:
    追踪会话(记录表, "nope")
  捕获 错误 为 e2:
    设 抛缺 为 真
  断言真(抛缺, "缺失目标应抛错")

# ============ 4) 头兼容 ============
段落 测试头兼容:
  设 头甲 为 ["标识": "a", "创建时间": 1, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 头乙 为 ["标识": "a", "创建时间": 1, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  断言真(校验头兼容(头甲, 头乙), "同头兼容")
  # 时间不等 → 抛
  设 头丙 为 ["标识": "a", "创建时间": 2, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 抛时间 为 假
  尝试:
    校验头兼容(头甲, 头丙)
  捕获 错误 为 e1:
    设 抛时间 为 真
  断言真(抛时间, "时间不等应抛错")  # 反跑：改反 → 红
  # 父不等 → 抛
  设 头丁 为 ["标识": "a", "创建时间": 1, "工作目录": "/w", "父会话": "p1", "种子长度": 空]
  设 抛父 为 假
  尝试:
    校验头兼容(头甲, 头丁)
  捕获 错误 为 e2:
    设 抛父 为 真
  断言真(抛父, "父不等应抛错")
  # 种子差异（isSeeded 语义）→ 抛
  设 头戊 为 ["标识": "a", "创建时间": 1, "工作目录": "/w", "父会话": 空, "种子长度": 4]
  设 抛种子 为 假
  尝试:
    校验头兼容(头甲, 头戊)
  捕获 错误 为 e3:
    设 抛种子 为 真
  断言真(抛种子, "种子差异应抛错")

# ============ 5) 逻辑语料 ============
段落 测试语料:
  设 活1 为 新建会话("live-x", "/w")
  活1.头信息 为 ["版本": [3, 0], "创建时间": 2, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 存活 为 [活1]
  设 持久表 为 [["标识": "p-y", "创建时间": 1, "工作目录": "/w", "父会话": 空, "种子长度": 空], ["标识": "p-z", "创建时间": 3, "工作目录": "/w", "父会话": 空, "种子长度": 空]]
  设 合并 为 合并会话记录(存活, 持久表)
  断言相等(长度(合并), 3, "合并 3 条")
  断言相等(合并[0]["头"]["标识"], "p-z", "语料按创建时间降序")
  断言相等(合并[1]["头"]["标识"], "live-x", "存活记录在中间")
  断言相等(合并[2]["头"]["标识"], "p-y", "最旧在末")
  断言真(合并[1]["live"], "存活标记")
  断言真(合并[1]["persisted"] == 假, "无持久对应")
  断言真(合并[0]["persisted"], "持久标记")
  # 解析会话语料：拷贝 + 排序（不修改入参顺序）
  设 料 为 解析会话语料([["头": 持久表[0], "live": 假, "persisted": 真], ["头": 持久表[1], "live": 假, "persisted": 真]])
  断言相等(料[0]["头"]["标识"], "p-z", "料排序降序")
  # 同 id 存活+持久：头兼容通过 → 合并 live
  设 同头 为 ["标识": "live-x", "创建时间": 2, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 合并2 为 合并会话记录(存活, [同头])
  断言相等(长度(合并2), 1, "同 id 合并为 1 条")
  断言真(合并2[0]["live"] 且 合并2[0]["persisted"], "同 id 双标记")
  # 同 id 头冲突 → 抛错
  设 冲突头 为 ["标识": "live-x", "创建时间": 9, "工作目录": "/w", "父会话": 空, "种子长度": 空]
  设 抛冲突 为 假
  尝试:
    合并会话记录(存活, [冲突头])
  捕获 错误 为 e1:
    设 抛冲突 为 真
  断言真(抛冲突, "同 id 头冲突应抛错")

段落 主:
  设 哑 为 0
  测试抽取()
  测试表面分类()
  测试血缘()
  测试头兼容()
  测试语料()
  打印 "test_会话查询1.5 PASS"

主()
