# test_时间上下文扩展.light —— R102 任务F 补缺测试（0.2.0-rc.1）
# 复刻对象：packages/context/time-context/src/index.ts（formatDuration / renderText elapsed 行 /
#           agent/pre-step 最小间隔门）+ invariant.ts（时区混杂/缺失「告诉模型去问」分支）
#
# 反跑判据（改任一条即红）：
#   1. 应注入读数 间隔门从 >= 改成 >：边界用例（现在-上次注入 == 最小间隔）由注入变不注入 → 红
#   2. 应注入读数 refreshIntervalMs=0 的「永远注入」改成「永远不注入」（返回 假）：interval=0 用例 → 红
#   3. 距前条模型可见时长 把 floor 改成 round：119s 用例（1 分钟前 → 2 分钟前）→ 红
#   4. 挂钟倒退钳零删掉：倒退用例（负差值）→ 红
#   5. 请求区判定 里「工具回环」分支删掉：工具回环用例落成 新轮/续跑 → 红
#   6. 时区引导文案 mixed/missing 分支删掉（一律返回 空）：缺失/混杂用例 → 红

从 时间上下文 导入 距前条模型可见时长, 应注入读数, 请求区判定, 时区引导文案

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 " 加上 标签 加上 " 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望))

段落 断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败（应为真） " 加上 标签)

段落 断言为假(条件, 标签):
  如果 条件 != 假:
    抛出 新建 错误("断言失败（应为假） " 加上 标签)

# 构造一条 user-rpc 消息
段落 用户消息(rpc编号, 时区):
  如果 时区 == 空:
    返回 {"source": {"kind": "user", "rpcId": rpc编号}}
  返回 {"source": {"kind": "user", "rpcId": rpc编号, "clientTimeZone": 时区}}


段落 主:
  # ── 1) 经过时长格式化（floor 语义 + 钳零 + unavailable） ────────────────
  断言相等(距前条模型可见时长(65000, 0), "1 分钟前", "65s → 1 分钟前")
  断言相等(距前条模型可见时长(3600000, 0), "1 小时前", "3600s → 1 小时前")
  断言相等(距前条模型可见时长(119000, 0), "1 分钟前", "119s floor（round 会变 2 分钟前）")
  断言相等(距前条模型可见时长(7200000, 0), "2 小时前", "7200s → 2 小时前")
  断言相等(距前条模型可见时长(90000000, 0), "1 天前", "25h → 1 天前")
  断言相等(距前条模型可见时长(45000, 0), "45 秒前", "45s → 45 秒前")
  断言相等(距前条模型可见时长(5000, 10000), "0 秒前", "挂钟倒退钳零")
  断言相等(距前条模型可见时长(60000, 空), "unavailable", "无基线 → unavailable")
  打印("用例1 经过时长格式化 PASS")

  # ── 2) 最小间隔门（>= 语义；0=每步注入；空=注入；倒退=注入） ────────────
  断言为真(应注入读数(1600000, 1000000, 600000), "恰好等于最小间隔 → 注入（>= 边界）")
  断言为假(应注入读数(1599999, 1000000, 600000), "差 1ms 未到间隔 → 不注入")
  断言为假(应注入读数(1000, 900, 600000), "远未到间隔 → 不注入")
  断言为真(应注入读数(1000000, 1600000, 600000), "挂钟倒退 → 注入")
  断言为真(应注入读数(1000, 500, 0), "interval=0 → 注入")
  断言为真(应注入读数(1000, 2000, 0), "interval=0 倒退也注入")
  断言为真(应注入读数(700000, 空, 600000), "从未注入 → 注入")
  打印("用例2 最小间隔门 PASS")

  # ── 3) 请求区判定（工具回环 / 续跑 / 新轮） ─────────────────────────────
  断言相等(请求区判定([{"种类": "用户消息", "步骤": 1}]), "新轮", "仅步骤1 → 新轮")
  断言相等(请求区判定([]), "新轮", "空请求表 → 新轮")
  断言相等(请求区判定([{"种类": "用户消息", "步骤": 1}, {"种类": "用户消息", "步骤": 3}]), "续跑", "步骤>1 → 续跑")
  断言相等(请求区判定([{"种类": "工具结果", "步骤": 2}]), "工具回环", "工具结果 → 工具回环")
  断言相等(请求区判定([{"种类": "用户消息", "步骤": 1}, {"种类": "工具结果", "步骤": 2}]), "工具回环", "含工具结果 → 工具回环（不注入）")
  打印("用例3 请求区判定 PASS")

  # ── 4) 时区混杂/缺失引导文案（对齐 invariant.ts「告诉模型去问」） ────────
  断言相等(时区引导文案([用户消息("r1", "Asia/Shanghai")]), 空, "resolved → 无需引导")
  设 期望引导 为 "Ask the user to clarify otherwise-unqualified dates and times."
  断言相等(时区引导文案([{"source": {"kind": "tool"}}]), 期望引导, "时区缺失 → 引导提问")
  断言相等(时区引导文案([用户消息("r1", "Asia/Tokyo"), 用户消息("r2", "America/New_York")]), 期望引导, "时区混杂 → 引导提问")
  打印("用例4 时区引导文案 PASS")

  打印("--- 时间上下文扩展（R102 任务F）测试通过 ---")


主()
