# test_webhook会话_接线.light —— 第6轮 任务B #261 webhook 会话宿主出口 判据
# 运行：python 运行.py examples/test_webhook会话_接线.light
# 判据：接桩出口（经宿主会话构造/经宿主消息注入/经宿主错误上报）在宿主桩 mock 下返回预期形状；
#       纯逻辑段回归绿由 test_webhook会话.light 承担。

从 webhook会话 导入 经宿主会话构造, 经宿主消息注入, 经宿主错误上报, 解析请求, 造用户消息, 造投递来源
从 宿主IO 导入 造宿主桩, 造成功结果, 造失败结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主桩能力：回显
段落 回显(参数字典):
  返回 参数字典

# mock 上下文（解析请求 需要 默认模型）
段落 默认模型:
  返回 {"provider": "mock", "model": "m1"}

段落 主:
  # ---- 1. 会话构造出口：已解析请求 + 选项 透传宿主桩 ----
  设 桩 为 造宿主桩({"会话构造": 回显, "消息注入": 回显, "错误上报": 回显})
  设 上下文 为 {"默认模型": 默认模型}
  设 输入 为 {"workspacePath": "/repo/webhook", "title": "标题", "prompt": "提示", "agentPreset": "standard", "permissionPreset": "default"}
  设 已解析 为 解析请求(上下文, 输入)
  设 选项 为 {"sessionId": "webhook-x", "signal": {"已中止": 假, "原因": 空}, "meta": {"cwd": "/repo/webhook"}}
  设 r1 为 经宿主会话构造(桩, 已解析, 选项)
  断言真(r1["成功"], "1a 会话构造成功")
  断言相等(r1["数据"]["已解析"]["title"], "标题", "1b 已解析透传")
  断言相等(r1["数据"]["选项"]["sessionId"], "webhook-x", "1c 选项透传")
  断言相等(桩["调用日志"][0]["能力"], "会话构造", "1d 能力名")

  # ---- 2. 无默认模型键的解析：模型选择走 上下文.默认模型 ----
  断言相等(已解析["modelSelection"]["provider"], "mock", "2a 默认模型选择")

  # ---- 3. 消息注入出口：造用户消息 + 造投递来源 透传 ----
  设 投递 为 {"kind": "github", "source": "push", "deliveryId": "d1", "receivedAt": 1}
  设 来源 为 造投递来源(投递, "规则1")
  设 消息 为 造用户消息([{"type": "text", "text": "提示"}], 来源, "msg-1")
  设 r2 为 经宿主消息注入(桩, 消息)
  断言真(r2["成功"], "3a 消息注入成功")
  断言相等(r2["数据"]["消息"]["role"], "user", "3b role")
  断言相等(r2["数据"]["消息"]["source"]["kind"], "webhook", "3c 来源形状")

  # ---- 4. 错误链出口：错误链() 汇总后交宿主桩 ----
  设 错误 为 {"message": "构造失败", "cause": {"message": "底层原因"}}
  设 r3 为 经宿主错误上报(桩, "webhook-x", 错误)
  断言真(r3["成功"], "4a 错误上报成功")
  断言相等(r3["数据"]["主题"], "webhook-x", "4b 主题")
  断言相等(r3["数据"]["错误链"], "构造失败: 底层原因", "4c 错误链汇总")

  # ---- 5. 宿主桩缺能力 -> UNSUPPORTED_OPERATION（不静默） ----
  设 r4 为 经宿主会话构造(造宿主桩({}), 已解析, 选项)
  断言真(是失败结果(r4), "5a 缺能力须失败")
  断言相等(r4["错误码"], "UNSUPPORTED_OPERATION", "5b 错误码")
  设 r5 为 经宿主消息注入(造宿主桩({}), 消息)
  断言真(是失败结果(r5), "5c 消息注入缺能力须失败")
  设 r6 为 经宿主错误上报(造宿主桩({}), "主题", 错误)
  断言真(是失败结果(r6), "5d 错误上报缺能力须失败")

  # ---- 6. 调用日志留痕 ----
  设 桩6 为 造宿主桩({"会话构造": 回显})
  设 _r6 为 经宿主会话构造(桩6, 已解析, 选项)
  断言相等(列表长度(桩6["调用日志"]), 1, "6a 调用日志一条")

  打印 "--- 第6轮 任务B #261 webhook 会话宿主出口 测试通过 ---"

主()