# test_设置页.light —— 设置页结构 + Agent预设页元数据 + 通用设置按四模式内置插件计数 判据
# 上游：deepseek-harness 设置页（用户在 v0.1.7 实测）
# 被测：src/设置页.light
# 运行：cd lightharness && python 运行.py examples/test_设置页.light
#
# 语言坑规避：断言诊断一律走 抛出 新建 错误（写 只吃字面量串，见 L-055/L-160）；
#   列表/字典字面量单行（L-051）；模块级标量在段落体内改不动 → 计数用字典。

从 设置页 导入 设置页签, 页签标识, 页签说明, 智能预设元数据表, 取预设元数据
从 设置页 导入 预设按序, 默认预设标识, 内置插件按模式, 内置插件概览, 渲染设置页
从 预设组合 导入 组合统计, 预设清单
从 内置核心字典 导入 字典设置, 字典包含键
从 内置核心列表 导入 列表包含

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §1 四页签
# =====================================================================
段落 用例_四页签:
  断言相等(设置页签(), ["通用设置", "模型", "内置插件", "Agent预设"], "1a 页签显示名")
  断言相等(页签标识(), ["general", "models", "builtin-plugins", "agent-presets"], "1b 页签标识")
  断言相等(长度(设置页签()), 4, "1c 页签数量")
  设 说明 为 页签说明()
  断言相等(说明["agent-presets"], "选择 Agent 的工具和工作方式", "1d Agent预设 页说明")

# =====================================================================
# §2 Agent 预设元数据（四内置预设，文案取自设置页实测）
# =====================================================================
段落 用例_Agent预设元数据:
  设 表 为 智能预设元数据表()
  断言相等(长度(字典键列表(表)), 4, "2a 四预设")

  设 标准 为 表["standard"]
  断言相等(标准["id"], "standard", "2b standard id")
  断言相等(标准["名称"], "标准模式", "2c standard 名称")
  断言相等(标准["描述"], "处理代码、文件和资料，适合大多数任务。Agent 会按需使用检索、编辑和终端等工具。", "2d standard 描述")
  断言相等(标准["是否内置"], 真, "2e standard 内置")
  断言相等(标准["顺序"], 1, "2f standard 顺序")
  断言相等(标准["是否默认"], 真, "2g standard 默认")

  设 编码 为 表["ptc"]
  断言相等(编码["名称"], "PTC 模式", "2h ptc 名称")
  断言相等(编码["描述"], "包含标准模式的所有能力，更适合批量调用工具，并对结果进行筛选、整理、去重、统计或汇总的任务。", "2i ptc 描述")
  断言相等(编码["顺序"], 2, "2j ptc 顺序")
  断言相等(编码["是否默认"], 假, "2k ptc 非默认")

  设 极简 为 表["minimal"]
  断言相等(极简["名称"], "极简模式", "2l minimal 名称")
  断言相等(极简["描述"], "Agent 仅使用终端工具完成任务，适合测试和对比其基础表现。", "2m minimal 描述")
  断言相等(极简["顺序"], 3, "2n minimal 顺序")

  设 组装 为 表["cordis"]
  断言相等(组装["名称"], "创造模式", "2o cordis 名称")
  断言相等(组装["描述"], "用对话定制 DSH：让 Agent 编写插件，添加新功能或界面；也能组合工具和提示词，创建自己的模式。", "2p cordis 描述")
  断言相等(组装["顺序"], 4, "2q cordis 顺序")

# =====================================================================
# §3 取预设元数据 / 默认预设 / 按序
# =====================================================================
段落 用例_取预设与默认:
  设 取 为 取预设元数据("cordis")
  断言相等(取["名称"], "创造模式", "3a 取预设元数据 cordis")
  设 序 为 预设按序()
  断言相等(长度(序), 4, "3b 按序长度")
  断言相等(序[0]["id"], "standard", "3c 按序首项是 standard")
  断言相等(序[1]["id"], "ptc", "3d 第二项 ptc")
  断言相等(序[2]["id"], "minimal", "3e 第三项 minimal")
  断言相等(序[3]["id"], "cordis", "3f 第四项 cordis")
  断言相等(默认预设标识(), "standard", "3g 默认预设 standard")

# =====================================================================
# §4 通用设置：内置插件按四模式（每种不同数量）
# =====================================================================
段落 用例_内置插件按模式:
  设 按模式 为 内置插件按模式()
  断言相等(按模式["standard"], 33, "4a standard 展平 33")
  断言相等(按模式["ptc"], 34, "4b ptc 展平 34")
  断言相等(按模式["minimal"], 8, "4c minimal 展平 8")
  断言相等(按模式["cordis"], 34, "4d cordis 展平 34")
  # 四种数量互不相同（对齐「每种对应不同数量的插件」）
  断言真(按模式["standard"] != 按模式["ptc"], "4e standard≠ptc")
  断言真(按模式["ptc"] != 按模式["minimal"], "4f ptc≠minimal")
  断言真(按模式["minimal"] != 按模式["cordis"], "4g minimal≠cordis")
  断言真(按模式["standard"] != 按模式["cordis"], "4h standard≠cordis")

  设 概览 为 内置插件概览()
  断言相等(长度(概览), 4, "4i 概览四行")
  断言相等(概览[2]["id"], "minimal", "4j 概览第三项 minimal")
  断言相等(概览[2]["展平后"], 8, "4k 概览 minimal 展平 8")

# =====================================================================
# §5 渲染设置页（整体结构）
# =====================================================================
段落 用例_渲染设置页:
  设 页 为 渲染设置页()
  断言相等(页["页签"], ["通用设置", "模型", "内置插件", "Agent预设"], "5a 页签")
  断言相等(页["通用设置"]["内置插件"]["按模式"]["standard"], 33, "5b 通用设置 内置插件按模式")
  断言相等(页["Agent预设"]["默认预设"], "standard", "5c Agent预设 默认")
  断言相等(长度(页["Agent预设"]["预设列表"]), 4, "5d Agent预设 列表四项")
  # 模型 / 内置插件 顶Tab 为宿主提供，结构占位不报错
  断言相等(页["模型"]["来源"], "宿主", "5e 模型 来源占位")
  断言相等(页["内置插件"]["来源"], "宿主", "5f 内置插件 来源占位")

段落 主程():
  用例_四页签()
  用例_Agent预设元数据()
  用例_取预设与默认()
  用例_内置插件按模式()
  用例_渲染设置页()
  打印 "test_设置页 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置页 通过 ---"
  返回 真

主程()
