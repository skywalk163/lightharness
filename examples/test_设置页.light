# test_设置页.light —— 设置页结构 + Agent预设页元数据 + 通用设置按四模式内置插件计数 判据
# 上游：deepseek-harness 设置页（用户在 v0.1.7 实测）
# 被测：src/设置页.light
# 运行：cd lightharness && python 运行.py examples/test_设置页.light
#
# 语言坑规避：断言诊断一律走 抛出 新建 错误（写 只吃字面量串，见 L-055/L-160）；
#   列表/字典字面量单行（L-051）；模块级标量在段落体内改不动 → 计数用字典。

从 设置页 导入 设置页签, 页签标识, 页签说明, 智能预设元数据表, 取预设元数据
从 设置页 导入 预设按序, 默认预设标识, 内置插件按模式, 内置插件概览, 渲染设置页
从 设置页 导入 通用设置行集, 取通用行, 权限需确认, 校验通用值, 通用设置块
从 预设组合 导入 组合统计, 预设清单
从 内置核心字典 导入 字典设置, 字典包含键
从 内置核心列表 导入 列表包含

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §1 四页签
# =====================================================================
段落 用例_四页签:
  断言相等(设置页签(), ["通用设置", "模型", "内置插件", "Agent预设"], "1a 页签显示名")
  断言相等(页签标识(), ["general", "models", "builtin-plugins", "agent-presets"], "1b 页签标识")
  断言相等(长度(设置页签()), 4, "1c 页签数量")
  设 说明 为 页签说明()
  断言相等(说明["agent-presets"], "选择 Agent 的工具和工作方式", "1d Agent预设 页说明")

# =====================================================================
# §2 Agent 预设元数据（四内置预设，文案取自设置页实测）
# =====================================================================
段落 用例_Agent预设元数据:
  设 表 为 智能预设元数据表()
  断言相等(长度(字典键列表(表)), 4, "2a 四预设")

  设 标准 为 表["standard"]
  断言相等(标准["id"], "standard", "2b standard id")
  断言相等(标准["名称"], "标准模式", "2c standard 名称")
  断言相等(标准["描述"], "处理代码、文件和资料，适合大多数任务。Agent 会按需使用检索、编辑和终端等工具。", "2d standard 描述")
  断言相等(标准["是否内置"], 真, "2e standard 内置")
  断言相等(标准["顺序"], 1, "2f standard 顺序")
  断言相等(标准["是否默认"], 真, "2g standard 默认")

  设 编码 为 表["ptc"]
  断言相等(编码["名称"], "PTC 模式", "2h ptc 名称")
  断言相等(编码["描述"], "包含标准模式的所有能力，更适合批量调用工具，并对结果进行筛选、整理、去重、统计或汇总的任务。", "2i ptc 描述")
  断言相等(编码["顺序"], 2, "2j ptc 顺序")
  断言相等(编码["是否默认"], 假, "2k ptc 非默认")

  设 极简 为 表["minimal"]
  断言相等(极简["名称"], "极简模式", "2l minimal 名称")
  断言相等(极简["描述"], "Agent 仅使用终端工具完成任务，适合测试和对比其基础表现。", "2m minimal 描述")
  断言相等(极简["顺序"], 3, "2n minimal 顺序")

  设 组装 为 表["cordis"]
  断言相等(组装["名称"], "创造模式", "2o cordis 名称")
  断言相等(组装["描述"], "用对话定制 DSH：让 Agent 编写插件，添加新功能或界面；也能组合工具和提示词，创建自己的模式。", "2p cordis 描述")
  断言相等(组装["顺序"], 4, "2q cordis 顺序")

# =====================================================================
# §3 取预设元数据 / 默认预设 / 按序
# =====================================================================
段落 用例_取预设与默认:
  设 取 为 取预设元数据("cordis")
  断言相等(取["名称"], "创造模式", "3a 取预设元数据 cordis")
  设 序 为 预设按序()
  断言相等(长度(序), 4, "3b 按序长度")
  断言相等(序[0]["id"], "standard", "3c 按序首项是 standard")
  断言相等(序[1]["id"], "ptc", "3d 第二项 ptc")
  断言相等(序[2]["id"], "minimal", "3e 第三项 minimal")
  断言相等(序[3]["id"], "cordis", "3f 第四项 cordis")
  断言相等(默认预设标识(), "standard", "3g 默认预设 standard")

# =====================================================================
# §4 通用设置：内置插件按四模式（每种不同数量）
# =====================================================================
段落 用例_内置插件按模式:
  设 按模式 为 内置插件按模式()
  断言相等(按模式["standard"], 33, "4a standard 展平 33")
  断言相等(按模式["ptc"], 34, "4b ptc 展平 34")
  断言相等(按模式["minimal"], 8, "4c minimal 展平 8")
  断言相等(按模式["cordis"], 34, "4d cordis 展平 34")
  # 四种数量互不相同（对齐「每种对应不同数量的插件」）
  断言真(按模式["standard"] != 按模式["ptc"], "4e standard≠ptc")
  断言真(按模式["ptc"] != 按模式["minimal"], "4f ptc≠minimal")
  断言真(按模式["minimal"] != 按模式["cordis"], "4g minimal≠cordis")
  断言真(按模式["standard"] != 按模式["cordis"], "4h standard≠cordis")

  设 概览 为 内置插件概览()
  断言相等(长度(概览), 4, "4i 概览四行")
  断言相等(概览[2]["id"], "minimal", "4j 概览第三项 minimal")
  断言相等(概览[2]["展平后"], 8, "4k 概览 minimal 展平 8")

# =====================================================================
# §5 渲染设置页（整体结构）
# =====================================================================
段落 用例_渲染设置页:
  设 页 为 渲染设置页()
  断言相等(页["页签"], ["通用设置", "模型", "内置插件", "Agent预设"], "5a 页签")
  断言相等(页["内置插件"]["按模式"]["standard"], 33, "5b 内置插件 按模式 standard（自通用设置迁移）")
  断言相等(页["Agent预设"]["默认预设"], "standard", "5c Agent预设 默认")
  断言相等(长度(页["Agent预设"]["预设列表"]), 4, "5d Agent预设 列表四项")
  # 模型 / 内置插件 顶Tab 为宿主提供，结构占位不报错
  断言相等(页["模型"]["来源"], "宿主", "5e 模型 来源占位")
  断言相等(页["内置插件"]["来源"], "宿主", "5f 内置插件 来源占位")
  # 通用设置 → 行集形状（对齐 R105 §2 契约）：含 配置文档+行集，不含内置插件计数
  断言真(字典包含键(页["通用设置"], "配置文档"), "5g 通用设置 含 配置文档")
  断言真(字典包含键(页["通用设置"], "行集"), "5h 通用设置 含 行集")
  断言真(字典包含键(页["通用设置"], "内置插件") == 假, "5i 通用设置 不含内置插件计数")
  # R105 收口合流（#257）：模型 / 内置插件 / Agent预设 三键已改调 设置页深化 的深化导出
  断言真(字典包含键(页["模型"], "行集"), "5j 模型 含 行集（深化接线）")
  断言真(长度(页["模型"]["行集"]) >= 6, "5k 模型 行集 ≥6 行")
  断言真(字典包含键(页["内置插件"], "清单"), "5l 内置插件 含 清单（深化接线）")
  断言真(字典包含键(页["内置插件"], "按模式概览"), "5m 内置插件 含 按模式概览")
  断言相等(页["内置插件"]["按模式概览"], 内置插件概览(), "5n 按模式概览 取自 内置插件概览")
  设 首卡 为 页["Agent预设"]["预设列表"][0]
  断言真(字典包含键(首卡, "区块"), "5o 预设首卡 含 区块（深化接线）")
  断言真(字典包含键(首卡["区块"], "模式说明"), "5p 区块 含 模式说明")
  断言真(字典包含键(首卡["区块"], "如何使用"), "5q 区块 含 如何使用")
  断言真(长度(首卡["区块"]["模式说明"]) > 0, "5r 模式说明 非空")
  断言真(长度(首卡["区块"]["如何使用"]) > 0, "5s 如何使用 非空")

# =====================================================================
# §6 通用设置行集（R105 任务线 A：九行模型 / 校验 / 覆盖）
# =====================================================================

段落 用例_通用设置行集:
  设 行集 为 通用设置行集()
  断言相等(长度(行集), 9, "6a 九行齐全")
  设 期望序 为 ["permission", "language", "appearance", "fontSize", "transcriptView", "performanceUsage", "linkOpening", "developerTools", "shortcuts"]
  遍历 位置 之 [0, 1, 2, 3, 4, 5, 6, 7, 8]:
    断言相等(行集[位置]["id"], 期望序[位置], "6b 行id序 " + 转字符串(位置))
  # 类型抽测
  断言相等(行集[0]["类型"], "下拉", "6c permission 类型下拉")
  断言相等(行集[2]["类型"], "卡片三选", "6d appearance 类型卡片三选")
  断言相等(行集[3]["类型"], "数字", "6e fontSize 类型数字")
  断言相等(行集[7]["类型"], "开关", "6f developerTools 类型开关")
  断言相等(行集[8]["类型"], "按钮", "6g shortcuts 类型按钮")
  # 默认值抽测
  断言相等(行集[0]["值"], "workspaceWrite", "6h permission 默认")
  断言相等(行集[1]["值"], "zh", "6i language 默认")
  断言相等(行集[2]["值"], "system", "6j appearance 默认")
  断言相等(行集[3]["值"], 14, "6k fontSize 默认 14")
  断言相等(行集[4]["值"], "detailed", "6l transcriptView 默认")
  断言相等(行集[5]["值"], "detailed", "6m performanceUsage 默认")
  断言相等(行集[6]["值"], "sidebar", "6n linkOpening 默认")
  断言相等(行集[7]["值"], 真, "6o developerTools 默认开")
  # 选项值集抽测（上游考据：语言 zh/en、字号 12-17、权限三档）
  断言相等(长度(行集[0]["选项"]), 3, "6p permission 三档")
  断言相等(行集[1]["选项"][0]["值"], "zh", "6q language zh")
  断言相等(行集[1]["选项"][1]["值"], "en", "6r language en")
  断言相等(行集[1]["选项"][0]["标签"], "中文", "6s language 标签中文")
  断言相等(行集[2]["选项"][2]["标签"], "跟随系统", "6t appearance 标签跟随系统")
  断言相等(行集[3]["最小"], 12, "6u fontSize 最小 12")
  断言相等(行集[3]["最大"], 17, "6v fontSize 最大 17")
  断言相等(行集[3]["单位"], "px", "6w fontSize 单位 px")
  断言相等(长度(行集[4]["选项"]), 4, "6x transcriptView 四档")
  断言相等(长度(行集[5]["选项"]), 2, "6y performanceUsage 两档")
  断言相等(行集[6]["选项"][1]["标签"], "默认浏览器", "6z linkOpening 标签默认浏览器")
  # 按钮行无 值 字段
  断言真(字典包含键(行集[8], "值") == 假, "6aa shortcuts 无值字段")
  断言相等(行集[8]["按钮"], "编辑快捷键", "6ab shortcuts 按钮文案")
  # 标题/描述抽测（照上游 locale 原文）
  断言相等(行集[0]["标题"], "权限", "6ac permission 标题")
  断言相等(行集[0]["描述"], "选择新会话的默认权限模式", "6ad permission 描述")
  断言相等(行集[3]["描述"], "仅影响会话内容的字号", "6ae fontSize 描述")
  断言相等(行集[7]["描述"], "开启后显示轨迹、本轮代码差异，新对话中的 Agent 预设切换", "6af developerTools 描述")
  断言相等(行集[8]["描述"], "查看和编辑当前可用的快捷键和输入操作", "6ag shortcuts 描述")

# 取通用行：已知行返回；未知行抛错（消息含合法 id 清单）
段落 用例_取通用行:
  设 行 为 取通用行("fontSize")
  断言相等(行["标题"], "字号大小", "7a 取通用行 fontSize")
  设 抛了 为 假
  设 文 为 ""
  尝试:
    设 坏行 为 取通用行("不存在的行")
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  断言相等(抛了, 真, "7b 未知行抛错")
  断言真(字符串包含(文, "permission"), "7c 错误消息含合法id清单")

# 校验通用值：合法/非法各例
段落 用例_校验通用值:
  设 好 为 校验通用值("permission", "readOnly")
  断言相等(好["合法"], 真, "8a permission 合法值")
  设 坏 为 校验通用值("permission", "superuser")
  断言相等(坏["合法"], 假, "8b permission 非法值")
  断言真(字符串包含(坏["消息"], "非法选项值"), "8c permission 非法消息")
  设 越下 为 校验通用值("fontSize", 11)
  断言相等(越下["合法"], 假, "8d fontSize 越下界 11")
  设 越上 为 校验通用值("fontSize", 18)
  断言相等(越上["合法"], 假, "8e fontSize 越上界 18")
  设 边下 为 校验通用值("fontSize", 12)
  断言相等(边下["合法"], 真, "8f fontSize 边界 12 合法")
  设 边上 为 校验通用值("fontSize", 17)
  断言相等(边上["合法"], 真, "8g fontSize 边界 17 合法")
  设 非数 为 校验通用值("fontSize", "大")
  断言相等(非数["合法"], 假, "8h fontSize 非数字")
  设 开真 为 校验通用值("developerTools", 真)
  断言相等(开真["合法"], 真, "8i developerTools 真")
  设 开假 为 校验通用值("developerTools", 假)
  断言相等(开假["合法"], 真, "8j developerTools 假")
  设 开坏 为 校验通用值("developerTools", "开")
  断言相等(开坏["合法"], 假, "8k developerTools 非布尔")
  设 卡片 为 校验通用值("appearance", "dark")
  断言相等(卡片["合法"], 真, "8l appearance 合法值")
  设 卡坏 为 校验通用值("appearance", "blue")
  断言相等(卡坏["合法"], 假, "8m appearance 非法值")
  设 步好 为 校验通用值("transcriptView", "verbose")
  断言相等(步好["合法"], 真, "8n transcriptView 合法值")
  设 步坏 为 校验通用值("transcriptView", "normal")
  断言相等(步坏["合法"], 假, "8o transcriptView 非法值(normal 是历史存值，不在可选集)")
  设 链好 为 校验通用值("linkOpening", "newTab")
  断言相等(链好["合法"], 真, "8p linkOpening 合法值")
  # 按钮行不受值校验
  设 任意钮 为 "任意"
  设 钮 为 校验通用值("shortcuts", 任意钮)
  断言相等(钮["合法"], 真, "8q shortcuts 按钮不校验值")

# 权限需确认：fullAccess → 真；其他 → 假
段落 用例_权限需确认:
  断言相等(权限需确认("fullAccess"), 真, "9a fullAccess 需确认")
  断言相等(权限需确认("workspaceWrite"), 假, "9b workspaceWrite 无需确认")
  断言相等(权限需确认("readOnly"), 假, "9c readOnly 无需确认")

# 通用设置块：默认块 + 已存值覆盖
段落 用例_通用设置块:
  设 空存 为 {}
  设 块 为 通用设置块(空存)
  断言真(字典包含键(块, "配置文档"), "10a 块含配置文档")
  断言真(字典包含键(块, "行集"), "10b 块含行集")
  断言相等(长度(块["行集"]), 9, "10c 默认九行")
  断言相等(块["配置文档"]["可用"], 假, "10d 配置文档默认不可用")
  断言相等(块["配置文档"]["路径"], "", "10e 配置文档默认空路径")
  设 行集 为 块["行集"]
  断言相等(行集[3]["值"], 14, "10f 默认字号 14")
  断言相等(行集[0]["值"], "workspaceWrite", "10g 默认权限")
  # 已存值覆盖默认值
  设 存值 为 {}
  字典设置(存值, "fontSize", 17)
  字典设置(存值, "permission", "fullAccess")
  字典设置(存值, "developerTools", 假)
  设 覆盖块 为 通用设置块(存值)
  设 覆盖行 为 覆盖块["行集"]
  断言相等(覆盖行[3]["值"], 17, "10h 已存字号覆盖为 17")
  断言相等(覆盖行[0]["值"], "fullAccess", "10i 已存权限覆盖")
  断言相等(覆盖行[7]["值"], 假, "10j 已存开关覆盖为假")
  断言相等(覆盖行[2]["值"], "system", "10k 未覆盖行保持默认")
  断言相等(覆盖行[8]["按钮"], "编辑快捷键", "10l 按钮行不受已存值影响")
  # 空参调用（默认 空 → 当空字典处理）
  设 缺省块 为 通用设置块()
  断言相等(长度(缺省块["行集"]), 9, "10m 缺省参数九行")

段落 主程():
  用例_四页签()
  用例_Agent预设元数据()
  用例_取预设与默认()
  用例_内置插件按模式()
  用例_渲染设置页()
  用例_通用设置行集()
  用例_取通用行()
  用例_校验通用值()
  用例_权限需确认()
  用例_通用设置块()
  打印 "test_设置页 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置页 通过 ---"
  返回 真

主程()
