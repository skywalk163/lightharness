# test_预设组合.light —— 第103轮 任务线A：四个内置 agent preset 的插件 / skill 组合数据表判据
# 上游：packages/bundle/web-app/presets/{standard,ptc,minimal,cordis}.patch.yml
# 被测：src/预设组合.light
# 运行：cd lightharness && python 运行.py examples/test_预设组合.light
#
# 实测对拍值（2026-09-30，以 src/预设组合.light 真实数据为准，非题面口径）：
#   插件行 = 行树递归计数（组行自身 1 行 + 子行递归）；展平后 = 插件行 + 1（声明行）
#   standard  插件行 32 / 展平 33
#   ptc       插件行 33 / 展平 34
#   minimal   插件行  7 / 展平  8
#   cordis    插件行 33 / 展平 34
#
# 语言坑规避：断言诊断一律走 抛出 新建 错误（写 只吃字面量串，见 L-055/L-160）；
#   列表/字典字面量单行不换行（L-051）；模块级标量在段落体内改不动 → 计数用字典（第34轮）。

从 预设组合 导入 组合, 组合行数, 组合统计, 预设序, 组合清单, 预设清单, 是已知预设
从 预设组合 导入 标准组合行表, 编码组合行表, 极简组合行表, 组装组合行表
从 预设深化 导入 是动态禁用标记, 行标识, 是否组行
从 内置核心字典 导入 字典设置, 字典包含键, 字典获取

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 在行表（含嵌套组行）里按 id 找行；找不到返回 空
段落 找行(行表, 标识):
  遍历 行 之 行表:
    如果 行标识(行) == 标识:
      返回 行
    如果 是否组行(行) == 真:
      设 命中 为 找行(字典获取(行, "config", []), 标识)
      如果 命中 != 空:
        返回 命中
  返回 空

# =====================================================================
# §1 四预设组合非空 + 行数（实测值）
# =====================================================================
段落 用例_四预设非空与行数:
  设 名册 为 预设清单()
  断言相等(长度(名册), 4, "1a 预设清单 四项")
  断言相等(名册, ["standard", "ptc", "minimal", "cordis"], "1b 预设清单 次序")

  断言真(组合("standard") != 空, "1c standard 组合非空")
  断言真(组合("ptc") != 空, "1d ptc 组合非空")
  断言真(组合("minimal") != 空, "1e minimal 组合非空")
  断言真(组合("cordis") != 空, "1f cordis 组合非空")

  断言相等(组合行数(组合("standard")), 32, "1g standard 插件行数")
  断言相等(组合行数(组合("ptc")), 33, "1h ptc 插件行数")
  断言相等(组合行数(组合("minimal")), 7, "1i minimal 插件行数")
  断言相等(组合行数(组合("cordis")), 33, "1j cordis 插件行数")

  断言相等(组合行数(标准组合行表()), 32, "1k 标准组合行表 直取一致")
  断言相等(组合行数(编码组合行表()), 33, "1l 编码组合行表 直取一致")
  断言相等(组合行数(极简组合行表()), 7, "1m 极简组合行表 直取一致")
  断言相等(组合行数(组装组合行表()), 33, "1n 组装组合行表 直取一致")

# =====================================================================
# §2 minimal 的 persistent-shell 组行：组 == 真 + 组内 5 子项齐全
# =====================================================================
段落 用例_极简持久壳组:
  设 极简 为 组合("minimal")
  断言相等(长度(极简), 2, "2a minimal 顶层两行")
  设 壳组 为 极简[1]
  断言相等(壳组["id"], "persistent-shell", "2b 组行 id")
  断言相等(壳组["group"], 真, "2c 组行 group 为真")
  断言相等(壳组["name"], "cordis:group", "2d 组行 name 恒 cordis:group")
  断言相等(是否组行(壳组), 真, "2e 预设深化 是否组行 判定一致")

  设 子表 为 壳组["config"]
  断言相等(长度(子表), 5, "2f 组内 5 子项")
  断言相等(子表[0]["id"], "pty", "2g 子项1 pty")
  断言相等(子表[1]["id"], "terminal-bash", "2h 子项2 terminal-bash")
  断言相等(子表[2]["id"], "persistent-bash", "2i 子项3 persistent-bash")
  断言相等(子表[3]["id"], "terminal-pwsh", "2j 子项4 terminal-pwsh")
  断言相等(子表[4]["id"], "persistent-pwsh", "2k 子项5 persistent-pwsh")

  断言相等(子表[0]["name"], "@deepseek-ai/dsh-terminal", "2l pty 模块名")
  断言相等(子表[2]["name"], "@deepseek-ai/dsh-tool-bash-persistent", "2m persistent-bash 模块名")
  断言相等(子表[4]["name"], "@deepseek-ai/dsh-tool-pwsh-persistent", "2n persistent-pwsh 模块名")
  断言相等(子表[2]["config"]["timeoutMs"], 300000, "2o persistent-bash 超时")
  断言相等(子表[3]["config"]["shellDialect"], "pwsh", "2p terminal-pwsh 方言")
  断言相等(子表[2]["已截断"], ["description"], "2q persistent-bash description 已标注截断")

# =====================================================================
# §3 terminal-bash 带 js表达式 禁用标记
# =====================================================================
段落 用例_终端BASH动态禁用:
  设 子表 为 组合("minimal")[1]["config"]
  设 终端 为 子表[1]
  断言相等(终端["id"], "terminal-bash", "3a terminal-bash 定位")
  设 标记 为 终端["disabled"]
  断言真(字典包含键(标记, "js表达式"), "3b disabled 是 js表达式 字典")
  断言相等(标记["js表达式"], "process.platform === 'win32'", "3c js表达式 原文")
  断言相等(是动态禁用标记(标记), 真, "3d 预设深化 是动态禁用标记 判定一致")
  断言相等(是动态禁用标记(子表[0]["disabled"]), 假, "3e pty 是字面布尔非动态标记")
  断言相等(子表[3]["disabled"]["js表达式"], "process.platform !== 'win32'", "3f terminal-pwsh 反向平台表达式")

# =====================================================================
# §4 组合统计展平（含 minimal）
# =====================================================================
段落 用例_组合统计展平:
  设 极简统 为 组合统计("minimal")
  断言相等(极简统["声明"], 1, "4a minimal 声明 1")
  断言相等(极简统["插件行"], 7, "4b minimal 插件行 7")
  断言相等(极简统["展平后"], 8, "4c minimal 展平后 8")
  断言相等(极简统, {"声明": 1, "插件行": 7, "展平后": 8}, "4d minimal 统计整表")

  断言相等(组合统计("standard"), {"声明": 1, "插件行": 32, "展平后": 33}, "4e standard 统计整表")
  断言相等(组合统计("ptc"), {"声明": 1, "插件行": 33, "展平后": 34}, "4f ptc 统计整表")
  断言相等(组合统计("cordis"), {"声明": 1, "插件行": 33, "展平后": 34}, "4g cordis 统计整表")
  断言相等(组合统计("zzz"), {"声明": 0, "插件行": 0, "展平后": 0}, "4h 未知预设统计全零")

# =====================================================================
# §5 预设序
# =====================================================================
段落 用例_预设序:
  断言相等(预设序("standard"), 1, "5a standard order 1")
  断言相等(预设序("ptc"), 2, "5b ptc order 2")
  断言相等(预设序("minimal"), 3, "5c minimal order 3")
  断言相等(预设序("cordis"), 4, "5d cordis order 4")
  断言相等(预设序("zzz"), 0, "5e 未知预设 order 0")
  断言相等(组合清单()["standard"]["order"], 1, "5f 组合清单 order 一致")

# =====================================================================
# §6 未知预设返回空
# =====================================================================
段落 用例_未知预设返回空:
  断言相等(组合("zzz"), 空, "6a 未知串返回空")
  断言相等(组合(""), 空, "6b 空串返回空")
  断言相等(组合(空), 空, "6c 空值返回空")
  断言相等(组合(7), 空, "6d 非串返回空")
  断言相等(是已知预设("standard"), 真, "6e 已知判定 真")
  断言相等(是已知预设("zzz"), 假, "6f 已知判定 假")
  断言相等(是已知预设(空), 假, "6g 已知判定 空值假")

# =====================================================================
# §7 ptc / standard 差异：delegation 组内 workflow 系列禁用位
#   （ptc 与 cordis 行数同为 33，行数不足以区分，故补此判据）
# =====================================================================
段落 用例_委派工作流禁用位:
  设 标准工作流 为 找行(组合("standard"), "workflow-ptc")
  设 编码工作流 为 找行(组合("ptc"), "workflow-ptc")
  设 组装工作流 为 找行(组合("cordis"), "workflow-ptc")
  断言真(标准工作流 != 空, "7a standard 有 workflow-ptc")
  断言相等(标准工作流["disabled"], 假, "7b standard workflow-ptc 启用")
  断言相等(编码工作流["disabled"], 真, "7c ptc workflow-ptc 禁用")
  断言相等(组装工作流["disabled"], 假, "7d cordis workflow-ptc 启用")
  设 编码工具流 为 找行(组合("ptc"), "tool-workflow")
  断言相等(编码工具流["disabled"], 真, "7e ptc tool-workflow 禁用")
  断言相等(找行(组合("minimal"), "workflow-ptc"), 空, "7f minimal 无 delegation 组")

段落 主程():
  用例_四预设非空与行数()
  用例_极简持久壳组()
  用例_终端BASH动态禁用()
  用例_组合统计展平()
  用例_预设序()
  用例_未知预设返回空()
  用例_委派工作流禁用位()
  打印 "test_预设组合 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试预设组合 通过 ---"
  返回 真

主程()
