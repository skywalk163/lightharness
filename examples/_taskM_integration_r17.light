# 第17轮路M整合验证：6个宿主接线模块共存与接口兼容（极简版）
从 宿主运行时 导入 造运行时, 启动, 停止
从 宿主上下文 导入 造根上下文, 造子上下文, 设置属性, 获取属性
从 宿主事件 导入 造事件接线, 注册事件类型, 列举事件类型
从 宿主工具 导入 造接线运行时, 注册工具, 列举工具
从 宿主IO 导入 造内存文件系统, 写文件, 读文件, 文件存在, 是成功结果, 是失败结果
从 宿主配置 导入 造配置项, 造注册表, 注册配置项, 造存储, 设置配置, 获取配置

段落 断言真(条件, 标签):
  如果 条件 != 真:
    打印 "FAIL: " + 标签
    抛出 新建 错误("整合验证失败: " + 标签)

段落 主:
  # 1. 运行时创建与启动/停止
  设 rt 为 造运行时("1.0.0-proto")
  断言真(rt["状态"] == "未初始化", "运行时初始状态未初始化")
  启动(rt, 0)
  断言真(rt["状态"] == "运行中", "运行时启动后状态运行中")
  停止(rt, 1)
  断言真(rt["状态"] == "已停止", "运行时停止后状态已停止")

  # 2. 上下文创建与属性继承
  设 父ctx 为 造根上下文("global", "root-1", 0)
  设置属性(父ctx, "版本", "1.0.0")
  设 子ctx 为 造子上下文(父ctx, "agent", 0)
  设置属性(子ctx, "代理名", "test-agent")
  断言真(获取属性(子ctx, "版本") == "1.0.0", "子上下文继承父上下文属性")
  断言真(获取属性(子ctx, "代理名") == "test-agent", "子上下文自有属性")
  断言真(获取属性(父ctx, "代理名") == 空, "父上下文看不到子上下文属性")

  # 3. 事件接线器创建与类型注册
  设 ev 为 造事件接线()
  注册事件类型(ev, ["事件名":"test/event","模式":"emit","参数形状":["类型":"对象"],"返回值形状":["类型":"空"],"描述":"测试事件"])
  设 事件列表 为 列举事件类型(ev)
  断言真(列表长度(事件列表) >= 1, "事件类型注册后列举返回至少1条")

  # 4. 工具接线器创建与注册
  设 tl 为 造接线运行时()
  注册工具(tl, "test-plugin", ["工具名":"echo","描述":"回显工具","参数模式":["类型":"对象","属性":["文本":["类型":"字符串"]]],"可见性":"public","分组":"test"])
  设 工具列表 为 列举工具(tl, 空)
  断言真(列表长度(工具列表) >= 1, "工具注册后列举返回至少1条")

  # 5. IO内存文件系统
  设 fs 为 造内存文件系统()
  写文件(fs, "/test.txt", "hello world", "req-1")
  断言真(文件存在(fs, "/test.txt") == 真, "IO写文件后文件存在")
  设 读结果 为 读文件(fs, "/test.txt", "req-2")
  断言真(是成功结果(读结果) == 真, "IO读文件成功")
  断言真(读结果["数据"] == "hello world", "IO读文件内容正确")
  设 不存在结果 为 读文件(fs, "/nonexistent.txt", "req-3")
  断言真(是失败结果(不存在结果) == 真, "IO读不存在文件返回失败")
  断言真(不存在结果["错误码"] == "NOT_FOUND", "IO错误码NOT_FOUND")

  # 6. 配置注册表
  设 项 为 造配置项("runtime.log_level", "string", "info", "日志级别", "默认值", "运行时可改", "runtime", 假, "core", 空)
  设 reg 为 造注册表()
  注册配置项(reg, 项)
  设 store 为 造存储()
  设置配置(store, reg, "runtime.log_level", "debug", "测试")
  断言真(获取配置(store, reg, "runtime.log_level") == "debug", "配置获取当前值")

  # 7. 模块间共存验证
  断言真(rt != 空, "运行时对象非空")
  断言真(父ctx != 空, "上下文对象非空")
  断言真(ev != 空, "事件接线器非空")
  断言真(tl != 空, "工具接线器非空")
  断言真(fs != 空, "IO文件系统非空")
  断言真(reg != 空, "配置注册表非空")

  打印 "=== 第17轮整合验证 ALL PASS (22断言) ==="
