# test_函数增强.light —— 第18轮 任务5（函数与闭包增强库）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_函数增强.light
# 修复对象：L-102（带默认参数 A级）/ L-098（闭包包装 A级）/ L-091/L-097（C级指南）+ 通用工具
#
# 反跑判据（改源码一行测试必须红，恢复后绿）：
#   A=正常：带默认参数+闭包包装计数器+管道 组合使用（回归绿验证）
#   B=边界：默认值填充、计数器多次递增状态持久（回归绿验证）
#   C=变异：造计数器 的状态读写改用局部变量（不持久）-> 计数器持久断言红

从 函数增强 导入 带默认参数, 柯里化, 闭包包装, 造计数器, 管道, 组合函数, 记忆化, 应用参数, 偏应用, 断言包装

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含(文本, 子串, 标签):
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 检查抛错含(标签, 子串, 运算):
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    设 忽略 为 运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 样例函数（全部命名段落，规避 L-091 内联限制） ----------
段落 加法字典(参数):
  返回 字典获取(参数, "甲", 0) + 字典获取(参数, "乙", 0)
段落 拼接列表(参数列表):
  返回 连接字符串(参数列表, "-")
段落 加十(值):
  返回 值 + 10
段落 乘二(值):
  返回 值 * 2
段落 平方(值):
  返回 值 * 值

设 计算记录 为 []

段落 昂贵计算(值):
  列表追加(计算记录, 值)
  返回 值 * 3

# 闭包包装样例原函数：(参数, 状态) 两参，状态计数
段落 次数统计(参数, 状态):
  设 状态["次数"] 为 字典获取(状态, "次数", 0) + 1
  返回 字典获取(状态, "次数", 0)

# 断言包装样例
段落 值为正(参数):
  返回 字典获取(参数, "值", 0) > 0
段落 结果为正(结果):
  返回 结果 > 0
段落 加倍(参数):
  返回 字典获取(参数, "值", 0) * 2
段落 触发前置失败:
  设 受包装 为 断言包装(加倍, 值为正, 结果为正)
  受包装(["值": -1])

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 带默认参数（L-102 A级） ============
  设 加法 为 带默认参数(加法字典, ["甲": 1, "乙": 2])
  断言相等(加法({}), 3, "全默认值")
  断言相等(加法(["甲": 5]), 7, "显式覆盖甲")
  断言相等(加法(["乙": 10]), 11, "显式覆盖乙")
  断言相等(加法(["甲": 1, "乙": 1]), 2, "全显式")

  # ============ 2) 柯里化 ============
  设 柯加 为 柯里化(拼接列表, 3)
  设 步一 为 柯加("甲")
  设 步二 为 步一("乙")
  断言相等(步二("丙"), "甲-乙-丙", "三元柯里化链")
  设 柯乘 为 柯里化(拼接列表, 2)
  断言相等(柯乘("一")("二"), "一-二", "二元柯里化")

  # ============ 3) 闭包包装（L-098 A级） ============
  设 包装果 为 闭包包装(次数统计, ["次数": 0])
  设 调用器 为 包装果["调用"]
  调用器("x")
  调用器("y")
  断言相等(调用器("z"), 3, "状态跨调用持久")
  断言相等(包装果["状态"]["次数"], 3, "状态可外部读取")

  # ============ 4) 造计数器 ============
  设 计数器 为 造计数器(10)
  断言相等(计数器["获取值"](), 10, "初始值")
  计数器["递增"]()
  计数器["递增"]()
  断言相等(计数器["获取值"](), 12, "两次递增")
  计数器["重置"]()
  断言相等(计数器["获取值"](), 10, "重置回初始")
  计数器["递增"]()
  断言相等(计数器["状态"]["值"], 11, "状态字典可外部读取")

  # ============ 5) 管道 ============
  断言相等(管道(5, []), 5, "空管道返回原值")
  断言相等(管道(5, [加十]), 15, "单函数管道")
  断言相等(管道(5, [加十, 乘二, 平方]), 900, "多函数顺序执行")
  断言相等(管道(2, [乘二, 加十]), 14, "函数间数据传递")

  # ============ 6) 组合 ============
  设 先乘后加 为 组合函数(加十, 乘二)
  断言相等(先乘后加(5), 20, "组合 甲(乙(x))")
  设 先加后乘 为 组合函数(乘二, 加十)
  断言相等(先加后乘(5), 30, "组合顺序敏感")

  # ============ 7) 记忆化 ============
  设 缓存平方 为 记忆化(昂贵计算)
  断言相等(缓存平方(4), 12, "首次调用执行")
  断言相等(缓存平方(4), 12, "二次调用返回缓存")
  断言相等(列表长度(计算记录), 1, "昂贵计算只执行一次")
  断言相等(缓存平方(5), 15, "不同参数重新计算")
  断言相等(列表长度(计算记录), 2, "不同参数计入执行")

  # ============ 8) 应用 / 偏应用 ============
  断言相等(应用参数(拼接列表, ["甲", "乙"]), "甲-乙", "应用列表参数")
  断言相等(应用参数(拼接列表, []), "", "空参数")
  设 补全 为 偏应用(拼接列表, ["前缀"])
  断言相等(补全(["后缀"]), "前缀-后缀", "偏应用固定首参")
  设 补全两 为 偏应用(拼接列表, ["一", "二"])
  断言相等(补全两(["三"]), "一-二-三", "偏应用固定多参")

  # ============ 9) 断言包装 ============
  设 受包装 为 断言包装(加倍, 值为正, 结果为正)
  断言相等(受包装(["值": 5]), 10, "前后置条件通过")
  检查抛错含("前置条件失败应抛", "前置条件失败", 触发前置失败)

  打印("test_函数增强 PASS")

主()
