# R126 B2 流式参数（残缺 JSON 顶层字段扫描）回归
# 对标 packages/util/values/src/partial-json.ts（上游 dsh-v0.2.1-alpha.1）
从 流式参数 导入 参数键表 参数字段完整 参数字符串前缀 参数字符串长度 参数值 残缺参数视图

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 信息 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真(值, 信息):
  如果 值 == 假:
    抛出 新建 错误("断言失败[" + 信息 + "]：期望真，实际=" + 转字符串(值))

段落 断言为假(值, 信息):
  如果 值 == 真:
    抛出 新建 错误("断言失败[" + 信息 + "]：期望假，实际=" + 转字符串(值))

段落 主:
  设 反斜杠 为 "\\"

  # ── 判据1：完整对象等价（键表、字段表、闭合、无效） ──
  设 视 为 残缺参数视图("{\"a\":1,\"b\":\"x\"}")
  断言相等(视["键表"], ["a", "b"], "判据1 键表首现序")
  断言相等(视["字段表"], {"a": 1, "b": "x"}, "判据1 字段表")
  断言为真(视["闭合"], "判据1 闭合")
  断言为假(视["无效"], "判据1 无效")

  # ── 判据2：普通完整 JSON 与直接解析等价 ──
  设 全文 为 " { \"名\" : 123 , \"表\" : [ 1 , 2 ] } "
  设 视2 为 残缺参数视图(全文)
  断言相等(视2["字段表"], 解析JSON(全文), "判据2 完整JSON等价")

  # ── 判据3：残缺字符串值（未闭合不进字段表，前缀可读） ──
  设 断3 为 "{\"a\":\"hello"
  断言相等(参数键表(断3), ["a"], "判据3 键已出现")
  断言相等(参数字符串前缀(断3, "a"), "hello", "判据3 前缀")
  断言相等(参数字符串长度(断3, "a"), 5, "判据3 长度")
  断言为假(参数字段完整(断3, "a"), "判据3 未完整")
  设 视3 为 残缺参数视图(断3)
  断言为假(字典包含键(视3["字段表"], "a"), "判据3 未完整不进字段表")
  断言为假(视3["闭合"], "判据3 未闭合")

  # ── 判据4：残缺嵌套对象 ──
  设 断4 为 "{\"a\":{\"b\":1,\"c\":"
  断言相等(参数键表(断4), ["a"], "判据4 键已出现")
  断言为假(参数字段完整(断4, "a"), "判据4 未完整")
  设 视4 为 残缺参数视图(断4)
  断言为假(字典包含键(视4["字段表"], "a"), "判据4 不进字段表")
  断言为假(视4["闭合"], "判据4 未闭合")
  断言为假(视4["无效"], "判据4 非无效")

  # ── 判据5：转义引号不截断 ──
  设 断5 为 "{\"a\":\"he" + 反斜杠 + "\"llo\",\"b\":2}"
  断言相等(参数字符串前缀(断5, "a"), "he\"llo", "判据5 转义引号解码")
  断言为真(参数字段完整(断5, "a"), "判据5 a完整")
  设 视5 为 残缺参数视图(断5)
  断言相等(视5["字段表"]["a"], "he\"llo", "判据5 完整文本")
  断言相等(视5["字段表"]["b"], 2, "判据5 后续字段")

  # ── 判据6：尾随逗号（前字段完整，对象未闭合） ──
  设 断6 为 "{\"a\":1,"
  设 视6 为 残缺参数视图(断6)
  断言相等(视6["字段表"]["a"], 1, "判据6 前字段完整")
  断言为假(视6["闭合"], "判据6 未闭合")
  断言为假(视6["无效"], "判据6 非无效")

  # ── 判据7：unicode 转义解码与流式 hex 等待 ──
  设 断7全 为 "{\"a\":\"" + 反斜杠 + "u4e2d文\"}"
  断言相等(参数字符串前缀(断7全, "a"), "中文", "判据7 u转义完整")
  设 断7缺 为 "{\"a\":\"" + 反斜杠 + "u4e"
  断言相等(参数字符串前缀(断7缺, "a"), "", "判据7 hex不足流式等待")
  断言相等(参数字符串长度(断7缺, "a"), 0, "判据7 等待期长度为零")
  设 断7补 为 "{\"a\":\"" + 反斜杠 + "u4e2d"
  断言相等(参数字符串前缀(断7补, "a"), "中", "判据7 hex补满即解码")

  # ── 判据8：简单转义（换行/制表/反斜杠） ──
  设 断8 为 "{\"a\":\"l1" + 反斜杠 + "nl2" + 反斜杠 + "t乙\"}"
  断言相等(参数字符串前缀(断8, "a"), "l1\nl2\t乙", "判据8 简单转义")

  # ── 判据9：非法转义保留有效前缀 ──
  设 断9 为 "{\"a\":\"ok" + 反斜杠 + "u12zz\"}"
  断言相等(参数字符串前缀(断9, "a"), "ok", "判据9 非法u保留前缀")
  # 参数字段完整 只判边界不验内容（见模块头降级登记3，对齐上游 complete 默认行为）
  断言为真(参数字段完整(断9, "a"), "判据9 完整只判边界")
  设 视9 为 残缺参数视图(断9)
  断言为假(字典包含键(视9["字段表"], "a"), "判据9 错串不进字段表")
  断言为假(视9["无效"], "判据9 结构仍有效")

  # ── 判据10：悬空反斜杠（流式等待）与闭合悬空（错） ──
  设 断10流 为 "{\"a\":\"x" + 反斜杠
  断言相等(参数字符串前缀(断10流, "a"), "x", "判据10 悬空转义等待")

  # ── 判据11：键含转义（\n 键名解码后可查值） ──
  设 断11 为 "{\"a" + 反斜杠 + "nb\":1}"
  设 断键 为 "a\nb"
  断言相等(参数键表(断11), [断键], "判据11 键转义解码")
  断言相等(参数值(断11, 断键), 1, "判据11 转义键取值")

  # ── 判据12：顶层非对象即无效 ──
  设 视12 为 残缺参数视图("\"abc\"")
  断言为真(视12["无效"], "判据12 顶层非对象")
  断言相等(视12["键表"], [], "判据12 无键")

  # ── 判据13：空文本 ──
  设 视13 为 残缺参数视图("")
  断言相等(视13["键表"], [], "判据13 空文本无键")
  断言为假(视13["闭合"], "判据13 空文本未闭合")
  断言为假(视13["无效"], "判据13 空文本非无效")

  # ── 判据14：闭合后垃圾 → 无效但仍算闭合 ──
  设 视14 为 残缺参数视图("{} x")
  断言为真(视14["无效"], "判据14 垃圾无效")
  断言为真(视14["闭合"], "判据14 错亦闭合")

  # ── 判据15：嵌套数组 + 内层转义引号 ──
  设 断15 为 "{\"a\":{\"b\":\"x" + 反斜杠 + "\"y" + 反斜杠 + "\"z\"},\"c\":2}"
  断言为真(参数字段完整(断15, "a"), "判据15 嵌套完整")
  设 视15 为 残缺参数视图(断15)
  断言相等(视15["字段表"]["a"]["b"], "x\"y\"z", "判据15 内层转义引号")
  断言相等(视15["字段表"]["c"], 2, "判据15 后字段")

  # ── 判据16：null 值存在性与 参数值 对串返回空 ──
  设 断16 为 "{\"a\":null,\"b\":\"s\"}"
  设 视16 为 残缺参数视图(断16)
  断言为真(字典包含键(视16["字段表"], "a"), "判据16 null进字段表")
  断言相等(视16["字段表"]["a"], 空, "判据16 null值")
  断言相等(参数值(断16, "b"), 空, "判据16 串不返回值")
  断言相等(参数字符串前缀(断16, "b"), "s", "判据16 串走前缀")

  # ── 判据17：字符串内容控制字符 → 内容错误 ──
  设 断17 为 "{\"a\":\"x" + "\t" + "\"}"
  断言相等(参数字符串前缀(断17, "a"), "x", "判据17 控制字符保留前缀")
  # 同判据9：完整只判边界（降级登记3）
  断言为真(参数字段完整(断17, "a"), "判据17 完整只判边界")
  设 视17 为 残缺参数视图(断17)
  断言为假(字典包含键(视17["字段表"], "a"), "判据17 错串不进字段表")

  # ── 判据18：字符串长度前缀限长 ──
  设 断18 为 "{\"a\":\"hello"
  断言相等(参数字符串长度(断18, "a"), 5, "判据18 长度全量")

  打印 "test_R126_流式参数 PASS"

主()
