# test_修复_会话.light —— 第 9 轮任务 1：会话域 4 项差异修复回归
#   §1 T2-D5 🔴 模块级 投影节点0 append 连接键名（原 ["system"] 笔误 → ["系统"]）
#   §2 T2-D1 🟡 压缩替换 无效区间抛错（文案对齐上游 surface.spec）
#   §3 T2-D2 🟡 事件带来源 快照（副本()），调用方改动不透传
#   §4 T2-D3 🟡 V0/V2 头 version 统一英文键，编码→解码还原
# 反跑判据：_antirun_session_fix.py（A/B/C 改反 src 修复点 → 红；恢复 → 绿）
# 运行：cd lightharness && python 运行.py examples/test_修复_会话.light

从 会话 导入 新建会话
从 会话格式 导入 造头, 编码V0头, 编码V2头, 解码V0头, 造事件, 事件带来源, 投影节点0, 记录系统提示, 版本文本

段落 核验 接收 标签, 实际, 期望, 备注:
  如果 实际 != 期望:
    打印 "✗ 失败：" + 标签 + " 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际) + " (" + 备注 + ")"
    抛出 "第9轮任务1 断言失败: " + 标签
  打印 "✓ " + 标签 + " (" + 备注 + ")"
  返回 真

段落 核验真 接收 标签, 条件, 备注:
  返回 核验(标签, 条件, 真, 备注)

段落 核验含 接收 标签, 容器文本, 子串, 备注:
  设 命中 为 假
  设 n 为 长度(容器文本)
  设 m 为 长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 容器文本[i:(i+m)] == 子串:
      设 命中 为 真
    设 i 为 i + 1
  返回 核验真(标签, 命中, 备注)

段落 主:
  打印 "===== 第 9 轮任务 1：会话域修复回归 ====="

  # ---- §1 T2-D5：模块级 投影节点0 第二条 append 连接（原笔误分支，此前必错）----
  设 会话甲 为 新建会话("fix_d5", ".")
  设 占1 为 记录系统提示(会话甲, "第一段", "append")
  设 占2 为 记录系统提示(会话甲, "第二段", "append")
  核验("1a 模块级 append 连接", 投影节点0(会话甲.事件表), "第一段第二段", "T2-D5 修复后连接生效")
  核验("1b 类方法一致", 会话甲.投影节点0(), "第一段第二段", "模块级与类方法语义一致")
  设 占3 为 记录系统提示(会话甲, "第三段", "append")
  核验("1c 三段连接", 投影节点0(会话甲.事件表), "第一段第二段第三段", "多次 append 累积")

  # ---- §2 T2-D1：压缩替换 无效区间抛错（文案对齐上游）----
  设 会话乙 为 新建会话("fix_d1", ".")
  设 占4 为 会话乙.记录事件("user/message", ["role": "user", "content": [["type": "text", "text": "a"]]])
  设 占5 为 会话乙.记录事件("user/message", ["role": "user", "content": [["type": "text", "text": "b"]]])
  尝试:
    设 占6 为 会话乙.压缩替换(5, 6, [])
    核验真("2a 起点不存在抛错", 假, "应抛 start not found")
  捕获 异常 错误:
    核验含("2a 起点不存在抛错", 转字符串(错误), "surface replace: start seq 5 not found", "上游同文案")
  尝试:
    设 占7 为 会话乙.压缩替换(0, 9, [])
    核验真("2b 终点不存在抛错", 假, "应抛 end not found")
  捕获 异常 错误:
    核验含("2b 终点不存在抛错", 转字符串(错误), "surface replace: end seq 9 not found", "上游同文案")
  尝试:
    设 占8 为 会话乙.压缩替换(1, 0, [])
    核验真("2c 起点大于终点抛错", 假, "应抛 start after end")
  捕获 异常 错误:
    核验含("2c 起点大于终点抛错", 转字符串(错误), "start seq 1 is after end seq 0", "上游同文案")
  设 占9 为 会话乙.压缩替换(0, 1, [["类型": "user/message", "数据": ["role": "user", "content": [["type": "text", "text": "s"]]], "源序号表": [0, 1]]])
  核验真("2d 合法区间仍可用", 长度(会话乙.查询事件("", 0, 0)) == 3, "原区间遮蔽 + 新事件入位")

  # ---- §3 T2-D2：来源序号表快照（逐元素拷贝绕法，见 L-082），调用方改动不透传 ----
  设 源表 为 [3, 4]
  设 事件甲 为 造事件("tool/result", 7, 0, ["消息": "r"])
  设 占A 为 事件带来源(事件甲, 源表)
  列表追加(源表, 99)
  核验真("3a 调用方改动不透传", 长度(事件甲["来源事件序号"]) == 2, "快照绕法（L-082）：与源表脱钩")
  核验("3b 快照值", 事件甲["来源事件序号"][0], 3, "内容一致")

  # ---- §4 T2-D3：V0/V2 头 version 英文键 + 编码→解码还原 ----
  设 头甲 为 造头(3, 0, "fixd3", 42, 空, 空, 空, 假)
  设 行甲 为 编码V0头(头甲)
  核验真("4a V0 version 英文键", 行甲["version"]["major"] == 3 且 行甲["version"]["minor"] == 0, "JSON 形状对齐上游 canonical envelope")
  设 头乙 为 解码V0头(行甲)
  核验("4b V0 往返还原", 版本文本(头乙["版本"]), "3.0", "编码→解码 还原 3.0")
  设 行乙 为 编码V2头(头甲)
  核验真("4c V2 version 英文键", 行乙["version"]["major"] == 3, "V2 编码同源统一")
  设 头丙 为 解码V0头(行乙)
  核验("4d V2 往返还原", 版本文本(头丙["版本"]), "3.0", "V2 头同样还原")

  打印 "===== 第 9 轮任务 1：会话域修复回归全部通过 ====="
