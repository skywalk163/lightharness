# test_R85_D_tool-cordis.light —— R85 任务 D：tool-cordis 纯逻辑对拍
从 toolcordis 导入 绳系统提示, 绳呈现列表调用, 绳呈现查询调用, 绳读精确字段, 绳精确输入, 绳构造注册, 绳执行查询, 绳归一提供者, 绳装配
从 内置核心判型 导入 是字符串, 是空, 是字典

# 自写断言辅助（避免与既有 断言 段名撞名）
段落 绳断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 绳断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件))

# 目录桩（供 绳装配 注入；返回归一前的注册列表）
段落 段_取目录桩:
  设 注册一 为 绳构造注册("Service", "服务", "listService", "service", 模式二, ["description": "目录"])
  设 注册二 为 绳构造注册("Event", "事件", "listEvents", "event", 模式二, ["description": "目录"])
  返回 [注册一, 注册二]

设 模式二 为 绳精确输入("service", "x")

段落 主:
  # ① 呈现列表调用
  设 列表呈现 为 绳呈现列表调用()
  绳断言相等(列表呈现["title"], "List Cordis Inspect Providers", "呈现列表调用标题")
  绳断言相等(列表呈现["kind"], "read", "呈现列表调用种类")

  # ② 呈现查询调用（组合标题）
  设 查询呈现 为 绳呈现查询调用(["platform": "host", "provider": "Service", "method": "listService"])
  绳断言相等(查询呈现["title"], "Query Cordis host Service.listService", "呈现查询调用标题")

  # ③ 安全读取字段
  设 输入一 为 ["service": "Session", "event": "turnBoundary"]
  绳断言相等(绳读精确字段(输入一, "service"), "Session", "读精确字段命中")
  绳断言为真(绳读精确字段(输入一, "缺失") == 空, "读精确字段缺失为空")
  绳断言为真(绳读精确字段("非字典", "x") == 空, "读精确字段非字典为空")

  # ④ 精确输入模式
  设 模式一 为 绳精确输入("service", "精确 Service 键")
  绳断言为真(字典包含键(模式一["properties"], "service"), "精确输入含字段")
  绳断言相等(模式一["properties"]["service"]["type"], "string", "精确输入字段类型")

  # ⑤ 构造注册 + 执行查询（合法方法返回字段；非法方法抛错）
  设 注册一 为 绳构造注册("Service", "服务发现", "listService", "service", 模式一, ["description": "目录"])
  绳断言相等(注册一["方法"], "listService", "注册方法名")
  绳断言相等(绳执行查询(注册一, "listService", 输入一), "Session", "执行查询合法返回字段")
  尝试:
    绳执行查询(注册一, "listEvents", 输入一)
    抛出 新建 错误("应为抛错: 执行查询错方法未抛 [NO_THROW]")
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
    如果 字符串包含(消息, "UNKNOWN_METHOD") == 假:
      抛出 新建 错误("断言失败: 执行查询错方法 期望含 UNKNOWN_METHOD 实际=" + 消息)

  # ⑥ 归一化 provider 列表
  设 注册二 为 绳构造注册("Event", "事件发现", "listEvents", "event", 模式一, ["description": "目录"])
  设 归一表 为 绳归一提供者([注册一, 注册二])
  绳断言相等(长度(归一表), 2, "归一表长度")
  绳断言相等(归一表[0]["id"], "Service", "归一表首id")
  绳断言相等(归一表[1]["方法"], "listEvents", "归一表次方法")

  # ⑦ 装配：缺 catalog 钩子抛错；有钩子返回归一表
  尝试:
    绳装配(空)
    抛出 新建 错误("应为抛错: 缺钩子未抛 [NO_THROW]")
  捕获 异常 为 e:
    设 消息二 为 转字符串(e)
    如果 字符串包含(消息二, "MISSING_CATALOG_HOOK") == 假:
      抛出 新建 错误("断言失败: 装配缺钩子 期望含 MISSING_CATALOG_HOOK 实际=" + 消息二)
  设 钩子一 为 ["取目录": 段_取目录桩]
  设 装配结果 为 绳装配(钩子一)
  绳断言相等(长度(装配结果), 2, "装配返回归一长度")

主()
写 "test_R85_D_tool-cordis PASS"
