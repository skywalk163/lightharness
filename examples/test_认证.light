# test_认证.light —— W2 登录认证模块验收（纯新增，不碰任何现有文件）
#
# 运行通道：
#   python 运行.py examples/test_认证.light                 # 随机令牌分支（默认）
#   HARNESS_WEB_TOKEN=abc123 python 运行.py examples/test_认证.light   # 固定令牌分支
#
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 退出码非 0。
# 反跑：把 src/认证.light 校验令牌 的相等判断改反（如 返回 假 / 不等才真），本测试必红。
#
# 语言坑规避：断言一律 断言相等（L-037 no-op）；字符串比较直接 ==；
#   环境变量 环境变量(名, 缺省)；模块级单例用字典承载（src 后端段落内重赋值不透出）。

从 认证 导入 初始化认证, 取令牌, 校验令牌

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 是十六进制串(串):
  设 i 为 0
  当 i < 列表长度(串):
    设 c 为 串[i]
    如果 (字符串包含("0123456789abcdef", c) == 假):
      返回 假
    设 i 为 i + 1
  返回 真

# =====================================================================
# 随机令牌分支（默认，无 HARNESS_WEB_TOKEN）
# =====================================================================
段落 用例_未初始化:
  # 必须在 初始化认证 之前验证，避免污染模块级单例
  断言相等(取令牌(), "", "未初始化_取令牌空")
  断言相等(校验令牌("任意"), 假, "未初始化_校验任意假")
  断言相等(校验令牌(空), 假, "未初始化_校验空假")
  断言相等(校验令牌(""), 假, "未初始化_校验空串假")

段落 用例_初始化与幂等:
  初始化认证()
  设 令牌1 为 取令牌()
  断言相等(令牌1 != "", 真, "初始化后非空")
  断言相等(列表长度(令牌1) >= 32, 真, "长度≥32")
  断言相等(是十六进制串(令牌1), 真, "全十六进制")
  初始化认证()  # 再次调用，应幂等
  设 令牌2 为 取令牌()
  断言相等(令牌1, 令牌2, "幂等_两次取令牌相同")

段落 用例_校验:
  设 当前 为 取令牌()
  断言相等(校验令牌(当前), 真, "校验_正确令牌")
  断言相等(校验令牌("错误令牌"), 假, "校验_错误令牌")
  断言相等(校验令牌(""), 假, "校验_空串")
  断言相等(校验令牌(空), 假, "校验_空值")

段落 随机分支:
  用例_未初始化()
  用例_初始化与幂等()
  用例_校验()
  写 "--- 测试认证(随机令牌) 通过 ---"

# =====================================================================
# 固定令牌分支（HARNESS_WEB_TOKEN 已设置，独立进程验证）
# =====================================================================
段落 固定分支:
  设 固定 为 环境变量("HARNESS_WEB_TOKEN", "")
  初始化认证()
  断言相等(取令牌(), 固定, "固定令牌_取令牌一致")
  断言相等(校验令牌(固定), 真, "固定令牌_校验真")
  断言相等(校验令牌("错误令牌"), 假, "固定令牌_校验错")
  写 "--- 测试认证(固定令牌=" + 固定 + ") 通过 ---"

# =====================================================================
# 主程：依据环境变量选择分支（同文件两进程覆盖两条路径）
# =====================================================================
段落 主程:
  设 固定 为 环境变量("HARNESS_WEB_TOKEN", "")
  如果 固定 != "" 且 固定 != 空:
    固定分支()
  否则:
    随机分支()
主程()
