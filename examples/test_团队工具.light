# test_团队工具.light —— tool-agent-team 工具定义纯逻辑（对标 #77）
# 对照上游：packages/experimental/tool-agent-team/src/index.ts
#   （9 个团队工具 name/description/parameters；wait_agent no-progress 短路；
#     team_task_list 过滤+分页；jsonOutput 呈现）
#
# 覆盖（≥6 断言，实际更多）：
#   1) 工具定义面：9 个工具名齐全
#   2) 参数 schema：spawn_teammate required / context enum；send_message required；
#      team_task_update action enum 八动作
#   3) 参数校验（复用 工具.light 校验参数）：缺字段报错 / 合法通过 / 非法 enum 报错
#   4) wait_agent 纯逻辑：缺省 30000 / 区间 [10000,3600000] / 非整数 / 越界
#   5) wait_agent 执行面：无活跃伙伴 -> noProgress 短路；有活跃伙伴 -> 交宿主等待；
#      超时不合法 -> 直接交宿主等待
#   6) team_task_list 纯逻辑：status/owner(unowned)/ready 过滤 + 分页 nextCursor
#   7) 判分页：负游标 / limit=0 / limit=101 抛错
#   8) 结果呈现：渲染JSON文本 形状
#
# 反跑判据（改反必红）：
#   C) 判等待超时合法 区间放宽（5000 也放行）-> 无进展短路用例变红

从 团队工具 导入 解析等待超时, 判等待超时合法, 是否活跃等待状态, 有无活跃等待伙伴, 无进展等待结果, 过滤团队任务, 判分页, 分页切片, 渲染JSON文本, 团队工具声明表, spawn_teammate模式, send_message模式, team_task_update模式, 团队工具面
从 工具 导入 校验参数
从 JSON 导入 序列化JSON

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言失败(期望真): " + 标签)

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)

# =====================================================================
# 假能力（注入执行面；返回固定投影，不实例化宿主服务）
# =====================================================================
段落 假列成员空闲:
  返回 [{"id": "lead", "status": "running"}, {"id": "child-a", "status": "idle"}]

段落 假列成员活跃:
  返回 [{"id": "lead", "status": "running"}, {"id": "child-a", "status": "running"}]

段落 假调用者标识:
  返回 "lead"

段落 假等待 接收 超时:
  返回 {"timedOut": 真, "收到超时": 超时}

段落 假列任务:
  返回 [
    {"id": "a", "status": "pending", "ready": 真},
    {"id": "b", "status": "in_progress", "ownerName": "lead", "ready": 真},
    {"id": "c", "status": "completed", "ready": 真}
  ]

段落 假建任务 接收 参数:
  返回 {"id": "new", "ok": 真}

# =====================================================================
# 1. 工具定义面：9 个工具名齐全
# =====================================================================
段落 用例工具定义:
  设 表 为 团队工具声明表()
  断言相等(列表长度(表), 9, "声明表含 9 个工具")
  设 名表 为 []
  遍历 项 之 表:
    列表追加(名表, 项["name"])
  断言真(列表包含(名表, "spawn_teammate"), "含 spawn_teammate")
  断言真(列表包含(名表, "send_message"), "含 send_message")
  断言真(列表包含(名表, "list_agents"), "含 list_agents")
  断言真(列表包含(名表, "wait_agent"), "含 wait_agent")
  断言真(列表包含(名表, "interrupt_agent"), "含 interrupt_agent")
  断言真(列表包含(名表, "team_task_create"), "含 team_task_create")
  断言真(列表包含(名表, "team_task_list"), "含 team_task_list")
  断言真(列表包含(名表, "team_task_get"), "含 team_task_get")
  断言真(列表包含(名表, "team_task_update"), "含 team_task_update")

# =====================================================================
# 2. 参数 schema + 参数校验
# =====================================================================
段落 用例参数校验:
  设 模式 为 spawn_teammate模式()
  断言相等(模式["required"], ["name", "description", "prompt"], "spawn required 三项")
  # 缺 name -> 校验报错
  设 错表 为 校验参数(模式, {"description": "d", "prompt": "p"})
  断言真(列表长度(错表) > 0, "缺 name 校验报错")
  # 合法全字段 -> 无错
  设 错表2 为 校验参数(模式, {"name": "w1", "description": "d", "prompt": "p", "context": "fresh"})
  断言相等(列表长度(错表2), 0, "合法 spawn 无错")
  # context 非法值 -> enum 报错
  设 错表3 为 校验参数(模式, {"name": "w1", "description": "d", "prompt": "p", "context": "weird"})
  断言真(列表长度(错表3) > 0, "context 非法 enum 报错")
  # send_message required
  设 错表4 为 校验参数(send_message模式(), {"target": "lead"})
  断言真(列表长度(错表4) > 0, "send_message 缺 message 报错")
  # team_task_update action 非法 enum 报错
  设 错表5 为 校验参数(team_task_update模式(), {"task_id": "a", "expected_revision": 1, "action": "fly"})
  断言真(列表长度(错表5) > 0, "update action 非法 enum 报错")
  # action=claim 合法
  设 错表6 为 校验参数(team_task_update模式(), {"task_id": "a", "expected_revision": 1, "action": "claim"})
  断言相等(列表长度(错表6), 0, "update action=claim 无错")

# =====================================================================
# 3. wait_agent 纯逻辑
# =====================================================================
段落 用例等待纯逻辑:
  断言相等(解析等待超时({}), 30000, "缺省 timeout_ms=30000")
  断言相等(解析等待超时({"timeout_ms": 60000}), 60000, "显式 timeout_ms")
  断言真(判等待超时合法(30000), "30000 合法")
  断言真(判等待超时合法(10000), "10000 下界合法")
  断言真(判等待超时合法(3600000), "3600000 上界合法")
  断言真(判等待超时合法(5000) == 假, "5000 越下界非法")
  断言真(判等待超时合法(4000000) == 假, "4000000 越上界非法")
  断言真(判等待超时合法("30000") == 假, "字符串非法")
  断言真(是否活跃等待状态("running"), "running 活跃")
  断言真(是否活跃等待状态("provisioning"), "provisioning 活跃")
  断言真(是否活跃等待状态("idle") == 假, "idle 不活跃")
  # 有无活跃等待伙伴：调用者 lead 之外
  设 成员表 为 [{"id": "lead", "status": "running"}, {"id": "child-a", "status": "running"}]
  断言真(有无活跃等待伙伴(成员表, "lead"), "有活跃伙伴")
  设 成员表2 为 [{"id": "lead", "status": "running"}, {"id": "child-a", "status": "idle"}]
  断言真(有无活跃等待伙伴(成员表2, "lead") == 假, "无活跃伙伴")

# =====================================================================
# 4. wait_agent 执行面短路
# =====================================================================
段落 用例等待执行面:
  # 无活跃伙伴 -> noProgress 短路
  设 能力 为 {"listMembers": 假列成员空闲, "callerId": 假调用者标识, "waitForChange": 假等待}
  设 面 为 新建 团队工具面(能力)
  设 结果 为 面.等待执行({})
  断言相等(结果["timedOut"], 假, "无活跃伙伴 timedOut=假")
  断言相等(结果["noProgress"]["reason"], "no-active-peer", "noProgress.reason")
  断言真(字典包含键(结果["noProgress"], "message"), "noProgress.message 存在")
  # 有活跃伙伴 -> 交宿主等待（收到超时 30000）
  设 能力2 为 {"listMembers": 假列成员活跃, "callerId": 假调用者标识, "waitForChange": 假等待}
  设 面2 为 新建 团队工具面(能力2)
  设 结果2 为 面2.等待执行({})
  断言相等(结果2["timedOut"], 真, "有活跃伙伴走宿主等待")
  断言相等(结果2["收到超时"], 30000, "宿主收到超时 30000")
  # 超时不合法（5000）-> 直接交宿主等待，不走短路
  设 结果3 为 面2.等待执行({"timeout_ms": 5000})
  断言相等(结果3["收到超时"], 5000, "越界超时直交宿主")

# =====================================================================
# 5. team_task_list 过滤 + 分页
# =====================================================================
段落 用例列任务:
  设 任务表 为 假列任务()
  设 过滤后1 为 过滤团队任务(任务表, "pending", 空, 空)
  断言相等(列表长度(过滤后1), 1, "过滤 pending -> 1")
  设 过滤后2 为 过滤团队任务(任务表, 空, "lead", 空)
  断言相等(列表长度(过滤后2), 1, "过滤 owner=lead -> 1")
  设 过滤后3 为 过滤团队任务(任务表, 空, "unowned", 空)
  断言相等(列表长度(过滤后3), 2, "过滤 owner=unowned -> 2")
  # 执行面分页
  设 能力 为 {"listTasks": 假列任务}
  设 面 为 新建 团队工具面(能力)
  设 全量 为 面.列任务执行({})
  断言相等(列表长度(全量["tasks"]), 3, "全量 3 条")
  断言真(字典包含键(全量, "nextCursor") == 假, "全量无 nextCursor")
  设 页1 为 面.列任务执行({"limit": 2, "cursor": 0})
  断言相等(列表长度(页1["tasks"]), 2, "首页 2 条")
  断言相等(页1["nextCursor"], 2, "首页 nextCursor=2")
  设 页2 为 面.列任务执行({"limit": 2, "cursor": 2})
  断言相等(列表长度(页2["tasks"]), 1, "次页 1 条")
  断言真(字典包含键(页2, "nextCursor") == 假, "末页无 nextCursor")

# =====================================================================
# 6. 判分页 + 结果呈现
# =====================================================================
段落 段_负游标:
  设 占位 为 判分页(-1, 50)

段落 段_零上限:
  设 占位 为 判分页(0, 0)

段落 段_超上限:
  设 占位 为 判分页(0, 101)

段落 用例判分页与呈现:
  检查抛错("负游标抛", 段_负游标)
  检查抛错("limit=0 抛", 段_零上限)
  检查抛错("limit=101 抛", 段_超上限)
  设 文本块 为 渲染JSON文本({"timedOut": 真})
  断言相等(文本块[0]["type"], "text", "渲染 type=text")
  断言真(字符串长度(文本块[0]["text"]) > 0, "渲染 text 非空")

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  用例工具定义()
  用例参数校验()
  用例等待纯逻辑()
  用例等待执行面()
  用例列任务()
  用例判分页与呈现()
  写 "test_团队工具: 全部用例通过"

主程()
