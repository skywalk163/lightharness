# test_客户端深化.light —— 客户端 v2：重试执行 + 翻译异常
从 客户端 导入 重试执行, 翻译异常, 造失败

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ===== 重试执行：首次成功 =====
  打印 "=== 重试执行测试 ==="
  设 调用次数 为 [0]
  段落 成功函数:
    设 调用次数[0] 为 调用次数[0] + 1
    返回 "ok"
  设 结果1 为 重试执行(成功函数, 3)
  断言等于(结果1["成功"], 真, "首次成功")
  断言等于(结果1["结果"], "ok", "结果正确")
  断言等于(结果1["重试次数"], 0, "重试次数0")

  # ===== 重试执行：失败2次后成功 =====
  设 调用次数2 为 [0]
  段落 间歇失败函数:
    设 调用次数2[0] 为 调用次数2[0] + 1
    如果 调用次数2[0] < 3:
      抛出 "临时错误"
    返回 "最终ok"
  设 结果2 为 重试执行(间歇失败函数, 5)
  断言等于(结果2["成功"], 真, "失败2次后成功")
  断言等于(结果2["结果"], "最终ok", "最终结果正确")
  断言等于(结果2["重试次数"], 2, "重试次数2")

  # ===== 重试执行：全部失败 =====
  段落 总是失败函数:
    抛出 "永久错误"
  设 结果3 为 重试执行(总是失败函数, 2)
  断言等于(结果3["成功"], 假, "全部失败返回假")
  断言等于(结果3["重试次数"], 2, "重试次数=最大重试")

  # ===== 翻译异常 =====
  打印 "=== 翻译异常测试 ==="
  设 超时失败 为 翻译异常("connection timeout expired")
  断言等于(超时失败["代码"], "TIMEOUT", "超时映射TIMEOUT")

  设 认证失败 为 翻译异常("HTTP 401 Unauthorized")
  断言等于(认证失败["代码"], "AUTH_ERROR", "401映射AUTH_ERROR")

  设 限流失败 为 翻译异常("429 rate limit exceeded")
  断言等于(限流失败["代码"], "RATE_LIMIT", "429映射RATE_LIMIT")

  设 普通失败 为 翻译异常("connection refused")
  断言等于(普通失败["代码"], "NETWORK_ERROR", "普通错误映射NETWORK_ERROR")

  打印 "--- 客户端深化测试通过 ---"

主()
