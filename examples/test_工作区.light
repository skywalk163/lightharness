# test_工作区.light —— 工作区模块测试
# 覆盖：路径规范化、路径等同、工作区字段不变量、接入/脱离/迁移/查询情形、
#        会话归属校验、候选收集、注册表登记/注销/查找/缓存一致性invariant
#
# 反跑判据见文件末尾注释块。

从 工作区 导入 规范化路径, 判定路径等同, 校验会话归属, 收集候选会话, 构造工作区, 工作区描述, 注册表, 复制列表

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言失败(期望真): " + 标签)

段落 断言假 接收 条件, 标签:
  如果 条件 != 假:
    抛出 新建 错误("断言失败(期望假): " + 标签)

段落 目录恒存在 接收 路径:
  返回 真

段落 目录恒不存在 接收 路径:
  返回 假

# ===== 1. 路径规范化 =====
段落 测试路径规范化:
  断言相等(规范化路径("/a/b/"), "/a/b", "去尾斜杠")
  断言相等(规范化路径("/a/b/../c"), "/a/c", "解析 .. ")
  断言相等(规范化路径("/a/./b"), "/a/b", "跳过 .")
  断言相等(规范化路径("/a//b"), "/a/b", "跳过空段")
  断言相等(规范化路径("/"), "/", "根路径保持")
  断言相等(规范化路径("/a/b/../../c"), "/c", "连续 .. 回退到根下")
  断言相等(规范化路径("C:\\Users\\proj"), "/C:/Users/proj", "反斜杠归一")
  断言真(判定路径等同("/a/b/", "/a/b"), "尾斜杠不等价")
  断言真(判定路径等同("/a/b/../c", "/a/c"), ".. 归一后等同")
  断言假(判定路径等同("/a/b", "/a/c"), "不同路径不等同")

# ===== 2. 工作区创建与字段不变量 =====
段落 测试工作区字段:
  设 区 为 构造工作区("w1", "/home/user/proj1", "项目一", 1000)
  断言相等(区.标识, "w1", "标识字段")
  断言相等(区.路径, "/home/user/proj1", "路径字段已规范化")
  断言相等(区.标题, "项目一", "标题字段")
  断言相等(区.创建于, 1000, "创建于字段")
  断言相等(区.更新于, 1000, "更新于初始等于创建于")
  断言相等(区.计数会话(), 0, "初始会话数为0")
  设 抛了空标识 为 假
  尝试:
    设 空区 为 新建 工作区描述("", "/path", "标题", 1)
  捕获 异常 e:
    设 抛了空标识 为 真
  断言真(抛了空标识, "空标识应抛错")
  设 抛了空路径 为 假
  尝试:
    设 空路径区 为 新建 工作区描述("w0", "", "标题", 1)
  捕获 异常 e:
    设 抛了空路径 为 真
  断言真(抛了空路径, "空路径应抛错")

# ===== 3. 接入/脱离/迁移/查询情形 =====
段落 测试状态迁移:
  设 区 为 构造工作区("w1", "/home/user/proj1", "项目一", 1000)
  区.接入会话("s1")
  断言相等(区.计数会话(), 1, "接入1个会话后计数")
  断言真(区.判定归属("s1"), "判定归属 s1 为真")
  断言假(区.判定归属("s2"), "判定归属 s2 为假")
  区.接入会话("s2")
  区.接入会话("s3")
  断言相等(区.计数会话(), 3, "接入3个会话后计数")
  断言真(区.更新于 > 1000, "接入后更新于应推进")
  设 抛了重复接入 为 假
  尝试:
    区.接入会话("s1")
  捕获 异常 e:
    设 抛了重复接入 为 真
  断言真(抛了重复接入, "重复接入 s1 应抛错")
  区.脱离会话("s2")
  断言相等(区.计数会话(), 2, "脱离 s2 后计数")
  断言假(区.判定归属("s2"), "脱离后 s2 不再归属")
  断言真(区.判定归属("s1"), "s1 仍在")
  设 抛了脱离不存在 为 假
  尝试:
    区.脱离会话("sX")
  捕获 异常 e:
    设 抛了脱离不存在 为 真
  断言真(抛了脱离不存在, "脱离不存在会话应抛错")
  区.迁移会话("s3", 0)
  设 情形0 为 区.查询情形(空)
  断言相等(情形0["会话标识表"][0], "s3", "迁移后 s3 在首位")
  断言相等(情形0["会话标识表"][1], "s1", "迁移后 s1 在次位")
  区.迁移会话("s3", 99)
  设 情形1 为 区.查询情形(空)
  断言相等(情形1["会话标识表"][1], "s3", "迁移到末尾后 s3 在最后位")
  设 抛了迁移不存在 为 假
  尝试:
    区.迁移会话("sX", 0)
  捕获 异常 e:
    设 抛了迁移不存在 为 真
  断言真(抛了迁移不存在, "迁移不存在会话应抛错")

# ===== 4. 查询情形与会话归属校验 =====
段落 测试查询与归属:
  设 区 为 构造工作区("w1", "/home/user/proj1", "项目一", 1000)
  区.接入会话("s1")
  区.接入会话("s2")
  设 情形 为 区.查询情形(目录恒存在)
  断言相等(情形["标识"], "w1", "情形标识")
  断言相等(情形["路径"], "/home/user/proj1", "情形路径")
  断言相等(情形["会话数"], 2, "情形会话数")
  断言真(情形["目录存在"], "情形目录存在(恒存在投影)")
  断言相等(列表长度(情形["会话标识表"]), 2, "情形会话标识表长度")
  设 情形不存在 为 区.查询情形(目录恒不存在)
  断言假(情形不存在["目录存在"], "情形目录不存在(恒不存在投影)")
  设 原表备份 为 复制列表(情形["会话标识表"])
  设 修改后 为 情形["会话标识表"]
  列表追加(修改后, "sZ")
  断言相等(区.计数会话(), 2, "修改情形副本不影响原工作区")
  区.刷新戳(9999)
  断言相等(区.更新于, 9999, "刷新戳后更新于")
  设 头1 为 ["cwd": "/home/user/proj1"]
  断言真(校验会话归属(头1, "/home/user/proj1", 目录恒存在), "cwd 匹配且目录存在")
  断言假(校验会话归属(头1, "/home/user/proj2", 目录恒存在), "cwd 不匹配")
  断言假(校验会话归属(头1, "/home/user/proj1", 目录恒不存在), "目录不存在")
  设 头无cwd 为 ["name": "s1"]
  断言假(校验会话归属(头无cwd, "/home/user/proj1", 目录恒存在), "无 cwd 字段")
  设 头尾斜杠 为 ["cwd": "/home/user/proj1/"]
  断言真(校验会话归属(头尾斜杠, "/home/user/proj1", 空), "尾斜杠归一后匹配")
  设 会话表 为 [["cwd": "/home/user/proj1"], ["cwd": "/home/user/proj2"], ["cwd": "/home/user/proj1/"]]
  设 候选 为 收集候选会话(会话表, "/home/user/proj1", 空)
  断言相等(列表长度(候选), 2, "候选会话数(含尾斜杠归一)")

# ===== 5. 注册表：登记/查找/注销 =====
段落 测试注册表基础:
  设 表 为 新建 注册表()
  设 区A 为 构造工作区("wa", "/proj/a", "A", 100)
  设 区B 为 构造工作区("wb", "/proj/b", "B", 200)
  表.登记(区A)
  表.登记(区B)
  断言相等(表.查找("wa").标识, "wa", "按标识查找 wa")
  断言相等(表.查找("wb").标题, "B", "按标识查找 wb 标题")
  断言相等(表.按路径查找("/proj/a").标识, "wa", "按路径查找 wa")
  断言相等(表.按路径查找("/proj/a/").标识, "wa", "按路径查找(尾斜杠归一) wa")
  断言相等(表.查找("wX"), 空, "查找不存在的标识返回空")
  断言相等(列表长度(表.汇集清单()), 2, "注册表清单数量")
  设 抛了重复标识 为 假
  尝试:
    设 区A2 为 构造工作区("wa", "/proj/c", "A2", 300)
    表.登记(区A2)
  捕获 异常 e:
    设 抛了重复标识 为 真
  断言真(抛了重复标识, "重复标识应抛错")
  设 抛了重复路径 为 假
  尝试:
    设 区C 为 构造工作区("wc", "/proj/a", "C", 400)
    表.登记(区C)
  捕获 异常 e:
    设 抛了重复路径 为 真
  断言真(抛了重复路径, "重复路径(归一后)应抛错")
  表.注销("wa")
  断言相等(表.查找("wa"), 空, "注销后查找返回空")
  断言相等(表.按路径查找("/proj/a"), 空, "注销后按路径查找返回空")
  断言相等(列表长度(表.汇集清单()), 1, "注销后清单数量")
  设 抛了注销不存在 为 假
  尝试:
    表.注销("wX")
  捕获 异常 e:
    设 抛了注销不存在 为 真
  断言真(抛了注销不存在, "注销不存在标识应抛错")

# ===== 6. 注册表：缓存一致性 invariant =====
段落 测试缓存一致:
  设 表 为 新建 注册表()
  设 区A 为 构造工作区("wa", "/proj/a", "A", 100)
  设 区B 为 构造工作区("wb", "/proj/b", "B", 200)
  表.登记(区A)
  表.登记(区B)
  断言真(表.校验一致(), "正常状态 invariant 通过")
  设 区D 为 构造工作区("wd", "/proj/d", "D", 500)
  表.登记(区D)
  断言真(表.校验一致(), "多工作区 invariant 通过")
  字典删除(表.路径索引, "/proj/d")
  断言假(表.校验一致(), "路径索引缺失时 invariant 失败")
  字典设置(表.路径索引, "/proj/d", "wd")
  断言真(表.校验一致(), "恢复后 invariant 通过")
  字典删除(表.标识登记, "wd")
  断言假(表.校验一致(), "标识登记缺失时 invariant 失败")
  字典设置(表.标识登记, "wd", 区D)
  断言真(表.校验一致(), "恢复后 invariant 通过")
  字典设置(表.路径索引, "/proj/d", "wX")
  断言假(表.校验一致(), "路径索引指向错误标识时 invariant 失败")
  字典设置(表.路径索引, "/proj/d", "wd")
  断言真(表.校验一致(), "恢复后 invariant 通过")

段落 主:
  测试路径规范化()
  测试工作区字段()
  测试状态迁移()
  测试查询与归属()
  测试注册表基础()
  测试缓存一致()
  打印 "--- 工作区模块测试通过 ---"

# ===========================================================
# 反跑判据（手动改反确认真红再改回）
#
# 1. 路径规范化值改反：
#    把「断言相等(规范化路径("/a/b/../c"), "/a/c", ...)」
#    改为 断言相等(规范化路径("/a/b/../c"), "/a/b/c", ...)
#    期望值 "/a/c" 改为 "/a/b/c"（真->假），测试必须红。
#
# 2. 路径等同判定改反：
#    把「断言真(判定路径等同("/a/b/", "/a/b"), ...)」
#    改为 断言假(判定路径等同("/a/b/", "/a/b"), ...)
#    真->假，测试必须红。
#
# 3. 接入重复会话抛->不抛：
#    把「断言真(抛了重复接入, "重复接入 s1 应抛错")」
#    改为 断言假(抛了重复接入, ...)
#    抛->不抛，测试必须红。
#
# 4. 脱离不存在会话抛->不抛：
#    把「断言真(抛了脱离不存在, ...)」
#    改为 断言假(抛了脱离不存在, ...)
#    抛->不抛，测试必须红。
#
# 5. 迁移后顺序改反：
#    把「断言相等(情形0["会话标识表"][0], "s3", ...)」
#    改为 断言相等(情形0["会话标识表"][0], "s1", ...)
#    值"s3"->"s1"（值->他值），测试必须红。
#
# 6. 会话计数改反：
#    把「断言相等(区.计数会话(), 2, "脱离 s2 后计数")」
#    改为 断言相等(区.计数会话(), 3, ...)
#    值 2->3（值->他值），测试必须红。
#
# 7. 缓存一致性 invariant 真->假：
#    把「断言真(表.校验一致(), "正常状态 invariant 通过")」
#    改为 断言假(表.校验一致(), ...)
#    真->假，测试必须红。
#
# 8. 路径索引缺失时 invariant 假->真：
#    把「断言假(表.校验一致(), "路径索引缺失时 invariant 失败")」
#    改为 断言真(表.校验一致(), ...)
#    假->真，测试必须红。
#
# 9. 会话归属判定真->假：
#    把「断言真(校验会话归属(头1, "/home/user/proj1", 目录恒存在), ...)」
#    改为 断言假(校验会话归属(头1, "/home/user/proj1", 目录恒存在), ...)
#    真->假，测试必须红。
# ===========================================================

主()
