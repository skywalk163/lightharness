# =====================================================================
# 反跑 3：模型对象闸
# =====================================================================
段落 反跑_模型_空_运算:
  设 请求 为 造请求()
  设 请求["model"] 为 空
  建会话(请求)

段落 反跑_模型_列表_运算:
  设 请求 为 造请求()
  设 请求["model"] 为 []
  建会话(请求)

段落 反跑_模型闸:
  设 上下文 为 造上下文()
  检查抛码("反跑_模型_空", "WEBHOOK_MODEL_NOT_OBJECT", 反跑_模型_空_运算)
  断言相等(长度(调用), 0, "反跑_模型闸: 空 model 零副作用（早于默认模型咨询）")
  设 上下文 为 造上下文()
  检查抛码("反跑_模型_列表", "WEBHOOK_MODEL_NOT_OBJECT", 反跑_模型_列表_运算)
  设 上下文 为 造上下文()
  设 好请求 为 造请求()
  设 好请求["model"] 为 {"provider": "p", "model": "m"}
  建会话(好请求)
  断言相等(列表包含(调用, "followup"), 真, "反跑_模型闸: 合法模型放行")

# =====================================================================
# 反跑 4：maxTokens 闸
# =====================================================================
段落 反跑_令牌_零_运算:
  设 请求 为 造请求()
  设 请求["model"] 为 {"provider": "p", "model": "m", "maxTokens": 0}
  建会话(请求)

段落 反跑_令牌_负_运算:
  设 请求 为 造请求()
  设 请求["model"] 为 {"provider": "p", "model": "m", "maxTokens": -5}
  建会话(请求)

段落 反跑_令牌_非整_运算:
  设 请求 为 造请求()
  设 请求["model"] 为 {"provider": "p", "model": "m", "maxTokens": 1.5}
  建会话(请求)

段落 反跑_令牌闸:
  设 上下文 为 造上下文()
  检查抛码("反跑_令牌_零", "WEBHOOK_MAX_TOKENS_NOT_POSITIVE", 反跑_令牌_零_运算)
  设 上下文 为 造上下文()
  检查抛码("反跑_令牌_负", "WEBHOOK_MAX_TOKENS_NOT_POSITIVE", 反跑_令牌_负_运算)
  设 上下文 为 造上下文()
  检查抛码("反跑_令牌_非整", "WEBHOOK_MAX_TOKENS_NOT_SAFE", 反跑_令牌_非整_运算)
  设 上下文 为 造上下文()
  设 好请求 为 造请求()
  设 好请求["model"] 为 {"provider": "p", "model": "m", "maxTokens": 7}
  建会话(好请求)
  断言相等(列表包含(调用, "followup"), 真, "反跑_令牌闸: 正安全整数放行")

# =====================================================================
# 反跑 5：必填字符串闸
# =====================================================================
段落 反跑_必填_非对象_运算:
  建会话(空)

段落 反跑_必填_空标题_运算:
  设 请求 为 造请求()
  设 请求["title"] 为 " "
  建会话(请求)

段落 反跑_必填_空提示_运算:
  设 请求 为 造请求()
  设 请求["prompt"] 为 ""
  建会话(请求)

段落 反跑_必填_空代理预设_运算:
  设 请求 为 造请求()
  设 请求["agentPreset"] 为 ""
  建会话(请求)

段落 反跑_必填_空权限预设_运算:
  设 请求 为 造请求()
  设 请求["permissionPreset"] 为 ""
  建会话(请求)

段落 反跑_必填闸:
  设 上下文 为 造上下文()
  检查抛码("反跑_必填_非对象", "WEBHOOK_REQUEST_NOT_OBJECT", 反跑_必填_非对象_运算)
  断言相等(长度(调用), 0, "反跑_必填闸: 非对象请求零副作用")
  设 上下文 为 造上下文()
  检查抛码("反跑_必填_空标题", "WEBHOOK_FIELD_EMPTY", 反跑_必填_空标题_运算)
  设 上下文 为 造上下文()
  检查抛码("反跑_必填_空提示", "WEBHOOK_FIELD_EMPTY", 反跑_必填_空提示_运算)
  设 上下文 为 造上下文()
  检查抛码("反跑_必填_空代理预设", "WEBHOOK_FIELD_EMPTY", 反跑_必填_空代理预设_运算)
  设 上下文 为 造上下文()
  检查抛码("反跑_必填_空权限预设", "WEBHOOK_FIELD_EMPTY", 反跑_必填_空权限预设_运算)
  设 上下文 为 造上下文()
  检查抛码("必填_非字符串", "WEBHOOK_FIELD_NOT_STRING", 反跑_必填_非字符串_运算)
  断言相等(必填字符串({"title": "  x  "}, "title"), "  x  ", "必填: 仅去空白判定不改写原值")

段落 反跑_必填_非字符串_运算:
  设 请求 为 造请求()
  设 请求["title"] 为 42
  建会话(请求)

# =====================================================================
# 反跑 6：回滚闸（挂载成功后失败必 detach + dispose）
# =====================================================================
段落 反跑_回滚闸:
  遍历 点 之 ["permission-set", "title", "followup"]:
    设 上下文 为 造上下文()
    设 假槽["失败点"] 为 点
    设 抛了 为 假
    尝试:
      建会话(造请求())
    捕获 异常 为 e:
      设 抛了 为 真
    断言相等(抛了, 真, "反跑_回滚_" + 点 + ": 必抛")
    断言相等(列表包含(调用, "detach"), 真, "反跑_回滚_" + 点 + ": 必摘除会话")
    断言相等(列表包含(调用, "dispose"), 真, "反跑_回滚_" + 点 + ": 必销毁句柄")

# =====================================================================
# 反跑 7：原错保留 + 回滚失败上报
# =====================================================================
段落 反跑_原错_运算:
  全局 当前上下文
  返回 创建Webhook会话(当前上下文, 造投递(), "review", 造请求(), 假槽["信号"])

段落 反跑_原错闸:
  全局 假槽
  设 上下文 为 造上下文()
  设 假槽["失败点"] 为 "title"
  设 假槽["摘除失败"] 为 真
  设 假槽["销毁失败"] 为 真
  设 抛了 为 假
  设 文 为 ""
  尝试:
    反跑_原错_运算()
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  断言相等(抛了, 真, "反跑_原错闸: 必抛")
  断言相等(字符串包含(文, "title failed"), 真, "反跑_原错闸: 抛的是原始错误")
  断言相等(长度(警告表), 2, "反跑_原错闸: 回滚失败上报 2 条")
  断言相等(字符串包含(警告表[0], "Workspace detach for Session"), 真, "反跑_原错闸: 首条为摘除回滚")
  断言相等(字符串包含(警告表[0], "rollback failed: detach failed"), 真, "反跑_原错闸: 摘除回滚文案")
  断言相等(字符串包含(警告表[1], "Agent disposal for Session"), 真, "反跑_原错闸: 次条为销毁回滚")
  断言相等(字符串包含(警告表[1], "rollback failed: dispose failed"), 真, "反跑_原错闸: 销毁回滚文案")

# =====================================================================
# 反跑 8：中止闸
# =====================================================================
段落 反跑_中止_信号_运算:
  检查未中止(中止信号("abort after workspace"))

段落 反跑_中止闸:
  全局 假槽
  检查抛码("反跑_中止_信号", "WEBHOOK_ABORTED", 反跑_中止_信号_运算)
  断言相等(字符串包含("x", "x"), 真, "反跑_中止闸: 存活信号不抛")
  设 上下文 为 造上下文()
  设 假槽["中止点"] 为 "workspace"
  设 抛了 为 假
  尝试:
    建会话(造请求())
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "反跑_中止闸: 工作区后中止必抛")
  断言相等(列表包含(调用, "followup"), 假, "反跑_中止闸: 未注入提示")
  断言相等(列表包含(调用, "dispose"), 假, "反跑_中止闸: 句柄未创建故不销毁")
  设 上下文 为 造上下文()
  设 假槽["中止点"] 为 "agent"
  设 抛了 为 假
  尝试:
    建会话(造请求())
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "反跑_中止闸: 代理后中止必抛")
  断言相等(列表包含(调用, "dispose"), 真, "反跑_中止闸: 代理后中止销毁句柄")
  断言相等(列表包含(调用, "detach"), 假, "反跑_中止闸: 未挂载故不摘除")
  断言相等(列表包含(调用, "followup"), 假, "反跑_中止闸: 代理后中止未注入")

# =====================================================================
# 反跑 9：种类闸（异种类不派发；一条抛错不阻断兄弟）
# =====================================================================
段落 反跑_种类闸:
  全局 规则调用
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "a", "kind": "fixture", "run": 规则记录})
  注册({"id": "b", "kind": "other", "run": 规则记录})
  注册({"id": "c", "kind": "fixture", "run": 规则抛错})
  派发(造夹具投递())
  断言相等(长度(规则调用), 2, "反跑_种类闸: 异种类被跳过")
  断言相等(规则调用[0], "记录", "反跑_种类闸: a 先执行")
  断言相等(规则调用[1], "抛错", "反跑_种类闸: c 兄弟不受影响")
  断言相等(长度(警告表), 1, "反跑_种类闸: 单条失败被收敛")

# =====================================================================
# 反跑 10：快照闸（detach + 冻结；快照投递 不深复刻即红）
# =====================================================================
段落 反跑_快照闸:
  全局 规则收到
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "r", "kind": "fixture", "run": 规则记录})
  设 原 为 造夹具投递()
  派发(原)
  设 原["event"]["value"] 为 2
  设 收到 为 规则收到[0]
  断言相等(收到["event"]["value"], 1, "反跑_快照闸: 规则看到派发时刻的旧值")
  断言相等(是冻结(收到), 真, "反跑_快照闸: 快照带冻结标记")
  断言相等(收到 != 原, 真, "反跑_快照闸: 快照非原对象")
  设 直接 为 快照投递(造夹具投递())
  断言相等(是冻结(直接), 真, "反跑_快照闸: 快照投递 直接调用亦冻结")

# =====================================================================
# 反跑 11：去重闸（原版故意不去重；派发 加去重即红）
# =====================================================================
段落 反跑_去重闸:
  全局 规则调用
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "repeat", "kind": "fixture", "run": 规则记录})
  设 投 为 造夹具投递()
  派发(投)
  派发(投)
  断言相等(长度(规则调用), 2, "反跑_去重闸: 同一投递触发 2 次（不去重）")
  断言相等(是冻结(规则收到[0]), 真, "反跑_去重闸: 第一次快照已冻结")
  断言相等(是冻结(规则收到[1]), 真, "反跑_去重闸: 第二次快照已冻结")
  设 规则收到[0]["event"]["value"] 为 99
  断言相等(规则收到[1]["event"]["value"], 1, "反跑_去重闸: 两次派发快照互不相干")
  断言相等(投["event"]["value"], 1, "反跑_去重闸: 原投递未被回写")

# =====================================================================
# 反跑 12：不变式闸
# =====================================================================
段落 反跑_不变式闸:
  设 会话 为 造准入会话("attached", "/workspace")
  设 一区 为 [{"path": "/workspace", "sessionIds": ["attached"]}]
  设 零区 为 [{"path": "/workspace", "sessionIds": []}]
  设 双区 为 [{"path": "/workspace", "sessionIds": ["attached"]}, {"path": "/workspace", "sessionIds": ["attached"]}]
  设 异区 为 [{"path": "/other", "sessionIds": ["attached"]}]
  设 无cwd 为 造准入会话("no-cwd", 空)
  断言相等(字符串包含(校验Webhook准入(无cwd, 造插入事件("webhook"), 一区), "has no cwd"), 真, "反跑_不变式: 缺 cwd")
  断言相等(字符串包含(校验Webhook准入(无cwd, 造插入事件("webhook"), 一区), "WEBHOOK_INVARIANT_NO_CWD"), 真, "反跑_不变式: 缺 cwd 码")
  断言相等(字符串包含(校验Webhook准入(会话, 造插入事件("webhook"), 零区), "belongs to 0 Workspaces"), 真, "反跑_不变式: 0 归属")
  断言相等(字符串包含(校验Webhook准入(会话, 造插入事件("webhook"), 双区), "belongs to 2 Workspaces"), 真, "反跑_不变式: 2 归属")
  断言相等(字符串包含(校验Webhook准入(会话, 造插入事件("webhook"), 异区), "differs from its Workspace path"), 真, "反跑_不变式: 路径不符")
  断言相等(字符串包含(校验Webhook准入(会话, 造插入事件("webhook"), 异区), "\"/workspace\""), 真, "反跑_不变式: 路径用 JSON 引号渲染")
  断言相等(校验Webhook准入(会话, 造插入事件("webhook"), 一区), "", "反跑_不变式: 正常归属放行")

# =====================================================================
# 反跑 13：注册闸（空 id / 空 kind / 缺 run / 重复）
# =====================================================================
段落 反跑_注册_空id_运算:
  注册({"id": "", "kind": "fixture", "run": 规则记录})

段落 反跑_注册_空kind_运算:
  注册({"id": "bad-kind", "kind": "", "run": 规则记录})

段落 反跑_注册_缺run_运算:
  注册({"id": "bad-run", "kind": "fixture", "run": 1})

段落 反跑_注册_重复_运算:
  注册({"id": "same", "kind": "fixture", "run": 规则记录})

段落 反跑_注册闸:
  设 上下文 为 造上下文()
  造运行时(上下文)
  检查抛码("反跑_注册_空id", "WEBHOOK_RULE_ID_EMPTY", 反跑_注册_空id_运算)
  检查抛码("反跑_注册_空kind", "WEBHOOK_RULE_KIND_EMPTY", 反跑_注册_空kind_运算)
  检查抛码("反跑_注册_缺run", "WEBHOOK_RULE_RUN_MISSING", 反跑_注册_缺run_运算)
  断言相等(长度(取规则号表()), 0, "反跑_注册闸: 非法注册未落表")
  设 号 为 注册({"id": "same", "kind": "fixture", "run": 规则记录})
  断言相等(号, "same", "反跑_注册闸: 注册返回规则号")
  检查抛码("反跑_注册_重复", "WEBHOOK_RULE_DUPLICATE", 反跑_注册_重复_运算)
  回收("same")
  设 号二 为 注册({"id": "same", "kind": "fixture", "run": 规则记录})
  断言相等(号二, "same", "反跑_注册闸: 回收后可重注册")
  断言相等(取登记("same")["关闭中"], 假, "反跑_注册闸: 重注册登记为活跃")

# =====================================================================
# 反跑 14：关闭闸
# =====================================================================
段落 反跑_关闭派发_运算:
  派发(造夹具投递())

段落 反跑_关闭注册_运算:
  注册({"id": "late", "kind": "fixture", "run": 规则记录})

段落 反跑_关闭闸:
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "r", "kind": "fixture", "run": 规则记录})
  断言相等(是运行时关闭(), 假, "反跑_关闭闸: 关闭前活跃")
  关闭运行时()
  断言相等(是运行时关闭(), 真, "反跑_关闭闸: 关闭后标记")
  检查抛码("反跑_关闭派发", "WEBHOOK_RUNTIME_CLOSING", 反跑_关闭派发_运算)
  检查抛码("反跑_关闭注册", "WEBHOOK_RUNTIME_CLOSING", 反跑_关闭注册_运算)

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  全局 调用, 消息表, 监听表, 警告表, 调试表, 假槽, 序号, 当前上下文, 规则调用, 规则收到
  用例_品牌()
  用例_判定助手()
  用例_助手()
  用例_解析请求()
  用例_主流程()
  用例_模型监听()
  用例_失败收敛()
  用例_运行时()
  用例_回收关闭()
  用例_不变式()
  反跑_投递闸()
  反跑_路径闸()
  反跑_模型闸()
  反跑_令牌闸()
  反跑_必填闸()
  反跑_回滚闸()
  反跑_原错闸()
  反跑_中止闸()
  反跑_种类闸()
  反跑_快照闸()
  反跑_去重闸()
  反跑_不变式闸()
  反跑_注册闸()
  反跑_关闭闸()
  打印 "--- 测试webhook会话 通过 ---"

主程()
