# test_webhook会话.light —— 对标 #71：webhook 会话构建纯逻辑反跑测试
# 原版：packages/webhook/webhook/src/{index.ts, session.ts, types.ts, invariant.ts, brand.ts}
# 用例对齐：tests/runtime.spec.ts、tests/session.spec.ts、tests/invariant.spec.ts
#
# 反跑判据（改反必须红，全部实测过）：
#   1) 投递闸 —— 反跑_投递闸：kind/source/deliveryId 空串、receivedAt 负、event 非无损 JSON
#      5 种畸形投递必抛；删掉 快照投递 里任一 抛出 闸即红。
#   2) 路径闸 —— 反跑_路径闸：相对路径必抛 [WEBHOOK_PATH_NOT_ABSOLUTE]，绝对路径必放行；
#      删掉该 抛出 闸即红。
#   3) 模型闸 —— 反跑_模型闸：model 为 空 必抛 [WEBHOOK_MODEL_NOT_OBJECT]；删掉该闸即红。
#   4) 令牌闸 —— 反跑_令牌闸：maxTokens 为 0 / -1 / 1.5 必抛；删掉该闸即红。
#   5) 必填闸 —— 反跑_必填闸：非对象请求、title 空白、prompt 空、agentPreset 空、
#      permissionPreset 空 必抛；删掉 必填字符串 的 抛出 即红。
#   6) 回滚闸 —— 反跑_回滚闸：permission-set/title/followup 失败必触发 detach + dispose；
#      删掉 回滚摘除 / 回滚销毁 调用即红。
#   7) 原错闸 —— 反跑_原错闸：title 失败 + 双重回滚失败仍抛 'title failed' 且 warn 记 2 条；
#      把 catch 里的 `抛出 e` 换成别的错、或回滚失败不上报即红。
#   8) 中止闸 —— 反跑_中止闸：检查未中止 遇已中止信号必抛；删掉该 抛出 即红。
#   9) 种类闸 —— 反跑_种类闸：异种类规则不被调用、一条抛错不影响兄弟；去掉 kind 比较即红。
#  10) 快照闸 —— 反跑_快照闸：派发后篡改原投递，规则看到的仍是旧值且快照被冻结；
#      快照投递 直接返回入参（不深复刻）即红。
#  11) 去重闸 —— 反跑_去重闸：同一投递派发两次 → 规则调用 2 次（原版故意不去重）；
#      派发 里加去重即红。
#  12) 不变式闸 —— 反跑_不变式闸：缺 cwd / 0 归属 / 2 归属 / 路径不符 四类必报错；
#      把 no-cwd 闸的返回值改成 "" 即红。
#
# 语言坑规避：
#   - `断言(条件,标签)` 降级 no-op（L-037），一律 断言相等 / 检查抛码。
#   - 写/打印 只吃字面量串（L-055）；本文件诊断全走 抛出 新建 错误。
#   - 字面量一律单行（L-051）；嵌套字面量内不写 \n（L-054）。
#   - 缺键访问先 字典包含键 守卫（L-036/L-041）。
#   - 无闭包：抛错场景与零参运算走「具名段落 + 全局槽位」。
#   - 主程 必须显式在文件末尾调用（运行.py 不会自动调）。

从 webhook会话 导入 规则标识, 来源标识, 投递标识
从 webhook会话 导入 是安全整数, 是绝对路径, 是可调用, 可无损JSON, 深复刻, 深冻结, 是冻结
从 webhook会话 导入 绑定上下文摘要, 取错误文本, 错误链, 造用户消息, 造投递来源
从 webhook会话 导入 检查未中止, 中止信号, 存活信号, 必填字符串, 解析请求
从 webhook会话 导入 创建Webhook会话, 快照投递
从 webhook会话 导入 造运行时, 取规则号表, 取登记, 是运行时关闭, 注册, 造调用标签, 派发, 回收, 关闭运行时
从 webhook会话 导入 校验Webhook准入, 内部派发检查, 上下文摘要上限
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 开头, 字符串包含, 截取
从 内置核心判型 导入 是字典, 是列表, 是字符串, 是整数
从 内置核心列表 导入 列表追加, 列表包含
从 内置核心字典 导入 字典包含键, 字典键列表

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛码 接收 标签, 码, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常 为 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, "[" + 码 + "]") == 假):
    抛出 新建 错误("错误码不符[" + 标签 + "]：实际=" + 文 + " 期望码=" + 码)

# =====================================================================
# 全局观察槽（宿主能力调用记录）
# =====================================================================
设 调用 为 []
设 消息表 为 []
设 监听表 为 {}
设 警告表 为 []
设 调试表 为 []
设 假槽 为 {}
设 序号 为 0
设 当前上下文 为 空
设 规则调用 为 []
设 规则收到 为 []
设 反跑号 为 ""

# =====================================================================
# 宿主假能力（对应 session.spec.ts 的 same-process fake）
# =====================================================================
段落 假日志警告 接收 文本:
  全局 警告表
  列表追加(警告表, 文本)

段落 假日志调试 接收 文本:
  全局 调试表
  列表追加(调试表, 文本)

段落 假权限解析 接收 名:
  全局 调用, 假槽
  列表追加(调用, "permission-resolve:" + 名)
  如果 (假槽["失败点"] == "permission-resolve"):
    抛出 新建 错误("permission resolve failed [PERM_RESOLVE]")
  返回 {}

段落 假权限设置 接收 会话, 名:
  全局 调用, 假槽
  列表追加(调用, "permission-set:" + 名)
  如果 (假槽["失败点"] == "permission-set"):
    抛出 新建 错误("permission set failed [PERM_SET]")
  返回 空

段落 假预设解析 接收 名:
  全局 调用, 假槽
  列表追加(调用, "preset-resolve:" + 名)
  如果 (假槽["失败点"] == "preset-resolve"):
    抛出 新建 错误("preset resolve failed [PRESET_RESOLVE]")
  返回 {"id": 名}

段落 假常驻键 接收 名:
  全局 调用, 假槽
  列表追加(调用, "standing:" + 名)
  如果 (假槽["失败点"] == "standing"):
    抛出 新建 错误("standing failed [STANDING]")
  返回 {}

段落 假预设挂载 接收 代理上下文, 名:
  全局 调用
  列表追加(调用, "mount:" + 名)
  返回 {"id": 名}

段落 假默认模型:
  全局 调用
  列表追加(调用, "default-model")
  返回 {"provider": "default-provider", "model": "default-model", "reasoningEffort": "high"}

段落 假挂载会话 接收 会话号:
  全局 调用, 假槽
  列表追加(调用, "attach")
  如果 (假槽["失败点"] == "attach"):
    抛出 新建 错误("attach failed [ATTACH]")
  返回 空

段落 假摘除会话 接收 会话号:
  全局 调用, 假槽
  列表追加(调用, "detach")
  如果 (假槽["摘除失败"] == 真):
    抛出 新建 错误("detach failed [DETACH]")
  返回 空

段落 假工作区创建 接收 路径:
  全局 调用, 假槽
  列表追加(调用, "workspace:" + 路径)
  如果 (假槽["失败点"] == "workspace"):
    抛出 新建 错误("workspace failed [WORKSPACE]")
  如果 (假槽["中止点"] == "workspace"):
    设 信 为 假槽["信号"]
    设 信["已中止"] 为 真
    设 信["原因"] 为 "abort after workspace"
  返回 {"path": 路径, "挂载会话": 假挂载会话, "摘除会话": 假摘除会话}

段落 假取请求头:
  全局 假槽
  返回 假槽["请求头"]

段落 假后继 接收 消息:
  全局 调用, 消息表, 假槽
  列表追加(调用, "followup")
  如果 (假槽["失败点"] == "followup"):
    抛出 新建 错误("followup failed [FOLLOWUP]")
  列表追加(消息表, 消息)
  返回 空

段落 假销毁:
  全局 调用, 假槽
  列表追加(调用, "dispose")
  如果 (假槽["销毁失败"] == 真):
    抛出 新建 错误("dispose failed [DISPOSE]")
  返回 空

段落 假监听 接收 代理上下文, 事件名, 监听器:
  全局 监听表
  设 监听表[事件名] 为 监听器
  返回 空

段落 假会话创建 接收 选项:
  全局 调用, 假槽, 假代理, 假句柄
  列表追加(调用, "agent-create")
  如果 (假槽["失败点"] == "agent"):
    抛出 新建 错误("agent failed [AGENT_CREATE]")
  设 代理上下文 为 {"agent": 假代理, "sessionId": 选项["sessionId"]}
  选项["setup"](代理上下文)
  如果 (假槽["中止点"] == "agent"):
    设 信 为 假槽["信号"]
    设 信["已中止"] 为 真
    设 信["原因"] 为 "abort after agent"
  返回 假句柄

段落 假改名 接收 会话, 标题:
  全局 调用, 假槽
  列表追加(调用, "title")
  如果 (假槽["失败点"] == "title"):
    抛出 新建 错误("title failed [TITLE_RENAME]")
  返回 {}

段落 假唯一标识:
  全局 序号
  设 序号 为 序号 + 1
  返回 "uuid-" + 转字符串(序号)

设 假会话 为 {"id": "webhook-session", "header": {"cwd": "/workspace"}, "requestHeader": 假取请求头}
设 假代理 为 {"session": 假会话, "followup": 假后继}
设 假句柄 为 {"agent": 假代理, "dispose": 假销毁}

段落 清假:
  全局 调用, 消息表, 监听表, 警告表, 调试表, 假槽, 序号, 规则调用, 规则收到
  设 调用 为 []
  设 消息表 为 []
  设 监听表 为 {}
  设 警告表 为 []
  设 调试表 为 []
  设 假槽 为 {"失败点": "", "摘除失败": 假, "销毁失败": 假, "中止点": "", "请求头": 空, "信号": 存活信号()}
  设 序号 为 0
  设 规则调用 为 []
  设 规则收到 为 []

段落 造上下文:
  全局 当前上下文
  清假
  设 上下文 为 {}
  设 上下文["日志警告"] 为 假日志警告
  设 上下文["日志调试"] 为 假日志调试
  设 上下文["权限预设解析"] 为 假权限解析
  设 上下文["权限预设设置"] 为 假权限设置
  设 上下文["代理预设解析"] 为 假预设解析
  设 上下文["代理预设常驻键"] 为 假常驻键
  设 上下文["代理预设挂载"] 为 假预设挂载
  设 上下文["默认模型"] 为 假默认模型
  设 上下文["工作区创建"] 为 假工作区创建
  设 上下文["会话创建"] 为 假会话创建
  设 上下文["会话标题改名"] 为 假改名
  设 上下文["唯一标识"] 为 假唯一标识
  设 上下文["监听"] 为 假监听
  设 当前上下文 为 上下文
  返回 上下文

# =====================================================================
# 固定夹具（对齐 session.spec.ts 的 delivery / request）
# =====================================================================
段落 造投递:
  返回 {"kind": "github", "source": "primary", "deliveryId": "delivery", "event": {"action": "ready_for_review"}, "receivedAt": 1}

段落 造夹具投递:
  返回 {"kind": "fixture", "source": "fixture-source", "deliveryId": "delivery-1", "event": {"value": 1}, "receivedAt": 1}

段落 造请求:
  返回 {"workspacePath": "/workspace", "title": "Review PR", "prompt": "Review it", "agentPreset": "standard", "permissionPreset": "read-only"}

段落 建会话 接收 请求:
  全局 假槽, 当前上下文
  返回 创建Webhook会话(当前上下文, 造投递(), "review", 请求, 假槽["信号"])

# =====================================================================
# 运行时假规则
# =====================================================================
段落 规则记录 接收 投递, 信号:
  全局 规则调用, 规则收到
  列表追加(规则调用, "记录")
  列表追加(规则收到, 投递)
  返回 空

段落 规则抛错 接收 投递, 信号:
  全局 规则调用
  列表追加(规则调用, "抛错")
  抛出 新建 错误("fixture failure [FIXTURE_FAIL]")

段落 规则建会话 接收 投递, 信号:
  全局 规则调用
  列表追加(规则调用, "建会话")
  返回 造请求()

段落 规则中止后抛 接收 投递, 信号:
  全局 规则调用
  列表追加(规则调用, "中止后抛")
  设 信号["已中止"] 为 真
  抛出 新建 错误("late failure [LATE_FAIL]")

# =====================================================================
# 模型监听的「下一步」夹具
# =====================================================================
段落 下一步_异供应方:
  返回 {"provider": "other-provider", "model": "default-model", "reasoningEffort": "other-provider-effort"}

段落 下一步_异模型:
  返回 {"provider": "default-provider", "model": "other-model", "reasoningEffort": "other-model-effort"}

段落 下一步_命中继承:
  返回 {"provider": "default-provider", "model": "default-model", "reasoningEffort": "inherited"}

段落 下一步_后期:
  返回 {"provider": "later-provider", "model": "later-model", "reasoningEffort": "later"}

段落 下一步_显式命中:
  返回 {"provider": "p", "model": "m", "reasoningEffort": "inherited"}

# =====================================================================
# 不变式夹具
# =====================================================================
段落 造准入会话 接收 会话号, 路径:
  设 会话 为 {}
  设 会话["id"] 为 会话号
  设 头 为 {}
  如果 (路径 != 空):
    设 头["cwd"] 为 路径
  设 会话["header"] 为 头
  返回 会话

段落 造插入事件 接收 来源种类:
  设 事件 为 {}
  设 事件["type"] 为 "agent/inbox/spliced"
  设 数据 为 {}
  设 插入 为 []
  设 消息 为 {}
  设 消息["source"] 为 {"kind": 来源种类}
  列表追加(插入, 消息)
  设 数据["inserted"] 为 插入
  设 事件["data"] 为 数据
  返回 事件

# =====================================================================
# 用例 1：brand.ts —— 不透明标识恒等投射
# =====================================================================
段落 用例_品牌:
  断言相等(规则标识("review"), "review", "品牌: 规则标识恒等")
  断言相等(来源标识("primary"), "primary", "品牌: 来源标识恒等")
  断言相等(投递标识("delivery-1"), "delivery-1", "品牌: 投递标识恒等")
  断言相等(规则标识(""), "", "品牌: 空串亦恒等（校验在注册期）")

# =====================================================================
# 用例 2：判定助手
# =====================================================================
段落 用例_判定助手:
  断言相等(是安全整数(0), 真, "安全整数: 0")
  断言相等(是安全整数(1), 真, "安全整数: 1")
  断言相等(是安全整数(-1), 真, "安全整数: -1")
  断言相等(是安全整数(9007199254740991), 真, "安全整数: 上界")
  断言相等(是安全整数(9007199254740992), 假, "安全整数: 越界")
  断言相等(是安全整数(1.5), 假, "安全整数: 非整")
  断言相等(是安全整数("1"), 假, "安全整数: 字符串")
  断言相等(是安全整数(空), 假, "安全整数: 空")

  断言相等(是绝对路径("/workspace"), 真, "绝对路径: POSIX")
  断言相等(是绝对路径("/"), 真, "绝对路径: 根")
  断言相等(是绝对路径("relative"), 假, "绝对路径: 相对")
  断言相等(是绝对路径(""), 假, "绝对路径: 空串")
  断言相等(是绝对路径("C:\\work"), 真, "绝对路径: 盘符反斜杠")
  断言相等(是绝对路径("C:/work"), 真, "绝对路径: 盘符正斜杠")
  断言相等(是绝对路径("1:/work"), 假, "绝对路径: 非盘符")
  断言相等(是绝对路径(空), 假, "绝对路径: 空")

  断言相等(是可调用(规则记录), 真, "可调用: 段落")
  断言相等(是可调用(1), 假, "可调用: 整数")
  断言相等(是可调用("x"), 假, "可调用: 字符串")
  断言相等(是可调用({}), 假, "可调用: 字典")
  断言相等(是可调用([]), 假, "可调用: 列表")
  断言相等(是可调用(空), 假, "可调用: 空")
  断言相等(是可调用(真), 假, "可调用: 布尔")

  断言相等(可无损JSON({"value": 1}), 真, "无损JSON: 简单对象")
  断言相等(可无损JSON({"a": [1, "x", {"b": 2}]}), 真, "无损JSON: 嵌套")
  断言相等(可无损JSON({"invalid": 空}), 假, "无损JSON: undefined 成员")
  断言相等(可无损JSON(空), 假, "无损JSON: 空")
  断言相等(可无损JSON(1), 真, "无损JSON: 整数")
  断言相等(可无损JSON("s"), 真, "无损JSON: 字符串")
  断言相等(可无损JSON(真), 真, "无损JSON: 布尔")
  设 环 为 {}
  设 环["self"] 为 环
  断言相等(可无损JSON(环), 假, "无损JSON: 环")

  设 原 为 {"event": {"value": 1}}
  设 复 为 深冻结(原)
  断言相等(是冻结(复), 真, "深冻结: 带冻结标记")
  断言相等(是冻结(原), 假, "深冻结: 原对象未冻结")
  设 原["event"]["value"] 为 2
  断言相等(复["event"]["value"], 1, "深冻结: 断共享引用")
  设 纯复 为 深复刻(原, 0)
  断言相等(纯复["event"]["value"], 2, "深复刻: 值一致")
  断言相等(字典包含键(纯复, "冻结"), 假, "深复刻: 不带冻结标记")

# =====================================================================
# 用例 3：dsh-llm 助手（摘要 / 错误链 / 用户消息 / 投递来源）
# =====================================================================
段落 用例_助手:
  断言相等(上下文摘要上限, 120, "摘要: 上限 120")
  断言相等(绑定上下文摘要("short"), "short", "摘要: 短串原样")
  设 长串 为 ""
  设 i 为 0
  当 (i < 130):
    设 长串 为 长串 + "a"
    设 i 为 i + 1
  设 摘 为 绑定上下文摘要(长串)
  断言相等(字符串长度(摘), 120, "摘要: 截断后长度 120")
  断言相等(结尾(摘, "…"), 真, "摘要: 以省略号收尾")
  断言相等(摘, 截取(长串, 0, 119) + "…", "摘要: 前 119 字 + 省略号")
  设 恰好 为 绑定上下文摘要(截取(长串, 0, 120))
  断言相等(字符串长度(恰好), 120, "摘要: 恰好 120 字不截断")

  断言相等(取错误文本({"message": "boom"}), "boom", "错误文本: 取 message")
  断言相等(取错误文本({"message": "", "name": "TypeError"}), "TypeError", "错误文本: 空 message 回退 name")
  断言相等(错误链({"message": "outer", "cause": {"message": "inner"}}), "outer: inner", "错误链: 两级")
  断言相等(错误链({"message": "same", "cause": {"message": "same"}}), "same", "错误链: 逐字重复去重")
  断言相等(错误链({"message": "only"}), "only", "错误链: 单级")
  设 三层 为 {"message": "a", "cause": {"message": "b", "cause": {"message": "c"}}}
  断言相等(错误链(三层), "a: b: c", "错误链: 三层")

  设 来 为 造投递来源(造投递(), "review")
  断言相等(来["kind"], "webhook", "来源: kind")
  断言相等(来["provider"], "github", "来源: provider")
  断言相等(来["source"], "primary", "来源: source")
  断言相等(来["deliveryId"], "delivery", "来源: deliveryId")
  断言相等(来["ruleId"], "review", "来源: ruleId")
  断言相等(来["form"], "notice", "来源: form")
  断言相等(来["summary"], "github webhook handled by review", "来源: summary")

  设 消息 为 造用户消息([{"type": "text", "text": "hi"}], 来, "msg-1")
  断言相等(消息["role"], "user", "用户消息: role")
  断言相等(消息["id"], "msg-1", "用户消息: id")
  断言相等(消息["content"][0]["text"], "hi", "用户消息: content")
  断言相等(消息["source"]["kind"], "webhook", "用户消息: source")

# =====================================================================
# 用例 4：请求解析（正向）
# =====================================================================
段落 用例_解析请求:
  设 上下文 为 造上下文()
  设 已解析 为 解析请求(上下文, 造请求())
  断言相等(已解析["workspacePath"], "/workspace", "解析: 路径")
  断言相等(已解析["title"], "Review PR", "解析: 标题")
  断言相等(已解析["prompt"], "Review it", "解析: 提示")
  断言相等(已解析["agentPreset"], "standard", "解析: 代理预设")
  断言相等(已解析["permissionPreset"], "read-only", "解析: 权限预设")
  断言相等(已解析["agentOptions"]["provider"], "default-provider", "解析: 默认 provider")
  断言相等(已解析["agentOptions"]["model"], "default-model", "解析: 默认 model")
  断言相等(字典包含键(已解析["agentOptions"], "maxTokens"), 假, "解析: 默认不带 maxTokens")
  断言相等(已解析["modelSelection"]["reasoningEffort"], "high", "解析: 默认带 reasoningEffort")
  断言相等(列表包含(调用, "default-model"), 真, "解析: 咨询默认模型")
  断言相等(长度(调用), 1, "解析: 仅 1 次宿主调用")

  设 上下文 为 造上下文()
  设 带模型 为 造请求()
  设 带模型["model"] 为 {"provider": "p", "model": "m", "maxTokens": 10}
  设 解二 为 解析请求(上下文, 带模型)
  断言相等(列表包含(调用, "default-model"), 假, "解析: 显式模型不查默认")
  断言相等(解二["agentOptions"]["provider"], "p", "解析: 显式 provider")
  断言相等(解二["agentOptions"]["model"], "m", "解析: 显式 model")
  断言相等(解二["agentOptions"]["maxTokens"], 10, "解析: maxTokens=10")
  断言相等(字典包含键(解二["modelSelection"], "reasoningEffort"), 假, "解析: 显式选择无 reasoningEffort")

  设 上下文 为 造上下文()
  设 无上限 为 造请求()
  设 无上限["model"] 为 {"provider": "p", "model": "m"}
  设 解三 为 解析请求(上下文, 无上限)
  断言相等(字典包含键(解三["agentOptions"], "maxTokens"), 假, "解析: 无上限不带 maxTokens")

  设 上下文 为 造上下文()
  断言相等(字典包含键(解析请求(上下文, 造请求()), "model"), 假, "解析: 结果不含 model 键")

# =====================================================================
# 用例 5：创建会话主流程（对齐 session.spec 的调用序列）
# =====================================================================
段落 用例_主流程:
  设 上下文 为 造上下文()
  设 会话号 为 建会话(造请求())
  断言相等(开头(会话号, "webhook-"), 真, "主流程: 会话号前缀")
  断言相等(会话号, "webhook-uuid-1", "主流程: 会话号含唯一标识")
  断言相等(
    连接字符串(调用, "|"),
    "default-model|permission-resolve:read-only|preset-resolve:standard|standing:standard|workspace:/workspace|agent-create|mount:standard|attach|permission-set:read-only|title|followup",
    "主流程: 宿主调用序列"
  )
  断言相等(长度(消息表), 1, "主流程: 注入 1 条消息")
  断言相等(消息表[0]["role"], "user", "消息: role")
  断言相等(消息表[0]["content"][0]["type"], "text", "消息: content.type")
  断言相等(消息表[0]["content"][0]["text"], "Review it", "消息: content.text")
  断言相等(消息表[0]["source"]["kind"], "webhook", "消息: source.kind")
  断言相等(消息表[0]["source"]["provider"], "github", "消息: source.provider")
  断言相等(消息表[0]["source"]["source"], "primary", "消息: source.source")
  断言相等(消息表[0]["source"]["deliveryId"], "delivery", "消息: source.deliveryId")
  断言相等(消息表[0]["source"]["ruleId"], "review", "消息: source.ruleId")
  断言相等(消息表[0]["source"]["form"], "notice", "消息: source.form")
  断言相等(消息表[0]["source"]["summary"], "github webhook handled by review", "消息: source.summary")
  断言相等(长度(警告表), 0, "主流程: 无警告")
  断言相等(长度(调试表), 0, "主流程: 无调试")

# =====================================================================
# 用例 6：初始模型选择监听器
# =====================================================================
段落 用例_模型监听:
  设 上下文 为 造上下文()
  建会话(造请求())
  断言相等(字典包含键(监听表, "agent/request"), 真, "模型监听: 已注册 agent/request")
  设 监听 为 监听表["agent/request"]
  断言相等(是可调用(监听), 真, "模型监听: 是可调用")

  设 出一 为 监听(空, 下一步_异供应方)
  断言相等(出一["reasoningEffort"], "other-provider-effort", "模型监听: 异 provider 原样返回")
  设 出二 为 监听(空, 下一步_异模型)
  断言相等(出二["reasoningEffort"], "other-model-effort", "模型监听: 异 model 原样返回")
  设 出三 为 监听(空, 下一步_命中继承)
  断言相等(出三["provider"], "default-provider", "模型监听: 命中保留 provider")
  断言相等(出三["model"], "default-model", "模型监听: 命中保留 model")
  断言相等(出三["reasoningEffort"], "high", "模型监听: 命中替换为默认 reasoningEffort")
  设 假槽["请求头"] 为 {}
  设 出四 为 监听(空, 下一步_后期)
  断言相等(出四["provider"], "later-provider", "模型监听: 有请求头后原样 provider")
  断言相等(出四["reasoningEffort"], "later", "模型监听: 有请求头后原样 reasoningEffort")

  设 上下文 为 造上下文()
  设 显式 为 造请求()
  设 显式["model"] 为 {"provider": "p", "model": "m"}
  建会话(显式)
  断言相等(列表包含(调用, "default-model"), 假, "显式模型: 不咨询默认")
  设 监听二 为 监听表["agent/request"]
  设 出五 为 监听二(空, 下一步_显式命中)
  断言相等(出五["provider"], "p", "显式模型: provider")
  断言相等(出五["model"], "m", "显式模型: model")
  断言相等(字典包含键(出五, "reasoningEffort"), 假, "显式模型: 剥离 reasoningEffort")

# =====================================================================
# 用例 7：失败收敛（预检与挂载前失败不得注入提示）
# =====================================================================
段落 用例_失败收敛:
  遍历 点 之 ["permission-resolve", "preset-resolve", "standing", "workspace", "agent", "attach"]:
    设 上下文 为 造上下文()
    设 假槽["失败点"] 为 点
    设 抛了 为 假
    尝试:
      建会话(造请求())
    捕获 异常 为 e:
      设 抛了 为 真
    断言相等(抛了, 真, "失败收敛_" + 点 + ": 必抛")
    断言相等(列表包含(调用, "followup"), 假, "失败收敛_" + 点 + ": 未注入提示")
    断言相等(长度(消息表), 0, "失败收敛_" + 点 + ": 消息表空")

  设 上下文 为 造上下文()
  设 假槽["失败点"] 为 "attach"
  设 抛了 为 假
  尝试:
    建会话(造请求())
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "挂载失败: 必抛")
  断言相等(列表包含(调用, "dispose"), 真, "挂载失败: 销毁句柄")
  断言相等(列表包含(调用, "detach"), 假, "挂载失败: 未挂载成功故不摘除")

  设 上下文 为 造上下文()
  设 假槽["失败点"] 为 "workspace"
  设 抛了 为 假
  尝试:
    建会话(造请求())
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(列表包含(调用, "dispose"), 假, "工作区失败: 句柄未创建")

# =====================================================================
# 用例 8：运行时注册 / 派发 / 回收 / 关闭
# =====================================================================
段落 用例_运行时:
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "succeeds", "kind": "fixture", "run": 规则记录})
  注册({"id": "throws", "kind": "fixture", "run": 规则抛错})
  注册({"id": "other-kind", "kind": "other", "run": 规则记录})
  断言相等(连接字符串(取规则号表(), "|"), "succeeds|throws|other-kind", "运行时: 注册序")
  派发(造夹具投递())
  断言相等(长度(规则调用), 2, "运行时: 仅同种类 2 条被调用")
  断言相等(规则调用[0], "记录", "运行时: 首条 succeeds")
  断言相等(规则调用[1], "抛错", "运行时: 次条 throws（抛错不阻断兄弟）")
  断言相等(长度(警告表), 1, "运行时: 抛错记 1 条警告")
  断言相等(字符串包含(警告表[0], "failed: fixture failure [FIXTURE_FAIL]"), 真, "运行时: 警告含错误链")
  断言相等(字符串包含(警告表[0], "provider=\"fixture\""), 真, "运行时: 警告含 provider")
  断言相等(字符串包含(警告表[0], "source=\"fixture-source\""), 真, "运行时: 警告含 source")
  断言相等(字符串包含(警告表[0], "delivery=\"delivery-1\""), 真, "运行时: 警告含 delivery")
  断言相等(字符串包含(警告表[0], "rule=\"throws\""), 真, "运行时: 警告含 rule")

  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "creates", "kind": "fixture", "run": 规则建会话})
  派发(造夹具投递())
  派发(造夹具投递())
  断言相等(列表包含(调用, "followup"), 真, "运行时: 建会话规则触发注入")
  设 计数 为 0
  遍历 项 之 调用:
    如果 (项 == "followup"):
      设 计数 为 计数 + 1
  断言相等(计数, 2, "运行时: 两次派发注入 2 次")

  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "aborted", "kind": "fixture", "run": 规则中止后抛})
  派发(造夹具投递())
  断言相等(长度(调试表), 1, "中止后: 走 debug 而非 warn")
  断言相等(长度(警告表), 0, "中止后: 无警告")
  断言相等(字符串包含(调试表[0], "stopped after disposal:"), 真, "中止后: debug 文案")

# =====================================================================
# 用例 9：回收与关闭
# =====================================================================
段落 用例_回收关闭:
  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "draining", "kind": "fixture", "run": 规则记录})
  断言相等(回收("draining"), 真, "回收: 首次返回真")
  断言相等(回收("draining"), 假, "回收: 二次幂等返回假")
  断言相等(取登记("draining"), 空, "回收: 登记已隐藏")
  断言相等(列表包含(取规则号表(), "draining"), 假, "回收: 规则号表已剔除")
  派发(造夹具投递())
  断言相等(长度(规则调用), 0, "回收后: 不再派发")

  设 上下文 为 造上下文()
  造运行时(上下文)
  注册({"id": "r", "kind": "fixture", "run": 规则记录})
  断言相等(是运行时关闭(), 假, "关闭前: 未关闭")
  关闭运行时()
  断言相等(是运行时关闭(), 真, "关闭后: 已关闭")
  断言相等(取登记("r"), 空, "关闭后: 登记已回收")
  断言相等(长度(取规则号表()), 0, "关闭后: 规则表空")
  检查抛码("关闭后派发", "WEBHOOK_RUNTIME_CLOSING", 反跑_关闭派发_运算)
  检查抛码("关闭后注册", "WEBHOOK_RUNTIME_CLOSING", 反跑_关闭注册_运算)

# =====================================================================
# 用例 10：不变式
# =====================================================================
段落 用例_不变式:
  设 会话 为 造准入会话("attached", "/workspace")
  设 一区 为 [{"path": "/workspace", "sessionIds": ["attached"]}]
  断言相等(校验Webhook准入(会话, 造插入事件("webhook"), 一区), "", "不变式: 匹配即通过")
  断言相等(校验Webhook准入(会话, 造插入事件("user"), 一区), "", "不变式: 非 webhook 消息跳过")
  设 他事件 为 {"type": "todo/write", "data": {}}
  断言相等(校验Webhook准入(会话, 他事件, 一区), "", "不变式: 非 inbox/spliced 跳过")
  设 零区 为 [{"path": "/workspace", "sessionIds": []}]
  断言相等(内部派发检查("todo/write", 会话, 造插入事件("webhook"), 零区), "", "不变式: 非 session/event 跳过")
  断言相等(字符串包含(内部派发检查("session/event", 会话, 造插入事件("webhook"), 零区), "belongs to 0 Workspaces"), 真, "不变式: 经 internal/dispatch 入口")

# =====================================================================
