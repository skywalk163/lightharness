# test_令牌估算.light —— 模块 #45 反跑测试
# 覆盖：text/reasoning/tool-call/tool-result/未知块 递归定价、消息、system/tools/头部 定价。
# 反跑判据：把任一 断言相等 的期望值改反即红；结构化判据（未知块同值相等、头部=系统+工具）改反即红。
# 注意：写 语句只接受字面量串，不写「写 "x" + 变量」；诊断一律走 抛出 新建 错误（表达式上下文，序列化JSON 可正常调用）。

从 JSON 导入 序列化JSON
从 令牌估算 导入 估算内容, 估算消息, 估算系统令牌, 估算工具令牌, 估算头部

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

# ---- 内容块定价 ----
段落 用例文本块:
  设 块 为 [["type": "text", "text": "hello"]]
  断言相等(估算内容(块), 6, "text块(len5)=ceil(5/4)+4=2+4=6")

段落 用例推理块:
  设 块 为 [["type": "reasoning", "text": "hi"]]
  断言相等(估算内容(块), 5, "reasoning块(len2)=ceil(2/4)+4=1+4=5")

段落 用例工具调用块:
  设 块 为 [["type": "tool-call", "name": "f", "arguments": "{}"]]
  # name len1=1, args len2=1, +4 → 6
  断言相等(估算内容(块), 6, "tool-call块(name1+args2)+4=6")

段落 用例工具结果块递归:
  设 内 为 ["type": "text", "text": "x"]
  设 块 为 [["type": "tool-result", "content": [内]]]
  # 内 text len1=1+4=5; tool-result +4 = 9
  断言相等(估算内容(块), 9, "tool-result递归(内5)+4=9")

段落 用例空块表:
  断言相等(估算内容([]), 0, "空块表=0")

段落 用例未知块保守价:
  # 未知块走 4 + ceil(len(JSON)/4)；同值两实例必须相等，且不低于块开销
  设 块A 为 ["type": "weird", "a": 1]
  设 块B 为 ["type": "weird", "a": 1]
  设 价A 为 估算内容([块A])
  设 价B 为 估算内容([块B])
  断言相等(价A, 价B, "未知块同值相等")
  如果 价A <= 4: 抛出 新建 错误("未知块价应不低于块开销4")
  写 "通过: 未知块价>=块开销"

# ---- 消息定价 ----
段落 用例消息混合:
  设 消息 为 ["content": [["type": "text", "text": "hello"], ["type": "reasoning", "text": "hi"]]]
  # 6 + 5 + 角色开销4 = 15
  断言相等(估算消息(消息), 15, "消息(6+5)+角色4=15")

段落 用例消息空内容:
  设 消息 为 ["content": []]
  断言相等(估算消息(消息), 4, "空内容消息=角色开销4")

# ---- 头部 system/tools 定价 ----
段落 用例系统令牌:
  断言相等(估算系统令牌(空), 0, "头部空→系统0")
  设 头部 为 ["system": "abc"]
  断言相等(估算系统令牌(头部), 5, "system len3=ceil(3/4)+4=1+4=5")
  设 无系统 为 ["foo": 1]
  断言相等(估算系统令牌(无系统), 0, "缺system键→0")

段落 用例工具令牌:
  断言相等(估算工具令牌(空), 0, "头部空→工具0")
  断言相等(估算工具令牌(["tools": []]), 0, "tools空表→0")
  断言相等(估算工具令牌(["foo": 1]), 0, "缺tools键→0")
  设 有工具 为 ["tools": [["name": "x"]]]
  如果 估算工具令牌(有工具) <= 0: 抛出 新建 错误("tools非空应定价为正")
  写 "通过: tools非空>0"

段落 用例头部分解:
  断言相等(估算头部(空), 0, "头部空→0")
  设 仅系统 为 ["system": "abc"]
  断言相等(估算头部(仅系统), 5, "头部(仅系统)=系统5+工具0=5")
  设 两者 为 ["system": "abc", "tools": [["name": "x"]]]
  # 结构化判据：头部 = 系统 + 工具（改反即红）
  断言相等(估算头部(两者), 估算系统令牌(两者) + 估算工具令牌(两者), "头部=系统+工具")

# ---- 运行 ----
用例文本块()
用例推理块()
用例工具调用块()
用例工具结果块递归()
用例空块表()
用例未知块保守价()
用例消息混合()
用例消息空内容()
用例系统令牌()
用例工具令牌()
用例头部分解()
写 "--- 令牌估算纯逻辑核心（模块45）测试通过 ---"
