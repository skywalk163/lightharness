# test_e2b.light —— e2b 云沙箱客户端测试（P2 生态层 e2b）
# 覆盖：本地模拟模式启动/执行代码/关闭 / 工具注册调用。
# 无 e2b API key 时使用本地模拟模式（subprocess 执行），用于开发/测试。
# 反跑判据：把 输出断言 或 返回码断言 改反即红。

从 e2b客户端 导入 E2BClient, 造e2b工具
从 工具 导入 工具注册表

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) + " 期望=" 加上 转字符串(期望)

# ---- 部分1：本地模拟模式 ----
段落 测本地模拟:
  # 无 API key → 本地模拟
  设 客户端 为 新建 E2BClient(空, "base")
  断言等于(客户端.状态()["本地模拟"], 真, "无API key应本地模拟")
  断言等于(客户端.状态()["已启动"], 假, "初始未启动")

  设 启动结果 为 客户端.启动()
  断言等于(启动结果["模式"], "local-sim", "启动模式应为 local-sim")
  断言等于(客户端.状态()["已启动"], 真, "启动后已启动应为真")

  # 正常代码
  设 r1 为 客户端.执行代码("print('e2b hello')")
  断言等于(r1["返回码"], 0, "正常代码返回码应为 0")
  断言真(r1["输出"].包含("e2b hello"), "输出应包含 e2b hello，实际=" 加上 r1["输出"])
  断言等于(r1["模式"], "local-sim", "执行模式应为 local-sim")

  # 计算
  设 r2 为 客户端.执行代码("print(7*8)")
  断言真(r2["输出"].包含("56"), "计算输出应包含 56，实际=" 加上 r2["输出"])

  # 错误代码
  设 r3 为 客户端.执行代码("raise ValueError('boom')")
  断言真(r3["返回码"] != 0, "错误代码返回码应非0")
  设 有错误信息 为 假
  如果 r3["错误"].包含("boom"):
    设有错误信息 为 真
  如果 r3["错误"].包含("ValueError"):
    设有错误信息 为 真
  断言真(有错误信息, "错误应包含 boom 或 ValueError，实际=" 加上 r3["错误"])

  # 执行取文本（成功）
  设 t1 为 客户端.执行取文本("print('text result')")
  断言等于(t1, "text result", "执行取文本应返回 stdout")

  # 执行取文本（失败）
  设 t2 为 客户端.执行取文本("raise Exception('fail')")
  断言真(t2.包含("e2b执行失败"), "失败时应返回失败描述，实际=" 加上 t2)

  # 状态
  设 状态 为 客户端.状态()
  断言真(状态["执行次数"] >= 5, "执行次数应>=5，实际=" 加上 转字符串(状态["执行次数"]))

  客户端.关闭()
  断言等于(客户端.状态()["已启动"], 假, "关闭后已启动应为假")
  打印 "本地模拟测试通过"

# ---- 部分2：工具注册调用 ----
段落 测工具注册:
  设 客户端 为 新建 E2BClient(空, "base")
  客户端.启动()
  设 注册表 为 新建 工具注册表()
  设 工具 为 造e2b工具(客户端, "e2b执行", "在e2b沙箱执行Python代码")
  注册表.注册(工具)

  设 结果 为 注册表.执行("e2b执行", ["代码": "print(100+1)"])
  设 结果文本 为 结果["content"][0]["text"]
  断言真(结果文本.包含("101"), "工具调用应返回 101，实际=" 加上 结果文本)

  客户端.关闭()
  打印 "工具注册测试通过"

测本地模拟()
测工具注册()
打印 "test_e2b PASS"
