# test_R85_D_工作区变更.light —— R85 任务 D 子任务对拍测试
# 对 src/工作区变更.light 的纯逻辑做真实对拍；git 执行与文件工具拦截均用注入的 mock 宿主钩子承接，
# 绝不真实执行 git / 网络 / 文件系统写。

从 工作区变更 导入 工区解析记录, 工区过滤路径, 工区显示路径, 工区比较快照, 工区记录器
从 工作区变更 导入 工区投影事件, 工区捕获编辑, 工区构造diff树命令, 工区构造轮记录, 工区校验轮记录
从 工作区变更 导入 工区比较显示, 工区构造事件

# ── 断言辅助（任务规定形态）──
段落 工区断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

# ── mock 宿主钩子：返回假 numstat 文本（路径含空格）──
段落 工区假numstat文本:
  返回 "2\t0\ta.txt" + "\n" + "0\t4\tb c.txt"

段落 工区假跑命令(命令):
  返回 工区假numstat文本()

# ── 主流程 ──
段落 主:
  # 1) numstat 解析（多行、含空格路径、含二进制行）
  设 样例 为 "3\t0\tsrc/a b.txt" + "\n" + "0\t5\tdocs/readme.md" + "\n" + "-\t-\tbin/tool"
  设 条目 为 工区解析记录(样例)
  工区断言相等(长(条目), 3, "numstat条目数")
  工区断言相等(条目[0]["路径"], "src/a b.txt", "numstat空格路径")
  工区断言相等(条目[0]["新增行数"], 3, "numstat新增行数")
  工区断言相等(条目[1]["删除行数"], 5, "numstat删除行数")
  工区断言相等(条目[2]["二进制"], 真, "numstat二进制标记")

  # 2) 路径过滤 / 显示名归一
  工区断言相等(工区显示路径("/repo/src/a b.txt", "/repo", "/repo", ""), "src/a b.txt", "显示路径-工作区内")
  工区断言相等(工区显示路径("/home/u/x.txt", "/repo", "/repo", "/home/u"), "~/x.txt", "显示路径-home缩写")
  工区断言相等(工区过滤路径("/repo/ignored.txt", ["/repo/ignored.txt"]), 假, "路径过滤-排除命中")
  工区断言相等(工区过滤路径("/repo/keep.txt", ["/repo/ignored.txt"]), 真, "路径过滤-保留")

  # 3) compare 快照汇总（新增/修改/删除 + 行数）
  设 前表 为 {"a.txt": {"新增行数": 0, "删除行数": 0}, "b.txt": {"新增行数": 1, "删除行数": 2}}
  设 后表 为 {"a.txt": {"新增行数": 0, "删除行数": 0}, "c.txt": {"新增行数": 5, "删除行数": 0}}
  设 汇总 为 工区比较快照(前表, 后表)
  工区断言相等(汇总["新增"], ["c.txt"], "compare新增清单")
  工区断言相等(汇总["修改"], ["a.txt"], "compare修改清单")
  工区断言相等(汇总["删除"], ["b.txt"], "compare删除清单")
  工区断言相等(汇总["新增行数"], 5, "compare新增行数汇总")
  工区断言相等(汇总["删除行数"], 2, "compare删除行数汇总")
  工区断言相等(汇总["总数"], 3, "compare总数")

  # 4) recorder 累积编辑 + 轮汇总（无 git 分支）
  设 记录器 为 新建 工区记录器("/repo", 空)
  记录器.开始轮(1)
  记录器.捕获编辑("write", {"file_path": "/repo/a.txt", "content": "hello"})
  记录器.捕获编辑("edit", {"file_path": "/repo/b.txt", "old_string": "1", "new_string": "2"})
  记录器.捕获编辑("read", {"file_path": "/repo/c.txt"})  # 非写工具，不计入
  工区断言相等(长(记录器.取编辑表()), 2, "recorder编辑累积数")
  设 轮汇总 为 记录器.结束轮()
  工区断言相等(轮汇总["轮"], 1, "recorder轮号")
  工区断言相等(轮汇总["总数"], 2, "recorder汇总总数")
  工区断言相等(长(轮汇总["文件"]), 2, "recorder汇总文件数")
  工区断言相等(轮汇总["快照"], 空, "recorder无git快照为空")

  # 5) 无 git 只列「文件工具编辑」分支：文件清单等于编辑去重路径
  设 文件表 为 []
  遍历 文件 之 轮汇总["文件"]:
    文件表.追加(文件["路径"])
  工区断言相等(文件表, ["/repo/a.txt", "/repo/b.txt"], "recorder仅列编辑路径")

  # 6) 事件投影只含 turn 号
  设 投影 为 工区投影事件({"轮": 7, "其它字段": 1})
  工区断言相等(投影, {"轮": 7}, "事件投影-仅turn")
  工区断言相等(长(字典键列表(投影)), 1, "事件投影-键唯一")

  # 7) git 命令构造 + 宿主注入解释结果
  工区断言相等(工区构造diff树命令("T1", "T2"), ["diff-tree", "-r", "-M", "-z", "--numstat", "T1", "T2"], "git命令构造")
  设 钩子 为 {"跑命令": 工区假跑命令}
  设 记录器2 为 新建 工区记录器("/repo", 钩子)
  设 差异 为 记录器2.取快照差异("T1", "T2")
  工区断言相等(长(差异), 2, "git注入-条目数")
  工区断言相等(差异[1]["路径"], "b c.txt", "git注入-空格路径")

  # 8) types 构造/校验形状
  工区断言相等(工区构造事件(9), {"轮": 9}, "构造事件")
  工区断言相等(工区校验轮记录(工区构造轮记录(1, "/repo", [], 0, 0, 0, "T1", "T2")), 真, "校验轮记录")

  写 "test_R85_D_工作区变更 PASS"

主()
