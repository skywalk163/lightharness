# test_R42_真实工具链.light —— 第42轮 任务5 验收（真实工具链端到端）
#
# 运行：cd lightharness && python 运行.py examples/test_R42_真实工具链.light
# 退出码 0 = 全部断言通过。
#
# 一条真实工具链（全程真实IO，不退回mock）：
#   ① bash工具真执行 echo（真实子进程，外部命令）
#   ② 真实抓取本机web服务器 /health（真实HTTP出，R42任务1）
#   ③ 真实webhook端点收本地HMAC签发POST（真实HTTP入+验签，R42任务2）
# 三者串成一条链，零源码修改。

从 web服务器 导入 全局服务
从 HTTP服务端 导入 处理循环, 新建选择器, 探测就绪, 是否愿等读, 是否愿等写, 关闭选择器
从 哈希 导入 HMAC_SHA256
从 JSON 导入 序列化JSON
从 工具_bash 导入 bash处理
从 真实抓取提供 导入 真实抓取
导入 socket

段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 标签:
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

# ---- 非阻塞原始POST（与R42任务2同源，主协程必须等待）----
异步 段落 原始请求 接收 主机, 端口, 方法, 路径, 头行表, 体文本, 超时值:
  设 请求行 为 方法 + " " + 路径 + " HTTP/1.1\r\n"
  设 头块 为 "Host: " + 主机 + ":" + 转字符串(端口) + "\r\nConnection: close\r\n"
  设 全部头 为 头块 + 连接字符串(头行表, "\r\n")
  如果 长(头行表) > 0:
    设 全部头 为 全部头 + "\r\n"
  设 全部头 为 全部头 + "Content-Length: " + 转字符串(长(体文本)) + "\r\n\r\n"
  设 请求文本 为 请求行 + 全部头 + 体文本
  设 请求字节 为 请求文本.encode("utf-8")
  设 套接字 为 socket.socket(socket.AF_INET, socket.SOCK_STREAM)
  套接字.setblocking(假)
  设 选择器 为 新建选择器()
  设 缓存 为 b""
  尝试:
    尝试:
      套接字.connect((主机, 端口))
    捕获 异常 e:
      设 截止 为 单调时钟() + 超时值
      当 真:
        如果 探测就绪(选择器, 套接字, "写"): 跳出
        如果 单调时钟() >= 截止: 抛出 新建 错误("连接超时")
        等待 异步睡眠(0.0005)
    设 偏移 为 0
    设 截止 为 单调时钟() + 超时值
    当 偏移 < 长(请求字节):
      尝试:
        设 已发 为 套接字.send(请求字节[偏移:])
        设 偏移 为 偏移 + 已发
      捕获 异常 e:
        如果 是否愿等写(e):
          如果 单调时钟() >= 截止: 抛出 新建 错误("发送超时")
          如果 探测就绪(选择器, 套接字, "写"): 等待 异步睡眠(0)
          否则: 等待 异步睡眠(0.0005)
        否则:
          抛出 新建 错误("发送失败")
    设 截止 为 单调时钟() + 超时值
    当 真:
      设 块 为 空
      尝试:
        设 块 为 套接字.recv(4096)
      捕获 异常 e:
        如果 是否愿等读(e):
          如果 单调时钟() >= 截止: 抛出 新建 错误("读取超时")
          如果 探测就绪(选择器, 套接字, "读"): 等待 异步睡眠(0)
          否则: 等待 异步睡眠(0.0005)
          继续
        否则:
          抛出 新建 错误("读取失败")
      如果 长(块) == 0: 跳出
      设 缓存 为 缓存 + 块
    套接字.close()
  最终:
    关闭选择器(选择器)
  设 分隔 为 缓存.查找(b"\r\n\r\n")
  如果 分隔 < 0:
    返回 ["状态": 0, "头": "", "体": ""]
  设 头文本 为 字符串(缓存[0:分隔], "utf-8")
  设 体 为 字符串(缓存[分隔 + 4:], "utf-8")
  设 部分 为 头文本.分割("\r\n")[0].split(" ")
  返回 ["状态": 转整数(部分[1]), "头": 头文本, "体": 体]

段落 造钩子头 接收 签名, 交付id, 事件名:
  返回 ["X-Hub-Signature-256: " + 签名, "X-GitHub-Delivery: " + 交付id, "X-GitHub-Event: " + 事件名, "Content-Type: application/json"]

异步 段落 主测试:
  设 基 为 当前目录()
  设 秘密 为 "secret"
  全局服务.配置(空, 空, 基, 5.0, "", [], "", 绑定地址="127.0.0.1", 令牌="")
  全局服务.设置钩子秘密(秘密)
  全局服务.清空钩子派发()
  设 任务S 为 创建任务(处理循环(全局服务.服务端))
  设 端口 为 全局服务.端口()
  断言真(端口 > 0, "内核端口已分配")

  # ① bash真实子进程
  设 rb 为 bash处理(["命令": "echo r42-chain-bash"])
  断言真(rb["输出"].查找("r42-chain-bash") >= 0, "bash真实子进程echo")
  断言相等(rb["退出码"], 0, "bash退出码0")

  # ② 真实抓取 /health（真实HTTP出）
  设 rf 为 等待 真实抓取("http://127.0.0.1:" + 转字符串(端口) + "/health", 5.0)
  断言相等(rf[0], 200, "真实抓取health_200")

  # ③ 真实webhook接收（真实HTTP入+验签）
  设 体 为 序列化JSON(["action": "opened", "repository": ["name": "chain"]])
  设 好签 为 "sha256=" + HMAC_SHA256(秘密, 体)
  设 rw 为 等待 原始请求("127.0.0.1", 端口, "POST", "/webhook/github", 造钩子头(好签, "dlv-chain", "push"), 体, 5.0)
  断言相等(rw["状态"], 202, "webhook好签名202")
  断言相等(全局服务.钩子派发数(), 1, "webhook派发一次")

  全局服务.停止()
  打印("任务5 真实工具链：bash真实子进程+真实fetch出+真实webhook入验签 全链rc=0")

异步 运行 主测试()
