# test_异步子进程.light —— R69 子任务 69.1：事件循环驱动的非阻塞子进程测试
#
# 验证：异步启动、完成回调触发、输出回调触发、取消杀树、启动失败处理。
# 运行：cd lightharness && python 运行.py examples/test_异步子进程.light
#
# 光明无闭包：回调全用顶层段落，共享状态走模块级 状态 表。

从 事件循环 导入 事件循环
从 异步子进程 导入 异步子进程, 异步运行
导入 os
导入 tempfile
导入 time

# 模块级共享状态（无闭包，回调只能读写这里）
设 状态 为 {"结果": 空, "输出计数": 0, "输出块": []}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言包含(文本, 片段, 标签):
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段 + "；实际=" + 文本[0:200]

# ---------- 顶层回调（无闭包，读写 状态 表） ----------
段落 存结果(结果):
  状态["结果"] 为 结果

段落 记输出(块):
  状态["输出计数"] 为 状态["输出计数"] + 1
  状态["输出块"].追加(块)

# 跑循环直到执行器完成或超时（毫秒）
段落 跑到完成(环, 执行器, 超时毫秒):
  设 截止 为 time.time() + 超时毫秒 / 1000.0
  当 真:
    如果 执行器.已完成:
      # 完成回调通过 立即调度 异步派发，需多跑一次刷新待执行队列
      环.运行一次(0)
      跳出
    如果 time.time() > 截止:
      抛出 "测试超时: 异步子进程未在 " + 转字符串(超时毫秒) + "ms 内完成"
    环.运行一次(50)

段落 主:
  # ============================================================
  # 1) 基本异步执行：完成回调触发，退出码 0，标准输出正确
  # ============================================================
  状态["结果"] 为 空
  设 环1 为 新建 事件循环()
  设 执行器1 为 新建 异步子进程(环1)
  执行器1.运行(["python", "-c", "print('async-hello')"], {}, 存结果)
  跑到完成(环1, 执行器1, 10000)
  设 r1 为 状态["结果"]
  断言真(r1 != 空, "完成回调被触发")
  断言相等(r1.退出码, 0, "异步执行退出码0")
  断言包含(r1.标准输出, "async-hello", "异步执行标准输出")
  环1.关闭()

  # ============================================================
  # 2) 输出回调：有新输出时触发
  # ============================================================
  状态["结果"] 为 空
  状态["输出计数"] 为 0
  状态["输出块"] 为 []
  设 环2 为 新建 事件循环()
  设 执行器2 为 新建 异步子进程(环2)
  执行器2.运行(
    ["python", "-c", "import time; print('line1'); time.sleep(0.1); print('line2')"],
    {},
    存结果,
    记输出
  )
  跑到完成(环2, 执行器2, 10000)
  断言真(状态["输出计数"] >= 1, "输出回调至少触发一次: " + 转字符串(状态["输出计数"]))
  断言真(状态["结果"] != 空, "完成回调触发")
  断言包含(状态["结果"].标准输出, "line1", "输出含line1")
  断言包含(状态["结果"].标准输出, "line2", "输出含line2")
  环2.关闭()

  # ============================================================
  # 3) 非零退出码正确回传
  # ============================================================
  状态["结果"] 为 空
  设 环3 为 新建 事件循环()
  设 执行器3 为 新建 异步子进程(环3)
  执行器3.运行(["python", "-c", "import sys; sys.exit(7)"], {}, 存结果)
  跑到完成(环3, 执行器3, 10000)
  断言相等(状态["结果"].退出码, 7, "非零退出码回传")
  环3.关闭()

  # ============================================================
  # 4) 取消杀树：长 sleep 被取消，完成回调仍触发
  # ============================================================
  状态["结果"] 为 空
  设 环4 为 新建 事件循环()
  设 执行器4 为 新建 异步子进程(环4)
  执行器4.运行(["python", "-c", "import time; time.sleep(30)"], {"宽限期毫秒": 2000}, 存结果)
  # 等一小会儿让进程启动
  环4.运行一次(200)
  断言真(执行器4.是否存活(), "取消前进程存活")
  执行器4.取消()
  跑到完成(环4, 执行器4, 10000)
  断言真(状态["结果"] != 空, "取消后完成回调仍触发")
  断言真(状态["结果"].退出码 != 0, "取消后退出码非0（被杀死）")
  环4.关闭()

  # ============================================================
  # 5) 启动失败：不存在的命令，完成回调携带失败信息
  # ============================================================
  状态["结果"] 为 空
  设 环5 为 新建 事件循环()
  设 执行器5 为 新建 异步子进程(环5)
  设 开动 为 执行器5.运行(["/nonexistent/command/xyz123"], {}, 存结果)
  # 启动失败时 运行 返回 假，但完成回调已被立即调度
  环5.运行一次(100)
  断言真(状态["结果"] != 空, "启动失败时完成回调被调度")
  断言相等(状态["结果"].退出码, -1, "启动失败退出码-1")
  断言真(长度(状态["结果"].标准错误) > 0, "启动失败有错误信息")
  环5.关闭()

  # ============================================================
  # 6) 便捷函数 异步运行
  # ============================================================
  状态["结果"] 为 空
  设 环6 为 新建 事件循环()
  设 执行器6 为 异步运行(环6, ["python", "-c", "print('convenience-ok')"], {}, 存结果)
  跑到完成(环6, 执行器6, 10000)
  断言相等(状态["结果"].退出码, 0, "便捷函数退出码0")
  断言包含(状态["结果"].标准输出, "convenience-ok", "便捷函数输出")
  环6.关闭()

  打印("test_异步子进程 全部断言通过（6 组 / 基本+输出回调+非零退出+取消+启动失败+便捷函数）")
