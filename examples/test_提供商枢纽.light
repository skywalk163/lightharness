# test_提供商枢纽.light —— jet-hub 接入模块离线自测（不联网）
#
# 跑法：cd lightharness && python 运行.py examples/test_提供商枢纽.light
# 断言范围：地址解析、密钥形状、模型目录解析、挑选模型、接入配置；
#   真实网关联调见 docs/jet-hub接入.md（Windows / FreeBSD 0.88 各有一次实测）。

从 内置核心列表 导入 列表长度
从 内置核心字典 导入 字典设置
从 内置核心字符串 导入 字符串包含, 结尾
从 提供商枢纽 导入 解析地址, 解析密钥, 是有效密钥, 解析模型清单, 挑选模型, 构造接入, 按提供商分组, 密钥文件路径, 补全版本段, 解析枢纽主目录

设 计数 为 {"失败": 0}

段落 断真(条件, 说明):
  如果 条件 == 假:
    打印 "FAIL: " + 说明
    字典设置(计数, "失败", 计数["失败"] + 1)

# ---- 1. 默认地址（无环境变量）----
设 空环境 为 {}
设 视图 为 解析地址(空环境)
断真(视图["地址"] == "http://127.0.0.1:8326/v1", "默认地址应为 127.0.0.1:8326/v1，实得 " + 视图["地址"])

# ---- 2. 显式 JET_HUB_BASE_URL（带尾斜杠 / 不带 /v1 都要补齐）----
设 自定义 为 {"JET_HUB_BASE_URL": "http://192.168.0.88:8326/"}
设 视图2 为 解析地址(自定义)
断真(视图2["地址"] == "http://192.168.0.88:8326/v1", "显式地址应补 /v1，实得 " + 视图2["地址"])
断真(字符串包含(视图2["来源"], "JET_HUB_BASE_URL"), "来源应标注环境变量")

# ---- 3. DSH_OPENAI_GATEWAY_HOST/PORT ----
设 网关环境 为 {"DSH_OPENAI_GATEWAY_HOST": "192.168.0.88", "DSH_OPENAI_GATEWAY_PORT": "9000"}
设 视图3 为 解析地址(网关环境)
断真(视图3["地址"] == "http://192.168.0.88:9000/v1", "DSH 网关环境应生效，实得 " + 视图3["地址"])

# ---- 4. 密钥形状：43 位 base64url 才算有效 ----
断真(是有效密钥("abcdefghijklmnopqrstuvwxyz0123456789ABCDEF") == 假, "42 位不应通过")
断真(是有效密钥("abcdefghijklmnopqrstuvwxyz0123456789ABCDEFG") == 真, "43 位应通过")
断真(是有效密钥("abcdefghijklmnopqrstuvwxyz0123456789ABCDEF!") == 假, "非法字符不应通过")

# ---- 5. 密钥解析：环境变量优先 ----
设 密钥环境 为 {"JET_HUB_API_KEY": "env-key"}
设 密钥视图 为 解析密钥(密钥环境)
断真(密钥视图["密钥"] == "env-key", "JET_HUB_API_KEY 应生效")
断真(密钥视图["存在"] == 真, "环境变量密钥应视为存在")
断真(字符串包含(密钥视图["来源"], "JET_HUB_API_KEY"), "来源应标注环境变量")

# ---- 6. 模型目录解析（dsh-providers-hub 真实响应形状）----
设 响应 为 "{\"object\":\"list\",\"data\":[{\"id\":\"deepseek-official/deepseek-flash\",\"object\":\"model\",\"created\":0,\"owned_by\":\"deepseek-official\",\"name\":\"DeepSeek-V4.1-Flash\",\"context_window\":1048576,\"input\":[\"text\",\"image\"],\"reasoning\":{\"default\":\"high\"}},{\"id\":\"codearts/GLM-5.2\",\"owned_by\":\"codearts\",\"name\":\"GLM-5.2 · x0.7\",\"context_window\":202752},{\"id\":\"raccoon/sn-glm-5-3-flash\",\"owned_by\":\"raccoon\",\"name\":\"GLM-5.3-Flash\"},{\"bad\":1}]}"
设 清单视图 为 解析模型清单(响应)
断真(清单视图["错误"] == "", "合法响应不应报错，实得 " + 清单视图["错误"])
断真(清单视图["总数"] == 3, "应解析出 3 条（最后一条无 id 跳过），实得 " + 转字符串(清单视图["总数"]))
设 首条 为 清单视图["模型列表"][0]
断真(首条["id"] == "deepseek-official/deepseek-flash", "首条 id 错")
断真(首条["提供商"] == "deepseek-official", "首条提供商错")
断真(首条["上下文窗口"] == 1048576, "首条窗口错")

# ---- 7. 坏响应不抛异常 ----
设 坏视图 为 解析模型清单("不是 JSON")
断真(坏视图["错误"] != "", "坏响应应给出错误而不是抛异常")
断真(坏视图["总数"] == 0, "坏响应不应有模型")

# ---- 8. 挑选模型：完整 id / 裸名 / 默认偏好 ----
设 偏好 为 挑选模型(清单视图["模型列表"], "codearts/GLM-5.2")
断真(偏好["id"] == "codearts/GLM-5.2", "完整 id 应精确命中")
设 裸名 为 挑选模型(清单视图["模型列表"], "sn-glm-5-3-flash")
断真(裸名["id"] == "raccoon/sn-glm-5-3-flash", "裸名应按尾段命中")
设 默认挑 为 挑选模型(清单视图["模型列表"], "")
断真(默认挑["id"] == "deepseek-official/deepseek-flash", "空偏好应取默认偏好模型")
设 空挑 为 挑选模型([], "")
断真(空挑 == 空, "空目录应返回 空")

# ---- 9. 分组 ----
设 组 为 按提供商分组(清单视图["模型列表"])
断真(列表长度(组) == 3, "应分 3 组，实得 " + 转字符串(列表长度(组)))
断真(组[0]["提供商"] == "deepseek-official", "首组应为 deepseek-official")

# ---- 10. 接入配置：.env 三行 + 完整端点 ----
设 接入 为 构造接入("http://127.0.0.1:8326/v1", "K", "codearts/GLM-5.2")
断真(接入["端点"] == "http://127.0.0.1:8326/v1/chat/completions", "端点拼接错，实得 " + 接入["端点"])
断真(接入["基址"] == "http://127.0.0.1:8326/v1", "基址错")
断真(字符串包含(接入["环境内容"], "OPENAI_MODEL=codearts/GLM-5.2"), ".env 模型行错")
断真(字符串包含(接入["环境内容"], "OPENAI_BASE_URL=http://127.0.0.1:8326/v1"), ".env 地址行错")

# ---- 11. 补全版本段不重复加 /v1 ----
断真(补全版本段("http://127.0.0.1:8326/v1") == "http://127.0.0.1:8326/v1", "已有 /v1 不应重复")
断真(补全版本段("http://127.0.0.1:8326/v1/") == "http://127.0.0.1:8326/v1", "尾斜杠应去掉")

# ---- 12. 密钥文件路径落在 <DSH_HOME>/openai-gateway/api-key ----
设 路径环境 为 {"DSH_HOME": "/tmp/fake-dsh"}
设 路径 为 密钥文件路径(路径环境)
断真(结尾(路径, "/openai-gateway/api-key") 或 结尾(路径, "\\openai-gateway\\api-key"), "密钥路径形状错：" + 路径)

# ---- 13. DSH_HOME 缺省/空串都要落到 <家>/.dsh（FreeBSD 实测暴露：空串不归一 → 空路径）----
设 空家环境 为 {"HOME": "/tmp/fakehome", "DSH_HOME": ""}
设 空家根 为 解析枢纽主目录(空家环境)
断真(字符串包含(空家根, "fakehome"), "DSH_HOME 为空串时应回落到 HOME，实得：" + 空家根)
断真(结尾(空家根, ".dsh"), "缺省 DSH 主目录应以 .dsh 结尾，实得：" + 空家根)

如果 计数["失败"] == 0:
  打印 "提供商枢纽离线自测 PASS"
否则:
  抛出 "提供商枢纽离线自测 FAIL: " + 转字符串(计数["失败"]) + " 条"