  断言相等(结果20["种类"], "error", "异常返回 error 种类")
  断言相等(结果20["步骤数"], 1, "异常在第一步")
  断言真(结果20.包含("失败"), "包含失败字段")
  打印("S20通过：客户端异常错误结构")

  打印("--- 代理循环行为对照测试全部通过 ---")

主()
