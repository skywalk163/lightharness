# test_行为对照_代理循环.light —— 第8轮任务1：代理循环行为对照
# 对标原版 packages/core/agent-loop/tests/ 下 23 个 spec 文件
# 提取可断言纯逻辑场景，对照已有光明测试，翻译未覆盖场景为本文件
# 运行：python 运行.py examples/test_行为对照_代理循环.light

从 代理 导入 代理循环, 系统提示投影
从 会话 导入 新建会话
从 工具 导入 工具注册表, 造工具定义, 造工具结果
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因, 造工具调用增量, 造工具调用原因, 造用量块, 造用量, 造超长原因, 造错误原因, 造失败
从 消息 导入 造文本块

# ===== 辅助断言 =====
段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败(应为真)：" + 信息)

段落 断言假 接收 条件, 信息:
  如果 条件 == 真:
    抛出 新建 错误("断言失败(应为假)：" + 信息)

# ===== 假客户端定义 =====

# 纯文本回答 + 正常停止
类 文本客户端:
  属性 模型名 等于 "deepseek-chat"
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 块表 为 []
    块表.追加(造块开始(0, "text"))
    块表.追加(造文本增量(0, "回答"))
    块表.追加(造块结束(0, ["type": "text", "text": "回答"]))
    块表.追加(造用量块(造用量(10, 5)))
    块表.追加(造结束(造停止原因()))
    返回 块表

# 纯文本 + max-tokens 停止
类 超长客户端:
  属性 模型名 等于 "deepseek-chat"
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 块表 为 []
    块表.追加(造块开始(0, "text"))
    块表.追加(造文本增量(0, "截断"))
    块表.追加(造块结束(0, ["type": "text", "text": "截断"]))
    块表.追加(造用量块(造用量(100, 200)))
    块表.追加(造结束(造超长原因()))
    返回 块表

# 文本 + 工具调用 + max-tokens 停止（验证工具调用被丢弃）
类 超长工具客户端:
  属性 模型名 等于 "deepseek-chat"
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 块表 为 []
    块表.追加(造块开始(0, "text"))
    块表.追加(造文本增量(0, "部分回答"))
    块表.追加(造块结束(0, ["type": "text", "text": "部分回答"]))
    块表.追加(造块开始(1, "tool-call"))
    块表.追加(造工具调用增量(1, "call_1", "echo", "{\"a\":1}"))
    块表.追加(造块结束(1, ["type": "tool-call", "id": "call_1", "name": "echo", "arguments": "{\"a\":1}"]))
    块表.追加(造结束(造超长原因()))
    返回 块表

# 抛异常客户端
类 抛错客户端:
  属性 模型名 等于 "deepseek-chat"
  段落 对话响应 接收 网络消息, 选项, 工具表:
    抛出 新建 错误("连接失败")

# 错误完成原因客户端
类 错误完成客户端:
  属性 模型名 等于 "deepseek-chat"
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 块表 为 []
    块表.追加(造结束(造错误原因(造失败("模型错误", "MODEL_ERROR"))))
    返回 块表

# 双轮客户端：第一次 max-tokens，第二次正常
类 双轮客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 调用次数 等于 0
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 己.调用次数 为 己.调用次数 + 1
    设 块表 为 []
    如果 己.调用次数 == 1:
      块表.追加(造块开始(0, "text"))
      块表.追加(造文本增量(0, "截断"))
      块表.追加(造块结束(0, ["type": "text", "text": "截断"]))
      块表.追加(造结束(造超长原因()))
    否则:
      块表.追加(造块开始(0, "text"))
      块表.追加(造文本增量(0, "完成"))
      块表.追加(造块结束(0, ["type": "text", "text": "完成"]))
      块表.追加(造用量块(造用量(20, 10)))
      块表.追加(造结束(造停止原因()))
    返回 块表

# 双工具→文本客户端：第一次返回两个并行工具调用，第二次返回文本
类 双工具文本客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 调用次数 等于 0
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 己.调用次数 为 己.调用次数 + 1
    设 块表 为 []
    如果 己.调用次数 == 1:
      块表.追加(造块开始(0, "tool-call"))
      块表.追加(造工具调用增量(0, "c1", "echo", "{\"a\":1}"))
      块表.追加(造块结束(0, ["type": "tool-call", "id": "c1", "name": "echo", "arguments": "{\"a\":1}"]))
      块表.追加(造块开始(1, "tool-call"))
      块表.追加(造工具调用增量(1, "c2", "echo", "{\"a\":2}"))
      块表.追加(造块结束(1, ["type": "tool-call", "id": "c2", "name": "echo", "arguments": "{\"a\":2}"]))
      块表.追加(造结束(造工具调用原因()))
    否则:
      块表.追加(造块开始(0, "text"))
      块表.追加(造文本增量(0, "完成"))
      块表.追加(造块结束(0, ["type": "text", "text": "完成"]))
      块表.追加(造用量块(造用量(20, 10)))
      块表.追加(造结束(造停止原因()))
    返回 块表

# 屏障客户端：第一次返回 echo+lock+echo，第二次返回文本
类 屏障客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 调用次数 等于 0
  段落 对话响应 接收 网络消息, 选项, 工具表:
    设 己.调用次数 为 己.调用次数 + 1
    设 块表 为 []
    如果 己.调用次数 == 1:
      块表.追加(造块开始(0, "tool-call"))
      块表.追加(造工具调用增量(0, "c1", "echo", "{\"a\":1}"))
      块表.追加(造块结束(0, ["type": "tool-call", "id": "c1", "name": "echo", "arguments": "{\"a\":1}"]))
      块表.追加(造块开始(1, "tool-call"))
      块表.追加(造工具调用增量(1, "c2", "lock", "{}"))
      块表.追加(造块结束(1, ["type": "tool-call", "id": "c2", "name": "lock", "arguments": "{}"]))
      块表.追加(造块开始(2, "tool-call"))
      块表.追加(造工具调用增量(2, "c3", "echo", "{\"a\":3}"))
      块表.追加(造块结束(2, ["type": "tool-call", "id": "c3", "name": "echo", "arguments": "{\"a\":3}"]))
      块表.追加(造结束(造工具调用原因()))
    否则:
      块表.追加(造块开始(0, "text"))
      块表.追加(造文本增量(0, "完成"))
      块表.追加(造块结束(0, ["type": "text", "text": "完成"]))
      块表.追加(造用量块(造用量(20, 10)))
      块表.追加(造结束(造停止原因()))
    返回 块表

# ===== 工具函数 =====
段落 回显工具 接收 参数:
  返回 [["type": "text", "text": "ok"]]

段落 锁工具 接收 参数:
  返回 [["type": "text", "text": "locked"]]

段落 主:
  设 空注册表 为 新建 工具注册表()

  # ===== 对标 cancel.spec.ts：Cancel primitive 终止/是已终止 =====
  设 会话1 为 新建会话("cancel1", ".")
  设 代理1 为 新建 代理循环(会话1, 新建 文本客户端(), 空注册表, [])
  断言假(代理1.是已终止(), "初始未终止")
  代理1.终止(["种类": "user"])
  断言真(代理1.是已终止(), "终止后已终止")
  打印("S1通过：cancel primitive 终止/是已终止")

  # ===== 对标 cancel.spec.ts：中断结算 非空内容 → assistant/message 中断=真 =====
  设 会话2 为 新建会话("cancel2", ".")
  设 代理2 为 新建 代理循环(会话2, 新建 文本客户端(), 空注册表, [])
  设 内容块 为 [造文本块("部分回答")]
  代理2.结算被终止尝试(1, 1, 内容块, 空)
  设 消息事件 为 会话2.查询事件("assistant/message", 0, 0)
  断言相等(长度(消息事件), 1, "中断结算记录一条 assistant/message")
  断言真(字典获取(消息事件[0]["数据"], "中断"), "中断标记为真")
  打印("S2通过：中断结算非空内容 → assistant/message 中断=真")

  # ===== 对标 cancel.spec.ts：中断结算 空内容 → assistant/attempt =====
  设 会话3 为 新建会话("cancel3", ".")
  设 代理3 为 新建 代理循环(会话3, 新建 文本客户端(), 空注册表, [])
  代理3.结算被终止尝试(1, 1, [], 空)
  设 尝试事件 为 会话3.查询事件("assistant/attempt", 0, 0)
  断言相等(长度(尝试事件), 1, "空内容中断结算记录一条 assistant/attempt")
  打印("S3通过：中断结算空内容 → assistant/attempt")

  # ===== 对标 cancel.spec.ts：预终止驱动 → aborted =====
  设 会话4 为 新建会话("cancel4", ".")
  设 代理4 为 新建 代理循环(会话4, 新建 文本客户端(), 空注册表, [])
  代理4.终止(["种类": "user"])
  设 结果4 为 代理4.驱动("测试")
  断言相等(结果4["种类"], "aborted", "预终止驱动返回 aborted")
  打印("S4通过：预终止驱动 → aborted")

  # ===== 对标 loop.spec.ts：max-tokens 终止 =====
  设 会话5 为 新建会话("mt1", ".")
  设 代理5 为 新建 代理循环(会话5, 新建 超长客户端(), 空注册表, [])
  设 结果5 为 代理5.驱动("测试")
  断言相等(结果5["种类"], "max-tokens", "超长原因返回 max-tokens")
  打印("S5通过：max-tokens 终止")

  # ===== 对标 loop.spec.ts：max-tokens 丢弃工具调用 =====
  设 会话6 为 新建会话("mt2", ".")
  设 注册表6 为 新建 工具注册表()
  注册表6.注册(造工具定义("echo", "回显", ["type": "object"], 回显工具))
  设 代理6 为 新建 代理循环(会话6, 新建 超长工具客户端(), 注册表6, [])
  设 结果6 为 代理6.驱动("测试")
  断言相等(结果6["种类"], "max-tokens", "超长+工具返回 max-tokens")
  设 工具调用事件 为 会话6.查询事件("tool/call", 0, 0)
  断言相等(长度(工具调用事件), 0, "max-tokens 不派发工具调用")
  打印("S6通过：max-tokens 丢弃工具调用")

  # ===== 对标 loop.spec.ts：max-tokens 不跨轮泄漏 =====
  设 会话7 为 新建会话("mt3", ".")
  设 代理7 为 新建 代理循环(会话7, 新建 双轮客户端(), 空注册表, [])
  设 结果7a 为 代理7.驱动("测试")
  断言相等(结果7a["种类"], "max-tokens", "首轮 max-tokens")
  设 结果7b 为 代理7.驱动("测试")
  断言相等(结果7b["种类"], "completed", "次轮正常完成（max-tokens 不跨轮泄漏）")
  打印("S7通过：max-tokens 不跨轮泄漏")

  # ===== 对标 loop.spec.ts：客户端异常 → error =====
  设 会话8 为 新建会话("err1", ".")
  设 代理8 为 新建 代理循环(会话8, 新建 抛错客户端(), 空注册表, [])
  设 结果8 为 代理8.驱动("测试")
  断言相等(结果8["种类"], "error", "客户端异常返回 error")
  断言真(结果8.包含("失败"), "error 结果包含失败字段")
  打印("S8通过：客户端异常 → error")

  # ===== 对标 loop.spec.ts：错误完成原因 → error =====
  设 会话9 为 新建会话("err2", ".")
  设 代理9 为 新建 代理循环(会话9, 新建 错误完成客户端(), 空注册表, [])
  设 结果9 为 代理9.驱动("测试")
  断言相等(结果9["种类"], "error", "错误完成原因返回 error")
  打印("S9通过：错误完成原因 → error")

  # ===== 对标 loop.spec.ts：请求配置 =====
  设 会话10 为 新建会话("cfg1", ".")
  设 代理10 为 新建 代理循环(会话10, 新建 文本客户端(), 空注册表, ["提供方": "prov1", "系统提示文本": "S1"])
  设 配置 为 代理10.请求配置()
  断言相等(字典获取(配置, "提供方"), "prov1", "请求配置提供方")
  断言相等(字典获取(配置, "模型"), "deepseek-chat", "请求配置模型")
  打印("S10通过：请求配置")

  # ===== 对标 loop.spec.ts：读后置提示能力 =====
  设 会话11 为 新建会话("cfg2", ".")
  设 代理11a 为 新建 代理循环(会话11, 新建 文本客户端(), 空注册表, ["路由读后置系统提示": 真])
  断言真(代理11a.读后置提示(), "读后置提示为真")
  设 代理11b 为 新建 代理循环(会话11, 新建 文本客户端(), 空注册表, ["路由读后置系统提示": 假])
  断言假(代理11b.读后置提示(), "读后置提示为假")
  设 代理11c 为 新建 代理循环(会话11, 新建 文本客户端(), 空注册表, [])
  断言假(代理11c.读后置提示(), "默认读后置提示为假")
  打印("S11通过：读后置提示能力")

  # ===== 对标 loop.spec.ts：渲染系统提示 =====
  设 会话12 为 新建会话("cfg3", ".")
  设 代理12a 为 新建 代理循环(会话12, 新建 文本客户端(), 空注册表, ["系统提示文本": "你好"])
  断言相等(代理12a.渲染系统提示(), "你好", "渲染系统提示返回文本")
  设 代理12b 为 新建 代理循环(会话12, 新建 文本客户端(), 空注册表, [])
  断言相等(代理12b.渲染系统提示(), "", "默认渲染系统提示为空")
  打印("S12通过：渲染系统提示")

  # ===== 对标 loop.spec.ts：工具模式变化检测 =====
  设 会话13 为 新建会话("cfg4", ".")
  设 注册表13 为 新建 工具注册表()
  注册表13.注册(造工具定义("echo", "回显", ["type": "object"], 回显工具))
  设 代理13 为 新建 代理循环(会话13, 新建 文本客户端(), 注册表13, [])
  代理13.记录请求准入(1, 1, ["echo"], 假)
  断言假(代理13.工具模式变化(["echo"]), "同工具模式无变化")
  断言真(代理13.工具模式变化(["echo", "other"]), "工具模式变化检测")
  打印("S13通过：工具模式变化检测")

  # ===== 对标 loop.spec.ts：请求面世代变化 =====
  设 会话14 为 新建会话("cfg5", ".")
  设 选项14 为 ["提供方": "prov", "系统提示文本": "S1", "路由读后置系统提示": 假]
  设 代理14 为 新建 代理循环(会话14, 新建 文本客户端(), 空注册表, 选项14)
  代理14.准备请求准入(1, 1, 假)
  代理14.记录请求准入(1, 1, [], 假)
  断言假(代理14.面代变化(), "首次无面代变化")
  字典设置(选项14, "系统提示文本", "S2")
  代理14.准备请求准入(1, 2, 假)
  断言真(代理14.面代变化(), "替换后面代变化")
  打印("S14通过：请求面世代变化")

  # ===== 对标 loop.spec.ts：溢出错误检测 =====
  设 代理15 为 新建 代理循环(新建会话("ovf", "."), 新建 文本客户端(), 空注册表, [])
  断言真(代理15.是溢出错误("context too long"), "检测 context")
  断言真(代理15.是溢出错误("maximum context length exceeded"), "检测 maximum context")
  断言真(代理15.是溢出错误("overflow"), "检测 overflow")
  断言真(代理15.是溢出错误("too long"), "检测 too long")
  断言真(代理15.是溢出错误("400 Bad Request"), "检测 400")
  断言假(代理15.是溢出错误("network timeout"), "非溢出错误返回假")
  断言假(代理15.是溢出错误("unauthorized"), "非溢出错误返回假")
  打印("S15通过：溢出错误检测")

  # ===== 对标 tool-calls.spec.ts：并行工具执行 =====
  设 会话16 为 新建会话("tool1", ".")
  设 注册表16 为 新建 工具注册表()
  注册表16.注册(造工具定义("echo", "回显", ["type": "object"], 回显工具))
  设 代理16 为 新建 代理循环(会话16, 新建 双工具文本客户端(), 注册表16, [])
  设 结果16 为 代理16.驱动("测试")
  设 工具调用表 为 会话16.查询事件("tool/call", 0, 0)
  设 工具结果表 为 会话16.查询事件("tool/result", 0, 0)
  断言相等(长度(工具调用表), 2, "两个并行工具调用")
  断言相等(长度(工具结果表), 2, "两个并行工具结果")
  打印("S16通过：并行工具执行")

  # ===== 对标 tool-calls.spec.ts：独占工具屏障 =====
  设 会话17 为 新建会话("tool2", ".")
  设 注册表17 为 新建 工具注册表()
  注册表17.注册(造工具定义("echo", "回显", ["type": "object"], 回显工具))
  注册表17.注册(造工具定义("lock", "锁", ["type": "object"], 锁工具, "exclusive"))
  设 代理17 为 新建 代理循环(会话17, 新建 屏障客户端(), 注册表17, [])
  设 结果17 为 代理17.驱动("测试")
  设 工具调用表17 为 会话17.查询事件("tool/call", 0, 0)
  设 工具结果表17 为 会话17.查询事件("tool/result", 0, 0)
  断言相等(长度(工具调用表17), 3, "屏障模式三个工具调用")
  断言相等(长度(工具结果表17), 3, "屏障模式三个工具结果")
  打印("S17通过：独占工具屏障")

  # ===== 对标 loop.spec.ts：轮次事件序列 =====
  设 会话18 为 新建会话("evt", ".")
  设 代理18 为 新建 代理循环(会话18, 新建 文本客户端(), 空注册表, [])
  设 结果18 为 代理18.驱动("测试")
  断言相等(结果18["种类"], "completed", "文本响应完成轮次")
  设 轮次开始表 为 会话18.查询事件("turn/start", 0, 0)
  设 步骤开始表 为 会话18.查询事件("step/start", 0, 0)
  设 步骤结束表 为 会话18.查询事件("step/end", 0, 0)
  设 轮次结束表 为 会话18.查询事件("turn/end", 0, 0)
  断言相等(长度(轮次开始表), 1, "一个轮次开始事件")
  断言相等(长度(步骤开始表), 1, "一个步骤开始事件")
  断言相等(长度(步骤结束表), 1, "一个步骤结束事件")
  断言相等(长度(轮次结束表), 1, "一个轮次结束事件")
  打印("S18通过：轮次事件序列")

  # ===== 对标 tool-calls.spec.ts：并发上限默认值 =====
  设 代理19 为 新建 代理循环(新建会话("cap", "."), 新建 文本客户端(), 空注册表, [])
  断言相等(代理19.并发上限, 4, "默认并发上限为4")
  打印("S19通过：并发上限默认值")

  # ===== 对标 request-error.spec.ts：客户端异常错误结构 =====
  设 会话20 为 新建会话("reqerr", ".")
  设 代理20 为 新建 代理循环(会话20, 新建 抛错客户端(), 空注册表, [])
