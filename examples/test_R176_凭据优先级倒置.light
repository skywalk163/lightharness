# test_R176_凭据优先级倒置.light —— B4 路 credentials rc.3 语义变更判据（有牙专钉）
# 上游锚点：dsh-v0.2.1-rc.3 = 1f81c047fc
#   packages/credentials/credentials-local/src/index.ts（resolve/describe/write/parseCredentialsDocument）
#   packages/credentials/credentials/src/index.ts（CredentialProvider 文档语义）
#
# 本文件钉四件事（rc.2 → rc.3 的行为差异）：
#   ① 优先级倒置：托管存储 file > env > project-env > user-env
#   ② describe 的 writable 恒真（含未配置引用）
#   ③ set/unset 不再因只读层遮蔽被拒（写入后托管值立刻生效；撤下后回退层重新生效）
#   ④ 未知顶层键容忍：不再拒绝启动，改回报 ignoredKeys
#
# 反跑判据（逐条实测，见 .hive/summary.md）：
#   - 把 凭据链.来源优先级 的 "file" 与 "env" 两行对调 → ① 必红
#   - 把 解析凭据视图 的 writable 改回「仅 file 为真」→ ② 必红
#   - 把 本地凭证提供者.置 的遮蔽拒绝加回 → ③ 必红
#   - 把 分类顶层键 的 忽略 分支改成 已读 → ④ 必红

从 凭据链 导入 来源表, 来源优先级, 解析凭据视图, 可否写入, 分类顶层键, 是空文档键表
从 凭据 导入 本地凭证提供者
从 内置核心字典 导入 字典创建, 字典设置, 字典获取, 字典包含键

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 造层(初始):
  设 层 为 字典创建()
  字典设置(层, "file", 字典创建())
  字典设置(层, "env", 字典创建())
  字典设置(层, "project-env", 字典创建())
  字典设置(层, "user-env", 字典创建())
  遍历 名 之 字典键列表(初始):
    字典设置(层, 名, 字典获取(初始, 名, 字典创建()))
  返回 层

段落 主:
  # ================= ① 优先级倒置 =================
  断言相等(来源优先级()[0], "file", "① 托管存储居首")
  断言相等(来源优先级()[1], "env", "① env 退为回退层")
  断言相等(来源表(), 来源优先级(), "① 来源表序即优先级序")

  设 双有 为 解析凭据视图(真, 真, 假, 假)
  断言相等(双有["source"], "file", "①b env 与 file 同有 → file 胜（rc.2 是 env 胜）")

  设 无文件 为 解析凭据视图(真, 假, 真, 真)
  断言相等(无文件["source"], "env", "①c 托管缺位时 env 才生效")

  设 仅用户 为 解析凭据视图(假, 假, 假, 真)
  断言相等(仅用户["source"], "user-env", "①d 最末回退层仍可命中")

  # ================= ② writable 恒真 =================
  断言相等(双有["writable"], 真, "② file 命中可写")
  断言相等(无文件["writable"], 真, "②b env 命中也可写（rc.3 全引用可写）")
  断言相等(仅用户["writable"], 真, "②c user-env 命中也可写")
  设 全无 为 解析凭据视图(假, 假, 假, 假)
  断言相等(全无["writable"], 真, "②d 未配置引用同样可写（上游 describe 缺省 writable:true）")
  断言相等(全无["configured"], 假, "②e 可写不等于已配置")

  # ================= ③ 写入/撤下不再因遮蔽被拒 =================
  设 写环境 为 可否写入(无文件, "sk-x")
  断言相等(写环境["合法"], 真, "③ env 来源可写")
  断言相等(写环境["消息"], "", "③b 合法时无消息")
  设 写空 为 可否写入(全无, "")
  断言相等(写空["合法"], 假, "③c 空值仍拒绝（上游保留该拒绝）")

  设 env层 为 字典创建()
  字典设置(env层, "K", "from-env")
  设 初始1 为 字典创建()
  字典设置(初始1, "env", env层)
  设 p 为 新建 本地凭证提供者(造层(初始1))
  断言相等(p.读取("K"), "from-env", "③d 初始命中 env 回退层")
  p.置("K", "from-store")
  断言相等(p.读取("K"), "from-store", "③e 写托管存储后立刻压过 env（不再抛错）")
  设 d 为 p.描述("K")
  断言相等(d["源"], "file", "③f 描述来源翻到 file")
  断言相等(d["可写"], 真, "③g 描述可写")

  p.清除("K")
  断言相等(p.读取("K"), "from-env", "③h 撤下托管值后回退层重新生效")
  设 d2 为 p.描述("K")
  断言相等(d2["源"], "env", "③i 描述来源退回 env")

  # 撤下不存在的引用是 no-op（上游：removing an absent reference is a no-op）
  设 抛了 为 假
  尝试:
    p.清除("NOT_THERE")
  捕获 异常 e:
    设 抛了 为 真
  断言相等(抛了, 假, "③j 撤下缺席引用不抛错")

  # ================= ④ 未知顶层键容忍 =================
  设 键表1 为 ["version", "refs", "records", "anotherTool"]
  设 分1 为 分类顶层键(键表1)
  断言相等(分1["已读"], ["version", "refs", "records"], "④ 三个已读键保序")
  断言相等(分1["忽略"], ["anotherTool"], "④b 外来键进 ignoredKeys")
  断言真(分1["未知"], "④c 未知标志为真")

  设 键表2 为 ["version", "refs"]
  设 分2 为 分类顶层键(键表2)
  断言相等(分2["忽略"], [], "④d 无外来键时忽略为空")
  断言相等(分2["未知"], 假, "④e 未知标志为假")

  断言真(是空文档键表([]), "④f 空文档（零键）判空")
  断言相等(是空文档键表(["version"]), 假, "④g 只有版本号不算空文档")

  打印("test_R176_凭据优先级倒置: 全部用例通过")

主()
