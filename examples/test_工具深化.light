# test_工具深化.light —— 工具 v2：批量执行 + 汇总统计
从 工具 导入 工具注册表, 造工具定义, 造工具模式

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 注册表 为 新建 工具注册表()

  # 注册工具A：回显参数
  段落 执行A 接收 参数:
    返回 [["type": "text", "text": "A:" + 转字符串(参数["值"])]]
  注册表.注册(造工具定义("工具A", "测试工具A", ["type": "object", "properties": ["值": ["type": "string"]], "required": ["值"]], 执行A))

  # 注册工具B：加法
  段落 执行B 接收 参数:
    设 和 为 参数["a"] + 参数["b"]
    返回 [["type": "text", "text": "和=" + 转字符串(和)]]
  注册表.注册(造工具定义("工具B", "加法工具", ["type": "object", "properties": ["a": ["type": "integer"], "b": ["type": "integer"]], "required": ["a", "b"]], 执行B))

  # ===== 批量执行 =====
  打印 "=== 批量执行测试 ==="
  设 调用表 为 []
  调用表.追加(["名字": "工具A", "参数": "{\"值\":\"hello\"}"])
  调用表.追加(["名字": "工具B", "参数": "{\"a\":3, \"b\":4}"])
  调用表.追加(["名字": "工具A", "参数": "{\"值\":\"world\"}"])

  设 批量结果 为 注册表.批量执行(调用表)
  断言等于(长度(批量结果), 3, "批量执行返回3个结果")
  断言等于(批量结果[0]["isError"], 假, "第1个成功")
  断言等于(批量结果[0]["content"][0]["text"], "A:hello", "第1个结果正确")
  断言等于(批量结果[1]["isError"], 假, "第2个成功")
  断言等于(批量结果[1]["content"][0]["text"], "和=7", "加法结果正确")
  断言等于(批量结果[2]["content"][0]["text"], "A:world", "第3个结果正确")

  # 批量执行含未知工具
  设 调用表2 为 []
  调用表2.追加(["名字": "不存在", "参数": "{}"])
  设 批量结果2 为 注册表.批量执行(调用表2)
  断言等于(批量结果2[0]["isError"], 真, "未知工具返回错误")

  # ===== 汇总统计 =====
  打印 "=== 汇总统计测试 ==="
  设 汇总 为 注册表.汇总统计()
  断言等于(汇总["总调用"], 3, "总调用=3(未知工具提前返回不计统计)")
  断言等于(汇总["总成功"], 3, "总成功=3")
  断言等于(汇总["总失败"], 0, "总失败=0")

  打印 "--- 工具深化测试通过 ---"

主()
