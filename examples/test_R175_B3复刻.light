# test_R175_B3复刻.light —— R175（T-0175）B3 线三小项端到端回归判据
# 运行：python 运行.py examples/test_R175_B3复刻.light
#
# 反跑判据（把下面任一期望值改反，本用例必须红）：
#   §A 子代理预设选择（preset-selection.ts）：白名单去重 / 默认值须在白名单内 /
#      description 回落与 Available presets / resolve 缺省兜底 / 未开白名单即禁用 /
#      提供方断言（不支持独立预设 → 拒）
#   §B 子代理活化（activation.ts）：名额上限 / 释放幂等 / 本地取 Agent、外部拒收 /
#      串行锁尾替换与「只在本轮仍是尾才收尾」
#   §C 工作区成员（workspace/entity.ts）：解析不出保留归属 / 名单过滤 / 裁决未变哨兵

从 子代理预设选择 导入 预选新建, 预选已配置, 预选可选表, 预选描述, 预选解析, 预选断言提供方, 预选校验服务
从 子代理活化 导入 活化新池, 活化占用, 活化释放, 活化在飞, 活化本地的, 活化外部的, 活化取代理, 活化要求本地, 活化新锁, 活化排队, 活化收尾, 活化活跃子数
从 工作区成员 导入 成员_候选匹配, 成员_名单, 成员_裁决

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 信息 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 信息):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 信息)

段落 主:
  # ============ §A 子代理预设选择 ============
  设 选 为 预选新建({"默认": "assist", "白名单": ["assist", "isolated"]})
  断言真(预选已配置(选), "A1 配了默认+白名单即已配置")
  断言相等(连接字符串(预选可选表(选), ","), "assist,isolated", "A2 choices=白名单")
  断言相等(预选描述(选), "Agent preset for this child. Omit to use assist.", "A3 description 默认回落")
  断言相等(预选描述(选, ["assist: 只读助手", "isolated: 无父上下文"]),
    "Agent preset for this child. Omit to use assist. Available presets: assist: 只读助手; isolated: 无父上下文",
    "A4 description 拼可用清单")
  断言相等(预选解析(选, {}), "assist", "A5 缺省回落部署默认")
  断言相等(预选解析(选, {"agent_preset": "isolated"}), "isolated", "A6 白名单内可选")
  断言相等(连接字符串(预选校验服务(选, 真, {"assist": {"description": "只读助手"}, "isolated": {"description": "无父上下文"}}), "|"),
    "assist: 只读助手|isolated: 无父上下文", "A7 validate 只收白名单内带描述")
  断言真(预选断言提供方(选, {"名字": "p", "支持预设": 真, "继承父上下文": 假}), "A8 支持独立预设 → 通过")
  # 默认值不在白名单内的配置必须被构造期拒绝（此处用正向对照：把 assist 放进白名单才建得出来）
  设 无默认 为 预选新建({"默认": 空, "白名单": 空})
  断言相等(预选已配置(无默认), 假, "A9 全空即未配置")
  断言相等(预选解析(无默认, {}), 空, "A10 未配置时缺省回落 空")
  断言相等(连接字符串(预选校验服务(无默认, 假, {}), ","), "", "A11 未配置不要求服务")

  # ============ §B 子代理活化 ============
  设 池 为 活化新池(2)
  设 令一 为 活化占用(池)
  设 令二 为 活化占用(池)
  断言相等(活化在飞(池), 2, "B1 占满 2")
  断言相等(活化释放(池, 令一), 真, "B2 首次释放成功")
  断言相等(活化释放(池, 令一), 假, "B3 重复释放幂等返假")
  断言相等(活化释放(池, 999), 假, "B4 未占用令牌释放返假")
  设 令三 为 活化占用(池)
  断言相等(活化在飞(池), 2, "B5 释放后能再占")
  断言相等(令三, 令二 + 1, "B6 令牌单调递增")
  设 本地 为 活化本地的("子会话-1", {"名": "child"})
  断言相等(活化取代理(本地)["名"], "child", "B7 本地活化可取 Agent")
  断言相等(活化取代理(活化外部的("子会话-2", {"运行": 1})), 空, "B8 外部活化无 Agent")
  断言相等(活化要求本地(本地)["标识"], "子会话-1", "B9 本地可继续输入")
  设 锁 为 活化新锁()
  设 一 为 活化排队(锁, "子会话-1")
  设 二 为 活化排队(锁, "子会话-1")
  设 三 为 活化排队(锁, "子会话-2")
  断言相等(一["前序号"], 空, "B10 首轮无前序")
  断言相等(二["前序号"], 一["序号"], "B11 同子会话 FIFO 串接")
  断言相等(三["前序号"], 空, "B12 不同子会话各自独立")
  断言相等(活化收尾(锁, "子会话-1", 一["序号"]), 假, "B13 非尾轮收尾不动条目")
  断言相等(活化收尾(锁, "子会话-1", 二["序号"]), 真, "B14 尾轮收尾成功")
  断言相等(活化活跃子数(锁), 1, "B15 只剩 子会话-2 的尾")

  # ============ §C 工作区成员 ============
  设 家 为 "/home/u/proj"
  断言真(成员_候选匹配({"标识": "S1", "规范路径": "/home/u/proj", "可解析": 真}, 家), "C1 同名保留")
  断言相等(成员_候选匹配({"标识": "S2", "规范路径": "/home/u/other", "可解析": 真}, 家), 假, "C2 异名剔除")
  断言真(成员_候选匹配({"标识": "S3", "规范路径": "/home/u/gone", "可解析": 假}, 家), "C3 解析不出→保留归属")
  设 录 为 {"路径": 家, "成员": [{"标识": "S1", "规范路径": "/home/u/proj", "可解析": 真}, {"标识": "S2", "规范路径": "/home/u/other", "可解析": 真}, {"标识": "S3", "规范路径": "/home/u/gone", "可解析": 假}]}
  断言相等(连接字符串(成员_名单(录), ","), "S1,S3", "C4 名单按候选匹配过滤")
  断言相等(成员_裁决(录, 空)["未变"], 假, "C5 过滤掉成员后长度变→非未变")
  设 全中 为 {"路径": 家, "成员": [{"标识": "S1", "规范路径": "/home/u/proj", "可解析": 真}, {"标识": "S3", "规范路径": "/home/u/gone", "可解析": 假}]}
  断言真(成员_裁决(全中, 空)["未变"], "C6 同对象且长度不变→未变哨兵")
  设 变更 为 {"路径": 家, "成员": [{"标识": "S1", "规范路径": "/home/u/proj", "可解析": 真}, {"标识": "S9", "规范路径": "/home/u/proj", "可解析": 真}]}
  设 判 为 成员_裁决(录, 变更)
  断言相等(连接字符串(判["成员"], ","), "S1,S9", "C7 变更后按新路径过滤")
  断言相等(判["未变"], 假, "C8 换了对象→非未变")

  打印("R175 B3 复刻判据全绿")