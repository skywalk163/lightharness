# test_工作区变更_接线.light —— 第6轮 任务E #289 工作区变更/交付呈现接线 判据
# 运行：python 运行.py examples/test_工作区变更_接线.light
# 判据：工区交付判定（轮记录改动文件表 → 交付.判定需交付/造交付事件）
#       + 接线交呈工具（present 工具注册进 工具注册表，宿主钩子注入）；
#       纯逻辑回归绿由 test_R85_D_工作区变更.light / test_R85_D_交付呈现.light 承担。

从 工作区变更 导入 工区交付判定, 工区构造轮记录, 工区构造文件编辑
从 交付呈现 导入 接线交呈工具, 交呈构造文件
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主钩子：取文件类型 恒 file
段落 mock取类型(路径):
  返回 "file"

段落 主:
  # ---- 1. 未声明改动 -> 未交付（须补声明） ----
  设 轮记录 为 工区构造轮记录(1, "/w", [工区构造文件编辑("/w/a.md", "写文件", 1)], 1, 1, 0, {}, {"/w/a.md": "新"})
  设 r1 为 工区交付判定(轮记录, [], "call-1")
  断言相等(列表长度(r1["判定"]["未交付"]), 1, "1a 未声明改动")
  断言相等(r1["判定"]["未交付"][0], "/w/a.md", "1b 路径")
  断言真(r1["交付事件"] != 空, "1c 有交付事件")

  # ---- 2. 已声明 -> 已交付（无事件） ----
  设 r2 为 工区交付判定(轮记录, [{"路径": "/w/a.md"}], "call-1")
  断言相等(列表长度(r2["判定"]["已交付"]), 1, "2a 已声明")
  断言相等(r2["交付事件"], 空, "2b 无事件")

  # ---- 3. 无改动 -> 全空 ----
  设 空轮 为 工区构造轮记录(2, "/w", [], 0, 0, 0, {}, {})
  设 r3 为 工区交付判定(空轮, [{"路径": "/w/a.md"}], "call-2")
  断言相等(列表长度(r3["判定"]["未交付"]), 0, "3a 无未交付")

  # ---- 4. present 工具注册 + 执行（宿主钩子注入） ----
  设 注册表 为 新建 工具注册表()
  断言真(接线交呈工具(注册表, {"取文件类型": mock取类型}), "4a 接线返回真")
  断言真(注册表.有无("present"), "4b present 可见")
  设 结果 为 注册表.查找("present")["execute"]({"文件列表": [交呈构造文件("/a.md", "说明")]})
  断言真(结果["isError"] == 假, "4c 执行成功")
  断言真(字符串包含(结果["content"][0]["text"], "Presented /a.md"), "4d 渲染输出")

  # ---- 5. 非常规文件 -> 抛错（宿主钩子判定保留） ----
  段落 mock非文件(路径):
    返回 "other"
  设 注册表2 为 新建 工具注册表()
  接线交呈工具(注册表2, {"取文件类型": mock非文件})
  设 已抛 为 假
  尝试:
    设 _r5 为 注册表2.查找("present")["execute"]({"文件列表": [交呈构造文件("/a.md", "")]})
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "5a 非 file 须抛")

  打印 "--- 第6轮 任务E #289 工作区/交付呈现接线 测试通过 ---"

主()