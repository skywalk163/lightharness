# test_修复_repair.light —— 第 10 轮任务 1：repair 域复刻（中断轮闭合器）行为对照
# 上游：packages/core/session/src/repair.ts interruptedTurnClosers + tests/repair.spec.ts（10 场景）
# 覆盖：平衡/空日志返回空 / 仅 turn 闭合 / step 先于 turn / TOOL_NOT_STARTED /
#       已答与已闭步骤不合成 / 早前轮不泄漏 / 多调用按日志序 / TOOL_OUTCOME_UNKNOWN +
#       来源事件序号 / 孤儿 tool/call 优雅处理 / 恢复码常量导出。
# 反跑判据：_antirun_repair.py（A 错误码改错 / B 序号基线改错 / C 平衡返回空改错 → 红）
# 运行：cd lightharness && python 运行.py examples/test_修复_repair.light

从 会话格式 导入 中断轮闭合器, 造事件, 恢复码工具未启动, 恢复码结果未知, 校验事件载荷

段落 核验 接收 标签, 实际, 期望, 备注:
  如果 实际 != 期望:
    打印 "✗ 失败：" + 标签 + " 期望=" + 转字符串(期望) + " 实际=" + 转字符串(实际) + " (" + 备注 + ")"
    抛出 "第10轮任务1 断言失败: " + 标签
  打印 "✓ " + 标签 + " (" + 备注 + ")"
  返回 真

段落 核验真 接收 标签, 条件, 备注:
  返回 核验(标签, 条件, 真, 备注)

段落 核验含 接收 标签, 容器文本, 子串, 备注:
  设 命中 为 假
  设 n 为 长度(容器文本)
  设 m 为 长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 容器文本[i:(i+m)] == 子串:
      设 命中 为 真
    设 i 为 i + 1
  返回 核验真(标签, 命中, 备注)

# ---- 日志构造助手（形状对齐上游 repair.spec.ts）----
段落 造轮开始 接收 轮, 序号:
  设 数据 为 {}
  数据["turn"] 为 轮
  返回 造事件("turn/start", 序号, 序号, 数据)

段落 造轮结束 接收 轮, 序号:
  设 数据 为 {}
  数据["turn"] 为 轮
  设 原因 为 {}
  原因["kind"] 为 "completed"
  数据["reason"] 为 原因
  返回 造事件("turn/end", 序号, 序号, 数据)

段落 造步开始 接收 轮, 步, 序号:
  设 数据 为 {}
  数据["turn"] 为 轮
  数据["step"] 为 步
  返回 造事件("step/start", 序号, 序号, 数据)

段落 造步结束 接收 轮, 步, 序号:
  设 数据 为 {}
  数据["turn"] 为 轮
  数据["step"] 为 步
  返回 造事件("step/end", 序号, 序号, 数据)

段落 造助手调用 接收 序号, 调用标识表:
  设 内容 为 []
  遍历 调用标识 之 调用标识表:
    设 调用块 为 {}
    调用块["type"] 为 "tool-call"
    调用块["id"] 为 调用标识
    调用块["name"] 为 "bash"
    列表追加(内容, 调用块)
  设 消息 为 {}
  消息["role"] 为 "assistant"
  消息["content"] 为 内容
  设 数据 为 {}
  数据["消息"] 为 消息
  数据["step"] 为 1
  返回 造事件("assistant/message", 序号, 序号, 数据)

段落 造工具结果 接收 序号, 调用标识:
  设 来源 为 {}
  来源["kind"] 为 "tool"
  来源["callId"] 为 调用标识
  设 消息 为 {}
  消息["来源"] 为 来源
  消息["content"] 为 []
  设 数据 为 {}
  数据["调用"] 为 调用标识
  数据["成功"] 为 假
  数据["消息"] 为 消息
  返回 造事件("tool/result", 序号, 序号, 数据)

段落 主:
  打印 "===== 第 10 轮任务 1：repair 域复刻回归 ====="

  # ---- 场景1：平衡日志（turn/end 收尾）返回空 ----
  设 日志甲 为 []
  列表追加(日志甲, 造轮开始(1, 0))
  列表追加(日志甲, 造轮结束(1, 1))
  核验真("1 平衡日志返回空", 长度(中断轮闭合器(日志甲)) == 0, "上游 toEqual([])")

  # ---- 场景2：空日志返回空 ----
  核验真("2 空日志返回空", 长度(中断轮闭合器([])) == 0, "上游 toEqual([])")

  # ---- 场景3：未闭合 turn（仅 turn/start）→ 仅 turn/end ----
  设 日志乙 为 []
  列表追加(日志乙, 造轮开始(1, 0))
  设 闭合乙 为 中断轮闭合器(日志乙)
  核验真("3a 仅 turn/end", (长度(闭合乙) == 1) 且 (闭合乙[0]["类型"] == "turn/end"), "上游 ['turn/end']")
  核验("3b 序号续接", 闭合乙[0]["序号"], 1, "最后真实 seq+1")
  核验("3c 原因 interrupted", 闭合乙[0]["数据"]["原因"], "interrupted", "上游 reason.kind=interrupted 展平")

  # ---- 场景4：未闭合 step → step/end 先于 turn/end ----
  设 日志丙 为 []
  列表追加(日志丙, 造轮开始(1, 0))
  列表追加(日志丙, 造步开始(1, 1, 1))
  设 闭合丙 为 中断轮闭合器(日志丙)
  核验("4a 类型序", 闭合丙[0]["类型"] + "/" + 闭合丙[1]["类型"], "step/end/turn/end", "先步后轮")
  核验("4b 序号", 转字符串(闭合丙[0]["序号"]) + "/" + 转字符串(闭合丙[1]["序号"]), "2/3", "上游 [2,3]")

  # ---- 场景5：未闭合 tool-call（无 tool/call 记录）→ TOOL_NOT_STARTED ----
  设 日志丁 为 []
  列表追加(日志丁, 造轮开始(2, 0))
  列表追加(日志丁, 造步开始(2, 1, 1))
  列表追加(日志丁, 造助手调用(2, ["call-1"]))
  设 闭合丁 为 中断轮闭合器(日志丁)
  核验("5a 三段闭合", 闭合丁[0]["类型"] + "/" + 闭合丁[1]["类型"] + "/" + 闭合丁[2]["类型"], "tool/result/step/end/turn/end", "result→step→turn")
  核验("5b 序号", 转字符串(闭合丁[0]["序号"]) + "/" + 转字符串(闭合丁[1]["序号"]) + "/" + 转字符串(闭合丁[2]["序号"]), "3/4/5", "上游 [3,4,5]")
  设 结果丁 为 闭合丁[0]["数据"]
  核验("5c callId", 结果丁["消息"]["来源"]["callId"], "call-1", "消息.来源.callId")
  核验("5d 错误码", 结果丁["错误"]["代码"], 恢复码工具未启动, "TOOL_NOT_STARTED")
  核验("5e 错误名", 结果丁["错误"]["名称"], "ToolNotStartedError", "上游同文案")
  核验含("5f 提示文案", 结果丁["消息"]["content"][0]["content"][0]["text"], "Retry it if it is still needed", "上游同文案")
  核验真("5g isError", 结果丁["消息"]["content"][0]["isError"] == 真, "错误结果标记")
  核验真("5h 无来源序号", 字典包含键(闭合丁[0], "来源事件序号") == 假, "未启动不携带 sourceEventSeqs")
  核验("5i 消息id", 结果丁["消息"]["id"], "interrupted-tool-result-call-1-3", "上游 id 形状")

  # ---- 场景6：已有 result 的 call 不再合成 ----
  设 日志戊 为 []
  列表追加(日志戊, 造轮开始(2, 0))
  列表追加(日志戊, 造步开始(2, 1, 1))
  列表追加(日志戊, 造助手调用(2, ["call-1"]))
  列表追加(日志戊, 造工具结果(3, "call-1"))
  设 闭合戊 为 中断轮闭合器(日志戊)
  核验("6 已答不合成", 闭合戊[0]["类型"] + "/" + 闭合戊[1]["类型"], "step/end/turn/end", "上游 ['step/end','turn/end']")

  # ---- 场景7：step/end 已闭合后不合成，仅 turn/end ----
  设 日志己 为 []
  列表追加(日志己, 造轮开始(2, 0))
  列表追加(日志己, 造步开始(2, 1, 1))
  列表追加(日志己, 造助手调用(2, ["call-1"]))
  列表追加(日志己, 造步结束(2, 1, 3))
  设 闭合己 为 中断轮闭合器(日志己)
  核验真("7a 仅 turn/end", (长度(闭合己) == 1) 且 (闭合己[0]["类型"] == "turn/end"), "step/end 清空待决调用")
  核验("7b 序号", 闭合己[0]["序号"], 4, "上游 toBe(4)")

  # ---- 场景8：早前轮 call 不泄漏到尾部修复 ----
  设 日志庚 为 []
  列表追加(日志庚, 造轮开始(1, 0))
  列表追加(日志庚, 造步开始(1, 1, 1))
  列表追加(日志庚, 造助手调用(2, ["old-call"]))
  列表追加(日志庚, 造工具结果(3, "old-call"))
  列表追加(日志庚, 造步结束(1, 1, 4))
  列表追加(日志庚, 造轮结束(1, 5))
  列表追加(日志庚, 造轮开始(2, 6))
  列表追加(日志庚, 造步开始(2, 1, 7))
  列表追加(日志庚, 造助手调用(8, ["new-call"]))
  设 闭合庚 为 中断轮闭合器(日志庚)
  核验("8a 三段闭合", 闭合庚[0]["类型"] + "/" + 闭合庚[1]["类型"] + "/" + 闭合庚[2]["类型"], "tool/result/step/end/turn/end", "仅轮2 待决")
  核验("8b 只合成 new-call", 闭合庚[0]["数据"]["消息"]["来源"]["callId"], "new-call", "old-call 不泄漏")

  # ---- 场景9：多未决 call 按日志序，仅未答者合成 ----
  设 日志辛 为 []
  列表追加(日志辛, 造轮开始(1, 0))
  列表追加(日志辛, 造步开始(1, 1, 1))
  列表追加(日志辛, 造助手调用(2, ["call-a", "call-b"]))
  列表追加(日志辛, 造工具结果(3, "call-a"))
  设 闭合辛 为 中断轮闭合器(日志辛)
  核验("9 仅未答 call-b", 闭合辛[0]["数据"]["消息"]["来源"]["callId"], "call-b", "已答 call-a 跳过")

  # ---- 场景10：tool/call 已记录 → TOOL_OUTCOME_UNKNOWN + 来源事件序号 ----
  设 日志壬 为 []
  列表追加(日志壬, 造轮开始(1, 0))
  列表追加(日志壬, 造步开始(1, 1, 1))
  列表追加(日志壬, 造助手调用(2, ["call-1"]))
  设 调用数据 为 {}
  调用数据["turn"] 为 1
  调用数据["step"] 为 1
  调用数据["callId"] 为 "call-1"
  调用数据["name"] 为 "bash"
  列表追加(日志壬, 造事件("tool/call", 3, 3, 调用数据))
  设 闭合壬 为 中断轮闭合器(日志壬)
  设 结果壬 为 闭合壬[0]["数据"]
  核验("10a 错误码", 结果壬["错误"]["代码"], 恢复码结果未知, "TOOL_OUTCOME_UNKNOWN")
  核验("10b 错误名", 结果壬["错误"]["名称"], "ToolOutcomeUnknownError", "上游同文案")
  核验真("10c 来源事件序号", 闭合壬[0]["来源事件序号"][0] == 3, "上游 sourceEventSeqs=[3]")
  核验含("10d 只读重试提示", 结果壬["消息"]["content"][0]["content"][0]["text"], "retry only if the operation is read-only or idempotent", "上游同文案")
  核验含("10e 核实外部状态提示", 结果壬["消息"]["content"][0]["content"][0]["text"], "first verify external state or ask the user", "上游同文案")

  # ---- 场景11：孤儿 tool/call（无 assistant 注册）优雅处理 ----
  设 日志癸 为 []
  列表追加(日志癸, 造轮开始(1, 0))
  列表追加(日志癸, 造步开始(1, 1, 1))
  设 孤儿数据 为 {}
  孤儿数据["turn"] 为 1
  孤儿数据["step"] 为 1
  孤儿数据["callId"] 为 "orphan"
  列表追加(日志癸, 造事件("tool/call", 2, 2, 孤儿数据))
  设 闭合癸 为 中断轮闭合器(日志癸)
  核验("11 孤儿不合成 result", 闭合癸[0]["类型"] + "/" + 闭合癸[1]["类型"], "step/end/turn/end", "无待决则无 result")

  # ---- 附加：恢复码常量导出 ----
  核验("12 常量导出", 恢复码工具未启动 + "/" + 恢复码结果未知, "TOOL_NOT_STARTED/TOOL_OUTCOME_UNKNOWN", "对齐上游常量")

  # ---- 附加：合成事件通过光明 V3 严格载荷校验（tool/result / step/end / turn/end 词汇内）----
  设 校验一 为 校验事件载荷("tool/result", 结果丁, 真)
  设 校验二 为 校验事件载荷("step/end", 闭合丙[0]["数据"], 真)
  设 校验三 为 校验事件载荷("turn/end", 闭合乙[0]["数据"], 真)
  核验真("13 合成事件过 V3 严格校验", (校验一 == 真) 且 (校验二 == 真) 且 (校验三 == 真), "词汇内形状，可经 V3 编解码回放")

  打印 "===== 第 10 轮任务 1：repair 域复刻回归全部通过 ====="
