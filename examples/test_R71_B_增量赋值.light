# test_R71_B_增量赋值.light —— G-02 增量赋值运算符（R71 任务B）
# 语法：n 加为 5 → n += 5；减为/乘为/除为/取模为/幂为 同理。
# 覆盖：基础六种增量、对象属性增量（外部成员链 + 方法内 己.x）、
#       字典/列表下标增量、与普通赋值「为」共存不冲突。

类 计数器:
    段落 构造:
        己.计数 为 0
        己.步长 为 2
    段落 增:
        己.计数 加为 己.步长

段落 主:
    # ── 基础六种增量（值链与任务书一致）──
    设 n 为 10
    n 加为 5
    断言(n == 15, "加为: 10+5 应为 15")
    n 减为 3
    断言(n == 12, "减为: 15-3 应为 12")
    n 乘为 2
    断言(n == 24, "乘为: 12*2 应为 24")
    n 除为 4
    断言(n == 6.0, "除为: 24/4 应为 6.0")
    n 取模为 5
    断言(n == 1.0, "取模为: 6.0%5 应为 1.0")
    n 幂为 3
    断言(n == 1.0, "幂为: 1.0**3 应为 1.0")

    # ── 与普通赋值「为」共存 ──
    设 m 为 100
    m 加为 1
    断言(m == 101, "普通赋值后再增量应生效")
    设 m 为 200
    断言(m == 200, "普通赋值「为」语义不受影响")

    # ── 列表下标增量 ──
    设 表 为 [10, 20, 30]
    表[0] 加为 5
    断言(表[0] == 15, "列表下标加为")
    表[1] 乘为 2
    断言(表[1] == 40, "列表下标乘为")

    # ── 字典下标增量 ──
    设 d 为 {"k": 1}
    d["k"] 加为 41
    断言(d["k"] == 42, "字典下标加为")
    d["k"] 减为 2
    断言(d["k"] == 40, "字典下标减为")

    # ── 对象属性增量：外部成员链 ──
    设 c 为 新建 计数器()
    c.计数 加为 5
    断言(c.计数 == 5, "对象属性加为（外部成员链）")
    c.计数 乘为 3
    断言(c.计数 == 15, "对象属性乘为（外部成员链）")

    # ── 方法内 己.属性 增量 ──
    c.增()
    断言(c.计数 == 17, "方法内 己.计数 加为 己.步长（0→5→15→17）")

    打印("test_R71_B PASS")
