# 运行Web服务器.light —— lightharness Web API 服务入口（Task B）
#
# 用法:
#   python 运行.py examples/运行Web服务器.light
#
# 环境变量:
#   HARNESS_WEB_MOCK   "1" 强制 mock（测试/演示，不消耗真实 token）；缺省（或 "0"）自动检测：
#                      能从环境变量 / .env 读出大模型密钥 → 真实客户端；
#                      读不出 → mock 占位启动（服务不退出），前端自动弹出配置页引导填写，
#                      保存后热更新为真实客户端，无需重启。
#   HARNESS_WEB_REPLY  mock 客户端固定回复文本（可含多轮回复，逗号分隔入参与回应清单）
#   HARNESS_PORT       广告端口（默认打印内核分配端口；HTTP服务端 固定内核分配，故本值只作对外声明）
#   HARNESS_PORT_FILE  把内核分配端口写入该文件（测试自动化读取用）
#   HARNESS_ROOT       会话持久化根目录（默认 sessions）
#   HARNESS_MODEL / HARNESS_ENDPOINT / DEEPSEEK_API_KEY / HARNESS_API_KEY / OPENAI_API_KEY
#                     真实客户端配置（解析口径同 总入口；密钥绝不打印）
#   HARNESS_WEB_UI_DIR   静态页面根目录（webui）；非空直接使用，缺省则按脚本路径推导
#   HARNESS_WEB_TOKEN    认证令牌（W2，缺省自动生成；登录 URL 携带 ?token=<令牌>）
#   HARNESS_WEB_NO_OPEN  "1" 时不自动打开浏览器（CI/门禁必须设置）
#   HARNESS_WEB_CORS     预留环境变量（默认不启用）
#
# 服务仅绑定 127.0.0.1（S1 无认证，仅限本机回环）。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 总入口 导入 组装注册表, 读取环境文件值
从 客户端 导入 客户端
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因
从 HTTP服务端 导入 处理循环
从 认证 导入 初始化认证, 取令牌
从 会话存储 导入 会话存储
从 系统接口 导入 获取脚本路径, 取目录名, 是否Windows
从 文件系统 导入 绝对路径, 规范化路径, 路径连接, 目录存在
从 外部命令 导入 执行命令, 命令存在

# ---- mock 客户端：记录请求历史，返回预设回应（对齐 test_联调CLI.light 模拟客户端 模式）----
类 模拟客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 回应表 等于 空
  属性 应答序号 等于 0

  段落 构造(回应清单):
    设 己.模型名 为 "deepseek-chat"
    设 己.回应表 为 回应清单
    设 己.应答序号 为 0

  # 对话响应：返回回应的流块列表；回应耗尽后循环最后一条
  段落 对话响应(消息表, 选项表, 工具表):
    如果 己.应答序号 >= 长(己.回应表):
      设 己.应答序号 为 长(己.回应表) - 1
    设 回应文本 为 己.回应表[己.应答序号]
    设 己.应答序号 为 己.应答序号 + 1
    返回 [造块开始(0, "text"), 造文本增量(0, 回应文本), 造块结束(0, ["type": "text", "text": 回应文本]), 造结束(造停止原因())]

# ---- 真实客户端：端点/模型/密钥解析（口径同 总入口.主，密钥不打印）----
段落 解析端点:
  设 端点 为 环境变量("HARNESS_ENDPOINT", 空)
  如果 端点 == 空 或 端点 == "":
    设 端点 为 读取环境文件值("HARNESS_ENDPOINT")
  如果 端点 == 空 或 端点 == "":
    设 端点 为 读取环境文件值("OPENAI_BASE_URL")
    如果 端点 != 空 且 端点 != "" 且 端点.查找("chat/completions") == -1:
      设 端点 为 端点 + "/chat/completions"
  如果 端点 == 空 或 端点 == "":
    设 端点 为 "https://api.deepseek.com/chat/completions"
  返回 端点

段落 解析模型:
  设 模型 为 环境变量("HARNESS_MODEL", 空)
  如果 模型 == 空 或 模型 == "":
    设 模型 为 读取环境文件值("HARNESS_MODEL")
  如果 模型 == 空 或 模型 == "":
    设 模型 为 读取环境文件值("OPENAI_MODEL")
  如果 模型 == 空 或 模型 == "":
    设 模型 为 "deepseek-chat"
  返回 模型

段落 解析密钥:
  设 密钥 为 环境变量("HARNESS_API_KEY", 空)
  如果 密钥 == 空:
    设 密钥 为 环境变量("DEEPSEEK_API_KEY", 空)
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("DEEPSEEK_API_KEY")
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("HARNESS_API_KEY")
  如果 密钥 == 空 或 密钥 == "":
    设 密钥 为 读取环境文件值("OPENAI_API_KEY")
  返回 密钥

# ---- 界面目录：静态页面根定位（契约 4，禁用 当前目录()）----
段落 解析界面目录:
  设 界面目录 为 环境变量("HARNESS_WEB_UI_DIR", "")
  如果 界面目录 != "":
    返回 界面目录
  尝试:
    设 脚本目录 为 取目录名(绝对路径(获取脚本路径()))
    设 候选A 为 规范化路径(路径连接(脚本目录, "webui"))
    如果 目录存在(候选A):
      返回 候选A
    设 候选B 为 规范化路径(路径连接(脚本目录, "..", "webui"))
    如果 目录存在(候选B):
      返回 候选B
  捕获 异常 错误对象:
    打印 "界面目录定位异常: " + 转字符串(错误对象)
  打印 "未找到 webui 目录，静态页面不启用"
  返回 ""

# ---- 主入口：装配客户端 → 起服务 → 打印端口 → 常驻 ----
# 大模型配置装配（自动检测）：
#   - 显式 HARNESS_WEB_MOCK=1 → 强制 mock（测试/演示，不消耗 token）。
#   - 缺省（或 =0）→ 自动检测：能从环境变量 / .env 读出大模型密钥 → 真实客户端，
#     configured=1（前端不弹配置页）；读不出 → 以 mock 占位启动（服务不退出），
#     configured=0（前端自动弹出配置页引导填写，保存后热更新为真实客户端）。
异步 段落 主环境():
  设 注册表 为 组装注册表()
  设 根 为 环境变量("HARNESS_ROOT", "sessions")
  设 模拟模式 为 环境变量("HARNESS_WEB_MOCK", "0")
  设 强制模拟 为 模拟模式 == "1"
  # 先解析大模型配置（只读；无论最终走真实还是 mock，配置元数据都要如实反映）
  设 端点 为 解析端点()
  设 模型 为 解析模型()
  设 密钥 为 解析密钥()
  设 有密钥 为 密钥 != "" 且 密钥 != 空
  设 是模拟 为 强制模拟
  如果 是模拟 == 假 且 有密钥 == 假:
    # 未检测到大模型配置：占位启动，页面引导配置（不再直接退出）
    打印 "警告: 未检测到大模型配置（.env 缺失或未填写 OPENAI_API_KEY），将以 mock 模式启动，请在页面配置大模型"
    设 是模拟 为 真
  设 客户端对象 为 空
  如果 是模拟:
    设 回复 为 环境变量("HARNESS_WEB_REPLY", "你好，我是 mock 模型的 web 服务回复")
    设 客户端对象 为 新建 模拟客户端([回复])
  否则:
    设 客户端对象 为 新建 客户端(端点, 密钥, 模型)
  # 认证装配（契约 2）：起服务前初始化认证并取令牌
  初始化认证()
  设 令牌 为 取令牌()
  # 静态页面目录（契约 4）：缺失时警告并传 ""，API 仍正常提供
  设 界面目录 为 解析界面目录()
  # 配置元数据（供 GET /api/config 返回；不含密钥明文）
  # configured = 能否读出大模型密钥：有密钥即 1（前端据此决定是否弹配置页）
  设 已配置 为 0
  如果 有密钥:
    设 已配置 为 1
  设 模拟标记 为 0
  如果 是模拟:
    设 模拟标记 为 1
  设 有密钥标记 为 0
  如果 有密钥:
    设 有密钥标记 为 1
  设 配置元数据 为 ["configured": 已配置, "mock": 模拟标记, "model": 模型, "endpoint": 端点, "has_key": 有密钥标记]
  # .env 路径：从脚本路径推导（examples/../.env），POST /api/config 写入此文件
  设 脚本目录 为 获取脚本路径()
  设 项目根 为 规范化路径(路径连接(脚本目录, ".."))
  设 环境文件路径 为 路径连接(项目根, ".env")
  设 服务 为 全局服务
  服务.配置(客户端对象, 注册表, 根, 30.0, 界面目录, 配置元数据, 环境文件路径)
  # E2：会话持久化初始化（JSONL + 索引，存储在 项目根/data/sessions/）
  设 数据根 为 路径连接(项目根, "data")
  设 会话库 为 新建 会话存储(数据根)
  服务.设置会话库(会话库)
  设 实际端口 为 服务.端口()
  设 广告端口 为 环境变量("HARNESS_PORT", "")
  如果 广告端口 == "":
    设 广告端口 为 转字符串(实际端口)
  设 端口文件 为 环境变量("HARNESS_PORT_FILE", "")
  如果 端口文件 != "":
    写入文件(端口文件, 转字符串(实际端口))
  # 登录 URL（契约 6）：启用认证 → 带 ?token=；否则保持原格式
  设 登录地址 为 "http://127.0.0.1:" + 广告端口
  如果 令牌 != "":
    设 登录地址 为 登录地址 + "/?token=" + 令牌
  打印 "web 服务已启动: " + 登录地址
  如果 广告端口 != 转字符串(实际端口):
    打印 "（内核分配实际端口: " + 转字符串(实际端口) + "）"
  # 自动打开浏览器（契约 6）：默认打开；HARNESS_WEB_NO_OPEN=1 关闭；失败仅提示不崩
  设 不自动打开 为 环境变量("HARNESS_WEB_NO_OPEN", "")
  如果 不自动打开 != "1":
    尝试:
      设 打开命令 为 ""
      如果 是否Windows():
        设 打开命令 为 "start \"\" \"" + 登录地址 + "\""
      否则:
        如果 命令存在("xdg-open"):
          设 打开命令 为 "xdg-open \"" + 登录地址 + "\""
        否则:
          如果 命令存在("open"):
            设 打开命令 为 "open \"" + 登录地址 + "\""
      如果 打开命令 != "":
        设 打开结果 为 执行命令(打开命令)
        设 返回码 为 打开结果.返回码
        如果 返回码 != 0:
          打印 "自动打开浏览器失败，请手动访问 " + 登录地址
      否则:
        打印 "未找到可用的浏览器打开命令，请手动访问 " + 登录地址
    捕获 异常 错误对象:
      打印 "自动打开浏览器失败，请手动访问 " + 登录地址
  设 循环任务 为 创建任务(处理循环(服务.服务端))
  # HARNESS_WEB_LIFETIME（秒）>0 时到时正常停机退出（门禁/自动化用）；0 或缺省 = 常驻
  设 寿命 为 整数(环境变量("HARNESS_WEB_LIFETIME", "0"))
  如果 寿命 > 0:
    等待 异步睡眠(寿命)
    服务.停止()
    返回
  当 真:
    等待 异步睡眠(3600)

异步 运行 主环境()。

导出 Web服务端
导出 全局服务
导出 路由处理器
导出 模拟客户端