# test_预设切换.light —— 第104轮 任务线A：会话内切换 agent preset（上游 session.ts 语义）
# 被测：src/预设切换.light
# 运行：cd lightharness && python 运行.py examples/test_预设切换.light
#
# 上游：packages/preset/agent-preset-registry/src/session.ts
#   key="agentPreset" / stateVersion=1 / init=header.agentPreset 否则 空 /
#   apply=命中 'agent-preset/selected' 取 data.agentPreset 否则保持 / wire.view=state 原样
#   语义：blank 期间可改 preset；改动效果**超出 blank 窗口**（首轮及以后都跑新组合）；
#         重建读 agentPreset 投影，绝不只读 header。
#
# 反跑判据（三组，见交付报告；三组均单点破坏-还原验证）：
#   反跑1：可否切换 改成恒返回真（去掉 blank 判定）→ 1b / 1d（已开轮应假）立红；
#   反跑2：预设投影推进 改成「任何事件都取 agentPreset」→ 3b（非命中事件应保持）立红；
#   反跑3：装配挂载集 未知预设由抛错改为返回空表 → 7a（应抛错未抛）立红。
#
# 语言坑规避：诊断一律走 抛出 新建 错误（L-055/L-160：打印只吃字面量串或字符串变量）；
#   列表/字典字面量单行；`设 X 为` 的 为 前留空格（L-151）；模块级计数用字典承载（第34轮）。

从 预设切换 导入 事件类型, 取轮次数, 是否空白会话, 可否切换, 预设投影键, 预设投影初始, 预设投影推进, 预设投影视图, 预设投影版本, 预设投影步进, 重建预设, 造切换事件, 装配挂载集
从 预设挂载过滤 导入 按预设过滤, 挂条目标识
从 会话投影缓存 导入 冷投影续算, 校验检查点兼容
从 总入口 导入 造注册表条目表, 解析预设装配, 组装注册表
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串包含
从 内置核心列表 导入 列表包含, 列表追加, 列表创建
从 内置核心字典 导入 字典设置

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真，实际假")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 应抛错：返回异常消息串（未抛错则判失败）
段落 检查抛错(用例, 标签):
  设 消息 为 "未抛错"
  尝试:
    用例()
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
  如果 消息 == "未抛错":
    抛出 新建 错误("断言失败[" + 标签 + "]：应抛错未抛")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)
  返回 消息

# =====================================================================
# 求值能力与注册表（口径沿用 examples/test_预设挂载过滤.light）
# =====================================================================
段落 恒假求值(表达式):
  返回 假

段落 造极简注册表():
  返回 [
    {"标识": "persona", "名称": "@deepseek-ai/dsh-persona"},
    {"标识": "pty", "名称": "@deepseek-ai/dsh-terminal"},
    {"标识": "terminal-bash", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-bash", "名称": "@deepseek-ai/dsh-tool-bash-persistent"},
    {"标识": "terminal-pwsh", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-pwsh", "名称": "@deepseek-ai/dsh-tool-pwsh-persistent"}]

段落 造带外条目注册表():
  返回 [
    {"标识": "persona", "名称": "@deepseek-ai/dsh-persona"},
    {"标识": "pty", "名称": "@deepseek-ai/dsh-terminal"},
    {"标识": "terminal-bash", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-bash", "名称": "@deepseek-ai/dsh-tool-bash-persistent"},
    {"标识": "terminal-pwsh", "名称": "@deepseek-ai/dsh-terminal-bash"},
    {"标识": "persistent-pwsh", "名称": "@deepseek-ai/dsh-tool-pwsh-persistent"},
    {"标识": "tool-web", "名称": "@deepseek-ai/dsh-tool-web"}]

段落 取标识表(条目表):
  设 表 为 列表创建()
  遍历 条目 之 条目表:
    列表追加(表, 挂条目标识(条目))
  返回 表

# =====================================================================
# 会话投影缓存黏合：读事件(起序号, 止序号) —— 闭区间；止序号 -1 表示到末尾
# =====================================================================
设 事件表 为 列表创建()

段落 读事件(起序号, 止序号):
  设 结果 为 列表创建()
  遍历 事件项 之 事件表:
    设 序号 为 事件项["序号"]
    如果 序号 < 起序号:
      跳过
    如果 止序号 >= 0 且 序号 > 止序号:
      跳过
    列表追加(结果, 事件项)
  返回 结果

# =====================================================================
# 主程
# =====================================================================
段落 主程():
  打印 "===== 第 104 轮任务线 A：会话内切换 agent preset ====="

  # ---- §1 blank 判定：仅未开轮可切换 ----
  断言相等(可否切换({"轮次数": 0}), 真, "1a blank（轮次数 0）可切换")
  断言相等(可否切换({"轮次数": 1}), 假, "1b 已开轮（轮次数 1）不可切换")
  断言相等(可否切换({"事件表": 列表创建()}), 真, "1c 空事件表 = 未开轮")
  断言相等(可否切换({"事件表": [{"类型": "turn/start"}]}), 假, "1d 事件表含 turn/start = 已开轮")
  断言相等(可否切换({}), 真, "1e 无任何轮次信息 = 未开轮")
  断言相等(可否切换(空), 假, "1f 非字典严口径 = 不可切换")
  断言相等(取轮次数({"轮次数": 3}), 3, "1g 取轮次数 显式值")
  断言相等(取轮次数({"事件表": [{"类型": "turn/start"}, {"type": "turn/start"}, {"类型": "step/start"}]}), 2, "1h 取轮次数 按 turn/start 计数")
  断言相等(事件类型({"type": "turn/start"}), "turn/start", "1i 事件类型 回退 type 键")
  断言相等(是否空白会话({"轮次数": 2}), 假, "1j 是否空白会话 已开轮")

  # ---- §2 投影初始：头有值取值，否则 空 ----
  断言相等(预设投影键(), "agentPreset", "2a 投影键")
  断言相等(预设投影初始({"agentPreset": "ptc"}), "ptc", "2b 头有 agentPreset 取之")
  断言相等(预设投影初始({}), 空, "2c 头无 agentPreset → 空")
  断言相等(预设投影初始(空), 空, "2d 非字典头 → 空")
  断言相等(预设投影初始({"agentPreset": 空}), 空, "2e 头值为 空 → 空")
  断言相等(预设投影初始({"会话ID": "s1", "agentPreset": "cordis"}), "cordis", "2f 头含其它键不影响")

  # ---- §3 投影推进：命中取新值，非命中保持 ----
  断言相等(预设投影推进("standard", 造切换事件("minimal")), "minimal", "3a 命中切换事件取新值")
  断言相等(预设投影推进("standard", {"type": "turn/start", "data": {"agentPreset": "zzz"}}), "standard", "3b 非命中事件保持原状态")
  断言相等(预设投影推进(空, 造切换事件("cordis")), "cordis", "3c 空状态命中 → 取新值")
  断言相等(预设投影推进("standard", 空), "standard", "3d 非字典事件保持")
  断言相等(预设投影推进("standard", {"type": "step/end"}), "standard", "3e 其它类型事件保持")

  # ---- §4 视图原样 / 版本 1 ----
  断言相等(预设投影视图("ptc"), "ptc", "4a 投影视图 原样返回串")
  断言相等(预设投影视图(空), 空, "4b 投影视图 原样返回空")
  断言相等(预设投影版本(), 1, "4c 投影版本 1")

  # ---- §5 造切换事件 形状 ----
  设 事件 为 造切换事件("minimal")
  断言相等(事件["type"], "agent-preset/selected", "5a 事件 type")
  断言相等(事件["data"]["agentPreset"], "minimal", "5b 事件 data.agentPreset")
  断言相等(事件类型(事件), "agent-preset/selected", "5c 事件类型 读出一致")

  # ---- §6 装配挂载集 与 预设挂载过滤.按预设过滤 结果一致 ----
  设 极简表 为 造极简注册表()
  设 装配 为 装配挂载集(极简表, "minimal", 恒假求值)
  设 过滤 为 按预设过滤(极简表, "minimal", 恒假求值)
  断言相等(长度(装配[0]), 长度(过滤[0]), "6a 挂载条目数一致")
  断言相等(取标识表(装配[0]), 取标识表(过滤[0]), "6b 挂载顺序与标识一致")
  断言相等(长度(装配[1]), 长度(过滤[1]), "6c 跳过条目数一致")
  断言相等(取标识表(装配[0]), ["persona", "pty", "terminal-bash", "persistent-bash", "terminal-pwsh", "persistent-pwsh"], "6d 恒假求值挂载 6")
  设 装配空求值 为 装配挂载集(极简表, "minimal")
  断言相等(取标识表(装配空求值[0]), ["persona", "pty"], "6e 空求值能力仅字面启用者挂载")
  断言相等(装配空求值[1][0]["原因"], "条件禁用", "6f 空求值能力跳过原因 条件禁用")
  设 外表 为 造带外条目注册表()
  设 装配外 为 装配挂载集(外表, "minimal", 恒假求值)
  断言相等(长度(装配外[0]), 6, "6g 组合外条目不挂载")
  断言相等(装配外[1][0]["标识"], "tool-web", "6h 组合外条目进跳过表")
  断言相等(装配外[1][0]["原因"], "组合外", "6i 跳过原因 组合外")

  # ---- §7 未知预设抛错（不是返回空表）----
  段落 用未知():
    装配挂载集(极简表, "zzz")
  段落 用空标识():
    装配挂载集(极简表, 空)
  段落 用非串标识():
    装配挂载集(极简表, 7)
  设 消息1 为 检查抛错(用未知, "7a")
  断言真(字符串包含(消息1, "not found"), "7b 未知预设消息含 not found")
  断言真(字符串包含(消息1, "zzz"), "7c 未知预设消息含标识")
  设 消息2 为 检查抛错(用空标识, "7d")
  断言真(字符串包含(消息2, "not found"), "7e 空预设标识抛错")
  设 消息3 为 检查抛错(用非串标识, "7f")
  断言真(字符串包含(消息3, "not found"), "7g 非串预设标识抛错")

  # ---- §8 重建读投影、绝不只读 header ----
  断言相等(重建预设({"agentPreset": "standard"}, 列表创建()), "standard", "8a 无事件 → 取头")
  断言相等(重建预设({"agentPreset": "standard"}, [造切换事件("minimal")]), "minimal", "8b 有切换事件 → 投影盖过头")
  断言相等(重建预设({}, [造切换事件("ptc")]), "ptc", "8c 头无值、有切换事件 → 取投影")
  断言相等(重建预设({"agentPreset": "standard"}, [{"type": "turn/start"}]), "standard", "8d 无关事件不改投影")
  断言相等(重建预设({"agentPreset": "standard"}, 空), "standard", "8e 非列表事件表 → 取头")

  # ---- §9 与 会话投影缓存.冷投影续算 黏合（复用 R101 #242 的折叠机制）----
  设 切换事 为 造切换事件("minimal")
  字典设置(切换事, "序号", 1)
  设 开轮事 为 {"type": "turn/start", "序号": 2}
  设 建会话事 为 {"type": "session/created", "序号": 0}
  列表追加(事件表, 建会话事)
  列表追加(事件表, 切换事)
  列表追加(事件表, 开轮事)
  设 检查点 为 {"会话ID": "s1", "已处理序号": 0, "投影快照": {"agentPreset": "standard"}, "格式版本": 7}
  断言相等(校验检查点兼容(检查点), 真, "9a 检查点兼容")
  设 新点 为 冷投影续算(检查点, 读事件, 预设投影步进)
  断言相等(新点["投影快照"]["agentPreset"], "minimal", "9b 冷投影续算 折叠出切换后预设")
  断言相等(新点["已处理序号"], 2, "9c 已处理序号推进到末事件")
  设 步进结果 为 预设投影步进({"agentPreset": "standard", "其它": 1}, 造切换事件("cordis"))
  断言相等(步进结果["agentPreset"], "cordis", "9d 投影步进 改 agentPreset")
  断言相等(步进结果["其它"], 1, "9e 投影步进 保留其它投影键")

  # ---- §10 总入口接线（HARNESS_PRESET 分叉的可测面）----
  设 注册表 为 组装注册表()
  设 条目表 为 造注册表条目表(注册表)
  断言相等(长度(条目表), 1, "10a 注册表条目表条目数")
  断言相等(条目表[0]["标识"], "bash", "10b 注册表条目表形状（取 标识 键）")
  设 装配接线 为 解析预设装配("minimal", 注册表)
  断言相等(长度(装配接线[0]), 0, "10c bash 不在 minimal 组合内 → 不挂载")
  断言相等(装配接线[1][0]["标识"], "bash", "10d bash 进跳过表")
  断言相等(装配接线[1][0]["原因"], "组合外", "10e 跳过原因 组合外")
  段落 用未知装配():
    解析预设装配("zzz", 注册表)
  设 消息4 为 检查抛错(用未知装配, "10f")
  断言真(字符串包含(消息4, "standard / ptc / minimal / cordis"), "10g 未知预设消息含可用四键")
  断言真(字符串包含(消息4, "zzz"), "10h 未知预设消息含标识")

  打印 "test_预设切换 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试预设切换 通过 ---"
  返回 真

主程()
