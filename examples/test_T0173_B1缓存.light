# test_T0173_B1缓存.light —— T-0173 B1 项#2：模型列表缓存状态机 + 时序边界校验回归
# 运行：python 运行.py examples/test_T0173_B1缓存.light
#
# 反跑判据（改反任一期望必须红）：
#   §1 时序校验：把 默认超时/年龄、越界抛错 任一期望改反必须红
#   §2 分作用域：把 换凭据重新加载 期望改反必须红
#   §3 单飞/新鲜：把 新鲜不重载 的加载次数改反必须红
#   §4 后台刷新：把 陈旧触发刷新 的加载次数改反必须红
#   §5 失败保留：把 首失败告警次数 / 连败只告警首次 改反必须红
#   §6 失效/释放：把 失效后重载 / 释放后不再加载 改反必须红

从 模型列表缓存 导入 建模型列表缓存, 视图, 失效, 释放, 解析列表时序
从 内置核心列表 导入 列表长度
从 内置核心字典 导入 字典获取

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 信息 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 信息):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 信息)

段落 期望抛错(调用):
  尝试:
    调用()
    返回 假
  捕获 错误 为 e:
    返回 真

段落 主:
  # ============ §1 时序边界校验 ============
  设 默认时序 为 解析列表时序({}, "plug")
  断言相等(默认时序["timeoutMs"], 5000, "§1 默认超时 5000")
  断言相等(默认时序["maxAgeMs"], 600000, "§1 默认年龄 600000")
  设 自定义 为 解析列表时序({"modelsTimeoutMs": 1000, "modelsMaxAgeMs": 0}, "plug")
  断言相等(自定义["timeoutMs"], 1000, "§1 自定义超时")
  断言相等(自定义["maxAgeMs"], 0, "§1 年龄可为 0")
  段落 超时越界():
    返回 解析列表时序({"modelsTimeoutMs": 9999999999}, "plug")
  断言真(期望抛错(超时越界), "§1 超时越界抛错")
  段落 年龄非整数():
    返回 解析列表时序({"modelsMaxAgeMs": 1.5}, "plug")
  断言真(期望抛错(年龄非整数), "§1 年龄非整数抛错")
  段落 超时非正():
    返回 解析列表时序({"modelsTimeoutMs": 0}, "plug")
  断言真(期望抛错(超时非正), "§1 超时非正抛错")

  # ============ §2-§6 缓存状态机 ============
  设 桩 为 {"加载次数": 0, "告警数": 0, "信息数": 0, "失败": 假}
  设 钟 为 {"t": 1000}
  段落 取凭据(地址):
    返回 "secret"
  段落 假加载(地址, 凭据):
    设 桩["加载次数"] 为 桩["加载次数"] + 1
    如果 桩["失败"]:
      抛出 新建 错误("boom")
    返回 {"条目": [{"id": "m1"}], "跳过": 0}
  段落 信息(消息):
    设 桩["信息数"] 为 桩["信息数"] + 1
  段落 告警(消息):
    设 桩["告警数"] 为 桩["告警数"] + 1
  段落 现在():
    返回 钟["t"]

  设 缓存 为 建模型列表缓存()
  设 设置 为 {"url": "https://api.deepseek.com/models", "maxAgeMs": 600000, "timeoutMs": 5000}

  # §2+§3 首次访问：等待加载，1 次加载，已认证
  设 视图1 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 1, "§3 首次加载 1 次")
  断言相等(视图1["authenticated"], 真, "§3 已认证")
  断言相等(列表长度(视图1["listing"]["条目"]), 1, "§3 拿到清单")
  断言相等(桩["信息数"], 1, "§3 成功信息 1 次")
  # 新鲜访问：不重载
  设 视图2 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 1, "§3 新鲜不重载")
  断言相等(桩["告警数"], 0, "§3 无告警")

  # §4 超过最大年龄：后台刷新（+1 加载），返回刷新前清单
  设 钟["t"] 为 钟["t"] + 700000
  设 视图3 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 2, "§4 陈旧触发刷新 +1")
  断言相等(列表长度(视图3["listing"]["条目"]), 1, "§4 刷新后清单仍可用")

  # §5 失败：保留上次清单（上游 keep previous），首次告警；连败只告警首次但仍在刷新
  设 桩["失败"] 为 真
  设 桩["加载次数"] 为 0
  设 桩["告警数"] 为 0
  设 钟["t"] 为 钟["t"] + 700000
  设 视图4 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 1, "§5 失败后重试 1 次")
  断言相等(列表长度(视图4["listing"]["条目"]), 1, "§5 失败保留上次清单")
  断言相等(桩["告警数"], 1, "§5 首失败告警 1 次")
  # 连败：同一次失败连不重复告警，但仍在刷新
  设 钟["t"] 为 钟["t"] + 700000
  设 视图5 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 2, "§5 持续失败继续刷新")
  断言相等(桩["告警数"], 1, "§5 连败只告警首次")

  # 恢复成功：failing 复位，信息恢复
  设 桩["失败"] 为 假
  设 桩["信息数"] 为 0
  设 钟["t"] 为 钟["t"] + 700000
  设 视图6 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(列表长度(视图6["listing"]["条目"]), 1, "§5 恢复拿到清单")
  断言相等(桩["信息数"], 1, "§5 恢复后信息 1 次")

  # §2 切换作用域：丢弃旧清单并重新加载
  设 桩["加载次数"] 为 0
  段落 取凭据2(地址):
    返回 "other"
  设 视图7 为 视图(缓存, 设置, 取凭据2, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 1, "§2 换凭据重新加载")
  断言相等(视图7["authenticated"], 真, "§2 新作用域已认证")

  # §6 失效：保留作用域但丢弃清单，下次等待重载
  失效(缓存)
  设 桩["加载次数"] 为 0
  设 视图8 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(桩["加载次数"], 1, "§6 失效后重载")

  # §6 释放：closed，返回当前视图且不再加载
  释放(缓存)
  设 桩["加载次数"] 为 0
  设 视图9 为 视图(缓存, 设置, 取凭据, 假加载, 现在, 信息, 告警)
  断言相等(视图9["authenticated"], 视图8["authenticated"], "§6 释放后仍返回视图")
  断言相等(桩["加载次数"], 0, "§6 释放后不再加载")

  打印("--- T-0173 B1 项#2 模型列表缓存 测试通过 ---")

主()
