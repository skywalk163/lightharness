# test_协议深化.light —— 对标 #103 域：acp{mcp,model-control,updates} + hook-protocol{detached,events,runner,types} 反跑测试
# 原版：packages/acp/acp/src/{mcp.ts, model-control.ts, updates.ts}
#       packages/hooks/hook-protocol/src/{detached.ts, events.ts, runner.ts, types.ts}
#
# 反跑判据（改反必须红，共 3 项，见 _antirun_t6_协议深化.py）：
#   A) MCP round-trip —— 把 解析MCP配置 的配置构造改坏（如 传输 键改错）即红：
#      判据A:round-trip / http round-trip 用例变红；恢复 → 绿。
#   B) 空批次不丢字段 —— 把 助手更新批次 的空块表分支改坏（提前 返回 空 而非 []，或
#      用量条不再追加）即红：判据B:空批次序列化 / 用量批次往返 用例变红；恢复 → 绿。
#   C) 成功状态码变异 —— 把 运行钩子 成功分支 `设 退出码 为 执行结果["退出码"]`
#      变异为 `设 退出码 为 0`（等价上游 result.exitCode ?? 0 改坏）即红：
#      运行:成功退出码（5→0）/ 运行:信号死亡（空→0）用例变红；恢复 → 绿。
#
# 语言坑规避：
#   - 断言(条件,标签) 降级 no-op（L-037），一律 断言相等 / 检查抛含（错误消息子串核对）。
#   - 写/打印 只吃字面量串（L-055）；诊断全走 抛出 新建 错误。
#   - 字面量一律单行（L-051）；嵌套字面量内不写 \n（L-054）→ 换行用 \u000a 转义。
#   - JSON 文本一律 序列化JSON(...) 构造（L-089）。
#   - 无闭包：函数引用经 槽运算 分发（同 test_网络钩子GitHub 约定）；时钟经 全局 时钟 模拟。
#   - 主程 必须显式在文件末尾调用。

从 协议深化 导入 规范化服务器名, 条目成记录, 绝对路径判定, 校验HTTP网址, 解析MCP配置
从 协议深化 导入 造控制状态, 模型选择值, 当前选择, 快照选择, 钉住轮次, 放开轮次, 组装选项, 设定配置值
从 协议深化 导入 助手更新批次, 调用更新, 结果更新, 解析工具入参
从 协议深化 导入 造分离跟踪器, 登记运行, 结算运行, 在飞数量, 结算全部, 排空运行
从 协议深化 导入 默认标准错误摘要上限, 摘要标准错误, 构造引用事件, 构造结果事件
从 协议深化 导入 默认钩子超时毫秒, 构输入流, 运行钩子
从 协议深化 导入 判方言, 构造指令钩, 判指令钩, 构造匹配组, 判匹配组, 判产出形, 判选择形
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串获取, 截取, 去除空白, 字符串包含, 开头, 结尾, 字符串重复
从 内置核心判型 导入 是字典, 是列表, 是字符串
从 内置核心列表 导入 列表创建, 列表长度, 列表获取, 列表追加
从 内置核心字典 导入 字典创建, 字典键列表, 字典包含键, 字典获取, 取可选
从 JSON 导入 解析JSON, 序列化JSON

# =====================================================================
# 断言框架（同 test_网络钩子GitHub.light 约定；抛错改按子串核对）
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛含(标签, 片段, 运算):
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常 为 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 片段) == 假):
    抛出 新建 错误("错误消息不符[" + 标签 + "]：实际=" + 文 + " 期望含=" + 片段)

# =====================================================================
# 全局装配槽（抛错用例分发）+ 模拟时钟（运行钩子 两拍计时）
# =====================================================================
设 槽 为 {}
设 时钟 为 {"值": 1000}

段落 槽运算:
  全局 槽
  如果 (槽["操作"] == "归一化"):
    规范化服务器名(槽["值"])
    返回 空
  如果 (槽["操作"] == "条目成记录"):
    条目成记录(槽["表"], 槽["字段"], 槽["类别"])
    返回 空
  如果 (槽["操作"] == "HTTP网址"):
    校验HTTP网址(槽["值"], 槽["字段"])
    返回 空
  如果 (槽["操作"] == "MCP配置"):
    解析MCP配置(槽["表"], 槽["目录"])
    返回 空
  如果 (槽["操作"] == "设定配置"):
    设定配置值(槽["状态"], 槽["配置ID"], 槽["值"], 槽["提供商表"], 槽["解析"], 槽["解析可用"], 槽["推理"])
    返回 空
  返回 空

段落 滴答时间:
  全局 时钟
  设 旧 为 时钟["值"]
  设 时钟["值"] 为 旧 + 1
  返回 旧

# =====================================================================
# 一、MCP 域（mcp.ts）
# =====================================================================
段落 用例_MCP:
  全局 槽
  断言相等(规范化服务器名("my-server"), "my-server", "归一:合法名直通")
  断言相等(规范化服务器名("valid_123-A"), "valid_123-A", "归一:划界名直通")
  设 长名 为 字符串重复("a", 40)
  设 折叠 为 规范化服务器名(长名)
  断言相等(字符串长度(折叠), 29, "归一:超长收敛29")
  断言相等(开头(折叠, 字符串重复("a", 20)), 真, "归一:折叠保留前缀")
  断言相等(规范化服务器名(折叠), 折叠, "归一:归一化幂等")
  设 空格名 为 规范化服务器名("GitHub Actions")
  断言相等(字符串包含(空格名, " "), 假, "归一:空白被折叠")
  断言相等(开头(空格名, "GitHub_Actions_"), 真, "归一:折叠加摘要")
  设 槽 为 {"操作": "归一化", "值": ""}
  检查抛含("归一:空名", "invalid server name", 槽运算)
  设 槽 为 {"操作": "归一化", "值": "a\u007fb"}
  检查抛含("归一:控制字符", "invalid server name", 槽运算)
  # 条目成记录
  设 记录 为 条目成记录([{"名": "PATH", "值": "/bin"}], "f", "environment")
  断言相等(记录["PATH"], "/bin", "条目:环境键原名")
  设 槽 为 {"操作": "条目成记录", "表": [{"名": "A", "值": "1"}, {"名": "A", "值": "2"}], "字段": "f", "类别": "environment"}
  检查抛含("条目:环境重复", "duplicate name", 槽运算)
  设 槽 为 {"操作": "条目成记录", "表": [{"名": "A=B", "值": "1"}], "字段": "f", "类别": "environment"}
  检查抛含("条目:环境含等号", "invalid environment entry", 槽运算)
  设 记录 为 条目成记录([{"名": "X-Test", "值": "v"}], "f", "header")
  断言相等(记录["X-Test"], "v", "条目:头键原名")
  设 槽 为 {"操作": "条目成记录", "表": [{"名": "X-A", "值": "1"}, {"名": "x-a", "值": "2"}], "字段": "f", "类别": "header"}
  检查抛含("条目:头大小写重复", "duplicate name", 槽运算)
  设 槽 为 {"操作": "条目成记录", "表": [{"名": "a b", "值": "v"}], "字段": "f", "类别": "header"}
  检查抛含("条目:非法头名", "invalid header entry", 槽运算)
  设 槽 为 {"操作": "条目成记录", "表": [{"名": "x", "值": "a\u000ab"}], "字段": "f", "类别": "header"}
  检查抛含("条目:非法头值", "invalid header entry", 槽运算)
  # 绝对路径判定
  断言相等(绝对路径判定("/usr/bin"), 真, "路径:绝对通过")
  断言相等(绝对路径判定("/"), 真, "路径:根绝对")
  断言相等(绝对路径判定("bin/x"), 假, "路径:相对拒绝")
  断言相等(绝对路径判定("C:\\x"), 真, "路径:反斜杠通过")
  断言相等(绝对路径判定(5), 假, "路径:非串拒绝")
  # HTTP 网址校验
  断言相等(校验HTTP网址("https://ok.com", "u"), 真, "网址:https通过")
  断言相等(校验HTTP网址("http://ok.com", "u"), 真, "网址:http通过")
  设 槽 为 {"操作": "HTTP网址", "值": "ftp://x", "字段": "u"}
  检查抛含("网址:非http", "must be an absolute HTTP(S) URL", 槽运算)
  设 槽 为 {"操作": "HTTP网址", "值": "https:// bad", "字段": "u"}
  检查抛含("网址:含空白", "must be an absolute HTTP(S) URL", 槽运算)
  # 解析MCP配置 判据A
  设 配置表 为 解析MCP配置([{"名": "s1", "指令": "/opt/bin/s", "参数": ["--x"], "环境": [{"名": "K", "值": "V"}]}], "/home/u")
  设 往返 为 解析JSON(序列化JSON(配置表))
  断言相等(往返, 配置表, "判据A:stdio round-trip")
  断言相等(配置表[0]["传输"], "stdio", "MCP:stdio传输")
  断言相等(配置表[0]["服务器名"], "s1", "MCP:服务器名")
  断言相等(配置表[0]["指令"], "/opt/bin/s", "MCP:指令")
  断言相等(配置表[0]["参数"][0], "--x", "MCP:参数")
  断言相等(配置表[0]["环境"]["K"], "V", "MCP:环境")
  断言相等(配置表[0]["目录"], "/home/u", "MCP:目录")
  断言相等(配置表[0]["启动失败即报错"], 真, "MCP:失败即报错")
  设 配置表 为 解析MCP配置([{"名": "api", "类型": "http", "网址": "https://h/x", "头表": [{"名": "Authorization", "值": "Bearer t"}]}], "/w")
  设 往返 为 解析JSON(序列化JSON(配置表))
  断言相等(往返, 配置表, "判据A:http round-trip")
  断言相等(配置表[0]["传输"], "streamable-http", "MCP:http传输")
  断言相等(配置表[0]["头表"]["Authorization"], "Bearer t", "MCP:头键原名")
  设 槽 为 {"操作": "MCP配置", "表": [{"名": "a b", "指令": "/x"}, {"名": "a b", "指令": "/y"}], "目录": "/w"}
  检查抛含("MCP:归一重复", "duplicate normalized name", 槽运算)
  设 槽 为 {"操作": "MCP配置", "表": [{"名": "x", "指令": "bin/run"}], "目录": "/w"}
  检查抛含("MCP:相对指令", "must be an absolute path", 槽运算)
  设 槽 为 {"操作": "MCP配置", "表": [{"名": "x", "类型": "http"}], "目录": "/w"}
  检查抛含("MCP:缺网址", "must be an absolute HTTP(S) URL", 槽运算)
  设 槽 为 {"操作": "MCP配置", "表": [{"名": "x", "类型": "ws", "网址": "https://h/x"}], "目录": "/w"}
  检查抛含("MCP:不支持运输", "is not supported", 槽运算)

# =====================================================================
# 二、模型控制域（model-control.ts）
# =====================================================================
段落 用例_模型:
  全局 槽
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  断言相等(当前选择(状态)["成员"], "m1", "模型:初始当前选择")
  断言相等(模型选择值("p", "m"), 序列化JSON(["p", "m"]), "模型:选择值格式")
  设 快照 为 快照选择(状态)
  设 快照["成员"] 为 "m9"
  断言相等(状态["已选"]["成员"], "m1", "模型:快照深拷贝")
  钉住轮次(状态, 5)
  设 状态["已选"] 为 {"提供者": "p", "成员": "m2"}
  断言相等(当前选择(状态)["成员"], "m1", "模型:轮次覆盖优先")
  放开轮次(状态, 4)
  断言相等(当前选择(状态)["成员"], "m1", "模型:轮次不匹配不放开")
  放开轮次(状态, 5)
  断言相等(当前选择(状态)["成员"], "m2", "模型:放开回退已选")
  设 提供商表 为 [{"标识": "p", "名": "P服务", "模型表": [{"标识": "m1", "名": "M1"}, {"标识": "m2", "名": "M2"}]}]
  设 空状态 为 造控制状态(空)
  断言相等(组装选项(空状态, 提供商表, 空, 真, 空), [], "模型:空已选返回空表")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m2"})
  设 选项表 为 组装选项(状态, 提供商表, {"提供者": "p", "成员": "m2"}, 真, 空)
  断言相等(选项表[0]["标识"], "model", "模型:选项标识")
  断言相等(选项表[0]["当前值"], 模型选择值("p", "m2"), "模型:选项当前值")
  断言相等(列表长度(选项表[0]["选项表"][0]["选项表"]), 2, "模型:组选项数")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m9"})
  设 选项表 为 组装选项(状态, 提供商表, {"提供者": "p", "成员": "m9"}, 真, 空)
  断言相等(列表长度(选项表[0]["选项表"][0]["选项表"]), 3, "模型:未知值追加")
  断言相等(选项表[0]["选项表"][0]["选项表"][0]["值"], 模型选择值("p", "m9"), "模型:未知值组首")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 选项表 为 组装选项(状态, 提供商表, 空, 假, 空)
  断言相等(选项表[0]["当前值"], 模型选择值("p", "m1"), "模型:解析降级用已选")
  设 推理信息 为 {"推理": {"默认档位": 空, "档位表": [{"标识": "low", "名": "低"}, {"标识": "high", "名": "高"}]}}
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1", "推理档位": "low"})
  设 选项表 为 组装选项(状态, 提供商表, {"提供者": "p", "成员": "m1", "推理档位": "low"}, 真, 推理信息)
  断言相等(列表长度(选项表), 2, "模型:推理选项追加")
  断言相等(选项表[1]["标识"], "reasoning_effort", "模型:推理标识")
  断言相等(选项表[1]["当前值"], "low", "模型:推理当前值")
  断言相等(选项表[1]["选项表"][0]["选项表"][0]["值"], "", "模型:提供者默认档")
  断言相等(列表长度(选项表[1]["选项表"][0]["选项表"]), 3, "模型:档位数含默认")
  # 设定配置值
  设 提供商表 为 [{"标识": "p", "名": "P", "模型表": [{"标识": "m1", "名": "M1"}]}]
  设 空状态 为 造控制状态(空)
  设 槽 为 {"操作": "设定配置", "状态": 空状态, "配置ID": "model", "值": "x", "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 空}
  检查抛含("配置:无已选", "no model selection", 槽运算)
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 槽 为 {"操作": "设定配置", "状态": 状态, "配置ID": "model", "值": 5, "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 空}
  检查抛含("配置:非串值", "requires a select value", 槽运算)
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 槽 为 {"操作": "设定配置", "状态": 状态, "配置ID": "model", "值": "p/no", "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 空}
  检查抛含("配置:未知模型", "unknown model option", 槽运算)
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 选项表 为 设定配置值(状态, "model", 模型选择值("p", "m1"), 提供商表, 空, 真, 空)
  断言相等(状态["已选"]["成员"], "m1", "配置:已选更新")
  断言相等(状态["已解析过"], 真, "配置:已解析标记")
  断言相等(选项表[0]["当前值"], 模型选择值("p", "m1"), "配置:返回选项")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 槽 为 {"操作": "设定配置", "状态": 状态, "配置ID": "reasoning_effort", "值": "low", "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 空}
  检查抛含("配置:无推理信息", "no model info", 槽运算)
  设 推理信息 为 {"推理": {"默认档位": 空, "档位表": [{"标识": "low", "名": "低"}]}}
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 槽 为 {"操作": "设定配置", "状态": 状态, "配置ID": "reasoning_effort", "值": "high", "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 推理信息}
  检查抛含("配置:未知档位", "unknown reasoning effort", 槽运算)
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 选项表 为 设定配置值(状态, "reasoning_effort", "", 提供商表, 空, 真, 推理信息)
  断言相等(取可选(当前选择(状态), "推理档位", 空), 空, "配置:默认档不落键")
  断言相等(选项表[1]["当前值"], "", "配置:推理默认当前值")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 选项表 为 设定配置值(状态, "reasoning_effort", "low", 提供商表, 空, 真, 推理信息)
  断言相等(当前选择(状态)["推理档位"], "low", "配置:推理档落键")
  断言相等(选项表[1]["当前值"], "low", "配置:推理选项当前值")
  设 状态 为 造控制状态({"提供者": "p", "成员": "m1"})
  设 槽 为 {"操作": "设定配置", "状态": 状态, "配置ID": "theme", "值": "x", "提供商表": 提供商表, "解析": 空, "解析可用": 真, "推理": 空}
  检查抛含("配置:未知配置ID", "unknown session config option", 槽运算)

# =====================================================================
# 三、语义更新域（updates.ts）
# =====================================================================
段落 用例_更新:
  # 判据B：空批次不丢字段
  设 批次 为 助手更新批次([], "m1", 空, 空, 空)
  断言相等(批次, [], "判据B:空批次为空表")
  断言相等(序列化JSON(批次), "[]", "判据B:空批次序列化")
  断言相等(解析JSON(序列化JSON(批次)), 批次, "判据B:空批次往返")
  设 批次 为 助手更新批次([], "m1", {"大小": 100}, 42, 空)
  断言相等(列表长度(批次), 1, "判据B:仅用量条")
  断言相等(批次[0]["sessionUpdate"], "usage_update", "判据B:用量类型")
  断言相等(批次[0]["used"], 42, "判据B:用量值")
  断言相等(批次[0]["size"], 100, "判据B:大小值")
  设 往返 为 解析JSON(序列化JSON(批次))
  断言相等(往返, 批次, "判据B:用量批次往返")
  # 消息块分支
  设 批次 为 助手更新批次([{"type": "reasoning", "text": "想想"}], "m1", 空, 空, 空)
  断言相等(批次[0]["sessionUpdate"], "agent_thought_chunk", "更新:思考块")
  断言相等(批次[0]["content"]["text"], "想想", "更新:思考文本")
  设 批次 为 助手更新批次([{"type": "reasoning", "text": ""}], "m1", 空, 空, 空)
  断言相等(批次, [], "更新:空思考跳过")
  设 批次 为 助手更新批次([{"type": "text", "text": "你好"}], "m1", 空, 空, 空)
  断言相等(批次[0]["sessionUpdate"], "agent_message_chunk", "更新:消息块")
  断言相等(批次[0]["content"]["text"], "你好", "更新:消息文本")
  设 附件库 为 {"img1": {"data": "QUJD", "mediaType": "image/png"}}
  设 批次 为 助手更新批次([{"type": "image", "attachment": "img1"}], "m1", 空, 空, 附件库)
  断言相等(批次[0]["content"]["type"], "image", "更新:图像类型")
  断言相等(批次[0]["content"]["mimeType"], "image/png", "更新:图像MIME")
  设 批次 为 助手更新批次([{"type": "tool"}], "m1", 空, 空, {})
  断言相等(批次, [], "更新:未知类型跳过")
  # 调用/结果更新
  设 入参文 为 序列化JSON({"q": 1})
  设 更新 为 调用更新({"id": "c1", "name": "search", "arguments": 入参文})
  断言相等(更新["sessionUpdate"], "tool_call", "更新:调用类型")
  断言相等(更新["toolCallId"], "c1", "更新:调用ID")
  断言相等(更新["title"], "search", "更新:调用名")
  断言相等(更新["status"], "in_progress", "更新:调用状态")
  断言相等(更新["rawInput"]["q"], 1, "更新:调用入参解析")
  设 更新 为 结果更新({"id": "c1", "isError": 假, "content": [{"type": "text", "text": "ok"}]}, {})
  断言相等(更新["sessionUpdate"], "tool_call_update", "更新:结果类型")
  断言相等(更新["status"], "completed", "更新:结果成功")
  断言相等(更新["content"][0]["kind"], "content", "更新:结果内容种类")
  断言相等(更新["content"][0]["content"]["text"], "ok", "更新:结果内容文本")
  设 更新 为 结果更新({"id": "c1", "isError": 真, "content": []}, {})
  断言相等(更新["status"], "failed", "更新:结果失败")
  # 工具入参解析
  设 解析 为 解析工具入参(序列化JSON({"a": 1}))
  断言相等(解析["a"], 1, "更新:入参JSON")
  断言相等(解析工具入参("not json"), "not json", "更新:入参原文")
  断言相等(解析工具入参(空), 空, "更新:入参空")

# =====================================================================
# 四、分离运行域（detached.ts）
# =====================================================================
段落 用例_分离:
  设 跟踪器 为 造分离跟踪器()
  断言相等(在飞数量(跟踪器), 0, "分离:初始零在飞")
  断言相等(排空运行(跟踪器), 真, "分离:空跑排空即达")
  设 跟踪器 为 造分离跟踪器()
  登记运行(跟踪器, "r1")
  登记运行(跟踪器, "r2")
  登记运行(跟踪器, "r1")
  断言相等(在飞数量(跟踪器), 2, "分离:登记去重")
  断言相等(排空运行(跟踪器), 假, "分离:排空未竟")
  断言相等(跟踪器["中止"], 真, "分离:中止信号")
  结算运行(跟踪器, "r1")
  断言相等(在飞数量(跟踪器), 1, "分离:结算后一")
  结算全部(跟踪器)
  断言相等(排空运行(跟踪器), 真, "分离:结算全部后排空")

# =====================================================================
# 五、钩子事件域（events.ts）
# =====================================================================
段落 用例_事件:
  断言相等(默认标准错误摘要上限, 500, "事件:默认上限")
  断言相等(摘要标准错误("", 500), 空, "事件:空摘要")
  断言相等(摘要标准错误("  ok  ", 500), "ok", "事件:修剪摘要")
  设 长串 为 "x" + 字符串重复("y", 50)
  设 摘要 为 摘要标准错误(长串, 5)
  断言相等(字符串长度(摘要), 6, "事件:截断长度")
  断言相等(结尾(摘要, "…"), 真, "事件:省略号")
  设 事件 为 构造引用事件(3, "pre", "codex", "h1", 空)
  断言相等(事件["turn"], 3, "事件:轮次")
  断言相等(事件["point"], "pre", "事件:点位")
  断言相等(事件["dialect"], "codex", "事件:方言")
  断言相等(事件["handlerId"], "h1", "事件:处理器")
  断言相等(字典包含键(事件, "matcher"), 假, "事件:无甄别式键")
  设 事件 为 构造引用事件(3, "pre", "codex", "h1", "*.md")
  断言相等(事件["matcher"], "*.md", "事件:甄别式键")
  设 事件 为 构造结果事件(3, "post", "h1", {"退出码": 0, "标准输出": "", "标准错误": ""}, 500, 12)
  断言相等(事件["decision"], "pass", "事件:缺省通过")
  断言相等(事件["exitCode"], 0, "事件:零退出码不丢")
  设 事件 为 构造结果事件(3, "post", "h1", {"退出码": 2, "标准输出": "", "标准错误": "blocked", "裁定": "block"}, 500, 12)
  断言相等(事件["decision"], "block", "事件:裁定优先")
  断言相等(事件["stderrSummary"], "blocked", "事件:摘要")
  设 事件 为 构造结果事件(3, "post", "h1", {"退出码": 1, "标准输出": "", "标准错误": "", "续行标志": 假}, 500, 12)
  断言相等(事件["decision"], "stop", "事件:不续行停止")

# =====================================================================
# 六、钩子运行器（runner.ts）—— 判据C
# =====================================================================
段落 用例_运行器:
  全局 时钟
  断言相等(默认钩子超时毫秒, 600000, "运行:默认超时")
  设 执行结果 为 {"退出码": 5, "标准输出": "ok", "标准错误": "", "失败消息": 空}
  设 钩 为 构造指令钩("echo hi", 空)
  设 时钟 为 {"值": 1000}
  设 结果 为 运行钩子(钩, {"a": 1}, 真, 默认钩子超时毫秒, "pre", 执行结果, 滴答时间)
  断言相等(结果["产出"]["退出码"], 5, "运行:成功退出码")
  断言相等(结果["产出"]["标准输出"], "ok", "运行:标准输出")
  断言相等(结果["时长毫秒"], 1, "运行:时长双拍")
  断言相等(结果["超时毫秒"], 600000, "运行:默认超时毫秒")
  设 钩 为 构造指令钩("echo hi", 5)
  设 时钟 为 {"值": 2000}
  设 结果 为 运行钩子(钩, {"a": 1}, 真, 默认钩子超时毫秒, "pre", 执行结果, 滴答时间)
  断言相等(结果["超时毫秒"], 5000, "运行:超时秒覆盖")
  断言相等(结果["输入"], 序列化JSON({"a": 1}) + "\u000a", "运行:尾随换行")
  设 结果 为 运行钩子(钩, {"a": 1}, 假, 默认钩子超时毫秒, "pre", 执行结果, 滴答时间)
  断言相等(结果["输入"], 序列化JSON({"a": 1}), "运行:无尾随换行")
  设 信号死亡 为 {"退出码": 空, "标准输出": "", "标准错误": "", "失败消息": 空}
  设 钩 为 构造指令钩("echo hi", 空)
  设 时钟 为 {"值": 3000}
  设 结果 为 运行钩子(钩, {}, 假, 默认钩子超时毫秒, "pre", 信号死亡, 滴答时间)
  断言相等(结果["产出"]["退出码"], 空, "运行:信号死亡空退出码")
  设 失败 为 {"退出码": 空, "标准输出": "", "标准错误": "", "失败消息": "boom"}
  设 时钟 为 {"值": 4000}
  设 结果 为 运行钩子(钩, {}, 假, 默认钩子超时毫秒, "pre", 失败, 滴答时间)
  断言相等(结果["产出"]["标准错误"], "boom", "运行:失败消息入产出")
  断言相等(结果["产出"]["退出码"], 空, "运行:失败无退出码")

# =====================================================================
# 七、钩子协议类型（types.ts）
# =====================================================================
段落 用例_类型:
  断言相等(判方言("claude-code"), 真, "类型:克劳德方言")
  断言相等(判方言("codex"), 真, "类型:科德方言")
  断言相等(判方言("other"), 假, "类型:未知方言")
  设 钩 为 构造指令钩("echo hi", 空)
  断言相等(钩["指令"], "echo hi", "类型:指令钩")
  断言相等(构造指令钩("x", 3)["超时秒"], 3, "类型:指令钩超时")
  断言相等(判指令钩({"指令": "x"}), 真, "类型:判钩合法")
  断言相等(判指令钩({"指令": "x", "超时秒": 0}), 真, "类型:判钩零超时")
  断言相等(判指令钩({}), 假, "类型:判钩缺指令")
  断言相等(判指令钩({"指令": "", "超时秒": -1}), 假, "类型:判钩负超时")
  断言相等(判指令钩("x"), 假, "类型:判钩非字典")
  设 组 为 构造匹配组("*.md", [钩])
  断言相等(组["甄别式"], "*.md", "类型:组甄别式")
  设 组 为 构造匹配组(空, [钩])
  断言相等(字典包含键(组, "甄别式"), 假, "类型:组无甄别式键")
  断言相等(判匹配组({"钩表": [{"指令": "x"}]}), 真, "类型:判组合法")
  断言相等(判匹配组({"钩表": [{"超时秒": 1}]}), 假, "类型:判组坏钩")
  断言相等(判匹配组({"钩表": "x"}), 假, "类型:判组非表")
  断言相等(判产出形({"退出码": 0, "标准输出": "", "标准错误": ""}), 真, "类型:判产出合法")
  断言相等(判产出形({"退出码": "x", "标准输出": "", "标准错误": ""}), 假, "类型:判产出非整退出码")
  断言相等(判产出形({}), 假, "类型:判产出缺失")
  断言相等(判选择形({"提供者": "p", "成员": "m"}), 真, "类型:判选择合法")
  断言相等(判选择形({"提供者": "", "成员": "m"}), 假, "类型:判选择空提供者")
  断言相等(判选择形("x"), 假, "类型:判选择非字典")

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  全局 槽, 时钟
  用例_MCP()
  用例_模型()
  用例_更新()
  用例_分离()
  用例_事件()
  用例_运行器()
  用例_类型()
  打印 "test_协议深化 PASS"

主程()