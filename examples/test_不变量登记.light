# test_不变量登记.light —— 第104轮 任务线B：包自持运行时不变量注册表（上游 invariants 包）
# 上游：packages/runtime-diagnostics/invariants/src/index.ts + tests/service.spec.ts
# 被测：src/不变量登记.light
# 运行：cd lightharness && python 运行.py examples/test_不变量登记.light
#
# 匹配能力口径（光明无正则字面量，宿主能力入参化）：
#   匹配能力(正则源, 包名) —— 包名 传 空 = 「只编译校验」（非法源抛错）；否则返回是否命中。
#   本测试注入 简易匹配：非法源集 = 含 "[" 或 "("（对齐 spec 的 ['['] / ['('] 两条反例）；
#   命中判定 = 正则源为包名的子串（unanchored）、区分大小写（对齐 spec 的
#   'uses unanchored, case-sensitive JavaScript regex sources'）。
#
# 语言坑规避：诊断一律走 抛出 新建 错误；列表/字典字面量单行；`设 X 为` 的 为 前留空格
#   （L-151）；模块级计数用字典承载（闭包不可重绑外层变量 L-098）。

从 不变量登记 导入 造不变量错误, 是不变量错误, 不变量错误码, 不变量错误名, 编译过滤表
从 不变量登记 导入 白名单字段, 黑名单字段, 默认配置, 归范配置, 是否选中, 登记, 是否占用
从 不变量登记 导入 条目空白错误, 条目重复错误, 条目非法错误, 包名坏文案, 校验包名
从 内置核心列表 导入 列表创建, 列表长度, 列表包含, 列表追加
从 内置核心字符串 导入 字符串包含
从 内置核心转换 导入 转字符串

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真，实际假")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 应抛错：返回异常消息串（未抛错则判失败）
段落 检查抛错(用例, 标签):
  设 消息 为 "未抛错"
  尝试:
    用例()
  捕获 异常甲:
    设 消息 为 转字符串(异常甲)
  如果 消息 == "未抛错":
    抛出 新建 错误("断言失败[" + 标签 + "]：应抛错未抛")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)
  返回 消息

# =====================================================================
# 匹配能力（宿主正则能力的入参替身）
# =====================================================================
段落 简易匹配(正则源, 包名):
  如果 字符串包含(正则源, "[") == 真 或 字符串包含(正则源, "(") == 真:
    抛出 新建 错误("bad regex: " + 正则源)
  如果 包名 == 空:
    返回 真
  返回 字符串包含(包名, 正则源)

# =====================================================================
# 固定物料
# =====================================================================
段落 会话包名():
  返回 "@deepseek-ai/dsh-session"

段落 代理包名():
  返回 "@deepseek-ai/dsh-agent"

段落 违规文案():
  返回 "invariant violated by \"@deepseek-ai/dsh-session\": seq must strictly increase"

# =====================================================================
# 主程
# =====================================================================
段落 主程():
  打印 "===== 第 104 轮任务线 B：包自持运行时不变量注册表（invariants）====="

  # ---- §1 错误族三字段与文案逐字（index.ts L50-66 / spec L189-208）----
  设 错 为 造不变量错误(会话包名(), "seq must strictly increase")
  断言相等(错["code"], "INVARIANT", "1a code 恒 INVARIANT")
  断言相等(错["name"], "InvariantError", "1b name 恒 InvariantError")
  断言相等(错["message"], 违规文案(), "1c 文案逐字")
  断言相等(错["packageName"], 会话包名(), "1d 暴露 packageName")
  断言相等(错["包名"], 会话包名(), "1e 中文别名键 包名")
  断言相等(错["消息"], 违规文案(), "1f 中文别名键 消息")
  断言相等(不变量错误码(), "INVARIANT", "1g 错误码常量")
  断言相等(不变量错误名(), "InvariantError", "1h 错误名常量")
  断言相等(是不变量错误(错), 真, "1i 是不变量错误 认本族")
  断言相等(是不变量错误({"code": "INVARIANT"}), 假, "1j 缺 name/packageName → 假")
  断言相等(是不变量错误({"code": "OTHER", "name": "InvariantError", "packageName": "x"}), 假, "1k 非本族 code → 假")
  断言相等(是不变量错误({"code": "INVARIANT", "name": "Error", "packageName": "x"}), 假, "1l 非本族 name → 假")
  断言相等(是不变量错误(7), 假, "1m 非字典 → 假")
  段落 抛不变量():
    抛出 新建 错误(造不变量错误(会话包名(), "seq must strictly increase")["消息"])
  设 抛消息 为 检查抛错(抛不变量, "1n")
  断言相等(抛消息, 违规文案(), "1o 抛出后消息逐字")

  # ---- §2 过滤表编译四条（compilePatterns L75-91 / spec L145-160）----
  段落 白空串():
    编译过滤表(白名单字段(), [""], 简易匹配)
  段落 白纯空格():
    编译过滤表(白名单字段(), [" "], 简易匹配)
  段落 白前空白():
    编译过滤表(白名单字段(), [" session"], 简易匹配)
  段落 黑后空白():
    编译过滤表(黑名单字段(), ["session "], 简易匹配)
  设 消息1 为 检查抛错(白空串, "2a")
  断言相等(消息1, "invariants: package_allowlist entries must be non-blank and have no surrounding whitespace", "2b 空串文案逐字")
  设 消息2 为 检查抛错(白纯空格, "2c")
  断言相等(消息2, 条目空白错误(白名单字段()), "2d 纯空格同一文案")
  设 消息3 为 检查抛错(白前空白, "2e")
  断言相等(消息3, 条目空白错误("package_allowlist"), "2f 前空白同一文案")
  设 消息4 为 检查抛错(黑后空白, "2g")
  断言相等(消息4, "invariants: package_blocklist entries must be non-blank and have no surrounding whitespace", "2h 黑名单后空白文案逐字")
  段落 白重复():
    编译过滤表(白名单字段(), ["session", "session"], 简易匹配)
  段落 黑重复():
    编译过滤表(黑名单字段(), ["agent", "agent"], 简易匹配)
  设 消息5 为 检查抛错(白重复, "2i")
  断言相等(消息5, "invariants: package_allowlist contains duplicate regex \"session\"", "2j 重复文案逐字（JSON 引号）")
  设 消息6 为 检查抛错(黑重复, "2k")
  断言相等(消息6, "invariants: package_blocklist contains duplicate regex \"agent\"", "2l 黑名单重复文案逐字")
  段落 白非法():
    编译过滤表(白名单字段(), ["["], 简易匹配)
  段落 黑非法():
    编译过滤表(黑名单字段(), ["("], 简易匹配)
  设 消息7 为 检查抛错(白非法, "2m")
  断言相等(消息7, "invariants: package_allowlist contains invalid regex \"[\"", "2n 非法正则文案逐字")
  设 消息8 为 检查抛错(黑非法, "2o")
  断言相等(消息8, "invariants: package_blocklist contains invalid regex \"(\"", "2p 黑名单非法正则文案逐字")
  断言相等(条目非法错误("package_allowlist", "x"), "invariants: package_allowlist contains invalid regex \"x\"", "2q 非法文案构件")
  断言相等(条目重复错误("package_blocklist", "y"), "invariants: package_blocklist contains duplicate regex \"y\"", "2r 重复文案构件")
  断言相等(编译过滤表(白名单字段(), ["session", "agent"], 简易匹配), ["session", "agent"], "2s 合法→原序返回源表")
  断言相等(编译过滤表(白名单字段(), [], 简易匹配), [], "2t 空表→空产物")
  段落 白非串():
    编译过滤表(白名单字段(), [7], 简易匹配)
  设 消息9 为 检查抛错(白非串, "2u")
  断言相等(消息9, 条目空白错误(白名单字段()), "2v 非串条目按空白文案拒")

  # ---- §3 是否选中 四路分支（selected L121-126 / spec L56-143）----
  设 全默认 为 默认配置()
  断言相等(全默认["enabled"], 真, "3a 默认 enabled 真")
  断言相等(全默认["package_allowlist"], [], "3b 默认 allowlist 空")
  断言相等(全默认["package_blocklist"], [], "3c 默认 blocklist 空")
  断言相等(归范配置(空)["enabled"], 真, "3d 空配置补默认")
  断言相等(是否选中(空, 会话包名(), 简易匹配), 真, "3e 空配置 admit-all")
  断言相等(是否选中(全默认, 会话包名(), 简易匹配), 真, "3f 默认 admit-all")
  设 停用 为 {"enabled": 假}
  断言相等(是否选中(停用, 会话包名(), 简易匹配), 假, "3g enabled 假 → 假")
  设 白未中 为 {"package_allowlist": ["^@later/invariants$"]}
  断言相等(是否选中(白未中, 会话包名(), 简易匹配), 假, "3h allowlist 未命中 → 假")
  断言相等(是否选中({"package_allowlist": ["Session"]}, 会话包名(), 简易匹配), 假, "3i 大小写敏感 → 假")
  设 黑中 为 {"package_blocklist": ["session"]}
  断言相等(是否选中(黑中, 会话包名(), 简易匹配), 假, "3j blocklist 命中 → 假")
  断言相等(是否选中(黑中, 代理包名(), 简易匹配), 真, "3k blocklist 未命中 → 真")
  设 白中黑中 为 {"package_allowlist": ["dsh-"], "package_blocklist": ["session"]}
  断言相等(是否选中(白中黑中, 会话包名(), 简易匹配), 假, "3l 白命中 + 黑命中 → 假（黑优先）")
  断言相等(是否选中(白中黑中, 代理包名(), 简易匹配), 真, "3m 白命中 + 黑未命中 → 真")
  设 同源双表 为 {"package_allowlist": ["agent"], "package_blocklist": ["agent"]}
  断言相等(是否选中(同源双表, 代理包名(), 简易匹配), 假, "3n 同源双表 → 黑优先")
  段落 选中时非法():
    是否选中({"package_blocklist": ["["]}, 会话包名(), 简易匹配)
  设 消息10 为 检查抛错(选中时非法, "3o")
  断言相等(消息10, "invariants: package_blocklist contains invalid regex \"[\"", "3p 选中路径也做编译校验")

  # ---- §4 登记：占名 / 释放 / 重复（register L136-197 / spec L80-89, L226-244）----
  设 空槽 为 列表创建()
  设 禁用配置 为 {"enabled": 假}
  段落 空名登记():
    登记(空槽, "", 全默认, 简易匹配)
  段落 空格名登记():
    登记(空槽, " ", 全默认, 简易匹配)
  段落 前空白名登记():
    登记(空槽, " pkg", 全默认, 简易匹配)
  段落 内含空格名登记():
    登记(空槽, "pack age", 全默认, 简易匹配)
  段落 换行名登记():
    登记(空槽, "package\n", 全默认, 简易匹配)
  段落 非串名登记():
    登记(空槽, 空, 全默认, 简易匹配)
  设 坏名1 为 检查抛错(空名登记, "4a")
  断言相等(坏名1, "invariants: packageName must be non-blank and contain no whitespace", "4b 空串包名文案逐字")
  断言相等(检查抛错(空格名登记, "4c"), 包名坏文案(), "4d 纯空格包名同一文案")
  断言相等(检查抛错(前空白名登记, "4e"), 包名坏文案(), "4f 前空白包名同一文案")
  断言相等(检查抛错(内含空格名登记, "4g"), 包名坏文案(), "4h 内部空白包名同一文案")
  断言相等(检查抛错(换行名登记, "4i"), 包名坏文案(), "4j 换行包名同一文案")
  断言相等(检查抛错(非串名登记, "4k"), 包名坏文案(), "4l 非串包名同一文案")
  断言相等(校验包名(会话包名()), 真, "4m 合法包名校验通过")
  断言相等(列表长度(空槽), 0, "4n 校验失败不占名")

  设 结果1 为 登记(空槽, 会话包名(), 全默认, 简易匹配)
  设 槽1 为 结果1[0]
  断言相等(列表长度(槽1), 1, "4o 登记后槽表 +1")
  断言相等(是否占用(槽1, 会话包名()), 真, "4p 名字已占")
  断言相等(列表长度(空槽), 0, "4q 入参槽表不被改写")
  设 结果2 为 登记(槽1, 代理包名(), 全默认, 简易匹配)
  设 槽2 为 结果2[0]
  断言相等(列表长度(槽2), 2, "4r 再登记 +1")
  段落 重复登记():
    登记(槽2, 会话包名(), 全默认, 简易匹配)
  设 消息11 为 检查抛错(重复登记, "4s")
  断言相等(消息11, "invariants: package \"@deepseek-ai/dsh-session\" is already registered", "4t 已登记文案逐字")

  设 释放2 为 结果2[1]
  设 槽2后 为 释放2()
  断言相等(列表长度(槽2后), 1, "4u 释放后槽表 −1")
  断言相等(是否占用(槽2后, 代理包名()), 假, "4v 释放后名字不再占用")
  断言相等(是否占用(槽2后, 会话包名()), 真, "4w 释放只摘自己")
  断言相等(槽2, 槽2后, "4x 释放原地改同一句柄")
  设 结果3 为 登记(槽2后, 代理包名(), 全默认, 简易匹配)
  断言相等(列表长度(结果3[0]), 2, "4y 释放后可重复登记同名")
  段落 释放后再释():
    结果3[1]()
  释放后再释()
  断言相等(列表长度(结果3[0]), 1, "4z 再次释放幂等摘同名")

  # ---- §5 被过滤也占名（spec L80-89 registers even when disabled）----
  设 空槽2 为 列表创建()
  设 结果4 为 登记(空槽2, 会话包名(), 禁用配置, 简易匹配)
  设 槽4 为 结果4[0]
  断言相等(列表长度(槽4), 1, "5a 被过滤也占名")
  断言相等(是否选中(禁用配置, 会话包名(), 简易匹配), 假, "5b 该配置确认未选中")
  段落 被过滤重登():
    登记(槽4, 会话包名(), 禁用配置, 简易匹配)
  设 消息12 为 检查抛错(被过滤重登, "5c")
  断言相等(消息12, "invariants: package \"@deepseek-ai/dsh-session\" is already registered", "5d 被过滤者再登记仍报 already registered")
  设 释放4 为 结果4[1]
  释放4()
  断言相等(列表长度(槽4), 0, "5e 被过滤登记的释放同样摘名")
  设 结果5 为 登记(槽4, 会话包名(), 禁用配置, 简易匹配)
  断言相等(列表长度(结果5[0]), 1, "5f 释放后恢复可登记")

  # ---- §6 黑名单过滤下的登记也占名 ----
  设 空槽3 为 列表创建()
  设 结果6 为 登记(空槽3, 会话包名(), 黑中, 简易匹配)
  断言相等(列表长度(结果6[0]), 1, "6a 黑名单过滤者仍占名")
  段落 黑名单重登():
    登记(结果6[0], 会话包名(), 黑中, 简易匹配)
  断言相等(检查抛错(黑名单重登, "6b"), "invariants: package \"@deepseek-ai/dsh-session\" is already registered", "6c 黑名单过滤者重复登记仍报错")

  打印 "test_不变量登记 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试不变量登记 通过 ---"
  返回 真

主程()
