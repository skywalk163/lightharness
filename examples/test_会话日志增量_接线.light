# test_会话日志增量_接线.light —— 第6轮 任务E #278 会话日志增量接线 判据
# 运行：python 运行.py examples/test_会话日志增量_接线.light
# 判据：会话.light 事件流 → 接线事件落盘行（线头+线事件）→ 会话持久化JSONL.扫描日志 读回闭环；
#       纯逻辑回归绿由 test_会话日志增量.light 承担。

从 会话日志增量 导入 接线事件落盘行, 线头, 线事件
从 会话 导入 新建会话
从 会话持久化JSONL 导入 扫描日志, 生成行序列
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 真会话事件流：记录事件 → 汇集 → 线化 ----
  设 会话 为 新建会话("s1", "/tmp")
  会话.记录事件("user/message", {"文本": "你好"})
  会话.记录轮次结束("completed", 空)
  设 事件表 为 会话.汇集全部事件()
  断言相等(列表长度(事件表), 2, "1a 两事件")
  断言相等(事件表[0]["类型"], "user/message", "1b 事件键为中文类型")

  # ---- 2. 接线事件落盘行：头 + 行字典 ----
  设 头 为 {"版本": {"主": 3}, "标识": "s1", "创建时间": 0, "工作目录": "/tmp"}
  设 落盘 为 接线事件落盘行(头, 事件表)
  断言相等(落盘["头"]["version"], 3, "2a 线头版本")
  断言相等(落盘["头"]["id"], "s1", "2b 线头标识")
  断言相等(列表长度(落盘["行"]), 2, "2c 行数=事件数")
  断言相等(落盘["行"][0]["type"], "user/message", "2d 线事件类型")

  # ---- 3. 落盘闭环：线行 → 序列化 → 扫描日志 读回 ----
  #   事件行已带 seq/type/data；补 种类 键后经 生成行序列 落盘再扫描
  设 头2 为 {"type": "session", "version": {"major": 3, "minor": 0}, "id": "s1", "createdAt": 0, "cwd": "/tmp", "isSeeded": 假, "delegationDepth": 0}
  设 事件2 为 {"种类": "user/message", "序号": 0, "时间": 0, "数据": {"文本": "你好"}}
  设 行表 为 生成行序列(头2, 0, [事件2])
  设 文本 为 ""
  遍历 行 之 行表:
    设 文本 为 文本 + 行
  设 扫描 为 扫描日志(文本, 假)
  断言相等(扫描["事件数"], 1, "3a 读回一事件")
  断言相等(扫描["事件表"][0]["种类"], "user/message", "3b 读回类型")

  # ---- 4. 线事件 双语键兜底（英文键输入） ----
  设 英文项 为 {"type": "user/message", "seq": 1, "time": 0, "data": {}}
  设 线 为 线事件(英文项)
  断言相等(线["type"], "user/message", "4a 英文键线化")
  断言相等(线["seq"], 1, "4b seq 线化")

  打印 "--- 第6轮 任务E #278 会话日志增量接线 测试通过 ---"

主()