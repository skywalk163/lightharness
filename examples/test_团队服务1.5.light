# test_团队服务1.5.light —— agent-team 1.5 增量定向用例
# 原版：packages/experimental/agent-team/src/{mailbox.ts, persisted.ts, types.ts, projection.ts}
#   1.5 增量 = durable mailbox（#2672 durable-inbox-recovery）+ send steer（#3333）+ 事件版本 1→2
#
# 本文件只测 1.5 语义增量（其余行为由 test_团队服务.light 覆盖）：
#   1) SendTeamMessageRequest 删除 delivery 调度字段；事件版本 2
#   2) 投递一次 根目标走 能力定向根（root.steer），不再有 wakeup/quiet 分支
#   3) 派发链 dispatchThrough：按 durable 队列顺序把目标所有未送达消息一并派发
#   4) 持久目标判定走 readPersistedSession（{"头","继承数","事件"} + isSeeded 切片）
#   5) 折叠校验：queued 载荷拒绝 delivery 多余键
#
# 语言坑规避同 test_团队服务.light：断言降级 no-op、捕获变量统一 异常对象、
#   无闭包走「场景字典 + 具名零参段落」槽位模式、字面量单行。

从 团队服务 导入 装信箱能力, 门面造, 派发消息, 信箱恢复, 投递内容
从 团队花名册 导入 装能力, 造牌, 抛牌因, 副本, 切片, 造册, 造器, 关闭, 等候, 局面, 已弃置, 令牌, 原因
从 团队折叠 导入 空折叠状态, 套用记录
从 内置核心转换 导入 转字符串
从 内置核心字典 导入 字典删除

# =====================================================================
# 常量
# =====================================================================
设 根标识 为 "team-root"
设 子标识 为 "child-1"

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查消息(标签, 片段, 运算):
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 片段) == 假):
    抛出 新建 错误("消息不符[" + 标签 + "]：实际=" + 文 + " 应含=" + 片段)

# =====================================================================
# 世界：入参能力的共享可变状态（宿主投影）
# =====================================================================
设 世界 为 {}
设 场景 为 {}

段落 清世界:
  设 占 为 装全部能力()
  设 世界["代理表"] 为 {}
  设 世界["局面表"] 为 {}
  设 世界["追加日志"] 为 []
  设 世界["恢复表"] 为 {}
  设 世界["标识序"] 为 0
  设 世界["冲刷日志"] 为 []
  设 世界["定向日志"] 为 []
  设 世界["子体日志"] 为 []
  设 世界["输入日志"] 为 []
  设 世界["末根"] 为 空
  返回 真

# ---- 能力函数（全部读 世界）----
段落 能查代理(标识):
  如果 (字典包含键(世界["代理表"], 标识) == 假): 返回 空
  返回 世界["代理表"][标识]

段落 能列代理:
  设 结果 为 []
  遍历 键 之 字典键列表(世界["代理表"]):
    列表追加(结果, 世界["代理表"][键])
  返回 结果

段落 能取局面(根):
  如果 (字典包含键(世界["局面表"], 根["标识"]) == 假):
    设 表 为 世界["局面表"]
    表[根["标识"]] 为 空折叠状态(根["标识"])
    设 世界["局面表"] 为 表
  设 世界["末根"] 为 根
  返回 世界["局面表"][根["标识"]]

段落 能追加记录(根, 种类, 数据):
  设 记 为 {}
  记["type"] 为 种类
  记["data"] 为 数据
  列表追加(世界["追加日志"], 记)
  设 局 为 能取局面(根)
  设 占位 为 套用记录(局, 记)
  返回 真

段落 能造标识:
  设 世界["标识序"] 为 世界["标识序"] + 1
  返回 "m" + 转字符串(世界["标识序"])

段落 能恢复会话(子标识):
  如果 (字典包含键(世界["恢复表"], 子标识) == 假):
    抛出 新建 错误("no persisted child Session")
  返回 世界["恢复表"][子标识]

段落 能冲刷(会话):
  列表追加(世界["冲刷日志"], 会话["标识"])
  返回 真

段落 能定向根(根, 输入):
  列表追加(世界["定向日志"], 根["标识"])
  列表追加(世界["输入日志"], 输入)
  列表追加(根["后缀"], 输入)
  返回 真

段落 能子体跟投(根, 目标标识, 内容, 源, 牌):
  列表追加(世界["子体日志"], [根["标识"], 目标标识])
  设 目标 为 能查代理(目标标识)
  如果 (目标 != 空):
    设 数 为 {}
    数["content"] 为 内容
    数["source"] 为 源
    设 记 为 {}
    记["type"] 为 "user/message"
    记["data"] 为 数
    列表追加(目标["后缀"], 记)
  返回 真

段落 能看板追加(记录):
  返回 真

段落 能派生成员(参):
  设 回 为 {}
  回["标识"] 为 参["子标识"]
  回["messageId"] 为 "msg-1"
  返回 回

段落 能落盘首轮提示(子标识, 消息号, 牌):
  返回 真

段落 能中断子体(子标识, 调用者):
  返回 真

段落 能排空子体(根, 子清单):
  返回 真

段落 能计时器(时限毫秒):
  返回 假

段落 裁决走世界(器, 队标识, 时限毫秒, 牌):
  返回 "唤醒"

# ---- 构造助手 ----
段落 造代理(标识, 键, 父会话, 态, 型):
  设 代 为 {}
  代["标识"] 为 标识
  代["键"] 为 键
  代["父会话"] 为 父会话
  代["态"] 为 态
  代["模型"] 为 型
  代["后缀"] 为 []
  返回 代

段落 放代理(代理):
  设 表 为 世界["代理表"]
  表[代理["标识"]] 为 代理
  设 世界["代理表"] 为 表
  返回 代理

段落 造成员(标识, 名字, 相位):
  设 成 为 {}
  成["id"] 为 标识
  成["name"] 为 名字
  成["description"] 为 名字 + " responsibility"
  成["provider"] 为 "spawn"
  成["context"] 为 "fresh"
  成["phase"] 为 相位
  返回 成

段落 放成员(根, 成员):
  设 局 为 能取局面(根)
  设 起 为 副本(成员)
  起["phase"] 为 "provisioning"
  设 数 为 {}
  数["version"] 为 2
  数["teamId"] 为 根["标识"]
  数["member"] 为 起
  设 记 为 {}
  记["type"] 为 "team/member"
  记["data"] 为 数
  设 占位 为 套用记录(局, 记)
  设 局二 为 能取局面(根)
  设 当 为 局二["成员表"][成员["id"]]
  如果 (成员["phase"] != "provisioning"):
    设 数二 为 {}
    数二["version"] 为 2
    数二["teamId"] 为 根["标识"]
    数二["member"] 为 成员
    设 记二 为 {}
    记二["type"] 为 "team/member"
    记二["data"] 为 数二
    设 占位 为 套用记录(局二, 记二)
  设 世界["追加日志"] 为 []
  返回 真

段落 放恢复(子标识, 记录列表):
  设 头 为 {}
  头["isSeeded"] 为 假
  头["parentSession"] 为 根标识
  设 载 为 {}
  载["头"] 为 头
  载["继承数"] 为 0
  载["事件"] 为 记录列表
  设 表 为 世界["恢复表"]
  表[子标识] 为 载
  设 世界["恢复表"] 为 表
  返回 载

段落 放恢复带种子(子标识, 记录列表):
  设 头 为 {}
  头["isSeeded"] 为 真
  头["parentSession"] 为 根标识
  设 载 为 {}
  载["头"] 为 头
  载["继承数"] 为 1
  设 预 为 []
  设 种 为 {}
  种["type"] 为 "user/message"
  设 种数 为 {}
  设 种源 为 {}
  种源["kind"] 为 "user"
  种数["source"] 为 种源
  种["data"] 为 种数
  列表追加(预, 种)
  遍历 记 之 记录列表:
    列表追加(预, 记)
  载["事件"] 为 预
  设 表 为 世界["恢复表"]
  表[子标识] 为 载
  设 世界["恢复表"] 为 表
  返回 载

段落 建队(标识):
  设 表 为 世界["局面表"]
  表[标识] 为 空折叠状态(标识)
  设 世界["局面表"] 为 表
  返回 世界["局面表"][标识]

段落 造消息请求(目标, 内容, 牌):
  设 请 为 {}
  请["目标"] 为 目标
  请["内容"] 为 内容
  请["牌"] 为 牌
  返回 请

段落 造团队后缀(消息标识):
  设 记录列表 为 []
  设 数 为 {}
  设 源 为 {}
  源["kind"] 为 "team-message"
  源["teamId"] 为 根标识
  源["messageId"] 为 消息标识
  设 数["source"] 为 源
  设 数["content"] 为 [{"type": "text", "text": "hello"}]
  设 记 为 {}
  记["type"] 为 "user/message"
  记["data"] 为 数
  列表追加(记录列表, 记)
  返回 记录列表

段落 数类型(种类):
  设 计 为 0
  遍历 记 之 世界["追加日志"]:
    如果 (记["type"] == 种类): 设 计 为 计 + 1
  返回 计

段落 造牌:
  设 牌 为 {}
  牌["已中止"] 为 假
  返回 牌

段落 装全部能力:
  设 占 为 装信箱能力(能查代理, 能列代理, 能追加记录, 能造标识, 能恢复会话, 能冲刷, 能定向根, 能子体跟投, 能看板追加)
  设 占 为 装能力(能查代理, 能列代理, 能取局面, 能追加记录, 能造标识, 能派生成员, 能落盘首轮提示, 能恢复会话, 能中断子体, 能排空子体, 能计时器, 裁决走世界)
  返回 真

段落 跑套用:
  设 占 为 套用记录(场景["局"], 场景["记"])
  返回 真

# =====================================================================
# 1.5 定向用例
# =====================================================================
段落 用例_发送无投递字段:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 请 为 造消息请求("worker", [{"type": "text", "text": "hi"}], 造牌())
  设 果 为 派发消息(根, 请)
  断言相等(果["状态"], "accepted", "无投递字段的请求即送")
  设 排 为 世界["追加日志"][0]["data"]
  断言相等(排["version"], 2, "排队事件版本为 2")
  断言相等(字典包含键(排["message"], "delivery"), 假, "排队载荷不再含 delivery")
  返回 真

段落 用例_根走定向:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 请 为 造消息请求("lead", [{"type": "text", "text": "steer me"}], 造牌())
  设 果 为 派发消息(子, 请)
  断言相等(果["状态"], "accepted", "队长定向即送")
  断言相等(列表长度(世界["定向日志"]), 1, "队长走定向（steer）")
  断言相等(世界["定向日志"][0], 根标识, "定向目标是队长")
  断言相等(数类型("team/message/delivered"), 1, "定向也记送达")
  返回 真

段落 用例_子体走跟投:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 请 为 造消息请求("worker", [{"type": "text", "text": "hi"}], 造牌())
  设 果 为 派发消息(根, 请)
  断言相等(果["状态"], "accepted", "活体成员即送")
  断言相等(列表长度(世界["子体日志"]), 1, "子体走跟投")
  断言相等(世界["子体日志"][0][1], 子标识, "跟投目标是成员")
  返回 真

段落 用例_投递链顺序:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 果1 为 派发消息(根, 造消息请求("worker", [{"type": "text", "text": "one"}], 造牌()))
  断言相等(果1["状态"], "queued", "冷目标首条保持排队")
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 果2 为 派发消息(根, 造消息请求("worker", [{"type": "text", "text": "two"}], 造牌()))
  断言相等(果2["状态"], "accepted", "活体后第二条即送并带走首条")
  断言相等(列表长度(世界["子体日志"]), 2, "两条按入队序派发")
  断言相等(世界["子体日志"][0][1], 子标识, "首条先派")
  断言相等(数类型("team/message/delivered"), 2, "两条都记送达")
  返回 真

段落 用例_持久已录头形状:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 后缀 为 造团队后缀("team-message-m1")
  设 占 为 放恢复(子标识, 后缀)
  设 请 为 造消息请求("worker", [{"type": "text", "text": "hi"}], 造牌())
  设 果 为 派发消息(根, 请)
  断言相等(果["状态"], "accepted", "冷目标已录即送")
  断言相等(数类型("team/message/delivered"), 1, "已录也记送达")
  返回 真

段落 用例_持久已录带种子:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 后缀 为 造团队后缀("team-message-m1")
  设 占 为 放恢复带种子(子标识, 后缀)
  设 请 为 造消息请求("worker", [{"type": "text", "text": "hi"}], 造牌())
  设 果 为 派发消息(根, 请)
  断言相等(果["状态"], "accepted", "带种子冷目标已录即送")
  断言相等(数类型("team/message/delivered"), 1, "带种子已录也记送达")
  返回 真

段落 用例_折叠拒交付字段:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 数 为 {}
  数["version"] 为 2
  数["teamId"] 为 根标识
  设 排 为 {}
  排["id"] 为 "team-message-m1"
  排["senderId"] 为 根标识
  排["senderName"] 为 "lead"
  排["targetId"] 为 子标识
  排["delivery"] 为 "quiet"
  排["content"] 为 []
  数["message"] 为 排
  设 记 为 {}
  记["type"] 为 "team/message/queued"
  记["data"] 为 数
  设 局 为 能取局面(根)
  场景["局"] 为 局
  场景["记"] 为 记
  检查消息("1.5无delivery字段", "unexpected key", 跑套用)
  返回 真

段落 用例_成员版本2:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 数 为 {}
  数["version"] 为 2
  数["teamId"] 为 根标识
  数["member"] 为 造成员(子标识, "worker", "provisioning")
  设 记 为 {}
  记["type"] 为 "team/member"
  记["data"] 为 数
  设 局 为 能取局面(根)
  设 占 为 套用记录(局, 记)
  断言相等(字典包含键(局["成员表"], 子标识), 真, "版本2成员边被折叠接受")
  返回 真

段落 用例_恢复无安静:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 请 为 造消息请求("worker", [{"type": "text", "text": "hi"}], 造牌())
  设 占 为 派发消息(根, 请)
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 占 为 信箱恢复(根, 造牌())
  断言相等(列表长度(世界["子体日志"]), 1, "恢复时活体目标被派发（无 quiet 跳过）")
  断言相等(数类型("team/message/delivered"), 1, "恢复也记送达")
  返回 真

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  设 占 为 用例_发送无投递字段()
  设 占 为 用例_根走定向()
  设 占 为 用例_子体走跟投()
  设 占 为 用例_投递链顺序()
  设 占 为 用例_持久已录头形状()
