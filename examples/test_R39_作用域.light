# test_R39_作用域.light —— 第 39 轮 任务 1 判据：scope 核心复刻（作用域键 / 父链 / 循环检测 / 上下文 / 载体 / 准入）
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/scope/src/index.ts（204 行）
#   官方 tests/scope.spec.ts 10 用例 → §1..§5 逐条映射
# 运行：cd lightharness && python 运行.py examples/test_R39_作用域.light
# 覆盖：建键/判型/标识比较/绑定父/一次性绑定/循环检测(自环·间接)/重绑句柄/取父/取链/取链向上/
#       上下文(建·扩展·派生·最近标签胜出)/建作用域/注销(幂等·原始)/载体(建·判型·取键·别名)/
#       准入(全局·祖先·旁支·未指键·基础过滤器否决)
# 反跑锚点：§1-02「作用域相等(键甲, 键乙) 期望 假」改 真 → rc=1；§2-03「作用域循环检测(预设, 代理) 期望 真」改 假 → rc=1

从 测试 导入 断言相等, 断言真
从 内置核心字符串 导入 字符串包含
从 作用域 导入 建作用域键, 是作用域键, 作用域键ID, 作用域键标签, 作用域相等
从 作用域 导入 作用域循环检测, 写父作用域, 绑定父作用域, 重绑父作用域, 取父作用域, 取作用域链, 取作用域链向上
从 作用域 导入 建上下文, 扩展作用域上下文, 派生上下文, 取上下文作用域
从 作用域 导入 建作用域, 取作用域键, 取作用域上下文, 登记作用域注销, 原始注销作用域, 注销作用域, 作用域已注销
从 作用域 导入 建作用域目标, 是作用域载体, 取载体作用域, 取目标作用域, 作用域准入

# ---- 断言助手：抛错必须「真抛」且「抛对消息」 ----
段落 断言抛错 接收 已捕获, 消息, 关键词, 编号:
  断言相等(已捕获, 真, "应抛错未抛 #" + 编号)
  断言真(字符串包含(消息, 关键词), "错误消息不含「" + 关键词 + "」 #" + 编号 + " 实际=" + 消息)
  返回 真

# ---- 基础过滤器桩（模拟 base 上已有的 Cordis filter）----
段落 否决器 接收 上下文:
  返回 假

段落 放行器 接收 上下文:
  返回 真

段落 注销计数动作:
  返回 真

段落 主:
  设 计数 为 0

  # ===== #00 判据自检：断言助手必须真能报错（防止空判 PASS）=====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检报错 为 真
  断言相等(自检报错, 真, "00 断言助手自检")
  设 自检抛错 为 假
  尝试:
    断言抛错(假, "", "x", "自检")
  捕获 异常 为 e:
    设 自检抛错 为 真
  断言相等(自检抛错, 真, "00b 抛错助手自检")
  打印 "OK #00"

  # ===== §1 作用域键：建 / 判型 / 标识 / 标签 =====
  设 计数 为 计数 + 1
  设 键甲 为 建作用域键("甲")
  设 键乙 为 建作用域键("乙")
  断言相等(是作用域键(键甲), 真, "01 是作用域键")
  断言相等(是作用域键({"a": 1}), 假, "01b 普通字典不是键")
  断言相等(是作用域键(空), 假, "01c 空不是键")
  断言相等(是作用域键("sk1"), 假, "01d 字符串不是键")
  断言真(作用域键ID(键甲) != 作用域键ID(键乙), "01e 每键唯一ID")
  断言相等(作用域键标签(键甲), "甲", "01f 标签")
  断言相等(作用域相等(键甲, 键甲), 真, "01g 同键相等")
  断言相等(作用域相等(键甲, 键乙), 假, "02 异键不等")
  断言相等(作用域相等(键甲, 空), 假, "02b 空不参与相等")
  断言相等(作用域相等(键甲, {"a": 1}), 假, "02c 非键不参与相等")
  断言真(键甲 != 键乙, "02d 键是不透明字典对象")
  打印 "OK #01-02d"

  # ===== §2 父链：绑定 / 一次性 / 循环检测 / 重绑 / 取链 =====
  设 计数 为 计数 + 1
  设 预设 为 建作用域键("preset")
  设 代理 为 建作用域键("agent")
  设 另一预设 为 建作用域键("other")
  设 绑定甲 为 绑定父作用域(代理, 预设)
  断言相等(取父作用域(代理), 预设, "03 取父")
  断言相等(取父作用域(预设), 空, "03b 根无父")
  断言相等(取父作用域(空), 空, "03c 空键无父")
  断言相等(取作用域链(代理), [代理, 预设], "03d 链就近优先")
  断言相等(取作用域链(预设), [预设], "03e 根链单元素")
  断言相等(取作用域链(空), [], "03f 空键空链")
  断言相等(取作用域链向上(代理), [预设, 代理], "03g 链向上由根到叶")
  断言相等(作用域循环检测(预设, 代理), 真, "03h 间接环被检出")
  打印 "OK #03-03h"

  # 一次性绑定：已绑定必须抛错（且只有原句柄能重绑）
  设 计数 为 计数 + 1
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    绑定父作用域(代理, 另一预设)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "ALREADY_BOUND", "04")
  打印 "OK #04"

  # 自环：键的父亲是自己
  设 计数 为 计数 + 1
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    绑定父作用域(预设, 预设)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "SCOPE_CYCLE", "05")
  # 写父作用域 直接调用同样拦环
  设 计数 为 计数 + 1
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    写父作用域(预设, 代理)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "SCOPE_CYCLE", "06")
  # 非作用域键入参拦阻
  设 计数 为 计数 + 1
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    绑定父作用域({"a": 1}, 预设)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "NOT_SCOPE_KEY", "06b")
  打印 "OK #05-06b"

  # 重绑：只能走句柄，且重绑仍做循环检测
  设 计数 为 计数 + 1
  重绑父作用域(绑定甲, 另一预设)
  断言相等(取作用域链(代理), [代理, 另一预设], "07 重绑生效")
  设 子键 为 建作用域键("child")
  设 绑定子 为 绑定父作用域(子键, 代理)
  断言相等(取作用域链(子键), [子键, 代理, 另一预设], "07b 重绑后新链闭合")
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    重绑父作用域(绑定甲, 子键)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "SCOPE_CYCLE", "07c 重绑不得认祖先为父")
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    重绑父作用域({"无": "句柄"}, 预设)
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "INVALID_BINDING", "07d 非法句柄")
  打印 "OK #07-07d"

  # ===== §3 作用域上下文（kScope / ctx.extend / scopeOf）=====
  设 计数 为 计数 + 1
  设 根 为 建上下文()
  断言相等(取上下文作用域(根), 空, "08 根上下文无标签")
  断言相等(取上下文作用域(空), 空, "08b 空上下文无标签")
  设 外层域 为 建作用域(根, 另一预设)
  设 外层上下文 为 取作用域上下文(外层域)
  断言相等(取上下文作用域(外层上下文), 另一预设, "08c 作用域上下文带标签")
  设 派生 为 派生上下文(外层上下文)
  断言相等(取上下文作用域(派生), 另一预设, "08d 派生上下文继承最近标签")
  设 内层域 为 建作用域(外层上下文, 代理)
  设 内层上下文 为 取作用域上下文(内层域)
  断言相等(取上下文作用域(内层上下文), 代理, "08e 内层标签胜出")
  断言相等(取上下文作用域(派生上下文(内层上下文)), 代理, "08f 内层派生仍取内层")
  设 裸扩展 为 扩展作用域上下文(根, 空)
  断言相等(取上下文作用域(裸扩展), 空, "08g 空键扩展不引入标签")
  打印 "OK #08-08g"

  # ===== §4 作用域生命周期（createScope / dispose / rawDispose）=====
  设 计数 为 计数 + 1
  设 已注销盘 为 {"n": 0}
  设 独立域 为 建作用域(根, 建作用域键("lonely"))
  断言相等(取作用域键(独立域), 取作用域键(独立域), "09 取作用域键")
  断言相等(作用域已注销(独立域), 假, "09b 初始未注销")
  登记作用域注销(独立域, 注销计数动作)
  断言相等(注销作用域(独立域), 真, "09c 注销返回真")
  断言相等(作用域已注销(独立域), 真, "09d 已注销")
  断言相等(注销作用域(独立域), 真, "09e 重复注销幂等")
  断言相等(原始注销作用域(独立域), 真, "09f 原始注销幂等空表安全")
  断言相等(登记作用域注销(独立域, 空), 假, "09g 拒绝空撤销器")
  断言相等(登记作用域注销(空, 注销计数动作), 假, "09h 拒绝空域体")
  断言相等(注销作用域(空), 假, "09i 空域体注销返回假")
  断言相等(作用域已注销(空), 真, "09j 空域体视为已注销")
  断言相等(取作用域键(空), 空, "09k 空域体取键为空")
  断言相等(取作用域上下文(空), 空, "09l 空域体取上下文为空")
  设 已捕获 为 假
  设 消息 为 ""
  尝试:
    建作用域(根, {"a": 1})
  捕获 异常 为 e:
    设 已捕获 为 真
    设 消息 为 转字符串(e)
  断言抛错(已捕获, 消息, "NOT_SCOPE_KEY", "09m 建作用域必须收作用域键")
  打印 "OK #09-09m"

  # ===== §5 载体与准入（scopeTarget / isScopeCarrier / carrierKeyOf / filter）=====
  设 计数 为 计数 + 1
  设 载体甲 为 建作用域目标(代理)
  断言相等(是作用域载体(载体甲), 真, "10 是载体")
  断言相等(是作用域载体({"a": 1}), 假, "10b 普通字典不是载体")
  断言相等(是作用域载体(空), 假, "10c 空不是载体")
  断言相等(取载体作用域(载体甲), 代理, "10d 取载体键")
  断言相等(取目标作用域(载体甲), 代理, "10e 取目标作用域别名")
  断言相等(取载体作用域({"a": 1}), 空, "10f 非载体取键为空")
  设 载体空 为 建作用域目标(空)
  断言相等(是作用域载体(载体空), 真, "10g 未指键载体仍是载体")
  断言相等(取载体作用域(载体空), 空, "10h 未指键载体键为空")
  断言真(载体甲 != 载体空, "10i 两载体互为不同对象")
  打印 "OK #10-10i"

  # 准入：全局 / 祖先 / 旁支 / 未指键 / 基础过滤器
  设 计数 为 计数 + 1
  断言相等(作用域准入(载体甲, 根), 真, "11 无标签监听全局准入")
  断言相等(作用域准入(载体甲, 外层上下文), 真, "11b 祖先标签准入")
  断言相等(作用域准入(载体甲, 内层上下文), 真, "11c 自身标签准入")
  设 旁支域 为 建作用域(根, 建作用域键("sibling"))
  断言相等(作用域准入(载体甲, 取作用域上下文(旁支域)), 假, "11d 旁支标签被拒")
  设 孙域 为 建作用域(内层上下文, 子键)
  断言相等(作用域准入(载体甲, 取作用域上下文(孙域)), 假, "11e 子标签被拒（事件不下行）")
  断言相等(作用域准入(载体空, 根), 真, "11f 未指键载体：无标签放行")
  断言相等(作用域准入(载体空, 外层上下文), 假, "11g 未指键载体：有标签拒绝")
  断言相等(作用域准入({"a": 1}, 根), 假, "11h 非载体一律拒绝")
  打印 "OK #11-11h"

  # 基础过滤器：先否决则否决；放行则退回作用域语义（保留 base 接收者语义）
  设 计数 为 计数 + 1
  设 载体否决 为 建作用域目标(代理, 否决器)
  断言相等(作用域准入(载体否决, 根), 假, "12 基础过滤器否决（无标签）")
  断言相等(作用域准入(载体否决, 内层上下文), 假, "12b 基础过滤器否决（有标签）")
  设 载体放行 为 建作用域目标(代理, 放行器)
  断言相等(作用域准入(载体放行, 根), 真, "12c 基础过滤器放行后退回作用域语义")
  断言相等(作用域准入(载体放行, 取作用域上下文(旁支域)), 假, "12d 放行后仍受作用域过滤")
  打印 "OK #12-12d"

  # 载体独立性：同键不同载体互不影响，各自记录键
  设 计数 为 计数 + 1
  设 载体甲二 为 建作用域目标(代理)
  断言真(载体甲 != 载体甲二, "13 同键载体互不相同")
  断言相等(取载体作用域(载体甲二), 代理, "13b 同键载体各自记录")
  断言相等(作用域准入(载体甲二, 内层上下文), 真, "13c 同键载体语义一致")
  打印 "OK #13-13c"

  打印 "作用域 判据通过：" + 转字符串(计数) + " 组"

主()
