# test_会话模型选择.light —— 每个会话单独选模型（对齐 DSH chat 框下的模型选择器）
#
# 覆盖：
#   ① GET /api/models：返回内置目录 + 当前（全局）模型；
#   ② POST /api/sessions/:id/model：把模型记到该会话；
#   ③ GET /api/models?session=id 与 GET /api/sessions/:id 都能读回；
#   ④ 对话请求带 model（且带 session_id）→ 该模型落盘到 <根>/session-models.json；
#   ⑤ 对话请求不带 model → 用该会话已存模型（不覆盖全局）。
#
# 跑法：python 运行.py examples/test_会话模型选择.light
# 机制同 test_web路由：直接调 路由处理器 + 真绑定内核端口；mock 客户端不出网。

从 web服务器 导入 Web服务端, 全局服务, 路由处理器
从 总入口 导入 组装注册表
从 会话存储 导入 会话存储
从 文件系统 导入 创建目录, 目录存在, 路径连接, 读取文件, 删除目录
从 JSON 导入 解析JSON
从 字符串处理 导入 编码
从 内置核心字典 导入 字典获取, 字典包含键, 字典键列表
从 内置核心列表 导入 列表长度
从 内置核心字符串 导入 字符串包含
从 流 导入 造块开始, 造文本增量, 造块结束, 造结束, 造停止原因
从 会话队列 导入 队是否忙
从 线程 导入 线程休眠
从 os 导入 _exit

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

类 模拟客户端:
  属性 模型名 等于 "deepseek-chat"
  属性 回应表 等于 空
  属性 应答序号 等于 0

  段落 构造(回应清单):
    设 己.模型名 为 "deepseek-chat"
    设 己.回应表 为 回应清单
    设 己.应答序号 为 0

  段落 对话响应(消息表, 选项表, 工具表):
    如果 己.应答序号 >= 长(己.回应表):
      设 己.应答序号 为 长(己.回应表) - 1
    设 回应文本 为 己.回应表[己.应答序号]
    设 己.应答序号 为 己.应答序号 + 1
    返回 [造块开始(0, "text"), 造文本增量(0, 回应文本), 造块结束(0, ["type": "text", "text": 回应文本]), 造结束(造停止原因())]

段落 造请求(方法, 路径, 令牌头, 体):
  设 头 为 {}
  如果 令牌头 != "" 且 令牌头 != 空:
    头["X-Auth-Token"] 为 令牌头
  返回 ["方法": 方法, "路径": 路径, "头": 头, "体": 体]

段落 聊天体(会话标识, 模型):
  设 对象 为 "{\"model\":\"" + 模型 + "\",\"messages\":[{\"role\":\"user\",\"content\":\"hi\"}],\"stream\":true"
  如果 会话标识 != "":
    设 对象 为 对象 + ",\"session_id\":\"" + 会话标识 + "\""
  返回 编码(对象 + "}")

段落 取响应对象(响应):
  返回 解析JSON(响应["体"])

# T-0531：流式请求把会话占用交给后台线程，本轮真正跑完才释放。
#   直调处理器且不消费流时，④ 返回的 200 只代表「后台线程已起」，不代表本轮结束；
#   ⑤ 紧跟发出会撞上占用 → 202。这里补上「上一轮何时结束」的判据前提：
#   按 10ms 轮询会话队列的 队是否忙（不自造标志、不固定 sleep），有上限且超时即失败。
段落 等本轮结束(会话标识, 上限秒):
  设 闸门 为 全局服务.取队列闸门()
  设 期限 为 时间戳() + 上限秒
  当 队是否忙(闸门, 会话标识) == 真:
    如果 时间戳() >= 期限:
      抛出 新建 错误("断言失败[上一轮结束等待超时]：会话=" + 会话标识 + " 上限秒=" + 转字符串(上限秒))
    线程休眠(0.01)

# 在模型目录里找 id；找不到 → 空
段落 找模型(目录, 标识):
  设 命中 为 空
  遍历 条目 之 目录:
    如果 字典获取(条目, "id", "") == 标识:
      设 命中 为 条目
  返回 命中

异步 段落 主测试:
  设 基 为 当前目录()
  设 根 为 路径连接(基, "_sm_sess")
  设 界面库 为 路径连接(基, "_sm_webui")
  设 数据根 为 路径连接(基, "_sm_data")
  如果 目录存在(根) == 假:
    创建目录(根)
  如果 目录存在(界面库) == 假:
    创建目录(界面库)
  如果 目录存在(数据根) == 假:
    创建目录(数据根)

  设 客户端对象 为 新建 模拟客户端(["模型选择 mock 回复"])
  设 注册表 为 组装注册表()
  设 元数据 为 ["configured": 1, "mock": 1, "model": "deepseek-flash", "endpoint": "http://127.0.0.1:9/v1/chat/completions", "has_key": 0]
  全局服务.配置(客户端对象, 注册表, 根, 30.0, 界面库, 元数据, 路径连接(基, "_sm.env"))
  全局服务.设置会话库(新建 会话存储(数据根))
  断言真(全局服务.端口() > 0, "内核端口已分配")

  # ① GET /api/models（无会话）→ 当前 = 全局模型；目录含内置模型
  设 响应 为 等待 路由处理器(造请求("GET", "/api/models", "", b''))
  断言相等(响应["状态"], 200, "模型目录_200")
  设 目录页 为 取响应对象(响应)
  断言相等(字典获取(目录页, "当前", ""), "deepseek-flash", "模型目录_当前全局")
  断言相等(字典获取(目录页, "全局", ""), "deepseek-flash", "模型目录_全局字段")
  断言相等(字典获取(目录页, "会话", ""), "", "模型目录_无会话时会话字段为空")
  设 目录 为 字典获取(目录页, "模型", [])
  断言真(列表长度(目录) > 0, "模型目录_非空")
  断言真(找模型(目录, "deepseek-flash") != 空, "模型目录_含内置 deepseek-flash")
  设 首条 为 目录[0]
  断言相等(字典获取(首条, "来源", ""), "内置", "模型目录_内置来源")

  # ② 新建会话 → ③ 给它设一个模型
  设 响应 为 等待 路由处理器(造请求("POST", "/api/sessions", "", 编码("{}")))
  断言相等(响应["状态"], 200, "新建会话_200")
  设 会话 为 取响应对象(响应)
  设 会话标识 为 字典获取(会话, "id", "")
  断言真(会话标识 != "", "新建会话_id 非空")
  设 设体 为 编码("{\"模型\":\"codearts/GLM-5.2\"}")
  设 响应 为 等待 路由处理器(造请求("POST", "/api/sessions/" + 会话标识 + "/model", "", 设体))
  断言相等(响应["状态"], 200, "设会话模型_200")
  断言相等(字典获取(取响应对象(响应), "模型", ""), "codearts/GLM-5.2", "设会话模型_回显")

  # ③ 读回：/api/models?session=id 与 /api/sessions/:id
  设 响应 为 等待 路由处理器(造请求("GET", "/api/models?session=" + 会话标识, "", b''))
  断言相等(响应["状态"], 200, "模型目录_带会话_200")
  设 带会话页 为 取响应对象(响应)
  断言相等(字典获取(带会话页, "当前", ""), "codearts/GLM-5.2", "模型目录_带会话_当前")
  断言相等(字典获取(带会话页, "会话", ""), "codearts/GLM-5.2", "模型目录_带会话_会话字段")
  断言相等(字典获取(带会话页, "全局", ""), "deepseek-flash", "模型目录_带会话_全局字段")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/sessions/" + 会话标识, "", b''))
  断言相等(响应["状态"], 200, "会话详情_200")
  断言相等(字典获取(取响应对象(响应), "模型", ""), "codearts/GLM-5.2", "会话详情_模型")

  # ④ 对话请求带 model + session_id → 落盘
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "", 聊天体(会话标识, "buddy/hy3")))
  断言相等(响应["状态"], 200, "对话_带模型_200")
  设 模型文件 为 路径连接(根, "session-models.json")
  断言真(目录存在(根), "会话根存在")
  设 落盘 为 解析JSON(读取文件(模型文件))
  断言相等(字典获取(落盘, 会话标识, ""), "buddy/hy3", "对话_模型已落盘")

  # ⑤ 对话请求不带 model → 用该会话已存模型（buddy/hy3），且全局配置不被改写
  等本轮结束(会话标识, 5)
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "", 聊天体(会话标识, "")))
  断言相等(响应["状态"], 200, "对话_不带模型_200")
  设 落盘2 为 解析JSON(读取文件(模型文件))
  断言相等(字典获取(落盘2, 会话标识, ""), "buddy/hy3", "对话_不带模型_保持会话模型")
  设 配置 为 全局服务.配置元数据
  断言相等(字典获取(配置, "model", ""), "deepseek-flash", "全局模型未被改写")

  # 空模型 = 跟随全局（存空串）
  设 响应 为 等待 路由处理器(造请求("POST", "/api/sessions/" + 会话标识 + "/model", "", 编码("{\"模型\":\"\"}")))
  断言相等(响应["状态"], 200, "清空会话模型_200")
  设 响应 为 等待 路由处理器(造请求("GET", "/api/models?session=" + 会话标识, "", b''))
  断言相等(字典获取(取响应对象(响应), "当前", ""), "deepseek-flash", "清空后跟随全局")
  断言相等(字典获取(取响应对象(响应), "会话", "<无>"), "", "清空后会话字段为空")

  # ⑥ 首轮新对话（不带 session_id）：模型要记到服务端生成的会话 id 上，
  #    否则客户端收到绑定帧后再问 /api/models 会退回全局默认。
  设 响应 为 等待 路由处理器(造请求("POST", "/v1/chat/completions", "", 聊天体("", "aggregate/auto")))
  断言相等(响应["状态"], 200, "首轮_带模型_200")
  设 落盘3 为 解析JSON(读取文件(模型文件))
  设 命中 为 假
  遍历 键 之 字典键列表(落盘3):
    如果 键.查找("web_") == 0 且 字典获取(落盘3, 键, "") == "aggregate/auto":
      设 命中 为 真
  断言真(命中, "首轮新对话_模型已按服务端会话 id 落盘")

  全局服务.停止()
  尝试:
    删除目录(根)
    删除目录(界面库)
    删除目录(数据根)
  捕获 异常 清理错误:
    设 忽略 为 空
  打印 "会话模型选择自测 PASS"
  # T-0526 的兜底唤醒线程退出修复属另一张卡；本用例全部断言已打完，
  # 主动收口子进程，避免与本卡无关的非守护线程把解释器钉在退出阶段。
  _exit(0)

异步 运行 主测试()。