# test_R37_集成测试.light —— 第37轮 任务3：代理循环统一后集成测试
# 运行：python 运行.py examples/test_R37_集成测试.light
#
# 覆盖：
#   §1 统一后导入路径正确性：代理运行时（stdlib 应用层，已重命名）与
#      代理循环（src 核心层，纯状态机）在同一程序内可同时导入，无同名冲突。
#   §2 src 代理循环 核心状态机端到端（建循环→开始轮次→开始/结束步骤→结束轮次→投影）。
#   §3 事件类型斜杠格式（统一后仍对齐上游）。
#   §4 中止路径（开始轮次/步骤→中止循环→信号置位+轮次/步骤转aborted）。
#   §5 agent-default-model（任务2）集成覆盖：建配置/取选择/更新/校验/投影/端到端联动。
#
# 说明（第37轮任务1）：原 stdlib/代理循环.light 与 src/代理循环.light 同名不同层次，
# 统一方案（方案B）把 stdlib 版重命名为「代理运行时」，src 版保持「代理循环」。

从 代理运行时 导入 会话
从 代理循环 导入 轮次待启, 轮次进行, 轮次完成, 步骤待启, 步骤进行, 步骤完成, 建循环, 开始轮次, 结束轮次, 开始步骤, 结束步骤, 是否超限, 轮次是否终态, 步骤是否终态, 投影循环, 校验循环投影, 发事件, 默认最大轮次, 建中止信号, 是否中止, 请求中止, 中止循环, 取检查点
从 代理默认模型 导入 建默认模型配置, 取当前选择, 更新默认模型, 校验模型配置, 校验设置载荷, 投影选择, 挂载设置源, 卸载设置源, 写用户层, 保存选择

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) +
      " 期望=" + 转字符串(期望))

段落 断言为真(实际, 信息):
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 断言为假(实际, 信息):
  如果 实际 != 假:
    抛出 新建 错误("断言失败（应为假）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 主:
  # ===== §1 统一后导入路径正确性（两模块共存）=====
  打印 "--- 测试1: 统一后导入路径 ---"
  断言相等(默认最大轮次, 3, "src 代理循环.默认最大轮次==3")
  设 会 为 新建 会话()
  会.追加("user", "你好")
  会.追加("assistant", "在")
  断言相等(长(会.列表()), 2, "代理运行时.会话 追加/列表 正常")
  断言相等(会.列表()[0]["role"], "user", "会话首条 role=user")
  打印 "  PASS: 代理运行时（重命名后）与 代理循环（src）共存导入，无同名冲突"

  # ===== §2 src 代理循环 核心状态机端到端 =====
  打印 "--- 测试2: src 代理循环 端到端 ---"
  设 驱动 为 建循环(3)
  断言为假(是否超限(驱动), "初始未超限")
  设 轮 为 开始轮次(驱动)
  断言相等(轮["状态"], 轮次进行, "开始轮次→running")
  设 步 为 开始步骤(驱动, "llm")
  断言相等(步["状态"], 步骤进行, "开始步骤→running")
  结束步骤(驱动, 步骤完成)
  断言为真(步骤是否终态(步), "步骤转 completed 后为终态")
  结束轮次(驱动)
  断言相等(轮["状态"], 轮次完成, "结束轮次→completed")
  断言为真(轮次是否终态(轮), "轮次终态")
  设 态 为 投影循环(驱动["事件表"])
  断言相等(态["轮次数"], 1, "投影轮次数==1")
  断言相等(态["步骤数"], 1, "投影步骤数==1")
  断言为真(校验循环投影(态), "投影校验通过")
  打印 "  PASS: 建循环→开始轮次→步骤→结束轮次→投影 端到端"

  # ===== §3 事件斜杠格式 + 检查点 =====
  打印 "--- 测试3: 事件格式与检查点 ---"
  设 旗 为 {"斜杠": 假, "检查点": 假}
  遍历 e 之 驱动["事件表"]:
    如果 e["类型"] == "turn/start":
      字典设置(旗, "斜杠", 真)
    如果 e["类型"] == "checkpoint":
      字典设置(旗, "检查点", 真)
  断言为真(旗["斜杠"], "事件类型含 turn/start 斜杠格式")
  断言为真(旗["检查点"], "记录检查点事件 checkpoint")
  断言为真(取检查点(驱动, 1) != 空, "取检查点(1) 非空")
  打印 "  PASS: 斜杠事件格式 + 检查点"

  # ===== §4 中止与恢复路径 =====
  打印 "--- 测试4: 中止路径 ---"
  设 驱动2 为 建循环(3)
  开始轮次(驱动2)
  开始步骤(驱动2, "tool")
  中止循环(驱动2, "user_abort")
  断言为真(是否中止(驱动2["信号"]), "中止信号置位")
  断言为真(步骤是否终态(驱动2["当前步骤"]), "当前步骤转中止（终态）")
  打印 "  PASS: 中止路径（轮次/步骤转 aborted）"

  # ===== §5 agent-default-model（任务2）集成覆盖 =====
  打印 "--- 测试5: agent-default-model 集成覆盖 ---"

  # 5.1 建默认模型配置 + 取当前选择
  设 默认模型 为 建默认模型配置("openai", "gpt-4o")
  设 选择 为 取当前选择(默认模型)
  断言相等(选择["提供者"], "openai", "5.1 提供者")
  断言相等(选择["模型"], "gpt-4o", "5.1 模型")
  断言为真(字典包含键(选择, "推理力度") == 假, "5.1 缺省推理力度省略键（对齐上游selection()）")
  打印 "  PASS: 建默认模型配置 + 取当前选择（缺省推理力度）"

  # 5.2 建配置带推理力度
  设 默认模型2 为 建默认模型配置("deepseek", "deepseek-chat", "high")
  设 选择2 为 取当前选择(默认模型2)
  断言相等(选择2["推理力度"], "high", "5.2 推理力度=high")
  打印 "  PASS: 建配置带推理力度"

  # 5.3 更新默认模型
  更新默认模型(默认模型, "anthropic", "claude-3-5-sonnet")
  设 选择3 为 取当前选择(默认模型)
  断言相等(选择3["提供者"], "anthropic", "5.3 更新后提供者")
  断言相等(选择3["模型"], "claude-3-5-sonnet", "5.3 更新后模型")
  打印 "  PASS: 更新默认模型"

  # 5.4 校验模型配置 + 校验设置载荷
  断言为真(校验模型配置(默认模型) == 真, "5.4 完整配置对象合法")
  断言为真(校验设置载荷({"提供者": "x", "模型": "y"}) == 真, "5.4 设置载荷合法")
  断言为真(校验设置载荷({"提供者": "", "模型": "y"}) == 真, "5.4 空字符串也是字符串（required只校验键存在+类型）")
  断言为真(校验设置载荷({"模型": "y"}) == 假, "5.4 缺提供者键非法")
  断言为真(校验设置载荷({"提供者": 123, "模型": "y"}) == 假, "5.4 提供者非字符串非法")
  打印 "  PASS: 校验模型配置+校验设置载荷（合法/非法）"

  # 5.5 投影选择：缺省推理力度省略键
  设 投影 为 投影选择({"提供者": "p", "模型": "m"})
  断言为真(字典包含键(投影, "推理力度") == 假, "5.5 缺省力度投影省略键")
  设 投影2 为 投影选择({"提供者": "p", "模型": "m", "推理力度": "ultra"})
  断言相等(投影2["推理力度"], "ultra", "5.5 未知力度原样保留（ReasoningEffortId无验证）")
  打印 "  PASS: 投影选择（缺省省略键/未知力度原样保留）"

  # 5.6 端到端：默认模型 → 代理循环联动（模拟路由选择）
  设 路由模型 为 建默认模型配置("openai", "gpt-4o-mini")
  设 循环 为 建循环()
  开始轮次(循环)
  设 步骤 为 开始步骤(循环, "llm")
  # 模拟：用默认模型配置驱动LLM步骤（此处仅验证配置可传递，不触网）
  设 步骤模型 为 取当前选择(路由模型)
  断言相等(步骤模型["模型"], "gpt-4o-mini", "5.6 步骤使用默认模型")
  结束步骤(循环)
  结束轮次(循环)
  断言为真(轮次是否终态(循环["轮次表"][0]), "5.6 轮次终态")
  打印 "  PASS: 端到端——默认模型配置驱动代理循环步骤（不触网）"

  打印 "  全部 6 组 agent-default-model 集成测试通过"

  打印 "--- R37 集成测试通过 ---"
