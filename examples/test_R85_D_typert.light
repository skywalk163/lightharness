# test_R85_D_typert.light —— R85 任务 D：typert protocol + generator 纯逻辑对拍
从 typert协议 导入 型协构造远程错误, 型协识别远程错误, 型协构造属主值, 型协是属主值, 型协释放属主值, 型协构造调用描述, 型协是调用描述, 型协构造远程结果成功, 型协构造远程结果失败, 型协是远程结果成功, 型协是远程结果失败
从 typert生成器 导入 型生分析包, 型生分析工作区, 型生发射包, 型生子类型节点
从 内置核心判型 导入 是字典

段落 型断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 型断言为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件))

# 属主值释放桩（修改模块级标记）
设 释放标记 为 {"已释放": 假}
段落 段_释放桩:
  释放标记["已释放"] 为 真

段落 主:
  # ① 远程错误：构造 + 结构识别（非远程错误返回 空）
  设 错误一 为 型协构造远程错误("gateway/internal", "boom", ["detail": "x"])
  型断言相等(错误一["code"], "gateway/internal", "远程错误码")
  型断言相等(型协识别远程错误(错误一)["message"], "boom", "远程错误识别往返")
  型断言为真(型协识别远程错误(["foo": "bar"]) == 空, "识别非远程错误为空")

  # ② 属主值：构造 + 识别 + 释放回调被调用
  设 属主值一 为 型协构造属主值("ctx", 段_释放桩)
  型断言为真(型协是属主值(属主值一), "属主值识别")
  型协释放属主值(属主值一)
  型断言为真(释放标记["已释放"] == 真, "属主值释放被调用")

  # ③ 调用描述：构造 + 谓词
  设 调用一 为 型协构造调用描述("svc/do", "svc", "svc", "do", [], ["mode": "src-json"])
  型断言为真(型协是调用描述(调用一), "调用描述谓词")
  型断言为真(型协是调用描述("非字典") == 假, "非字典非调用描述")

  # ④ 远程结果：成功/失败分支
  设 成功一 为 型协构造远程结果成功("v")
  型断言为真(型协是远程结果成功(成功一), "远程结果成功")
  型断言为真(型协是远程结果失败(成功一) == 假, "成功非失败")
  设 失败一 为 型协构造远程结果失败(错误一)
  型断言为真(型协是远程结果失败(失败一), "远程结果失败")

  # ⑤ analyzer：包描述 → 包模型（含 services / invocations 计数）
  设 包描述一 为 ["name": "my-pkg", "root": "/p", "exports": [["name": "A"]], "services": [["key": "Session", "members": ["get", "set"]]], "events": [["name": "turnBoundary"]], "objects": [], "schemas": [], "invocations": [["service": "Session", "method": "get"]]]
  设 包模型一 为 型生分析包(包描述一)
  型断言相等(包模型一["name"], "my-pkg", "包模型名")
  型断言相等(长度(包模型一["services"]), 1, "包模型服务数")
  型断言相等(长度(包模型一["invocations"]), 1, "包模型调用数")
  尝试:
    型生分析包("非字典")
    抛出 新建 错误("应为抛错: 包描述非字典未抛 [NO_THROW]")
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
    如果 字符串包含(消息, "BAD_PACKAGE_DESC") == 假:
      抛出 新建 错误("断言失败: 包描述非字典 期望含 BAD_PACKAGE_DESC 实际=" + 消息)

  # ⑥ analyzer：工作区 → faces
  设 工作区一 为 型生分析工作区([["face": "host", "packages": [包描述一]]])
  型断言相等(长度(工作区一["faces"]), 1, "工作区面数")
  型断言相等(工作区一["faces"][0]["face"], "host", "工作区面名")

  # ⑦ emitter：包模型 → 文本桩（含 service 名）
  设 文本一 为 型生发射包(包模型一)
  型断言为真(字符串长度(文本一) > 0, "发射文本非空")
  型断言为真(字符串包含(文本一, "Session"), "发射文本含服务名")
  设 调用文本 为 型生发射包(调用一)
  型断言为真(字符串包含(调用文本, "svc/do"), "发射调用文本")

  # ⑧ 类型节点边提取
  设 联合节点 为 ["kind": "union", "types": ["t1", "t2"]]
  型断言相等(长度(型生子类型节点(联合节点)), 2, "联合子节点数")
  设 关键字节点 为 ["kind": "keyword", "name": "string"]
  型断言相等(长度(型生子类型节点(关键字节点)), 0, "关键字无子节点")
  设 数组节点 为 ["kind": "array", "element": "e1"]
  型断言相等(型生子类型节点(数组节点)[0], "e1", "数组子节点")

主()
写 "test_R85_D_typert PASS"
