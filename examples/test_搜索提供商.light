# test_搜索提供商.light —— 第14轮 任务4（搜索提供商域）判据
# 上游：packages/web/web-search-{deepseek,exa,perplexity}/src/{provider.ts,types.ts} + web/src/types.ts
# 运行：cd lightharness && LIGHT_MERGE=... python 运行.py examples/test_搜索提供商.light
# 反跑：_antirun_search.py（A 响应归一不再提取 url / B 参数校验 limit 上界放开 / C 401 不再映射 API_KEY_MISSING）
# 注意：写 只接受字面量串或变量（L-045）；诊断走 抛出 新建 错误（表达式上下文）。

从 JSON 导入 序列化JSON
从 搜索提供商 导入 提供商深寻, 提供商艾克萨, 提供商彭普
从 搜索提供商 导入 码缺密钥, 码限流, 码参数非法, 码提供商错误, 码空响应, 码解析失败
从 搜索提供商 导入 取字段, 有字段, 是正整数, 归一参数
从 搜索提供商 导入 统一参数模式, 校验搜索参数, 有搜索参数错误, 时间范围枚举, 安全搜索枚举
从 搜索提供商 导入 深寻默认参数, 艾克萨默认参数, 彭普默认参数, 填默认参数, 可服务
从 搜索提供商 导入 构造请求, 公共请求头, 归一搜索响应, 归一深寻响应, 归一艾克萨响应, 归一彭普响应
从 搜索提供商 导入 归一空响应, 归一异常响应, 引用摘录, 首个非空高亮
从 搜索提供商 导入 造搜索错误, 状态码转错误码, 是成功状态, 上游码转本卡码, 错误码文案
从 搜索提供商 导入 提供商列表, 是已知提供商, 提供商描述, 取提供商, 提供商注册表

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 含子串(文本, 子串):
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 主:
  打印 "===== 第 14 轮任务 4：搜索提供商域（纯逻辑面）====="

  # ---- §1 统一参数模式与校验 ----
  断言相等(长(校验搜索参数({"query": "hello"})), 0, "1a 合法参数无错误")
  断言相等(时间范围枚举(), ["day", "week", "month", "year"], "1b 时间范围枚举")
  断言相等(安全搜索枚举(), ["off", "moderate", "strict"], "1c 安全搜索枚举")

  设 空查询错 为 校验搜索参数({"query": ""})
  断言相等(长(空查询错) > 0, 真, "1d 空 query 报错")
  断言相等(空查询错[0]["原因"], "minLength", "1d2 原因为 minLength")

  设 缺查询错 为 校验搜索参数({"limit": 5})
  断言相等(长(缺查询错) > 0, 真, "1e 缺 query 报错")
  断言相等(缺查询错[0]["原因"], "missing", "1e2 原因为 missing")

  设 下界错 为 校验搜索参数({"query": "x", "limit": 0})
  断言相等(下界错[0]["原因"], "minimum", "1f limit 0 违反 minimum")
  设 上界错 为 校验搜索参数({"query": "x", "limit": 101})
  断言相等(上界错[0]["原因"], "maximum", "1g limit 101 违反 maximum")
  断言相等(长(校验搜索参数({"query": "x", "limit": 100})), 0, "1h limit 100 合法")
  断言相等(长(校验搜索参数({"query": "x", "limit": 1})), 0, "1i limit 1 合法")

  设 时间错 为 校验搜索参数({"query": "x", "time_range": "century"})
  断言相等(时间错[0]["原因"], "enum", "1j 非法 time_range 违反 enum")
  断言相等(长(校验搜索参数({"query": "x", "time_range": "week"})), 0, "1k 合法 time_range")
  设 安全错 为 校验搜索参数({"query": "x", "safesearch": "paranoid"})
  断言相等(安全错[0]["原因"], "enum", "1l 非法 safesearch 违反 enum")
  设 语言错 为 校验搜索参数({"query": "x", "language": "z"})
  断言相等(语言错[0]["原因"], "minLength", "1m 过短 language 违反 minLength")

  断言相等(有搜索参数错误({"query": "x"}), 假, "1n 有搜索参数错误=假")
  断言相等(有搜索参数错误({"query": ""}), 真, "1o 有搜索参数错误=真")

  # 归一参数：别名统一
  设 归一名 为 归一参数({"query": "q", "limit": 7, "time_range": "day", "language": "zh", "safesearch": "off"})
  断言相等(归一名["query"], "q", "1p 归一 query")
  断言相等(归一名["maxResults"], 7, "1q limit → maxResults")
  断言相等(归一名["timeRange"], "day", "1r time_range → timeRange")
  断言相等(归一名["language"], "zh", "1s language 透传")
  断言相等(归一名["safesearch"], "off", "1t safesearch 透传")
  断言相等(归一参数({"query": "q", "max_results": 9})["maxResults"], 9, "1u max_results 别名")
  设 归一小 为 归一参数({"query": "q"})
  断言相等(有字段(归一小, ["maxResults"]), 假, "1v 缺省不落 maxResults")

  # ---- §2 默认值填充与可用性 ----
  断言相等(深寻默认参数()["baseURL"], "https://api.deepseek.com/anthropic/v1", "2a 深寻默认端点")
  断言相等(深寻默认参数()["model"], "deepseek-v4-flash", "2b 深寻默认模型")
  断言相等(深寻默认参数()["maxTokens"], 4096, "2c 深寻默认令牌上限")
  断言相等(深寻默认参数()["maxUses"], 5, "2d 深寻默认最大次数")
  断言相等(深寻默认参数()["apiVersion"], "2023-06-01", "2e 深寻默认接口版本")
  断言相等(艾克萨默认参数()["searchType"], "auto", "2f 艾克萨默认检索型")
  断言相等(艾克萨默认参数()["highlightsPerResult"], 1, "2g 艾克萨默认高亮数")
  断言相等(艾克萨默认参数()["baseURL"], "https://api.exa.ai", "2h 艾克萨默认端点")
  断言相等(彭普默认参数()["model"], "sonar", "2i 彭普默认模型")
  断言相等(彭普默认参数()["maxTokens"], 1024, "2j 彭普默认令牌上限")

  设 覆盖后 为 填默认参数(提供商深寻, {"model": "custom-model", "maxUses": 9})
  断言相等(覆盖后["model"], "custom-model", "2k 选项覆盖默认模型")
  断言相等(覆盖后["maxUses"], 9, "2l 选项覆盖最大次数")
  断言相等(覆盖后["baseURL"], "https://api.deepseek.com/anthropic/v1", "2m 未覆盖项保留默认")
  断言相等(填默认参数(提供商艾克萨, {})["searchType"], "auto", "2n 空选项保留默认")

  断言相等(可服务(提供商深寻, "", {}), 假, "2o 空密钥不可服务")
  断言相等(可服务(提供商深寻, "sk-x", {}), 真, "2p 正常密钥可服务")
  断言相等(可服务(提供商深寻, "sk-x", {"maxTokens": 0}), 假, "2q 非正令牌上限不可服务")
  断言相等(可服务(提供商艾克萨, "sk-x", {"highlightsPerResult": 0}), 假, "2r 非正高亮数不可服务")
  断言相等(可服务(提供商彭普, "sk-x", {}), 真, "2s 彭普可服务")
  断言相等(是正整数(3), 真, "2t 正整数判定")
  断言相等(是正整数(0), 假, "2u 零非正整数")

  # ---- §3 请求构造 ----
  设 深寻请求 为 构造请求(提供商深寻, {"query": "light language", "limit": 8}, "sk-key", {})
  断言相等(深寻请求["url"], "https://api.deepseek.com/anthropic/v1/messages", "3a 深寻 URL")
  断言相等(深寻请求["method"], "POST", "3b 深寻 方法")
  断言相等(深寻请求["headers"]["x-api-key"], "sk-key", "3c 深寻 x-api-key")
  断言相等(深寻请求["headers"]["authorization"], "Bearer sk-key", "3d 深寻 authorization Bearer")
  断言相等(深寻请求["headers"]["anthropic-version"], "2023-06-01", "3e 深寻 anthropic-version")
  断言相等(深寻请求["headers"]["content-type"], "application/json", "3f 深寻 content-type")
  断言相等(深寻请求["body"]["model"], "deepseek-v4-flash", "3g 深寻 body.model")
  断言相等(深寻请求["body"]["max_tokens"], 4096, "3h 深寻 body.max_tokens")
  设 深寻文本 为 深寻请求["body"]["messages"][0]["content"][0]["text"]
  断言真(含子串(深寻文本, "Perform a web search for the query: light language"), "3i 深寻 提示文本含查询")
  断言相等(深寻请求["body"]["messages"][0]["role"], "user", "3j 深寻 角色")
  断言相等(深寻请求["body"]["tools"][0]["type"], "web_search_20250305", "3k 深寻 工具类型")
  断言相等(深寻请求["body"]["tools"][0]["name"], "web_search", "3l 深寻 工具名")
  断言相等(深寻请求["body"]["tools"][0]["max_uses"], 5, "3m 深寻 工具最大次数")

  设 艾克萨请求 为 构造请求(提供商艾克萨, {"query": "exa q", "limit": 3}, "ex-key", {})
  断言相等(艾克萨请求["url"], "https://api.exa.ai/search", "3n 艾克萨 URL")
  断言相等(艾克萨请求["headers"]["authorization"], "Bearer ex-key", "3o 艾克萨 authorization")
  断言相等(字典包含键(艾克萨请求["headers"], "x-api-key"), 假, "3p 艾克萨 无 x-api-key")
  断言相等(艾克萨请求["body"]["query"], "exa q", "3q 艾克萨 body.query")
  断言相等(艾克萨请求["body"]["type"], "auto", "3r 艾克萨 body.type")
  断言相等(艾克萨请求["body"]["contents"]["highlights"]["highlightsPerUrl"], 1, "3s 艾克萨 highlights")
  断言相等(艾克萨请求["body"]["numResults"], 3, "3t 艾克萨 numResults 落键")
  设 艾克萨无界 为 构造请求(提供商艾克萨, {"query": "q"}, "ex-key", {})
  断言相等(字典包含键(艾克萨无界["body"], "numResults"), 假, "3u 艾克萨 无界不落 numResults")

  设 彭普请求 为 构造请求(提供商彭普, {"query": "pplx q", "time_range": "month"}, "pp-key", {})
  断言相等(彭普请求["url"], "https://api.perplexity.ai/chat/completions", "3v 彭普 URL")
  断言相等(彭普请求["body"]["model"], "sonar", "3w 彭普 body.model")
  断言相等(彭普请求["body"]["max_tokens"], 1024, "3x 彭普 body.max_tokens")
  断言相等(彭普请求["body"]["messages"][0]["content"], "pplx q", "3y 彭普 消息内容")
  断言相等(彭普请求["body"]["search_recency_filter"], "month", "3z 彭普 时间范围映射")
  设 彭普无时间 为 构造请求(提供商彭普, {"query": "q"}, "pp-key", {})
  断言相等(字典包含键(彭普无时间["body"], "search_recency_filter"), 假, "3z2 彭普 无时间范围不落键")

  设 选项请求 为 构造请求(提供商彭普, {"query": "q"}, "pp-key", {"model": "sonar-pro"})
  断言相等(选项请求["body"]["model"], "sonar-pro", "3z3 构造请求 透传选项")

  # 未知提供商 → 抛错
  尝试:
    设 占位未知一 为 构造请求("no-such", {"query": "q"}, "k", {})
    断言真(假, "3z4 未知提供商应抛错")
  捕获 异常 错误一:
    断言真(含子串(转字符串(错误一), "unknown web search provider"), "3z4 未知提供商构造请求抛错")

  尝试:
    设 占位未知二 为 填默认参数("no-such", {})
    断言真(假, "3z5 未知提供商默认参数应抛错")
  捕获 异常 错误二:
    断言真(含子串(转字符串(错误二), "unknown web search provider"), "3z5 未知提供商填默认抛错")

  # ---- §4 响应归一 ----
  # 4a 无结果块 → 抛错
  设 纯文本载荷 为 {"content": [{"type": "text", "text": "prose"}]}
  尝试:
    设 占位无块 为 归一深寻响应(纯文本载荷)
    断言真(假, "4a 无结果块应抛错")
  捕获 异常 错误三:
    断言真(含子串(转字符串(错误三), "no web_search_tool_result blocks"), "4a 无结果块抛错")

  # 4b~4h 深寻归一
  设 深寻块 为 {"type": "web_search_tool_result", "content": [{"type": "web_search_result", "url": "https://a.example", "title": "标题A", "page_age": "2026-01-02"}, {"type": "web_search_result", "url": "https://a.example", "title": "重复条目"}]}
  设 摘录块 为 {"type": "text", "text": "正文", "citations": [{"url": "https://a.example", "cited_text": "摘录A"}, {"url": "https://a.example", "cited_text": "后到者应丢弃"}]}
  设 深寻结果 为 归一深寻响应({"content": [深寻块, 摘录块]})
  断言相等(长(深寻结果["sources"]), 1, "4b 按 url 去重")
  断言相等(深寻结果["sources"][0]["url"], "https://a.example", "4c url 提取")
  断言相等(深寻结果["sources"][0]["snippet"], "摘录A", "4d snippet 取首个引用摘录")
  断言相等(深寻结果["sources"][0]["title"], "标题A", "4e title 透传")
  断言相等(深寻结果["sources"][0]["publishedAt"], "2026-01-02", "4f page_age → publishedAt")
  断言相等(深寻结果["truncated"], 假, "4g truncated 恒为假")

  设 无题结果 为 归一深寻响应({"content": [{"type": "web_search_tool_result", "content": [{"type": "web_search_result", "url": "https://b.example", "title": "", "page_age": ""}]}]})
  断言相等(字典包含键(无题结果["sources"][0], "title"), 假, "4h title 为空不落键")
  断言相等(字典包含键(无题结果["sources"][0], "snippet"), 假, "4h2 无引用不落 snippet")
  断言相等(字典包含键(无题结果["sources"][0], "publishedAt"), 假, "4h3 page_age 为空不落键")

  设 异型块 为 {"type": "web_search_tool_result", "content": [{"type": "other_result", "url": "https://x.example"}, {"type": "web_search_result", "url": ""}]}
  断言相等(长(归一深寻响应({"content": [异型块]})["sources"]), 0, "4h4 非结果类型与空 url 被跳过")

  # 4i~4l 艾克萨归一
  设 艾克萨载荷 为 {"results": [{"url": "https://e1.example", "title": "E1", "publishedDate": "2026-02-02", "highlights": ["", "   ", "高亮句"]}, {"url": "https://e2.example", "highlights": []}, {"url": "https://e3.example"}]}
  设 艾克萨结果 为 归一艾克萨响应(艾克萨载荷)
  断言相等(长(艾克萨结果["sources"]), 1, "4i 无高亮条目被丢弃")
  断言相等(艾克萨结果["sources"][0]["url"], "https://e1.example", "4j 艾克萨 url")
  断言相等(艾克萨结果["sources"][0]["snippet"], "高亮句", "4k 艾克萨 首个非空高亮")
  断言相等(艾克萨结果["sources"][0]["title"], "E1", "4l 艾克萨 title")
  断言相等(艾克萨结果["sources"][0]["publishedAt"], "2026-02-02", "4l2 艾克萨 publishedDate")
  断言相等(首个非空高亮(["", "  ", "实"]), "实", "4l3 首个非空高亮跳过空白")
  断言相等(首个非空高亮([]), 空, "4l4 空高亮表返回空")
  断言相等(长(归一艾克萨响应({})["sources"]), 0, "4l5 空载荷返回空来源")

  # 4m~4o 彭普归一（结构化优先）
  设 彭普载荷 为 {"choices": [{"message": {"content": "答案文本"}}], "search_results": [{"url": "https://p1.example", "title": "P1", "snippet": "P摘", "date": "2026-03-03"}], "citations": ["https://忽略.example"]}
  设 彭普结果 为 归一彭普响应(彭普载荷)
  断言相等(彭普结果["content"], "答案文本", "4m 彭普 content 提取")
  断言相等(长(彭普结果["sources"]), 1, "4n search_results 优先于 citations")
  断言相等(彭普结果["sources"][0]["url"], "https://p1.example", "4o 彭普 url")
  断言相等(彭普结果["sources"][0]["snippet"], "P摘", "4o2 彭普 snippet")
  断言相等(彭普结果["sources"][0]["publishedAt"], "2026-03-03", "4o3 彭普 date → publishedAt")

  # 4p~4r 彭普 citations 回退
  设 引用载荷 为 {"citations": ["https://c1.example", "https://c2.example"]}
  设 引用结果 为 归一彭普响应(引用载荷)
  断言相等(长(引用结果["sources"]), 2, "4p citations 回退条数")
  断言相等(引用结果["sources"][0]["url"], "https://c1.example", "4q citations 仅 url")
  断言相等(字典包含键(引用结果["sources"][0], "title"), 假, "4r citations 不臆造 title")
  断言相等(字典包含键(引用结果, "content"), 假, "4r2 空 content 不落键")
  断言相等(长(归一彭普响应({})["sources"]), 0, "4r3 空载荷返回空来源")

  # 4s dispatch
  断言相等(长(归一搜索响应(提供商深寻, {"content": [深寻块]})["sources"]), 1, "4s dispatch 深寻")
  断言相等(长(归一搜索响应(提供商艾克萨, 艾克萨载荷)["sources"]), 1, "4s2 dispatch 艾克萨")
  断言相等(长(归一搜索响应(提供商彭普, 彭普载荷)["sources"]), 1, "4s3 dispatch 彭普")

  # 4t 空响应 / 异常响应归一
  设 空结 为 归一空响应()
  断言相等(长(空结["sources"]), 0, "4t 空响应 sources 为空")
  断言相等(空结["error"]["code"], 码空响应, "4t2 空响应码 EMPTY_RESPONSE")
  设 异常结 为 归一异常响应("exa", "bad json body")
  断言相等(异常结["error"]["code"], 码解析失败, "4t3 异常响应码 PARSE_ERROR")
  断言相等(异常结["error"]["provider"], "exa", "4t4 异常响应带提供商")

  # 4u 引用摘录辅助
  设 摘录表 为 引用摘录([{"type": "text", "citations": [{"url": "u1", "cited_text": "一"}, {"url": "u1", "cited_text": "二"}, {"url": "u2", "cited_text": ""}]}, {"type": "other", "citations": [{"url": "u3", "cited_text": "三"}]}])
  断言相等(摘录表["u1"], "一", "4u 首次出现者胜")
  断言相等(字典包含键(摘录表, "u2"), 假, "4u2 空 cited_text 不落键")
  断言相等(字典包含键(摘录表, "u3"), 假, "4u3 非 text 块被跳过")

  # ---- §5 错误族与状态码映射 ----
  设 错误结 为 造搜索错误(码缺密钥, "no key", 提供商深寻)
  断言相等(错误结["ok"], 假, "5a 错误结 ok=假")
  断言相等(错误结["code"], 码缺密钥, "5b 错误结 code")
  断言相等(错误结["message"], "no key", "5c 错误结 message")
  断言相等(错误结["provider"], 提供商深寻, "5d 错误结 provider")

  断言相等(状态码转错误码(401), 码缺密钥, "5e 401 → API_KEY_MISSING")
  断言相等(状态码转错误码(403), 码缺密钥, "5f 403 → API_KEY_MISSING")
  断言相等(状态码转错误码(429), 码限流, "5g 429 → RATE_LIMITED")
  断言相等(状态码转错误码(400), 码参数非法, "5h 400 → INVALID_PARAM")
  断言相等(状态码转错误码(422), 码参数非法, "5i 422 → INVALID_PARAM")
  断言相等(状态码转错误码(500), 码提供商错误, "5j 500 → PROVIDER_ERROR")
  断言相等(状态码转错误码(503), 码提供商错误, "5k 503 → PROVIDER_ERROR")
  断言相等(是成功状态(200), 真, "5l 200 成功")
  断言相等(是成功状态(299), 真, "5m 299 成功")
  断言相等(是成功状态(300), 假, "5n 300 非成功")

  断言相等(上游码转本卡码("WEB_PROVIDER_CREDENTIAL_MISSING"), 码缺密钥, "5o 上游缺凭据码上译")
  断言相等(上游码转本卡码("WEB_ABORTED"), "ABORTED", "5p 上游中止码上译")
  断言相等(上游码转本卡码("WEB_PROVIDER_ERROR"), 码提供商错误, "5q 上游通用失败码上译")
  断言真(字符串长度(错误码文案(码缺密钥)) > 0, "5r 缺密钥文案非空")
  断言真(字符串长度(错误码文案(码限流)) > 0, "5s 限流文案非空")
  断言相等(错误码文案("__unknown__"), "web search provider failed", "5t 未知码回退文案")

  # ---- §6 提供商注册表 ----
  断言相等(提供商列表(), [提供商深寻, 提供商艾克萨, 提供商彭普], "6a 提供商列表")
  断言相等(是已知提供商(提供商深寻), 真, "6b 已知提供商 深寻")
  断言相等(是已知提供商(提供商艾克萨), 真, "6c 已知提供商 艾克萨")
  断言相等(是已知提供商(提供商彭普), 真, "6d 已知提供商 彭普")
  断言相等(是已知提供商("openai"), 假, "6e 未知提供商判假")
  断言相等(取提供商(提供商深寻)["默认端点"], "https://api.deepseek.com/anthropic/v1", "6f 深寻注册项端点")
  断言相等(取提供商(提供商艾克萨)["路径"], "/search", "6g 艾克萨注册项路径")
  断言相等(取提供商(提供商彭普)["默认模型"], "sonar", "6h 彭普注册项模型")
  断言相等(取提供商(提供商深寻)["认证头"], "x-api-key + authorization", "6i 深寻认证头")
  设 注册表 为 提供商注册表()
  断言相等(长(注册表), 3, "6j 注册表三项")
  断言相等(注册表[提供商艾克萨]["描述"], "Exa search API with highlight contents", "6k 注册表艾克萨描述")

  尝试:
    设 占位未知三 为 取提供商("no-such")
    断言真(假, "6l 未知提供商应抛错")
  捕获 异常 错误四:
    断言真(含子串(转字符串(错误四), "unknown web search provider"), "6l 未知提供商取注册项抛错")

  打印 "test_搜索提供商 PASS"

主()
