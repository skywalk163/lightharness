# test_R87_B3_编排_子智能体目录.light —— R87 B3 第2组：子智能体目录 v1/unknown + BFS 后代
# 覆盖：
#   1. 目录阶段版本() == 3（上游 stateVersion 2→3）
#   2. 目录投影接受 v0 one-shot/continuable；v1 新增 unknown（标签可选）
#   3. entries 规则 mode !== 'continuable' → 一行式行（unknown 落一行式，无标签键）
#   4. unknown 以 v0 落库被拒；非目录事件/继承切点跳过
#   5. 运行中后代 BFS：任意深度 running，fork(无出处) 不入谱，成环只访一次
#   6. 校验浏览地址接受 unknown 模式
# 反跑判据：把「版本!=1 拒 unknown」改松、或把 BFS 改成只扫直系，断言即红。

从 子智能体 导入 目录投影, 校验目录数据, 目录阶段版本, 运行中后代, 造后代行, 校验浏览地址

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) + " 期望=" 加上 转字符串(期望)

段落 是校验抛错(数据):
  设 抛了 为 假
  尝试:
    校验目录数据(数据)
  捕获 错误 为 e:
    设 抛了 为 真
  返回 抛了

# ---- 1. 阶段版本 ----
断言等于(目录阶段版本(), 3, "目录阶段版本 应为 3")

# ---- 2/3/4. 目录投影折痕与行物化 ----
设 投影 为 新建 目录投影(0)
投影.应用事件(["类型": "subagent/catalog", "序号": 1, "数据": ["版本": 0, "子标识": "c-one", "子创建时间": 10, "模式": "one-shot", "标签": "探针"]])
投影.应用事件(["类型": "subagent/catalog", "序号": 2, "数据": ["版本": 0, "子标识": "c-cont", "子创建时间": 20, "模式": "continuable", "标签": "续谈"]])
# v1 unknown：无标签 → 一行式行（不落标签键）
投影.应用事件(["类型": "subagent/catalog", "序号": 3, "数据": ["版本": 1, "子标识": "c-unk", "子创建时间": 30, "模式": "unknown"]])
# v1 unknown：带标签
投影.应用事件(["类型": "subagent/catalog", "序号": 4, "数据": ["版本": 1, "子标识": "c-unk2", "子创建时间": 40, "模式": "unknown", "标签": "老壳"]])
# 非目录事件原样跳过
投影.应用事件(["类型": "别的/事件", "序号": 5, "数据": []])

设 行表 为 投影.条目()
断言等于(长度(行表), 4, "应折出 4 行")
# one-shot：一行式带标签
断言等于(行表[0]["标识"], "c-one", "行0 标识")
断言等于(行表[0]["模式"], "one-shot", "行0 模式")
断言等于(行表[0]["标签"], "探针", "行0 标签")
# continuable：标签必在
断言等于(行表[1]["标识"], "c-cont", "行1 标识")
断言等于(行表[1]["标签"], "续谈", "行1 标签")
# unknown 无标签：一行式，不含标签键
断言等于(行表[2]["标识"], "c-unk", "行2 标识")
断言等于(行表[2]["模式"], "unknown", "行2 模式")
断言真(行表[2].包含("标签") == 假, "行2 unknown 无标签不应落标签键")
# unknown 带标签：一行式带标签
断言等于(行表[3]["标识"], "c-unk2", "行3 标识")
断言等于(行表[3]["标签"], "老壳", "行3 标签")

# v0 unknown 必须被校验拒绝
断言真(是校验抛错(["版本": 0, "子标识": "x", "子创建时间": 1, "模式": "unknown"]), "v0 unknown 应拒")
# v2 不支持
断言真(是校验抛错(["版本": 2, "子标识": "x", "子创建时间": 1, "模式": "one-shot"]), "v2 应拒")
# 未知模式
断言真(是校验抛错(["版本": 1, "子标识": "x", "子创建时间": 1, "模式": "weird"]), "未知模式应拒")
# v1 unknown 合法不抛
断言真(是校验抛错(["版本": 1, "子标识": "x", "子创建时间": 1, "模式": "unknown"]) == 假, "v1 unknown 应放行")

# ---- 5. 运行中后代 BFS ----
# 根 root → a(subagent,running) → b(subagent,running, 孙)；c 是 root 的 fork(无出处, running)；
# d 是 a 的子(inactive)；e 是旁支兄弟(origin=subagent 但父不在谱系内)
设 代理表 为 [
  ["标识": "root", "父会话": 空, "出处": "system", "状态": "running"],
  ["标识": "a", "父会话": "root", "出处": "subagent", "状态": "running"],
  ["标识": "b", "父会话": "a", "出处": "subagent", "状态": "running"],
  ["标识": "c", "父会话": "root", "出处": "fork", "状态": "running"],
  ["标识": "d", "父会话": "a", "出处": "subagent", "状态": "inactive"],
  ["标识": "e", "父会话": "other", "出处": "subagent", "状态": "running"]
]
设 后代 为 运行中后代(代理表, "root")
断言真(后代.包含("a"), "后代应含 a")
断言真(后代.包含("b"), "后代应含 b（任意深度）")
断言真(后代.包含("c") == 假, "fork c 无出处不应入后代")
断言真(后代.包含("d") == 假, "inactive d 不应入选")
断言真(后代.包含("e") == 假, "旁支 e 不应入选")

# 成环防护：环1→环2→环1b，只访一次不死循环
设 环表 为 [
  ["标识": "root", "父会话": 空, "出处": "system", "状态": "running"],
  ["标识": "环1", "父会话": "root", "出处": "subagent", "状态": "running"],
  ["标识": "环2", "父会话": "环1", "出处": "subagent", "状态": "running"],
  ["标识": "环1b", "父会话": "环2", "出处": "subagent", "状态": "running"]
]
设 环后代 为 运行中后代(环表, "root")
断言真(环后代.包含("环1"), "环：含环1")
断言真(环后代.包含("环2"), "环：含环2")
断言真(环后代.包含("环1b"), "环：含环1b")

# ---- 6. 浏览地址 ----
校验浏览地址(["父会话标识": "p", "子会话标识": "c", "模式": "unknown"])
校验浏览地址(["父会话标识": "p", "子会话标识": "c", "模式": "continuable"])
设 地址抛 为 假
尝试:
  校验浏览地址(["父会话标识": "p", "子会话标识": "c", "模式": "weird"])
捕获 错误 为 e:
  设 地址抛 为 真
断言真(地址抛, "地址坏模式应抛")

# 后代行构造
设 行 为 造后代行("c1", "running", "unknown", "")
断言等于(行["活动"], "running", "后代行 活动")
断言真(行.包含("标签") == 假, "空标签不落键")

打印 "test_R87_B3_编排_子智能体目录 PASS"
