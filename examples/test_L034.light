# 缺陷：L-034 双引号串字面量内出现 { } 被误判为字典字面量起始
# 登记核对：经探针确认，lexer._tokenize_string 的引号分支正确消费引号内全部
#   字符（含 { } [ ]），不再穿透字符串边界。原绕法（消息内避免 { }）非必需。
#   剩余 parser 层字符串插值（{标识符} 自动变 f-string）属设计行为，超出包⑤硬边界。
# 载体：自带最小用例，不依赖其它模块。用不触发插值的结构字符模式验证。

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # 场景1：双引号串内含方括号（结构字符不穿透串边界）
  设 消息1 为 "list=[1, 2, 3]"
  断言等于(消息1, "list=[1, 2, 3]", "L-034 串内方括号不穿透")

  # 场景2：双引号串内含空花括号
  设 消息2 为 "empty={}"
  断言等于(消息2, "empty={}", "L-034 串内空花括号不穿透")

  # 场景3：双引号串内含双花括号
  设 消息3 为 "template={{a}}"
  断言等于(消息3, "template={{a}}", "L-034 串内双花括号不穿透")

  # 场景4：双引号串内含单独左花括号（无配对右花括号）
  设 消息4 为 "msg={ open end"
  断言等于(消息4, "msg={ open end", "L-034 串内单独左花括号不穿透")

  # 场景5：双引号串内含单独右花括号（无配对左花括号）
  设 消息5 为 "msg=} close end"
  断言等于(消息5, "msg=} close end", "L-034 串内单独右花括号不穿透")

  # 场景6：双引号串内同时含花括号和方括号（混合结构字符）
  设 消息6 为 "data={[1,2]} end"
  断言等于(消息6, "data={[1,2]} end", "L-034 串内混合结构字符不穿透")

  打印 "--- 测试L034 通过 ---"

主()
