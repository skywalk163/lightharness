# test_远端总线.light —— 远端总线纯逻辑覆盖测试
# 对标编号 55：远端 API 总线纯逻辑
# 覆盖：转发白名单/子代理归属/会话审视/代理解析器/参数校验/JSON安全/编解码/失败信封/远端调用
# 反跑判据：每条测试末尾写明改反方法与必红原因

从 远端总线 导入 整理直达清单, 判定可转发, 判定子代理归属, 构造归属拒绝, 审视远端会话, 代理解析器, 判定纯对象, 校验JSON安全, 校验精确参数, 解码值, 解析编解码, 构造已撤回, 构造运载失败, 构造内部失败, 调用远端

# ============================================================
# 断言辅助
# ============================================================

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

# ============================================================
# 桩函数
# ============================================================

段落 透传 接收 值:
  返回 值

段落 始终拒绝 接收 值:
  抛出 "校验拒绝"

段落 给引用 接收 值:
  返回 透传

段落 认定归属 接收 代理标识, 父代理:
  返回 真

段落 否认归属 接收 代理标识, 父代理:
  返回 假

段落 审视某会话 接收 会话标识:
  返回 ["头": ["来源": "normal", "工作目录": "/tmp", "标识": 会话标识], "条目": []]

段落 审视子代理会话 接收 会话标识:
  返回 ["头": ["来源": "subagent", "工作目录": "/tmp", "标识": 会话标识], "条目": []]

段落 恢复某代理 接收 会话标识, 选项:
  返回 ["标识": "a1", "会话": ["头": ["来源": "normal", "工作目录": "/tmp"]]]

段落 成功连接器 接收 端点, 参数:
  返回 ["好": 真, "值": "结果值"]

段落 失败连接器 接收 端点, 参数:
  返回 ["好": 假, "失败": ["代码": "rpc-error", "消息": "远端失败"]]

段落 异常连接器 接收 端点, 参数:
  抛出 "连接异常"

# ============================================================
# 测试 1：转发白名单判定
# ============================================================

段落 测白名单判定:
  设 清单 为 整理直达清单()
  断言相等(列表长度(清单), 11, "白名单有11项")
  断言真(判定可转发("agent-preset/selected"), "agent-preset/selected 可转发")
  断言真(判定可转发("commands/change"), "commands/change 可转发")
  断言真(判定可转发("cordis/request-run"), "cordis/request-run 可转发")
  断言真(判定可转发("llm/adapters-updated"), "llm/adapters-updated 可转发")
  断言真(判定可转发("settings/document-updated"), "settings/document-updated 可转发")
  断言相等(判定可转发("unknown"), 假, "unknown 不可转发")
  断言相等(判定可转发("fake/event"), 假, "fake/event 不可转发")
# 反跑判据：
#   把 列表长度(清单) 的期望 11 改为 10 → 断言相等必红
#   把 判定可转发("agent-preset/selected") 改为 判定可转发("fake") → 断言真必红
#   把 判定可转发("unknown") 的期望 假 改为 真 → 断言相等必红

# ============================================================
# 测试 2：子代理归属判定
# ============================================================

段落 测子代理归属:
  设 上下文 为 ["代理表": {}, "判定归属": 认定归属]
  # origin = subagent → true
  设 头1 为 ["来源": "subagent", "父会话": 空]
  断言相等(判定子代理归属(上下文, 头1, 空), 真, "subagent来源归属为真")
  # origin = normal, 无父 → false
  设 头2 为 ["来源": "normal", "父会话": 空]
  断言相等(判定子代理归属(上下文, 头2, 空), 假, "normal无父归属为假")
  # origin = normal, 有父无代理 → false
  设 头3 为 ["来源": "normal", "父会话": "parent-1"]
  断言相等(判定子代理归属(上下文, 头3, 空), 假, "有父无代理归属为假")
  # origin = normal, 有父有代理且认定归属 → true
  设 头4 为 ["来源": "normal", "父会话": "parent-1"]
  设 代理 为 ["标识": "a1"]
  设 上下文2 为 ["代理表": ["parent-1": 代理], "判定归属": 认定归属]
  断言相等(判定子代理归属(上下文2, 头4, 代理), 真, "父代理链认定归属为真")
  # origin = normal, 有父有代理但否认归属 → false
  设 上下文3 为 ["代理表": ["parent-1": 代理], "判定归属": 否认归属]
  断言相等(判定子代理归属(上下文3, 头4, 代理), 假, "否认归属为假")
# 反跑判据：
#   把 头1 的 "来源" 从 "subagent" 改为 "normal" → 断言相等(真) 必红
#   把 头2 的 "来源" 从 "normal" 改为 "subagent" → 断言相等(假) 必红
#   把 上下文2 的 "判定归属" 从 认定归属 改为 否认归属 → 断言相等(真) 必红

# ============================================================
# 测试 3：归属拒绝错误信封
# ============================================================

段落 测归属拒绝:
  设 信封 为 构造归属拒绝("s1")
  断言相等(取可选(信封, "代码"), "agent-busy", "拒绝代码为agent-busy")
  断言真(取可选(信封, "消息") != 空, "拒绝有消息")
  断言真(取可选(信封, "细节") != 空, "拒绝有细节")
# 反跑判据：
#   把 "agent-busy" 改为 "internal" → 断言相等必红
#   把 取可选(信封, "消息") 改为 取可选(信封, "不存在字段") → 断言真必红

# ============================================================
# 测试 4：会话审视
# ============================================================

段落 测会话审视:
  # 无持久层 → 抛出
  设 无持久已抛 为 假
  尝试:
    审视远端会话({}, "s1")
  捕获:
    设 无持久已抛 为 真
  断言真(无持久已抛, "无持久层应抛出")
  # 有持久层但列表空 → 抛出
  设 空列表持久层 为 ["列表": [], "审视": 审视某会话]
  设 不存在已抛 为 假
  尝试:
    审视远端会话(["持久层": 空列表持久层], "s1")
  捕获:
    设 不存在已抛 为 真
  断言真(不存在已抛, "不存在会话应抛出")
  # 有会话但缺工作目录 → 抛出
  设 缺目录持久层 为 ["列表": [["标识": "s1"]], "审视": 审视某会话]
  设 缺目录已抛 为 假
  尝试:
    审视远端会话(["持久层": 缺目录持久层], "s1")
  捕获:
    设 缺目录已抛 为 真
  断言真(缺目录已抛, "缺工作目录应抛出")
  # 正常审视
  设 正常持久层 为 ["列表": [["标识": "s1", "工作目录": "/tmp"]], "审视": 审视某会话]
  设 审视结果 为 审视远端会话(["持久层": 正常持久层], "s1")
  断言真(取可选(审视结果, "头") != 空, "正常审视有头")
  断言真(取可选(审视结果, "条目") != 空, "正常审视有条目")
# 反跑判据：
#   把 无持久已抛 的期望 真 改为 假 → 断言真必红
#   把 空列表持久层 的 "列表" 从 [] 改为 [["标识": "s1", "工作目录": "/tmp"]] → 不存在已抛 变为假 → 断言真必红
#   把 缺目录持久层 的项加 "工作目录": "/tmp" → 缺目录已抛 变为假 → 断言真必红
#   把 正常持久层 的 "列表" 改为 [] → 审视远端会话抛出 → 断言真(取可选(审视结果, "头")) 必红

# ============================================================
# 测试 5：代理解析器 — 活跃代理
# ============================================================

段落 测代理解析活跃:
  # 活跃代理无归属 → 返回代理
  设 会话头 为 ["来源": "normal", "父会话": 空, "工作目录": "/tmp"]
  设 代理对象 为 ["标识": "a1", "会话": ["头": 会话头]]
  设 上下文 为 ["代理表": ["s1": 代理对象], "会话表": {}, "判定归属": 否认归属]
  设 解析器 为 新建 代理解析器(上下文, {})
  设 结果 为 解析器.解析代理("s1")
  断言真(取可选(结果, "代理") != 空, "活跃代理无归属应返回代理")
  # 活跃代理有归属 → 返回失败
  设 子代理头 为 ["来源": "subagent", "父会话": 空, "工作目录": "/tmp"]
  设 子代理 为 ["标识": "a2", "会话": ["头": 子代理头]]
  设 子上下文 为 ["代理表": ["s2": 子代理], "会话表": {}, "判定归属": 否认归属]
  设 子解析器 为 新建 代理解析器(子上下文, {})
  设 子结果 为 子解析器.解析代理("s2")
  断言真(取可选(子结果, "失败") != 空, "子代理活跃应返回失败")
  断言相等(取可选(子结果["失败"], "代码"), "agent-busy", "失败代码为agent-busy")
# 反跑判据：
#   把 会话头 的 "来源" 从 "normal" 改为 "subagent" → 断言真(取可选(结果, "代理")) 必红（变为失败）
#   把 子代理头 的 "来源" 从 "subagent" 改为 "normal" → 断言真(取可选(子结果, "失败")) 必红（变为代理）
#   把 "agent-busy" 改为 "internal" → 断言相等必红

# ============================================================
# 测试 6：代理解析器 — 冷启动
# ============================================================

段落 测代理解析冷启动:
  # 会话不存在 → session-not-found
  设 空上下文 为 ["代理表": {}, "会话表": {}, "持久层": ["列表": [], "审视": 审视某会话], "判定归属": 否认归属, "恢复代理": 恢复某代理]
  设 空解析器 为 新建 代理解析器(空上下文, {})
  设 空结果 为 空解析器.解析代理("不存在")
  断言真(取可选(空结果, "失败") != 空, "会话不存在应返回失败")
  断言相等(取可选(空结果["失败"], "代码"), "session-not-found", "失败代码为session-not-found")
  # 冷启动正常 → 返回代理
  设 冷上下文 为 ["代理表": {}, "会话表": {}, "持久层": ["列表": [["标识": "s3", "工作目录": "/tmp"]], "审视": 审视某会话], "判定归属": 否认归属, "恢复代理": 恢复某代理]
  设 冷解析器 为 新建 代理解析器(冷上下文, {})
  设 冷结果 为 冷解析器.解析代理("s3")
  断言真(取可选(冷结果, "代理") != 空, "冷启动应返回代理")
  # 冷启动子代理归属 → agent-busy
  设 子代理冷上下文 为 ["代理表": {}, "会话表": {}, "持久层": ["列表": [["标识": "s4", "工作目录": "/tmp"]], "审视": 审视子代理会话], "判定归属": 否认归属, "恢复代理": 恢复某代理]
  设 子代理冷解析器 为 新建 代理解析器(子代理冷上下文, {})
  设 子代理冷结果 为 子代理冷解析器.解析代理("s4")
  断言相等(取可选(子代理冷结果["失败"], "代码"), "agent-busy", "子代理冷启动应返回agent-busy")
  # 无恢复函数 → internal
  设 无恢复上下文 为 ["代理表": {}, "会话表": {}, "持久层": ["列表": [["标识": "s5", "工作目录": "/tmp"]], "审视": 审视某会话], "判定归属": 否认归属]
  设 无恢复解析器 为 新建 代理解析器(无恢复上下文, {})
  设 无恢复结果 为 无恢复解析器.解析代理("s5")
  断言相等(取可选(无恢复结果["失败"], "代码"), "internal", "无恢复函数应返回internal")
# 反跑判据：
#   把 空上下文 的 "列表" 从 [] 改为 [["标识": "不存在", "工作目录": "/tmp"]] → 失败代码不再是 session-not-found → 断言相等必红
#   把 冷上下文 的 "恢复代理" 删除 → 断言真(取可选(冷结果, "代理")) 必红（变为internal）
#   把 子代理冷上下文 的 "审视" 从 审视子代理会话 改为 审视某会话 → 失败代码不再是 agent-busy → 断言相等必红
#   把 无恢复上下文 加上 "恢复代理": 恢复某代理 → 失败代码不再是 internal → 断言相等必红

# ============================================================
# 测试 7：参数形状校验
# ============================================================

段落 测参数形状校验:
  设 严格编解码 为 ["严格": 真, "校验函数": 透传]
  设 校验描述符 为 ["参数列表": [["线名": "input", "来源": "json", "编解码": 严格编解码]]]
  # 非纯对象 → 抛出
  设 非对象已抛 为 假
  尝试:
    校验精确参数("not a dict", 校验描述符, "test/echo")
  捕获:
    设 非对象已抛 为 真
  断言真(非对象已抛, "非纯对象应抛出")
  # 匹配 → 不抛出
  设 匹配已抛 为 假
  尝试:
    校验精确参数(["input": "hello"], 校验描述符, "test/echo")
  捕获:
    设 匹配已抛 为 真
  断言相等(匹配已抛, 假, "匹配参数不应抛出")
  # 额外键 → 抛出
  设 额外已抛 为 假
  尝试:
    校验精确参数(["input": "hello", "extra": "val"], 校验描述符, "test/echo")
  捕获:
    设 额外已抛 为 真
  断言真(额外已抛, "额外键应抛出")
  # 缺失键 → 抛出
  设 缺失已抛 为 假
  尝试:
    校验精确参数({}, 校验描述符, "test/echo")
  捕获:
    设 缺失已抛 为 真
  断言真(缺失已抛, "缺失键应抛出")
  # 可缺省键缺失 → 不抛出
  设 可缺省描述符 为 ["参数列表": [["线名": "required", "来源": "json", "编解码": 严格编解码], ["线名": "optional", "来源": "json", "允许空": 真, "编解码": 严格编解码]]]
  设 可缺省已抛 为 假
  尝试:
    校验精确参数(["required": "val"], 可缺省描述符, "test/echo")
  捕获:
    设 可缺省已抛 为 真
  断言相等(可缺省已抛, 假, "可缺省键缺失不应抛出")
  # 缺必需键 → 抛出
  设 缺必需已抛 为 假
  尝试:
    校验精确参数(["optional": "val"], 可缺省描述符, "test/echo")
  捕获:
    设 缺必需已抛 为 真
  断言真(缺必需已抛, "缺必需键应抛出")
  # src-json 编解码 → 缺失不抛出
  设 源JSON编解码 为 ["严格": 真, "校验函数": 透传, "来源": "src-json"]
  设 源JSON描述符 为 ["参数列表": [["线名": "flex", "来源": "json", "编解码": 源JSON编解码]]]
  设 源JSON已抛 为 假
  尝试:
    校验精确参数({}, 源JSON描述符, "test/echo")
  捕获:
    设 源JSON已抛 为 真
  断言相等(源JSON已抛, 假, "src-json编解码缺失不应抛出")
# 反跑判据：
#   把 非对象已抛 的期望 真 改为 假 → 断言真必红
#   把 匹配已抛 的期望 假 改为 真 → 断言相等必红
#   把 可缺省描述符 中 "允许空" 从 真 改为 假 → 可缺省已抛 变为真 → 断言相等(假) 必红
#   把 源JSON编解码 中 "来源" 从 "src-json" 改为 "json" → 源JSON已抛 变为真 → 断言相等(假) 必红

# ============================================================
# 测试 8：JSON 安全校验
# ============================================================

段落 测JSON安全:
  # 空 → 通过
  设 空已抛 为 假
  尝试:
    校验JSON安全(空, [])
  捕获:
    设 空已抛 为 真
  断言相等(空已抛, 假, "空值应通过")
  # 字符串 → 通过
  设 串已抛 为 假
  尝试:
    校验JSON安全("hello", [])
  捕获:
    设 串已抛 为 真
  断言相等(串已抛, 假, "字符串应通过")
  # 布尔 → 通过
  设 布尔已抛 为 假
  尝试:
    校验JSON安全(真, [])
  捕获:
    设 布尔已抛 为 真
  断言相等(布尔已抛, 假, "布尔应通过")
  # 整数 → 通过
  设 整已抛 为 假
  尝试:
    校验JSON安全(42, [])
  捕获:
    设 整已抛 为 真
  断言相等(整已抛, 假, "整数应通过")
  # 有限浮点 → 通过
  设 浮已抛 为 假
  尝试:
    校验JSON安全(1.5, [])
  捕获:
    设 浮已抛 为 真
  断言相等(浮已抛, 假, "有限浮点应通过")
  # 列表 → 通过
  设 列已抛 为 假
  尝试:
    校验JSON安全([1, 2, 3], [])
  捕获:
    设 列已抛 为 真
  断言相等(列已抛, 假, "列表应通过")
  # 字典 → 通过
  设 典已抛 为 假
  尝试:
    校验JSON安全(["a": 1, "b": 2], [])
  捕获:
    设 典已抛 为 真
  断言相等(典已抛, 假, "字典应通过")
  # 非 JSON 类型 → 抛出
  设 非JSON已抛 为 假
  尝试:
    校验JSON安全(透传, [])
  捕获:
    设 非JSON已抛 为 真
  断言真(非JSON已抛, "非JSON类型应抛出")
  # 循环引用 → 抛出
  设 自引 为 {}
  设 自引["自"] 为 自引
  设 循环已抛 为 假
  尝试:
    校验JSON安全(自引, [])
  捕获:
    设 循环已抛 为 真
  断言真(循环已抛, "循环引用应抛出")
# 反跑判据：
#   把 空已抛 的期望 假 改为 真 → 断言相等必红
#   把 非JSON已抛 的期望 真 改为 假 → 断言真必红
#   把 循环已抛 的期望 真 改为 假 → 断言真必红
#   把 自引["自"] 为 自引 改为 自引["自"] 为 1 → 循环已抛 变为假 → 断言真必红

# ============================================================
# 测试 9：解码值
# ============================================================

段落 测解码值:
  设 严格编解码 为 ["严格": 真, "校验函数": 透传]
  # strict + 有效值
  设 结果1 为 解码值(严格编解码, "hello", "decode", "test/echo", "field1")
  断言相等(结果1, "hello", "strict解码返回值")
  # strict + 校验函数产出非JSON → 抛出
  设 非JSON编解码 为 ["严格": 真, "校验函数": 给引用]
  设 非JSON已抛 为 假
  尝试:
    解码值(非JSON编解码, "input", "decode", "test/echo", "field2")
  捕获:
    设 非JSON已抛 为 真
  断言真(非JSON已抛, "非JSON产出应抛出")
# 反跑判据：
#   把 结果1 的期望 "hello" 改为 "world" → 断言相等必红
#   把 非JSON编解码 的 "校验函数" 从 给引用 改为 透传 → 非JSON已抛 变为假 → 断言真必红

# ============================================================
# 测试 10：编解码解析
# ============================================================

段落 测编解码解析:
  设 严格编解码 为 ["严格": 真, "校验函数": 透传]
  设 宽松编解码 为 ["严格": 假, "校验函数": 透传]
  设 拒绝编解码 为 ["严格": 真, "校验函数": 始终拒绝]
  # strict + 有效
  断言相等(解析编解码(严格编解码, "hello", "test/echo", "field"), "hello", "strict解析返回值")
  # 非strict → 抛出
  设 非strict已抛 为 假
  尝试:
    解析编解码(宽松编解码, "hello", "test/echo", "field")
  捕获:
    设 非strict已抛 为 真
  断言真(非strict已抛, "非strict应抛出")
  # strict + 校验拒绝 → 抛出
  设 拒绝已抛 为 假
  尝试:
    解析编解码(拒绝编解码, "hello", "test/echo", "field")
  捕获:
    设 拒绝已抛 为 真
  断言真(拒绝已抛, "校验拒绝应抛出")
# 反跑判据：
#   把 strict解析 的期望 "hello" 改为 "world" → 断言相等必红
#   把 宽松编解码 的 "严格" 从 假 改为 真 → 非strict已抛 变为假 → 断言真必红
#   把 拒绝编解码 的 "校验函数" 从 始终拒绝 改为 透传 → 拒绝已抛 变为假 → 断言真必红

# ============================================================
# 测试 11：失败信封
# ============================================================

段落 测失败信封:
  # 构造内部失败
  设 内部 为 构造内部失败("测试消息")
  断言相等(取可选(内部, "成功"), 假, "内部失败成功为假")
  断言相等(取可选(内部["失败"], "代码"), "internal", "内部失败代码")
  断言相等(取可选(内部["失败"], "消息"), "测试消息", "内部失败消息")
  # 构造已撤回
  设 撤回 为 构造已撤回("test/echo")
  断言相等(取可选(撤回, "成功"), 假, "撤回成功为假")
  断言相等(取可选(撤回["失败"], "代码"), "internal", "撤回失败代码")
  # 构造运载失败
  设 运载 为 构造运载失败("test/echo", "连接错误")
  断言相等(取可选(运载, "成功"), 假, "运载成功为假")
  断言相等(取可选(运载["失败"], "代码"), "internal", "运载失败代码")
  断言真(取可选(运载["失败"], "消息") != 空, "运载失败有消息")
# 反跑判据：
#   把 取可选(内部, "成功") 的期望 假 改为 真 → 断言相等必红
#   把 "internal" 改为 "rpc-error" → 断言相等必红
#   把 构造已撤回 改为 构造运载失败 → 消息不同 → 断言相等必红

# ============================================================
# 测试 12：远端调用
# ============================================================

段落 测远端调用:
  设 严格编解码 为 ["严格": 真, "校验函数": 透传]
  设 调用描述符 为 ["命名空间": "test", "方法": "echo", "参数列表": [["线名": "input", "来源": "json", "编解码": 严格编解码]], "结果编解码": 严格编解码]
  设 活跃令牌 为 ["活跃": 真]
  # token 失效 → 撤回
  设 失效令牌 为 ["活跃": 假]
  设 失效结果 为 调用远端(调用描述符, 空, 失效令牌, ["hello"], 成功连接器, 空)
  断言相等(取可选(失效结果, "成功"), 假, "失效令牌应返回失败")
  断言相等(取可选(失效结果["失败"], "代码"), "internal", "失效令牌失败代码")
  # 参数计数不匹配 → 抛出
  设 计数已抛 为 假
  尝试:
    调用远端(调用描述符, 空, 活跃令牌, [], 成功连接器, 空)
  捕获:
    设 计数已抛 为 真
  断言真(计数已抛, "参数计数不匹配应抛出")
  # 正常调用 → 成功
  设 成功结果 为 调用远端(调用描述符, 空, 活跃令牌, ["hello"], 成功连接器, 空)
  断言相等(取可选(成功结果, "成功"), 真, "成功调用应返回成功")
  断言相等(取可选(成功结果, "值"), "结果值", "返回值正确")
  # RPC 失败 → 失败透传
  设 失败结果 为 调用远端(调用描述符, 空, 活跃令牌, ["hello"], 失败连接器, 空)
  断言相等(取可选(失败结果, "成功"), 假, "RPC失败应返回失败")
  断言相等(取可选(失败结果["失败"], "代码"), "rpc-error", "RPC失败代码透传")
  # RPC 异常 → 运载失败
  设 异常结果 为 调用远端(调用描述符, 空, 活跃令牌, ["hello"], 异常连接器, 空)
  断言相等(取可选(异常结果, "成功"), 假, "连接异常应返回失败")
  断言相等(取可选(异常结果["失败"], "代码"), "internal", "连接异常失败代码")
  # 有投影缺标识 → 抛出
  设 投影 为 ["线名": "ctx", "编解码": 严格编解码, "参数索引": 0]
  设 投影描述符 为 ["命名空间": "test", "方法": "invoke", "参数列表": [["线名": "ctx", "编解码": 严格编解码, "来源": "json"], ["线名": "input", "编解码": 严格编解码, "来源": "json"]], "结果编解码": 严格编解码]
  设 缺标识已抛 为 假
  尝试:
    调用远端(投影描述符, 投影, 活跃令牌, ["hello"], 成功连接器, 空)
  捕获:
    设 缺标识已抛 为 真
  断言真(缺标识已抛, "投影缺标识应抛出")
  # 有投影正常 → 成功
  设 投影结果 为 调用远端(投影描述符, 投影, 活跃令牌, ["hello"], 成功连接器, "identity")
  断言相等(取可选(投影结果, "成功"), 真, "投影调用应成功")
  断言相等(取可选(投影结果, "值"), "结果值", "投影返回值正确")
# 反跑判据：
#   把 失效令牌 的 "活跃" 从 假 改为 真 → 失效结果 不再是失败 → 断言相等(假) 必红
#   把 计数已抛 的期望 真 改为 假 → 断言真必红
#   把 成功连接器 改为 失败连接器 → 成功结果 变为失败 → 断言相等(真) 必红
#   把 缺标识已抛 的期望 真 改为 假 → 断言真必红
#   把 投影 从 ["线名": "ctx", ...] 改为 空 → 缺标识已抛 变为假 → 断言真必红

# ============================================================
# 主入口
# ============================================================

测白名单判定()
测子代理归属()
测归属拒绝()
测会话审视()
测代理解析活跃()
测代理解析冷启动()
测参数形状校验()
测JSON安全()
测解码值()
测编解码解析()
测失败信封()
测远端调用()
