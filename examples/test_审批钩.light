# test_审批钩.light —— E4 权限+审批+agent 集成测试
# 验证：pre_tool 钩子注册 → 放行/拒绝/审批三条路径 → agent 主循环正确响应

从 权限 导入 权限管理器, 预设全放行, 预设按类别, 预设全拒绝
从 审批 导入 审批管理器
从 agent 导入 钩子管理器, 运行智能体, 注册默认钩子, 审批上下文, 审批钩
导入 time

段落 断言 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：条件=" + 转字符串(条件))

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


# ---- 工具注册表 mock ----
类 Mock注册表:
  属性 执行次数 等于 0
  段落 构造:
    设 己.执行次数 为 0
  段落 描述表:
    返回 [{"名称": "bash", "描述": "shell"}]
  段落 执行 接收 工具名, 参数:
    设 己.执行次数 为 己.执行次数 + 1
    返回 ["content": "MOCK_EXEC_OK", "isError": 假, "error": ""]


# ---- 事件推送 mock ----
类 事件收集:
  属性 事件列表 等于 空
  段落 构造:
    设 己.事件列表 为 []
  段落 推送 接收 事件:
    己.事件列表.追加(事件)
    返回 真


# ---- 聊天函数 mock（bash ls，一次工具调用）----
段落 聊天一次bash 接收 消息, 工具表, 模型:
  设 已工具 为 假
  设 i 为 0
  当 i < 长度(消息):
    如果 消息[i].包含("角色") 且 消息[i]["角色"] == "tool":
      设 已工具 为 真
    设 i 为 i + 1
  如果 已工具 == 假:
    返回 ["内容": "", "工具调用": [{"id": "call_1", "name": "bash", "arguments": {"command": "ls"}}]]
  返回 ["内容": "DONE", "工具调用": []]


# ---- 聊天函数 mock（危险命令）----
段落 聊天危险命令 接收 消息, 工具表, 模型:
  设 已工具 为 假
  设 i 为 0
  当 i < 长度(消息):
    如果 消息[i].包含("角色") 且 消息[i]["角色"] == "tool":
      设 已工具 为 真
    设 i 为 i + 1
  如果 已工具 == 假:
    返回 ["内容": "", "工具调用": [{"id": "call_1", "name": "bash", "arguments": {"command": "rm -rf /"}}]]
  返回 ["内容": "DONE", "工具调用": []]


# ---- 聊天函数 mock（需审批：写文件）----
段落 聊天需审批 接收 消息, 工具表, 模型:
  设 已工具 为 假
  设 i 为 0
  当 i < 长度(消息):
    如果 消息[i].包含("角色") 且 消息[i]["角色"] == "tool":
      设 已工具 为 真
    设 i 为 i + 1
  如果 已工具 == 假:
    返回 ["内容": "", "工具调用": [{"id": "call_1", "name": "写文件", "arguments": {"路径": "/tmp/x", "内容": "hi"}}]]
  返回 ["内容": "DONE", "工具调用": []]


# ---- 用例 1：放行路径（bash ls 自动放行）----
段落 用例1_放行:
  设 权 为 新建 权限管理器()
  设 审 为 新建 审批管理器()
  设 上 为 新建 审批上下文("sess1")
  设 钩 为 新建 钩子管理器()
  注册默认钩子(钩, 审, 权, 上)
  断言(长度(钩.预工具) == 1, "用例1a: 注册了1个 pre_tool 钩子")
  断言(长度(钩.后工具) == 1, "用例1b: 注册了后工具钩子")
  断言(长度(钩.后轮次) == 1, "用例1c: 注册了后轮次钩子")
  设 表 为 新建 Mock注册表()
  设 事件 为 新建 事件收集()
  设 初始 为 ["角色": "user", "内容": "ls 一下"]
  设 结果 为 运行智能体(初始, 表, 聊天一次bash, 事件.推送, 钩, 5, "mock")
  断言(结果["文本"] == "DONE", "用例1d: 最终文本 DONE")
  断言(表.执行次数 == 1, "用例1e: 工具执行1次（放行）")
  断言(长度(审.待审批) == 0, "用例1f: 无待审批项")
  写 "通过: 用例1 放行路径"


# ---- 用例 2：拒绝路径（危险命令 rm -rf /）----
段落 用例2_拒绝:
  设 权 为 新建 权限管理器()
  设 审 为 新建 审批管理器()
  设 上 为 新建 审批上下文("sess2")
  设 钩 为 新建 钩子管理器()
  注册默认钩子(钩, 审, 权, 上)
  设 表 为 新建 Mock注册表()
  设 事件 为 新建 事件收集()
  设 初始 为 ["角色": "user", "内容": "删除根目录"]
  设 结果 为 运行智能体(初始, 表, 聊天危险命令, 事件.推送, 钩, 5, "mock")
  断言(结果["文本"] == "DONE", "用例2a: 最终文本 DONE")
  断言(表.执行次数 == 0, "用例2b: 工具未执行（拒绝）")
  断言(长度(审.待审批) == 0, "用例2c: 危险命令不进入审批")
  # 检查事件包含拒绝理由
  设 拒绝事件 为 空
  设 i 为 0
  当 i < 长度(事件.事件列表):
    如果 事件.事件列表[i]["种类"] == "工具结果" 且 事件.事件列表[i].包含("错误"):
      设 拒绝事件 为 事件.事件列表[i]["错误"]
    设 i 为 i + 1
  断言(拒绝事件 != 空, "用例2d: 有拒绝事件")
  断言(拒绝事件.查找("权限策略") >= 0, "用例2e: 拒绝理由含权限策略")
  写 "通过: 用例2 拒绝路径"


# ---- 用例 3：审批超时路径（写文件 → 请求审批 → 超时默认拒绝）----
段落 用例3_审批超时:
  设 权 为 新建 权限管理器()
  权.设置预设(预设按类别)
  # 把审批超时改成 0.3 秒，加快测试
  设 权.审批超时 为 0.3
  设 审 为 新建 审批管理器()
  设 上 为 新建 审批上下文("sess3")
  设 钩 为 新建 钩子管理器()
  注册默认钩子(钩, 审, 权, 上)
  设 表 为 新建 Mock注册表()
  设 事件 为 新建 事件收集()
  设 初始 为 ["角色": "user", "内容": "写个文件"]
  设 结果 为 运行智能体(初始, 表, 聊天需审批, 事件.推送, 钩, 5, "mock")
  断言(结果["文本"] == "DONE", "用例3a: 最终文本 DONE")
  断言(表.执行次数 == 0, "用例3b: 工具未执行（超时默认拒绝）")
  # 超时后审批移入已处理
  断言(长度(审.已处理) == 1, "用例3c: 有1条已处理")
  设 结果项 为 审.全部已处理()
  断言(结果项[0]["批准"] == 假, "用例3d: 超时后批准为假")
  断言(结果项[0]["状态"] == "超时", "用例3e: 状态为超时")
  写 "通过: 用例3 审批超时路径"


# ---- 用例 4：权限模式切换（全放行/全拒绝/按类别）----
段落 用例4_预设切换:
  # 全放行：危险命令也放行
  设 权 为 新建 权限管理器()
  权.设置预设(预设全放行)
  设 审 为 新建 审批管理器()
  设 上 为 新建 审批上下文("sess4a")
  设 钩 为 新建 钩子管理器()
  注册默认钩子(钩, 审, 权, 上)
  设 表 为 新建 Mock注册表()
  设 事件 为 新建 事件收集()
  运行智能体(["角色": "user", "内容": "x"], 表, 聊天危险命令, 事件.推送, 钩, 5, "mock")
  断言(表.执行次数 == 1, "用例4a: 全放行-危险命令也执行")
  断言(长度(审.待审批) == 0, "用例4b: 全放行-无待审批")

  # 全拒绝：所有工具都拒绝
  设 权2 为 新建 权限管理器()
  权2.设置预设(预设全拒绝)
  设 审2 为 新建 审批管理器()
  设 上2 为 新建 审批上下文("sess4b")
  设 钩2 为 新建 钩子管理器()
  注册默认钩子(钩2, 审2, 权2, 上2)
  设 表2 为 新建 Mock注册表()
  设 事件2 为 新建 事件收集()
  运行智能体(["角色": "user", "内容": "x"], 表2, 聊天一次bash, 事件2.推送, 钩2, 5, "mock")
  断言(表2.执行次数 == 0, "用例4c: 全拒绝-工具不执行")
  断言(长度(审2.待审批) == 0, "用例4d: 全拒绝-无待审批")

  写 "通过: 用例4 预设切换"


# ---- 用例 5：审批钩直接调用（单元测试）----
段落 用例5_钩直接调用:
  设 权 为 新建 权限管理器()
  设 审 为 新建 审批管理器()
  设 上 为 新建 审批上下文("sess5")
  设 钩对象 为 新建 审批钩(权, 审, 上)
  # 放行：bash ls
  设 结果1 为 钩对象.裁决("bash", {"command": "ls"})
  断言(结果1["批准"] == 真, "用例5a: 放行-批准")
  断言(结果1["需审批"] == 假, "用例5b: 放行-不需审批")
  # 拒绝：危险命令
  设 结果2 为 钩对象.裁决("bash", {"command": "rm -rf /"})
  断言(结果2["批准"] == 假, "用例5c: 拒绝-不批准")
  断言(结果2.包含("理由") == 真, "用例5d: 拒绝-有理由")
  写 "通过: 用例5 钩直接调用"


段落 主:
  用例1_放行()
  用例2_拒绝()
  用例3_审批超时()
  用例4_预设切换()
  用例5_钩直接调用()
  写 ""
  写 "全部 5 用例通过 ✓"

主()
