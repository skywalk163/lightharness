# test_搜索提供商_接线.light —— 第6轮 任务E #282 搜索提供商接线 判据
# 运行：python 运行.py examples/test_搜索提供商_接线.light
# 判据：接线搜索工具（依赖注入执行器，手法同 交互工具）：注册 → 查找 → 执行 → mock 载荷归一；
#       纯逻辑回归绿由 test_搜索提供商.light 承担。

从 搜索提供商 导入 接线搜索工具
从 工具 导入 工具注册表
从 JSON 导入 解析JSON

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 执行器：返回深寻 web_search_tool_result 载荷形状
段落 mock深寻执行器(请求):
  返回 {"content": [{"type": "web_search_tool_result", "content": [
    {"type": "web_search_result", "url": "https://example.com/a", "title": "结果甲"},
    {"type": "web_search_result", "url": "https://example.com/b", "title": "结果乙"}]}]}

段落 主:
  # ---- 1. 一行注册：search 工具对注册表可见 ----
  设 注册表 为 新建 工具注册表()
  设 接线结果 为 接线搜索工具(注册表, {"提供商": "deepseek-official", "执行器": mock深寻执行器})
  断言真(接线结果, "1a 接线返回真")
  断言真(注册表.有无("search"), "1b 注册表可见")

  # ---- 2. 执行：mock 载荷归一成功 ----
  设 定义 为 注册表.查找("search")
  断言真(定义 != 空, "2a 定义可查")
  设 结果 为 定义["execute"]({"query": "光明语言"})
  断言真(结果["isError"] == 假, "2b 执行成功")
  设 载荷 为 解析JSON(结果["content"][0]["text"])
  断言真(是字典(载荷), "2c 归一结果为字典")
  断言真(序列化JSON(载荷).包含("example.com/a"), "2d 来源透传")

  # ---- 3. 参数校验失败 -> 错误结果（不静默） ----
  设 结果3 为 注册表.查找("search")["execute"]({"limit": "不是数字"})
  断言真(结果3["isError"], "3a 坏参数须错误结果")

  # ---- 4. 描述表可见（对模型可见面：列表含 name=search 条目） ----
  设 描述表 为 注册表.描述表()
  设 见到 为 假
  遍历 条目 之 描述表:
    如果 条目["name"] == "search":
      设 见到 为 真
  断言真(见到, "4a 描述表含 search")

  打印 "--- 第6轮 任务E #282 搜索提供商接线 测试通过 ---"

主()