# test_R73_D_模式匹配.light —— R73 任务 D（G-11，低优先级）
#
# 任务书：docs/功能对标/光明语言语法缺陷清零_R71-R73三轮并发开发任务书.md §五 D
# 缺陷：G-11 match-case 模式匹配不完善——解构匹配（字典/元组）、守卫、通配符
#       此前字典模式（LBRACE 起始）与元组模式（LPAREN 起始）直接被 parser 拒绝，
#       列表 rest 模式 `[首, *余]` 存在死循环挂死（`*` 不消费 token）。
# 修复面（light-merge/src/）：
#   · ast_nodes_v3.py：MatchPattern 新增 keys / trailing_comma 字段（dict 模式键、
#     tuple 单元素尾逗号）。
#   · parser_stmt.py：_parse_match_pattern 新增 tuple/dict/rest 分支；列表元素递归
#     传入 in_sequence=True 约束 rest 只能出现在括号内；tuple 解析遇到比较/逻辑
#     守卫运算符立即停止交由上层整体重解析为表达式（`情况 (分数 >= 90):`）；
#     兜底分支改为「消费 token + wildcard」，修复 `*` 死循环挂死。
#   · code_generator.py / code_generator_unified.py：_generate_match_pattern 新增
#     tuple（空/单元素尾逗号/多元素）、dict（keys 字面量 + 值递归）、rest（`*`+内层）。
# 反向哨兵（预期编译失败）test_R73_D_顶层星号模式.light 登记于 tests/test_回归.py
#   EXPECT_RED——rest 模式只允许出现在列表/元组模式内部，顶层 `情况 *余:` 应报错。
# 改前此文件解析即失败；改后 20 断言 rc=0。

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ok " + 标签

段落 校验rest 接收 首, 余:
  断言相等(首, 1, "4a rest 首元素")
  断言相等(余, [2, 3, 4], "4b rest 余项")

段落 校验嵌套 接收 名, 龄, 首, 尾:
  断言相等(名, "张三", "11a 嵌套 dict 内层名")
  断言相等(龄, 30, "11b 嵌套 dict 内层龄")
  断言相等(首, "a", "11c 嵌套 list 首")
  断言相等(尾, "b", "11d 嵌套 list 尾")

段落 主:
  # 1. 字典解构：双键匹配 + 绑定
  匹配 {"甲": 1, "乙": 2}:
    情况 {"甲": 值, "乙": 值乙}: 断言相等(值 + 值乙, 3, "1a 字典双键解构求和")
    其他: 断言相等(1, 2, "1b 字典解构不应走默认")

  # 2. 字典数字键解构
  匹配 {1: "一", 2: "二"}:
    情况 {1: 值, 2: 值二}: 断言相等(值 + 值二, "一二", "2a 字典数字键解构")
    其他: 断言相等(1, 2, "2b 数字键不应走默认")

  # 3. 元组解构：多元素
  匹配 (1, 2):
    情况 (甲, 乙): 断言相等(甲 + 乙, 3, "3a 元组双元素解构")
    其他: 断言相等(1, 2, "3b 元组解构不应走默认")

  # 4. 列表解构 + rest（改前死循环挂死，修复核心断言）
  匹配 [1, 2, 3, 4]:
    情况 [首, *余]: 校验rest(首, 余)
    其他: 断言相等(1, 2, "4c rest 不应走默认")

  # 5. 列表完全字面匹配（无 rest）
  匹配 [1, 2, 3]:
    情况 [1, 2, 3]: 断言相等(1, 1, "5a 列表字面模式")
    其他: 断言相等(1, 2, "5b 字面列表不应走默认")

  # 6. 守卫：「若」关键字守卫（捕获 + 条件）
  匹配 85:
    情况 x 若 x >= 90: 断言相等(1, 2, "6a 守卫未命中不应进入")
    情况 y 若 y >= 80: 断言相等(文本(y), "85", "6b 若守卫命中")
    其他: 断言相等(1, 2, "6c 守卫命中后不应走默认")

  # 7. 布尔守卫式：情况 变量 >= 阈值:（纯表达式守卫）
  设 分数 = 92
  匹配 分数:
    情况 分数 >= 95: 断言相等(1, 2, "7a 表达式守卫未命中")
    情况 分数 >= 90: 断言相等(1, 1, "7b 表达式守卫命中 true")
    其他: 断言相等(1, 2, "7c 表达式守卫命中后不应走默认")

  # 8. 布尔守卫式括号形态：情况 (表达式):（tuple 分支回退重解析）
  设 高度 = 188
  匹配 高度:
    情况 (高度 >= 190): 断言相等(1, 2, "8a 括号守卫未命中")
    情况 (高度 >= 185): 断言相等(1, 1, "8b 括号守卫命中 true")
    其他: 断言相等(1, 2, "8c 括号守卫命中后不应走默认")

  # 9. 通配符 `_`（顶层；通配命中即终态，不设默认分支避免 case _ 重复）
  匹配 "任意文本":
    情况 _: 断言相等(1, 1, "9a 顶层通配命中")

  # 10. 类型匹配 + 绑定（原有能力回归）
  匹配 123:
    情况 整数 n: 断言相等(n, 123, "10a 类型匹配绑定")
    其他: 断言相等(1, 2, "10b 类型匹配不应走默认")

  # 11. 嵌套解构：字典套字典 + 列表
  匹配 {"人": {"名": "张三", "年龄": 30}, "标签": ["a", "b"]}:
    情况 {"人": {"名": 名, "年龄": 龄}, "标签": [首, 尾]}: 校验嵌套(名, 龄, 首, 尾)
    其他: 断言相等(1, 2, "11e 嵌套解构不应走默认")

  # 12. 列表元素个数不匹配 → 下一条匹配 / 默认分支
  匹配 [1, 2]:
    情况 [a, b, c]: 断言相等(1, 2, "12a 三元素模式不应命中双元素列表")
    情况 [a, b]: 断言相等(a + b, 3, "12b 双元素模式命中")
    其他: 断言相等(1, 2, "12c 双元素命中后不应走默认")

  # 13. 默认分支（其他）兜底
  匹配 "未知值":
    情况 整数 k: 断言相等(1, 2, "13a 类型不符不应命中")
    其他: 断言相等(1, 1, "13b 默认分支命中 true")

  # 14. 字典部分键不匹配 → 走默认分支
  匹配 {"甲": 1, "乙": 2}:
    情况 {"甲": 值, "丙": 值丙}: 断言相等(1, 2, "14a 缺键模式不应命中")
    其他: 断言相等(1, 1, "14b 缺键走默认 true")

  # 15. 字符串字面模式（原有能力回归）
  匹配 "成功":
    情况 "成功": 断言相等(1, 1, "15a 字符串字面模式")
    其他: 断言相等(1, 2, "15b 字符串模式不应走默认")

  打印 "R73-D 全部断言通过"