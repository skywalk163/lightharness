# test_字符串替换编辑器.light —— 第13轮 任务1（fs 编辑器域）对齐判据
# 运行：LIGHT_MERGE=G:\dswork\duan-light-merge\light-merge python 运行.py examples/test_字符串替换编辑器.light
# 上游：packages/fs/tool-str-replace-editor/src/index.ts（531 行）
#
# 覆盖：解析目标门禁 / 视图行号渲染 / view_range 校验族 / 截断尾注 / 目录 2 层树过滤排序 /
#   create 门禁与已存在拒绝 / str_replace 唯一/未找到/歧义行号/new_str 无/删除替换/花括号文本 /
#   insert 边界 / 命令枚举与必填门禁 / 呈现形状
#
# 反跑判据（改反源码任一期望测试必须红）：
#   A. 渲染视图行 6 位右对齐改 4 位 -> 视图行号断言红
#   B. 替换于文件 多命中歧义条件放宽 -> 歧义抛错断言红
#   C. 插入于文件 行上界放开 -> 超上界抛错断言红

从 字符串替换编辑器 导入 执行编辑命令, 呈现编辑调用, 格式化文件视图, 造目录视图, 收集命中偏移, 偏移行号, 解析目标, 必填参数
从 JSON 导入 序列化JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含(文本, 子串, 标签):
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 断言不含(文本, 子串, 标签):
  如果 查找子串(文本, 子串) >= 0:
    抛出 新建 错误("断言不含失败: " + 标签 + " 文本=" + 转字符串(文本))

# 断言抛错且文案含子串（L-088 绕法：布尔标志；错误对象字符串化即消息）
段落 检查抛错含(标签, 子串, 运算):
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 内存文件系统宿主 ----------
段落 造宿主:
  设 文件表 为 {}  # 抑制L166
  设 目录表 为 {}
  段落 查信息(路径):
    如果 字典包含键(文件表, 路径):
      返回 ["类型": "文件", "版本": 1]
    如果 字典包含键(目录表, 路径):
      返回 ["类型": "目录", "版本": 1]
    返回 空
  段落 读文本(路径):
    返回 字典获取(文件表, 路径, "")
  段落 写文本(路径, 内容):
    设 文件表[路径] 为 内容
    返回 1
  段落 列目录(路径):
    返回 字典获取(目录表, 路径, [])
  返回 ["查信息": 查信息, "读文本": 读文本, "写文本": 写文本, "列目录": 列目录, "文件表": 文件表]

段落 造限宿主(上限值):
  设 宿主 为 造宿主()  # 抑制L166
  宿主["上限"] 为 上限值
  返回 宿主

# 全局宿主
设 宿主 为 造宿主()
设 文件表 为 宿主["文件表"]

# 全局目录树宿主（/repo 两层树）
段落 造树查信息(路径):
  如果 路径 == "/repo":
    返回 ["类型": "目录", "版本": 1]
  如果 字典包含键(文件表, 路径):
    返回 ["类型": "文件", "版本": 1]
  返回 空

设 树表 为 {}
树表["/repo"] 为 [["名": "乙目录", "类型": "目录", "显示路径": "/repo/乙目录"], ["名": ".隐藏", "类型": "文件", "显示路径": "/repo/.隐藏"], ["名": "node_modules", "类型": "目录", "显示路径": "/repo/node_modules"], ["名": "甲.txt", "类型": "文件", "显示路径": "/repo/甲.txt"], ["名": "__pycache__", "类型": "目录", "显示路径": "/repo/__pycache__"]]
树表["/repo/乙目录"] 为 [["名": "深层", "类型": "目录", "显示路径": "/repo/乙目录/深层"], ["名": "内.md", "类型": "文件", "显示路径": "/repo/乙目录/内.md"]]
树表["/repo/乙目录/深层"] 为 [["名": "三层.txt", "类型": "文件", "显示路径": "/repo/乙目录/深层/三层.txt"]]

段落 树列目录(路径):
  返回 字典获取(树表, 路径, [])

设 目录宿主 为 ["查信息": 造树查信息, "读文本": 空, "写文本": 空, "列目录": 树列目录]

# ---------- 抛错场景闭包 ----------
段落 视空路径:
  执行编辑命令(["command": "view", "path": ""], 宿主)

段落 视空白路径:
  执行编辑命令(["command": "view", "path": "   "], 宿主)

段落 视相对路径:
  执行编辑命令(["command": "view", "path": "rel/file.txt"], 宿主)

段落 视不存在:
  执行编辑命令(["command": "view", "path": "/repo/无.txt"], 宿主)

段落 视范围起低:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [0, 2]], 宿主)

段落 视范围起高:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [4, 4]], 宿主)

段落 视范围止高:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [1, 4]], 宿主)

段落 视范围倒序:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [3, 2]], 宿主)

段落 视范围单值:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [1]], 宿主)

段落 视范围浮点:
  执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [1.5, 2]], 宿主)

段落 视目录带范围:
  执行编辑命令(["command": "view", "path": "/repo", "view_range": [1, 2]], 目录宿主)

段落 创已存在:
  执行编辑命令(["command": "create", "path": "/repo/三行.txt", "file_text": "新内容"], 宿主)

段落 创缺文本:
  执行编辑命令(["command": "create", "path": "/repo/另.txt"], 宿主)

段落 创空文本:
  执行编辑命令(["command": "create", "path": "/repo/空.txt", "file_text": ""], 宿主)

段落 创无文本:
  执行编辑命令(["command": "create", "path": "/repo/无值.txt", "file_text": 空], 宿主)

段落 换唯一:
  返回 执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "old_str": "乙", "new_str": "贰"], 宿主)

段落 换未找到:
  执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "old_str": "戊", "new_str": "陆"], 宿主)

段落 换多命中:
  执行编辑命令(["command": "str_replace", "path": "/repo/双乙.txt", "old_str": "乙", "new_str": "贰"], 宿主)

段落 换无新串:
  执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "old_str": "乙", "new_str": 空], 宿主)

段落 换缺旧串:
  执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "new_str": "贰"], 宿主)

段落 换空旧串:
  执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "old_str": "", "new_str": "贰"], 宿主)

段落 换目录:
  执行编辑命令(["command": "str_replace", "path": "/repo", "old_str": "甲", "new_str": "贰"], 目录宿主)

段落 插超上界:
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": 4, "new_str": "零"], 宿主)

段落 插负行:
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": -1, "new_str": "零"], 宿主)

段落 插缺行:
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "new_str": "零"], 宿主)

段落 插缺新串:
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": 0], 宿主)

段落 插目录:
  执行编辑命令(["command": "insert", "path": "/repo", "insert_line": 0, "new_str": "零"], 目录宿主)

段落 未知命令:
  执行编辑命令(["command": "删库", "path": "/repo/三行.txt"], 宿主)

段落 缺路径:
  执行编辑命令(["command": "view"], 宿主)

段落 目标空串:
  解析目标("")

段落 目标相对:
  解析目标("rel.txt")

段落 必填缺省:
  必填参数(空, "file_text", "create", 真)

段落 必填空串:
  必填参数("", "old_str", "str_replace", 假)

# ---------- 主流程 ----------
段落 主:
  # ============ 0) 命中收集与行号（纯函数直测） ============
  断言相等(收集命中偏移("甲乙甲乙", "甲"), [0, 2], "命中偏移两处")
  断言相等(收集命中偏移("甲乙", "丙"), [], "无命中空表")
  断言相等(收集命中偏移("aaa", "aa"), [0], "重叠命中不重计")
  断言相等(偏移行号("甲\n乙\n丙", [0, 3]), [1, 2], "偏移行号")
  断言相等(偏移行号("甲\n乙", [3]), [2], "末偏移行号")

  # ============ 1) 解析目标门禁 ============
  检查抛错含("空路径应抛", "路径必须为非空字符串", 视空路径)
  检查抛错含("空白路径应抛", "路径必须为非空字符串", 视空白路径)
  检查抛错含("相对路径应抛", "不是绝对路径", 视相对路径)
  检查抛错含("相对路径建议", "是不是想写 /rel/file.txt？", 视相对路径)
  检查抛错含("目标空串", "路径必须为非空字符串", 目标空串)
  检查抛错含("目标相对", "应以 / 开头", 目标相对)
  断言相等(解析目标("/repo/a"), "/repo/a", "绝对路径原样")

  # ============ 2) 视图行号渲染 ============
  设 文件表["/repo/三行.txt"] 为 "甲\n乙\n丙"
  设 视图 为 执行编辑命令(["command": "view", "path": "/repo/三行.txt"], 宿主)
  断言含(视图, "这里有 3 行", "总行数提示")
  断言含(视图, "     1  甲", "行号 6 位右对齐 行1")
  断言含(视图, "     2  乙", "行号 行2")
  断言含(视图, "     3  丙", "行号 行3")
  断言真(查找子串(视图, "1  甲") > 查找子串(视图, "这里是"), "头部先行号")

  # ============ 3) view_range 区间与校验族 ============
  设 区间视图 为 执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [2, 3]], 宿主)
  断言含(区间视图, "视图范围=[2, 3]", "区间头提示")
  断言含(区间视图, "     2  乙", "区间含行2")
  断言含(区间视图, "     3  丙", "区间含行3")
  断言不含(区间视图, "  甲", "区间不含行1")
  设 到尾视图 为 执行编辑命令(["command": "view", "path": "/repo/三行.txt", "view_range": [2, -1]], 宿主)
  断言含(到尾视图, "视图范围=[2, -1]", "到尾头提示")
  断言含(到尾视图, "     2  乙", "到尾含行2")
  断言含(到尾视图, "     3  丙", "到尾含行3")
  检查抛错含("起低于 1 应抛", "第一个元素 0 应在文件行范围内: [1, 3]", 视范围起低)
  检查抛错含("起超总行应抛", "第一个元素 4 应在文件行范围内: [1, 3]", 视范围起高)
  检查抛错含("止超总行应抛", "第二个元素 4 应小于文件行数: 3", 视范围止高)
  检查抛错含("止小于起应抛", "第二个元素 2 应大于等于其第一个元素 3", 视范围倒序)
  检查抛错含("单元素应抛", "应为两个整数组成的列表", 视范围单值)
  检查抛错含("浮点应抛", "应为两个整数组成的列表", 视范围浮点)

  # ============ 4) 截断尾注 ============
  设 限视图 为 格式化文件视图("/repo/长.txt", "0123456789ABCDEF", 40, 空)
  断言相等(限视图, 截取(限视图, 0, 40) + "<response clipped><NOTE>To save on context only part of this file has been shown to you. You should retry this tool after you have searched inside the file with grep -n in order to find the line numbers of what you are looking for.</NOTE>", "截断输出=前缀+尾注")
  断言相等(字符串长度(限视图), 40 + 字符串长度("<response clipped><NOTE>To save on context only part of this file has been shown to you. You should retry this tool after you have searched inside the file with grep -n in order to find the line numbers of what you are looking for.</NOTE>"), "截断长度=上限+尾注")
  断言含(限视图, "<response clipped>", "截断尾注头")
  断言含(限视图, "这是 /repo/长.txt", "截断保留头部前缀")
  断言不含(限视图, "ABCDEF\n", "截断丢弃超限渲染行")
  设 不限视图 为 格式化文件视图("/repo/长.txt", "0123456789ABCDEF", 16000, 空)
  断言不含(不限视图, "<response clipped>", "未超限不截断")
  断言含(不限视图, "     1  0123456789ABCDEF", "未截断含完整渲染行")

  # ============ 5) 目录 2 层树：过滤与排序 ============
  设 目录视图 为 执行编辑命令(["command": "view", "path": "/repo"], 目录宿主)
  断言含(目录视图, "Here're the files and directories up to 2 levels deep in /repo", "目录头部提示")
  断言含(目录视图, "d\t/repo", "根目录行")
  断言含(目录视图, "d\t/repo/乙目录", "子目录行")
  断言含(目录视图, "f\t/repo/甲.txt", "子文件行")
  断言含(目录视图, "f\t/repo/乙目录/内.md", "二层文件行")
  断言含(目录视图, "d\t/repo/乙目录/深层", "二层目录行")
  断言不含(目录视图, "三层.txt", "三层不下钻")
  断言不含(目录视图, ".隐藏", "隐藏条目过滤")
  断言不含(目录视图, "\tnode_modules", "node_modules 过滤")
  断言不含(目录视图, "\t__pycache__", "__pycache__ 过滤")
  # 排序：乙(0x4E59) < 内(0x5185) < 深(0x6DF1) < 甲(0x7532)，前缀短者在先
  设 序乙 为 查找子串(目录视图, "/repo/乙目录\n")
  设 序乙内 为 查找子串(目录视图, "/repo/乙目录/内.md")
  设 序乙深 为 查找子串(目录视图, "/repo/乙目录/深层")
  设 序甲 为 查找子串(目录视图, "/repo/甲.txt")
  断言真(序乙 >= 0, "乙目录行存在")
  断言真(序乙内 > 序乙, "排序 乙目录 < 乙目录/内.md")
  断言真(序乙深 > 序乙内, "排序 内.md < 深层")
  断言真(序甲 > 序乙深, "排序 深层 < 甲.txt")
  # 目录 + view_range 拒绝
  检查抛错含("目录带范围应抛", "不允许使用 view_range", 视目录带范围)

  # ============ 6) create 门禁 ============
  设 创结果 为 执行编辑命令(["command": "create", "path": "/repo/新.txt", "file_text": "正文"], 宿主)
  断言相等(创结果, "新文件创建成功: /repo/新.txt", "create 成功文案")
  断言相等(字典获取(文件表, "/repo/新.txt", ""), "正文", "create 落盘内容")
  检查抛错含("create 已存在应抛", "文件已存在: /repo/三行.txt。create 不能覆盖", 创已存在)
  检查抛错含("create 缺 file_text 应抛", "参数 file_text 是 create 命令必填", 创缺文本)
  检查抛错含("create 无(null) file_text 应抛", "参数 file_text 是 create 命令必填", 创无文本)
  创空文本()
  断言相等(字典获取(文件表, "/repo/空.txt", "X"), "", "create 空文件合法")

  # ============ 7) str_replace ============
  设 换结果 为 换唯一()
  断言相等(换结果, "文件 /repo/三行.txt 已编辑成功", "str_replace 成功文案")
  断言相等(字典获取(文件表, "/repo/三行.txt", ""), "甲\n贰\n丙", "str_replace 内容替换")
  检查抛错含("未找到应抛", "未执行替换，old_str 未在 /repo/三行.txt 中原样出现", 换未找到)
  设 文件表["/repo/双乙.txt"] 为 "甲乙\n丙乙"
  检查抛错含("多命中应抛", "未执行替换，old_str 在行 [1, 2] 出现多次，请确保唯一", 换多命中)
  断言相等(字典获取(文件表, "/repo/双乙.txt", ""), "甲乙\n丙乙", "多命中不落盘")
  检查抛错含("new_str 为 无 应抛", "参数 new_str 必须省略或为字符串", 换无新串)
  检查抛错含("old_str 缺省应抛", "参数 old_str 是 str_replace 命令必填", 换缺旧串)
  检查抛错含("old_str 空串应抛", "参数 old_str 是 str_replace 命令为空", 换空旧串)
  检查抛错含("目录上替换应抛", "是目录，只有 view 命令可用于目录", 换目录)
  # 省略 new_str（键不存在）= 删除替换（上游 undefined -> 空串）
  执行编辑命令(["command": "str_replace", "path": "/repo/三行.txt", "old_str": "贰"], 宿主)
  断言相等(字典获取(文件表, "/repo/三行.txt", ""), "甲\n\n丙", "省略 new_str 为删除替换")
  # 花括号文本安全（L-089 绕法：序列化JSON 构造）
  设 花文本 为 序列化JSON(["名": "旧值", "单": 1])
  设 文件表["/repo/花.txt"] 为 花文本
  执行编辑命令(["command": "str_replace", "path": "/repo/花.txt", "old_str": "旧值", "new_str": "新值"], 宿主)
  断言相等(字典获取(文件表, "/repo/花.txt", ""), 序列化JSON(["名": "新值", "单": 1]), "花括号文本替换")
  检查抛错含("不存在路径替换应抛", "不存在，请提供有效路径", 视不存在)

  # ============ 8) insert 边界 ============
  设 文件表["/repo/三行.txt"] 为 "甲\n乙\n丙"
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": 0, "new_str": "零"], 宿主)
  断言相等(字典获取(文件表, "/repo/三行.txt", ""), "零\n甲\n乙\n丙", "insert 0 头插")
  设 文件表["/repo/三行.txt"] 为 "甲\n乙\n丙"
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": 3, "new_str": "丁"], 宿主)
  断言相等(字典获取(文件表, "/repo/三行.txt", ""), "甲\n乙\n丙\n丁", "insert 等于总行数尾插")
  设 文件表["/repo/三行.txt"] 为 "甲\n乙\n丙"
  执行编辑命令(["command": "insert", "path": "/repo/三行.txt", "insert_line": 1, "new_str": "一甲\n一乙"], 宿主)
  断言相等(字典获取(文件表, "/repo/三行.txt", ""), "甲\n一甲\n一乙\n乙\n丙", "insert 多行插入")
  设 文件表["/repo/三行.txt"] 为 "甲\n乙\n丙"
  检查抛错含("超上界应抛", "insert_line 参数无效: 4。应在文件行范围内: [0, 3]", 插超上界)
  检查抛错含("负行应抛", "insert_line 参数无效: -1。应在文件行范围内: [0, 3]", 插负行)
  检查抛错含("insert_line 缺省应抛", "参数 insert_line 是 insert 命令必填", 插缺行)
  检查抛错含("insert new_str 缺省应抛", "参数 new_str 是 insert 命令必填", 插缺新串)
  检查抛错含("目录上插入应抛", "是目录，只有 view 命令可用于目录", 插目录)

  # ============ 9) 命令枚举与必填门禁 ============
  检查抛错含("未知命令应抛", "未知命令: 删库。允许: view, create, str_replace, insert", 未知命令)
  检查抛错含("缺 path 应抛", "参数 path 必填", 缺路径)
  检查抛错含("必填参数缺省应抛", "参数 file_text 是 create 命令必填", 必填缺省)
  检查抛错含("必填参数空串应抛", "参数 old_str 是 str_replace 命令为空", 必填空串)

  # ============ 10) 命令呈现形状 ============
  设 形甲 为 呈现编辑调用(["command": "view", "path": "/repo/a.txt"])
  断言相等(形甲["卡片"], "generic", "view 卡片")
  断言相等(形甲["标题"], "view /repo/a.txt", "view 标题")
  断言相等(形甲["种类"], "read", "view 种类")
  断言相等(形甲["位置"], [["路径": "/repo/a.txt"]], "view 位置")
  设 形乙 为 呈现编辑调用(["command": "create", "path": "/repo/b.txt", "file_text": "内容"])
  断言相等(形乙["卡片"], "diff", "create 卡片")
  断言相等(形乙["差异"], [["路径": "/repo/b.txt", "旧文本": 空, "新文本": "内容"]], "create 差异")
  设 形丙 为 呈现编辑调用(["command": "str_replace", "path": "/repo/c.txt", "old_str": "旧", "new_str": "新"])
  断言相等(形丙["卡片"], "diff", "str_replace 卡片")
  断言相等(形丙["差异"], [["路径": "/repo/c.txt", "旧文本": "旧", "新文本": "新"]], "str_replace 差异")
  设 形丁 为 呈现编辑调用(["command": "insert", "path": "/repo/d.txt", "insert_line": 0, "new_str": "x"])
  断言相等(形丁["卡片"], "generic", "insert 卡片")
  断言相等(形丁["种类"], "edit", "insert 种类")
  断言相等(形丁["位置"], [["路径": "/repo/d.txt", "行": 1]], "insert 行号 max(1, il+1)")
  设 形戊 为 呈现编辑调用(["command": "insert", "path": "/repo/d.txt", "new_str": "x"])
  断言相等(形戊["位置"], [["路径": "/repo/d.txt"]], "insert 无行号位置")

  打印("test_字符串替换编辑器 PASS")

主()
