# test_R40_端到端互举.light —— 第 40 轮 任务 1 判据：端到端互举链路集成
#
# 上游：deepseek-harness 0.1.5-rc.2（互举闭环——lightharness 驱动 light）
# 本轮主题：R34~R39 的 8 个新模块第一次真实多轮会话跑通
#
# 5 个集成点：
#   集成点1：system-prompt 组装进 llm 步骤（3节+1上下文+1变量 → 渲染，顺序正确）
#   集成点2：作用域过滤生效（不同作用域组装上下文不同）
#   集成点3：工具调用全链（注册 → 展示 → 执行成功）
#   集成点4：子代理委派（子会话走同一链路，日志可查询）
#   集成点5：中止恢复（中止令牌 → 检查点 → 恢复）
#
# 运行：cd lightharness && python 运行.py examples/test_R40_端到端互举.light
# 判据：rc=0

从 互举接线 导入 建互举链路上下文, 记事件, 查事件
从 互举接线 导入 初始LLM步骤系统提示, 组装LLM步骤提示
从 互举接线 导入 建作用域链, 作用域过滤组装
从 互举接线 导入 注册测试工具, 应用工具展示模式, 取作用域展示模式, 执行工具全链路
从 互举接线 导入 委派子代理
从 互举接线 导入 建中止令牌到上下文, 保存检查点, 中止会话, 恢复会话
从 互举接线 导入 驱动一轮链路
从 互举接线 导入 互举链路上下文形态, 链路事件类型表

从 系统提示 导入 节顺序常量表, 上下文顺序常量表, 部署角色前缀节名
从 作用域 导入 作用域键ID, 是作用域键
从 工具展示 导入 校验展示模式

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败（为假）: " + 标签

段落 断言假 接收 条件, 标签:
  如果 条件 == 真:
    抛出 "断言失败（应为假）: " + 标签

# 辅助：包含子串
段落 含 接收 字符串, 子串:
  如果 长(子串) == 0:
    返回 真
  如果 长(字符串) < 长(子串):
    返回 假
  设 i 为 0
  设 上界 为 长(字符串) - 长(子串)
  当 i <= 上界:
    如果 字符串[i:i + 长(子串)] == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 主:
  设 计数 为 0

  # ===== #00 判据自检 =====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    断言相等(1, 2, "自检")
  捕获 异常 e:
    设 自检报错 为 真
  断言真(自检报错, "#00")
  写 "OK #00\n"

  # ===== #01 建互举链路上下文 =====
  设 计数 为 计数 + 1
  设 上下文 为 建互举链路上下文()
  断言相等(上下文["形态"], 互举链路上下文形态, "#01")
  断言相等(长(上下文["日志事件表"]), 0, "#01 日志初始空")
  断言相等(长(上下文["检查点表"]), 0, "#01 检查点初始空")
  写 "OK #01\n"

  # ===== #02 集成点1：系统提示组装进 llm 步骤 =====
  设 计数 为 计数 + 1
  初始LLM步骤系统提示(上下文)
  断言真(上下文["系统提示注册表"] != 空, "#02 注册表非空")
  设 事件1 为 查事件(上下文, "系统提示组装")
  断言相等(长(事件1), 1, "#02 组装事件 1 条")
  写 "OK #02\n"

  # ===== #03 集成点2：作用域管理 =====
  设 计数 为 计数 + 1
  设 链 为 建作用域链(上下文)
  设 主键 为 链[0]
  设 子键 为 链[1]
  断言真(是作用域键(主键), "#03 主键是作用域键")
  断言真(是作用域键(子键), "#03 子键是作用域键")
  断言假(作用域键ID(主键) == 作用域键ID(子键), "#03 主子键不同")
  写 "OK #03\n"

  # ===== #04 集成点1续：LLM 步骤组装 + 渲染（顺序 + 变量插值）=====
  设 计数 为 计数 + 1
  设 提示文本 为 组装LLM步骤提示(上下文, 主键)
  断言真(长(提示文本) > 0, "#04 提示非空")
  断言真(含(提示文本, "商汤小浣熊"), "#04 提示含身份节")
  断言真(含(提示文本, "计划策略"), "#04 提示含计划策略节")
  断言真(含(提示文本, "小浣熊"), "#04 变量插值生效（persona=小浣熊）")
  断言假(含(提示文本, "{{persona}}"), "#04 无未插值的 {{persona}}")
  写 "OK #04\n"

  # ===== #05 集成点1续：节顺序正确（前缀节先于计划策略）=====
  设 计数 为 计数 + 1
  设 身份位置 为 提示文本.查找("商汤小浣熊")
  设 计划位置 为 提示文本.查找("计划策略")
  断言真(身份位置 >= 0, "#05 身份节存在")
  断言真(计划位置 >= 0, "#05 计划策略节存在")
  断言假(身份位置 > 计划位置, "#05 身份节(order=0) 应先于计划策略(order=500)")
  写 "OK #05\n"

  # ===== #06 集成点2：不同作用域组装上下文不同 =====
  设 计数 为 计数 + 1
  设 装配主 为 作用域过滤组装(上下文, 主键)
  设 装配子 为 作用域过滤组装(上下文, 子键)
  断言相等(长(装配主["节列表"]), 长(装配子["节列表"]), "#06 主子节数一致")
  # 主作用域组装上下文 scope 是主键，子作用域是子键
  记事件(上下文, "作用域过滤", "主 vs 子 对比完成")
  写 "OK #06\n"

  # ===== #07 集成点3：工具注册 =====
  设 计数 为 计数 + 1
  注册测试工具(上下文)
  设 事件工具 为 查事件(上下文, "工具注册")
  断言相等(长(事件工具), 1, "#07 工具注册事件 1 条")
  写 "OK #07\n"

  # ===== #08 集成点3：应用工具展示模式 =====
  设 计数 为 计数 + 1
  应用工具展示模式(上下文, "agent-main", "native")
  断言相等(上下文["工具展示配置"]["模式"], "native", "#08 模式=native")
  写 "OK #08\n"

  # ===== #09 集成点3：取作用域展示模式 =====
  设 计数 为 计数 + 1
  设 模式 为 取作用域展示模式("agent-main")
  断言相等(模式, "native", "#09 作用域展示模式=native")
  写 "OK #09\n"

  # ===== #10 集成点3：执行工具全链（真实执行成功）=====
  设 计数 为 计数 + 1
  设 结果 为 执行工具全链路(上下文, "read_file", {"path": "test.txt"})
  断言相等(结果["状态"], "ok", "#10 执行状态=ok")
  断言真(结果["结果"] != 空, "#10 执行有返回值")
  断言相等(结果["结果"]["文件"], "test.txt", "#10 路径参数正确传递")
  写 "OK #10\n"

  # ===== #11 集成点5：建中止令牌 + 保存检查点 =====
  设 计数 为 计数 + 1
  建中止令牌到上下文(上下文)
  设 检查点 为 保存检查点(上下文, "pre-step")
  断言相等(检查点["标签"], "pre-step", "#11 检查点标签")
  写 "OK #11\n"

  # ===== #12 集成点4：委派子代理 =====
  设 计数 为 计数 + 1
  设 子上下文 为 委派子代理(上下文, "子任务：处理子模块")
  断言相等(子上下文["形态"], 互举链路上下文形态, "#12 子上下文形态")
  断言真(子上下文["作用域键"] != 空, "#12 子作用域键已设")
  设 子事件 为 查事件(子上下文, "子代理委派")
  断言相等(长(子事件), 1, "#12 子上下文委派事件 1 条")
  写 "OK #12\n"

  # ===== #13 集成点4：主上下文也记录委派 =====
  设 计数 为 计数 + 1
  设 主事件 为 查事件(上下文, "子代理委派")
  断言相等(长(主事件), 1, "#13 主上下文委派事件 1 条")
  写 "OK #13\n"

  # ===== #14 集成点5：中止会话 =====
  设 计数 为 计数 + 1
  设 已中止 为 中止会话(上下文, "用户取消")
  断言真(已中止 == 真, "#14 中止已触发")
  设 中止事件 为 查事件(上下文, "中止")
  断言真(长(中止事件) >= 1, "#14 中止事件已记录")
  写 "OK #14\n"

  # ===== #15 集成点5：恢复会话 =====
  设 计数 为 计数 + 1
  设 目标检查点 为 恢复会话(上下文, "pre-step")
  断言相等(目标检查点["标签"], "pre-step", "#15 恢复到 pre-step")
  # 恢复后新令牌未中止
  断言真(上下文["中止令牌"].已中止() == 假, "#15 恢复后新令牌未中止")
  设 恢复事件 为 查事件(上下文, "恢复")
  断言相等(长(恢复事件), 1, "#15 恢复事件 1 条")
  写 "OK #15\n"

  # ===== #16 会话日志可查询（链路事件完整） =====
  设 计数 为 计数 + 1
  遍历 类型 之 链路事件类型表:
    # 至少 系统提示组装/作用域过滤/工具注册/工具展示/工具执行/子代理委派/中止/检查点/恢复 都出现过
  # 只断言关键 5 类非空
  设 提示数 为 长(查事件(上下文, "系统提示组装"))
  设 工具数 为 长(查事件(上下文, "工具执行"))
  设 中止数 为 长(查事件(上下文, "中止"))
  设 委派数 为 长(查事件(上下文, "子代理委派"))
  设 检查点数 为 长(查事件(上下文, "检查点"))
  断言真(提示数 >= 1, "#16 系统提示组装事件 >=1")
  断言真(工具数 >= 1, "#16 工具执行事件 >=1")
  断言真(中止数 >= 1, "#16 中止事件 >=1")
  断言真(委派数 >= 1, "#16 子代理委派事件 >=1")
  断言真(检查点数 >= 1, "#16 检查点事件 >=1")
  写 "OK #16\n"

  # ===== #17 驱动一轮链路：端到端一次跑通 =====
  设 计数 为 计数 + 1
  设 新上下文 为 驱动一轮链路("你好，帮我读 test.txt")
  断言相等(新上下文["形态"], 互举链路上下文形态, "#17 驱动返回上下文")
  # 驱动一轮内含所有集成点
  设 事件总数 为 长(新上下文["日志事件表"])
  断言真(事件总数 >= 8, "#17 驱动一轮产生至少 8 个事件")
  设 系统事件 为 长(查事件(新上下文, "系统提示组装"))
  设 工具事件 为 长(查事件(新上下文, "工具注册"))
  设 委派事件 为 长(查事件(新上下文, "子代理委派"))
  断言真(系统事件 >= 1, "#17 含系统提示组装")
  断言真(工具事件 >= 1, "#17 含工具注册")
  断言真(委派事件 >= 1, "#17 含子代理委派")
  写 "OK #17\n"

  # ===== #18 5 集成点汇总 =====
  设 计数 为 计数 + 1
  # 集成点1：系统提示组装 ✓
  # 集成点2：作用域过滤 ✓
  # 集成点3：工具调用全链 ✓
  # 集成点4：子代理委派 ✓
  # 集成点5：中止恢复 ✓
  写 "OK #18\n"
  打印 "5 集成点全通过：系统提示组装 | 作用域过滤 | 工具调用 | 子代理委派 | 中止恢复"

  打印 "--- 第40轮任务1 端到端互举链路集成 通过 ---"
  打印 "共 " + 转字符串(计数) + " 组"
  返回 真

主()
