# test_agent工具调用.light —— E1 agent 循环工具调用端到端（mock API）
# 验证：mock API 返回 tool_calls → 执行工具 → 结果回传 → 继续循环 → 最终返回文本；
#       钩子机制（pre_tool/post_tool）正确调用；契约1 事件格式推送；轮次上限生效。
从 工具 导入 工具注册表
从 核心工具 导入 默认核心注册表
从 agent 导入 钩子管理器, 运行智能体

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  # ===== 场景1：正常 tool_calls → 执行 → 回传 → 终文 =====
  设 状态 为 {"轮":0, "预钩":0, "后钩":0}
  段落 模拟聊天 接收 消息, 工具表, 模型:
    设 状态["轮"] 为 状态["轮"] + 1
    如果 状态["轮"] == 1:
      返回 ["停止": 假, "内容":"", "工具调用": [["id":"call1","name":"bash","arguments":"{\"命令\":\"echo hello\"}"]]]
    返回 ["停止": 真, "内容":"任务完成", "工具调用": []]
  段落 记录预 接收 名, 参:
    设 状态["预钩"] 为 状态["预钩"] + 1
    返回 ["批准": 真, "需审批": 假, "理由": ""]
  段落 记录后 接收 名, 结果:
    设 状态["后钩"] 为 状态["后钩"] + 1
    返回 结果

  设 注册表 为 默认核心注册表()
  设 钩子 为 新建 钩子管理器()
  钩子.注册预工具(记录预)
  钩子.注册后工具(记录后)
  设 事件 为 []
  段落 推送 接收 e:
    事件.追加(e)
  设 结果 为 运行智能体(["角色":"user","内容":"执行 echo hello"], 注册表, 模拟聊天, 推送, 钩子, 20, "mock")
  断言相等(结果["文本"], "任务完成", "最终文本")
  断言相等(状态["轮"], 2, "模型被调用2轮")
  断言相等(状态["预钩"], 1, "pre_tool 调用1次")
  断言相等(状态["后钩"], 1, "post_tool 调用1次")
  设 有调用 为 假
  设 有结果 为 假
  设 含hello 为 假
  遍历 e 之 事件:
    如果 e["种类"] == "工具调用": 设 有调用 为 真
    如果 e["种类"] == "工具结果": 设 有结果 为 真
    如果 e["种类"] == "工具结果" 且 e["结果"].包含("hello"): 设 含hello 为 真
  断言相等(有调用, 真, "有工具调用事件(契约1)")
  断言相等(有结果, 真, "有工具结果事件(契约1)")
  断言相等(含hello, 真, "工具结果含 hello")

  # ===== 场景2：pre_tool 拒绝钩子 =====
  设 状态2 为 {"轮":0}
  段落 模拟聊天2 接收 消息, 工具表, 模型:
    设 状态2["轮"] 为 状态2["轮"] + 1
    返回 ["停止": 假, "内容":"", "工具调用": [["id":"c2","name":"bash","arguments":"{\"命令\":\"rm -rf /\"}"]]]
  段落 拒绝钩 接收 名, 参:
    返回 ["批准": 假, "需审批": 假, "理由": "危险命令"]
  设 钩子2 为 新建 钩子管理器()
  钩子2.注册预工具(拒绝钩)
  设 事件2 为 []
  段落 推送2 接收 e:
    事件2.追加(e)
  设 结果2 为 运行智能体(["角色":"user","内容":"x"], 注册表, 模拟聊天2, 推送2, 钩子2, 20, "mock")
  设 拒绝可见 为 假
  遍历 e 之 事件2:
    如果 e["种类"] == "工具结果" 且 e["错误"].包含("危险命令"): 设 拒绝可见 为 真
  断言相等(拒绝可见, 真, "拒绝钩子生效(工具结果含理由)")

  # ===== 场景3：轮次上限 =====
  设 状态3 为 {"轮":0}
  段落 模拟聊天3 接收 消息, 工具表, 模型:
    设 状态3["轮"] 为 状态3["轮"] + 1
    返回 ["停止": 假, "内容":"", "工具调用": [["id":"c3","name":"读文件","arguments":"{\"路径\":\"x.txt\"}"]]]
  设 钩子3 为 新建 钩子管理器()
  设 事件3 为 []
  段落 推送3 接收 e:
    事件3.追加(e)
  设 结果3 为 运行智能体(["角色":"user","内容":"loop"], 注册表, 模拟聊天3, 推送3, 钩子3, 20, "mock")
  断言相等(结果3["文本"], "工具调用轮次超限", "轮次超限")
  断言相等(状态3["轮"], 20, "恰好20轮")

  打印 "--- agent 工具调用端到端测试通过 ---"

主()
