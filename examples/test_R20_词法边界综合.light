    断言相等(捕获块(38), 39, "捕获块 调用")
    断言相等(抛出异常(39), 40, "抛出异常 调用")
    断言相等(打印函数(40), 41, "打印函数 调用")
    断言相等(新建对象(41), 42, "新建对象 调用")
    断言相等(返回值(42), 43, "返回值 调用")
    断言相等(设值器(43), 44, "设值器 调用")
