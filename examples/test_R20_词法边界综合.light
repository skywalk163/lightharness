    断言相等(类型别名表(56), 57, "类型别名表 调用")
    断言相等(标准库函数表(57), 58, "标准库函数表 调用")

    打印 "---- 二、合法关键字语句 ----"
    如果 1 == 1:
        断言真(真, "如果语句")
    如果 1 == 2:
        断言真(假, "不可达")
    否则:
        断言真(真, "否则语句")
    如果 1 == 2:
        断言真(假, "不可达二")
    否则若 2 == 2:
        断言真(真, "否则若语句")
    遍历 键 之 [7, 8, 9]:
        断言真(键 > 0, "遍历之语句")
    遍历 键 之 [1, 2]:
        断言真(键 > 0, "遍历语句二")
    设 计数 为 0
    当 计数 < 3:
        设 计数 为 计数 + 1
    断言相等(计数, 3, "当循环退出")
    尝试:
        抛出 新建 错误("探测")
    捕获 异常 为 异常甲:
        断言真(转字符串(异常甲) != "", "捕获语句")
    尝试:
        断言真(真, "尝试直行")
    捕获 异常 为 异常乙:
        断言真(假, "不可达三")
    最终:
        断言真(真, "最终语句")
    设 甲 为 真
    设 乙 为 假
    设 丙 为 空
    断言真(甲 == 真, "设为真")
    断言真(乙 == 假, "设为假")
    断言真(丙 == 空, "设为空")
    段落 返回真():
        返回 真
    断言真(返回真(), "返回真语句")
    段落 返回假():
        返回 假
    断言真(返回假() == 假, "返回假语句")
    段落 返回空():
        返回 空
    断言真(返回空() == 空, "返回空语句")
    设 去重结果 为 去重([1, 1, 2])
    断言相等(列表长度(去重结果), 2, "去重语句")
    设 排序结果 为 排序([3, 1, 2])
    断言相等(排序结果[0], 1, "排序语句")
    设 求和结果 为 求和([1, 2, 3])
    断言相等(求和结果, 6, "求和语句")
    设 最大结果 为 求最大([1, 3, 2])
    断言相等(最大结果, 3, "求最大语句")
    设 匹配结果 为 查找("[0-9]+", "abc123")
    断言真(匹配结果 != 空, "匹配调用")
    设 管道结果 为 管道(5, [恒真])
    断言真(管道结果 == 真, "管道语句")

    打印 "---- 三、边界混合 ----"
    断言真(等于判断(1) == 2, "混合01 关键字前缀名作实参")
    设 混合表 为 {"去重占位": 去重占位, "作用域匹配": 作用域匹配}
    断言真(混合表["去重占位"](1) == 2, "混合02 字典值取函数再调用")
    设 混合列表 为 [排序函数, 筛选器]
    断言真(列表长度(混合列表) == 2, "混合03 列表元素存函数")
    断言相等(去重占位(排序函数(4)), 6, "混合04 嵌套调用")
    设 邻甲 为 1
    如果 大于判断(邻甲) == 2:
        断言真(真, "混合05 与如果语句相邻")
    设 递增结果 为 管道(1, [加上操作, 加上操作])
    断言相等(递增结果, 3, "混合06 管道串关键字前缀名")
    断言真(乘以操作(乘以操作(2)) > 0, "混合07 叠加调用")
    设 混合字典 为 {"捕获块": 捕获块, "尝试块": 尝试块, "普通": 1}
    断言相等(混合字典["尝试块"](5), 6, "混合08 字典多键混用")
    遍历 处理器 之 [读取器, 输出流]:
        断言真(处理器(1) > 0, "混合09 遍历调用关键字前缀名")
    尝试:
        断言真(调试器(1) == 2, "混合10 尝试体内调用")
    捕获 异常 为 混合异常:
        抛出 新建 错误("混合10 不应进入捕获")
    断言真(恒真(作用域匹配(1)), "混合11 关键字前缀名作高阶实参")
    # 注：嵌套段落（段落体内定义段落）的形参名不被 `_scan_user_definitions` 预扫描覆盖，
    # 故此处形参用非关键字前缀名 `算子`；关键字前缀名作形参的模块级形态由 test_R20_关键字前缀标识符.light 覆盖。
    段落 内层返回(算子):
        返回 算子(9)
    断言相等(内层返回(小于判断), 10, "混合12 函数值作参数")
    断言真(求最大值(1) > 0, "混合13 求最大前缀")
    断言真(构造器(1) > 0, "混合14 构造前缀")
    断言真(抽象类(1) > 0, "混合15 抽象前缀")
    断言真(静态方法表(1) > 0, "混合16 静态方法前缀")
    断言真(退出循环标记(1) > 0, "混合17 退出循环前缀")
    断言真(否则若分支(1) > 0, "混合18 否则若前缀")
    断言真(标准库函数表(1) > 0, "混合19 标准库前缀")
    断言真(类型别名表(1) > 0, "混合20 类型别名前缀")
    断言真(外部函数(1) > 0, "混合21 外部前缀")
    断言真(等待器(1) > 0, "混合22 等待前缀")

    打印 "test_R20_词法边界综合 PASS"

主()
