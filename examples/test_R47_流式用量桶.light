# test_R47_流式用量桶.light —— 第47轮 任务1（#5/#6 流式用量分桶 + TokenUsage 桶转换）
#
# 运行：cd lightharness && python 运行.py examples/test_R47_流式用量桶.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 覆盖（纯逻辑面，不动 R43 已接真的传输层）：
#   - 造用量 五桶形状：输入/输出/缓存读/缓存写/推理（缓存写为 R47 新增桶）
#   - 用量累计：多个用量字典按桶累加；缓存读/缓存写/推理独立累计不混桶
#   - 缺桶归零（用量桶值）与 计费输入 = 输入+缓存读+缓存写（上游 types.ts 口径）
#   - 客户端.翻译用量：wire usage → 内部分桶
#     · prompt_cache_hit_tokens 与 prompt_tokens_details.cached_tokens 双路缓存读
#     · prompt_cache_miss_tokens → 缓存写（R47 新增）
#     · reasoning_tokens → 推理；totalTokens = prompt+completion（上游 mapUsage 口径）
#   - StreamChunk usage 块经块组装器保真（组装器.用量() 返回完整分桶字典）
#
# 铁律：零修改真实HTTP/SSE传输层（R43已接真），只补词汇/累计纯逻辑。

从 流 导入 造用量, 用量累计, 用量桶值, 计费输入, 造用量块, 块组装器
从 客户端 导入 翻译用量

段落 断言相等(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")

段落 主:
  # ============ 1) 造用量 五桶形状（缓存写为新增桶） ============
  设 甲 为 造用量(10, 5)
  断言相等(甲["输入"], 10, "造用量_输入")
  断言相等(甲["输出"], 5, "造用量_输出")
  断言真(甲.包含("缓存读") == 假, "造用量_缺省不带缓存读桶")

  设 乙 为 造用量(10, 5, 3, 2, 4)
  断言相等(乙["缓存读"], 3, "造用量_缓存读桶")
  断言相等(乙["推理"], 2, "造用量_推理桶")
  断言相等(乙["缓存写"], 4, "造用量_缓存写桶（R47新增）")

  # 四参位置调用兼容（既有 客户端.翻译用量 的调用形态不破）
  设 丙 为 造用量(7, 8, 1, 9)
  断言相等(丙["推理"], 9, "造用量_四参位置兼容_推理")
  断言真(丙.包含("缓存写") == 假, "造用量_四参位置兼容_无缓存写")

  # ============ 2) 多块累计：分桶独立累计不混桶 ============
  # 模拟一次多 chunk 流：三段增量各带部分桶
  设 段1 为 ["输入": 100, "输出": 20, "缓存读": 30, "推理": 5]
  设 段2 为 ["输入": 50, "输出": 10, "缓存写": 8]
  设 段3 为 ["输入": 70, "输出": 30, "缓存读": 20, "推理": 7, "totalTokens": 200]
  设 合 为 用量累计([段1, 段2, 段3])
  断言相等(合["输入"], 220, "累计_输入合计")
  断言相等(合["输出"], 60, "累计_输出合计")
  断言相等(合["缓存读"], 50, "累计_缓存读独立累计(30+20)")
  断言相等(合["缓存写"], 8, "累计_缓存写独立累计(仅段2)")
  断言相等(合["推理"], 12, "累计_推理独立累计(5+7)")
  断言相等(合["totalTokens"], 200, "累计_totalTokens任一带即累计")
  # 不混桶：缓存读(50) != 缓存写(8) != 推理(12)，三桶各自独立
  断言真(合["缓存读"] != 合["缓存写"], "累计_缓存读不混入缓存写")
  断言真(合["缓存写"] != 合["推理"], "累计_缓存写不混入推理")

  # ============ 3) 缺桶归零 + 计费输入 ============
  断言相等(用量桶值(段2, "缓存读"), 0, "缺桶归零_缓存读")
  断言相等(用量桶值(段2, "缓存写"), 8, "有桶直读_缓存写")
  断言相等(用量桶值(["输入": 1, "输出": 2], "推理"), 0, "缺桶归零_推理")
  # 计费输入 = 输入 + 缓存读 + 缓存写（上游：billed input = sum of the three）
  断言相等(计费输入(合), 278, "计费输入(220+50+8)")
  断言相等(计费输入(段1), 130, "计费输入_无缓存写(100+30+0)")

  # ============ 4) 客户端.翻译用量：wire → 内部分桶 ============
  # 4a. DeepSeek 命中/未命中口径：prompt=110(hit 40 + miss 30)，completion=25，reasoning=6
  设 wire1 为 ["prompt_tokens": 110, "completion_tokens": 25,
    "prompt_cache_hit_tokens": 40, "prompt_cache_miss_tokens": 30,
    "completion_tokens_details": ["reasoning_tokens": 6]]
  设 t1 为 翻译用量(wire1)
  断言相等(t1["输入"], 70, "翻译_输入=prompt-缓存读(110-40)")
  断言相等(t1["输出"], 25, "翻译_输出")
  断言相等(t1["缓存读"], 40, "翻译_缓存读=hit")
  断言相等(t1["缓存写"], 30, "翻译_缓存写=miss（R47新增）")
  断言相等(t1["推理"], 6, "翻译_推理")
  断言相等(t1["totalTokens"], 135, "翻译_totalTokens=prompt+completion")

  # 4b. OpenAI 风格 prompt_tokens_details.cached_tokens 优先路
  设 wire2 为 ["prompt_tokens": 90, "completion_tokens": 15,
    "prompt_tokens_details": ["cached_tokens": 25]]
  设 t2 为 翻译用量(wire2)
  断言相等(t2["缓存读"], 25, "翻译_details缓存读优先")
  断言相等(t2["输入"], 65, "翻译_details输入减出")
  断言真(t2.包含("缓存写") == 假, "翻译_无miss不带缓存写桶")

  # 4c. 无缓存字段 → 缺省两桶（既有语义不破）
  设 wire3 为 ["prompt_tokens": 12, "completion_tokens": 3]
  设 t3 为 翻译用量(wire3)
  断言相等(t3["输入"], 12, "翻译_纯输入")
  断言真(t3.包含("缓存读") == 假, "翻译_无缓存读桶")
  断言真(t3.包含("缓存写") == 假, "翻译_无缓存写桶")

  # ============ 5) usage 块经块组装器保真 ============
  设 组装器 为 新建 块组装器()
  组装器.送入(造用量块(t1))
  设 回读 为 组装器.用量()
  断言相等(回读["缓存读"], 40, "组装器_用量缓存读保真")
  断言相等(回读["缓存写"], 30, "组装器_用量缓存写保真")
  断言相等(回读["推理"], 6, "组装器_用量推理保真")

  打印 "R47 流式用量桶：五桶形状/分桶累计不混桶/翻译用量/组装器保真 全部通过"

主()
