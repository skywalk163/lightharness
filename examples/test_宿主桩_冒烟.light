# test_宿主桩_冒烟.light —— #291 宿主桩套件冒烟
# 运行：python 运行.py examples/test_宿主桩_冒烟.light

从 宿主桩 导入 造宿主桩套件, 设预设进程, 取钩子历史, 取遥测表, 取审批表
从 宿主IO 导入 宿主转交, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  设 套件 为 造宿主桩套件()
  设 桩 为 套件["桩"]
  设 状态 为 套件["状态"]

  # 1. 内存文件 IO 往返
  设 rw 为 宿主转交(桩, "写", {"路径": "/a.txt", "内容": "hello", "请求ID": "w1"})
  断言真(rw["成功"], "1a 写成功")
  设 rr 为 宿主转交(桩, "读", {"路径": "/a.txt", "请求ID": "r1"})
  断言真(rr["成功"], "1b 读成功")
  断言相等(rr["数据"], "hello", "1c 读往返")

  # 2. hooks 事件总线桩：三域可派发可断言
  设 rh 为 宿主转交(桩, "宿主钩子", {"事件": {"域": "PreToolUse", "类型": "pre", "数据": {"工具": "bash"}}, "会话": "s1"})
  断言真(rh["成功"], "2a 钩子派发")
  设 历史 为 取钩子历史(状态)
  断言相等(列表长度(历史), 1, "2b 历史一条")
  断言相等(历史[0]["事件"]["域"], "PreToolUse", "2c 域")

  # 3. 受控子进程桩：预设退出码/输出
  设预设进程(状态, "echo hi", 0, "hi\n")
  设 rp 为 宿主转交(桩, "子进程执行", {"命令": "echo hi"})
  断言真(rp["成功"], "3a 子进程成功")
  断言相等(rp["数据"]["退出码"], 0, "3b 退出码")
  断言相等(rp["数据"]["标准输出"], "hi\n", "3c 输出")

  # 4. 受控沙箱桩
  设 rs 为 宿主转交(桩, "沙箱执行", {"命令": "echo hi", "工作目录": "/tmp"})
  断言真(rs["成功"], "4a 沙箱成功")
  断言相等(rs["数据"]["资源限制"], "stub-sandbox", "4b 沙箱标记")

  # 5. 遥测桩
  设 rt 为 宿主转交(桩, "遥测记录", {"指标名": "tool_call", "值": 1, "维度": {"工具": "bash"}})
  断言真(rt["成功"], "5a 遥测记录")
  设 遥测 为 取遥测表(状态)
  断言相等(列表长度(遥测), 1, "5b 遥测一条")

  # 6. 审批桩
  设 ra 为 宿主转交(桩, "审批结果", {"工具名": "bash", "裁定": "批准", "详情": "ok"})
  断言真(ra["成功"], "6a 审批记录")
  设 审批 为 取审批表(状态)
  断言相等(列表长度(审批), 1, "6b 审批一条")

  # 7. 未知能力 -> UNSUPPORTED_OPERATION
  设 ru 为 宿主转交(桩, "不存在的能力", {})
  断言真(是失败结果(ru), "7a 未知能力失败")

  打印 "--- #291 宿主桩套件 冒烟测试通过 ---"

主()
