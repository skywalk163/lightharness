# test_R39_集成测试.light —— 第 39 轮 任务 5：scope + system-prompt 集成测试
# 运行：python 运行.py examples/test_R39_集成测试.light
# 覆盖：§1 scope 核心 / §2 scope 存储层 / §3 作用域层组 / §4 system-prompt 核心 /
#       §5 complete + 瀑布流 / §6 工具排序+变量插值 / §7 scope+system-prompt 联动 /
#       §8 agent-default-model 深化 + 端到端

从 内置核心字典 导入 字典包含键, 字典键列表
从 内置核心判型 导入 是空
从 作用域 导入 建作用域键, 是作用域键, 作用域相等, 绑定父作用域, 重绑父作用域
从 作用域 导入 取父作用域, 取作用域链, 作用域键ID
从 作用域 导入 建上下文, 扩展作用域上下文
从 作用域 导入 命名条目表, 注销命名条目, 匿名条目表, 注销匿名条目
从 作用域 导入 作用域层组, 造作用域层组, 写父作用域
从 系统提示 导入 建系统提示注册表, 注册节, 注册上下文, 注册变量
从 系统提示 导入 注册组装监听器, 撤销节, 撤销变量
从 系统提示 导入 组装系统提示, 渲染提示, 校验变量名, 排序工具, 校验工具排序
从 系统提示 导入 节顺序常量表, 工具排序未列出标记
从 代理默认模型 导入 建默认模型配置, 取当前选择, 更新默认模型

段落 必等 接收 实际, 期望, 编号:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际 " + 转字符串(实际) + "，期望 " + 转字符串(期望))
  返回 真

段落 通过 接收 编号:
  打印 "OK #" + 编号
  返回 真

# ===== §3 作用域层组用的动作段落 =====
段落 全局动作 接收 层:
  层.命名.插入("全局节", "来自全局")
  返回 空

段落 域A动作 接收 层:
  层.命名.插入("域A专属", "只有 A 能看")
  返回 空

段落 域B动作 接收 层:
  层.命名.插入("域B专属", "只有 B 能看")
  返回 空

# ===== §4 system-prompt 用的函数文本 =====
段落 节函数 接收 ctx:
  返回 "函数节"

# ===== §5 瀑布流监听器 =====
段落 监听器修改 接收 装配, ctx:
  装配["节列表"][0]["文本"] 为 "被监听器修改"
  返回 装配

# ===== §7 scope+system-prompt 联动 专用动作 =====
段落 身份动作 接收 层:
  层.命名.插入("身份", "你是光明 Agent")
  返回 空

段落 域A专属动作 接收 层:
  层.命名.插入("域A专属", "仅 A 可见")
  返回 空

段落 域B专属动作 接收 层:
  层.命名.插入("域B专属", "仅 B 可见")
  返回 空

段落 主:
  设 计数 为 0

  # ==================================================================
  # §1 scope 核心
  # ==================================================================
  打印 "--- §1 scope 核心 ---"

  设 计数 为 计数 + 1
  设 k1 为 建作用域键()
  必等(是作用域键(k1), 真, "1.1")

  设 计数 为 计数 + 1
  设 k2 为 建作用域键()
  设 k3 为 建作用域键()
  绑定父作用域(k3, k2)
  绑定父作用域(k2, k1)
  设 链 为 取作用域链(k3)
  必等(长(链), 3, "1.2 链长3")
  必等(作用域相等(链[0], k3), 真, "1.2b")
  必等(作用域相等(链[2], k1), 真, "1.2c")

  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    绑定父作用域(k1, k3)
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "1.3 循环检测")

  设 计数 为 计数 + 1
  抛错数 为 0
  尝试:
    绑定父作用域(k3, k1)
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "1.4 一次性绑定")

  设 计数 为 计数 + 1
  设 k4 为 建作用域键()
  设 句柄 为 绑定父作用域(k4, k1)
  重绑父作用域(句柄, k3)
  设 链2 为 取作用域链(k4)
  必等(长(链2), 4, "1.5 重绑后链长4")
  抛错数 为 0
  尝试:
    绑定父作用域(k3, k4)
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "1.6 重绑后仍可检测")

  通过("§1 scope 核心")

  # ==================================================================
  # §2 scope 存储层
  # ==================================================================
  打印 "--- §2 scope 存储层 ---"

  设 计数 为 计数 + 1
  设 n 为 新建 命名条目表()
  设 h1 为 n.插入("a", 1)
  n.插入("b", 2)
  必等(n.条目数(), 2, "2.1")
  必等(n.取("a"), 1, "2.1b")
  抛错数 为 0
  尝试:
    n.插入("a", 99)
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "2.2 重复名抛错")
  注销命名条目(h1)
  注销命名条目(h1)
  必等(n.条目数(), 1, "2.3 幂等注销后1")

  设 计数 为 计数 + 1
  设 a 为 新建 匿名条目表()
  设 ah 为 a.追加("x")
  a.追加("y")
  a.追加("x")
  必等(a.条目数(), 3, "2.4 匿名3")
  注销匿名条目(ah)
  注销匿名条目(ah)
  必等(a.条目数(), 2, "2.5 幂等2")

  通过("§2 scope 存储层")

  # ==================================================================
  # §3 作用域层组（scope 上下文附着 + 作用域过滤）
  # ==================================================================
  打印 "--- §3 作用域层组 ---"

  设 计数 为 计数 + 1
  设 组 为 造作用域层组()
  设 根Ctx 为 建上下文(空)
  设 根键 为 建作用域键("根")
  设 域A键 为 建作用域键("A")
  设 域B键 为 建作用域键("B")
  设 域A上下文 为 扩展作用域上下文(根Ctx, 域A键)
  设 域B上下文 为 扩展作用域上下文(根Ctx, 域B键)
  绑定父作用域(域A键, 根键)
  绑定父作用域(域B键, 根键)

  组.附着(根Ctx, 全局动作)
  组.附着(域A上下文, 域A动作)
  组.附着(域B上下文, 域B动作)

  设 收集A 为 组.合并命名(域A键)
  设 收集B 为 组.合并命名(域B键)
  设 收集根 为 组.合并命名(根键)

  必等(字典包含键(收集A, "全局节"), 真, "3.1 域A含全局")
  必等(字典包含键(收集A, "域A专属"), 真, "3.1b")
  必等(字典包含键(收集A, "域B专属"), 假, "3.1c")

  必等(字典包含键(收集B, "全局节"), 真, "3.2")
  必等(字典包含键(收集B, "域B专属"), 真, "3.2b")

  必等(字典包含键(收集根, "域A专属"), 假, "3.3 根不含子专属")
  必等(字典包含键(收集根, "域B专属"), 假, "3.3b")

  通过("§3 作用域层组")

  # ==================================================================
  # §4 system-prompt 核心
  # ==================================================================
  打印 "--- §4 system-prompt 核心 ---"

  设 计数 为 计数 + 1
  设 reg 为 建系统提示注册表()
  注册节(reg, "intro", 100, "你好")
  抛错数 为 0
  尝试:
    注册节(reg, "intro", 200, "重复")
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "4.1 重复节抛错")
  撤销节(reg, "intro")
  必等(长(reg["节顺序"]), 0, "4.2")

  设 计数 为 计数 + 1
  注册节(reg, "s_low", 100, "低阶")
  注册节(reg, "s_mid", 500, "中阶")
  注册节(reg, "s_high", 900, "高阶")
  设 a 为 组装系统提示(reg)
  必等(a["节列表"][0]["名字"], "s_low", "4.3")
  必等(a["节列表"][1]["名字"], "s_mid", "4.3b")
  必等(a["节列表"][2]["名字"], "s_high", "4.3c")

  设 计数 为 计数 + 1
  注册上下文(reg, "sandbox", 110, "沙箱")
  注册上下文(reg, "approval", 115, "审批")
  设 b 为 组装系统提示(reg)
  必等(b["上下文列表"][0]["名字"], "sandbox", "4.4")

  设 计数 为 计数 + 1
  撤销节(reg, "s_low")
  注册节(reg, "f_low", 100, 节函数)
  设 c 为 组装系统提示(reg)
  必等(c["节列表"][0]["文本"], "函数节", "4.5")

  通过("§4 system-prompt 核心")

  # ==================================================================
  # §5 complete 节 + 瀑布流监听器
  # ==================================================================
  打印 "--- §5 complete + 瀑布流 ---"

  设 计数 为 计数 + 1
  设 reg2 为 建系统提示注册表()
  注册节(reg2, "普通", 100, "基础")
  注册节(reg2, "完整节", 500, "这是完整提示", 真)
  设 ass 为 组装系统提示(reg2)
  设 有完整 为 假
  遍历 s 之 ass["节列表"]:
    如果 s["名字"] == "完整节":
      有完整 为 真
  必等(有完整, 真, "5.1 complete 节存在")

  设 计数 为 计数 + 1
  注册节(reg2, "另完整", 600, "另一完整", 真)
  抛错数 为 0
  尝试:
    组装系统提示(reg2)
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "5.2 多 complete 冲突")

  设 计数 为 计数 + 1
  设 reg3 为 建系统提示注册表()
  注册节(reg3, "a", 100, "正文")
  注册组装监听器(reg3, 监听器修改)
  设 a3 为 组装系统提示(reg3)
  必等(a3["节列表"][0]["文本"], "被监听器修改", "5.3")

  通过("§5 complete + 瀑布流")

  # ==================================================================
  # §6 工具排序 + 变量插值 + 常量
  # ==================================================================
  打印 "--- §6 工具排序 + 变量插值 ---"

  设 计数 为 计数 + 1
  设 工具们 为 [
    ["name": "grep", "description": "搜", "parameters": ["type": "object"]],
    ["name": "bash", "description": "跑", "parameters": ["type": "object"]],
    ["name": "read", "description": "读", "parameters": ["type": "object"]]
  ]
  设 已知名 为 {"bash": 真, "grep": 真, "read": 真}
  设 s1 为 排序工具(工具们, 空, 已知名)
  必等(s1[0]["name"], "bash", "6.1")
  必等(s1[2]["name"], "read", "6.1b")

  设 计数 为 计数 + 1
  设 工具排序 为 ["read", 工具排序未列出标记, "bash"]
  设 s2 为 排序工具(工具们, 工具排序, 已知名)
  必等(s2[0]["name"], "read", "6.2")
  必等(s2[1]["name"], "grep", "6.2b")
  必等(s2[2]["name"], "bash", "6.2c")

  设 计数 为 计数 + 1
  抛错数 为 0
  尝试:
    校验工具排序(["bash", "bash", 工具排序未列出标记])
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "6.3 重复名抛错")
  抛错数 为 0
  尝试:
    校验工具排序(["bash"])
  捕获 异常 为 e:
    抛错数 为 抛错数 + 1
  必等(抛错数, 1, "6.4 必须含 REST")

  设 计数 为 计数 + 1
  设 reg4 为 建系统提示注册表()
  注册节(reg4, "开头", 0, "你好 {{who}}")
  注册变量(reg4, "who", "光明")
  注册变量(reg4, "project", "duan-light-merge")
  注册节(reg4, "结尾", 1000, "来自 {{project}}")
  设 a4 为 组装系统提示(reg4)
  设 提示 为 渲染提示(a4)
  必等(提示.查找("你好 光明") >= 0, 真, "6.5")
  必等(提示.查找("来自 duan-light-merge") >= 0, 真, "6.5b")

  设 计数 为 计数 + 1
  必等(校验变量名("name_ok"), 真, "6.6")
  必等(校验变量名("Name_OK"), 假, "6.6b")
  必等(校验变量名("1abc"), 假, "6.6c")
  必等(校验变量名("ok-hyphen"), 假, "6.6d")

  设 计数 为 计数 + 1
  必等(字典包含键(节顺序常量表, "HARNESS_IDENTITY"), 真, "6.7")
  必等(字典包含键(节顺序常量表, "DEPLOYMENT_PERSONA_SUFFIX"), 真, "6.7b")
  必等(节顺序常量表["HARNESS_IDENTITY"], -1000, "6.7c")

  通过("§6 工具排序 + 变量插值")

  # ==================================================================
  # §7 scope + system-prompt 联动
  # ==================================================================
  打印 "--- §7 scope + system-prompt 联动 ---"

  设 计数 为 计数 + 1
  设 组7 为 造作用域层组()
  设 根7 为 建上下文(空)
  设 根7键 为 建作用域键("根7")
  设 域A键 为 建作用域键("A")
  设 域B键 为 建作用域键("B")
  设 域A上下文 为 扩展作用域上下文(根7, 域A键)
  设 域B上下文 为 扩展作用域上下文(根7, 域B键)
  绑定父作用域(域A键, 根7键)
  绑定父作用域(域B键, 根7键)

  组7.附着(根7, 身份动作)
  组7.附着(域A上下文, 域A专属动作)
  组7.附着(域B上下文, 域B专属动作)

  设 regA 为 建系统提示注册表()
  注册变量(regA, "who", "域A")
  设 收集A 为 组7.合并命名(域A键)
  遍历 名字 之 字典键列表(收集A):
    注册节(regA, 名字, 100, 收集A[名字])
  注册节(regA, "greet", 9000, "hello {{who}}")
  设 assA 为 组装系统提示(regA)
  设 提示A 为 渲染提示(assA)
  必等(提示A.查找("你是光明 Agent") >= 0, 真, "7.1")
  必等(提示A.查找("仅 A 可见") >= 0, 真, "7.1b")
  必等(提示A.查找("仅 B 可见") >= 0, 假, "7.1c")
  必等(提示A.查找("hello 域A") >= 0, 真, "7.1d")

  设 regB 为 建系统提示注册表()
  注册变量(regB, "who", "域B")
  设 收集B 为 组7.合并命名(域B键)
  遍历 名字 之 字典键列表(收集B):
    注册节(regB, 名字, 100, 收集B[名字])
  注册节(regB, "greet", 9000, "hello {{who}}")
  设 assB 为 组装系统提示(regB)
  设 提示B 为 渲染提示(assB)
  必等(提示B.查找("你是光明 Agent") >= 0, 真, "7.2")
  必等(提示B.查找("仅 B 可见") >= 0, 真, "7.2b")
  必等(提示B.查找("仅 A 可见") >= 0, 假, "7.2c")
  必等(提示B.查找("hello 域B") >= 0, 真, "7.2d")

  通过("§7 scope+system-prompt 联动")

  # ==================================================================
  # §8 agent-default-model 深化 + 端到端
  # ==================================================================
  打印 "--- §8 agent-default-model 深化 + 端到端 ---"

  设 计数 为 计数 + 1
  设 默认模型 为 建默认模型配置("deepseek-official", "deepseek-v4-flash")
  设 选择 为 取当前选择(默认模型)
  设 reg5 为 建系统提示注册表()
  注册变量(reg5, "model_provider", 选择["提供者"])
  注册变量(reg5, "model_name", 选择["模型"])
  注册节(reg5, "模型介绍", 50, "当前模型：{{model_provider}} - {{model_name}}")
  设 a5 为 组装系统提示(reg5)
  设 提示5 为 渲染提示(a5)
  必等(提示5.查找("deepseek-official") >= 0, 真, "8.1")
  必等(提示5.查找("deepseek-v4-flash") >= 0, 真, "8.1b")

  更新默认模型(默认模型, "new-provider", "new-model")
  撤销变量(reg5, "model_provider")
  撤销变量(reg5, "model_name")
  注册变量(reg5, "model_provider", 取当前选择(默认模型)["提供者"])
  注册变量(reg5, "model_name", 取当前选择(默认模型)["模型"])
  设 a6 为 组装系统提示(reg5)
  设 提示6 为 渲染提示(a6)
  必等(提示6.查找("new-provider") >= 0, 真, "8.2")
  必等(提示6.查找("new-model") >= 0, 真, "8.2b")

  通过("§8 agent-default-model + 端到端")

  打印 "R39 集成测试通过：" + 转字符串(计数) + " 组"

主()

