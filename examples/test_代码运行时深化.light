# test_代码运行时深化.light —— 代码运行时 v2：超时配置/输出限制/执行统计
# 用模拟/桩数据验证，不真的执行外部代码
从 代码运行时 导入 代码运行时

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 主:
  # ===== 超时配置 =====
  打印 "=== 超时配置测试 ==="
  # 默认30秒
  设 运行时默认 为 新建 代码运行时(空)
  断言等于(运行时默认.状态()["超时秒"], 30, "默认超时30秒")

  # 自定义超时
  设 运行时自定义 为 新建 代码运行时(10)
  断言等于(运行时自定义.状态()["超时秒"], 10, "自定义超时10秒")

  # 选项配置最大输出字节数
  设 运行时选项 为 新建 代码运行时(5, ["最大输出字节数": 100])
  断言等于(运行时选项.状态()["超时秒"], 5, "选项超时5秒")
  设 统计0 为 运行时选项.执行统计()
  断言等于(统计0["最大输出字节数"], 100, "最大输出字节数=100")
  打印 "  超时配置通过"

  # ===== 输出限制（用桩数据手动验证截断逻辑）=====
  打印 "=== 输出限制测试 ==="
  设 运行时小输出 为 新建 代码运行时(30, ["最大输出字节数": 10])
  # 执行简单命令产生输出，验证截断
  设 结果 为 运行时小输出.执行("print('12345678901234567890')")
  断言等于(结果["已截断"], 真, "输出超限应标记已截断")
  断言真(长度(结果["输出"]) <= 10, "输出被截断到10字节内")

  # 小输出不截断
  设 运行时正常 为 新建 代码运行时(30)
  设 结果2 为 运行时正常.执行("print('hi')")
  断言等于(结果2["已截断"], 假, "小输出不截断")
  断言等于(结果2["返回码"], 0, "正常执行返回码0")
  打印 "  输出限制通过"

  # ===== 执行统计 =====
  打印 "=== 执行统计测试 ==="
  设 运行时统计 为 新建 代码运行时(30)
  # 执行3次成功
  运行时统计.执行("print(1)")
  运行时统计.执行("print(2)")
  运行时统计.执行("print(3)")
  设 统计1 为 运行时统计.执行统计()
  断言等于(统计1["执行次数"], 3, "执行次数=3")
  断言等于(统计1["成功次数"], 3, "成功次数=3")
  断言等于(统计1["失败次数"], 0, "失败次数=0")
  断言等于(统计1["成功率"], 1.0, "成功率=1.0")
  断言真(统计1["总耗时秒"] >= 0, "总耗时>=0")
  断言真(统计1["平均耗时秒"] >= 0, "平均耗时>=0")

  # 执行1次失败（语法错误）
  运行时统计.执行("import nonexistent_module_xyz")
  设 统计2 为 运行时统计.执行统计()
  断言等于(统计2["执行次数"], 4, "执行次数=4")
  断言等于(统计2["成功次数"], 3, "成功次数=3")
  断言等于(统计2["失败次数"], 1, "失败次数=1")
  断言真(统计2["成功率"] < 1.0, "成功率<1.0")
  打印 "  执行统计通过"

  打印 "--- 代码运行时深化测试通过 ---"

主()
