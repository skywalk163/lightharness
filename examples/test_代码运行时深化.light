# test_代码运行时深化.light —— 代码运行时 v2：超时配置/输出限制/执行统计
# 用模拟/桩数据验证，不真的执行外部代码
从 代码运行时 导入 代码运行时

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

# ---- 桩：执行 改为注入数据源（不触真实 subprocess / python PATH）----
# 断言全部保留原样；只替换「执行」数据源。反跑判据不变：把 已截断/返回码 断言改反即红。
# 桩自实现截断与统计（因 桩替换了整段 执行，截断逻辑需在桩内复刻）。
设 桩深化槽 为 空

段落 桩深化执行(代码):
  全局 桩深化槽
  设 运行时 为 桩深化槽
  运行时.执行次数 为 运行时.执行次数 + 1
  设 开始时间 为 时间戳()
  设 输出 为 ""
  设 错误 为 ""
  设 返回码 为 0
  如果 代码 == "print('12345678901234567890')":
    设 输出 为 "12345678901234567890\n"
  如果 代码 == "print('hi')":
    设 输出 为 "hi\n"
  如果 代码 == "print(1)":
    设 输出 为 "1\n"
  如果 代码 == "print(2)":
    设 输出 为 "2\n"
  如果 代码 == "print(3)":
    设 输出 为 "3\n"
  如果 代码 == "import nonexistent_module_xyz":
    设 错误 为 "ModuleNotFoundError: No module named 'nonexistent_module_xyz'\n"
    设 返回码 为 1
  # 复刻截断逻辑
  设 已截断 为 假
  如果 长度(输出) > 运行时.最大输出字节数:
    设 输出 为 截取(输出, 0, 运行时.最大输出字节数)
    设 已截断 为 真
  如果 长度(错误) > 运行时.最大输出字节数:
    设 错误 为 截取(错误, 0, 运行时.最大输出字节数)
    设 已截断 为 真
  设 耗时 为 时间戳() - 开始时间
  运行时.总耗时秒 为 运行时.总耗时秒 + 耗时
  如果 返回码 == 0:
    运行时.成功次数 为 运行时.成功次数 + 1
  否则:
    运行时.失败次数 为 运行时.失败次数 + 1
  返回 ["输出": 输出, "错误": 错误, "返回码": 返回码, "已截断": 已截断, "耗时秒": 耗时]

段落 接桩深化执行(运行时):
  全局 桩深化槽
  设 桩深化槽 为 运行时
  设 运行时.执行 为 桩深化执行
  返回 真

段落 主:
  # ===== 超时配置 =====
  打印 "=== 超时配置测试 ==="
  # 默认30秒
  设 运行时默认 为 新建 代码运行时(空)
  断言等于(运行时默认.状态()["超时秒"], 30, "默认超时30秒")

  # 自定义超时
  设 运行时自定义 为 新建 代码运行时(10)
  断言等于(运行时自定义.状态()["超时秒"], 10, "自定义超时10秒")

  # 选项配置最大输出字节数
  设 运行时选项 为 新建 代码运行时(5, ["最大输出字节数": 100])
  断言等于(运行时选项.状态()["超时秒"], 5, "选项超时5秒")
  设 统计0 为 运行时选项.执行统计()
  断言等于(统计0["最大输出字节数"], 100, "最大输出字节数=100")
  打印 "  超时配置通过"

  # ===== 输出限制（用桩数据手动验证截断逻辑）=====
  打印 "=== 输出限制测试 ==="
  设 运行时小输出 为 新建 代码运行时(30, ["最大输出字节数": 10])
  # 接入桩数据源（只替换数据源，不触真实 subprocess / python PATH）
  接桩深化执行(运行时小输出)
  # 执行简单命令产生输出，验证截断
  设 结果 为 运行时小输出.执行("print('12345678901234567890')")
  断言等于(结果["已截断"], 真, "输出超限应标记已截断")
  断言真(长度(结果["输出"]) <= 10, "输出被截断到10字节内")

  # 小输出不截断
  设 运行时正常 为 新建 代码运行时(30)
  接桩深化执行(运行时正常)
  设 结果2 为 运行时正常.执行("print('hi')")
  断言等于(结果2["已截断"], 假, "小输出不截断")
  断言等于(结果2["返回码"], 0, "正常执行返回码0")
  打印 "  输出限制通过"

  # ===== 执行统计 =====
  打印 "=== 执行统计测试 ==="
  设 运行时统计 为 新建 代码运行时(30)
  接桩深化执行(运行时统计)
  # 执行3次成功
  运行时统计.执行("print(1)")
  运行时统计.执行("print(2)")
  运行时统计.执行("print(3)")
  设 统计1 为 运行时统计.执行统计()
  断言等于(统计1["执行次数"], 3, "执行次数=3")
  断言等于(统计1["成功次数"], 3, "成功次数=3")
  断言等于(统计1["失败次数"], 0, "失败次数=0")
  断言等于(统计1["成功率"], 1.0, "成功率=1.0")
  断言真(统计1["总耗时秒"] >= 0, "总耗时>=0")
  断言真(统计1["平均耗时秒"] >= 0, "平均耗时>=0")

  # 执行1次失败（语法错误）
  运行时统计.执行("import nonexistent_module_xyz")
  设 统计2 为 运行时统计.执行统计()
  断言等于(统计2["执行次数"], 4, "执行次数=4")
  断言等于(统计2["成功次数"], 3, "成功次数=3")
  断言等于(统计2["失败次数"], 1, "失败次数=1")
  断言真(统计2["成功率"] < 1.0, "成功率<1.0")
  打印 "  执行统计通过"

  打印 "--- 代码运行时深化测试通过 ---"

主()
