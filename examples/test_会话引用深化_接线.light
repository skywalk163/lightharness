# test_会话引用深化_接线.light —— 第6轮 任务E #281 会话引用深化接线 判据
# 运行：python 运行.py examples/test_会话引用深化_接线.light
# 判据：接线提及匹配（造引用候选 → 造提及候选 → 候选匹配查询 单步流水线）；
#       纯逻辑回归绿由 test_会话引用深化.light 承担。

从 会话引用深化 导入 接线提及匹配, 会话引用标签

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 提及查询命中：标签包含查询词 ----
  设 r1 为 接线提及匹配("调试", "s1", "/work", "调试会话", 0)
  断言真(r1["命中"], "1a 标签命中")
  断言真(是字典(r1["候选"]), "1b 候选形状")
  断言真(是字典(r1["提及"]), "1c 提及形状")

  # ---- 2. 会话id 命中 ----
  设 r2 为 接线提及匹配("s1", "s1", "/work", "别的标题", 0)
  断言真(r2["命中"], "2a id 命中")

  # ---- 3. 不命中 ----
  设 r3 为 接线提及匹配("完全无关", "s1", "/work", "调试会话", 0)
  断言真(r3["命中"] == 假, "3a 不命中")

  # ---- 4. 显示标题命中 ----
  设 r4 为 接线提及匹配("别的", "s9", "/work", "别的标题", 0)
  断言真(r4["命中"], "4a 标题命中")

  # ---- 5. 既有 会话引用标签 保留（回归锚点：返回 {label, displayTitle}） ----
  设 标签对 为 会话引用标签("标题甲", 空, "s1")
  断言相等(标签对["label"], "标题甲", "5a 标签对")

  打印 "--- 第6轮 任务E #281 会话引用深化接线 测试通过 ---"

主()