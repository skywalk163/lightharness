# test_沙箱_接线.light —— 第6轮 任务E #286 sandbox 失败签名分类接线 判据
# 运行：python 运行.py examples/test_沙箱_接线.light
# 判据：接线沙箱失败分类（运行受限增强 结果 dict → 绳分类运行失败 规则签名匹配）；
#       纯逻辑回归绿由 test_沙箱.light / test_沙箱深化.light 承担。

从 沙箱 导入 接线沙箱失败分类, 绳分类运行失败

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # 规则表（绳分类运行失败 既有契约：fatalSignatures / informationalLines / allowedExitCodes）
  设 规则表 为 [{"fatalSignatures": ["command not found"]},
    {"fatalSignatures": ["permission denied"]}]

  # ---- 1. 退出码 0 -> 非失败，分类空 ----
  设 r1 为 接线沙箱失败分类({"退出码": 0, "标准输出": "", "标准错误": ""}, 规则表)
  断言相等(r1["分类"], 空, "1a 退出码0无分类")

  # ---- 2. 签名命中 -> detail 信封（结果透传） ----
  设 r2 为 接线沙箱失败分类({"退出码": 127, "标准输出": "", "标准错误": "bash: foo: command not found"}, 规则表)
  断言相等(r2["分类"]["detail"], "bash: foo: command not found", "2a 命中行")
  断言相等(r2["结果"]["退出码"], 127, "2b 结果透传")

  # ---- 3. 另一签名 ----
  设 r3 为 接线沙箱失败分类({"退出码": 1, "标准输出": "", "标准错误": "cp: permission denied"}, 规则表)
  断言相等(r3["分类"]["detail"], "cp: permission denied", "3a 另一签名")

  # ---- 4. 无命中 -> 空（不静默猜） ----
  设 r4 为 接线沙箱失败分类({"退出码": 2, "标准输出": "", "标准错误": "别的错误"}, 规则表)
  断言相等(r4["分类"], 空, "4a 无命中为空")

  # ---- 5. 英文键兜底（运行受限增强 双语形状） ----
  设 r5 为 接线沙箱失败分类({"exitCode": 127, "stdout": "", "stderr": "x: command not found"}, 规则表)
  断言相等(r5["分类"]["detail"], "x: command not found", "5a 英文键兜底")

  # ---- 6. 绳分类运行失败 直接调用（既有纯逻辑保留） ----
  断言相等(绳分类运行失败(0, "任意", 规则表), 空, "6a 退出码0为空")

  打印 "--- 第6轮 任务E #286 沙箱失败分类接线 测试通过 ---"

主()