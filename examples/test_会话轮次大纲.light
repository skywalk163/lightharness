# test_会话轮次大纲.light —— 模块 会话轮次大纲 对齐判据（第12轮 任务2 会话投影域）
# 运行：python 运行.py examples/test_会话轮次大纲.light

从 会话轮次大纲 导入 空大纲, 预览文本, 轮次大纲折叠, 轮次大纲视图, 提示预览上限, 回答预览上限

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 列表取(列表, i):
  设 计数 为 0
  遍历 元素 之 列表:
    如果 计数 == i: 返回 元素
    设 计数 为 计数 + 1
  返回 空

段落 主:
  设 状态 为 空大纲()
  # 1) 空大纲
  断言相等(列表长度(状态["turns"]), 0, "空大纲 turns 为空")
  断言相等(状态["draft"], "", "空大纲 draft 为空")

  # 2) 预览：跳过非文本块，拼接文本块
  设 内容1 为 [{"type": "text", "text": "你好"}, {"type": "reasoning", "text": "不可见"}, {"type": "text", "text": "世界"}]
  断言相等(预览文本(内容1, 120), "你好 世界", "预览跳过非文本块")

  # 3) 预览：超长文本截断到上限并加省略号
  设 长文 为 "这是一段非常长的提示文本，用于测试预览的截断行为，长度远超五十字符的上限预算，需要被截断。这是一段非常长的提示文本，用于测试预览的截断行为，长度远超五十字符的上限预算，需要被截断。"
  设 预1 为 预览文本([{"type": "text", "text": 长文}], 50)
  断言相等(字符串长度(预1), 50, "预览截断长度恰为上限")
  断言相等(截取(预1, 49, 50), "…", "预览截断末尾为省略号")

  # 4) turn/start 开新条目
  设 状态 为 轮次大纲折叠(状态, {"type": "turn/start", "seq": 5, "data": {"turn": 0}})
  断言相等(列表长度(状态["turns"]), 1, "turn/start 追加一条")
  设 项0 为 列表取(状态["turns"], 0)
  断言相等(项0["turn"], 0, "条目轮次为 0")
  断言相等(项0["seq"], 5, "条目 seq 来自事件")
  断言相等(项0["prompt"], "", "初始 prompt 为空")

  # 5) 用户消息写入 prompt
  设 状态 为 轮次大纲折叠(状态, {"type": "user/message", "data": {"source": {"kind": "user"}, "content": [{"type": "text", "text": "今天天气如何"}]}})
  设 项0 为 列表取(状态["turns"], 0)
  断言相等(项0["prompt"], "今天天气如何", "用户消息写入 prompt")

  # 6) 非 user 来源忽略
  设 状态2 为 轮次大纲折叠(状态, {"type": "user/message", "data": {"source": {"kind": "tool"}, "content": [{"type": "text", "text": "旁路"}]}})
  断言相等(状态2["turns"], 状态["turns"], "非 user 来源不写 prompt")

  # 7) 已写 prompt 后重复用户消息忽略
  设 状态3 为 轮次大纲折叠(状态, {"type": "user/message", "data": {"source": {"kind": "user"}, "content": [{"type": "text", "text": "再问一句"}]}})
  断言相等(状态3["turns"], 状态["turns"], "prompt 已写不再覆盖")

  # 8) 助手消息仅写草稿
  设 状态 为 轮次大纲折叠(状态, {"type": "assistant/message", "data": {"message": {"content": [{"type": "text", "text": "今天是晴天"}]}}})
  断言相等(状态["draft"], "今天是晴天", "助手消息写草稿")
  断言相等(列表取(状态["turns"], 0)["response"], "", "草稿未提交时 response 为空")

  # 9) 重复草稿保持内容不变
  设 状态4 为 轮次大纲折叠(状态, {"type": "assistant/message", "data": {"message": {"content": [{"type": "text", "text": "今天是晴天"}]}}})
  断言相等(状态4["draft"], "今天是晴天", "重复草稿不覆盖")
  断言相等(状态4["turns"], 状态["turns"], "重复草稿不新增 turns")

  # 10) turn/end 提交草稿
  设 状态 为 轮次大纲折叠(状态, {"type": "turn/end", "data": {"reason": "done"}})
  设 项0 为 列表取(状态["turns"], 0)
  断言相等(项0["response"], "今天是晴天", "turn/end 提交 response")
  断言相等(状态["draft"], "", "turn/end 清空草稿")

  # 11) 空草稿的 turn/end 不动
  设 状态5 为 轮次大纲折叠(状态, {"type": "turn/end", "data": {"reason": "again"}})
  断言相等(状态5["turns"], 状态["turns"], "空草稿 turn/end 不回退")

  # 12) 下一轮 turn/start 追加；同轮回落忽略
  设 状态 为 轮次大纲折叠(状态, {"type": "turn/start", "seq": 9, "data": {"turn": 1}})
  断言相等(列表长度(状态["turns"]), 2, "第二轮追加")
  设 状态6 为 轮次大纲折叠(状态, {"type": "turn/start", "seq": 10, "data": {"turn": 1}})
  断言相等(状态6["turns"], 状态["turns"], "同轮 turn/start 忽略")

  # 13) 视图返回 turns；限量常量
  断言相等(轮次大纲视图(状态), 状态["turns"], "视图返回 turns")
  断言相等(提示预览上限(), 50, "提示上限 50")
  断言相等(回答预览上限(), 120, "回答上限 120")
  打印 "test_会话轮次大纲 PASS"

主()