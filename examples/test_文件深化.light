# test_文件深化.light —— 文件 v2：原子写文本 + 追加文本
从 文件 导入 写文本文件, 读文本文件, 原子写文本, 追加文本, 建临时目录, 拼路径, 删除路径, 存在

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 主:
  设 临时目录 为 建临时目录()
  设 测试文件 为 拼路径(临时目录, "原子测试.txt")

  # ===== 原子写文本 =====
  打印 "=== 原子写文本测试 ==="
  原子写文本(测试文件, "原子写入内容")
  设 读到 为 读文本文件(测试文件)
  断言等于(读到, "原子写入内容", "原子写后读回正确")

  # 覆盖写
  原子写文本(测试文件, "覆盖后的内容")
  设 读到2 为 读文本文件(测试文件)
  断言等于(读到2, "覆盖后的内容", "原子覆盖写正确")

  # 确认没有 .tmp 残留
  设 临时残留 为 测试文件 + ".tmp"
  断言等于(存在(临时残留), 假, "无.tmp残留文件")

  # ===== 追加文本 =====
  打印 "=== 追加文本测试 ==="
  设 追加文件 为 拼路径(临时目录, "追加测试.txt")
  追加文本(追加文件, "第一行\n")
  追加文本(追加文件, "第二行\n")
  追加文本(追加文件, "第三行")
  设 追加读到 为 读文本文件(追加文件)
  断言等于(追加读到, "第一行\n第二行\n第三行", "追加文本拼接正确")

  # 追加到不存在的文件（自动创建）
  设 新文件 为 拼路径(临时目录, "新文件.txt")
  追加文本(新文件, "全新内容")
  断言等于(读文本文件(新文件), "全新内容", "追加到新文件自动创建")

  # 清理
  删除路径(临时目录)

  打印 "--- 文件深化测试通过 ---"

主()
