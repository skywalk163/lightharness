# test_acp转码_接线.light —— 第6轮 任务B #258 ACP 转码宿主出口 判据
# 运行：python 运行.py examples/test_acp转码_接线.light
# 判据：接桩出口（经宿主编码终结帧）在宿主桩 mock 下返回预期形状；
#       纯逻辑段回归绿由 test_acp转码.light 承担。

从 acp转码 导入 经宿主编码终结帧, 轮次转停止原因, 是种子专有原因
从 宿主IO 导入 造宿主桩, 造成功结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主桩能力：终结帧编码 -> 回显参数
段落 编码帧(参数字典):
  返回 参数字典

段落 主:
  # ---- 1. 纯逻辑映射回归锚点（本卡不改，确认映射仍在） ----
  断言相等(轮次转停止原因({"kind": "completed"}), "end_turn", "1a completed")
  断言相等(轮次转停止原因({"kind": "max-tokens"}), "max_tokens", "1b max-tokens")
  断言相等(轮次转停止原因({"kind": "interrupted"}), "cancelled", "1c interrupted")
  断言相等(轮次转停止原因({"kind": "未知"}), "end_turn", "1d 未知兜底")

  # ---- 2. 经宿主编码终结帧：completed -> end_turn 透传宿主桩 ----
  设 桩 为 造宿主桩({"终结帧编码": 编码帧})
  设 r1 为 经宿主编码终结帧(桩, {"kind": "completed"})
  断言真(r1["成功"], "2a 成功形状")
  断言相等(r1["数据"]["停止原因"], "end_turn", "2b 停止原因")
  断言相等(r1["数据"]["种子专有"], 假, "2c 非种子专有")

  # ---- 3. interrupted -> cancelled 透传 ----
  设 r2 为 经宿主编码终结帧(桩, {"kind": "interrupted"})
  断言相等(r2["数据"]["停止原因"], "cancelled", "3a interrupted 映射")

  # ---- 4. forked -> 种子专有判定为真，映射兜底 end_turn ----
  设 r3 为 经宿主编码终结帧(桩, {"kind": "forked"})
  断言真(r3["数据"]["种子专有"], "4a forked 专有")
  断言相等(r3["数据"]["停止原因"], "end_turn", "4b 兜底映射")
  断言真(是种子专有原因({"kind": "forked"}), "4c 判定保留")

  # ---- 5. 宿主桩缺能力 -> UNSUPPORTED_OPERATION（不静默） ----
  设 r4 为 经宿主编码终结帧(造宿主桩({}), {"kind": "completed"})
  断言真(是失败结果(r4), "5a 缺能力须失败")
  断言相等(r4["错误码"], "UNSUPPORTED_OPERATION", "5b 错误码")

  # ---- 6. 调用日志留痕 ----
  设 桩5 为 造宿主桩({"终结帧编码": 编码帧})
  设 _r5 为 经宿主编码终结帧(桩5, {"kind": "max-tokens"})
  断言相等(列表长度(桩5["调用日志"]), 1, "6a 调用日志一条")
  断言相等(桩5["调用日志"][0]["能力"], "终结帧编码", "6b 能力名")

  打印 "--- 第6轮 任务B #258 ACP 转码宿主出口 测试通过 ---"

主()