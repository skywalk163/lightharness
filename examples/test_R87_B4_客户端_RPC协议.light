# R87 B4-G3 client connection RPC 协议面 + 认证结构 + 模块图不变式 回归
从 客户端RPC 导入 传输错, 成功结果, 失败结果, 造客户端请求, 造服务端响应帧, 通道合法, 校验通道, 端点段合法, 端点自路径, 校验目标, 解析服务端响应
从 客户端认证 导入 解析Cookie头, 造Cookie名, 造签名信封, 拆签名信封, 校验Cookie窗口
从 客户端模块不变式 导入 校验模块图自洽

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


段落 摘要桩(权威):
  返回 "hashvalue"

段落 路径解析好(标识):
  返回 "/plugins/" + 标识 + "/client.js"

段落 路径解析坏(标识):
  返回 空
段落 主:
  # ---- 结果信封 ----
  设 错 为 传输错("boom")
  断言相等(错["ok"], 假, "传输错 ok 假")
  断言相等(错["error"]["code"], "gateway/internal", "传输错 code")
  断言相等(错["error"]["message"], "boom", "传输错 message")
  设 成 为 成功结果(["a": 1])
  断言相等(成["ok"], 真, "成功结果 ok")
  设 失 为 失败结果("gateway/bad-request", "bad", ["issues": []])
  断言相等(失["error"]["details"]["issues"], [], "失败结果 details 透传")

  # ---- 传输信封 ----
  设 求 为 造客户端请求("r1", "goals/create", ["x": 1])
  断言相等(求["type"], "client-request", "客户端请求 type")
  断言相等(求["method"], "goals/create", "客户端请求 method")
  设 响 为 造服务端响应帧("r1", 成)
  断言相等(响["type"], "server-response", "服务端响应 type")

  # ---- 通道/端点段 ----
  断言相等(通道合法("/rpc"), 真, "通道合法 /rpc")
  断言相等(通道合法("/api"), 真, "通道合法 /api 自身(仅校验形状)")
  断言相等(通道合法("rpc"), 假, "通道非法 缺斜杠")
  断言相等(通道合法("/bad space"), 假, "通道非法 空格")
  断言相等(端点段合法("goals"), 真, "端点段合法")
  断言相等(端点段合法(".."), 假, "端点段拒绝 ..")
  断言相等(端点段合法(""), 假, "端点段拒绝空")
  断言相等(端点段合法("a-b.c_d$e"), 真, "端点段允许 -._$")

  # ---- 端点自路径 ----
  设 ep 为 端点自路径("/rpc", "/rpc/goals/create")
  断言相等(ep, "goals/create", "端点自路径 拆解")
  断言相等(端点自路径("/rpc", "/other/goals"), 空, "端点自路径 前缀不符")
  断言相等(端点自路径("/rpc", "/rpc/goals/../x"), 空, "端点自路径 拒绝 ..")

  # ---- 校验目标 ----
  校验目标("/rpc", "goals/create")
  断言相等(真, 真, "校验目标 通过")

  # ---- 解析服务端响应 ----
  设 解 为 解析服务端响应(["type": "server-response", "rpcId": "r1", "result": ["ok": 真, "value": 42]])
  断言相等(解["rpcId"], "r1", "响应解析 rpcId")
  断言相等(解["result"]["ok"], 真, "响应解析 ok")
  设 解错 为 解析服务端响应(["type": "server-response", "rpcId": "r2", "result": ["ok": 假, "error": ["code": "gateway/x", "message": "m", "details": []]]])
  断言相等(解错["result"]["error"]["code"], "gateway/x", "响应解析 失败 code")

  # ---- Cookie 头解析 ----
  设 c 为 解析Cookie头("dsh-auth-abc=xyz; other=1", "dsh-auth-abc")
  断言相等(c, "xyz", "Cookie头 取值")
  断言相等(解析Cookie头("other=1", "dsh-auth-abc"), 空, "Cookie头 未命中")

  # ---- Cookie 名（摘要注入）----
  设 名 为 造Cookie名("localhost:8080", 摘要桩)
  断言相等(名, "dsh-auth-hashvalue", "Cookie名 派生")

  # ---- 签名信封 ----
  设 env 为 造签名信封("body", "sig")
  断言相等(env, "v1.body.sig", "签名信封 形状")
  设 dec 为 拆签名信封("v1.body.sig")
  断言相等(dec["体"], "body", "拆信封 体")
  断言相等(dec["签"], "sig", "拆信封 签")
  断言相等(拆签名信封("v1.only.two.x"), 空, "拆信封 段数错")

  # ---- Cookie 窗口 ----
  断言相等(校验Cookie窗口(1000, 2000, 1500, 100000), 真, "窗口 有效")
  断言相等(校验Cookie窗口(1000, 1500, 2000, 100000), 假, "窗口 已过期")
  断言相等(校验Cookie窗口(1000, 500, 1500, 100000), 假, "窗口 过期早于签发")

  # ---- 模块图不变式 ----
  设 图 为 [["id": "a", "url": "/plugins/a/client.js"], ["id": "b", "url": "/plugins/b/client.js"]]
  设 好 为 校验模块图自洽(图, 路径解析好)
  断言相等(好["ok"], 真, "模块图 全解析 ok")
  设 坏 为 校验模块图自洽(图, 路径解析坏)
  断言相等(坏["ok"], 假, "模块图 缺解析 失败")
  断言相等(列表长度(坏["失败表"]), 2, "模块图 两行失败")

  写 "test_R87_B4_客户端_RPC协议: 全部通过"

主()
