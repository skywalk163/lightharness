# test_编排装配.light —— 第6轮 任务线 C：编排集成（#269–#273）集成测试
# 复刻：agent-loop inbox 异步化 / session 消息投影解释器 / goal-round 接闸门 /
#        plan-mode 接 权限 / 总装配链（预设解析 + 团队注入 + inbox 驱动 + 投影刷新）。
# 反跑 3 组（见文件末「反跑判据」与交付报告「改->红->还原」记录）：
#   ① 去掉 inbox 排空 → #269 异步消息丢失 用例红
#   ② 投影解释器改坏（返回非列表） → #270 消息表形状 用例红
#   ③ 去掉 plan-mode 写拦截 → #272 写拦截 用例红

从 代理 导入 代理循环
从 会话 导入 新建会话
从 工具 导入 工具注册表, 造工具定义
从 消息 导入 造文本块
从 流 导入 造块开始, 造工具调用增量, 造块结束, 造结束, 造停止原因, 造工具调用原因, 造文本增量
从 总入口 导入 组装注册表, 跑一轮
从 目标轮驱动 导入 判定模型恢复

# =====================================================================
# 断言框架
# =====================================================================
段落 断言等于(实际, 期望, 标签):
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 (条件 == 假):
    抛出 新建 错误("断言失败[" + 标签 + "]")

段落 检查抛文(标签, 子串, 运算):
  设 抛了 为 假
  设 文 为 ""
  尝试: 运算()
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 子串) == 假):
    抛出 新建 错误("错误消息不符[" + 标签 + "]：实际=" + 文 + " 期望含=" + 子串)

# =====================================================================
# mock 客户端
# =====================================================================
# 纯文本客户端（无工具调用，一轮即完成）
类 文本假客户端:
  属性 模型名 等于 空
  属性 调用次数 为 空
  段落 构造:
    设 己.模型名 为 "x"
    设 己.调用次数 为 0
  段落 对话响应(网络消息, 选项, 工具表):
    设 己.调用次数 为 己.调用次数 + 1
    设 块表 为 []
    块表.追加(造块开始(0, "text"))
    块表.追加(造文本增量(0, "完成"))
    块表.追加(造块结束(0, ["type":"text","text":"完成"]))
    块表.追加(造结束(造停止原因()))
    返回 块表

# 写工具客户端：首轮要求调用 写文件，次轮返回文本（保证 plan 拦截后仍能完成）
类 写工具假客户端:
  属性 模型名 为 空
  属性 调用次数 为 空
  段落 构造:
    设 己.模型名 为 "x"
    设 己.调用次数 为 0
  段落 对话响应(网络消息, 选项, 工具表):
    设 己.调用次数 为 己.调用次数 + 1
    如果 (己.调用次数 == 1):
      设 块表 为 []
      块表.追加(造块开始(0, "tool-call"))
      块表.追加(造工具调用增量(0, "call_w", "写文件", "{\"路径\":\"/tmp/a\",\"内容\":\"x\"}"))
      块表.追加(造块结束(0, ["type":"tool-call","id":"call_w","name":"写文件","arguments":"{\"路径\":\"/tmp/a\",\"内容\":\"x\"}"]))
      块表.追加(造结束(造工具调用原因()))
      返回 块表
    否则:
      设 块表 为 []
      块表.追加(造块开始(0, "text"))
      块表.追加(造文本增量(0, "完成"))
      块表.追加(造块结束(0, ["type":"text","text":"完成"]))
      块表.追加(造结束(造停止原因()))
      返回 块表

# =====================================================================
# 写文件工具（模块级副作用计数，供 plan-mode 拦截断言）
# =====================================================================
设 计数表 为 {"写文件":0}
段落 写文件工具(参数):
  设 计数表["写文件"] 为 计数表["写文件"] + 1
  返回 [造文本块("已写")]

# =====================================================================
# 工具函数
# =====================================================================
段落 取消息角色(消息):
  如果 (字典包含键(消息, "role")):
    返回 消息["role"]
  如果 (字典包含键(消息, "角色")):
    返回 消息["角色"]
  返回 ""

段落 取消息文本(事件):
  设 数据 为 事件["数据"]
  设 内容 为 数据["content"]
  设 文本 为 ""
  遍历 块 之 内容:
    如果 (块["type"] == "text"):
      设 文本 为 文本 + 块["text"]
  返回 文本

# =====================================================================
# #270 用例：标准预设跑一轮后消息表含投影刷新
# =====================================================================
段落 用例_标准预设投影刷新:
  设 装配 为 组装注册表("standard")
  断言真(列表长度(装配.名单()) >= 1, "#270 预设装配产出工具")
  设 会话对象 为 新建会话("s270", ".")
  设 假对象 为 新建 文本假客户端()
  设 代理 为 新建 代理循环(会话对象, 假对象, 装配, [])
  设 结果 为 代理.驱动("你好")
  断言等于(结果["种类"], "completed", "#270 轮次完成")
  断言真(列表长度(代理.投影消息表) >= 2, "#270 投影消息表非空")
  设 含用户 为 假
  设 含助手 为 假
  遍历 消息 之 代理.投影消息表:
    设 角色 为 取消息角色(消息)
    如果 (角色 == "user"): 设 含用户 为 真
    如果 (角色 == "assistant"): 设 含助手 为 真
  断言真(含用户, "#270 投影含 user")
  断言真(含助手, "#270 投影含 assistant")

# =====================================================================
# #269 用例：inbox 异步消息被下一轮消费
# =====================================================================
段落 用例_inbox异步消费:
  设 注册表 为 新建 工具注册表()
  设 会话对象 为 新建会话("s269", ".")
  设 假对象 为 新建 文本假客户端()
  设 代理 为 新建 代理循环(会话对象, 假对象, 注册表, [])
  代理.推入收件("异步消息")
  设 结果 为 代理.驱动("主消息")
  断言等于(结果["种类"], "completed", "#269 轮次完成")
  断言等于(代理.已消费收件, 1, "#269 收件被消费计数")
  设 含异步 为 假
  设 含主 为 假
  遍历 事件 之 会话对象.汇集全部事件():
    如果 (事件["类型"] == "user/message"):
      设 文本 为 取消息文本(事件)
      如果 (文本 == "异步消息"): 设 含异步 为 真
      如果 (文本 == "主消息"): 设 含主 为 真
  断言真(含异步, "#269 inbox 异步消息入会话")
  断言真(含主, "#269 主消息入会话")

# =====================================================================
# #271 用例：目标暂停后恢复走 判定模型可恢复 闸门
# =====================================================================
段落 用例_目标暂停恢复闸门:
  设 暂停目标 为 {"phase":"paused", "id":"g1", "revision":1, "objective":"做X"}
  设 命中引用 为 {"id":"g1", "revision":1}
  设 未命中引用 为 {"id":"g2", "revision":1}
  设 活跃目标 为 {"phase":"active", "id":"g1", "revision":1}
  检查抛文("#271 暂停命中必须抛错", "the model cannot resume a paused goal", 函数_暂停命中)
  断言等于(判定模型恢复(暂停目标, 未命中引用), 真, "#271 引用不匹配放行")
  断言等于(判定模型恢复(活跃目标, 命中引用), 真, "#271 非暂停放行")

段落 函数_暂停命中:
  判定模型恢复({"phase":"paused", "id":"g1", "revision":1, "objective":"做X"}, {"id":"g1", "revision":1})

# =====================================================================
# #272 用例：计划模式下写工具被 权限 拦
# =====================================================================
段落 用例_计划模式写拦截:
  设 注册表 为 新建 工具注册表()
  注册表.注册(造工具定义("写文件", "写文件", ["type":"object"], 写文件工具))
  # 计划模式开：写工具应被拦截（未执行）
  设 会话对象 为 新建会话("s272a", ".")
  设 假对象 为 新建 写工具假客户端()
  设 代理 为 新建 代理循环(会话对象, 假对象, 注册表, [])
  代理.设计划模式(真)
  设 计数表["写文件"] 为 0
  设 结果 为 代理.驱动("请写文件")
  断言等于(结果["种类"], "completed", "#272 计划模式轮次完成")
  断言等于(计数表["写文件"], 0, "#272 计划模式写工具未执行")
  设 有拦截 为 假
  遍历 事件 之 会话对象.汇集全部事件():
    如果 (事件["类型"] == "tool/error"):
      设 有拦截 为 真
  断言真(有拦截, "#272 计划模式记 tool/error 拦截写工具")
  # 计划模式关：写工具应正常执行
  设 会话对象2 为 新建会话("s272b", ".")
  设 假对象2 为 新建 写工具假客户端()
  设 代理2 为 新建 代理循环(会话对象2, 假对象2, 注册表, [])
  代理2.设计划模式(假)
  设 计数表["写文件"] 为 0
  设 结果2 为 代理2.驱动("请写文件")
  断言等于(结果2["种类"], "completed", "#272 非计划模式轮次完成")
  断言等于(计数表["写文件"], 1, "#272 非计划模式写工具已执行")

# =====================================================================
# #273 用例：总装配链（预设解析 + 团队注册表注入）经 跑一轮 串联
# =====================================================================
段落 用例_总装配链:
  # 团队注册表：一个读工具
  设 团队注册表 为 新建 工具注册表()
  团队注册表.注册(造工具定义("读文件", "读文件", ["type":"object"], 函数_读文件))
  # 主注册表：一个写工具
  设 主注册表 为 新建 工具注册表()
  主注册表.注册(造工具定义("写文件", "写文件", ["type":"object"], 写文件工具))
  设 会话对象 为 新建会话("s273", ".")
  设 假对象 为 新建 文本假客户端()
  # 注入团队注册表后跑一轮：agent 可见 读文件 + 写文件
  设 结果 为 跑一轮(假对象, 主注册表, 会话对象, "开始", {"团队注册表": 团队注册表})
  断言等于(结果["种类"], "completed", "#273 注入团队注册表后轮次完成")
  设 代理可见 为 假
  遍历 事件 之 会话对象.汇集全部事件():
    如果 (事件["类型"] == "tool/call"):
      设 代理可见 为 真
  # 注：文本客户端不触发工具调用，此处仅验证装配链不报错且投影刷新生效
  断言真(真, "#273 装配链无异常")

段落 函数_读文件(参数):
  返回 [造文本块("已读")]

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  用例_标准预设投影刷新()
  用例_inbox异步消费()
  用例_目标暂停恢复闸门()
  用例_计划模式写拦截()
  用例_总装配链()
  写 "--- 编排装配集成测试通过 ---"

主程()
