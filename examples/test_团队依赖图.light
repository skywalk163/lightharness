从 团队依赖图 导入 构造团队标识, 构造任务标识, 构造消息标识, 构造任务快照, 构造等待结果, 构造成员快照, 构造成员通知, 构造任务通知, 构造排队通知, 构造送达通知, 构造团队错误, 构造接线错误, 判定团队错误, 必需文本, 写范围, 校验任务接线

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言失败(期望真): " + 标签)

段落 主:
  测试类型层()
  测试错误层()
  测试必需文本()
  测试写范围()
  测试任务接线()
  写 "团队依赖图 全部测试通过"

# ===========================================================
# 类型层测试（对齐 types.ts）
# ===========================================================
段落 测试类型层:
  断言相等(构造团队标识("t1"), "t1", "构造团队标识")
  断言相等(构造任务标识("tk1"), "tk1", "构造任务标识")
  断言相等(构造消息标识("m1"), "m1", "构造消息标识")
  设 快照 为 构造任务快照("t1", 1, "主题", "描述", "pending", 空, [], [])
  断言相等(快照["id"], "t1", "快照 id")
  断言相等(快照["revision"], 1, "快照 revision")
  断言相等(快照["subject"], "主题", "快照 subject")
  断言相等(快照["description"], "描述", "快照 description")
  断言相等(快照["status"], "pending", "快照 status")
  断言相等(字典包含键(快照, "ownerId"), 假, "ownerId 可选不设")
  断言相等(快照["blockedBy"], [], "快照 blockedBy 空")
  断言相等(快照["writeScopes"], [], "快照 writeScopes 空")
  设 快照2 为 构造任务快照("t2", 2, "主题2", "描述2", "in_progress", "m1", ["t1"], ["src"])
  断言相等(快照2["ownerId"], "m1", "ownerId 已设")
  断言相等(快照2["blockedBy"], ["t1"], "blockedBy 已设")
  断言相等(快照2["writeScopes"], ["src"], "writeScopes 已设")
  断言相等(构造等待结果(真)["timedOut"], 真, "等待结果 已超时")
  断言相等(构造等待结果(假)["timedOut"], 假, "等待结果 未超时")
  设 成员快照 为 构造成员快照("m1", "成员1", "描述", "deepseek", {}, "active", 空)
  断言相等(成员快照["id"], "m1", "成员快照 id")
  断言相等(成员快照["provider"], "deepseek", "成员快照 provider")
  断言相等(字典包含键(成员快照, "error"), 假, "error 可选不设")
  设 成员通知 为 构造成员通知("team1", 成员快照)
  断言相等(成员通知["version"], 1, "成员通知 version")
  断言相等(成员通知["teamId"], "team1", "成员通知 teamId")
  设 任务通知 为 构造任务通知("team1", 快照)
  断言相等(任务通知["version"], 1, "任务通知 version")
  断言相等(任务通知["teamId"], "team1", "任务通知 teamId")
  设 排队通知 为 构造排队通知("team1", 快照)
  断言相等(排队通知["version"], 1, "排队通知 version")
  断言相等(排队通知["teamId"], "team1", "排队通知 teamId")
  设 送达通知 为 构造送达通知("team1", "m1", "m2")
  断言相等(送达通知["version"], 1, "送达通知 version")
  断言相等(送达通知["messageId"], "m1", "送达通知 messageId")
  断言相等(送达通知["targetId"], "m2", "送达通知 targetId")

# ===========================================================
# 错误层测试（对齐 error.ts）
# ===========================================================
段落 测试错误层:
  设 错误对象 为 构造团队错误("test message", "TEAM_INVALID_ARGUMENT")
  断言相等(错误对象["名"], "TeamError", "团队错误 名")
  断言相等(错误对象["code"], "TEAM_INVALID_ARGUMENT", "团队错误 code")
  断言相等(错误对象["消息"], "test message", "团队错误 消息")
  设 接线错误对象 为 构造接线错误("cycle error", "cycle")
  断言相等(接线错误对象["名"], "TeamTaskGraphError", "接线错误 名")
  断言相等(接线错误对象["violation"], "cycle", "接线错误 violation")
  断言真(字典包含键(接线错误对象, "消息"), "接线错误有消息键")
  断言相等(判定团队错误("hello"), "hello", "字符串归一")
  断言相等(判定团队错误({"消息": "test"}), "test", "字典归一")
  断言相等(判定团队错误(123), "123", "数字归一")

# ===========================================================
# 校验层测试：必需文本（对齐 requiredText）
# ===========================================================
段落 测试必需文本:
  断言相等(必需文本("hello", "name", 10), "hello", "正常文本")
  断言相等(必需文本("  hello  ", "name", 10), "hello", "空白 trim")
  断言相等(必需文本("hello", "name", 5), "hello", "恰好上限")
  断言相等(必需文本("hi", "name", 2), "hi", "短文本上限")
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    必需文本("", "name", 10)
  捕获 异常 e:
    设 抛了 为 真
    设 消息 为 文本(e)
  断言相等(抛了, 真, "空文本抛错")
  断言真(字符串包含(消息, "non-empty"), "空文本消息含 non-empty")
  断言真(字符串包含(消息, "name"), "空文本消息含字段名")
  设 抛了2 为 假
  尝试:
    必需文本("   ", "field", 10)
  捕获 异常 e:
    设 抛了2 为 真
  断言相等(抛了2, 真, "纯空白抛错")
  设 抛了3 为 假
  设 消息3 为 ""
  尝试:
    必需文本("hello!", "name", 5)
  捕获 异常 e:
    设 抛了3 为 真
    设 消息3 为 文本(e)
  断言相等(抛了3, 真, "超长抛错")
  断言真(字符串包含(消息3, "exceeds"), "超长消息含 exceeds")
  断言真(字符串包含(消息3, "name"), "超长消息含字段名")
  断言真(字符串包含(消息3, "5"), "超长消息含上限值")

# ===========================================================
# 校验层测试：写范围（对齐 writeScope）
# ===========================================================
段落 测试写范围:
  断言相等(写范围("src/lib"), "src/lib", "正常路径")
  断言相等(写范围("src\\lib"), "src/lib", "反斜杠归一")
  断言相等(写范围("./src/lib"), "src/lib", "去前导点斜")
  断言相等(写范围("src/lib/"), "src/lib", "去尾部斜")
  断言相等(写范围("src/lib//"), "src/lib", "去多尾部斜")
  断言相等(写范围("src\\lib/sub"), "src/lib/sub", "混合斜杠")
  断言相等(写范围("a"), "a", "单字符")
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    写范围("/abs")
  捕获 异常 e:
    设 抛了 为 真
    设 消息 为 文本(e)
  断言相等(抛了, 真, "根路径抛错")
  断言真(字符串包含(消息, "invalid"), "根路径消息含 invalid")
  设 抛了2 为 假
  尝试:
    写范围("C:foo")
  捕获 异常 e:
    设 抛了2 为 真
  断言相等(抛了2, 真, "大写盘符抛错")
  设 抛了3 为 假
  尝试:
    写范围("c:foo")
  捕获 异常 e:
    设 抛了3 为 真
  断言相等(抛了3, 真, "小写盘符抛错")
  设 抛了4 为 假
  尝试:
    写范围("src//lib")
  捕获 异常 e:
    设 抛了4 为 真
  断言相等(抛了4, 真, "空段抛错")
  设 抛了5 为 假
  尝试:
    写范围("src/./lib")
  捕获 异常 e:
    设 抛了5 为 真
  断言相等(抛了5, 真, "点段抛错")
  设 抛了6 为 假
  设 消息6 为 ""
  尝试:
    写范围("src/../lib")
  捕获 异常 e:
    设 抛了6 为 真
    设 消息6 为 文本(e)
  断言相等(抛了6, 真, "双点段抛错")
  断言真(字符串包含(消息6, "invalid"), "双点段消息含 invalid")
  设 抛了7 为 假
  尝试:
    写范围("")
  捕获 异常 e:
    设 抛了7 为 真
  断言相等(抛了7, 真, "空字符串抛错")

# ===========================================================
# 依赖图层测试（对齐 assertTaskGraphCandidate）
# 四类违规：缺失(missing)、重复(duplicate)、自我(cycle)、环(cycle)
# ===========================================================
段落 测试任务接线:
  # 空表 + 无依赖候选 -> 不抛
  设 候选1 为 构造任务快照("t1", 1, "主题", "描述", "pending", 空, [], [])
  设 抛了1 为 假
  尝试:
    校验任务接线({}, 候选1)
  捕获 异常 e:
    设 抛了1 为 真
  断言相等(抛了1, 假, "空表无依赖不抛")
  # 依赖已有任务 -> 不抛
  设 当前表 为 {}
  当前表["t1"] 为 构造任务快照("t1", 1, "主题", "描述", "pending", 空, [], [])
  设 候选2 为 构造任务快照("t2", 1, "主题2", "描述2", "pending", 空, ["t1"], [])
  设 抛了2 为 假
  尝试:
    校验任务接线(当前表, 候选2)
  捕获 异常 e:
    设 抛了2 为 真
  断言相等(抛了2, 假, "依赖已有任务不抛")
  # 缺失前置 -> 抛错
  设 候选3 为 构造任务快照("t3", 1, "主题3", "描述3", "pending", 空, ["nonexistent"], [])
  设 抛了3 为 假
  设 消息3 为 ""
  尝试:
    校验任务接线({}, 候选3)
  捕获 异常 e:
    设 抛了3 为 真
    设 消息3 为 文本(e)
  断言相等(抛了3, 真, "缺失前置抛错")
  断言真(字符串包含(消息3, "missing"), "缺失前置消息含 missing")
  # 依赖已删除任务 -> 抛错
  设 当前表2 为 {}
  当前表2["del"] 为 构造任务快照("del", 1, "主题", "描述", "deleted", 空, [], [])
  设 候选4 为 构造任务快照("t4", 1, "主题", "描述", "pending", 空, ["del"], [])
  设 抛了4 为 假
  设 消息4 为 ""
  尝试:
    校验任务接线(当前表2, 候选4)
  捕获 异常 e:
    设 抛了4 为 真
    设 消息4 为 文本(e)
  断言相等(抛了4, 真, "依赖已删抛错")
  断言真(字符串包含(消息4, "missing"), "依赖已删消息含 missing")
  # 自我依赖 -> 抛错
  设 候选5 为 构造任务快照("t5", 1, "主题", "描述", "pending", 空, ["t5"], [])
  设 抛了5 为 假
  设 消息5 为 ""
  尝试:
    校验任务接线({}, 候选5)
  捕获 异常 e:
    设 抛了5 为 真
    设 消息5 为 文本(e)
  断言相等(抛了5, 真, "自我依赖抛错")
  断言真(字符串包含(消息5, "block itself"), "自我依赖消息含 block itself")
  # 重复阻塞 -> 抛错
  设 当前表3 为 {}
  当前表3["A"] 为 构造任务快照("A", 1, "主题", "描述", "pending", 空, [], [])
  设 候选6 为 构造任务快照("t6", 1, "主题", "描述", "pending", 空, ["A", "A"], [])
  设 抛了6 为 假
  设 消息6 为 ""
  尝试:
    校验任务接线(当前表3, 候选6)
  捕获 异常 e:
    设 抛了6 为 真
    设 消息6 为 文本(e)
  断言相等(抛了6, 真, "重复阻塞抛错")
  断言真(字符串包含(消息6, "repeats"), "重复阻塞消息含 repeats")
  # 双任务环 -> 抛错
  设 当前表4 为 {}
  当前表4["A"] 为 构造任务快照("A", 1, "主题", "描述", "pending", 空, ["B"], [])
  设 候选7 为 构造任务快照("B", 1, "主题", "描述", "pending", 空, ["A"], [])
  设 抛了7 为 假
  设 消息7 为 ""
  尝试:
    校验任务接线(当前表4, 候选7)
  捕获 异常 e:
    设 抛了7 为 真
    设 消息7 为 文本(e)
  断言相等(抛了7, 真, "双任务环抛错")
  断言真(字符串包含(消息7, "cycle"), "双任务环消息含 cycle")
  # 三任务环 -> 抛错
  设 当前表5 为 {}
  当前表5["A"] 为 构造任务快照("A", 1, "主题", "描述", "pending", 空, ["B"], [])
  当前表5["B"] 为 构造任务快照("B", 1, "主题", "描述", "pending", 空, ["C"], [])
  设 候选8 为 构造任务快照("C", 1, "主题", "描述", "pending", 空, ["A"], [])
  设 抛了8 为 假
  设 消息8 为 ""
  尝试:
    校验任务接线(当前表5, 候选8)
  捕获 异常 e:
    设 抛了8 为 真
    设 消息8 为 文本(e)
  断言相等(抛了8, 真, "三任务环抛错")
  断言真(字符串包含(消息8, "cycle"), "三任务环消息含 cycle")
  # 无环链式 -> 不抛
  设 当前表6 为 {}
  当前表6["A"] 为 构造任务快照("A", 1, "主题", "描述", "pending", 空, ["B"], [])
  当前表6["B"] 为 构造任务快照("B", 1, "主题", "描述", "pending", 空, ["C"], [])
  设 候选9 为 构造任务快照("C", 1, "主题", "描述", "pending", 空, [], [])
  设 抛了9 为 假
  尝试:
    校验任务接线(当前表6, 候选9)
  捕获 异常 e:
    设 抛了9 为 真
  断言相等(抛了9, 假, "无环链式不抛")
  # 菱形依赖 -> 不抛
  设 当前表7 为 {}
  当前表7["A"] 为 构造任务快照("A", 1, "主题", "描述", "pending", 空, ["B", "C"], [])
  当前表7["B"] 为 构造任务快照("B", 1, "主题", "描述", "pending", 空, ["D"], [])
  当前表7["C"] 为 构造任务快照("C", 1, "主题", "描述", "pending", 空, ["D"], [])
  设 候选10 为 构造任务快照("D", 1, "主题", "描述", "pending", 空, [], [])
  设 抛了10 为 假
  尝试:
    校验任务接线(当前表7, 候选10)
  捕获 异常 e:
    设 抛了10 为 真
  断言相等(抛了10, 假, "菱形依赖不抛")
  # 已删除任务不参与校验 -> 不抛
  设 当前表8 为 {}
  当前表8["del"] 为 构造任务快照("del", 1, "主题", "描述", "deleted", 空, ["del"], [])
  设 候选11 为 构造任务快照("t11", 1, "主题", "描述", "pending", 空, [], [])
  设 抛了11 为 假
  尝试:
    校验任务接线(当前表8, 候选11)
  捕获 异常 e:
    设 抛了11 为 真
  断言相等(抛了11, 假, "已删除任务不参与校验")
  # 候选替换已有任务 -> 不抛
  设 当前表9 为 {}
  当前表9["t1"] 为 构造任务快照("t1", 1, "主题", "描述", "deleted", 空, [], [])
  设 候选12 为 构造任务快照("t1", 2, "新主题", "新描述", "pending", 空, [], [])
  设 抛了12 为 假
  尝试:
    校验任务接线(当前表9, 候选12)
  捕获 异常 e:
    设 抛了12 为 真
  断言相等(抛了12, 假, "候选替换已有任务不抛")

# 反跑判据：
#   必需文本：空文本不抛 -> 红；超长不抛 -> 红；纯空白不抛 -> 红
#   写范围：根路径放行 -> 红；盘符放行 -> 红；.. 放行 -> 红；空段放行 -> 红；空字符串放行 -> 红
#   校验任务接线：缺前置误判通过 -> 红；自我依赖放行 -> 红；重复放行 -> 红；双任务环放行 -> 红；三任务环放行 -> 红

主()
