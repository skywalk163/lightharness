# test_R38_工具展示.light —— 第 38 轮 任务 1 判据：agent-tool-presentation 复刻
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/agent-tool-presentation/
#   src/index.ts（72 行） + tests/agent-tool-presentation.spec.ts（8 契约映射）
# 运行：cd lightharness && python 运行.py examples/test_R38_工具展示.light
# 覆盖：建配置/校验/应用native/应用ptc(有/无codeRuntime)/应用both/作用域隔离/
#       卸载恢复/获取可见工具/生成SDK/代理注册表联动（Task 2 适配层）

从 内置核心字符串 导入 字符串包含
从 工具 导入 工具注册表, 造工具定义
从 代码运行时 导入 代码运行时
从 工具展示 导入 工具展示插件名, 工具展示依赖, 工具展示模式表
从 工具展示 导入 校验展示模式, 建工具展示配置, 校验工具展示配置
从 工具展示 导入 获取作用域展示, 应用工具展示, 注销工具展示
从 工具展示 导入 是否待代码运行时, 等待代码运行时
从 工具展示 导入 获取可见工具, 生成工具SDK
从 工具展示 导入 工具展示注册表代理, 造代理工具展示

# ---- 测试桩执行函数（仅返回文本块，够测试代理委托用）----
段落 示例执行(参数):
  返回 [["type": "text", "text": "ok"]]

# ---- 造一个含 3 工具的注册表（echo/search/write_file）----
段落 造样例注册表:
  设 表 为 新建 工具注册表()
  表.注册(造工具定义("echo", "回声工具。", ["type": "object", "properties": ["值": ["type": "string"]], "required": ["值"]], 示例执行))
  表.注册(造工具定义("search", "在代码中搜索。", ["type": "object", "properties": ["关键词": ["type": "string"]], "required": ["关键词"]], 示例执行))
  表.注册(造工具定义("write_file", "写入文件。", ["type": "object", "properties": ["路径": ["type": "string"]], "required": ["路径"]], 示例执行))
  返回 表

# ---- 取 schema 列表中的名字列表（供对比工具差异）----
段落 取名字(列表):
  设 结果 为 []
  遍历 t 之 列表:
    结果.追加(t["name"])
  返回 结果

段落 必等(实际, 期望, 编号):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际 " + 转字符串(实际) + "，期望 " + 转字符串(期望))
  返回 真

段落 主:
  设 计数 为 0

  # ===== #00 判据自检：断言助手必须真能报错 =====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    必等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检报错 为 真
  必等(自检报错, 真, "00")
  打印 "OK #00"

  # ===== 常量与依赖（上游 inject=['tools']，mode 必填）=====
  设 计数 为 计数 + 1
  必等(工具展示插件名, "tool-presentation", "01")
  必等(工具展示依赖, ["tools"], "01b")
  必等(工具展示模式表, ["native", "ptc", "both"], "01c")
  打印 "OK #01-01c"

  # ===== §1 建配置 + 校验展示模式（mode 必填、枚举）=====
  设 计数 为 计数 + 1
  设 配置 为 建工具展示配置("ptc")
  必等(校验工具展示配置(配置), 真, "02")
  必等(配置["模式"], "ptc", "02b")
  必等(校验展示模式("native"), 真, "02c")
  必等(校验展示模式("ptc"), 真, "02d")
  必等(校验展示模式("both"), 真, "02e")
  必等(校验展示模式("其他"), 假, "02f")
  必等(校验展示模式(空), 假, "02g")
  打印 "OK #02-02g"

  # mode 必填 / 非法值 → 抛错（对齐上游 Config({}) 抛错）
  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    建工具展示配置(空)
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  尝试:
    建工具展示配置("bad")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  必等(抛错数, 2, "03")
  打印 "OK #03"

  # ===== §2 native 应用 + 获取可见工具（全部工具）=====
  设 计数 为 计数 + 1
  设 注册表 为 造样例注册表()
  设 配置N 为 建工具展示配置("native")
  设 注销器N 为 应用工具展示(配置N, "scope_native", 注册表)
  必等(获取作用域展示("scope_native"), "native", "04")
  必等(是否待代码运行时(配置N), 假, "04b")
  设 可见N 为 取名字(获取可见工具("scope_native", 注册表))
  必等(可见N, ["echo", "search", "write_file"], "04c")
  打印 "OK #04-04c"

  # ===== §3 ptc 应用（有 codeRuntime）→ 仅 run_code =====
  设 计数 为 计数 + 1
  设 运行时 为 新建 代码运行时(30)
  设 配置P 为 建工具展示配置("ptc")
  设 注销器P 为 应用工具展示(配置P, "scope_ptc", 注册表, 运行时)
  必等(获取作用域展示("scope_ptc"), "ptc", "05")
  必等(配置P["已应用"], 真, "05b")
  设 可见P 为 取名字(获取可见工具("scope_ptc", 注册表))
  必等(可见P, ["run_code"], "05c")
  打印 "OK #05-05c"

  # ===== §4 ptc 应用（无 codeRuntime）→ pending，回退全量 =====
  设 计数 为 计数 + 1
  设 配置Q 为 建工具展示配置("ptc")
  设 注销器Q 为 应用工具展示(配置Q, "scope_pending", 注册表)
  必等(是否待代码运行时(配置Q), 真, "06")
  必等(获取作用域展示("scope_pending"), "native", "06b")
  设 可见Q 为 取名字(获取可见工具("scope_pending", 注册表))
  必等(可见Q, ["echo", "search", "write_file"], "06c")
  打印 "OK #06-06c"

  # ===== §5 等待 codeRuntime 到达后应用（pending → ptc）=====
  设 计数 为 计数 + 1
  设 运行时2 为 新建 代码运行时(30)
  等待代码运行时(配置Q, 运行时2)
  必等(是否待代码运行时(配置Q), 假, "07")
  必等(获取作用域展示("scope_pending"), "ptc", "07b")
  设 可见Q2 为 取名字(获取可见工具("scope_pending", 注册表))
  必等(可见Q2, ["run_code"], "07c")
  打印 "OK #07-07c"

  # ===== §6 both 应用（有 codeRuntime）→ echo/search/write_file + run_code =====
  设 计数 为 计数 + 1
  设 运行时3 为 新建 代码运行时(30)
  设 配置B 为 建工具展示配置("both")
  应用工具展示(配置B, "scope_both", 注册表, 运行时3)
  必等(获取作用域展示("scope_both"), "both", "08")
  设 可见B 为 取名字(获取可见工具("scope_both", 注册表))
  必等(可见B, ["echo", "search", "write_file", "run_code"], "08b")
  打印 "OK #08-08b"

  # ===== §7 作用域隔离（一个 ptc，一个 native，互不影响）=====
  设 计数 为 计数 + 1
  设 运行时4 为 新建 代码运行时(30)
  应用工具展示(建工具展示配置("ptc"), "coded", 注册表, 运行时4)
  应用工具展示(建工具展示配置("native"), "plain", 注册表)
  必等(取名字(获取可见工具("coded", 注册表)), ["run_code"], "09")
  必等(取名字(获取可见工具("plain", 注册表)), ["echo", "search", "write_file"], "09b")
  打印 "OK #09-09b"

  # ===== §8 卸载恢复（HMR 安全）→ 回退部署默认（全量）=====
  设 计数 为 计数 + 1
  设 配置U 为 建工具展示配置("ptc")
  设 注销器U 为 应用工具展示(配置U, "scope_unload", 注册表, 运行时4)
  必等(取名字(获取可见工具("scope_unload", 注册表)), ["run_code"], "10")
  注销工具展示(注销器U)
  必等(获取作用域展示("scope_unload"), "native", "10b")
  必等(取名字(获取可见工具("scope_unload", 注册表)), ["echo", "search", "write_file"], "10c")
  必等(注销器U["已应用"], 假, "10d")
  打印 "OK #10-10d"

  # ===== §9 生成工具 SDK（ptc/both 提供 run_code 可调用工具清单）=====
  设 计数 为 计数 + 1
  设 sdk 为 生成工具SDK(注册表)
  必等(长(sdk["条目"]), 3, "11")
  必等(字符串包含(sdk["文本"], "echo"), 真, "11b")
  必等(字符串包含(sdk["文本"], "search"), 真, "11c")
  必等(字符串包含(sdk["文本"], "write_file"), 真, "11d")
  打印 "OK #11-11d"

  # ===== §10 代理注册表代理（Task 2 零修改适配层，端到端）=====
  设 计数 为 计数 + 1
  设 运行时5 为 新建 代码运行时(30)
  设 包络 为 造代理工具展示("scope_proxy", 注册表, "ptc", 运行时5)
  设 代理注册表 为 包络["代理注册表"]
  # 覆盖 描述表() → 按作用域过滤
  必等(取名字(代理注册表.描述表()), ["run_code"], "12")
  # 委托 执行 / 执行策略 原样转发
  设 结果 为 代理注册表.执行("echo", "{\"值\":\"x\"}")
  必等(结果["isError"], 假, "12b")
  必等(代理注册表.执行策略("echo"), "exclusive", "12c")
  必等(代理注册表.有无("search"), 真, "12d")
  打印 "OK #12-12d"

  # ===== §11 代理 pending → 运行时到达后代理自动切换 =====
  设 计数 为 计数 + 1
  设 包络2 为 造代理工具展示("scope_proxy2", 注册表, "ptc")
  设 代理2 为 包络2["代理注册表"]
  必等(取名字(代理2.描述表()), ["echo", "search", "write_file"], "13")
  等待代码运行时(包络2["配置"], 新建 代码运行时(30))
  必等(取名字(代理2.描述表()), ["run_code"], "13b")
  注销工具展示(包络2["注销器"])
  必等(取名字(代理2.描述表()), ["echo", "search", "write_file"], "13c")
  打印 "OK #13-13c"

  打印 "工具展示 判据通过：" + 转字符串(计数) + " 组"

主()
