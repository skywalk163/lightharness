    断言相等(内层19(加一), 20, "推迟执行 形参作函数")
    段落 内层变量(函数值):
        返回 函数值 + 100
    断言相等(内层变量(1), 101, "形参作变量")
    段落 二层外():
        段落 二层内(返回值):
            段落 三层内(尝试结果):
                返回 返回值 * 10 + 尝试结果
            返回 三层内(2)
        返回 二层内(1)
    断言相等(二层外(), 12, "三层嵌套形参")
