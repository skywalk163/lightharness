# test_R21_L152家族嵌套形参.light —— 第21轮 任务4：L-152 家族（嵌套段落关键字前缀形参）
# 覆盖：19 个关键字前缀形参（形参作函数调用/作变量）+ 2层/3层嵌套。全部 rc=0 自校验。

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
    如果 条件 != 真:
        抛出 新建 错误("断言真失败: " + 标签)

段落 加一(输入):
    返回 输入 + 1


段落 主:
    段落 内层1(函数值):
        返回 函数值(1)
    断言相等(内层1(加一), 2, "函数值 形参作函数")
    段落 内层2(返回值):
        返回 返回值(2)
    断言相等(内层2(加一), 3, "返回值 形参作函数")
    段落 内层3(尝试结果):
        返回 尝试结果(3)
    断言相等(内层3(加一), 4, "尝试结果 形参作函数")
    段落 内层4(设值器):
        返回 设值器(4)
    断言相等(内层4(加一), 5, "设值器 形参作函数")
    段落 内层5 接收 等于判断:
        返回 等于判断(5)
    断言相等(内层5(加一), 6, "等于判断 形参作函数")
    段落 内层6(如果条件):
        返回 如果条件(6)
    断言相等(内层6(加一), 7, "如果条件 形参作函数")
    段落 内层7(当循环):
        返回 当循环(7)
    断言相等(内层7(加一), 8, "当循环 形参作函数")
    段落 内层8(遍历器):
        返回 遍历器(8)
    断言相等(内层8(加一), 9, "遍历器 形参作函数")
    段落 内层9(捕获块):
        返回 捕获块(9)
    断言相等(内层9(加一), 10, "捕获块 形参作函数")
    段落 内层10(抛出异常):
        返回 抛出异常(10)
    断言相等(内层10(加一), 11, "抛出异常 形参作函数")
    段落 内层11(打印函数):
        返回 打印函数(11)
    断言相等(内层11(加一), 12, "打印函数 形参作函数")
    段落 内层12(新建对象):
        返回 新建对象(12)
    断言相等(内层12(加一), 13, "新建对象 形参作函数")
    段落 内层13(导入模块):
        返回 导入模块(13)
    断言相等(内层13(加一), 14, "导入模块 形参作函数")
    段落 内层14(导出名称):
        返回 导出名称(14)
    断言相等(内层14(加一), 15, "导出名称 形参作函数")
    段落 内层15(定义变量):
        返回 定义变量(15)
    断言相等(内层15(加一), 16, "定义变量 形参作函数")
    段落 内层16(设置属性):
        返回 设置属性(16)
    断言相等(内层16(加一), 17, "设置属性 形参作函数")
    段落 内层17(异步作用域):
        返回 异步作用域(17)
    断言相等(内层17(加一), 18, "异步作用域 形参作函数")
    段落 内层18(等待结果):
        返回 等待结果(18)
    断言相等(内层18(加一), 19, "等待结果 形参作函数")
    段落 内层19(推迟执行):
