从 客户端 导入 客户端

段落 主:
  # 测试1：默认超时秒为60
  设 客户端1 为 新建 客户端("https://api.deepseek.com", "test-key", "deepseek-chat")
  断言 客户端1.超时秒 == 60, "默认超时秒应为60"
  打印("测试1通过：默认超时秒60")

  # 测试2：构造函数传入选项["超时秒"]
  设 客户端2 为 新建 客户端("https://api.deepseek.com", "test-key", "deepseek-chat", ["超时秒": 120])
  断言 客户端2.超时秒 == 120, "自定义超时秒应为120"
  打印("测试2通过：自定义超时秒120")

  # 测试3：选项为空时使用默认值
  设 客户端3 为 新建 客户端("https://api.deepseek.com", "test-key", "deepseek-chat", 空)
  断言 客户端3.超时秒 == 60, "选项为空时超时秒应为60"
  打印("测试3通过：选项为空使用默认值")

  # 测试4：选项不含超时秒时使用默认值
  设 客户端4 为 新建 客户端("https://api.deepseek.com", "test-key", "deepseek-chat", ["其他选项": "值"])
  断言 客户端4.超时秒 == 60, "选项不含超时秒时应为60"
  打印("测试4通过：选项不含超时秒使用默认值")

  # 测试5：超时秒为0时使用默认值（协程路径）
  # 验证对话响应协程的默认超时逻辑（不实际调用，只验证属性）
  设 客户端5 为 新建 客户端("https://api.deepseek.com", "test-key", "deepseek-chat", ["超时秒": 30])
  断言 客户端5.超时秒 == 30, "超时秒应为30"
  打印("测试5通过：超时秒30")

  # 测试6：模型名/端点/密钥不受选项影响
  断言 客户端2.端点 == "https://api.deepseek.com", "端点应正确"
  断言 客户端2.密钥 == "test-key", "密钥应正确"
  断言 客户端2.模型名 == "deepseek-chat", "模型名应正确"
  打印("测试6通过：其他属性不受选项影响")

  打印("--- 客户端超时配置v2测试通过 ---")

主()
