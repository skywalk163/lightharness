# test_存储核心.light —— 第15轮 任务2（存储核心与JSON域）对齐判据
# 运行：LIGHT_MERGE=...light-merge python 运行.py examples/test_存储核心.light
# 上游：packages/storage/storage/src/（backend/error/registry）+ storage-json/src/（format/per-record-unit/single-unit）
#
# 覆盖：单元名与记录键规则 / 注册表（注册/查找/名单/重复/缺失含 registered 列表与 none/disposer 匹配语义）/
#   错误码文本形态 / 单元文档六步校验链（JSON 坏/非对象/外来头/版本不符/tables 非对象/表值非对象/多余表忽略/
#   缺表空）/ 记录文档版本过滤（畸形过期读作缺席）/ 单记录单元（round-trip/删除幂等/键安全/未声明表/
#   未声明全局槽/legacy 兄弟文件引导/备份时间戳）/ 单文件单元（批量读写/空文件打开/部分写入/内存快照）/
#   内存后端（写入读取 round-trip/close 拒绝/重开持久/重复打开拒绝）
#
# 反跑判据（改源码一行测试必须红，恢复后绿）：
#   A=正常：内存后端写入->读取 round-trip 数据一致（回归绿验证）
#   B=边界：空存储单元批量读取返回空列表不报错（回归绿验证）
#   C=变异：取后端 的 NotFound 消息改错 -> 测试立红

从 存储核心 导入 造内存后端, 存储错误文本, 断言单元名, 断言记录键, 造后端注册表, 注册后端, 取后端, 列出后端名, 移除后端, 造单元描述符, 序列化单元文档, 解析单元文档, 序列化记录文档, 解析记录文档, 造单记录单元, 载入全部, 写入记录, 删除记录, 备份记录, 设置全局, 断言打开, 关闭单元, 造单文件单元, 单文件写入记录, 单文件删除记录, 单文件设置全局, 单文件载入全部, 打开单元, 关闭后端

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 标签)

段落 断言含 接收 文本, 子串, 标签:
  如果 查找子串(文本, 子串) < 0:
    抛出 新建 错误("断言含失败: " + 标签 + " 文本=" + 转字符串(文本))

段落 检查抛错含 接收 标签, 子串, 运算:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    设 忽略 为 运算()
  捕获 错误 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)
  断言含(消息, 子串, 标签 + "（文案）")

# ---------- 抛错场景 ----------
段落 场注册重名:
  设 注册表 为 造后端注册表()
  注册后端(注册表, "甲后端", ["标记": 1])
  注册后端(注册表, "甲后端", ["标记": 2])

段落 场取未注册:
  取后端(造后端注册表(), "幽灵")

段落 场单元名大写:
  断言单元名("Kv")

段落 场单元名数字头:
  断言单元名("1kv")

段落 场键不安全:
  断言记录键("kv", "坏/键")

段落 场文档坏JSON:
  解析单元文档("不是JSON", 造单元描述符("kv", 1, [], 假, 空, 空))

段落 场文档非对象:
  解析单元文档("[1]", 造单元描述符("kv", 1, [], 假, 空, 空))

段落 场文档外来头:
  解析单元文档("{\"unit\":{\"name\":\"别处\",\"version\":1},\"tables\":{}}", 造单元描述符("kv", 1, [], 假, 空, 空))

段落 场文档版本不符:
  解析单元文档("{\"unit\":{\"name\":\"kv\",\"version\":9},\"tables\":{}}", 造单元描述符("kv", 1, [], 假, 空, 空))

段落 场文档表坏:
  解析单元文档("{\"unit\":{\"name\":\"kv\",\"version\":1},\"tables\":[]}", 造单元描述符("kv", 1, [], 假, 空, 空))

段落 场文档行值坏:
  解析单元文档("{\"unit\":{\"name\":\"kv\",\"version\":1},\"tables\":{\"任务\": [\"数组\"]}}", 造单元描述符("kv", 1, ["任务"], 假, 空, 空))

段落 场未声明表:
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空), "根")
  写入记录(单元, "未声明", "k", "v")

段落 场键不安全写:
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空), "根")
  写入记录(单元, "任务", "坏/键", "v")

段落 场全局未声明:
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空), "根")
  设置全局(单元, "值")

段落 场关后写:
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空), "根")
  关闭单元(单元)
  写入记录(单元, "任务", "k", "v")

段落 场备份缺记录:
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空), "根")
  备份记录(单元, "任务", "无", "202609131200")

段落 场单文件未声明全局:
  设 介质 为 {}
  设 单元 为 造单文件单元(介质, 造单元描述符("kv", 1, ["任务"], 假, "single", 空), "根")
  单文件设置全局(单元, "值")

段落 场重复打开:
  设 后端 为 造内存后端()
  打开单元(后端, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空))
  打开单元(后端, 造单元描述符("kv", 1, ["任务"], 假, "per-record", 空))

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 名称规则与错误文本 ============
  断言单元名("kv_main")
  断言单元名("a")
  检查抛错含("单元名大写应抛", "unit name must match", 场单元名大写)
  检查抛错含("单元名数字头应抛", "unit name must match", 场单元名数字头)
  断言记录键("kv", "task-1_X")
  检查抛错含("键不安全应抛", "per-record key '坏/键' is not path-safe", 场键不安全写)
  断言相等(存储错误文本("closed", "单元已关闭"), "StorageError[closed] 单元已关闭", "错误文本形态")

  # ============ 2) 注册表 ============
  设 注册表 为 造后端注册表()
  设 注销甲 为 注册后端(注册表, "甲后端", ["标记": 1])
  注册后端(注册表, "乙后端", ["标记": 2])
  断言相等(列表长度(列出后端名(注册表)), 2, "注册两个后端")
  设 取回 为 取后端(注册表, "甲后端")
  断言相等(取回["标记"], 1, "按名查找")
  检查抛错含("重复注册应抛", "storage backend '甲后端' is already registered", 场注册重名)
  检查抛错含("未注册应抛含列表", "is not registered (registered: none)", 场取未注册)
  # 空注册表 -> none 字面
  段落 场取空表:
    取后端(造后端注册表(), "幽灵")
  检查抛错含("空表应报 none", "(registered: none)", 场取空表)
  # disposer：注销 + 重注册后旧 disposer 不移除继任者
  设 注册表乙 为 造后端注册表()
  设 旧注销 为 注册后端(注册表乙, "甲后端", ["代": 1])
  移除后端(注册表乙, "甲后端", ["代": 1])
  注册后端(注册表乙, "甲后端", ["代": 2])
  移除后端(注册表乙, "甲后端", ["代": 1])
  断言相等(列表长度(列出后端名(注册表乙)), 1, "旧注销不移除继任者")

  # ============ 3) 单元文档格式 ============
  设 描述符 为 造单元描述符("kv_main", 2, ["任务", "用户"], 真, "single", 空)
  断言相等(描述符["layout"], "single", "布局缺省 single")
  断言相等(描述符["compatibleVersions"], [], "兼容版本缺省空表")
  设 状态 为 {"版本": 2, "global": "全局槽值", "表集合": {"任务": {"t1": "值一"}, "多余表": {"x": 1}}}
  设 文档 为 序列化单元文档("kv_main", 状态)
  断言真(结尾(文档, "\n"), "文档尾换行")
  设 回状 为 解析单元文档(文档, 描述符)
  断言相等(回状["表集合"]["任务"]["t1"], "值一", "记录 round-trip")
  断言相等(回状["global"], "全局槽值", "全局 round-trip")
  断言真(字典包含键(回状["表集合"], "多余表") == 假, "多余表忽略")
  # 缺表 -> 空
  设 缺表文 为 "{\"unit\":{\"name\":\"kv_main\",\"version\":2},\"tables\":{\"任务\":{\"t1\":\"值一\"}}}"
  设 缺表状 为 解析单元文档(缺表文, 造单元描述符("kv_main", 2, ["任务", "用户"], 真, "single", 空))
  断言相等(缺表状["表集合"]["用户"], {}, "缺声明表为空")
  # 六步校验链
  检查抛错含("文档坏 JSON 应抛", "file is not valid JSON", 场文档坏JSON)
  检查抛错含("文档非对象应抛", "file is not a JSON object", 场文档非对象)
  检查抛错含("外来头应抛", "missing or foreign unit header", 场文档外来头)
  检查抛错含("版本不符应抛", "stored version 9 != expected 1", 场文档版本不符)
  断言含(存储错误文本("version-mismatch", "占位"), "[version-mismatch]", "版本错码承载")
  检查抛错含("tables 非对象应抛", "tables is not an object", 场文档表坏)
  检查抛错含("表值非对象应抛", "table '任务' is not an object", 场文档行值坏)

  # ============ 4) 记录文档版本过滤 ============
  断言相等(解析记录文档(序列化记录文档(2, "新"), [2]), "新", "当前版本可读")
  断言相等(解析记录文档(序列化记录文档(1, "旧"), [2]), 空, "过期版本读作缺席")
  断言相等(解析记录文档(序列化记录文档(1, "旧"), [2, 1]), "旧", "兼容版本可读")
  断言相等(解析记录文档("坏", [2]), 空, "畸形读作缺席")
  断言相等(解析记录文档("[1]", [2]), 空, "非对象读作缺席")

  # ============ 5) 单记录单元 ============
  设 介质 为 {}
  设 单元 为 造单记录单元(介质, 造单元描述符("kv", 2, ["任务", "用户"], 真, "per-record", [1]), "根")
  # A 判据：内存后端（介质模拟）写入->读取 round-trip
  写入记录(单元, "任务", "task-1", "任务值")
  写入记录(单元, "任务", "task-2", "任务值二")
  写入记录(单元, "用户", "user-1", ["名": "小明"])
  设 快照 为 载入全部(单元)
  断言相等(快照["表集合"]["任务"]["task-1"], "任务值", "round-trip 值一")
  断言相等(快照["表集合"]["用户"]["user-1"]["名"], "小明", "结构值 round-trip")
  断言相等(快照["global"], 空, "未写全局为空")
  # 覆盖写
  写入记录(单元, "任务", "task-1", "更新值")
  断言相等(载入全部(单元)["表集合"]["任务"]["task-1"], "更新值", "覆盖写生效")
  # 删除幂等
  删除记录(单元, "任务", "task-2")
  删除记录(单元, "任务", "task-2")
  断言真(字典包含键(载入全部(单元)["表集合"]["任务"], "task-2") == 假, "删除后缺席")
  # 键安全与声明校验
  检查抛错含("未声明表应抛", "does not declare table '未声明'", 场未声明表)
  检查抛错含("键不安全写应抛", "is not path-safe", 场键不安全写)
  # 全局槽
  设置全局(单元, "根配置")
  断言相等(载入全部(单元)["global"], "根配置", "全局写入读取")
  检查抛错含("全局未声明应抛", "does not declare a global slot", 场全局未声明)
  # 备份（时间戳注入）
  设 备份路径 为 备份记录(单元, "任务", "task-1", "202609131200")
  断言含(备份路径, "task-1.json.bak.202609131200", "备份路径形态")
  断言真(字典包含键(介质, "根/kv/任务/task-1.json") == 假, "备份后原路径移除")
  检查抛错含("备份缺记录应抛", "is missing in table", 场备份缺记录)
  # 兼容版本：旧版本文档可读
  设 兼容介质 为 {}
  兼容介质["根/kv/任务/legacy-1.json"] 为 序列化记录文档(1, "旧值")
  设 兼容单元 为 造单记录单元(兼容介质, 造单元描述符("kv", 2, ["任务"], 假, "per-record", [1]), "根")
  断言相等(载入全部(兼容单元)["表集合"]["任务"]["legacy-1"], "旧值", "兼容版本引导可读")

  # ============ 6) legacy 兄弟文件引导 ============
  设 旧介质 为 {}
  旧介质["根/kv.json"] 为 "{\"unit\":{\"name\":\"kv\",\"version\":1},\"tables\":{\"任务\":{\"legacy-1\":\"旧文档值\"}}}"
  设 旧单元 为 造单记录单元(旧介质, 造单元描述符("kv", 2, ["任务"], 假, "per-record", [1]), "根")
  设 引导快照 为 载入全部(旧单元)
  断言相等(引导快照["表集合"]["任务"]["legacy-1"], "旧文档值", "legacy 引导进内存")
  # 引导后以当前版本重写子文档
  断言含(旧介质["根/kv/任务/legacy-1.json"], "\"version\": 2", "引导重写当前版本")
  # legacy 兄弟文件永不改删
  断言真(字典包含键(旧介质, "根/kv.json"), "legacy 文件保留")
  # 外来 legacy 静默忽略
  设 外来介质 为 {}
  外来介质["根/kv.json"] 为 "{\"unit\":{\"name\":\"别的\",\"version\":1},\"tables\":{}}"
  设 外来单元 为 造单记录单元(外来介质, 造单元描述符("kv", 2, ["任务"], 假, "per-record", [1]), "根")
  断言相等(列表长度(字典键列表(载入全部(外来单元)["表集合"]["任务"])), 0, "外来 legacy 忽略")

  # ============ 7) 单文件单元 ============
  设 介质乙 为 {}
  设 空单元 为 造单文件单元(介质乙, 造单元描述符("kv", 1, ["任务"], 假, "single", 空), "根")
  # B 判据：空存储单元批量读取返回空列表不报错
  设 空快照 为 单文件载入全部(空单元)
  断言相等(空快照["表集合"]["任务"], {}, "空单元批量读为空表")
  断言真(空快照["global"] == 空, "空单元全局为空")
  断言真(字典包含键(介质乙, "根/kv.json") == 假, "物化推迟首写")
  # 部分写入 + 批量读
  单文件写入记录(空单元, "任务", "t1", "单值")
  单文件写入记录(空单元, "任务", "t2", "单值二")
  断言真(字典包含键(介质乙, "根/kv.json"), "首写物化文档")
  设 写后快照 为 单文件载入全部(空单元)
  断言相等(列表长度(字典键列表(写后快照["表集合"]["任务"])), 2, "批量读两条")
  # 覆盖写与删除（删除无键不发布）
  单文件写入记录(空单元, "任务", "t1", "改值")
  断言相等(单文件载入全部(空单元)["表集合"]["任务"]["t1"], "改值", "覆盖写")
  单文件删除记录(空单元, "任务", "无键")
  断言相等(列表长度(字典键列表(单文件载入全部(空单元)["表集合"]["任务"])), 2, "删除无键不发布")
  单文件删除记录(空单元, "任务", "t2")
  断言真(字典包含键(单文件载入全部(空单元)["表集合"]["任务"], "t2") == 假, "删除有键生效")
  # 文档 round-trip：重开读回
  设 重开单元 为 造单文件单元(介质乙, 造单元描述符("kv", 1, ["任务"], 假, "single", 空), "根")
  断言相等(单文件载入全部(重开单元)["表集合"]["任务"]["t1"], "改值", "文档重开 round-trip")
  检查抛错含("单文件全局未声明应抛", "does not declare a global slot", 场单文件未声明全局)

  # ============ 8) 内存后端 ============
  设 后端 为 造内存后端()
  设 后单元 为 打开单元(后端, 造单元描述符("store", 3, ["数据"], 真, "per-record", 空))
  写入记录(后单元, "数据", "d-1", "后端值")
  设置全局(后单元, "后端全局")
  关闭单元(后单元)
  # close 后调用拒绝
  检查抛错含("关后写应抛", "is closed", 场关后写)
  # 重开持久
  设 后单元乙 为 打开单元(后端, 造单元描述符("store", 3, ["数据"], 真, "per-record", 空))
  设 重快照 为 载入全部(后单元乙)
  断言相等(重快照["表集合"]["数据"]["d-1"], "后端值", "重开持久记录")
  断言相等(重快照["global"], "后端全局", "重开持久全局")
  检查抛错含("未关重复打开应抛", "is already open", 场重复打开)
  关闭后端(后端)

  打印("test_存储核心 PASS")

主()
