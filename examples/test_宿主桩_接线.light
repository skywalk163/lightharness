# test_宿主桩_接线.light —— 第7轮 B线 #291 宿主桩接桩出口判据
# 运行：python 运行.py examples/test_宿主桩_接线.light
# 判据：
#   #10 钩子：经宿主触发钩子 走 宿主桩 "宿主钩子" 能力，三域事件可断言
#   #12 子进程：接桩子进程 + 经桩运行进程 返回预设退出码/输出
#   #13 沙箱：接桩沙箱 + 经桩运行受限 返回沙箱信封
#   #17 交互：接桩交互 + 经桩记录审批 可断言裁定
#   #19 遥测：接桩遥测 + 经桩记录遥测 可断言指标
#   #20 代码运行时：接桩代码运行时 + 经桩执行 返回预设结果
#   #21 e2b：接桩e2b + 经桩执行代码 返回沙箱信封

从 宿主桩 导入 造宿主桩套件, 设预设进程, 设预设进程详细, 取钩子历史, 取遥测表, 取审批表
从 钩子 导入 经宿主触发钩子
从 子进程 导入 接桩子进程, 经桩运行进程, 子进程桩已接
从 沙箱 导入 接桩沙箱, 经桩运行受限, 沙箱桩已接
从 交互命令 导入 接桩交互, 经桩记录审批, 交互桩已接
从 反馈 导入 接桩遥测, 经桩记录遥测, 遥测桩已接
从 代码运行时 导入 接桩代码运行时, 经桩执行, 代码运行时桩已接
从 e2b客户端 导入 接桩e2b, 经桩执行代码, e2b桩已接
从 宿主IO 导入 是失败结果, 是成功结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  设 套件 为 造宿主桩套件()
  设 桩 为 套件["桩"]
  设 状态 为 套件["状态"]

  # ============ #10 钩子：三域事件经桩可派发可断言 ============
  设 r10a 为 经宿主触发钩子(桩, "PreToolUse", "pre", {"工具": "bash"}, "sess-1")
  断言真(是成功结果(r10a), "#10a PreToolUse 成功")
  设 r10b 为 经宿主触发钩子(桩, "PostToolUse", "post", {"工具": "bash", "输出": "ok"}, "sess-1")
  断言真(是成功结果(r10b), "#10b PostToolUse 成功")
  设 r10c 为 经宿主触发钩子(桩, "Stop", "stop", {"原因": "done"}, "sess-1")
  断言真(是成功结果(r10c), "#10c Stop 成功")
  设 历史10 为 取钩子历史(状态)
  断言相等(列表长度(历史10), 3, "#10d 三域历史三条")
  断言相等(历史10[0]["事件"]["域"], "PreToolUse", "#10e 首域")
  断言相等(历史10[2]["事件"]["域"], "Stop", "#10f 末域")
  # 非宿主域 -> INVALID_ARGUMENT
  设 r10g 为 经宿主触发钩子(桩, "session", "x", {}, "sess-1")
  断言真(是失败结果(r10g), "#10g 非宿主域失败")

  # ============ #12 子进程：接桩后经桩执行返回预设 ============
  设预设进程(状态, "echo hello", 0, "hello\n")
  设预设进程(状态, "bad cmd", 2, "")
  设预设进程详细(状态, "bad cmd2", 1, "", "err msg", 假)
  接桩子进程(桩)
  断言真(子进程桩已接(), "#12a 子进程桩已接")
  设 r12a 为 经桩运行进程("echo hello", 5000)
  断言真(是成功结果(r12a), "#12b 经桩运行成功")
  断言相等(r12a["数据"]["退出码"], 0, "#12c 退出码0")
  断言相等(r12a["数据"]["标准输出"], "hello\n", "#12d 输出")
  设 r12b 为 经桩运行进程("bad cmd", 5000)
  断言真(是成功结果(r12b), "#12e 失败命令仍成功信封")
  断言相等(r12b["数据"]["退出码"], 2, "#12f 退出码2")

  # ============ #13 沙箱：接桩后经桩运行受限返回沙箱信封 ============
  接桩沙箱(桩)
  断言真(沙箱桩已接(), "#13a 沙箱桩已接")
  设 r13 为 经桩运行受限("echo hello", 5000, "/work")
  断言真(是成功结果(r13), "#13b 经桩沙箱成功")
  断言相等(r13["数据"]["资源限制"], "stub-sandbox", "#13c 沙箱标记")
  断言相等(r13["数据"]["退出码"], 0, "#13d 退出码0")

  # ============ #17 交互：审批结果经桩记录可断言 ============
  接桩交互(桩)
  断言真(交互桩已接(), "#17a 交互桩已接")
  设 r17a 为 经桩记录审批("bash", "批准", "ok")
  断言真(是成功结果(r17a), "#17b 记录批准")
  设 r17b 为 经桩记录审批("rm", "拒绝", "危险操作")
  断言真(是成功结果(r17b), "#17c 记录拒绝")
  设 审批17 为 取审批表(状态)
  断言相等(列表长度(审批17), 2, "#17d 审批两条")
  断言相等(审批17[0]["裁定"], "批准", "#17e 首条批准")
  断言相等(审批17[1]["裁定"], "拒绝", "#17f 次条拒绝")

  # ============ #19 遥测：指标经桩记录可断言 ============
  接桩遥测(桩)
  断言真(遥测桩已接(), "#19a 遥测桩已接")
  设 r19a 为 经桩记录遥测("tool_call", 1, {"工具": "bash"})
  断言真(是成功结果(r19a), "#19b 记录tool_call")
  设 r19b 为 经桩记录遥测("token_usage", 150, {"模型": "deepseek"})
  断言真(是成功结果(r19b), "#19c 记录token")
  设 遥测19 为 取遥测表(状态)
  断言相等(列表长度(遥测19), 2, "#19d 遥测两条")
  断言相等(遥测19[0]["指标名"], "tool_call", "#19e 首条指标名")
  断言相等(遥测19[1]["值"], 150, "#19f 次条值")

  # ============ #20 代码运行时：经桩执行返回预设 ============
  设预设进程(状态, "code:print(1+1)", 0, "2\n")
  接桩代码运行时(桩)
  断言真(代码运行时桩已接(), "#20a 代码运行时桩已接")
  设 r20 为 经桩执行("print(1+1)")
  断言真(是成功结果(r20), "#20b 经桩执行成功")
  断言相等(r20["数据"]["退出码"], 0, "#20c 退出码0")
  断言相等(r20["数据"]["标准输出"], "2\n", "#20d 输出2")

  # ============ #21 e2b：经桩执行代码返回沙箱信封 ============
  设预设进程(状态, "e2b:print('hi')", 0, "hi\n")
  接桩e2b(桩)
  断言真(e2b桩已接(), "#21a e2b桩已接")
  设 r21 为 经桩执行代码("print('hi')")
  断言真(是成功结果(r21), "#21b 经桩执行成功")
  断言相等(r21["数据"]["退出码"], 0, "#21c 退出码0")
  断言相等(r21["数据"]["资源限制"], "stub-sandbox", "#21d 沙箱标记")
  断言相等(r21["数据"]["标准输出"], "hi\n", "#21e 输出hi")

  打印 "--- 第7轮 B线 #291 宿主桩接桩出口测试通过（七张卡全绿） ---"

主()
