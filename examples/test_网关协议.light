# test_网关协议.light —— 第16轮 任务3（api 网关协议：流协议/远程错误码/远程事件/类型）判据
# 上游：stream-protocol.ts / remote-error-codes.ts / remote-events.ts / types.ts
# 运行：cd lightharness && python 运行.py examples/test_网关协议.light
# 反跑：_antirun_t3_网关协议.py（A 数据帧 round-trip / B 错误帧空 details 不丢 / C 错误码表变异）

从 网关协议 导入 远程流多路路径, 远程事件流端点, 远程事件结果端点, 远程事件流负载, 远程事件流就绪
从 网关协议 导入 网解析远程流客户端消息, 是客户端开启消息, 是客户端取消消息
从 网关协议 导入 网解析远程流服务器消息, 是服务器项目帧, 是服务器错误帧, 是服务器结束帧
从 网关协议 导入 造开启消息, 造取消消息, 造项目帧, 造错误帧, 造结束帧, 序列化流消息
从 网关协议 导入 造就绪帧, 造发射帧, 造瀑布帧, 造取消事件帧, 是就绪帧, 是发射帧, 是瀑布帧, 是取消事件帧
从 网关协议 导入 网解析远程事件结果, 网解析远程事件拒绝, 网投影远程事件请求, 网投影远程事件拒绝, 网还原远程事件拒绝
从 网关协议 导入 网是远程事件标识, 网是远程JSON值
从 网关协议 导入 网关错误码表, 是网关错误码, 造网关错误详情, 是网关错误详情
从 网关协议 导入 转发事件表, 是转发事件, 查转发事件模式, 是事件模式, 是转发事件条目
从 网关协议 导入 转发事件名表, 是转发事件名, 是事件选择

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 含文本 接收 文本, 子串:
  设 n 为 字符串长度(文本)
  设 m 为 字符串长度(子串)
  设 i 为 0
  当 i + m <= n:
    如果 截取(文本, i, i + m) == 子串:
      返回 真
    设 i 为 i + 1
  返回 假

段落 应抛错 接收 动作, 标签:
  设 抛了 为 假
  设 消息 为 ""
  尝试:
    动作()
  捕获 异常 为 e:
    设 抛了 为 真
    设 消息 为 转字符串(e)
  如果 抛了 == 假:
    抛出 新建 错误("应抛错未抛：" + 标签)
  返回 消息

段落 抛非法客户端消息:
  网解析远程流客户端消息("{\"type\":\"open\",\"streamId\":\"\"}")

段落 抛非法服务器消息:
  网解析远程流服务器消息("{\"type\":\"item\"}")

段落 抛畸形JSON:
  网解析远程流服务器消息("not json at all")

段落 抛非对象:
  网解析远程流服务器消息("123")

段落 抛空对象:
  网解析远程流服务器消息("{}")

段落 抛坏结果:
  网解析远程事件结果({"clientId": "", "eventId": "e", "outcome": {"kind": "next"}})

段落 抛代理不符:
  网投影远程事件请求({"event": "x", "agent": "other"}, "mine")

段落 主:
  打印 "===== 第 16 轮任务 3：api 网关协议 ====="

  # ---- §0 协议常量 ----
  断言相等(远程流多路路径(), "/api/remote.mux", "0a 流多路路径")
  断言相等(远程事件流端点(), "$events", "0b 事件流端点")
  断言相等(远程事件结果端点(), "$events/result", "0c 事件结果端点")
  断言相等(远程事件流负载(), {"args": {}}, "0d 事件流负载")
  断言相等(远程事件流就绪(), {"type": "ready"}, "0e 事件流就绪")

  # ---- §1 流协议：数据帧 round-trip（A 反跑锚点）----
  设 帧 为 造项目帧("s1", {"x": 1, "y": [2, 3]})
  设 串 为 序列化流消息(帧)
  设 回 为 网解析远程流服务器消息(串)
  断言相等(是服务器项目帧(回), 真, "1a 项目帧 round-trip 判别")
  断言相等(回["value"]["x"], 1, "1b 项目帧 value.x")
  断言相等(回["value"]["y"][1], 3, "1c 项目帧 value.y[1]")
  断言相等(回["streamId"], "s1", "1d 项目帧 streamId")

  # ---- §1 流协议：错误帧 空 details 不丢字段（B 反跑锚点）----
  设 错帧 为 造错误帧("s1", "E1", "boom", {})
  设 错串 为 序列化流消息(错帧)
  设 错回 为 网解析远程流服务器消息(错串)
  断言相等(是服务器错误帧(错回), 真, "1e 错误帧 round-trip 判别")
  断言相等(错回["error"]["code"], "E1", "1f 错误帧 code")
  断言相等(错回["error"]["details"], {}, "1g 错误帧 空 details 不丢")

  # ---- §1 流协议：客户端消息判别 ----
  断言相等(是客户端开启消息(造开启消息("s1", "$events", {"args": {}})), 真, "1h 开启消息判别")
  断言相等(是客户端取消消息(造取消消息("s1")), 真, "1i 取消消息判别")
  断言相等(是服务器结束帧(造结束帧("s1")), 真, "1j 结束帧判别")

  # ---- §1 流协议：RemoteEvent 下行帧 ----
  断言相等(是就绪帧(造就绪帧("c1", {"home": "/h"})), 真, "1k 就绪帧判别")
  断言相等(是发射帧(造发射帧("ev", [])), 真, "1l 发射帧判别")
  断言相等(是瀑布帧(造瀑布帧("ev", "eid", "aid", {"k": 1})), 真, "1m 瀑布帧判别")
  断言相等(是取消事件帧(造取消事件帧("eid")), 真, "1n 取消事件帧判别")

  # ---- §1 流协议：远程事件结果解析 ----
  设 结果next 为 网解析远程事件结果({"clientId": "c", "eventId": "e", "outcome": {"kind": "next"}})
  断言相等(结果next["outcome"]["kind"], "next", "1o 结果 next")
  设 结果val 为 网解析远程事件结果({"clientId": "c", "eventId": "e", "outcome": {"kind": "result", "value": {"v": 7}}})
  断言相等(结果val["outcome"]["value"]["v"], 7, "1p 结果 result+value")
  设 结果rej 为 网解析远程事件结果({"clientId": "c", "eventId": "e", "outcome": {"kind": "rejected", "error": {"name": "E", "message": "m"}}})
  断言相等(结果rej["outcome"]["kind"], "rejected", "1q 结果 rejected")
  断言相等(结果rej["outcome"]["error"]["name"], "E", "1r 结果 rejected error.name")
  断言相等(含文本(应抛错(抛坏结果, "坏结果"), "invalid Remote event result"), 真, "1s 坏结果抛错")

  # ---- §1 流协议：拒绝投影 / 还原 ----
  设 拒投 为 网投影远程事件拒绝({"name": "N", "message": "M", "code": "C", "details": {"k": 1}})
  断言相等(拒投["name"], "N", "1t 拒绝投影 name")
  断言相等(拒投["code"], "C", "1u 拒绝投影 code")
  断言相等(拒投["details"]["k"], 1, "1v 拒绝投影 details")
  设 拒缺 为 网投影远程事件拒绝({})
  断言相等(拒缺["name"], "Error", "1w 拒绝投影 缺 name 补 Error")
  设 还原 为 网还原远程事件拒绝(拒投)
  断言相等(还原["name"], "N", "1x 拒绝还原 name")
  断言相等(还原["code"], "C", "1y 拒绝还原 code")

  # ---- §1 流协议：请求投影 / 标识校验 ----
  设 投影 为 网投影远程事件请求({"agent": "mine", "event": "x", "a": 1}, "mine")
  断言相等(投影["request"]["a"], 1, "1z 请求投影 保留非 agent 字段")
  断言相等(含文本(应抛错(抛代理不符, "代理不符"), "scoped Agent directly"), 真, "1aa 请求投影 代理不符抛错")
  断言相等(网是远程事件标识("e1"), 真, "1ab 事件标识 非空")
  断言相等(网是远程事件标识(""), 假, "1ac 事件标识 空拒绝")

  # ---- §1 流协议：无损 JSON 判定 ----
  断言相等(网是远程JSON值({"a": 1}), 真, "1ad 远程JSON值 字典")
  断言相等(网是远程JSON值([1, "x", 真]), 真, "1ae 远程JSON值 列表")
  断言相等(网是远程JSON值(空), 真, "1af 远程JSON值 null")

  # ---- §1 流协议：协议边界（畸形/非对象/空对象）----
  断言相等(含文本(应抛错(抛畸形JSON, "not JSON"), "not JSON"), 真, "1ag 畸形 JSON 抛错")
  断言相等(含文本(应抛错(抛非对象, "must be an object"), "must be an object"), 真, "1ah 非对象抛错")
  断言相等(含文本(应抛错(抛空对象, "invalid Remote stream server message"), "invalid Remote stream server"), 真, "1ai 空对象非帧抛错")
  断言相等(含文本(应抛错(抛非法客户端消息, "invalid Remote stream client message"), "client message"), 真, "1aj 非法客户端消息抛错")
  断言相等(含文本(应抛错(抛非法服务器消息, "invalid Remote stream server message"), "server message"), 真, "1ak 非法服务器消息(缺 streamId)抛错")

  # ---- §2 远程错误码 ----
  断言相等(长度(网关错误码表()), 17, "2a 错误码表长度")
  断言相等(是网关错误码("gateway/ambiguous-endpoint"), 真, "2b 命中错误码")
  断言相等(是网关错误码("gateway/nope"), 假, "2c 未知错误码拒绝")
  断言相等(是网关错误详情(造网关错误详情("ep")), 真, "2d 错误详情 仅 endpoint")
  设 详情f 为 造网关错误详情("ep", "fld")
  断言相等(详情f["field"], "fld", "2e 错误详情 带 field")
  断言相等(是网关错误详情({"endpoint": 123}), 假, "2f 错误详情 endpoint 非串拒绝")

  # ---- §3 远程事件 ----
  断言相等(长度(转发事件表()), 19, "3a 转发事件表长度")
  断言相等(是转发事件("approval/request"), 真, "3b 转发事件 命中")
  断言相等(是转发事件("nope"), 假, "3c 转发事件 未命中拒绝")
  断言相等(查转发事件模式("approval/request"), "waterfall", "3d 查模式 waterfall")
  断言相等(查转发事件模式("api-session/status"), "emit", "3e 查模式 emit")
  断言相等(是事件模式("emit"), 真, "3f 事件模式 emit")
  断言相等(是事件模式("weird"), 假, "3g 事件模式 非法拒绝")
  断言相等(是转发事件条目({"event": "x", "mode": "emit"}), 真, "3h 转发条目 emit")
  断言相等(是转发事件条目({"event": "x", "mode": "bad"}), 假, "3i 转发条目 非法模式拒绝")

  # ---- §4 远程类型 ----
  断言相等(是转发事件名("api-session/error"), 真, "4a 事件名 命中")
  断言相等(是转发事件名("zzz"), 假, "4b 事件名 未命中拒绝")
  断言相等(是事件选择({}), 真, "4c 事件选择 空集")
  断言相等(是事件选择({"api-session/error": 真}), 真, "4d 事件选择 单键真")
  断言相等(是事件选择({"bogus": 真}), 假, "4e 事件选择 未知键拒绝")
  断言相等(是事件选择({"api-session/error": 假}), 假, "4f 事件选择 值非真拒绝")

  打印 "test_网关协议 PASS"
