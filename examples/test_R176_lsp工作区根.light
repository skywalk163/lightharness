# test_R176_lsp工作区根.light —— B4 路 lsp rc.3 工作区根判定判据
# 上游锚点：packages/lsp/tool-lsp/src/index.ts（session-cwd.ts 整文件删除）@ dsh-v0.2.1-rc.3
# 反跑判据：把 工作区根判定 的「无代理」分支返回值改成带根 → 本文件必红。

从 语言服务器 导入 工作区根判定

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 主:
  设 有代理 为 工作区根判定(真, "/repo")
  断言相等(有代理["根"], "/repo", "有代理 → 根为工作区")
  断言相等(有代理["码"], "", "b 成功时无错误码")
  断言相等(有代理["错误"], "", "c 成功时无错误文案")

  设 无代理 为 工作区根判定(假, "/repo")
  断言相等(无代理["根"], 空, "d 无代理 → 根未定义（不退回会话头）")
  断言相等(无代理["码"], "LSP_WORKSPACE_REQUIRED", "e 错误码逐字")
  断言相等(无代理["错误"], "the lsp tool requires a session workspace cwd", "f 错误文案逐字")

  设 空根 为 工作区根判定(真, 空)
  断言相等(空根["根"], 空, "g 确保后仍无根 → 拒绝")
  断言相等(空根["码"], "LSP_WORKSPACE_REQUIRED", "h 同一条拒绝路径")

  # 上游判据是 `workspaceRoot === undefined`：空串**不**等于未定义，故不拒绝（忠实投影，不擅自加严）
  设 空串根 为 工作区根判定(真, "")
  断言相等(空串根["码"], "", "i 空串根不等于未定义 → 不拒绝（上游 === undefined 语义）")

  打印("test_R176_lsp工作区根: 全部用例通过")

主()
