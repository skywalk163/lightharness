# test_ssh连接配置.light —— R104 任务线 C（卡号 #253）：ssh/ssh 连接配置校验链 + 形状
#
# 上游依据（G:\dswork\AI\deepseek-harness，0.2.0-rc.1 = e5b5ccbfcb）：
#   packages/ssh/ssh/src/index.ts :17–:104 — Config 接口 + 构造期 zod 校验链 + 两个 getter
#
# 覆盖：
#   §1 默认值与边界常量
#   §2 错误族（建立 / 判定）
#   §3 合法配置通过（含 bootstrap 成对齐全）
#   §4 七类边界（host 非法字符 / node 非绝对 / hash 非 64 位十六进制 /
#       requestTimeoutMs 超 2^31-1 / maxFrameBytes 超 64MiB / maxPending 超 128 / leaseMs 越界两向）
#   §5 成对规则两向（只给 path / 只给 hash 都失败，文案逐字）
#   §6 非 POSIX 平台门禁（注入平台名，不读 process.platform）
#   §7 默认值填充（四键齐全 + 入参不被改动）
#   §8 getter 语义与文案（节点可执行文件 / 引导路径 未就绪即抛）
#
# 反跑：由收口单独执行（改 src/ssh连接配置.light 单点破坏 → 本文件立红 → 还原），
#   本文件保持只读验证。
# 运行：cd lightharness && python 运行.py examples/test_ssh连接配置.light

从 ssh连接配置 导入 SSH连接默认请求超时毫秒, SSH连接请求超时上限, SSH连接最大帧字节上限, SSH连接默认最大挂起
从 ssh连接配置 导入 SSH连接默认租约毫秒, SSH连接租约下限, SSH连接租约上限
从 ssh连接配置 导入 建立SSH连接错误, 是SSH连接错误
从 ssh连接配置 导入 主机合法, 绝对路径合法, 哈希合法, 正整数合法, 租约毫秒合法
从 ssh连接配置 导入 填充默认值, 校验配置, 节点可执行文件, 引导路径
从 内置核心字典 导入 字典包含键

设 合法哈希 为 "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望: 抛出 "断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假: 抛出 "断言失败[" + 标签 + "]：条件为假"

# 校验非法输入：校验配置 返回 [假, 非空错误表]，且错误文案含指定片段
段落 断言校验失败(配置, 平台, 期望含, 标签):
  设 结果 为 校验配置(配置, 平台)
  断言相等(结果[0], 假, 标签 + "_应失败")
  断言真(长(结果[1]) > 0, 标签 + "_错误表非空")
  设 命中 为 假
  遍历 文案 之 结果[1]:
    如果 期望含 在 文案: 设 命中 为 真
  断言真(命中 == 真, 标签 + "_消息含[" + 期望含 + "]，实得=" + 转字符串(结果[1]))

# 校验抛出（双参函数）：抛出 SSH连接错误 且文案含指定片段
段落 断言抛出文案二(函数, 参数甲, 参数乙, 期望含, 标签):
  设 捕获为空 为 真
  尝试:
    设 丢弃 为 函数(参数甲, 参数乙)
    断言相等(假, 真, 标签 + "_应抛未抛")
  捕获 抛了:
    设 错误体 为 抛了.args[0]
    断言真(是SSH连接错误(错误体) == 真, 标签 + "_错误族")
    断言真(期望含 在 错误体["消息"], 标签 + "_消息含:" + 错误体["消息"])
    设 捕获为空 为 假
  断言真(捕获为空 == 假, 标签 + "_未捕获")

# 校验抛出（单参函数）：同上
段落 断言抛出文案一(函数, 参数甲, 期望含, 标签):
  设 捕获为空 为 真
  尝试:
    设 丢弃 为 函数(参数甲)
    断言相等(假, 真, 标签 + "_应抛未抛")
  捕获 抛了:
    设 错误体 为 抛了.args[0]
    断言真(是SSH连接错误(错误体) == 真, 标签 + "_错误族")
    断言真(期望含 在 错误体["消息"], 标签 + "_消息含:" + 错误体["消息"])
    设 捕获为空 为 假
  断言真(捕获为空 == 假, 标签 + "_未捕获")

# 合法基线配置（五必填）；每次新建，避免用例间串味
段落 造合法配置():
  返回 {"host": "lab-01.home", "node": "/usr/local/bin/node", "helper": "/opt/dsh/helper.mjs", "helperHash": 合法哈希, "workspace": "/root/workspace"}

段落 主:
  # =====================================================================
  # §1 默认值与边界常量
  # =====================================================================
  断言相等(SSH连接默认请求超时毫秒, 30000, "1a_请求超时默认")
  断言相等(SSH连接请求超时上限, 2147483647, "1b_请求超时上限")
  断言相等(SSH连接最大帧字节上限, 67108864, "1c_帧字节上限64MiB")
  断言相等(SSH连接默认最大挂起, 128, "1d_挂起默认")
  断言相等(SSH连接默认租约毫秒, 30000, "1e_租约默认")
  断言相等(SSH连接租约下限, 3000, "1f_租约下限")
  断言相等(SSH连接租约上限, 600000, "1g_租约上限")

  # =====================================================================
  # §2 错误族
  # =====================================================================
  设 错 为 建立SSH连接错误("boom")
  断言相等(错["名"], "SSHError", "2a_名")
  断言相等(错["消息"], "boom", "2b_消息")
  断言真(是SSH连接错误(错) == 真, "2c_判定真")
  断言真(是SSH连接错误({"名": "RemoteOperationError"}) == 假, "2d_判定非")
  断言真(是SSH连接错误("plain") == 假, "2e_判定字符串非")

  # =====================================================================
  # §3 合法配置通过（含 bootstrap 成对齐全）
  # =====================================================================
  设 结果 为 校验配置(造合法配置(), "linux")
  断言真(结果[0] == 真, "3a_合法通过")
  断言相等(长(结果[1]), 0, "3b_零错误文案")
  设 成对配置 为 造合法配置()
  成对配置["bootstrapPath"] = "/opt/dsh/ptc/bootstrap.mjs"
  成对配置["bootstrapHash"] = 合法哈希
  设 成对结果 为 校验配置(成对配置, "darwin")
  断言真(成对结果[0] == 真, "3c_成对齐全通过darwin")

  # =====================================================================
  # §4 七类边界（各破一键）
  # =====================================================================
  设 主机坏 为 造合法配置()
  主机坏["host"] = "-bad-host"
  断言校验失败(主机坏, "linux", "host", "4a_host非法字符")
  设 节点坏 为 造合法配置()
  节点坏["node"] = "usr/local/bin/node"
  断言校验失败(节点坏, "linux", "node", "4b_node非绝对")
  设 哈希坏 为 造合法配置()
  哈希坏["helperHash"] = "not-a-hash"
  断言校验失败(哈希坏, "linux", "helperHash", "4c_哈希非64hex")
  设 超时坏 为 造合法配置()
  超时坏["requestTimeoutMs"] = 2147483648
  断言校验失败(超时坏, "linux", "requestTimeoutMs", "4d_请求超时超上限")
  设 帧坏 为 造合法配置()
  帧坏["maxFrameBytes"] = 67108865
  断言校验失败(帧坏, "linux", "maxFrameBytes", "4e_帧字节超64MiB")
  设 挂起坏 为 造合法配置()
  挂起坏["maxPending"] = 129
  断言校验失败(挂起坏, "linux", "maxPending", "4f_挂起超128")
  设 租约低坏 为 造合法配置()
  租约低坏["leaseMs"] = 2999
  断言校验失败(租约低坏, "linux", "leaseMs", "4g_租约低于下限")
  设 租约高坏 为 造合法配置()
  租约高坏["leaseMs"] = 600001
  断言校验失败(租约高坏, "linux", "leaseMs", "4h_租约高于上限")

  # =====================================================================
  # §5 成对规则两向（文案逐字）
  # =====================================================================
  设 只路径 为 造合法配置()
  只路径["bootstrapPath"] = "/opt/dsh/ptc/bootstrap.mjs"
  断言校验失败(只路径, "linux", "bootstrapPath and bootstrapHash must be paired", "5a_只给path")
  设 只哈希 为 造合法配置()
  只哈希["bootstrapHash"] = 合法哈希
  断言校验失败(只哈希, "linux", "bootstrapPath and bootstrapHash must be paired", "5b_只给hash")

  # =====================================================================
  # §6 非 POSIX 平台门禁（注入平台名，抛出文案逐字）
  # =====================================================================
  断言抛出文案二(校验配置, 造合法配置(), "win32", "SSH runtime requires a POSIX client", "6a_win32抛")
  断言抛出文案二(校验配置, 造合法配置(), "freebsd", "SSH runtime requires a POSIX client", "6b_freebsd抛")

  # =====================================================================
  # §7 默认值填充（四键齐全 + 入参不被改动）
  # =====================================================================
  设 原 为 造合法配置()
  设 完整 为 填充默认值(原)
  断言相等(完整["requestTimeoutMs"], 30000, "7a_请求超时默认")
  断言相等(完整["maxFrameBytes"], 67108864, "7b_帧字节默认")
  断言相等(完整["maxPending"], 128, "7c_挂起默认")
  断言相等(完整["leaseMs"], 30000, "7d_租约默认")
  断言真(字典包含键(完整, "bootstrapPath") == 假, "7e_不补bootstrapPath")
  断言真(字典包含键(完整, "bootstrapHash") == 假, "7f_不补bootstrapHash")
  断言真(字典包含键(原, "requestTimeoutMs") == 假, "7g_入参未被改动")
  # 已带值的键不被默认值覆盖
  设 带值 为 造合法配置()
  带值["maxPending"] = 64
  设 完整带值 为 填充默认值(带值)
  断言相等(完整带值["maxPending"], 64, "7h_已有值不覆盖")
  # 缺平台名时默认 linux（合法配置不抛）
  设 默认平台结果 为 校验配置(造合法配置())
  断言真(默认平台结果[0] == 真, "7i_默认平台linux")

  # =====================================================================
  # §8 getter 语义与文案（未就绪即抛，文案逐字）
  # =====================================================================
  断言抛出文案一(节点可执行文件, 空, "SSH helper is not ready", "8a_节点未就绪")
  断言相等(节点可执行文件({"node": "/usr/local/bin/node"}), "/usr/local/bin/node", "8b_节点就绪取值")
  断言抛出文案二(引导路径, 空, 造合法配置(), "SSH PTC requires a verified bootstrapPath and bootstrapHash", "8c_远端未就绪")
  断言抛出文案二(引导路径, {"node": "/usr/local/bin/node"}, 造合法配置(), "SSH PTC requires a verified bootstrapPath and bootstrapHash", "8d_未配置bootstrap")
  设 有引导 为 造合法配置()
  有引导["bootstrapPath"] = "/opt/dsh/ptc/bootstrap.mjs"
  断言相等(引导路径({"node": "/usr/local/bin/node"}, 有引导), "/opt/dsh/ptc/bootstrap.mjs", "8e_就绪取值")

  打印("test_ssh连接配置 全部通过")
