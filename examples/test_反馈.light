# 反馈（模块28）测试 —— 反跑判据：改期望值即红

从 反馈 导入 记录反馈, 解析最大备注字节, 会话身份, 同一身份, 同一头部身份, 解析备注, 版本冲突, 是空操作, 反馈服务

段落 断言相等 接收 甲, 乙, 信息:
  如果 甲 != 乙:
    抛出 "断言失败: " 加上 信息 加上 " (期望 " 加上 转字符串(乙) 加上 " 实得 " 加上 转字符串(甲) 加上 ")"

段落 主:
  # ===== command-feedback：recordFeedback =====
  # 用例1：trim 后非空 → 返回归一化文本
  断言相等(记录反馈("  good feedback  "), "good feedback", "用例1 trim 后返回")
  # 反跑判据：把 "good feedback" 改 "" 即红
  # 用例1b：纯空白 → 抛错
  设 拒了 为 假
  尝试:
    记录反馈("    ")
  捕获 异常 e:
    设 拒了 为 真
  断言相等(拒了, 真, "用例1b 空白反馈抛错")
  # 反跑判据：把 真 改 假 即红
  设 拒了2 为 假
  尝试:
    记录反馈("")
  捕获 异常 e:
    设 拒了2 为 真
  断言相等(拒了2, 真, "用例1c 空反馈抛错")

  # ===== message-feedback：配置校验 =====
  # 用例2：maxNoteBytes 必须 ≥1 整数
  断言相等(解析最大备注字节(100), 100, "用例2 合法上限通过")
  设 拒上限 为 假
  尝试:
    解析最大备注字节(0)
  捕获 异常 e:
    设 拒上限 为 真
  断言相等(拒上限, 真, "用例2b 0 拒绝")
  设 拒上限2 为 假
  尝试:
    解析最大备注字节(-5)
  捕获 异常 e:
    设 拒上限2 为 真
  断言相等(拒上限2, 真, "用例2c 负数拒绝")

  # ===== 会话身份 / 同一身份 =====
  # 用例3：身份取 createdAt(+cwd)，判断一致
  设 头A 为 { "id": "s1", "createdAt": 100, "cwd": "/a" }
  设 头B 为 { "id": "s1", "createdAt": 100, "cwd": "/b" }
  设 头C 为 { "id": "s1", "createdAt": 200, "cwd": "/a" }
  设 身份A 为 会话身份(头A)
  断言相等(身份A["createdAt"], 100, "用例3 createdAt")
  断言相等(身份A["cwd"], "/a", "用例3 cwd 保留")
  设 行A 为 { "session": { "createdAt": 100, "cwd": "/a" }, "items": [] }
  断言相等(同一身份(行A, 头A), 真, "用例3b 同身份(一致)")
  断言相等(同一身份(行A, 头B), 假, "用例3c 同身份(cwd 不同→否)")
  断言相等(同一身份(行A, 头C), 假, "用例3d 同身份(createdAt 不同→否)")
  断言相等(同一头部身份(头A, 头B), 假, "用例3e 头部身份(cwd 不同→否)")
  断言相等(同一头部身份(头A, 头A), 真, "用例3f 头部身份(全同→是)")

  # ===== resolveNote =====
  # 用例4：备注校验——无/空/超长
  断言相等(解析备注(空, 10)["ok"], 真, "用例4 无备注→ok")
  设 空备注 为 解析备注("   ", 10)
  断言相等(空备注["ok"], 假, "用例4b 空白备注→note-blank")
  断言相等(空备注["error"]["code"], "note-blank", "用例4c 错误码")
  设 超长备注 为 解析备注("一二三四五六七八九十", 10)   # 10 中文 × 3 = 30 字节 > 10
  断言相等(超长备注["ok"], 假, "用例4d 超长→note-too-large")
  断言相等(超长备注["error"]["code"], "note-too-large", "用例4e 错误码")
  断言相等(超长备注["error"]["actualBytes"], 30, "用例4f 实际字节=30")
  断言相等(超长备注["error"]["maxBytes"], 10, "用例4g 上限=10")
  设 正常备注 为 解析备注("hi", 10)
  断言相等(正常备注["ok"], 真, "用例4h 正常备注→ok")
  断言相等(正常备注["value"], "hi", "用例4i 返回原串(不trim)")

  # ===== 版本冲突 / 空操作 =====
  # 用例5：CAS 判定
  断言相等(版本冲突(空, 空), 假, "用例5 首次(null vs null)→无冲突")
  断言相等(版本冲突("v1", "v1"), 假, "用例5b 同版本→无冲突")
  断言相等(版本冲突(空, "v1"), 真, "用例5c null vs v1→冲突")
  断言相等(版本冲突("v2", "v1"), 真, "用例5d 旧版本→冲突")
  # 用例5e：空操作
  设 现有 为 { "rating": "up", "note": "n", "version": "v1" }
  断言相等(是空操作(现有, "up", "n"), 真, "用例5e rating+note 同→空操作")
  断言相等(是空操作(现有, "down", "n"), 假, "用例5f rating 不同→非空操作")
  断言相等(是空操作(空, "up", "n"), 假, "用例5g 无现有项→非(会新建)")

  # ===== 反馈服务 put/delete 状态机 =====
  # 用例6：put 创建 → 版本 v1；重复 null 版本 → 冲突；带当前版本 → 更新 v2
  设 服务 为 新建 反馈服务(200)
  设 头 为 { "id": "s1", "createdAt": 100, "cwd": "/a" }
  设 r1 为 服务.放置("s1", 头, "m1", "up", "第一版备注", 空)
  断言相等(r1["ok"], 真, "用例6 首次 put 成功")
  断言相等(r1["value"]["version"], "v1", "用例6b 版本=v1")
  断言相等(r1["value"]["rating"], "up", "用例6c rating")
  断言相等(r1["value"]["note"], "第一版备注", "用例6d note 保留")
  设 版本1 为 r1["value"]["version"]
  # 用 null(if版本=空) 再次 put → 冲突（existing.version 已是 v1）
  设 r2 为 服务.放置("s1", 头, "m1", "up", "第一版备注", 空)
  断言相等(r2["ok"], 假, "用例6e 旧null版本→冲突")
  断言相等(r2["error"]["code"], "version-conflict", "用例6f 冲突错误码")
  # 带当前版本 → 成功并更新到 v2
  设 r3 为 服务.放置("s1", 头, "m1", "up", "第二版备注", 版本1)
  断言相等(r3["ok"], 真, "用例6g 带当前版本→成功")
  断言相等(r3["value"]["version"], "v2", "用例6h 版本前进到v2")
  断言相等(r3["value"]["note"], "第二版备注", "用例6i note 更新")
  断言相等(r3["value"]["createdAt"] == r1["value"]["createdAt"], 真, "用例6j createdAt 保留首次时间")
  # 反跑判据：把 "v2" 改 "v1" 即红

  # 用例7：空操作不前进版本
  设 服务2 为 新建 反馈服务(10)
  设 a1 为 服务2.放置("s1", 头, "m1", "up", "note", 空)
  设 a2 为 服务2.放置("s1", 头, "m1", "up", "note", "v1")
  断言相等(a2["value"]["version"], "v1", "用例7 相同内容 put→版本不变(空操作)")

  # 用例8：delete——存在需版本匹配（错版本→冲突）；不存在即成功(空后置，忽略版本)
  # 此时 服务.m1 版本为 v2（来自用例6 r3）
  设 d0 为 服务.删除("s1", 头, "m1", "v1")
  断言相等(d0["ok"], 假, "用例8 错误版本删除→冲突")
  断言相等(d0["error"]["code"], "version-conflict", "用例8b 冲突错误码")
  设 d1 为 服务.删除("s1", 头, "m1", "v2")
  断言相等(d1["ok"], 真, "用例8c 带正确版本删除成功")
  断言相等(d1["value"]["absent"], 真, "用例8d 空后置")
  设 d2 为 服务.删除("s1", 头, "m1", "v2")
  断言相等(d2["ok"], 真, "用例8e 删除后再删(已不存在)→成功(忽略版本)")

  # 用例9：备注超长在 put 中先于版本校验触发
  设 服务3 为 新建 反馈服务(5)
  设 toobig 为 服务3.放置("s1", 头, "m1", "up", "一二三四五六", 空)   # 6 中文=18字节 > 5
  断言相等(toobig["ok"], 假, "用例9 备注超长 put→失败")
  断言相等(toobig["error"]["code"], "note-too-large", "用例9b 错误码")

  打印("--- 反馈子系统（模块28）测试通过 ---")

主()
