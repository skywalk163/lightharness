# test_会话标题族_接线.light —— 第6轮 任务E #280 会话标题族接线 判据
# 运行：python 运行.py examples/test_会话标题族_接线.light
# 判据：接线标题族回退（首条消息 → 会话标题.回退会话标题 → 规范化 → 造标题载荷）；
#       纯逻辑回归绿由 test_会话标题族.light 承担。

从 会话标题族 导入 接线标题族回退, 造标题用户消息
从 会话标题 导入 规范化会话标题

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 首条消息回退标题：限词截断 ----
  设 消息表 为 [造标题用户消息(1, "你好 世界 这 是 一 个 很 长 的 消息")]
  设 r1 为 接线标题族回退(消息表, 3, 120)
  断言相等(r1["标题"], "你好 世界 这", "1a 三词截断")
  断言真(是字典(r1["载荷"]), "1b 载荷形状")

  # ---- 2. 短消息：整标题 ----
  设 r2 为 接线标题族回退([造标题用户消息(1, "短标题")], 8, 120)
  断言相等(r2["标题"], "短标题", "2a 短消息全词")

  # ---- 3. 回退等价 会话标题.规范化会话标题（既有纯逻辑保留） ----
  断言相等(r2["标题"], 规范化会话标题("短标题", 120), "3a 与规范化一致")

  # ---- 4. 空消息表 -> 抛错（first-prompt 语义保留） ----
  设 已抛 为 假
  尝试:
    设 _r4 为 接线标题族回退([], 3, 120)
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "4a 空消息表须抛")

  打印 "--- 第6轮 任务E #280 会话标题族接线 测试通过 ---"

主()