# test_团队看板.light —— 模块 #66（对标编号 66）反跑测试
# 对齐原版：packages/experimental/agent-team/src/task-board.ts（自包含，不复用其它 .light）
#
# 覆盖：
#   创建（正常流 + 标识空/重复/坏优先级/依赖缺失/依赖重复/依赖自引用 抛错）
#   查询 / 列举（投影读取）
#   刷新（改优先级 / 改前置项重验图 / 状态流转 待办<->进行中 / 完成态不可改 / 未知态）
#   完成（前置满足放行 / 前置未完拒绝 / 重复完成拒绝 / 未知拒绝）
#   删除（无依赖方放行 / 有依赖方拒绝 / 未知拒绝）
#   依赖图四项校验（缺失/重复/自引用/循环）单元 + 状态流转单元
#   事件溯源被动断言（种类 / 序号连续 / 数据投影）
#
# 反跑判据：
#   把 任一 断言相等 期望值改反即红（如 合法完成 后状态非 完成）；
#   把 任一 检查抛错 用例改为「不抛」即红（如 非法依赖 被放行、非法完成 被放行）。
# 语言坑规避：写 只接受变量/字面量（表达式先 设 成变量再 写）；
#             抛错判据走 检查抛错 + 具名零参段落（匿名闭包不可作实参）；
#             状态 不作变量名（用 旧态/新态）；字典/映射 不作变量名。

从 团队看板 导入 团队看板, 判非负整数, 校验依赖图, 校验状态流转
从 JSON 导入 序列化JSON
从 内置核心转换 导入 转字符串

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误:
    设 抛了 为 真
  如果 (抛了 == 假): 抛出 新建 错误("期望抛错但未抛: " + 标签)

# 造一块带事件记录器的看板，返回 [板, 已记]
段落 造板:
  设 已记 为 []
  段落 收记录 接收 记录:
    列表追加(已记, 记录)
  设 板 为 新建 团队看板(收记录)
  返回 ["板": 板, "已记": 已记]

# =====================================================================
# 1. 依赖图四项校验单元（缺失 / 重复 / 自引用 / 循环）
# =====================================================================
段落 用例依赖图单元:
  设 表 为 {}
  设 表["a"] 为 ["任务标识": "a", "前置项": [], "状态": "待办", "优先级": 0]
  设 表["b"] 为 ["任务标识": "b", "前置项": ["a"], "状态": "待办", "优先级": 0]
  设 表["c"] 为 ["任务标识": "c", "前置项": ["b"], "状态": "待办", "优先级": 0]
  断言相等(校验依赖图(表, "n", []), 真, "无依赖新任务合法")
  断言相等(校验依赖图(表, "n", ["a"]), 真, "依赖已存在任务合法")
  断言相等(校验依赖图(表, "n", ["a", "b"]), 真, "依赖多个已存在任务合法")

段落 段_缺依赖:
  设 表 为 {}
  设 表["a"] 为 ["任务标识": "a", "前置项": [], "状态": "待办", "优先级": 0]
  设 占位 为 校验依赖图(表, "n", ["x"])

段落 段_重依赖:
  设 表 为 {}
  设 表["a"] 为 ["任务标识": "a", "前置项": [], "状态": "待办", "优先级": 0]
  设 占位 为 校验依赖图(表, "n", ["a", "a"])

段落 段_自依赖:
  设 表 为 {}
  设 占位 为 校验依赖图(表, "n", ["n"])

段落 段_环依赖:
  设 表 为 {}
  设 表["a"] 为 ["任务标识": "a", "前置项": [], "状态": "待办", "优先级": 0]
  设 表["b"] 为 ["任务标识": "b", "前置项": ["a"], "状态": "待办", "优先级": 0]
  设 表["c"] 为 ["任务标识": "c", "前置项": ["b"], "状态": "待办", "优先级": 0]
  # 把 b 的前置改成 [c]：c -> b -> c 成环
  设 占位 为 校验依赖图(表, "b", ["c"])

段落 用例依赖图违规:
  检查抛错("依赖缺失应抛", 段_缺依赖)
  检查抛错("依赖重复应抛", 段_重依赖)
  检查抛错("依赖自引用应抛", 段_自依赖)
  检查抛错("依赖循环应抛", 段_环依赖)

# =====================================================================
# 2. 状态流转单元
# =====================================================================
段落 用例状态流转单元:
  断言相等(校验状态流转("待办", "进行中"), 真, "待办->进行中 合法")
  断言相等(校验状态流转("进行中", "待办"), 真, "进行中->待办 重开合法")
  断言相等(校验状态流转("待办", "待办"), 真, "同态放行")
  断言相等(校验状态流转("进行中", "完成"), 真, "进行中->完成 由 prereq 另行保证")
  断言相等(校验状态流转("完成", "完成"), 真, "完成->完成 同态放行")

段落 段_终态改:
  设 占位 为 校验状态流转("完成", "进行中")

段落 段_未知态:
  设 占位 为 校验状态流转("待办", "怪")

段落 用例状态流转违规:
  检查抛错("已完成不可再变更状态应抛", 段_终态改)
  检查抛错("未知状态应抛", 段_未知态)

# =====================================================================
# 3. 创建正常流 + 事件被动断言
# =====================================================================
段落 用例创建正常:
  设 包 为 造板()
  设 板 为 包["板"]
  设 已记 为 包["已记"]
  设 记录1 为 板.创建("t1", [], 0)
  断言相等(记录1["任务标识"], "t1", "创建返回标识")
  断言相等(记录1["状态"], "待办", "创建初始待办")
  断言相等(记录1["优先级"], 0, "创建默认优先级 0")
  断言相等(记录1["前置项"], [], "创建无前置项")
  设 记录2 为 板.创建("t2", ["t1"], 5)
  断言相等(记录2["前置项"], ["t1"], "创建带前置项")
  断言相等(记录2["优先级"], 5, "创建带优先级")
  断言相等(板.查询("t1")["状态"], "待办", "查询返回投影")
  断言相等(列表长度(板.列举()), 2, "列举含两条")
  # 事件被动断言
  断言相等(列表长度(已记), 2, "创建两次发两条事件")
  断言相等(已记[0]["种类"], "task-created", "首事件种类")
  断言相等(已记[0]["序号"], 1, "首事件序号 1")
  断言相等(已记[1]["序号"], 2, "次事件序号 2（连续）")
  断言相等(已记[1]["序号"] - 已记[0]["序号"], 1, "序号步长 1")
  断言相等(已记[1]["数据"]["任务标识"], "t2", "事件数据含标识")
  断言相等(已记[1]["数据"]["优先级"], 5, "事件数据含优先级")

# =====================================================================
# 4. 创建违规抛错
# =====================================================================
段落 段_空标识:
  设 包 为 造板()
  设 占位 为 包["板"].创建("", [])

段落 段_重复标识:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", [])
  设 占位 为 包["板"].创建("t1", [])

段落 段_坏优先级负:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", [], 0 - 1)

段落 段_坏优先级串:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", [], "3")

段落 段_缺依赖:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", ["ghost"])

段落 段_重依赖:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", [])
  设 占位 为 包["板"].创建("t2", ["t1", "t1"])

段落 段_自依赖:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", ["t1"])

段落 用例创建违规:
  检查抛错("空标识应抛", 段_空标识)
  检查抛错("重复标识应抛", 段_重复标识)
  检查抛错("负优先级应抛", 段_坏优先级负)
  检查抛错("字符串优先级应抛", 段_坏优先级串)
  检查抛错("依赖缺失应抛", 段_缺依赖)
  检查抛错("依赖重复应抛", 段_重依赖)
  检查抛错("依赖自引用应抛", 段_自依赖)

# =====================================================================
# 5. 查询 / 列举
# =====================================================================
段落 用例查询列举:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("t1", [])
  设 占位 为 板.创建("t2", ["t1"])
  断言相等(板.查询("t1")["任务标识"], "t1", "查询命中")
  断言相等(板.查询("t2")["前置项"], ["t1"], "查询前置项")
  断言相等(列表长度(板.列举()), 2, "列举长度")

段落 段_查未知:
  设 包 为 造板()
  设 占位 为 包["板"].查询("ghost")

段落 用例查询未知:
  检查抛错("查询未知任务应抛", 段_查未知)

# =====================================================================
# 6. 刷新优先级
# =====================================================================
段落 用例刷新优先级:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("t1", [])
  设 改后 为 板.刷新("t1", ["优先级": 3])
  断言相等(改后["优先级"], 3, "刷新改优先级")
  断言相等(板.查询("t1")["优先级"], 3, "刷新后查询一致")
  设 改回 为 板.刷新("t1", ["优先级": 0])
  断言相等(改回["优先级"], 0, "刷新回 0")

段落 段_坏优先级刷新:
  设 包 为 造板()
  设 占位 为 包["板"].创建("t1", [])
  设 占位 为 包["板"].刷新("t1", ["优先级": 0 - 5])

段落 用例刷新优先级违规:
  检查抛错("负优先级刷新应抛", 段_坏优先级刷新)

# =====================================================================
# 7. 刷新状态流转（含完成态不可改、未知态、合并改字段）
# =====================================================================
段落 用例刷新状态:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("t1", [])
  设 进行中 为 板.刷新("t1", ["状态": "进行中"])
  断言相等(进行中["状态"], "进行中", "待办->进行中")
  设 重开 为 板.刷新("t1", ["状态": "待办"])
  断言相等(重开["状态"], "待办", "进行中->待办 重开")
  设 合并 为 板.刷新("t1", ["优先级": 7, "状态": "进行中"])
  断言相等(合并["优先级"], 7, "合并改优先级生效")
  断言相等(合并["状态"], "进行中", "合并改状态生效")

段落 段_终态改刷新:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("t1", [])
  设 占位 为 板.完成("t1")
  设 占位 为 板.刷新("t1", ["状态": "进行中"])

段落 段_未知态刷新:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("t1", [])
  设 占位 为 板.刷新("t1", ["状态": "怪"])

段落 用例刷新状态违规:
  检查抛错("已完成经刷新改态应抛", 段_终态改刷新)
  检查抛错("刷新未知状态应抛", 段_未知态刷新)

# =====================================================================
# 8. 刷新改依赖（合法 + 自引用/缺失/重复/循环 抛错）
# =====================================================================
段落 用例刷新依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.创建("c", [])
  设 改后 为 板.刷新("c", ["前置项": ["a"]])
  断言相等(改后["前置项"], ["a"], "刷新改前置项合法")

段落 段_刷新缺依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.刷新("a", ["前置项": ["ghost"]])

段落 段_刷新重依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", [])
  设 占位 为 板.刷新("a", ["前置项": ["b", "b"]])

段落 段_刷新自依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.刷新("a", ["前置项": ["a"]])

段落 段_刷新环依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.创建("c", ["b"])
  # c 当前依赖 b；把 b 的前置改成 [c] -> 环
  设 占位 为 板.刷新("b", ["前置项": ["c"]])

段落 用例刷新依赖违规:
  检查抛错("刷新依赖缺失应抛", 段_刷新缺依赖)
  检查抛错("刷新依赖重复应抛", 段_刷新重依赖)
  检查抛错("刷新依赖自引用应抛", 段_刷新自依赖)
  检查抛错("刷新依赖循环应抛", 段_刷新环依赖)

# =====================================================================
# 9. 完成（前置满足放行 / 前置未完拒绝 / 重复完成拒绝 / 未知拒绝）
# =====================================================================
段落 用例完成放行:
  设 包 为 造板()
  设 板 为 包["板"]
  设 已记 为 包["已记"]
  设 占位 为 板.创建("a", [])
  设 完成态 为 板.完成("a")
  断言相等(完成态["状态"], "完成", "无前置任务完成 -> 完成")
  断言相等(板.查询("a")["状态"], "完成", "完成后状态持久")
  断言相等(已记[列表长度(已记) - 1]["种类"], "task-completed", "完成发事件")

段落 段_前置未完刷新:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.完成("b")

段落 段_重复完成:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.完成("a")
  设 占位 为 板.完成("a")

段落 段_完成未知:
  设 包 为 造板()
  设 占位 为 包["板"].完成("ghost")

段落 用例完成违规:
  检查抛错("前置未完完成应抛", 段_前置未完刷新)
  检查抛错("重复完成应抛", 段_重复完成)
  检查抛错("完成未知任务应抛", 段_完成未知)

# 合法完成：前置先完成，再完成后继（反跑锚点：合法完成不可被拒）
段落 用例完成链式:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.完成("a")
  断言相等(板.查询("a")["状态"], "完成", "前置已完成")
  设 后继 为 板.完成("b")
  断言相等(后继["状态"], "完成", "前置满足 -> 后继完成放行")
  断言相等(板.查询("b")["状态"], "完成", "后继状态持久")

# =====================================================================
# 10. 删除（无依赖方放行 / 有依赖方拒绝 / 未知拒绝）+ 列举联动
# =====================================================================
段落 用例删除放行:
  设 包 为 造板()
  设 板 为 包["板"]
  设 已记 为 包["已记"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", [])
  设 结果 为 板.删除("b")
  断言相等(结果, 真, "删除无依赖方返回真")
  断言相等(列表长度(板.列举()), 1, "删除后列举少一条")
  断言相等(已记[列表长度(已记) - 1]["种类"], "task-deleted", "删除发事件")

段落 段_删除有依赖方:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.删除("a")

段落 段_删除未知:
  设 包 为 造板()
  设 占位 为 包["板"].删除("ghost")

段落 用例删除违规:
  检查抛错("存在依赖方删除应抛", 段_删除有依赖方)
  检查抛错("删除未知任务应抛", 段_删除未知)

# 已完成且无依赖方的任务可删（终态不阻止删除）
段落 用例删除已完成:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.完成("a")
  设 结果 为 板.删除("a")
  断言相等(结果, 真, "已完成无依赖方可删")
  断言相等(列表长度(板.列举()), 0, "删除后看板清空")

# =====================================================================
# 11. 反跑判据显式锚点
# =====================================================================
# 合法完成被拒 -> 必红：前置全完成后 完成 必须成功并置 完成
段落 用例反跑合法完成:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.完成("a")
  断言相等(板.完成("b")["状态"], "完成", "反跑：合法完成必须放行")

# 非法依赖被放行 -> 必红：构成循环的依赖变更必须拒绝
段落 用例反跑非法依赖:
  设 包 为 造板()
  设 板 为 包["板"]
  设 占位 为 板.创建("a", [])
  设 占位 为 板.创建("b", ["a"])
  设 占位 为 板.创建("c", ["b"])
  检查抛错("反跑：非法循环依赖必须拒绝", 段_刷新环依赖)

# =====================================================================
# 12. 事件序号连续 + 数据投影（综合）
# =====================================================================
段落 用例事件投影:
  设 包 为 造板()
  设 板 为 包["板"]
  设 已记 为 包["已记"]
  设 占位 为 板.创建("a", [], 2)
  设 占位 为 板.刷新("a", ["状态": "进行中"])
  设 占位 为 板.完成("a")
  断言相等(列表长度(已记), 3, "三态变更发三条事件")
  断言相等(已记[0]["种类"], "task-created", "事件1 创建")
  断言相等(已记[1]["种类"], "task-updated", "事件2 刷新")
  断言相等(已记[2]["种类"], "task-completed", "事件3 完成")
  断言相等(已记[0]["序号"], 1, "序号起 1")
  断言相等(已记[2]["序号"], 3, "序号到 3")
  断言相等(已记[2]["数据"]["状态"], "完成", "完成事件数据含终态")

# =====================================================================
# 主程
# =====================================================================
段落 主程:
  用例依赖图单元()
  用例依赖图违规()
  用例状态流转单元()
  用例状态流转违规()
  用例创建正常()
  用例创建违规()
  用例查询列举()
  用例查询未知()
  用例刷新优先级()
  用例刷新优先级违规()
  用例刷新状态()
  用例刷新状态违规()
  用例刷新依赖()
  用例刷新依赖违规()
  用例完成放行()
  用例完成违规()
  用例完成链式()
  用例删除放行()
  用例删除违规()
  用例删除已完成()
  用例反跑合法完成()
  用例反跑非法依赖()
  用例事件投影()
  写 "test_团队看板: 全部用例通过"

主程()
