# test_R28_混合场景.light —— 第28轮 任务4：列/类 与既有规则混合场景
#
# 任务书 4.3：
#   · 列数 为 3; 对于 元素 在 序列: 打印 元素
#   · 类 测试类: 字段 为 类别; 方法 为 列数（类体内使用 列/类 词首并入名）
#   · 序列 为 [1,2,3]; 对于 元素 在 序列: 打印 元素
# 全部 rc=0 自校验。

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))


# ===== 1. 列数 与 for-in 序列 混合 =====

段落 测试_列数混合:
    设 列数 为 3
    设 序列 为 [10, 20, 30]
    设 合计 为 0
    循环 对于 元素 在 序列:
        设 合计 为 合计 加 元素
    返回 合计 等于 列数 * 20

断言相等(测试_列数混合(), 真, "列：列数/序列/for-in 混合（10+20+30=60=3*20）")

# ===== 2. 类体内使用 列/类 词首并入名 =====

类 配置类:
    段落 初始化(类别名):
        己.类别 = 类别名
        己.列数 = 2
    段落 自报:
        返回 己.类别 加 转字符串(己.列数)

段落 测试_类体混合:
    设 实例 为 新建 配置类("A")
    返回 实例.自报()

断言相等(测试_类体混合(), "A2", "类/列：类体内 类别/列数 词首并入名正常")

# ===== 3. 序列 列表 与 遍历 混合 =====

段落 测试_无空格遍历:
    设 项目表 为 ["x", "y"]
    设 拼接 为 ""
    遍历 项目 之 项目表:
        设 拼接 为 拼接 加 项目
    返回 拼接

断言相等(测试_无空格遍历(), "xy", "列：遍历之 与列表名混合")

# ===== 4. CS 清零后全类别回归抽查 =====

段落 测试_回归抽查:
    设 乘法 为 6
    设 减法 为 2
    设 真空 为 1
    设 到位 为 3
    设 段落名 为 4
    设 配置 为 5
    设 是否 为 真
    如果 是否:
        返回 乘法 减 减法 加 到位 * 段落名 + 配置
    返回 0

断言相等(测试_回归抽查(), 21, "回归：R27 已删 14 字名与运算符切分共存（6-2+3*4+5=29）")

段落 主:
    打印("R28 混合场景测试全部通过（4 组）")
    返回 真

主()
