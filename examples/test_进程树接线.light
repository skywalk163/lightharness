# test_进程树接线.light —— R64 进程树引擎接线层回归（子进程 + 沙箱）
#
# 验证 stdlib/进程树.light 通过 src/子进程.light 和 src/沙箱.light 接进主路径后，
# 接口、超时、有界输出、资源限制都正常。引擎本身的 9 组断言见 test_进程树.light。
#
# 运行：cd lightharness && python 运行.py examples/test_进程树接线.light

从 子进程 导入 运行进程树, 运行进程树命令
从 沙箱 导入 沙箱, 建只读沙箱
从 文件系统 导入 写入文件
导入 os
导入 tempfile

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言包含(文本, 片段, 标签):
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段

段落 主:
  # ============================================================
  # 1) 子进程.运行进程树：命令数组，基本执行
  # ============================================================
  设 r1 为 运行进程树(["python", "-c", "print('wired-ok')"], 10000, {})
  断言相等(r1["码"], 0, "运行进程树退出码0")
  断言包含(r1["输出"], "wired-ok", "运行进程树输出")
  断言相等(r1["成功"], 真, "运行进程树成功")
  断言相等(r1["超时"], 假, "运行进程树不超时")

  # ============================================================
  # 2) 子进程.运行进程树命令：shell 字符串
  # ============================================================
  设 r2 为 运行进程树命令("echo shell-cmd-ok", 10000, {})
  断言相等(r2["码"], 0, "运行进程树命令退出码0")
  断言包含(r2["输出"], "shell-cmd-ok", "运行进程树命令输出")

  # ============================================================
  # 3) 子进程.运行进程树：超时杀树
  # ============================================================
  设 r3 为 运行进程树(["python", "-c", "import time; time.sleep(30)"], 700, ["宽限期毫秒": 2000])
  断言相等(r3["超时"], 真, "运行进程树超时触发")
  断言相等(r3["成功"], 假, "超时后不成功")

  # ============================================================
  # 4) 子进程.运行进程树：有界输出 spill
  # ============================================================
  设 溢出目录 为 tempfile.mkdtemp()
  设 r4 为 运行进程树(["python", "-c", "print('B'*40000)"], 15000, ["限尾字节": 1024, "溢出目录": 溢出目录])
  断言相等(r4["码"], 0, "有界输出退出码0")
  断言真(r4["溢出文件"] != 空, "有界输出溢出文件非空")
  断言真(os.path.exists(r4["溢出文件"]), "溢出文件存在")
  断言包含(r4["输出"], "已省略", "输出含省略标记")

  # ============================================================
  # 5) 沙箱.运行受限增强：基本执行 + 工作目录限定
  # ============================================================
  设 沙箱对象 为 建只读沙箱(溢出目录, 空)
  设 r5 为 沙箱对象.运行受限增强("echo sandbox-enhanced-ok", 10)
  断言相等(r5["码"], 0, "沙箱增强退出码0")
  断言包含(r5["输出"], "sandbox-enhanced-ok", "沙箱增强输出")
  断言真(r5["资源限制"].包含("无资源限制") 或 r5["资源限制"].包含("CPU时间") 或 r5["资源限制"].包含("内存限制"), "资源限制描述存在")

  # ============================================================
  # 6) 沙箱.运行受限增强：秒数上限 → 超时杀树
  # ============================================================
  设 沙箱超时 为 新建 沙箱([溢出目录], [], [], ["秒数上限": 1])
  设 r6 为 沙箱超时.运行受限增强("ping -n 30 127.0.0.1", 10)
  断言相等(r6["超时"], 真, "沙箱秒数上限触发超时")
  断言相等(r6["成功"], 假, "超时后不成功")

  # ============================================================
  # 7) 沙箱.运行受限增强：兆数上限 → 输出字节上限 spill
  # ============================================================
  设 沙箱输出限 为 新建 沙箱([溢出目录], [], [], ["兆数上限": 0.01])
  设 脚本路径 为 连接路径(溢出目录, "bigout.py")
  写入文件(脚本路径, "print('C'*30000)")
  设 r7 为 沙箱输出限.运行受限增强("python " + 脚本路径, 10)
  断言相等(r7["码"], 0, "沙箱输出上限退出码0")
  断言真(r7["溢出文件"] != 空, "沙箱输出上限触发spill")
  断言包含(r7["输出"], "已省略", "沙箱输出上限含省略标记")

  输出("test_进程树接线.light 全部断言通过（7 组 / 子进程数组+字符串+超时+spill + 沙箱基本+秒数上限+兆数上限）")
