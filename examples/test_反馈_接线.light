# test_反馈_接线.light —— 第6轮 任务E #287 反馈接线（命令面 + 消息 CAS 面）判据
# 运行：python 运行.py examples/test_反馈_接线.light
# 判据：接线反馈命令（/feedback 命令名 -> 处理函数 注册）+ 反馈命令入口（记录反馈 归一 + 放置）
#       + 接线反馈CAS（乐观锁版本冲突）；纯逻辑回归绿由 test_反馈.light 承担。

从 反馈 导入 接线反馈命令, 接线反馈CAS, 记录反馈, 反馈服务

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 命令面：/feedback 注册进命令表（交互循环 命令名->处理函数 形状） ----
  设 命令表 为 {}
  设 服务 为 新建 反馈服务(100)
  断言真(接线反馈命令(命令表, 服务), "1a 接线返回真")
  断言真(字典包含键(命令表, "feedback"), "1b feedback 命令注册")

  # ---- 2. 命令入口：归一化 + 落服务（首放 if版本=空） ----
  设 回显 为 命令表["feedback"]("up 消息甲 干得漂亮")
  断言真(开头(回显, "已记录反馈"), "2a 回显")
  设 现有项2 为 服务.取现有项("cli", {"createdAt": "t0", "cwd": "/cli"}, "消息甲")
  断言真(现有项2 != 空, "2b 服务有记录")
  断言相等(现有项2["rating"], "up", "2c 评级记录")

  # ---- 3. 空文本 -> 抛错（记录反馈 归一语义保留） ----
  设 已抛 为 假
  尝试:
    设 _r3 为 命令表["feedback"]("   ")
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "3a 空反馈须抛")

  # ---- 4. 乐观锁 CAS：正确版本更新成功 ----
  设 现有 为 服务.取现有项("cli", {"createdAt": "t0", "cwd": "/cli"}, "消息甲")
  设 现版本 为 现有["version"]
  设 更新结果 为 接线反馈CAS(服务, "cli", {"createdAt": "t0", "cwd": "/cli"}, "消息甲", "down", "改评", 现版本)
  断言真(更新结果["ok"], "4a 正确版本更新成功")

  # ---- 5. CAS：错误版本 -> version-conflict ----
  设 冲突结果 为 接线反馈CAS(服务, "cli", {"createdAt": "t0", "cwd": "/cli"}, "消息甲", "up", "再改", "v99")
  断言真(冲突结果["ok"] == 假, "5a 错版本须失败")
  断言相等(冲突结果["error"]["code"], "version-conflict", "5b 冲突码")

  # ---- 6. 记录反馈 纯逻辑（回归锚点） ----
  断言相等(记录反馈("  好评  "), "好评", "6a 归一化")

  打印 "--- 第6轮 任务E #287 反馈接线 测试通过 ---"

主()