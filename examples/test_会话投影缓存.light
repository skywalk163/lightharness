# test_会话投影缓存.light —— R101 任务C 新卡 #242 会话投影检查点缓存 测试
#
# 覆盖（每判据组含反跑点，改反即红）：
#   1) 正例：写入检查点 → 读回 → 续算一段事件 → 序号推进、快照只含尾部增量
#   2) 反例：格式版本不符/缺字段/负序号的检查点被 校验检查点兼容 判假、读检查点 忽略
#   3) 反例：检查点序号超过日志末尾（崩溃领先）→ 回退从 0 全量重算，不抛
#   4) 反例：KV 读失败 → 读检查点 返回空而不是崩
#
# 反跑点（改反即红）：
#   反跑1：src/会话投影缓存.light 冷投影续算 里「锚点缺失回退全量」改成「抛出」→ 用例3 立红
#   反跑2：校验检查点兼容 里「格式版本存在性」检查删掉 → 用例2 坏记录被接受立红
#   反跑3：校验检查点兼容 里「序号非负」检查删掉 → 负序号记录被接受立红
#   反跑4：读检查点 里「KV 读失败返回空」改成「抛出」→ 用例4 立红
#
# 运行：cd lightharness && python 运行.py examples/test_会话投影缓存.light

从 会话投影缓存 导入 读检查点, 写检查点, 冷投影续算, 校验检查点兼容, 检查点键, 当前格式版本

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败: " + 标签)

# ---- 内存 KV（注入 读KV/写KV）----
类 内存KV:
  属性 表 等于 {}
  段落 构造:
    己.表 为 {}
  段落 读取(键):
    如果 字典包含键(己.表, 键) == 假: 返回 空
    返回 己.表[键]
  段落 写入(键, 值):
    己.表[键] 为 值
    返回 真

# ---- 抛错 KV：读取永远抛（模拟介质故障）----
类 抛错KV:
  段落 读取(键):
    抛出 新建 错误("介质故障")
  段落 写入(键, 值):
    返回 真

# ---- 假事件日志读取器（注入 读事件(起,止)，闭区间；止=-1 到末尾）----
类 日志读取器:
  属性 事件表 等于 []
  段落 构造(事件表):
    己.事件表 为 事件表
  段落 读取(起, 止):
    设 结果 为 []
    遍历 事件项 之 己.事件表:
      设 序号 为 事件项["序号"]
      设 下限 为 序号 >= 起
      设 上限 为 (止 == -1) 或 (序号 <= 止)
      如果 下限 且 上限:
        列表追加(结果, 事件项)
    返回 结果

# ---- 投影步进：累加 计数 + 拼接载荷（纯函数，模拟上游 projection fold）----
段落 步进计数(快照, 事件项):
  设 新快照 为 {}
  遍历 键 之 快照:
    新快照[键] 为 快照[键]
  设 现计数 为 新快照.获取("计数", 0)
  新快照["计数"] 为 现计数 + 1
  设 现载荷 为 新快照.获取("载荷", "")
  新快照["载荷"] 为 现载荷 + 事件项["载荷"]
  返回 新快照

段落 造事件(序号, 载荷):
  设 项 为 {}
  项["序号"] 为 序号
  项["载荷"] 为 载荷
  返回 项

段落 主:
  # ============ 1) 正例：写检查点 → 读回 → 续算 → 序号推进 ============
  设 kv 为 新建 内存KV()
  # 第一次冷读：空检查点（-1），日志有 3 条事件
  设 日志表 为 [造事件(0, "A"), 造事件(1, "B"), 造事件(2, "C")]
  设 读取器 为 新建 日志读取器(日志表)
  设 空检查点 为 {"会话ID": "s1", "已处理序号": -1, "投影快照": {}, "格式版本": 当前格式版本}
  # 注：已处理序号=-1 不落盘（兼容闸门要求 >=0）；冷读面直接续算空检查点
  设 新检查点 为 冷投影续算(空检查点, 读取器.读取, 步进计数)
  断言等于(新检查点["已处理序号"], 2, "首次续算后序号=日志末尾2")
  断言等于(新检查点["投影快照"]["计数"], 3, "首次续算 fold 全部3条")
  断言等于(新检查点["投影快照"]["载荷"], "ABC", "载荷=ABC")

  # 落盘检查点
  写检查点("s1", 新检查点, kv.写入)
  设 键 为 检查点键("s1")
  断言等于(字典包含键(kv.表, 键), 真, "KV 已落盘检查点")

  # 读回
  设 读回 为 读检查点("s1", kv.读取)
  断言真(读回 != 空, "读回非空")
  断言等于(读回["已处理序号"], 2, "读回序号=2")
  断言等于(读回["投影快照"]["载荷"], "ABC", "读回载荷=ABC")

  # 追加 2 条事件后冷读续算：只 fold 序号 3、4，不重算前缀
  设 新日志表 为 [造事件(0, "A"), 造事件(1, "B"), 造事件(2, "C"), 造事件(3, "D"), 造事件(4, "E")]
  设 新读取器 为 新建 日志读取器(新日志表)
  设 续算结果 为 冷投影续算(读回, 新读取器.读取, 步进计数)
  断言等于(续算结果["已处理序号"], 4, "续算后序号推进到4")
  断言等于(续算结果["投影快照"]["计数"], 5, "累计 fold 5条（前缀3+尾部2）")
  断言等于(续算结果["投影快照"]["载荷"], "ABCDE", "载荷含前缀ABC+尾部DE")
  写检查点("s1", 续算结果, kv.写入)

  # 再无新事件续算：序号不回退、快照不变
  设 空转 为 冷投影续算(续算结果, 新读取器.读取, 步进计数)
  断言等于(空转["已处理序号"], 4, "无新事件序号维持4")
  断言等于(空转["投影快照"]["载荷"], "ABCDE", "无新事件载荷不变")

  # ============ 2) 反例：不兼容检查点被判定/忽略 ============
  设 坏版本 为 {"会话ID": "s2", "已处理序号": 0, "投影快照": {}, "格式版本": 999}
  # 版本号 999 与当前 7 不符：本模块只校验「版本是 >=0 整数」，跨代丢弃由上游 storage-domain
  # 的 compatibleVersions 负责；这里重点测「缺版本字段」与「负序号」两类结构坏记录
  设 缺版本 为 {"会话ID": "s2", "已处理序号": 0, "投影快照": {}}
  断言真(校验检查点兼容(缺版本) == 假, "缺格式版本字段 → 不兼容（反跑2）")
  设 负序号 为 {"会话ID": "s2", "已处理序号": -1, "投影快照": {}, "格式版本": 当前格式版本}
  断言真(校验检查点兼容(负序号) == 假, "负序号 → 不兼容（反跑3）")
  设 缺快照 为 {"会话ID": "s2", "已处理序号": 0, "格式版本": 当前格式版本}
  断言真(校验检查点兼容(缺快照) == 假, "缺投影快照 → 不兼容")
  设 空标识 为 {"会话ID": "", "已处理序号": 0, "投影快照": {}, "格式版本": 当前格式版本}
  断言真(校验检查点兼容(空标识) == 假, "空会话ID → 不兼容")
  设 好记录 为 {"会话ID": "s2", "已处理序号": 3, "投影快照": {"x": 1}, "格式版本": 当前格式版本}
  断言真(校验检查点兼容(好记录) == 真, "结构合法记录 → 兼容")

  # 坏记录落 KV 后读检查点 应忽略返回空
  设 kv2 为 新建 内存KV()
  kv2.表[检查点键("s2")] 为 缺版本
  设 读到坏 为 读检查点("s2", kv2.读取)
  断言真(读到坏 == 空, "结构坏记录被读检查点忽略（不抛）")

  # ============ 3) 反例：检查点序号超过日志末尾 → 回退全量，不抛 ============
  # 检查点声称 fold 到了序号 9，但日志只有 0..2（崩溃方向异常：检查点领先于日志）
  设 领先检查点 为 {"会话ID": "s3", "已处理序号": 9, "投影快照": {"计数": 99, "载荷": "OLD"}, "格式版本": 当前格式版本}
  设 短日志 为 [造事件(0, "X"), 造事件(1, "Y"), 造事件(2, "Z")]
  设 短读取器 为 新建 日志读取器(短日志)
  设 抛领先 为 假
  设 回退结果 为 空
  尝试:
    设 回退结果 为 冷投影续算(领先检查点, 短读取器.读取, 步进计数)
  捕获 异常 e:
    设 抛领先 为 真
  断言真(抛领先 == 假, "检查点领先日志不抛错（反跑1）")
  断言等于(回退结果["已处理序号"], 2, "回退全量后序号=日志末尾2")
  断言等于(回退结果["投影快照"]["计数"], 3, "回退后从空快照 fold 3条")
  断言等于(回退结果["投影快照"]["载荷"], "XYZ", "旧快照 OLD 被丢弃，载荷=XYZ")

  # ============ 4) 反例：KV 读失败 → 返回空而不是崩 ============
  设 坏kv 为 新建 抛错KV()
  设 抛读 为 假
  设 坏读到 为 空
  尝试:
    设 坏读到 为 读检查点("s9", 坏kv.读取)
  捕获 异常 e:
    设 抛读 为 真
  断言真(抛读 == 假, "KV 读失败不抛（反跑4）")
  断言真(坏读到 == 空, "KV 读失败返回空")

  打印 "--- 会话投影缓存测试通过 ---"

主()
