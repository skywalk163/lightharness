# R87 B4-G1 设置脱敏深化 + 表单投影 纯逻辑回归
# 上游：packages/settings/settings/src/{redact.ts,schema.ts}

从 设置 导入 脱敏值 普通配置 展示模式 易变表单 是表达式 投影表单 是易变路径

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 信息 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 主:
  # ---- redact.ts union/intersect/transform ----
  设 联A 为 {"类型": "对象", "属性": {"token": {"角色": "secret"}}}
  设 联B 为 {"类型": "对象", "属性": {"token": {"类型": "字符串"}}}
  设 交B 为 {"类型": "对象", "属性": {"name": {"类型": "字符串"}}}
  设 变内 为 {"类型": "对象", "属性": {"token": {"角色": "secret"}}}
  设 属性 为 字典创建()
  字典设置(属性, "联合", {"类型": "联合", "表": [联A, 联B]})
  字典设置(属性, "交叉", {"类型": "交叉", "表": [联A, 交B]})
  字典设置(属性, "变换", {"类型": "变换", "内": 变内})
  设 模式 为 {"类型": "对象", "属性": 属性}
  设 值 为 {"联合": {"token": "u-secret"}, "交叉": {"token": "i-secret", "name": "可视"}, "变换": {"token": "t-secret"}}
  设 结果 为 脱敏值(模式, 值)
  断言相等(结果["值"]["联合"], {}, "联合 秘密被剥")
  断言相等(结果["值"]["交叉"]["name"], "可视", "交叉 非秘密保留")
  断言相等(字典包含键(结果["值"]["交叉"], "token"), 假, "交叉 秘密被剥")
  断言相等(结果["值"]["变换"], {}, "变换 秘密被剥")
  断言相等(列表长度(结果["秘密"]), 3, "秘密去重后三条")

  设 空合 为 脱敏值({"类型": "联合", "表": []}, "可视")
  断言相等(空合["值"], "可视", "无表联合 原样")
  断言相等(列表长度(空合["秘密"]), 0, "无表联合 无秘密")

  # ---- schema.ts plainConfig ----
  设 脱机 为 普通配置({"a": {"b": 1}, "c": [1, 2], "d": "x"})
  断言相等(脱机["a"]["b"], 1, "普通配置 嵌套脱机")
  断言相等(脱机["c"], [1, 2], "普通配置 列表脱机")

  # ---- schema.ts volatileForm / projectForm / isVolatilePath ----
  设 全易变 为 {"类型": "对象", "易变": 真, "属性": {"secret": {"角色": "secret", "默认": "隐藏", "必填": 真}, "mode": {"类型": "字符串", "默认": "one"}}}
  设 表 为 易变表单(全易变)
  断言相等(字典包含键(表, "易变"), 假, "易变表单 去易变标记")
  断言相等(字典包含键(表["属性"]["secret"], "默认"), 假, "易变表单 secret 删默认")
  断言相等(字典包含键(表["属性"]["secret"], "必填"), 假, "易变表单 secret 删必填")
  断言相等(字典包含键(表["属性"]["mode"], "默认"), 真, "易变表单 非秘密默认保留")

  设 嵌属性 为 字典创建()
  字典设置(嵌属性, "固定", {"类型": "字符串"})
  字典设置(嵌属性, "活", {"类型": "字符串", "易变": 真})
  设 非易变 为 {"类型": "对象", "属性": {"普通": {"类型": "字符串"}, "嵌套": {"类型": "对象", "属性": 嵌属性}}}
  设 活表 为 易变表单(非易变)
  断言相等(字典包含键(活表["属性"], "嵌套"), 真, "易变表单 保留含活子的嵌套")
  断言相等(字典包含键(活表["属性"], "普通"), 假, "易变表单 剔除普通")
  断言相等(字典包含键(活表["属性"]["嵌套"]["属性"], "活"), 真, "易变表单 只留活字段")
  断言相等(字典包含键(活表["属性"]["嵌套"]["属性"], "固定"), 假, "易变表单 剔固定")

  设 空表 为 易变表单({"类型": "对象", "属性": {"固定": {"类型": "字符串"}}})
  断言相等(空表, 空, "全固定对象→空")

  # projectForm
  设 投影 为 投影表单(活表, {"普通": "隐藏", "嵌套": {"固定": "隐藏", "活": 3}, "活": 真})
  断言相等(投影, {"嵌套": {"活": 3}}, "投影表单 只投影声明活字段")
  设 表达式值 为 {"__jsExpr": "ctx.live"}
  断言相等(是表达式(表达式值), 真, "是表达式 !!js 节点")
  断言相等(投影表单(活表, {"嵌套": 表达式值}), {"嵌套": 表达式值}, "投影表单 表达式整体保留")
  断言相等(投影表单(活表, 空), 空, "投影表单 null 原样")

  # isVolatilePath
  断言相等(是易变路径(全易变, ["任何"]), 真, "根易变→任意路径真")
  断言相等(是易变路径(非易变, ["嵌套", "活"]), 真, "活路径真")
  断言相等(是易变路径(非易变, ["嵌套", "固定"]), 假, "固定路径假")
  断言相等(是易变路径(非易变, []), 假, "空路径假")

  打印 "test_R87_B4_配置_设置schema PASS"

主()
