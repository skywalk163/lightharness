# test_工具执行.light —— 模块 工具执行 对齐判据（第34轮 任务2 工具流水线）
# 运行：python 运行.py examples/test_工具执行.light

从 工具执行 导入 级公开, 级内部, 级私有, 调正常, 调拒绝, 调限流, 调取消, 调失败, 审计开始, 审计结束, 审计失败, 审计拒绝, 审计限流, 策略令牌桶, 策略滑动窗, 建注册表, 具注册工具, 注册插件工具, 插件级别, 具注销工具, 取工具, 工具名表, 列出工具, 具可见级别, 具可否见, 权限判定, 建取消令牌, 是否取消, 请求取消, 检查取消, 注册清理, 执行清理, 建审计日志, 具记审计, 审计查询, 审计导出, 审计导入, 审计条数, 建限速器, 令牌桶取, 滑动窗取, 限流检查, 建执行器, 推时钟, 具摘要, 执行工具

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真 接收 实际, 信息:
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 断言为假 接收 实际, 信息:
  如果 实际 != 假:
    抛出 新建 错误("断言失败（应为假）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 检查抛错 接收 探针, 信息:
  设 已抛 为 假
  尝试:
    探针()
  捕获 异常 为 e:
    设 已抛 为 真
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛：" + 信息)
  返回 真

# ---- 工具处理函数（取消令牌注入上下文）----
设 清理盘 为 {"次数": 0}

段落 回显处理 接收 参数, 令牌:
  返回 {"回显": 字典获取(参数, "值", 空)}

段落 炸处理 接收 参数, 令牌:
  抛出 新建 错误("工具内部炸了 [TOOL_BOOM]")

段落 取消处理 接收 参数, 令牌:
  请求取消(令牌, "user_abort")
  检查取消(令牌)
  返回 "不该到这里"

段落 读取消 接收 参数, 令牌:
  返回 是否取消(令牌)

段落 清理钩子 接收 令牌:
  字典设置(清理盘, "次数", 清理盘["次数"] + 1)
  返回 真

段落 主:
  # ---------- 1) 权限：可见性矩阵 ----------
  断言相等(长(具可见级别(级公开)), 3, "public 对三级可见")
  断言相等(长(具可见级别(级内部)), 2, "internal 对内部/私有可见")
  断言相等(长(具可见级别(级私有)), 1, "private 仅私有可见")
  断言为真(具可否见(级公开, 级公开), "public→public 可见")
  断言为真(具可否见(级公开, 级私有), "public→private 可见")
  断言为真(具可否见(级内部, 级私有), "internal→private 可见")
  断言为假(具可否见(级内部, 级公开), "internal→public 不可见")
  断言为假(具可否见(级私有, 级内部), "private→internal 不可见")
  断言为假(具可否见("瞎写", 级公开), "未知工具级别不可见")
  断言为假(具可否见(级公开, "瞎写"), "未知调用者级别不可见")

  # ---------- 2) 注册与权限继承 ----------
  设 注册 为 建注册表()
  具注册工具(注册, "读文件", 级公开, 回显处理)
  具注册工具(注册, "内部统计", 级内部, 回显处理)
  具注册工具(注册, "私有钥匙", 级私有, 回显处理, "插件甲")
  断言相等(长(工具名表(注册)), 3, "注册 3 个工具")
  段落 重名注册:
    具注册工具(注册, "读文件", 级公开, 回显处理)
  检查抛错(重名注册, "工具重名必须抛错")
  段落 坏级别:
    具注册工具(注册, "怪工具", "瞎写", 回显处理)
  检查抛错(坏级别, "未知权限级别必须抛错")
  段落 空名:
    具注册工具(注册, "", 级公开, 回显处理)
  检查抛错(空名, "空工具名必须抛错")

  # 插件权限继承
  注册插件工具(注册, "插件乙", 级内部, ["乙工具甲", "乙工具乙"], 回显处理)
  断言相等(插件级别(注册, "插件乙"), 级内部, "插件乙级别 internal")
  断言相等(取工具(注册, "乙工具甲")["级别"], 级内部, "插件工具继承 internal")
  断言相等(取工具(注册, "乙工具甲")["插件"], "插件乙", "插件归属正确")

  # 可见性列举
  断言相等(长(列出工具(注册, 级公开)), 1, "public 调用者只见 public 工具")
  断言相等(长(列出工具(注册, 级内部)), 4, "internal 调用者见 public+internal（含插件乙两件）")
  断言相等(长(列出工具(注册, 级私有)), 5, "private 调用者全见")
  断言相等(长(列出工具(注册)), 5, "不传级别列出全部")

  # 权限判定
  设 公具 为 取工具(注册, "读文件")
  断言为真(权限判定(公具, 级私有)["可调用"], "public 工具可被 private 调用")
  设 私具 为 取工具(注册, "私有钥匙")
  断言为假(权限判定(私具, 级公开)["可调用"], "private 工具拒绝 public 调用")
  断言相等(权限判定(私具, 级公开)["错误码"], "PERMISSION_DENIED", "拒绝错误码")
  断言为真(权限判定(私具, 级私有, "插件甲")["可调用"], "同插件豁免可见")
  断言相等(权限判定(取工具(注册, "不存在"), 级公开)["错误码"], "TOOL_NOT_FOUND", "工具不存在错误码")

  # 注销
  断言为真(具注销工具(注册, "读文件"), "注销成功")
  断言为假(具注销工具(注册, "读文件"), "重复注销返回假")
  断言相等(长(工具名表(注册)), 4, "注销后剩 4 个")

  # ---------- 3) 取消令牌 ----------
  设 令牌 为 建取消令牌()
  断言为假(是否取消(令牌), "初始未取消")
  断言为真(请求取消(令牌, "timeout"), "首次取消返回真")
  断言为真(是否取消(令牌), "已取消")
  断言为假(请求取消(令牌, "user_abort"), "重复取消返回假")
  断言相等(令牌["原因"], "timeout", "首次原因保留")
  段落 已取消检查:
    检查取消(令牌)
  检查抛错(已取消检查, "已取消时 检查取消 必须抛错")
  # 关联中止信号
  设 令牌乙 为 建取消令牌({"中止": 真, "原因": 空})
  断言为真(是否取消(令牌乙), "信号中止时令牌视为已取消")
  # 清理回调
  设 令牌丙 为 建取消令牌()
  注册清理(令牌丙, 清理钩子)
  注册清理(令牌丙, 清理钩子)
  断言相等(执行清理(令牌丙), 2, "两个清理钩子都执行")
  断言相等(清理盘["次数"], 2, "清理钩子计数")

  # ---------- 4) 审计日志（追加-only + 环形缓冲 + 查询） ----------
  设 日志 为 建审计日志(3)
  具记审计(日志, 审计开始, "读文件", "甲", "start", 100, "摘要甲")
  具记审计(日志, 审计结束, "读文件", "甲", 调正常, 120, "", 20)
  具记审计(日志, 审计拒绝, "写文件", "乙", 调拒绝, 130, "摘要乙")
  断言相等(审计条数(日志), 3, "满 3 条")
  具记审计(日志, 审计限流, "读文件", "乙", 调限流, 140, "")
  断言相等(审计条数(日志), 3, "超容量后仍为 3（环形缓冲）")
  断言相等(日志["事件表"][0]["序号"], 2, "最旧一条被丢弃")
  断言相等(日志["序号"], 4, "序号仍单调增长")
  # 查询
  断言相等(长(审计查询(日志, "读文件")), 2, "按工具名过滤")
  断言相等(长(审计查询(日志, 空, "乙")), 2, "按调用者过滤")
  断言相等(长(审计查询(日志, 空, 空, 调限流)), 1, "按状态过滤")
  断言相等(长(审计查询(日志, 空, 空, 空, 135)), 1, "按起始时刻过滤（缓冲区剩 120/130/140）")
  断言相等(长(审计查询(日志, "读文件", "甲", 调正常)), 1, "组合过滤")
  段落 坏审计类型:
    具记审计(日志, "瞎写", "x", "y", "z", 0)
  检查抛错(坏审计类型, "未知审计类型必须抛错")
  # 导出/导入（持久化接口）
  设 快照 为 审计导出(日志)
  断言相等(快照["序号"], 4, "快照保留序号")
  设 日志乙 为 建审计日志(10)
  审计导入(日志乙, 快照)
  断言相等(审计条数(日志乙), 3, "导入恢复 3 条")
  断言相等(序列化JSON(审计查询(日志乙)), 序列化JSON(审计查询(日志)), "导入内容一致")

  # ---------- 5) 速率限制 ----------
  # 滑动窗口：maxRequests=2, window=1000
  设 限速 为 建限速器(2, 1000, 0, 策略滑动窗)
  断言为真(限流检查(限速, 0, "甲具", "甲")["放行"], "第 1 次放行")
  断言为真(限流检查(限速, 10, "甲具", "甲")["放行"], "第 2 次放行")
  设 超限 为 限流检查(限速, 20, "甲具", "甲")
  断言为假(超限["放行"], "第 3 次被限流")
  断言相等(超限["错误码"], "RATE_LIMITED", "限流错误码")
  断言相等(超限["维度"], "全局", "先命中全局维度")
  断言为真(超限["重试毫秒"] > 0, "给出重试建议")
  断言为真(限流检查(限速, 30, "乙具", "甲")["放行"] == 假, "全局超限后换工具仍被拒")
  断言为真(限流检查(限速, 1100, "甲具", "甲")["放行"], "窗口滑过后恢复")
  # 每工具维度独立
  设 限速丙 为 建限速器(5, 1000, 0, 策略滑动窗)
  限流检查(限速丙, 0, "甲具")
  限流检查(限速丙, 0, "甲具")
  断言为真(限流检查(限速丙, 0, "乙具")["放行"], "不同工具互不干扰")
  断言为真(字典包含键(限速丙["工具表"], "甲具"), "工具维度已建")
  断言为真(字典包含键(限速丙["调用者表"], "甲") == 假, "未传调用者不建维度")
  # 令牌桶：容量 2，按时间补充
  设 桶 为 建限速器(10, 1000, 2, 策略令牌桶)
  断言为真(限流检查(桶, 0)["放行"], "桶初始有 2 令牌（第 1 个）")
  断言为真(限流检查(桶, 0)["放行"], "第 2 个令牌")
  断言为假(限流检查(桶, 0)["放行"], "第 3 次桶空")
  断言为真(限流检查(桶, 100)["放行"], "过 100ms 补 1 个令牌（10/1000ms）")
  断言为假(限流检查(桶, 100)["放行"], "补充已用尽")

  # ---------- 6) 执行流水线：顺序 权限 → 限流 → 取消 → 执行 ----------
  设 执行器 为 建执行器(10, 1000, 0, 策略滑动窗)
  具注册工具(执行器["注册"], "公开读", 级公开, 回显处理)
  具注册工具(执行器["注册"], "私有写", 级私有, 回显处理)
  具注册工具(执行器["注册"], "会炸", 级公开, 炸处理)
  具注册工具(执行器["注册"], "自取消", 级公开, 取消处理)
  注册清理(执行器["令牌"], 清理钩子)

  # 正常路径
  设 结果甲 为 执行工具(执行器, "公开读", 级公开, "甲", {"值": 42})
  断言相等(结果甲["状态"], 调正常, "正常执行")
  断言相等(结果甲["结果"]["回显"], 42, "处理函数返回值")
  断言相等(结果甲["错误码"], 空, "无错误码")

  # 权限拒绝（先于限流与执行）
  设 结果乙 为 执行工具(执行器, "私有写", 级公开, "甲", {})
  断言相等(结果乙["状态"], 调拒绝, "权限拒绝")
  断言相等(结果乙["错误码"], "PERMISSION_DENIED", "拒绝错误码")
  断言相等(长(审计查询(执行器["审计"], "私有写", 空, 调拒绝)), 1, "拒绝已审计")
  断言相等(长(审计查询(执行器["审计"], "私有写", 空, 审计开始)), 0, "拒绝不入 start 审计")

  # 失败路径（工具抛错）
  设 之前次数 为 清理盘["次数"]
  设 结果丙 为 执行工具(执行器, "会炸", 级公开, "甲", {})
  断言相等(结果丙["状态"], 调失败, "工具抛错 → failed")
  断言为真(字符串包含(结果丙["消息"], "TOOL_BOOM") == 真, "保留错误消息")
  断言相等(清理盘["次数"], 之前次数, "普通失败不触发取消清理")

  # 取消路径（工具内请求取消 → 检查取消抛错 → 执行清理）
  设 结果丁 为 执行工具(执行器, "自取消", 级公开, "甲", {})
  断言相等(结果丁["状态"], 调取消, "工具内取消 → cancelled")
  断言相等(清理盘["次数"], 之前次数 + 1, "取消触发清理钩子")
  断言相等(长(审计查询(执行器["审计"], "自取消", 空, 调取消)), 1, "取消已审计")

  # 执行前已取消：直接拒绝，且不计 start
  设 结果戊 为 执行工具(执行器, "公开读", 级公开, "甲", {"值": 1})
  断言相等(结果戊["状态"], 调取消, "令牌已取消 → 后续调用直接取消")
  断言相等(结果戊["错误码"], "TOOL_CANCELLED", "取消错误码")

  # 限流：用新执行器（maxRequests=1）
  设 节流器 为 建执行器(1, 1000, 0, 策略滑动窗)
  具注册工具(节流器["注册"], "限流具", 级公开, 回显处理)
  断言相等(执行工具(节流器, "限流具", 级公开, "甲", {})["状态"], 调正常, "第 1 次执行成功")
  设 节流结果 为 执行工具(节流器, "限流具", 级公开, "甲", {})
  断言相等(节流结果["状态"], 调限流, "第 2 次被限流")
  断言相等(节流结果["错误码"], "RATE_LIMITED", "限流错误码")
  断言为真(字符串包含(节流结果["消息"], "重试") == 真, "消息含重试建议")
  断言相等(长(审计查询(节流器["审计"], "限流具", 空, 调限流)), 1, "限流已审计")
  # 推时钟过窗口后恢复
  推时钟(节流器, 1001)
  断言相等(执行工具(节流器, "限流具", 级公开, "甲", {})["状态"], 调正常, "过窗口后恢复")
  段落 时钟倒退:
    推时钟(节流器, 0 - 5)
  检查抛错(时钟倒退, "时钟不可倒退")

  # 摘要裁剪
  设 长串 为 "abcdefghijklmnopqrstuvwxyz0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789"
  断言相等(字符串长度(具摘要(长串, 64)), 64, "超长摘要裁剪到 64")
  断言相等(具摘要({"值": 1}, 64), 序列化JSON({"值": 1}), "短参数不裁剪")

  打印 "test_工具执行 PASS"

主()
