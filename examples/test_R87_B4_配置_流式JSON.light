# R87 B4-G1 流式JSON 封顶纯逻辑回归
从 流式JSON 导入 字符串字节上限 截断UTF8 封顶行 封顶事件 解析参数 结果文本 累计用量 串字节数

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 信息 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 重复(字符, 次数):
  设 串 为 ""
  设 k 为 0
  当 k < 次数:
    设 串 为 串 + 字符
    设 k 为 k + 1
  返回 串

段落 主:
  # 常量
  断言相等(字符串字节上限, 8192, "常量 默认字符串上限")

  # 截断UTF8：多字节字符不被劈开（é = 2 字节，上限5 → "éé" 共4字节，第3个é劈开则丢）
  断言相等(截断UTF8("ééé", 5), "éé", "截断UTF8 丢劈开尾字符")
  断言相等(截断UTF8("abcdef", 3), "abc", "截断UTF8 ASCII")
  断言相等(截断UTF8("abc", 10), "abc", "截断UTF8 未超长原样")

  # 封顶事件：超长字符串被切并置 truncated
  设 封顶 为 封顶事件({"type": "text", "text": 重复("x", 9000)}, 8192)
  断言相等(封顶["truncated"], 真, "封顶事件 置截断标志")
  断言相等(串字节数(封顶["text"]) <= 8192, 真, "封顶事件 文本在字节上限内")

  # 嵌套封顶 + 长键截断
  设 封顶2 为 封顶事件({"input": {"items": ["éééééé", 空, 真], "n": 1}}, 11)
  断言相等(封顶2["truncated"], 真, "封顶2 置标志")
  断言相等(串字节数(封顶2["input"]["items"][0]) <= 11, 真, "封顶2 嵌套字符串封顶")

  # 深度切尾：200 层嵌套数组不栈溢出
  设 深 为 "leaf"
  设 i 为 0
  当 i < 200:
    设 深 为 [深]
    设 i 为 i + 1
  设 深行 为 封顶行({"type": "tool_call", "input": 深}, 8192, 32768)
  设 深回 为 解析JSON(深行)
  断言相等(深回["truncated"], 真, "深度切尾 置标志")

  # 封顶行双层降级：20000 个数的 input 在 1024 行限下只留标量
  设 大数表 为 []
  设 j 为 0
  当 j < 20000:
    列表追加(大数表, j)
    设 j 为 j + 1
  设 行 为 封顶行({"type": "tool_call", "callId": "c", "tool": "bash", "input": 大数表}, 8192, 1024)
  设 行回 为 解析JSON(行)
  断言相等(行回["type"], "tool_call", "行降级 保留 type")
  断言相等(行回["callId"], "c", "行降级 保留标量 callId")
  断言相等(行回["tool"], "bash", "行降级 保留标量 tool")
  断言相等(行回["truncated"], 真, "行降级 置标志")
  断言相等(字典包含键(行回, "input"), 假, "行降级 丢结构化 input")

  # 第二降级：连标量都超长（39个x 在 64 行限下）→ 只留 type+truncated
  设 末行 为 封顶行({"type": "text", "text": 重复("x", 39)}, 4096, 64)
  设 末回 为 解析JSON(末行)
  断言相等(末回, {"type": "text", "truncated": 真}, "标量超长 只留 type")

  # 正常行不降级
  设 正常 为 封顶行({"type": "error", "message": "ok"}, 8192, 32768)
  断言相等(解析JSON(正常), {"type": "error", "message": "ok"}, "正常行 原样")

  # parseArguments
  断言相等(解析参数(""), {}, "解析参数 空→{}")
  断言相等(解析参数("not json"), "not json", "解析参数 非法→原文")
  断言相等(解析参数("{\"n\":1e400}"), "{\"n\":1e400}", "解析参数 非有限数→原文")
  设 正常参 为 解析参数("{\"a\":1}")
  断言相等(正常参["a"], 1, "解析参数 合法→对象")

  # resultText
  设 文本 为 结果文本([{"type": "reasoning", "text": "t"}, {"type": "text", "text": "a"}, {"type": "text", "text": "b"}, {"type": "image"}])
  断言相等(文本, "ab", "结果文本 只拼 text 块")

  # addUsage：跨尝试累加；可选桶双方都报才保留
  设 态 为 累计用量({"用量": 空, "完整": 真}, {"inputTokens": 10, "outputTokens": 2, "totalTokens": 12, "cacheReadTokens": 4})
  断言相等(态["用量"]["inputTokens"], 10, "累计用量 首尝试 input")
  设 态2 为 累计用量(态, {"inputTokens": 3, "outputTokens": 1, "totalTokens": 4})
  断言相等(态2["用量"]["inputTokens"], 13, "累计用量 累加 input")
  断言相等(态2["用量"]["totalTokens"], 16, "累计用量 双方都报 total")
  断言相等(字典包含键(态2["用量"], "cacheReadTokens"), 假, "累计用量 仅旧方报 read 桶省略")
  断言相等(态2["完整"], 真, "累计用量 完整")
  # 任一尝试缺报 → 完整=假
  设 态3 为 累计用量({"用量": 空, "完整": 真}, 空)
  断言相等(态3["完整"], 假, "累计用量 缺报→不完整")

  打印 "test_R87_B4_配置_流式JSON PASS"

主()
