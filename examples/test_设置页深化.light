# test_设置页深化.light —— 设置页三页签（模型 / 内置插件 / Agent预设）深化结构 判据
# R107 任务线 E：随三页真实化改写 —— 旧占位断言换新形状断言（旧→新对照见 R107 交付报告），
#   键齐全性/计数/字段齐全性/逐字文案的覆盖全部保留；按模式概览 33/34/8/34（patch 声明行数口径）
#   的 R105 断言原样保持，插件页新增「成员计数」（展平叶子 29/30/6/30）按另一口径分别断言。
# 被测：src/设置页深化.light（三页已一行委托 设置模型页 / 设置插件页 / 设置预设页，R107 E）
# 运行：cd lightharness && python 运行.py examples/test_设置页深化.light

从 设置页深化 导入 渲染模型页, 渲染插件页, 渲染预设页, 渲染深化页
从 设置页深化 导入 造模型行, 造插件行, 造预设卡, 预设模式说明, 预设如何使用
从 设置页 导入 内置插件概览
从 总入口 导入 组装注册表
从 预设组合 导入 组合统计
从 内置核心字典 导入 字典设置, 字典包含键, 字典键列表
从 内置核心列表 导入 列表追加, 列表包含

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# =====================================================================
# §1 渲染模型页（委托 A 线 设置模型页：R107 真实形状）
#   旧覆盖对照：1a/1b/1c 键齐全 → 新七键；1d 来源=宿主 → provider 字段；
#   1o 值占位 → 凭据恰三键（密钥永不回显）；1e-1k 行 id → 模型行 4 条 id 序。
# =====================================================================
段落 用例_渲染模型页:
  设 元数据 为 {"has_key": 1, "mock": 0, "model": "deepseek-flash", "endpoint": "https://api.deepseek.com"}
  设 页 为 渲染模型页(元数据)
  设 页键 为 ["说明", "只读", "提供商行", "模型行", "模型目录继承", "可用提供商", "协议选项"]
  遍历 键 之 页键:
    断言真(字典包含键(页, 键), "1a 模型页含键 " + 键)
  断言相等(长度(页键), 7, "1a2 七键")
  设 行 为 页["提供商行"][0]
  断言相等(行["provider"], "deepseek-official", "1b provider=deepseek-official")
  断言相等(行["显示名"], "DeepSeek", "1b2 显示名=DeepSeek")
  断言相等(行["命名空间"], "llm-deepseek", "1b3 命名空间=llm-deepseek")
  断言相等(行["可删除"], 假, "1b4 可删除=假")
  设 凭据 为 行["凭据"]
  断言相等(长度(字典键列表(凭据)), 3, "1c 凭据恰三键（无明文槽）")
  断言相等(凭据["configured"], 真, "1c2 has_key=1 → configured 真")
  设 空页 为 渲染模型页(空)
  断言相等(空页["提供商行"][0]["凭据"]["configured"], 假, "1c3 空元数据 → configured 假")
  设 期望序 为 ["deepseek-flash", "deepseek-v4-flash", "deepseek-v4-pro", "deepseek-v4-flash-vision-exp"]
  断言相等(长度(页["模型行"]), 4, "1d 模型行四条")
  设 i 为 0
  遍历 目录行 之 页["模型行"]:
    断言相等(目录行["id"], 期望序[i], "1d2 模型行 id 序 " + 转字符串(i))
    设 i 为 i + 1
  断言相等(长度(页["协议选项"]), 3, "1e 协议选项三条")
  断言相等(页["模型目录继承"], 真, "1f 未自定义 → 继承真")
  设 单行 为 造模型行("x", "文本", "标题甲", "描述甲")
  断言相等(单行["值"], 空, "1g 造模型行 兼容辅助保留")

# =====================================================================
# §2 渲染插件页（委托 B 线 设置插件页：两段真实分组）
#   旧覆盖对照：2n 清单两行占位 → 两段真实分组；2u 启用占位假 → 三态合法；
#   2v 来源=宿主插件注册表 → B 页 来源=本仓插件注册表；2e-2l 概览 33/34/8/34 原样保持。
# =====================================================================
段落 用例_渲染插件页:
  设 注册表 为 组装注册表()
  设 页 为 渲染插件页(注册表, "standard", 空)
  设 页键 为 ["说明", "来源", "按模式概览", "按模式", "预设切换器", "分组"]
  遍历 键 之 页键:
    断言真(字典包含键(页, 键), "2a 插件页含键 " + 键)
  设 概览 为 页["按模式概览"]
  断言相等(长度(概览), 4, "2b 概览四行")
  断言相等(概览[0]["展平后"], 33, "2b2 standard 展平 33")
  断言相等(概览[1]["展平后"], 34, "2b3 ptc 展平 34")
  断言相等(概览[2]["展平后"], 8, "2b4 minimal 展平 8")
  断言相等(概览[3]["展平后"], 34, "2b5 cordis 展平 34")
  断言相等(页["按模式概览"][0]["展平后"], 内置插件概览()[0]["展平后"], "2b6 与 设置页.内置插件概览 同源")
  遍历 项 之 概览:
    断言相等(项["口径"], "patch 声明行数（含组行）", "2c 口径标注字段 " + 项["id"])
  # ---- 分组（旧 2n 清单两行占位 → 新两段真实分组）----
  断言相等(长度(页["分组"]), 2, "2d 两段分组")
  设 会话组 为 页["分组"][0]
  断言相等(会话组["分组"], "会话插件", "2d2 会话分组名逐字")
  断言相等(会话组["副标题"], "由 Agent 预设按会话组成", "2d3 会话副标题逐字")
  断言相等(会话组["默认展开"], 真, "2d4 会话默认展开")
  断言相等(会话组["当前预设"], "standard", "2d5 当前预设 standard")
  # ---- 成员计数 = 展平叶子 29（上游 UI 口径；反跑锚点：计数若改回 展平后 33 → 2e2 红）----
  断言相等(会话组["计数"], 29, "2e standard 展平叶子 29")
  断言相等(长度(会话组["项"]), 会话组["计数"], "2e2 成员条数==计数（一致性）")
  断言真(会话组["计数"] != 概览[0]["展平后"], "2e3 叶子29 与 声明行33 两口径不等")
  设 首行 为 会话组["项"][0]
  断言真(长度(首行["entryId"]) > 0, "2f 首行 entryId 非空")
  设 三态 为 ["enabled", "disabled", "conditional"]
  遍历 成员行 之 会话组["项"]:
    断言真(列表包含(三态, 成员行["启用"]), "2g 启用三态合法")
  设 全局组 为 页["分组"][1]
  断言相等(全局组["分组"], "全局插件", "2h 全局分组名逐字")
  断言相等(全局组["默认展开"], 假, "2h2 全局默认收起")
  断言相等(长度(全局组["项"]), 长度(注册表.名单()), "2h3 全局计数==注册表名单长度")
  设 页m 为 渲染插件页(注册表, "minimal", 空)
  断言相等(页m["分组"][0]["计数"], 6, "2i minimal 展平叶子 6")
  设 单行2 为 造插件行("全局插件")
  断言相等(单行2["启用"], 假, "2j 造插件行 兼容辅助保留")

# =====================================================================
# §3 渲染预设页（委托 C 线 设置预设页：分组 + 查看配置）
#   旧覆盖对照：3a 预设列表 → 分组/默认预设/开发者工具；3d-3l 区块.* → 帮助.*；
#   新增 3e 配置详情块（成员数 == 展平后口径）。
# =====================================================================
段落 用例_渲染预设页:
  设 页 为 渲染预设页(空, 真)
  设 页键 为 ["说明", "分组", "默认预设", "开发者工具"]
  遍历 键 之 页键:
    断言真(字典包含键(页, 键), "3a 预设页含键 " + 键)
  断言相等(页["默认预设"], "standard", "3a2 默认预设 standard")
  断言相等(页["开发者工具"], 真, "3a3 开发者工具 真")
  断言相等(长度(页["分组"]), 2, "3b 两分组")
  断言相等(页["分组"][0]["分组"], "内置", "3b2 内置组")
  断言相等(页["分组"][1]["分组"], "自定义", "3b3 自定义组")
  断言相等(长度(页["分组"][1]["预设"]), 0, "3b4 自定义组空但存在")
  设 列表 为 页["分组"][0]["预设"]
  断言相等(长度(列表), 4, "3c 四张预设卡")
  设 期望序 为 ["standard", "ptc", "minimal", "cordis"]
  设 i 为 0
  遍历 卡 之 列表:
    断言相等(卡["id"], 期望序[i], "3c2 预设顺序 " + 转字符串(i))
    设 i 为 i + 1
  遍历 卡 之 列表:
    断言真(字典包含键(卡["帮助"], "模式说明"), "3d 卡帮助含模式说明")
    断言真(长度(卡["帮助"]["模式说明"]) > 0, "3d2 模式说明非空")
    断言真(长度(卡["帮助"]["如何使用"]) > 0, "3d3 如何使用非空")
    断言真(字典包含键(卡, "配置"), "3e 卡含配置块")
    断言真(字典包含键(卡["配置"], "成员数"), "3e2 配置含成员数")
    断言真(字典包含键(卡["配置"], "文本"), "3e3 配置含文本")
    断言真(字典包含键(卡["配置"], "行"), "3e4 配置含行")
    断言真(字典包含键(卡, "名称"), "3j 卡保留 名称")
    断言真(字典包含键(卡, "描述"), "3k 卡保留 描述")
    断言真(字典包含键(卡, "顺序"), "3l 卡保留 顺序")
  断言相等(列表[0]["配置"]["成员数"], 组合统计("standard")["展平后"], "3e5 standard 成员数==展平后33")
  断言相等(列表[0]["是否默认"], 真, "3f standard 默认标记")
  断言真(字符串包含(列表[0]["帮助"]["模式说明"], "### 工作方式"), "3g standard 模式说明含工作方式")
  断言真(字符串包含(列表[1]["帮助"]["如何使用"], "### 汇总错误日志"), "3g2 ptc 如何使用含汇总错误日志")
  断言真(字符串包含(预设模式说明("cordis"), "创造模式具备标准任务工具"), "3h 预设模式说明(cordis) 直查")
  设 抛了 为 假
  尝试:
    设 坏 为 预设模式说明("不存在的预设")
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "3h2 未知预设取模式说明抛错")
  设 卡2 为 造预设卡("minimal", "甲说明", "乙用法")
  断言相等(卡2["区块"]["模式说明"], "甲说明", "3i 造预设卡 兼容辅助保留")

# =====================================================================
# §4 渲染深化页 分派（三合法标识 + 未知抛错；旧 4a-4h 覆盖保持，键断言换新形状）
# =====================================================================
段落 用例_渲染深化页:
  设 模型页 为 渲染深化页("models")
  断言真(字典包含键(模型页, "提供商行"), "4a models → 模型页（含提供商行）")
  设 插件页 为 渲染深化页("builtin-plugins")
  断言真(字典包含键(插件页, "分组"), "4b builtin-plugins → 插件页（含分组）")
  设 预设页 为 渲染深化页("agent-presets")
  断言真(字典包含键(预设页, "默认预设"), "4c agent-presets → 预设页（含默认预设）")
  设 抛了 为 假
  设 文 为 ""
  尝试:
    设 坏页 为 渲染深化页("settings")
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  断言相等(抛了, 真, "4d 未知标识抛错")
  断言真(字符串包含(文, "models"), "4e 错误消息含 models")
  断言真(字符串包含(文, "builtin-plugins"), "4f 错误消息含 builtin-plugins")
  断言真(字符串包含(文, "agent-presets"), "4g 错误消息含 agent-presets")
  断言真(字符串包含(文, "settings"), "4h 错误消息回显非法标识")

段落 主程():
  用例_渲染模型页()
  用例_渲染插件页()
  用例_渲染预设页()
  用例_渲染深化页()
  打印 "test_设置页深化 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置页深化 通过 ---"
  返回 真

主程()
