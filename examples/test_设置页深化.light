# test_设置页深化.light —— 设置页三页签（模型 / 内置插件 / Agent预设）深化结构 判据
# 被测：src/设置页深化.light（本文件与其配套新增，不修改 src/设置页.light）
# 上游：deepseek-harness
#   ui-settings-models/src/client/locales.ts（模型行文案）
#   ui-settings-plugin-inventory/src/client/locales.ts + PluginInventorySettingsTab.tsx（插件分组/启用）
#   ui-agent-preset/src/client/guide-locales.ts（四预设 模式说明 / 如何使用 正文）
# 运行：cd lightharness && python 运行.py examples/test_设置页深化.light
#
# 语言坑规避：断言诊断一律走 抛出 新建 错误（写 只吃字面量串，见 L-055/L-160）；
#   列表/字典字面量单行（L-051）；模块级标量在段落体内改不动 → 计数用字典。

从 设置页深化 导入 渲染模型页, 渲染插件页, 渲染预设页, 渲染深化页
从 设置页深化 导入 造模型行, 造插件行, 造预设卡, 预设模式说明, 预设如何使用
从 设置页 导入 内置插件概览
从 内置核心字典 导入 字典设置, 字典包含键, 字典键列表
从 内置核心列表 导入 列表追加, 列表包含

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真值，实际=" + 转字符串(条件))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 含行标识(行集, 标识) -> 行集中是否存在该 id 的行
段落 含行标识(行集, 标识):
  设 结果 为 假
  遍历 行 之 行集:
    如果 行["id"] == 标识:
      设 结果 为 真
  返回 结果

# =====================================================================
# §1 渲染模型页（键齐全 / 行集非空 / 每行 id+标题 / 来源 宿主）
# =====================================================================
段落 用例_渲染模型页:
  设 页 为 渲染模型页()
  断言真(字典包含键(页, "说明"), "1a 模型页含 说明")
  断言真(字典包含键(页, "来源"), "1b 模型页含 来源")
  断言真(字典包含键(页, "行集"), "1c 模型页含 行集")
  断言相等(页["来源"], "宿主", "1d 模型页 来源=宿主")
  设 行集 为 页["行集"]
  断言相等(长度(行集), 6, "1e 模型页六行")
  # 行覆盖：提供商 / 协议 / 接口地址 / 密钥状态 / 模型选择 / 高级参数
  断言真(含行标识(行集, "provider"), "1f 含 provider 行")
  断言真(含行标识(行集, "protocol"), "1g 含 protocol 行")
  断言真(含行标识(行集, "baseUrl"), "1h 含 baseUrl 行（接口地址）")
  断言真(含行标识(行集, "apiKeyStatus"), "1i 含 apiKeyStatus 行（密钥状态）")
  断言真(含行标识(行集, "model"), "1j 含 model 行（模型选择）")
  断言真(含行标识(行集, "modelAdvanced"), "1k 含 modelAdvanced 行（高级参数；上游无温度字段）")
  # 每行字段：id + 标题 + 值占位 + 来源
  遍历 行 之 行集:
    断言真(字典包含键(行, "id"), "1l 行含 id")
    断言真(字典包含键(行, "标题"), "1m 行含 标题")
    断言真(长度(行["标题"]) > 0, "1n 行标题非空")
    断言相等(行["值"], 空, "1o 行值为空（宿主提供）")
    断言相等(行["来源"], "宿主", "1p 行来源=宿主")
  # 造模型行 单条形状
  设 单行 为 造模型行("x", "文本", "标题甲", "描述甲")
  断言相等(单行["id"], "x", "1q 造模型行 id")
  断言相等(单行["类型"], "文本", "1r 造模型行 类型")
  断言相等(单行["值"], 空, "1s 造模型行 值占位")

# =====================================================================
# §2 渲染插件页（键齐全 / 概览 4 行且计数 33/34/8/34 / 清单字段齐全）
# =====================================================================
段落 用例_渲染插件页:
  设 页 为 渲染插件页()
  断言真(字典包含键(页, "说明"), "2a 插件页含 说明")
  断言真(字典包含键(页, "按模式概览"), "2b 插件页含 按模式概览")
  断言真(字典包含键(页, "清单"), "2c 插件页含 清单")
  设 概览 为 页["按模式概览"]
  断言相等(长度(概览), 4, "2d 概览四行")
  # 计数实测：33 / 34 / 8 / 34（直接复用 设置页.内置插件概览，不重算）
  断言相等(概览[0]["id"], "standard", "2e 概览首项 standard")
  断言相等(概览[0]["展平后"], 33, "2f standard 展平 33")
  断言相等(概览[1]["id"], "ptc", "2g 概览次项 ptc")
  断言相等(概览[1]["展平后"], 34, "2h ptc 展平 34")
  断言相等(概览[2]["id"], "minimal", "2i 概览第三项 minimal")
  断言相等(概览[2]["展平后"], 8, "2j minimal 展平 8")
  断言相等(概览[3]["id"], "cordis", "2k 概览第四项 cordis")
  断言相等(概览[3]["展平后"], 34, "2l cordis 展平 34")
  # 与 设置页.内置插件概览() 同源（不重算、不改计数）
  断言相等(页["按模式概览"], 内置插件概览(), "2m 按模式概览 直接取自 设置页.内置插件概览")
  # 清单结构：id / 名称 / 分组 / 启用 / 来源
  设 清单 为 页["清单"]
  断言相等(长度(清单), 2, "2n 清单两行占位")
  设 合法分组 为 ["全局插件", "会话插件"]
  遍历 行 之 清单:
    断言真(字典包含键(行, "id"), "2o 清单行含 id")
    断言真(字典包含键(行, "名称"), "2p 清单行含 名称")
    断言真(字典包含键(行, "分组"), "2q 清单行含 分组")
    断言真(字典包含键(行, "启用"), "2r 清单行含 启用")
    断言真(字典包含键(行, "来源"), "2s 清单行含 来源")
    断言真(列表包含(合法分组, 行["分组"]), "2t 分组为 全局插件/会话插件")
    断言相等(行["启用"], 假, "2u 启用占位为假")
    断言相等(行["来源"], "宿主插件注册表", "2v 来源=宿主插件注册表")
  # 造插件行 单条形状
  设 单行 为 造插件行("全局插件")
  断言相等(单行["分组"], "全局插件", "2w 造插件行 分组")
  断言相等(单行["启用"], 假, "2x 造插件行 启用占位")

# =====================================================================
# §3 渲染预设页（四卡 / 顺序 / 区块 两键 / 正文非空 / 逐字抽查）
# =====================================================================
段落 用例_渲染预设页:
  设 页 为 渲染预设页()
  断言真(字典包含键(页, "预设列表"), "3a 预设页含 预设列表")
  设 列表 为 页["预设列表"]
  断言相等(长度(列表), 4, "3b 四张预设卡")
  设 期望序 为 ["standard", "ptc", "minimal", "cordis"]
  遍历 位置 之 [0, 1, 2, 3]:
    断言相等(列表[位置]["id"], 期望序[位置], "3c 预设顺序 " + 转字符串(位置))
  # 每卡：保留原元数据字段 + 区块.模式说明 / 区块.如何使用
  遍历 卡 之 列表:
    断言真(字典包含键(卡, "区块"), "3d 卡含 区块")
    设 区块 为 卡["区块"]
    断言真(字典包含键(区块, "模式说明"), "3e 区块含 模式说明")
    断言真(字典包含键(区块, "如何使用"), "3f 区块含 如何使用")
    断言真(长度(区块["模式说明"]) > 0, "3g 模式说明 非空")
    断言真(长度(区块["如何使用"]) > 0, "3h 如何使用 非空")
    断言真(字典包含键(卡, "名称"), "3i 卡保留 名称")
    断言真(字典包含键(卡, "描述"), "3j 卡保留 描述")
    断言真(字典包含键(卡, "顺序"), "3k 卡保留 顺序")
    断言相等(卡["是否内置"], 真, "3l 卡保留 是否内置")
  # 逐字抽查（上游 guide-locales.ts guideZh）
  断言真(字符串包含(列表[0]["区块"]["模式说明"], "### 工作方式"), "3m standard 模式说明 含 工作方式")
  断言真(字符串包含(列表[0]["区块"]["如何使用"], "### 修复一个问题"), "3n standard 如何使用 含 修复一个问题")
  断言真(字符串包含(列表[1]["区块"]["模式说明"], "Programmatic Tool Calling"), "3o ptc 模式说明 含 PTC 全称")
  断言真(字符串包含(列表[1]["区块"]["如何使用"], "### 汇总错误日志"), "3p ptc 如何使用 含 汇总错误日志")
  断言真(字符串包含(列表[2]["区块"]["模式说明"], "Shell 工具"), "3q minimal 模式说明 含 Shell 工具")
  断言真(字符串包含(列表[2]["区块"]["如何使用"], "### 对比基础修复表现"), "3r minimal 如何使用 含 对比基础修复")
  断言真(字符串包含(列表[3]["区块"]["模式说明"], "### 插件与模式的关系"), "3s cordis 模式说明 含 插件与模式的关系")
  断言真(字符串包含(列表[3]["区块"]["如何使用"], "### 创建自己的模式"), "3t cordis 如何使用 含 创建自己的模式")
  # 段落直查：预设模式说明 / 预设如何使用
  断言真(字符串包含(预设模式说明("cordis"), "创造模式具备标准任务工具"), "3u 预设模式说明(cordis) 正文")
  断言真(字符串包含(预设如何使用("ptc"), "configs/ 下所有 JSON 文件"), "3v 预设如何使用(ptc) 正文")
  设 抛了 为 假
  尝试:
    设 坏 为 预设模式说明("不存在的预设")
  捕获 异常 为 e:
    设 抛了 为 真
  断言相等(抛了, 真, "3w 未知预设取模式说明抛错")
  # 造预设卡：区块被覆盖
  设 卡 为 造预设卡("minimal", "甲说明", "乙用法")
  断言相等(卡["区块"]["模式说明"], "甲说明", "3x 造预设卡 覆盖 模式说明")
  断言相等(卡["区块"]["如何使用"], "乙用法", "3y 造预设卡 覆盖 如何使用")
  断言相等(卡["名称"], "极简模式", "3z 造预设卡 保留名称")

# =====================================================================
# §4 渲染深化页 分派（三合法标识 + 未知抛错）
# =====================================================================
段落 用例_渲染深化页:
  设 模型页 为 渲染深化页("models")
  断言真(字典包含键(模型页, "行集"), "4a models → 模型页（含行集）")
  设 插件页 为 渲染深化页("builtin-plugins")
  断言真(字典包含键(插件页, "清单"), "4b builtin-plugins → 插件页（含清单）")
  设 预设页 为 渲染深化页("agent-presets")
  断言真(字典包含键(预设页, "预设列表"), "4c agent-presets → 预设页（含预设列表）")
  设 抛了 为 假
  设 文 为 ""
  尝试:
    设 坏页 为 渲染深化页("settings")
  捕获 异常 为 e:
    设 抛了 为 真
    设 文 为 转字符串(e)
  断言相等(抛了, 真, "4d 未知标识抛错")
  断言真(字符串包含(文, "models"), "4e 错误消息含 models")
  断言真(字符串包含(文, "builtin-plugins"), "4f 错误消息含 builtin-plugins")
  断言真(字符串包含(文, "agent-presets"), "4g 错误消息含 agent-presets")
  断言真(字符串包含(文, "settings"), "4h 错误消息回显非法标识")

段落 主程():
  用例_渲染模型页()
  用例_渲染插件页()
  用例_渲染预设页()
  用例_渲染深化页()
  打印 "test_设置页深化 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试设置页深化 通过 ---"
  返回 真

主程()
