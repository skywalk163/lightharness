# test_团队工具_接线.light —— 第6轮 任务E #290 团队工具/代理团队接线 判据
# 运行：python 运行.py examples/test_团队工具_接线.light
# 判据：接线团队工具（9 工具注册进 工具注册表）+ 造代理团队能力（读面真实接
#       代理团队.折叠团队状态/任务分页 事件流）；纯逻辑回归绿由 test_团队工具.light / test_代理团队.light 承担。

从 团队工具 导入 接线团队工具, 造代理团队能力
从 代理团队 导入 折叠团队状态
从 工具 导入 工具注册表

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

段落 主:
  # ---- 1. 事件流造两个任务 + 一个成员（代理团队 事件形状） ----
  设 事件表 为 [
    {"种类": "team/task", "任务": {"标识": "task-1", "状态": "pending", "主题": "甲", "描述": "做甲"}},
    {"种类": "team/task", "任务": {"标识": "task-2", "状态": "in_progress", "主题": "乙", "描述": "做乙"}},
    {"种类": "team/member", "成员": {"标识": "lead-1", "名字": "领队", "状态": "running"}}
  ]
  设 状态 为 折叠团队状态(事件表)
  断言相等(列表长度(字典键列表(状态["任务表"])), 2, "1a 两任务折叠")
  断言相等(列表长度(字典键列表(状态["成员表"])), 1, "1b 一成员折叠")

  # ---- 2. 造代理团队能力（读面真实事件流） ----
  设 能力 为 造代理团队能力(事件表, "lead-1")
  断言相等(能力["callerId"], "lead-1", "2a 调用者标识")

  # ---- 3. 一行接线：9 个团队工具注册进 工具注册表 ----
  设 注册表 为 新建 工具注册表()
  断言真(接线团队工具(注册表, 能力), "3a 接线返回真")
  断言相等(列表长度(注册表.名单()), 9, "3b 九工具注册")

  # ---- 4. list_agents 执行：读面真实（折叠成员表名单直透） ----
  设 r4 为 注册表.查找("list_agents")["execute"]({})
  断言真(r4["isError"] == 假, "4a 执行成功")
  断言相等(r4["content"][0]["id"], "lead-1", "4b 成员透传")

  # ---- 5. team_task_list 执行：任务过滤分页真实（分页切片信封 {"tasks": [...]}） ----
  设 r5 为 注册表.查找("team_task_list")["execute"]({})
  断言相等(列表长度(r5["content"]["tasks"]), 2, "5a 两任务")
  断言相等(r5["content"]["tasks"][0]["id"], "task-1", "5b 首任务")

  # ---- 6. team_task_get 执行：指定任务 ----
  设 r6 为 注册表.查找("team_task_get")["execute"]({"task_id": "task-2"})
  断言相等(r6["content"]["id"], "task-2", "6a 取任务")
  断言相等(r6["content"]["status"], "in_progress", "6b 任务状态")

  # ---- 7. getTask 不存在 -> 抛错 ----
  设 已抛 为 假
  尝试:
    设 _r7 为 注册表.查找("team_task_get")["execute"]({"task_id": "task-99"})
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "7a 未知任务须抛")

  # ---- 8. 写面能力缺键 -> 抛错（宿主注入位保留） ----
  设 已抛8 为 假
  尝试:
    设 _r8 为 注册表.查找("team_task_create")["execute"]({"subject": "x"})
  捕获 异常 e:
    设 已抛8 为 真
  断言真(已抛8, "8a 缺写面能力须抛")

  打印 "--- 第6轮 任务E #290 团队工具接线 测试通过 ---"

主()