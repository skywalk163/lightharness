# test_推理工具.light —— 推理与工具纯逻辑核心（任务卡 N，对标编号 64）测试
# 运行：python 运行.py examples/test_推理工具.light  → 必须 rc=0
# 反跑判据：把任一 断言相等/断言真 的期望值改反、或把期望抛改不抛，用例立即红（见各用例旁注）。
#
# 覆盖（对照原版）：
#   llm-retry/index.ts L58-63                   retry 退避（指数退避 + jitter，上限封顶）
#   llm-deepseek/serialize.ts L45-72           选项求解（reasoning effort 校验 / thinking 求解）
#   llm-deepseek/serialize.ts L74-99           内容校验/转换（文本块拼平 / 拒图像 / 校验图像角色）
#   session-stats/projection.ts L82-159        会话统计投影（输出令牌 / LLM·工具计时 / 待呼 / 轮步计数）
#   atomic-write/index.ts L35-64,66-78,80-130  原子覆写 + 写锁争用判定 + 锁协议（命名/延迟/超时/指数退避）
#   output-retention/index.ts L129-198,200-220 项保留器（预算/入/截断/收统计）+ UTF-8 尾随不完整裁剪
#
# 说明：本运行器后端不暴露异常消息给光明代码（无 转字符串/字符串包含/异常.message），
#       故 检查抛错 仅断言「确有异常抛出」（足以支撑反跑：把应抛改不抛即红）；
#       模块仍把稳定判别子以 [CODE] 拼入消息串，供能读取消息的下游断言。

从 推理工具 导入 计算退避, 校验说理力度, 求解说理, 含图像, 拼平文本, 断言纯文本, 断言图像角色, 析令牌, 判定令增量, 初始态, 投影, 原子覆写, 锁命名, 判定写锁争用, 锁延迟表, 持文件锁, 校验预算, 项保留器, 前缀表, 裁剪尾utf8

# ── 判据助手（不依赖任何不可用转换器：仅比对原值、标签为字符串）──
段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 异常 e:
    设 抛了 为 真
  如果 抛了 == 假:
    抛出 "应抛未抛: " + 标签
  返回 真

# ── 共享状态（模块级，建后端 时原地改写，避免跨用例污染）──
设 原子记录 为 []
设 锁脚本 为 { "步": 0, "结果": [], "延": [], "释": [], "时值": 0, "锁在值": 真 }

段落 清空记录:
  当 长(原子记录) > 0:
    列表弹出(原子记录)

# ── 原子覆写 后端构造（抽象真实 fs：造临时档/写独占/改名/删 均为入参能力）──
段落 记录调用 接收 标记, 档:
  原子记录.追加(标记 + ":" + 档)

段落 造临时成功 接收 终档:
  返回 终档 + ".abc.tmp"

段落 写成功 接收 临时档, 内容, 权限:
  记录调用("写独占", 临时档)

段落 改成功 接收 临时档, 终档:
  记录调用("改名", 临时档)

段落 删记录 接收 档:
  记录调用("删", 档)

段落 写失败 接收 临时档, 内容, 权限:
  抛出 新建 错误("write-fail")

段落 改失败 接收 临时档, 终档:
  抛出 新建 错误("rename-fail")

段落 建原子成功后端:
  返回 { "造临时档": 造临时成功, "写独占": 写成功, "改名": 改成功, "删": 删记录 }

段落 建原子写失败后端:
  返回 { "造临时档": 造临时成功, "写独占": 写失败, "改名": 改成功, "删": 删记录 }

段落 建原子改失败后端:
  返回 { "造临时档": 造临时成功, "写独占": 写成功, "改名": 改失败, "删": 删记录 }

# ── 写锁协议 后端构造（争用序列 / 时 / 延 / 锁在 / 释锁 均为入参能力）──
段落 试锁函数 接收 锁档:
  设 i 为 锁脚本["步"]
  设 r 为 锁脚本["结果"][i]
  设 锁脚本["步"] 为 i + 1
  返回 r

段落 时函数 接收:
  设 v 为 锁脚本["时值"]
  设 锁脚本["时值"] 为 锁脚本["时值"] + 锁脚本["时步"]
  返回 v

段落 延函数 接收 d:
  锁脚本["延"].追加(d)

段落 锁在函数 接收 锁档:
  返回 锁脚本["锁在值"]

段落 释锁函数 接收 锁档:
  锁脚本["释"].追加(锁档)

段落 建锁后端 接收 结果表, 时值, 锁在值, 时步:
  设 锁脚本["步"] 为 0
  设 锁脚本["结果"] 为 结果表
  设 锁脚本["延"] 为 []
  设 锁脚本["释"] 为 []
  设 锁脚本["时值"] 为 时值
  设 锁脚本["时步"] 为 时步
  设 锁脚本["锁在值"] 为 锁在值
  返回 { "试锁": 试锁函数, "时": 时函数, "延": 延函数, "锁在": 锁在函数, "释锁": 释锁函数 }

段落 恒等运算:
  返回 "ok-result"

# =================== 一、retry 退避 ===================
段落 用例_退避:
  设 策 为 { "初延迟": 100, "最大延迟": 5000, "抖动比": 0.5 }
  # 反跑：把 50 改 51 立即红（实际=50）
  断言相等(计算退避(策, 1, 0), 50, "退避-retry1随机0=初延迟*0.5")
  断言相等(计算退避(策, 1, 1), 150, "退避-retry1随机1=初延迟*1.5")
  # 反跑：把 5000 改 4999 立即红（上限封顶）
  断言相等(计算退避(策, 20, 1), 5000, "退避-上限封顶")
  设 策0 为 { "初延迟": 100, "最大延迟": 5000, "抖动比": 0 }
  断言相等(计算退避(策0, 2, 0.5), 200, "退避-无抖动retry2=初延迟*2")
  断言相等(计算退避(策0, 3, 0.5), 400, "退避-无抖动retry3=初延迟*4")

# =================== 二、选项求解 / 内容校验 ===================
段落 触发坏力度:
  校验说理力度("weird")

段落 触发说理冲突:
  求解说理({ "说理力度": "high" }, { "说理": "禁用", "说理力度": "low" })

段落 触发说理冲突2:
  # 缺省 thinking=禁用，且缺省自身带 说理力度=low（非 opts 显式）→ 仍判冲突抛
  求解说理({}, { "说理": "禁用", "说理力度": "low" })

段落 触发纯文本含图:
  断言纯文本([{ "型": "图像" }])

段落 触发图像角色冲突:
  断言图像角色([{ "角色": "system", "内容": [{ "型": "图像" }] }])

段落 用例_说理:
  断言相等(校验说理力度("off"), "off", "说理力度-off合法")
  断言相等(校验说理力度("max"), "max", "说理力度-max合法")
  检查抛错("说理力度-非法", 触发坏力度)
  设 r1 为 求解说理({ "目的": "session-title" }, {})
  断言相等(r1["说理"], "禁用", "求解-标题强制禁用")
  设 r2 为 求解说理({}, { "说理": "禁用" })
  断言相等(r2["说理"], "禁用", "求解-缺省禁用")
  设 r3 为 求解说理({ "说理力度": "off" }, { "说理": "启用", "说理力度": "low" })
  断言相等(r3["说理"], "禁用", "求解-off映射禁用")
  设 r4 为 求解说理({ "说理力度": "high" }, { "说理": "启用", "说理力度": "low" })
  断言相等(r4["说理"], "启用", "求解-high说理启用")
  断言相等(r4["说理力度"], "high", "求解-high力度透传")
  设 r5 为 求解说理({}, { "说理": "启用" })
  断言相等(r5["说理"], "启用", "求解-仅缺省说理")
  检查抛错("求解-说理冲突", 触发说理冲突)
  检查抛错("求解-缺省说理冲突", 触发说理冲突2)

段落 用例_内容:
  断言相等(拼平文本([{ "型": "文本", "文": "a" }, { "型": "图像" }, { "型": "文本", "文": "b" }]), "ab", "内容-拼平仅文本块")
  断言纯文本([{ "型": "文本", "文": "x" }])
  检查抛错("内容-含图像抛", 触发纯文本含图)
  断言图像角色([{ "角色": "用户", "内容": [{ "型": "图像" }] }])
  检查抛错("内容-非user图像抛", 触发图像角色冲突)

# =================== 三、会话统计投影 ===================
段落 跑投影 接收 事件表:
  设 态 为 初始态()
  遍历 事件 之 事件表:
    设 态 为 投影(态, 事件)
  返回 态

段落 用例_投影:
  # 事件表以 .追加 逐条入表（光明解析器不接受跨换行 [..] 字面量），保持单条字典单行。
  设 表 为 []
  表.追加({ "型": "步开始", "数据": { "轮": 1, "步": 1 }, "时间": 100 })
  表.追加({ "型": "助块", "数据": { "轮": 1, "步": 1, "块": { "型": "text-delta", "文": "a" } }, "时间": 120 })
  表.追加({ "型": "助消息", "数据": { "轮": 1, "步": 1, "用量": { "输出令牌": 5 } }, "时间": 200 })
  设 态1 为 跑投影(表)
  断言相等(态1["推毫秒"], 100, "投影-推毫秒=200-100")
  断言相等(态1["首令毫秒"], 20, "投影-首令毫秒=120-100")
  断言相等(态1["首令步"], 1, "投影-首令步=1")
  断言相等(态1["解码毫秒"], 80, "投影-解码毫秒=200-120")
  断言相等(态1["解码令牌"], 5, "投影-解码令牌=5")
  断言相等(态1["步数"], 0, "投影-缺步结束不增步")
  设 表 为 []
  表.追加({ "型": "步开始", "数据": { "轮": 1, "步": 1 }, "时间": 100 })
  表.追加({ "型": "助块", "数据": { "轮": 1, "步": 1, "块": { "型": "text-delta", "文": "a" } }, "时间": 120 })
  表.追加({ "型": "助消息", "数据": { "轮": 1, "步": 1, "用量": { "输出令牌": 5 } }, "时间": 200 })
  表.追加({ "型": "步结束", "数据": { "轮": 1, "步": 1 }, "时间": 200 })
  设 态2 为 跑投影(表)
  断言相等(态2["步数"], 1, "投影-步结束增步")
  断言相等(态2["轮数"], 1, "投影-轮数增")
  设 表 为 []
  表.追加({ "型": "具呼", "数据": { "呼号": "c1" }, "时间": 100 })
  表.追加({ "型": "具果", "数据": { "消息": { "源": { "呼号": "c1" } } }, "时间": 150 })
  设 态3 为 跑投影(表)
  断言相等(态3["具毫秒"], 50, "投影-具毫秒=150-100")
  断言相等(长(态3["待呼"]), 0, "投影-待呼清理")
  设 表 为 []
  表.追加({ "型": "步结束", "数据": { "轮": 1, "步": 1 }, "时间": 0 })
  表.追加({ "型": "步结束", "数据": { "轮": 1, "步": 2 }, "时间": 0 })
  设 态4 为 跑投影(表)
  断言相等(态4["轮数"], 1, "投影-同轮两步只计一轮")
  设 表 为 []
  表.追加({ "型": "具呼", "数据": { "呼号": "c2" }, "时间": 100 })
  表.追加({ "型": "轮结束", "数据": {}, "时间": 100 })
  设 态5 为 跑投影(表)
  断言相等(长(态5["待呼"]), 0, "投影-轮结束清残留待呼")
  设 表 为 []
  表.追加({ "型": "具果", "数据": { "消息": { "源": { "呼号": "nope" } } }, "时间": 100 })
  设 态6 为 跑投影(表)
  断言相等(态6["具毫秒"], 0, "投影-无匹配呼号不计时")
  设 表 为 []
  表.追加({ "型": "步开始", "数据": { "轮": 1, "步": 1 }, "时间": 100 })
  表.追加({ "型": "助块", "数据": { "轮": 1, "步": 1, "块": { "型": "text-delta", "文": "" } }, "时间": 120 })
  表.追加({ "型": "助消息", "数据": { "轮": 1, "步": 1, "用量": { "输出令牌": 5 } }, "时间": 200 })
  设 态7 为 跑投影(表)
  断言相等(态7["首令毫秒"], 0, "投影-空增量不计首令")
  断言相等(态7["解码毫秒"], 0, "投影-无首令不解码")

# =================== 四、写锁争用判定 + 锁延迟表 ===================
段落 用例_锁争用:
  断言真(判定写锁争用("EEXIST", 假), "锁争用-EEXIST恒真")
  断言真(判定写锁争用("EPERM", 真), "锁争用-EPERM且锁在")
  断言真(判定写锁争用("EPERM", 假) == 假, "锁争用-EPERM锁不在假")
  断言真(判定写锁争用("ENOENT", 假) == 假, "锁争用-其他码假")
  断言相等(锁命名("a.txt"), "a.txt.lock", "锁命名-后缀")
  断言相等(锁延迟表(5), [20,40,80,160,200], "锁延迟-5次序列封顶")
  设 长表 为 锁延迟表(10)
  断言相等(长表[4], 200, "锁延迟-第5次封顶200")
  断言相等(长表[9], 200, "锁延迟-后续维持200")

# =================== 五、持文件锁协议（整合）===================
段落 触发锁超时:
  设 后端 为 建锁后端(["EEXIST"], 0, 真, 2000)
  持文件锁("b.txt", 恒等运算, 后端)

段落 用例_锁协议:
  设 后端 为 建锁后端(["EEXIST","EEXIST","EEXIST","ok"], 0, 真, 1)
  设 结果 为 持文件锁("a.txt", 恒等运算, 后端)
  断言相等(结果, "ok-result", "锁协议-争用后取得结果")
  断言相等(锁脚本["延"], [20,40,80], "锁协议-指数退避序列")
  断言相等(锁脚本["释"], ["a.txt.lock"], "锁协议-终释放锁")

段落 用例_锁超时:
  检查抛错("锁超时", 触发锁超时)
  断言相等(锁脚本["延"], [], "锁超时-未退避即抛")

# =================== 六、原子覆写 ===================
段落 用例_原子成功:
  清空记录()
  设 后端 为 建原子成功后端()
  设 r 为 原子覆写("f.txt", "hello", 384, 后端)
  断言相等(r, 真, "原子覆写-成功返回真")
  断言相等(原子记录, ["写独占:f.txt.abc.tmp","改名:f.txt.abc.tmp"], "原子覆写-成功仅写与改名")

段落 触发原子写失败:
  清空记录()
  设 后端 为 建原子写失败后端()
  原子覆写("f.txt", "hello", 384, 后端)

段落 用例_原子写失败:
  检查抛错("原子写失败", 触发原子写失败)
  断言相等(原子记录, ["删:f.txt.abc.tmp"], "原子写失败-清理临时档")

段落 触发原子改失败:
  清空记录()
  设 后端 为 建原子改失败后端()
  原子覆写("f.txt", "hello", 384, 后端)

段落 用例_原子改失败:
  检查抛错("原子改失败", 触发原子改失败)
  断言相等(原子记录, ["写独占:f.txt.abc.tmp","删:f.txt.abc.tmp"], "原子改失败-写后清理")

# =================== 七、输出保留 + UTF-8 尾随裁剪 ===================
段落 触发预算负:
  校验预算(-1, "maxItems")

段落 触发预算浮:
  校验预算(2.5, "maxItems")

段落 用例_保留:
  设 r 为 新建 项保留器({ "上限": 2 })
  设 p1 为 r.入("a")
  断言真(p1["留"], "保留-首项留")
  断言真(p1["截"] == 假, "保留-首项不截")
  设 p2 为 r.入("b")
  断言真(p2["留"], "保留-次项留")
  设 p3 为 r.入("c")
  断言真(p3["留"] == 假, "保留-溢出项不留")
  断言真(p3["截"], "保留-溢出项截")
  设 收 为 r.收()
  断言真(收["截"], "保留-有省略")
  断言相等(收["见"], 3, "保留-见3")
  断言相等(收["留"], 2, "保留-留2")
  断言相等(收["省"]["式"], "精确", "保留-省略式精确")
  断言相等(收["省"]["数"], 1, "保留-省略数1")

段落 用例_预算:
  检查抛错("预算-负", 触发预算负)
  检查抛错("预算-浮", 触发预算浮)

段落 用例_utf8:
  断言相等(裁剪尾utf8([104,105]), [104,105], "utf8-ASCII不变")
  断言相等(裁剪尾utf8([195,169]), [195,169], "utf8-完整2字节不变")
  断言相等(裁剪尾utf8([226,130]), [], "utf8-不完整3字节裁空")
  断言相等(裁剪尾utf8([240,157,132]), [], "utf8-不完整4字节裁空")
  断言相等(裁剪尾utf8([104,226,130,172]), [104,226,130,172], "utf8-ASCII+完整€不变")
  断言相等(裁剪尾utf8([104,226,130]), [104], "utf8-ASCII后切€裁尾")
  断言相等(裁剪尾utf8([170]), [170], "utf8-孤立续字节开头不变")
  断言相等(裁剪尾utf8([249]), [249], "utf8-无效首字节不变")

# ── 主入口 ──
段落 主程:
  用例_退避()
  用例_说理()
  用例_内容()
  用例_投影()
  用例_锁争用()
  用例_锁协议()
  用例_锁超时()
