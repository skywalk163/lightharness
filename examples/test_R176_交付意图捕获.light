# test_R176_交付意图捕获.light —— B4 路 deliverables rc.3 变更捕获口径判据
# 上游锚点：packages/deliverables/workspace-changes/src/{capture.ts,index.ts,recorder.ts}
#            @ dsh-v0.2.1-rc.3（mutationPath 整段删除；capture 改吃 fs 意图事件的解析后绝对路径）
# 反跑判据：把 工区意图捕获 的空串判定删掉，或把 工区判首捕获 的 contains 反转 → 本文件必红。

从 工作区变更 导入 工区意图捕获, 工区判首捕获
从 内置核心字典 导入 字典创建, 字典设置

段落 断言相等(甲, 乙, 信息):
  如果 甲 != 乙:
    抛出 "断言失败: " + 信息 + " (期望 " + 转字符串(乙) + " 实得 " + 转字符串(甲) + ")"

段落 断言真(值, 信息):
  如果 值 != 真:
    抛出 "断言失败: " + 信息 + " (期望 真)"

段落 主:
  # ---------- §1 意图路径：fs 层已解析，记录器不再推导 ----------
  设 写意图 为 {"target": "/repo/a.txt", "kind": "write"}
  设 捕1 为 工区意图捕获(写意图)
  断言相等(捕1["路径"], "/repo/a.txt", "§1 直接取目标绝对路径")
  断言相等(捕1["来源"], "fs-intent", "§1b 来源标记为 fs 意图")

  设 改意图 为 {"target": "/repo/b c.txt", "kind": "edit"}
  断言相等(工区意图捕获(改意图)["路径"], "/repo/b c.txt", "§1c 含空格路径原样（不再拼接 cwd）")

  # 相对路径也不做 cwd 解析——上游 rc.3 把解析责任交给 fs.processPath
  设 相对意图 为 {"target": "rel/x.txt"}
  断言相等(工区意图捕获(相对意图)["路径"], "rel/x.txt", "§1d 记录器不做 resolve(cwd, path)")

  断言相等(工区意图捕获({"target": ""})["路径"], 空, "§1e 空路径 → 空")
  断言相等(工区意图捕获({"target": 1})["路径"], 空, "§1f 非字符串 → 空")
  断言相等(工区意图捕获({})["路径"], 空, "§1g 缺 target → 空")
  断言相等(工区意图捕获(空)["路径"], 空, "§1h 非字典 → 空")

  # ---------- §2 本轮首次捕获同一路径 ----------
  设 表 为 字典创建()
  断言真(工区判首捕获(表, "/repo/a.txt"), "§2 空表 → 首次")
  字典设置(表, "/repo/a.txt", {"kind": "file", "file": "blob1"})
  断言相等(工区判首捕获(表, "/repo/a.txt"), 假, "§2b 已捕获过 → 非首次")
  断言真(工区判首捕获(表, "/repo/other.txt"), "§2c 其它路径仍是首次")
  断言真(工区判首捕获(空, "/repo/a.txt"), "§2d 无表按首次处理")

  打印("test_R176_交付意图捕获: 全部用例通过")

主()
