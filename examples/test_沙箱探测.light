# test_沙箱探测.light —— R69 子任务 69.3：沙箱多平台探测链测试
#
# 验证：平台识别、各后端探测函数、主入口返回有效结果、fail-closed 行为。
# 运行：cd lightharness && python 运行.py examples/test_沙箱探测.light

从 沙箱探测 导入 探测可用后端, 有可用后端, 当前平台, 沙箱不可用错误
从 沙箱探测 导入 探测bwrap, 探测landlock, 探测rlimits, 探测freebsd_jail, 探测seatbelt, 探测windows_acl
导入 sys

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言包含(文本, 片段, 标签):
  如果 文本.包含(片段) == 假:
    抛出 "断言失败: " + 标签 + " 文本不含 " + 片段 + "；实际=" + 文本[0:200]

段落 主:
  # ============================================================
  # 1) 平台识别：当前平台应在已知平台集合中
  # ============================================================
  设 平台 为 当前平台()
  设 已知平台 为 ["linux", "freebsd", "darwin", "win32"]
  设 平台已知 为 假
  遍历 p 之 已知平台:
    如果 平台 == p:
      平台已知 为 真
  断言真(平台已知, "当前平台 " + 平台 + " 在已知平台集合中")
  打印("当前平台: " + 平台 + " (sys.platform=" + sys.platform + ")")

  # ============================================================
  # 2) 各后端探测函数返回有效结构（可用/详情字段）
  # ============================================================
  设 r_bwrap 为 探测bwrap()
  断言真("可用" 在 r_bwrap, "bwrap 探测结果含 可用 字段")
  断言真("详情" 在 r_bwrap, "bwrap 探测结果含 详情 字段")

  设 r_landlock 为 探测landlock()
  断言真("可用" 在 r_landlock, "landlock 探测结果含 可用 字段")
  断言真("详情" 在 r_landlock, "landlock 探测结果含 详情 字段")

  设 r_rlimits 为 探测rlimits()
  断言真("可用" 在 r_rlimits, "rlimits 探测结果含 可用 字段")
  断言真("详情" 在 r_rlimits, "rlimits 探测结果含 详情 字段")
  断言包含(r_rlimits["详情"], "rlimits", "rlimits 详情明确标明后端名（可追溯）")

  设 r_jail 为 探测freebsd_jail()
  断言真("可用" 在 r_jail, "freebsd-jail 探测结果含 可用 字段")
  断言真("详情" 在 r_jail, "freebsd-jail 探测结果含 详情 字段")

  设 r_seatbelt 为 探测seatbelt()
  断言真("可用" 在 r_seatbelt, "seatbelt 探测结果含 可用 字段")
  断言真("详情" 在 r_seatbelt, "seatbelt 探测结果含 详情 字段")

  设 r_acl 为 探测windows_acl()
  断言相等(r_acl["可用"], 真, "windows-acl 恒可用")
  断言包含(r_acl["详情"], "windows-acl", "windows-acl 详情含后端名")

  # ============================================================
  # 3) 主入口 探测可用后端() 返回有效结果
  # ============================================================
  设 结果 为 探测可用后端()
  断言真("后端" 在 结果, "探测结果含 后端 字段")
  断言真("执行强度" 在 结果, "探测结果含 执行强度 字段")
  断言真("探测结果" 在 结果, "探测结果含 探测结果 字段")
  断言真(长度(结果["探测结果"]) >= 1, "探测结果至少含一个候选")
  设 后端名 为 结果["后端"]
  打印("选中后端: " + 后端名 + " (执行强度=" + 结果["执行强度"] + ")")

  # 选中的后端应在该平台的候选链中
  设 平台候选 为 ["linux": ["bwrap", "landlock", "rlimits"], "freebsd": ["freebsd-jail"], "darwin": ["seatbelt"], "win32": ["windows-acl"]]
  设 候选们 为 平台候选[平台]
  设 后端在链 为 假
  遍历 候选 之 候选们:
    如果 后端名 == 候选:
      后端在链 为 真
  断言真(后端在链, "选中后端 " + 后端名 + " 在平台 " + 平台 + " 的候选链中")

  # ============================================================
  # 4) 有可用后端() 与 探测可用后端() 一致
  # ============================================================
  设 有 为 有可用后端()
  断言相等(有, 真, "有可用后端() 返回真（与 探测可用后端 一致）")

  # ============================================================
  # 5) 平台特定断言
  # ============================================================
  如果 平台 == "win32":
    # Windows 上应选中 windows-acl
    断言相等(后端名, "windows-acl", "Windows 上选中 windows-acl")
    断言相等(结果["执行强度"], "partial", "windows-acl 执行强度为 partial")
  如果 平台 == "freebsd":
    # FreeBSD 上候选是 freebsd-jail（二进制可能不存在，但探测结构有效）
    断言相等(候选们[0], "freebsd-jail", "FreeBSD 候选链首项为 freebsd-jail")
  如果 平台 == "darwin":
    断言相等(候选们[0], "seatbelt", "macOS 候选链首项为 seatbelt")
  如果 平台 == "linux":
    # Linux 上 bwrap 优先级高于 landlock，rlimits 为最终兜底
    断言相等(候选们[0], "bwrap", "Linux 候选链首项为 bwrap")
    断言相等(候选们[1], "landlock", "Linux 候选链第二项为 landlock")
    断言相等(候选们[2], "rlimits", "Linux 候选链第三项为 rlimits")
    # 本机实测（R86 方案 b）：若 bwrap/landlock 均不可用，rlimits 必须可兜底
    断言相等(r_rlimits["可用"], 真, "Linux 上探测rlimits 应可用（resource 模块）")

  打印("test_沙箱探测 全部断言通过（5 组 / 平台识别+各后端探测+主入口+有可用后端+平台特定）")
