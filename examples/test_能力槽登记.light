# test_能力槽登记.light —— 第104轮 任务线D：browser-use / computer-use 独占注册槽 + 品牌
# 上游：packages/browser-use 与 packages/computer-use（index.ts + brand.ts，同构仅文案不同）
# 被测：src/能力槽登记.light
# 运行：cd lightharness && python 运行.py examples/test_能力槽登记.light
#
# 判据（来自任务书 D 线）：
#   · 两能力各自造槽初始 空 → 登记成功 → 提供者名 返回该名 → 释放后新槽回 空；
#   · 关闭资源期间仍返回占用名（旧句柄不被 preemptive 清空）；
#   · 二次登记（异名 / 同名）一律抛错；两能力互不影响；品牌原样透传（含空串）。
#
# 语言坑规避：诊断一律走 抛出 新建 错误；错误捕获后取 转字符串(e) 再用 字符串包含 校验文案
#   （对齐 test_预设挂载过滤.light §7，容忍运行期对错误对象的封装前缀）；列表/字典字面量单行。

从 能力槽登记 导入 造浏览器槽, 造计算机槽, 登记浏览器, 登记计算机, 提供者名, 浏览器提供者名, 计算机提供者名
从 内置核心转换 导入 转字符串
从 内置核心字符串 导入 字符串包含

设 通过盘 为 {"通过": 0}

# =====================================================================
# 断言框架
# =====================================================================
段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：期望真，实际假")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)

# 应抛错：返回异常消息串（未抛错则判失败）
段落 检查抛错(用例, 标签):
  设 消息 为 "未抛错"
  尝试:
    用例()
  捕获 异常 为 e:
    设 消息 为 转字符串(e)
  如果 消息 == "未抛错":
    抛出 新建 错误("断言失败[" + 标签 + "]：应抛错未抛")
  字典设置(通过盘, "通过", 通过盘["通过"] + 1)
  返回 消息

# =====================================================================
# 主程
# =====================================================================
段落 主程():
  打印 "===== 第 104 轮任务线 D：browser-use / computer-use 独占注册槽 + 品牌 ====="

  # ---- §1 browser 生命周期：空 → 登记 → getter → 释放 → 旧句柄仍在 / 新槽空 ----
  设 b空 为 造浏览器槽()
  断言相等(提供者名(b空), 空, "1a browser 初始未占用")
  设 br 为 登记浏览器(b空, "alpha")
  设 b持 为 br[0]
  设 brel 为 br[1]
  断言相等(提供者名(b持), "alpha", "1b 登记后 getter 返回 alpha")
  设 b释 为 brel()
  断言相等(提供者名(b释), 空, "1c 释放后新槽 getter 回空")
  断言相等(提供者名(b持), "alpha", "1d 关闭期间旧句柄仍返回占用名")
  设 br2 为 登记浏览器(b释, "beta")
  断言相等(提供者名(br2[0]), "beta", "1e 在释放后的空槽上可重新登记")

  # ---- §2 computer 生命周期（同构，独立走一遍）----
  设 c空 为 造计算机槽()
  断言相等(提供者名(c空), 空, "2a computer 初始未占用")
  设 cr 为 登记计算机(c空, "capX")
  设 c持 为 cr[0]
  设 crel 为 cr[1]
  断言相等(提供者名(c持), "capX", "2b computer 登记后 getter 返回 capX")
  设 c释 为 crel()
  断言相等(提供者名(c释), 空, "2c computer 释放后新槽回空")
  断言相等(提供者名(c持), "capX", "2d computer 关闭期间旧句柄仍返回名")

  # ---- §3 占用抛错：异名 / 同名 都抛，文案逐字 ----
  段落 用浏览器异名():
    登记浏览器(b持, "other")
  段落 用浏览器同名():
    登记浏览器(b持, "alpha")
  段落 用计算机异名():
    登记计算机(c持, "capY")
  设 m1 为 检查抛错(用浏览器异名, "3a browser 异名占用抛错")
  断言真(字符串包含(m1, "browser use provider \"alpha\" is already registered"), "3b browser 异名文案逐字")
  设 m2 为 检查抛错(用浏览器同名, "3c browser 同名再登记也抛")
  断言真(字符串包含(m2, "browser use provider \"alpha\" is already registered"), "3d browser 同名文案逐字")
  设 m3 为 检查抛错(用计算机异名, "3e computer 占用抛错")
  断言真(字符串包含(m3, "computer use provider \"capX\" is already registered"), "3f computer 文案逐字")

  # ---- §4 两能力互不影响（命名空间隔离：各造各的槽，登记一侧不动另一侧）----
  设 b2空 为 造浏览器槽()
  设 c2空 为 造计算机槽()
  设 b2r 为 登记浏览器(b2空, "only-browser")
  断言相等(提供者名(c2空), 空, "4a 登记 browser 后 computer 槽仍空")
  设 c2r 为 登记计算机(c2空, "only-computer")
  断言相等(提供者名(b2r[0]), "only-browser", "4b 登记 computer 后 browser 槽不受影响")
  断言相等(提供者名(c2r[0]), "only-computer", "4c computer 槽登记成功")

  # ---- §5 品牌：名字原样透传（含空串，不加校验）----
  断言相等(浏览器提供者名("any@thing"), "any@thing", "5a browser 品牌原样透传")
  断言相等(浏览器提供者名(""), "", "5b browser 品牌空串原样")
  断言相等(计算机提供者名("cap"), "cap", "5c computer 品牌原样透传")
  断言相等(计算机提供者名(""), "", "5d computer 品牌空串原样")

  打印 "test_能力槽登记 通过 断言数=" + 转字符串(通过盘["通过"])
  打印 "--- 测试能力槽登记 通过 ---"
  返回 真

主程()
