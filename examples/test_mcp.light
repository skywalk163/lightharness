# test_mcp.light —— MCP 客户端测试（P2 生态层）
# 覆盖：连接握手 + tools/list 发现 / 注册到工具注册表（mcp__<服务器名>__<原始名>）
#       / 经注册表调用 echo、add / 注销能力。
# 反跑判据：把 echo 或 add 的断言改反即红；或把 已注册 长度断言改反即红。

导入 time
从 JSON 导入 序列化JSON
从 工具 导入 工具注册表
从 mcp客户端 导入 注册MCP服务器

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) 加上 " 期望=" 加上 转字符串(期望)

# 1) 注册 MCP 服务器：连接 + 发现 + 注册
设 注册表 为 新建 工具注册表()
设 结果 为 注册MCP服务器(注册表, "python", ["examples/mcp_服务器.py"], "demo")
如果 结果.包含("错误"):
  抛出 "MCP 注册失败: " 加上 结果["错误"]
设 客户端 为 结果["客户端"]
设 已注册 为 结果["已注册"]

# 断言发现到 2 个工具且命名正确
断言等于(长度(已注册), 2, "应发现并注册 2 个工具")
断言等于(已注册[0], "mcp__demo__echo", "第一个公开名应为 echo")
断言等于(已注册[1], "mcp__demo__add", "第二个公开名应为 add")
断言真(注册表.有无("mcp__demo__echo"), "echo 应已注册")
断言真(注册表.有无("mcp__demo__add"), "add 应已注册")

# 2) 经注册表调用 echo
设 参数1 为 序列化JSON(["text": "hello mcp"])
设 呼回1 为 注册表.执行("mcp__demo__echo", 参数1)
设 内容1 为 呼回1["content"]
设 首块1 为 内容1[0]
设 文本1 为 首块1["text"]
断言等于(文本1, "hello mcp", "echo 应回显输入")
断言等于(呼回1["isError"], 假, "echo 不应报错")

# 3) 经注册表调用 add
设 参数2 为 序列化JSON(["a": 2, "b": 3])
设 呼回2 为 注册表.执行("mcp__demo__add", 参数2)
设 内容2 为 呼回2["content"]
设 首块2 为 内容2[0]
设 文本2 为 首块2["text"]
断言等于(文本2, "5", "add 应返回 5")
断言等于(呼回2["isError"], 假, "add 不应报错")

# 4) 注销能力：注销 echo 后不再存在
注册表.注销("mcp__demo__echo")
断言等于(注册表.有无("mcp__demo__echo"), 假, "注销后 echo 不应存在")
断言真(注册表.有无("mcp__demo__add"), "注销 echo 不影响 add")

# 清理
客户端.关闭()
打印 "test_mcp PASS"
