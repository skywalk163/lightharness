# test_附件_通用文件.light —— 对标 #48 EncodedFileAttachment（上游 attachment/admission.ts + types.ts）
# 覆盖：合法/非法 base64、空串「图片拒绝 vs 文件放行」分流、错误码文案 Image/File 区分、
#       name 规整与缺省、文件引用确定性与内容寻址、端到端准入编码文件。
# 上游要点（admission.ts）：decodeCanonicalBase64(data, empty, code) ——
#   图片 empty='reject'（空串即拒，INVALID_IMAGE_BASE64）；文件 empty='accept'（空串=零字节合法，
#   INVALID_FILE_BASE64）。文件不设大小/类型限额（index.ts saveFile 注释原文）。
# 反跑判据：文件空串「放行」改「拒绝」→ 红；文件文案 File 改 Image → 红；引用确定性改随机 → 红。

从 JSON 导入 序列化JSON
从 附件准入 导入 是规范base64, 存输入, 存文件输入, 规整文件名, 造文件引用, 准入编码文件

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望: 抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 检查抛错文案 接收 标签, 运算, 片段:
  设 消息 为 ""
  尝试:
    运算()
  捕获 错误:
    设 消息 为 转字符串(错误)
  如果 消息 == "":
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 查找子串(消息, 片段) == -1:
    抛出 新建 错误("错误文案不含[" + 片段 + "]: " + 标签 + " 实际=" + 消息)

# ---- 合法 base64：文件接受 ----
段落 用例合法文件:
  设 引用 为 造文件引用(["data": "AAAA", "name": "a.bin"])
  断言相等(引用["bytes"], 3, "合法 AAAA → 3 字节")
  断言相等(引用["name"], "a.bin", "name 透传")
  断言相等(查找子串(引用["attachmentId"], "file-"), 0, "attachmentId 前缀 file-")

# ---- 空串分流：图片拒绝 / 文件放行（零字节）----
段落 段_图片空串:
  存输入(["data": "", "mediaType": "image/png"])

段落 用例空串分流:
  设 空文件 为 准入编码文件(["data": ""])
  断言相等(空文件["bytes"], 0, "文件：空串=零字节合法")
  检查抛错文案("图片：空串拒绝且文案含 Image", 段_图片空串, "Image")

# ---- 非规范 base64：两者都拒，但文案 Image/File 分流 ----
段落 段_文件非规范:
  存文件输入(["data": "AAB="])

段落 段_图片非规范:
  存输入(["data": "AAB=", "mediaType": "image/png"])

段落 用例非规范分流:
  检查抛错文案("文件：非规范拒且文案含 File", 段_文件非规范, "File")
  检查抛错文案("图片：非规范拒且文案含 Image", 段_图片非规范, "Image")

# ---- 长度非 4 倍数 / 非法字符：文件拒绝 ----
段落 段_文件长度错:
  存文件输入(["data": "AAA"])

段落 段_文件非法字符:
  存文件输入(["data": "!!!!"])

段落 用例文件拒绝:
  检查抛错文案("文件：长度非4倍数拒", 段_文件长度错, "File")
  检查抛错文案("文件：非法字符拒", 段_文件非法字符, "File")

# ---- name 规整（剥离目录路径）----
段落 用例name规整:
  断言相等(规整文件名("a/b/c.txt"), "c.txt", "剥离多级 / 路径")
  断言相等(规整文件名("dir\\x.zip"), "x.zip", "剥离 \\ 路径")
  断言相等(规整文件名("plain.txt"), "plain.txt", "无路径不变")

# ---- name 缺省 + 引用确定性 + 内容寻址 ----
段落 用例引用确定性:
  设 甲 为 造文件引用(["data": "AAAA", "name": "a.txt"])
  设 乙 为 造文件引用(["data": "AAAA", "name": "a.txt"])
  断言相等(甲["attachmentId"], 乙["attachmentId"], "同输入同 attachmentId（确定性）")
  断言相等(甲["attachmentId"] == 乙["attachmentId"], 真, "确定性二次确认")

段落 用例引用内容寻址:
  设 甲 为 造文件引用(["data": "AAAA", "name": "a.bin"])
  设 乙 为 造文件引用(["data": "AAA=", "name": "a.bin"])
  如果 甲["attachmentId"] == 乙["attachmentId"]:
    抛出 新建 错误("不同字节内容应得不同 attachmentId（内容寻址）")

段落 用例引用缺省名:
  设 引用 为 造文件引用(["data": "AAAA"])
  断言相等(引用["name"], "attachment", "未传 name → 缺省 attachment")

# ---- 端到端准入编码文件 ----
段落 用例端到端:
  设 引用 为 准入编码文件(["data": "AAAA", "name": "dir/note.md"])
  断言相等(引用["name"], "note.md", "端到端 name 规整去路径")
  断言相等(引用["bytes"], 3, "端到端 bytes 精确")

# ---- 图片与文件共用同一条规范判定（分流只在空串策略与文案）----
段落 用例规范判定共用:
  断言相等(是规范base64("AAAA"), 真, "AAAA 规范")
  断言相等(是规范base64("AAB="), 假, "AAB= 尾比特非0 非规范")

用例合法文件()
用例空串分流()
用例非规范分流()
用例文件拒绝()
用例name规整()
用例引用确定性()
用例引用内容寻址()
用例引用缺省名()
用例端到端()
用例规范判定共用()
写 "--- 附件 通用文件附件（#48 EncodedFileAttachment）测试通过 ---"
