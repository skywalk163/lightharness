# test_T0388_工具通道抖动根治.light
# T-0388「工具通道持续抖动」根治专项（修复提交 14c41e3）。
#
# 现场根因：模型在长上下文下回退 OpenAI 英文惯例（command/path/content...），
# 中文 schema 报 PARAM_SCHEMA_INVALID；旧版只回「参数校验失败」四字，模型不知错在哪，
# 原样重发直到 max-steps —— 即「工具通道持续抖动」。
#
# 三层根治（本测试逐层覆盖，任一层回退即红）：
#   §1 参数名别名归一        src/工具.light:归一参数 / 候选规范键
#   §2 校验明细回传          src/工具.light:格式化校验错误 / 工具注册表.执行
#   §3 连续失败熔断止血阀    src/代理.light:记参数失败 / 参数熔断门限
#
# 运行：python 运行.py examples/test_T0388_工具通道抖动根治.light

从 工具 导入 归一参数, 候选规范键, 格式化校验错误, 校验参数, 工具注册表, 造工具定义
从 代理 导入 代理循环
从 会话 导入 新建会话

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败（应为真）：" + 信息)

段落 断言含(文本, 片段, 信息):
  如果 查找子串(文本, 片段) < 0:
    抛出 新建 错误("断言失败（未含子串）：" + 信息 + " | 文本=" + 文本 + " 片段=" + 片段)

# 假客户端：构造代理循环用；本测试不驱动模型，仅需占位
类 假客户端:
  属性 模型名 等于 空

  段落 构造:
    设 己.模型名 为 "test-model"

段落 造代理(选项):
  设 会话对象 为 新建会话("t0388", ".")
  返回 新建 代理循环(会话对象, 新建 假客户端(), 空, 选项)

# 直接构造一条 PARAM_SCHEMA_INVALID 结果（代理层熔断只看 error.代码）
段落 参数错结果(工具名):
  返回 ["isError": 真, "error": ["消息": "参数校验失败", "代码": "PARAM_SCHEMA_INVALID", "字段错误": [["路径": ["参数", "命令"], "原因": "missing"]]]]

段落 成功结果:
  返回 ["isError": 假, "error": 空]

段落 主:
  # ============ §1 参数名别名归一 ============
  # 中文 schema：模型回退英文键 → 归一为中文规范键（现场主路径）
  设 中文模式 为 ["type": "object", "properties": [
    "命令": ["type": "string"], "路径": ["type": "string"], "内容": ["type": "string"],
    "查询": ["type": "string"], "最大结果": ["type": "integer"]
  ], "required": ["命令"]]
  设 归一1 为 归一参数(中文模式, ["command": "echo hi", "path": "a.light", "content": "x"])
  断言相等(归一1["参数"]["命令"], "echo hi", "command→命令")
  断言相等(归一1["参数"]["路径"], "a.light", "path→路径")
  断言相等(归一1["参数"]["内容"], "x", "content→内容")
  断言相等(长(归一1["改名"]), 3, "记录3处改名")

  # query / limit / start_line / end_line 等别名全覆盖
  设 归一2 为 归一参数(中文模式, ["query": "关键词", "max_results": 5, "mode": "x"])
  断言相等(归一2["参数"]["查询"], "关键词", "query→查询")
  断言相等(归一2["参数"]["最大结果"], 5, "max_results→最大结果")

  # 反向：英文 schema 下模型发中文键 → 归一为英文（插件/MCP 兼容）
  设 英文模式 为 ["type": "object", "properties": [
    "command": ["type": "string"], "path": ["type": "string"]
  ], "required": ["command"]]
  设 归一3 为 归一参数(英文模式, ["命令": "pwd", "路径": "x"])
  断言相等(归一3["参数"]["command"], "pwd", "命令→command（反向）")
  断言相等(归一3["参数"]["path"], "x", "路径→path（反向）")

  # 不越界①：目标键已存在 → 不覆盖、不改名
  设 归一4 为 归一参数(中文模式, ["command": "A", "命令": "B"])
  断言相等(归一4["参数"]["命令"], "B", "目标键已存在不被英文键覆盖")
  断言相等(长(归一4["改名"]), 0, "目标键已存在不记改名")

  # 不越界②：原键本身已在 schema 声明 → 不当别名改
  设 双模式 为 ["type": "object", "properties": [
    "command": ["type": "string"], "命令": ["type": "string"]
  ]]
  设 归一5 为 归一参数(双模式, ["command": "keep"])
  断言相等(归一5["参数"]["command"], "keep", "原键已声明则保留")
  断言相等(长(归一5["改名"]), 0, "原键已声明不记改名")

  # 不越界③：陌生键原样透传
  设 归一6 为 归一参数(中文模式, ["未知键": 42])
  断言相等(归一6["参数"]["未知键"], 42, "陌生键透传")
  断言相等(长(归一6["改名"]), 0, "陌生键不记改名")

  # 候选规范键双向可见
  断言真(候选规范键("command").包含("命令"), "候选表 command→命令")
  断言真(候选规范键("命令").包含("command"), "候选表 命令→command")

  # ============ §2 校验明细回传（真·现场复现：英文键喂中文 schema 工具）============
  设 注册表 为 新建 工具注册表()
  段落 回显(参数):
    返回 [["type": "text", "text": 参数["命令"]]]
  注册表.注册(造工具定义("执行器", "测试执行器", 中文模式, 回显))

  # 现场复现：模型发 {"command": "echo hi"} —— 归一后执行成功，不再 PARAM_SCHEMA_INVALID
  设 现场结果 为 注册表.执行("执行器", "{\"command\": \"echo hi\"}")
  断言相等(现场结果["isError"], 假, "英文键经归一后执行成功（抖动现场被消解）")
  断言相等(现场结果["content"][0]["text"], "echo hi", "归一后参数正确传入 execute")
  断言相等(现场结果["别名归一"][0], ["command", "命令"], "结果带回改名记录供观测")

  # 真缺必填 → isError + 代码 + 字段路径/原因 + 可自纠明细文本
  设 失败结果 为 注册表.执行("执行器", "{\"path\": \"only-path\"}")
  断言相等(失败结果["isError"], 真, "缺必填→isError")
  断言相等(失败结果["error"]["代码"], "PARAM_SCHEMA_INVALID", "校验失败代码")
  断言相等(失败结果["error"]["字段错误"][0]["路径"][1], "命令", "错误含字段路径")
  断言相等(失败结果["error"]["字段错误"][0]["原因"], "missing", "错误含原因 missing")
  断言含(失败结果["content"][0]["text"], "命令", "明细文本含缺失字段名（模型可自纠）")
  断言含(失败结果["content"][0]["text"], "缺少必需字段", "明细文本含原因说明（非仅四字）")

  # 格式化校验错误独立可测
  设 校验错误 为 校验参数(中文模式, ["路径": "x"])
  断言含(格式化校验错误(校验错误), "命令", "格式化错误含字段名")
  断言真(长度(格式化校验错误(校验错误)) > 12, "格式化错误不止「参数校验失败」四字")

  # ============ §3 连续失败熔断止血阀（代理层直接驱动）============
  # 默认门限 3：前 2 次不熔断，第 3 次熔断
  设 代理A 为 造代理([])
  代理A.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理A.是已终止(), 假, "第1次失败不熔断")
  断言相等(代理A.参数失败计数["bash"], 1, "第1次计数=1")
  代理A.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理A.是已终止(), 假, "第2次失败不熔断")
  断言相等(代理A.参数失败计数["bash"], 2, "第2次计数=2")
  代理A.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理A.是已终止(), 真, "第3次失败→熔断")
  断言含(代理A.中止原因, "熔断", "中止原因含熔断")
  断言含(代理A.中止原因, "bash", "中止原因含工具名")

  # 成功一次即清零（抖动间歇性：失败→成功→失败 不应累加到门限）
  设 代理B 为 造代理([])
  代理B.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理B.参数失败计数["bash"], 1, "B 第1次=1")
  代理B.记参数失败("bash", 成功结果())
  断言相等(代理B.参数失败计数["bash"], 0, "成功后清零")
  代理B.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理B.是已终止(), 假, "清零后重新计数，不误熔断")

  # 非 PARAM_SCHEMA_INVALID 错误（如 TOOL_EXECUTION_FAILED）不算参数失败
  设 代理C 为 造代理([])
  代理C.记参数失败("bash", ["isError": 真, "error": ["消息": "boom", "代码": "TOOL_EXECUTION_FAILED"]])
  断言相等(代理C.是已终止(), 假, "执行类错误不触发参数熔断")
  断言相等(代理C.参数失败计数.包含("bash"), 假, "执行类错误不计数")

  # 门限 0 → 关闭熔断（可配置）
  设 代理D 为 造代理(["参数熔断门限": 0])
  遍历 序号 之 [1, 2, 3, 4, 5]:
    代理D.记参数失败("bash", 参数错结果("bash"))
  断言相等(代理D.是已终止(), 假, "门限0关闭熔断，5次失败仍不终止")

  # 不同工具独立计数（A 工具抖动不连累 B 工具）
  设 代理E 为 造代理(["参数熔断门限": 2])
  代理E.记参数失败("读文件", 参数错结果("读文件"))
  代理E.记参数失败("写文件", 参数错结果("写文件"))
  断言相等(代理E.是已终止(), 假, "各工具1次，都未达门限")
  断言相等(代理E.参数失败计数["读文件"], 1, "读文件独立计数")
  断言相等(代理E.参数失败计数["写文件"], 1, "写文件独立计数")
  代理E.记参数失败("读文件", 参数错结果("读文件"))
  断言相等(代理E.是已终止(), 真, "读文件达门限熔断")
  断言相等(代理E.参数失败计数["写文件"], 1, "写文件计数不受影响")

  打印 "--- test_T0388_工具通道抖动根治 全部通过 ---"

主()
