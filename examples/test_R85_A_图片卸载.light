# test_R85_A_图片卸载.light —— R85 任务 A：图片卸载面（0.1.6）对拍
#
# 判据锚点（verbatim，不自行推算）：
#   ddefc45fbc packages/llm/llm/tests/content.spec.ts
#     describe('requiredImageOffload traversal')
#     describe('projectOffloadedImages')
#     describe('requiredImageOffload')
# 移植对象：src/消息.light §8 —— content.ts:126/208/218/226/258/277/311 + error.ts:172
# 偏离说明：
#   上游 `expect(projected[0]).toBe(messages[0])` 是对象同一性断言；光明 == 为深相等，
#   故以「无卸载标记时投影结果与原消息深相等」等价替代，并在报告登记。
# 回调约定：光明回调不吞多余实参，故占位/取字节回调均按 1 参声明（上游 JS 允许忽略）。
# 命名避坑：L-119/L-120 中文数字别名（一 二 三 四 五 …）与 空 是保留字，
#   本文件局部变量一律用 甲乙丙丁戊 / 表 等安全名。
#   实证：`设 四 为 [4,4,4,4]` 会让 四 绑定为整数 4，进而 `四[i]` 报
#   "object of type 'int' has no len()" 与 SyntaxWarning "'int' object is not subscriptable"。

从 消息 导入 卸载错误码, 基64长度, 内容含图片, 块已卸载, 遍历图片块, 收集图片字节, 卸载前缀数, 需卸载数, 替换已卸载图片, 投影已卸载图片, 造卸载错误

段落 对拍相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 对拍为真(条件, 标签):
  如果 条件 != 真:
    抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(条件))

# ---- 夹具（对齐 content.spec.ts 的 image() / createUserMessage()）----

段落 造附件(字节):
  返回 ["attachmentId": "img-" + 转字符串(字节), "mediaType": "image/png", "bytes": 字节, "width": 1, "height": 1]

段落 造图块(字节, 已卸载):
  设 块 为 ["type": "image", "attachment": 造附件(字节)]
  如果 已卸载 == 真:
    块["offloaded"] 为 真
  返回 块

段落 造文本块(文本):
  返回 ["type": "text", "text": 文本]

段落 造工具结果(标识, 内容):
  返回 ["type": "tool-result", "toolCallId": 标识, "content": 内容]

段落 造请求消息(内容):
  返回 ["id": "m", "role": "user", "content": 内容, "source": ["kind": "plugin", "plugin": "test"]]

# ---- 回调（模块级；光明回调无法捕获调用方局部变量）----

段落 段_取字节(块):
  设 附件 为 块["attachment"]
  返回 附件["bytes"]

设 见到盒 为 ["表": 列表创建()]

段落 段_记录字节(块):
  设 附件 为 块["attachment"]
  列表追加(见到盒["表"], 附件["bytes"])
  返回 附件["bytes"]

段落 段_占位省略(引用):
  返回 "[omitted]"

段落 段_占位带字节(引用):
  返回 "[omitted]:" + 转字符串(引用["bytes"])

# ---- 上游夹具 requiredImageOffload traversal ----

段落 造嵌套内容:
  设 最内 为 造工具结果("deep", [造图块(4, 假)])
  设 中层 为 造工具结果("nested", [最内])
  设 内层内容 为 列表创建()
  列表追加(内层内容, 造文本块("x"))
  列表追加(内层内容, 造图块(2, 假))
  列表追加(内层内容, 中层)
  设 块表 为 列表创建()
  列表追加(块表, 造文本块("before"))
  列表追加(块表, 造图块(1, 假))
  列表追加(块表, 造工具结果("shot", 内层内容))
  列表追加(块表, 造图块(3, 假))
  返回 块表

段落 对拍遍历:
  设 盒 为 见到盒
  盒["表"] 为 列表创建()
  设 内容 为 造嵌套内容()
  设 预算 为 ["representation": "raw", "maxImages": 0]
  设 请求 为 [造请求消息(内容)]
  设 数 为 需卸载数(请求, 预算, 段_记录字节)
  对拍相等(数, 4, "遍历需卸载数 maxImages=0")
  对拍相等(盒["表"], [1, 2, 4, 3], "遍历顺序 含三层嵌套")
  对拍为真(内容含图片(内容) == 真, "内容含图片 递归")
  对拍为真(内容含图片([造文本块("x")]) == 假, "内容不含图片")

段落 造请求表(字节表, 卸载索引表):
  设 内容 为 列表创建()
  设 i 为 0
  当 i < 长度(字节表):
    设 字节 为 字节表[i]
    列表追加(内容, 造图块(字节, 列表包含(卸载索引表, i) == 真))
    设 i 为 i + 1
  返回 [造请求消息(内容)]

段落 对拍预算:
  设 无上限预算 为 ["representation": "raw"]
  设 甲表 为 [4, 4, 4, 4]
  设 乙表 为 [4, 4, 4, 4, 4]
  设 丙表 为 [4, 4, 4, 4, 1]
  设 无索引 为 []
  对拍相等(需卸载数(造请求表(甲表, 无索引), 无上限预算, 段_取字节), 0, "无上限预算不卸")
  设 限字节 为 ["representation": "raw", "maxBytes": 16]
  对拍相等(需卸载数(造请求表(甲表, 无索引), 限字节, 段_取字节), 0, "恰好达标不卸")
  设 限张 为 ["representation": "raw", "maxImages": 4]
  对拍相等(需卸载数(造请求表(甲表, 无索引), 限张, 段_取字节), 0, "张数恰好达标不卸")
  设 张量 为 ["representation": "raw", "maxImages": 4, "countQuantum": 2]
  对拍相等(需卸载数(造请求表(乙表, 无索引), 张量, 段_取字节), 2, "一张超额按整张量卸 2")
  设 字节量 为 ["representation": "raw", "maxBytes": 16, "byteQuantum": 5]
  对拍相等(需卸载数(造请求表(丙表, 无索引), 字节量, 段_取字节), 2, "一字节超额按整字节量跨第 2 张")
  设 巨表 为 列表创建()
  设 i 为 0
  当 i < 129:
    列表追加(巨表, 1048576)
    设 i 为 i + 1
  设 巨预算 为 ["representation": "raw", "maxBytes": 134217728, "byteQuantum": 67108864]
  对拍相等(需卸载数(造请求表(巨表, 无索引), 巨预算, 段_取字节), 65, "129 张 1MiB 超 128MiB 按 64MiB 量卸 65")
  设 基64预算 为 ["representation": "base64", "maxBytes": 8]
  设 丁表 为 [3, 3, 3]
  对拍相等(需卸载数(造请求表(丁表, 无索引), 基64预算, 段_取字节), 1, "base64 表示按填充长度计量卸 1")
  对拍相等(需卸载数(造请求表(丁表, [0]), 基64预算, 段_取字节), 0, "已卸载项跳过")

段落 对拍基64长度:
  对拍相等(基64长度(0), 0, "base64 零字节")
  对拍相等(基64长度(1), 4, "base64 单字节")
  对拍相等(基64长度(3), 4, "base64 三字节")
  对拍相等(基64长度(4), 8, "base64 四字节")
  对拍相等(基64长度(65), 88, "base64 六十五字节")

段落 对拍前缀数:
  设 预算 为 ["maxImages": 3, "countQuantum": 2, "maxBytes": 100]
  对拍相等(卸载前缀数([1, 1, 1, 1, 1], 预算), 2, "卸载前缀数 按整量")

段落 对拍投影恒等:
  设 原 为 [造请求消息([造图块(300, 假)])]
  设 投 为 投影已卸载图片(原, 段_占位省略)
  设 甲项 为 投[0]
  设 源项 为 原[0]
  对拍相等(长度(投), 1, "投影条数")
  对拍相等(甲项, 源项, "无卸载标记时投影与原消息深相等")

段落 对拍投影替换:
  设 嵌套 为 造工具结果("shot", [造图块(3, 真)])
  设 消息甲 为 造请求消息([嵌套])
  设 消息乙 为 造请求消息([造图块(3, 真), 造图块(3, 假)])
  设 投 为 投影已卸载图片([消息甲, 消息乙], 段_占位带字节)
  设 甲项 为 投[0]
  设 甲内容 为 甲项["content"]
  设 甲内块 为 甲内容[0]
  对拍相等(甲内块["type"], "tool-result", "嵌套外层类型保留")
  对拍相等(甲内块["toolCallId"], "shot", "嵌套 toolCallId 保留")
  设 甲内层 为 甲内块["content"]
  设 甲内文 为 甲内层[0]
  对拍相等(甲内文["type"], "text", "嵌套已卸载块转文本")
  对拍相等(甲内文["text"], "[omitted]:3", "嵌套占位文本含字节")
  设 乙项 为 投[1]
  设 乙内容 为 乙项["content"]
  设 乙文本 为 乙内容[0]
  设 乙图片 为 乙内容[1]
  对拍相等(乙文本["text"], "[omitted]:3", "顶层已卸载块转占位")
  对拍相等(乙图片["type"], "image", "未标记图片保留")
  设 源乙 为 消息乙["content"][0]
  对拍为真(块已卸载(源乙) == 真, "原始消息未被投影改写")

段落 对拍投影混合:
  设 纯文本 为 造工具结果("text-only", [造文本块("kept")])
  设 消息 为 造请求消息([纯文本, 造图块(3, 真)])
  设 投 为 投影已卸载图片([消息], 段_占位省略)
  设 甲项 为 投[0]
  设 甲内容 为 甲项["content"]
  设 甲块 为 甲内容[0]
  设 乙块 为 甲内容[1]
  对拍相等(甲块, 纯文本, "混合时未改动块原样保留")
  对拍相等(乙块["type"], "text", "混合时已卸载块转文本")
  对拍相等(乙块["text"], "[omitted]", "混合占位文本")

段落 对拍卸载错误:
  对拍相等(卸载错误码(), "IMAGE_OFFLOAD_REQUIRED", "错误码逐字")
  设 错误 为 造卸载错误("base64", 2)
  对拍相等(错误["code"], "IMAGE_OFFLOAD_REQUIRED", "错误形状 code")
  对拍相等(错误["name"], "LlmError", "错误形状 name")
  对拍相等(错误["offloadImages"], 2, "错误形状 offloadImages")
  对拍为真(字符串包含(错误["message"], "2 more oldest occurrence(s)"), "错误文案含张数")
  对拍为真(字符串包含(错误["message"], "DeepSeek base64 request images exceed the route budget"), "错误文案含路由预算句")

段落 主:
  对拍遍历()
  对拍预算()
  对拍基64长度()
  对拍前缀数()
  对拍投影恒等()
  对拍投影替换()
  对拍投影混合()
  对拍卸载错误()

主()
写 "test_R85_A_图片卸载 PASS"
