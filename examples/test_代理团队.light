  列表追加(事件表, 发二["事件"])
  发消息事件(事件表, "lead", "领队", ["标识": "team-message-3", "目标标识": "mem-1", "内容": "三"], 假, "team-1", 4, 配置表())

段落 加任务到表(任务表, 标识, 状态="pending"):
  任务表[标识] 为 ["标识": 标识, "修订": 1, "主题": "t", "描述": "d", "状态": 状态, "归属": 空, "阻塞于": [], "写域": []]

# ---------- 主流程 ----------
段落 主:
  # ============ 1) 校验族 ============
  #   需要文本("主题", "subject", 200)
  #   检查抛错含("超长主题应抛", "subject exceeds 200 characters", 场建超长主题)
  #   检查抛错含("写域根路径应抛", "invalid workspace-relative write scope", 场写域根)
  #   检查抛错含("写域上跳应抛", "invalid workspace-relative write scope", 场写域上跳)
  #   断言相等(归一写域("a\\b/"), "a/b", "写域反斜杠与尾斜杠归一")
  #   断言相等(归一写域("./src/main.ts"), "src/main.ts", "写域去点斜前缀")
  #   校验成员名("runner-one")
  #   校验成员名("r2d2")
  #   检查抛错含("成员名大写应抛", "lower-kebab-case", 场成员名大写)
  #   检查抛错含("成员名 lead 应抛", "not \"lead\"", 场成员名lead)
  #   检查抛错含("成员名尾连应抛", "lower-kebab-case", 场成员名连尾)

  # ============ 2) 任务图 ============
  检查抛错含("依赖环应抛", "task dependency cycle includes", 场环)
  检查抛错含("自引用应抛", "cannot block itself", 场自引用)
  检查抛错含("重复阻塞应抛", "repeats blocker", 场重复阻塞)
  检查抛错含("缺失阻塞应抛", "is missing or deleted", 场缺阻塞)
  # 菱形不误报
  设 菱表 为 {}
  菱表["task-1"] 为 ["标识": "task-1", "状态": "completed", "阻塞于": []]
  菱表["task-2"] 为 ["标识": "task-2", "状态": "pending", "阻塞于": ["task-1"]]
  菱表["task-3"] 为 ["标识": "task-3", "状态": "pending", "阻塞于": ["task-1"]]
  菱表["task-4"] 为 ["标识": "task-4", "状态": "pending", "阻塞于": ["task-2", "task-3"]]
  断言任务图(菱表)
  # 就绪判定
  断言真(任务就绪(菱表["task-2"], 菱表), "依赖 completed 就绪")
  设 菱表["task-1"]["状态"] 为 "pending"
  断言真(任务就绪(菱表["task-2"], 菱表) == 假, "依赖未完成不就绪")

  # ============ 3) 看板 create ============
  #   设 事件表 为 []
  #   设 建果 为 造任务事件(事件表, ["主题": "实现功能", "描述": "功能描述", "写域": ["src/"]], "team-1", 1, 配置表())
  #   设 快照 为 建果["快照"]
  #   断言相等(快照["标识"], "task-1", "任务标识序列")
  #   断言相等(快照["状态"], "pending", "初始 pending")
  #   断言相等(快照["修订"], 1, "初始修订 1")
  #   断言真(快照["归属"] == 空, "初始无归属")
  #   断言相等(快照["写域"], ["src"], "写域归一入快照")
  #   检查抛错含("任务超限应抛", "Team task limit 3 reached", 场建超限)
  #   # 依赖建任务
  #   设 建果2 为 造任务事件(事件表, ["主题": "后续任务", "描述": "d", "阻塞于": ["task-1"]], "team-1", 2, 配置表())
  #   断言相等(建果2["快照"]["阻塞于"], ["task-1"], "依赖入快照")
  #   检查抛错含("缺失依赖建任务应抛", "blocker task \"task-9\" not found", 场建缺依赖)

  # ============ 4) 看板 update（CAS/授权/九动作） ============
  检查抛错含("stale 修订应抛", "stale team task \"task-1\" revision 9; current revision is 1", 场改stale)
  检查抛错含("deleted 应抛", "is deleted", 场改deleted)
  检查抛错含("越权应抛", "requires its owner or Team Lead", 场改越权)
  # claim：未就绪/被占/成功
  检查抛错含("claim 被占应抛", "owned by another member", 场claim被占)
  检查抛错含("claim 未就绪应抛", "is not ready to claim", 场claim未就绪)
  设 事件表 为 []
  加任务(事件表, "task-1", "completed", [], 空, 1)
  加任务(事件表, "task-2", "pending", ["task-1"], 空, 2)
  设 认领果 为 改任务事件(事件表, ["标识": "task-2", "期望修订": 1, "动作": "claim"], "mem-1", 假, "team-1", 3, 配置表())
  断言相等(认领果["快照"]["状态"], "in_progress", "claim 后 in_progress")
  断言相等(认领果["快照"]["归属"], "mem-1", "claim 后归属")
  断言相等(认领果["快照"]["修订"], 2, "claim 后修订+1")
  # release/complete/reopen
  设 事件表 为 []
  加任务(事件表, "task-1", "in_progress", [], "lead", 1)
  设 释果 为 改任务事件(事件表, ["标识": "task-1", "期望修订": 1, "动作": "release"], "lead", 真, "team-1", 2, 配置表())
  断言相等(释果["快照"]["状态"], "pending", "release 后 pending")
  断言真(释果["快照"]["归属"] == 空, "release 后无归属")
  检查抛错含("release 未开始应抛", "only an in-progress task can be released", 场release未开始)
  检查抛错含("edit 无字段应抛", "requires subject, description, or write_scopes", 场edit无字段)
  设 事件表 为 []
  加任务(事件表, "task-1", "in_progress", [], "lead", 1)
  设 完果 为 改任务事件(事件表, ["标识": "task-1", "期望修订": 1, "动作": "complete"], "lead", 真, "team-1", 2, 配置表())
  断言相等(完果["快照"]["状态"], "completed", "complete 后 completed")
  列表追加(事件表, 完果["事件"])
  设 重开果 为 改任务事件(事件表, ["标识": "task-1", "期望修订": 2, "动作": "reopen"], "lead", 真, "team-1", 3, 配置表())
  断言相等(重开果["快照"]["状态"], "pending", "reopen 后 pending")
  # set_dependencies / reassign / delete
  检查抛错含("设依赖缺参应抛", "set_dependencies requires blocked_by", 场设依赖缺参)
  检查抛错含("reassign 非领队应抛", "only the Team Lead can reassign tasks", 场reassign非领队)
  检查抛错含("delete 有依赖者应抛", "still blocks", 场delete有依赖)
  设 事件表 为 []
  加成员(事件表, "mem-1", "runner", "active", 1)
  加任务(事件表, "task-1", "pending", [], 空, 1)
  设 派果 为 改任务事件(事件表, ["标识": "task-1", "期望修订": 1, "动作": "reassign", "归属": "mem-1"], "lead", 真, "team-1", 2, 配置表())
  断言相等(派果["快照"]["归属"], "mem-1", "reassign 后归属")
  断言相等(派果["快照"]["状态"], "in_progress", "reassign 后 in_progress")
  设 事件表 为 []
  加任务(事件表, "task-1", "pending", [], 空, 1)
  设 删果 为 改任务事件(事件表, ["标识": "task-1", "期望修订": 1, "动作": "delete"], "lead", 真, "team-1", 2, 配置表())
  断言相等(删果["快照"]["状态"], "deleted", "delete 后墓碑")

  # ============ 5) 名册 ============
  检查抛错含("成员超限应抛", "Team member limit 1 reached", 场成员超限)
  检查抛错含("成员重名应抛", "was already used in this Team", 场成员重名)
  设 事件表 为 []
  加成员(事件表, "mem-1", "runner", "active", 1)
  加成员(事件表, "mem-2", "helper", "provisioning", 2)
  断言相等(找活跃成员(事件表, "lead"), "lead", "lead 解析")
  断言相等(找活跃成员(事件表, "runner"), "mem-1", "活跃成员解析")
  检查抛错含("非活动成员应抛", "active teammate \"helper\" not found", 场找非活动)
  检查抛错含("未知成员应抛", "active teammate \"ghost\" not found", 场找未知)

  # ============ 6) 邮箱 ============
  检查抛错含("已处置应抛", "Agent Teams service is disposing", 场发已处置)
  检查抛错含("自发消息应抛", "cannot message itself", 场发自发)
  检查抛错含("目标非活动应抛", "not found", 场发目标非活动)
  检查抛错含("超字节应抛", "team message exceeds 100 bytes", 场发超字节)
  设 事件表 为 []
  加成员(事件表, "mem-1", "runner", "active", 1)
  设 发果 为 发消息事件(事件表, "lead", "领队", ["标识": "team-message-1", "目标标识": "mem-1", "内容": "你好"], 假, "team-1", 2, 配置表())
  断言相等(发果["状态"], "accepted", "目标活跃即时投递 accepted")
  列表追加(事件表, 发果["事件"])
  # 邮箱满（待投递上限 2）
  设 事件表 为 []
  加成员(事件表, "mem-1", "runner", "provisioning", 1)
  设 事件表 为 []
  加成员(事件表, "mem-1", "runner", "active", 1)
  设 发一 为 发消息事件(事件表, "lead", "领队", ["标识": "team-message-1", "目标标识": "mem-1", "内容": "一"], 假, "team-1", 2, 配置表())
  列表追加(事件表, 发一["事件"])
  设 发二 为 发消息事件(事件表, "lead", "领队", ["标识": "team-message-2", "目标标识": "mem-1", "内容": "二"], 假, "team-1", 3, 配置表())
  列表追加(事件表, 发二["事件"])
  检查抛错含("邮箱满应抛", "has 2 pending messages", 场发邮箱满)
  # 确认送达 + 未读数 + 接受判定
  断言相等(未读数(事件表, "mem-1"), 2, "确认前未读 2")
  断言真(消息接受判定(事件表, "team-message-1") == 假, "确认前未接受")
  确认送达事件(事件表, "team-message-1", "mem-1", "team-1", 4)
  断言相等(未读数(事件表, "mem-1"), 1, "确认后未读 1")
  断言真(消息接受判定(事件表, "team-message-1"), "确认后已接受")

  # ============ 7) 投影与 invariant ============
  设 事件表 为 []
  加任务(事件表, "task-1", "pending", [], 空, 1)
  加成员(事件表, "mem-1", "runner", "active", 2)
  设 状态 为 折叠团队状态(事件表)
  断言相等(列表长度(字典键列表(状态["任务表"])), 1, "折叠任务数")
  断言相等(状态["下个任务号"], 2, "折叠下个任务号")
  检查抛错含("未知事件折叠应抛", "未知团队事件", 场未知事件)
  校验事件流(事件表)
  检查抛错含("事件流违规应抛", "violates the Agent Teams stream", 场流违规)

  # ============ 8) 分页（补充实现） ============
  检查抛错含("分页零限应抛", "limit must be a positive integer", 场分页零限)
  设 页表 为 {}
  加任务到表(页表, "task-1")
  加任务到表(页表, "task-2")
  加任务到表(页表, "task-3")
  加任务到表(页表, "task-4", "deleted")
  设 页果 为 任务分页(页表, 0, 2)
  断言相等(列表长度(页果["任务表"]), 2, "分页限量")
  断言相等(页果["下页游标"], 2, "下页游标")
  设 页果2 为 任务分页(页表, 2, 2)
  断言相等(列表长度(页果2["任务表"]), 1, "第二页剩 deleted 外 1 条")
  断言真(页果2["下页游标"] == 空, "末页无游标")

  # ============ 9) 活动聚合（补充实现） ============
  设 事件表 为 []
  加任务(事件表, "task-1", "pending", [], 空, 5)
  加任务(事件表, "task-2", "pending", [], 空, 6)
  加成员(事件表, "mem-1", "runner", "active", 7)
  设 活动表 为 近期活动(事件表, 10)
  断言相等(列表长度(活动表), 2, "连续同类型聚合")
  断言相等(活动表[0]["种类"], "team/member", "倒序最近一类")
  断言相等(活动表[0]["次数"], 1, "member 次数")
  断言相等(活动表[1]["种类"], "team/task", "连续同类型聚合")
  断言相等(活动表[1]["次数"], 2, "聚合次数")
  断言相等(活动表[1]["最近时间"], 6, "最近时间")

  # ============ 10) 生命周期（补充实现） ============
  断言团队转移("活跃", "暂停")
  断言团队转移("暂停", "活跃")
  断言团队转移("活跃", "已终止")
  检查抛错含("非法转移应抛", "invalid team transition", 场转移非法)
  设 任务表 为 {}
  任务表["task-1"] 为 ["标识": "task-1", "修订": 1, "状态": "in_progress", "阻塞于": []]
  任务表["task-2"] 为 ["标识": "task-2", "修订": 1, "状态": "pending", "阻塞于": []]
  设 清理表 为 清理终止任务(任务表)
  断言相等(清理表["task-1"]["状态"], "deleted", "终止清理 in_progress")
  断言相等(清理表["task-2"]["状态"], "pending", "pending 不受清理")
  断言相等(清理表["task-1"]["修订"], 2, "清理后修订+1")

  打印("test_代理团队 PASS")

主()
