# 溢出（模块27）测试 —— 反跑判据：改期望值即红

从 溢出 导入 扁平化纯文本, 校验上限, 构造预览, 描述省略, 溢出提示, 模拟保存文本, 溢出替换, 字节长度

段落 断言相等 接收 甲, 乙, 信息:
  如果 甲 != 乙:
    抛出 "断言失败: " 加上 信息 加上 " (期望 " 加上 转字符串(乙) 加上 " 实得 " 加上 转字符串(甲) 加上 ")"

段落 主:
  # 用例1：扁平化纯文本（含非文本块返回 空）
  断言相等(扁平化纯文本([{ "类型": "text", "文本": "hello" }, { "类型": "text", "文本": " world" }]), "hello world", "用例1 合并文本块")
  # 反跑判据：把 "hello world" 改 "" 即红
  断言相等(扁平化纯文本([{ "类型": "text", "文本": "a" }, { "类型": "image", "文本": "x" }]), 空, "用例1b 非文本块返回空")
  # 反跑判据：把 空 改 "a" 即红

  # 用例2：上限校验
  设 ok 为 真
  尝试:
    校验上限(1024)
  捕获 异常 e:
    设 ok 为 假
  断言相等(ok, 真, "用例2 合法上限通过")
  设 bad1 为 假
  尝试:
    校验上限(-1)
  捕获 异常 e:
    设 bad1 为 真
  断言相等(bad1, 真, "用例2b 负上限拒绝")
  设 bad2 为 假
  尝试:
    校验上限(1.5)
  捕获 异常 e:
    设 bad2 为 真
  断言相等(bad2, 真, "用例2c 小数上限拒绝")

  # 用例3：构造预览（头尾 + 字节边界 + 省略计数）
  设 文本 为 "ABCDEFGHIJKLMNOP"   # 16 字节 ASCII
  设 预览 为 构造预览(文本, 10)   # head=5, tail=5 → "ABCDEFGHIJ"? head=前5, tail=后5 → "ABCDEFGHIJ"? 前缀5+后缀5=10字节, 全16→省略6
  # head=(10+1)//2=5, tail=10//2=5；前缀=前5字节"ABCDE"，后缀=后5字节"LMNOP"
  断言相等(预览["文本"], "ABCDELMNOP", "用例3 头尾预览拼接")
  # 反跑判据：把 "ABCDELMNOP" 改 "ABCDEF" 即红
  断言相等(预览["省略"]["种类"], "精确", "用例3b 省略为精确")
  断言相等(预览["省略"]["计数"], 6, "用例3c 省略计数=16-10")
  # 反跑判据：把 6 改 0 即红

  # 用例3d：预算 ≥ 总长 → 原样且省略为「无」
  设 预览全 为 构造预览(文本, 100)
  断言相等(预览全["文本"], 文本, "用例3d 预算充足原样返回")
  断言相等(预览全["省略"]["种类"], "无", "用例3d 省略为无")

  # 用例3e：预算 0 → 全省略、文本空
  设 预览零 为 构造预览(文本, 0)
  断言相等(预览零["文本"], "", "用例3e 预算0文本空")
  断言相等(预览零["省略"]["计数"], 16, "用例3e 省略计数=总长")

  # 用例3f：多字节字符停在码点边界（中文3字节/字）
  设 中文 为 "一二三四五六七八"   # 8 字 × 3 = 24 字节
  设 预览中 为 构造预览(中文, 9)  # head=5,tail=4 → 前缀最多5字节=1字+2字节(第2字截断→停在边界→只取1字), 后缀4字节=1字
  # 前缀：累计到"一"(3)+"二"(3)=6 >5? 加"二"后6>5 不取，故前缀="一"(3字节)。后缀：累计"八"(3)≤4→取；"七"(3)+3=6>4 不取，故后缀="八"。文本="一八"
  断言相等(预览中["文本"], "一八", "用例3f 中文停在码点边界")
  断言相等(预览中["省略"]["计数"], 24 - 3 - 3, "用例3f 中文省略计数")

  # 用例4：描述省略
  断言相等(描述省略({ "种类": "无" }, "bytes"), "", "用例4 none→空")
  断言相等(描述省略({ "种类": "精确", "计数": 42 }, "bytes"), "Omitted 42 bytes.", "用例4 exact→Omitted")
  断言相等(描述省略({ "种类": "未知" }, "bytes"), "More bytes were omitted.", "用例4 unknown→More")

  # 用例5：溢出提示格式
  设 引用 为 { "定位符": "spill://sess/a.txt", "字节长度": 100, "检索提示": "Read the full file." }
  设 提示 为 溢出提示({ "种类": "精确", "计数": 100 }, 引用)
  断言相等(提示, "(Omitted 100 bytes. Full formatted result stored at: spill://sess/a.txt. Read the full file.)", "用例5 提示格式")
  # 反跑判据：改任意片段即红
  设 提示无 为 溢出提示({ "种类": "无" }, 引用)
  断言相等(提示无, "( Full formatted result stored at: spill://sess/a.txt. Read the full file.)", "用例5b none 提示无省略描述")

  # 用例6：saveText 契约
  设 保存输入 为 {
    "拥有者": { "会话id": "sess-1" },
    "源": { "工具名": "bash", "调用id": "c1", "标签": "result" },
    "建议名": "bash.txt",
    "内容": "some output"
  }
  设 保存引用 为 模拟保存文本(保存输入)
  断言相等(保存引用["定位符"], "spill://sess-1/bash.txt", "用例6 定位符派生")
  断言相等(保存引用["字节长度"], 11, "用例6 字节长度=内容UTF8长")
  断言相等(保存引用["检索提示"], "Read the full file to see all content.", "用例6 检索提示")
  # 反跑判据：把 11 改 0 即红

  # 用例7：溢出替换不变量——替换字节长度 ≤ cap；提示本身超 cap → 返回 空
  # 用一段明显超 cap 的文本
  设 超长 为 ""
  设 k 为 0
  当 k < 500:
    设 超长 为 超长 + "line\n"
    设 k 为 k + 1
  # 500*5=2500 字节
  设 cap 为 200
  设 替换 为 溢出替换(超长, 字节长度(超长), cap, 保存引用)
  断言相等(替换 == 空, 假, "用例7 正常溢出产生替换")
  断言相等(字节长度(替换) <= cap, 真, "用例7 不变量：替换 ≤ cap")
  # 反跑判据：把 <= 改 > 即红（需先确认 字节长度(替换) 确实 ≤ cap）

  # 极小 cap：连提示都放不下 → 返回 空（保留内联）
  设 极小替换 为 溢出替换(超长, 字节长度(超长), 10, 保存引用)
  断言相等(极小替换, 空, "用例7b 极小cap返回空")
  # 反跑判据：把 空 改 "x" 即红

  打印("--- 溢出子系统（模块27）测试通过 ---")

主()
