# test_类型注册.light —— 模块62 类型注册 对齐判据
# 运行：python 运行.py examples/test_类型注册.light
#
# 反跑判据（改反任一期望值测试必须红）：
#   - 构造注册键/构造包键/构造端点：把任一前缀（typert:/typertPackage:/typertEndpoint:）改反测试必须红
#   - 判定编解码严格：把 strict 真↔假、schema 缺↔不缺、_def/typeName 存在↔缺失 任一判定取反测试必须红
#   - 校验清单：把缺 schema 抛↔不抛、某段非对象抛↔不抛、name 空抛↔不抛、缺省补值改反测试必须红
#   - 描述符存储：把 登记重复抛↔不抛、去重 保留↔覆盖（本地>远程优先级）、撤回未登记抛↔不抛、
#     查询命中↔空、条目数 任一期望改反测试必须红

从 类型注册 导入 校验清单, 判定编解码严格, 构造注册键, 构造包键, 构造端点, 造描述符存储

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败: " + 信息 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 信息:
  如果 条件 != 真:
    抛出 新建 错误("断言真失败: " + 信息)

段落 检查抛错 接收 标签, 运算:
  设 抛了 为 假
  尝试:
    运算()
  捕获 错误 为 e:
    设 抛了 为 真
  如果 抛了 == 假:
    抛出 新建 错误("应抛未抛: " + 标签)

# ---------- 构造入参 ----------
段落 造编解码 接收 严格:
  返回 { "strict": 严格, "schema": { "_def": { "typeName": "ZodObject" } } }

段落 造模式段:
  返回 { "codec": 造编解码(真), "name": "greet", "description": "问候" }

段落 造清单:
  返回 { "schema": 造模式段(), "service": { "name": "svc", "description": "服务描述" }, "event": { "name": "ready" }, "object": { "name": "obj" }, "invocation": { "name": "inv", "service": "svc" } }

段落 造描述符 接收 名:
  返回 { "name": 名 }

# ---------- 判定编解码严格：抛错用例 ----------
段落 编解码非对象:
  判定编解码严格("x")

段落 编解码非严格:
  判定编解码严格(造编解码(假))

段落 编解码缺严格:
  判定编解码严格({ "schema": { "_def": { "typeName": "ZodObject" } } })

段落 编解码缺模式:
  判定编解码严格({ "strict": 真 })

段落 编解码模式非对象:
  判定编解码严格({ "strict": 真, "schema": "zod" })

段落 编解码缺定义:
  判定编解码严格({ "strict": 真, "schema": { "name": "x" } })

段落 编解码定义非对象:
  判定编解码严格({ "strict": 真, "schema": { "_def": 42 } })

段落 编解码缺种类:
  判定编解码严格({ "strict": 真, "schema": { "_def": { "x": 1 } } })

# ---------- 校验清单：抛错用例 ----------
段落 清单非对象:
  校验清单("nope")

段落 清单缺模式段:
  校验清单({ "service": { "name": "svc" } })

段落 清单模式段非对象:
  校验清单({ "schema": "x" })

段落 清单模式缺编解码:
  校验清单({ "schema": { "name": "greet" } })

段落 清单模式名空:
  校验清单({ "schema": { "codec": 造编解码(真), "name": "" } })

段落 清单模式名非串:
  校验清单({ "schema": { "codec": 造编解码(真), "name": 7 } })

段落 清单服务非对象:
  校验清单({ "schema": 造模式段(), "service": 42 })

段落 清单服务名空:
  校验清单({ "schema": 造模式段(), "service": { "name": "" } })

段落 清单时机非对象:
  校验清单({ "schema": 造模式段(), "event": 42 })

段落 清单时机名空:
  校验清单({ "schema": 造模式段(), "event": { "name": "" } })

段落 清单对象名空:
  校验清单({ "schema": 造模式段(), "object": { "name": "" } })

段落 清单调用名空:
  校验清单({ "schema": 造模式段(), "invocation": { "name": "" } })

# ---------- 描述符存储：抛错用例（共享模块级 库） ----------
段落 重复登记:
  库.登记("本地", 造描述符("greet"))

段落 撤回未登记:
  库.撤回("typert:nope")

# 模块级共享存储实例
设 库 为 造描述符存储()

段落 主:
  # ============ 1) 三个 key 生成纯函数 ============
  断言相等(构造注册键("greet"), "typert:greet", "注册键前缀")
  断言相等(构造包键("acp"), "typertPackage:acp", "包键前缀")
  断言相等(构造端点("greet"), "typertEndpoint:greet", "端点前缀")
  断言相等(构造注册键("a:b"), "typert:a:b", "注册键原样保留")

  # ============ 2) 判定编解码严格 ============
  断言真(判定编解码严格(造编解码(真)) == 真, "严格且 zod v4 schema 通过")
  检查抛错("非对象应抛", 编解码非对象)
  检查抛错("非严格应抛", 编解码非严格)
  检查抛错("缺 strict 应抛", 编解码缺严格)
  检查抛错("缺 schema 应抛", 编解码缺模式)
  检查抛错("schema 非对象应抛", 编解码模式非对象)
  检查抛错("缺 _def 应抛", 编解码缺定义)
  检查抛错("_def 非对象应抛", 编解码定义非对象)
  检查抛错("缺 typeName 应抛", 编解码缺种类)

  # ============ 3) 校验清单 ============
  # 合法全量清单 → 规范化
  设 全1 为 校验清单(造清单())
  断言相等(全1["schema"]["name"], "greet", "schema name 规范化")
  断言相等(全1["schema"]["description"], "问候", "schema 描述保留")
  断言相等(全1["schema"]["version"], "1", "schema 版本缺省 1")
  断言相等(全1["service"]["name"], "svc", "service name 规范化")
  断言相等(全1["service"]["description"], "服务描述", "service 描述保留")
  断言相等(全1["event"]["name"], "ready", "event name 规范化")
  断言相等(全1["object"]["name"], "obj", "object name 规范化")
  断言相等(全1["invocation"]["name"], "inv", "invocation name 规范化")
  断言相等(全1["invocation"]["service"], "svc", "invocation service 保留")
  # 仅 schema 段：缺省段为空
  设 简1 为 校验清单({ "schema": { "codec": 造编解码(真), "name": "bare" } })
  断言相等(简1["schema"]["description"], "", "schema 描述缺省空串")
  断言相等(简1["schema"]["version"], "1", "schema 版本缺省 1")
  断言真(简1["service"] == 空, "缺省 service 为空")
  断言真(简1["event"] == 空, "缺省 event 为空")
  断言真(简1["object"] == 空, "缺省 object 为空")
  断言真(简1["invocation"] == 空, "缺省 invocation 为空")
  # 抛错路径
  检查抛错("顶层非对象应抛", 清单非对象)
  检查抛错("缺 schema 段应抛", 清单缺模式段)
  检查抛错("schema 段非对象应抛", 清单模式段非对象)
  检查抛错("schema 缺 codec 应抛", 清单模式缺编解码)
  检查抛错("schema name 空应抛", 清单模式名空)
  检查抛错("schema name 非串应抛", 清单模式名非串)
  检查抛错("service 段非对象应抛", 清单服务非对象)
  检查抛错("service name 空应抛", 清单服务名空)
  检查抛错("event 段非对象应抛", 清单时机非对象)
  检查抛错("event name 空应抛", 清单时机名空)
  检查抛错("object name 空应抛", 清单对象名空)
  检查抛错("invocation name 空应抛", 清单调用名空)

  # ============ 4) 描述符存储：登记/查询/去重/撤回 ============
  断言相等(库.条目数(), 0, "初始为空")
  # 登记
  设 甲 为 库.登记("本地", 造描述符("greet"))
  断言真(库.判定已登记("typert:greet"), "登记后已存在")
  断言相等(甲["来源"], "本地", "登记来源记录")
  断言相等(甲["描述符"]["name"], "greet", "登记描述符保留")
  断言相等(库.条目数(), 1, "登记后条数 1")
  # 重复登记抛错且不新增
  检查抛错("重复登记应抛", 重复登记)
  断言相等(库.条目数(), 1, "重复登记不新增")
  # 查询
  设 乙 为 库.查询("typert:greet")
  断言相等(乙["来源"], "本地", "查询来源")
  断言相等(乙["描述符"]["name"], "greet", "查询描述符")
  断言真(库.查询("typert:nope") == 空, "未登记查询为空")
  # 去重：同键远程低优先级 → 保留现有
  设 丙 为 库.去重("远程", 造描述符("greet"))
  断言相等(丙, { "新增": 假, "覆盖": 假 }, "远程去重保留本地")
  断言相等(库.查询("typert:greet")["来源"], "本地", "保留现有来源")
  断言相等(库.条目数(), 1, "去重不新增")
  # 去重：新键远程新增
  设 库2 为 造描述符存储()
  设 丁 为 库2.去重("远程", 造描述符("ping"))
  断言相等(丁, { "新增": 真, "覆盖": 假 }, "新键远程新增")
  断言相等(库2.条目数(), 1, "去重新增条数 1")
  # 去重：本地高优先级覆盖远程
  设 戊 为 库2.去重("本地", 造描述符("ping"))
  断言相等(戊, { "新增": 假, "覆盖": 真 }, "本地覆盖远程")
  断言相等(库2.查询("typert:ping")["来源"], "本地", "覆盖后来源本地")
  # 去重：同级本地去重保留
  设 辛 为 库2.去重("本地", 造描述符("ping"))
  断言相等(辛, { "新增": 假, "覆盖": 假 }, "同级本地去重保留")
  # 撤回
  设 庚 为 库.撤回("typert:greet")
  断言相等(庚["描述符"]["name"], "greet", "撤回返回原条目")
  断言真(库.判定已登记("typert:greet") == 假, "撤回后不存在")
  断言相等(库.条目数(), 0, "撤回后清空")
  检查抛错("未登记撤回应抛", 撤回未登记)

  打印("--- 类型注册（模块62）测试通过 ---")

主()
