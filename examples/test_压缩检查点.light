# test_压缩检查点.light —— R102 任务I：checkpoint + tool-pairing + bracket 状态机
#
# 覆盖：
#   一、checkpoint 来源保存-恢复往返（造检查点来源 → 是否检查点来源）
#   二、tool-pairing：正常配对 / 孤儿 tool_use / 缺失 result（损坏表面抛错）
#   三、压缩括号状态机（start/summary/end：双重触发 / 孤儿 / 标识配对 / 一次性 summary /
#       成功 end 需 summary / error end 回滚）
#   四、遮蔽序号表校验
#
# 反跑 4 组：
#   反跑1：推进开始删掉「已有压缩在进行」判断 → 双重 start 用例立红
#   反跑2：推进摘要删掉「无对应 start」判断 → 孤儿 summary 用例立红
#   反跑3：推进结束删掉「成功 end 需 summary」判断 → 无 summary 的成功 end 立红
#   反跑4：校验遮蔽表删掉「首项==range.start」判断 → 错配首项被接受立红
#
# 运行：cd lightharness && python 运行.py examples/test_压缩检查点.light

从 压缩配套 导入 造检查点来源, 是否检查点来源, 配对平衡前, 配对平衡后, 建立缓存
从 压缩状态机 导入 构造压缩轨迹, 推进压缩轨迹, 校验遮蔽表

# ===== 断言工具 =====
段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
    如果 条件 != 真:
        抛出 "断言失败: " + 标签

段落 断言空(值, 标签):
    如果 值 != 空:
        抛出 "断言失败(应为空): " + 标签 + " 实际=" + 转字符串(值)

段落 断言非空(值, 标签):
    如果 值 == 空:
        抛出 "断言失败(应非空): " + 标签

打印 "=== 一、checkpoint 来源往返 ==="

设 源1 为 造检查点来源("cmp-1", "cmd-x")
断言相等(源1["种类"], "plugin", "checkpoint 种类")
断言相等(源1["插件"], "compact", "checkpoint 插件")
断言相等(源1["压缩标识"], "cmp-1", "checkpoint 压缩标识")
断言相等(源1["来源命令标识"], "cmd-x", "checkpoint 来源命令标识")
断言真(是否检查点来源(源1) == 真, "checkpoint 来源可识别")

设 源2 为 造检查点来源("cmp-2", 空)
断言相等(取可选(源2, "来源命令标识"), 空, "无命令标识时省略字段")
断言真(是否检查点来源(源2) == 真, "无命令标识仍可识别")
断言真(是否检查点来源({"种类": "user", "文本": "普通消息"}) == 假, "普通来源不识别为检查点")

打印 "=== 二、tool-pairing ==="

# 表面：0=user,1=assistant(1 tool-call),2=tool/result,3=assistant(0),4=assistant(1 tool-call 孤儿)
# 切口表：[T,T,F,T,T,F]
设 日志表 为 []
日志表.追加({ "序号": 0, "类型": "user/message", "数据": {} })
日志表.追加({ "序号": 1, "类型": "assistant/message", "数据": { "消息": { "content": [ { "类型": "tool-call" } ] } } })
日志表.追加({ "序号": 2, "类型": "tool/result", "数据": {} })
日志表.追加({ "序号": 3, "类型": "assistant/message", "数据": { "消息": { "content": [] } } })
日志表.追加({ "序号": 4, "类型": "assistant/message", "数据": { "消息": { "content": [ { "类型": "tool-call" } ] } } })
设 表面 为 { "节点表": [0, 1, 2, 3, 4], "事件表": 日志表, "生成代": 0, "平衡缓存": 空 }

# 正常配对：call(seq1) 与 result(seq2) 闭合
断言真(配对平衡前(表面, 2) == 假, "正常配对：call 后切口仍未闭合")
断言真(配对平衡后(表面, 2) == 真, "正常配对：result 后切口闭合")
断言真(配对平衡前(表面, 0) == 真, "正常配对：表面首切口平衡")

# 孤儿 tool_use：seq4 的 tool-call 无 result，表面尾切口不平衡
断言真(配对平衡后(表面, 4) == 假, "孤儿 tool_use：尾切口不平衡")

# 缺失 result：开头就来 tool/result（无前置 open call）→ 损坏表面抛错
设 坏日志 为 [{ "序号": 0, "类型": "tool/result", "数据": {} }]
设 坏表面 为 { "节点表": [0], "事件表": 坏日志, "生成代": 0, "平衡缓存": 空 }
设 损坏抛错 为 假
尝试:
    建立缓存(坏日志, [0], 0)
捕获 错误:
    设 损坏抛错 为 真
断言真(损坏抛错, "缺失 result（无前置 call）→ 损坏表面抛错")

打印 "=== 三、括号状态机 ==="

# 3.1 幸福路径：start → summary → 成功 end（清槽）
设 轨迹1 为 构造压缩轨迹()
断言空(推进压缩轨迹(轨迹1, { "类别": "compaction/start", "数据": { "标识": "c1" } }), "3.1 start 通过")
断言空(推进压缩轨迹(轨迹1, { "类别": "compaction/summary", "数据": { "标识": "c1" } }), "3.1 summary 通过")
断言空(推进压缩轨迹(轨迹1, { "类别": "compaction/end", "数据": { "标识": "c1" } }), "3.1 成功 end 通过")
断言空(轨迹1["开启"], "3.1 end 后槽已清")

# 3.2 双重触发：open 中再来 start
设 轨迹2 为 构造压缩轨迹()
推进压缩轨迹(轨迹2, { "类别": "compaction/start", "数据": { "标识": "c1" } })
设 双开错 为 推进压缩轨迹(轨迹2, { "类别": "compaction/start", "数据": { "标识": "c2" } })
断言非空(双开错, "3.2 双重 start 拒绝")

# 3.3 孤儿 summary / 孤儿 end
设 轨迹3 为 构造压缩轨迹()
断言非空(推进压缩轨迹(轨迹3, { "类别": "compaction/summary", "数据": { "标识": "x" } }), "3.3 孤儿 summary 拒绝")
设 轨迹3b 为 构造压缩轨迹()
断言非空(推进压缩轨迹(轨迹3b, { "类别": "compaction/end", "数据": { "标识": "x" } }), "3.3 孤儿 end 拒绝")

# 3.4 标识配对：summary 用错 id
设 轨迹4 为 构造压缩轨迹()
推进压缩轨迹(轨迹4, { "类别": "compaction/start", "数据": { "标识": "c1", "命令": "cmd-a" } })
断言非空(推进压缩轨迹(轨迹4, { "类别": "compaction/summary", "数据": { "标识": "其他", "命令": "cmd-a" } }), "3.4 summary id 不匹配拒绝")
断言非空(推进压缩轨迹(轨迹4, { "类别": "compaction/summary", "数据": { "标识": "c1", "命令": "cmd-b" } }), "3.4 summary 命令不一致拒绝")

# 3.5 summary 一次性
设 轨迹5 为 构造压缩轨迹()
推进压缩轨迹(轨迹5, { "类别": "compaction/start", "数据": { "标识": "c1" } })
推进压缩轨迹(轨迹5, { "类别": "compaction/summary", "数据": { "标识": "c1" } })
断言非空(推进压缩轨迹(轨迹5, { "类别": "compaction/summary", "数据": { "标识": "c1" } }), "3.5 重复 summary 拒绝")

# 3.6 成功 end 需 summary；error end 允许回滚
设 轨迹6 为 构造压缩轨迹()
推进压缩轨迹(轨迹6, { "类别": "compaction/start", "数据": { "标识": "c1" } })
断言非空(推进压缩轨迹(轨迹6, { "类别": "compaction/end", "数据": { "标识": "c1" } }), "3.6 无 summary 的成功 end 拒绝")
# 带 error 的 end 回滚：清槽，随后可再起一次
设 轨迹6b 为 构造压缩轨迹()
推进压缩轨迹(轨迹6b, { "类别": "compaction/start", "数据": { "标识": "c1" } })
断言空(推进压缩轨迹(轨迹6b, { "类别": "compaction/end", "数据": { "标识": "c1", "错误": "summarizer 崩了" } }), "3.6 error end 回滚通过")
断言空(轨迹6b["开启"], "3.6 error end 后槽已清")
断言空(推进压缩轨迹(轨迹6b, { "类别": "compaction/start", "数据": { "标识": "c2" } }), "3.6 回滚后可新起压缩")

打印 "=== 四、遮蔽序号表校验 ==="

# 表面节点 [10,11,12,13]，遮蔽区间 start=10 end=12 → 应为 [10,11,12]
断言空(校验遮蔽表([10, 11, 12, 13], 10, 12, [10, 11, 12]), "4.0 正确遮蔽表通过")
断言非空(校验遮蔽表([10, 11, 12, 13], 10, 12, []), "4.1 空遮蔽表拒绝")
断言非空(校验遮蔽表([10, 11, 12, 13], 10, 12, [99, 11, 12]), "4.2 首项不匹配拒绝")
断言非空(校验遮蔽表([10, 11, 12, 13], 10, 12, [10, 12]), "4.3 缺中间节点拒绝")
断言非空(校验遮蔽表([10, 11, 12, 13], 12, 10, [10, 11, 12]), "4.4 终点早于起点拒绝")

打印 ""
打印 "test_压缩检查点 PASS"
