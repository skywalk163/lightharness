# test_事件循环.light —— 事件循环.light 回归测试（R66 子任务 66.2）
#
# 覆盖（规划文档 66.2 验收）：
#   1) 定时器按到期序触发（20/40/60ms 最小堆出列）
#   2) 取消定时器：取消的不再触发；重复取消返回 假
#   3) 套接字可读触发回调（读事件派发 + 读回调拿到的 fd 正确）
#   4) 写事件派发（connect 后套接字可写）
#   5) 同一 fd 读写同挂（掩码等值三分支）与独立注销
#   6) 回调异常隔离：炸掉的回调不炸循环，错误表 可查
#   7) 立即调度：同线程投递 + 跨线程投递（运行持续 中被唤醒并派发）
#   8) 停止/关闭语义：停止 后 运行一次 返回 假、立即调度 返回 假
#   9) 0ms 定时器下一轮即到期
#
# 运行：cd lightharness && python 运行.py examples/test_事件循环.light
从 事件循环 导入 事件循环
从 套接字 导入 新建套接字对, AF_INET
导入 threading
导入 time

# 回调不能闭包（该语言无嵌套段落），共享状态全走模块级 状态 表
设 状态 为 {"序列": [], "错误数": 0, "停止计数": 0, "循环": 空}

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + "；实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

# ---------- 回调（顶层段落，无参/单参两种签名） ----------
段落 记20:
  状态["序列"].追加("t20")

段落 记40:
  状态["序列"].追加("t40")

段落 记60:
  状态["序列"].追加("t60")

段落 记99:
  状态["序列"].追加("t99")

段落 记零毫秒:
  状态["序列"].追加("zero")

段落 炸回调(fd):
  状态["错误数"] 为 状态["错误数"] + 1
  抛出 "故意炸的回调（隔离用）"

段落 记读(fd):
  状态["序列"].追加(["读", fd])

段落 记写(fd):
  状态["序列"].追加(["写", fd])

段落 跨线程落点:
  状态["序列"].追加("跨线程")

段落 停循环:
  状态["停止计数"] 为 状态["停止计数"] + 1
  状态["循环"].停止()

# ---------- 1) 定时器按序 + 2) 取消 ----------
段落 试定时器:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  循环.延时回调(60, 记60)
  循环.延时回调(20, 记20)
  设 句柄40 为 循环.延时回调(40, 记40)
  断言真(循环.取消定时器(句柄40), "40ms 定时器取消成功")
  断言真(循环.取消定时器(句柄40) == 假, "同一句柄二次取消返回假")
  断言真(循环.取消定时器(999) == 假, "不存在的句柄取消返回假")
  循环.延时回调(1, 记99)
  # 跑到 60ms 定时器出列为止（运行持续 靠 停止 收口，这里用 运行一次 轮询）
  设 截止 为 time.monotonic() + 2.0
  当 长度(状态["序列"]) < 3 且 time.monotonic() < 截止:
    循环.运行一次(10)
  断言相等(状态["序列"], ["t99", "t20", "t60"], "定时器按到期序出列且取消的不触发")
  循环.关闭()

# ---------- 3) 读事件 + 回调拿 fd ----------
段落 试读事件:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  设 甲乙 为 新建套接字对(AF_INET, 真)
  设 甲 为 甲乙[0]
  设 乙 为 甲乙[1]
  循环.注册读(甲.文件号(), 记读)
  乙.发送(b"x")
  设 派发过 为 循环.运行一次(500)
  断言真(派发过, "读事件派发返回真")
  断言相等(状态["序列"], [["读", 甲.文件号()]], "读回调收到注册时的 fd")
  # 数据真正可读（回调没消费），注销后循环恢复空转
  断言真(循环.注销读(甲.文件号()), "注销读 返回真")
  断言真(循环.注销读(甲.文件号()) == 假, "重复注销读 返回假")
  断言真(循环.运行一次(30) == 假, "注销后无事件空转")
  甲.关闭()
  乙.关闭()
  循环.关闭()

# ---------- 4) 写事件 ----------
段落 试写事件:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  设 甲乙 为 新建套接字对(AF_INET, 真)
  设 乙 为 甲乙[1]
  循环.注册写(乙.文件号(), 记写)
  断言真(循环.运行一次(500), "可写事件派发")
  断言相等(状态["序列"], [["写", 乙.文件号()]], "写回调收到 fd")
  断言真(循环.注销写(乙.文件号()), "注销写 返回真")
  设 甲 为 甲乙[0]
  甲.关闭()
  乙.关闭()
  循环.关闭()

# ---------- 5) 同 fd 读写同挂 + 独立注销 ----------
段落 试读写同挂:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  设 甲乙 为 新建套接字对(AF_INET, 真)
  设 甲 为 甲乙[0]
  设 乙 为 甲乙[1]
  循环.注册读(甲.文件号(), 记读)
  循环.注册写(甲.文件号(), 记写)
  # 触发读：让对端写一个字节
  乙.发送(b"y")
  设 截止 为 time.monotonic() + 2.0
  当 长度(状态["序列"]) < 2 且 time.monotonic() < 截止:
    循环.运行一次(20)
  # 读+写同轮都应派发（先读后写）
  断言相等(状态["序列"][0][0], "读", "同挂时先派发读")
  断言相等(状态["序列"][1][0], "写", "同轮随后派发写")
  # 独立注销：注销读之后，写回调还在（用下次运行验证不炸）
  循环.注销读(甲.文件号())
  断言真(循环.注销写(甲.文件号()), "写回调独立注销")
  甲.关闭()
  乙.关闭()
  循环.关闭()

# ---------- 6) 回调异常隔离 ----------
段落 试异常隔离:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  设 甲乙 为 新建套接字对(AF_INET, 真)
  设 甲 为 甲乙[0]
  设 乙 为 甲乙[1]
  循环.注册读(甲.文件号(), 炸回调)
  乙.发送(b"boom")
  断言真(循环.运行一次(500), "炸掉的回调也计派发")
  # socketpair 里的数据没被回调消费，不注销的话下一次运行还会再炸一次
  循环.注销读(甲.文件号())
  # 循环还活着：0ms 定时器下一轮照常跑
  循环.延时回调(0, 记零毫秒)
  断言真(循环.运行一次(500), "异常后循环仍可运行")
  断言相等(状态["序列"], ["zero"], "炸后后续回调照常派发")
  断言相等(长度(循环.错误表), 1, "错误表 记到一条")
  断言真(转字符串(循环.错误表[0][1]).包含("故意炸"), "错误表 内容可读")
  甲.关闭()
  乙.关闭()
  循环.关闭()

# ---------- 7) 立即调度（同线程 + 跨线程） ----------
段落 试调度:
  # 同线程：立即调度 的回调在本轮最先派发
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  循环.延时回调(50, 记60)
  循环.立即调度(记20)
  循环.运行一次(200)
  断言相等(状态["序列"][0], "t20", "立即调度 优先于定时器")
  循环.关闭()

  # 跨线程：运行持续 跑在子线程，主线程投递收尾回调把循环停掉
  设 循环2 为 新建 事件循环()
  状态["循环"] 为 循环2
  状态["序列"] 为 []
  状态["停止计数"] 为 0
  设 t 为 threading.Thread(target=跨线程投递者)
  t.start()
  循环2.运行持续()
  t.join(2000)
  断言相等(状态["序列"], ["跨线程"], "跨线程投递被派发")
  断言相等(状态["停止计数"], 1, "收尾回调停止了循环")
  断言真(t.is_alive() == 假, "投递线程已结束")
  断言真(循环2.立即调度(记20) == 假, "停止后 立即调度 返回假")
  断言真(循环2.运行一次(10) == 假, "停止后 运行一次 返回假")
  循环2.关闭()

段落 跨线程投递者:
  # 模拟另一条业务线程往循环里投工作；给 运行持续 一点先睡进 select 的时间
  time.sleep(0.1)
  状态["循环"].立即调度(跨线程落点)
  状态["循环"].立即调度(停循环)

# ---------- 9) 0ms 定时器 ----------
段落 试零毫秒:
  设 循环 为 新建 事件循环()
  状态["序列"] 为 []
  循环.延时回调(0, 记零毫秒)
  断言真(循环.运行一次(200), "0ms 定时器下一轮到期")
  断言相等(状态["序列"], ["zero"], "0ms 定时器触发了")
  循环.关闭()

段落 主:
  试定时器()
  试读事件()
  试写事件()
  试读写同挂()
  试异常隔离()
  试调度()
  试零毫秒()
  输出("test_事件循环.light 全部断言通过（9 组 / 定时器按序+取消+读事件+写事件+读写同挂+异常隔离+立即调度+跨线程+停止关闭语义）")

主()
