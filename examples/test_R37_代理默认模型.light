# test_R37_代理默认模型.light —— 第 37 轮 任务 2 判据：agent-default-model 复刻
# 上游：deepseek-harness 0.1.5-rc.2 packages/core/agent-default-model/
#   src/index.ts（109 行） + tests/agent-default-model.spec.ts（官方 5 用例，§5-§9 逐条映射）
# 运行：cd lightharness && python 运行.py examples/test_R37_代理默认模型.light
# 覆盖：建配置/校验/投影/取当前选择/更新/挂载部分叠加/保存整节替换/卸载回退/无挂载 no-op

从 内置核心字典 导入 字典包含键
从 代理默认模型 导入 默认模型设置命名空间
从 代理默认模型 导入 校验设置载荷, 校验模型配置, 投影选择
从 代理默认模型 导入 建默认模型配置, 取当前选择, 更新默认模型
从 代理默认模型 导入 挂载设置源, 卸载设置源, 写用户层, 保存选择

段落 必等(实际, 期望, 编号):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败 #" + 编号 + "：实际 " + 转字符串(实际) + "，期望 " + 转字符串(期望))
  返回 真

段落 通过(编号):
  打印 "OK #" + 编号
  返回 真

段落 主:
  设 计数 为 0

  # ===== #00 判据自检：断言助手必须真能报错 =====
  设 计数 为 计数 + 1
  设 自检报错 为 假
  尝试:
    必等(1, 2, "自检")
  捕获 异常 为 e:
    设 自检报错 为 真
  必等(自检报错, 真, "00")
  通过("00")

  # ===== §1 建默认模型配置（对应上游 Config + 构造）=====
  设 计数 为 计数 + 1
  设 配置 为 建默认模型配置("deepseek-official", "deepseek-v4-flash")
  必等(校验模型配置(配置), 真, "01")
  必等(字典包含键(配置["入口"], "推理力度"), 假, "02")
  必等(配置["形态"], "代理默认模型配置", "02b")
  通过("01-02b")

  设 计数 为 计数 + 1
  设 带力度 为 建默认模型配置("p1", "m1", "high")
  必等(带力度["入口"]["推理力度"], "high", "03")
  必等(字典包含键(带力度["入口"], "推理力度"), 真, "03b")
  通过("03")

  # 非法入参抛错（上游 Config schema 校验失败即抛）
  设 计数 为 计数 + 1
  设 抛错数 为 0
  尝试:
    建默认模型配置(123, "m")
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  尝试:
    建默认模型配置("p", {})
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  尝试:
    建默认模型配置("p", "m", 9)
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  必等(抛错数, 3, "04")
  通过("04")

  # ===== §2 schema 校验（对应 AGENT_DEFAULT_MODEL_SETTINGS_SCHEMA / Config）=====
  设 计数 为 计数 + 1
  必等(校验设置载荷({"提供者": "p", "模型": "m"}), 真, "05")
  必等(校验设置载荷({"提供者": "p"}), 假, "05b")
  必等(校验设置载荷({"模型": "m"}), 假, "05c")
  必等(校验设置载荷({"提供者": "p", "模型": "m", "推理力度": 7}), 假, "05d")
  必等(校验设置载荷("不是字典"), 假, "05e")
  必等(校验模型配置({"形态": "代理默认模型配置", "入口": {"提供者": "p"}}), 假, "05f")
  必等(校验模型配置({"形态": "别的", "入口": {"提供者": "p", "模型": "m"}}), 假, "05g")
  通过("05")

  # ===== §3 投影选择（对应私有 selection()；ReasoningEffortId 无验证原样保留）=====
  设 计数 为 计数 + 1
  设 投影甲 为 投影选择({"提供者": "p", "模型": "m"})
  必等(投影甲["提供者"], "p", "06")
  必等(投影甲["模型"], "m", "06b")
  必等(字典包含键(投影甲, "推理力度"), 假, "06c")
  设 投影乙 为 投影选择({"提供者": "p", "模型": "m", "推理力度": "ultra"})
  必等(投影乙["推理力度"], "ultra", "06d")
  通过("06")

  # ===== §4 取当前选择：未挂载读组合入口；返回分离副本 =====
  设 计数 为 计数 + 1
  设 当前 为 取当前选择(配置)
  必等(当前["提供者"], "deepseek-official", "07")
  必等(当前["模型"], "deepseek-v4-flash", "07b")
  必等(字典包含键(当前, "推理力度"), 假, "07c")
  当前["模型"] 为 "被篡改"
  必等(取当前选择(配置)["模型"], "deepseek-v4-flash", "07d")
  通过("07")

  # ===== §5 更新默认模型（任务书 2.2；推理力度=空 清除，保留需显式传值）=====
  设 计数 为 计数 + 1
  设 更新件 为 建默认模型配置("p0", "m0", "medium")
  更新默认模型(更新件, "p1", "m1", "medium")
  必等(更新件["入口"]["提供者"], "p1", "08")
  必等(更新件["入口"]["模型"], "m1", "08b")
  必等(更新件["入口"]["推理力度"], "medium", "08c")
  更新默认模型(更新件, 空, 空, 空)
  必等(字典包含键(更新件["入口"], "推理力度"), 假, "08d")
  必等(更新件["入口"]["提供者"], "p1", "08e")
  必等(更新件["入口"]["模型"], "m1", "08f")
  更新默认模型(更新件, 空, "m2", "high")
  必等(更新件["入口"]["模型"], "m2", "08g")
  必等(更新件["入口"]["推理力度"], "high", "08h")
  设 抛错数 为 0
  尝试:
    更新默认模型(更新件, 99)
  捕获 异常 为 e:
    设 抛错数 为 抛错数 + 1
  必等(抛错数, 1, "08i")
  通过("08")

  # ===== §6 挂载 + 部分叠加（官方用例 3：layers a partial section over the entry）=====
  设 计数 为 计数 + 1
  挂载设置源(配置)
  必等(配置["挂载"], 真, "09")
  必等(取当前选择(配置)["模型"], "deepseek-v4-flash", "09b")
  写用户层(配置, {"模型": "deepseek-reasoner"})
  设 叠加读 为 取当前选择(配置)
  必等(叠加读["提供者"], "deepseek-official", "09c")
  必等(叠加读["模型"], "deepseek-reasoner", "09d")
  必等(字典包含键(叠加读, "推理力度"), 假, "09e")
  通过("09")

  # ===== §7 保存选择：整节替换写回；无力度选择清除已存力度（官方用例 1/2）=====
  设 计数 为 计数 + 1
  必等(保存选择(配置, {"提供者": "acme-gateway", "模型": "acme-large", "推理力度": "high"}), 真, "10")
  设 力度读 为 取当前选择(配置)
  必等(力度读["提供者"], "acme-gateway", "10b")
  必等(力度读["模型"], "acme-large", "10c")
  必等(力度读["推理力度"], "high", "10d")
  必等(保存选择(配置, {"提供者": "acme-gateway", "模型": "acme-plain"}), 真, "10e")
  设 朴素读 为 取当前选择(配置)
  必等(朴素读["模型"], "acme-plain", "10f")
  必等(字典包含键(朴素读, "推理力度"), 假, "10g")
  通过("10")

  # ===== §8 挂载后更新入口不影响当前选择（上游 setSource 后 entry 不再被读）=====
  设 计数 为 计数 + 1
  更新默认模型(配置, "entry-p", "entry-m")
  必等(配置["入口"]["提供者"], "entry-p", "11")
  必等(取当前选择(配置)["提供者"], "acme-gateway", "11b")
  通过("11")

  # ===== §9 卸载回退组合入口（官方用例 4：provider detaches）=====
  设 计数 为 计数 + 1
  卸载设置源(配置)
  必等(配置["挂载"], 假, "12")
  设 回退读 为 取当前选择(配置)
  必等(回退读["提供者"], "entry-p", "12b")
  必等(回退读["模型"], "entry-m", "12c")
  通过("12")

  # ===== §10 无挂载保存 no-op：组合入口保持（官方用例 5）=====
  设 计数 为 计数 + 1
  设 孤件 为 建默认模型配置("p", "m")
  必等(保存选择(孤件, {"提供者": "other", "模型": "other"}), 假, "13")
  设 孤读 为 取当前选择(孤件)
  必等(孤读["提供者"], "p", "13b")
  必等(孤读["模型"], "m", "13c")
  通过("13")

  # ===== §11 命名空间常量（上游 'agent-default-model'）=====
  设 计数 为 计数 + 1
  必等(默认模型设置命名空间, "agent-default-model", "14")
  通过("14")

  打印 "代理默认模型 判据通过：" + 转字符串(计数) + " 组"

主()
