# test_L050.light —— L-050 回归：捕获异常变量名支持任意合法标识符
# 运行：python 运行.py examples/test_L050.light
#
# 缺陷 L-050：捕获异常的变量名必须用单字母 ASCII（如 `e`）——中文名
# （如 `错误对象`）作捕获变量时解析器报「无法识别的语法元素：':'」。
# 修复后任意合法标识符（中文/多字/ASCII）均可作捕获变量名。
#
# 测试覆盖：
#   1. 捕获 异常 错误对象: —— 中文变量名 + 异常类型
#   2. 捕获 错误 错误对象: —— 中文变量名 + 错误类型
#   3. 捕获 错误对象: —— 无类型 + 中文变量名
#   4. 捕获 异常 e: —— ASCII 单字母（回归）
#   5. 捕获 异常 excVar: —— ASCII 多字母（回归）
#   6. 捕获 错误 为 错误对象: —— 为 绑定 + 中文变量名（回归）

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 序列化JSON(实际) + " 期望=" + 序列化JSON(期望))

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 新建 错误("断言失败: " + 标签)

段落 主:
  # 1. 捕获 异常 错误对象: 中文变量名 + 异常类型
  设 捕获到 为 假
  设 消息 为 ""
  尝试:
    抛出 新建 错误("中文变量名01")
  捕获 异常 错误对象:
    设 捕获到 为 真
    设 消息 为 转字符串(错误对象)
  断言真(捕获到, "异常 错误对象: 应捕获")
  断言相等(消息, "中文变量名01", "异常 错误对象: 消息正确")

  # 2. 捕获 错误 错误对象: 中文变量名 + 错误类型
  设 捕获到2 为 假
  设 消息2 为 ""
  尝试:
    抛出 新建 错误("中文变量名02")
  捕获 错误 错误对象:
    设 捕获到2 为 真
    设 消息2 为 转字符串(错误对象)
  断言真(捕获到2, "错误 错误对象: 应捕获")
  断言相等(消息2, "中文变量名02", "错误 错误对象: 消息正确")

  # 3. 捕获 错误对象: 无类型 + 中文变量名
  设 捕获到3 为 假
  尝试:
    抛出 新建 错误("无类型中文")
  捕获 错误对象:
    设 捕获到3 为 真
  断言真(捕获到3, "错误对象: 无类型中文应捕获")

  # 4. 捕获 异常 e: ASCII 单字母（回归）
  设 捕获到4 为 假
  设 消息4 为 ""
  尝试:
    抛出 新建 错误("ASCII单字母")
  捕获 异常 e:
    设 捕获到4 为 真
    设 消息4 为 转字符串(e)
  断言真(捕获到4, "异常 e: ASCII回归")
  断言相等(消息4, "ASCII单字母", "异常 e: 消息正确")

  # 5. 捕获 异常 excVar: ASCII 多字母（回归）
  设 捕获到5 为 假
  尝试:
    抛出 新建 错误("ASCII多字母")
  捕获 异常 excVar:
    设 捕获到5 为 真
  断言真(捕获到5, "异常 excVar: ASCII多字母回归")

  # 6. 捕获 错误 为 错误对象: 为 绑定 + 中文变量名（回归）
  设 捕获到6 为 假
  设 消息6 为 ""
  尝试:
    抛出 新建 错误("为绑定中文")
  捕获 错误 为 错误对象:
    设 捕获到6 为 真
    设 消息6 为 转字符串(错误对象)
  断言真(捕获到6, "错误 为 错误对象: 回归")
  断言相等(消息6, "为绑定中文", "错误 为 错误对象: 消息正确")

  打印 "L-050 测试通过"

主()
