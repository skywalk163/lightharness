# test_代理系统提示.light —— 路3(G) 对齐判据：系统提示投影提交决策 + 请求头准入四原因
# 对标原版 runtime-context.ts SystemPromptProjection + buildRequest request/header。
# 反跑判据：同文不重复提交、无读后置能力归一化改写（替换而非追加）、
#           未变化不重记请求头、series/reason 标记——未对齐实现任一条即失败。
# 运行：python 运行.py examples/test_代理系统提示.light

从 代理 导入 代理循环, 系统提示投影
从 会话 导入 新建会话

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真 接收 条件, 信息:
  如果 条件 == 假:
    抛出 新建 错误("断言失败(应为真)：" + 信息)

# ---- 假客户端：仅需 模型名（请求配置读取用） ----
类 假客户端:
  属性 模型名 等于 空

  段落 构造:
    设 己.模型名 为 "deepseek-chat"

段落 提交文本 接收 提交:
  设 消息 为 字典获取(提交, "消息")
  设 内容 为 字典获取(消息, "content")
  如果 内容 == 空 或 长度(内容) == 0:
    返回 ""
  返回 字典获取(列表获取(内容, 0), "text")

段落 主:
  # ===== A. 系统提示投影：append / replace 提交决策 =====
  设 会话对象 为 新建会话("sp1", ".")
  设 投影器 为 新建 系统提示投影(会话对象)

  # A1 表面为空 → 追加新头节点
  设 提交表 为 投影器.投影("你好", ["读历史提示": 真, "开始系列": 真])
  断言相等(长度(提交表), 1, "空表面追加一条提交")
  断言相等(字典获取(字典获取(提交表[0], "意图"), "表面操作"), "append", "追加意图")
  断言相等(提交文本(提交表[0]), "你好", "追加携带渲染文本")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])

  # A2 有能力 + 继续系列 + 同文 → 无提交（反跑判据：贪心追加实现在此失败）
  断言相等(长度(投影器.投影("你好", ["读历史提示": 真, "开始系列": 假])), 0, "同文无提交")

  # A3 有能力 + 继续系列 + 异文 → 追加
  设 提交表 为 投影器.投影("新任务", ["读历史提示": 真, "开始系列": 假])
  断言相等(长度(提交表), 1, "异文追加一条")
  断言相等(字典获取(字典获取(提交表[0], "意图"), "表面操作"), "append", "异文为追加")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])

  # A4 无读后置提示能力 → 归一化：清旧节点 + 改写头节点（替换而非追加）
  设 提交表 为 投影器.投影("第三版", ["读历史提示": 假, "开始系列": 假])
  断言相等(长度(提交表), 2, "归一化产出清理+改写两条")
  断言相等(字典获取(字典获取(提交表[0], "意图"), "表面操作"), "replace", "清理为替换")
  断言相等(提交文本(提交表[0]), "", "旧节点清空")
  断言相等(字典获取(字典获取(提交表[1], "意图"), "源事件序号"), [0], "头节点替换指向原头序号")
  断言相等(提交文本(提交表[1]), "第三版", "头节点改写为渲染文本")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[1], "消息"), "意图": 字典获取(提交表[1], "意图")])

  # A5 开始请求系列 → 归一化（即使有能力）：清空其余非空 + 改写头节点
  设 提交表 为 投影器.投影("第四版", ["读历史提示": 真, "开始系列": 真])
  断言相等(长度(提交表), 2, "系列开始归一化两条")
  断言相等(字典获取(字典获取(提交表[1], "意图"), "源事件序号"), [2], "系列开始改写当前头节点")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[1], "消息"), "意图": 字典获取(提交表[1], "意图")])

  # A6 归一化之后：同文无提交，异文追加
  断言相等(长度(投影器.投影("第四版", ["读历史提示": 真, "开始系列": 假])), 0, "归一化后同文无提交")
  设 提交表 为 投影器.投影("第五版", ["读历史提示": 真, "开始系列": 假])
  断言相等(长度(提交表), 1, "归一化后异文追加")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])

  # A7 渲染文本为空 → 归一化清空全部非空节点
  设 提交表 为 投影器.投影("", ["读历史提示": 真, "开始系列": 假])
  断言相等(长度(提交表), 2, "空渲染清空两条旧节点")
  断言相等(提交文本(提交表[0]), "", "清空为空文本")
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[0], "消息"), "意图": 字典获取(提交表[0], "意图")])
  会话对象.记录事件("system/message", ["消息": 字典获取(提交表[1], "消息"), "意图": 字典获取(提交表[1], "意图")])

  # A8 表面全空 → 再追加
  断言相等(长度(投影器.投影("最终", ["读历史提示": 真, "开始系列": 假])), 1, "空表面再追加")

  # ===== B. 请求头准入四原因（initial / change / series / resume）=====
  设 会话乙 为 新建会话("sp2", ".")
  设 假对象 为 新建 假客户端()
  设 选项 为 ["提供方": "prov1", "系统提示文本": "S1", "路由读后置系统提示": 假]
  设 代理 为 新建 代理循环(会话乙, 假对象, 空, 选项)

  # B1 首记且无基线 → initial
  代理.记录请求准入(1, 1, ["工具甲"], 假)
  断言相等(字典获取(代理.当前请求头(), "原因"), "initial", "首记为 initial")
  断言相等(长度(会话乙.查询事件("request/header", 0, 0)), 1, "记录一条请求头")
  断言相等(长度(会话乙.查询事件("request/context", 0, 0)), 1, "上下文首记")

  # B2 同配置同工具且非系列开始 → 不重记（反跑判据：逐步重复记录实现在此失败）
  代理.记录请求准入(1, 2, ["工具甲"], 假)
  断言相等(长度(会话乙.查询事件("request/header", 0, 0)), 1, "未变化不重记请求头")
  断言相等(长度(会话乙.查询事件("request/context", 0, 0)), 1, "上下文未变不重记")

  # B3 工具模式变化 → change
  代理.记录请求准入(1, 3, ["工具甲", "工具乙"], 假)
  断言相等(字典获取(代理.当前请求头(), "原因"), "change", "工具变化为 change")
  断言相等(长度(会话乙.查询事件("request/header", 0, 0)), 2, "change 记第二条")

  # B4 同配置 + 开始请求系列 → series
  代理.记录请求准入(2, 1, ["工具甲", "工具乙"], 真)
  断言相等(字典获取(代理.当前请求头(), "原因"), "series", "系列开始为 series")
  断言相等(字典获取(代理.当前请求头(), "开始系列"), 真, "series 标记开始系列")
  断言相等(长度(会话乙.查询事件("request/header", 0, 0)), 3, "series 记第三条")

  # B5 新实例接续既有会话基线 → resume
  设 代理乙 为 新建 代理循环(会话乙, 假对象, 空, 选项)
  代理乙.记录请求准入(2, 2, ["工具甲", "工具乙"], 假)
  断言相等(字典获取(代理乙.当前请求头(), "原因"), "resume", "实例接续为 resume")

  # ===== C. 准备请求准入闭环：replace 计入请求面世代，意图被下一轮投影消化 =====
  设 会话丙 为 新建会话("sp3", ".")
  设 选项丙 为 ["提供方": "prov", "系统提示文本": "S1", "路由读后置系统提示": 假]
  设 代理丙 为 新建 代理循环(会话丙, 假对象, 空, 选项丙)

  代理丙.准备请求准入(1, 1, 假)
  断言相等(长度(会话丙.查询事件("system/message", 0, 0)), 1, "首轮追加系统消息")
  断言相等(代理丙.自记替换数, 0, "追加不计替换")
  代理丙.记录请求准入(1, 1, ["工具"], 假)

  字典设置(选项丙, "系统提示文本", "S2")
  代理丙.准备请求准入(1, 2, 假)
  断言相等(长度(会话丙.查询事件("system/message", 0, 0)), 2, "改写记录第二条系统消息")
  设 替换事件 为 列表获取(会话丙.查询事件("system/message", 0, 0), 1)
  断言相等(字典获取(字典获取(字典获取(替换事件, "数据"), "意图"), "表面操作"), "replace", "改写意图为 replace")
  断言相等(代理丙.自记替换数, 1, "归一化改写计一次替换")
  断言真(代理丙.面代变化(), "替换后请求面世代变化")
  代理丙.记录请求准入(1, 2, ["工具"], 假)

  # 反跑判据：投影消费自身 replace 意图后表面收敛，同文不再提交
  断言相等(长度(代理丙.投影器.投影("S2", ["读历史提示": 真, "开始系列": 假])), 0, "replace 后表面同文无再提交")

  打印 "--- 代理系统提示投影与请求头准入测试通过 ---"

主()
