# test_套接字.light —— 套接字.light 回归测试（R66 子任务 66.1）
#
# 覆盖（规划文档 66.1 验收）：
#   1) TCP 回环客户端/服务端（阻塞 + 非阻塞接受）
#   2) UDP 回环（发送到/接收自）
#   3) 套接字选项（SO_REUSEADDR / SO_RCVBUF / SO_SNDBUF / TCP_NODELAY——后者必须
#      用 IPPROTO_TCP 级别，误用 SOL_SOCKET 在 POSIX 上等价 SO_DEBUG → EACCES）
#   4) 非阻塞模式 + 超时模式（EAGAIN / timeout 异常分类）
#   5) 字节层收发正确性（含 \x00 \xff 等任意字节；大载荷走 发送全部 循环）
#   6) 套接字对（唤醒通道语义）
#   7) 地址族常量与关闭幂等
#
# 运行：cd lightharness && python 运行.py examples/test_套接字.light
从 套接字 导入 新建TCP套接字, 新建UDP套接字, 新建套接字, 新建套接字对
从 套接字 导入 AF_INET, AF_INET6, AF_UNIX, SOCK_STREAM, SOCK_DGRAM, SOL_SOCKET, SO_REUSEADDR, SO_RCVBUF, SO_SNDBUF, TCP_NODELAY, IPPROTO_TCP, 套接字对可用族, 套接字
导入 errno
导入 time

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + "；实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " + 标签

# 起一个非阻塞监听服务，返回 [服务套接字, 端口]
段落 起服务():
  设 服务 为 新建TCP套接字()
  服务.设置选项(SOL_SOCKET, SO_REUSEADDR, 1)
  服务.绑定("127.0.0.1", 0)
  服务.监听(8)
  设 端口 为 服务.本地地址()[1]
  断言真(端口 > 0, "绑定临时端口")
  返回 [服务, 端口]

# Windows 上非阻塞 connect 异步完成：接受轮询到就绪为止（有上界）
段落 轮询接受(服务, 次数上限):
  设 顺 为 0
  当 真:
    尝试:
      返回 服务.接受()
    捕获 异常 e:
      设 顺 为 顺 + 1
      如果 顺 > 次数上限:
        抛出 "接受 轮询超上限: " + 转字符串(e)
      time.sleep(0.01)

段落 主:
  # ============================================================
  # 1) TCP 阻塞回环：连接/接受/收发/对端地址
  # ============================================================
  设 组 为 起服务()
  设 服务 为 组[0]
  设 端口 为 组[1]
  服务.设置阻塞(真)
  设 客 为 新建TCP套接字()
  客.设置超时(2.0)
  客.连接("127.0.0.1", 端口)
  设 对 为 服务.接受()
  设 连 为 对[0]
  断言真(对[2] > 0, "接受 返回对端端口")
  断言相等(连.本地地址()[1], 端口, "连接套接字本地端口=服务端口")
  断言相等(连.对端地址()[1], 客.本地地址()[1], "服务端看到的对端=客户端端口")
  客.发送全部(b"ping-001")
  断言相等(连.接收(64), b"ping-001", "TCP 阻塞回环收发")
  连.关闭()
  客.关闭()
  服务.关闭()
  断言相等(服务.关闭(), 假, "关闭幂等")

  # ============================================================
  # 2) TCP 非阻塞：空 accept 抛 EAGAIN（愿等，不是致命错）
  # ============================================================
  设 组2 为 起服务()
  设 服务2 为 组2[0]
  服务2.设置阻塞(假)
  设 空转了 为 假
  尝试:
    服务2.接受()
  捕获 异常 e:
    设 错误号 为 getattr(e, "errno", 空)
    # Windows 上 EWOULDBLOCK(10035) 与 EAGAIN(10036) 是两个不同常量，两者都是「愿等」
    如果 错误号 == errno.EAGAIN 或 错误号 == errno.EWOULDBLOCK:
      设 空转了 为 真
  断言真(空转了, "非阻塞无连接时 accept 抛 EAGAIN")
  服务2.关闭()

  # ============================================================
  # 3) 非阻塞 recv：无数据抛 EAGAIN
  # ============================================================
  设 组3 为 起服务()
  设 服务3 为 组3[0]
  设 端口3 为 组3[1]
  设 客3 为 新建TCP套接字()
  客3.设置阻塞(假)
  设 已连 为 假
  尝试:
    客3.连接("127.0.0.1", 端口3)
    设 已连 为 真
  捕获 异常 e:
    # 非阻塞 connect 在握手未完时会抛 EINPROGRESS/EWOULDBLOCK，属正常路径
    设 错误号 为 getattr(e, "errno", 空)
    如果 错误号 == errno.EINPROGRESS 或 错误号 == errno.EWOULDBLOCK 或 错误号 == errno.EAGAIN:
      设 已连 为 真
  断言真(已连, "非阻塞 connect 被接受")
  设 空读了 为 假
  尝试:
    客3.接收(16)
  捕获 异常 e:
    设 读错误号 为 getattr(e, "errno", 空)
    如果 读错误号 == errno.EAGAIN 或 读错误号 == errno.EWOULDBLOCK:
      设 空读了 为 真
  断言真(空读了, "非阻塞无数据 recv 抛 EAGAIN")
  客3.关闭()
  服务3.关闭()

  # ============================================================
  # 4) 超时模式：settimeout 后无数据 recv 抛超时异常
  # ============================================================
  设 组4 为 起服务()
  设 服务4 为 组4[0]
  设 端口4 为 组4[1]
  设 客4 为 新建TCP套接字()
  客4.设置超时(0.2)
  客4.连接("127.0.0.1", 端口4)
  设 超时炸了 为 假
  设 开始 为 time.monotonic()
  尝试:
    客4.接收(16)
  捕获 异常 e:
    # Windows/Unix 抛的异常类型名与消息各不相同（TimeoutError / socket.timeout /
    # "timed out"），但共同点是「等够了一段才抛」——耗时下限是本组真正的判据
    设 超时炸了 为 真
  设 耗时 为 time.monotonic() 减去 开始
  断言真(超时炸了, "超时 recv 抛超时异常")
  断言真(耗时 >= 0.15, "超时确实等了一小段: " + 转字符串(耗时))
  客4.关闭()
  服务4.关闭()

  # ============================================================
  # 5) 套接字选项：设置 + 读回
  # ============================================================
  设 s5 为 新建TCP套接字()
  # SO_REUSEADDR 的 getsockopt 读回值是实现定义：Linux 返回 1，FreeBSD 返回 4
  # （R68 实测），语义判据是「非 0 即开」——断言开关语义可往返，不钉死数值。
  s5.设置选项(SOL_SOCKET, SO_REUSEADDR, 1)
  断言真(s5.读取选项(SOL_SOCKET, SO_REUSEADDR) != 0, "SO_REUSEADDR 读回为开（非 0）")
  s5.设置选项(SOL_SOCKET, SO_REUSEADDR, 0)
  断言相等(s5.读取选项(SOL_SOCKET, SO_REUSEADDR), 0, "SO_REUSEADDR 读回为关（0）")
  s5.设置选项(SOL_SOCKET, SO_REUSEADDR, 1)
  断言真(s5.读取选项(SOL_SOCKET, SO_REUSEADDR) != 0, "SO_REUSEADDR 重新置开")
  s5.设置选项(SOL_SOCKET, SO_RCVBUF, 65536)
  断言真(s5.读取选项(SOL_SOCKET, SO_RCVBUF) >= 65536, "SO_RCVBUF 读回不低于设置值")
  s5.设置选项(SOL_SOCKET, SO_SNDBUF, 65536)
  断言真(s5.读取选项(SOL_SOCKET, SO_SNDBUF) >= 65536, "SO_SNDBUF 读回不低于设置值")
  # TCP_NODELAY 属 IPPROTO_TCP 级别（R86 归因）：POSIX 上 SOL_SOCKET=1 且
  # TCP_NODELAY=1，误传 SOL_SOCKET 级别会被内核当成 SO_DEBUG（需 CAP_NET_ADMIN）
  # → EACCES；Windows 却静默接受。级别用错是调用面问题，不是 0.86 环境限制。
  断言真(IPPROTO_TCP != 空, "IPPROTO_TCP 常量可用")
  断言真(TCP_NODELAY != 空, "TCP_NODELAY 常量可用")
  s5.设置选项(IPPROTO_TCP, TCP_NODELAY, 1)
  断言真(s5.读取选项(IPPROTO_TCP, TCP_NODELAY) != 0, "TCP_NODELAY 读回为开")
  断言真(s5.设置不延迟(假), "设置不延迟(假) 可用")
  断言相等(s5.读取不延迟(), 0, "设置不延迟(假) 读回 0")
  断言真(s5.设置不延迟(真), "设置不延迟(真) 走 IPPROTO_TCP 级别成功")
  断言真(s5.读取不延迟() != 0, "设置不延迟(真) 读回为开")
  s5.关闭()

  # ============================================================
  # 6) UDP 回环：发送到/接收自，来源地址回传
  # ============================================================
  设 u1 为 新建UDP套接字()
  u1.绑定("127.0.0.1", 0)
  设 u1端口 为 u1.本地地址()[1]
  设 u2 为 新建UDP套接字()
  u2.绑定("127.0.0.1", 0)
  u2.设置超时(2.0)
  设 n 为 u2.发送到(b"udp-payload", "127.0.0.1", u1端口)
  断言相等(n, 长度("udp-payload"), "发送到 返回发送字节数")
  设 包 为 u1.接收自(64)
  断言相等(包[0], b"udp-payload", "UDP 数据到达")
  断言相等(包[1], "127.0.0.1", "UDP 来源主机")
  断言真(包[2] == u2.本地地址()[1], "UDP 来源端口对上")
  u1.关闭()
  u2.关闭()

  # ============================================================
  # 7) 字节层正确性：任意字节（含 0x00/0xff/多字节汉字 utf-8 原样字节）
  # ============================================================
  设 组7 为 起服务()
  设 服务7 为 组7[0]
  设 端口7 为 组7[1]
  服务7.设置阻塞(真)
  设 客7 为 新建TCP套接字()
  客7.设置超时(2.0)
  客7.连接("127.0.0.1", 端口7)
  设 连7 为 服务7.接受()[0]
  设 载荷 为 b"\x00\x01\xff\xfe\xe4\xb8\xad\xe6\x96\x87\x00binary"
  客7.发送全部(载荷)
  断言相等(连7.接收(256), 载荷, "任意字节原样到达（不做字符层加工）")
  # 大载荷走 发送全部 的循环路径（>默认发送缓冲，逼出多轮 send）
  设 大载荷 为 b"A" * 200000
  客7.发送全部(大载荷)
  设 收到 为 b""
  当 长度(收到) < 200000:
    设 块 为 连7.接收(65536)
    如果 长度(块) == 0:
      抛出 "对端在收满前关闭"
    设 收到 为 收到 + 块
  断言相等(收到, 大载荷, "200KB 大载荷完整到达")
  连7.关闭()
  客7.关闭()
  服务7.关闭()

  # ============================================================
  # 8) 套接字对：一端写、另一端读（事件循环唤醒通道语义）
  # ============================================================
  # 地址族兼容：Windows 的 socketpair 支持 AF_INET；POSIX 只支持 AF_UNIX，
  # stdlib 会把 AF_INET 映射成 AF_UNIX（R86），所以这里传 AF_INET 三平台都合法。
  设 甲乙 为 新建套接字对(AF_INET, 真)
  设 甲 为 甲乙[0]
  设 乙 为 甲乙[1]
  乙.发送(b"wake-r66")
  断言相等(甲.接收(32), b"wake-r66", "套接字对跨端可读")
  断言真(甲.当前超时() == 0.0, "非阻塞模式读回 0")
  甲.关闭()
  乙.关闭()
  # 传 空 = 平台默认族（win32=AF_INET；POSIX=AF_UNIX）——不想关心平台的调用方走这条
  断言真(套接字对可用族(空) != 空, "套接字对可用族(空) 返回平台默认")
  设 默认对 为 新建套接字对(空, 真)
  设 默甲 为 默认对[0]
  设 默乙 为 默认对[1]
  默乙.发送(b"wake-default")
  断言相等(默甲.接收(32), b"wake-default", "平台默认族套接字对跨端可读")
  默甲.关闭()
  默乙.关闭()

  # ============================================================
  # 9) 地址族常量与工厂：AF_INET/AF_INET6 恒有；AF_UNIX 仅 POSIX（Windows 为 空）
  # ============================================================
  断言真(AF_INET > 0, "AF_INET 常量")
  断言真(AF_INET6 > 0, "AF_INET6 常量")
  断言相等(SOCK_DGRAM, 新建UDP套接字().原始.type, "SOCK_DGRAM 与工厂一致")
  设 u9 为 新建UDP套接字()
  u9.关闭()
  设 tcp9 为 新建套接字(AF_INET, SOCK_STREAM)
  tcp9.绑定("127.0.0.1", 0)
  断言真(tcp9.本地地址()[1] > 0, "新建套接字 工厂可用")
  tcp9.关闭()
  # Windows 上 AF_UNIX 为 空 且不导出崩溃；POSIX 上为正数——两种都算过
  如果 AF_UNIX != 空:
    设 ux 为 新建套接字(AF_UNIX, SOCK_STREAM)
    ux.关闭()

  输出("test_套接字.light 全部断言通过（9 组 / TCP阻塞回环+非阻塞accept+非阻塞recv+超时模式+选项(TCP级别)+UDP回环+字节层+套接字对(平台自适应)+地址族常量）")

主()
