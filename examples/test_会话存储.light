# test_会话存储.light —— E2 会话持久化最小复现（会话 CRUD + 索引 + 标题）
#
# 运行通道：python 运行.py examples/test_会话存储.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛 错误 → 非零退出（反跑立红）。
#
# 覆盖验收点：
#   1) 新建会话：JSONL 文件落盘、索引条目写入、id 格式合法
#   2) 追加消息：写入 JSONL、索引 消息数+1、最后更新 刷新
#   3) 会话列表：按最后更新倒序
#   4) 会话详情：完整消息历史、顺序正确
#   5) 删除会话：文件与索引条目都移除
#   6) 更新标题：索引标题变更
#   7) 标题生成：首条消息前 30 字
#   8) 会话恢复：新实例重建后历史完整、坏行宽容
#   9) 并发安全：多次追加不覆盖（追加模式实证）
#  10) 大会话性能：1000 条消息加载 < 1 秒

从 会话存储 导入 会话存储, 生成标题, 生成会话标识
从 JSON 导入 序列化JSON, 解析JSON
从 文件系统 导入 创建目录, 目录存在, 文件存在, 读取文件, 写入文件, 删除文件, 删除目录, 路径连接
导入 time
导入 os

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " + 标签 + "（条件为假）"

段落 主:
  # ---- 准备：系统临时目录作根，避免污染工作区 ----
  设 基 为 当前目录()
  设 根 为 路径连接(基, "_e2_会话存储_tmp")
  尝试:
    删除目录(路径连接(根, "sessions", "_index.json.tmp"))
  捕获 异常 e:
    设 忽略 为 空
  如果 目录存在(根) == 假:
    创建目录(根)

  设 存储 为 新建 会话存储(根)
  设 会话目录 为 存储.取会话目录()
  断言真(目录存在(会话目录), "sessions 目录自动创建")
  断言真(文件存在(路径连接(会话目录, "_index.json")), "空索引文件创建")

  # ===== 1) 新建会话 =====
  设 索引空 为 存储.列表会话()
  断言相等(长(索引空), 0, "初始会话列表为空")

  设 s1 为 存储.新建会话("第一个会话")
  断言真(长(s1["id"]) > 0, "新建会话返回 id")
  断言相等(s1["标题"], "第一个会话", "新建会话标题")
  断言相等(s1["消息数"], 0, "新建会话消息数 0")
  设 id1 为 s1["id"]
  设 文件1 为 s1["文件"]
  断言真(id1.查找("session_") == 0, "id 以 session_ 开头")
  # id 格式：session_YYYYMMDD_HHMMSS_6位（session_=8, 日期8, _=1, 时间6, _=1, 随机6 → 30 字符）
  断言相等(长(id1), 30, "id 长度固定 30")
  断言相等(长(截取(id1, 24, 30)), 6, "id 随机串 6 位")
  断言真(文件存在(存储.取会话文件(id1)), "JSONL 文件落盘")
  设 空内容 为 读取文件(存储.取会话文件(id1))
  断言相等(空内容, "", "新建会话 JSONL 为空")

  # 默认标题
  设 s2 为 存储.新建会话("")
  设 id2 为 s2["id"]
  断言相等(s2["标题"], "新会话", "空标题回落默认")

  # ===== 2) 追加消息 =====
  设 追加1 为 存储.追加消息(id1, {"角色": "user", "内容": "你好"})
  断言相等(追加1["角色"], "user", "追加消息角色保留")
  断言真(追加1.获取("时间", "") != "", "追加消息自动补 时间")
  设 追加2 为 存储.追加消息(id1, {"角色": "assistant", "内容": "你好！"})
  断言真(追加2.获取("时间", "") != "", "assistant 消息补 时间")
  设 索引s1 为 存储.取元数据(id1)
  断言相等(索引s1["消息数"], 2, "追加2条后消息数=2")

  # ===== 4) 会话详情：顺序正确 =====
  设 历史 为 存储.获取会话(id1)
  断言相等(长(历史), 2, "详情返回2条消息")
  断言相等(历史[0]["角色"], "user", "首条为 user")
  断言相等(历史[1]["角色"], "assistant", "次条为 assistant")
  断言相等(历史[0]["内容"], "你好", "首条内容正确")

  # 不存在的会话 → 返回错误字典，不抛异常
  设 不存在 为 存储.获取会话("session_19700101_000000_abcdef")
  断言真(不存在.获取("错误", "") != "", "不存在会话返回错误")

  # ===== 3) 会话列表：按最后更新倒序 =====
  设 s3 为 存储.新建会话("第三个")
  设 id3 为 s3["id"]
  存储.追加消息(id3, {"角色": "user", "内容": "最新的一条"})
  设 列表 为 存储.列表会话()
  断言相等(长(列表), 3, "共 3 个会话")
  # 断言按 最后更新 倒序（同秒内时间戳并列，稳定排序保持插入序，故不绑死具体 id）
  设 已倒序 为 真
  设 遍历索引 为 1
  当 遍历索引 < 长(列表):
    如果 列表[遍历索引 - 1].获取("最后更新", "") < 列表[遍历索引].获取("最后更新", ""):
      设 已倒序 为 假
    设 遍历索引 为 遍历索引 + 1
  断言相等(已倒序, 真, "列表按最后更新倒序")
  设 集合完整 为 真
  遍历 条目 之 列表:
    如果 条目["id"] != id1 且 条目["id"] != id2 且 条目["id"] != id3:
      设 集合完整 为 假
  断言相等(集合完整, 真, "列表含全部会话")

  # ===== 6) 更新标题 =====
  设 改标题 为 存储.更新标题(id1, "重命名后的标题")
  断言相等(改标题["标题"], "重命名后的标题", "更新标题生效")
  设 校验标题 为 存储.获取会话(id1)
  断言相等(长(校验标题), 2, "改标题不丢消息")
  设 改空标题 为 存储.更新标题(id1, "")
  断言相等(改空标题["标题"], "新会话", "空标题回落默认")
  设 改不存在 为 存储.更新标题("session_19700101_000000_abcdef", "x")
  断言真(改不存在.获取("错误", "") != "", "改不存在会话返回错误")

  # ===== 7) 标题生成：首条消息前 30 字 =====
  设 短文本 为 "帮我看看这份季度报告里的关键指标"
  断言相等(长(短文本), 16, "短文本长度自检")
  断言相等(生成标题([{"角色": "user", "内容": 短文本}]), 短文本, "短消息整段作标题")
  设 长文本 为 "这是一个超过三十个字符的用户提问内容需要被截断到前三十个字符以便展示为会话标题的样例文本"
  设 长标题 为 生成标题([{"角色": "user", "内容": 长文本}])
  断言相等(长(长标题), 30, "长消息截断到 30 字")
  断言相等(截取(长文本, 0, 30), 长标题, "标题取前 30 字")
  断言相等(生成标题([{"角色": "assistant", "内容": "助手先说话"}]), "新会话", "无 user 消息回落默认标题")
  设 换行文本 为 "第一行\n\n\n第二行内容"
  断言相等(生成标题([{"角色": "user", "内容": 换行文本}]), "第一行 第二行内容", "换行折叠为空格")
  设 工具消息 为 {"角色": "assistant", "内容": 空, "工具调用": []}
  断言相等(生成标题([工具消息, {"角色": "user", "内容": "真正的问题"}]), "真正的问题", "跳过空内容 assistant 消息")

  # ===== 9) 并发安全：追加模式不覆盖 =====
  设 文件1路径 为 存储.取会话文件(id1)
  设 追加前长度 为 文件大小(文件1路径)
  设 追加3 为 存储.追加消息(id1, {"角色": "user", "内容": "再来一条"})
  设 追加4 为 存储.追加消息(id1, {"角色": "tool", "内容": "file1\nfile2", "工具调用id": "call_1", "工具名": "bash"})
  设 追加后长度 为 文件大小(文件1路径)
  断言真(追加后长度 > 追加前长度, "追加后文件变大（未覆盖）")
  设 历史2 为 存储.获取会话(id1)
  断言相等(长(历史2), 4, "4 条消息全部保留")
  断言相等(历史2[0]["内容"], "你好", "首条未被覆盖")
  设 索引s1b 为 存储.取元数据(id1)
  断言相等(索引s1b["消息数"], 4, "索引消息数=4")
  # 换行符必须转义为 \n，不产生裸换行（JSONL 每行一条完整 JSON）
  设 文件文本 为 读取文件(文件1路径)
  设 裸换行数 为 长(文件文本.split("\n"))
  断言相等(裸换行数, 5, "4 条消息 4 个行尾 + 尾部空串 = 5 段（无裸换行破坏结构）")
  断言相等(历史2[3]["工具调用id"], "call_1", "工具消息字段完整")

  # ===== 8) 会话恢复：新实例重建，历史完整 =====
  设 存储2 为 新建 会话存储(根)
  设 恢复列表 为 存储2.列表会话()
  断言相等(长(恢复列表), 3, "重启后会话数保持 3")
  设 恢复历史 为 存储2.获取会话(id1)
  断言相等(长(恢复历史), 4, "重启后消息历史完整")
  断言相等(恢复历史[0]["内容"], "你好", "重启后首条内容不变")
  设 恢复元数据 为 存储2.取元数据(id1)
  断言相等(恢复元数据["消息数"], 4, "重启后索引消息数一致")
  # 手动破坏一行为坏行：宽容读取，坏行带标记，不静默丢
  设 坏行 为 读取文件(文件1路径) + "{这行不是合法JSON\n"
  写入文件(文件1路径, 坏行)
  设 宽容历史 为 存储2.获取会话(id1)
  断言相等(长(宽容历史), 5, "坏行也被计入（不丢数据）")
  断言真(宽容历史[4].获取("坏", 假) == 真, "坏行带 坏 标记")
  断言相等(宽容历史[0]["内容"], "你好", "坏行不影响前序消息")
  设 存储2b 为 新建 会话存储(根)
  存储2b.追加消息(id1, {"角色": "user", "内容": "坏行之后还能追加"})
  断言真(存储2b.获取会话(id1)[0]["内容"] == "你好", "坏行修复后可继续追加")

  # ===== 10) 大会话性能：1000 条消息加载 < 1 秒 =====
  设 大会话 为 存储2b.新建会话("大会话")
  设 大id 为 大会话["id"]
  设 i 为 0
  当 i < 1000:
    存储2b.追加消息(大id, {"角色": "user", "内容": "第 " + 转字符串(i) + " 条消息"})
    设 i 为 i + 1
  设 大索引 为 存储2b.取元数据(大id)
  断言相等(大索引["消息数"], 1000, "大会话消息数=1000")
  设 存储3 为 新建 会话存储(根)
  设 起点 为 time.time()
  设 大历史 为 存储3.获取会话(大id)
  设 耗时 为 time.time() - 起点
  写 "大会话加载耗时: "
  写 转字符串(耗时)
  写 " 秒\n"
  断言相等(长(大历史), 1000, "大会话加载 1000 条")
  断言相等(大历史[999]["内容"], "第 999 条消息", "大会话末条正确")
  断言真(耗时 < 1.0, "大会话加载 < 1 秒")

  # ===== 5) 删除会话 =====
  设 文件还在 为 文件存在(存储.取会话文件(id1))
  断言真(文件还在 == 真, "删除前文件存在")
  设 删除结果 为 存储.删除会话(id1)
  断言相等(删除结果["删除"], id1, "删除返回被删标识")
  断言真(文件存在(存储.取会话文件(id1)) == 假, "JSONL 文件已删除")
  设 删除后列表 为 存储.列表会话()
  断言相等(长(删除后列表), 2, "索引条目已移除")
  设 有残留 为 假
  设 待查表 为 删除后列表
  遍历 条目 之 待查表:
    如果 条目["id"] == id1:
      设 有残留 为 真
  断言相等(有残留, 假, "列表中无被删会话残留")
  设 删除结果2 为 存储.删除会话(id1)
  断言真(删除结果2.获取("错误", "") != "", "重复删除返回错误（不抛异常）")

  # 索引文件自身也是合法 JSON（原子写不损坏）
  设 索引原文 为 读取文件(路径连接(存储.取会话目录(), "_index.json"))
  设 索引回读 为 解析JSON(索引原文)
  断言相等(长(索引回读["会话"]), 2, "索引文件回读一致")
  设 有临时残留 为 文件存在(路径连接(存储.取会话目录(), "_index.json.tmp"))
  断言相等(有临时残留, 假, "原子写后无临时文件残留")

  # ---- 清理（逐文件删除后再删目录；尽力而为，失败不阻断验收）----
  尝试:
    设 清理表 为 存储.列表会话()
    遍历 条目 之 清理表:
      尝试:
        删除文件(存储.取会话文件(条目["id"]))
      捕获 异常 ce:
        设 忽略 为 空
    设 目录清单 为 os.listdir(存储.取会话目录())
    遍历 条目 之 目录清单:
      尝试:
        删除文件(路径连接(存储.取会话目录(), 条目))
      捕获 异常 ce2:
        设 忽略2 为 空
    删除目录(存储.取会话目录())
    删除目录(根)
  捕获 异常 e:
    写 "清理失败（不阻断验收）: "
    写 转字符串(e)

  打印 "--- 测试会话存储（JSONL/索引/CRUD/标题/恢复/性能） 通过 ---"

主()
