# test_文件深.light —— 文件系统加深测试（T10-03）
#
# 反跑判据：每个断言改反一行即红（见各断言旁注释）。
# 测试在临时目录 _taskT10_03_* 中操作，收尾删干净。

从 文件 导入 写JSON文件, 读JSON文件, 写文本文件, 读文本文件, 保证目录, 列目录
从 文件 导入 删除路径, 重命名路径, 复制路径, 存在, 文件信息, 查找文件, 建临时目录, 写二进制, 读二进制
从 存储 导入 存储

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 断言为真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败(期望真): " + 标签

段落 主:
  设 根 为 建临时目录()
  打印 "临时目录: " + 根

  # === 1. 写读闭环 ===
  设 文本路径 为 连接路径(根, "文本.txt")
  写文本文件(文本路径, "lightharness")
  断言等于(读文本文件(文本路径), "lightharness", "文本往返一致")
  # 反跑: 把 "lightharness" 改为 "nope" 即红

  设 JSON路径 为 连接路径(根, "数据.json")
  写JSON文件(JSON路径, ["名字": "光明", "版本": 42])
  设 回读 为 读JSON文件(JSON路径)
  断言等于(回读["名字"], "光明", "JSON 名字往返一致")
  断言等于(回读["版本"], 42, "JSON 版本往返一致")
  # 反跑: 把 42 改为 41 即红

  设 二进制路径 为 连接路径(根, "字节.bin")
  写二进制(二进制路径, b"hello")
  设 字节回读 为 读二进制(二进制路径)
  断言为真(字节回读 == b"hello", "二进制往返一致")
  # 反跑: 把 "hello" 改为 "world" 即红

  # === 2. 目录操作 ===
  设 深目录 为 连接路径(根, "a", "b", "c")
  保证目录(深目录)
  断言为真(目录存在(深目录), "递归建目录成功")
  # 反跑: 把 目录存在 改为 假 断言即红

  设 子文件 为 连接路径(深目录, "深文件.txt")
  写文本文件(子文件, "深")
  断言为真(文件存在(子文件), "深目录内文件存在")

  设 目录表 为 列目录(根)
  断言为真(长度(目录表) >= 3, "根目录至少 3 项")
  # 反跑: 把 >= 3 改为 > 10 即红

  # 删除文件
  删除路径(文本路径)
  断言为真(文件存在(文本路径) == 假, "删除文件后不存在")
  # 反跑: 把 假 改为 真 即红

  # 删除空目录
  设 空目录 为 连接路径(根, "空目录")
  保证目录(空目录)
  删除路径(空目录)
  断言为真(目录存在(空目录) == 假, "删除空目录后不存在")
  # 反跑: 把 假 改为 真 即红

  # 删除非空目录（递归）
  删除路径(连接路径(根, "a"))
  断言为真(目录存在(连接路径(根, "a")) == 假, "删除非空目录后不存在")
  # 反跑: 把 假 改为 真 即红

  # 重命名
  设 旧名 为 连接路径(根, "旧.txt")
  设 新名 为 连接路径(根, "新.txt")
  写文本文件(旧名, "rename")
  重命名路径(旧名, 新名)
  断言为真(文件存在(旧名) == 假, "重命名后旧路径不存在")
  断言为真(文件存在(新名), "重命名后新路径存在")
  # 反跑: 把 假 改为 真 即红

  # 复制
  设 源文件 为 连接路径(根, "源.txt")
  设 副本 为 连接路径(根, "副本.txt")
  写文本文件(源文件, "copy")
  复制路径(源文件, 副本)
  断言为真(文件存在(副本), "复制后副本存在")
  断言等于(读文本文件(副本), "copy", "复制内容一致")
  # 反跑: 把 "copy" 改为 "wrong" 即红

  # 复制目录
  设 源目录 为 连接路径(根, "源目录")
  设 目标目录 为 连接路径(根, "目标目录")
  保证目录(源目录)
  写文本文件(连接路径(源目录, "内.txt"), "inner")
  复制路径(源目录, 目标目录)
  断言为真(目录存在(目标目录), "复制目录后目标存在")
  断言等于(读文本文件(连接路径(目标目录, "内.txt")), "inner", "复制目录内容一致")
  # 反跑: 把 "inner" 改为 "outer" 即红

  # === 3. stat（文件信息）===
  设 信息路径 为 连接路径(根, "stat.txt")
  写文本文件(信息路径, "12345")
  设 信息 为 文件信息(信息路径)
  断言等于(信息["类别"], "文件", "stat 类别=文件")
  断言等于(信息["大小"], 5, "stat 大小=5")
  断言为真(信息["存在"], "stat 存在=真")
  # 反跑: 把 5 改为 6 即红

  设 目录信息 为 文件信息(源目录)
  断言等于(目录信息["类别"], "目录", "stat 类别=目录")
  # 反跑: 把 "目录" 改为 "文件" 即红

  设 不存在信息 为 文件信息(连接路径(根, "不存在"))
  断言为真(不存在信息["存在"] == 假, "stat 不存在=假")
  # 反跑: 把 假 改为 真 即红

  # === 4. glob 查找 ===
  设 glob目录 为 连接路径(根, "glob测试")
  保证目录(glob目录)
  写文本文件(连接路径(glob目录, "a.txt"), "a")
  写文本文件(连接路径(glob目录, "b.txt"), "b")
  写文本文件(连接路径(glob目录, "c.json"), "c")
  设 子目录 为 连接路径(glob目录, "子")
  保证目录(子目录)
  写文本文件(连接路径(子目录, "deep.json"), "deep")

  设 txt结果 为 查找文件(glob目录, "*.txt", 假)
  断言等于(长度(txt结果), 2, "glob *.txt 匹配 2 个")
  # 反跑: 把 2 改为 3 即红

  设 json递归 为 查找文件(glob目录, "*.json", 真)
  断言为真(长度(json递归) >= 2, "glob 递归 *.json 至少 2 个")
  # 反跑: 把 >= 2 改为 > 5 即红

  # === 5. 存储持久化 ===
  设 存储路径 为 连接路径(根, "存储.json")
  设 仓1 为 新建 存储(存储路径, "空间A")
  仓1.存值("键1", "值1")
  仓1.存值("键2", "值2")
  断言等于(仓1.读值("键1"), "值1", "存储 读值 键1")
  # 反跑: 把 "值1" 改为 "值X" 即红

  设 键表 为 仓1.键名表()
  断言等于(长度(键表), 2, "存储 键名表 长度=2")
  # 反跑: 把 2 改为 3 即红

  仓1.删值("键1")
  断言为真(仓1.读值("键1") == 空, "存储 删值后读值为空")
  # 反跑: 把 空 改为 "值1" 即红

  # 关闭后重开能读回（持久化验证）
  设 仓2 为 新建 存储(存储路径, "空间A")
  断言等于(仓2.读值("键2"), "值2", "存储 重开后读回 键2")
  # 反跑: 把 "值2" 改为 "值X" 即红
  断言为真(仓2.读值("键1") == 空, "存储 重开后 键1 仍为空")
  # 反跑: 把 空 改为 "值1" 即红

  # 命名空间隔离
  设 仓B 为 新建 存储(存储路径, "空间B")
  仓B.存值("B键", "B值")
  断言等于(仓B.读值("B键"), "B值", "存储 命名空间B 读值")
  断言为真(仓B.读值("键2") == 空, "存储 命名空间隔离 键2 不在 B")
  # 反跑: 把 空 改为 "值2" 即红

  # === 收尾：删除临时目录 ===
  删除路径(根)
  断言为真(目录存在(根) == 假, "收尾删除临时目录")

  打印 "test_文件深 PASS"

主()
