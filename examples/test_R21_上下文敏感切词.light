# test_R21_上下文敏感切词.light —— 第21轮 任务2：词法上下文敏感切词（运行期自校验）
#
# 目标：关键字前缀标识符在**非语句起始位置**（表达式语境：赋值右侧/实参/返回值/
#       二元运算操作数/列表元素/字典键/高阶实参）整体成词；语句起始位置与运算符
#       关键字的既有切分不变。全部 rc=0 自校验。

段落 断言相等(实际, 期望, 标签):
    如果 实际 != 期望:
        抛出 新建 错误("断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言真(条件, 标签):
    如果 条件 != 真:
        抛出 新建 错误("断言真失败: " + 标签)

段落 恒真(输入):
    返回 真

段落 去重占位(输入):
    返回 输入 + 1
段落 作用域匹配(输入):
    返回 输入 + 1
段落 排序函数(输入):
    返回 输入 + 1
段落 筛选器(输入):
    返回 输入 + 1
段落 读取器(输入):
    返回 输入 + 1

段落 取结果:
    返回 作用域匹配(1)

段落 主:
    打印 "---- 一、表达式语境（关键字前缀名整体成词）----"
    # 1. 赋值右侧
    设 结果一 为 去重占位(1)
    断言相等(结果一, 2, "赋值右侧")
    # 2. 嵌套调用作实参
    断言相等(去重占位(作用域匹配(1)), 3, "嵌套调用实参")
    # 3. 返回值位置
    断言相等(取结果(), 2, "返回值位置")
    # 4. 二元运算操作数
    断言相等(去重占位(1) + 作用域匹配(1), 4, "二元运算操作数")
    # 5. 列表元素（函数引用）
    设 列表一 为 [排序函数, 筛选器]
    断言相等(列表长度(列表一), 2, "列表元素")
    断言相等(列表一[0](1), 2, "列表取函数再调用")
    # 6. 字典值存函数再调用
    设 映射一 为 {"去重占位": 去重占位, "读取器": 读取器}
    断言相等(映射一["去重占位"](1), 2, "字典值取函数")
    # 7. 高阶实参
    断言真(恒真(去重占位(1)), "关键字前缀名作高阶实参")

    打印 "---- 二、语句起始位置（切分不变）----"
    # 8. 无空格语句头 + 块体
    如果 恒真(1):
        设 分支结果 为 去重占位(1)
    断言相等(分支结果, 2, "无空格如果 + 块体调用")
    # 9. 遍历（`之` 为运算符关键字，仍切分）
    遍历 元素 之 列表一:
        断言真(元素(1) > 0, "遍历调用关键字前缀名")
    # 10. 条件表达式中的调用
    如果 去重占位(1) == 2:
        断言真(真, "条件表达式调用")

    打印 "---- 三、运算符关键字（仍按关键字切分）----"
    设 与结果 为 真 与 假
    断言相等(与结果, 假, "逻辑与")
    设 或结果 为 假 或 真
    断言相等(或结果, 真, "逻辑或")
    设 加结果 为 1 + 2
    断言相等(加结果, 3, "加法")

    打印 "test_R21_上下文敏感切词 PASS"

主()
