# test_R52_终端视图.light —— 第52轮 任务4（terminal-controller 视图状态机，#191 面）
#
# 运行：cd lightharness && python 运行.py examples/test_R52_终端视图.light
# 退出码 0 = 全部断言通过；任一断言失败 → 抛出 错误 → 非零退出。
#
# 上游：deepseek-harness 0.1.6-alpha.1（ea53423b60）
#   packages/api/terminal-controller/src/client/model.ts（TerminalView* 契约与 consume/fail/write/resize）
#   packages/api/terminal-controller/src/stream.ts（TerminalFollower 有界字节队列）
#   packages/api/terminal-controller/src/client/close-requests.ts（TerminalCloseRequests）
#
# 覆盖（纯逻辑面，不接真实PTY/宿主）：
#   词表 —— 问题五值/相位九值/渲染帧与视图状态/终端信息形状谓词
#   帧消费 —— 代切换以 snapshot 开场；同代中途 snapshot 非法；output 序号严格 +1（缺口非法）；
#             非 output 帧的 info/可写补丁；非 state 帧的渲染修订递增
#   失败映射 —— control-unavailable 仅失写；limit-reached → terminalLimit；载具错误 → disconnected
#   写入 —— 准入三条件；排队字节超上限 → inputFull
#   尺寸 —— 相同忽略；超环境上限钳制
#   跟随器 —— 字节预算超限显式失败+关闭；完结后推入忽略；读一步四态；失败在排空后上抛
#   关机簿 —— 形状校验（id 正则）、保存/待办/移除、载入键 id 一致性
#
# 命名避坑：断言助手 检相等/检真/检空串/抛错数。

从 终端 导入 视图问题表, 视图相位表, 是渲染帧, 是视图状态, 是终端信息
从 终端 导入 造帧消费机, 帧消费机吃帧, 视图失败映射, 写入准入, 输入配额判定, 尺寸未变, 尺寸钳制
从 终端 导入 造视图跟随器, 跟随器推入, 跟随器完结, 跟随器关闭, 跟随器读一步
从 终端 导入 关机键前缀, 造关机请求簿, 是关机请求, 关机簿保存, 关机簿移除, 关机簿待办, 关机簿载入

段落 检相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 检真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 新建 错误("断言失败[" + 标签 + "]：条件为假")
  返回 真

段落 主:
  打印 "===== 第52轮 任务4：terminal-controller 视图状态机 ====="

  # ============ 1) 词表与形状 ============
  检相等(视图问题表(), ["missingTerminal", "inputFull", "attachmentEnded", "invalidOutput", "terminalLimit"], "词_问题五值")
  检相等(视图相位表(), ["idle", "loading", "creating", "connecting", "connected", "disconnected", "closing", "closed", "failed"], "词_相位九值")
  设 信息 为 {"id": "t1", "title": "甲终端", "state": "running", "controllerId": "att-1", "cols": 80, "rows": 24}
  检真(是终端信息(信息), "形_终端信息合法")
  检真(是终端信息({"id": ""}) == 假, "形_空id拒绝")
  检真(是渲染帧({"revision": 3, "frame": {"type": "output", "sequence": 1}}), "形_渲染帧合法")
  检真(是渲染帧({"revision": 3, "frame": {"type": "state"}}) == 假, "形_state帧非渲染")
  检真(是渲染帧({"revision": "三", "frame": {"type": "output"}}) == 假, "形_修订非数拒绝")
  设 好状态 为 {"phase": "connected", "writable": 真, "title": "甲终端", "issue": 空}
  检真(是视图状态(好状态), "形_视图状态合法")
  检真(是视图状态({"phase": "梦游", "writable": 假}) == 假, "形_未知相位拒绝")
  检真(是视图状态({"phase": "failed", "writable": 假, "issue": "玄学"}) == 假, "形_未知问题拒绝")
  检真(是视图状态({"phase": "connected", "writable": 假, "render": {"revision": 1, "frame": {"type": "output", "sequence": 1}}}), "形_带渲染帧合法")

  # ============ 2) 帧消费状态机 ============
  # 代切换以 snapshot 开场 → info 补丁 + 渲染修订
  设 机 为 造帧消费机()
  设 判 为 帧消费机吃帧(机, {"type": "snapshot", "sequence": 0, "info": 信息}, 7, "att-1")
  检真(判["失败"] == 空, "帧_代切换snapshot合法")
  检相等(机["代"], 7, "帧_代登记")
  检相等(机["序号"], 0, "帧_序号取snapshot")
  检相等(长(机["补丁表"]), 2, "帧_snapshot双补丁")
  检相等(机["补丁表"][0]["phase"], "connected", "帧_相位connected")
  检相等(机["补丁表"][0]["writable"], 真, "帧_running且同挂载可写")
  检相等(机["补丁表"][1]["render"]["revision"], 1, "帧_渲染修订1")
  # 同代 output 序号严格 +1
  设 判 为 帧消费机吃帧(机, {"type": "output", "sequence": 1}, 7, "att-1")
  检真(判["失败"] == 空, "帧_output连续合法")
  检相等(机["序号"], 1, "帧_序号推进")
  检相等(长(机["补丁表"]), 3, "帧_output仅渲染补丁")
  检相等(机["补丁表"][2]["render"]["revision"], 2, "帧_渲染修订2")
  # 序号缺口 → invalidOutput
  设 判 为 帧消费机吃帧(机, {"type": "output", "sequence": 3}, 7, "att-1")
  检相等(判["失败"], "invalidOutput", "帧_序号缺口非法")
  # 同代中途 snapshot → 非法
  设 机 为 造帧消费机()
  帧消费机吃帧(机, {"type": "snapshot", "sequence": 0, "info": 信息}, 1, "att-1")
  设 判 为 帧消费机吃帧(机, {"type": "snapshot", "sequence": 5, "info": 信息}, 1, "att-1")
  检相等(判["失败"], "invalidOutput", "帧_同代中途snapshot非法")
  # 代切换遇 output → 非法（缺屏幕快照）
  设 机 为 造帧消费机()
  设 判 为 帧消费机吃帧(机, {"type": "output", "sequence": 1}, 9, "att-1")
  检相等(判["失败"], "invalidOutput", "帧_代切换遇output非法")
  # 非同挂载标识 → 不可写
  设 机 为 造帧消费机()
  帧消费机吃帧(机, {"type": "snapshot", "sequence": 0, "info": 信息}, 2, "att-旧")
  检相等(机["补丁表"][0]["writable"], 假, "帧_异挂载不可写")
  # state 帧：补丁但无渲染
  设 机 为 造帧消费机()
  帧消费机吃帧(机, {"type": "snapshot", "sequence": 0, "info": 信息}, 3, "att-1")
  帧消费机吃帧(机, {"type": "output", "sequence": 1}, 3, "att-1")
  设 判 为 帧消费机吃帧(机, {"type": "state", "info": 信息}, 3, "att-1")
  检真(判["失败"] == 空, "帧_state合法")
  检相等(长(机["补丁表"]), 4, "帧_state仅info补丁")
  检真(字典包含键(机["补丁表"][3], "render") == 假, "帧_state无渲染")
  # exited 终端不可写
  设 退信息 为 {"id": "t1", "title": "甲终端", "state": "exited", "controllerId": "att-1"}
  设 机 为 造帧消费机()
  帧消费机吃帧(机, {"type": "snapshot", "sequence": 0, "info": 退信息}, 4, "att-1")
  检相等(机["补丁表"][0]["writable"], 假, "帧_exited不可写")

  # ============ 3) 失败映射 ============
  设 判 为 视图失败映射("terminal/control-unavailable", 假)
  检真(判["仅失写"], "败_控制不可用仅失写")
  检相等(判["改相位"], 空, "败_控制不可用不改相位")
  设 判 为 视图失败映射("terminal/limit-reached", 假)
  检相等(判["问题"], "terminalLimit", "败_限额映射")
  检相等(判["改相位"], "failed", "败_限额相位failed")
  设 判 为 视图失败映射("其它", 真)
  检相等(判["改相位"], "disconnected", "败_载具错误disconnected")
  设 判 为 视图失败映射("其它", 假)
  检相等(判["改相位"], "failed", "败_普通错误failed")

  # ============ 4) 写入准入与配额 ============
  检真(写入准入({"writable": 真, "info": 信息}, "att-1"), "写_三条件齐准入")
  检真(写入准入({"writable": 假, "info": 信息}, "att-1") == 假, "写_不可写忽略")
  检真(写入准入({"writable": 真}, "att-1") == 假, "写_无信息忽略")
  检真(写入准入({"writable": 真, "info": 信息}, 空) == 假, "写_无挂载忽略")
  检相等(输入配额判定(100, 20, 200), {"准": 真, "问题": 空}, "写_配额内放行")
  检相等(输入配额判定(100, 101, 200), {"准": 假, "问题": "inputFull"}, "写_超配额inputFull")

  # ============ 5) 尺寸 ============
  检真(尺寸未变(信息, 80, 24), "寸_相同忽略")
  检真(尺寸未变(信息, 100, 24) == 假, "寸_列变不忽略")
  检相等(尺寸钳制(120, 40, {"maxCols": 100, "maxRows": 30}), {"cols": 100, "rows": 30}, "寸_超限钳制")
  检相等(尺寸钳制(80, 24, 空), {"cols": 80, "rows": 24}, "寸_无环境原值")

  # ============ 6) 跟随器（字节预算队列） ============
  设 随 为 造视图跟随器(100)
  跟随器推入(随, {"type": "output", "sequence": 1}, 30)
  跟随器推入(随, {"type": "output", "sequence": 2}, 40)
  检相等(随["字节"], 70, "随_字节累计")
  检相等(跟随器读一步(随)["原因"], "帧", "随_读出帧")
  检相等(随["字节"], 40, "随_读后扣减")
  # 超预算 → 显式失败 + 关闭
  跟随器推入(随, {"type": "output", "sequence": 3}, 61)
  检真(字符串包含(随["失败"], "exceeded its buffer"), "随_超预算失败")
  检真(随["关闭"], "随_超预算后关闭")
  检相等(随["字节"], 0, "随_关闭清字节")
  # 完结后推入忽略；读尽队列后得完
  设 随 为 造视图跟随器(1000)
  跟随器推入(随, {"type": "output", "sequence": 1}, 10)
  跟随器完结(随)
  跟随器推入(随, {"type": "output", "sequence": 2}, 10)
  检相等(跟随器读一步(随)["原因"], "帧", "随_完结后队列仍可读")
  检相等(跟随器读一步(随)["原因"], "完", "随_队列尽得完")
  检相等(随["字节"], 0, "随_完结扣尽")
  # 失败在队列排空后上抛
  设 随 为 造视图跟随器(1000)
  跟随器推入(随, {"type": "output", "sequence": 1}, 10)
  字典设置(随, "失败", "线路断了")
  检相等(跟随器读一步(随)["原因"], "帧", "随_失败前排空队列")
  设 判 为 跟随器读一步(随)
  检相等(判["原因"], "败", "随_排空后上抛")
  检相等(判["错误"], "线路断了", "随_失败错误透传")
  # 等待态：队列空未完结
  设 随 为 造视图跟随器(1000)
  跟随器关闭(随)
  检相等(跟随器读一步(随)["原因"], "完", "随_关闭后得完")
  设 随 为 造视图跟随器(1000)
  检相等(跟随器读一步(随)["原因"], "等待", "随_空队等待")

  # ============ 7) 关机请求簿 ============
  检相等(关机键前缀(), "dsh.terminal.close.v1.", "簿_键前缀")
  设 好请求 为 {"sessionId": "s1", "id": "term-1", "title": "甲"}
  检真(是关机请求(好请求), "簿_形状合法")
  检真(是关机请求({"sessionId": "", "id": "t", "title": "甲"}) == 假, "簿_空会话拒绝")
  检真(是关机请求({"sessionId": "s1", "id": "坏 id!", "title": "甲"}) == 假, "簿_坏id拒绝")
  检真(是关机请求({"sessionId": "s1", "id": "term-1"}) == 假, "簿_缺标题拒绝")
  # 128 位长 id 上边界
  设 长id 为 ""
  设 序 为 0
  当 序 < 128:
    设 长id 为 长id + "a"
    设 序 为 序 + 1
  检真(是关机请求({"sessionId": "s1", "id": 长id, "title": "甲"}), "簿_128位id合法")
  检真(是关机请求({"sessionId": "s1", "id": 长id + "a", "title": "甲"}) == 假, "簿_129位id拒绝")
  # 保存/待办/移除
  设 簿 为 造关机请求簿()
  关机簿保存(簿, 好请求)
  关机簿保存(簿, {"sessionId": "s1", "id": "term-2", "title": "乙"})
  检相等(长(关机簿待办(簿)), 2, "簿_待办两条")
  关机簿移除(簿, "term-1")
  检相等(长(关机簿待办(簿)), 1, "簿_确认后移除")
  检相等(关机簿待办(簿)[0]["id"], "term-2", "簿_余项正确")
  # 载入：形状非法 / 键与 id 不一致 → 抛
  设 抛错数 为 0
  尝试:
    关机簿载入(簿, 关机键前缀() + "term-3", {"sessionId": "s1", "id": "term-9", "title": "丙"})
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "簿_键id不一致抛错")
  设 抛错数 为 0
  尝试:
    关机簿载入(簿, 关机键前缀() + "term-3", {"sessionId": "s1", "id": "term-3"})
  捕获 异常:
    设 抛错数 为 抛错数 + 1
  检相等(抛错数, 1, "簿_缺标题形状非法抛错")
  关机簿载入(簿, 关机键前缀() + "term-3", {"sessionId": "s1", "id": "term-3", "title": "丙"})
  检相等(长(关机簿待办(簿)), 2, "簿_合法载入")

  打印 "R52 终端视图：词表形状/帧消费四非法/失败映射/写入配额/尺寸钳制/跟随器字节预算/关机簿 全部通过"

主()
