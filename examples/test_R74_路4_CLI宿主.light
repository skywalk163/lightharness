# test_R74_路4_CLI宿主.light —— 对标 #11 CLI 宿主层移植收口：上游 6 文件纯逻辑移植实测
# 运行：python 运行.py examples/test_R74_路4_CLI宿主.light
#
# 覆盖 src/CLI判定逻辑.light 从上游 apps/cli/src/ 6 文件提取的纯逻辑：
#   args.ts         解析启动 / 累积补丁
#   profile-boot.ts 解析遥测补丁 / 全补丁顺序 / 校验默认样板初始化
#   dump-config.ts  渲染配置快照
#   plugin.ts       锚定路径规格
# （bin.ts / process-shutdown.ts 属宿主层，登记不移植，本用例不覆盖，见交付报告与 #11 证据）
#
# 断言均跑真实逻辑（非仅常量）：启动调用解析的校验分支、补丁收集器折叠、遥测开关语义、
# 层叠加顺序、样板初始化校验、配置快照渲染顺序、相对路径锚定。

从 CLI判定逻辑 导入 解析启动, 累积补丁, 解析遥测补丁, 全补丁顺序, 校验默认样板初始化, 渲染配置快照, 锚定路径规格

段落 断言包含(文本, 摘录, 标签):
  如果 字符串包含(文本, 摘录) == 假:
    抛出 "断言失败: " + 标签 + "（缺少片段 " + 摘录 + "）"

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

段落 检查抛错(标签, 运算):
  设 有错 为 假
  设 文案 为 ""
  尝试:
    运算()
  捕获 异常 错误:
    设 有错 为 真
    设 文案 为 转字符串(错误)
  如果 有错 == 假:
    抛出 "应抛未抛: " + 标签
  返回 文案

# ---- 各抛错场景的具名封装（光明不支持参数位内联闭包，故抽具名段落）----
段落 抛补丁空:
  解析启动("web", 假, 假, 空, [""], [])

段落 抛默认空:
  解析启动("web", 假, 假, "", [], [])

段落 抛桌面:
  解析启动("DESKTOP", 假, 假, 空, [], [])

段落 抛互斥:
  解析启动("web", 真, 真, 空, [], [])

段落 抛带参:
  解析启动("web", 真, 假, 空, [], ["x"])

段落 抛默认带补丁:
  解析启动("web", 假, 真, 空, ["a.yml"], [])

段落 抛未知样板:
  校验默认样板初始化("x", "nope", ["web", "tui"])

段落 抛已发布目标:
  校验默认样板初始化("web", "web", ["web", "tui"])

段落 主:
  # ① profile 引导：余参原样带走
  设 调用 为 解析启动("web", 假, 假, 空, [], ["run the tests"])
  断言等于(调用["方式"], "profile", "profile 引导方式")
  断言等于(调用["档案"], "web", "profile 档案名")
  断言等于(调用["余参"], ["run the tests"], "profile 余参原样带走")

  # ② --dump-config（非仅默认）
  设 调用 为 解析启动("web", 真, 假, 空, [], [])
  断言等于(调用["方式"], "dump-config", "dump-config 方式")
  断言等于(调用["仅默认"], 假, "dump-config 仅默认=假")

  # ③ --dump-default-config（仅默认）
  设 调用 为 解析启动("web", 假, 真, 空, [], [])
  断言等于(调用["方式"], "dump-config", "dump-default-config 方式")
  断言等于(调用["仅默认"], 真, "dump-default-config 仅默认=真")

  # ④ --patch 空串校验
  设 文案 为 检查抛错("--patch 空串", 抛补丁空)
  断言包含(文案, "--patch needs a path", "--patch 空串文案")

  # ⑤ --from-default-profile 空串校验（注意上游空串 "" 与未提供 空 不同）
  设 文案 为 检查抛错("--from-default-profile 空串", 抛默认空)
  断言包含(文案, "--from-default-profile needs a name", "--from-default-profile 空串文案")

  # ⑥ desktop 由 Electron 独占（不区分大小写）
  设 文案 为 检查抛错("desktop 拒绝（大写）", 抛桌面)
  断言包含(文案, "Electron", "desktop 拒绝文案")

  # ⑦ 两个 dump 旗标互斥
  设 文案 为 检查抛错("dump 互斥", 抛互斥)
  断言包含(文案, "mutually exclusive", "dump 互斥文案")

  # ⑧ dump 不接受 app 参数
  设 文案 为 检查抛错("dump 带参", 抛带参)
  断言包含(文案, "no app arguments", "dump 带参文案")

  # ⑨ --dump-default-config 不吃 --patch
  设 文案 为 检查抛错("dump-default 带 patch", 抛默认带补丁)
  断言包含(文案, "takes no --patch", "dump-default 带 patch 文案")

  # ⑩ --from-default-profile 合法 → profile 引导且带样板名
  设 调用 为 解析启动("rescue", 假, 假, "web", [], [])
  断言等于(调用["方式"], "profile", "from-default 仍走 profile")
  断言等于(调用["默认样板"], "web", "from-default 样板名")

  # ---- args.ts：累积补丁（collect 可重复单值收集器）----
  断言等于(累积补丁("a", []), ["a"], "collect 首值")
  断言等于(累积补丁("b", ["a"]), ["a", "b"], "collect 追加")
  断言等于(累积补丁("c", ["a", "b"]), ["a", "b", "c"], "collect 多值折叠")

  # ---- profile-boot.ts：解析遥测补丁（resolveTelemetryPatch）----
  断言等于(解析遥测补丁(空, 真), 空, "未设环境变量→不生成补丁")
  断言等于(解析遥测补丁("1", 假), 空, "无遥测行→不生成补丁")
  # 任意非空值（含 "0"/"false"）都禁用——隐私开关宁可误关
  设 补丁 为 解析遥测补丁("0", 真)
  断言等于(补丁 == 空, 假, "0 也禁用遥测")
  断言等于(补丁["禁用"], 真, "补丁禁用=真")
  断言等于(解析遥测补丁("false", 真)["禁用"], 真, "false 也禁用遥测")
  断言等于(解析遥测补丁("yes", 真)["编号"], "session-telemetry-otel", "补丁编号")

  # ---- profile-boot.ts：全补丁顺序（allPatches）----
  断言等于(全补丁顺序(["b1"], ["p1"], ["h1"], ["o1"]), ["b1", "p1", "h1", "o1"], "单层顺序")
  断言等于(全补丁顺序(["b1", "b2"], ["p1"], ["h1", "h2"], ["o1"]), ["b1", "b2", "p1", "h1", "h2", "o1"], "多层顺序")
  断言等于(全补丁顺序([], [], [], []), [], "全空顺序")

  # ---- profile-boot.ts：校验默认样板初始化 ----
  断言等于(校验默认样板初始化("rescue", "web", ["web", "tui", "headless"]), 真, "合法从默认初始化")
  设 文案 为 检查抛错("未知样板", 抛未知样板)
  断言包含(文案, "unknown default profile", "未知样板文案")
  设 文案 为 检查抛错("shipped 目标", 抛已发布目标)
  断言包含(文案, "is shipped and cannot be a custom profile target", "shipped 目标文案")

  # ---- dump-config.ts：渲染配置快照（renderConfigDump 纯渲染）----
  设 快照 为 渲染配置快照("dsh", "cordis.yml", [])
  断言包含(快照, "dsh", "快照含安装名")
  断言包含(快照, "cordis.yml", "快照含根配置名")
  断言包含(快照, "(无层)", "空层提示")
  设 快照 为 渲染配置快照("dsh", "cordis.yml", [["标签": "bundleA", "补丁": []], ["标签": "bundleB", "补丁": []]])
  断言包含(快照, "bundleA", "快照含层A标签")
  断言包含(快照, "bundleB", "快照含层B标签")
  # 顺序：A 在 B 之前
  断言等于(字符串包含(快照, "bundleA") == 真 且 字符串包含(快照, "bundleB") == 真 且 查找子串(快照, "bundleA") < 查找子串(快照, "bundleB"), 真, "层顺序 A 在 B 前")

  # ---- plugin.ts：锚定路径规格（anchorPathSpec）----
  设 锚 为 锚定路径规格("./plugin", "/home/u")
  断言等于(锚 == "./plugin", 假, "相对规格被锚定（不再是原值）")
  断言包含(锚, "plugin", "锚定后含相对名")
  断言包含(锚, "/home/u", "锚定后含基准目录")
  设 锚 为 锚定路径规格("file:../x", "/c/w")
  断言等于(开头(锚, "file:"), 真, "file: 前缀保留")
  断言等于(锚 == "file:../x", 假, "file: 相对规格被锚定")
  断言包含(锚, "/c/", "file: 锚定到基准目录")
  断言等于(锚定路径规格("add", "/cwd"), "add", "registry 名原样")
  断言等于(锚定路径规格("react", "/cwd"), "react", "包名原样")
  设 锚 为 锚定路径规格("../sibling", "/a/b")
  断言等于(锚 == "../sibling", 假, "../ 规格被锚定")
  断言包含(锚, "/a/b", "../ 锚定到基准目录")

  打印 "test_R74_路4_CLI宿主 PASS"

主()
