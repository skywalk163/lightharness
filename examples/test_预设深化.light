  断言相等(造显示文本({"id": "p-user", "trust": "user"})["name"], "p-user", "5a 预设显示 用户预设回退 id")
  断言相等(造显示文本({"id": "p2", "trust": "user", "name": "我的预设"})["name"], "我的预设", "5b 预设显示 用自报名")
  断言相等(行启用({"disabled": 真}), 假, "5c 预设 行启用 禁用")
  断言相等(行启用({}), 真, "5d 预设 行启用 默认启用")
  # settings 脱敏（redact.ts 已覆盖）
  设 模式 为 {"类型": "对象", "属性": {"令牌": {"角色": "secret"}, "主名": {"类型": "字符串"}}}
  设 脱敏结果 为 脱敏值(模式, {"令牌": "s3cr3t", "主名": "n"})
  断言相等(长度(脱敏结果["秘密"]), 1, "5e 脱敏 秘密槽位数")
  断言相等(脱敏结果["秘密"][0]["路径"], ["令牌"], "5f 脱敏 秘密路径")
  断言相等(脱敏结果["秘密"][0]["设置"], 真, "5g 脱敏 槽位已设置")
  断言相等(字典包含键(脱敏结果["值"], "令牌"), 假, "5h 脱敏 值已剥离秘密")
  断言相等(脱敏结果["值"]["主名"], "n", "5i 脱敏 保留非秘密")
  # skill 技能清单（skill/src/index.ts 已覆盖）
  断言相等(是技能名("my-skill"), 真, "5j 技能名 常规")
  断言相等(是技能名("My"), 假, "5k 技能名 含大写拒绝")

  打印 "test_预设深化 PASS"
