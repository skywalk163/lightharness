# test_R35_非空块边界.light —— R35 任务2 G2 编译门 + 五种边界形态自校验
#
# 结论：非空块 **通用化成功，已从 _P0A_MERGE_WHOLE 移除**（3 → 2 条）。
# 通用规则 GR-2b（lexer.py R21 上下文敏感分支）：
#   ① 新增类别 `_P0A_UNARY_PREFIX_KW = {'非'}` —— 一元前缀运算符，与二元中缀运算符
#      （加/减/乘/除/等于/大于/小于/包含/与/或/且）语义不同：无空格 `非X` 恒为复合名
#      （语料实证：非空 259 / 非法 206 / 非零 164 / 非值 125 / 非负整数 67 …），
#      而非 `not X` 表达式；
#   ② R21 闸门3「词首关键字不得是运算符关键字」对一元前缀类开例外；
#   ③ 收窄：`非` 的余部若是**已声明名字**（user_definitions）则仍是操作数
#      （`非甲` = not 甲），保持运算符切分 —— 保证反向形态零变化。
# 判据：G1 全语料 864 文件零变化 ∧ G2 本文件 rc=0 ∧ G3 五种边界形态 token 流一致。
#
# 运行：cd lightharness && python 运行.py examples/test_R35_非空块边界.light

段落 断言相等 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 非空块:
  返回 82

段落 消费 接收 入参:
  返回 入参

段落 消费名 接收 入参:
  # 传参位收到的是**函数名**（未调用），此处调用之：
  # 若词法把 非空块 劈成 非 + 空块，此处必然语义错（not 空块()）。
  返回 入参()

段落 取反 接收 标志:
  返回 标志 == 假

段落 主:
  # F1 设名位
  设 非空块值 为 82
  断言相等(非空块值, 82, "F1 设名位 整词")

  # F2 函数名位（调用语境）
  断言相等(非空块(), 82, "F2 函数名位 整词")

  # F4 段落名位
  断言相等(非空块(), 82, "F4 段落名位 整词")

  # F5 传参位（首参 / 次参）
  断言相等(消费(非空块()), 82, "F5 传参位 首参 整词")
  断言相等(消费名(非空块), 82, "F5 传参位 传函数名 整词")

  # 附加形态：值位 / 列表元素 / 条件位 / 算术位
  设 别名 为 非空块
  断言相等(别名(), 82, "值位 整词")
  设 表 为 [非空块]
  断言相等(长度(表), 1, "列表元素 整词")
  如果 表[0]():
    断言相等(1, 1, "条件位 整词")

  # 同类复合名（非 + 名词）整词
  设 非法 为 真
  断言相等(非法, 真, "非法 整词")
  设 非零值 为 7
  断言相等(非零值, 7, "非零值 整词")

  # ---- 反向形态：`非` 的一元取反语义不得被吞 ----
  # (a) 带空格：非 甲 ⇒ 仍是 not
  设 甲 为 真
  断言相等(非 甲, 假, "反向 a：非 甲 仍是取反")
  # (b) 无空格但余部是已声明名字：非甲 ⇒ 仍是 not（收窄③）
  断言相等(非甲, 假, "反向 b：非甲（甲已声明）仍是取反")
  # (c) 传参位调用取反
  断言相等(取反(非 甲), 真, "反向 c：传参位取反")

  打印 "--- test_R35 非空块边界 通过 ---"

主()
