# test_R73_A_位运算符.light —— G-08 位运算符完善（R73 任务A）
#
# 覆盖：六基本位运算符（位与/位或/位异或/位非/左移/右移）、
#       运算符优先级、五种复合位赋值（位与为/位或为/位异或为/左移为/右移为），
#       以及复合位赋值作用于成员目标、下标目标、与普通赋值共存。
#
# 运行：python 运行.py examples/test_R73_A_位运算符.light

类 箱子:
    段落 构造:
        己.位 为 0b1010

段落 主:
    # ── 六基本位运算符 ──
    断言(3 位与 1 == 1, "位与: 3&1=1")
    断言(3 位或 1 == 3, "位或: 3|1=3")
    断言(3 位异或 1 == 2, "位异或: 3^1=2")
    断言(位非 3 == -4, "位非: ~3=-4")
    断言(1 左移 4 == 16, "左移: 1<<4=16")
    断言(16 右移 2 == 4, "右移: 16>>2=4")

    # ── 优先级（与 Python 一致：| < ^ < & < <<,>> < +/-）──
    断言(1 位或 2 位与 4 == 1, "优先级: 1|(2&4)=1")
    断言((1 位或 2) 位与 4 == 0, "括号覆盖优先级")
    断言(1 左移 4 加 1 == 32, "优先级: 1<<(4+1)=32（<< 低于 +/-）")
    断言(7 右移 1 位与 1 == 1, "优先级: (7>>1)&1=1")

    # ── 负值 / 边界 ──
    断言(位非 0 == -1, "位非 0 = -1")
    断言(位非(-1) == 0, "位非 -1 = 0")
    断言(-1 右移 1 == -1, "算术右移: -1>>1=-1")

    # ── 五种复合位赋值 ──
    设 a 为 12
    a 位与为 10
    断言(a == 8, "位与为: 12&=10 → 8")

    设 b 为 5
    b 位或为 3
    断言(b == 7, "位或为: 5|=3 → 7")

    设 c 为 12
    c 位异或为 10
    断言(c == 6, "位异或为: 12^=10 → 6")

    设 d 为 1
    d 左移为 4
    断言(d == 16, "左移为: 1<<=4 → 16")

    设 e 为 16
    e 右移为 2
    断言(e == 4, "右移为: 16>>=2 → 4")

    # ── 复合位赋值：成员目标 ──
    设 箱 为 箱子()
    箱.位 位与为 0b0011
    断言(箱.位 == 0b0010, "成员位与为: 10 & 3 = 2")

    # ── 复合位赋值：下标目标 ──
    设 表 为 [0b1111, 0]
    表[0] 位与为 0b0110
    断言(表[0] == 0b0110, "下标位与为: 15 & 6 = 6")

    # ── 与普通赋值共存 ──
    设 f 为 0xFF
    f 位与为 0x0F
    断言(f == 0x0F, "十六进制掩码位与为")
    设 f 为 0xFF
    断言(f == 0xFF, "普通赋值语义不受影响")

    打印 "--- test_R73_A 位运算符 通过 ---"

主()
