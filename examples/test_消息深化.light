# test_消息深化.light —— 消息词汇表深化测试（#4 v2：image/audio/resource 块）
# 覆盖：造图片块/造音频块/造资源块构造 / 取消息文本投影 / 含多块消息构造。
# 反跑判据：把 块类型 或 文本投影 断言改反即红。

从 消息 导入 造图片块, 造音频块, 造资源块, 造文本块, 造用户消息, 取消息文本

段落 断言真 接收 条件, 标签:
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 断言等于 接收 实际, 期望, 标签:
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) + " 期望=" 加上 转字符串(期望)

段落 主:
  # 图片块
  设 图片块 为 造图片块("iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg==", "image/png")
  断言等于(图片块["type"], "image", "图片块类型应为 image")
  断言等于(图片块["mimeType"], "image/png", "mimeType 应为 image/png")
  断言真(图片块["data"].包含("iVBORw0KGgo"), "图片块应含 data")

  # 图片块默认 mimeType
  设 图片块2 为 造图片块("data123", 空)
  断言等于(图片块2["mimeType"], "image/png", "默认 mimeType 应为 image/png")

  # 音频块
  设 音频块 为 造音频块("UklGRiQAAABXQVZFZm10IBAAAAABAAEAESsAACJWAAACABAAZGF0YQAAAAA=", "audio/wav")
  断言等于(音频块["type"], "audio", "音频块类型应为 audio")
  断言等于(音频块["mimeType"], "audio/wav", "mimeType 应为 audio/wav")
  断言真(音频块["data"].包含("UklGRiQ"), "音频块应含 data")

  # 资源块
  设 资源块 为 造资源块("res_001", "这是资源内容", ["type": "url", "uri": "https://example.com/doc"])
  断言等于(资源块["type"], "resource", "资源块类型应为 resource")
  断言等于(资源块["resourceId"], "res_001", "resourceId 应为 res_001")
  断言等于(资源块["text"], "这是资源内容", "text 应为 这是资源内容")
  断言真(资源块.包含("source"), "资源块应含 source")

  # 资源块无来源
  设 资源块2 为 造资源块("res_002", "无来源资源", 空)
  断言真(资源块2.包含("source") == 假, "无来源资源块不应含 source")

  # 取消息文本投影：多块消息
  设 内容 为 [造文本块("你好"), 图片块, 音频块, 资源块]
  设 消息 为 造用户消息(内容)
  设 文本 为 取消息文本(消息)
  断言真(文本.包含("你好"), "文本投影应含 你好")
  断言真(文本.包含("[图片 image/png:"), "文本投影应含 [图片 image/png:")
  断言真(文本.包含("[音频 audio/wav]"), "文本投影应含 [音频 audio/wav]")
  断言真(文本.包含("[资源 res_001:"), "文本投影应含 [资源 res_001:")
  断言真(文本.包含("这是资源内容"), "文本投影应含资源文本")

  打印 "test_消息深化 PASS"

主()
