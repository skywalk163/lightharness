# test_子代理深化.light —— 模块 子代理深化 对齐判据（第34轮 任务3 子代理深化）
# 运行：python 运行.py examples/test_子代理深化.light

从 子代理深化 导入 深块容量, 默认最大深度, 消息待办, 消息已读, 消息已决, 建目录, 建目录根, 加子目录, 删子目录, 列子目录, 目录路径, 归属目录, 查归属, 列归属, 切段, 隔离检查, 深解析路径, 切换目录, 建收件箱, 投入消息, 优先级权重, 取待办, 标记已读, 标记已决, 列举消息, 待办数, 是否积压, 深追加, 深展平, 深逆展平, 深分块长, 深块数, 深校验, 建子代理, 可否派生, 派生子代, 代理链, 深度自洽, 子代数

段落 断言相等 接收 实际, 期望, 信息:
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 断言为真 接收 实际, 信息:
  如果 实际 != 真:
    抛出 新建 错误("断言失败（应为真）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 断言为假 接收 实际, 信息:
  如果 实际 != 假:
    抛出 新建 错误("断言失败（应为假）：" + 信息 + " | 实际=" + 转字符串(实际))

段落 检查抛错 接收 探针, 信息:
  设 已抛 为 假
  尝试:
    探针()
  捕获 异常 为 e:
    设 已抛 为 真
  如果 已抛 == 假:
    抛出 新建 错误("应抛错未抛：" + 信息)
  返回 真

段落 主:
  # ---------- 1) 父属目录：层级 ----------
  设 根 为 建目录根()
  设 甲 为 加子目录(根, "甲")
  设 乙 为 加子目录(根, "乙")
  设 甲丙 为 加子目录(甲, "丙")
  断言相等(长(列子目录(根)), 2, "根下 2 个子目录")
  断言相等(长(列子目录(甲)), 1, "甲下 1 个子目录")
  断言相等(目录路径(根), "根", "根路径")
  断言相等(目录路径(甲), "根/甲", "甲路径")
  断言相等(目录路径(甲丙), "根/甲/丙", "丙路径（层级拼接）")
  段落 重名目录:
    加子目录(根, "甲")
  检查抛错(重名目录, "子目录重名必须抛错")
  段落 空目录名:
    建目录("")
  检查抛错(空目录名, "空目录名必须抛错")
  断言为真(删子目录(根, "乙"), "删子目录成功")
  断言为假(删子目录(根, "乙"), "重复删除返回假")
  断言相等(长(列子目录(根)), 1, "删除后根下剩 1 个")

  # ---------- 2) 归属与隔离 ----------
  断言为真(归属目录(甲, "子甲"), "子甲 归属 甲")
  断言为假(归属目录(甲, "子甲"), "重复归属返回假")
  断言相等(长(列归属(甲)), 1, "甲下 1 个子代理")
  断言相等(查归属(甲, "子甲")["名称"], "子甲", "查归属命中")
  断言相等(查归属(甲, "不存在"), 空, "查不到返回空")

  断言相等(长(切段("甲/丙")), 2, "切段去空")
  断言相等(长(切段("/甲//丙/")), 2, "切段去多余斜杠")
  断言为真(深解析路径(甲, "丙") == 甲丙, "向下解析命中")
  断言相等(深解析路径(甲, "不存在"), 空, "不存在的路径返回空")
  断言为真(深解析路径(甲, "") == 甲, "空路径即自身")

  # 隔离：含 .. 一律拒绝（不得跨目录访问）
  设 逃逸 为 隔离检查(甲, "../乙")
  断言为假(逃逸["允许"], ".. 逃逸被拒")
  断言相等(逃逸["错误码"], "CROSS_DIRECTORY_DENIED", "跨目录错误码")
  断言为假(隔离检查(甲, "丙/../../乙")["允许"], "嵌套 .. 也被拒")
  设 正常 为 隔离检查(甲, "丙")
  断言为真(正常["允许"], "向下访问允许")
  断言为真(正常["目标"] == 甲丙, "返回目标目录")
  设 缺失 为 隔离检查(甲, "不存在")
  断言为假(缺失["允许"], "不存在路径被拒")
  断言相等(缺失["错误码"], "PATH_NOT_FOUND", "路径不存在错误码")
  段落 切换逃逸:
    切换目录(甲, "..")
  检查抛错(切换逃逸, "切换目录逃逸必须抛错")
  断言为真(切换目录(甲, "丙") == 甲丙, "正常切换")

  # ---------- 3) Human Inbox ----------
  设 收件箱 为 建收件箱(3)
  投入消息(收件箱, "子甲", "需要确认删除", "normal", 100)
  投入消息(收件箱, "子乙", "高危操作待批", "urgent", 110)
  投入消息(收件箱, "子丙", "低优先提示", "low", 120)
  断言相等(长(列举消息(收件箱)), 3, "入队 3 条")
  断言相等(收件箱["序号"], 3, "消息序号递增")
  断言相等(列举消息(收件箱)[0]["status"], 消息待办, "初始 pending")
  断言相等(列举消息(收件箱)[0]["sender"], "子甲", "sender 字段")
  断言相等(列举消息(收件箱)[0]["createdAt"], 100, "createdAt 字段")
  段落 坏优先级:
    投入消息(收件箱, "子丁", "x", "瞎写", 130)
  检查抛错(坏优先级, "未知优先级必须抛错")
  段落 空发送者:
    投入消息(收件箱, "", "x", "normal", 140)
  检查抛错(空发送者, "空发送者必须抛错")
  段落 坏阈值:
    建收件箱(0)
  检查抛错(坏阈值, "非正积压阈值必须抛错")

  # 优先级权重
  断言相等(优先级权重("urgent"), 3, "urgent 权重 3")
  断言相等(优先级权重("high"), 2, "high 权重 2")
  断言相等(优先级权重("normal"), 1, "normal 权重 1")
  断言相等(优先级权重("low"), 0, "low 权重 0")

  # 出队：urgent 优先（第 2 条入队的 urgent 先出）
  设 首条 为 取待办(收件箱)
  断言相等(首条["sender"], "子乙", "urgent 先出队")
  断言相等(首条["status"], 消息已读, "出队即 acknowledged")
  断言相等(待办数(收件箱), 2, "剩余 2 条待办")
  设 次条 为 取待办(收件箱)
  断言相等(次条["sender"], "子甲", "其次 normal")
  设 三条 为 取待办(收件箱)
  断言相等(三条["sender"], "子丙", "最后 low")
  断言相等(取待办(收件箱), 空, "队列空返回空")

  # 标记已读 / 已决
  设 箱乙 为 建收件箱(2)
  投入消息(箱乙, "甲", "内容甲")
  投入消息(箱乙, "乙", "内容乙")
  断言为真(标记已读(箱乙, 1), "标记已读成功")
  断言为假(标记已读(箱乙, 1), "重复标记已读返回假（已非 pending）")
  断言为假(标记已读(箱乙, 99), "不存在序号返回假")
  断言为真(标记已决(箱乙, 2), "标记已决成功")
  断言相等(长(列举消息(箱乙, 消息已读)), 1, "已读 1 条")
  断言相等(长(列举消息(箱乙, 消息已决)), 1, "已决 1 条")
  断言相等(长(列举消息(箱乙, 消息待办)), 0, "无待办")

  # 积压判定
  设 箱丙 为 建收件箱(2)
  断言为假(是否积压(箱丙), "空箱不积压")
  投入消息(箱丙, "甲", "一")
  断言为假(是否积压(箱丙), "1 条未到阈值")
  投入消息(箱丙, "乙", "二")
  断言为真(是否积压(箱丙), "2 条达阈值即积压")
  取待办(箱丙)
  断言为假(是否积压(箱丙), "出队后不再积压")

  # ---------- 4) ChunkedList：不可变 + 展平 + 校验 ----------
  断言相等(深块容量, 64, "块容量 64")
  设 头甲 为 空
  设 头甲 为 深追加(头甲, 1)
  设 头乙 为 深追加(头甲, 2)
  设 头丙 为 深追加(头乙, 3)
  断言相等(深分块长(头甲), 1, "头甲 1 项")
  断言相等(深分块长(头乙), 2, "头乙 2 项")
  断言相等(深分块长(头丙), 3, "头丙 3 项")
  断言相等(序列化JSON(深展平(头甲)), 序列化JSON([1]), "头甲未被修改（不可变）")
  断言相等(序列化JSON(深展平(头乙)), 序列化JSON([1, 2]), "头乙未被修改（不可变）")
  断言相等(序列化JSON(深展平(头丙)), 序列化JSON([1, 2, 3]), "正序展平")
  断言相等(序列化JSON(深逆展平(头丙)), 序列化JSON([3, 2, 1]), "逆序展平")
  断言相等(深块数(头丙), 1, "3 项仍在 1 块")
  断言为真(深校验(头丙), "单块校验通过")
  断言为真(深校验(空), "空列表校验通过")

  # 跨块：追加 64 项后新开一块
  设 头丁 为 空
  设 计 为 0
  当 计 < 130:
    设 头丁 为 深追加(头丁, 计)
    设 计 为 计 + 1
  断言相等(深分块长(头丁), 130, "130 项")
  断言相等(深块数(头丁), 3, "130 项占 3 块（64+64+2）")
  断言相等(深展平(头丁)[0], 0, "首项 0")
  断言相等(深展平(头丁)[129], 129, "末项 129")
  断言相等(深逆展平(头丁)[0], 129, "逆序首项 129")
  断言为真(深校验(头丁), "多块校验通过")
  # 手工构造非法块：空值表
  断言为假(深校验({"值表": []}), "空块校验失败")
  断言为假(深校验({"值表": [1], "前件": {"值表": []}}), "前件空块校验失败")

  # ---------- 5) 深度限制 ----------
  设 主代理 为 建子代理("主")
  断言相等(主代理["深度"], 1, "主代理深度 1")
  断言相等(子代数(主代理), 0, "初始无子代")
  断言为真(可否派生(主代理, 3), "深度 1 可派生到 2")
  设 二层 为 派生子代(主代理, "二层", 3)
  断言相等(二层["深度"], 2, "二层深度 2")
  断言相等(子代数(主代理), 1, "主代理 1 个子代")
  设 三层 为 派生子代(二层, "三层", 3)
  断言相等(三层["深度"], 3, "三层深度 3")
  断言为假(可否派生(三层, 3), "深度 3 不可再派生（上限 3）")
  段落 超限派生:
    派生子代(三层, "四层", 3)
  检查抛错(超限派生, "超深度必须抛错")
  断言相等(子代数(三层), 0, "超限未创建子代")
  断言相等(默认最大深度, 3, "默认最大深度 3")

  # 超限错误消息可被捕获（消息内容断言）
  设 抓到 为 ""
  尝试:
    派生子代(三层, "四层", 3)
  捕获 异常 为 e:
    设 抓到 为 转字符串(e)
  断言为真(字符串包含(抓到, "SUBAGENT_DEPTH_EXCEEDED") == 真, "错误码在消息内")
  断言为真(字符串包含(抓到, "建议") == 真, "消息含建议")

  # 提升上限后可继续
  断言为真(可否派生(三层, 5), "上限提到 5 后可派生")
  设 四层 为 派生子代(三层, "四层", 5)
  断言相等(四层["深度"], 4, "四层深度 4")

  # 父代理链
  断言相等(序列化JSON(代理链(四层)), 序列化JSON(["四层", "三层", "二层", "主"]), "父代理链完整")
  断言为真(深度自洽(四层), "链路长度与深度自洽")
  断言为真(深度自洽(主代理), "主代理自洽")
  段落 空名子代:
    建子代理("")
  检查抛错(空名子代, "空子代理名必须抛错")

  打印 "test_子代理深化 PASS"

主()
