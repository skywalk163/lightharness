# test_工具系统.light —— E1 工具系统最小复现
# 验证：4 核心工具可注册/执行、返回格式正确、安全护栏生效。
# R8 工具结果归一化：content 恒为块表，结构化结果被 JSON 序列化进单 text 块，
#   故读取结构化字段须 取 content[0]["text"] 再 解析JSON（见 取载荷）。
从 工具 导入 工具注册表
从 核心工具 导入 默认核心注册表
从 JSON 导入 解析JSON

段落 断言相等(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)

# 从归一化结果取结构化载荷：content[0] 是 text 块，其 text 为原 dict 的 JSON 串
段落 取载荷(结果):
  设 块表 为 结果["content"]
  设 首块 为 块表[0]
  返回 解析JSON(首块["text"])

段落 主:
  设 表 为 默认核心注册表()
  断言相等(表.有无("bash"), 真, "bash 已注册")
  断言相等(表.有无("读文件"), 真, "读文件 已注册")
  断言相等(表.有无("写文件"), 真, "写文件 已注册")
  断言相等(表.有无("搜索文件"), 真, "搜索文件 已注册")

  # ---- bash ----
  设 r 为 表.执行("bash", "{\"命令\":\"echo hello\"}")
  断言相等(r["isError"], 假, "bash 执行成功")
  设 bash载荷 为 取载荷(r)
  断言相等(bash载荷["输出"].包含("hello"), 真, "bash 输出含 hello")
  断言相等(bash载荷["退出码"], 0, "bash 退出码=0")

  # ---- 未知工具 ----
  设 r2 为 表.执行("不存在", "{}")
  断言相等(r2["isError"], 真, "未知工具报错")
  断言相等(r2["error"]["代码"], "TOOL_NOT_FOUND", "未知工具代码")

  # ---- 写文件 + 读文件 ----
  设 目标 为 连接路径(当前目录(), "E1_测试临时.txt")
  设 w 为 表.执行("写文件", "{\"路径\":\"E1_测试临时.txt\",\"内容\":\"你好世界\"}")
  断言相等(w["isError"], 假, "写文件成功")
  设 w载荷 为 取载荷(w)
  断言相等(w载荷["写入字节数"], 文件大小(目标), "写入字节数一致")
  设 rd 为 表.执行("读文件", "{\"路径\":\"E1_测试临时.txt\"}")
  断言相等(rd["isError"], 假, "读文件成功")
  设 rd载荷 为 取载荷(rd)
  断言相等(rd载荷["内容"], "你好世界", "读文件内容一致")
  断言相等(rd载荷["截断"], 假, "小文件未截断")

  # ---- 读不存在 / 越界 ----
  设 rd2 为 表.执行("读文件", "{\"路径\":\"不存在_xyz.txt\"}")
  断言相等(rd2["isError"], 真, "读不存在报错")
  设 rd3 为 表.执行("读文件", "{\"路径\":\"../越界.txt\"}")
  断言相等(rd3["isError"], 真, "越界路径被拒")

  # ---- 搜索文件：文件名 ----
  设 s 为 表.执行("搜索文件", "{\"模式\":\"文件名\",\"查询\":\"E1_测试临时.txt\"}")
  断言相等(s["isError"], 假, "文件名搜索无错")
  设 s载荷 为 取载荷(s)
  设 s结果 为 s载荷["结果"]
  设 找到 为 假
  遍历 项 之 s结果:
    如果 项["路径"].包含("E1_测试临时.txt"):
      设 找到 为 真
  断言相等(找到, 真, "文件名搜索命中")

  # ---- 搜索文件：内容 ----
  设 s2 为 表.执行("搜索文件", "{\"模式\":\"内容\",\"查询\":\"你好世界\"}")
  断言相等(s2["isError"], 假, "内容搜索无错")
  设 s2载荷 为 取载荷(s2)
  设 s2结果 为 s2载荷["结果"]
  设 找到2 为 假
  遍历 项 之 s2结果:
    如果 项["路径"].包含("E1_测试临时.txt"):
      设 找到2 为 真
  断言相等(找到2, 真, "内容搜索命中")

  # 清理
  删除文件(目标)

  # ---- bash cd 越界拒绝 ----
  设 r3 为 表.执行("bash", "{\"命令\":\"cd .. && echo no\"}")
  断言相等(r3["isError"], 假, "bash 未抛异常(返回结构化错误)")
  设 r3载荷 为 取载荷(r3)
  断言相等(r3载荷["退出码"], -1, "cd 越界 退出码=-1")
  断言相等(r3载荷["错误"].包含("禁止"), 真, "cd 越界提示")

  打印 "--- 工具系统测试通过 ---"

主()
