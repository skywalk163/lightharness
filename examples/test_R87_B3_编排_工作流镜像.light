# test_R87_B3_编排_工作流镜像.light —— R87 B3 第2组：运行标识→作业镜像 + 作业结局判定
# 覆盖：
#   1. 记录镜像 start/stop：在录才路由，未在录/停止后返回空行（迟到事件无害）
#   2. 四类事件行格式：phase/log/成员启/成员止
#   3. 作业结局：completed(带渲染值+单复数)/cancelled→killed/error→failed/未知→abnormal
# 反跑判据：把 stop 改成不摘出、或把 cancelled 映射成 completed，断言即红。

从 工作流记录镜像 导入 记录镜像, 作业结局, 渲染结局, 阶段日志行, 通道日志行, 成员启动行, 成员结束行

段落 断言真(条件, 标签):
  如果 条件 == 假:
    抛出 "断言失败: " 加上 标签

段落 断言等于(实际, 期望, 标签):
  如果 实际 != 期望:
    抛出 "断言失败: " 加上 标签 + " 实际=" 加上 转字符串(实际) + " 期望=" 加上 转字符串(期望)

# ---- 行格式 ----
断言等于(阶段日志行("编排中"), "▸ 编排中\n", "phase 行")
断言等于(通道日志行("加载脚本"), "加载脚本\n", "log 行")
断言等于(成员启动行(2, "审计员"), "agent #2 审计员 started\n", "成员启行")
断言等于(成员结束行(2, "ok"), "agent #2 ok\n", "成员止行")

# ---- 镜像路由 ----
设 镜像 为 新建 记录镜像()
断言真(镜像.是否在录("run-1") == 假, "初始未在录")
# 未在录：投递返回空串
断言等于(镜像.投递("phase", ["标识": "run-1", "标题": "x"]), "", "未在录不路由")

镜像.开始("run-1", "作业把手甲")
断言真(镜像.是否在录("run-1"), "开始后在录")
断言等于(镜像.投递("phase", ["标识": "run-1", "标题": "拉取依赖"]), "▸ 拉取依赖\n", "phase 路由")
断言等于(镜像.投递("log", ["标识": "run-1", "正文": "第1步"]), "第1步\n", "log 路由")
断言等于(镜像.投递("成员启", ["标识": "run-1", "序号": 1, "标签": "研究员"]), "agent #1 研究员 started\n", "成员启路由")
断言等于(镜像.投递("成员止", ["标识": "run-1", "序号": 1, "结局": "completed"]), "agent #1 completed\n", "成员止路由")
# 别的 runId 未在录
断言等于(镜像.投递("log", ["标识": "run-其他", "正文": "z"]), "", "别的 runId 不路由")

# stop 后迟到事件被丢弃（幂等）
镜像.停止("run-1")
断言真(镜像.是否在录("run-1") == 假, "停止后摘出")
断言等于(镜像.投递("log", ["标识": "run-1", "正文": "迟到"]), "", "停止后迟到事件不路由")
镜像.停止("run-1")
断言真(镜像.是否在录("run-1") == 假, "重复停止幂等")

# ---- 作业结局 ----
设 完结局 为 作业结局(["停止原因": "completed", "启动成员数": 3, "返回值": ["答": 42]], "审计", 50000)
断言等于(完结局["状态"], "completed", "completed 状态")
断言等于(完结局["细节"], "3 agents", "复数细节")
断言真(完结局["结果"].包含('workflow "审计" completed (3 agents)'), "completed 结果头")
断言真(完结局["结果"].包含("42"), "completed 结果含返回值")

设 单结局 为 作业结局(["停止原因": "completed", "启动成员数": 1, "返回值": 空], "清扫", 50000)
断言等于(单结局["细节"], "1 agent", "单数细节")

设 撤结局 为 作业结局(["停止原因": "cancelled"], "x", 50000)
断言等于(撤结局["状态"], "killed", "cancelled→killed")

设 错结局 为 作业结局(["停止原因": "error", "错误": "脚本第3行抛错"], "x", 50000)
断言等于(错结局["状态"], "failed", "error→failed")
断言等于(错结局["细节"], "脚本第3行抛错", "error 细节")

设 错缺 为 作业结局(["停止原因": "error"], "x", 50000)
断言等于(错缺["细节"], "unknown error", "error 缺错误回退")

设 异结局 为 作业结局(["停止原因": "weird"], "x", 50000)
断言等于(异结局["状态"], "failed", "未知原因→failed")
断言真(异结局["细节"].包含("abnormally"), "未知原因文案")

# 渲染截断
设 长文 为 渲染结局("长名", 1, ["很大": "x"], 30)
断言真(长文.包含("truncated"), "超长渲染截断")

打印 "test_R87_B3_编排_工作流镜像 PASS"
