# test_R71_D_字符串能力.light —— R71任务D 测试
# 验证字符串能力补全（G-04）：
#   1. 原始字符串 r'...'/r"..."/R'...'/R"..."（反斜杠不转义）
#   2. 多行三引号字符串 '''...''' / """..."""（含换行，生成 Python 字符串）
#   3. 格式化说明符 {expr:spec}（.2f / >10 / <10 / ^10 / +d / , 千分位）
#   4. 格式说明符与变量插值混合 {x:.2f} {y:.3f}
#   5. 现有 {变量} 插值不受影响（兼容回归）
# 覆盖：Windows路径/正则原始串、大小写前缀、多行含换行、三引号单双引号、
#       各格式说明符形态、与变量插值混合、现有单/双引号字符串插值兼容

段落 断言等于 接收 实际, 期望, 标签 = "":
  如果 实际 != 期望:
    抛出 "断言失败: " + 标签 + " 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望)
  打印 "  ✓ " + 标签

段落 断言真 接收 条件, 标签 = "":
  如果 条件 != 真:
    抛出 "断言失败: " + 标签 + " 期望为真 实际=" + 转字符串(条件)
  打印 "  ✓ " + 标签

段落 主:
  打印 "===== R71-D 字符串能力测试 ====="

  # §1 原始字符串（反斜杠不转义）
  打印 "--- §1 原始字符串 ---"
  设 路径 为 r'C:\Users\name\dir'
  断言等于(路径, "C:\\Users\\name\\dir", "1a r'...' Windows路径原样保留反斜杠")
  设 正则 为 r'\d+\.\d+'
  断言等于(正则, "\\d+\\.\\d+", "1b r'...' 正则无需双重转义")
  设 大R路径 为 R'C:\Path\Name'
  断言等于(大R路径, "C:\\Path\\Name", "1c R'...' 大写前缀等价小写")
  设 大R双 为 R"\d{4}-\d{2}"
  断言等于(大R双, "\\d{4}-\\d{2}", "1d R\"...\" 大写前缀双引号")

  # §2 多行三引号字符串（单引号）
  打印 "--- §2 三引号（单引号） ---"
  设 多行 为 '''第一行
第二行
第三行'''
  断言真(字符串包含(多行, "第一行"), "2a 三引号保留第一行")
  断言真(字符串包含(多行, "第二行"), "2b 三引号保留第二行")
  断言真(字符串包含(多行, "第三行"), "2c 三引号保留第三行")
  断言真(字符串长度(多行) > 9, "2d 三引号含换行（长度>9）")

  # §3 多行三引号字符串（双引号）
  打印 "--- §3 三引号（双引号） ---"
  设 多行2 为 """双引号第一行
双引号第二行"""
  断言真(字符串包含(多行2, "双引号第一行"), "3a 双引号三引号保留第一行")
  断言真(字符串包含(多行2, "双引号第二行"), "3b 双引号三引号保留第二行")

  # §4 格式化说明符
  打印 "--- §4 格式化说明符 ---"
  设 pi 为 3.14159
  设 s1 为 "{pi:.2f}"
  断言等于(s1, "3.14", "4a .2f 两位小数")
  设 s2 为 "{pi:>10.2f}"
  断言等于(字符串长度(s2), 10, "4b >10 右对齐宽度10")
  断言真(字符串包含(s2, "3.14"), "4c >10 右对齐含3.14（左补空格）")
  设 s3 为 "{pi:<10.2f}"
  断言等于(字符串长度(s3), 10, "4d <10 左对齐宽度10")
  断言真(字符串包含(s3, "3.14"), "4e <10 左对齐含3.14（右补空格）")
  设 s4 为 "{pi:^10.2f}"
  断言等于(字符串长度(s4), 10, "4f ^10 居中宽度10")
  断言真(字符串包含(s4, "3.14"), "4g ^10 居中含3.14（两侧补空格）")
  设 s5 为 "{pi:+.2f}"
  断言等于(s5, "+3.14", "4h +d 显示正负号")
  设 大数 为 1234567.891
  设 s6 为 "{大数:,}"
  断言等于(s6, "1,234,567.891", "4i , 千分位分隔")

  # §5 格式化说明符与变量插值混合
  打印 "--- §5 格式说明 + 变量插值混合 ---"
  设 x 为 3.14159
  设 y 为 2.71828
  设 s7 为 "{x:.2f} {y:.3f}"
  断言等于(s7, "3.14 2.718", "5a {x:.2f} {y:.3f} 混合")
  设 s8 为 "{y:.1f} {x:.3f}"
  断言等于(s8, "2.7 3.142", "5b 两个都带格式混合")

  # §6 现有 {变量} 插值不受影响（兼容回归）
  打印 "--- §6 现有插值兼容 ---"
  设 名字 为 "光明"
  设 数 为 42
  设 s9 为 "你好 {名字}，编号 {数}"
  断言等于(s9, "你好 光明，编号 42", "6a 现有变量插值不受影响")
  设 普单 为 '普通单引号串'
  断言等于(普单, "普通单引号串", "6b 普通单引号字符串")
  设 普双 为 "普通双引号字符串"
  断言等于(普双, "普通双引号字符串", "6c 普通双引号字符串")

  # §7 字面量 + 格式说明符（R71-D 补：字面量表达式在带格式说明时可插值）
  打印 "--- §7 字面量 + 格式说明符 ---"
  设 L1 为 "{3.14159:.2f}"
  断言等于(L1, "3.14", "7a 数字字面量 .2f")
  设 L2 为 "{0xFF:04X}"
  断言等于(L2, "00FF", "7b 十六进制字面量 :04X")
  设 L3 为 "{1234567:,}"
  断言等于(L3, "1,234,567", "7c 整数字面量 :, 千分位")
  设 大 为 255
  设 L4 为 "{大:>8d}"
  断言等于(字符串长度(L4), 8, "7d 变量 + >8d 宽度8")

  # §8 L-086 防御不回归（非法格式说明 / 无格式说明的纯字面量维持普通文本）
  打印 "--- §8 L-086 防御不回归 ---"
  设 J 为 '{"name": "光明", "version": 4}'
  断言等于(J, '{"name": "光明", "version": 4}', "8a JSON 串不被误插值")
  设 R 为 "[0-9a-f]{1,4}"
  断言等于(R, "[0-9a-f]{1,4}", "8b 正则量词 {1,4} 不被误插值")
  设 N 为 "{3.14159}"
  断言等于(N, "{3.14159}", "8c 无格式说明的纯字面量维持文本")
  设 K 为 '{"x": 1}'
  断言等于(K, '{"x": 1}', "8d 数字值 JSON 串不被误插值（spec=1 恰为合法宽度）")
  设 K2 为 '{"count": 10, "ok": 真}'
  断言等于(K2, '{"count": 10, "ok": 真}', "8e 多字段数字值 JSON 串不被误插值")

  打印 "===== R71-D 全部测试通过 ====="

主()
