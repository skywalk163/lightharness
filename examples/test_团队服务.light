# test_团队服务.light —— 对标 #69：团队信箱 + 服务门面
# 原版：packages/experimental/agent-team/src/{mailbox.ts, index.ts}
#   用例对齐 tests/team.spec.ts「Team mailbox and waiting」的 mailbox 段 + 门面各方法路由。
#
# 复刻边界：纯逻辑核心，事件溯源。信箱/门面内部服务（花名册/生命周期/等待者/看板/折叠）
#   全部复用 #68/#67/#66 的 .light 模块；本测试只注入宿主能力并断言各方法路径化判定。
#
# 反跑判据（改反必须红）：
#   1) 派发路由错 —— 用例「反跑_派发路由」断言 派发消息 产生 queued + delivered 两条边
#      （追加日志），且 target 收到注入；若 派发消息 不调 能力追加记录 即红。
#   2) 自消息闸失效 —— 用例「反跑_自消息」断言对自己发信必抛 TEAM_SELF_MESSAGE；
#      若发送已准入 去掉自消息判断即红。
#   3) 信箱满闸失效 —— 用例「反跑_信箱满」断言待发数达上限必抛 TEAM_MAILBOX_FULL；
#      若待发计数不排除已送达即红。
#   4) 恢复目标过滤反 —— 用例「反跑_恢复过滤」断言成员恢复只投递发给自己的一批；
#      若 信箱恢复 对成员也派发全部消息即红。
#   5) 弃置闸失效 —— 用例「反跑_弃置闸」断言已弃置后 派发消息/派生队友 必抛 TEAM_DISPOSED；
#      若门面各方法不先查 已弃置 即红。
#   6) 配置校验失效 —— 用例「反跑_配置校验」断言 成员上限=0 / 非整数 必抛 TEAM_INVALID_CONFIG；
#      若 判限 允许 <1 即红。
#   7) 观测确认失效 —— 用例「反跑_观测确认」断言 team-message 收据会被登记为未决投递；
#      若 观测会话边 不识别 team-message 源即红。
#
# 语言坑规避：
#   - `新建 错误(...)` 只能作 抛出 的直接操作数（L-056），错误值建模为字典、抛出点现造。
#   - 捕获变量统一 异常对象（L-050）；写 只吃字面量串（L-055），诊断走 抛出 新建 错误。
#   - 断言降级 no-op（L-037），一律 断言相等 / 检查抛码 / 检查消息。
#   - 字面量单行（L-051）；无闭包：抛错场景走「场景字典 + 具名零参段落」槽位模式。
#   - 命名避危险词根：门面方法 造任务/读任务/列任务（建 是关键字、取 是危险根）。

从 团队服务 导入 装信箱能力, 门面造, 门面配置, 派发消息, 派生队友, 造任务, 读任务, 列任务, 改任务, 等候变更, 隶属, 中断队友, 弃置运行时, 观测会话边, 信箱恢复, 未决投递, 投递内容, 量字节, 判先后, 判限, 正上限, 远程视图, 任务变更结果, 查远端路由, 装路由, 创任务变更, 更任务变更, 陈腐操作样例, 拒操作样例, 上抛操作样例, 成功操作样例
从 团队花名册 导入 装能力, 造团队错, 造牌, 中止牌, 抛牌因, 副本, 切片, 造册, 造生命, 造器, 关闭, 关闭变动器, 等候, 唤醒, 中断, 派生, 局面, 隶属地, 试隶属, 已弃置, 已关闭, 收束, 全结算, 造结算, 令牌, 原因
从 团队折叠 导入 空折叠状态, 套用记录
从 内置核心转换 导入 转字符串
从 内置核心字典 导入 字典删除

# =====================================================================
# 常量
# =====================================================================
设 根标识 为 "team-root"
设 子标识 为 "child-1"
设 副标识 为 "child-2"

# =====================================================================
# 判据助手
# =====================================================================
段落 断言相等 接收 实际, 期望, 标签:
  如果 (实际 != 期望):
    抛出 新建 错误("断言失败[" + 标签 + "]：实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 检查抛码 接收 标签, 码, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, "[" + 码 + "]") == 假):
    抛出 新建 错误("错误码不符[" + 标签 + "]：实际=" + 文 + " 期望码=" + 码)

段落 检查消息 接收 标签, 片段, 运算:
  设 抛了 为 假
  设 文 为 ""
  尝试:
    运算()
  捕获 异常对象:
    设 抛了 为 真
    设 文 为 转字符串(异常对象)
  如果 (抛了 == 假):
    抛出 新建 错误("期望抛错但未抛: " + 标签)
  如果 (字符串包含(文, 片段) == 假):
    抛出 新建 错误("消息不符[" + 标签 + "]：实际=" + 文 + " 应含=" + 片段)

# =====================================================================
# 世界：入参能力的共享可变状态（宿主投影）
# =====================================================================
设 世界 为 {}
设 场景 为 {}

段落 清世界:
  设 占 为 装全部能力()
  设 世界["代理表"] 为 {}
  设 世界["局面表"] 为 {}
  设 世界["追加日志"] 为 []
  设 世界["派生日志"] 为 []
  设 世界["派生抛"] 为 空
  设 世界["落盘抛"] 为 空
  设 世界["恢复表"] 为 {}
  设 世界["恢复抛"] 为 空
  设 世界["计时判定"] 为 假
  设 世界["裁决"] 为 默认裁决
  设 世界["标识序"] 为 0
  设 世界["中断日志"] 为 []
  设 世界["排空日志"] 为 []
  设 世界["局面抛"] 为 空
  设 世界["追加回值"] 为 真
  设 世界["冲刷日志"] 为 []
  设 世界["注入日志"] 为 []
  设 世界["跟投日志"] 为 []
  设 世界["子体日志"] 为 []
  设 世界["看板日志"] 为 []
  设 世界["输入日志"] 为 []
  设 世界["末根"] 为 空
  返回 真

# ---- 能力函数（全部读 世界）----
段落 能查代理 接收 标识:
  如果 (字典包含键(世界["代理表"], 标识) == 假): 返回 空
  返回 世界["代理表"][标识]

段落 能列代理:
  设 结果 为 []
  遍历 键 之 字典键列表(世界["代理表"]):
    列表追加(结果, 世界["代理表"][键])
  返回 结果

段落 能取局面 接收 根:
  如果 (世界["局面抛"] != 空):
    抛出 新建 错误(世界["局面抛"])
  如果 (字典包含键(世界["局面表"], 根["标识"]) == 假):
    设 表 为 世界["局面表"]
    表[根["标识"]] 为 空折叠状态(根["标识"])
    设 世界["局面表"] 为 表
  设 世界["末根"] 为 根
  返回 世界["局面表"][根["标识"]]

段落 能追加记录 接收 根, 种类, 数据:
  设 记 为 {}
  记["type"] 为 种类
  记["data"] 为 数据
  列表追加(世界["追加日志"], 记)
  如果 (世界["追加回值"] == 假): 返回 真
  设 局 为 能取局面(根)
  设 占位 为 套用记录(局, 记)
  返回 真

段落 能造标识:
  设 世界["标识序"] 为 世界["标识序"] + 1
  返回 "m" + 转字符串(世界["标识序"])

段落 能派生成员 接收 参:
  如果 (世界["派生抛"] != 空):
    抛出 新建 错误(世界["派生抛"])
  列表追加(世界["派生日志"], 参["子标识"])
  设 回 为 {}
  回["标识"] 为 参["子标识"]
  回["messageId"] 为 "msg-1"
  返回 回

段落 能落盘首轮提示 接收 子标识, 消息号, 牌:
  如果 (世界["落盘抛"] != 空):
    抛出 新建 错误(世界["落盘抛"])
  返回 真

段落 能恢复会话 接收 子标识:
  如果 (世界["恢复抛"] != 空):
    抛出 新建 错误(世界["恢复抛"])
  如果 (字典包含键(世界["恢复表"], 子标识) == 假):
    抛出 新建 错误("no persisted child Session")
  返回 世界["恢复表"][子标识]

段落 能中断子体 接收 子标识, 调用者:
  列表追加(世界["中断日志"], 子标识)
  返回 真

段落 能排空子体 接收 根, 子清单:
  列表追加(世界["排空日志"], 子清单)
  返回 真

段落 能计时器 接收 时限毫秒:
  返回 世界["计时判定"]

段落 能冲刷 接收 会话:
  列表追加(世界["冲刷日志"], 会话["标识"])
  返回 真

段落 能注入 接收 目标, 输入:
  列表追加(世界["注入日志"], 目标["标识"])
  列表追加(世界["输入日志"], 输入)
  列表追加(目标["后缀"], 输入)
  返回 真

段落 能跟投根 接收 根, 输入:
  列表追加(世界["跟投日志"], 根["标识"])
  列表追加(世界["输入日志"], 输入)
  列表追加(根["后缀"], 输入)
  返回 真

段落 能子体跟投 接收 根, 目标标识, 内容, 源, 牌:
  列表追加(世界["子体日志"], [根["标识"], 目标标识])
  设 目标 为 能查代理(目标标识)
  如果 (目标 != 空):
    设 数 为 {}
    数["content"] 为 内容
    数["source"] 为 源
    设 记 为 {}
    记["type"] 为 "user/message"
    记["data"] 为 数
    列表追加(目标["后缀"], 记)
  返回 真

段落 能看板追加 接收 记录:
  列表追加(世界["看板日志"], 记录)
  返回 真

# ---- 裁决实现（wait 三选一停驻点）----
段落 默认裁决 接收 器, 队标识, 时限毫秒, 牌:
  设 占 为 唤醒(队标识)
  返回 "唤醒"

段落 裁决_唤醒本队 接收 器, 队标识, 时限毫秒, 牌:
  设 占 为 唤醒(队标识)
  返回 "唤醒"

段落 裁决_超时 接收 器, 队标识, 时限毫秒, 牌:
  返回 "超时"

# ---- 构造助手 ----
段落 造代理 接收 标识, 键, 父会话, 态, 型:
  设 代 为 {}
  代["标识"] 为 标识
  代["键"] 为 键
  代["父会话"] 为 父会话
  代["态"] 为 态
  代["模型"] 为 型
  代["后缀"] 为 []
  返回 代

段落 放代理 接收 代理:
  设 表 为 世界["代理表"]
  表[代理["标识"]] 为 代理
  设 世界["代理表"] 为 表
  返回 代理

# 非成员调用者：是根的子体（有子体描述 + 父会话指向根）但不在花名册成员表
段落 造外员 接收 标识, 父会话:
  设 代 为 造代理(标识, "k-x", 父会话, "idle", "mock")
  设 描 为 {}
  描["type"] 为 "subagent/descriptor"
  设 描数 为 {}
  描数["mode"] 为 "spawn"
  描数["provider"] 为 "spawn"
  描["data"] 为 描数
  代["后缀"] 为 [描]
  返回 代

段落 建队 接收 标识:
  设 表 为 世界["局面表"]
  表[标识] 为 空折叠状态(标识)
  设 世界["局面表"] 为 表
  返回 世界["局面表"][标识]

段落 落成员边 接收 根, 成员:
  设 数 为 {}
  数["version"] 为 1
  数["teamId"] 为 根["标识"]
  数["member"] 为 成员
  设 记 为 {}
  记["type"] 为 "team/member"
  记["data"] 为 数
  设 局 为 能取局面(根)
  设 占位 为 套用记录(局, 记)
  返回 真

段落 放成员 接收 根, 成员:
  设 局 为 能取局面(根)
  如果 (字典包含键(局["成员表"], 成员["id"]) == 假):
    设 起 为 副本(成员)
    起["phase"] 为 "provisioning"
    设 占位 为 落成员边(根, 起)
  设 局二 为 能取局面(根)
  设 当 为 局二["成员表"][成员["id"]]
  如果 (当["phase"] == "provisioning"):
    如果 (成员["phase"] != "provisioning"):
      设 占位 为 落成员边(根, 成员)
  设 世界["追加日志"] 为 []
  返回 真

段落 造成员 接收 标识, 名字, 相位:
  设 成 为 {}
  成["id"] 为 标识
  成["name"] 为 名字
  成["description"] 为 名字 + " responsibility"
  成["provider"] 为 "spawn"
  成["context"] 为 "fresh"
  成["phase"] 为 相位
  返回 成

段落 造请求 接收 名字, 描述, 提供者, 上下文, 牌:
  设 请 为 {}
  请["名字"] 为 名字
  请["描述"] 为 描述
  请["提示"] 为 [{"type": "text", "text": "go"}]
  请["上下文"] 为 上下文
  请["提供者"] 为 提供者
  请["令牌"] 为 牌
  返回 请

段落 造消息请求 接收 目标, 投递, 内容, 牌:
  设 请 为 {}
  请["目标"] 为 目标
  请["投递"] 为 投递
  请["内容"] 为 内容
  请["牌"] 为 牌
  返回 请

段落 放恢复 接收 子标识, 记录列表:
  设 元 为 {}
  元["seedLength"] 为 0
  设 载 为 {}
  载["元"] 为 元
  载["事件"] 为 记录列表
  设 表 为 世界["恢复表"]
  表[子标识] 为 载
  设 世界["恢复表"] 为 表
  返回 载

段落 造子体后缀 接收 模式, 提供者:
  设 记录列表 为 []
  设 描 为 {}
  描["type"] 为 "subagent/descriptor"
  设 描数 为 {}
  描数["mode"] 为 模式
  描数["provider"] 为 提供者
  描["data"] 为 描数
  列表追加(记录列表, 描)
  设 用 为 {}
  用["type"] 为 "user/message"
  设 用数 为 {}
  设 源 为 {}
  源["kind"] 为 "user"
  用数["source"] 为 源
  用["data"] 为 用数
  列表追加(记录列表, 用)
  返回 记录列表

段落 造团队后缀 接收 消息号:
  设 用 为 {}
  用["type"] 为 "user/message"
  设 用数 为 {}
  设 源 为 {}
  源["kind"] 为 "team-message"
  源["teamId"] 为 根标识
  源["messageId"] 为 消息号
  用数["content"] 为 []
  用数["source"] 为 源
  用["data"] 为 用数
  返回 [用]

# 装全部能力：给 #68 花名册 12 项 + 给 #69 门面 10 项，均读同一 世界
段落 裁决走世界 接收 器, 队标识, 时限毫秒, 牌:
  返回 世界["裁决"](器, 队标识, 时限毫秒, 牌)

段落 装全部能力:
  设 占 为 装能力(能查代理, 能列代理, 能取局面, 能追加记录, 能造标识, 能派生成员, 能落盘首轮提示, 能恢复会话, 能中断子体, 能排空子体, 能计时器, 裁决走世界)
  设 占 为 装信箱能力(能查代理, 能列代理, 能追加记录, 能造标识, 能恢复会话, 能冲刷, 能注入, 能跟投根, 能子体跟投, 能看板追加)
  返回 真

# =====================================================================
# 槽位运行器（无闭包，抛错场景统一走这里）
# =====================================================================
段落 跑派发:
  设 占 为 派发消息(场景["调用者"], 场景["请求"])
  返回 真

段落 跑派生:
  设 占 为 派生队友(场景["调用者"], 场景["请求"])
  返回 真

段落 跑隶属:
  设 占 为 隶属(场景["代理"])
  返回 真

段落 跑恢复:
  设 占 为 信箱恢复(场景["代理"], 场景["牌"])
  返回 真

段落 跑观测:
  设 占 为 观测会话边(场景["会话"], 场景["记录"])
  返回 真

段落 跑等候:
  设 占 为 等候变更(场景["调用者"], 场景["限"], 场景["牌"])
  返回 真

段落 跑中断:
  设 占 为 中断队友(场景["调用者"], 场景["目标名"])
  返回 真

段落 跑造任务:
  设 占 为 造任务(场景["调用者"], 场景["请求"])
  返回 真

段落 跑读任务:
  设 占 为 读任务(场景["调用者"], 场景["标识"])
  返回 真

段落 跑列任务:
  设 占 为 列任务(场景["调用者"])
  返回 真

段落 跑改任务:
  设 占 为 改任务(场景["调用者"], 场景["请求"])
  返回 真

# 计数助手：统计 追加日志 里某 type 的条数
段落 数类型 接收 种类:
  设 数 为 0
  遍历 记 之 世界["追加日志"]:
    如果 (记["type"] == 种类): 设 数 为 数 + 1
  返回 数

# =====================================================================
# 1. 门面配置
# =====================================================================
段落 用例_配置默认:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 配 为 门面配置()
  断言相等(配["成员上限"], 8, "默认成员上限")
  断言相等(配["任务上限"], 256, "默认任务上限")
  断言相等(配["待发上限"], 64, "默认待发上限")
  断言相等(配["消息字节"], 65536, "默认消息字节")
  断言相等(配["弃置时限"], 5000, "默认弃置时限")
  返回 真

段落 用例_配置非法:
  设 清 为 清世界()
  设 场景["坏值"] 为 0
  设 场景["字段"] 为 "成员上限"
  检查抛码("上限为零", "TEAM_INVALID_CONFIG", 跑判限)
  设 场景["坏值"] 为 "x"
  检查抛码("上限非整数", "TEAM_INVALID_CONFIG", 跑判限)
  返回 真

