  返回 真

# =====================================================================
# 4. 派发消息（sendMessage）—— 分发各路径
# =====================================================================
段落 用例_派发入队即送:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 请 为 造消息请求("worker", "quiet", [{"type": "text", "text": "hi"}], 造牌())
  设 果 为 派发消息(根, 请)
  断言相等(果["状态"], "accepted", "活跃目标即送")
  断言相等(数类型("team/message/queued"), 1, "排队边一条")
  断言相等(数类型("team/message/delivered"), 1, "送达边一条")
  断言相等(列表长度(世界["注入日志"]), 1, "子体被注入")
  断言相等(世界["注入日志"][0], 子标识, "注入目标是子体")
  断言相等(列表长度(世界["冲刷日志"]), 1, "目标会话被冲刷")
  断言相等(世界["冲刷日志"][0], 子标识, "冲刷目标是子体")
  设 局 为 局面(根)
  断言相等(字典包含键(局["已送达"], 果["消息标识"]), 真, "已送达记入折叠")
  返回 真

