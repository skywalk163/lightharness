# =====================================================================
# 6. 信箱恢复（recoverFor）
# =====================================================================
段落 用例_恢复队长:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "live-one", "active"))
  设 占 为 放成员(根, 造成员(副标识, "gone-one", "active"))
  设 占 为 派发消息(根, 造消息请求("gone-one", "quiet", [{"type": "text", "text": "a"}], 造牌()))
  设 占 为 派发消息(根, 造消息请求("live-one", "quiet", [{"type": "text", "text": "b"}], 造牌()))
  设 活 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 世界["追加日志"] 为 []
  设 占 为 信箱恢复(根, 造牌())
  断言相等(列表长度(世界["注入日志"]), 1, "队长恢复只派活体目标的待发")
  断言相等(世界["注入日志"][0], 子标识, "活体目标被投递")
  断言相等(数类型("team/message/delivered"), 1, "恢复后活体目标记送达")
  设 局 为 局面(根)
  断言相等(字典包含键(局["已送达"], "team-message-m1"), 假, "静默无活体目标仍排队")
  返回 真

