  断言相等(配["成员上限"], 3, "自定义成员上限")
  断言相等(配["任务上限"], 256, "未给任务上限回落默认")
  断言相等(配["待发上限"], 1, "自定义待发上限")
  断言相等(配["消息字节"], 200, "自定义消息字节")
  断言相等(配["弃置时限"], 6000, "自定义弃置时限")
  返回 真

# =====================================================================
# 2. 隶属路由
# =====================================================================
段落 用例_隶属路由:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 隶 为 隶属(根)
  断言相等(隶["角色"], "lead", "队长角色")
  断言相等(隶["名字"], "lead", "队长名")
  设 隶2 为 隶属(子)
  断言相等(隶2["角色"], "teammate", "成员角色")
  断言相等(隶2["队标识"], 根标识, "成员队标识")
  设 外 为 放代理(造外员(副标识, 根标识))
  设 场景["代理"] 为 外
  检查抛码("非成员隶属", "TEAM_NOT_MEMBER", 跑隶属)
  返回 真

# =====================================================================
# 3. 派生队友（spawnTeammate）路由
# =====================================================================
段落 用例_派生队友路由:
  设 清 为 清世界()
  设 占 为 门面造({})
  设 根 为 放代理(造代理(根标识, "k-root", 空, "idle", "mock"))
  设 占 为 建队(根标识)
  设 占 为 放成员(根, 造成员(子标识, "worker", "active"))
  设 子 为 放代理(造代理(子标识, "k-c1", 根标识, "running", "child-model"))
  设 请 为 造请求("newbie", "d", "spawn", "fresh", 造牌())
  设 回 为 派生队友(根, 请)
  断言相等(回["成员"]["名字"], "newbie", "派生后成员名")
  断言相等(回["成员"]["角色"], "teammate", "派生后角色")
  断言相等(回["成员"]["标识"], "m1", "派生后标识走造标识")
  设 请2 为 造请求("late", "d", "spawn", "fresh", 造牌())
  设 场景["调用者"] 为 子
  设 场景["请求"] 为 请2
  检查抛码("成员派生需队长", "TEAM_LEAD_REQUIRED", 跑派生)
  设 外 为 放代理(造外员(副标识, 根标识))
  设 场景["调用者"] 为 外
  检查抛码("非成员派生", "TEAM_NOT_MEMBER", 跑派生)
  返回 真

