# test_acp内容_接线.light —— 第6轮 任务B #257 ACP 内容准入/投影宿主出口 判据
# 运行：python 运行.py examples/test_acp内容_接线.light
# 判据：接桩出口（经宿主抓取提示/经宿主投影内容）在宿主桩 mock 下返回预期形状；
#       纯逻辑段回归绿由 test_acp内容.light 承担。

从 acp内容 导入 经宿主抓取提示, 经宿主投影内容
从 宿主IO 导入 造宿主桩, 造成功结果, 造失败结果, 是失败结果

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))
  返回 真

段落 断言真(条件, 信息):
  如果 条件 == 假:
    抛出 新建 错误("断言失败：" + 信息)
  返回 真

# mock 宿主桩能力：抓取提示 -> 返回固定 ACP ContentBlock 列表
段落 抓提示(参数字典):
  返回 [{"type": "text", "text": "宿主提示"}, {"type": "image", "mimeType": "image/png", "data": "AB=="}]

# mock 宿主桩能力：投影 -> 回显
段落 投影(参数字典):
  返回 参数字典

# mock 宿主桩能力：抓取提示 -> 仅空白文本块（触发 admitAcpPrompt 空提示抛错）
段落 空提示(参数字典):
  返回 [{"type": "text", "text": "   "}]

段落 主:
  # ---- 1. 经宿主抓取提示：准入通过 + 投影写回 ----
  设 桩 为 造宿主桩({"acp抓取提示": 抓提示, "acp投影": 投影})
  设 r1 为 经宿主抓取提示(桩, 真)
  断言真(r1["成功"], "1a 抓取+投影成功")
  设 内容 为 r1["数据"]["内容"]
  断言相等(列表长度(内容), 2, "1b 投影两块")
  断言相等(内容[0]["type"], "text", "1c 首块文本")
  断言相等(内容[0]["text"], "宿主提示", "1d 文本透传")
  断言相等(内容[1]["type"], "image", "1e 次块图像")
  断言相等(内容[1]["attachment"]["mediaType"], "image/png", "1f 图像引用")
  # 调用日志：抓取 + 投影 两次
  断言相等(列表长度(桩["调用日志"]), 2, "1g 抓取与投影各留痕一次")

  # ---- 2. 宿主桩缺能力 -> UNSUPPORTED_OPERATION（不静默） ----
  设 r2 为 经宿主抓取提示(造宿主桩({}), 真)
  断言真(是失败结果(r2), "2a 缺抓取能力须失败")
  断言相等(r2["错误码"], "UNSUPPORTED_OPERATION", "2b 错误码")

  # ---- 3. 空提示：准入判定保留 -> 抛错原样上抛 ----
  设 桩3 为 造宿主桩({"acp抓取提示": 空提示})
  设 已抛 为 假
  尝试:
    # 抓取能力返回空白文本块 -> admitAcpPrompt 抛 "empty prompt"
    设 _r3 为 经宿主抓取提示(桩3, 真)
  捕获 异常 e:
    设 已抛 为 真
  断言真(已抛, "3a 空提示须抛（准入判定保留）")

  # ---- 4. 经宿主投影内容：assistant 方向写回 ----
  设 桩4 为 造宿主桩({"acp投影": 投影})
  设 r4 为 经宿主投影内容(桩4, [{"type": "text", "text": "回投"}])
  断言真(r4["成功"], "4a 投影成功")
  断言相等(r4["数据"]["内容"][0]["text"], "回投", "4b 内容透传")

  # ---- 5. 投影能力缺失 -> UNSUPPORTED_OPERATION ----
  设 r5 为 经宿主投影内容(造宿主桩({}), [])
  断言真(是失败结果(r5), "5a 缺投影能力须失败")

  打印 "--- 第6轮 任务B #257 ACP 内容宿主出口 测试通过 ---"

主()