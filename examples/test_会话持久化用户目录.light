# test_会话持久化用户目录.light
# 验证会话持久化根落到用户级目录（~/.lightharness，或 HARNESS_HOME 覆盖），
# 且旧 <项目根>/data/sessions 的数据能被无损迁移。T-会话持久化 专项。
# 运行：python 运行.py examples/test_会话持久化用户目录.light

从 会话持久化根 导入 解析会话持久化根, 展开波浪号, 迁移旧会话数据
从 文件系统 导入 路径连接, 目录存在, 创建目录, 读取文件, 写入文件, 文件存在, 删除目录, 删除文件, 文件列表
从 环境 导入 设置环境变量, 删除环境变量

段落 断言相等(实际, 期望, 信息):
  如果 实际 != 期望:
    抛出 新建 错误("断言失败：" + 信息 + " | 实际=" + 转字符串(实际) + " 期望=" + 转字符串(期望))

段落 清空目录(目录):
  如果 目录存在(目录) == 假:
    返回
  遍历 名字 之 文件列表(目录):
    删除文件(路径连接(目录, 名字))
  删除目录(目录)

段落 主:
  设 家 为 主目录()

  # ---- §1 默认根 = 主目录/.lightharness ----
  删除环境变量("HARNESS_HOME")
  断言相等(解析会话持久化根(), 路径连接(家, ".lightharness"), "默认根 = ~/.lightharness")

  # ---- §2 HARNESS_HOME 覆盖（含 ~ 展开）----
  设置环境变量("HARNESS_HOME", "/tmp/lh-custom-home")
  断言相等(解析会话持久化根(), "/tmp/lh-custom-home", "HARNESS_HOME 绝对值覆盖")
  设置环境变量("HARNESS_HOME", "~/.my-lh")
  断言相等(解析会话持久化根(), 路径连接(家, ".my-lh"), "HARNESS_HOME 的 ~ 展开")
  删除环境变量("HARNESS_HOME")

  # ---- §3 展开波浪号边界 ----
  断言相等(展开波浪号("~"), 家, "~ 展开为主目录")
  断言相等(展开波浪号("~/x"), 路径连接(家, "x"), "~/x 展开")
  断言相等(展开波浪号("/abs/path"), "/abs/path", "绝对路径原样")

  # ---- §4 旧数据迁移（临时目录，无损且幂等）----
  设 临时根 为 路径连接("/tmp", "lh_migrate_test")
  设 旧目录 为 路径连接(路径连接(临时根, "data"), "sessions")
  设 新目录 为 路径连接(临时根, "new_sessions")
  清空目录(旧目录)
  清空目录(新目录)
  创建目录(旧目录)
  写入文件(路径连接(旧目录, "session_old.jsonl"), "{\"type\":\"session\"}\n")
  写入文件(路径连接(旧目录, "_index.json"), "{}")
  写入文件(路径连接(旧目录, "ignore.txt"), "x")

  断言相等(迁移旧会话数据(临时根, 新目录), 真, "迁移返回真（有数据搬）")
  断言相等(文件存在(路径连接(新目录, "session_old.jsonl")), 真, "jsonl 已迁移")
  断言相等(文件存在(路径连接(新目录, "_index.json")), 真, "索引已迁移")
  断言相等(文件存在(路径连接(新目录, "ignore.txt")), 假, "非会话文件不迁移")
  断言相等(读取文件(路径连接(新目录, "session_old.jsonl")), "{\"type\":\"session\"}\n", "迁移内容无损")
  # 幂等：再跑一次不再搬（目标已存在）
  断言相等(迁移旧会话数据(临时根, 新目录), 假, "二次迁移返回假（幂等）")
  # 旧数据仍在（无损）
  断言相等(文件存在(路径连接(旧目录, "session_old.jsonl")), 真, "旧数据保留（不删源）")

  # 清理
  清空目录(旧目录)
  清空目录(新目录)
  打印 "--- test_会话持久化用户目录 全部通过 ---"

主()
